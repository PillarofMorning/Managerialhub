                    <Btn kind="ghost" onClick={() => pattern('production')}>+ Production 2x12h</Btn>
                    <Btn kind="ghost" onClick={() => pattern('sanitation')}>+ Sanitation 2x12h</Btn>
                    <Btn kind="ghost" onClick={() => addDef('production')}>+ Production shift</Btn>
                    <Btn kind="ghost" onClick={() => addDef('sanitation', '18:00', '06:00')}>+ Sanitation shift</Btn>
