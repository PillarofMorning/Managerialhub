    const selected = selectedId ? runs.find(r => r.id === selectedId) : null;
    const selSeq = selected ? lineRunsOf(selected.area, selected.line) : [];
    const selIdx = selected ? selSeq.findIndex(r => r.id === selected.id) : -1;
    const dialogCanSwap = dialog && dialog.draft.id ? (() => { const r = runs.find(x => x.id === dialog.draft.id); if (!r) return null; const sq = lineRunsOf(r.area, r.line), i = sq.findIndex(x => x.id === r.id); return { earlier: i > 0, later: i >= 0 && i < sq.length - 1 }; })() : null;
    const issueColor = { overlap: BRAND.red, short: BRAND.red, tight: '#D97706', shift: '#F97316' };
    const rangeLabel = view.days === 1 ? fmtDay(view.from) : `${fmtDay(view.from)} to ${fmtDay(rangeTo - 1)}`;
    const issueValues = Object.keys(issues).map(k => issues[k]);
    const extrasMissing = settings.extrasOk === false && apiReady;

    return (
        <div className="flex flex-col h-screen bg-[#F7F9FC] text-slate-800 overflow-hidden" style={{ fontFamily: BRAND_FONT }}>
            <div className="bg-white border-b border-slate-200 px-4 py-2 flex flex-wrap items-center gap-4 flex-shrink-0 z-40">
                <BrandLogo />
                <div className="leading-tight"><div className="text-sm font-black uppercase tracking-widest text-[#00468B]">Production Schedule</div><div className="text-[10px] text-slate-400">plan · import · shifts · cleaning</div></div>
                <div className="flex flex-wrap gap-1.5 ml-2">
                    {TABS.map(t => { const I = t.icon; return (
                        <button key={t.id} type="button" onClick={() => setTab(t.id)} className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold border whitespace-nowrap transition-colors ${tab === t.id ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB]'}`}><I className="w-4 h-4" />{t.label}</button>); })}
                </div>
                <div className="ml-auto flex items-center gap-2">
                    <Btn kind="ghost" onClick={undoLast} disabled={!undoStack.length} title={undoStack.length ? `Undo: ${undoStack[undoStack.length - 1].label}` : 'Nothing to undo'}><span className="inline-flex items-center gap-1"><UndoIcon className="w-3.5 h-3.5" /> Undo{undoStack.length ? ` (${undoStack.length})` : ''}</span></Btn>
                    <Btn kind="ghost" onClick={reload} title="Read the runs again from Dataverse"><span className="inline-flex items-center gap-1"><RotateIcon className="w-3.5 h-3.5" /> Reload</span></Btn>
                </div>
            </div>
            {/* the page itself never scrolls in the host canvas, so this area does (same shell as the Manager hub) */}
            <main className="flex-1 min-h-0 overflow-y-auto relative">
                {(issueValues.length > 0 || extrasMissing) && (
                    <div className="px-4 pt-3 space-y-1.5">
                        {extrasMissing && (
                            <div className="px-3 py-1.5 rounded-lg bg-[#FFF6E0] border border-[#FFB81C]/60 text-xs font-bold text-slate-800 flex flex-wrap items-center gap-2">
                                <span>Order # and Cases are kept on this browser only: the runs table has no craa5_ordernumber (text) / craa5_cases (whole number) columns yet.</span>
                                <button type="button" className="underline text-[#00468B]" onClick={() => updateSettings(s => ({ ...s, extrasOk: null }))}>I added them, check again</button>
                            </div>
                        )}
                        {issueValues.map((m, i) => <div key={i} className="px-3 py-1.5 rounded-lg bg-[#FFF6E0] border border-[#FFB81C]/60 text-xs font-bold text-slate-800">{m}</div>)}
                    </div>
                )}
                {notice && (
                    <div className="fixed bottom-5 left-1/2 -translate-x-1/2 z-[120] max-w-[90vw]" role="status">
                        <div className={`px-4 py-2.5 rounded-xl border shadow-lg text-sm font-semibold flex items-start gap-3 ${notice.type === 'error' ? 'bg-[#FDE8EC] border-[#E4002B]/50 text-[#B00020]' : notice.type === 'success' ? 'bg-[#DCFCE7] border-[#16A34A]/50 text-[#166534]' : 'bg-white border-[#B3D4F2] text-[#00468B]'}`}>
                            <span>{notice.message}</span>
                            <button type="button" onClick={() => setNotice(null)} className="opacity-60 hover:opacity-100"><XIcon className="w-4 h-4" /></button>
                        </div>
                    </div>
                )}
                <div className="p-4">
                    {tab === 'schedule' && (
                        <div className="space-y-3">
                            <div className="flex flex-wrap items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 shadow-sm">
                                <div className="flex gap-1">{[[1, '1 day'], [3, '3 days'], [7, 'Week'], [14, '2 weeks'], [28, '4 weeks'], [56, '8 weeks']].map(p => <Chip key={p[0]} on={view.days === p[0]} onClick={() => setDays(p[0])}>{p[1]}</Chip>)}</div>
                                <div className="flex items-center gap-1 ml-1">
                                    <Btn kind="ghost" onClick={() => stepRange(-1)}>{'<'}</Btn>
                                    <Btn kind="ghost" onClick={goToday}>Today</Btn>
                                    <Btn kind="ghost" onClick={() => stepRange(1)}>{'>'}</Btn>
                                    <input type="date" className="border border-slate-300 rounded-lg px-2 py-1 text-xs" value={getLocalYMD(new Date(view.from))} onChange={(e) => { const d = parseYMD(e.target.value); if (d) jumpTo(d.getTime()); }} />
                                    <span className="text-sm font-black text-[#00468B] ml-1 whitespace-nowrap">{rangeLabel}</span>
                                </div>
                                <div className="flex flex-wrap items-center gap-1.5 ml-auto">
                                    <label className="text-[10px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1">Snap
                                        <select className="border border-slate-300 rounded-lg px-1.5 py-1 text-xs normal-case font-bold" value={settings.snapMins} onChange={(e) => updateSettings(s => ({ ...s, snapMins: Number(e.target.value) }))}>{[5, 15, 30, 60].map(n => <option key={n} value={n}>{n} min</option>)}</select></label>
                                    <Chip on={settings.push} onClick={() => updateSettings(s => ({ ...s, push: !s.push }))} title="When a run is dropped or stretched over later runs, push them later instead of refusing">Push later runs</Chip>
                                    <Chip on={settings.showShifts} onClick={() => updateSettings(s => ({ ...s, showShifts: !s.showShifts }))} title="Production and sanitation headcount under each line (shown for ranges up to 2 weeks)">Shift overlay{settings.showShifts && view.days > 14 ? ' (≤ 2 wks)' : ''}</Chip>
                                    <Chip on={settings.showClean} onClick={() => updateSettings(s => ({ ...s, showClean: !s.showClean }))} title="Cleaning window between runs: green = enough time">Cleaning windows</Chip>
                                    <Chip on={settings.hideEmpty} onClick={() => updateSettings(s => ({ ...s, hideEmpty: !s.hideEmpty }))}>Hide empty lines</Chip>
                                    <Btn kind="yellow" onClick={() => setShowIssues(v => !v)}><span className="inline-flex items-center gap-1"><AlertIcon className="w-3.5 h-3.5" /> Checks ({issueList.length})</span></Btn>
                                    <Btn onClick={() => openNew(rows[0] || null, midnightOf(Math.max(view.from, Math.min(nowMs, rangeTo - 1))).getTime() + 6 * HOUR)}>+ Run</Btn>
                                </div>
                            </div>
                            {showIssues && (
                                <div className="bg-white border border-slate-200 rounded-xl p-3 shadow-sm max-h-56 overflow-y-auto">
                                    {issueList.length === 0 && <p className="text-sm text-[#166534] font-semibold">Nothing to flag in this period: no overlaps, every changeover has time to clean{settings.shifts.length ? ', every run is covered by a production shift' : ''}.</p>}
                                    {issueList.map(it => (
                                        <button key={it.key} type="button" onClick={() => { setSelectedId(it.runId); if (it.ms < view.from || it.ms > rangeTo) jumpTo(it.ms); }} className="w-full text-left flex items-start gap-2 py-1 text-xs border-b border-slate-100 hover:bg-slate-50">
                                            <span className="mt-1 w-2 h-2 rounded-full flex-shrink-0" style={{ background: issueColor[it.kind] }} /><span className="font-bold text-slate-500 whitespace-nowrap">{fmtDT(it.ms)}</span><span>{it.text}</span></button>))}
                                </div>
                            )}
                            <div className="flex flex-wrap items-center gap-2 rounded-xl px-3 min-h-[42px] text-xs border" style={selected ? { background: BRAND.yellowSoft, borderColor: BRAND.yellow } : { background: '#fff', borderColor: '#E2E8F0' }}>
                                {selected ? (<>
                                    <b className="text-slate-800">{lineLabelOf(selected.area, selected.line)}</b><span>{runTitle(selected)}</span><span className="text-slate-500">{fmtDT(selected.start)} to {fmtDT(selected.end)} ({fmtHrs(selected.end - selected.start)})</span>
                                    <div className="ml-auto flex gap-1.5 py-1">
                                        <Btn kind="ghost" disabled={selIdx <= 0} onClick={() => swapWithNeighbour(selected.id, -1)} title="Trade places with the run before it">{'< Earlier'}</Btn>
                                        <Btn kind="ghost" disabled={selIdx < 0 || selIdx >= selSeq.length - 1} onClick={() => swapWithNeighbour(selected.id, 1)} title="Trade places with the run after it">{'Later >'}</Btn>
                                        <Btn onClick={() => openEdit(selected)}>Edit</Btn>
                                        <Btn kind="ghost" onClick={() => setSelectedId(null)}>Done</Btn>
                                    </div>
                                </>) : <span className="text-slate-400">Click a run to select it (then use Earlier / Later to change the order). Double-click a run to edit it, or an empty spot on a line to add one.</span>}
                            </div>
                            <GanttView rows={rows} runs={runs} gaps={analysis.gaps} occ={occ} own={own} rangeFrom={view.from} rangeDays={view.days} settings={settings}
                                selectedId={selectedId} onSelect={setSelectedId} onCommit={commitMove} onOpen={openEdit} onNewRun={openNew}
                                issueMap={analysis.issueMap} uncoveredMap={analysis.uncoveredMap} nowMs={nowMs} />
                            <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] text-slate-500 px-1">
                                <span><i className="inline-block w-3 h-3 rounded-sm bg-[#0072CE] align-middle mr-1" />Run</span>
                                <span><i className="inline-block w-3 h-3 rounded-sm bg-[#FFB81C] align-middle mr-1" />Allergen</span>
                                <span><i className="inline-block w-3 h-3 rounded-sm bg-black align-middle mr-1" />Maintenance</span>
                                {['ok', 'tight', 'short'].map(k => <span key={k}><i className="inline-block w-3 h-3 rounded-sm border align-middle mr-1" style={{ background: GAP_STYLE[k].bg, borderColor: GAP_STYLE[k].border }} />{k === 'ok' ? 'Enough time to clean' : k === 'tight' ? 'Tight' : 'Not enough time'}</span>)}
                                <span><i className="inline-block w-3 h-3 rounded-sm border align-middle mr-1" style={{ background: SHIFT_GROUPS.production.soft, borderColor: SHIFT_GROUPS.production.color }} />Production shift (people)</span>
                                <span><i className="inline-block w-3 h-3 rounded-sm border align-middle mr-1" style={{ background: SHIFT_GROUPS.sanitation.soft, borderColor: SHIFT_GROUPS.sanitation.color }} />Sanitation shift (people)</span>
                                <span className="ml-auto">Drag = move · edges = start / stop · drop past a neighbour = swap order · Alt = no snapping · Esc = cancel · double-click = edit / add</span>
                            </div>
                        </div>
                    )}
                    {tab === 'month' && (
                        <div className="space-y-3">
                            <div className="flex flex-wrap items-center gap-3">
                                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Production Monthly</h2>
                                <div className="flex items-center gap-2 bg-white p-1 rounded-lg border border-slate-200 shadow-sm">
                                    <button type="button" onClick={() => setMonth(new Date(month.getFullYear(), month.getMonth() - 1, 1))} className="px-3 py-1 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-md">{'< Prev'}</button>
