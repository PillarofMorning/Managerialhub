let SHIFT_SEQ = 1;
const newShiftId = () => `sh_${Date.now().toString(36)}_${SHIFT_SEQ++}`;
function ShiftsView({ rows, settings, updateSettings, employees, empLoaded, rosterCount, own }) {
    const [sub, setSub] = useState('shifts');
    const [lineKey, setLineKey] = useState('*');
    const [search, setSearch] = useState('');
    const [crewFilter, setCrewFilter] = useState('');
    const defs = settings.shifts.filter(s => s.lineKey === lineKey);
    const setDef = (id, patch) => updateSettings(s => ({ ...s, shifts: s.shifts.map(x => x.id === id ? { ...x, ...patch } : x) }));
    const addDef = (group, start, stop, label, crew) => updateSettings(s => ({ ...s, shifts: s.shifts.concat([{ id: newShiftId(), lineKey, group, label: label || '', crew: crew || '', days: [0, 1, 2, 3, 4, 5, 6], start: start || '06:00', stop: stop || '18:00', heads: '' }]) }));
    const pattern = (group) => updateSettings(s => ({ ...s, shifts: s.shifts.concat([
        { id: newShiftId(), lineKey, group, label: 'Days', crew: '', days: [0, 1, 2, 3, 4, 5, 6], start: '06:00', stop: '18:00', heads: '' },
        { id: newShiftId(), lineKey, group, label: 'Nights', crew: '', days: [0, 1, 2, 3, 4, 5, 6], start: '18:00', stop: '06:00', heads: '' }]) }));
    const delDef = (id) => updateSettings(s => ({ ...s, shifts: s.shifts.filter(x => x.id !== id) }));
    const copyToAll = () => updateSettings(s => {
        const mine = s.shifts.filter(x => x.lineKey === lineKey);
        const keys = rows.map(r => r.key).filter(k => k !== lineKey);
        const kept = s.shifts.filter(x => x.lineKey === lineKey || keys.indexOf(x.lineKey) < 0);
        const copies = [];
        keys.forEach(k => mine.forEach(x => copies.push({ ...x, id: newShiftId(), lineKey: k })));
        return { ...s, shifts: kept.concat(copies) };
    });
    const weekStart = addDaysLocal(midnightOf(Date.now()), -new Date().getDay());
    const grid = useMemo(() => {
        const occ = shiftOccurrences(settings.shifts, weekStart.getTime() - DAY, weekStart.getTime() + 8 * DAY, rosterCount);
        const out = {};
        ['production', 'sanitation'].forEach(g => {
            out[g] = [];
            for (let d = 0; d < 7; d++) { const rowc = []; for (let h = 0; h < 24; h++) { const a = addDaysLocal(weekStart, d).getTime() + h * HOUR; rowc.push(coverageFor(occ, lineKey, g, a, a + HOUR, own).avg); } out[g].push(rowc); }
        });
        return out;
    }, [settings.shifts, lineKey, rosterCount, own]);
    const filteredEmps = employees.filter(e => (!crewFilter || e.crew === crewFilter) && (!search || e.name.toLowerCase().indexOf(search.toLowerCase()) >= 0 || e.jobRole.toLowerCase().indexOf(search.toLowerCase()) >= 0));
    const cycle = (e) => {
        const cur = settings.rosterOverrides[e.id] || '';
        const order = ['', 'production', 'sanitation', 'exclude'], nx = order[(order.indexOf(cur) + 1) % order.length];
        updateSettings(s => { const o = { ...s.rosterOverrides }; if (nx) o[e.id] = nx; else delete o[e.id]; return { ...s, rosterOverrides: o }; });
    };
    const th = "px-2 py-1.5 text-left text-[10px] font-black uppercase tracking-wider text-slate-500";
    return (
        <div className="space-y-4">
            <div className="flex gap-2">
                <Chip on={sub === 'shifts'} onClick={() => setSub('shifts')}>Shifts per line</Chip>
                <Chip on={sub === 'roster'} onClick={() => setSub('roster')}>Roster ({employees.length})</Chip>
            </div>
            {sub === 'shifts' && (
                <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-4">
                    <div className="flex flex-wrap items-end gap-3">
                        <Field label="Line"><select className={inputCls} value={lineKey} onChange={(e) => setLineKey(e.target.value)}><option value="*">Every line (default)</option>{rows.map(r => <option key={r.key} value={r.key}>{r.label}</option>)}</select></Field>
                        <Btn kind="ghost" onClick={() => pattern('production')}>+ Production 2×12h</Btn>
                        <Btn kind="ghost" onClick={() => pattern('sanitation')}>+ Sanitation 2×12h</Btn>
                        <Btn kind="ghost" onClick={() => addDef('production')}>+ Production shift</Btn>
                        <Btn kind="ghost" onClick={() => addDef('sanitation', '18:00', '06:00')}>+ Sanitation shift</Btn>
                        {lineKey !== '*' && defs.length > 0 && <Btn kind="ghost" onClick={copyToAll} title="Replaces the shifts of every other line with these">Copy to all other lines</Btn>}
                    </div>
                    <p className="text-xs text-slate-500">A shift lists the days it <b>starts</b> on. Stop earlier than start means it ends the next morning (night shift). Leave <b>People</b> empty to count the roster for that crew. "Every line" shifts apply to any line that has no shift of its own for that group (production or sanitation).</p>
                    {defs.length === 0 && <div className="text-sm text-slate-400 py-4">No shifts for this line yet.</div>}
                    {defs.length > 0 && (
                        <div className="overflow-x-auto"><table className="w-full text-xs">
                            <thead><tr><th className={th}>Group</th><th className={th}>Name</th><th className={th}>Crew</th><th className={th}>Starts on</th><th className={th}>Start</th><th className={th}>Stop</th><th className={th}>People</th><th /></tr></thead>
                            <tbody>{defs.map(s => {
                                const sg = SHIFT_GROUPS[s.group];
                                const resolved = s.heads !== '' ? Number(s.heads) : (s.crew ? rosterCount(s.crew, s.group) : 0);
                                return (
                                    <tr key={s.id} className="border-t border-slate-100">
                                        <td className="px-2 py-1"><select className={inputCls} style={{ borderColor: sg.color }} value={s.group} onChange={(e) => setDef(s.id, { group: e.target.value })}><option value="production">Production</option><option value="sanitation">Sanitation</option></select></td>
                                        <td className="px-2 py-1"><input className={inputCls + ' min-w-[90px]'} value={s.label} onChange={(e) => setDef(s.id, { label: e.target.value })} placeholder="Days" /></td>
                                        <td className="px-2 py-1"><select className={inputCls} value={s.crew} onChange={(e) => setDef(s.id, { crew: e.target.value })}><option value="">-</option>{CREWS.map(c => <option key={c} value={c}>{c}</option>)}</select></td>
                                        <td className="px-2 py-1"><div className="flex gap-1">{DOW.map((d, i) => <button key={i} type="button" title={d} onClick={() => setDef(s.id, { days: s.days.indexOf(i) >= 0 ? s.days.filter(x => x !== i) : s.days.concat([i]).sort() })} className={`w-6 h-6 rounded text-[10px] font-black border ${s.days.indexOf(i) >= 0 ? 'text-white border-transparent' : 'bg-white text-slate-400 border-slate-300'}`} style={s.days.indexOf(i) >= 0 ? { background: sg.color } : undefined}>{d[0]}</button>)}</div></td>
                                        <td className="px-2 py-1"><input type="time" className={inputCls} value={s.start} onChange={(e) => setDef(s.id, { start: e.target.value })} /></td>
                                        <td className="px-2 py-1"><input type="time" className={inputCls} value={s.stop} onChange={(e) => setDef(s.id, { stop: e.target.value })} /></td>
                                        <td className="px-2 py-1"><input type="number" min="0" className={inputCls + ' w-20'} value={s.heads} placeholder={s.crew ? String(rosterCount(s.crew, s.group)) : '0'} onChange={(e) => setDef(s.id, { heads: e.target.value })} title={`Counts as ${resolved} people`} /></td>
                                        <td className="px-2 py-1"><button type="button" className="text-slate-400 hover:text-[#E4002B]" onClick={() => delDef(s.id)} title="Remove"><XIcon className="w-4 h-4" /></button></td>
                                    </tr>
                                );
                            })}</tbody></table></div>
                    )}
                    <div className="grid md:grid-cols-2 gap-4">
                        {['production', 'sanitation'].map(g => (
                            <div key={g}>
                                <div className="text-[10px] font-black uppercase tracking-wider mb-1" style={{ color: SHIFT_GROUPS[g].color }}>{SHIFT_GROUPS[g].label} headcount this week, by hour</div>
                                <div className="border border-slate-200 rounded-lg overflow-hidden">
                                    <div className="flex text-[8px] text-slate-400 pl-8">{Array.from({ length: 24 }, (_, h) => <div key={h} className="flex-1 text-center">{h % 3 === 0 ? pad2(h) : ''}</div>)}</div>
                                    {grid[g].map((rowc, d) => (
                                        <div key={d} className="flex items-center">
                                            <div className="w-8 text-[9px] font-bold text-slate-500 pl-1">{DOW[d]}</div>
                                            {rowc.map((v, h) => <div key={h} className="flex-1 h-4 border-l border-white text-[8px] text-center leading-4" style={{ background: v > 0 ? SHIFT_GROUPS[g].color : '#F1F5F9', opacity: v > 0 ? Math.min(1, 0.35 + v / 12) : 1, color: v > 0 ? '#fff' : 'transparent' }} title={`${DOW[d]} ${pad2(h)}:00 · ${Math.round(v * 10) / 10} people`}>{v > 0 ? Math.round(v) : ''}</div>)}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )}
            {sub === 'roster' && (
                <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-4">
                    <div className="overflow-x-auto"><table className="text-xs"><thead><tr><th className={th}>People on roster</th>{CREWS.map(c => <th key={c} className={th + ' text-center'}>Crew {c}</th>)}</tr></thead>
                        <tbody>{['production', 'sanitation'].map(g => <tr key={g} className="border-t border-slate-100"><td className="px-2 py-1 font-black" style={{ color: SHIFT_GROUPS[g].color }}>{SHIFT_GROUPS[g].label}</td>{CREWS.map(c => <td key={c} className="px-2 py-1 text-center font-bold">{rosterCount(c, g)}</td>)}</tr>)}</tbody></table></div>
                    <div className="flex flex-wrap items-center gap-3">
                        <input className={inputCls + ' max-w-[240px]'} placeholder="Search name or job role" value={search} onChange={(e) => setSearch(e.target.value)} />
                        <div className="flex gap-1.5"><Chip on={!crewFilter} onClick={() => setCrewFilter('')}>All</Chip>{CREWS.map(c => <Chip key={c} on={crewFilter === c} onClick={() => setCrewFilter(c)}>{c}</Chip>)}</div>
                        <span className="text-xs text-slate-400">Click a Group to change it: Auto → Production → Sanitation → Exclude. Auto uses the job role (Sanitation / Cleaning = sanitation).</span>
                    </div>
                    {!empLoaded && <p className="text-sm text-slate-400">Loading the roster...</p>}
                    {empLoaded && employees.length === 0 && <p className="text-sm text-slate-500">No employees could be read from the employee table.</p>}
                    <div className="max-h-[480px] overflow-y-auto border border-slate-200 rounded-lg">
                        <table className="w-full text-xs"><thead className="sticky top-0 bg-slate-50"><tr><th className={th}>Name</th><th className={th}>Crew</th><th className={th}>Job role</th><th className={th}>Group</th></tr></thead>
                            <tbody>{filteredEmps.map(e => {
                                const g = rosterGroup(e, settings.rosterOverrides), forced = !!settings.rosterOverrides[e.id];
                                const sg = SHIFT_GROUPS[g];
                                return <tr key={e.id} className="border-t border-slate-100">
                                    <td className="px-2 py-1 font-semibold">{e.name}</td><td className="px-2 py-1">{e.crew || <span className="text-[#E4002B]">none</span>}</td><td className="px-2 py-1 text-slate-500">{e.jobRole || '-'}</td>
                                    <td className="px-2 py-1"><button type="button" onClick={() => cycle(e)} className="px-2 py-0.5 rounded border text-[10px] font-black uppercase" style={sg ? { background: sg.soft, color: sg.color, borderColor: sg.color } : { background: '#F1F5F9', color: '#64748B', borderColor: '#CBD5E1' }}>{g === 'lead' ? 'Lead / supervisor' : g === 'exclude' ? 'Excluded' : sg.label}{forced ? ' *' : ''}</button></td></tr>;
                            })}</tbody></table>
                    </div>
                </div>
            )}
        </div>
    );
}

// ============================================================================
// CLEANING TIMES per line
// ============================================================================
function CleaningView({ rows, assets, assetsByArea, settings, updateSettings, gaps, own, rosterCount, onJump, assetsLoaded }) {
    const [lineKey, setLineKey] = useState(rows.length ? rows[0].key : '');
    const [people, setPeople] = useState('');
    useEffect(() => { if (!lineKey && rows.length) setLineKey(rows[0].key); }, [rows.length]);
    const areaNames = useMemo(() => Object.keys(assetsByArea).sort(), [assetsByArea]);
    const cfg = settings.clean[lineKey] || {};
    const setCfg = (patch) => updateSettings(s => ({ ...s, clean: { ...s.clean, [lineKey]: { ...(s.clean[lineKey] || {}), ...patch } } }));
    const toggleArea = (a) => { const cur = cfg.areas || []; setCfg({ areas: cur.indexOf(a) >= 0 ? cur.filter(x => x !== a) : cur.concat([a]) }); };
    // Typical sanitation crew for the line: the average headcount of its sanitation shifts (or the fallback), changeable here.
    const effDefs = settings.shifts.filter(x => x.group === 'sanitation' && x.lineKey === (own[`${lineKey}|sanitation`] ? lineKey : '*'));
    const resolved = effDefs.map(x => x.heads !== '' && x.heads !== undefined ? Number(x.heads) : (x.crew ? rosterCount(x.crew, 'sanitation') : 0)).filter(h => h > 0);
    const typical = resolved.length ? Math.max(1, Math.round(resolved.reduce((a, b) => a + b, 0) / resolved.length)) : settings.cleanHeads;
    const ctxHeads = people !== '' ? Math.max(1, parseInt(people, 10) || 1) : typical;
    const needAt = (h) => ({
        base: cleanRequirement(null, { code: -1, allergen: false }, cfg, assetsByArea, h),
        alg: cleanRequirement({ code: -2, allergen: true, allergenType: '', crumb: false }, { code: -1, allergen: false }, cfg, assetsByArea, h),
    });
    const { base, alg } = needAt(ctxHeads);
    const mine = gaps.filter(g => g.lineKey === lineKey && g.end >= Date.now() - DAY).sort((a, b) => a.start - b.start).slice(0, 40);
    const th = "px-2 py-1.5 text-left text-[10px] font-black uppercase tracking-wider text-slate-500";
    const areaTotals = (a) => (assetsByArea[a] || []).reduce((n, x) => n + x.baseMins, 0);
    return (
        <div className="grid lg:grid-cols-2 gap-4">
            <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-3">
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Cleaning time for a line</h2>
                <Field label="Line"><select className={inputCls} value={lineKey} onChange={(e) => setLineKey(e.target.value)}>{rows.map(r => <option key={r.key} value={r.key}>{r.label}</option>)}</select></Field>
                <div>
                    <div className="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">Equipment areas cleaned on this line {assetsLoaded ? '' : '(loading...)'}</div>
                    {areaNames.length === 0 && <p className="text-xs text-slate-500">No equipment was read from the equipment table. The manual minutes below are used instead.</p>}
                    <div className="flex flex-wrap gap-1.5 max-h-40 overflow-y-auto">{areaNames.map(a => <Chip key={a} on={(cfg.areas || []).indexOf(a) >= 0} onClick={() => toggleArea(a)} title={`${(assetsByArea[a] || []).length} equipment, ${fmtMins(areaTotals(a))} of work`}>{a} · {(assetsByArea[a] || []).length}</Chip>)}</div>
                </div>
                <div className="grid grid-cols-2 gap-3">
