                <div className="flex flex-wrap items-center gap-2 mt-3">
                    {onRefreshAll && (
                        <Btn kind="primary" onClick={onRefreshAll} disabled={probing || !apiReady}>
                            {probing ? 'Refreshing & Testing...' : 'Refresh Dataverse & Test All Columns'}
                        </Btn>
