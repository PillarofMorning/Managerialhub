    }), [sheets]);
    const winnerOf = useMemo(() => { const w = {}; usable.forEach(sh => { w[sh.parsed.days[0].ymd] = sh.id; }); return w; }, [usable]);   // sorted by week then order read: the last one read wins
    const isUsed = (sh) => pick[sh.id] !== undefined ? pick[sh.id] : winnerOf[sh.parsed.days[0].ymd] === sh.id;
    const active = useMemo(() => usable.filter(sh => pick[sh.id] !== undefined ? pick[sh.id] : winnerOf[sh.parsed.days[0].ymd] === sh.id), [usable, pick, winnerOf]);
    const sheetById = useMemo(() => { const m = {}; sheets.forEach(sh => { m[sh.id] = sh; }); return m; }, [sheets]);
    const readOk = active.length > 0;
    // step 1 folds away once something was read (so steps 2 and 3 are in view) and opens again when everything is cleared
    useEffect(() => { setOpen({ s1: !readOk, s2: true, s3: true }); setFolded({}); }, [readOk]);
    const toggleStep = (k) => setOpen(o => ({ ...o, [k]: !o[k] }));

    const addSheets = (list, skip) => {
        setResult(null);
        setSheets(prev => {
            const names = {}; list.forEach(s => { names[s.name] = true; });
            const kept = prev.filter(s => !names[s.name]);
            const room = Math.max(0, MAX_SHEETS - kept.length), take = list.slice(0, room);
            if (take.length < list.length) skip.push({ name: `${list.length - take.length} more sheet${list.length - take.length === 1 ? '' : 's'}`, why: `only ${MAX_SHEETS} weeks are held at once: after applying, press Clear all (or remove sheets with the x) and add these again` });
            return kept.concat(take.map(s => ({ id: `s${seqRef.current}`, n: seqRef.current++, name: s.name, grid: s.grid, comments: s.comments || {}, weekStart: '', parsed: parseSheet(s.grid, { comments: s.comments }) })));
        });
