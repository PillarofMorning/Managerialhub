// GANTT: 1 day to 8 weeks. Drag to move (or to another line), drag the edges to change start / stop, drop past a
// neighbour's middle to swap the order, double-click to edit, double-click empty space to add.
// Includes Redzone Live Line Cards on the left rail and collapsible Supporting Sub-Rows with early clean offsets.
// ============================================================================
const GANTT_LABEL_W = 224;
const GRID_STEPS = [1, 2, 3, 4, 6, 12];
const NO_ITEMS = [];
const hourLabel = (h) => `${h % 12 || 12}${h >= 12 ? 'p' : 'a'}`;

const SupportSubRow = memo(function SupportSubRow({ sub, parentRow, parentVis, parentGaps, subVis, rangeFrom, rangeTo, rangeMs, trackW, showClean, api, searchQuery = '' }) {
    const pct = (ms) => ((ms - rangeFrom) / rangeMs) * 100;
    const offsetMs = (sub.offsetMins || 0) * 60000;
    const q = searchQuery ? searchQuery.trim().toLowerCase() : '';
    const subEmoji = sub.emoji || defaultEmojiForArea(sub.area);
    const eqpTip = sub.pieceNames && sub.pieceNames.length > 0
        ? `Supporting equipment attached to ${parentRow.label}:\n- ${sub.pieceNames.slice(0, 12).join('\n- ')}${sub.pieceNames.length > 12 ? `\n...and ${sub.pieceNames.length - 12} more` : ''}`
        : `Supporting area for ${parentRow.label}${sub.offsetMins > 0 ? ` (starts clean ${sub.offsetMins}m before ${parentRow.label} stops)` : ''}`;

    return (
        <div className="flex border-b border-indigo-200/80 bg-indigo-50/25 hover:bg-indigo-50/50 transition-colors" style={{ minHeight: 38 }} data-subline={sub.key}>
            <div className="flex-shrink-0 border-r-2 border-slate-300 border-l-4 border-l-indigo-500 pl-2.5 pr-2 py-1 flex flex-col justify-center bg-indigo-50/60 z-20 relative overflow-hidden" style={{ width: GANTT_LABEL_W }} title={eqpTip}>
                <div className="flex items-center justify-between gap-1">
                    <div className="flex items-center gap-1 min-w-0">
                        <span className="text-[12px] leading-none flex-shrink-0">{subEmoji}</span>
                        <span className="font-bold text-[11px] text-indigo-950 truncate">{sub.area}</span>
                    </div>
                    {sub.offsetMins > 0 ? (
                        <span className="px-1 py-0.2 rounded bg-amber-100 text-amber-900 border border-amber-300 text-[8.5px] font-black flex-shrink-0" title={`${sub.area} starts its clean ${sub.offsetMins} minutes before ${parentRow.label} stops`}>-{sub.offsetMins}m clean</span>
                    ) : (
                        <span className="px-1 py-0.2 rounded bg-indigo-100 text-indigo-800 border border-indigo-200 text-[8.5px] font-black flex-shrink-0">Support</span>
                    )}
                </div>
                <div className="flex items-center justify-between gap-1 text-[9.5px] text-indigo-700/85 font-semibold truncate">
                    <span className="truncate">Supports {parentRow.label}</span>
                    {sub.pieceCount > 0 && <span className="text-[9px] font-bold text-slate-600 flex-shrink-0">{sub.pieceCount} eqp</span>}
                </div>
            </div>
            <div className="flex-1 relative"
                onDoubleClick={(e) => {
                    if (e.target.closest && e.target.closest('[data-run],[data-gap]')) return;
                    api.addAt({ key: lineKeyOf(sub.area, 1), area: sub.area, line: 1, label: sub.area }, e.clientX);
                }}>
                {/* Synchronized support feed bars aligned with parent line runs (stopping offsetMins early if clean follows) */}
                {parentVis.map(r => {
                    if (isMaint(r)) return null;
                    const feedEnd = offsetMs > 0 ? Math.max(r.start + 15 * 60000, r.end - offsetMs) : r.end;
                    const l = Math.max(rangeFrom, r.start), r2 = Math.min(rangeTo, feedEnd);
                    if (r2 <= l) return null;
                    const w = ((r2 - l) / rangeMs) * trackW;
                    const tip = `${sub.area} feeding ${parentRow.label} (${r.product})\nFeed start: ${fmtDT(r.start)}\nFeed stop: ${fmtDT(feedEnd)}${sub.offsetMins > 0 ? ` (${sub.offsetMins}m before ${parentRow.label} stops at ${fmtTime(r.end)} so ${sub.area} can begin early clean)` : ''}`;
                    return (
                        <div key={`feed-${r.id}`} title={tip}
                            className="absolute rounded-sm border border-dashed border-indigo-400/80 bg-indigo-500/15 text-indigo-950 text-[9px] px-1.5 flex items-center overflow-hidden z-[4]"
                            style={{ left: `${pct(l)}%`, width: `${Math.max(((r2 - l) / rangeMs) * 100, 0.15)}%`, top: 5, height: 26 }}>
                            {w > 55 && <span className="truncate font-bold pointer-events-none">{subEmoji} Feed: {r.product}{sub.offsetMins > 0 && w > 155 ? ` (-${sub.offsetMins}m stop)` : ''}</span>}
                        </div>
                    );
                })}
                {/* Early-Offset Clean Windows for this Supporting Area */}
                {showClean && parentGaps.map(g => {
                    const sw = (g.supportWindows || []).find(w => canon(w.area) === canon(sub.area));
                    const earlyStart = sw ? sw.earlyStart : (g.start - offsetMs);
                    const cleanMins = sw && sw.mins > 0 ? sw.mins : (g.mins || 90);
                    const cleanEnd = sw ? sw.cleanEnd : Math.max(g.end, earlyStart + cleanMins * 60000);
                    const l = Math.max(rangeFrom, earlyStart), r2 = Math.min(rangeTo, cleanEnd);
                    if (r2 <= l) return null;
                    const w = ((r2 - l) / rangeMs) * trackW;
                    const tip = `${sub.area} Supporting Clean Window (for ${parentRow.label})\nEarly Clean Start: ${fmtDT(earlyStart)}${sub.offsetMins > 0 ? ` (${sub.offsetMins}m BEFORE ${parentRow.label} stops at ${fmtTime(g.start)})` : ''}\nClean Target End: ${fmtDT(cleanEnd)} (${fmtMins(cleanMins)})\n${sub.pieceCount > 0 ? `Equipment: ${sub.pieceCount} piece(s)` : ''}`;
                    return (
                        <div key={`sclean-${g.prevId}-${g.nextId}`} data-gap="1" title={tip}
                            className="absolute rounded-sm border border-amber-500 bg-amber-100/90 text-amber-950 text-[8.5px] font-black overflow-hidden whitespace-nowrap flex items-center justify-center z-[8] shadow-xs"
                            style={{ left: `${pct(l)}%`, width: `${Math.max(((r2 - l) / rangeMs) * 100, 0.2)}%`, top: 4, height: 28, backgroundImage: 'repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(217,119,6,0.12) 4px, rgba(217,119,6,0.12) 8px)' }}>
                            {w > 34 && (sub.offsetMins > 0
                                ? (w > 115 ? `EARLY CLEAN (-${sub.offsetMins}m) ${fmtMins(cleanMins)}` : `-${sub.offsetMins}m CLEAN`)
                                : (w > 85 ? `SUPP CLEAN ${fmtMins(cleanMins)}` : 'CLEAN'))}
                        </div>
                    );
                })}
                {/* Any direct dedicated runs scheduled specifically on the supporting area */}
                {(subVis || []).map(r => {
                    const l = Math.max(rangeFrom, r.start), r2 = Math.min(rangeTo, r.end);
                    if (r2 <= l) return null;
                    const w = ((r2 - l) / rangeMs) * trackW;
                    const matchesRun = !q || ((r.product && r.product.toLowerCase().includes(q)) || (r.code && String(r.code).toLowerCase().includes(q)));
                    return (
                        <div key={r.id} data-run="1" title={`${runTitle(r)} (${sub.area})\n${fmtDT(r.start)} to ${fmtDT(r.end)}`}
                            onPointerDown={(e) => api.down(e, r, 'move')}
                            onDoubleClick={(e) => { e.stopPropagation(); api.open(r); }}
                            className={`absolute rounded-sm shadow-xs border border-indigo-700 bg-indigo-700 text-white text-[9px] px-1.5 flex items-center overflow-hidden z-10 cursor-grab ${q && !matchesRun ? 'opacity-35' : ''}`}
                            style={{ left: `${pct(l)}%`, width: `${Math.max(((r2 - l) / rangeMs) * 100, 0.15)}%`, top: 5, height: 26 }}>
                            {w > 24 && <span className="truncate font-bold pointer-events-none">{r.product}</span>}
                        </div>
                    );
                })}
            </div>
        </div>
    );
});

const GanttRow = memo(function GanttRow({ row, rowIndex = 0, vis, rowGaps, occProd, occSan, rangeFrom, rangeTo, rangeMs, trackW, showClean, stripH, selId, dragId, gh, issueMap, uncoveredMap, api, searchQuery = '', nowMs, isExpanded = false, onToggleSupport, lineCallouts = NO_ITEMS, casesProducedMap = {}, onOpenCallout }) {
    const pct = (ms) => ((ms - rangeFrom) / rangeMs) * 100;
    const rowH = 52 + stripH * 2 + (stripH ? 3 : 0);
    const rowHours = vis.reduce((s, r) => s + (isMaint(r) ? 0 : (Math.min(rangeTo, r.end) - Math.max(rangeFrom, r.start)) / HOUR), 0);
    const rowCases = vis.reduce((s, r) => s + (isMaint(r) || !r.cases ? 0 : Number(r.cases) || 0), 0);
    const utilPct = Math.min(100, Math.round((rowHours / (rangeMs / HOUR)) * 100));
    const q = searchQuery ? searchQuery.trim().toLowerCase() : '';

    const rowHasShortClean = rowGaps.some(g => g.end > rangeFrom && g.start < rangeTo && (g.status === 'short' || g.status === 'nocrew' || g.status === 'overlap'));
    const rowMajorCleans = rowGaps.filter(g => g.end > rangeFrom && g.start < rangeTo && isMajorCleanKind(g.kind));
    const activeRunNow = nowMs ? vis.find(r => nowMs >= r.start && nowMs < r.end) : null;
    const activeGapNow = nowMs && !activeRunNow ? rowGaps.find(g => nowMs >= g.start && nowMs < g.end) : null;
    const openCallouts = (lineCallouts || []).filter(c => !c.resolved);
    const emoji = row.emoji || defaultEmojiForArea(row.area);
    const subCount = row.supportSubRows ? row.supportSubRows.length : 0;

    let statusBadge = null;
    if (openCallouts.length > 0) {
        statusBadge = <span className="px-1.5 py-0.5 rounded bg-[#FDE8EC] text-[#B00020] border border-[#E4002B] text-[8.5px] font-black flex-shrink-0 animate-pulse" title={`${openCallouts.length} active floor callout(s): ${openCallouts.map(c => c.type + ' - ' + c.note).join('; ')}`}>ALERT ({openCallouts.length})</span>;
    } else if (rowHasShortClean) {
        statusBadge = <span className="px-1.5 py-0.5 rounded bg-[#FDE8EC] text-[#B00020] border border-[#E4002B]/40 text-[8.5px] font-black flex-shrink-0" title="One or more cleans on this line are short or overlapping">SHORT</span>;
    } else if (activeRunNow) {
        statusBadge = isMaint(activeRunNow)
            ? <span className="px-1.5 py-0.5 rounded bg-slate-800 text-amber-300 border border-slate-700 text-[8.5px] font-black flex-shrink-0">MAINT</span>
            : <span className="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-400 text-[8.5px] font-black flex-shrink-0" title={`Running now: ${activeRunNow.product}`}>RUN</span>;
    } else if (activeGapNow) {
        statusBadge = <span className="px-1.5 py-0.5 rounded bg-sky-100 text-sky-800 border border-sky-300 text-[8.5px] font-black flex-shrink-0">CLEAN</span>;
    } else if (rowMajorCleans.length > 0) {
        statusBadge = <span className="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-300 text-[8.5px] font-black flex-shrink-0" title={`${rowMajorCleans.length} major clean(s) scheduled in view`}>Cleans: {rowMajorCleans.length}</span>;
    }

    return (
        <div ref={(el) => api.row(row.key, el)} data-line={row.key} className={`flex border-b border-slate-200 transition-colors group ${rowIndex % 2 === 0 ? 'bg-slate-50/30' : 'bg-white'} hover:bg-[#E6F1FB]/30`} style={{ minHeight: rowH }}>
            <div className="flex-shrink-0 border-r-2 border-slate-300 px-2.5 py-1.5 flex flex-col justify-center bg-slate-50 z-20 relative overflow-hidden" style={{ width: GANTT_LABEL_W }}>
                <div className="flex items-center justify-between gap-1">
                    <div className="flex items-center gap-1.5 min-w-0">
                        <span className="text-[14px] leading-none flex-shrink-0" title={`Line icon for ${row.area}`}>{emoji}</span>
                        <span className="font-bold text-[12.5px] text-[#00468B] leading-tight truncate" title={row.label}>{row.label}</span>
                    </div>
                    {statusBadge}
                </div>
                <div className="flex items-center justify-between gap-1 mt-0.5">
                    <span className="text-[10px] text-slate-500 font-medium truncate">
                        {vis.length} runs - {Math.round(rowHours)}h ({utilPct}%){rowCases > 0 ? ` - ${fmtNum(rowCases)} cs` : ''}
                    </span>
                    <div className="flex items-center gap-1 flex-shrink-0">
                        {onOpenCallout && (
                            <button type="button" onClick={(e) => { e.stopPropagation(); onOpenCallout({ area: row.area, line: row.line, lineKey: row.key, label: row.label }); }}
                                className="opacity-0 group-hover:opacity-100 focus:opacity-100 px-1 py-0.2 rounded border border-slate-300 bg-white hover:bg-rose-50 hover:border-rose-300 text-[8.5px] font-bold text-slate-600 hover:text-rose-700 transition-opacity"
                                title="Log a Redzone Floor Callout on this line">+Alert</button>
                        )}
                        {subCount > 0 && onToggleSupport && (
                            <button type="button" onClick={(e) => { e.stopPropagation(); onToggleSupport(row.key); }}
                                className={`px-1.5 py-0.2 rounded border text-[8.5px] font-black transition-colors ${isExpanded ? 'bg-indigo-600 text-white border-indigo-700' : 'bg-indigo-50 text-indigo-800 border-indigo-300 hover:bg-indigo-100'}`}
                                title={`${isExpanded ? 'Hide' : 'Show'} ${subCount} supporting area sub-row(s): ${row.supportSubRows.map(s => s.area + (s.offsetMins > 0 ? ' (-' + s.offsetMins + 'm)' : '')).join(', ')}`}>
                                {isExpanded ? `v ${subCount} Supp` : `+${subCount} Supp`}
                            </button>
                        )}
                    </div>
                </div>
                <div className="absolute bottom-0 left-0 right-0 h-[3px] bg-slate-200">
                    <div className={`h-full transition-all ${openCallouts.length > 0 || rowHasShortClean ? 'bg-[#E4002B]' : activeRunNow ? 'bg-emerald-500' : 'bg-[#0072CE]'}`} style={{ width: `${utilPct}%` }} />
                </div>
            </div>
            <div className="flex-1 relative"
                onDoubleClick={(e) => {
                    if (e.target.closest && e.target.closest('[data-run],[data-gap],[data-callout]')) return;
                    api.addAt(row, e.clientX);
                }}>
                {/* shift overlay: production and sanitation headcount */}
                {stripH > 0 && [['production', occProd], ['sanitation', occSan]].map((pair, gi) => {
                    const g = pair[0], list = pair[1];
                    return (
                        <div key={g} className="absolute left-0 right-0" style={{ bottom: gi === 0 ? stripH + 2 : 1, height: stripH - 1 }}>
                            {list.map((o, i) => {
                                const l = Math.max(rangeFrom, o.start), r2 = Math.min(rangeTo, o.end), w = ((r2 - l) / rangeMs) * trackW;
                                const sg = SHIFT_GROUPS[g];
                                return <div key={i} className="absolute top-0 bottom-0 rounded-sm overflow-hidden whitespace-nowrap text-[8px] font-black leading-none flex items-center px-0.5 border"
                                    style={{ left: `${pct(l)}%`, width: `${((r2 - l) / rangeMs) * 100}%`, background: sg.soft, borderColor: sg.color, color: sg.color }}
                                    title={`${sg.label}${o.label ? ' ' + o.label : ''}${o.crew ? ' crew ' + o.crew : ''}: ${o.heads} people, ${fmtTime(o.start)} to ${fmtTime(o.end)}`}>
                                    {w > 26 ? `${sg.short} ${o.heads}` : ''}{w > 90 && o.label ? ` ${o.label}` : ''}
                                </div>;
                            })}
                        </div>
                    );
                })}
                {/* cleaning windows between runs */}
                {showClean && rowGaps.map(g => {
                    const l = Math.max(rangeFrom, g.start), r2 = Math.min(rangeTo, g.end);
                    if (r2 <= l) return null;
                    const st = GAP_STYLE[g.status] || GAP_STYLE.none, w = ((r2 - l) / rangeMs) * trackW;
                    const kShort = g.kind === 'weekly' ? 'EOW' : g.kind === 'midweek' ? '72h' : g.kind === 'allergen' ? 'ALRG' : g.kind === 'full' ? 'DAILY' : (CLEAN_KINDS[g.kind] ? CLEAN_KINDS[g.kind].short : '');
                    const hasEarlySupp = g.supportWindows && g.supportWindows.some(sw => sw.offsetMins > 0);
                    return <div key={g.prevId + g.nextId} data-gap="1" className="absolute rounded-sm border text-[9px] font-black overflow-hidden whitespace-nowrap flex items-center justify-center z-[5]"
                        style={{ left: `${pct(l)}%`, width: `${((r2 - l) / rangeMs) * 100}%`, top: 8, height: 36, background: st.bg, borderColor: st.border, color: st.text, backgroundImage: 'repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(0,0,0,0.04) 5px, rgba(0,0,0,0.04) 10px)' }}
                        title={`${st.label}\n${gapText(g)}`}>
                        {w > 30 && (g.status === 'overlap' ? 'OVERLAP' : g.status === 'nocrew' ? (w > 110 ? `${CLEAN_KINDS[g.kind].short} - NO CREW` : 'NO CREW') : !(g.mins > 0) ? fmtHrs(g.gapMs) : w > 120 ? `${CLEAN_KINDS[g.kind].short} ${fmtMins(g.mins)} / ${fmtHrs(g.gapMs)}${hasEarlySupp && w > 170 ? ' (+Supp)' : ''}` : w > 52 ? `${kShort} ${fmtMins(g.mins)}` : kShort || fmtHrs(g.gapMs))}
                    </div>;
                })}
                {/* runs */}
                {vis.map(r => {
                    const l = Math.max(rangeFrom, r.start), r2 = Math.min(rangeTo, r.end);
                    const w = ((r2 - l) / rangeMs) * trackW;
                    const maint = isMaint(r), sel = selId === r.id, dragging = dragId === r.id;
                    const actualCases = r.casesProduced !== undefined && r.casesProduced !== null && r.casesProduced !== '' ? Number(r.casesProduced) : (casesProducedMap[r.id] !== undefined ? Number(casesProducedMap[r.id]) : null);
                    const casePct = r.cases > 0 && actualCases !== null && !isNaN(actualCases) ? Math.min(100, Math.round((actualCases / r.cases) * 100)) : null;
                    const bg = maint 
                        ? 'bg-slate-900 border-slate-700 text-white' 
                        : r.allergen 
                            ? 'bg-gradient-to-b from-[#FFC436] to-[#FFB81C] border-[#B27B00] text-slate-900 shadow-xs hover:brightness-105' 
                            : 'bg-gradient-to-b from-[#0072CE] to-[#005BA4] border-[#00468B] text-white shadow-xs hover:brightness-105 transition-shadow';
                    const bad = issueMap[r.id] === 'overlap', unc = uncoveredMap[r.id];
                    const matchesRun = !q || (
                        (r.product && r.product.toLowerCase().includes(q)) ||
                        (r.code && String(r.code).toLowerCase().includes(q)) ||
                        (r.order && String(r.order).toLowerCase().includes(q)) ||
                        (r.notes && r.notes.toLowerCase().includes(q)) ||
                        (row.label && row.label.toLowerCase().includes(q))
                    );
                    const matchCls = q ? (matchesRun ? 'ring-2 ring-[#FFB81C] shadow-md z-20' : 'opacity-35') : '';
                    const tip = `${runTitle(r)}\n${fmtDT(r.start)} to ${fmtDT(r.end)} (${fmtHrs(r.end - r.start)})${r.cases ? `\nTarget: ${fmtNum(r.cases)} cases${actualCases !== null ? ` - Produced: ${fmtNum(actualCases)} cs (${casePct}%)` : ''}` : ''}${r.order ? `\nOrder ${r.order}` : ''}${r.allergen ? `\nAllergen${r.allergenType ? ': ' + r.allergenType : ''}` : ''}${r.notes ? `\nNotes: ${clipText(r.notes, 300)}` : ''}${unc ? `\nNo production shift for ${fmtHrs(unc)} of this run` : ''}\nDrag to move, drag an edge to resize, double-click to edit`;
                    return (
                        <div key={r.id} data-run="1" title={tip}
                            onPointerDown={(e) => api.down(e, r, 'move')}
                            onDoubleClick={(e) => { e.stopPropagation(); api.open(r); }}
                            className={`absolute rounded-sm shadow-sm border text-[10px] px-1.5 py-0.5 flex flex-col justify-center overflow-hidden z-10 cursor-grab active:cursor-grabbing ${bg} ${sel ? 'ring-2 ring-offset-1 ring-[#E4002B]' : ''} ${bad ? 'outline outline-2 outline-[#E4002B]' : ''} ${dragging ? 'opacity-40' : ''} ${matchCls}`}
                            style={{ left: `${pct(l)}%`, width: `${Math.max(((r2 - l) / rangeMs) * 100, 0.15)}%`, top: 8, height: 36, touchAction: 'none', borderTop: unc ? '4px solid #F97316' : undefined }}>
                            {r.start >= rangeFrom && <div onPointerDown={(e) => api.down(e, r, 'start')} className="absolute left-0 top-0 bottom-0 w-[6px] cursor-ew-resize hover:bg-white/40" />}
                            {r.end <= rangeTo && <div onPointerDown={(e) => api.down(e, r, 'end')} className="absolute right-0 top-0 bottom-0 w-[6px] cursor-ew-resize hover:bg-white/40" />}
                            {r.notes && w > 14 && <span className="absolute right-1 top-0 text-[10px] leading-none pointer-events-none opacity-90" data-note="1" aria-label="has notes">*</span>}
                            {w > 22 && <span className="truncate leading-tight font-bold pointer-events-none">{maint ? 'MAINTENANCE' : r.product}</span>}
                            {w > 110 && <span className="truncate leading-none text-[9px] opacity-90 pointer-events-none">{fmtHrs(r.end - r.start)}{r.cases ? ` - ${actualCases !== null ? `${fmtNum(actualCases)}/` : ''}${fmtNum(r.cases)} cs` : ''}{r.order ? ` - #${r.order}` : ''}{r.allergen ? ' - ALLERGEN' : ''}</span>}
                            {casePct !== null && (
                                <div className="absolute bottom-0 left-0 right-0 h-[3px] bg-black/25 pointer-events-none">
                                    <div className={`h-full ${casePct >= 95 ? 'bg-emerald-300' : casePct >= 75 ? 'bg-amber-300' : 'bg-rose-400'}`} style={{ width: `${casePct}%` }} />
                                </div>
                            )}
                        </div>
                    );
                })}
                {/* Redzone floor callout pins */}
                {openCallouts.map(c => {
                    const cMs = c.atMs || nowMs;
                    if (cMs < rangeFrom || cMs > rangeTo) return null;
                    return (
                        <button key={c.id} type="button" data-callout="1"
                            onClick={(e) => { e.stopPropagation(); if (onOpenCallout) onOpenCallout({ area: row.area, line: row.line, lineKey: row.key, label: row.label, calloutId: c.id }); }}
                            title={`Redzone Floor Callout (${c.type}): ${c.note}\nLogged at ${fmtDT(cMs)} - Click to view or resolve`}
                            className="absolute top-0.5 z-[22] px-1.5 py-0.2 rounded-full bg-[#E4002B] text-white border border-white shadow-md text-[8px] font-black uppercase tracking-wider hover:scale-105 transition-transform"
                            style={{ left: `${pct(cMs)}%`, transform: 'translateX(-50%)' }}>
                            {c.type}
                        </button>
                    );
                })}
                {gh && (
                    <div className="absolute rounded-sm border-2 border-dashed z-[25] pointer-events-none flex items-center justify-center text-[10px] font-black"
                        style={{ left: `${pct(Math.max(rangeFrom, gh.start))}%`, width: `${Math.max(((Math.min(rangeTo, gh.end) - Math.max(rangeFrom, gh.start)) / rangeMs) * 100, 0.2)}%`, top: 6, height: 40,
