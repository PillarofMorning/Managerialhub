                        </div>
                        <p className="text-xs text-slate-600 mt-1 max-w-4xl">
                            Groups all similar runs by SKU and product description, assigns their authoritative attributes from <b>Equipment Assets ({TABLE_ASSETS})</b> (canonical Line/Area Name, Line #, Area GUID, Clean/Allergen Minutes, SAP Codes) and <b>SKU Master</b>, Purges <b>0-run ghost lines</b> (such as <code>"Waterjet Line 1"</code> with 0 runs), and repairs <b>email/import mishaps</b>.
                        </p>
                    </div>
                    <div className="flex flex-wrap items-center gap-2">
                        {!running ? (
                            <Btn kind="ghost" disabled={fixBusy} onClick={() => startAudit({ kind: 'all' })} title="Scan every run in the Dataverse table so all historical and future runs are included in Similar Run Clusters">
                                Scan All Dataverse Runs ({fmtNum(stdData.allRuns.length)} loaded)
                            </Btn>
                        ) : (
                            <Btn kind="danger" onClick={cancelAudit}>Stop Scan</Btn>
                        )}
