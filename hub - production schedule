function parseDelimited(text) {
    const rows = []; let row = [], cell = '', inQ = false;
    const t = String(text || '').replace(/\r\n?/g, '\n');
    const delim = t.indexOf('\t') >= 0 ? '\t' : ',';
    for (let i = 0; i < t.length; i++) {
        const ch = t[i];
        if (inQ) { if (ch === '"') { if (t[i + 1] === '"') { cell += '"'; i++; } else inQ = false; } else cell += ch; }
        else if (ch === '"' && cell === '') inQ = true;
        else if (ch === delim) { row.push(cell); cell = ''; }
        else if (ch === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; }
        else cell += ch;
    }
    row.push(cell);
    if (row.length > 1 || row[0] !== '') rows.push(row);
    return rows;
}
const WEEKDAYS = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
function weekdayIndex(v) {
    const t = String(v === null || v === undefined ? '' : v).trim().toLowerCase();
    if (t.length < 3) return -1;
    for (let i = 0; i < 7; i++) if (WEEKDAYS[i].indexOf(t) === 0 || t.indexOf(WEEKDAYS[i]) === 0) return i;
    return -1;
}
function cellStr(v) {
