                        <div role="option" aria-selected={hi === shown.length} data-i={shown.length} onClick={() => pick(shown.length)} onMouseMove={() => { if (hi !== shown.length) setHi(shown.length); }}
                            className={`px-3 py-1.5 cursor-pointer border-t border-slate-100 text-xs font-bold ${hi === shown.length ? 'bg-[#FFF6E0] text-slate-800' : 'text-slate-600'}`}>
                            Use "{text.trim()}" {newWord || 'as typed'}
