        employees.forEach(e => { const g = rosterGroup(e, settings.rosterOverrides); if (!e.crew || (g !== 'production' && g !== 'sanitation')) return; const k = `${e.crew}|${g}`; t[k] = (t[k] || 0) + 1; });
        return t;
    }, [employees, settings.rosterOverrides]);
    const rosterCount = (crew, group) => rosterTable[`${crew}|${group}`] || 0;

    // Runs for a date window: one filtered read, merged by id; remembered so a window is not fetched twice.
    const want = tab === 'month' ? [new Date(month.getFullYear(), month.getMonth(), 1 - 7).getTime(), new Date(month.getFullYear(), month.getMonth() + 1, 8).getTime()]
        : [addDaysLocal(new Date(view.from), -14).getTime(), addDaysLocal(new Date(view.from), view.days + 14).getTime()];
    const wantKey = `${tab === 'month' ? 'm' : 's'}|${want[0]}|${want[1]}`;
    useEffect(() => {
        if (!apiReady || (tab !== 'schedule' && tab !== 'month' && tab !== 'cleaning')) return;
        const [f, t] = want;
        if (loadedRef.current.some(([a, b]) => a <= f && b >= t)) return;
        let alive = true;
        const timer = setTimeout(async () => {
            const rows = await queryRecords(TABLE_PROD, dataApiRef.current, { filter: `statecode eq 0 and craa5_datestarttime lt ${isoZ(t)} and craa5_dateendtime gt ${isoZ(f)}`, orderby: 'craa5_datestarttime asc', top: RANGE_LIMIT });
            if (!alive) return;
            if (rows === null) { setIssues(p => ({ ...p, runs: 'Runs could not be loaded for this period. Press Reload.' })); return; }
            const truncated = rows.length >= RANGE_LIMIT;
            setIssues(p => { const n = { ...p }; if (truncated) n.cap = `Only the first ${RANGE_LIMIT} runs of this period are shown. Pick a shorter range.`; else delete n.cap; delete n.runs; return n; });
            if (!truncated) loadedRef.current = loadedRef.current.concat([[f, t]]);
            noteKeys('runs', rows);
            const fresh = rows.map(r => normRun(r, sideRef.current)), freshIds = {};
            fresh.forEach(r => { freshIds[r.id] = true; });
            const recent = (id) => Date.now() - (touchedRef.current[id] || 0) < 60000;
            setRuns(prev => {
                const m = {};
                prev.forEach(r => { if (truncated || freshIds[r.id] || !(r.start < t && r.end > f) || recent(r.id)) m[r.id] = r; });
                fresh.forEach(r => { if (!recent(r.id)) m[r.id] = r; });
                return Object.keys(m).map(k => m[k]).sort(byStart);
            });
        }, 250);
        return () => { alive = false; clearTimeout(timer); };
    }, [apiReady, wantKey, reloadTick, tab === 'schedule' || tab === 'month' || tab === 'cleaning']);   // coming back to a tab after an import (which clears what was loaded) reads the runs again
    const reload = () => { loadedRef.current = []; colStateRef.current.refused = {}; colStateRef.current.probed = {}; setReloadTick(n => n + 1); };   // Reload also tries the optional columns again

    // ------------------------------------------------------------------------
    // WRITES (Dataverse when available; in preview mode they only change this screen)
    // ------------------------------------------------------------------------
    const writer = () => {
        const w = getWriteApi(dataApiRef.current);
        if (w) return w;
        if (!apiReady) return { create: async () => `mem${memIdRef.current++}`, update: async () => {}, remove: async () => {} };
        return null;
    };
    // Browser-kept copy of Order # / Cases / Notes for runs whose Dataverse columns refused them, so the value still shows.
    const lastDropRef = useRef([]);   // Order # / Cases / Notes the last dialog save could not store in Dataverse
    const sideTimer = useRef(null), sideSkipRef = useRef(0), sideProbed = useRef(false);
    const flushSide = () => { if (sideTimer.current) { clearTimeout(sideTimer.current); sideTimer.current = null; lsWrite(LS_SIDE, sideRef.current); } };
    const scheduleSide = () => {
        if (!sideProbed.current) { sideProbed.current = true; lsWrite(LS_SIDE, sideRef.current); }   // the first write is straight away, so a blocked or full browser store is known at once
        if (!sideTimer.current) sideTimer.current = setTimeout(() => { sideTimer.current = null; lsWrite(LS_SIDE, sideRef.current); }, 1000);   // then at most one write a second
    };
    const rememberSide = (id, extras, dropped) => {
        if (!id) return;
        const d = dropped || [], x = extras || {}, keep = {};
        if (d.indexOf(F_ORDER) >= 0 && x.order) keep.order = x.order;
        if (d.indexOf(F_CASES) >= 0 && x.cases !== null && x.cases !== undefined && x.cases !== '' && !isNaN(Number(x.cases))) keep.cases = Math.round(Number(x.cases));
        if (d.indexOf(F_NOTES) >= 0 && x.notes) keep.notes = x.notes;
        const next = sideRef.current, had = !!next[id], has = Object.keys(keep).length > 0;
        if (!has && !had) return;
        if (has) { if (!had && Object.keys(next).length >= SIDE_MAX) { sideSkipRef.current++; return; } next[id] = keep; } else delete next[id];
        scheduleSide();
    };
    const forgetSide = (id) => { if (sideRef.current[id]) { delete sideRef.current[id]; scheduleSide(); } };   // a deleted run gives its place back
    useEffect(() => {
        window.addEventListener('pagehide', flushSide);
        return () => { window.removeEventListener('pagehide', flushSide); flushSide(); };
    }, []);

    // ------------------------------------------------------------------------
    // PAYLOADS. Every save goes through deliver(): it sends the run's columns plus the optional ones (Order #, Cases, Notes, MSS area id,
    // Imported from), and when Dataverse refuses an optional column it names it, remembers it for this visit and sends the rest again, so a
    // missing column never blocks scheduling. What was sent, what was refused and what came back is kept for the Data Check tab (newest last).
    // ------------------------------------------------------------------------
    const payloadsRef = useRef([]);
    const payloadSeq = useRef(0);
    const colStateRef = useRef({ refused: {}, sent: {}, probed: {} });   // column -> reason it was refused / rows that carried it / 'found' | 'missing' from the column test
    const seenKeysRef = useRef({});                                       // table key -> { lower-case column name: true } seen on rows that were read
    const [payloadTick, setPayloadTick] = useState(0);
    const tickTimer = useRef(null);
    const bumpPayloads = () => { if (tickTimer.current) return; tickTimer.current = setTimeout(() => { tickTimer.current = null; setPayloadTick(n => n + 1); }, 350); };   // at most ~3 redraws a second, even in a 5,000-run upload
    useEffect(() => () => { clearTimeout(tickTimer.current); clearTimeout(noticeTimer.current); }, []);
    const logPayload = (entry) => {
        const e = { n: ++payloadSeq.current, t: Date.now(), ...entry };
        const list = payloadsRef.current; list.push(e);
        if (list.length > PAYLOAD_KEEP) list.splice(0, list.length - PAYLOAD_KEEP);
        bumpPayloads();
        return e;
    };
    const noteKeys = (table, rows) => {
        const o = seenKeysRef.current[table] = seenKeysRef.current[table] || {};
        for (let i = 0; i < Math.min(rows.length, 25); i++) Object.keys(rows[i]).forEach(k => { o[k.toLowerCase()] = true; });
    };
    const mssIdx = useMemo(() => mssIndex(areas), [areas]);
    const mssIdxRef = useRef(mssIdx); mssIdxRef.current = mssIdx;
    const areaIdFor = (area) => { const it = mssIdxRef.current.byName[String(area === undefined || area === null ? '' : area).trim()]; return it ? it.id : ''; };
    const cpTouchRef = useRef(null);   // the Clean Plan hears of every saved run change (see CLEAN PLAN below)
    const deliver = async (op, id, required, optional, meta) => {
        const w = writer();
        if (!w) throw new Error("No Dataverse write connection in this environment. Nothing was saved.");
        const st = colStateRef.current, wanted = Object.keys(optional || {});
        let cols = wanted.filter(c => !(apiReady && st.refused[c]));
        const generic = [];   // columns blamed because an error named none: only believed once the retry without them went through
        let res = null, failure = null, body = {};
        for (let attempt = 0; attempt <= wanted.length; attempt++) {   // Dataverse names one unknown column per answer, so every optional column may cost one more try
            body = { ...required }; cols.forEach(c => { body[c] = optional[c]; });
            try { res = op === 'create' ? await w.create(TABLE_PROD, body) : await w.update(TABLE_PROD, id, body); failure = null; break; }
            catch (e) {
                failure = e;
                const bad = apiReady && cols.length ? badColumns(e, cols) : [];
                if (!bad.length) break;
                const msg = errText(e).toLowerCase();
                bad.forEach(c => { if (msg.indexOf(c.toLowerCase()) >= 0) st.refused[c] = errText(e); else generic.push(c); });   // a named column is refused at once; the others only after the retry works
