// IMPORT WEEK
// ============================================================================
const STATUS_LOOK = {
    new: { label: 'NEW', cls: 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' },
    update: { label: 'UPDATE', cls: 'bg-[#E6F1FB] text-[#00468B] border-[#0072CE]' },
    same: { label: 'ALREADY THERE', cls: 'bg-slate-100 text-slate-500 border-slate-300' },
    clash: { label: 'CLASH', cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
};
// Which MSS line a sheet line belongs on: the same name ignoring spaces and dashes ("IBL 4" is IBL4), else "IBL 4" as area IBL line 4,
// else the longest area name found inside the sheet name ("Breading Night"), else the only area whose name holds the sheet name.
function guessArea(label, areaOptions) {
    const r = resolveArea(label, areaOptions);
    if (r.exact) return { area: r.area, line: r.line > 1 ? r.line : 1 };
    const cl = canon(label);
    if (!cl) return { area: '', line: 1 };
    const inside = areaOptions.filter(a => canon(a) && cl.indexOf(canon(a)) >= 0).sort((x, y) => canon(y).length - canon(x).length);
    if (inside.length) return { area: inside[0], line: 1 };
    const holds = areaOptions.filter(a => canon(a).indexOf(cl) >= 0);
    return holds.length === 1 ? { area: holds[0], line: 1 } : { area: '', line: 1 };
}
function guessLineCfg(label, areaOptions, prevCfg) {
    const preset = presetForLabel(label);
    const guess = guessArea(label, areaOptions);
    if (prevCfg) {
        // a line that never found its area (an older guess missed "IBL 4" against IBL4) tries again; one the person cleared or picked (areaSet) is left alone
        const pc = !prevCfg.area && !prevCfg.areaSet && guess.area ? { ...prevCfg, area: guess.area, line: Number(prevCfg.line) > 1 ? prevCfg.line : guess.line } : prevCfg;
        if (pc.pattern) return pc;
        // saved before line patterns existed: settings still at the old defaults take this line's pattern, anything typed by hand stays
        const untouched = pc.dayStart === '06:00' && !pc.dayStop && pc.chain !== false && !(Number(pc.gapMins) > 0) && !pc.rate && Number(pc.defaultHours) === 8 && !pc.skip;
        return untouched && preset !== 'custom' ? { ...pc, ...patternFields(preset) } : { ...pc, pattern: 'custom' };
    }
    return { area: guess.area, line: guess.line, dayStart: '06:00', dayStop: '', chain: true, gapMins: 0, rate: '', defaultHours: 8, skip: false, ...patternFields(preset) };
}

const smallIn = "border border-slate-300 rounded px-1.5 py-1 text-xs bg-white focus:outline-none focus:ring-1 focus:ring-[#0072CE] ";
const patternLook = (c) => LINE_PATTERNS[c.pattern] || LINE_PATTERNS.custom;
function patternSummary(c) {
    const w = windowHours(c), start = fmtClock(c.dayStart || '06:00'), stop = c.dayStop ? fmtClock(c.dayStop) : '';
    if (c.pattern === 'nonstop') return `Runs around the clock. Each day starts at ${start}, and a 24 h run flows straight into the next day. A blank hours cell means a full 24 h.`;
    if (c.pattern === 'night' && w) return `Each night's first run starts at ${start} and the shift ends at ${stop} (${fmtHrs(w * HOUR)} a night). A blank hours cell is filled to ${stop}.`;
    if (c.pattern === 'dayclean' && w) return `Each day's first run starts at ${start} and the night clean starts at ${stop} (${fmtHrs(w * HOUR)} a day). A blank hours cell is filled to ${stop}. The other ${fmtHrs((24 - w) * HOUR)} is left overnight for cleaning.`;
    if (w) return `Each day's first run starts at ${start} and the window ends at ${stop} (${fmtHrs(w * HOUR)} a day). A blank hours cell is filled to ${stop}.`;
    return `Each day's first run starts at ${start}; the rest stack after it in sheet order. A blank hours cell uses ${Number(c.defaultHours) || 8} h.`;
}
function patternTag(c) {
    const pt = patternLook(c), start = fmtClock(c.dayStart || '06:00');
    if (c.pattern === 'nonstop') return `${pt.label} · days start ${start}`;
    return `${pt.label} · ${start}${c.dayStop ? ` to ${fmtClock(c.dayStop)}` : ' start'}`;
}
// One day's hours from the sheet against the line's window: green fills it, red is longer than it, yellow falls short of it.
function chipLook(hours, winH) {
    if (!winH) return { cls: 'bg-slate-100 text-slate-600 border-slate-300', tip: 'Hours on the sheet for this day' };
    if (hours > winH + 0.05) return { cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]', tip: `${fmtHrs((hours - winH) * HOUR)} longer than the window: the last run ends after the stop` };
    if (hours >= winH - 0.05) return { cls: 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]', tip: 'Fills the window exactly' };
    return { cls: 'bg-[#FFF6E0] text-slate-700 border-[#FFB81C]', tip: `${fmtHrs((winH - hours) * HOUR)} short of the window` };
}

// One sheet line: where it goes, how it runs, and what its hours add up to each day. Wraps on any screen width.
function LineCard({ L, c, chips, setCfg, areaOptions, lineChoices }) {
    const [more, setMore] = useState(false);
    const kind = LINE_PATTERNS[c.pattern] ? c.pattern : 'custom';
