                            <div className="text-base font-black text-[#92400E] mt-0.5">{L.rule.midweekHours > 0 ? fmtMins(midweek.mins) : 'IBL4 only'}</div>
                            <div className="text-[10px] text-slate-600">{L.rule.midweekHours > 0 ? `${midweek.equipCount} pcs - ${fmtMins(midweek.work)} work` : 'Not required'}</div>
