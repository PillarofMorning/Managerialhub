            startDate: getLocalYMD(new Date(run.start)), startTime: hhmmOf(run.start), endDate: getLocalYMD(new Date(run.end)), endTime: hhmmOf(run.end),
            hours: String(Math.round(((run.end - run.start) / HOUR) * 100) / 100), cases: run.cases === null ? '' : String(run.cases), order: run.order || '', notes: run.notes || '', batch: run.batch || '',
