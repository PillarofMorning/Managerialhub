                            <span className="text-slate-500">{Object.keys(e.fields).length} column{Object.keys(e.fields).length === 1 ? '' : 's'}</span>
                            {e.sent.map(c => <span key={c} className="px-1 rounded border text-[10px] font-bold bg-[#DCFCE7] text-[#166534] border-[#16A34A]">{colLabel(c)}</span>)}
