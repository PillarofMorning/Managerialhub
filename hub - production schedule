                                {notesLeft.slice(0, 200).map((n, i) => <li key={i}><b>{n.line}</b>{n.ymd ? ` ${fmtDay(parseYMD(n.ymd).getTime())}` : ''}{active.length > 1 ? ` (${n.sheet})` : ''}: <i>{n.text}</i> <span className="text-slate-400">({n.why})</span></li>)}
