function gapsAround(cand, runs, ctx) {
    const cl = canonLine(cand.area, cand.line);
    const c = { ...cand, id: cand.id || 'candidate' };
    const seq = runs.filter(r => r.id !== c.id && canonLine(r.area, r.line) === cl).concat([c]);
    let before = null, after = null;
    judgeStops(lineStops(seq), lineCtxOf(ctx, cand.area, cand.line)).forEach(g => {
        if (g.next && g.next.id === c.id && !before) before = g;
        if (g.prev.id === c.id && !after) after = g;
    });
    return { before, after };
}

