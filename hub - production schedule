                    {/* CALCULATED CLEAN TIMES SUMMARY FOR THIS LINE */}
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <div className="rounded-lg border border-[#7DD3FC] bg-[#E0F2FE]/50 p-2.5">
                            <div className="text-[10px] font-black uppercase text-[#0369A1]">Daily Clean</div>
