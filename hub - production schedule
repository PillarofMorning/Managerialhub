// A search box with a pick list under it, used instead of <input list=...> (which only offers what matches the text already in the box).
// It opens with the whole list, narrows as you type, Up / Down + Enter or a click picks, Esc closes just the list. What is typed but
// not in the list stays as typed (allowNew) and is offered as the last row. options: [{ value, label, group?, note? }].
let comboSeq = 0;
function ComboBox({ value, onText, onPick, onCommit, onStart, options, placeholder, className, allowNew, newWord, ariaLabel }) {
    const [open, setOpen] = useState(false);
