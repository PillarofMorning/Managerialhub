// MONTH CALENDAR: drag a run to another day (keeps its time of day), double-click to edit
// ============================================================================
function MonthView({ runs, month, lineFilter, onMoveDay, onOpen, issueMap }) {
    const first = new Date(month.getFullYear(), month.getMonth(), 1);
    const dim = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
    const cells = [];
    for (let i = 0; i < first.getDay(); i++) cells.push(null);
    for (let i = 1; i <= dim; i++) cells.push(i);
    const byDay = useMemo(() => {
        const m = {};
        runs.forEach(r => { if (lineFilter && lineKeyOf(r.area, r.line) !== lineFilter) return; const k = getLocalYMD(new Date(r.start)); (m[k] = m[k] || []).push(r); });
        Object.keys(m).forEach(k => m[k].sort(byStart));
        return m;
    }, [runs, lineFilter]);
    const todayYmd = getLocalYMD(new Date());
    return (
        <div className="bg-slate-200 border border-slate-200 rounded-xl overflow-hidden grid grid-cols-7 gap-px">
            {DOW.map(d => <div key={d} className="bg-slate-50 py-2 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">{d}</div>)}
            {cells.map((dayNum, i) => {
                if (!dayNum) return <div key={`e${i}`} className="bg-slate-50/50" />;
                const dateObj = new Date(month.getFullYear(), month.getMonth(), dayNum), ymd = getLocalYMD(dateObj);
                const list = byDay[ymd] || [];
                return (
                    <div key={dayNum} className={`py-1.5 flex flex-col min-h-[118px] ${ymd === todayYmd ? 'bg-[#FFF6E0]' : 'bg-white'}`}
                        onDragOver={(e) => { e.preventDefault(); e.currentTarget.classList.add('ring-2', 'ring-inset', 'ring-[#0072CE]'); }}
                        onDragLeave={(e) => { e.currentTarget.classList.remove('ring-2', 'ring-inset', 'ring-[#0072CE]'); }}
                        onDrop={(e) => { e.preventDefault(); e.currentTarget.classList.remove('ring-2', 'ring-inset', 'ring-[#0072CE]'); const id = e.dataTransfer.getData('text/plain'); if (id) onMoveDay(id, dateObj); }}>
                        <span className={`text-sm font-bold px-2 mb-1 ${ymd === todayYmd ? 'text-[#E4002B]' : 'text-slate-700'}`}>{dayNum}</span>
                        <div className="flex flex-col gap-1 px-1">
                            {list.slice(0, 6).map(r => (
                                <div key={r.id} draggable onDragStart={(e) => { e.dataTransfer.setData('text/plain', r.id); }} onDoubleClick={() => onOpen(r)}
                                    className={`cursor-move rounded-md px-1.5 py-1 border-l-[3px] hover:shadow-sm ${issueMap[r.id] === 'overlap' ? 'bg-[#FDE8EC]' : 'bg-[#E6F1FB]'} ${r.allergen ? 'border-[#FFB81C]' : 'border-[#0072CE]'}`}
                                    title={`${runTitle(r)}\n${fmtDT(r.start)} to ${fmtDT(r.end)}\nDrag to another day, double-click to edit`}>
                                    <div className="text-[9px] font-black uppercase text-[#00468B] leading-none truncate">{lineLabelOf(r.area, r.line)}</div>
                                    <div className="text-[11px] text-slate-700 truncate leading-tight">{fmtTime(r.start)} {r.product}{r.allergen ? ' ⚠️' : ''}</div>
                                </div>
                            ))}
                            {list.length > 6 && <div className="text-[10px] font-bold text-slate-500 px-1">+{list.length - 6} more</div>}
                        </div>
                    </div>
                );
            })}
        </div>
    );
}

// ============================================================================
// IMPORT WEEK
// ============================================================================
const STATUS_LOOK = {
    new: { label: 'NEW', cls: 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' },
    update: { label: 'UPDATE', cls: 'bg-[#E6F1FB] text-[#00468B] border-[#0072CE]' },
    same: { label: 'ALREADY THERE', cls: 'bg-slate-100 text-slate-500 border-slate-300' },
    clash: { label: 'CLASH', cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
};
function guessLineCfg(label, areaOptions, prevCfg) {
    const preset = presetForLabel(label);
    if (prevCfg) {
        if (prevCfg.pattern) return prevCfg;
        // saved before line patterns existed: settings still at the old defaults take this line's pattern, anything typed by hand stays
        const untouched = prevCfg.dayStart === '06:00' && !prevCfg.dayStop && prevCfg.chain !== false && !(Number(prevCfg.gapMins) > 0) && !prevCfg.rate && Number(prevCfg.defaultHours) === 8 && !prevCfg.skip;
        return untouched && preset !== 'custom' ? { ...prevCfg, ...patternFields(preset) } : { ...prevCfg, pattern: 'custom' };
    }
    const lc = label.toLowerCase().trim();
    const find = (name) => areaOptions.find(a => a.toLowerCase() === name.toLowerCase());
    let area = find(lc) || '', line = 1;
    if (!area) {
        const m = /^(.*?)[\s-]*(\d+)$/.exec(lc);
        if (m && find(m[1].trim())) { area = find(m[1].trim()); line = Number(m[2]); }
    }
    if (!area) area = areaOptions.find(a => a.toLowerCase().indexOf(lc) >= 0 || lc.indexOf(a.toLowerCase()) >= 0) || '';
    return { area, line, dayStart: '06:00', dayStop: '', chain: true, gapMins: 0, rate: '', defaultHours: 8, skip: false, ...patternFields(preset) };
}

const smallIn = "border border-slate-300 rounded px-1.5 py-1 text-xs bg-white focus:outline-none focus:ring-1 focus:ring-[#0072CE] ";
const patternLook = (c) => LINE_PATTERNS[c.pattern] || LINE_PATTERNS.custom;
function patternSummary(c) {
    const w = windowHours(c), start = fmtClock(c.dayStart || '06:00'), stop = c.dayStop ? fmtClock(c.dayStop) : '';
    if (c.pattern === 'nonstop') return `Runs around the clock. Each day starts at ${start}, and a 24 h run flows straight into the next day. A blank hours cell means a full 24 h.`;
    if (c.pattern === 'night' && w) return `Each night's first run starts at ${start} and the shift ends at ${stop} (${fmtHrs(w * HOUR)} a night). A blank hours cell is filled to ${stop}.`;
    if (c.pattern === 'dayclean' && w) return `Each day's first run starts at ${start} and the night clean starts at ${stop} (${fmtHrs(w * HOUR)} a day). A blank hours cell is filled to ${stop}. The other ${fmtHrs((24 - w) * HOUR)} is left overnight for cleaning.`;
    if (w) return `Each day's first run starts at ${start} and the window ends at ${stop} (${fmtHrs(w * HOUR)} a day). A blank hours cell is filled to ${stop}.`;
    return `Each day's first run starts at ${start}; the rest stack after it in sheet order. A blank hours cell uses ${Number(c.defaultHours) || 8} h.`;
}
function patternTag(c) {
    const pt = patternLook(c), start = fmtClock(c.dayStart || '06:00');
    if (c.pattern === 'nonstop') return `${pt.label} · days start ${start}`;
    return `${pt.label} · ${start}${c.dayStop ? ` to ${fmtClock(c.dayStop)}` : ' start'}`;
}
// One day's hours from the sheet against the line's window: green fills it, red is longer than it, yellow falls short of it.
function chipLook(hours, winH) {
    if (!winH) return { cls: 'bg-slate-100 text-slate-600 border-slate-300', tip: 'Hours on the sheet for this day' };
    if (hours > winH + 0.05) return { cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]', tip: `${fmtHrs((hours - winH) * HOUR)} longer than the window: the last run ends after the stop` };
    if (hours >= winH - 0.05) return { cls: 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]', tip: 'Fills the window exactly' };
    return { cls: 'bg-[#FFF6E0] text-slate-700 border-[#FFB81C]', tip: `${fmtHrs((winH - hours) * HOUR)} short of the window` };
}

// One sheet line: where it goes, how it runs, and what its hours add up to each day. Wraps on any screen width.
function LineCard({ L, c, chips, setCfg }) {
    const [more, setMore] = useState(false);
    const kind = LINE_PATTERNS[c.pattern] ? c.pattern : 'custom';
    const missing = !c.area && !c.skip;
    return (
        <div className={`border border-slate-200 rounded-xl p-3 ${c.skip ? 'opacity-50' : ''} ${missing ? 'bg-[#FDE8EC]/40' : 'bg-white'}`}>
            <div className="flex flex-wrap items-end gap-x-3 gap-y-2">
                <div className="w-full sm:w-40">
                    <div className="font-black text-slate-800 text-sm">{L.label}</div>
                    <div className="text-[10px] text-slate-400">{[L.leads, L.supervisor].filter(Boolean).join(' · ')}</div>
                </div>
                <Field label="Area"><input list="ps-areas-i" className={smallIn + 'w-36 ' + (missing ? 'border-[#E4002B] bg-[#FDE8EC]' : '')} value={c.area} onChange={(e) => setCfg(L.label, { area: e.target.value })} placeholder="choose area" /></Field>
                <Field label="Line #"><input type="number" min="1" className={smallIn + 'w-16'} value={c.line} onChange={(e) => setCfg(L.label, { line: e.target.value })} /></Field>
                <Field label="How it runs"><select className={smallIn + 'w-52'} value={kind} onChange={(e) => setCfg(L.label, patternFields(e.target.value))}>{PATTERN_ORDER.map(k => <option key={k} value={k}>{LINE_PATTERNS[k].label}</option>)}</select></Field>
                <Field label="First run starts"><input type="time" className={smallIn} value={c.dayStart} onChange={(e) => setCfg(L.label, { dayStart: e.target.value })} /></Field>
                {kind !== 'nonstop' && <Field label={kind === 'dayclean' ? 'Night clean starts' : kind === 'night' ? 'Shift ends' : 'Window ends (optional)'}><input type="time" className={smallIn} value={c.dayStop} onChange={(e) => setCfg(L.label, { dayStop: e.target.value })} /></Field>}
                <label className="flex items-center gap-1.5 text-xs font-bold text-slate-600 pb-1.5"><input type="checkbox" checked={!!c.skip} onChange={(e) => setCfg(L.label, { skip: e.target.checked })} /> Skip this line</label>
            </div>
            <p className="text-[11px] text-slate-500 mt-2">{patternSummary(c)}</p>
            {chips.length > 0 && (
                <div className="flex flex-wrap items-center gap-1.5 mt-2">
                    <span className="text-[10px] font-black uppercase tracking-wider text-slate-400">Hours per day</span>
                    {chips.map(ch => {
                        const lk = ch.filled ? { cls: 'bg-[#FFF6E0] text-slate-700 border-[#FFB81C] border-dashed', tip: 'No hours on the sheet for this day: filled in from the line pattern. Type the real hours in step 3 if they differ.' } : chipLook(ch.hours, ch.winH);
                        return <span key={ch.ymd} title={lk.tip} className={`px-1.5 py-0.5 rounded border text-[11px] font-bold whitespace-nowrap ${lk.cls}`}>{DOW[ch.dow]} {fmtHrs(ch.hours * HOUR)}{ch.filled ? ' (filled in)' : ch.winH ? ` of ${fmtHrs(ch.winH * HOUR)}` : ''}</span>;
                    })}
                </div>
            )}
            <button type="button" className="mt-2 text-[11px] font-bold text-[#0072CE] hover:underline" onClick={() => setMore(v => !v)}>{more ? 'Fewer settings' : 'More settings'}</button>
            {more && (
                <div className="flex flex-wrap items-end gap-x-4 gap-y-2 mt-2 p-2 rounded-lg bg-slate-50">
                    <label className="flex items-center gap-1.5 text-xs font-bold text-slate-600 pb-1.5" title="A run that is still going at the next day's start pushes that day's first run later"><input type="checkbox" checked={c.chain !== false} onChange={(e) => setCfg(L.label, { chain: e.target.checked })} /> Back to back across days</label>
                    <Field label="Gap between runs (min)"><input type="number" min="0" className={smallIn + 'w-20'} value={c.gapMins} onChange={(e) => setCfg(L.label, { gapMins: e.target.value })} /></Field>
                    <Field label="Cases per hour" hint="works out hours when a cell has none"><input type="number" min="0" className={smallIn + 'w-24'} value={c.rate} onChange={(e) => setCfg(L.label, { rate: e.target.value })} placeholder="-" /></Field>
                    <Field label="Hours if blank" hint="only for a line with no window"><input type="number" min="0.25" step="0.25" className={smallIn + 'w-20'} value={c.defaultHours} onChange={(e) => setCfg(L.label, { defaultHours: e.target.value })} /></Field>
                </div>
            )}
        </div>
    );
}

// One run to check: day, item and status on the first line; start, stop, hours and flags on the second. Wraps on any screen width.
function RunRow({ r, ed, onInclude, onEdit, onReset, onFlag }) {
    const p = r.p, look = STATUS_LOOK[r.status];
    const edited = ed.start || ed.end || (ed.hours !== undefined && ed.hours !== '');
    const lab = 'text-[10px] font-black uppercase tracking-wider text-slate-400';
    const guessed = p.hoursSource === 'default' || p.hoursSource === 'window';
    const hoursTip = p.hoursSource === 'default' ? 'No hours on the sheet: the line\'s "hours if blank" was used. Type the real hours.' : p.hoursSource === 'window' ? 'No hours on the sheet: filled to the end of the line\'s window. Type the real hours if they differ.' : p.hoursSource === 'rate' ? 'Worked out from cases and the line rate' : '';
    const notes = [];
    if (r.status === 'update') notes.push({ t: r.changes.join('; '), c: 'text-slate-500' });
    if (r.status === 'clash' && r.clashWith) notes.push({ t: `overlaps ${runTitle(r.clashWith)}, ${fmtDT(r.clashWith.start)}`, c: 'text-[#B00020]' });
    if (r.selfOverlap) notes.push({ t: 'overlaps another run on this sheet', c: 'text-[#B00020]' });
    if (p.afterCutoff) notes.push({ t: `ends after the stop time (${fmtTime(p.cutAt)})`, c: 'text-[#B27B00]' });
    if (p.pushedMs > 0) notes.push({ t: `pushed ${fmtHrs(p.pushedMs)} by the run before`, c: 'text-slate-400' });
    if (guessed) notes.push({ t: p.hoursSource === 'window' ? 'no hours on the sheet: filled to the end of the window' : 'no hours on the sheet: the line default was used', c: 'text-[#B27B00]' });
    if (p.bad) notes.push({ t: 'stop is not after start', c: 'text-[#B00020] font-bold' });
    return (
        <div className={`px-3 py-2 border-t border-slate-100 ${r.include ? '' : 'opacity-60'} ${p.bad || r.selfOverlap ? 'bg-[#FDE8EC]/60' : ''}`}>
            <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
                <input type="checkbox" checked={r.include} title="Put this run on the schedule" onChange={(e) => onInclude(e.target.checked)} />
                <span className="text-xs font-black text-slate-700 whitespace-nowrap">{fmtDay(parseYMD(p.ymd).getTime())}</span>
                <span className="font-mono text-xs text-slate-500">{p.item}</span>
                <span className="text-xs text-slate-800 min-w-0 flex-1 basis-48" title={p.desc}>{p.desc}</span>
                <span className={`inline-block px-1.5 py-0.5 rounded border text-[10px] font-black whitespace-nowrap ${look.cls}`}>{look.label}</span>
            </div>
            <div className="flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-1.5 pl-6">
                <label className="flex items-center gap-1"><span className={lab}>Start</span><input type="datetime-local" className={smallIn} value={dtLocalValue(p.start)} onChange={(e) => e.target.value && onEdit({ start: e.target.value })} /></label>
                <label className="flex items-center gap-1"><span className={lab}>Stop</span><input type="datetime-local" className={smallIn} value={dtLocalValue(p.end)} onChange={(e) => e.target.value && onEdit({ end: e.target.value })} /></label>
                <label className="flex items-center gap-1"><span className={lab}>Hours</span>
                    <input type="number" step="0.25" min="0.25" className={smallIn + 'w-16 ' + (guessed ? 'border-[#FFB81C] bg-[#FFF6E0]' : '')} value={Math.round(p.hours * 100) / 100} title={hoursTip} onChange={(e) => onEdit({ hours: e.target.value, end: '' })} /></label>
                {edited && <button type="button" className="text-[10px] text-slate-400 hover:text-[#E4002B] underline" title="Back to the sheet values" onClick={onReset}>reset</button>}
                <span className="whitespace-nowrap text-xs">
                    <label className="mr-2" title="Allergen run"><input type="checkbox" checked={r.allergen} onChange={(e) => onFlag({ allergen: e.target.checked })} /> A</label>
                    <label title="Crumb clean"><input type="checkbox" checked={r.crumb} onChange={(e) => onFlag({ crumb: e.target.checked })} /> C</label>
                </span>
                <span className="text-[11px] text-slate-500 whitespace-nowrap">{p.cases !== null && p.cases !== undefined ? `${fmtNum(p.cases)} cases` : ''}{p.order ? ` · order # ${p.order}` : ''}{p.orderWarn && <span className="ml-1 text-[#B27B00]" title="This does not look like an order number. It is saved as typed.">⚠</span>}</span>
                {r.gap && <span className="inline-block px-1.5 py-0.5 rounded border text-[10px] font-black whitespace-nowrap" style={{ background: GAP_STYLE[r.gap.status].bg, borderColor: GAP_STYLE[r.gap.status].border, color: GAP_STYLE[r.gap.status].text }} title={gapText(r.gap)}>{r.gap.status === 'overlap' ? 'OVERLAP' : r.gap.req.mins <= 0 ? 'same product' : `clean ${fmtHrs(r.gap.gapMs)} / needs ${fmtMins(r.gap.req.mins)}`}</span>}
            </div>
            {notes.length > 0 && <div className="mt-1 pl-6 text-[10px] flex flex-wrap gap-x-3">{notes.map((n, i) => <span key={i} className={n.c}>{n.t}</span>)}</div>}
        </div>
    );
}

// One numbered step of the import. The title row stays on screen when the step is folded, with a line saying where it stands
// (and `right` for anything that should stay visible, like the status counts), so folding never hides a problem.
function Section({ title, open, onToggle, summary, right, children }) {
    return (
        <div className="bg-white border border-slate-200 rounded-xl shadow-sm">
            <div className="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                <h2 className="flex-1 basis-56 min-w-0 text-base font-black text-[#00468B] uppercase tracking-widest">
                    <button type="button" aria-expanded={open} onClick={onToggle} title={open ? 'Fold this step away' : 'Open this step'} className="flex items-start gap-2 w-full text-left uppercase tracking-widest font-black">
                        <ChevronIcon className={`w-5 h-5 mt-px flex-shrink-0 text-[#0072CE] transition-transform ${open ? '' : '-rotate-90'}`} />
                        <span className="min-w-0 flex-1">
                            <span className="block">{title}</span>
                            {!open && summary && <span className="block mt-0.5 normal-case tracking-normal text-xs font-semibold text-slate-500">{summary}</span>}
                        </span>
                    </button>
                </h2>
                {right}
            </div>
            {open && <div className="px-4 pb-4">{children}</div>}
        </div>
    );
}

function ImportView({ areaOptions, settings, updateSettings, api, gapCtx, onDone, onView, apiReady }) {
    const [text, setText] = useState('');
    const [fileName, setFileName] = useState('');
    const [weekStart, setWeekStart] = useState('');
    const [reading, setReading] = useState(false);
    const [grid, setGrid] = useState(null);
    const [edits, setEdits] = useState({});          // per planned run: { start, end, hours }
    const [inc, setInc] = useState({});              // per planned run: true / false when the user ticked it by hand
    const [flags, setFlags] = useState({});          // per planned run: { allergen, crumb } typed by hand
    const [removeIds, setRemoveIds] = useState({});  // runs on the schedule but not on the sheet, ticked for removal
    const [existing, setExisting] = useState({ key: '', byLine: {}, failed: false, loading: false });
    const [recallMap, setRecallMap] = useState({});
    const [applying, setApplying] = useState(null);  // { done, total }
    const [result, setResult] = useState(null);      // { message, type, changes, confirmUndo, busy }
    const applyingRef = useRef(false);
    const [open, setOpen] = useState({ s1: true, s2: true, s3: true });   // which of the three steps are unfolded
    const [folded, setFolded] = useState({});                              // step 3 lines folded away, by sheet line

    const parsed = useMemo(() => grid ? parseSheet(grid, { weekStart }) : null, [grid, weekStart]);
    const ok = parsed && !parsed.error;
    // Every new read starts from the same layout: step 1 folded away once a plan was read (so steps 2 and 3 are in view),
    // open again when a read fails or is cleared; steps 2 and 3 and every line open.
    const readOk = !!ok;
    useEffect(() => { setOpen({ s1: !readOk, s2: true, s3: true }); setFolded({}); }, [grid, readOk]);
    const toggleStep = (k) => setOpen(o => ({ ...o, [k]: !o[k] }));
    const cfgs = useMemo(() => {
        const out = {};
        if (ok) parsed.lines.forEach(L => { out[lineCfgKey(L.label)] = guessLineCfg(L.label, areaOptions, settings.lineMap[lineCfgKey(L.label)]); });
        return out;
    }, [parsed, settings.lineMap, areaOptions]);
    const setCfg = (label, patch) => updateSettings(s => ({ ...s, lineMap: { ...s.lineMap, [lineCfgKey(label)]: { ...guessLineCfg(label, areaOptions, s.lineMap[lineCfgKey(label)]), ...patch } } }));

    const readText = (t) => { setResult(null); setEdits({}); setInc({}); setFlags({}); setRemoveIds({}); setExisting({ key: '', byLine: {}, failed: false, loading: false }); setGrid(t && t.trim() ? parseDelimited(t) : null); };
    const readFile = (file) => {
        if (!file) return;
        setFileName(file.name); setReading(true); setResult(null);
        const done = (msg) => { setReading(false); if (msg) setResult({ type: 'error', message: msg }); };
        const lower = file.name.toLowerCase();
        const fr = new FileReader();
        if (/\.(csv|tsv|txt)$/.test(lower)) {
            fr.onload = () => { setText(String(fr.result)); readText(String(fr.result)); done(); };
            fr.onerror = () => done('Could not read that file.');
            fr.readAsText(file);
            return;
        }
        const withXlsx = (cb) => {
            if (window.XLSX) { cb(); return; }
            const s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
            s.onload = cb; s.onerror = () => done('Could not load the Excel reader (blocked network?). Copy the cells in Excel and paste them into the box instead.');
            document.head.appendChild(s);
        };
        fr.onload = () => withXlsx(() => {
            try {
                const wb = window.XLSX.read(fr.result, { type: 'array', cellDates: true });
                // the first sheet that has a weekday header
                let rows = null;
                for (let i = 0; i < wb.SheetNames.length && !rows; i++) {
                    const g = window.XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[i]], { header: 1, raw: true, defval: '' });
                    const p = parseSheet(g, {});
                    if (!p.error || p.needWeekStart) rows = g;
                }
                if (!rows) { done('No sheet in that workbook has a Sunday ... Saturday header row.'); return; }
                setText(''); setEdits({}); setInc({}); setFlags({}); setRemoveIds({}); setExisting({ key: '', byLine: {}, failed: false, loading: false }); setGrid(rows); done();
            } catch (e) { done(`Could not read that workbook: ${e && e.message ? e.message : e}`); }
        });
        fr.onerror = () => done('Could not read that file.');
        fr.readAsArrayBuffer(file);
    };

    const planned = useMemo(() => ok ? planRuns(parsed, cfgs, edits) : [], [parsed, cfgs, edits]);
    const span = useMemo(() => {
        if (!planned.length) return null;
        return { from: Math.min.apply(null, planned.map(p => p.start)) - DAY, to: Math.max.apply(null, planned.map(p => p.end)) + DAY };
    }, [planned]);
    const lineKeysNeeded = useMemo(() => { const m = {}; planned.forEach(p => { m[lineKeyOf(p.area, p.line)] = true; }); return Object.keys(m).sort(); }, [planned]);
    const codesNeeded = useMemo(() => { const m = {}; planned.forEach(p => { m[p.item] = true; }); return Object.keys(m).sort(); }, [planned]);
    const needKey = span ? `${lineKeysNeeded.join(',')}|${Math.floor(span.from / HOUR)}|${Math.floor(span.to / HOUR)}` : '';

    // What is already on those lines (one read per line) and the last-known allergen settings per product code.
    useEffect(() => {
        if (!needKey) return;
        let alive = true;
        const t = setTimeout(async () => {
            setExisting(p => ({ ...p, key: needKey, loading: true }));
            const byLine = {}; let failed = false;
            for (let i = 0; i < lineKeysNeeded.length; i++) {
                const kr = splitKey(lineKeysNeeded[i]);
                const rows = await api.readLine(kr.area, kr.line, span.from, span.to);
                if (!alive) return;
                if (rows === null) failed = true; else byLine[lineKeysNeeded[i]] = rows;
            }
            if (!alive) return;
            setExisting({ key: needKey, byLine, failed, loading: false });
        }, 400);
        return () => { alive = false; clearTimeout(t); };
    }, [needKey, apiReady, result && result.tick]);
    const codeKey = codesNeeded.join(',');
    useEffect(() => {
        if (!codeKey) return;
        let alive = true;
        (async () => { const m = await api.recallMany(codesNeeded); if (alive) setRecallMap(m || {}); })();
        return () => { alive = false; };
    }, [codeKey, apiReady]);

    // Status of every planned run against what exists.
    const view = useMemo(() => {
        const out = { rows: [], orphans: [], counts: { new: 0, update: 0, same: 0, clash: 0, selected: 0 }, shortClean: 0 };
        // Until the first read of a sheet finishes there is nothing to show. After that the last statuses stay on screen (dimmed)
        // while a changed plan is checked again, and Apply stays off until the check matches what is on screen.
        if (!ok) return { ...out, pending: true };
        if (!needKey) return { ...out, pending: false };   // nothing planned (every line skipped): nothing to check
        if (!existing.key) return { ...out, pending: true };
        out.pending = existing.key !== needKey || existing.loading;
        const matchedIds = {};
        const rows = planned.map(p => {
            const lk = lineKeyOf(p.area, p.line), list = existing.byLine[lk] || [];
            const m = matchExisting(p, list, matchedIds);
            if (m) matchedIds[m.id] = true;
            const rec = recallMap[p.item];
            const fl = flags[p.key] || {};
            const allergen = fl.allergen !== undefined ? fl.allergen : (m ? m.allergen : rec ? rec.allergen : false);
            const crumb = fl.crumb !== undefined ? fl.crumb : (m ? m.crumb : rec ? rec.crumb : false);
            const allergenType = m ? m.allergenType : rec ? rec.allergenType : '';
            return { p, m, allergen, crumb, allergenType, lk };
        });
        rows.forEach(r => {
            const p = r.p, m = r.m, changes = [];
            if (m) {
                if (Math.abs(m.start - p.start) >= 60000) changes.push(`start ${fmtDT(m.start)} to ${fmtDT(p.start)}`);
                if (Math.abs(m.end - p.end) >= 60000) changes.push(`stop ${fmtDT(m.end)} to ${fmtDT(p.end)}`);
                if (p.order && m.order !== p.order) changes.push(`order # ${m.order || '(none)'} to ${p.order}`);
                if (p.cases !== null && m.cases !== p.cases) changes.push(`cases ${fmtNum(m.cases) || '(none)'} to ${fmtNum(p.cases)}`);
                if (r.allergen !== m.allergen) changes.push(r.allergen ? 'allergen on' : 'allergen off');
                if (r.crumb !== m.crumb) changes.push(r.crumb ? 'crumb clean on' : 'crumb clean off');
                if (p.desc && m.product !== p.desc) changes.push('description');
                r.status = changes.length ? 'update' : 'same'; r.changes = changes;
            } else {
                const others = (existing.byLine[r.lk] || []).filter(e => !matchedIds[e.id] && e.start < p.end && e.end > p.start);
                r.status = others.length ? 'clash' : 'new'; r.clashWith = others[0] || null; r.changes = [];
            }
            const forced = inc[p.key];
            r.include = forced !== undefined ? forced : (r.status === 'new' || r.status === 'update');
        });
        // planned runs overlapping each other (e.g. a run that is too long for the day)
        const byLine = {};
        rows.forEach(r => { (byLine[r.lk] = byLine[r.lk] || []).push(r); });
        Object.keys(byLine).forEach(k => {
            const l = byLine[k].filter(r => r.include).sort((a, b) => a.p.start - b.p.start);
            for (let i = 1; i < l.length; i++) if (l[i].p.start < l[i - 1].p.end) { l[i].selfOverlap = true; l[i - 1].selfOverlap = true; }
        });
        // cleaning window before each planned run (existing runs not replaced + planned runs that will be saved)
        Object.keys(byLine).forEach(k => {
            const kr = splitKey(k);
            const keep = (existing.byLine[k] || []).filter(e => !byLine[k].some(r => r.m && r.m.id === e.id && r.include));
            const plannedRuns = byLine[k].filter(r => r.include).map(r => ({ id: `plan:${r.p.key}`, area: kr.area, line: kr.line, code: Number(r.p.item), product: r.p.desc, start: r.p.start, end: r.p.end, allergen: r.allergen, allergenType: r.allergenType, crumb: r.crumb }));
            const all = keep.concat(plannedRuns);
            byLine[k].forEach(r => {
                if (!r.include) return;
                const g = gapsAround(plannedRuns.find(x => x.id === `plan:${r.p.key}`), all, gapCtx);
                r.gap = g.before;
                if (g.before && (g.before.status === 'short' || g.before.status === 'overlap')) out.shortClean++;
            });
        });
        rows.forEach(r => { out.counts[r.status]++; if (r.include) out.counts.selected++; });
        // runs already on the schedule inside the sheet's week that the sheet no longer lists
        if (parsed && parsed.days.length) {
            const wFrom = parseYMD(parsed.days[0].ymd).getTime(), wTo = addDaysLocal(parseYMD(parsed.days[parsed.days.length - 1].ymd), 1).getTime();
            lineKeysNeeded.forEach(k => (existing.byLine[k] || []).forEach(e => { if (!matchedIds[e.id] && e.start >= wFrom && e.start < wTo) out.orphans.push(e); }));
            out.orphans.sort(byStart);
        }
        out.rows = rows;
        return out;
    }, [ok, planned, existing, needKey, recallMap, flags, inc, gapCtx, parsed, lineKeysNeeded]);

    const unmapped = ok ? parsed.lines.filter(L => L.items.some(it => Object.keys(it.days).length) && !cfgs[lineCfgKey(L.label)].skip && !cfgs[lineCfgKey(L.label)].area) : [];
    const toApply = (view.rows || []).filter(r => r.include && (r.status === 'new' || r.status === 'update' || (r.status === 'clash' && inc[r.p.key]) || (r.status === 'same' && inc[r.p.key])));
    const toRemove = (view.orphans || []).filter(o => removeIds[o.id]);
    const canApply = ok && !view.pending && !existing.failed && !applying && unmapped.length === 0 && (toApply.length > 0 || toRemove.length > 0) && !toApply.some(r => r.p.bad);

    const apply = async () => {
        if (applyingRef.current || !canApply) return;
        applyingRef.current = true;
        const total = toApply.length + toRemove.length;
        setApplying({ done: 0, total }); setResult(null);
        const changes = []; let failure = null, done = 0, created = 0, updated = 0, removed = 0;
        try {
            for (let i = 0; i < toApply.length && !failure; i++) {
                const r = toApply[i], p = r.p;
                const run = { area: p.area, line: p.line, code: Number(p.item), product: p.desc || (r.m ? r.m.product : ''), start: p.start, end: p.end, allergen: r.allergen, allergenType: r.allergenType, crumb: r.crumb };
                const extras = { order: p.order || (r.m ? r.m.order : ''), cases: p.cases !== null ? p.cases : (r.m ? r.m.cases : null) };
                try {
                    if (r.m) { await api.saveRun('update', r.m.id, run, extras); changes.push({ type: 'update', id: r.m.id, before: r.m }); updated++; }
                    else { const id = await api.saveRun('create', null, run, extras); changes.push({ type: 'create', id }); created++; }
                } catch (err) { failure = err; break; }
                done++; setApplying({ done, total });
            }
            for (let i = 0; i < toRemove.length && !failure; i++) {
                try { await api.deleteRun(toRemove[i].id); changes.push({ type: 'delete', run: toRemove[i] }); removed++; }
                catch (err) { failure = err; break; }
                done++; setApplying({ done, total });
            }
        } finally { applyingRef.current = false; setApplying(null); }
        const summary = `${created} added, ${updated} updated${removed ? `, ${removed} removed` : ''}`;
        setRemoveIds({}); setInc({});
        updateSettings(s => { const ord = s.lineOrder.slice(); parsed.lines.forEach(L => { const c = cfgs[lineCfgKey(L.label)]; if (c && !c.skip && c.area) { const k = lineKeyOf(c.area, Math.max(1, parseInt(c.line, 10) || 1)); if (ord.indexOf(k) < 0) ord.push(k); } }); return { ...s, lineOrder: ord }; });
        if (failure) setResult({ type: 'error', message: `Stopped after ${done} of ${total}: ${failure.message || failure}. What was already saved (${summary}) stays on the schedule.`, changes, tick: Date.now() });
        else setResult({ type: 'success', message: `Import finished: ${summary}.`, changes, tick: Date.now() });
        onDone();
    };
    const undoImport = async () => {
        if (!result || !result.changes || !result.changes.length || result.busy) return;
        if (!result.confirmUndo) { setResult({ ...result, confirmUndo: true }); return; }
        setResult({ ...result, busy: true });
        let failure = null, n = 0;
        for (let i = result.changes.length - 1; i >= 0 && !failure; i--) {
            const c = result.changes[i];
            try {
                if (c.type === 'create') await api.deleteRun(c.id);
                else if (c.type === 'update') await api.saveRun('update', c.id, c.before, { order: c.before.order, cases: c.before.cases });
                else await api.saveRun('create', null, c.run, { order: c.run.order, cases: c.run.cases });
                n++;
            } catch (err) { failure = err; }
        }
        onDone();
        setResult(failure ? { type: 'error', message: `Undid ${n} of ${result.changes.length} changes, then failed: ${failure.message || failure}.`, changes: result.changes.slice(0, result.changes.length - n), tick: Date.now() } : { type: 'success', message: `Import undone (${n} changes reverted).`, tick: Date.now() });
    };

    const setEdit = (key, patch) => setEdits(e => ({ ...e, [key]: { ...(e[key] || {}), ...patch } }));
    // hours per line and day (after the pattern and any edits), for the chips on each line card and the group headers
    const lineStats = useMemo(() => {
        const m = {};
        planned.forEach(p => {
            const g = m[p.lineKey] = m[p.lineKey] || { days: {}, count: 0, hours: 0 };
            const d = g.days[p.ymd] = g.days[p.ymd] || { hours: 0, filled: false };
            d.hours += p.hours; g.count++; g.hours += p.hours;
            if (p.hoursSource === 'window' || p.hoursSource === 'default') d.filled = true;
        });
        return m;
    }, [planned]);
    const chipsFor = (L) => {
        const lk = lineCfgKey(L.label), st = lineStats[lk], c = cfgs[lk];
        if (!st || !c) return [];
        const wh = windowHours(c);
        return parsed.days.filter(D => st.days[D.ymd]).map(D => ({ ymd: D.ymd, dow: parseYMD(D.ymd).getDay(), hours: st.days[D.ymd].hours, filled: st.days[D.ymd].filled, winH: wh }));
    };
    // the runs to check, grouped by sheet line (first appearance order); a folded line still shows how many will be saved and how many need a look
    const groups = useMemo(() => {
        const g = [], idx = {};
        (view.rows || []).forEach(r => {
            const k = r.p.lineKey;
            if (idx[k] === undefined) { idx[k] = g.length; g.push({ key: k, label: r.p.lineLabel, area: r.p.area, line: r.p.line, rows: [], hours: 0, apply: 0, attention: 0 }); }
            const G = g[idx[k]]; G.rows.push(r); G.hours += r.p.hours;
            if (r.include) G.apply++;
            if (r.status === 'clash' || r.selfOverlap || r.p.bad || (r.include && r.gap && (r.gap.status === 'short' || r.gap.status === 'overlap'))) G.attention++;
        });
        return g;
    }, [view.rows]);
    const setAllFolded = (v) => { const m = {}; groups.forEach(G => { m[G.key] = v; }); setFolded(m); };

    // why the Apply button is off, so it never just sits there grey
    const applyHint = canApply || applying ? '' :
        unmapped.length > 0 ? `Choose an area for ${unmapped.map(l => l.label).join(', ')} in step 2 (or tick Skip).` :
        existing.failed ? 'Could not read what is already scheduled: press Reload (top right) and try again.' :
        view.pending ? 'Checking what is already on the schedule...' :
        toApply.some(r => r.p.bad) ? 'A run stops before it starts: fix its start or stop in step 3.' :
        'Nothing to apply: every run is already on the schedule, or unticked.';
    const weekText = ok ? `${fmtDay(parseYMD(parsed.days[0].ymd).getTime())} to ${fmtDay(parseYMD(parsed.days[parsed.days.length - 1].ymd).getTime())}` : '';
    const stepLines = ok ? parsed.lines.filter(L => L.items.length) : [];
    const lineCount = stepLines.length, skippedCount = stepLines.filter(L => cfgs[lineCfgKey(L.label)].skip).length;

    return (
        <div className="space-y-5">
            <Section title="1. Bring in the weekly plan" open={open.s1} onToggle={() => toggleStep('s1')}
                summary={ok ? <>{fileName || 'Pasted plan'} · {parsed.week || 'Week'}, {weekText} · {parsed.lines.length} lines · {parsed.runCount} runs on the sheet{parsed.warnings.length > 0 && <span className="text-[#B27B00]"> · {parsed.warnings.join(' ')}</span>}</> : (text.trim() ? 'Pasted, not read yet' : 'Nothing read yet')}>
                <p className="text-sm text-slate-500 mb-3">In Excel select the whole table (top-left cell to the last row), copy, and paste it here. Or upload the .xlsx. Dates are read from the day headers; every line section becomes a line on the schedule.</p>
                <textarea className="w-full h-28 border border-slate-300 rounded-lg p-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40" placeholder="Paste the Excel cells here (Ctrl+V)" value={text}
                    onChange={(e) => setText(e.target.value)} onPaste={(e) => { const t = e.clipboardData && e.clipboardData.getData('text'); if (t) { e.preventDefault(); setText(t); setFileName(''); readText(t); } }} />
                <div className="flex flex-wrap items-center gap-3 mt-3">
                    <Btn onClick={() => { setFileName(''); readText(text); }} disabled={!text.trim()}>Read pasted plan</Btn>
                    <label className="px-3 py-1.5 rounded-lg text-xs font-extrabold border bg-white text-slate-700 hover:bg-slate-50 border-slate-300 cursor-pointer inline-flex items-center gap-1.5"><UploadIcon className="w-3.5 h-3.5" /> Upload .xlsx / .csv
                        <input type="file" accept=".xlsx,.xls,.xlsm,.csv,.tsv,.txt" className="hidden" onChange={(e) => { readFile(e.target.files && e.target.files[0]); e.target.value = ''; }} /></label>
                    {(grid || text) && <Btn kind="ghost" onClick={() => { setText(''); setFileName(''); readText(''); setWeekStart(''); }}>Clear</Btn>}
                    {reading && <span className="text-xs text-slate-500">Reading {fileName}...</span>}
                    {fileName && !reading && <span className="text-xs text-slate-500">{fileName}</span>}
                </div>
                {!ok && result && result.type === 'error' && <div className="mt-3 p-3 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-sm text-[#B00020] font-semibold">{result.message}</div>}
                {parsed && parsed.error && (
                    <div className="mt-3 p-3 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-sm text-[#B00020] font-semibold">
                        {parsed.error}
                        {parsed.needWeekStart && <div className="mt-2 flex items-center gap-2"><span className="text-xs">Sunday date:</span><input type="date" className={smallIn} value={weekStart} onChange={(e) => setWeekStart(e.target.value)} /></div>}
                    </div>
                )}
                {ok && (
                    <div className="mt-3 flex flex-wrap gap-2 text-xs">
                        <span className="px-2 py-1 rounded-lg bg-[#E6F1FB] text-[#00468B] font-bold">{parsed.week || 'Week'} · {fmtDay(parseYMD(parsed.days[0].ymd).getTime())} to {fmtDay(parseYMD(parsed.days[parsed.days.length - 1].ymd).getTime())}</span>
                        <span className="px-2 py-1 rounded-lg bg-[#E6F1FB] text-[#00468B] font-bold">{parsed.lines.length} lines</span>
                        <span className="px-2 py-1 rounded-lg bg-[#E6F1FB] text-[#00468B] font-bold">{parsed.runCount} runs on the sheet</span>
                        {parsed.warnings.map((w, i) => <span key={i} className="px-2 py-1 rounded-lg bg-[#FFF6E0] text-slate-800 font-bold">{w}</span>)}
                    </div>
                )}
            </Section>

            {ok && (
                <Section title="2. How each line runs" open={open.s2} onToggle={() => toggleStep('s2')}
                    summary={<>{lineCount} line{lineCount === 1 ? '' : 's'}{skippedCount > 0 && ` · ${skippedCount} skipped`}{unmapped.length > 0 ? <span className="text-[#E4002B]"> · choose an area for {unmapped.map(l => l.label).join(', ')}</span> : ' · all set'}</>}>
                    <p className="text-sm text-slate-500 mb-3">Pick how each line runs. <b>First run starts</b> is where every day begins and the rest of that day's runs stack after it in sheet order. Which days a line runs on comes from the sheet. The chips compare each day's hours with the line's window. Settings are remembered for next week.</p>
                    <div className="space-y-3">
                        {stepLines.map(L => <LineCard key={L.label} L={L} c={cfgs[lineCfgKey(L.label)]} chips={chipsFor(L)} setCfg={setCfg} />)}
                    </div>
                    <datalist id="ps-areas-i">{areaOptions.map(a => <option key={a} value={a} />)}</datalist>
                    {unmapped.length > 0 && <p className="mt-2 text-xs font-bold text-[#E4002B]">Choose an area for: {unmapped.map(l => l.label).join(', ')} (or tick Skip).</p>}
                </Section>
            )}

            {ok && (
                <Section title="3. Check and apply" open={open.s3} onToggle={() => toggleStep('s3')}
                    summary={view.pending ? 'Checking what is already on the schedule...' : `${view.rows.length} run${view.rows.length === 1 ? '' : 's'} on ${groups.length} line${groups.length === 1 ? '' : 's'}, ${toApply.length} to apply`}
                    right={!view.pending && (
                        <div className="flex flex-wrap gap-1.5 text-[10px] font-black">
                            {['new', 'update', 'same', 'clash'].map(k => <span key={k} className={`px-2 py-0.5 rounded border ${STATUS_LOOK[k].cls}`}>{view.counts[k]} {STATUS_LOOK[k].label}</span>)}
                            {view.shortClean > 0 && <span className="px-2 py-0.5 rounded border bg-[#FDE8EC] text-[#B00020] border-[#E4002B]">{view.shortClean} without enough clean time</span>}
                        </div>
                    )}>
                    {existing.failed && <div className="mb-2 p-2 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-xs font-bold text-[#B00020]">Could not read what is already scheduled on these lines, so duplicates cannot be ruled out. Press Reload (top right) and try again.</div>}
                    {view.pending && !existing.failed && <p className="text-sm text-slate-500 mb-2">Checking what is already on the schedule...</p>}
                    {view.rows.length > 0 && (
                        <div className={`transition-opacity ${view.pending ? 'opacity-50' : ''}`}>
                            {groups.length > 1 && (
                                <div className="flex flex-wrap items-center gap-x-4 gap-y-1 mb-2 text-[11px] font-bold">
                                    <span className="text-slate-400">Lines:</span>
                                    <button type="button" className="text-[#0072CE] hover:underline" onClick={() => setAllFolded(true)}>Fold all</button>
                                    <button type="button" className="text-[#0072CE] hover:underline" onClick={() => setAllFolded(false)}>Open all</button>
                                </div>
                            )}
                            <div className="space-y-4">
                                {groups.map(G => (
                                    <div key={G.key} className="border border-slate-200 rounded-xl overflow-hidden">
                                        <button type="button" aria-expanded={!folded[G.key]} title={folded[G.key] ? 'Open this line' : 'Fold this line away'} onClick={() => setFolded(f => ({ ...f, [G.key]: !f[G.key] }))}
                                            className="w-full px-3 py-2 bg-[#E6F1FB] flex flex-wrap items-center gap-x-3 gap-y-0.5 text-left">
                                            <ChevronIcon className={`w-4 h-4 flex-shrink-0 text-[#0072CE] transition-transform ${folded[G.key] ? '-rotate-90' : ''}`} />
                                            <span className="text-sm font-black text-[#00468B]">{G.label}</span>
                                            <span className="text-xs font-bold text-slate-600">{lineLabelOf(G.area, G.line)}</span>
                                            <span className="text-[11px] text-slate-500">{patternTag(cfgs[G.key])}</span>
                                            <span className="ml-auto flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] font-bold text-slate-600">
                                                {G.attention > 0 && <span className="px-1.5 py-0.5 rounded border text-[10px] font-black bg-[#FDE8EC] text-[#B00020] border-[#E4002B]">{G.attention} to look at</span>}
                                                <span>{G.rows.length} run{G.rows.length === 1 ? '' : 's'} · {fmtHrs(G.hours * HOUR)} · {G.apply} to apply</span>
                                            </span>
                                        </button>
                                        {!folded[G.key] && G.rows.map(r => <RunRow key={r.p.key} r={r} ed={edits[r.p.key] || {}}
                                            onInclude={(v) => setInc(i => ({ ...i, [r.p.key]: v }))}
                                            onEdit={(patch) => setEdit(r.p.key, patch)}
                                            onReset={() => setEdits(e => { const n = { ...e }; delete n[r.p.key]; return n; })}
                                            onFlag={(patch) => setFlags(f => ({ ...f, [r.p.key]: { ...(f[r.p.key] || {}), ...patch } }))} />)}
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                    {ok && parsed.lines.some(L => L.notes.length || L.items.some(it => it.notes.length)) && (
                        <div className="mt-3 p-3 rounded-lg bg-[#FFF6E0] border border-[#FFB81C]/60">
                            <div className="text-[10px] font-black uppercase tracking-wider text-slate-600 mb-1">Notes on the sheet (not scheduled, read them)</div>
                            <ul className="text-xs text-slate-700 space-y-0.5">
                                {parsed.lines.map(L => L.items.flatMap(it => it.notes.map(n => ({ l: L.label, t: `${it.item} ${it.desc}`, n }))).concat(L.notes.map(n => ({ l: L.label, t: '', n }))).map((x, i) => <li key={L.label + i}><b>{x.l}</b> {fmtDay(parseYMD(x.n.ymd).getTime())}{x.t ? ` · ${x.t}` : ''}: <i>{x.n.text}</i></li>))}
                            </ul>
                        </div>
                    )}
                    {!view.pending && view.orphans.length > 0 && (
                        <div className="mt-3 p-3 rounded-lg bg-slate-50 border border-slate-200">
                            <div className="text-[10px] font-black uppercase tracking-wider text-slate-600 mb-1">Already on the schedule this week but not on the sheet ({view.orphans.length})</div>
                            <div className="space-y-0.5 max-h-40 overflow-y-auto">
                                {view.orphans.map(o => (
                                    <label key={o.id} className="flex items-center gap-2 text-xs text-slate-700"><input type="checkbox" checked={!!removeIds[o.id]} onChange={(e) => setRemoveIds(m => ({ ...m, [o.id]: e.target.checked }))} />
                                        <span className="font-bold">{lineLabelOf(o.area, o.line)}</span> {fmtDT(o.start)} to {fmtTime(o.end)} · {runTitle(o)}</label>
                                ))}
                            </div>
                            <p className="text-[10px] text-slate-400 mt-1">Left alone unless ticked. Ticked runs are deleted when you apply.</p>
                        </div>
                    )}
                </Section>
            )}

            {/* Outside the folding steps on purpose: Apply, its result and Undo stay reachable whichever step is folded */}
            {ok && (
                <div className="sticky bottom-0 z-30 -mx-4 px-4 py-3 bg-white/95 border-t border-slate-200 shadow-[0_-6px_14px_rgba(15,23,42,0.08)]">
                    {result && <div className={`mb-2 p-2.5 rounded-lg border text-sm font-semibold max-h-28 overflow-y-auto ${result.type === 'success' ? 'bg-[#DCFCE7] border-[#16A34A]/50 text-[#166534]' : 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B00020]'}`}>{result.message}</div>}
                    <div className="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <Btn onClick={apply} disabled={!canApply}>{applying ? `Saving ${applying.done} of ${applying.total}...` : `Apply to schedule (${toApply.length} run${toApply.length === 1 ? '' : 's'}${toRemove.length ? `, remove ${toRemove.length}` : ''})`}</Btn>
                        {applyHint && <span className="text-xs text-slate-500 font-semibold min-w-0 flex-1 basis-56">{applyHint}</span>}
                        {!apiReady && <span className="text-xs text-[#B27B00] font-bold">Preview mode: nothing is saved to Dataverse.</span>}
                        {result && result.changes && result.changes.length > 0 && !applying && <Btn kind="danger" onClick={undoImport} disabled={result.busy}>{result.busy ? 'Undoing...' : result.confirmUndo ? 'Really undo this import?' : 'Undo this import'}</Btn>}
                        {result && result.type === 'success' && ok && <Btn kind="ghost" onClick={() => onView(parseYMD(parsed.days[0].ymd).getTime())}>View week on the schedule</Btn>}
                    </div>
                </div>
            )}
        </div>
    );
}

