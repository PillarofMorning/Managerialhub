    const buildClusterUpdates = (c, forceAllRuns) => {
        const tgt = getClusterTarget(c);
        const items = [];
        c.runs.forEach(r => {
            const patch = {};
            if (tgt.area && r.area !== tgt.area) patch.area = tgt.area;
            if (tgt.line && (Number(r.line) || 1) !== tgt.line) patch.line = tgt.line;
            if (tgt.areaId && r.areaId !== tgt.areaId) patch.areaId = tgt.areaId;
            if (tgt.code !== null && !isNaN(tgt.code) && r.code !== tgt.code) patch.code = tgt.code;
            if (tgt.product && String(r.product || '').trim() !== tgt.product.trim()) patch.product = tgt.product.trim();
            if (!!r.allergen !== tgt.allergen) {
                patch.allergen = tgt.allergen;
                patch.allergenType = tgt.allergen ? (tgt.allergenType || 'Allergen') : '';
            } else if (tgt.allergen && tgt.allergenType && canon(r.allergenType) !== canon(tgt.allergenType)) {
                patch.allergen = true;
                patch.allergenType = tgt.allergenType;
            }
            if (!!r.crumb !== tgt.crumb) patch.crumb = tgt.crumb;
            const rHrs = Math.max(0, (r.end - r.start) / HOUR);
            const estCases = (c.medianCasesPerHour && rHrs > 0) ? Math.round((rHrs * c.medianCasesPerHour) / 10) * 10 : c.medianCases;
            if ((r.cases === 0 || (r.cases === null && r.code === null)) && estCases > 0) {
                patch.cases = estCases;
            }
            if (Object.keys(patch).length > 0 || forceAllRuns) {
                items.push({
                    id: r.id,
                    patch: Object.keys(patch).length > 0 ? patch : {
                        area: tgt.area,
                        line: tgt.line,
                        areaId: tgt.areaId,
                        code: tgt.code,
                        product: tgt.product,
                        allergen: tgt.allergen,
