                    <ul className="text-xs text-slate-800 space-y-1">{miss.map(c => <li key={c.name}><b>{c.label || c.name}</b> - {c.type} - <code className="px-1 bg-white rounded border border-slate-200">{c.name}</code> <span className="text-slate-500">{c.need} - {c.why}</span></li>)}</ul>
                </div>); })}
            {COLUMN_GUIDE.map(t => (
                <div key={t.key} className="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                    <div className="px-4 py-2 bg-[#E6F1FB] flex flex-wrap items-center justify-between gap-2">
