    const codeStr = String(rawCode).trim().replace(/^0+/, '') || String(rawCode).trim();
    if (!codeStr) return null;
    const product = renderSafe(r.craa5_productname || r.craa5_description || r.craa5_product || r.craa5_title || r.craa5_name || '').trim();
    const alrgStr = renderSafe(r.craa5_allergens || r.craa5_typeofallergen || r.craa5_allergentype || '').trim();
    const hasAlrg = truthy(r.craa5_allergen) || truthy(r.craa5_hasallergen) || (!!alrgStr && !/^(none|no|n\/a|-)$/i.test(alrgStr));
    const specialRules = renderSafe(r.craa5_specialrules || '').trim();
    const crumb = truthy(r.craa5_crumbclean) || truthy(r.craa5_crumb) || /crumb/i.test(specialRules);
    const rate = Math.max(0, Number(r.craa5_actualcaserate || r.craa5_idealcaserate || r.craa5_standardrunrate || r.craa5_casesperhour || r.craa5_rate) || 0);
    const area = renderSafe(r.craa5_line || r.craa5_area || r.craa5_defaultarea || '').trim();
