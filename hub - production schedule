                            <ul className="text-xs text-slate-700 space-y-0.5 max-h-40 overflow-y-auto">
                                {notesLeft.slice(0, 200).map((n, i) => <li key={i}><b>{n.line}</b>{n.ymd ? ` ${fmtDay(parseYMD(n.ymd).getTime())}` : ''}{active.length > 1 ? ` (${n.sheet})` : ''}: <i>{n.text}</i> <span className="text-slate-400">({n.why})</span></li>)}
                            </ul>
                        </div>
                    )}
                    {!pending && view.orphans.length > 0 && (
                        <div className="mt-3 p-3 rounded-lg bg-slate-50 border border-slate-200">
                            <div className="text-[10px] font-black uppercase tracking-wider text-slate-600 mb-1">Already on the schedule in these weeks but not on the sheets ({view.orphans.length})</div>
                            <div className="space-y-0.5 max-h-40 overflow-y-auto">
                                {orphanShown.map(o => (
