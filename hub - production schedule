function ImportView({ areaOptions, lineChoices, settings, updateSettings, api, gapCtx, onDone, onView, apiReady, onOpenCheck, reloadTick }) {
    const [text, setText] = useState('');
    const [sheets, setSheets] = useState([]);        // [{ id, name, grid, comments, weekStart, parsed }] one per week sheet read
