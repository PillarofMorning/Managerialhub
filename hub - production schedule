    const d = new Date(2000, 0, 1); d.setFullYear(y, mo, day);
    return d.getMonth() === mo && d.getDate() === day ? d : null;
};
const withTime = (day, hhmm) => { const m = /^(\d{1,2}):(\d{2})/.exec(hhmm || ''); return m ? new Date(day.getFullYear(), day.getMonth(), day.getDate(), Number(m[1]), Number(m[2])) : null; };
const hhmmOf = (ms) => { const d = new Date(ms); return `${pad2(d.getHours())}:${pad2(d.getMinutes())}`; };
