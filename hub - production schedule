function RunDialog({ draft: initial, areaOptions, lineChoices, mssNames, recall, gapCtx, allRuns, onSave, onDelete, onSwap, onDuplicate, onClose, busy, canSwap, notesMissing, ovMissing, onOpenCallout }) {
