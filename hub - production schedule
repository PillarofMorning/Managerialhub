                <div ref={barRef} className="sticky bottom-0 z-30 -mx-4 px-4 py-3 bg-white/95 border-t border-slate-200 shadow-[0_-6px_14px_rgba(15,23,42,0.08)]">
                    {result && (
                        <div className={`mb-2 p-2.5 rounded-lg border text-sm font-semibold max-h-32 overflow-y-auto ${result.type === 'success' ? 'bg-[#DCFCE7] border-[#16A34A]/50 text-[#166534]' : result.type === 'warn' ? 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800' : 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B00020]'}`} data-testid="cr-result">
                            <div>{result.message}</div>
