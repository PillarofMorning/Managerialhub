                                                    : { text: it.numLines > 1 ? `Primary (${it.numLines} Lines)` : 'Primary (1 Line)', cls: 'bg-emerald-100 text-emerald-800' };
                                            return (
                                                <tr key={it.name} className={it.line ? 'bg-white hover:bg-slate-50/80' : 'bg-slate-50/60 text-slate-400'}>
                                                    <td className="py-2 px-3">
                                                        <select
                                                            className="border border-slate-300 rounded-lg px-1.5 py-1 text-sm bg-white"
                                                            value={it.emoji || ''}
                                                            onChange={(e) => saveAreaConfigToDataverse(it, { emoji: e.target.value })}
                                                        >
                                                            <option value={it.emoji || ''}>{it.emoji || cpStr(0x1F3ED)}</option>
                                                            {EMOJI_PRESETS.map(p => <option key={p.label} value={p.icon}>{p.icon} {p.label}</option>)}
                                                        </select>
                                                    </td>
                                                    <td className="py-2 px-3 font-black text-slate-800">{it.name}</td>
                                                    <td className="py-2 px-3">
                                                        <input
                                                            type="checkbox"
                                                            checked={!!it.line}
                                                            onChange={(e) => saveAreaConfigToDataverse(it, { runs: e.target.checked })}
                                                            className="w-4 h-4 accent-[#0072CE] cursor-pointer"
                                                        />
                                                    </td>
                                                    <td className="py-2 px-3">
                                                        <input
                                                            type="number"
                                                            min={1}
                                                            max={16}
                                                            defaultValue={it.numLines || 1}
                                                            onBlur={(e) => {
                                                                const v = clamp(parseInt(e.target.value, 10) || 1, 1, 16);
                                                                if (v !== it.numLines) saveAreaConfigToDataverse(it, { numLines: v });
                                                            }}
                                                            className="w-16 border border-slate-300 rounded-lg px-2 py-1 text-xs font-bold text-slate-800"
                                                        />
                                                    </td>
                                                    <td className="py-2 px-3">
                                                        <input
                                                            type="text"
                                                            defaultValue={it.supportingRaw || ''}
                                                            placeholder="e.g. Line 2, Line 3, Hand Pack"
                                                            onBlur={(e) => {
                                                                const v = e.target.value.trim();
                                                                if (v !== (it.supportingRaw || '')) saveAreaConfigToDataverse(it, { supportingRaw: v });
                                                            }}
                                                            className="w-56 border border-slate-300 rounded-lg px-2 py-1 text-xs font-mono text-slate-800"
                                                        />
                                                    </td>
                                                    <td className="py-2 px-3">
                                                        <input
                                                            type="text"
                                                            defaultValue={it.offsetRaw || ''}
                                                            placeholder="e.g. 90 or 90, 60"
                                                            onBlur={(e) => {
                                                                const v = e.target.value.trim();
                                                                if (v !== (it.offsetRaw || '')) saveAreaConfigToDataverse(it, { offsetRaw: v });
                                                            }}
                                                            className="w-36 border border-slate-300 rounded-lg px-2 py-1 text-xs font-mono text-slate-800"
                                                        />
                                                    </td>
                                                    <td className="py-2 px-3">
                                                        <span className={`px-2 py-0.5 rounded-full text-[10px] font-black ${role.cls}`}>{role.text}</span>
                                                    </td>
                                                </tr>
                                            );
                                        })}
                                    </tbody>
                                </table>
                            </div>

                            {/* Equipment-Level Supporting Line & Early Clean Offset Assignment */}
                            <div className="space-y-2 pt-2 border-t border-slate-200">
                                <div className="font-black text-[#00468B] uppercase tracking-wider">Supporting Equipment Pieces & Variable Clean Offsets (craa5_aa_assets)</div>
                                <p className="text-[11px] text-slate-500">Attach specific supporting equipment pieces (e.g. Custard Kettles, Mixers, Holding Tanks) to one or more primary lines and set how many minutes early they can stop and begin cleaning before the primary line stops.</p>
                                <div className="overflow-x-auto border border-slate-200 rounded-xl max-h-64">
                                    <table className="w-full text-left border-collapse">
                                        <thead>
                                            <tr className="bg-slate-100 text-[10px] font-black uppercase tracking-wider text-slate-500 border-b border-slate-200 sticky top-0">
                                                <th className="py-2 px-3">Area</th>
                                                <th className="py-2 px-3">Equipment Piece</th>
                                                <th className="py-2 px-3">Clean Mins</th>
                                                <th className="py-2 px-3">Supported Primary Line(s) (craa5_supportedline)</th>
                                                <th className="py-2 px-3">Early Clean Offset Mins (craa5_cleanoffsetmins)</th>
                                            </tr>
                                        </thead>
                                        <tbody className="divide-y divide-slate-200">
                                            {assetList.slice(0, 80).map(eq => (
                                                <tr key={eq.id || eq.equipId || eq.name} className="hover:bg-slate-50">
                                                    <td className="py-1.5 px-3 font-bold text-slate-700">{eq.area}</td>
                                                    <td className="py-1.5 px-3 font-semibold text-slate-800">{eq.name}</td>
                                                    <td className="py-1.5 px-3 font-mono text-slate-600">{eq.mins}m</td>
                                                    <td className="py-1.5 px-3">
                                                        <input
                                                            type="text"
                                                            defaultValue={eq.supportedLine || ''}
                                                            placeholder="Inherits area or e.g. Line 2, Line 3"
                                                            onBlur={(e) => {
                                                                const v = e.target.value.trim();
                                                                if (v !== (eq.supportedLine || '')) saveAssetSupportToDataverse(eq, { supportedLine: v });
                                                            }}
                                                            className="w-56 border border-slate-300 rounded px-2 py-1 text-xs font-mono"
                                                        />
                                                    </td>
                                                    <td className="py-1.5 px-3">
                                                        <input
                                                            type="number"
                                                            min={0}
                                                            max={720}
                                                            defaultValue={eq.cleanOffsetMins || 0}
                                                            onBlur={(e) => {
                                                                const v = Math.max(0, parseInt(e.target.value, 10) || 0);
                                                                if (v !== (eq.cleanOffsetMins || 0)) saveAssetSupportToDataverse(eq, { cleanOffsetMins: v });
                                                            }}
                                                            className="w-24 border border-slate-300 rounded px-2 py-1 text-xs font-mono"
                                                        />
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* Modal 3: Redzone Floor Callouts Modal */}
            {calloutModal && (
                <div className="fixed inset-0 z-[120] bg-slate-900/50 flex items-center justify-center p-4" onClick={() => setCalloutModal(null)}>
                    <div className="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden" onClick={(e) => e.stopPropagation()}>
                        <div className="px-5 py-3.5 bg-rose-700 text-white flex items-center justify-between">
                            <div>
                                <h3 className="text-sm font-black uppercase tracking-widest">Redzone Floor Callout & Bottleneck Log</h3>
                                <p className="text-[11px] text-rose-100">Pin live floor alerts (Maintenance, QA Hold, Sanitation Wait, Material Starved) to lines</p>
                            </div>
                            <button type="button" onClick={() => setCalloutModal(null)} className="text-white/80 hover:text-white"><XIcon className="w-5 h-5" /></button>
                        </div>
                        <div className="p-5 space-y-4 text-xs">
                            <div className="grid grid-cols-2 gap-3">
                                <label className="block">
                                    <span className="text-[10px] font-black uppercase tracking-wider text-slate-500">Production Line</span>
                                    <select
                                        className="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-bold"
                                        value={calloutModal.lineKey}
                                        onChange={(e) => {
                                            const r = allRows.find(x => x.key === e.target.value);
                                            setCalloutModal(prev => ({ ...prev, lineKey: e.target.value, label: r ? r.label : e.target.value }));
                                        }}
                                    >
                                        {allRows.map(r => <option key={r.key} value={r.key}>{r.emoji ? `${r.emoji} ` : ''}{r.label}</option>)}
                                    </select>
                                </label>
                                <label className="block">
                                    <span className="text-[10px] font-black uppercase tracking-wider text-slate-500">Callout Category</span>
                                    <select
                                        className="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-bold"
                                        value={calloutModal.type}
                                        onChange={(e) => setCalloutModal(prev => ({ ...prev, type: e.target.value }))}
                                    >
                                        <option value="MAINT">MAINT - Equipment / Mechanical Down</option>
                                        <option value="QA HOLD">QA HOLD - Quality / Swab / Micro Hold</option>
                                        <option value="SANITATION WAIT">SANITATION WAIT - Crew / Early Clean Hold</option>
                                        <option value="MATERIAL STARVED">MATERIAL STARVED - Supporting Prep / Packaging</option>
                                        <option value="CREW SHORT">CREW SHORT - Staffing Bottleneck</option>
                                    </select>
                                </label>
                            </div>
                            <label className="block">
                                <span className="text-[10px] font-black uppercase tracking-wider text-slate-500">Floor Note / Action Required</span>
                                <input
                                    type="text"
                                    value={calloutModal.note}
                                    onChange={(e) => setCalloutModal(prev => ({ ...prev, note: e.target.value }))}
                                    placeholder="e.g. Waiting on Custard Kettle 2CIP before Line 2 changeover..."
                                    className="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs"
                                />
                            </label>
                            <div className="flex justify-end gap-2">
                                <Btn kind="ghost" onClick={() => setCalloutModal(null)}>Close</Btn>
                                <Btn kind="red" onClick={() => {
                                    const lineRuns = runs.filter(r => lineKeyOf(r.area, r.line) === calloutModal.lineKey);
                                    const activeRun = (calloutModal.runId && runs.find(r => r.id === calloutModal.runId))
                                        || lineRuns.find(r => r.start <= nowMs && r.end >= nowMs)
                                        || lineRuns.slice().sort((a, b) => Math.abs(a.start - nowMs) - Math.abs(b.start - nowMs))[0]
                                        || null;
                                    const entry = {
                                        id: `co-${Date.now()}`,
                                        lineKey: calloutModal.lineKey,
                                        label: calloutModal.label,
                                        runId: activeRun ? activeRun.id : (calloutModal.runId || ''),
                                        type: calloutModal.type || 'MAINT',
                                        note: (calloutModal.note || '').trim() || calloutModal.type,
                                        at: Date.now(),
                                        resolved: false,
                                    };
                                    const nextFloor = [entry].concat(settings.floorCallouts || []).slice(0, 100);
                                    updateSettings(s => ({ ...s, floorCallouts: [entry].concat(s.floorCallouts || []).slice(0, 100) }));
                                    if (activeRun && activeRun.id) {
                                        const runCallouts = nextFloor.filter(x => x.runId === activeRun.id || (!x.runId && x.lineKey === calloutModal.lineKey)).slice(0, 25);
                                        const nextJson = JSON.stringify(runCallouts);
                                        setRuns(prev => prev.map(r => r.id === activeRun.id ? { ...r, callouts: runCallouts, calloutsJson: nextJson } : r));
                                        deliver('update', activeRun.id, {}, { [F_CALLOUTS]: nextJson }, { what: 'callout', quiet: true })
                                            .then(res => rememberSide(activeRun.id, { calloutsJson: nextJson }, res.dropped))
                                            .catch(() => rememberSide(activeRun.id, { calloutsJson: nextJson }, [F_CALLOUTS]));
                                    }
                                    setCalloutModal(prev => ({ ...prev, note: '' }));
                                    notify(`Pinned ${entry.type} callout on ${entry.label}.`, 'warn');
                                }}>Pin Callout to Line</Btn>
                            </div>

                            {/* Active Callouts List */}
                            <div className="border-t border-slate-200 pt-3 space-y-2 max-h-56 overflow-y-auto">
                                <div className="text-[10px] font-black uppercase tracking-wider text-slate-400">Open Floor Callouts ({(settings.floorCallouts || []).filter(c => !c.resolved).length})</div>
                                {(settings.floorCallouts || []).filter(c => !c.resolved).length === 0 && (
                                    <p className="text-slate-400 text-xs">No active floor callouts.</p>
                                )}
                                {(settings.floorCallouts || []).filter(c => !c.resolved).map(c => (
                                    <div key={c.id} className="p-2.5 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-between gap-2">
                                        <div>
                                            <div className="font-black text-rose-900">{c.label} - <span className="px-1.5 py-0.5 rounded bg-rose-600 text-white text-[10px]">{c.type}</span></div>
                                            <div className="text-slate-700 mt-0.5">{c.note}</div>
                                            <div className="text-[10px] text-slate-400 mt-0.5">{fmtDT(c.at)}</div>
                                        </div>
                                        <Btn kind="ghost" onClick={() => {
                                            const nextFloor = (settings.floorCallouts || []).map(x => x.id === c.id ? { ...x, resolved: true } : x);
                                            updateSettings(s => ({
                                                ...s,
                                                floorCallouts: (s.floorCallouts || []).map(x => x.id === c.id ? { ...x, resolved: true } : x),
                                            }));
                                            const lineRuns = runs.filter(r => lineKeyOf(r.area, r.line) === c.lineKey);
                                            const targetRun = (c.runId && runs.find(r => r.id === c.runId))
                                                || lineRuns.find(r => Array.isArray(r.callouts) && r.callouts.some(rc => rc.id === c.id))
                                                || lineRuns[0]
                                                || null;
                                            if (targetRun && targetRun.id) {
                                                const runCallouts = nextFloor.filter(x => x.runId === targetRun.id || (!x.runId && x.lineKey === c.lineKey)).slice(0, 25);
                                                const nextJson = JSON.stringify(runCallouts);
                                                setRuns(prev => prev.map(r => r.id === targetRun.id ? { ...r, callouts: runCallouts, calloutsJson: nextJson } : r));
                                                deliver('update', targetRun.id, {}, { [F_CALLOUTS]: nextJson }, { what: 'callout resolve', quiet: true })
                                                    .then(res => rememberSide(targetRun.id, { calloutsJson: nextJson }, res.dropped))
                                                    .catch(() => rememberSide(targetRun.id, { calloutsJson: nextJson }, [F_CALLOUTS]));
                                            }
                                            notify(`Resolved callout on ${c.label}.`, 'success');
                                        }}>Resolve</Btn>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {dialog && <RunDialog key={dialog.draft.id || 'new'} draft={dialog.draft} areaOptions={areaOptions} lineChoices={lineChoices} mssNames={mss.names} recall={recallOne} gapCtx={gapCtx} allRuns={runs} busy={dialogBusy} canSwap={dialogCanSwap}
                notesMissing={!!colStateRef.current.refused[F_NOTES]} ovMissing={!!colStateRef.current.refused[F_CLEAN_OV]} onSave={saveDialog} onDelete={deleteDialog} onDuplicate={duplicateRun} onSwap={(d, dir) => { swapWithNeighbour(d.id, dir); setDialog(null); }} onClose={() => setDialog(null)} />}
        </div>
    );
}