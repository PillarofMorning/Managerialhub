    };
    // What the memoized lines call. The functions above are new on every render, so the lines get this fixed object that
    // always reaches the latest of them (a line only redraws when its own data changes).
    const live = useRef({});
    live.current = {
        startDrag, onOpen,
        addAt: (row, clientX) => { const rect = trackRef.current.getBoundingClientRect(); onNewRun(row, snapMs(rangeFrom + ((clientX - rect.left) / rect.width) * rangeMs, false)); },
    };
    const rowApi = useMemo(() => ({
        row: (key, el) => { if (el) rowRefs.current[key] = el; else delete rowRefs.current[key]; },
        down: (e, r, mode) => live.current.startDrag(e, r, mode),
        open: (r) => live.current.onOpen(r),
        addAt: (row, x) => live.current.addAt(row, x),
    }), []);

    // columns: one per local day
    const dayCells = useMemo(() => {
        const out = [];
        for (let i = 0; i < rangeDays; i++) { const d = addDaysLocal(new Date(rangeFrom), i); out.push({ ms: d.getTime(), next: addDaysLocal(d, 1).getTime(), dow: d.getDay(), date: d.getDate(), month: d.getMonth(), label: fmtDayHead(d.getTime()) }); }
        return out;
    }, [rangeFrom, rangeDays]);
    // hour lines: as many as leave room for a label (every hour on a day, every 6 h over a week, noon and midnight over 2 weeks, none after)
    const hoursInRange = Math.max(1, rangeMs / HOUR);
    let hourStep = 0;
    if (rangeDays <= 14) for (let i = 0; i < GRID_STEPS.length; i++) if (GRID_STEPS[i] * (trackW / hoursInRange) >= 34) { hourStep = GRID_STEPS[i]; break; }
    const hourTicks = useMemo(() => {
        const out = [];
        if (!hourStep) return out;
