                                <span className={`px-1.5 py-0.5 rounded border text-[10px] font-black ${x.st.s === 'found' ? 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' : x.st.s === 'missing' ? 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' : 'bg-slate-100 text-slate-500 border-slate-300'}`}>{x.st.s === 'found' ? 'FOUND' : x.st.s === 'missing' ? 'MISSING' : 'NOT TESTED'}</span>
                                <span className="text-[10px] font-black uppercase tracking-wider text-slate-400">{x.c.need}</span>
                                {x.c.type && <span className="text-slate-500 font-semibold">{x.c.type}</span>}
                                <span className="text-slate-600 min-w-0 flex-1 basis-64">{x.c.why}</span>
                                {x.st.n > 0 && <span className="text-[10px] text-slate-400">sent with {fmtNum(x.st.n)} save{x.st.n === 1 ? '' : 's'}</span>}
                                {x.st.why && x.st.s === 'missing' && <span className="text-[10px] text-[#B00020] basis-full truncate" title={x.st.why}>{x.st.why}</span>}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    );
}

