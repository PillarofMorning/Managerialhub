}
// Trade the places of two neighbours on one line: the span they cover and the gap between them stay as they are.
function swapPlan(first, second) {
    const gap = Math.max(0, second.start - first.end);
    const dF = first.end - first.start, dS = second.end - second.start;
    const sStart = first.start, sEnd = first.start + dS;
    const fStart = sEnd + gap, fEnd = fStart + dF;
    return { mode: 'swap', updates: [{ id: second.id, patch: { start: sStart, end: sEnd } }, { id: first.id, patch: { start: fStart, end: fEnd } }] };
}

// ============================================================================
// GAPS: the cleaning window before and after a run (used by the Gantt, the edit dialog and the import and change request previews)
//   ctx = { clean (the Cleaning Times settings), own, occ (shift occurrences), assetsByArea, fallbackHeads }
// ============================================================================
const gapText = (g) => g ? g.reason || '' : '';
