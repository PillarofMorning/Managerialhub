                                    <button type="button" onClick={() => setMonth(new Date(month.getFullYear(), month.getMonth() + 1, 1))} className="px-3 py-1 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-md">{'Next >'}</button>
