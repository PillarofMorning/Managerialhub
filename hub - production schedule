const NO_ITEMS = [];
const hourLabel = (h) => `${h % 12 || 12}${h >= 12 ? 'p' : 'a'}`;   // 6a, 12p, 6p

const GanttRow = memo(function GanttRow({ row, vis, rowGaps, occProd, occSan, rangeFrom, rangeTo, rangeMs, trackW, showClean, stripH, selId, dragId, gh, issueMap, uncoveredMap, api }) {
