                    <div className="grid sm:grid-cols-2 gap-2" data-testid="skip-words">
                        <Field label={tx('Midweek clean leaves out', 'La limpieza de media semana no incluye')} hint={skipHint(skipM, L.rule.midweekHours > 0 ? tx('Nothing left out', 'No se deja nada fuera') : tx('Only used on 72 h lines (IBL4)', 'Solo para lineas de 72 h (IBL4)'))}>
                            <input className={inputCls} value={L.cfg.skipMidweek !== undefined ? L.cfg.skipMidweek : CR_SKIP_DEFAULT.midweek} placeholder="caseout, dry clean, freezer" onChange={(e) => setCfg({ skipMidweek: e.target.value })} data-testid="skip-midweek" />
                        </Field>
