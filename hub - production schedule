                            <span className={`font-black ${e.ok ? 'text-[#166534]' : 'text-[#B00020]'}`}>{e.ok ? (e.preview ? 'preview' : 'saved') : 'FAILED'}</span>
                        </button>
                        {!e.ok && <div className="px-3 pb-1 text-[11px] text-[#B00020] font-semibold">{e.error}</div>}
                        {openId === e.n && <pre className="mx-3 mb-2 p-2 rounded bg-slate-900 text-slate-100 text-[11px] overflow-x-auto max-h-56 overflow-y-auto">{JSON.stringify(e.fields, null, 2)}</pre>}
                    </div>
                ))}
