        options.forEach(o => { const k = canon(o.label); if (k === q) a.push(o); else if (k.indexOf(q) === 0) b.push(o); else if (k.indexOf(q) >= 0) c.push(o); });
        return a.concat(b, c);
    }, [options, typed, q]);
    const exact = options.some(o => canon(o.value) === q);
    const showNew = !!allowNew && typed && !!q && !exact;
