                                        <span className="font-bold">{lineLabelOf(o.area, o.line)}</span> {fmtDT(o.start)} to {fmtTime(o.end)} · {runTitle(o)}</label>
                                ))}
                                {view.orphans.length > orphanShown.length && <div className="text-[10px] text-slate-400">... and {view.orphans.length - orphanShown.length} more (not listed)</div>}
