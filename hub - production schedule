    const gapCtx = useMemo(() => ({ occ, own, cleanCfg: (lk) => settings.clean[lk], assetsByArea, fallbackHeads: settings.cleanHeads }), [occ, own, settings.clean, assetsByArea, settings.cleanHeads]);
    const analysis = useMemo(() => {
