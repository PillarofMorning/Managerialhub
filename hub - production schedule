    mine.forEach(o => { if (o.start > s && o.start < e) pts.push(o.start); if (o.end > s && o.end < e) pts.push(o.end); });
    pts.sort((x, y) => x - y);
    let weighted = 0, min = Infinity, uncovered = 0;
    for (let i = 0; i + 1 < pts.length; i++) {
        const a = pts[i], b = pts[i + 1];
        if (b <= a) continue;
        const mid = (a + b) / 2;
        let h = 0;
        mine.forEach(o => { if (o.start <= mid && o.end > mid) h += o.heads; });
        weighted += h * (b - a); min = Math.min(min, h);
        if (h <= 0) uncovered += b - a;
    }
    const span = Math.max(1, e - s);
    return { avg: weighted / span, min: min === Infinity ? 0 : min, uncovered, any: mine.length > 0 };
}

// ============================================================================
// MSS (craa5_aa_ms_assets) + EQUIPMENT (craa5_aa_assets) + RUN RULES (craa5_changeover_rule) AUTO-LINKER
//   - MSS supplies the frequency linked to down windows (Daily SAP order craa5_sapdaily, 72h Midweek NS order, Weekend EOW Weekly craa5_sapw).
//   - Assets supplies the time required (minutes) and crew head cap per piece based on that frequency.
//   - Run Rules (craa5_changeover_rule) + built-in plant defaults govern how stops are cleaned:
//       * If a line is down every day, it is cleaned every week (Daily clean on daily down windows if daily pieces exist, and EOW/Weekly clean on the weekend).
//       * EOW / Weekly cleans are done on the weekend (Fri 18:00 - Mon 06:00).
//       * Midweek clean is triggered after 72 hours of run time for IBL4 only (unless another line is configured in Run Rules).
// ============================================================================
function readMsAssetRow(r, i) {
    const id = String(r.craa5_aa_ms_assetsid || r.id || `ms_${i}`).toLowerCase().trim();
    const name = String(r.craa5_title || r.craa5_equipment || r.craa5_equipmentidentifier || r.craa5_name || '').trim();
    const area = String(r.craa5_textarea || r.craa5_area || r.craa5_areaname || '').trim();
    const room = String(r.craa5_textroom || r.craa5_room || r.craa5_roomname || '').trim();
    const assetId = String(r._craa5_asset_value || r.craa5_asset || r.craa5_olduid || '').toLowerCase().trim();
    const areaId = String(r._craa5_area_lu_value || r.craa5_area_lu || r._craa5_area_value || r._craa5_area_lookup_value || '').toLowerCase().trim();
    const sapDaily = String(r.craa5_sapdaily || '').toUpperCase().trim();
    const sapWeekly = String(r.craa5_sapw || r.craa5_sapbiweekly || '').toUpperCase().trim();
    const sapShift = String(r.craa5_sapshift || '').toUpperCase().trim();
    const sapMonthly = String(r.craa5_sapmonthly || r.craa5_sapm || r.craa5_saptwomonth || '').toUpperCase().trim();
    const sapQuarterly = String(r.craa5_sapquarterly || r.craa5_sapq || r.craa5_sapsixmonth || r.craa5_sap2xyear || '').toUpperCase().trim();
    const sapAnnual = String(r.craa5_sapannual || '').toUpperCase().trim();
    const freqText = String(r.craa5_freqofclean || '').trim();
    const rawMsVal = Math.max(0, Number(r.craa5_minstoclean || r.craa5_hourstoclean || r.craa5_hoursrequired) || 0);
    const mins = (rawMsVal > 0 && rawMsVal <= 16 && !r.craa5_minstoclean) ? Math.round(rawMsVal * 60) : Math.round(rawMsVal);
    const heads = Math.max(1, Number(r.craa5_headstoclean || r.craa5_heads) || 1);
    return { id, name, area, room, assetId, areaId, sapDaily, sapWeekly, sapShift, sapMonthly, sapQuarterly, sapAnnual, freqText, mins, heads };
}

function classifySapFreq(sapDaily, sapWeekly, deptCode, workCode, freqText, rowFlags, areaName) {
    const codes = [sapDaily, sapWeekly, deptCode, workCode].map(c => String(c || '').toUpperCase().trim()).filter(Boolean);
    const cArea = canon(areaName || '');
    const isIbl4Area = cArea.indexOf('ibl4') === 0;
    let daily = !!(rowFlags && rowFlags.daily);
    let midweek = !!(rowFlags && rowFlags.midweek);
    let weekly = !!(rowFlags && rowFlags.weekly);

    if (sapDaily) {
        if (/(?:NS|MW|72)$/i.test(sapDaily) || isIbl4Area) { midweek = true; daily = true; }
        else if (/W$/i.test(sapDaily)) { weekly = true; }
        else { daily = true; }
    }
    if (sapWeekly) {
        weekly = true;
    }
    codes.forEach(code => {
        if (/(?:NS|MW|72)$/i.test(code)) { midweek = true; daily = true; }
        else if (/(?:PSW|W)$/i.test(code)) { weekly = true; }
        else if (/D$/i.test(code) && !/ND$/i.test(code)) {
            if (isIbl4Area) { midweek = true; daily = true; }
            else daily = true;
        }
    });
    if (freqText) {
        if (/mid\s*week|72\s*h|non[-\s]*stop/i.test(freqText)) { midweek = true; daily = true; }
        if (/daily/i.test(freqText)) daily = true;
        if (/week|eow/i.test(freqText)) weekly = true;
    }
    return { daily, midweek, weekly, flagged: daily || midweek || weekly, codes };
}

function readRunRuleRow(r, i) {
    const id = String(r.craa5_changeover_ruleid || `rule_${i}`);
    let cond = {};
    try {
        const rawJson = String(r.craa5_rule_condition_json || '').trim();
        if (rawJson && rawJson.charAt(0) === '{') cond = JSON.parse(rawJson) || {};
    } catch (e) {}
    const parsedFromLine = parseAreaAndLine(String(r.craa5_line || ''), 1);
    const name = String(r.craa5_name || cond.name || r.craa5_rulename || r.craa5_title || r.craa5_area || cond.area || `Rule ${i + 1}`).trim();
    const area = String(cond.area || r.craa5_area || (parsedFromLine.baseArea && !/^\d+$/.test(parsedFromLine.baseArea) ? parsedFromLine.baseArea : '') || name).trim();
    const lineNumCandidate = cond.line ?? (!isNaN(Number(r.craa5_line)) && Number(r.craa5_line) > 0 ? Number(r.craa5_line) : parsedFromLine.line);
    const line = Math.max(1, Math.floor(Number(lineNumCandidate) || 1));
    const cLine = canonLine(area, line);
    const isIbl4 = cLine === 'ibl4' || canon(area).indexOf('ibl4') === 0;
    const runPattern = String(cond.runPattern || r.craa5_runpattern || (isIbl4 ? 'continuous_72h' : 'daily_down')).toLowerCase().trim();
    const downFrequency = String(cond.downFrequency || r.craa5_downfrequency || r.craa5_cleanrule || (isIbl4 ? 'midweek_72h_and_weekend_eow' : 'daily_and_weekend_eow')).toLowerCase().trim();
    const rawMw = cond.midweekHours ?? r.craa5_midweekhours;
    const midweekHours = rawMw !== undefined && rawMw !== null && rawMw !== ''
        ? Math.max(0, Number(rawMw) || 0)
        : (isIbl4 || runPattern === 'continuous_72h' || downFrequency.indexOf('72') > -1 ? 72 : 0);
    const rawEow = cond.eowWeekend ?? r.craa5_eowweekend;
    const eowWeekend = rawEow === undefined || rawEow === null ? true : !!rawEow;
    const dailyDownMin = Math.max(15, Number(cond.dailyDownMin ?? r.craa5_base_wash_minutes ?? r.craa5_dailydownmin) || 60);
    const rawChange = cond.changeoverMins ?? cond.changeMins ?? r.craa5_changeovermins;
    const changeMins = rawChange !== undefined && rawChange !== null && rawChange !== '' ? Number(rawChange) : null;
    const rawCrumb = cond.crumbMins ?? r.craa5_crumbmins;
    const crumbMins = rawCrumb !== undefined && rawCrumb !== null && rawCrumb !== '' ? Number(rawCrumb) : null;
    const rawAlrg = cond.allergenMins ?? r.craa5_allergenmins;
    const allergenMins = rawAlrg !== undefined && rawAlrg !== null && rawAlrg !== '' ? Number(rawAlrg) : null;
    const sapDaily = String(cond.sapDaily || r.craa5_sapdaily || '').toUpperCase().trim();
    const sapMidweek = String(cond.sapMidweek || r.craa5_sapmidweek || '').toUpperCase().trim();
    const sapWeekly = String(cond.sapWeekly || r.craa5_sapweekly || '').toUpperCase().trim();
    const headsRequired = Math.max(0, Number(r.craa5_heads_required ?? cond.headsRequired) || 0);
    const requiresSwab = r.craa5_requires_swab !== undefined ? !!r.craa5_requires_swab : (cond.requiresSwab !== undefined ? !!cond.requiresSwab : true);
    const active = r.craa5_active !== undefined ? !!r.craa5_active : (cond.active !== undefined ? !!cond.active : true);
    const out = {
        id, name, area, line, cLine, runPattern, downFrequency, midweekHours, eowWeekend,
        dailyDownMin, changeMins, crumbMins, allergenMins, sapDaily, sapMidweek, sapWeekly,
        headsRequired, requiresSwab, active, fromTable: true
    };
    // what the Midweek and Daily cleans leave out (words), when the rule says (see CR_SKIP_DEFAULT)
    if (cond.skipMidweek !== undefined && cond.skipMidweek !== null) out.skipMidweek = String(cond.skipMidweek);
    if (cond.skipDaily !== undefined && cond.skipDaily !== null) out.skipDaily = String(cond.skipDaily);
    return out;
}

function defaultLineRule(area, line, pieces) {
    const cLine = canonLine(area, line);
    const cArea = canon(area);
    const isIbl4 = cLine === 'ibl4' || cArea.indexOf('ibl4') === 0;
    // a Midweek flag only matters on a 72 h line: IBL5 or Waterjet equipment marked Daily and Midweek is still cleaned nightly
    const hasDailyPieces = (pieces || []).some(p => p.daily && (isIbl4 ? !p.midweek : true));
    const hasMidweekPieces = (pieces || []).some(p => p.midweek);
    const hasWeeklyPieces = (pieces || []).some(p => p.weekly);
    const sapDailySet = {}, sapMidweekSet = {}, sapWeeklySet = {};
    (pieces || []).forEach(p => {
        if (p.sapDaily) {
            if (/(?:NS|MW|72)$/i.test(p.sapDaily) || isIbl4) sapMidweekSet[p.sapDaily] = true;
            else sapDailySet[p.sapDaily] = true;
        }
        if (p.sapWeekly) sapWeeklySet[p.sapWeekly] = true;
        (p.sapCodes || []).forEach(c => {
            if (/(?:NS|MW|72)$/i.test(c)) sapMidweekSet[c] = true;
            else if (/(?:PSW|W)$/i.test(c)) sapWeeklySet[c] = true;
            else if (/D$/i.test(c) && !/ND$/i.test(c)) {
                if (isIbl4) sapMidweekSet[c] = true;
                else sapDailySet[c] = true;
            }
        });
    });
    const runPattern = isIbl4 ? 'continuous_72h' : 'daily_down';
    const downFrequency = isIbl4
        ? 'midweek_72h_and_weekend_eow'
        : (hasDailyPieces || !hasWeeklyPieces ? 'daily_and_weekend_eow' : 'weekly_weekend_only');
    return {
        id: `default_${cLine}`,
        name: Number(line) > 1 ? `${area} L${line}` : String(area || cLine),
        area: String(area || ''),
        line: Math.max(1, Number(line) || 1),
        cLine,
        runPattern,
        downFrequency,
        midweekHours: isIbl4 ? 72 : 0,
        eowWeekend: true,
        dailyDownMin: CR_FULL_MIN,
        changeMins: null,
        crumbMins: null,
        allergenMins: null,
        sapDaily: Object.keys(sapDailySet).sort().join(', '),
        sapMidweek: Object.keys(sapMidweekSet).sort().join(', '),
        sapWeekly: Object.keys(sapWeeklySet).sort().join(', '),
        hasDailyPieces,
        hasMidweekPieces,
        hasWeeklyPieces,
        fromTable: false,
    };
}

// Links MSS rows (craa5_aa_ms_assets) and Equipment rows (craa5_aa_assets) into unified equipment pieces grouped by area.
// Equipment (craa5_aa_assets) is the primary source of truth for plant areas, rooms, equipment names, clean minutes, and headcount caps.
function buildUnifiedAssets(rawAssets, rawMsAssets, equipSupportOverrides) {
    const msRows = (rawMsAssets || []).map(readMsAssetRow).filter(m => m.name || m.area);
    const msByAssetId = {}, msByAreaName = {}, msByName = {};
    msRows.forEach(m => {
        if (m.assetId) (msByAssetId[m.assetId] = msByAssetId[m.assetId] || []).push(m);
        const ak = `${canon(m.area)}|${canon(m.name)}`;
        if (m.name) {
            (msByAreaName[ak] = msByAreaName[ak] || []).push(m);
            (msByName[canon(m.name)] = msByName[canon(m.name)] || []).push(m);
        }
    });

    const matchedMsIds = {};
    const unified = [];

    (rawAssets || []).forEach((a, idx) => {
        const assetId = String(a.craa5_aa_assetsid || a.id || `asset_${idx}`).toLowerCase().trim();
        const name = String(a.craa5_equipmentidentifier || a.craa5_ValidationName || a.craa5_validationname || a.craa5_equipment || a.craa5_name || 'Equipment').trim();
        const area = String(a.craa5_areaname || a.craa5_area || a.craa5_Area || 'Unassigned').trim();
        const room = String(a.craa5_roomname || a.craa5_room || a.craa5_subarea || a.craa5_zone || '').trim();
        const areaId = String(a._craa5_area_lookup_value || a.craa5_area_lookup || a._craa5_area_value || a._craa5_area_lu_value || '').toLowerCase().trim();
        const deptCode = String(a.craa5_departmentcode || a.craa5_sapdaily || '').toUpperCase().trim();
        const workCode = String(a.craa5_workareacode || a.craa5_sapw || a.craa5_sapbiweekly || '').toUpperCase().trim();
        const eqOv = (equipSupportOverrides && equipSupportOverrides[assetId]) || {};
        const supportedLineRaw = String(eqOv.supportedLine !== undefined ? eqOv.supportedLine : (a.craa5_supportedline || a.craa5_SupportedLine || a.craa5_associatedline || '')).trim();
        const supportedLines = supportedLineRaw ? supportedLineRaw.split(/[,;/]+/).map(s => s.trim()).filter(Boolean) : [];
        const offRawVal = eqOv.cleanOffsetMins !== undefined && eqOv.cleanOffsetMins !== '' ? eqOv.cleanOffsetMins : (a.craa5_cleanoffsetmins ?? a.craa5_CleanOffsetMins ?? a.craa5_offsetmins ?? null);
        const cleanOffsetMins = (offRawVal !== null && offRawVal !== undefined && offRawVal !== '' && !isNaN(Number(offRawVal))) ? Math.max(0, Math.round(Number(offRawVal))) : null;

        // Match MSS rows by 1) _craa5_asset_value GUID, 2) canonical area + equipment name, 3) prefix area + equipment name
        let linkedMs = (msByAssetId[assetId] || []).slice();
        if (!linkedMs.length && name) {
            const exact = msByAreaName[`${canon(area)}|${canon(name)}`];
            if (exact && exact.length) linkedMs = exact.slice();
            else {
                const cArea = canon(area);
                const cands = (msByName[canon(name)] || []).filter(m => {
                    const ma = canon(m.area);
                    return ma === cArea || ma.indexOf(cArea) === 0 || cArea.indexOf(ma) === 0;
                });
                if (cands.length) linkedMs = cands;
            }
        }
        linkedMs.forEach(m => { matchedMsIds[m.id] = true; });

        const sapDailyList = [], sapWeeklyList = [], freqTexts = [];
        let msMins = 0, msHeads = 0, msAreaId = '';
        linkedMs.forEach(m => {
            if (m.sapDaily && sapDailyList.indexOf(m.sapDaily) < 0) sapDailyList.push(m.sapDaily);
            if (m.sapWeekly && sapWeeklyList.indexOf(m.sapWeekly) < 0) sapWeeklyList.push(m.sapWeekly);
            if (m.freqText && freqTexts.indexOf(m.freqText) < 0) freqTexts.push(m.freqText);
            if (m.mins > msMins) msMins = m.mins;
            if (m.heads > msHeads) msHeads = m.heads;
            if (!msAreaId && m.areaId) msAreaId = m.areaId;
        });

        const rowFlags = {
            daily: !!a.craa5_dailyclean,
            midweek: !!a.craa5_midweek,
            weekly: !!a.craa5_weeklyclean,
            anyFreq: FREQ_COLS.some(col => !!a[col]),
        };
        const freq = classifySapFreq(
            sapDailyList.join(','),
            sapWeeklyList.join(','),
            deptCode,
            workCode,
            freqTexts.join(' '),
            rowFlags,
            area
        );

        const rawHoursReq = Math.max(0, Number(a.craa5_minstoclean || a.craa5_hoursrequired || a.craa5_hourstoclean) || 0);
        const convertedHoursReq = (rawHoursReq > 0 && rawHoursReq <= 16 && !a.craa5_minstoclean) ? Math.round(rawHoursReq * 60) : Math.round(rawHoursReq);
        const hoursReq = convertedHoursReq || msMins || 0;
        const dailyMinCol = Math.max(0, Number(a.craa5_dailymin) || 0);
        const dailyMins = dailyMinCol > 0 ? dailyMinCol : hoursReq;
        const midweekMins = hoursReq > 0 ? hoursReq : dailyMins;
        const weeklyMins = hoursReq > 0 ? hoursReq : dailyMins;
        const alrgRaw = Number(a.craa5_allergenminstoclean ?? a.craa5_MINALRG ?? a.craa5_minalrg) || 0;
        const allergenMins = alrgRaw > 0 ? ((alrgRaw <= 16 && !a.craa5_allergenminstoclean) ? Math.round(alrgRaw) : Math.round(alrgRaw)) : Math.max(weeklyMins, dailyMins);
        const heads = Math.max(1, Number(a.craa5_heads || a.craa5_headstoclean) || msHeads || 1);

        unified.push({
            id: assetId,
            area,
            room: room || (linkedMs[0] && linkedMs[0].room) || '',
            areaId: areaId || msAreaId,
            name,
            baseMins: hoursReq || dailyMins,
            mins: hoursReq || dailyMins,
            dailyMins,
            midweekMins,
            weeklyMins,
            allergenMins,
            heads,
            daily: freq.daily,
            midweek: freq.midweek,
            weekly: freq.weekly,
            flagged: freq.flagged || rowFlags.anyFreq,
            sapDaily: sapDailyList[0] || (deptCode && !/W$/i.test(deptCode) ? deptCode : ''),
            sapWeekly: sapWeeklyList[0] || (workCode && /W$/i.test(workCode) ? workCode : (/W$/i.test(deptCode) ? deptCode : '')),
            sapCodes: freq.codes,
            mssLinked: linkedMs.length > 0,
            supportedLine: supportedLineRaw,
            supportedLineRaw,
            supportedLines,
            cleanOffsetMins,
        });
    });

    // Also include any MSS schedule rows that carry clean minutes or SAP codes for sub-areas not yet in craa5_aa_assets
    msRows.forEach(m => {
        if (matchedMsIds[m.id] || !m.area || !m.name) return;
        const freq = classifySapFreq(m.sapDaily, m.sapWeekly, '', '', m.freqText, {}, m.area);
        if (m.mins <= 0 && !freq.flagged) return;
        const exists = unified.some(u => canon(u.area) === canon(m.area) && canon(u.name) === canon(m.name));
        if (exists) return;
        const base = m.mins > 0 ? m.mins : 0;
        const mId = String(m.assetId || m.id).toLowerCase().trim();
        const eqOv = (equipSupportOverrides && equipSupportOverrides[mId]) || {};
        const supportedLineRaw = String(eqOv.supportedLine || '').trim();
        const supportedLines = supportedLineRaw ? supportedLineRaw.split(/[,;/]+/).map(s => s.trim()).filter(Boolean) : [];
        const offRawVal = eqOv.cleanOffsetMins !== undefined && eqOv.cleanOffsetMins !== '' ? eqOv.cleanOffsetMins : null;
        const cleanOffsetMins = (offRawVal !== null && !isNaN(Number(offRawVal))) ? Math.max(0, Math.round(Number(offRawVal))) : null;
        unified.push({
            id: mId,
            area: m.area,
            room: m.room || '',
            areaId: m.areaId || '',
            name: m.name,
            baseMins: base,
            mins: base,
            dailyMins: base,
            midweekMins: base,
            weeklyMins: base,
            allergenMins: base,
            heads: m.heads || 1,
            daily: freq.daily,
            midweek: freq.midweek,
            weekly: freq.weekly,
            flagged: freq.flagged,
            sapDaily: m.sapDaily || '',
            sapWeekly: m.sapWeekly || '',
            sapCodes: freq.codes,
            mssLinked: true,
            fromMssOnly: true,
            supportedLine: supportedLineRaw,
            supportedLineRaw,
            supportedLines,
            cleanOffsetMins,
        });
    });

    return unified;
}

// Synthesizes MSS area rows with Equipment (craa5_aa_assets) so that Equipment is ALWAYS linked for GUIDs and asset counts,
// while respecting craa5_aa_mss_area's authoritative "Runs Product" flags so non-production asset rooms (General, Janitorial,
// Temper, Tote, IBL4PS, etc.) never pollute the Gantt as production lines.
function synthesizeAreasWithAssets(rawAreas, unifiedAssets) {
    const arr = Array.isArray(rawAreas) ? rawAreas : (rawAreas && Array.isArray(rawAreas.value) ? rawAreas.value : (rawAreas && Array.isArray(rawAreas.rows) ? rawAreas.rows : []));
    const out = arr.map(a => ({ ...a }));
    const byCanon = {}, byFamilyList = {};
    const hasExplicitProductFlags = out.some(a => truthy(a.craa5_runsproduct) || truthy(a['craa5_runsproduct' + FMT]) || truthy(a.craa5_production) || truthy(a['craa5_production' + FMT]));
    out.forEach(a => {
        const n = renderSafe(a.craa5_area || a.craa5_name || a.craa5_areaname).trim();
        if (!n) return;
        const ck = canon(n);
        if (ck && !byCanon[ck]) byCanon[ck] = a;
        const fam = canonPlantFamily(n, 1);
        if (fam) (byFamilyList[fam] = byFamilyList[fam] || []).push(a);
    });
    const assetAreas = {}, assetByFamily = {};
    (unifiedAssets || []).forEach(p => {
        const n = String(p.area || '').trim();
        if (!n || STATUS_AREAS.indexOf(n.toLowerCase()) >= 0) return;
        const ck = canon(n);
        if (!ck) return;
        if (!assetAreas[ck]) {
            assetAreas[ck] = {
                name: n,
                canon: ck,
                family: canonPlantFamily(n, 1),
                areaId: p.areaId || '',
                count: 0,
                hasDailyOrWeekly: false,
                maxCleanMins: 0,
                maxAllergenMins: 0,
                totalHeads: 0,
                sapDaily: '',
                sapWeekly: '',
                equipmentNames: [],
            };
        }
        const info = assetAreas[ck];
        info.count++;
        if (p.daily || p.midweek || p.weekly) info.hasDailyOrWeekly = true;
        if (!info.areaId && p.areaId) info.areaId = p.areaId;
        if ((p.mins || 0) > info.maxCleanMins) info.maxCleanMins = p.mins || 0;
        if ((p.allergenMins || 0) > info.maxAllergenMins) info.maxAllergenMins = p.allergenMins || 0;
        info.totalHeads += (p.heads || 1);
        if (!info.sapDaily && p.sapDaily) info.sapDaily = p.sapDaily;
        if (!info.sapWeekly && p.sapWeekly) info.sapWeekly = p.sapWeekly;
        if (p.name && info.equipmentNames.indexOf(p.name) < 0) info.equipmentNames.push(p.name);
        if (info.family && (!assetByFamily[info.family] || info.count > assetByFamily[info.family].count)) {
            assetByFamily[info.family] = info;
        }
    });
    const attachAssetInfo = (target, info) => {
        target._assetAreaName = info.name;
        target._assetAreaId = info.areaId || '';
        target._assetCount = info.count;
        target._assetCleanMins = info.maxCleanMins;
        target._assetAllergenMins = info.maxAllergenMins;
        target._assetHeads = info.totalHeads;
        target._assetSapDaily = info.sapDaily;
        target._assetSapWeekly = info.sapWeekly;
        target._assetNames = info.equipmentNames;
        if (!target.craa5_aa_mss_areaid && info.areaId) target.craa5_aa_mss_areaid = info.areaId;
    };
    Object.keys(assetAreas).forEach(ck => {
        const info = assetAreas[ck];
        const existing = byCanon[ck];
        const famMatches = info.family ? (byFamilyList[info.family] || []) : [];
        if (!existing && !famMatches.length) {
            // Only infer runsProduct from asset areas when craa5_aa_mss_area has no explicit product flags at all,
            // and never for known non-production rooms or sub-equipment codes (like IBL4PS).
            const fallbackRuns = !hasExplicitProductFlags
                && !NON_PRODUCT_AREA_RE.test(info.name)
                && !/ps$/i.test(ck)
                && /^(ibl|line|bread|wj|waterjet|high\s*speed|custard|dough|kettle)/i.test(info.name);
            out.push({
                craa5_aa_mss_areaid: info.areaId || `asset_area_${ck}`,
                craa5_area: info.name,
                craa5_name: info.name,
                craa5_runsproduct: fallbackRuns,
                craa5_production: fallbackRuns,
                _fromAssets: true,
                _assetAreaName: info.name,
                _assetAreaId: info.areaId || '',
                _assetCount: info.count,
                _assetCleanMins: info.maxCleanMins,
                _assetAllergenMins: info.maxAllergenMins,
                _assetHeads: info.totalHeads,
                _assetSapDaily: info.sapDaily,
                _assetSapWeekly: info.sapWeekly,
                _assetNames: info.equipmentNames,
            });
        } else {
            if (existing) attachAssetInfo(existing, info);
            famMatches.forEach(fm => { if (fm !== existing && !fm._assetCount) attachAssetInfo(fm, info); });
        }
    });
    return out;
}

// Reads a SKU Master row (craa5_skumaster)
function readSkuMasterRow(r) {
    if (!r) return null;
