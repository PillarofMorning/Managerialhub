    };
    const cpClassify = (e) => TABLE_GONE_RE.test(e) ? 'missing' : CP_PRIV_RE.test(e) ? 'noaccess' : 'error';
    const cpAdopt = (cfg) => updateSettings(s => ({ ...s, clean: cfg.clean || {}, shifts: cfg.shifts || [], cleanHeads: numOr(cfg.cleanHeads, s.cleanHeads), rosterOverrides: cfg.rosterOverrides || {} }));
    // Is the table there, and what settings are shared? A browser with no cleaning or shift settings of its own takes the shared ones.
    const cpLoadConfig = async () => {
        const C = cpRef.current;
