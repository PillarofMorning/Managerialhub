                        <Btn kind="ghost" onClick={() => copyTable(t)}>Copy Table Spec</Btn>
                    </div>
                    <div className="divide-y divide-slate-100">
                        {rowsOf(t).map(x => (
                            <div key={x.c.name} className="px-4 py-1.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs" data-col={x.c.name}>
