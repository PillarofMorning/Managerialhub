                        </div>
                        <div className="rounded-lg border border-[#C4B5FD] bg-[#EDE9FE]/60 p-2.5">
                            <div className="text-[10px] font-black uppercase text-[#5B21B6]">Weekend EOW</div>
                            <div className="text-base font-black text-[#5B21B6] mt-0.5">{fmtMins(weekly.mins)}</div>
                            <div className="text-[10px] text-slate-600">{weekly.equipCount} pcs - {fmtMins(weekly.work)} work</div>
                            {L.rule.sapWeekly && <div className="text-[9px] font-mono text-slate-500 mt-0.5">{L.rule.sapWeekly}</div>}
                        </div>
                        <div className="rounded-lg border border-[#FCA5A5] bg-[#FDE8EC]/60 p-2.5">
                            <div className="text-[10px] font-black uppercase text-[#B00020]">Allergen Clean</div>
                            <div className="text-base font-black text-[#B00020] mt-0.5">{fmtMins(alg.mins)}</div>
                            <div className="text-[10px] text-slate-600">{alg.equipCount} pcs - {fmtMins(alg.work)} work</div>
                        </div>
                    </div>

                    {/* LINKED EQUIPMENT LIST FROM MSS & ASSETS */}
                    {L.pieces.length > 0 && (
                        <div className="border border-slate-200 rounded-xl overflow-hidden">
                            <div className="px-3 py-1.5 bg-slate-50 border-b border-slate-200 text-[10px] font-black uppercase tracking-wider text-slate-500">
                                Equipment on {rows.find(r => r.key === lineKey)?.label || lineKey} ({L.pieces.length} pieces from Equipment & MSS)
                            </div>
                            <div className="max-h-56 overflow-y-auto">
                                <table className="w-full text-[11px]">
                                    <thead className="bg-white sticky top-0 border-b border-slate-100 text-[9px] uppercase text-slate-400">
                                        <tr>
                                            <th className="px-2.5 py-1 text-left">Equipment</th>
                                            <th className="px-2 py-1 text-left">MSS SAP Order</th>
                                            <th className="px-2 py-1 text-left">Frequency</th>
                                            <th className="px-2 py-1 text-right">Daily</th>
                                            <th className="px-2 py-1 text-right">EOW/MW</th>
                                            <th className="px-2 py-1 text-right">Heads</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {L.pieces.map(p => (
                                            <tr key={p.id} className="border-t border-slate-100">
                                                <td className="px-2.5 py-1 font-semibold text-slate-800">{p.name}{p.room ? <span className="text-slate-400 font-normal"> - {p.room}</span> : ''}</td>
                                                <td className="px-2 py-1 font-mono text-[10px] text-slate-500">{(p.sapCodes || []).join(', ') || '-'}</td>
                                                <td className="px-2 py-1">
                                                    <div className="flex flex-wrap gap-1">
                                                        {p.daily && !p.midweek && <span className="px-1 rounded bg-[#E0F2FE] text-[#0369A1] text-[9px] font-black">Daily</span>}
                                                        {p.midweek && <span className="px-1 rounded bg-[#FEF3C7] text-[#92400E] text-[9px] font-black">72h MW</span>}
                                                        {p.weekly && <span className="px-1 rounded bg-[#EDE9FE] text-[#5B21B6] text-[9px] font-black">EOW Wk</span>}
                                                    </div>
                                                </td>
                                                <td className="px-2 py-1 text-right font-bold">{fmtMins(p.dailyMins)}</td>
                                                <td className="px-2 py-1 text-right font-bold">{fmtMins(p.weeklyMins)}</td>
                                                <td className="px-2 py-1 text-right text-slate-500">{p.heads}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    )}
                </div>

                {/* UPCOMING STOPS ON THIS LINE */}
                <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col">
                    <div className="flex items-center justify-between mb-2">
                        <h2 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Upcoming Stops & Clean Windows ({mine.length})</h2>
                        <span className="text-[11px] font-bold text-slate-500">With {ctxHeads} sanitation {ctxHeads === 1 ? 'person' : 'people'}</span>
                    </div>
                    {mine.length === 0 && <p className="text-sm text-slate-400 py-6">No stops loaded for this line in the current date window. Open the Schedule over the dates you want to inspect.</p>}
                    <div className="space-y-2 max-h-[580px] overflow-y-auto pr-1">
                        {mine.map(g => {
                            const st = GAP_STYLE[g.status] || GAP_STYLE.none;
                            const ck = CLEAN_KINDS[g.kind] || CLEAN_KINDS.full;
                            return (
                                <button key={g.prevId + g.nextId} type="button" onClick={() => onJump(g.start)} className="w-full text-left rounded-xl border px-3 py-2 text-xs transition-shadow hover:shadow-md" style={{ background: st.bg, borderColor: st.border, color: st.text }}>
                                    <div className="flex flex-wrap items-center justify-between gap-1">
                                        <span className="font-black">{fmtDT(g.start)} to {g.end ? fmtDT(g.end) : 'Open'}</span>
                                        <div className="flex items-center gap-1.5">
                                            {g.need && g.need.sapOrder && <span className="px-1.5 py-0.5 rounded bg-white/80 text-slate-700 font-mono text-[10px] font-bold">{g.need.sapOrder}</span>}
                                            <span className="px-2 py-0.5 rounded border text-[10px] font-black" style={{ background: ck.badgeBg || '#fff', color: ck.badgeFg || st.text, borderColor: ck.border || st.border }}>{ck.label}</span>
                                            <span className="font-black uppercase text-[10px]">{st.label}</span>
                                        </div>
                                    </div>
                                    <div className="font-semibold mt-0.5 text-[11px]">{runTitle(g.prev)} to {g.next ? runTitle(g.next) : 'End of planned runs'}</div>
                                    <div className="opacity-85 text-[11px] mt-0.5">{gapText(g)}</div>
                                </button>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    );
}

// ============================================================================
// CLEAN PLAN tab: the cleans the runs need (the hangups a director should know about first), every allergen, EOW weekly, 72h midweek, and daily clean,
// the days the MSS needs a Daily clean, and the publishing to the shared table the other apps read.
// ============================================================================
const CP_HANG = { short: 0, overlap: 1, nocrew: 2, tight: 3 };
// An alert in Spanish (the English sentence is the row's craa5_reason).
function cpAlertEs(a) {
    const d = a.det || {}, ln = `${a.area} L${a.line}`;
    if (a.kind === 'over72') return `${ln} corre ${cpHrs((d.hours || 0) * 60)} desde ${fmtDT(Date.parse(d.from))} antes de su siguiente limpieza (${fmtDT(Date.parse(d.stop))}): ${cpHrs((d.overBy || 0) * 60)} sobre el limite de ${d.limit} h.${a.status === 'approved' ? ` Aprobado por ${d.by || 'programacion'}${d.why ? `: ${d.why}` : ''}.` : ' Sin aprobar: pida una parada a programacion, o registre su aprobacion en la corrida.'}`;
    if (a.kind === 'apart') return `Highspeed y Custard estan programadas a la vez de ${fmtDT(a.start)} a ${fmtDT(a.end)}: estas dos lineas nunca corren al mismo tiempo.`;
    if (a.kind === 'noeow') return `${ln} tiene corridas en la semana del ${fmtDay(a.start)} pero ninguna parada para su limpieza de fin de semana: corre todo el fin de semana hasta la semana siguiente.`;
    return a.reason;
}
// The one-page guide behind "? How it works" on the Clean Plan tab, in English and Spanish (es-MX).
const CP_GUIDE = [
    ['What this page does', 'Que hace esta pagina',
        'It works out every clean each line needs from the runs on the schedule, and publishes them to the Clean Plan table. Ganttly, Shift Start, the MSS calendar, PBED and the Manager hub all read that one table, so every app shows the same cleans.',
        'Calcula cada limpieza que necesita cada linea a partir de las corridas del horario, y las publica en la tabla Clean Plan. Ganttly, Shift Start, el calendario MSS, PBED y el Manager hub leen esa misma tabla, asi que todas las apps muestran las mismas limpiezas.'],
    ['The rules for each line', 'Las reglas de cada linea',
        'IBL4: a Midweek clean before it has run 72 h (everything except caseout, dry clean items and the freezer), and an End of Week clean (everything). IBL5 and Waterjet: a Daily clean every night (everything except the PIC areas named on Cleaning Times), and an End of Week clean. Highspeed and Custard: a short Daily clean, and an End of Week clean with the kettles, silo, sifter and dough room. Dough room, silo and sifter start their clean 5 hours before the line stops.',
        'IBL4: una limpieza de media semana antes de correr 72 h (todo menos caseout, articulos de limpieza en seco y el congelador), y una limpieza de fin de semana (todo). IBL5 y Waterjet: una limpieza diaria cada noche (todo menos las areas PIC escritas en Tiempos de Limpieza), y una limpieza de fin de semana. Highspeed y Custard: una limpieza diaria corta, y una de fin de semana con las marmitas, silo, cernidor y cuarto de masa. El cuarto de masa, silo y cernidor empiezan su limpieza 5 horas antes de que pare la linea.'],
    ['When scheduling moves the Midweek clean', 'Cuando programacion mueve la limpieza de media semana',
        'Open the run (double-click it). Under Clean after this run pick Midweek clean here, or No Midweek clean here (approved), and write who approved it and why. A line past 72 h shows red until it is approved, then amber.',
        'Abra la corrida (doble clic). En Limpieza despues de esta corrida elija Limpieza de media semana aqui, o Sin limpieza de media semana aqui (aprobado), y escriba quien lo aprobo y por que. Una linea con mas de 72 h se ve en rojo hasta que se aprueba, luego en amarillo.'],
    ['Reading the colors', 'Como leer los colores',
        'Green: the clean fits the stop with the crew on shift. Amber: tight, or approved by scheduling. Red: not enough time, no crew, runs overlap, or an alert nobody approved.',
        'Verde: la limpieza cabe en la parada con el personal del turno. Amarillo: justo, o aprobado por programacion. Rojo: no alcanza el tiempo, no hay personal, las corridas se enciman, o una alerta sin aprobar.'],
    ['What to do with an alert', 'Que hacer con una alerta',
        'Click it to see the runs on the Schedule. Ask scheduling for a stop, move a run, or record their approval on the run. Highspeed and Custard never run at the same time: move one of the two runs.',
        'Haga clic para ver las corridas en el Horario. Pida una parada a programacion, mueva una corrida, o registre su aprobacion en la corrida. Highspeed y Custard nunca corren al mismo tiempo: mueva una de las dos corridas.'],
    ['Publishing', 'Publicar',
        'With Publish by itself on, the plan is published a few seconds after any change to a run. The first time, press Share these settings so every computer uses the same cleaning settings.',
        'Con "Publish by itself" encendido, el plan se publica unos segundos despues de cualquier cambio en una corrida. La primera vez, presione "Share these settings" para que todas las computadoras usen los mismos ajustes de limpieza.'],
];
function CleanPlanView({ engine, cp, tick, cfgState, auto, setAuto, apiReady, ready, onJump, onOpenCheck, nowMs, active }) {
    const [from, setFrom] = useState(() => cpMondayYmd(Date.now()));
    const [weeks, setWeeks] = useState(2);
    const [got, setData] = useState(null);
    const [loading, setLoading] = useState(false);
    const [err, setErr] = useState('');
    const [moreCleans, setMoreCleans] = useState(false);
    const [confirmUse, setConfirmUse] = useState(false);
    const [guide, setGuide] = useState(false);
    const F = parseYMD(from) ? cpWeekStart(parseYMD(from).getTime(), 0) : cpWeekStart(Date.now(), 0);
    const T = cpWeekStart(F, weeks);
    const epoch = cp.epoch;
    useEffect(() => {
        if (!active) return;
        let alive = true;
        setLoading(true); setErr('');
        const t = setTimeout(async () => {
            try { const b = await engine.preview(F, T); if (!alive) return; if (!b) { setData(null); setErr('The runs could not be read for these weeks. Press Reload (top right) to try again.'); } else setData({ ...b, rangeKey: `${F}|${T}` }); }
            catch (e) { if (alive) { setData(null); setErr(errText(e)); } }
            if (alive) setLoading(false);
        }, 250);
        return () => { alive = false; clearTimeout(t); };
    }, [active, F, T, epoch, cfgState, engine]);
    const shiftWeeks = (n) => setFrom(cpAddDaysYmd(getLocalYMD(new Date(F)), 7 * n));
    const data = got && got.rangeKey === `${F}|${T}` ? got : null;
    const wins = data ? data.windows : [];
    const ahead = (g) => (g.stopKind === 'last' ? g.start : g.end) >= nowMs - HOUR;
    const hang = wins.filter(g => CP_HANG[g.status] !== undefined)
        .sort((a, b) => ahead(b) - ahead(a) || (CP_HANG[a.status] === 3) - (CP_HANG[b.status] === 3) || a.start - b.start);
    const red = hang.filter(g => g.status !== 'tight' && ahead(g)), amber = hang.filter(g => g.status === 'tight' && ahead(g)), past = hang.filter(g => g.status !== 'tight' && !ahead(g));
    const cleans = wins.filter(g => isMajorCleanKind(g.kind) || (g.kind === 'changeover' && g.need.basis !== 'untimed'));
    const alerts = data ? (data.alerts || []).slice().sort((a, b) => (a.status === 'approved') - (b.status === 'approved') || a.start - b.start) : [];
    const count = (k) => wins.filter(g => g.kind === k).length;
    const groups = data ? data.groups : [];
    const days = groups.length ? groups[0].days : [];
    const noneDays = groups.reduce((n, G) => n + G.days.filter(d => d.kind === 'none').length, 0);
    const busy = cp.busy, last = cp.last;
    const tableText = { found: 'Clean Plan table found', missing: 'Clean Plan table not created yet', noaccess: 'No permission to read the Clean Plan table', error: 'The Clean Plan table could not be read', unknown: 'Looking for the Clean Plan table...', preview: 'Preview mode: nothing is written' }[cp.table] || cp.table;
    const tz = browserTz(), plantTz = (cp.shared && cp.shared.tz) || CP_PLANT_TZ, tzOk = tz === plantTz;
    const reqMissing = cp.reqMissing && cp.reqMissing.length > 0;
    const canPublish = apiReady && cp.table === 'found' && tzOk && cfgState !== 'differ' && !busy && ready && !reqMissing && !cp.noWrite;
    const pill = (ok, warn) => `px-2 py-1 rounded-lg border text-[11px] font-bold ${ok ? 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' : warn ? 'bg-[#FFF6E0] text-slate-800 border-[#FFB81C]' : 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]'}`;
    const line = (g) => `${g.prev.area} L${g.prev.line}`;
    const card = 'bg-white border border-slate-200 rounded-xl p-4 shadow-sm';
    const h2 = 'text-sm font-black text-[#00468B] uppercase tracking-widest';
    return (
        <div className="space-y-4" data-testid="cleanplan">
            {guide && <Modal title={tx('How the Clean Plan works', 'Como funciona el Plan de Limpieza')} onClose={() => setGuide(false)} wide footer={<Btn onClick={() => setGuide(false)}>{tx('Close', 'Cerrar')}</Btn>}>
                <ol className="space-y-3 list-decimal pl-5 text-sm text-slate-700" data-testid="cp-guide">
                    {CP_GUIDE.map(g => <li key={g[0]}><b className="text-[#00468B]">{tx(g[0], g[1])}</b><p className="mt-0.5 leading-snug">{tx(g[2], g[3])}</p></li>)}
                </ol>
            </Modal>}
            <div className={card}>
                <div className="flex flex-wrap items-center gap-3">
                    <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Clean Plan</h2>
                    <span className={pill(cp.table === 'found', cp.table === 'unknown' || cp.table === 'preview')} data-testid="cp-table">{tableText}</span>
                    <Btn kind="ghost" onClick={() => setGuide(true)} title={tx('A one-page guide to the Clean Plan, in English and Spanish', 'Guia de una pagina del Plan de Limpieza, en ingles y espanol')} data-testid="cp-guide-open">{tx('? How it works', '? Como funciona')}</Btn>
                    <span className={pill(cfgState === 'same', cfgState === 'none')} data-testid="cp-cfg">{cfgState === 'same' ? 'Settings shared' : cfgState === 'differ' ? 'This browser\'s settings differ from the shared ones' : 'Settings not shared yet'}</span>
                    {!tzOk && <span className={pill(false)}>This computer is on {tz || 'an unknown time zone'}; the plant is on {plantTz}</span>}
                </div>
                <p className="text-xs text-slate-600 mt-2">What every line needs cleaned, worked out from the runs + MSS + Equipment: allergen cleans, Weekend EOW / Weekly cleans, IBL4 72-hour Midweek cleans, Daily down cleans, and timed product changes.</p>
                {cp.table === 'missing' && <p className="text-xs text-[#B00020] font-semibold mt-1">Create the Clean Plan table to share it: <button type="button" className="underline" onClick={() => onOpenCheck('columns')}>see what to create</button>. The plan below works without it.</p>}
                {(cp.table === 'noaccess' || cp.table === 'error') && <p className="text-xs text-[#B00020] font-semibold mt-1 break-words">{cp.tableWhy}</p>}
                {cp.reqMissing && cp.reqMissing.length > 0 && <p className="text-xs text-[#B00020] font-semibold mt-1">The Clean Plan table needs {cp.reqMissing.join(', ')}: <button type="button" className="underline" onClick={() => onOpenCheck('columns')}>see what to create</button>, then Check again.</p>}
                {cp.noWrite && <p className="text-xs text-[#B00020] font-semibold mt-1 break-words" data-testid="cp-nowrite">This account can read the Clean Plan table but not write it, so it does not publish. Ask for Create and Write on the Clean Plan table, then Check again.</p>}
                {!ready && apiReady && cp.table === 'found' && <p className="text-xs text-slate-600 font-semibold mt-1" data-testid="cp-notready">Waiting for MSS & equipment to be read before publishing. If this stays, press Reload (top right).</p>}
                <div className="flex flex-wrap items-center gap-2 mt-3">
                    {cfgState !== 'same' && cp.table === 'found' && <Btn kind="yellow" onClick={() => engine.share()} disabled={busy} title="Saves this browser's Cleaning Times and Shifts settings in the Clean Plan table">Share these settings</Btn>}
                    {cfgState === 'differ' && (confirmUse
                        ? <><span className="text-xs font-bold">Replace this browser's cleaning and shift settings with the shared ones?</span><Btn onClick={() => { engine.useShared(); setConfirmUse(false); }}>Yes, use the shared ones</Btn><Btn kind="ghost" onClick={() => setConfirmUse(false)}>No</Btn></>
                        : <Btn kind="ghost" onClick={() => setConfirmUse(true)}>Use the shared settings</Btn>)}
                    <Chip on={auto} onClick={() => setAuto(!auto)}>Publish by itself</Chip>
                    <Btn onClick={() => engine.publish(F, T)} disabled={!canPublish}>{cfgState === 'none' && cp.table === 'found' ? 'Share settings and publish these weeks' : 'Publish these weeks'}</Btn>
                    {busy && <Btn kind="danger" onClick={() => engine.stop()}>Stop</Btn>}
                    <Btn kind="ghost" onClick={() => engine.recheck()} disabled={busy}>Check again</Btn>
                </div>
                {busy && cp.progress && (
                    <div className="mt-3" data-testid="cp-progress">
                        <div className="text-xs font-bold text-[#00468B]">{cp.progress.what}{cp.progress.total ? ` (${cp.progress.done} of ${cp.progress.total})` : ''}</div>
                        <div className="h-2 rounded bg-slate-100 mt-1 overflow-hidden"><div className="h-2 bg-[#0072CE]" style={{ width: `${cp.progress.total ? Math.round(100 * cp.progress.done / cp.progress.total) : 10}%` }} /></div>
                    </div>
                )}
                {last && !busy && (
                    <div className={`mt-3 text-xs rounded-lg border px-3 py-2 ${last.errors.length || last.failed ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B00020]' : last.skipped ? 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800' : 'bg-[#F0FDF4] border-[#86EFAC] text-[#166534]'}`} data-testid="cp-last">
                        {last.skipped ? <>Not published ({last.why}): {last.skipped}</>
                            : last.errors.length && !last.weeks && !last.created && !last.updated && !last.removed ? <>Not published {fmtDT(last.at)} ({last.why}).</>
                            : <>{last.errors.length || last.failed ? 'Published with problems' : 'Published'} {fmtDT(last.at)} ({last.why}): {last.weeks} week{last.weeks === 1 ? '' : 's'} from {fmtDay(last.from)}, {last.created} new, {last.updated} changed, {last.removed} removed, {last.same} unchanged{last.failed ? `, ${last.failed} failed` : ''}{last.stopped ? ', stopped' : ''}.{last.dropped && last.dropped.length ? ` Not stored (column missing): ${last.dropped.join(', ')}.` : ''}</>}
                        {last.errors.length > 0 && <div className="font-semibold break-words">{last.errors[0]}</div>}
                    </div>
                )}
            </div>

            <div className="flex flex-wrap items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 shadow-sm">
                <Btn kind="ghost" onClick={() => shiftWeeks(-weeks)}>{'<'}</Btn>
                <Btn kind="ghost" onClick={() => setFrom(cpMondayYmd(Date.now()))}>This week</Btn>
                <Btn kind="ghost" onClick={() => shiftWeeks(weeks)}>{'>'}</Btn>
                <label className="text-[10px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1">Week of
                    <input type="date" className="border border-slate-300 rounded-lg px-2 py-1 text-xs normal-case font-bold" value={getLocalYMD(new Date(F))} onChange={(e) => { const d = parseYMD(e.target.value); if (d) setFrom(cpMondayYmd(d.getTime())); }} /></label>
                <label className="text-[10px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1">Weeks
                    <select className="border border-slate-300 rounded-lg px-1.5 py-1 text-xs normal-case font-bold" value={weeks} onChange={(e) => setWeeks(Number(e.target.value))}>{[1, 2, 3, 4, 6, 8].map(n => <option key={n} value={n}>{n}</option>)}</select></label>
                <span className="text-sm font-black text-[#00468B] whitespace-nowrap">{fmtDay(F)} to {fmtDay(T - 1)}</span>
                {loading && <span className="text-xs text-slate-500">Working it out...</span>}
                {data && !loading && <span className="text-xs text-slate-500" data-testid="cp-summary">{count('allergen')} allergen - {count('weekly')} weekend EOW - {count('midweek')} 72h midweek - {count('full')} daily - {count('changeover')} changeover - <b className={red.length ? 'text-[#B00020]' : 'text-[#166534]'}>{red.length} hangup{red.length === 1 ? '' : 's'} ahead</b>{past.length ? ` (${past.length} past)` : ''} - {noneDays} line-day{noneDays === 1 ? '' : 's'} with no Daily clean needed</span>}
            </div>
            {err && <div className="px-3 py-2 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-xs font-bold text-[#B00020]">{err}</div>}
            {data && data.long > 0 && <div className="px-3 py-2 rounded-lg bg-[#FFF6E0] border border-[#FFB81C] text-xs text-slate-800">{data.long} run{data.long === 1 ? ' is' : 's are'} longer than {CP_MAX_RUN_DAYS} days (a mistyped end date?) and left out.</div>}

            <div className={card} data-testid="cp-alerts">
                <h3 className={h2}>{tx('Alerts for scheduling', 'Alertas para programacion')}</h3>
                <p className="text-[11px] text-slate-500 mb-2">{tx('IBL4 (or any 72 h line) running past 72 h without a Midweek clean, Highspeed and Custard scheduled at the same time, and lines with no End of Week clean in a week. Red = not approved, amber = approved by scheduling on the run. Click one to see it on the Schedule.', 'IBL4 (o cualquier linea de 72 h) corriendo mas de 72 h sin limpieza de media semana, Highspeed y Custard programadas a la vez, y lineas sin limpieza de fin de semana en una semana. Rojo = sin aprobar, amarillo = aprobado por programacion en la corrida. Haga clic en una para verla en el Horario.')}</p>
                {data && !alerts.length && <p className="text-sm text-[#166534] font-semibold" data-testid="cp-noalerts">{tx('No alerts in these weeks.', 'Sin alertas en estas semanas.')}</p>}
                <div className="space-y-1.5">
                    {alerts.map(a => { const st = a.status === 'approved' ? GAP_STYLE.tight : GAP_STYLE.short, k = CP_ALERTS[a.kind]; return (
                        <button key={a.key} type="button" onClick={() => onJump(a.start)} className="w-full text-left rounded-lg border px-2.5 py-1.5 text-[11px]" style={{ background: st.bg, borderColor: st.border, color: st.text }} data-alert={a.kind} data-alert-status={a.status}>
                            <div className="font-black">{a.area} L{a.line} - {fmtDT(a.start)} - {tx(k.label, k.es)}{a.status === 'approved' ? ` - ${tx('approved', 'aprobado')}${a.det.by ? ` (${a.det.by})` : ''}` : ''}</div>
                            <div className="opacity-90">{tx(a.reason, cpAlertEs(a))}</div>
                        </button>); })}
                </div>
            </div>

            <div className={card} data-testid="cp-hangups">
                <h3 className={h2}>Hangups for directors</h3>
                <p className="text-[11px] text-slate-500 mb-2">Cleans that do not fit: not enough crew time before the next run, runs that overlap, or no sanitation shift in the stop. Click one to see it on the Schedule.</p>
                {data && !red.length && <p className="text-sm text-[#166534] font-semibold" data-testid="cp-nohang">{past.length ? 'No hangups from now on in these weeks. The ones marked past below have already happened.' : amber.length ? 'Every clean in these weeks fits; the tight ones are below.' : 'No hangups in these weeks: every clean fits the time and the crew on shift.'}</p>}
                <div className="space-y-1.5">
                    {red.concat(amber, past).map(g => { const st = GAP_STYLE[g.status], was = !ahead(g), ck = CLEAN_KINDS[g.kind] || CLEAN_KINDS.full; return (
                        <button key={`${g.prevId}|${g.nextId}|${g.stopKind}`} type="button" onClick={() => onJump(g.start)} className={`w-full text-left rounded-lg border px-2.5 py-1.5 text-[11px] ${was ? 'opacity-60' : ''}`} style={{ background: st.bg, borderColor: st.border, color: st.text }} data-hang={g.status} data-past={was ? '1' : undefined}>
                            <div className="font-black">{was ? 'Past - ' : ''}{line(g)} - {fmtDT(g.start)}{g.stopKind !== 'last' && g.end > g.start ? ` to ${fmtDT(g.end)}` : g.stopKind === 'overlap' ? ' (the next run starts before this one ends)' : g.stopKind !== 'last' ? ' (no time between the runs)' : ''} - {ck.label} - {st.label}{g.shortMins > 0 ? ` by ${cpHrs(g.shortMins)}` : ''}</div>
                            <div className="opacity-90">{g.reason}</div>
                        </button>); })}
                </div>
            </div>

            <div className={card} data-testid="cp-cleans">
                <h3 className={h2}>Cleans and downtime</h3>
                <p className="text-[11px] text-slate-500 mb-2">Every allergen clean, Weekend EOW / Weekly clean, 72h Midweek clean (IBL4), Daily clean, and timed product change.</p>
                {data && !cleans.length && <p className="text-sm text-slate-500">No cleans in these weeks.</p>}
                {cleans.length > 0 && <div className="overflow-x-auto">
                    <table className="w-full text-[11px]">
                        <thead><tr className="text-left text-[10px] uppercase tracking-wider text-slate-400"><th className="pr-3 py-1">Line</th><th className="pr-3">Stops</th><th className="pr-3">Starts again</th><th className="pr-3">Clean</th><th className="pr-3">SAP Order</th><th className="pr-3">Takes</th><th className="pr-3">Crew</th><th className="pr-3">Status</th></tr></thead>
                        <tbody>{(moreCleans ? cleans : cleans.slice(0, 150)).map(g => { const st = GAP_STYLE[g.status] || GAP_STYLE.ok, ck = CLEAN_KINDS[g.kind] || CLEAN_KINDS.full; return (
                            <tr key={`${g.prevId}|${g.nextId}|${g.stopKind}`} className="border-t border-slate-100 align-top hover:bg-slate-50 cursor-pointer" onClick={() => onJump(g.start)} title={g.reason}>
                                <td className="pr-3 py-1 font-bold whitespace-nowrap">{line(g)}</td>
                                <td className="pr-3 whitespace-nowrap">{fmtDT(g.start)}</td>
                                <td className="pr-3 whitespace-nowrap">{g.next ? fmtDT(g.end) : g.open === 'unplanned' ? 'not planned yet' : 'no run after it'}</td>
                                <td className="pr-3 whitespace-nowrap"><span className="px-1.5 py-0.5 rounded border text-[10px] font-black" style={{ background: ck.badgeBg || '#F8FAFC', color: ck.badgeFg || '#334155', borderColor: ck.border || '#CBD5E1' }}>{ck.label}{g.kind === 'allergen' && g.prev.allergenType ? ` (${g.prev.allergenType})` : ''}</span></td>
                                <td className="pr-3 whitespace-nowrap font-mono text-[10px] text-slate-500">{(g.need && g.need.sapOrder) || '-'}</td>
                                <td className="pr-3 whitespace-nowrap font-bold">{g.mins > 0 ? cpHrs(g.mins) : ''}</td>
                                <td className="pr-3 whitespace-nowrap">{g.kind === 'changeover' ? 'line crew' : !g.cleanStart ? 'none' : g.assumed ? `${Math.round(g.heads * 10) / 10} assumed` : g.heads ? `${Math.round(g.heads * 10) / 10} on shift` : ''}</td>
                                <td className="pr-3 whitespace-nowrap"><span className="px-1.5 py-0.5 rounded border text-[10px] font-black" style={{ background: st.bg, borderColor: st.border, color: st.text }}>{g.status === 'ok' ? (g.cleanEnd ? `done ${getLocalYMD(new Date(g.cleanEnd)) === getLocalYMD(new Date(g.start)) ? fmtTime(g.cleanEnd) : fmtDT(g.cleanEnd)}` : 'ok') : STATUS_WORDS[g.status]}</span></td>
                            </tr>); })}</tbody>
                    </table>
                    {cleans.length > 150 && !moreCleans && <button type="button" className="mt-1 text-xs font-bold text-[#0072CE] underline" onClick={() => setMoreCleans(true)}>Show all {cleans.length}</button>}
                </div>}
            </div>

            <div className={card} data-testid="cp-days">
                <h3 className={h2}>Days the MSS needs a Daily clean</h3>
                <p className="text-[11px] text-slate-500 mb-2">Per MSS area (all its lines together), the same rule as the MSS calendar's line rules: a Daily clean on a day the area had an hour or more without production; one clean for a stretch of idle days in a row (a down weekend too); none on a day it ran with less than an hour free.</p>
                {data && !groups.length && <p className="text-sm text-slate-500">No runs in these weeks.</p>}
                {groups.length > 0 && <div className="overflow-x-auto">
                    <table className="text-[10px] border-separate" style={{ borderSpacing: 2 }}>
                        <thead><tr><th className="text-left pr-2 text-slate-400 font-black uppercase tracking-wider sticky left-0 bg-white">Area</th>{days.map(d => <th key={d.date} className={`px-1 font-bold whitespace-nowrap ${d.dow === 1 ? 'border-l-2 border-slate-300' : ''} ${d.dow === 0 || d.dow === 6 ? 'text-slate-400' : 'text-slate-600'}`}>{DOW[d.dow]} {Number(d.date.slice(8))}</th>)}</tr></thead>
                        <tbody>{groups.map(G => (
                            <tr key={G.key}>
                                <td className="pr-2 font-black text-slate-700 whitespace-nowrap sticky left-0 bg-white">{G.name}</td>
                                {G.days.map(d => { const k = DAY_KINDS[d.kind]; return <td key={d.date} title={`${G.name} ${cpDayText(d.date)}: ${d.reason}`} className={`text-center rounded font-bold px-1 py-1 whitespace-nowrap ${d.dow === 1 ? 'border-l-2 border-slate-300' : ''}`} style={{ background: k.bg, color: k.fg, boxShadow: `inset 0 0 0 1px ${k.border}`, minWidth: 34 }} data-day={d.kind}>{k.short}</td>; })}
                            </tr>))}</tbody>
                    </table>
                </div>}
                <div className="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[10px] text-slate-500">{['due', 'stretch', 'covered', 'none', 'unplanned'].map(k => <span key={k}><i className="inline-block w-3 h-3 rounded-sm align-middle mr-1" style={{ background: DAY_KINDS[k].bg, boxShadow: `inset 0 0 0 1px ${DAY_KINDS[k].border}` }} />{DAY_KINDS[k].label}</span>)}</div>
            </div>
        </div>
    );
}

// ============================================================================
// PREVIEW DATA (only when there is no Dataverse API at all, e.g. the canvas preview)
// ============================================================================
function previewData() {
    // Never sample data: with no Dataverse API (the canvas preview) every list is empty and the page says so.
    return { areas: [], runs: [], assets: [], msAssets: [], runRules: [] };
}

// ============================================================================
// DATA CHECK: (1) Run check = runs that are not saved completely or not on a real MSS production area, with fixes;
//             (2) Columns = every Dataverse column the app uses, found or missing, with what to create;
//             (3) Payloads = what every save sent, which optional columns Dataverse refused, and what came back.
// ============================================================================
