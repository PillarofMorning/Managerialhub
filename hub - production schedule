        if (ps !== null && pe !== null && ns !== null) { const ne = endFromHours(ns, (pe - ps) / HOUR); n.endDate = getLocalYMD(new Date(ne)); n.endTime = hhmmOf(ne); }
        return n;
    });
    const setStop = (patch) => setD(p => {
        const n = { ...p, ...patch }, ns = draftStart(n), ne = draftEnd(n);
