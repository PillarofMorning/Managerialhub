                        rangeFrom={rangeFrom} rangeTo={rangeTo} rangeMs={rangeMs} trackW={trackW} showClean={showClean} stripH={stripH}
                        selId={selKey === row.key ? selectedId : null} dragId={ghost && ghost.originKey === row.key ? ghost.id : null} gh={ghost && ghost.rowKey === row.key ? ghost : null}
                        issueMap={issueMap} uncoveredMap={uncoveredMap} api={rowApi} />;
                })}
