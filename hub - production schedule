        const body = tryExtras ? { ...fields, ...(extras.order ? { [F_ORDER]: String(extras.order) } : {}), ...(extras.cases !== null && extras.cases !== undefined ? { [F_CASES]: Number(extras.cases) } : {}) } : fields;
