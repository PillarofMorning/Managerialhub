                                                        {!folded[G.key] && !applying && G.rows.map(r => <RunRow key={r.p.key} r={r} ed={edits[r.p.key] || {}}
                                                            onInclude={(v) => setInc(i => ({ ...i, [r.p.key]: v }))}
