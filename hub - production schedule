                    <div style={{ display: tab === 'import' ? 'block' : 'none' }}>
                        <ImportView areaOptions={areaOptions} settings={settings} updateSettings={updateSettings} api={importApi} gapCtx={gapCtx} apiReady={apiReady}
                            onDone={() => { loadedRef.current = []; setReloadTick(n => n + 1); }}
                            onView={(ms) => { setTab('schedule'); setView(v => ({ days: 7, from: addDaysLocal(midnightOf(ms), -new Date(ms).getDay()).getTime() })); }} />
                    </div>
                    {tab === 'shifts' && <ShiftsView rows={allRows} settings={settings} updateSettings={updateSettings} employees={employees} empLoaded={empLoaded} rosterCount={rosterCount} own={own} />}
                    {tab === 'cleaning' && <CleaningView rows={allRows} assets={assetList} assetsByArea={assetsByArea} settings={settings} updateSettings={updateSettings} gaps={analysis.gaps} own={own} rosterCount={rosterCount} assetsLoaded={assetsLoaded}
                        onJump={(ms) => { setTab('schedule'); jumpTo(ms); }} />}
                </div>
            </main>
            {dialog && <RunDialog key={dialog.draft.id || 'new'} draft={dialog.draft} areaOptions={areaOptions} recall={recallOne} gapCtx={gapCtx} allRuns={runs} busy={dialogBusy} canSwap={dialogCanSwap}
                onSave={saveDialog} onDelete={deleteDialog} onDuplicate={duplicateRun} onSwap={(d, dir) => { swapWithNeighbour(d.id, dir); setDialog(null); }} onClose={() => setDialog(null)} />}
        </div>
    );
}
