    // Another line starts at line 1; the same one as when the box was entered keeps the line number it had.
    const startRef = useRef(null);
    const pickArea = (text) => {
        const r = resolveArea(text, areaOptions), base = startRef.current || { area: c.area, line: c.line };
        const area = r.exact ? r.area : String(text).trim();
        const line = r.exact && r.line > 1 ? r.line : area === base.area ? base.line : 1;
