        if (ns !== null && h > 0) { const ne = endFromHours(ns, h); n.endDate = getLocalYMD(new Date(ne)); n.endTime = hhmmOf(ne); }
        return n;
    });
    const lineNum = Math.max(1, parseInt(d.line, 10) || 1);
    const problem = !d.area.trim() ? 'Pick a line.' : s === null || e === null ? 'Enter a start and a stop.' : !(e > s) ? 'Stop must be after start.'
        : d.code !== '' && !/^\d{1,9}$/.test(String(d.code)) ? 'Product code must be a whole number.' : !d.product.trim() ? 'Enter the product.' : null;
