// later so "24 h every day" runs back to back across daylight-saving changes.
function endFromHours(startMs, hours) {
    const wholeDays = hours > 0 && hours % 24 === 0 ? hours / 24 : 0;
    return wholeDays ? addDaysLocal(new Date(startMs), wholeDays).getTime() : startMs + Math.round(hours * HOUR);
}
