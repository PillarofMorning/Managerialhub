    let m = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(s);
    if (m) return parseYMD(`${m[1]}-${pad2(m[2])}-${pad2(m[3])}`);
    m = /^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/.exec(s);
    if (m) { const y = m[3].length === 2 ? 2000 + Number(m[3]) : Number(m[3]); return parseYMD(`${y}-${pad2(m[1])}-${pad2(m[2])}`); }
    return null;
}
