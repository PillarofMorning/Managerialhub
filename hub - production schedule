                    <Btn kind="ghost" onClick={copy} disabled={!all.length}>Copy the last 20</Btn>
                    <Btn kind="ghost" onClick={clearPayloads} disabled={!all.length}>Clear</Btn>
                    {copied && <span className="text-[#166534]">{copied}</span>}
                </div>
            </div>
            {list.length === 0 && <p className="text-sm text-slate-500">{all.length ? 'No problems in the payloads kept.' : 'Nothing saved yet this visit.'}</p>}
            <div className="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                {list.slice(0, shown).map(e => (
                    <div key={e.n} className="border-t border-slate-100 first:border-t-0" data-payload={e.n}>
                        <button type="button" className="w-full text-left px-3 py-1.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs hover:bg-slate-50" onClick={() => setOpenId(openId === e.n ? null : e.n)} aria-expanded={openId === e.n}>
                            <span className="font-mono text-slate-400">{fmtSec(e.t)}</span>
                            <span className={`px-1.5 py-0.5 rounded border text-[10px] font-black uppercase ${e.op === 'delete' ? 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' : e.op === 'create' ? 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' : 'bg-[#E6F1FB] text-[#00468B] border-[#0072CE]'}`}>{e.op}</span>
                            <span className="text-slate-700 min-w-0 flex-1 basis-40 truncate">{e.table !== TABLE_PROD ? `${e.table}: ` : ''}{e.what || e.table}{e.id ? <span className="text-slate-400"> - {String(e.id).slice(-8)}</span> : ''}</span>
                            <span className="text-slate-500">{Object.keys(e.fields).length} column{Object.keys(e.fields).length === 1 ? '' : 's'}</span>
                            {e.sent.map(c => <span key={c} className="px-1 rounded border text-[10px] font-bold bg-[#DCFCE7] text-[#166534] border-[#16A34A]">{colLabel(c)}</span>)}
                            {e.dropped.map(c => <span key={c} className="px-1 rounded border text-[10px] font-bold bg-[#FFF6E0] text-slate-800 border-[#FFB81C]" title="Dataverse refused this column">{colLabel(c)} not stored</span>)}
                            <span className={`font-black ${e.ok ? 'text-[#166534]' : 'text-[#B00020]'}`}>{e.ok ? (e.preview ? 'preview' : 'saved') : 'FAILED'}</span>
                        </button>
                        {!e.ok && <div className="px-3 pb-1 text-[11px] text-[#B00020] font-semibold">{e.error}</div>}
                        {openId === e.n && <pre className="mx-3 mb-2 p-2 rounded bg-slate-900 text-slate-100 text-[11px] overflow-x-auto max-h-56 overflow-y-auto">{JSON.stringify(e.fields, null, 2)}</pre>}
