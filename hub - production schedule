function parseSheet(grid, opts) {
    const warnings = [];
    if (!grid || !grid.length) return { error: 'Nothing to read: the sheet is empty.' };
    // 1. weekday header row (3 or more weekday names in one row)
    let hRow = -1, dayCols = [];
    for (let r = 0; r < Math.min(grid.length, 20) && hRow < 0; r++) {
        const found = [];
        (grid[r] || []).forEach((c, ci) => { const wi = weekdayIndex(c); if (wi >= 0) found.push({ dow: wi, col: ci }); });
        if (found.length >= 3) { hRow = r; dayCols = found; }
    }
    if (hRow < 0) return { error: 'Could not find the weekday header row (Sunday, Monday ...). Copy the whole table including its top rows.' };
    const hdr = grid[hRow] || [];
    const week = cellStr((grid[hRow] || [])[0]) || cellStr((grid[Math.max(0, hRow - 1)] || [])[0]);
    // 2. a date for every weekday: the cell(s) right after the name, else derived from any one known date
    const dates = {};
    dayCols.forEach(dc => { for (let k = 1; k <= 2 && !dates[dc.dow]; k++) { const d = parseSheetDate(hdr[dc.col + k]); if (d) dates[dc.dow] = d; } });
    const known = Object.keys(dates);
    if (!known.length) {
        const ws = opts && opts.weekStart ? parseYMD(opts.weekStart) : null;
        if (!ws) return { error: 'Found the weekdays but no dates next to them. Enter the Sunday date of the week below.', needWeekStart: true };
        dayCols.forEach(dc => { dates[dc.dow] = addDaysLocal(ws, dc.dow); });
    } else {
        const k0 = Number(known[0]);
        dayCols.forEach(dc => { if (!dates[dc.dow]) dates[dc.dow] = addDaysLocal(dates[k0], dc.dow - k0); });
    }
    // 3. cases / hours / order # columns under each weekday (label row below the header)
    const lab = grid[hRow + 1] || [];
    const days = dayCols.map((dc, i) => {
        const end = i + 1 < dayCols.length ? dayCols[i + 1].col : dc.col + 4;
        const cols = { cases: dc.col, hours: dc.col + 1, order: dc.col + 2 };
        for (let c = dc.col; c < end; c++) {
            const t = cellStr(lab[c]).toLowerCase();
            if (/^cases?/.test(t)) cols.cases = c; else if (/^hours?/.test(t)) cols.hours = c; else if (/^order/.test(t)) cols.order = c;
        }
        return { dow: dc.dow, ymd: getLocalYMD(dates[dc.dow]), label: DOW[dc.dow], cols };
    }).sort((a, b) => a.ymd < b.ymd ? -1 : 1);
    let updatedCol = -1;
