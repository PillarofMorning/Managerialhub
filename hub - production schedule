                                                {(form.approval || form.signature) && <span><b>Approved by</b> {[form.approval, form.signature].filter(Boolean).join(', ')}</span>}
                                            </div>
                                            {form.fixedZone === 'Y' && !form.approval && !form.signature && <div className="mx-3 mb-2 p-2 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-xs font-semibold text-[#B00020]" data-testid="cr-noapproval">This is a change inside the fixed zone (the next 7 days) and the form has no plant approval or supply chain signature. The form says one is needed: check with Supply Chain before applying. It will not be applied by itself.</div>}
                                            {f.hold && f.inboxResult && <div className="mx-3 mb-2 p-2 rounded-lg bg-[#FFF6E0] border border-[#FFB81C]/60 text-xs text-slate-700" data-testid="cr-held">This request was looked at before and is waiting for you ({f.inboxStatus}): {f.inboxResult}</div>}
                                            {appliedAt && <div className="mx-3 mb-2 p-2 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-600" data-testid="cr-seen">This form was applied here on {fmtDT(appliedAt)}. Reading it again is safe: lines that are already done show as ALREADY DONE and are not changed twice.</div>}
                                            {form.problems.map((t, k) => <div key={k} className="mx-3 mb-2 text-xs font-semibold text-[#7A5200]">{t}</div>)}
                                            {(!dd || dd.loading) && <div className="px-3 py-2 text-xs font-bold text-[#00468B]">Reading the schedule around the dates on this form...</div>}
                                            {dd && dd.failed && <div className="px-3 py-2 text-xs font-semibold text-[#B00020]">Could not read the schedule for these dates. Press Reload (top right).</div>}
                                            {pl && pl.map(r => <ChangeLine key={r.i} row={r} ed={(edits[f.id] && edits[f.id][r.i]) || {}} setEd={(i, patch) => setEd(f.id, i, patch)} lineChoices={lineChoices} areaNames={areaNames} />)}
                                        </>)}
                                    </div>)}
                                </div>
                            );
                        })}
                    </div>
                </Section>
            )}

            {history.length > 0 && (
                <Section title="Recent changes" open={!!open.hist} onToggle={() => setOpen(o => ({ ...o, hist: !o.hist }))} summary={`${history.length} kept in this browser · last ${fmtDT(history[0].at)}`}>
                    <p className="text-sm text-slate-500 mb-2">What the schedule looked like before each apply is kept here for 14 days, also after the page is closed. Undo takes back the newest one; the older ones come back one at a time, newest first.</p>
                    <div className="space-y-1.5" data-testid="cr-history">
                        {history.map((e, i) => (
                            <div key={e.id} className="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-xs" data-testid="cr-hist-row">
                                <span className="font-black text-[#00468B]">{fmtDT(e.at)}</span>
                                <span className={`px-1.5 rounded font-bold ${e.auto ? 'bg-[#FFF6E0] text-[#7A5200]' : 'bg-[#E6F1FB] text-[#00468B]'}`}>{e.auto ? 'by itself' : 'by hand'}</span>
                                <span className="min-w-0 flex-1 basis-56 font-semibold text-slate-700">{crCountsText(e.counts)}{e.partial ? ' (unfinished)' : ''} · {e.names.join(', ')}</span>
                                {i === 0 ? (!applying && undoBox(e)) : <span className="text-slate-400">undo the newer ones first</span>}
                            </div>
                        ))}
                    </div>
                </Section>
            )}

            {/* Outside the folding steps on purpose: Apply, its result and Undo stay reachable whichever step is folded */}
            {(waiting || result) && (
                <div ref={barRef} className="sticky bottom-0 z-30 -mx-4 px-4 py-3 bg-white/95 border-t border-slate-200 shadow-[0_-6px_14px_rgba(15,23,42,0.08)]">
                    {result && (
                        <div className={`mb-2 p-2.5 rounded-lg border text-sm font-semibold max-h-32 overflow-y-auto ${result.type === 'success' ? 'bg-[#DCFCE7] border-[#16A34A]/50 text-[#166534]' : result.type === 'warn' ? 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800' : 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B00020]'}`} data-testid="cr-result">
                            <div>{result.message}</div>
                            {result.lines && result.lines.map((l, i) => <div key={i} className="text-xs font-semibold mt-0.5">{l}</div>)}
                        </div>
                    )}
                    {applying && <div className="mb-2 h-1.5 rounded bg-slate-200 overflow-hidden"><div className="h-full bg-[#0072CE] transition-all" style={{ width: `${applying.phase === 'checking' || applying.phase === 'looking' ? 100 : pct}%`, background: applying.phase === 'checking' || applying.phase === 'looking' ? '#FFB81C' : undefined }} /></div>}
                    <div className="flex flex-wrap items-center gap-x-3 gap-y-2">
                        {waiting && <Btn onClick={() => apply(null, false)} disabled={!canApply} className="min-w-[15rem]" title="Change the schedule as shown above">{applying ? (applying.phase === 'looking' ? 'Looking at the schedule again...' : applying.phase === 'checking' ? 'Checking what was saved...' : `Saving ${applying.done} of ${applying.total}...`) : `Apply to schedule (${jobs.length} line${jobs.length === 1 ? '' : 's'}${jobs.length ? `: ${[jobCounts.change && `${jobCounts.change} change`, jobCounts.add && `${jobCounts.add} add`, jobCounts.remove && `${jobCounts.remove} take off`].filter(Boolean).join(', ')}` : ''})`}</Btn>}
                        {applying && applying.phase === 'saving' && <Btn kind="danger" onClick={() => { cancelRef.current = true; }}>Stop</Btn>}
                        {waiting && applyHint && <span className="text-xs text-slate-500 font-semibold min-w-0 flex-1 basis-56">{applyHint}</span>}
                        {!apiReady && <span className="text-xs text-[#B27B00] font-bold">Preview mode: nothing is saved to Dataverse.</span>}
                        {result && history.length > 0 && result.entryId === history[0].id && !applying && undoBox(history[0])}
                        {result && (result.type === 'success' || result.type === 'warn') && result.viewMs > 0 && !applying && <Btn kind="ghost" onClick={() => onView(result.viewMs)}>View on the schedule</Btn>}
                    </div>
                </div>
            )}
        </div>
    );
}
const ChangeViewMemo = memo(ChangeView);

