                if (isMaint(r)) return;
                const c = coverageFor(gapCtx.occ, k, 'production', r.start, r.end, own);
                if (c.any !== false && c.uncovered > 15 * 60000) uncoveredMap[r.id] = c.uncovered;
            });
        });
        return { gaps, issueMap, uncoveredMap };
    }, [runs, gapCtx, own]);
    const issueList = useMemo(() => {
        const list = [];
        analysis.gaps.forEach(g => {
            if (g.end < view.from || g.start > rangeTo) return;
            if (g.status === 'overlap') list.push({ key: `o${g.prevId}${g.nextId}`, kind: 'overlap', ms: g.next.start, runId: g.nextId, text: `${lineLabelOf(g.prev.area, g.prev.line)}: ${runTitle(g.prev)} and ${runTitle(g.next)} overlap by ${fmtHrs(-g.gapMs)}` });
            else if (g.status === 'short') list.push({ key: `s${g.prevId}${g.nextId}`, kind: 'short', ms: g.start, runId: g.nextId, text: `${lineLabelOf(g.prev.area, g.prev.line)}: ${gapText(g)}. Needs ${fmtMins(Math.max(0, g.req.mins - g.usableMs / 60000))} more` });
            else if (g.status === 'tight') list.push({ key: `t${g.prevId}${g.nextId}`, kind: 'tight', ms: g.start, runId: g.nextId, text: `${lineLabelOf(g.prev.area, g.prev.line)}: tight changeover. ${gapText(g)}` });
        });
        runs.forEach(r => { if (analysis.uncoveredMap[r.id] && r.start < rangeTo && r.end > view.from) list.push({ key: `u${r.id}`, kind: 'shift', ms: r.start, runId: r.id, text: `${lineLabelOf(r.area, r.line)}: ${runTitle(r)} has no production shift for ${fmtHrs(analysis.uncoveredMap[r.id])}` }); });
        return list.sort((a, b) => a.ms - b.ms);
    }, [analysis, runs, view.from, rangeTo]);

    // ------------------------------------------------------------------------
    // API handed to the import view
    // ------------------------------------------------------------------------
    const importApi = {
        readLine: async (area, line, from, to) => {
            if (!apiReady) return runsRef.current.filter(r => r.area === area && r.line === line && r.start < to && r.end > from).sort(byStart);
            const rows2 = await queryRecords(TABLE_PROD, dataApiRef.current, { filter: `statecode eq 0 and craa5_area eq '${odataStr(area)}' and craa5_line eq ${line} and craa5_datestarttime lt ${isoZ(to)} and craa5_dateendtime gt ${isoZ(from)}`, orderby: 'craa5_datestarttime asc', top: RANGE_LIMIT });
            return rows2 === null ? null : rows2.map(r => normRun(r, sideRef.current)).sort(byStart);
        },
        recallMany: async (codes) => {
            const out = {}, valid = codes.filter(c => /^\d{1,9}$/.test(c));
            const take = (list) => list.forEach(r => { const k = String(r.code); if (r.code !== null && !out[k]) out[k] = { product: r.product, allergen: r.allergen, allergenType: r.allergenType, crumb: r.crumb }; });
            if (!valid.length) return out;
            if (!apiReady) { take(runsRef.current.slice().sort((a, b) => b.start - a.start)); return out; }
            for (let i = 0; i < valid.length; i += 20) {
                const chunk = valid.slice(i, i + 20);
                const rows2 = await queryRecords(TABLE_PROD, dataApiRef.current, { filter: `statecode eq 0 and (${chunk.map(c => `craa5_productcode eq ${c}`).join(' or ')})`, orderby: 'craa5_datestarttime desc', top: 400 });
                if (rows2) take(rows2.map(r => normRun(r, sideRef.current)));
            }
            return out;
        },
        saveRun, deleteRun,
    };
    const recallOne = async (code) => { if (!/^\d{1,9}$/.test(String(code))) return null; const m = await importApi.recallMany([String(code)]); return m[String(code)] || null; };

    // ------------------------------------------------------------------------
    // SCHEDULE ACTIONS
    // ------------------------------------------------------------------------
    const lineRunsOf = (area, line) => runsRef.current.filter(r => r.area === area && r.line === line).sort(byStart);
    const commitMove = async (run, tgt) => {
        const plan = planPlacement(run, tgt, lineRunsOf(tgt.area, tgt.line), settingsRef.current.push);
        if (plan.mode === 'blocked') { notify(plan.error, 'error'); return; }
        const label = plan.mode === 'swap' ? `swap order on ${lineLabelOf(run.area, run.line)}` : plan.mode === 'push' ? `move ${runTitle(run)} and push ${plan.pushed} later` : `move ${runTitle(run)}`;
        const ok = await applyUpdates(plan.updates, label);
        if (ok && plan.mode === 'swap') notify('Order swapped.', 'success');
        if (ok && plan.mode === 'push') notify(`Pushed ${plan.pushed} later run${plan.pushed === 1 ? '' : 's'} to make room.`, 'info');
    };
    const swapWithNeighbour = async (runId, dir) => {
        const r = runsRef.current.find(x => x.id === runId);
        if (!r) return;
        const seq = lineRunsOf(r.area, r.line), i = seq.findIndex(x => x.id === runId), j = i + dir;
        if (j < 0 || j >= seq.length) return;
        const plan = swapPlan(seq[Math.min(i, j)], seq[Math.max(i, j)]);
        await applyUpdates(plan.updates, `swap order on ${lineLabelOf(r.area, r.line)}`);
    };
    const moveToDay = async (id, dateObj) => {
        const r = runsRef.current.find(x => x.id === id);
        if (!r) return;
        const s0 = new Date(r.start), ns = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), s0.getHours(), s0.getMinutes()).getTime();
        if (ns === r.start) return;
        await commitMove(r, { start: ns, end: ns + (r.end - r.start), area: r.area, line: r.line });
    };
    const openEdit = (r) => { setSelectedId(r.id); setDialog({ draft: makeDraft(r) }); };
    const openNew = (row, ms) => setDialog({ draft: makeDraft({ area: row ? row.area : '', line: row ? row.line : 1, start: ms }, areaOptions[0]) });
    const draftToRun = (d) => {
        const s = draftStart(d), e = draftEnd(d);
        return { area: d.area.trim(), line: Math.max(1, parseInt(d.line, 10) || 1), code: d.code === '' ? null : Number(d.code), product: d.product.trim(), start: s, end: e, allergen: d.allergen, allergenType: d.allergen ? d.allergenType : '', crumb: d.crumb };
    };
    const draftExtras = (d) => ({ order: d.order.trim(), cases: d.cases === '' || isNaN(Number(d.cases)) ? null : Number(d.cases) });
    const saveDialog = async (d) => {
        if (dialogBusy) return;
        setDialogBusy(true);
        try {
            const base = draftToRun(d), extras = draftExtras(d);
            if (d.id) {
                const before = runsRef.current.find(r => r.id === d.id);
                await saveRun('update', d.id, base, extras);
                if (before) pushUndo(`edit ${runTitle(before)}`, [{ type: 'patch', id: d.id, before: { start: before.start, end: before.end, area: before.area, line: before.line } }]);
                setDialog(null); notify('Run saved.', 'success');
            } else {
                const dur = base.end - base.start, hours = dur / HOUR;
                const count = d.repeat === 'once' ? 1 : clamp(parseInt(d.repeatDays, 10) || 1, 1, 60);
                const first = parseYMD(d.startDate);
                const planned = [];
                for (let k = 0; k < count; k++) {
                    const day = addDaysLocal(first, k);
                    if (d.repeat === 'weekdays' && (day.getDay() === 0 || day.getDay() === 6)) continue;
                    const s = withTime(day, d.startTime).getTime();
                    planned.push({ ...base, start: s, end: k === 0 ? base.end : endFromHours(s, hours) });
                }
                const existing = lineRunsOf(base.area, base.line);
                const okRuns = planned.filter(p => !existing.some(r => r.start < p.end && r.end > p.start));
                const skipped = planned.length - okRuns.length;
                const ids = [];
                let failure = null;
                for (let i = 0; i < okRuns.length && !failure; i++) { try { ids.push(await saveRun('create', null, okRuns[i], extras)); } catch (e) { failure = e; } }
                if (ids.length) pushUndo(`add ${ids.length} run${ids.length === 1 ? '' : 's'}`, ids.map(id => ({ type: 'create', id })));
                if (failure) notify(`Added ${ids.length} of ${planned.length}, then failed: ${failure.message || failure}`, 'error');
                else { setDialog(null); notify(`Added ${ids.length} run${ids.length === 1 ? '' : 's'}${skipped ? `. ${skipped} day${skipped === 1 ? '' : 's'} skipped because another run is already there` : ''}.`, ids.length ? 'success' : 'error'); }
                if (ids.length) { const f = okRuns[0]; if (f.start < view.from || f.start > rangeTo) jumpTo(f.start); }
            }
        } catch (e) { notify(`Could not save: ${e && e.message ? e.message : e}`, 'error'); }
        finally { setDialogBusy(false); }
    };
    const deleteDialog = async (d) => {
        const r = runsRef.current.find(x => x.id === d.id);
        setDialogBusy(true);
        try { await deleteRun(d.id); if (r) pushUndo(`delete ${runTitle(r)}`, [{ type: 'delete', run: r }]); setDialog(null); setSelectedId(null); notify('Run deleted. Undo is available.', 'success'); }
        catch (e) { notify(`Could not delete: ${e && e.message ? e.message : e}`, 'error'); }
        finally { setDialogBusy(false); }
    };
    const duplicateRun = async (d) => {
        const r = runsRef.current.find(x => x.id === d.id);
        if (!r) return;
        setDialogBusy(true);
        try {
            const dur = r.end - r.start, copy = { ...r, start: r.end, end: r.end + dur };
