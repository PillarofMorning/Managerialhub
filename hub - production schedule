                        {!apiReady && <span className="text-xs text-[#B27B00] font-bold">Preview mode: nothing is saved to Dataverse.</span>}
                        {result && result.changes && result.changes.length > 0 && !applying && (result.confirmUndo || result.busy ? (() => { const nc = result.changes.filter(c => c.type === 'create').length, nu = result.changes.filter(c => c.type === 'update').length, nd = result.changes.filter(c => c.type === 'delete').length; return (
                            <span className="flex flex-wrap items-center gap-2"><span className="text-xs font-bold text-[#B00020]">{result.busy ? 'Undoing...' : `Delete the ${nc} run${nc === 1 ? '' : 's'} this import added${nu ? `, put back the ${nu} it changed` : ''}${nd ? `, restore the ${nd} it removed` : ''}? Edits made since are lost.`}</span>
                                <Btn kind="dangerSolid" onClick={undoImport} disabled={result.busy}>Yes, undo</Btn><Btn kind="ghost" onClick={() => setResult({ ...result, confirmUndo: false })} disabled={result.busy}>No</Btn></span>); })() : <Btn kind="danger" onClick={undoImport}>Undo this import</Btn>)}
                        {result && (result.type === 'success' || result.type === 'warn') && active.length > 0 && !applying && <Btn kind="ghost" onClick={() => onView(parseYMD(active[0].parsed.days[0].ymd).getTime())}>View {active.length > 1 ? 'the first week' : 'week'} on the schedule</Btn>}
                    </div>
                </div>
            )}
        </div>
    );
}

// ============================================================================
// CHANGE REQUESTS (view): read a form (upload, paste or the inbox), show what each line would do to the schedule, apply it, Undo
// ============================================================================
// the days of the schedule one form needs to see (a line that cannot be read, or asks for nothing, needs none)
function crWindows(form, nowMs) {
    const seen = {}, out = [];
    form.lines.forEach(L => { if (L.kind === 'bad' || L.kind === 'same' || L.kind === 'incomplete') return; const w = crWindow(form, L, nowMs); if (!seen[w.key]) { seen[w.key] = true; out.push(w); } });
    return out;
}
const CR_LOOK = {
    ok: { label: 'WILL CHANGE', cls: 'bg-[#E6F1FB] text-[#00468B] border-[#0072CE]' },
    out: { label: 'LEFT OUT', cls: 'bg-slate-100 text-slate-500 border-slate-300' },
    check: { label: 'CHECK, THEN TICK', cls: 'bg-[#FFF6E0] text-[#7A5200] border-[#FFB81C]' },
    already: { label: 'ALREADY DONE', cls: 'bg-slate-100 text-slate-500 border-slate-300' },
    same: { label: 'NO CHANGE', cls: 'bg-slate-100 text-slate-500 border-slate-300' },
    pick: { label: 'WHICH RUN?', cls: 'bg-[#FFF6E0] text-[#7A5200] border-[#FFB81C]' },
    needs: { label: 'NEEDS DETAILS', cls: 'bg-[#FFF6E0] text-[#7A5200] border-[#FFB81C]' },
    missing: { label: 'NOT FOUND', cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
    blocked: { label: 'BLOCKED', cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
    incomplete: { label: 'NOT ENOUGH', cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
    bad: { label: "CAN'T READ", cls: 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]' },
};
function crAmountsText(L) {
    const a = (n) => n === null || n === undefined ? '' : isNaN(n) ? '?' : fmtNum(n), d = (x) => x ? fmtDay(x.getTime()) : '';
    const oa = a(L.origAmt), na = a(L.newAmt);
    const amt = oa && na ? `${oa} to ${na} cases` : na ? `${na} cases` : oa ? `${oa} cases` : 'no amounts';
    return [amt, L.origDate && L.newDate && !crSameDay(L.origDate, L.newDate) ? `${d(L.origDate)} to ${d(L.newDate)}` : d(L.newDate || L.origDate)].filter(Boolean).join(' - ');
}
const crHrsText = (h) => h === null || h === undefined || !isFinite(h) ? '' : String(Math.round(h * 100) / 100);

function ChangeLine({ row, ed, setEd, lineChoices, areaNames }) {
    const L = row.L, i = row.i;
    const look = row.status === 'ok' && !row.include ? (ed.include === false ? CR_LOOK.out : CR_LOOK.check) : CR_LOOK[row.status] || CR_LOOK.bad;
    const hoursNow = ed.hoursText !== undefined ? ed.hoursText : crHrsText(row.add ? row.add.hours : row.after ? row.after.hours : null);
    const commitArea = (t) => { const r = resolveArea(t, areaNames); setEd(i, r.exact ? (r.line > 1 ? { area: r.area, line: r.line } : { area: r.area }) : { area: String(t).trim() }); };
    const hoursBox = (
        <Field label="Run hours"><input type="number" min="0.25" step="0.25" className={smallIn + 'w-20'} data-testid="cr-hours" value={hoursNow} onChange={(e) => { const v = e.target.value; setEd(i, { hoursText: v, hours: v === '' || isNaN(Number(v)) ? undefined : Number(v) }); }} /></Field>
    );
    return (
        <div className={`px-3 py-2.5 border-t border-slate-100 flex flex-wrap gap-x-4 gap-y-2 text-xs ${row.status === 'already' || row.status === 'same' ? 'opacity-70' : ''}`} data-testid="cr-line" data-status={row.status} data-include={row.include ? '1' : '0'}>
            <div className="flex items-start gap-2 min-w-0 flex-1 basis-80">
                <input type="checkbox" className="mt-1" checked={row.include} disabled={row.status !== 'ok'} title={row.status === 'ok' ? 'Apply this line' : 'Nothing to apply on this line yet'} onChange={(e) => setEd(i, { include: e.target.checked })} />
                <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <span className={`px-1.5 py-0.5 rounded border text-[10px] font-black ${look.cls}`}>{look.label}</span>
                        <b className="text-slate-800">{CR_KIND_LABEL[row.kind] || row.kind}</b>
                        <span className="font-bold text-slate-700">{L.code || '?'}</span><span className="text-slate-600 min-w-0 truncate">{L.desc}</span>
                    </div>
                    <div className="text-slate-600 mt-0.5">Line {L.row} of the form: {crAmountsText(L)}</div>
                    {row.what && <div className="font-semibold text-slate-800 mt-0.5">{row.what}</div>}
                    {row.before && row.after && <div className="text-slate-600 mt-0.5">{fmtDT(row.before.start)} to {fmtTime(row.before.end)}, then {fmtDT(row.after.start)} to {fmtTime(row.after.end)} ({fmtHrs(row.after.end - row.after.start)})</div>}
                    {row.error && <div className="text-[#B00020] font-semibold mt-0.5">{row.error}</div>}
                    {row.warns.map((w, k) => <div key={k} className="text-[#7A5200] font-semibold">{w}</div>)}
                    {row.pushes.length > 0 && <div className="text-slate-500">Pushed later: {row.pushes.slice(0, 3).map(p => `${runTitle(p.run)} to ${fmtDT(p.start)}`).join('; ')}{row.pushes.length > 3 ? ` and ${row.pushes.length - 3} more` : ''}</div>}
                </div>
            </div>
            <div className="flex flex-wrap items-start gap-2 flex-1 basis-64">
                {row.status === 'pick' && (
                    <Field label="Which run is it?" plain>
                        <select className={smallIn + 'w-full max-w-xs'} data-testid="cr-pick" value={ed.pick || ''} onChange={(e) => setEd(i, { pick: e.target.value })}>
                            <option value="">{row.cands.length ? 'Pick the run...' : 'No run to pick'}</option>
                            {row.cands.map(r => <option key={r.id} value={r.id}>{fmtDT(r.start)} to {fmtTime(r.end)} - {lineLabelOf(r.area, r.line)} - {r.cases !== null && r.cases !== undefined ? `${fmtNum(r.cases)} cases` : 'no cases saved'}</option>)}
                        </select>
                    </Field>
                )}
                {row.status === 'missing' && L.newAmt > 0 && row.kind !== 'add' && (L.newDate || L.origDate) && <Btn kind="ghost" onClick={() => setEd(i, { asAdd: true })} title="There is no run to change: add the new amount as a new run instead">Add it as a new run</Btn>}
                {(row.kind === 'add' && ed.asAdd) && <Btn kind="ghost" onClick={() => setEd(i, { asAdd: false })}>Back to a change</Btn>}
                {row.kind === 'add' && row.add && (<>
