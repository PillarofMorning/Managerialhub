                                                    onText={(t) => setMapPick(p => ({ ...p, [G.key]: { ...groupMap(G), text: t } }))} onPick={(o) => setMapPick(p => ({ ...p, [G.key]: { ...groupMap(G), text: o.value } }))} onCommit={(t) => setMapPick(p => ({ ...p, [G.key]: { ...groupMap(G), text: t } }))} /></Field>
                                                <Field label="Line #" className="w-16"><input type="number" min="1" className={inputCls} value={m.line} onChange={(e) => setMapPick(p => ({ ...p, [G.key]: { ...groupMap(G), line: e.target.value } }))} /></Field>
                                                <Btn disabled={!tgt || fixBusy || running} onClick={() => fixRuns(G.runs.map(r => ({ id: r.id, patch: tgt })), `Moved ${G.area || '(blank)'} to ${tgt.area}`)} title={tgt ? '' : 'Pick an MSS area from the list'}>{tgt ? `Move ${fmtNum(G.runs.length)} run${G.runs.length === 1 ? '' : 's'} to ${tgt.area}` : 'Pick an area'}</Btn>
