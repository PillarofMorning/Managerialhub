                <div className="flex flex-wrap items-center gap-3 mt-3 text-xs font-bold">
                    <span className="px-2 py-1 rounded-lg bg-[#E6F1FB] text-[#00468B]">{fmtNum(all.length)} payload{all.length === 1 ? '' : 's'}</span>
                    <span className="px-2 py-1 rounded-lg bg-[#DCFCE7] text-[#166534]">{fmtNum(ok)} saved</span>
