                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <Field label="Product change (min)" hint="Blank = untimed"><input type="number" min="0" className={inputCls} value={rawCfg.changeMins ?? ''} placeholder="untimed" onChange={(e) => setCfg({ changeMins: e.target.value })} data-testid="change-mins" /></Field>
                        <Field label="Crumb extra (min)" hint="Added on crumb runs"><input type="number" min="0" className={inputCls} value={rawCfg.crumbMins ?? ''} placeholder="0" onChange={(e) => setCfg({ crumbMins: e.target.value })} /></Field>
                        <Field label="Fallback clean (min)" hint="If 0 equipment"><input type="number" min="0" className={inputCls} value={rawCfg.baseMins ?? ''} placeholder="60" onChange={(e) => setCfg({ baseMins: e.target.value })} /></Field>
