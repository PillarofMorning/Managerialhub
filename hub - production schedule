        : gapsAround({ id: d.id, area: d.area, line: lineNum, code: d.code === '' ? null : Number(d.code), start: s, end: e, allergen: d.allergen, allergenType: d.allergenType, crumb: d.crumb }, allRuns, gapCtx),
