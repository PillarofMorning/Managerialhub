                    )}
                    <div style={{ display: tab === 'import' ? 'block' : 'none' }}>
                        <ImportViewMemo areaOptions={areaOptions} lineChoices={lineChoices} settings={settings} updateSettings={updateSettings} api={importApi} gapCtx={gapCtx} apiReady={apiReady} reloadTick={reloadTick}
                            onDone={importDone} onView={importShow} onOpenCheck={openCheck} />
                    </div>
                    <div style={{ display: tab === 'changes' ? 'block' : 'none' }}>
                        <ChangeViewMemo api={importApi} lineChoices={lineChoices} settings={settings} updateSettings={updateSettings} gapCtx={gapCtx} apiReady={apiReady} reloadTick={reloadTick}
                            onDone={importDone} onView={importShow} onOpenCheck={openCheck} onPending={onCrPending} active={tab === 'changes'} />
                    </div>
                    {tab === 'check' && <DataCheckView sub={checkSub} setSub={setCheckSub} auditRef={auditRef} subscribe={auditSubscribe} startAudit={startAudit} cancelAudit={cancelAudit} fixRuns={fixRuns} deleteRuns={deleteRuns}
                        undoFix={undoFix} openRun={openRunFromCheck} mssIdx={mssIdx} payloadsRef={payloadsRef} payloadTick={payloadTick} colStatus={colStatus} refusedCols={refusedCols} probeColumns={probeColumns} probing={probing}
                        resetRefused={resetRefused} clearPayloads={clearPayloads} apiReady={apiReady} />}
                    {tab === 'shifts' && <ShiftsView rows={allRows} settings={settings} updateSettings={updateSettings} employees={employees} empLoaded={empLoaded} rosterCount={rosterCount} own={own} />}
                    {tab === 'cleanplan' && <CleanPlanView engine={cpEngine} cp={cpRef.current} tick={cpTick} cfgState={cpCfgState} auto={cpAuto} setAuto={setCpAuto} apiReady={apiReady}
                        onJump={(ms) => { setTab('schedule'); jumpTo(ms); }} onOpenCheck={openCheck} nowMs={nowMs} active={tab === 'cleanplan'} />}
                    {tab === 'cleaning' && <CleaningView rows={allRows} assets={assetList} assetsByArea={assetsByArea} settings={settings} updateSettings={updateSettings} gaps={analysis.gaps} own={own} rosterCount={rosterCount} assetsLoaded={assetsLoaded}
                        onJump={(ms) => { setTab('schedule'); jumpTo(ms); }} />}
                </div>
            </main>
            {dialog && <RunDialog key={dialog.draft.id || 'new'} draft={dialog.draft} areaOptions={areaOptions} lineChoices={lineChoices} mssNames={mss.names} recall={recallOne} gapCtx={gapCtx} allRuns={runs} busy={dialogBusy} canSwap={dialogCanSwap}
                notesMissing={!!colStateRef.current.refused[F_NOTES]} onSave={saveDialog} onDelete={deleteDialog} onDuplicate={duplicateRun} onSwap={(d, dir) => { swapWithNeighbour(d.id, dir); setDialog(null); }} onClose={() => setDialog(null)} />}
        </div>
    );
}
