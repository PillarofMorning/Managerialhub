                    {!empLoaded && <p className="text-sm text-slate-400">Loading the roster...</p>}
                    {empLoaded && employees.length === 0 && <p className="text-sm text-slate-500">No employees could be read from the employee table.</p>}
                    <div className="max-h-[480px] overflow-y-auto border border-slate-200 rounded-lg">
                        <table className="w-full text-xs"><thead className="sticky top-0 bg-slate-50"><tr><th className={th}>Name</th><th className={th}>Crew</th><th className={th}>Job role</th><th className={th}>Group</th></tr></thead>
                            <tbody>{filteredEmps.map(e => {
                                const g = rosterGroup(e, settings.rosterOverrides), forced = !!settings.rosterOverrides[e.id];
                                const sg = SHIFT_GROUPS[g];
                                return <tr key={e.id} className="border-t border-slate-100">
                                    <td className="px-2 py-1 font-semibold">{e.name}</td><td className="px-2 py-1">{e.crew || <span className="text-[#E4002B]">none</span>}</td><td className="px-2 py-1 text-slate-500">{e.jobRole || '-'}</td>
                                    <td className="px-2 py-1"><button type="button" onClick={() => cycle(e)} className="px-2 py-0.5 rounded border text-[10px] font-black uppercase" style={sg ? { background: sg.soft, color: sg.color, borderColor: sg.color } : { background: '#F1F5F9', color: '#64748B', borderColor: '#CBD5E1' }}>{g === 'lead' ? 'Lead / supervisor' : g === 'exclude' ? 'Excluded' : sg.label}{forced ? ' *' : ''}</button></td></tr>;
                            })}</tbody></table>
                    </div>
                </div>
            )}
        </div>
    );
}

