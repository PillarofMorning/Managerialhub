        if (!typed || !q) return options;
        const a = [], b = [], c = [];
        options.forEach(o => { const k = canon(o.label); if (k === q) a.push(o); else if (k.indexOf(q) === 0) b.push(o); else if (k.indexOf(q) >= 0) c.push(o); });
        return a.concat(b, c);
    }, [options, typed, q]);
    const exact = options.some(o => canon(o.value) === q);
    const showNew = !!allowNew && typed && !!q && !exact;
    const total = shown.length + (showNew ? 1 : 0);
    const openList = () => {
        const el = inputRef.current;
        if (el) {
            const r = el.getBoundingClientRect(), host = el.closest ? el.closest('main') : null;
            const floor = (host ? host.getBoundingClientRect().bottom : window.innerHeight) - (host ? 76 : 0);   // main has the pinned Apply bar at its foot
            setUp(floor - r.bottom < 250 && r.top - (host ? host.getBoundingClientRect().top : 0) > floor - r.bottom);
        }
        setOpen(true); setTyped(false);
        let at = 0; for (let i = 0; i < options.length; i++) if (q && canon(options[i].value) === q) { at = i; break; }
        setHi(at);
    };
    const closeList = () => { setOpen(false); setTyped(false); };
    const pick = (i) => {
        dirtyRef.current = false;
        if (i < shown.length) onPick(shown[i]);
        else if (showNew) onPick({ value: text.trim(), label: text.trim(), isNew: true });
        closeList();
    };
    useEffect(() => {   // keep the highlighted row in view inside the list (without moving the page)
        const list = listRef.current;
        if (!open || !list) return;
        const el = list.querySelector(`[data-i="${hi}"]`);
        if (!el) return;
        if (el.offsetTop < list.scrollTop) list.scrollTop = el.offsetTop - 22;
        else if (el.offsetTop + el.offsetHeight > list.scrollTop + list.clientHeight) list.scrollTop = el.offsetTop + el.offsetHeight - list.clientHeight;
    }, [hi, open, shown]);
