                <Field label="Line" className="col-span-4" plain hint={d.area.trim() && mssNames.length && mssNames.indexOf(d.area.trim()) < 0 ? 'Not an MSS area: it is saved with exactly this name.' : 'The lines come from the MSS areas. Type to search.'}>
                    <ComboBox value={d.area} options={lineChoices} allowNew newWord="as a new line" ariaLabel="Line" placeholder="Pick or type a line"
                        className={inputCls + (!d.area.trim() ? ' border-[#E4002B]' : '')}
