                                                <Btn kind="dangerSolid" disabled={fixBusy || running} onClick={() => { setSure(''); fixRuns(G.runs.map(r => ({ id: r.id, patch: { area: G.fix.area, line: G.fix.line, areaId: G.fix.areaId } })), `Closest name: ${G.area} to ${G.fix.area}`); }}>{`Yes, use ${G.fix.area}`}</Btn><Btn kind="ghost" onClick={() => setSure('')}>No</Btn></div>
                                        ) : G.fix ? (
                                            <Btn kind="primary" disabled={fixBusy || running} onClick={() => fixRuns(G.runs.map(r => ({ id: r.id, patch: { area: G.fix.area, line: G.fix.line, areaId: G.fix.areaId } })), `Spelling: ${G.area} to ${G.fix.area}`)}>{`${G.fix.label} (${fmtNum(G.runs.length)} run${G.runs.length === 1 ? '' : 's'})`}</Btn>
                                        ) : (
