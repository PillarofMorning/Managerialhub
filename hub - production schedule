function applyDomTranslation(root, lang) {
    if (!root || typeof document === 'undefined') return;
    try {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        let node = walker.nextNode();
        while (node) {
            const parentTag = node.parentElement ? node.parentElement.tagName : '';
            if (parentTag !== 'SCRIPT' && parentTag !== 'STYLE' && parentTag !== 'TEXTAREA') {
                const cur = node.nodeValue || '';
                const trimmed = cur.trim();
                if (trimmed) {
                    if (lang === 'es') {
                        if (node._origEnText === undefined) {
                            node._origEnText = cur;
                        }
                        const base = node._origEnText;
                        const baseTrim = base.trim();
                        if (PS_EXACT_ES[baseTrim]) {
                            const nextVal = base.replace(baseTrim, PS_EXACT_ES[baseTrim]);
                            if (node.nodeValue !== nextVal) node.nodeValue = nextVal;
                        } else {
                            let out = base;
                            for (let i = 0; i < PS_PHRASE_ES.length; i++) {
                                out = out.replace(PS_PHRASE_ES[i][0], PS_PHRASE_ES[i][1]);
                            }
                            if (node.nodeValue !== out) node.nodeValue = out;
                        }
                    } else if (node._origEnText !== undefined) {
                        if (node.nodeValue !== node._origEnText) {
                            node.nodeValue = node._origEnText;
                        }
                    }
                }
            }
            node = walker.nextNode();
        }
    } catch (e) {}
}

