                    <Btn kind={onRefreshAll ? 'ghost' : 'primary'} onClick={probeColumns} disabled={probing || !apiReady}>{probing ? 'Testing...' : 'Test Columns Only'}</Btn>
                    <Btn kind="ghost" onClick={resetRefused} disabled={!refusedCols.length}>Clear Refused Cache & Retry</Btn>
                    <Btn kind="ghost" onClick={copyAllRecommended}>Copy Missing / Untested Spec</Btn>
                    {!apiReady && <span className="text-xs font-bold text-[#B27B00]">Preview mode: there is no Dataverse to test.</span>}
                    {missing > 0 && <span className="text-xs font-bold text-[#B00020]">{missing} column{missing === 1 ? '' : 's'} missing</span>}
