}
const GapPill = ({ g, label }) => {
    if (!g) return null;
    const st = GAP_STYLE[g.status] || GAP_STYLE.none;
    return (
        <div className="rounded-lg border px-2.5 py-1.5 text-[11px] leading-snug" style={{ background: st.bg, borderColor: st.border, color: st.text }}>
            <div className="font-black uppercase tracking-wider text-[10px]">{label}: {st.label}</div>
            <div>{gapText(g)}</div>
        </div>
    );
};

// ============================================================================
// RUN DIALOG: edit an existing run (double-click) or add one (double-click an empty spot / "+ Run")
// ============================================================================
function makeDraft(run, areaDefault) {
    if (run && run.id) {
        return { id: run.id, area: run.area, line: String(run.line), code: run.code === null ? '' : String(run.code), product: run.product,
            startDate: getLocalYMD(new Date(run.start)), startTime: hhmmOf(run.start), endDate: getLocalYMD(new Date(run.end)), endTime: hhmmOf(run.end),
            hours: String(Math.round(((run.end - run.start) / HOUR) * 100) / 100), cases: run.cases === null ? '' : String(run.cases), order: run.order || '',
            allergen: run.allergen, allergenType: run.allergenType || '', crumb: run.crumb, repeat: 'once', repeatDays: 5 };
    }
    const s = run && run.start ? run.start : midnightOf(Date.now()).getTime() + 6 * HOUR;
    const hours = run && run.end ? (run.end - s) / HOUR : 8;
    const e = s + hours * HOUR;
    return { id: null, area: (run && run.area) || areaDefault || '', line: String((run && run.line) || 1), code: '', product: '',
        startDate: getLocalYMD(new Date(s)), startTime: hhmmOf(s), endDate: getLocalYMD(new Date(e)), endTime: hhmmOf(e), hours: String(hours),
        cases: '', order: '', allergen: false, allergenType: '', crumb: false, repeat: 'once', repeatDays: 5 };
}
const draftStart = (d) => { const day = parseYMD(d.startDate), t = day && withTime(day, d.startTime); return t ? t.getTime() : null; };
const draftEnd = (d) => { const day = parseYMD(d.endDate), t = day && withTime(day, d.endTime); return t ? t.getTime() : null; };

function RunDialog({ draft: initial, areaOptions, lineOptions, recall, gapCtx, allRuns, onSave, onDelete, onSwap, onDuplicate, onClose, busy, canSwap }) {
    const [d, setD] = useState(initial);
    const [confirmDel, setConfirmDel] = useState(false);
    const isNew = !d.id;
    const set = (patch) => setD(p => ({ ...p, ...patch }));
    const s = draftStart(d), e = draftEnd(d);
    // Start keeps the length (the whole run moves); Stop changes the length; Length moves the stop.
    const setStart = (patch) => setD(p => {
        const n = { ...p, ...patch }, ps = draftStart(p), pe = draftEnd(p), ns = draftStart(n);
        if (ps !== null && pe !== null && ns !== null) { const ne = endFromHours(ns, (pe - ps) / HOUR); n.endDate = getLocalYMD(new Date(ne)); n.endTime = hhmmOf(ne); }
        return n;
    });
    const setStop = (patch) => setD(p => {
        const n = { ...p, ...patch }, ns = draftStart(n), ne = draftEnd(n);
        if (ns !== null && ne !== null) n.hours = String(Math.round(((ne - ns) / HOUR) * 100) / 100);
        return n;
    });
    const setHours = (v) => setD(p => {
        const n = { ...p, hours: v }, ns = draftStart(n), h = parseFloat(v);
        if (ns !== null && h > 0) { const ne = endFromHours(ns, h); n.endDate = getLocalYMD(new Date(ne)); n.endTime = hhmmOf(ne); }
        return n;
    });
    const lineNum = Math.max(1, parseInt(d.line, 10) || 1);
    const problem = !d.area ? 'Choose an area.' : s === null || e === null ? 'Enter a start and a stop.' : !(e > s) ? 'Stop must be after start.'
        : d.code !== '' && !/^\d{1,9}$/.test(String(d.code)) ? 'Product code must be a whole number.' : !d.product.trim() ? 'Enter the product.' : null;
    const gaps = useMemo(() => (s === null || e === null || !(e > s) || !d.area) ? null
        : gapsAround({ id: d.id, area: d.area, line: lineNum, code: d.code === '' ? null : Number(d.code), start: s, end: e, allergen: d.allergen, allergenType: d.allergenType, crumb: d.crumb }, allRuns, gapCtx),
        [d.id, d.area, lineNum, d.code, s, e, d.allergen, d.allergenType, d.crumb, allRuns, gapCtx]);
    const doRecall = async () => {
        if (!isNew || !/^\d{1,9}$/.test(String(d.code))) return;
        const code = d.code, r = await recall(code);
        if (r) setD(p => p.code !== code ? p : { ...p, product: p.product.trim() ? p.product : r.product, allergen: r.allergen, allergenType: r.allergenType, crumb: r.crumb });
    };
    return (
        <Modal title={isNew ? 'Add run' : 'Edit run'} onClose={onClose} wide
            footer={<>
                <Btn onClick={() => onSave(d)} disabled={!!problem || busy}>{busy ? 'Saving...' : isNew ? (d.repeat === 'once' ? 'Add run' : 'Add runs') : 'Save changes'}</Btn>
                <Btn kind="ghost" onClick={onClose}>Cancel</Btn>
                {!isNew && <Btn kind="ghost" onClick={() => onDuplicate(d)} title="Copy this run to right after it">Duplicate</Btn>}
                {!isNew && !confirmDel && <Btn kind="danger" onClick={() => setConfirmDel(true)} className="ml-auto">Delete</Btn>}
                {!isNew && confirmDel && <span className="ml-auto flex items-center gap-2"><span className="text-xs font-bold text-[#E4002B]">Delete this run?</span><Btn kind="dangerSolid" onClick={() => onDelete(d)} disabled={busy}>Yes, delete</Btn><Btn kind="ghost" onClick={() => setConfirmDel(false)}>No</Btn></span>}
            </>}>
            <div className="grid grid-cols-6 gap-3">
                <Field label="Area" className="col-span-3">
                    <input list="ps-areas" className={inputCls} value={d.area} onChange={e2 => set({ area: e2.target.value })} />
                </Field>
                <Field label="Line" className="col-span-1">
                    <input className={inputCls} type="number" min="1" value={d.line} onChange={e2 => set({ line: e2.target.value })} />
                </Field>
                <Field label="Product code" className="col-span-2">
                    <input className={inputCls} inputMode="numeric" value={d.code} onChange={e2 => set({ code: e2.target.value })} onBlur={doRecall} />
                </Field>
                <Field label="Product" className="col-span-6">
                    <input className={inputCls} value={d.product} onChange={e2 => set({ product: e2.target.value })} />
                </Field>
                <Field label="Start" className="col-span-3">
                    <div className="flex gap-2"><input className={inputCls} type="date" value={d.startDate} onChange={e2 => setStart({ startDate: e2.target.value })} /><input className={inputCls} type="time" value={d.startTime} onChange={e2 => setStart({ startTime: e2.target.value })} /></div>
                </Field>
                <Field label="Stop" className="col-span-3">
                    <div className="flex gap-2"><input className={inputCls} type="date" value={d.endDate} onChange={e2 => setStop({ endDate: e2.target.value })} /><input className={inputCls} type="time" value={d.endTime} onChange={e2 => setStop({ endTime: e2.target.value })} /></div>
                </Field>
                <Field label="Length (hours)" className="col-span-2" hint="Changing Start keeps the length.">
                    <input className={inputCls} type="number" step="0.25" min="0.25" value={d.hours} onChange={e2 => setHours(e2.target.value)} />
                </Field>
                <Field label="Cases" className="col-span-2"><input className={inputCls} inputMode="numeric" value={d.cases} onChange={e2 => set({ cases: e2.target.value })} /></Field>
                <Field label="Order #" className="col-span-2"><input className={inputCls} value={d.order} onChange={e2 => set({ order: e2.target.value })} /></Field>
                <div className="col-span-6 flex flex-wrap items-center gap-4 text-sm">
                    <label className="flex items-center gap-2 font-bold text-slate-700"><input type="checkbox" checked={d.allergen} onChange={e2 => set({ allergen: e2.target.checked })} /> Allergen</label>
                    {d.allergen && <input className={`${inputCls} max-w-[220px]`} placeholder="Type of allergen" value={d.allergenType} onChange={e2 => set({ allergenType: e2.target.value })} />}
                    <label className="flex items-center gap-2 font-bold text-slate-700"><input type="checkbox" checked={d.crumb} onChange={e2 => set({ crumb: e2.target.checked })} /> Crumb clean</label>
                </div>
                {isNew && (
                    <div className="col-span-6 flex flex-wrap items-end gap-3 p-3 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2]">
                        <Field label="Repeat"><select className={inputCls} value={d.repeat} onChange={e2 => set({ repeat: e2.target.value })}><option value="once">Once</option><option value="daily">Every day</option><option value="weekdays">Weekdays only</option></select></Field>
                        {d.repeat !== 'once' && <Field label="For how many days"><input className={inputCls} style={{ width: 90 }} type="number" min="2" max="60" value={d.repeatDays} onChange={e2 => set({ repeatDays: e2.target.value })} /></Field>}
                        {d.repeat !== 'once' && <p className="text-[11px] text-slate-600 pb-2">Same start time and length each day. Days that clash with another run on the line are skipped.</p>}
                    </div>
                )}
                <div className="col-span-6 grid grid-cols-2 gap-2">
                    <GapPill g={gaps && gaps.before} label="Before this run" />
                    <GapPill g={gaps && gaps.after} label="After this run" />
                </div>
                {!isNew && canSwap && (
                    <div className="col-span-6 flex items-center gap-2 text-xs text-slate-600">
                        <span className="font-black uppercase tracking-wider text-[10px] text-slate-500">Order on this line</span>
                        <Btn kind="ghost" disabled={!canSwap.earlier} onClick={() => onSwap(d, -1)}>{'< Earlier'}</Btn>
                        <Btn kind="ghost" disabled={!canSwap.later} onClick={() => onSwap(d, 1)}>{'Later >'}</Btn>
                        <span className="text-slate-400">trades places with the neighbour, keeping the gap</span>
                    </div>
                )}
                {problem && <div className="col-span-6 text-xs font-bold text-[#E4002B]">{problem}</div>}
            </div>
            <datalist id="ps-areas">{areaOptions.map(a => <option key={a} value={a} />)}</datalist>
        </Modal>
    );
}

// ============================================================================
// GANTT: 1 day to 8 weeks. Drag to move (or to another line), drag the edges to change start / stop, drop past a
// neighbour's middle to swap the order, double-click to edit, double-click empty space to add.
// ============================================================================
function GanttView({ rows, runs, gaps, occ, own, rangeFrom, rangeDays, settings, selectedId, onSelect, onCommit, onOpen, onNewRun, issueMap, uncoveredMap, nowMs }) {
    const rangeTo = addDaysLocal(new Date(rangeFrom), rangeDays).getTime();   // local calendar days (a day can be 23 or 25 h)
    const rangeMs = rangeTo - rangeFrom;
    const trackRef = useRef(null), rowRefs = useRef({}), dragRef = useRef(null), cancelRef = useRef(false);
    const [ghost, setGhost] = useState(null);
    const [trackW, setTrackW] = useState(900);
    useEffect(() => {
        const measure = () => { if (trackRef.current) setTrackW(trackRef.current.getBoundingClientRect().width || 900); };
        measure();
        window.addEventListener('resize', measure);
        return () => window.removeEventListener('resize', measure);
    }, [rows.length, rangeDays]);
    const settingsRef = useRef(settings); settingsRef.current = settings;
    const byLine = useMemo(() => {
        const m = {};
        runs.forEach(r => { const k = lineKeyOf(r.area, r.line); (m[k] = m[k] || []).push(r); });
        Object.keys(m).forEach(k => m[k].sort(byStart));
        return m;
    }, [runs]);
    const byLineRef = useRef(byLine); byLineRef.current = byLine;
    const gapsByLine = useMemo(() => { const m = {}; gaps.forEach(g => { (m[g.lineKey] = m[g.lineKey] || []).push(g); }); return m; }, [gaps]);
    const pct = (ms) => ((ms - rangeFrom) / rangeMs) * 100;
    const snapMs = (ms, free) => {
        if (free) return Math.round(ms / 60000) * 60000;
        const step = Math.max(1, settingsRef.current.snapMins) * 60000, d0 = midnightOf(ms).getTime();
        return d0 + Math.round((ms - d0) / step) * step;
    };

    const startDrag = (e, run, mode) => {
        if (e.button !== undefined && e.button !== 0) return;
        e.stopPropagation();
        const rect = trackRef.current.getBoundingClientRect();
        const rowKey = lineKeyOf(run.area, run.line);
        const d = { run, mode, x0: e.clientX, y0: e.clientY, rect, msPerPx: rangeMs / rect.width, moved: false, rowKey, tgt: null };
        dragRef.current = d; cancelRef.current = false;
        const onMove = (ev) => {
            const dx = ev.clientX - d.x0, dy = ev.clientY - d.y0;
            if (!d.moved && Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
            d.moved = true;
            const free = ev.altKey;
            const delta = dx * d.msPerPx;
            let key = d.rowKey;
            if (d.mode === 'move') {
                const keys = Object.keys(rowRefs.current);
                for (let i = 0; i < keys.length; i++) { const el = rowRefs.current[keys[i]]; if (!el) continue; const rr = el.getBoundingClientRect(); if (ev.clientY >= rr.top && ev.clientY < rr.bottom) { key = keys[i]; break; } }
            }
            const kr = splitKey(key), dur = run.end - run.start;
            const edges = [];
            (byLineRef.current[key] || []).forEach(o => { if (o.id !== run.id) { edges.push(o.start); edges.push(o.end); } });
            const magnet = (ms) => { if (free) return ms; let best = ms, bd = 7 * d.msPerPx; edges.forEach(x => { const dd = Math.abs(x - ms); if (dd < bd) { bd = dd; best = x; } }); return best; };
            let s = run.start, en = run.end;
            if (d.mode === 'move') {
                const ns = snapMs(run.start + delta, free), ms1 = magnet(ns), me = magnet(ns + dur);
                s = Math.abs(ms1 - ns) <= Math.abs(me - (ns + dur)) && ms1 !== ns ? ms1 : (me !== ns + dur ? me - dur : ns);
                en = s + dur;
            } else if (d.mode === 'start') {
                s = Math.min(magnet(snapMs(run.start + delta, free)), run.end - 15 * 60000);
            } else {
                en = Math.max(magnet(snapMs(run.end + delta, free)), run.start + 15 * 60000);
            }
            const tgt = { start: s, end: en, area: kr.area, line: kr.line };
            d.tgt = tgt;
            const plan = planPlacement(run, tgt, byLineRef.current[key] || [], settingsRef.current.push);
            setGhost({ id: run.id, rowKey: key, start: s, end: en, mode: plan.mode, error: plan.error, pushed: plan.pushed });
        };
        const finish = (ev) => {
            window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', finish); window.removeEventListener('pointercancel', finish); window.removeEventListener('keydown', onKey);
            dragRef.current = null; setGhost(null);
            if (cancelRef.current) return;
            if (!d.moved || !d.tgt) { onSelect(run.id); return; }
            if (d.tgt.start === run.start && d.tgt.end === run.end && d.tgt.area === run.area && d.tgt.line === run.line) return;
            onCommit(run, d.tgt);
        };
        const onKey = (ev) => { if (ev.key === 'Escape') { cancelRef.current = true; finish(ev); } };
        window.addEventListener('pointermove', onMove); window.addEventListener('pointerup', finish); window.addEventListener('pointercancel', finish); window.addEventListener('keydown', onKey);
    };

    // day columns
    const dayCells = useMemo(() => {
        const out = [];
        for (let i = 0; i < rangeDays; i++) { const d = addDaysLocal(new Date(rangeFrom), i); out.push({ ms: d.getTime(), next: addDaysLocal(d, 1).getTime(), dow: d.getDay(), date: d.getDate(), month: d.getMonth(), label: d.toLocaleDateString([], { weekday: 'short', day: 'numeric' }) }); }
        return out;
    }, [rangeFrom, rangeDays]);
    const hourStep = rangeDays === 1 ? 2 : rangeDays === 2 ? 3 : rangeDays <= 4 ? 6 : 0;
    const dayCellStyle = (c) => ({ left: `${pct(c.ms)}%`, width: `${((c.next - c.ms) / rangeMs) * 100}%` });
    const showNow = nowMs >= rangeFrom && nowMs <= rangeTo;
    const overlayOn = settings.showShifts && rangeDays <= 14;   // too dense to read over longer ranges
    const stripH = overlayOn ? 11 : 0;

    return (
        <div className="bg-white border border-slate-300 rounded-xl overflow-hidden select-none" style={{ touchAction: 'pan-y' }}>
            {/* header */}
            <div className="flex border-b-2 border-slate-300 bg-slate-50 sticky top-0 z-30">
                <div className="w-[170px] flex-shrink-0 border-r-2 border-slate-300 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest text-slate-500 flex items-end">Line</div>
                <div className="flex-1 relative" ref={trackRef} style={{ height: hourStep ? 46 : 34 }}>
                    {dayCells.map((c, i) => (
                        <div key={i} className={`absolute top-0 border-l border-slate-300 text-[10px] font-bold text-slate-600 px-1 overflow-hidden whitespace-nowrap ${c.dow === 0 || c.dow === 6 ? 'bg-slate-100' : ''}`} style={{ ...dayCellStyle(c), height: hourStep ? 23 : 34 }}>
                            {rangeDays <= 21 ? c.label : (c.date === 1 || i === 0 || c.dow === 0 ? <><span className={c.date === 1 ? 'text-[#00468B]' : ''}>{c.date === 1 ? new Date(c.ms).toLocaleDateString([], { month: 'short' }) + ' ' : ''}{c.date}</span></> : null)}
                            {rangeDays > 21 && <div className="text-[8px] text-slate-400 font-medium">{DOW[c.dow][0]}</div>}
                        </div>
                    ))}
                    {hourStep > 0 && dayCells.map((c, i) => {
                        const out = [];
                        for (let h = 0; h < 24; h += hourStep) out.push(<div key={`${i}-${h}`} className="absolute border-l border-slate-200 text-[9px] text-slate-400 pl-0.5" style={{ left: `${pct(c.ms + h * HOUR)}%`, top: 23, height: 23 }}>{pad2(h)}</div>);
                        return out;
                    })}
                </div>
            </div>
            {rows.length === 0 && <div className="p-10 text-center text-sm text-slate-500">No lines to show yet. Import a week, or use "+ Run" to schedule the first run.</div>}
            {rows.map(row => {
                const lineRuns = byLine[row.key] || [];
                const vis = lineRuns.filter(r => r.start < rangeTo && r.end > rangeFrom);
                const rowGaps = (gapsByLine[row.key] || []).filter(g => g.end > rangeFrom && g.start < rangeTo);
                const rowOcc = overlayOn ? ['production', 'sanitation'].flatMap(g => occForLine(occ, row.key, g, own)).filter(o => o.end > rangeFrom && o.start < rangeTo) : [];
                const rowH = 46 + stripH * 2 + (stripH ? 3 : 0);
                const gh = ghost && ghost.rowKey === row.key ? ghost : null;
                return (
                    <div key={row.key} ref={el => { rowRefs.current[row.key] = el; }} className="flex border-b border-slate-200 hover:bg-slate-50/40" style={{ minHeight: rowH }}>
                        <div className="w-[170px] flex-shrink-0 border-r-2 border-slate-300 px-2 py-1 flex flex-col justify-center bg-white z-20">
                            <span className="font-bold text-[13px] text-slate-800 leading-tight">{row.label}</span>
                            <span className="text-[10px] text-slate-400">{vis.length} run{vis.length === 1 ? '' : 's'} in view</span>
                        </div>
                        <div className="flex-1 relative"
                            onDoubleClick={(e) => {
                                if (e.target.closest && e.target.closest('[data-run],[data-gap]')) return;
                                const rect = trackRef.current.getBoundingClientRect();
                                onNewRun(row, snapMs(rangeFrom + ((e.clientX - rect.left) / rect.width) * rangeMs, false));
                            }}>
                            {dayCells.map((c, i) => <div key={i} className={`absolute top-0 bottom-0 border-l ${c.dow === 0 ? 'border-slate-300' : 'border-slate-200'} ${c.dow === 0 || c.dow === 6 ? 'bg-slate-50' : ''}`} style={dayCellStyle(c)} />)}
                            {rangeDays <= 4 && dayCells.map((c, i) => <div key={`n${i}`} className="absolute top-0 bottom-0 bg-slate-200/30" style={{ left: `${pct(c.ms + 18 * HOUR)}%`, width: `${(12 * HOUR / rangeMs) * 100}%` }} />)}
                            {showNow && <div className="absolute top-0 bottom-0 w-px bg-[#E4002B] z-[15]" style={{ left: `${pct(nowMs)}%` }} title="Now" />}
                            {/* shift overlay: production and sanitation headcount */}
                            {stripH > 0 && ['production', 'sanitation'].map((g, gi) => (
                                <div key={g} className="absolute left-0 right-0" style={{ bottom: gi === 0 ? stripH + 2 : 1, height: stripH - 1 }}>
                                    {rowOcc.filter(o => o.group === g).map((o, i) => {
                                        const l = Math.max(rangeFrom, o.start), r2 = Math.min(rangeTo, o.end), w = ((r2 - l) / rangeMs) * trackW;
                                        const sg = SHIFT_GROUPS[g];
                                        return <div key={i} className="absolute top-0 bottom-0 rounded-sm overflow-hidden whitespace-nowrap text-[8px] font-black leading-none flex items-center px-0.5 border"
                                            style={{ left: `${pct(l)}%`, width: `${((r2 - l) / rangeMs) * 100}%`, background: sg.soft, borderColor: sg.color, color: sg.color }}
                                            title={`${sg.label}${o.label ? ' ' + o.label : ''}${o.crew ? ' crew ' + o.crew : ''}: ${o.heads} people, ${fmtTime(o.start)} to ${fmtTime(o.end)}`}>
                                            {w > 26 ? `${sg.short} ${o.heads}` : ''}{w > 90 && o.label ? ` ${o.label}` : ''}
                                        </div>;
                                    })}
                                </div>
                            ))}
                            {/* cleaning windows between runs */}
                            {settings.showClean && rowGaps.map(g => {
                                const l = Math.max(rangeFrom, g.start), r2 = Math.min(rangeTo, g.end);
                                if (r2 <= l) return null;
                                const st = GAP_STYLE[g.status], w = ((r2 - l) / rangeMs) * trackW;
                                return <div key={g.prevId + g.nextId} data-gap="1" className="absolute rounded-sm border text-[9px] font-black overflow-hidden whitespace-nowrap flex items-center justify-center z-[5]"
                                    style={{ left: `${pct(l)}%`, width: `${((r2 - l) / rangeMs) * 100}%`, top: 6, height: 34, background: st.bg, borderColor: st.border, color: st.text, backgroundImage: 'repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(0,0,0,0.04) 5px, rgba(0,0,0,0.04) 10px)' }}
                                    title={`${st.label}\n${gapText(g)}`}>
                                    {w > 34 && (g.status === 'overlap' ? 'OVERLAP' : g.req.mins <= 0 ? fmtHrs(g.gapMs) : w > 120 ? `Clean ${fmtMins(g.req.mins)} / ${fmtHrs(g.gapMs)}` : w > 60 ? `${fmtMins(g.req.mins)}/${fmtHrs(g.gapMs)}` : fmtHrs(g.gapMs))}
                                </div>;
                            })}
                            {/* runs */}
                            {vis.map(r => {
                                const l = Math.max(rangeFrom, r.start), r2 = Math.min(rangeTo, r.end);
                                const w = ((r2 - l) / rangeMs) * trackW;
                                const maint = isMaint(r), sel = selectedId === r.id, dragging = ghost && ghost.id === r.id;
                                const bg = maint ? 'bg-black border-slate-800 text-white' : r.allergen ? 'bg-[#FFB81C] border-[#B27B00] text-slate-900' : 'bg-[#0072CE] border-[#00468B] text-white';
                                const bad = issueMap[r.id] === 'overlap', unc = uncoveredMap[r.id];
                                const tip = `${runTitle(r)}\n${fmtDT(r.start)} to ${fmtDT(r.end)} (${fmtHrs(r.end - r.start)})${r.cases ? `\n${fmtNum(r.cases)} cases` : ''}${r.order ? `\nOrder ${r.order}` : ''}${r.allergen ? `\nAllergen${r.allergenType ? ': ' + r.allergenType : ''}` : ''}${unc ? `\nNo production shift for ${fmtHrs(unc)} of this run` : ''}\nDrag to move, drag an edge to resize, double-click to edit`;
                                return (
                                    <div key={r.id} data-run="1" title={tip}
                                        onPointerDown={(e) => startDrag(e, r, 'move')}
                                        onDoubleClick={(e) => { e.stopPropagation(); onOpen(r); }}
                                        className={`absolute rounded-sm shadow-sm border text-[10px] px-1.5 py-0.5 flex flex-col justify-center overflow-hidden z-10 cursor-grab active:cursor-grabbing ${bg} ${sel ? 'ring-2 ring-offset-1 ring-[#E4002B]' : ''} ${bad ? 'outline outline-2 outline-[#E4002B]' : ''} ${dragging ? 'opacity-40' : ''}`}
                                        style={{ left: `${pct(l)}%`, width: `${Math.max(((r2 - l) / rangeMs) * 100, 0.15)}%`, top: 6, height: 34, touchAction: 'none', borderTop: unc ? '4px solid #F97316' : undefined }}>
                                        {r.start >= rangeFrom && <div onPointerDown={(e) => startDrag(e, r, 'start')} className="absolute left-0 top-0 bottom-0 w-[6px] cursor-ew-resize hover:bg-white/40" />}
                                        {r.end <= rangeTo && <div onPointerDown={(e) => startDrag(e, r, 'end')} className="absolute right-0 top-0 bottom-0 w-[6px] cursor-ew-resize hover:bg-white/40" />}
                                        {w > 22 && <span className="truncate leading-tight font-bold pointer-events-none">{maint ? 'MAINTENANCE' : r.product}</span>}
                                        {w > 110 && <span className="truncate leading-none text-[9px] opacity-90 pointer-events-none">{fmtHrs(r.end - r.start)}{r.cases ? ` · ${fmtNum(r.cases)} cs` : ''}{r.order ? ` · #${r.order}` : ''}{r.allergen ? ' · ALLERGEN' : ''}</span>}
                                    </div>
                                );
                            })}
                            {gh && (
                                <div className="absolute rounded-sm border-2 border-dashed z-[25] pointer-events-none flex items-center justify-center text-[10px] font-black"
                                    style={{ left: `${pct(Math.max(rangeFrom, gh.start))}%`, width: `${Math.max(((Math.min(rangeTo, gh.end) - Math.max(rangeFrom, gh.start)) / rangeMs) * 100, 0.2)}%`, top: 4, height: 38,
                                        background: gh.mode === 'blocked' ? 'rgba(228,0,43,0.18)' : gh.mode === 'free' ? 'rgba(0,114,206,0.18)' : 'rgba(255,184,28,0.30)', borderColor: gh.mode === 'blocked' ? '#E4002B' : gh.mode === 'free' ? '#0072CE' : '#B27B00', color: '#111' }}>
                                    <span className="absolute left-0 top-0.5 bg-slate-900 text-white text-[10px] px-1.5 py-0.5 rounded whitespace-nowrap shadow z-30">
                                        {fmtDay(gh.start)} {fmtTime(gh.start)} to {fmtTime(gh.end)} ({fmtHrs(gh.end - gh.start)}){gh.mode === 'swap' ? ' · swaps order' : gh.mode === 'push' ? ` · pushes ${gh.pushed} later run${gh.pushed === 1 ? '' : 's'}` : gh.mode === 'blocked' ? ' · blocked' : ''}
                                    </span>
                                </div>
                            )}
                        </div>
                    </div>
                );
            })}
        </div>
    );
}

