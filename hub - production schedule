        dayCells.forEach(c => { for (let h = hourStep; h < 24; h += hourStep) { const t = new Date(c.ms); t.setHours(h, 0, 0, 0); if (t.getTime() > c.ms && t.getTime() < c.next && (!out.length || out[out.length - 1].ms < t.getTime())) out.push({ ms: t.getTime(), h: t.getHours() }); } });
        return out;
    }, [dayCells, hourStep]);
    const nightBands = useMemo(() => {   // 6 pm to 6 am, shaded over ranges up to a week
        const out = [];
        if (rangeDays > 7) return out;
        dayCells.forEach(c => { const a = new Date(c.ms); a.setHours(6, 0, 0, 0); const b = new Date(c.ms); b.setHours(18, 0, 0, 0); out.push([c.ms, a.getTime()], [b.getTime(), c.next]); });
        return out;
    }, [dayCells, rangeDays]);
    const dayCellStyle = (c) => ({ left: `${pct(c.ms)}%`, width: `${((c.next - c.ms) / rangeMs) * 100}%` });
    const showNow = nowMs >= rangeFrom && nowMs <= rangeTo;
    const overlayOn = settings.showShifts && rangeDays <= 14;   // too dense to read over longer ranges
    const stripH = overlayOn ? 11 : 0;
    const showClean = !!settings.showClean;

    // per line: what is in view (rebuilt only when the runs, shifts or range change, not on a click or a drag)
    const rowData = useMemo(() => {
        const out = {}, inView = (o) => o.end > rangeFrom && o.start < rangeTo;
        rows.forEach(row => {
            out[row.key] = {
                vis: (byLine[row.key] || []).filter(r => r.start < rangeTo && r.end > rangeFrom),
                rowGaps: (gapsByLine[row.key] || []).filter(g => g.end > rangeFrom && g.start < rangeTo),
                occProd: overlayOn ? occForLine(occ, row.key, 'production', own).filter(inView) : NO_ITEMS,
                occSan: overlayOn ? occForLine(occ, row.key, 'sanitation', own).filter(inView) : NO_ITEMS,
            };
        });
        return out;
    }, [rows, byLine, gapsByLine, occ, own, overlayOn, rangeFrom, rangeTo]);
    const selKey = useMemo(() => {
        if (!selectedId) return null;
        const ks = Object.keys(byLine);
        for (let i = 0; i < ks.length; i++) if (byLine[ks[i]].some(r => r.id === selectedId)) return ks[i];
        return null;
    }, [selectedId, byLine]);

    return (
        <div className="bg-white border border-slate-300 rounded-xl select-none" style={{ touchAction: 'pan-y', overflow: 'clip' }}>
            {/* header: days on top, hours under them; it stays at the top of the page while the lines scroll */}
            <div className="flex border-b-2 border-slate-300 bg-slate-50 sticky top-0 z-30 shadow-sm">
                <div className="flex-shrink-0 border-r-2 border-slate-300 px-2 py-1.5 text-[10px] font-black uppercase tracking-widest text-slate-500 flex items-end" style={{ width: GANTT_LABEL_W }}>Line</div>
                <div className="flex-1 relative" ref={trackRef} style={{ height: hourStep ? 46 : 34 }}>
                    {dayCells.map((c, i) => (
                        <div key={i} className={`absolute top-0 border-l ${c.dow === 0 ? 'border-slate-500/70' : 'border-slate-300'} ${hourStep ? 'border-b border-b-slate-200' : ''} text-[10px] font-bold text-slate-600 px-1 overflow-hidden whitespace-nowrap ${c.dow === 0 || c.dow === 6 ? 'bg-slate-100' : ''}`} style={{ ...dayCellStyle(c), height: hourStep ? 23 : 34 }}>
                            {rangeDays <= 21 ? c.label : (c.date === 1 || i === 0 || c.dow === 0 ? <><span className={c.date === 1 ? 'text-[#00468B]' : ''}>{c.date === 1 ? fmtMonthName(c.ms) + ' ' : ''}{c.date}</span></> : null)}
                            {rangeDays > 21 && <div className="text-[8px] text-slate-400 font-medium">{DOW[c.dow][0]}</div>}
                        </div>
                    ))}
                    {hourStep > 0 && hourTicks.map(t => (
                        <div key={t.ms} className="absolute border-l border-slate-300 leading-none" style={{ left: `${pct(t.ms)}%`, top: 23, height: 23 }}>
                            <span className="inline-block text-[9px] font-black text-[#00468B] bg-[#E6F1FB] border-b border-r border-[#CFE3F7] rounded-br px-1 py-0.5">{hourLabel(t.h)}</span>
                        </div>
                    ))}
                    {showNow && <div className="absolute bottom-0 px-1 rounded-t bg-[#E4002B] text-white text-[9px] font-black leading-4 z-[2]" style={{ left: `${pct(nowMs)}%`, transform: 'translateX(-50%)' }}>NOW</div>}
                </div>
            </div>
            {rows.length === 0 && <div className="p-10 text-center text-sm text-slate-500">No lines to show yet. Import a week, or use "+ Run" to schedule the first run.</div>}
            <div className="relative">
                {rows.length > 0 && (
                    <div className="absolute top-0 bottom-0 right-0 pointer-events-none overflow-hidden" style={{ left: GANTT_LABEL_W }} data-grid="1">
                        {dayCells.map((c, i) => (c.dow === 0 || c.dow === 6) && <div key={`w${i}`} className="absolute top-0 bottom-0 bg-slate-100/80" style={dayCellStyle(c)} />)}
                        {nightBands.map((b, i) => <div key={`n${i}`} className="absolute top-0 bottom-0 bg-slate-300/20" style={{ left: `${pct(b[0])}%`, width: `${((b[1] - b[0]) / rangeMs) * 100}%` }} />)}
                        {hourTicks.map(t => <div key={t.ms} data-hourline="1" className="absolute top-0 bottom-0 border-l border-dashed border-slate-300/90" style={{ left: `${pct(t.ms)}%` }} />)}
                        {dayCells.map((c, i) => i > 0 && <div key={`d${i}`} data-dayline="1" className={`absolute top-0 bottom-0 border-l ${c.dow === 0 ? 'border-slate-500/70' : 'border-slate-300'}`} style={{ left: `${pct(c.ms)}%` }} />)}
                    </div>
