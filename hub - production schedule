                        <Btn
                            kind="primary"
                            disabled={fixBusy || running || (stdData.totalActionable === 0)}
                            onClick={handleStandardizeEverything}
                        >
                            Standardize All & Purge 0-Run Ghosts ({fmtNum(stdData.totalActionable)})
                        </Btn>
                    </div>
                </div>

                {/* Progress / Undo Bar */}
                {(A && (A.fixing || A.fixed)) && (
                    <div className="space-y-2 pt-1">
                        {A.fixing && (
                            <div className="bg-[#FFF6E0] border border-[#FFB81C] rounded-xl p-3 text-xs font-bold text-slate-800">
                                <div className="flex items-center justify-between gap-2">
                                    <span>{A.fixing.label}: {fmtNum(A.fixing.done)} of {fmtNum(A.fixing.total)}</span>
                                    <Btn kind="danger" onClick={cancelAudit}>Stop</Btn>
                                </div>
                                <div className="h-1.5 rounded bg-white mt-1.5 overflow-hidden">
                                    <div className="h-full bg-[#0072CE]" style={{ width: `${A.fixing.total ? Math.round((A.fixing.done / A.fixing.total) * 100) : 0}%` }} />
                                </div>
                            </div>
