                                        </td>
                                        <td className="px-2.5 py-2 whitespace-nowrap">
                                            <div><b className="text-[#5B21B6]">{fmtMins(item.weeklyMins)}</b> <span className="text-[10px] text-slate-400">({fmtMins(item.weeklyWork)} work)</span></div>
                                        </td>
                                        <td className="px-2.5 py-2 whitespace-nowrap">
