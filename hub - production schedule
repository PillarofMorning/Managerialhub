                            <input className={inputCls} value={L.cfg.skipDaily !== undefined ? L.cfg.skipDaily : CR_SKIP_DEFAULT.full} placeholder={tx('PIC areas, comma between them', 'Areas PIC, separadas por coma')} onChange={(e) => setCfg({ skipDaily: e.target.value })} data-testid="skip-daily" />
                        </Field>
