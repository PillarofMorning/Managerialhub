        startDate: getLocalYMD(new Date(s)), startTime: hhmmOf(s), endDate: getLocalYMD(new Date(e)), endTime: hhmmOf(e), hours: String(hours),
        cases: '', order: '', notes: '', batch: '', allergen: false, allergenType: '', crumb: false, repeat: 'once', repeatDays: 5 };
