        </div>
    );
}

// One run to check: day, item and status on the first line; start, stop, hours and flags on the second. Wraps on any screen width.
function RunRow({ r, ed, onInclude, onEdit, onReset, onFlag }) {
    const p = r.p, look = STATUS_LOOK[r.status];
    const edited = ed.start || ed.end || (ed.hours !== undefined && ed.hours !== '');
    const lab = 'text-[10px] font-black uppercase tracking-wider text-slate-400';
    const guessed = p.hoursSource === 'default' || p.hoursSource === 'window';
    const hoursTip = p.hoursSource === 'default' ? 'No hours on the sheet: the line\'s "hours if blank" was used. Type the real hours.' : p.hoursSource === 'window' ? 'No hours on the sheet: filled to the end of the line\'s window. Type the real hours if they differ.' : p.hoursSource === 'rate' ? 'Worked out from cases and the line rate' : '';
    const notes = [];
    if (r.status === 'update') notes.push({ t: r.changes.join('; '), c: 'text-slate-500' });
    if (r.status === 'clash' && r.clashWith) notes.push({ t: `overlaps ${runTitle(r.clashWith)}, ${fmtDT(r.clashWith.start)}`, c: 'text-[#B00020]' });
    if (r.selfOverlap) notes.push({ t: 'overlaps another run on this sheet', c: 'text-[#B00020]' });
    if (p.afterCutoff) notes.push({ t: `ends after the stop time (${fmtTime(p.cutAt)})`, c: 'text-[#B27B00]' });
