const DOWN_RULE_LABELS = {
    daily_and_weekend_eow: { short: 'Daily + Weekend EOW', badge: 'bg-[#E0F2FE] text-[#0369A1] border-[#7DD3FC]', desc: 'Down every day: Daily (D) clean on daily stops >= 60m + EOW Weekly (W) clean on the weekend.' },
    weekly_weekend_only: { short: 'Down Daily to Cleaned Weekly (Weekend)', badge: 'bg-[#EDE9FE] text-[#5B21B6] border-[#C4B5FD]', desc: 'Down every day, cleaned once every week on the weekend EOW stop.' },
    midweek_72h_and_weekend_eow: { short: '72h Midweek + Weekend EOW (IBL4)', badge: 'bg-[#FEF3C7] text-[#92400E] border-[#FCD34D]', desc: 'Continuous run: Midweek (NS) clean after 72 hours + EOW Weekly (PSW/W) clean on the weekend.' },
};

function CleaningView({ rows, assets, assetsByArea, areaList, runRulesByLine, settings, updateSettings, gaps, own, onJump, assetsLoaded, onOpenCheck, onSaveRunRule, sanLogs }) {
    const [lineKey, setLineKey] = useState(rows.length ? rows[0].key : '');
    const [people, setPeople] = useState('');
    const [savingRule, setSavingRule] = useState(false);
    useEffect(() => { if (!lineKey && rows.length) setLineKey(rows[0].key); }, [rows.length]);
    const areaNames = useMemo(() => Object.keys(assetsByArea).sort(byNatural), [assetsByArea]);

    const lk = splitKey(lineKey), cfgKey = cleanCfgKey(settings.clean, lk.area, lk.line) || lineKey;
    const rawCfg = settings.clean[cfgKey] || {};
    const setCfg = (patch) => updateSettings(s => {
        const key = cleanCfgKey(s.clean, lk.area, lk.line) || lineKey;
        const nextRow = { ...(s.clean[key] || {}), ...patch };
        if (patch.areas === null) delete nextRow.areas;
        return { ...s, clean: { ...s.clean, [key]: nextRow } };
    });

    // Index recent sanitation logs (craa5__log_) by assetId and canonical area so each line shows its latest floor completion
    const lastLogForLine = useMemo(() => {
        const logs = sanLogs || [];
        const byAsset = {}, byArea = {};
        logs.forEach(lg => {
            if (!lg || !lg.at) return;
            if (lg.assetId && (!byAsset[lg.assetId] || lg.at > byAsset[lg.assetId].at)) byAsset[lg.assetId] = lg;
            const ca = canon(lg.area);
            if (ca && (!byArea[ca] || lg.at > byArea[ca].at)) byArea[ca] = lg;
        });
        return (L) => {
            let best = null;
            (L.pieces || []).forEach(p => {
                const hit = byAsset[p.id];
                if (hit && (!best || hit.at > best.at)) best = hit;
            });
            (L.linkedAreas || [L.area]).forEach(a => {
                const hit = byArea[canon(a)];
                if (hit && (!best || hit.at > best.at)) best = hit;
            });
            return best;
        };
    }, [sanLogs]);

    // Build at-a-glance summary across ALL production lines
    const allLinesSummary = useMemo(() => {
        return rows.map(r => {
            const k = splitKey(r.key);
            const effDefs = settings.shifts.filter(x => x.group === 'sanitation' && x.lineKey === shiftLineKey(own, k.area, k.line, 'sanitation'));
            const resolved = effDefs.map(x => x.heads !== '' && x.heads !== undefined ? Number(x.heads) : 0).filter(h => h > 0);
            const crewH = resolved.length ? Math.max(1, Math.round(resolved.reduce((a, b) => a + b, 0) / resolved.length)) : Math.max(1, Number(settings.cleanHeads) || 2);
            const L = lineCtxOf({ clean: settings.clean, own: {}, occ: [], assetsByArea, areaList, runRulesByLine, fallbackHeads: crewH }, k.area, k.line);
            const dailyNeed = cleanNeed('full', null, L, false);
            const midweekNeed = cleanNeed('midweek', null, L, false);
            const weeklyNeed = cleanNeed('weekly', null, L, true);
            const alrgNeed = cleanNeed('allergen', null, L, false);
            const lineGaps = gaps.filter(g => g.lineKey === r.key && g.end >= Date.now() - DAY);
            const shortCount = lineGaps.filter(g => g.status === 'short' || g.status === 'overlap' || g.status === 'nocrew').length;
            const lastLog = lastLogForLine(L);
            return {
                row: r, L, crewH, lastLog,
                dailyMins: needFlatMins(dailyNeed, crewH), dailyWork: dailyNeed.work,
                midweekMins: L.rule.midweekHours > 0 ? needFlatMins(midweekNeed, crewH) : 0, midweekWork: midweekNeed.work,
                weeklyMins: needFlatMins(weeklyNeed, crewH), weeklyWork: weeklyNeed.work,
                alrgMins: needFlatMins(alrgNeed, crewH), alrgWork: alrgNeed.work,
                nDaily: L.pieces.filter(p => p.daily).length,
                nMidweek: L.pieces.filter(p => p.midweek).length,
                nWeekly: L.pieces.filter(p => p.weekly).length,
                shortCount, totalStops: lineGaps.length,
            };
        });
    }, [rows, settings.clean, settings.shifts, settings.cleanHeads, own, assetsByArea, areaList, runRulesByLine, gaps, lastLogForLine]);

    const effDefs = settings.shifts.filter(x => x.group === 'sanitation' && x.lineKey === shiftLineKey(own, lk.area, lk.line, 'sanitation'));
    const resolved = effDefs.map(x => x.heads !== '' && x.heads !== undefined ? Number(x.heads) : 0).filter(h => h > 0);
    const typical = resolved.length ? Math.max(1, Math.round(resolved.reduce((a, b) => a + b, 0) / resolved.length)) : Math.max(1, Number(settings.cleanHeads) || 2);
    const ctxHeads = people !== '' ? Math.max(1, parseInt(people, 10) || 1) : typical;

    const L = useMemo(() => {
        const k = splitKey(lineKey);
        return lineCtxOf({ clean: settings.clean, own: {}, occ: [], assetsByArea, areaList, runRulesByLine, fallbackHeads: ctxHeads }, k.area, k.line);
    }, [lineKey, settings.clean, assetsByArea, areaList, runRulesByLine, ctxHeads]);

    const toggleArea = (a) => {
        const cur = L.linkedAreas || [];
        const next = cur.indexOf(a) >= 0 ? cur.filter(x => x !== a) : cur.concat([a]);
        setCfg({ areas: next });
    };

    const needOf = (kind, h, weekly) => {
        const n = cleanNeed(kind, null, L, weekly);
        return { mins: needFlatMins(n, h), basis: n.basis, equipCount: n.count, work: n.work, weekly: n.weekly, midweek: n.midweek, noDaily: n.noDaily, sapOrder: n.sapOrder };
    };
    const needAt = (h) => ({
        daily: needOf('full', h, false),
        midweek: needOf('midweek', h, false),
        weekly: needOf('weekly', h, true),
        alg: needOf('allergen', h, false),
    });
    const { daily, midweek, weekly, alg } = needAt(ctxHeads);
    const skipM = cleanScope('midweek', L, false).skipped, skipD = cleanScope('full', L, false).skipped;
    const skipHint = (list, none) => list.length ? `${list.length} ${tx('left out', 'fuera')}: ${list.slice(0, 6).map(x => x.p.name).join(', ')}${list.length > 6 ? ', ...' : ''}` : none;
    const mine = gaps.filter(g => g.lineKey === lineKey && g.end >= Date.now() - DAY).sort((a, b) => a.start - b.start).slice(0, 40);
    const th = "px-2.5 py-2 text-left text-[10px] font-black uppercase tracking-wider text-slate-500 border-b border-slate-200";
    const areaTotals = (a) => (assetsByArea[a] || []).reduce((n, x) => n + x.baseMins, 0);
    const ruleMeta = DOWN_RULE_LABELS[L.rule.downFrequency] || DOWN_RULE_LABELS.daily_and_weekend_eow;

    return (
        <div className="space-y-4">
            {/* AT-A-GLANCE ALL-LINES SUMMARY TABLE */}
            <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <div>
                        <h2 className="text-sm font-black text-[#00468B] uppercase tracking-widest">All Lines - Auto-Populated Equipment & MSS Clean Times</h2>
                        <p className="text-xs text-slate-500">Primary source of truth: <b>Equipment (<code className="text-[11px]">craa5_aa_assets</code>)</b> paired with <b>MSS (<code className="text-[11px]">craa5_aa_ms_assets</code>)</b>, <b>Run Rules (<code className="text-[11px]">{TABLE_RUN_RULES}</code>)</b>, and <b>Floor Logs (<code className="text-[11px]">{TABLE_LOGS}</code>)</b>. Click any line to customize.</p>
                    </div>
                    <div className="flex items-center gap-2">
                        <span className="text-[11px] font-bold text-slate-600">Default sanitation crew:</span>
                        <input type="number" min="1" className="w-16 border border-slate-300 rounded-lg px-2 py-1 text-xs font-bold text-[#00468B]" value={settings.cleanHeads} onChange={(e) => updateSettings(s => ({ ...s, cleanHeads: Math.max(1, parseInt(e.target.value, 10) || 1) }))} />
                        {onOpenCheck && <Btn kind="ghost" onClick={() => onOpenCheck('columns')} title="Inspect Dataverse table & column definitions including Equipment, MSS, and Run Rules">Linked Tables Spec</Btn>}
                    </div>
