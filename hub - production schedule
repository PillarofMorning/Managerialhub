                        </div>
                    )}
                    {applying && <div className="mb-2 h-1.5 rounded bg-slate-200 overflow-hidden"><div className="h-full bg-[#0072CE] transition-all" style={{ width: `${applying.phase === 'checking' || applying.phase === 'looking' ? 100 : pct}%`, background: applying.phase === 'checking' || applying.phase === 'looking' ? '#FFB81C' : undefined }} /></div>}
                    <div className="flex flex-wrap items-center gap-x-3 gap-y-2">
                        {waiting && <Btn onClick={() => apply(null, false)} disabled={!canApply} className="min-w-[15rem]" title="Change the schedule as shown above">{applying ? (applying.phase === 'looking' ? 'Looking at the schedule again...' : applying.phase === 'checking' ? 'Checking what was saved...' : `Saving ${applying.done} of ${applying.total}...`) : `Apply to schedule (${jobs.length} line${jobs.length === 1 ? '' : 's'}${jobs.length ? `: ${[jobCounts.change && `${jobCounts.change} change`, jobCounts.add && `${jobCounts.add} add`, jobCounts.remove && `${jobCounts.remove} take off`].filter(Boolean).join(', ')}` : ''})`}</Btn>}
