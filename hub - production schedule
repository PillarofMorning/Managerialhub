const inputCls = "w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]";
const Btn = ({ children, onClick, kind = 'primary', disabled, title, className = '' }) => {
    const kinds = {
        primary: 'bg-[#0072CE] text-white hover:bg-[#00468B] border-[#0072CE]',
        ghost: 'bg-white text-slate-700 hover:bg-slate-50 border-slate-300',
        danger: 'bg-white text-[#E4002B] hover:bg-[#FDE8EC] border-[#E4002B]/40',
        dangerSolid: 'bg-[#E4002B] text-white hover:bg-[#B00020] border-[#E4002B]',
        yellow: 'bg-[#FFB81C] text-slate-900 hover:brightness-95 border-[#B27B00]/40',
    };
    return <button type="button" disabled={disabled} onClick={onClick} title={title} className={`px-3 py-1.5 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed ${kinds[kind]} ${className}`}>{children}</button>;
};
const Chip = ({ on, onClick, children, title }) => (
    <button type="button" onClick={onClick} title={title} className={`px-2.5 py-1 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap ${on ? 'bg-[#0072CE] text-white border-[#0072CE] shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]'}`}>{children}</button>
);
const Field = ({ label, children, className = '', hint }) => (
    <label className={`block ${className}`}>
        <span className="block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">{label}</span>
        {children}
        {hint && <span className="block text-[10px] text-slate-400 mt-0.5">{hint}</span>}
    </label>
);
function Modal({ title, onClose, children, wide, footer }) {
    useEffect(() => {
        const k = (e) => { if (e.key === 'Escape') onClose(); };
        window.addEventListener('keydown', k);
        return () => window.removeEventListener('keydown', k);
    }, [onClose]);
    return (
        <div className="fixed inset-0 z-[100] bg-slate-900/40 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
            <div className={`bg-white rounded-2xl shadow-2xl border border-slate-200 w-full ${wide ? 'max-w-3xl' : 'max-w-xl'} my-6`} style={{ fontFamily: BRAND_FONT }}>
                <div className="flex items-center justify-between px-5 py-3 border-b border-slate-200">
                    <h3 className="text-sm font-black uppercase tracking-widest text-[#00468B]">{title}</h3>
                    <button type="button" onClick={onClose} className="text-slate-400 hover:text-slate-700"><XIcon className="w-5 h-5" /></button>
                </div>
                <div className="p-5">{children}</div>
                {footer && <div className="px-5 py-3 border-t border-slate-200 bg-slate-50 rounded-b-2xl flex items-center gap-2 flex-wrap">{footer}</div>}
