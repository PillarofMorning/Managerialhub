    const updates = [{ id: run.id, patch: patchSelf }];
    let cursor = tgt.end;
    const later = others.filter(r => r.start >= tgt.start);
    for (let k = 0; k < later.length; k++) {
        const r = later[k];
        if (r.start >= cursor) break;
        const d = cursor - r.start;
        updates.push({ id: r.id, patch: { start: r.start + d, end: r.end + d } });
        cursor = r.end + d;
    }
