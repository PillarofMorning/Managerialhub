// Reads rows. Returns an array, or null when EVERY attempt failed (a failed read is never mistaken for "no data").
async function queryRecords(entityNames, dataApi, { orderby, filter = "statecode eq 0", top = QUERY_LIMIT } = {}) {
    const web = safeGetXrm()?.WebApi;
    const names = Array.isArray(entityNames) ? entityNames : [entityNames];
    let emptyResult = null;
    const odata = [filter ? `$filter=${filter}` : '', orderby ? `$orderby=${orderby}` : '', `$top=${top}`].filter(Boolean).join('&');
    for (const en of names) {
        if (web?.retrieveMultipleRecords) {
            try {
                const res = await withTimeout(web.retrieveMultipleRecords(en, `?${odata}`), API_TIMEOUT_MS, `Xrm.WebApi ${en}`);
                if (Array.isArray(res?.entities)) { if (res.entities.length || names.length === 1) return res.entities; emptyResult = res.entities; continue; }
            } catch (e) { console.warn(`[ProdSchedule] ${en} via Xrm.WebApi:`, e?.message || e); }
        }
        if (dataApi?.queryTable) {
            try {
                const opts = { pageSize: Math.min(top, 500), filter };
                if (orderby) opts.orderBy = orderby;
                let page = await withTimeout(dataApi.queryTable(en, opts), API_TIMEOUT_MS, `dataApi ${en}`);
                if (!Array.isArray(page?.rows)) throw new Error("no rows");
                const rows = [...page.rows];
                while (page?.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < top) {
                    page = await withTimeout(page.loadMoreRows(), API_TIMEOUT_MS, `dataApi ${en}`);
                    rows.push(...(Array.isArray(page?.rows) ? page.rows : []));
                }
                if (rows.length || names.length === 1) return rows.slice(0, top);
                emptyResult = rows;
            } catch (e) { console.warn(`[ProdSchedule] ${en} via dataApi:`, e?.message || e); }
        }
    }
    return emptyResult;
}

const idOf = (res) => { const id = typeof res === 'string' ? res : res?.id; return id ? String(id).replace(/[{}]/g, '') : null; };
// Returns null when no write API exists, so callers can say so instead of pretending a save happened.
function getWriteApi(dataApi) {
    const web = safeGetXrm()?.WebApi;
    if (web?.createRecord && web?.updateRecord && web?.deleteRecord) {
        return { create: async (t, d) => idOf(await web.createRecord(t, d)), update: (t, id, d) => web.updateRecord(t, id, d), remove: (t, id) => web.deleteRecord(t, id) };
    }
    if (dataApi?.createRow && dataApi?.updateRow) {
        return {
            create: async (t, d) => idOf(await dataApi.createRow(t, d)),
            update: (t, id, d) => dataApi.updateRow(t, id, d),
            remove: (t, id) => dataApi.deleteRow ? dataApi.deleteRow(t, id) : Promise.reject(new Error("Delete isn't available in this environment")),
        };
    }
    return null;
}

