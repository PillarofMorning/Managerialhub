    );
}

function DataCheckView({ sub, setSub, auditRef, subscribe, startAudit, cancelAudit, fixRuns, deleteRuns, undoFix, openRun, mssIdx, payloadsRef, payloadTick, colStatus, refusedCols, probeColumns, probing, resetRefused, clearPayloads, apiReady }) {
    const [, force] = useState(0);
    useEffect(() => subscribe(() => force(n => n + 1)), [subscribe]);
    const probedOnce = useRef(false);
    // the first time the Columns list is opened in a visit the columns are tested, so it shows what is missing and not just what was tried
    useEffect(() => { if (sub === 'columns' && apiReady && !probedOnce.current) { probedOnce.current = true; probeColumns(); } }, [sub, apiReady]);
    const A = auditRef.current, nPay = payloadsRef.current.length, nBad = payloadsRef.current.filter(e => !e.ok || e.dropped.length).length;
    const SUBS = [
        { id: 'run', label: 'Run check', badge: A.result ? (A.result.counts.bad ? A.result.counts.bad : (A.stopped || A.capped || A.error || (A.cut && A.cut.length) ? '' : '✓')) : '' },
        { id: 'columns', label: 'Columns', badge: refusedCols.length ? refusedCols.length : '' },
        { id: 'payloads', label: 'Payloads', badge: nPay ? (nBad ? `${nBad}!` : nPay) : '' },
    ];
    return (
        <div className="space-y-4">
            <div className="flex flex-wrap items-center gap-3">
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Data Check</h2>
                <div className="flex gap-1.5">{SUBS.map(s => <Chip key={s.id} on={sub === s.id} onClick={() => setSub(s.id)}>{s.label}{s.badge !== '' && <span className="ml-1.5 px-1.5 rounded-full bg-white/25 text-[10px]">{s.badge}</span>}</Chip>)}</div>
            </div>
            {sub === 'run' && <RunCheckPanel A={A} startAudit={startAudit} cancelAudit={cancelAudit} fixRuns={fixRuns} deleteRuns={deleteRuns} undoFix={undoFix} openRun={openRun} mssIdx={mssIdx} apiReady={apiReady} />}
            {sub === 'columns' && <ColumnsPanel colStatus={colStatus} probeColumns={probeColumns} probing={probing} resetRefused={resetRefused} apiReady={apiReady} refusedCols={refusedCols} />}
            {sub === 'payloads' && <PayloadsPanel payloadsRef={payloadsRef} clearPayloads={clearPayloads} tick={payloadTick} />}
        </div>
    );
}

