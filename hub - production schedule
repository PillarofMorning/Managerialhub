            notes: extras && extras.notes !== undefined ? extras.notes : (run.notes || ''), areaId: res.sent.indexOf(F_AREA_ID) >= 0 ? areaIdFor(run.area) : (run.areaId || ''), batch: extras && extras.batch ? extras.batch : (run.batch || ''), flags: { lineBlank: false, startBlank: false, endBlank: false } };
        if (!quiet) setRuns(prev => (op === 'create' ? prev.concat([full]) : prev.map(r => r.id === rid ? { ...r, ...full } : r)).sort(byStart));
        return rid;
    };
    const patchFields = (patch) => {
        const f = {};
        if (patch.start !== undefined) f.craa5_datestarttime = new Date(patch.start).toISOString();
        if (patch.end !== undefined) f.craa5_dateendtime = new Date(patch.end).toISOString();
        if (patch.area !== undefined) f.craa5_area = patch.area;
        if (patch.line !== undefined) f.craa5_line = patch.line;
        return f;
    };
    // A change to some of a run's columns (a drag, a fix from the Data Check tab). An area change carries the MSS area id too.
    const patchRun = async (id, patch, what, meta) => {
        const opt = {};
        if (patch.areaId !== undefined) opt[F_AREA_ID] = patch.areaId || null;
        else if (patch.area !== undefined) opt[F_AREA_ID] = areaIdFor(patch.area) || null;   // an area that is not an MSS area must not keep the old area's id
        return deliver('update', id, patchFields(patch), opt, { ...(meta || {}), what: what || 'change' });
    };
    const deleteRun = async (id, meta) => {
        const w = writer();
        if (!w) throw new Error("No Dataverse write connection in this environment. Nothing was deleted.");
        try { await w.remove(TABLE_PROD, id); }
        catch (e) { logPayload({ op: 'delete', table: TABLE_PROD, id, what: (meta && meta.what) || 'delete', fields: {}, sent: [], dropped: [], ok: false, error: errText(e), preview: !apiReady }); throw e; }
        forgetSide(id);
        logPayload({ op: 'delete', table: TABLE_PROD, id, what: (meta && meta.what) || 'delete', fields: {}, sent: [], dropped: [], ok: true, error: '', preview: !apiReady });
        if (cpTouchRef.current) cpTouchRef.current();
        if (!(meta && meta.quiet)) { touched(id); setRuns(prev => prev.filter(r => r.id !== id)); }
    };
    const pushUndo = (label, items) => setUndoStack(s => s.concat([{ label, items }]).slice(-30));
    // Apply a list of { id, patch } with an immediate on-screen change; a failure puts the unsaved ones back.
    const applyUpdates = async (updates, label) => {
        const befores = updates.map(u => { const r = runsRef.current.find(x => x.id === u.id); return r ? { id: u.id, before: { start: r.start, end: r.end, area: r.area, line: r.line } } : null; }).filter(Boolean);
        const map = {}; updates.forEach(u => { map[u.id] = u.patch; });
        setRuns(prev => prev.map(r => map[r.id] ? { ...r, ...map[r.id] } : r).sort(byStart));
        const saved = []; let failure = null;
        for (let i = 0; i < updates.length; i++) {
            try { await patchRun(updates[i].id, updates[i].patch, label); touched(updates[i].id); saved.push(updates[i].id); }
            catch (e) { failure = e; break; }
        }
        if (failure) {
            const back = {}; befores.forEach(b => { if (saved.indexOf(b.id) < 0) back[b.id] = b.before; });
            setRuns(prev => prev.map(r => back[r.id] ? { ...r, ...back[r.id] } : r).sort(byStart));
            notify(`Could not save the change: ${failure.message || failure}${saved.length ? ` (${saved.length} of ${updates.length} runs were saved)` : ''}.`, 'error');
        }
        if (saved.length) pushUndo(label, befores.filter(b => saved.indexOf(b.id) >= 0).map(b => ({ type: 'patch', id: b.id, before: b.before })));
        return !failure;
    };
    const undoLast = async () => {
        const top = undoStack[undoStack.length - 1];
        if (!top) return;
        setUndoStack(s => s.slice(0, -1));
        let failure = null;
        for (let i = top.items.length - 1; i >= 0 && !failure; i--) {
            const it = top.items[i];
            try {
                if (it.type === 'patch') { await patchRun(it.id, it.before, `undo ${top.label}`); touched(it.id); setRuns(prev => prev.map(r => r.id === it.id ? { ...r, ...it.before } : r).sort(byStart)); }
                else if (it.type === 'create') await deleteRun(it.id, { what: `undo ${top.label}` });
                else if (it.type === 'delete') await saveRun('create', null, it.run, { order: it.run.order, cases: it.run.cases, notes: it.run.notes, batch: it.run.batch }, { what: `undo ${top.label}` });
            } catch (e) { failure = e; }
        }
        if (failure) notify(`Could not undo: ${failure.message || failure}`, 'error'); else notify(`Undone: ${top.label}`, 'success');
    };

    // ------------------------------------------------------------------------
    // LINES, SHIFTS, CLEANING CHECKS
    // ------------------------------------------------------------------------
    const allRows = useMemo(() => {
        const m = {};
        const add = (area, line) => { if (!area) return; const k = lineKeyOf(area, line); if (!m[k]) m[k] = { key: k, area, line: Number(line) || 1, label: lineLabelOf(area, Number(line) || 1) }; };
        runs.forEach(r => add(r.area, r.line));
        Object.keys(settings.lineMap).forEach(k => { const c = settings.lineMap[k]; if (c && !c.skip && c.area) add(c.area, c.line); });
        settings.extraLines.forEach(k => { const kr = splitKey(k); add(kr.area, kr.line); });
        // every MSS production line has its row, even before it has a run (IBL4 and "IBL line 4" count as the same line)
        if (mss.tier !== 'all') {
            const have = {}; Object.keys(m).forEach(k => { have[canonLine(m[k].area, m[k].line)] = true; });
            mss.names.forEach(n => { if (!have[canonLine(n, 1)]) add(n, 1); });
        }
        const list = Object.keys(m).map(k => m[k]);
        const idx = (k) => { const i = settings.lineOrder.indexOf(k); return i < 0 ? 9999 : i; };
        return list.sort((a, b) => idx(a.key) - idx(b.key) || byNatural(a.label, b.label));
    }, [runs, settings.lineMap, settings.extraLines, settings.lineOrder, mss]);
    const rangeTo = addDaysLocal(new Date(view.from), view.days).getTime();
    const rows = useMemo(() => {
        if (!settings.hideEmpty) return allRows;
        const has = {}; runs.forEach(r => { if (r.start < rangeTo && r.end > view.from) has[lineKeyOf(r.area, r.line)] = true; });
        return allRows.filter(r => has[r.key]);
    }, [allRows, runs, settings.hideEmpty, view.from, rangeTo]);

    const own = useMemo(() => { const o = {}; settings.shifts.forEach(s => { o[`${s.lineKey}|${s.group}`] = true; }); return o; }, [settings.shifts]);
    const span = useMemo(() => {
        let lo = view.from - 14 * DAY, hi = rangeTo + 14 * DAY;
        runs.forEach(r => { if (r.start < lo) lo = r.start; if (r.end > hi) hi = r.end; });
        return [Math.max(lo, Date.now() - 400 * DAY), Math.min(hi, Date.now() + 400 * DAY)];
    }, [runs, view.from, rangeTo]);
    const rosterSig = JSON.stringify(rosterTable);
    const occ = useMemo(() => shiftOccurrences(settings.shifts, span[0] - DAY, span[1] + DAY, rosterCount), [settings.shifts, span[0], span[1], rosterSig]);
    const gapCtx = useMemo(() => ({ occ, own, clean: settings.clean, assetsByArea, fallbackHeads: settings.cleanHeads }), [occ, own, settings.clean, assetsByArea, settings.cleanHeads]);
    const analysis = useMemo(() => {
        const byLine = {}, exact = {};
        runs.forEach(r => { const c = canonLine(r.area, r.line), k = lineKeyOf(r.area, r.line); (byLine[c] = byLine[c] || []).push(r); (exact[k] = exact[k] || []).push(r); });
        const gaps = [], issueMap = {}, uncoveredMap = {};
        // the stops of each line (however its area is spelled), judged by the cleaning rules
        Object.keys(byLine).forEach(c => {
            const l = byLine[c], latest = l.reduce((a, b) => b.start > a.start ? b : a, l[0]);
