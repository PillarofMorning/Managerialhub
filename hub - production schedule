// CLEANING TIMES per line
// ============================================================================
function CleaningView({ rows, assets, assetsByArea, settings, updateSettings, gaps, own, rosterCount, onJump, assetsLoaded }) {
    const [lineKey, setLineKey] = useState(rows.length ? rows[0].key : '');
    const [people, setPeople] = useState('');
    useEffect(() => { if (!lineKey && rows.length) setLineKey(rows[0].key); }, [rows.length]);
    const areaNames = useMemo(() => Object.keys(assetsByArea).sort(), [assetsByArea]);
    const cfg = settings.clean[lineKey] || {};
    const setCfg = (patch) => updateSettings(s => ({ ...s, clean: { ...s.clean, [lineKey]: { ...(s.clean[lineKey] || {}), ...patch } } }));
    const toggleArea = (a) => { const cur = cfg.areas || []; setCfg({ areas: cur.indexOf(a) >= 0 ? cur.filter(x => x !== a) : cur.concat([a]) }); };
    // Typical sanitation crew for the line: the average headcount of its sanitation shifts (or the fallback), changeable here.
    const effDefs = settings.shifts.filter(x => x.group === 'sanitation' && x.lineKey === (own[`${lineKey}|sanitation`] ? lineKey : '*'));
    const resolved = effDefs.map(x => x.heads !== '' && x.heads !== undefined ? Number(x.heads) : (x.crew ? rosterCount(x.crew, 'sanitation') : 0)).filter(h => h > 0);
    const typical = resolved.length ? Math.max(1, Math.round(resolved.reduce((a, b) => a + b, 0) / resolved.length)) : settings.cleanHeads;
    const ctxHeads = people !== '' ? Math.max(1, parseInt(people, 10) || 1) : typical;
    const L = useMemo(() => { const k = splitKey(lineKey); return lineCtxOf({ clean: settings.clean, own: {}, occ: [], assetsByArea, fallbackHeads: settings.cleanHeads }, k.area, k.line); }, [lineKey, settings.clean, assetsByArea, settings.cleanHeads]);
    const needOf = (kind, h, weekly) => { const n = cleanNeed(kind, null, L, weekly); return { mins: needFlatMins(n, h), basis: n.basis, equipCount: n.count, work: n.work, weekly: n.weekly, noDaily: n.noDaily }; };
    const needAt = (h) => ({ base: needOf('full', h, false), alg: needOf('allergen', h, false), week: needOf('full', h, true) });
    const { base, alg, week } = needAt(ctxHeads);
    const nDaily = L.pieces.filter(p => p.daily).length, nWeekly = L.pieces.filter(p => p.weekly && !p.daily).length;
    const mine = gaps.filter(g => g.lineKey === lineKey && g.end >= Date.now() - DAY).sort((a, b) => a.start - b.start).slice(0, 40);
    const th = "px-2 py-1.5 text-left text-[10px] font-black uppercase tracking-wider text-slate-500";
    const areaTotals = (a) => (assetsByArea[a] || []).reduce((n, x) => n + x.baseMins, 0);
    return (
        <div className="grid lg:grid-cols-2 gap-4">
            <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-3">
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Cleaning time for a line</h2>
                <Field label="Line"><select className={inputCls} value={lineKey} onChange={(e) => setLineKey(e.target.value)}>{rows.map(r => <option key={r.key} value={r.key}>{r.label}</option>)}</select></Field>
                <div>
                    <div className="text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">Equipment areas cleaned on this line {assetsLoaded ? '' : '(loading...)'}</div>
                    {areaNames.length === 0 && <p className="text-xs text-slate-500">No equipment was read from the equipment table. The manual minutes below are used instead.</p>}
                    <div className="flex flex-wrap gap-1.5 max-h-40 overflow-y-auto">{areaNames.map(a => <Chip key={a} on={(cfg.areas || []).indexOf(a) >= 0} onClick={() => toggleArea(a)} title={`${(assetsByArea[a] || []).length} equipment, ${fmtMins(areaTotals(a))} of work`}>{a} · {(assetsByArea[a] || []).length}</Chip>)}</div>
                </div>
                <div className="grid grid-cols-2 gap-3">
                    <Field label="Manual clean (min)" hint="Used when no equipment is chosen. Default 60."><input type="number" min="0" className={inputCls} value={cfg.baseMins ?? ''} placeholder="60" onChange={(e) => setCfg({ baseMins: e.target.value })} /></Field>
                    <Field label="Manual allergen clean (min)" hint="Default 480 (the 8 h rule)."><input type="number" min="0" className={inputCls} value={cfg.allergenMins ?? ''} placeholder="480" onChange={(e) => setCfg({ allergenMins: e.target.value })} /></Field>
                    <Field label="Extra after a crumb clean (min)"><input type="number" min="0" className={inputCls} value={cfg.crumbMins ?? ''} placeholder="0" onChange={(e) => setCfg({ crumbMins: e.target.value })} /></Field>
                    <Field label="Product change (min)" hint="A different item with no clean between (production does it). Blank = not timed, never flagged."><input type="number" min="0" className={inputCls} value={cfg.changeMins ?? ''} placeholder="not timed" onChange={(e) => setCfg({ changeMins: e.target.value })} data-testid="change-mins" /></Field>
                    <Field label="Sanitation people if no shift set" hint="Used when the line has no sanitation shift."><input type="number" min="1" className={inputCls} value={settings.cleanHeads} onChange={(e) => updateSettings(s => ({ ...s, cleanHeads: Math.max(1, parseInt(e.target.value, 10) || 1) }))} /></Field>
                </div>
                <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs space-y-1">
                    <div className="flex flex-wrap items-center gap-2">
                        <span className="font-black uppercase tracking-wider text-[10px] text-slate-500">What a changeover needs with</span>
                        <input type="number" min="1" className="w-16 border border-slate-300 rounded px-1.5 py-0.5 text-xs bg-white" value={people} placeholder={String(typical)} onChange={(e) => setPeople(e.target.value)} />
                        <span className="font-black uppercase tracking-wider text-[10px] text-slate-500">sanitation {ctxHeads === 1 ? 'person' : 'people'} {people === '' ? `(this line's usual shift)` : ''}</span>
                    </div>
                    <div>Daily (full) clean: <b>{fmtMins(base.mins)}</b> <span className="text-slate-400">({base.basis}{base.equipCount ? `, ${base.equipCount} equipment, ${fmtMins(base.work || 0)} of work` : ''}{base.noDaily ? ', no piece flagged Daily' : ''})</span></div>
                    {week.weekly > 0 && <div>Longest full clean of the week (with {week.weekly} weekly piece{week.weekly === 1 ? '' : 's'}): <b>{fmtMins(week.mins)}</b></div>}
                    <div>After an allergen run: <b>{fmtMins(alg.mins)}</b></div>
                    <table className="text-[11px] mt-1"><thead><tr className="text-left text-[9px] uppercase tracking-wider text-slate-400"><th className="pr-3">People</th><th className="pr-3">Normal</th><th>After allergen</th></tr></thead>
                        <tbody>{[1, 2, 3, 4, 5, 6].map(h => { const n = needAt(h); return <tr key={h} className={h === ctxHeads ? 'font-black text-[#00468B]' : ''}><td className="pr-3">{h}</td><td className="pr-3">{fmtMins(n.base.mins)}</td><td>{fmtMins(n.alg.mins)}</td></tr>; })}</tbody></table>
                    <p className="text-[10px] text-slate-400">Equipment minutes are crew minutes: elapsed time = total ÷ people, never faster than the slowest single piece (limited by its own crew size).</p>
                    <p className="text-[10px] text-slate-500">{L.flagged ? `The daily clean counts the ${nDaily} piece${nDaily === 1 ? '' : 's'} flagged Daily on the equipment table${nWeekly ? `; the ${nWeekly} Weekly one${nWeekly === 1 ? ' goes' : 's go'} into the longest full clean of each week` : ''}.` : 'None of this line\'s equipment has a cleaning frequency set, so every piece counts in the daily clean.'} Which clean a stop needs: an allergen clean after an allergen run (unless the next run carries the same allergens), the daily (full) clean in the stop of an hour or more that leaves the line the most free time that day (a night stop counts for both days it touches), nothing when the same item runs on, else a product change.</p>
                </div>
            </div>
            <div className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest mb-2">Upcoming stops on this line</h2>
                {mine.length === 0 && <p className="text-sm text-slate-400">No stops loaded for this line. Open the Schedule over the dates you care about.</p>}
                <div className="space-y-1.5 max-h-[520px] overflow-y-auto">
                    {mine.map(g => { const st = GAP_STYLE[g.status] || GAP_STYLE.none; return (
                        <button key={g.prevId + g.nextId} type="button" onClick={() => onJump(g.start)} className="w-full text-left rounded-lg border px-2.5 py-1.5 text-[11px]" style={{ background: st.bg, borderColor: st.border, color: st.text }}>
                            <div className="font-black">{fmtDT(g.start)} → {fmtDT(g.end)} · {CLEAN_KINDS[g.kind].label} · {st.label}</div>
                            <div>{runTitle(g.prev)} → {runTitle(g.next)}</div>
                            <div className="opacity-80">{gapText(g)}</div>
                        </button>); })}
                </div>
            </div>
        </div>
    );
}

// ============================================================================
// CLEAN PLAN tab: the cleans the runs need (the hangups a director should know about first), every allergen and full clean,
// the days the MSS needs a Daily clean, and the publishing to the shared table the other apps read.
// ============================================================================
const CP_HANG = { short: 0, overlap: 1, nocrew: 2, tight: 3 };
function CleanPlanView({ engine, cp, tick, cfgState, auto, setAuto, apiReady, onJump, onOpenCheck, nowMs, active }) {
    const [from, setFrom] = useState(() => cpMondayYmd(Date.now()));
    const [weeks, setWeeks] = useState(2);
    const [data, setData] = useState(null);
    const [loading, setLoading] = useState(false);
    const [err, setErr] = useState('');
    const [moreCleans, setMoreCleans] = useState(false);
    const [confirmUse, setConfirmUse] = useState(false);
    const F = parseYMD(from) ? cpWeekStart(parseYMD(from).getTime(), 0) : cpWeekStart(Date.now(), 0);
    const T = cpWeekStart(F, weeks);
    const epoch = cp.epoch;
    useEffect(() => {
        if (!active) return;
        let alive = true;
        setLoading(true); setErr('');
        const t = setTimeout(async () => {
            try { const b = await engine.preview(F, T); if (!alive) return; if (!b) setErr('The runs could not be read for these weeks. Press Refresh.'); else setData(b); }
            catch (e) { if (alive) setErr(errText(e)); }
            if (alive) setLoading(false);
        }, 250);
        return () => { alive = false; clearTimeout(t); };
    }, [active, F, T, epoch, cfgState, engine]);
    const shiftWeeks = (n) => setFrom(cpAddDaysYmd(getLocalYMD(new Date(F)), 7 * n));
    const wins = data ? data.windows : [];
    const hang = wins.filter(g => CP_HANG[g.status] !== undefined && (g.stopKind === 'last' ? g.start : g.end) >= nowMs - HOUR)
        .sort((a, b) => (CP_HANG[a.status] === 3) - (CP_HANG[b.status] === 3) || a.start - b.start);
    const red = hang.filter(g => g.status !== 'tight'), amber = hang.filter(g => g.status === 'tight');
    const cleans = wins.filter(g => g.kind === 'allergen' || g.kind === 'full' || (g.kind === 'changeover' && g.need.basis !== 'untimed'));
    const count = (k) => wins.filter(g => g.kind === k).length;
    const groups = data ? data.groups : [];
    const days = groups.length ? groups[0].days : [];
    const noneDays = groups.reduce((n, G) => n + G.days.filter(d => d.kind === 'none').length, 0);
    const busy = cp.busy, last = cp.last;
    const tableText = { found: 'Clean Plan table found', missing: 'Clean Plan table not created yet', noaccess: 'No permission to read the Clean Plan table', error: 'The Clean Plan table could not be read', unknown: 'Looking for the Clean Plan table...', preview: 'Preview mode: nothing is written' }[cp.table] || cp.table;
    const tz = browserTz(), plantTz = (cp.shared && cp.shared.tz) || CP_PLANT_TZ, tzOk = tz === plantTz;
    const canPublish = apiReady && cp.table === 'found' && tzOk && cfgState !== 'differ' && !busy;
    const pill = (ok, warn) => `px-2 py-1 rounded-lg border text-[11px] font-bold ${ok ? 'bg-[#DCFCE7] text-[#166534] border-[#16A34A]' : warn ? 'bg-[#FFF6E0] text-slate-800 border-[#FFB81C]' : 'bg-[#FDE8EC] text-[#B00020] border-[#E4002B]'}`;
    const line = (g) => `${g.prev.area} L${g.prev.line}`;
    const card = 'bg-white border border-slate-200 rounded-xl p-4 shadow-sm';
    const h2 = 'text-sm font-black text-[#00468B] uppercase tracking-widest';
    return (
        <div className="space-y-4" data-testid="cleanplan">
            <div className={card}>
                <div className="flex flex-wrap items-center gap-3">
                    <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Clean Plan</h2>
                    <span className={pill(cp.table === 'found', cp.table === 'unknown' || cp.table === 'preview')} data-testid="cp-table">{tableText}</span>
                    <span className={pill(cfgState === 'same', cfgState === 'none')} data-testid="cp-cfg">{cfgState === 'same' ? 'Settings shared' : cfgState === 'differ' ? 'This browser\'s settings differ from the shared ones' : 'Settings not shared yet'}</span>
                    {!tzOk && <span className={pill(false)}>This computer is on {tz || 'an unknown time zone'}; the plant is on {plantTz}</span>}
                </div>
                <p className="text-xs text-slate-600 mt-2">What every line needs cleaned, worked out from the runs: allergen cleans, each line's daily (full) clean, product changes, whether the sanitation crew has the time, and which days the MSS needs a Daily clean. Once published, the MSS calendar, the Ganttly, Shift Start and the Manager hub read it from Dataverse instead of each guessing. It follows the Cleaning Times and Shifts tabs.</p>
                {cp.table === 'missing' && <p className="text-xs text-[#B00020] font-semibold mt-1">Create the Clean Plan table to share it: <button type="button" className="underline" onClick={() => onOpenCheck('columns')}>see what to create</button>. The plan below works without it.</p>}
                {(cp.table === 'noaccess' || cp.table === 'error') && <p className="text-xs text-[#B00020] font-semibold mt-1 break-words">{cp.tableWhy}</p>}
                {cp.reqMissing && cp.reqMissing.length > 0 && <p className="text-xs text-[#B00020] font-semibold mt-1">The Clean Plan table needs {cp.reqMissing.join(', ')}: <button type="button" className="underline" onClick={() => onOpenCheck('columns')}>see what to create</button>, then Check again.</p>}
                <div className="flex flex-wrap items-center gap-2 mt-3">
                    {cfgState !== 'same' && cp.table === 'found' && <Btn kind="yellow" onClick={() => engine.share()} disabled={busy} title="Saves this browser's Cleaning Times and Shifts settings in the Clean Plan table: every page that publishes then uses the same ones">Share these settings</Btn>}
                    {cfgState === 'differ' && (confirmUse
                        ? <><span className="text-xs font-bold">Replace this browser's cleaning and shift settings with the shared ones?</span><Btn onClick={() => { engine.useShared(); setConfirmUse(false); }}>Yes, use the shared ones</Btn><Btn kind="ghost" onClick={() => setConfirmUse(false)}>No</Btn></>
                        : <Btn kind="ghost" onClick={() => setConfirmUse(true)}>Use the shared settings</Btn>)}
                    <Chip on={auto} onClick={() => setAuto(!auto)} title="A few seconds after a run is saved, moved, imported or deleted on this page (and when this tab opens) last week to 8 weeks ahead are published again; only rows that changed are written">Publish by itself</Chip>
                    <Btn onClick={() => engine.publish(F, T)} disabled={!canPublish} title={!canPublish ? 'See the notes above' : 'Write these weeks to the Clean Plan table'}>{cfgState === 'none' && cp.table === 'found' ? 'Share settings and publish these weeks' : 'Publish these weeks'}</Btn>
                    {busy && <Btn kind="danger" onClick={() => engine.stop()}>Stop</Btn>}
                    <Btn kind="ghost" onClick={() => engine.recheck()} disabled={busy}>Check again</Btn>
                </div>
                {busy && cp.progress && (
                    <div className="mt-3" data-testid="cp-progress">
                        <div className="text-xs font-bold text-[#00468B]">{cp.progress.what}{cp.progress.total ? ` (${cp.progress.done} of ${cp.progress.total})` : ''}</div>
                        <div className="h-2 rounded bg-slate-100 mt-1 overflow-hidden"><div className="h-2 bg-[#0072CE]" style={{ width: `${cp.progress.total ? Math.round(100 * cp.progress.done / cp.progress.total) : 10}%` }} /></div>
                    </div>
                )}
                {last && !busy && (
                    <div className={`mt-3 text-xs rounded-lg border px-3 py-2 ${last.errors.length || last.failed ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B00020]' : last.skipped ? 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800' : 'bg-[#F0FDF4] border-[#86EFAC] text-[#166534]'}`} data-testid="cp-last">
                        {last.skipped ? <>Not published ({last.why}): {last.skipped}</>
                            : <>Published {fmtDT(last.at)} ({last.why}): {last.weeks} week{last.weeks === 1 ? '' : 's'} from {fmtDay(last.from)}, {last.created} new, {last.updated} changed, {last.removed} removed, {last.same} unchanged{last.failed ? `, ${last.failed} failed` : ''}{last.stopped ? ', stopped' : ''}.{last.dropped && last.dropped.length ? ` Not stored (column missing): ${last.dropped.join(', ')}.` : ''}</>}
                        {last.errors.length > 0 && <div className="font-semibold break-words">{last.errors[0]}</div>}
                    </div>
                )}
            </div>

            <div className="flex flex-wrap items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 shadow-sm">
                <Btn kind="ghost" onClick={() => shiftWeeks(-weeks)}>{'<'}</Btn>
                <Btn kind="ghost" onClick={() => setFrom(cpMondayYmd(Date.now()))}>This week</Btn>
                <Btn kind="ghost" onClick={() => shiftWeeks(weeks)}>{'>'}</Btn>
                <label className="text-[10px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1">Week of
                    <input type="date" className="border border-slate-300 rounded-lg px-2 py-1 text-xs normal-case font-bold" value={getLocalYMD(new Date(F))} onChange={(e) => { const d = parseYMD(e.target.value); if (d) setFrom(cpMondayYmd(d.getTime())); }} /></label>
                <label className="text-[10px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1">Weeks
                    <select className="border border-slate-300 rounded-lg px-1.5 py-1 text-xs normal-case font-bold" value={weeks} onChange={(e) => setWeeks(Number(e.target.value))}>{[1, 2, 3, 4, 6, 8].map(n => <option key={n} value={n}>{n}</option>)}</select></label>
                <span className="text-sm font-black text-[#00468B] whitespace-nowrap">{fmtDay(F)} to {fmtDay(T - 1)}</span>
                {loading && <span className="text-xs text-slate-500">Working it out...</span>}
                {data && !loading && <span className="text-xs text-slate-500" data-testid="cp-summary">{count('allergen')} allergen clean{count('allergen') === 1 ? '' : 's'} · {count('full')} full clean{count('full') === 1 ? '' : 's'} · {count('changeover')} product change{count('changeover') === 1 ? '' : 's'} · <b className={red.length ? 'text-[#B00020]' : 'text-[#166534]'}>{red.length} hangup{red.length === 1 ? '' : 's'}</b> · {noneDays} line-day{noneDays === 1 ? '' : 's'} with no Daily clean needed</span>}
            </div>
            {err && <div className="px-3 py-2 rounded-lg bg-[#FDE8EC] border border-[#E4002B]/40 text-xs font-bold text-[#B00020]">{err}</div>}
            {data && data.long > 0 && <div className="px-3 py-2 rounded-lg bg-[#FFF6E0] border border-[#FFB81C] text-xs text-slate-800">{data.long} run{data.long === 1 ? ' is' : 's are'} longer than {CP_MAX_RUN_DAYS} days (a mistyped end date?) and left out, as the MSS does. The Run check on Data Check finds them.</div>}

            <div className={card} data-testid="cp-hangups">
                <h3 className={h2}>Hangups for directors</h3>
                <p className="text-[11px] text-slate-500 mb-2">Cleans that do not fit: not enough crew time before the next run, runs that overlap, or no sanitation shift in the stop. Click one to see it on the Schedule.</p>
                {data && !red.length && <p className="text-sm text-[#166534] font-semibold">No hangups in these weeks: every clean fits the time and the crew on shift.</p>}
                <div className="space-y-1.5">
                    {red.concat(amber).map(g => { const st = GAP_STYLE[g.status]; return (
                        <button key={`${g.prevId}|${g.nextId}|${g.stopKind}`} type="button" onClick={() => onJump(g.start)} className="w-full text-left rounded-lg border px-2.5 py-1.5 text-[11px]" style={{ background: st.bg, borderColor: st.border, color: st.text }} data-hang={g.status}>
                            <div className="font-black">{line(g)} · {fmtDT(g.start)}{g.stopKind !== 'last' && g.end > g.start ? ` to ${fmtDT(g.end)}` : g.stopKind === 'overlap' ? ' (the next run starts before this one ends)' : g.stopKind !== 'last' ? ' (no time between the runs)' : ''} · {CLEAN_KINDS[g.kind].label} · {st.label}{g.shortMins > 0 ? ` by ${cpHrs(g.shortMins)}` : ''}</div>
                            <div className="opacity-90">{g.reason}</div>
                        </button>); })}
                </div>
            </div>

            <div className={card} data-testid="cp-cleans">
                <h3 className={h2}>Cleans and downtime</h3>
                <p className="text-[11px] text-slate-500 mb-2">Every allergen clean and daily (full) clean, and the timed product changes: when the line stops, when it starts again, how long the clean takes with the crew on shift.</p>
                {data && !cleans.length && <p className="text-sm text-slate-500">No cleans in these weeks.</p>}
                {cleans.length > 0 && <div className="overflow-x-auto">
                    <table className="w-full text-[11px]">
                        <thead><tr className="text-left text-[10px] uppercase tracking-wider text-slate-400"><th className="pr-3 py-1">Line</th><th className="pr-3">Stops</th><th className="pr-3">Starts again</th><th className="pr-3">Clean</th><th className="pr-3">Takes</th><th className="pr-3">Crew</th><th className="pr-3">Status</th></tr></thead>
                        <tbody>{(moreCleans ? cleans : cleans.slice(0, 150)).map(g => { const st = GAP_STYLE[g.status] || GAP_STYLE.ok; return (
                            <tr key={`${g.prevId}|${g.nextId}|${g.stopKind}`} className="border-t border-slate-100 align-top hover:bg-slate-50 cursor-pointer" onClick={() => onJump(g.start)} title={g.reason}>
                                <td className="pr-3 py-1 font-bold whitespace-nowrap">{line(g)}</td>
                                <td className="pr-3 whitespace-nowrap">{fmtDT(g.start)}</td>
                                <td className="pr-3 whitespace-nowrap">{g.next ? fmtDT(g.end) : g.open === 'unplanned' ? 'not planned yet' : 'no run after it'}</td>
                                <td className="pr-3 whitespace-nowrap">{CLEAN_KINDS[g.kind].label}{g.kind === 'allergen' && g.prev.allergenType ? ` (${g.prev.allergenType})` : ''}</td>
                                <td className="pr-3 whitespace-nowrap">{g.mins > 0 ? cpHrs(g.mins) : ''}</td>
                                <td className="pr-3 whitespace-nowrap">{g.kind === 'changeover' ? 'line crew' : g.assumed ? `${g.heads} assumed` : g.heads ? `${Math.round(g.heads * 10) / 10} on shift` : ''}</td>
                                <td className="pr-3 whitespace-nowrap"><span className="px-1.5 py-0.5 rounded border text-[10px] font-black" style={{ background: st.bg, borderColor: st.border, color: st.text }}>{g.status === 'ok' ? (g.cleanEnd ? `done ${fmtTime(g.cleanEnd)}` : 'ok') : STATUS_WORDS[g.status]}</span></td>
                            </tr>); })}</tbody>
                    </table>
                    {cleans.length > 150 && !moreCleans && <button type="button" className="mt-1 text-xs font-bold text-[#0072CE] underline" onClick={() => setMoreCleans(true)}>Show all {cleans.length}</button>}
                </div>}
            </div>

            <div className={card} data-testid="cp-days">
                <h3 className={h2}>Days the MSS needs a Daily clean</h3>
                <p className="text-[11px] text-slate-500 mb-2">Per MSS area (all its lines together), the same rule as the MSS calendar's line rules: a Daily clean on a day the area had an hour or more without production; one clean for a stretch of idle days in a row (a down weekend too); none on a day it ran with less than an hour free. The MSS reads these days instead of a fixed daily frequency.</p>
                {data && !groups.length && <p className="text-sm text-slate-500">No runs in these weeks.</p>}
                {groups.length > 0 && <div className="overflow-x-auto">
                    <table className="text-[10px] border-separate" style={{ borderSpacing: 2 }}>
                        <thead><tr><th className="text-left pr-2 text-slate-400 font-black uppercase tracking-wider sticky left-0 bg-white">Area</th>{days.map(d => <th key={d.date} className={`px-1 font-bold whitespace-nowrap ${d.dow === 1 ? 'border-l-2 border-slate-300' : ''} ${d.dow === 0 || d.dow === 6 ? 'text-slate-400' : 'text-slate-600'}`}>{DOW[d.dow]} {Number(d.date.slice(8))}</th>)}</tr></thead>
                        <tbody>{groups.map(G => (
                            <tr key={G.key}>
                                <td className="pr-2 font-black text-slate-700 whitespace-nowrap sticky left-0 bg-white">{G.name}</td>
                                {G.days.map(d => { const k = DAY_KINDS[d.kind]; return <td key={d.date} title={`${G.name} ${cpDayText(d.date)}: ${d.reason}`} className={`text-center rounded font-bold px-1 py-1 whitespace-nowrap ${d.dow === 1 ? 'border-l-2 border-slate-300' : ''}`} style={{ background: k.bg, color: k.fg, boxShadow: `inset 0 0 0 1px ${k.border}`, minWidth: 34 }} data-day={d.kind}>{k.short}</td>; })}
                            </tr>))}</tbody>
                    </table>
                </div>}
                <div className="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[10px] text-slate-500">{['due', 'stretch', 'covered', 'none', 'unplanned'].map(k => <span key={k}><i className="inline-block w-3 h-3 rounded-sm align-middle mr-1" style={{ background: DAY_KINDS[k].bg, boxShadow: `inset 0 0 0 1px ${DAY_KINDS[k].border}` }} />{DAY_KINDS[k].label}</span>)}</div>
            </div>
        </div>
    );
}

