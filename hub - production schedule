                gaps.push(g);
                if (g.status === 'overlap') { issueMap[g.nextId] = 'overlap'; issueMap[g.prevId] = 'overlap'; }
            });
        });
        Object.keys(exact).forEach(k => {
            const l = exact[k];
            const hasProd = own[`${k}|production`] || own['*|production'];
            if (hasProd) l.forEach(r => {
                if (isMaint(r)) return;
                const c = coverageFor(gapCtx.occ, k, 'production', r.start, r.end, own);
                if (c.any !== false && c.uncovered > 15 * 60000) uncoveredMap[r.id] = c.uncovered;
            });
        });
        return { gaps, issueMap, uncoveredMap };
    }, [runs, gapCtx, own]);
    const issueList = useMemo(() => {
        const list = [];
        analysis.gaps.forEach(g => {
            if (g.end < view.from || g.start > rangeTo) return;
            if (g.status === 'overlap') list.push({ key: `o${g.prevId}${g.nextId}`, kind: 'overlap', ms: g.next.start, runId: g.nextId, text: `${lineLabelOf(g.prev.area, g.prev.line)}: ${runTitle(g.prev)} and ${runTitle(g.next)} overlap by ${fmtHrs(g.overlapMs)}` });
            else if (g.status === 'short' || g.status === 'nocrew' || g.status === 'tight') list.push({ key: `${g.status[0]}${g.prevId}${g.nextId}`, kind: g.status, ms: g.start, runId: g.nextId, text: `${lineLabelOf(g.prev.area, g.prev.line)}: ${gapText(g)}` });
        });
        runs.forEach(r => { if (analysis.uncoveredMap[r.id] && r.start < rangeTo && r.end > view.from) list.push({ key: `u${r.id}`, kind: 'shift', ms: r.start, runId: r.id, text: `${lineLabelOf(r.area, r.line)}: ${runTitle(r)} has no production shift for ${fmtHrs(analysis.uncoveredMap[r.id])}` }); });
        return list.sort((a, b) => a.ms - b.ms);
    }, [analysis, runs, view.from, rangeTo]);

    // ------------------------------------------------------------------------
    // CLEAN PLAN: the cleans worked out from the runs, written to the shared table craa5_cleanplan for the other apps (see the
    // CLEAN PLAN blocks above). The settings it uses are the shared ones (the config row), so every page publishes the same answer.
    // ------------------------------------------------------------------------
    const cpRef = useRef({ table: 'unknown', tableWhy: '', shared: null, sharedAt: '', busy: false, progress: null, last: null, timer: null, lastStart: 0, pending: [],
        hashCol: true, idsOk: true, missing: {}, reqMissing: [], stop: false, epoch: 0, visitFull: 0, previewCache: {} });
    const [cpTick, setCpTick] = useState(0);
    const cpEmitTimer = useRef(null);
    const cpEmit = (soon) => { if (soon) { if (cpEmitTimer.current) return; cpEmitTimer.current = setTimeout(() => { cpEmitTimer.current = null; setCpTick(n => n + 1); }, 1000); } else setCpTick(n => n + 1); };
    const empRef = useRef(employees); empRef.current = employees;
    const assetsByAreaRef = useRef(assetsByArea); assetsByAreaRef.current = assetsByArea;
    const cpReadyRef = useRef(false); cpReadyRef.current = assetsLoaded && !issues.assets && empLoaded && !issues.emp;
    const cpLs = () => lsRead(LS_CP, {});
    const cpLsSet = (patch) => lsWrite(LS_CP, { ...cpLs(), ...patch });
    const cpAuto = settings.cpAuto !== false;
    const cpCfgLocal = cpCfgOf(settings);
    const cpCfgState = !cpRef.current.shared ? 'none' : cpCfgSig(cpRef.current.shared) === cpCfgSig(cpCfgLocal) ? 'same' : 'differ';
    const cpRead = async (filter, select, orderby, top) => {
        const errs = [];
        const rows = await queryRecords(TABLE_CLEAN, dataApiRef.current, { filter, select, orderby, top: top || RANGE_LIMIT, quiet: true, errs });
