                const ns = snapMs(run.start + delta, free), ms1 = magnet(ns), me = magnet(ns + dur);
                s = Math.abs(ms1 - ns) <= Math.abs(me - (ns + dur)) && ms1 !== ns ? ms1 : (me !== ns + dur ? me - dur : ns);
                en = s + dur;
            } else if (d.mode === 'start') {
                s = Math.min(magnet(snapMs(run.start + delta, free)), run.end - 15 * 60000);
            } else {
                en = Math.max(magnet(snapMs(run.end + delta, free)), run.start + 15 * 60000);
            }
            const tgt = { start: s, end: en, area: kr.area, line: kr.line };
            d.tgt = tgt;
            const plan = planPlacement(run, tgt, byLineRef.current[key] || [], settingsRef.current.push);
            setGhost({ id: run.id, rowKey: key, originKey: d.rowKey, start: s, end: en, mode: plan.mode, error: plan.error, pushed: plan.pushed });
        };
        const finish = (ev) => {
            window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', finish); window.removeEventListener('pointercancel', finish); window.removeEventListener('keydown', onKey);
