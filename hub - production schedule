// ============================================================================
// STANDARDIZER ENGINE & PANEL:
//   1. Loads all similar runs (from active schedule + full Dataverse audit pool)
//   2. Assigns main attributes from Equipment Assets (craa5_aa_assets) including
//      canonical line/area name (e.g. "Waterjet Line 1" -> "WJ"), Line #, Area GUID,
//      Equipment Clean/Allergen Minutes, and SAP Codes
//   3. Purges "0-run" ghost lines (such as "Waterjet Line 1" with 0 runs in
//      lineMap, extraLines, lineOrder, or duplicate MSS Area rows)
//   4. Resolves email/import mishaps (missing SKU code, abbreviated product name,
//      missing allergen tags, or 0-case runs) using Similar Run Clusters + SKU Master
// ============================================================================
function buildStandardizerAnalysis(arg0, argAssetList, argMssIdx, argSkuByCode, argSettings) {
    const opts = Array.isArray(arg0)
        ? { runs: arg0, auditRuns: [], assetList: argAssetList, effectiveAreas: [], mssIdx: argMssIdx, skuByCode: argSkuByCode, settings: argSettings }
        : (arg0 || {});
    const { runs, auditRuns, assetList, effectiveAreas, mssIdx, skuByCode, settings } = opts;
    // 1. Merge loaded schedule runs + audit runs into one deduplicated pool
    const runMap = {};
    (runs || []).forEach(r => { if (r && r.id) runMap[r.id] = r; });
    (auditRuns || []).forEach(r => { if (r && r.id && !runMap[r.id]) runMap[r.id] = r; });
    const allRuns = Object.keys(runMap).map(id => runMap[id]).sort(byStart);

    // 2. Build authoritative Equipment Asset Profiles from craa5_aa_assets (assetList)
    const assetByFam = {}, assetProfiles = [];
    (assetList || []).forEach(a => {
        const rawArea = String(a.area || '').trim();
        if (!rawArea || STATUS_AREAS.indexOf(rawArea.toLowerCase()) >= 0) return;
        const parsed = parseAreaAndLine(rawArea, 1);
        const fam = canonPlantFamily(rawArea, 1);
        if (!fam) return;
        const mssIt = (mssIdx && ((mssIdx.byFamily && mssIdx.byFamily[fam]) || mssIdx.byCanon[canon(rawArea)] || mssIdx.byName[rawArea])) || null;
        if (mssIt && !mssIt.line && !mssIt.isSupporting) return;
        if (!mssIt && NON_PRODUCT_AREA_RE.test(rawArea)) return;
        if (!assetByFam[fam]) {
            // Prefer the clean Equipment Asset area name (without redundant "Line 1" suffix)
            const cleanAssetName = parsed.hadLineSuffix ? parsed.baseArea : rawArea;
            const canonicalName = (mssIt && !mssIt.parsedLine.hadLineSuffix && canon(mssIt.name) === canon(cleanAssetName))
                ? mssIt.name
                : (cleanAssetName || (mssIt ? mssIt.name : rawArea));
            const prof = {
                family: fam,
                canonicalName,
                assetAreaName: rawArea,
                mssAreaName: mssIt ? mssIt.name : '',
                areaId: (mssIt && mssIt.id) || a.areaId || '',
                numLines: mssIt ? (Number(mssIt.numLines) || 1) : 1,
                emoji: (mssIt && mssIt.emoji) || defaultEmojiForArea(canonicalName),
                isSupporting: !!(mssIt && mssIt.isSupporting),
                supportingRaw: mssIt ? mssIt.supportingRaw : '',
                equipmentCount: 0,
                equipmentNames: [],
                dailyCleanMins: 0,
                allergenCleanMins: 0,
                totalHeads: 0,
                sapCodes: [],
            };
            assetByFam[fam] = prof;
            assetProfiles.push(prof);
        }
        const p = assetByFam[fam];
        p.equipmentCount++;
        if (a.name && p.equipmentNames.indexOf(a.name) < 0) p.equipmentNames.push(a.name);
        if ((a.mins || 0) > p.dailyCleanMins) p.dailyCleanMins = a.mins || 0;
        if ((a.allergenMins || 0) > p.allergenCleanMins) p.allergenCleanMins = a.allergenMins || 0;
        p.totalHeads += (a.heads || 1);
        if (!p.areaId && a.areaId) p.areaId = a.areaId;
        (a.sapCodes || []).forEach(c => { if (c && p.sapCodes.indexOf(c) < 0) p.sapCodes.push(c); });
    });

    // Also include any primary/supporting MSS production lines that don't have rows in assetList yet
    ((mssIdx && mssIdx.lines) || []).forEach(it => {
        const fam = it.family || canonPlantFamily(it.name, 1);
        if (!fam || assetByFam[fam]) return;
        const prof = {
            family: fam,
            canonicalName: it.assetCanonicalName || (it.parsedLine.hadLineSuffix ? it.parsedLine.baseArea : it.name),
            assetAreaName: it.assetCanonicalName || it.name,
            mssAreaName: it.name,
            areaId: it.id || '',
            numLines: Number(it.numLines) || 1,
            emoji: it.emoji || defaultEmojiForArea(it.name),
            isSupporting: !!it.isSupporting,
            supportingRaw: it.supportingRaw || '',
            equipmentCount: it.assetCount || 0,
            equipmentNames: it.assetNames || [],
            dailyCleanMins: it.assetCleanMins || 0,
            allergenCleanMins: it.assetAllergenMins || 0,
            totalHeads: it.assetHeads || 0,
            sapCodes: [it.assetSapDaily, it.assetSapWeekly].filter(Boolean),
        };
        assetByFam[fam] = prof;
        assetProfiles.push(prof);
    });

    assetProfiles.sort((a, b) => priorityRankForArea(a.canonicalName, mssIdx && mssIdx.byName) - priorityRankForArea(b.canonicalName, mssIdx && mssIdx.byName) || byNatural(a.canonicalName, b.canonicalName));

    // Helper: resolve any raw area + line to its authoritative Equipment Asset Profile
    const resolveToAssetProfile = (rawArea, rawLine) => {
        const parsed = parseAreaAndLine(rawArea, rawLine);
        const fam = canonPlantFamily(rawArea, rawLine);
        const prof = fam ? assetByFam[fam] : null;
        if (prof) {
            const effLine = /^ibl\d+$/.test(fam) ? 1 : clamp(parsed.line || 1, 1, Math.max(1, prof.numLines || 16));
            return {
                matched: true,
                profile: prof,
                canonicalArea: prof.canonicalName,
                canonicalLine: effLine,
                canonicalAreaId: prof.areaId || '',
                hadLineSuffix: parsed.hadLineSuffix,
            };
        }
        const m = mssIdx ? matchMssArea(rawArea, rawLine, mssIdx) : { kind: 'unknown' };
        if (m && m.item) {
            const mFam = m.item.family || canonPlantFamily(m.item.name, 1);
            const mProf = mFam ? assetByFam[mFam] : null;
            const cName = mProf ? mProf.canonicalName : (m.suggest ? m.suggest.area : m.item.name);
            const cLine = m.suggest ? m.suggest.line : (parsed.line || 1);
            return {
                matched: true,
                profile: mProf || null,
                canonicalArea: cName,
                canonicalLine: cLine,
                canonicalAreaId: (mProf && mProf.areaId) || m.item.id || '',
                hadLineSuffix: parsed.hadLineSuffix,
            };
        }
        return {
            matched: false,
            profile: null,
            canonicalArea: parsed.hadLineSuffix ? parsed.baseArea : String(rawArea || '').trim(),
            canonicalLine: parsed.line || 1,
            canonicalAreaId: '',
            hadLineSuffix: parsed.hadLineSuffix,
        };
    };

    // 3. Scan for 0-Run Ghost Lines & Non-Standard Line Aliases across Runs, Areas, lineMap, extraLines, lineOrder
    const lineVariantMap = {};
    const ensureVariant = (areaStr, lineNum, sourceTag) => {
        const a = String(areaStr === undefined || areaStr === null ? '' : areaStr).trim();
        if (!a) return null;
        const ln = Math.max(1, parseInt(lineNum, 10) || 1);
        const k = `${a}|${ln}`;
        if (!lineVariantMap[k]) {
            const res = resolveToAssetProfile(a, ln);
            lineVariantMap[k] = {
                key: k,
                rawArea: a,
                rawLine: ln,
                sources: [],
                runs: [],
                resolved: res,
                targetArea: res.canonicalArea || a,
                targetLine: res.canonicalLine || ln,
                targetAreaId: res.canonicalAreaId || '',
                profile: res.profile || null,
            };
        }
        if (sourceTag && lineVariantMap[k].sources.indexOf(sourceTag) < 0) {
            lineVariantMap[k].sources.push(sourceTag);
        }
        return lineVariantMap[k];
    };

    allRuns.forEach(r => {
        if (!r.area) return;
        const v = ensureVariant(r.area, r.line, 'Schedule Runs');
        if (v) v.runs.push(r);
    });
    (effectiveAreas || []).forEach(a => {
        const n = renderSafe(a.craa5_area || a.craa5_name || a.craa5_areaname).trim();
        if (!n || NON_PRODUCT_AREA_RE.test(n) || STATUS_AREAS.indexOf(n.toLowerCase()) >= 0) return;
        ensureVariant(n, 1, a._fromAssets ? 'Equipment Assets' : 'MSS Areas Table');
    });
    if (settings) {
        Object.keys(settings.lineMap || {}).forEach(k => {
            const c = settings.lineMap[k];
            if (c && c.area) ensureVariant(c.area, c.line || 1, 'Import Line Map');
            const parsedK = parseAreaAndLine(k, 1);
            if (parsedK.hadLineSuffix) ensureVariant(k, 1, 'Import Line Map Key');
        });
        (settings.extraLines || []).forEach(k => {
            const kr = splitKey(k);
            if (kr.area) ensureVariant(kr.area, kr.line, 'Saved Extra Lines');
        });
        (settings.lineOrder || []).forEach(k => {
            const kr = splitKey(k);
            if (kr.area) ensureVariant(kr.area, kr.line, 'Saved Line Order');
        });
    }

    const lineVariants = Object.keys(lineVariantMap).map(k => {
        const v = lineVariantMap[k];
        const parsed = parseAreaAndLine(v.rawArea, v.rawLine);
        const isNameDiff = v.rawArea !== v.targetArea || v.rawLine !== v.targetLine;
        const isZeroRun = v.runs.length === 0;
        const missingAreaIdRuns = v.targetAreaId ? v.runs.filter(r => r.areaId !== v.targetAreaId) : [];
        // A line variant is a 0-run ghost or alias if it has 0 runs AND (its name differs from the canonical Equipment Asset name, or it has "Line N" baked into the area name, or it came from extraLines/lineMap/lineOrder)
        const isZeroRunGhost = isZeroRun && (
            isNameDiff ||
            parsed.hadLineSuffix ||
            v.sources.indexOf('Saved Extra Lines') >= 0 ||
            v.sources.indexOf('Import Line Map') >= 0 ||
            v.sources.indexOf('Import Line Map Key') >= 0
        );
        const needsRunStandardize = v.runs.length > 0 && isNameDiff;
        return {
            ...v,
            hadLineSuffix: parsed.hadLineSuffix,
            isNameDiff,
            isZeroRun,
            isZeroRunGhost,
            needsRunStandardize,
            missingAreaIdCount: missingAreaIdRuns.length,
            actionable: isZeroRunGhost || needsRunStandardize,
        };
    }).sort((a, b) => (b.actionable ? 1 : 0) - (a.actionable ? 1 : 0) || b.runs.length - a.runs.length || byNatural(a.rawArea, b.rawArea));

    const ghostAndAliasLines = lineVariants.filter(v => v.actionable);

    // 4. Group all non-maintenance runs into Similar Run Clusters (by SKU code + fuzzy product similarity)
    const LINE_HEADER_PRODUCT_RE = /^(?:water\s*jet|wj|ibl\s*\d*|high\s*speed|hs|bread(?:ing)?|custard|dough(?:\s*room)?|kettle(?:s)?)\s*(?:[\-_\/]?\s*(?:line|ln)\s*\d+|\d+)?$/i;
    const headerGhostRuns = [];
    const clusterList = [];
    const clusterByCode = {};

    allRuns.forEach(r => {
        if (isMaint(r)) return;
        const prodTrim = String(r.product || '').trim();
        // Detect 0-case / blank-code header ghost runs (e.g. product or area is "Waterjet Line 1" with 0 cases and no SKU code)
        if (r.code === null && (!r.cases || r.cases <= 0) && (!prodTrim || LINE_HEADER_PRODUCT_RE.test(prodTrim))) {
            headerGhostRuns.push(r);
            return;
        }
        if (r.code !== null && r.code !== undefined) {
            const ck = String(r.code);
            if (!clusterByCode[ck]) {
                const cl = { id: `sku_${ck}`, codeKey: Number(r.code), sampleProduct: prodTrim, runs: [] };
                clusterByCode[ck] = cl;
                clusterList.push(cl);
            }
            const cl = clusterByCode[ck];
            cl.runs.push(r);
            if (prodTrim.length > (cl.sampleProduct || '').length) cl.sampleProduct = prodTrim;
        }
    });

    // Attach runs without a SKU code (email mishaps) to the best matching Similar Run Cluster by product description, or form a product cluster
    const uncodedByProd = {};
    allRuns.forEach(r => {
        if (isMaint(r)) return;
        if (headerGhostRuns.indexOf(r) >= 0) return;
        if (r.code !== null && r.code !== undefined) return;
        const prodTrim = String(r.product || '').trim();
        let bestCluster = null, bestSim = 0;
        if (prodTrim) {
            clusterList.forEach(cl => {
                const sim = productSimilarity(prodTrim, cl.sampleProduct);
                if (sim >= 0.68 && sim > bestSim) {
                    bestSim = sim;
                    bestCluster = cl;
                }
            });
        }
        if (bestCluster) {
            bestCluster.runs.push(r);
        } else {
            const pk = canon(prodTrim) || `blank_${r.id}`;
            if (!uncodedByProd[pk]) {
                const cl = { id: `prod_${pk}`, codeKey: null, sampleProduct: prodTrim, runs: [] };
                uncodedByProd[pk] = cl;
                clusterList.push(cl);
            }
            uncodedByProd[pk].runs.push(r);
        }
    });

    // 5. Compute canonical attributes for each Similar Run Cluster from Equipment Assets + SKU Master + Dominant Consensus
    const totalRunFixesMap = {};
    const addRunFixPatch = (runObj, patchObj, reasons) => {
        if (!runObj || !runObj.id || !Object.keys(patchObj).length) return;
        if (!totalRunFixesMap[runObj.id]) {
            totalRunFixesMap[runObj.id] = { id: runObj.id, run: runObj, patch: {}, reasons: [] };
        }
        Object.assign(totalRunFixesMap[runObj.id].patch, patchObj);
        (reasons || []).forEach(rs => {
            if (totalRunFixesMap[runObj.id].reasons.indexOf(rs) < 0) totalRunFixesMap[runObj.id].reasons.push(rs);
        });
    };

    const clusters = clusterList.map(cl => {
        const skuEntry = (cl.codeKey !== null && skuByCode && skuByCode[String(cl.codeKey)]) || null;
        // Count area/line frequencies across runs in this cluster, resolved through Equipment Assets
        const lineVotes = {}, prodVotes = {}, codeVotes = {}, allergenTypeVotes = {};
        let allergenTrueCount = 0, crumbTrueCount = 0;
        const caseRates = [], caseAmounts = [];

        cl.runs.forEach(r => {
            const res = resolveToAssetProfile(r.area, r.line);
            const lk = `${res.canonicalArea}|${res.canonicalLine}`;
            lineVotes[lk] = (lineVotes[lk] || 0) + 1;
            const p = String(r.product || '').trim();
            if (p && !LINE_HEADER_PRODUCT_RE.test(p)) prodVotes[p] = (prodVotes[p] || 0) + 1;
            if (r.code !== null && r.code !== undefined) codeVotes[r.code] = (codeVotes[r.code] || 0) + 1;
            if (r.allergen) {
                allergenTrueCount++;
                const at = String(r.allergenType || '').trim();
                if (at && at.toLowerCase() !== 'none') allergenTypeVotes[at] = (allergenTypeVotes[at] || 0) + 1;
            }
            if (r.crumb) crumbTrueCount++;
            if (r.cases !== null && r.cases !== undefined && r.cases > 0) {
                caseAmounts.push(r.cases);
                const hrs = (r.end - r.start) / HOUR;
                if (hrs > 0.25) caseRates.push(r.cases / hrs);
            }
        });

        // Pick dominant canonical line from Equipment Assets
        let bestLk = '';
        if (skuEntry && skuEntry.defaultArea) {
            const skuRes = resolveToAssetProfile(skuEntry.defaultArea, skuEntry.defaultLine || 1);
            bestLk = `${skuRes.canonicalArea}|${skuRes.canonicalLine}`;
        }
        if (!bestLk) {
            Object.keys(lineVotes).sort((a, b) => lineVotes[b] - lineVotes[a]).forEach(k => { if (!bestLk) bestLk = k; });
        }
        const bestSplit = bestLk ? splitKey(bestLk) : { area: '', line: 1 };
        const assetRes = resolveToAssetProfile(bestSplit.area, bestSplit.line);
        const canonicalArea = assetRes.canonicalArea || bestSplit.area;
        const canonicalLine = assetRes.canonicalLine || bestSplit.line || 1;
        const canonicalAreaId = assetRes.canonicalAreaId || '';
        const assetProfile = assetRes.profile || null;

        // Pick canonical SKU code
        let canonicalCode = cl.codeKey !== null ? cl.codeKey : (skuEntry ? skuEntry.code : null);
        if (canonicalCode === null) {
            const sortedCodes = Object.keys(codeVotes).sort((a, b) => codeVotes[b] - codeVotes[a]);
            if (sortedCodes.length) canonicalCode = Number(sortedCodes[0]);
        }

        // Pick canonical Product Name (prefer SKU Master, else most frequent rich product description)
        let canonicalProduct = (skuEntry && skuEntry.name) ? skuEntry.name : '';
        if (!canonicalProduct) {
            const sortedProds = Object.keys(prodVotes).sort((a, b) => prodVotes[b] - prodVotes[a] || b.length - a.length);
            canonicalProduct = sortedProds[0] || cl.sampleProduct || '';
        }

        // Pick canonical Allergen & Crumb attributes
        const canonicalAllergen = skuEntry ? !!skuEntry.allergen : (allergenTrueCount > 0);
        let canonicalAllergenType = (skuEntry && skuEntry.allergenType) ? skuEntry.allergenType : '';
        if (canonicalAllergen && !canonicalAllergenType) {
            const sortedAt = Object.keys(allergenTypeVotes).sort((a, b) => allergenTypeVotes[b] - allergenTypeVotes[a]);
            canonicalAllergenType = sortedAt[0] || '';
        }
        const canonicalCrumb = skuEntry ? !!skuEntry.crumb : (crumbTrueCount > 0 && crumbTrueCount >= Math.ceil(cl.runs.length / 2));

        // Median cases/hr and median cases for email mishap 0-case runs
        caseRates.sort((a, b) => a - b);
        caseAmounts.sort((a, b) => a - b);
        const medianCasesPerHour = caseRates.length ? Math.round(caseRates[Math.floor(caseRates.length / 2)]) : null;
        const medianCases = caseAmounts.length ? Math.round(caseAmounts[Math.floor(caseAmounts.length / 2)]) : null;

        // Evaluate each run in the cluster against the canonical Equipment Asset + Similar Run attributes
        const runDiffs = [];
        const rawAreasSeen = {};
        cl.runs.forEach(r => {
            if (r.area) rawAreasSeen[`${r.area}${Number(r.line) > 1 ? ' L' + r.line : ''}`] = true;
            const patch = {};
            const reasons = [];
            if (canonicalArea && r.area !== canonicalArea) {
                patch.area = canonicalArea;
                reasons.push(`Area "${r.area || '(blank)'}" to Asset "${canonicalArea}"`);
            }
            if (canonicalLine && (Number(r.line) || 1) !== canonicalLine) {
                patch.line = canonicalLine;
                reasons.push(`Line ${r.line || 1} to Line ${canonicalLine}`);
            }
            if (canonicalAreaId && r.areaId && r.areaId !== canonicalAreaId) {
                patch.areaId = canonicalAreaId;
                if (!patch.area) reasons.push(`Link Asset Area GUID (${canonicalArea})`);
            }
            if (canonicalCode !== null && r.code !== canonicalCode) {
                patch.code = canonicalCode;
                reasons.push(`SKU Code ${r.code === null ? '(blank)' : r.code} to ${canonicalCode}`);
            }
            if (canonicalProduct && String(r.product || '').trim() !== canonicalProduct) {
                patch.product = canonicalProduct;
                reasons.push(`Product "${clipText(r.product || '(blank)', 24)}" to "${clipText(canonicalProduct, 24)}"`);
            }
            if (!!r.allergen !== canonicalAllergen) {
                patch.allergen = canonicalAllergen;
                patch.allergenType = canonicalAllergen ? (canonicalAllergenType || 'Allergen') : '';
                reasons.push(canonicalAllergen ? `Allergen flag ON (${canonicalAllergenType || 'Allergen'})` : 'Allergen flag OFF');
            } else if (canonicalAllergen && canonicalAllergenType && canon(r.allergenType) !== canon(canonicalAllergenType)) {
                patch.allergen = true;
                patch.allergenType = canonicalAllergenType;
                reasons.push(`Allergen type "${r.allergenType || 'None'}" to "${canonicalAllergenType}"`);
            }
            if (!!r.crumb !== canonicalCrumb) {
                patch.crumb = canonicalCrumb;
                reasons.push(canonicalCrumb ? 'Crumb flag ON' : 'Crumb flag OFF');
            }
            // Email mishap check: 0 cases or blank cases when cluster has known rate/cases
            const rHrs = Math.max(0, (r.end - r.start) / HOUR);
            const estCases = (medianCasesPerHour && rHrs > 0) ? Math.round((rHrs * medianCasesPerHour) / 10) * 10 : medianCases;
            if ((r.cases === 0 || (r.cases === null && r.code === null)) && estCases > 0) {
                patch.cases = estCases;
                reasons.push(`0/Blank Cases to ${fmtNum(estCases)} cs (from similar runs rate)`);
            }
            if (Object.keys(patch).length > 0) {
                if (canonicalAreaId && r.areaId !== canonicalAreaId) patch.areaId = canonicalAreaId;
                runDiffs.push({ run: r, patch, reasons });
                addRunFixPatch(r, patch, reasons);
            }
        });

        return {
            id: cl.id,
            runs: cl.runs,
            runDiffs,
            rawAreasList: Object.keys(rawAreasSeen),
            canonicalArea,
            canonicalLine,
            canonicalAreaId,
            assetProfile,
            canonicalCode,
            canonicalProduct,
            canonicalAllergen,
            canonicalAllergenType,
            canonicalCrumb,
            medianCasesPerHour,
            medianCases,
            fromSkuMaster: !!skuEntry,
        };
    }).sort((a, b) => b.runDiffs.length - a.runDiffs.length || b.runs.length - a.runs.length || byNatural(String(a.canonicalCode || ''), String(b.canonicalCode || '')));

    // Also include any lineVariant runs that weren't already in totalRunFixesMap (excluding 0-case header ghost runs which belong in headerGhostRuns)
    lineVariants.forEach(v => {
        if (!v.needsRunStandardize) return;
        v.runs.forEach(r => {
            if (headerGhostRuns.indexOf(r) >= 0) return;
            const patch = {};
            const reasons = [];
            if (v.targetArea && r.area !== v.targetArea) {
                patch.area = v.targetArea;
                reasons.push(`Area "${r.area}" to Equipment Asset "${v.targetArea}"`);
            }
            if (v.targetLine && (Number(r.line) || 1) !== v.targetLine) {
                patch.line = v.targetLine;
                reasons.push(`Line ${r.line || 1} to Line ${v.targetLine}`);
            }
            if (Object.keys(patch).length > 0 && v.targetAreaId && r.areaId !== v.targetAreaId) {
                patch.areaId = v.targetAreaId;
            }
            addRunFixPatch(r, patch, reasons);
        });
    });

    const totalRunFixes = Object.keys(totalRunFixesMap).map(id => totalRunFixesMap[id]);
    const emailMishapRuns = totalRunFixes.filter(f =>
        f.patch.code !== undefined ||
        f.patch.cases !== undefined ||
        !f.run.product ||
        !String(f.run.product).trim() ||
        parseAreaAndLine(f.run.area, f.run.line).hadLineSuffix
    );

    return {
        allRuns,
        assetProfiles,
        assetByFam,
        lineVariants,
        ghostAndAliasLines,
        ghostLines: ghostAndAliasLines,
        clusters,
        mismatchedClusterCount: clusters.filter(c => c.runDiffs.length > 0).length,
        totalRunFixes,
        headerGhostRuns,
        emailMishapRuns,
        totalActionable: ghostAndAliasLines.length + totalRunFixes.length + headerGhostRuns.length,
    };
}

function StandardizerPanel({ stdData, A, startAudit, cancelAudit, fixRuns, deleteRuns, undoFix, openRun, onPurgeGhostLines, onSimulateDemoGhost, apiReady }) {
    const [sec, setSec] = useState('all'); // 'all' | 'lines' | 'clusters' | 'mishaps'
    const [q, setQ] = useState('');
    const [onlyDiff, setOnlyDiff] = useState(false);
    const [expandedCluster, setExpandedCluster] = useState({});
    const [clusterOverrides, setClusterOverrides] = useState({}); // clusterId -> { area, line, product, code, allergen, allergenType, crumb }
    const [customAliasTest, setCustomAliasTest] = useState('Waterjet Line 1');
    const [statusMsg, setStatusMsg] = useState('');

    const running = A && A.status === 'running';
    const fixBusy = !!(A && A.fixing);
    const qLow = q.trim().toLowerCase();

    const filteredGhostAndAliases = useMemo(() => {
        const base = onlyDiff ? stdData.ghostAndAliasLines : stdData.lineVariants;
        if (!qLow) return base;
        return base.filter(v =>
            v.rawArea.toLowerCase().indexOf(qLow) >= 0 ||
            v.targetArea.toLowerCase().indexOf(qLow) >= 0 ||
            v.sources.join(' ').toLowerCase().indexOf(qLow) >= 0
        );
    }, [stdData, onlyDiff, qLow]);

    const filteredClusters = useMemo(() => {
        const base = onlyDiff ? stdData.clusters.filter(c => c.runDiffs.length > 0) : stdData.clusters;
        if (!qLow) return base;
        return base.filter(c =>
            String(c.canonicalCode || '').toLowerCase().indexOf(qLow) >= 0 ||
            String(c.canonicalProduct || '').toLowerCase().indexOf(qLow) >= 0 ||
            String(c.canonicalArea || '').toLowerCase().indexOf(qLow) >= 0 ||
            c.rawAreasList.some(a => a.toLowerCase().indexOf(qLow) >= 0)
        );
    }, [stdData, onlyDiff, qLow]);

    const getClusterTarget = (c) => {
        const ov = clusterOverrides[c.id] || {};
        const targetArea = ov.area !== undefined ? ov.area : c.canonicalArea;
        const targetLine = ov.line !== undefined ? (Math.max(1, parseInt(ov.line, 10) || 1)) : c.canonicalLine;
        const fam = canonPlantFamily(targetArea, targetLine);
        const prof = (fam && stdData.assetByFam[fam]) || c.assetProfile || null;
        return {
            area: targetArea,
            line: targetLine,
            areaId: prof ? prof.areaId : c.canonicalAreaId,
            code: ov.code !== undefined ? (ov.code === '' ? null : Number(ov.code)) : c.canonicalCode,
            product: ov.product !== undefined ? ov.product : c.canonicalProduct,
            allergen: ov.allergen !== undefined ? !!ov.allergen : c.canonicalAllergen,
            allergenType: ov.allergenType !== undefined ? ov.allergenType : c.canonicalAllergenType,
