        <div ref={(el) => api.row(row.key, el)} data-line={row.key} className="flex border-b border-slate-200 hover:bg-slate-50/40" style={{ minHeight: rowH }}>
            <div className="flex-shrink-0 border-r-2 border-slate-300 px-2 py-1 flex flex-col justify-center bg-slate-50 z-20" style={{ width: GANTT_LABEL_W }}>
                <span className="font-bold text-[13px] text-slate-800 leading-tight">{row.label}</span>
