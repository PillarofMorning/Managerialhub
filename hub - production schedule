        employees.forEach(e => { const g = rosterGroup(e, settings.rosterOverrides); if (!e.crew || (g !== 'production' && g !== 'sanitation')) return; const k = `${e.crew}|${g}`; t[k] = (t[k] || 0) + 1; });
