        if (res.rows === null) { C.table = cpClassify(res.err); C.tableWhy = res.err; if (C.table === 'error' && badColumns(res.err, ['craa5_rowtype']).length) C.reqMissing = ['Row Type']; cpEmit(); return; }
        C.table = 'found'; C.tableWhy = '';
        noteKeys('cleanplan', res.rows);
        const row = res.rows.filter(r => String(rv(r, CP_ID) || '').toLowerCase() === cpGuid('config'))[0] || res.rows[0];
        let cfg = null;
        try { cfg = row ? JSON.parse(rv(row, 'craa5_details') || 'null') : null; } catch (e) { cfg = null; }
        C.shared = cfg && typeof cfg === 'object' && !Array.isArray(cfg) ? cfg : null;
        C.sharedAt = row ? String(row.modifiedon || '') : '';
        if (C.shared && cpCfgSig(C.shared) !== cpCfgSig(cpCfgOf(settingsRef.current)) && cpCfgEmpty(cpCfgOf(settingsRef.current))) cpAdopt(C.shared);
        cpEmit();
    };
    useEffect(() => { cpLoadConfig(); }, [apiReady, reloadTick]);
    const cpSleep = (ms) => new Promise(r => setTimeout(r, ms));
    const cpMark = (col, st) => { colStateRef.current.probed[`cleanplan|${col}`] = st; };
    // One row written: a fixed id from its plan key (an existing row with that id is updated instead), a missing optional column left
    // out and named, a busy Dataverse waited for. Returns { id, op } or throws.
    const cpPut = async (w, key, fields, id) => {
        const C = cpRef.current;
