            if (!open) { openList(); return; }
            const step = e.key === 'ArrowDown' ? 1 : total - 1;
            if (total) setHi(h => (h + step) % total);
        } else if (e.key === 'Enter') {
            if (open && total) { e.preventDefault(); pick(Math.min(hi, total - 1)); }
        } else if (e.key === 'Escape') {
            if (open) { e.preventDefault(); e.stopPropagation(); closeList(); }   // closes the list, not the dialog around it
        } else if (e.key === 'Tab') closeList();
    };
    return (
        <div className="relative">
            <input ref={inputRef} role="combobox" aria-expanded={open} aria-controls={idRef.current} aria-autocomplete="list" aria-label={ariaLabel} autoComplete="off" spellCheck={false}
                className={className} value={text} placeholder={placeholder}
                onChange={(e) => { dirtyRef.current = true; setTyped(true); setOpen(true); setHi(0); onText(e.target.value); }}
                onFocus={() => { if (onStart) onStart(); openList(); }} onClick={() => { if (!open) openList(); }} onKeyDown={onKeyDown}
                onBlur={() => { closeList(); if (dirtyRef.current) { dirtyRef.current = false; if (onCommit) onCommit(text); } }} />
            {open && (
                <div id={idRef.current} ref={listRef} role="listbox" onMouseDown={(e) => e.preventDefault()}
                    className={`absolute left-0 right-0 z-[60] max-h-60 overflow-y-auto rounded-lg border border-slate-300 bg-white shadow-xl py-1 text-sm ${up ? 'bottom-full mb-1' : 'mt-1'}`} style={{ minWidth: 190 }}>
                    {total === 0 && <div className="px-3 py-2 text-xs text-slate-400">Nothing in the list yet. Type a name.</div>}
                    {shown.map((o, i) => (
                        <React.Fragment key={o.value}>
                            {o.group && (i === 0 || shown[i - 1].group !== o.group) && <div className="px-3 pt-1.5 pb-0.5 text-[10px] font-black uppercase tracking-wider text-slate-400">{o.group}</div>}
                            <div role="option" aria-selected={i === hi} data-i={i} onClick={() => pick(i)} onMouseMove={() => { if (hi !== i) setHi(i); }}
                                className={`px-3 py-1.5 cursor-pointer flex items-center gap-2 ${i === hi ? 'bg-[#E6F1FB] text-[#00468B]' : 'text-slate-700'}`}>
                                <span className="font-bold truncate">{o.label}</span>
                                {o.note && <span className="ml-auto text-[10px] text-slate-400 whitespace-nowrap">{o.note}</span>}
                            </div>
                        </React.Fragment>
                    ))}
                    {showNew && (
                        <div role="option" aria-selected={hi === shown.length} data-i={shown.length} onClick={() => pick(shown.length)} onMouseMove={() => { if (hi !== shown.length) setHi(shown.length); }}
                            className={`px-3 py-1.5 cursor-pointer border-t border-slate-100 text-xs font-bold ${hi === shown.length ? 'bg-[#FFF6E0] text-slate-800' : 'text-slate-600'}`}>
                            Use "{text.trim()}" {newWord || 'as typed'}
                        </div>
                    )}
                </div>
            )}
        </div>
    );
}
function Modal({ title, onClose, children, wide, footer }) {
    // one listener for the life of the dialog (it used to be taken off and put back on every keystroke); Esc that a pick list
    // already used to close itself is left alone
    const closeRef = useRef(onClose); closeRef.current = onClose;
    useEffect(() => {
        const k = (e) => { if (e.key === 'Escape' && !e.defaultPrevented) closeRef.current(); };
        window.addEventListener('keydown', k);
        return () => window.removeEventListener('keydown', k);
    }, []);
    return (
        <div className="fixed inset-0 z-[100] bg-slate-900/40 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
            <div className={`bg-white rounded-2xl shadow-2xl border border-slate-200 w-full ${wide ? 'max-w-3xl' : 'max-w-xl'} my-6`} style={{ fontFamily: BRAND_FONT }}>
                <div className="flex items-center justify-between px-5 py-3 border-b border-slate-200">
                    <h3 className="text-sm font-black uppercase tracking-widest text-[#00468B]">{title}</h3>
                    <button type="button" onClick={onClose} className="text-slate-400 hover:text-slate-700"><XIcon className="w-5 h-5" /></button>
                </div>
                <div className="p-5">{children}</div>
                {footer && <div className="px-5 py-3 border-t border-slate-200 bg-slate-50 rounded-b-2xl flex items-center gap-2 flex-wrap">{footer}</div>}
            </div>
        </div>
