}

// Reads an Employee row (craa5__aa_employee), filtering out deactivated / "No longer with us" records
function readEmployeeRow(r, deactMap) {
    if (!r) return null;
    const id = String(r.craa5__aa_employeeid || r.craa5_aa_employeeid || r.id || '').toLowerCase().trim();
