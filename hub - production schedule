function RunDialog({ draft: initial, areaOptions, lineChoices, mssNames, recall, gapCtx, allRuns, onSave, onDelete, onSwap, onDuplicate, onClose, busy, canSwap, notesMissing }) {
    const [d, setD] = useState(initial);
    const [confirmDel, setConfirmDel] = useState(false);
    const isNew = !d.id;
    const set = (patch) => setD(p => ({ ...p, ...patch }));
    // A picked or typed line. A name from the list is written the list's way ("ibl 4" becomes IBL4, or IBL on line 4), anything else stays
    // as typed. Another area starts on line 1; the same area as when the box was entered keeps the line number it had.
    const startRef = useRef(null);
    const pickLine = (text) => {
        const r = resolveArea(text, areaOptions), base = startRef.current || { area: d.area, line: d.line };
        const area = r.exact ? r.area : String(text).trim();
        const line = r.exact && r.line > 1 ? String(r.line) : area === base.area ? String(base.line) : '1';
        if (area !== d.area || line !== String(d.line)) set({ area, line });
