}

function ColumnsPanel({ colStatus, probeColumns, probing, resetRefused, apiReady, refusedCols, tablesFound, onRefreshAll }) {
    const [copied, setCopied] = useState('');
    const rowsOf = (t) => t.cols.map(c => ({ c, st: colStatus(t.key, c) }));
    const toCreate = [];
    const untested = [];
    COLUMN_GUIDE.forEach(t => {
        if (t.key !== 'runs') return;
        rowsOf(t).forEach(x => {
            if (x.c.need !== 'optional' || x.st.s === 'found') return;
            (x.st.s === 'missing' ? toCreate : untested).push(x);
        });
    });
    const missing = COLUMN_GUIDE.reduce((n, t) => n + (t.optionalTable && !(tablesFound && tablesFound[t.key]) ? 0 : rowsOf(t).filter(x => x.st.s === 'missing').length), 0);
    const tablesToCreate = COLUMN_GUIDE.filter(t => t.optionalTable && !(tablesFound && tablesFound[t.key]) && !rowsOf(t).some(x => x.st.s === 'found'));
    const tablesWithGaps = COLUMN_GUIDE.filter(t => t.key !== 'runs' && ((tablesFound && tablesFound[t.key]) || rowsOf(t).some(x => x.st.s === 'found')) && rowsOf(t).some(x => x.st.s === 'missing' || (x.c.need === 'optional' && x.st.s !== 'found')));
    const copyTable = async (t, only) => {
        const cols = only || t.cols;
        const txt = (only ? `On the table ${t.table} (${t.displayName || t.title}) create these columns:\n` : `In Dataverse create a table with the display name "${t.displayName || t.title}" (its name will be ${t.table}) and these columns (never use craa5_name as primary column):\n`) + cols.map(c => `- Display name "${c.label || c.name}", type ${c.type} (column name ${c.name}): ${c.why}`).join('\n') + (only || !t.note ? '' : `\n${t.note}`);
