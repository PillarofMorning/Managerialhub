                    const l = Math.max(rangeFrom, g.start), r2 = Math.min(rangeTo, g.end);
                    if (r2 <= l) return null;
                    const st = GAP_STYLE[g.status] || GAP_STYLE.none, w = ((r2 - l) / rangeMs) * trackW;
