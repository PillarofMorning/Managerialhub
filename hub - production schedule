// Automatically finds the asset/MSS areas that belong to a production line (area, line) when not manually overridden.
function autoAreasForLine(area, line, assetsByArea, areaList) {
    const map = assetsByArea || {};
    const keys = Object.keys(map);
    if (!keys.length) return [];
    const cLine = canonLine(area, line);
    const cArea = canon(area);
    if (!cArea) return [];
    const lineDigits = (cLine.match(/\d+/g) || []).join('');
    const areaDigits = (cArea.match(/\d+/g) || []).join('');
    const wantDigits = lineDigits || areaDigits;

    let mssAreaId = '';
    (areaList || []).forEach(a => {
        const ca = canon(a.name);
        if (ca === cLine || (ca === cArea && (!wantDigits || ca.indexOf(wantDigits) > -1 || Number(line) === 1))) {
            if (a.id) mssAreaId = String(a.id).toLowerCase().trim();
        }
    });

    const matched = [];
    keys.forEach(k => {
        const ck = canon(k);
        if (!ck) return;
        const kDigits = (ck.match(/\d+/g) || []).join('');
        // 1. Exact canonical match to line or area (when line number agrees)
        if (ck === cLine || (ck === cArea && (Number(line) === 1 || wantDigits === kDigits))) {
            matched.push(k);
            return;
        }
        // 2. Sub-area prefix match with matching line number (e.g. "IBL4PS" -> "IBL4")
        if (cLine.length >= 2 && ck.indexOf(cLine) === 0 && (!wantDigits || kDigits === wantDigits)) {
            matched.push(k);
            return;
        }
        if (Number(line) === 1 && cArea.length >= 3 && ck.indexOf(cArea) === 0 && (!wantDigits || kDigits === wantDigits)) {
            matched.push(k);
            return;
        }
        // 3. MSS Area Lookup GUID match (when line 1 or digits match)
        const list = map[k] || [];
        if (mssAreaId && (Number(line) === 1 || !wantDigits || kDigits === wantDigits) && list.some(p => p.areaId && p.areaId === mssAreaId)) {
            matched.push(k);
            return;
        }
        // 4. SAP order code match (e.g. SSANIBL4NS / SSANIBL5W)
        const token = cLine.toUpperCase();
        if (token.length >= 3 && (!wantDigits || kDigits === wantDigits) && list.some(p => (p.sapCodes || []).some(sc => sc.indexOf(token) > -1))) {
            matched.push(k);
        }
    });
    return matched.sort(byNatural);
}

// Finds all supporting areas (e.g. Custard, Dough Room, Kettles) and their specific equipment pieces attached to a primary line (area, line),
// along with each supporting area/equipment piece's variable early-clean start offset (minutes before the primary line stops).
function supportingForLine(area, line, assetsByArea, areaList) {
    const map = assetsByArea || {};
    const areaKeys = Object.keys(map);
    const cLine = canonLine(area, line);
    const cArea = canon(area);
    const lineDigits = (cLine.match(/\d+/g) || []).join('') || (cArea.match(/\d+/g) || []).join('');
    const groupsByCanon = {};
    const groupOrder = [];

    const ensureGroup = (supName, supAreaObj, offsetMins) => {
        const sck = canon(supName);
        if (!sck || sck === cLine || sck === cArea) return null;
        if (!groupsByCanon[sck]) {
            groupsByCanon[sck] = {
                area: supName,
                canon: sck,
                areaId: (supAreaObj && supAreaObj.id) || '',
                emoji: (supAreaObj && supAreaObj.emoji) || defaultEmojiForArea(supName),
                offsetMins: Math.max(0, Number(offsetMins) || (CR_EARLY_RE.test(supName) ? CR_EARLY_MINS : 60)),
                pieces: [],
                seenIds: {},
            };
            groupOrder.push(sck);
        }
        return groupsByCanon[sck];
    };

    // 1. Check supporting areas from craa5_aa_mss_area (`areaList`) that declare this primary line in `craa5_supporting`
    (areaList || []).forEach(a => {
        if (!a || !a.isSupporting || !Array.isArray(a.supports)) return;
        const matchSup = a.supports.find(s => doesTargetMatchLine(s.canonKey, area, line));
        if (!matchSup) return;
        const grp = ensureGroup(a.name, a, matchSup.offsetMins);
        if (!grp) return;
        // Find all equipment pieces in this supporting area
        const matchingAssetAreaKeys = areaKeys.filter(k => canon(k) === a.canon);
        const areaPieces = [];
        matchingAssetAreaKeys.forEach(k => (map[k] || []).forEach(p => areaPieces.push(p)));
        const hasLineTaggedPieces = areaPieces.some(p => (p.supportedLines && p.supportedLines.length > 0) || (lineDigits && canon(p.name + ' ' + p.room).indexOf(lineDigits) >= 0));
        areaPieces.forEach(p => {
            const pid = p.id || `${p.area}|${p.name}`;
            if (grp.seenIds[pid]) return;
            const explicitMatch = Array.isArray(p.supportedLines) && p.supportedLines.length > 0
                ? p.supportedLines.some(sl => doesTargetMatchLine(canon(sl), area, line))
                : null;
            if (explicitMatch === false) return; // explicitly attached to a different line
            if (explicitMatch === null && hasLineTaggedPieces && lineDigits) {
                const textDigits = (canon(p.name + ' ' + p.room).match(/\d+/g) || []).join('');
                if (textDigits && textDigits !== lineDigits) return;
            }
            const effOffset = (p.cleanOffsetMins !== null && p.cleanOffsetMins !== undefined) ? p.cleanOffsetMins : grp.offsetMins;
            grp.seenIds[pid] = true;
            grp.pieces.push({
                ...p,
                _isSupportPiece: true,
                _supportArea: grp.area,
                _offsetMins: effOffset,
            });
        });
    });

    // 2. Also check any equipment piece across all areas that explicitly sets `craa5_supportedline` matching this primary line
    areaKeys.forEach(k => {
        (map[k] || []).forEach(p => {
            if (!Array.isArray(p.supportedLines) || !p.supportedLines.length) return;
            if (!p.supportedLines.some(sl => doesTargetMatchLine(canon(sl), area, line))) return;
            const supAreaObj = (areaList || []).find(a => a.canon === canon(p.area));
            const matchSup = supAreaObj && Array.isArray(supAreaObj.supports) ? supAreaObj.supports.find(s => doesTargetMatchLine(s.canonKey, area, line)) : null;
            const defOff = matchSup ? matchSup.offsetMins : 0;   // 0: ensureGroup's default (5 h for dough / silo / sifter, else 1 h)
            const grp = ensureGroup(p.area, supAreaObj, defOff);
            if (!grp) return;
            const pid = p.id || `${p.area}|${p.name}`;
            if (grp.seenIds[pid]) return;
            const effOffset = (p.cleanOffsetMins !== null && p.cleanOffsetMins !== undefined) ? p.cleanOffsetMins : grp.offsetMins;
            grp.seenIds[pid] = true;
            grp.pieces.push({
                ...p,
                _isSupportPiece: true,
                _supportArea: grp.area,
                _offsetMins: effOffset,
            });
        });
    });

    return groupOrder.map(sck => {
        const g = groupsByCanon[sck];
        const maxPieceOffset = g.pieces.reduce((m, p) => Math.max(m, Number(p._offsetMins) || 0), g.offsetMins);
        return {
            area: g.area,
            canon: g.canon,
            areaId: g.areaId,
            emoji: g.emoji,
            offsetMins: g.offsetMins,
            maxOffsetMins: maxPieceOffset,
            pieces: g.pieces,
        };
    });
}

// ============================================================================
// CLEAN PLAN (1 of 2): the day rules, a copy of the MSS calendar's LINE RULES (r14) for one MSS area at a time.
// The MSS ties every plan line to the MSS area of the same name (letters and digits, any case) and judges the equipment of that
// area on the production of ALL lines of that area together. Keep these constants equal to the MSS calendar's LR_* ones and
// DAILY_ON: a test runs both copies on the same runs and they must agree day for day. CP_RULES names them, so a reader can tell.
// ============================================================================
const CP_DOWN_MIN = 60;           // minutes of a day without production that make it a day with downtime (a Daily job falls due)
const CP_RAN_WEEK_MIN = 60;       // minutes of production in a Monday-to-Sunday week that make it a week the line ran
const CP_WEEKEND_RAN_MIN = 720;   // a weekend with less production than this (Saturday and Sunday together) is a down weekend
const CP_IDLE_DAY_MIN = 60;       // a day with less production than this is an idle day; 2+ in a row share one Daily job
const CP_MAX_RUN_DAYS = 31;       // a run longer than this is a mistyped end date: left out
const CP_PAD_WEEKS = 10;          // weeks of runs read at most before and after the weeks published, so a long shutdown is judged whole
const CP_DAILY_ON = [true, true, true, true, true, true, true];   // Sunday to Saturday (the MSS DAILY_ON)
const CP_RULES = 'lr14|D60|W60|WE720|I60|stretch|1111111|pad10|max31|maint|mw72last|scope1';
const cpCollapse = (s) => String(s === undefined || s === null ? '' : s).replace(/\s+/g, ' ').trim();
// The line a run is on, the way the MSS calendar keys it: area (spaces collapsed, any case) and line number (blank = 1)
const cpLineKey = (area, line) => cpCollapse(area).toLowerCase() + '|' + (Number(line) >= 1 ? Math.floor(Number(line)) : 1);
const cpMerge = (iv) => {
    const out = [];
    iv.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]).forEach((x) => {
        const last = out[out.length - 1];
        if (last && x[0] <= last[1]) { if (x[1] > last[1]) last[1] = x[1]; } else out.push([x[0], x[1]]);
    });
    return out;
};
const cpMondayYmd = (ms) => { const d = new Date(ms); return getLocalYMD(new Date(d.getFullYear(), d.getMonth(), d.getDate() - ((d.getDay() + 6) % 7))); };
const cpAddDaysYmd = (ymd, n) => { const d = parseYMD(ymd); return d ? getLocalYMD(new Date(d.getFullYear(), d.getMonth(), d.getDate() + n)) : ''; };
const cpMondayMs = (ms) => parseYMD(cpMondayYmd(ms)).getTime();
// The runs as the day rules use them: per MSS area its production as merged [start, end) pieces (maintenance runs are downtime),
// and every Monday-to-Sunday week (YYYY-MM-DD of its Monday) that has a run on any line. Runs longer than CP_MAX_RUN_DAYS are left out.
//   groups[key] = { key (letters and digits of the area, lower case), name, lines (MSS line keys), iv, areaId }
function cpPlanModel(runs) {
    const groups = {}, order = [], weekHas = {};
    let long = 0, used = 0;
    (runs || []).forEach((r) => {
        if (!r || !cpCollapse(r.area) || !(r.start > 0) || !(r.end > r.start)) return;
        if (r.end - r.start > CP_MAX_RUN_DAYS * DAY) { long += 1; return; }
        used += 1;
        let mon = cpMondayYmd(r.start);
        for (let guard = 0; guard < 8 && mon; guard++) {
            weekHas[mon] = true;
            mon = cpAddDaysYmd(mon, 7);
            if (!mon || parseYMD(mon).getTime() >= r.end) break;
        }
        const key = canon(r.area);
        if (!key) return;
        let G = groups[key];
        if (!G) { G = groups[key] = { key: key, name: cpCollapse(r.area), lines: [], iv: [], areaId: '' }; order.push(key); }
        const lk = cpLineKey(r.area, r.line);
        if (G.lines.indexOf(lk) < 0) G.lines.push(lk);
        if (!G.areaId && r.areaId) G.areaId = r.areaId;
        if (!isMaint(r)) G.iv.push([r.start, r.end]);
    });
    order.forEach((k) => { groups[k].iv = cpMerge(groups[k].iv); groups[k].lines.sort(); });
    order.sort((a, b) => byNatural(groups[a].name, groups[b].name));
    return { groups: groups, order: order, weekHas: weekHas, long: long, used: used };
}
// Days from the Monday `fromYmd` for nWeeks weeks: [{ date, dow, t0 (local midnight ms) }], plus the end of the last day.
function cpDays(fromYmd, nWeeks) {
    const s = parseYMD(fromYmd), days = [], weeks = [];
    if (!s) return { days: days, weeks: weeks, end: 0 };
    for (let i = 0; i < nWeeks * 7; i++) {
        const c = new Date(s.getFullYear(), s.getMonth(), s.getDate() + i);
        days.push({ date: getLocalYMD(c), dow: c.getDay(), t0: c.getTime() });
    }
    for (let w = 0; w < nWeeks; w++) weeks.push({ monday: days[w * 7].date });
    const e = new Date(s.getFullYear(), s.getMonth(), s.getDate() + nWeeks * 7);
    return { days: days, weeks: weeks, end: e.getTime() };
}
// One area's calendar over days/weeks (Monday first, whole weeks), the MSS calendar's buildOne for an area of the plan:
//   prod[i] minutes of production, len[i] minutes in the day (23 or 25 h when the clocks change), planned[w] the week has runs,
//   kind[i] 0 no Daily job / 1 a Daily job of its own / 3 last day of 2+ days in a row that share one Daily / 2 a day that job covers,
//   jobs [{ at, cover: [day indexes], from, to, edge }], weekOn[w] 1 when mid-week and weekly jobs count, together[i] the day shares a job.
function cpLineCalendar(iv, weekHas, cal) {
    const days = cal.days, weeks = cal.weeks, n = days.length;
    const kind = [], weekOn = [], jobs = [], prod = [], planned = [], len = [], idle = [], wkDown = [], together = [];
    if (!n) return { kind: kind, jobs: jobs, weekOn: weekOn, prod: prod, planned: planned, len: len, together: together };
    const t0 = days.map((d) => d.t0).concat([cal.end]);
    for (let i = 0; i < n; i++) len.push((t0[i + 1] - t0[i]) / 60000);
    let j = 0;
    for (let i = 0; i < n; i++) {
        const a = t0[i], b = t0[i + 1];
        while (j < iv.length && iv[j][1] <= a) j++;
        let sum = 0;
        for (let k = j; k < iv.length && iv[k][0] < b; k++) sum += Math.min(b, iv[k][1]) - Math.max(a, iv[k][0]);
        prod.push(sum / 60000);
        kind.push(0); idle.push(false); together.push(false);
    }
    for (let w = 0; w < weeks.length; w++) {
        const base = w * 7, known = !!weekHas[weeks[w].monday];
        planned.push(known);
        if (!known) { weekOn.push(0); wkDown.push(false); continue; }
        let wk = 0;
        for (let d = 0; d < 7; d++) {
            const i = base + d;
            wk += prod[i];
            kind[i] = CP_DAILY_ON[days[i].dow] && len[i] - prod[i] >= CP_DOWN_MIN ? 1 : 0;
            idle[i] = prod[i] < CP_IDLE_DAY_MIN;
        }
        weekOn.push(wk >= CP_RAN_WEEK_MIN ? 1 : 0);
        const down = prod[base + 5] + prod[base + 6] < CP_WEEKEND_RAN_MIN;
        wkDown.push(down && kind[base + 5] === 1 && kind[base + 6] === 1);
    }
    // the days that share one Daily job: a down weekend, and every idle day (two or more in a row make a stretch)
    wkDown.forEach((down, w) => { if (down) { together[w * 7 + 5] = true; together[w * 7 + 6] = true; } });
    for (let i = 0; i < n; i++) if (idle[i] && kind[i] === 1) together[i] = true;
    for (let i = 0; i < n; ) {
        if (!together[i]) { i += 1; continue; }
        let e = i;
        while (e + 1 < n && together[e + 1]) e += 1;
        if (e > i) {
            const cover = [];
            for (let k = i; k <= e; k++) { cover.push(k); kind[k] = k === e ? 3 : 2; }
            jobs.push({ at: e, cover: cover, from: days[i].date, to: days[e].date, edge: i === 0 || e === n - 1 });
        }
        i = e + 1;
    }
    return { kind: kind, jobs: jobs, weekOn: weekOn, prod: prod, planned: planned, len: len, together: together };
}

// ============================================================================
// CLEAN PLAN (2 of 2): the rows the other apps read, in the optional Dataverse table craa5_cleanplan ("Clean Plan").
// ============================================================================
const CP_PLANT_TZ = 'America/Chicago';     // days are plant days: publishing is off in a browser set to another time zone
const CP_AUTO_BACK_WEEKS = 1, CP_AUTO_AHEAD_WEEKS = 8;   // 'Publish by itself' keeps last week to 8 weeks ahead up to date
const CP_MANUAL_MAX_WEEKS = 8;             // weeks one Publish click can cover (each week is its own step with its own stamp)
const CP_READ_BEFORE_DAYS = 8, CP_READ_AFTER_DAYS = 14, CP_EXTEND_DAYS = 14;
const CP_DEBOUNCE_MS = 10000, CP_MIN_GAP_MS = 60000, CP_REFRESH_MS = 12 * HOUR;
const CP_DETAILS_MAX = 1900, CP_REASON_MAX = 2000;
const CP_CONFIG_START = '2000-01-01T00:00:00Z';   // the config row sits far outside every week, so no publish owns it
const CP_CONC = 4;
const CP_RUN_COLS = ['craa5__aa_prd_schdid', 'craa5_area', 'craa5_line', 'craa5_productcode', 'craa5_product', 'craa5_datestarttime', 'craa5_dateendtime', 'craa5_allergen', 'craa5_typeofallergen', 'craa5_crumbclean'];
const DAY_KINDS = {
    due: { label: 'Daily clean due', short: 'Clean', bg: '#E6F1FB', fg: '#00468B', border: '#B3D4F2' },
    stretch: { label: 'One Daily clean for the idle days', short: 'Clean', bg: '#FFF6E0', fg: '#7A5200', border: '#FFB81C' },
    covered: { label: 'Covered by the stretch clean', short: '*', bg: '#FFFBEF', fg: '#B27B00', border: '#FFE2A3' },
    none: { label: 'No Daily clean needed', short: 'None', bg: '#DCFCE7', fg: '#166534', border: '#86EFAC' },
    unplanned: { label: 'Week not planned', short: '?', bg: '#F1F5F9', fg: '#94A3B8', border: '#E2E8F0' },
};
const DAY_KIND_OF = ['none', 'due', 'covered', 'stretch'];

