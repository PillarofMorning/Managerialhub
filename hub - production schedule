    const [result, setResult] = useState(null);      // { message, type, lines, changes, confirmUndo, busy, tick, notStored }
    const applyingRef = useRef(false), cancelRef = useRef(false), mountedRef = useRef(true);
    const barRef = useRef(null);
    // a result (and its Undo / View buttons) must not sit half below the edge of a short canvas
    useEffect(() => { if (result && barRef.current && barRef.current.scrollIntoView) { try { barRef.current.scrollIntoView({ block: 'nearest' }); } catch (e) { /* older engines */ } } }, [result && result.tick]);
    const seqRef = useRef(1), winCache = useRef({}), cacheTick = useRef(0), recallAsked = useRef({});
    const [open, setOpen] = useState({ s1: true, s2: true, s3: true });   // which of the three steps are unfolded
    const [folded, setFolded] = useState({});        // step 3 lines folded away: `${sheet id}|${line key}` -> true
    const [weekOpen, setWeekOpen] = useState({});    // step 3 weeks: sheet id -> true / false (default: open when there is only one week)
    useEffect(() => { mountedRef.current = true; return () => { mountedRef.current = false; }; }, []);

    // ---- the sheets
    const usable = useMemo(() => sheets.filter(sh => sh.parsed && !sh.parsed.error).sort((a, b) => {
        const x = a.parsed.days[0].ymd, y = b.parsed.days[0].ymd;
