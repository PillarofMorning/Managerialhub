                        </div>
                        <div className={`rounded-lg border p-2.5 ${L.rule.midweekHours > 0 ? 'border-[#FCD34D] bg-[#FEF3C7]/60' : 'border-slate-200 bg-slate-50 opacity-60'}`}>
