        if (!failure && apiReady) sent.forEach(c => { st.sent[c] = (st.sent[c] || 0) + 1; });
        const entry = logPayload({ op, table: TABLE_PROD, id: id || (typeof res === 'string' ? res : ''), what: (meta && meta.what) || '', fields: clipFields(body), sent, dropped: failure ? [] : wanted.filter(c => sent.indexOf(c) < 0), ok: !failure, error: failure ? errText(failure) : '', preview: !apiReady });
