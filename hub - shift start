// The shifts archived or saved in the last two weeks, as rows (dated at their shift start): the board of the next shift sees what the shift
// before left unfinished, and the supervisor finder and remembered board see who ran it.
let RECENT_ARCHIVE_ROWS: any[] = [];
let RECENT_ARCHIVES: ShiftBoard[] = [];
async function readRecentArchiveRows(props: any): Promise<any[]> {
    const list = await readArchiveRange(props, Date.now() - 14 * 86400000, Date.now() + 3600000);
    RECENT_ARCHIVES = list;
    RECENT_ARCHIVE_ROWS = [];
    list.forEach(a => { RECENT_ARCHIVE_ROWS.push.apply(RECENT_ARCHIVE_ROWS, boardTaskRows(a, 'archive')); });
    return RECENT_ARCHIVE_ROWS;
}
// Old task rows of a shift that is already in the archive (imported, not yet retired) are left out, so nothing counts twice.
function dropCoveredTaskRows(rows: any[]): any[] {
    const shifts = RECENT_ARCHIVES.concat(LIVE_BOARDS);
    if (!shifts.length) return rows;
    return rows.filter(r => { if (isBoardRow(r)) return true; const t = taskTime(r), team = getField(r, 'craa5_team'); return !shifts.some(s => sameText(s.team, team) && t >= s.slotStart - SHIFT_PREP_MS && t < boardEndOf(s)); });
}
const mergeBoardRows = (rows: any[]) => { const live: any[] = []; LIVE_BOARDS.forEach(b => { if (b.status !== 'archived') live.push.apply(live, boardTaskRows(b)); }); const cutoff = Date.now() - TASK_LOOKBACK_MS; return dropCoveredTaskRows((rows || []).filter(r => !isBoardRow(r))).concat(live.filter(r => (taskTime(r) || Number(r?._slotStart || 0)) >= cutoff), RECENT_ARCHIVE_ROWS.filter(r => (taskTime(r) || Number(r?._slotStart || 0)) >= cutoff)); };

// ============================================================================
// CURRENT SHIFT (craa5_workshift: one row per slot - same rules as Ganttly)
// craa5_shiftcode (A-D), craa5_dayname / craa5_daynumber (1 = Sun), craa5_shiftstarthour / craa5_shiftendhour.
// Midnight is stored as 1, or every hour is stored +1 (1/7/13/19).
// ============================================================================
type Slot = { crew: string; day: number; startHour: number; lengthHours: number };
function parseWorkShiftRows(rows: any[]): Slot[] {
    const read = (r: any, n: string) => getFormattedField(r, n) ?? getField(r, n);
    const raw = rows.map(r => ({ crew: normalizeShift(read(r, 'craa5_shiftcode')), dayName: String(read(r, 'craa5_dayname') || ''), dayNum: parseInt(read(r, 'craa5_daynumber'), 10), startH: parseInt(read(r, 'craa5_shiftstarthour'), 10), endH: parseInt(read(r, 'craa5_shiftendhour'), 10) }));
    const hours: number[] = [];
    raw.forEach(x => { if (!isNaN(x.startH)) hours.push(x.startH); if (!isNaN(x.endH)) hours.push(x.endH); });
    const plusOne = hours.length > 0 && hours.every(h => h >= 1 && (h - 1) % 6 === 0);
    const hasZeroDay = raw.some(x => x.dayNum === 0);
    const fixHour = (h: number) => plusOne ? (h - 1 + 24) % 24 : (h === 1 || h === 24) ? 0 : ((h % 24) + 24) % 24;
    const slots: Slot[] = [], pending: Slot[] = [];
    raw.forEach(x => {
        const m = x.dayName.toLowerCase().match(/sun|mon|tue|wed|thu|fri|sat/);
        let day = m ? ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'].indexOf(m[0]) : (isNaN(x.dayNum) ? -1 : (hasZeroDay ? x.dayNum : x.dayNum - 1));
        if (!x.crew || day < 0 || isNaN(x.startH) || isNaN(x.endH)) return;
        day = ((day % 7) + 7) % 7;
        const sH = fixHour(x.startH), eH = fixHour(x.endH);
        const slot = { crew: x.crew, day, startHour: sH, lengthHours: ((eH - sH + 24) % 24) || 24 };
        (sH < 4 ? pending : slots).push(slot);
    });
    // After-midnight rows belong to the named day or the next one, whichever overlaps the other rows less.
    const hoursOf = (s: Slot) => Array.from({ length: s.lengthHours }, (_, h) => (s.day * 24 + s.startHour + h) % 168);
    pending.forEach(p => {
        const taken = new Set<number>(); slots.forEach(s => hoursOf(s).forEach(h => taken.add(h)));
        const next = { ...p, day: (p.day + 1) % 7 };
        const clash = (s: Slot) => hoursOf(s).filter(h => taken.has(h)).length;
        slots.push(clash(p) < clash(next) ? p : next);
    });
    return slots;
}

// A slot ends at the same wall-clock hour whatever the clocks did in between (a 12 h night is 11 real hours the night clocks go forward).
const slotEndMs = (start: Date, lengthHours: number) => { const e = new Date(start); e.setHours(e.getHours() + lengthHours, 0, 0, 0); return e.getTime(); };
function findCurrentShift(slots: Slot[], now = new Date()): { crew: string; startMs: number; endMs: number } {
    for (const s of slots) {
        for (let back = 0; back <= 1; back++) {
            const d = new Date(now); d.setDate(d.getDate() - back);
            if (d.getDay() !== s.day) continue;
            const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
            const end = slotEndMs(start, s.lengthHours);
            if (now.getTime() >= start.getTime() && now.getTime() < end) return { crew: s.crew, startMs: start.getTime(), endMs: end };
        }
    }
    return { crew: "", startMs: 0, endMs: 0 };
}

// The crew whose shift starts within the next hour (supervisors set up before clock-in), with the time it starts; crew is "" when none does.
function findUpcomingSlot(slots: Slot[], now = new Date()): { crew: string; startMs: number } {
    let crew = "", startMs = 0, soonest = SHIFT_PREP_MS + 1;
    slots.forEach(s => {
        for (let ahead = 0; ahead <= 1; ahead++) {
            const d = new Date(now); d.setDate(d.getDate() + ahead);
            if (d.getDay() !== s.day) continue;
            const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
            const inMs = start.getTime() - now.getTime();
            if (inMs > 0 && inMs <= SHIFT_PREP_MS && inMs < soonest) { crew = s.crew; soonest = inMs; startMs = start.getTime(); }
        }
    });
    return { crew, startMs };
}
const findUpcomingShift = (slots: Slot[], now = new Date()): string => findUpcomingSlot(slots, now).crew;

// The next shift a crew (an employee-table letter) works that has not started yet. skipFirst leaves out the one starting within the hour,
// which is the shift being set up live, so "next" means the one after it.
function nextSlotOf(slots: Slot[], crew: string, now = new Date(), skipFirst = false): { startMs: number; endMs: number } | null {
    const found: { startMs: number; endMs: number }[] = [];
    slots.filter(s => crewLetterOf(s.crew) === crew).forEach(s => {
        for (let ahead = 0; ahead <= 8; ahead++) {
            const d = new Date(now); d.setDate(d.getDate() + ahead);
            if (d.getDay() !== s.day) continue;
            const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
            if (start.getTime() > now.getTime() && !found.some(f => f.startMs === start.getTime())) found.push({ startMs: start.getTime(), endMs: slotEndMs(start, s.lengthHours) });   // a slot listed twice is one shift
        }
    });
    found.sort((a, b) => a.startMs - b.startMs);
    return found[skipFirst ? 1 : 0] || null;
}
const slotLabel = (ms: number) => new Date(ms).toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit' });

// Which board a person opens: a supervisor always opens their own shift layout live by default, no matter who selects,
// so they immediately see their own crew and shift layout upon login (they can still switch to Next shift via the header toggle).
function viewDefaultsFor(sup: any, _slots: Slot[], _rows: any[] = [], _sups: any[] = [], _readOk = true): { crew: string; next: boolean } {
    if (!sup || !isSupervisorLike(sup)) return { crew: "", next: false };
    const own = crewOfPerson(sup);
    return { crew: own, next: false };
}
// The shift a next-shift board is about (null for a live board): the crew's next one, leaving out the one starting within the hour.
function nextSlotForView(crew: string, wantNext: boolean, slots: Slot[]): { startMs: number; endMs: number } | null {
    if (!wantNext || !crew || !slots.length) return null;
    const now = new Date(), cur = findCurrentShift(slots, now), up = findUpcomingSlot(slots, now);
    return nextSlotOf(slots, crew, now, crew !== crewLetterOf(cur.crew) && crew === crewLetterOf(up.crew));
}

// ============================================================================
// DATAVERSE READS - Xrm.WebApi first, then the generative page's dataApi.
// A slow or failed call only falls back for that call; it never switches an API off.
// ============================================================================
async function queryDataApi(dataApi: any, table: string, filter: string, extra: { select?: string[]; orderBy?: string; top?: number } = {}): Promise<any[]> {
    let page: any = await asyncRace(dataApi.queryTable(table, { filter, pageSize: 500, ...extra }), API_TIMEOUT_MS, `queryTable ${table}`);
    if (!Array.isArray(page?.rows)) throw new Error(`queryTable ${table}: no rows`);
    const rows = [...page.rows];
    while (page?.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < 5000) {
        page = await asyncRace(page.loadMoreRows(), API_TIMEOUT_MS, `queryTable ${table}`);
        rows.push(...(Array.isArray(page?.rows) ? page.rows : []));
    }
    return rows;
}

