    // ============================================================================
    // INTERACTION HANDLERS
    // ============================================================================
    const isOvertimeCandidate = useCallback((e: any) => roleOf(e) !== 'supervisor' && getField(e, 'craa5__aa_employeeid') !== selectedSupervisorId && !selectedLeadIds.has(getField(e, 'craa5__aa_employeeid')), [selectedSupervisorId, selectedLeadIds]);

    useEffect(() => {
        const delay = setTimeout(() => {
            if (empSearchText.length < 2) { setSearchSuggestions([]); return; }
