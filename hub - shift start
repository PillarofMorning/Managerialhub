                            <div className="flex items-center gap-1.5" aria-label="Shift selector">
                                {crewLetters.map(l => (
                                    <button key={l} disabled={!isLiveCrew(l) && !crewHasNext(l)} onClick={() => chooseCrew(l)} title={l === clockCrew ? tx(`Shift ${l} is on now`, `El Turno ${l} esta en curso`) : isLiveCrew(l) ? tx(`Shift ${l} (Today / Live)`, `Turno ${l} (Hoy / En Vivo)`) : crewHasNext(l) ? tx(`Shift ${l}: set up its next shift`, `Turno ${l}: planear su proximo turno`) : tx(`Shift ${l} has no shift in the work schedule`, `El Turno ${l} no tiene turno en el horario`)} className={`relative px-2.5 py-1 text-[11px] font-extrabold rounded-lg border ${shownCrew === l ? 'bg-[#0072CE] text-white border-[#0072CE]' : (!isLiveCrew(l) && !crewHasNext(l)) ? 'text-slate-300 border-slate-200' : 'text-slate-600 border-slate-300 hover:bg-[#E6F1FB]'}`}>
                                        {l}{l === clockCrew && <span aria-hidden="true" style={{ position: 'absolute', top: -3, right: -3, width: 8, height: 8, borderRadius: 8, background: BRAND.yellow }} />}
                                    </button>
                                ))}
                                <div className="flex rounded-lg border border-slate-300 overflow-hidden">
                                    <button disabled={!liveOk} onClick={() => chooseMode(false)} title={liveOk ? tx('Today: the shift on now', 'Hoy: el turno actual en vivo') : tx(`Shift ${shownCrew} is not on right now`, `El Turno ${shownCrew} no esta activo ahora`)} className={`px-2.5 py-1 text-[11px] font-extrabold ${boardMode === 'live' ? 'bg-[#0072CE] text-white' : liveOk ? 'text-slate-600 hover:bg-[#E6F1FB]' : 'text-slate-300'}`}>{tx("Live", "En Vivo")}</button>
                                    {peekNext && <button onClick={() => chooseMode(true)} title={tx("Set up the next shift ahead of time", "Planear el siguiente turno por adelantado")} className={`px-2.5 py-1 text-[11px] font-extrabold border-l border-slate-300 ${boardMode === 'next' ? 'bg-[#FFB81C] text-slate-900' : 'text-slate-600 hover:bg-[#FFF6E0]'}`}>{tx("Next shift", "Prox. turno")} - {slotLabel(peekNext.startMs)}</button>}
                                </div>
                            </div>
                            {/* Always-accessible Save button across all steps so personnel and setup never fail to save */}
                            <div className="flex items-center gap-1.5 bg-[#F7F9FC] border border-slate-200 px-2 py-1 rounded-xl">
                                {boardMode === 'live' && currentStep === 4 && (
                                    <Button appearance="secondary" size="small" onClick={() => { logAccessEvent(propsRef.current, 'open_composer', { action: 'update_composer_opened', user: myName, email: myEmail, role: access.role, crew: boardCrew || currentShift, summary: 'Opened Teams Update Composer' }, 2000); handleCopyToClipboard(); }} title={tx("Write the 9-12-3 status message for Teams: pick what it shows, check it, then copy and paste it into Teams", "Escribir el reporte de estatus 9-12-3 para Teams: elige que muestra, revisalo, copialo y pegalo en Teams")}>
                                         {tx("Teams Update", "Reporte para Teams")}
                                    </Button>
                                )}
                                {!access.can && <span title={access.why} className="max-w-[320px] truncate bg-slate-100 border border-slate-300 rounded-lg px-2.5 py-1 text-[11px] text-slate-700 font-semibold">{tx("View only", "Solo lectura")} - {access.why}</span>}
                                <Button appearance="primary" size="small" disabled={!access.can} onClick={() => { handleSubmission(); }} title={tx("Save personnel and shift progress to Dataverse", "Guardar personal y avance del turno en Dataverse")}>
                                    {boardMode === 'next' ? tx('Save Setup', 'Guardar Plan') : tx('Save Progress', 'Guardar Avance')}
                                </Button>
                            </div>
                        </div>
                    </div>
                    {(todayShifts.length > 0 || prevShiftBoards.length > 0) && (
                        <div className="px-4 pb-1.5 flex items-center gap-1.5 overflow-x-auto" aria-label="Today's shifts">
                            <span className="text-[10px] font-extrabold uppercase tracking-[0.06em] text-slate-500 whitespace-nowrap">{tx("Today's shifts", "Turnos de hoy")}</span>
                            {todayShifts.map(c => {
                                const isOpen = c.kind === 'live' && sameText(c.team, getField(activeSupervisorObj, 'craa5_name')) && boardMode === 'live';
                                const tone = c.kind === 'live' ? { background: isOpen ? BRAND.blue : (isDark ? '#172554' : '#E6F1FB'), color: isOpen ? '#FFFFFF' : (isDark ? '#93C5FD' : BRAND.blueDark), borderColor: BRAND.blue } : c.kind === 'plan' ? { background: isDark ? '#422006' : BRAND.yellowSoft, color: isDark ? '#FDE68A' : '#8A5A00', borderColor: BRAND.yellow } : { background: isDark ? '#334155' : '#F1F5F9', color: isDark ? '#CBD5E1' : '#475569', borderColor: isDark ? '#475569' : '#CBD5E1' };
                                const word = c.kind === 'live' ? tx('Live', 'En Vivo') : c.kind === 'plan' ? tx('Plan', 'Plan') : tx('Archived', 'Archivado');
                                const btn = <button key={c.key} type="button" onClick={c.open} title={c.kind === 'live' ? tx('Open this live board', 'Abrir este tablero en vivo') : c.kind === 'plan' ? tx('Open this plan as a next-shift setup', 'Abrir este plan del proximo turno') : tx('View this archived shift (read only)', 'Ver este turno archivado (solo lectura)')} className="px-2 py-0.5 rounded-lg border text-[11px] font-bold whitespace-nowrap" style={c.earlier ? { background: isDark ? '#3B2F12' : BRAND.yellowSoft, color: isDark ? '#FCD34D' : '#8A5A00', borderColor: BRAND.yellow } : tone}>{c.earlier ? tx('Not closed', 'Sin cerrar') : word} - {tx("Shift", "Turno")} {c.crew || '?'} - {formatFullName(c.team) || c.team || tx('No supervisor', 'Sin supervisor')} - {slotLabel(c.slotStart)}</button>;
                                if (!(c.kind === 'live' && c.earlier && c.canClose && c.boards && c.boards.length)) return btn;
                                return (
                                    <span key={c.key} className="inline-flex items-center gap-0.5 whitespace-nowrap">
                                        {btn}
                                        <button type="button" onClick={() => closeOutBoards(c.boards || [])} className="px-1.5 py-0.5 rounded-lg border text-[11px] font-extrabold whitespace-nowrap cursor-pointer"
                                            style={{ background: '#8A5A00', color: '#FFFFFF', borderColor: '#8A5A00' }} title={tx('Archive this earlier shift now', 'Archivar ahora este turno anterior')}>{tx('Close out', 'Cerrar')}</button>
                                    </span>
                                );
                            })}
                            {prevShiftBoards.length > 0 && (
                                <button type="button" onClick={() => setShowPrevShift(v => !v)} className="whitespace-nowrap px-2 py-0.5 rounded-md border text-[11px] font-bold cursor-pointer"
                                    style={{ background: showPrevShift ? '#8A5A00' : (isDark ? '#3B2F12' : BRAND.yellowSoft), color: showPrevShift ? '#FFFFFF' : (isDark ? '#FCD34D' : '#8A5A00'), borderColor: BRAND.yellow }}
                                    title={tx("What the shift before this one finished, what it left, callouts and who was out", "Lo que termino el turno anterior, lo que dejo pendiente, avisos y quien falto")}>
                                    {tx("From last shift", "Del turno anterior")} ({prevShiftBoards.length}) {showPrevShift ? '^' : 'v'}
                                </button>
                            )}
                        </div>
                    )}
                    {showPrevShift && prevShiftBoards.length > 0 && (
                        <div className="px-4 pb-2 grid grid-cols-1 lg:grid-cols-2 gap-2" aria-label="From last shift">
                            {prevShiftBoards.map(pb => {
                                const done = pb.rooms.filter(r => r.done), open = pb.rooms.filter(r => !r.done);
                                return (
                                    <div key={pb.key} className={`rounded-lg border px-2.5 py-1.5 text-[11px] ${isDark ? 'bg-slate-900 border-slate-700 text-slate-200' : 'bg-white border-amber-200 text-slate-700'}`}>
                                        <div className="font-extrabold" style={{ color: isDark ? '#FCD34D' : '#8A5A00' }}>
                                            {tx("Shift", "Turno")} {pb.crew} - {formatFullName(pb.team)} - {slotLabel(pb.slotStart)}{pb.handedOffAt ? ` - ${tx("handed off", "entregado")} ${clockTime(new Date(pb.handedOffAt).getTime())}` : ` - ${tx("not handed off yet", "aun sin entregar")}`}
                                        </div>
                                        {pb.rooms.length === 0 && <div className="text-slate-500">{tx("No rooms were saved on this board.", "Este tablero no guardo cuartos.")}</div>}
                                        {done.length > 0 && <div><b className="text-emerald-700">{tx("Finished", "Terminado")} ({done.length}):</b> {done.map(r => trDv(r.name)).join(', ')}</div>}
                                        {open.length > 0 && (
                                            <div className="flex flex-col gap-0.5 mt-0.5">
                                                <b className="text-amber-800">{tx("Not finished", "Sin terminar")} ({open.length}):</b>
                                                {open.map(r => (
                                                    <div key={r.name} className="pl-2">
                                                        <b>{trDv(r.name)}</b>{r.pct > 0 ? ` (${r.pct}%)` : ''}
                                                        {r.left ? <span> - {tx("left", "falta")}: {trDv(r.left)}</span> : r.status ? <span> - {trDv(r.status)}</span> : null}
                                                        {r.callout ? <span className="text-red-700"> - {tx("callout", "aviso")}: {trDv(r.callout)}</span> : null}
                                                    </div>
                                                ))}
                                            </div>
                                        )}
                                        {pb.rooms.filter(r => r.done && r.callout).map(r => <div key={'c' + r.name}><b className="text-red-700">{tx("Callout", "Aviso")}</b> {trDv(r.name)}: {trDv(r.callout)}</div>)}
                                        {pb.out.length > 0 && <div className="mt-0.5 text-slate-500">{pb.out.join(' - ')}</div>}
                                    </div>
                                );
                            })}
                        </div>
                    )}
                    <ProgressBar value={(currentStep + 1) / steps.length} color={currentStep === steps.length - 1 ? "success" : "brand"} />
                </nav>
            )}

            {showMsIdModal && (
                <div role="dialog" aria-modal="true" aria-label="Microsoft ID Settings" style={{ position: 'fixed', inset: 0, zIndex: 1100, background: 'rgba(15,23,42,0.55)', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 12 }} onClick={() => setShowMsIdModal(false)}>
                    <div className="bg-white shadow-xl border border-slate-200 rounded-2xl w-full max-w-[440px] overflow-hidden" onClick={e => e.stopPropagation()}>
                        <div className="bg-white border-b-4 border-[#FFB81C] px-5 py-3.5 flex items-center justify-between">
                            <div>
                                <h3 className="ss-dark-title text-sm font-black uppercase tracking-wider m-0" style={{ color: BRAND.blueDark }}>
                                    {tx("Microsoft ID & User Identity", "ID de Microsoft e Identidad")}
                                </h3>
                                <p className="text-[11px] text-slate-500 m-0">
                                    {tx("Read from Xrm / Dataverse systemuser or set manually for local preview", "Leido de Xrm / Dataverse systemuser o configurado manualmente")}
                                </p>
                            </div>
                            <Button size="small" appearance="subtle" onClick={() => setShowMsIdModal(false)}>{tx("Close", "Cerrar")}</Button>
                        </div>
                        <div className="p-4 flex flex-col gap-3">
                            <div>
                                <label className="block text-xs font-bold text-slate-700 mb-1">{tx("Display Name", "Nombre Completo")}</label>
                                <Input
                                    size="small"
                                    value={msIdFormName}
                                    onChange={(e: any, d: any) => setMsIdFormName(getInputValue(e, d))}
                                    placeholder={tx("e.g. Jane Doe", "ej. Juan Perez")}
                                    className="w-full"
                                />
                            </div>
                            <div>
                                <label className="block text-xs font-bold text-slate-700 mb-1">{tx("Microsoft ID / Email / UPN", "ID de Microsoft / Correo / UPN")}</label>
                                <Input
                                    size="small"
                                    value={msIdFormEmail}
                                    onChange={(e: any, d: any) => setMsIdFormEmail(getInputValue(e, d))}
                                    placeholder={tx("e.g. user@schwans.com", "ej. usuario@schwans.com")}
                                    className="w-full"
                                />
                            </div>
                            <div className="flex items-center justify-end gap-2 pt-2 border-t border-slate-200">
                                <Button size="small" appearance="secondary" onClick={() => setShowMsIdModal(false)}>{tx("Cancel", "Cancelar")}</Button>
                                <Button
                                    size="small"
                                    appearance="primary"
                                    onClick={() => {
                                        const nextUser = {
                                            name: msIdFormName.trim() || msUser?.name || "User",
                                            email: msIdFormEmail.trim() || msUser?.email || "",
                                            id: msUser?.id || "MANUAL-MS-ID"
                                        };
                                        setMsUser(nextUser);
                                        try { localStorage.setItem('stillwell_active_ms_user_v1', JSON.stringify(nextUser)); } catch (e) {}
                                        const matched = resolveUserIdentity(nextUser, allEmployees);
                                        if (matched) {
                                            hydrateState({ ...GLOBAL_DATA_CACHE, msUser: nextUser, resolvedUser: matched });
                                        } else if (GLOBAL_DATA_CACHE) {
                                            GLOBAL_DATA_CACHE = { ...GLOBAL_DATA_CACHE, msUser: nextUser };
                                        }
                                        setShowMsIdModal(false);
                                    }}
                                >
                                    {tx("Save Microsoft ID", "Guardar ID de Microsoft")}
                                </Button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {showProfileModal && (
                <div role="dialog" aria-modal="true" aria-label="Profile and Roster" style={{ position: 'fixed', inset: 0, zIndex: 1000, background: 'rgba(15,23,42,0.55)', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 12 }}>
                    <div className="bg-white shadow-xl border border-slate-200 rounded-2xl w-full max-w-[440px] overflow-hidden">
                        <div className="bg-white border-b-4 border-[#FFB81C] px-5 py-3.5 flex items-center justify-between">
                            <div>
                                <h3 className="ss-dark-title text-sm font-black uppercase tracking-wider m-0" style={{ color: BRAND.blueDark }}>{tx("Profile & Employee Roster", "Perfil y Lista de Personal")}</h3>
                                <p className="text-[11px] text-slate-500 m-0">{tx("Switch user or mark an employee as no longer with us", "Cambiar de usuario o dar de baja a un empleado")}</p>
                            </div>
                            <Button size="small" appearance="subtle" onClick={() => setShowProfileModal(false)}>{tx("Close", "Cerrar")}</Button>
                        </div>
                        <AuthBox
                            users={allEmployees}
                            onLogin={(u: any) => {
                                const uResolved = withCalculatedRole(u);
                                const uNm = formatFullName(getField(uResolved, 'craa5_name')) || 'User';
                                const uEm = getEmployeeEmail(uResolved) || msUser?.email || uNm;
                                const nextMs = { name: uNm, email: uEm, id: String(getField(uResolved, 'craa5__aa_employeeid') || msUser?.id || '') };
                                setMsUser(nextMs);
                                try { localStorage.setItem('stillwell_active_ms_user_v1', JSON.stringify(nextMs)); } catch (e) {}
                                logAccessEvent(propsRef.current, `switch_profile_${uNm}`, { action: 'profile_switched', user: uNm, email: getEmployeeEmail(uResolved), role: String(uResolved?.calculatedRole || 'user'), crew: crewOfPerson(uResolved) || currentShift || '', summary: `Switched profile to ${uNm}` }, 1500);
                                setShowProfileModal(false);
                                resetBoard();
                                setSelectedSupervisorId(null);
                                setDisableAutoLogin(false);
                                hydrateState({ ...GLOBAL_DATA_CACHE, msUser: nextMs, resolvedUser: uResolved });
                            }}
                            onDeactivateEmployee={handleDeactivateEmployee}
                        />
                    </div>
                </div>
            )}

            {showGuide && <ShiftStartPictureGuide onClose={() => setShowGuide(false)} />}
            {showData && <DataCheckPanel onClose={() => setShowData(false)} hostProps={propsRef.current} msUser={msUser} currentUser={currentUser} slotCount={(GLOBAL_DATA_CACHE?.slots || []).length} currentShift={currentShift} shiftStartMs={shiftStartMs} upNextShift={upNextShift} teams={GLOBAL_DATA_CACHE?.teams || []} teamsRead={GLOBAL_DATA_CACHE?.teamsRead || 0} employees={allEmployees} supervisors={supervisors} taskStatus={taskStatus} areaCount={areas.length} assetCount={(assets || []).length} assetSource={LAST_ASSET_SOURCE} bundleSource={GLOBAL_DATA_CACHE?.bundleSource || LAST_BUNDLE_SOURCE} boardCrew={boardCrew} ownerName={ownerLabel} presets={presets} presetStore={presetStore} presetLog={presetLog} prd={prd.keyOf === prdKey ? prd : PRD_IDLE} prdWindow={prdWindow} hist={histNow} histStatus={histStatus.key === histKey ? histStatus : HIST_IDLE} histNames={histNames} remembered={rememberedLog} onReread={() => { histForce.current = true; setHistReload(n => n + 1); }} onRefreshBackground={handleRefreshBackground} onExportBoardJson={exportBoardJson} onImportBoardJson={importBoardJson} />}
            {composerData && <UpdateComposer data={composerData} hostProps={propsRef.current} meKey={updateKeyOf(msUser) || String(getField(currentUser, 'craa5__aa_employeeid') || 'me')} meName={(msUser && msUser.name) || formatFullName(getField(currentUser, 'craa5_name')) || 'Me'} fullAccess={fullAccess} onClose={() => setComposerData(null)} />}
            {viewerBoard && <ShiftViewer board={viewerBoard} onClose={() => setViewerBoard(null)} />}
            {showBoards && <ShiftBoardsPanel hostProps={propsRef.current} by={String(msUser?.name || 'Full Access')} byEmail={myEmail} slots={GLOBAL_DATA_CACHE?.slots || []} onClose={() => setShowBoards(false)} onChanged={() => { readLiveBoards(propsRef.current).then(() => setPresetRecords(p => mergeBoardRows(p))).catch(() => {}); }} />}
            {archiveNotice && <div role="status" style={{ position: 'fixed', right: 16, bottom: 16, zIndex: 900, maxWidth: 520, padding: '10px 14px', borderRadius: 10, fontSize: 12, fontWeight: 600, boxShadow: '0 8px 24px rgba(0,0,0,0.18)', background: archiveNotice.tone === 'ok' ? (isDark ? '#064E3B' : '#ECFDF5') : (isDark ? '#422006' : BRAND.yellowSoft), color: archiveNotice.tone === 'ok' ? (isDark ? '#A7F3D0' : '#065F46') : (isDark ? '#FDE68A' : '#8A5A00'), border: `1px solid ${archiveNotice.tone === 'ok' ? '#059669' : BRAND.yellow}`, display: 'flex', gap: 10, alignItems: 'flex-start' }}><span style={{ flex: 1 }}>{archiveNotice.text}</span><button type="button" onClick={() => setArchiveNotice(null)} aria-label="Dismiss" style={{ border: 'none', background: 'none', cursor: 'pointer', fontWeight: 800, color: 'inherit' }}>{tx("Dismiss", "Cerrar")}</button></div>}
            <main style={{ flex: 1, minHeight: 0, maxWidth: '100%', overflow: "hidden", display: "flex", flexDirection: "column", position: 'relative' }}> {SC} </main>
        </div>
    </FluentProvider>
);
}

const App = (props: any) => <><MainComponent { ...props } /><ConfirmHost /></>;
export default App;
