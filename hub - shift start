function AreaSelectionScreen({ areas, selectedAreaIds, onSelectChange, onAddCustomArea }: any) {
    const [searchText, setSearchText] = useState("");
    const [customText, setCustomText] = useState("");
    const filtered = areas.filter((a: any) => renderSafe(getField(a, 'craa5_area')).toLowerCase().includes(searchText.toLowerCase()));
    const assignedList = filtered.filter((a: any) => selectedAreaIds.has(getField(a, 'craa5_aa_mss_areaid')));
    const unassignedList = filtered.filter((a: any) => !selectedAreaIds.has(getField(a, 'craa5_aa_mss_areaid')));
    const productionList = unassignedList.filter((a: any) => isProductionArea(a));
    const supportingList = unassignedList.filter((a: any) => !isProductionArea(a));

    const handleDrop = (e: React.DragEvent, assign: boolean) => {
        const areaId = e.dataTransfer?.getData("areaId") || GLOBAL_DRAG_PAYLOAD;
        if (!areaId) return;
        const next = new Set(selectedAreaIds);
        if (assign) next.add(areaId); else next.delete(areaId);
        onSelectChange(next);
        GLOBAL_DRAG_PAYLOAD = null;
    };

    const renderDraggableArea = (a: any) => {
        const aId = getField(a, 'craa5_aa_mss_areaid');
        return (
            <div key={aId} draggable={true} onDragStart={e => { GLOBAL_DRAG_PAYLOAD = aId; if (e.dataTransfer) e.dataTransfer.setData("areaId", aId); }} className="p-3 bg-white border border-slate-200 rounded-lg mb-2 cursor-grab text-sm font-semibold text-slate-700 shadow-sm hover:border-[#0072CE]">
                {renderSafe(getField(a, 'craa5_area'))} {getAreaEmoji(a)}
            </div>
        );
    };

    const column = (title: string, list: any[], assign: boolean, cls: string, titleColor: string, empty: string) => (
        <div onDragOver={(e) => e.preventDefault()} onDrop={(e) => handleDrop(e, assign)} className={`flex-1 rounded-xl border-2 border-dashed p-4 flex flex-col box-border ${cls}`}>
            <Text weight="bold" className="mb-3 uppercase tracking-wider" size={300} style={{ color: titleColor }}>{title} ({list.length})</Text>
            <div className="flex-1 overflow-y-auto pr-1 pb-6">
                {list.map(renderDraggableArea)}
                {list.length === 0 && <Text size={200} color="neutralSecondary" className="italic">{empty}</Text>}
            </div>
        </div>
    );

    return (
        <div className="p-5 h-full flex flex-col box-border">
            <ScreenTitle>Select Active Areas</ScreenTitle>
            <div className="flex justify-between my-4 flex-wrap gap-3">
                <div className="flex gap-2 flex-wrap">
                    <Input placeholder="Filter areas..." value={searchText} onChange={(e: any, d: any) => setSearchText(getInputValue(e, d))} />
                    <Input placeholder="Custom area..." value={customText} onChange={(e: any, d: any) => setCustomText(getInputValue(e, d))} />
                    <Button onClick={() => { if (customText.trim()) onAddCustomArea(customText.trim()); setCustomText(""); }}>Add Custom</Button>
                </div>
                <Button appearance="primary" onClick={() => {
                    const next = new Set(selectedAreaIds);
                    areas.filter((a: any) => !isEverydayArea(a) && isProductionArea(a)).forEach((a: any) => next.add(getField(a, 'craa5_aa_mss_areaid')));
                    onSelectChange(next);
                }}>Auto-Complete Non-Everyday</Button>
            </div>
            <div className="flex gap-5 flex-1 overflow-hidden">
                {column("Supporting Areas", supportingList, false, "bg-slate-50 border-slate-300", "#334155", "No unassigned supporting areas found.")}
                {column("Production Areas", productionList, false, "bg-[#FFF6E0] border-[#FFB81C]", "#8A5A00", "No unassigned production areas found.")}
                {column("Assigned For Today", assignedList, true, "bg-[#E6F1FB] border-[#0072CE]", BRAND.blueDark, "Drag areas here to assign to leads...")}
            </div>
        </div>
    );
}

