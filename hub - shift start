                    try {
                        const bgOwn = supNameRaw ? await readSavedAssignments(propsRef.current, supNameRaw).catch(() => ({ recent: [] as any[] })) : { recent: [] as any[] };
                        const bgOpenMap: Record<string, any> = {};
                        fetchedTasks.concat(bgOwn?.recent || []).forEach((r: any) => {
