// What changed between two versions of a board, in plain words
function diffBoardRows(prev: any[], next: any[], prevAtt?: any[], nextAtt?: any[]): string[] {
    const out: string[] = [];
    const who = (r: any) => keyGuid(r.craa5__aaemp_guid) || keyText(r.craa5_id);
    const people = (rows: any[]) => { const m: Record<string, { name: string; area: string }> = {}; (rows || []).forEach(r => { if (r && r.craa5_id) m[who(r)] = { name: String(r.craa5_id), area: String(r.craa5_area || '') }; }); return m; };
    const areas = (rows: any[]) => { const m: Record<string, any> = {}; (rows || []).forEach(r => { if (r && r.craa5_area && !m[keyText(r.craa5_area)]) m[keyText(r.craa5_area)] = r; }); return m; };
    const pp = people(prev), pn = people(next), ap = areas(prev), an = areas(next);
    Object.keys(pn).forEach(k => {
        const a = pp[k], b = pn[k];
        if (!a) out.push(OUT_AREA_RE.test(b.area) ? `Marked ${b.name} ${b.area}` : `Added ${b.name} to ${b.area}`);
        else if (keyText(a.area) !== keyText(b.area)) out.push(OUT_AREA_RE.test(b.area) ? `Marked ${b.name} ${b.area} (was ${a.area})` : `Moved ${b.name} from ${a.area} to ${b.area}`);
    });
    Object.keys(pp).forEach(k => { if (!pn[k]) out.push(`Removed ${pp[k].name} from ${pp[k].area}`); });
    Object.keys(an).forEach(k => {
        const a = ap[k], b = an[k], nm = String(b.craa5_area);
        if (!a) { if (!OUT_AREA_RE.test(nm)) out.push(`Added area ${nm}${b.craa5_lead ? ` (lead ${b.craa5_lead})` : ''}`); return; }
        if (String(a.craa5_lead || '') !== String(b.craa5_lead || '')) out.push(`${nm} lead: ${a.craa5_lead || 'none'} to ${b.craa5_lead || 'none'}`);
        if (String(a.craa5_whatisbeingdone || '') !== String(b.craa5_whatisbeingdone || '')) out.push(`${nm} status: ${a.craa5_whatisbeingdone || 'none'} to ${b.craa5_whatisbeingdone || 'none'}`);
        if (String(a.craa5_whatislefttodo || '') !== String(b.craa5_whatislefttodo || '')) out.push(`${nm} left to do: ${b.craa5_whatislefttodo || '(cleared)'}`);
        if (!isBoolTrue(a.craa5_complete) && isBoolTrue(b.craa5_complete)) out.push(`${nm} marked done`);
        if (isBoolTrue(a.craa5_complete) && !isBoolTrue(b.craa5_complete)) out.push(`${nm} reopened`);
        if ((Number(a.craa5_percentagecomplete) || 0) !== (Number(b.craa5_percentagecomplete) || 0)) out.push(`${nm} progress: ${Number(a.craa5_percentagecomplete) || 0}% to ${Number(b.craa5_percentagecomplete) || 0}%`);
    });
    Object.keys(ap).forEach(k => { if (!an[k] && !OUT_AREA_RE.test(String(ap[k].craa5_area))) out.push(`Removed area ${ap[k].craa5_area}`); });
    if (!prev || !prev.length) out.unshift(`First save: ${Object.keys(pn).length} people in ${Object.keys(an).length} areas`);
    return out.slice(0, 200);
}

// ---- MSS log (craa5__log_): what an area marked finished tells the MSS calendar ----
// Interim, until Ganttly logs each piece as it is done: only the equipment that belongs to the area's clean is logged.
//   Daily / Everyday / Allergen / Dry clean: pieces marked Daily.  Midweek: Daily or Midweek.  EOW: Daily, Midweek or Weekly.
//   Monthly, quarterly and annual pieces are never logged from here, and a changeover logs nothing.
// The row says which clean was done (EOW = daily + weekly, never monthly). A row without those flags would count for every
// frequency in the MSS calendar, so a row is never sent without them. Data contract 1.0.1 (section 6.3, transition rule):
// the date is the shift date (plant day the shift started, hubShiftDate), the row id is hubLogIdOf(completion key), so a
// second save, a second device or Ganttly later logging the same piece finds the same row instead of adding one.
// Anything that failed is tried again on the next save. SHIFT_START_LOGS_MSS = false switches it off (Ganttly's Done screen takes over).
const SHIFT_START_LOGS_MSS = false;   // off: Ganttly v1.3 logs each piece as it is marked Done. Set true only if this version runs without Ganttly v1.3.
const MSS_LOG_TABLE = 'craa5__log_';
const MSS_LOG_ID = 'craa5__log_id';
type MssAreaJob = { areaId: string; areaName: string; cleanType: string; assets: any[]; cleanedBy: string; totalAreaHrs: number };
function mssCleanScope(cleanType: string): { pieceFreqs: string[]; logFlags: { craa5_daily: boolean; craa5_weekly: boolean; craa5_monthly: boolean }; code: string } | null {
    const raw = String(getCleanTypeMeta(cleanType).rawLabel || '').toLowerCase();
    if (raw.indexOf('change') >= 0) return null;
    if (raw.indexOf('allergen') >= 0) return { pieceFreqs: ['daily'], logFlags: { craa5_daily: true, craa5_weekly: false, craa5_monthly: false }, code: 'allergen' };
    if (raw.indexOf('eow') >= 0) return { pieceFreqs: ['daily', 'midweek', 'weekly'], logFlags: { craa5_daily: true, craa5_weekly: true, craa5_monthly: false }, code: 'eow' };
    if (raw.indexOf('midweek') >= 0) return { pieceFreqs: ['daily', 'midweek'], logFlags: { craa5_daily: true, craa5_weekly: false, craa5_monthly: false }, code: 'midweek' };
    return { pieceFreqs: ['daily'], logFlags: { craa5_daily: true, craa5_weekly: false, craa5_monthly: false }, code: 'daily' };
}
const assetFlag = (a: any, col: string) => isBoolTrue(a?.[col] ?? getField(a, col));
const assetGuidOf = (a: any) => hubGuid(a?.craa5_aa_assetsid || a?.craa5_equipmentguid || getField(a, 'craa5_aa_assetsid') || '');
