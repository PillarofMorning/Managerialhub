type ShiftBoard = {
    v: number; kind?: 'live' | 'plan' | 'archive'; crew: string; team: string; supervisorEmail: string; slotStart: number; slotEnd: number; status: BoardStatus;
    savedAt: string; savedBy: string; saveCount: number; rows: any[]; state?: any;
    supervisor?: { name: string; email: string; id: string };
    attendance?: { status: string; people: { name: string; guid: string }[] }[];
    archivedAt?: string; archivedBy?: string; archiveId?: string; sourceRowIds?: string[]; reopened?: boolean; imported?: boolean; source?: string; sourceBoardId?: string;
    retiredAt?: string; usedAt?: string; usedBy?: string; liveBoardId?: string;
    error?: string; claim?: { id: string; by: string; at: string } | null; log?: { at: string; by: string; what: string }[];
    updates?: BoardUpdates;
    recordId?: string; modifiedOn?: string;
};
type TableState = 'unknown' | 'ok' | 'missing' | 'error';
const TABLE_STATE: Record<string, TableState> = {};
const TABLE_ERROR: Record<string, string> = {};
const TABLE_HAS_UPDATES: Record<string, boolean> = {};
const TABLE_REFUSED_COLS: Record<string, Record<string, boolean>> = { ...(ENDPOINT_META.refusedCols || {}) };
[PLAN_TABLE, ARCHIVE_TABLE, UPDATE_PRESET_TABLE].forEach(t => {
    TABLE_REFUSED_COLS[t] = { ...(TABLE_REFUSED_COLS[t] || {}), craa5_name: true };
    delete TABLE_REFUSED_COLS[t].craa5_title;
});
const TABLE_SNIFFED: Record<string, boolean> = {};
let BOARD_STORE: TableState = 'unknown';
let BOARD_ERROR = '';
let LIVE_BOARDS: ShiftBoard[] = [];   // the shifts on now, as last read or saved here
const setTableState = (table: string, s: TableState, err: string = '') => { TABLE_STATE[table] = s; TABLE_ERROR[table] = err; if (table === BOARD_TABLE) { BOARD_STORE = s; BOARD_ERROR = err; } };
const markColRefused = (table: string, col: string, val: boolean = true) => {
    const cur = { ...(TABLE_REFUSED_COLS[table] || {}) };
    if (val) cur[col] = true; else delete cur[col];
    if (table === PLAN_TABLE || table === ARCHIVE_TABLE || table === UPDATE_PRESET_TABLE) cur.craa5_name = true;
    TABLE_REFUSED_COLS[table] = cur;
    ENDPOINT_META.refusedCols = { ...(ENDPOINT_META.refusedCols || {}), [table]: cur };
    saveEndpointMeta();
};
function extractDvError(e: any): string {
    if (!e) return 'failed';
    if (typeof e === 'string') return e;
    const parts: string[] = [];
    for (const v of [e.message, e.error?.message, e.innerError?.message, e.error?.innererror?.message, e.raw, e.details, e.statusText]) {
        if (v && typeof v === 'string' && !parts.includes(v)) parts.push(v);
    }
    if (parts.length) return parts.join(' - ');
    try { return JSON.stringify(e); } catch (x) { return String(e); }
}
function isColumnError(msg: string, table: string): boolean {
    if (/property|attribute|column|field|0x80040203|0x80041103/i.test(msg)) return true;
    const tLow = String(table || '').toLowerCase();
    const cols = (msg.match(/craa5_[a-z0-9_]+/gi) || []).map(s => s.toLowerCase());
    return cols.some(c => c !== tLow && c !== tLow + 's' && c !== tLow + 'es');
}
function sniffTableCols(table: string, rows: any[]) {
    if (!Array.isArray(rows) || !rows.length) return;
    const keys = new Set<string>();
    rows.forEach(r => Object.keys(r || {}).forEach(k => keys.add(k.toLowerCase())));
    const isNoNameTable = table === PLAN_TABLE || table === ARCHIVE_TABLE || table === UPDATE_PRESET_TABLE;
    if (isNoNameTable) {
        TABLE_SNIFFED[table] = true;
        markColRefused(table, 'craa5_name', true);
        if (keys.has('craa5_title')) markColRefused(table, 'craa5_title', false);
        return;
    }
    if (!keys.has('craa5_title') && (keys.has('craa5_name') || keys.has('craa5_boardjson') || keys.has('craa5_details'))) {
        TABLE_SNIFFED[table] = true;
        markColRefused(table, 'craa5_title', true);
        if (keys.has('craa5_name')) {
            markColRefused(table, 'craa5_name', false);
        } else {
            markColRefused(table, 'craa5_name', true);
        }
    } else if (keys.has('craa5_title') && !keys.has('craa5_name')) {
        TABLE_SNIFFED[table] = true;
        markColRefused(table, 'craa5_name', true);
        markColRefused(table, 'craa5_title', false);
    }
}

const boardName = (b: { crew: string; team: string; slotStart: number }) => `${b.crew || '?'} | ${b.team || '?'} | ${new Date(b.slotStart).toISOString()}`;
const boardLog = (b: ShiftBoard, by: string, what: string): ShiftBoard => ({ ...b, log: (b.log || []).concat([{ at: new Date().toISOString(), by, what }]).slice(-60) });
const boardEndOf = (b: ShiftBoard) => b.slotEnd || (b.slotStart + 12 * 3600000);
const boardIsOverdue = (b: ShiftBoard, now = Date.now()) => boardEndOf(b) + BOARD_ARCHIVE_AFTER_MS <= now;
// Rows that come from the shift tables (never written back as task rows): live boards, archives and plans
const isBoardRow = (r: any) => /^(board|archive|plan):/.test(String(getField(r, 'craa5_taskassignmentid') || ''));
const isLiveBoardRow = (r: any) => String(getField(r, 'craa5_taskassignmentid') || '').indexOf('board:') === 0;
const sleepMs = (ms: number) => new Promise(res => setTimeout(res, ms));
const parseBoardName = (name: string) => { const p = String(name || '').split(' | '); const t = p.length >= 3 ? new Date(p.slice(2).join(' | ')).getTime() : NaN; return { crew: p[0] || '', team: p[1] || '', slotStart: isNaN(t) ? 0 : t }; };

// The columns of a craa5_taskassignment row, from a save payload or from a row read back: everything the app always wrote, plus the
// equipment (GUID and name) and the copies of status / notes other apps read.
function taskRowFields(row: any): any {
    const g = (k: string, alt?: string, alt2?: string) => {
        const v = getField(row, k);
        if (v !== undefined && v !== null && v !== '') return v;
        if (alt) { const v2 = getField(row, alt); if (v2 !== undefined && v2 !== null && v2 !== '') return v2; }
        return alt2 ? getField(row, alt2) : undefined;
    };
    const status = String(g('craa5_whatisbeingdone', 'currentStatus', 'status') || g('craa5__currentstatus') || ''), notes = String(g('craa5_whatislefttodo', 'futureNotes', 'notes') || g('craa5__future_or_notes') || '');
    return {
        craa5_area: String(g('craa5_area', 'area') || ''),
        craa5_lead: String(g('craa5_lead', 'lead') || ''),
        craa5_leademail: String(g('craa5_leademail', 'leadEmail') || ''),
        craa5_supervisoremail: String(g('craa5_supervisoremail', 'supervisorEmail') || ''),
        craa5_shift: String(g('craa5_shift', 'shift', 'crew') || ''),
        craa5_team: String(g('craa5_team', 'team', 'supervisor') || ''),
        craa5_id: String(g('craa5_id', 'empName', 'emp') || ''),
        craa5_email: String(g('craa5_email', 'empEmail') || ''),
        craa5__aaemp_guid: String(g('craa5__aaemp_guid', 'empGuid', 'empId') || ''),
        craa5_badgenumber: String(g('craa5_badgenumber', 'badgeNumber') || ''),
        craa5_starttime: g('craa5_starttime', 'startTime') || null,
        craa5_datetimeofassignment: g('craa5_datetimeofassignment', 'createdon') || null,
        craa5_endtime: g('craa5_endtime', 'endTime') || null,
        craa5_percentagecomplete: Number(g('craa5_percentagecomplete', 'percentage')) || 0,
        craa5_complete: isBoolTrue(g('craa5_complete', 'isComplete')),
        craa5_whatisbeingdone: status,
        craa5_whatislefttodo: notes,
        craa5__currentstatus: status,
        craa5__future_or_notes: notes,
        craa5_subcategory: String(g('craa5_subcategory') || ''),
        craa5_equipment: String(g('craa5_equipment', 'equipment') || ''),
        craa5_equipmentguid: String(g('craa5_equipmentguid', 'equipGuid') || ''),
    };
}

// Ganttly's equipment work laid onto the board's rows: each person's row in an area gets the equipment they cleaned there (GUID and name
// of the newest) and the time their last piece was done (craa5_endtime), unless the row already has them. The whole list is in equipmentDone.
const keyText = (v: any) => String(v ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const keyGuid = (v: any) => String(v ?? '').toLowerCase().replace(/[{}]/g, '').trim();
const OUT_AREA_RE = /\b(pto|sick|late|left early|ncns)\b/i;
function applyBoardUpdates(rows: any[], updates?: BoardUpdates | null): any[] {
    const work = updates && Array.isArray(updates.work) ? updates.work : [];
    if (!work.length) return rows || [];
    const isMe = (r: any, p: { name: string; empId: string }) => { const g = keyGuid(r.craa5__aaemp_guid); return (!!g && keyGuid(p.empId) === g) || (!!r.craa5_id && keyText(p.name) === keyText(r.craa5_id)); };
    return (rows || []).map((r: any) => {
        if (!r || !r.craa5_id || OUT_AREA_RE.test(String(r.craa5_area || ''))) return r;
        const byPerson = work.filter(w => (w.workers || []).some(p => isMe(r, p)));
        if (!byPerson.length) return r;
        let mine = byPerson.filter(w => keyText(w.area) === keyText(r.craa5_area));
        if (!mine.length) {   // the person is in only one room on the board: the work is theirs there
            const theirs = (rows || []).filter((x: any) => x && x.craa5_id && !OUT_AREA_RE.test(String(x.craa5_area || '')) && keyText(x.craa5_id) === keyText(r.craa5_id));
            if (theirs.length === 1) mine = byPerson;
        }
        if (!mine.length) return r;
        const sorted = mine.slice().sort((a, b) => String(a.doneAt || a.startedAt || '').localeCompare(String(b.doneAt || b.startedAt || '')));
        const last = sorted[sorted.length - 1], dones = sorted.map(w => w.doneAt).filter(Boolean) as string[];
        return {
            ...r, craa5_equipmentguid: r.craa5_equipmentguid || last.equipmentGuid || '', craa5_equipment: r.craa5_equipment || last.equipment || '',
            craa5_endtime: r.craa5_endtime || (dones.length ? dones[dones.length - 1] : null),
            equipmentDone: sorted.map(w => ({ guid: w.equipmentGuid, name: w.equipment, startedAt: w.startedAt || null, doneAt: w.doneAt || null })),
        };
    });
}

// A board's rows as craa5_taskassignment rows. Each row is dated inside its own shift (a board set up early, or the second shift of a
// double, never lands in the shift before): live rows at their save time but never before the shift starts, archived rows at the start.
function boardTaskRows(b: ShiftBoard, prefix: 'board' | 'archive' | 'live' = 'board'): any[] {
    if (!b || !Array.isArray(b.rows)) return [];
    const normPrefix = prefix === 'live' ? 'board' : prefix;
    const slot0 = (Number(b.slotStart) || Date.now()) + 60000, saved = new Date(b.savedAt || b.modifiedOn || 0).getTime() || slot0;
    const out: any[] = [];
    applyBoardUpdates(b.rows || [], b.updates).forEach((rawRow: any, i: number) => {
        const r = taskRowFields(rawRow);
        const rt = new Date(r.craa5_datetimeofassignment || 0).getTime() || saved;
        const when = new Date(normPrefix === 'archive' ? slot0 : Math.max(rt, slot0)).toISOString();
        out.push({
            ...r,
            craa5_team: r.craa5_team || b.team || '',
            craa5_shift: r.craa5_shift || b.crew || '',
            craa5_supervisoremail: r.craa5_supervisoremail || b.supervisorEmail || '',
            craa5_taskassignmentid: `${normPrefix}:${b.recordId || 'new'}:${i}`,
            craa5_datetimeofassignment: when,
            createdon: when,
            modifiedon: when,
            statecode: 0,
            _board: normPrefix,
            _slotStart: Number(b.slotStart) || 0,
            _savedAt: saved,
        });
    });
    return out;
}

// ---- Reading and writing the shift tables ----
async function tableQuery(props: any, table: string, filter: string, select: string[], top: number, orderBy: string = 'modifiedon desc'): Promise<any[]> {
    const webApi = getWebApi(props), dataApi = props?.dataApi;
    const noName = table === PLAN_TABLE || table === ARCHIVE_TABLE || table === UPDATE_PRESET_TABLE;
    const knownRefused = TABLE_REFUSED_COLS[table] || {};
    const sel = select.filter(c => !(c === 'craa5_updatesjson' && TABLE_HAS_UPDATES[table] === false) && !(noName && c === 'craa5_name') && !knownRefused[c]);
    let effFilter = filter;
    if (effFilter && knownRefused['craa5_title'] && /\bcraa5_title\b/i.test(effFilter)) {
        if (table === PLAN_TABLE) effFilter = effFilter.replace(/\bcraa5_title\b/gi, 'craa5_shiftplan1');
        else if (table === ARCHIVE_TABLE) effFilter = effFilter.replace(/\bcraa5_title\b/gi, 'craa5_shiftarchive1');
        else if (table === UPDATE_PRESET_TABLE) effFilter = effFilter.replace(/\bcraa5_title\b/gi, 'craa5_updatepreset1');
        else if (!knownRefused['craa5_name']) effFilter = effFilter.replace(/\bcraa5_title\b/gi, 'craa5_name');
    }
    let lastErr: any = null;
    if (webApi?.retrieveMultipleRecords) {
        try {
            const res: any = await asyncRace(webApi.retrieveMultipleRecords(table, `?${sel.length ? `$select=${sel.join(',')}&` : ''}${effFilter ? `$filter=${effFilter}&` : ''}$orderby=${orderBy}&$top=${top}`), API_TIMEOUT_MS, table);
            if (Array.isArray(res?.entities)) {
                if (sel.length === 0) sniffTableCols(table, res.entities);
                if (TABLE_STATE[table] !== 'ok') setTableState(table, 'ok');
                return res.entities;
            }
        } catch (e: any) {
            if (effFilter) {
                try {
                    const resEnc: any = await asyncRace(webApi.retrieveMultipleRecords(table, `?${sel.length ? `$select=${sel.join(',')}&` : ''}$filter=${encodeURIComponent(effFilter)}&$orderby=${orderBy}&$top=${top}`), API_TIMEOUT_MS, table);
                    if (Array.isArray(resEnc?.entities)) {
                        if (sel.length === 0) sniffTableCols(table, resEnc.entities);
                        if (TABLE_STATE[table] !== 'ok') setTableState(table, 'ok');
                        return resEnc.entities;
                    }
                } catch (eEnc: any) { lastErr = eEnc; }
            }
            if (!lastErr) lastErr = e;
        }
    }
    if (dataApi?.queryTable) {
        try {
            const rows = await queryDataApi(dataApi, table, effFilter, sel.length ? { select: sel, orderBy, top } : { orderBy, top });
            if (sel.length === 0) sniffTableCols(table, rows);
            if (TABLE_STATE[table] !== 'ok') setTableState(table, 'ok');
            return rows;
        } catch (e: any) { lastErr = e; }
    }
    const msg = extractDvError(lastErr);
    if (sel.indexOf('craa5_updatesjson') >= 0 && /craa5_updatesjson/i.test(msg)) { TABLE_HAS_UPDATES[table] = false; return tableQuery(props, table, filter, select, top, orderBy); }
