        try {
            let rid = id || '';
            if (rid) await asyncRace(api.update(table, rid, d), API_TIMEOUT_MS, `${table} save`);
            else { const res: any = await asyncRace(api.create(table, d), API_TIMEOUT_MS, `${table} create`); rid = String(typeof res === 'string' ? res : (res?.id || res?.[table + 'id'] || res?.rowId || '')).replace(/[{}]/g, ''); }
            setTableState(table, 'ok');
            return { ok: true, id: rid, error: '', refused };
        } catch (e: any) {
            const msg = extractDvError(e);
            const matches = (msg.match(/craa5_[a-z0-9_]+/gi) || []).map(s => s.toLowerCase());
            const bad = matches.find(n => n in d && n !== 'craa5_boardjson' && n !== 'craa5_details' && (cols.some(c => c.name === n) || n === 'craa5_title' || n === 'craa5_name' || n === 'craa5_shiftplan1' || n === 'craa5_shiftarchive1' || n === 'craa5_updatepreset1' || n === 'statecode' || n === 'statuscode'));
            if (bad) {
                if (bad === 'craa5_updatesjson') TABLE_HAS_UPDATES[table] = false;
                markColRefused(table, bad, true);
                if (bad === 'craa5_title' && !noName && !TABLE_REFUSED_COLS[table]?.['craa5_name'] && !('craa5_name' in d)) {
                    d.craa5_name = d.craa5_title;
                } else if (bad === 'craa5_name' && !TABLE_REFUSED_COLS[table]?.['craa5_title'] && !('craa5_title' in d) && origTitle !== undefined) {
                    d.craa5_title = origTitle;
                } else if (bad !== 'craa5_title' && bad !== 'craa5_name' && bad !== 'craa5_shiftplan1' && bad !== 'craa5_shiftarchive1' && bad !== 'craa5_updatepreset1') {
                    refused.push(bad);
                }
                delete d[bad];
                if (noName) delete d.craa5_name;
                continue;
            }
            if ('craa5_title' in d) {
                markColRefused(table, 'craa5_title', true);
                if (!noName && !TABLE_REFUSED_COLS[table]?.['craa5_name'] && !('craa5_name' in d)) d.craa5_name = d.craa5_title;
                delete d.craa5_title;
                continue;
            }
            if ('craa5_name' in d) {
                markColRefused(table, 'craa5_name', true);
                delete d.craa5_name;
                continue;
            }
            if (/statuscode/i.test(msg) && 'statuscode' in d) { delete d.statuscode; continue; }
            const optKeys = Object.keys(d).filter(k => k !== 'craa5_boardjson' && k !== 'craa5_details' && k !== 'craa5_name' && k !== 'craa5_title' && k !== 'craa5_shiftplan1' && k !== 'craa5_shiftarchive1' && k !== 'craa5_updatepreset1' && k !== 'statecode');
            if (optKeys.length > 0 && (!looksMissing(msg) || isColumnError(msg, table))) {
                optKeys.forEach(k => delete d[k]);
                continue;
            }
            if (looksMissing(msg) && !isColumnError(msg, table)) setTableState(table, 'missing', msg);
            return { ok: false, id, error: msg, refused };
        }
    }
    return { ok: false, id, error: 'too many columns refused', refused };
}
