// Who could fill the rooms that are short of their usual headcount: the people who have worked the room, strongest first, each person used once.
type Suggest = { id: string; name: string; days: number };
function suggestMembers(h: History | null, rooms: { id: string; name: string; have: number }[], staff: { id: string; name: string }[], atMin: number): Record<string, Suggest[]> {
    const out: Record<string, Suggest[]> = {};
    if (!h || !rooms.length || !staff.length) return out;
    const once: Record<string, boolean> = {}; staff = staff.filter(s => { if (once[s.id]) return false; once[s.id] = true; return true; });
    const need: Record<string, number> = {}, pairs: { room: string; who: number; days: number }[] = [];
    rooms.forEach(r => {
        const usual = typicalHeadcount(h, r.name, atMin) || typicalHeadcount(h, r.name) || 1, n = Math.max(1, usual) - r.have; if (n <= 0) return;
        need[r.id] = n;
        staff.forEach((s, i) => { const days = shiftsInArea(h, s.id, s.name, r.name); if (days > 0) pairs.push({ room: r.id, who: i, days }); });
    });
