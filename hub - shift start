                                                <Text size={200} color="neutralSecondary" block className="mb-4">Lead: {formatFullName(getField(ld, 'craa5_name'))}</Text>
                                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                    <div className="flex flex-col gap-1"><Text size={200} weight="semibold">Completed and in process</Text><Input placeholder="Enter completed and in process..." value={d.currentStatus || ""} onChange={(e: any, dObj: any) => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], currentStatus: getInputValue(e, dObj) } }))} /></div>
                                                    <div className="flex flex-col gap-1"><Text size={200} weight="semibold">What is left to do</Text><Input placeholder="Enter what is left to do..." value={d.futureNotes || ""} onChange={(e: any, dObj: any) => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], futureNotes: getInputValue(e, dObj) } }))} /></div>
                                                </div>
                                            </div>
                                        );
                                    })}</div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
        );
    }

    return (
        <FluentProvider theme={cjTheme} style={{ background: 'transparent' }}>
            <div style={{ width: "100%", height: `${appHeight}px`, display: "flex", flexDirection: "column", background: "#F7F9FC", overflow: "hidden", position: 'relative', fontFamily: BRAND_FONT }}>
                {isLoading && (
                    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 20, background: '#F7F9FC', zIndex: 9999 }}>
                        <BrandLogo />
                        <Spinner size="large" label={busyLabel} />
                    </div>
                )}

                <header className="bg-white border-b-4 border-[#FFB81C] shrink-0 z-20">
                    <div className="px-5 h-[64px] flex items-center justify-between gap-4">
                        <div className="min-w-0 flex-1">
                            <h1 className="text-lg font-black leading-tight tracking-tight truncate" style={{ color: BRAND.blueDark }}>Shift Assignment</h1>
                            <p className="text-[11px] font-bold text-slate-500 truncate" title={`${subtitleHead}${ownerLabel ? ` · ${ownerLabel}` : ''}${headerNote ? ` · ${headerNote.text}` : ''}`}>{subtitleHead}{ownerLabel ? ` · ${ownerLabel}` : ''}{headerNote && <span style={{ color: headerNote.tone === 'error' ? BRAND.red : headerNote.tone === 'ok' ? BRAND.blue : undefined }}>{` · ${headerNote.text}`}</span>}</p>
                        </div>
                        <div className="flex items-center gap-3 shrink-0">
                            {adminMode && (
                                <div className="flex items-center gap-1.5 px-2 py-1 rounded-lg border" style={{ background: BRAND.redSoft, borderColor: '#F6B3C0' }}>
                                    <Text size={200} weight="semibold" style={{ color: BRAND.red }}>View As:</Text>
                                    <select value={selectedSupervisorId || ""} onChange={(e) => switchBoard(e.target.value)} className="px-1 py-0.5 rounded border border-[#F6B3C0] text-xs outline-none bg-white"><option value="" disabled>-- Select Supervisor --</option>{supervisors.map(s => <option key={getField(s, 'craa5__aa_employeeid')} value={getField(s, 'craa5__aa_employeeid')}>{formatFullName(getField(s, 'craa5_name'))}{!isSupervisorLike(s) ? ' (acting)' : ''}</option>)}</select>
                                </div>
                            )}
                            <div className={`flex items-center gap-1 px-2 py-0.5 rounded-lg border ${adminMode ? 'bg-[#E6F1FB] border-[#B3D4F2]' : 'border-transparent'}`}>
                                <Checkbox checked={adminMode} onChange={(e, d) => setAdminMode(!!d.checked)} /><Text size={200} weight={adminMode ? "semibold" : "regular"} style={{ color: adminMode ? BRAND.blueDark : 'inherit', cursor: 'pointer' }} onClick={() => setAdminMode(!adminMode)}>Acting Sup.</Text>
                            </div>
                            <Text size={200} weight="semibold" className="hidden md:block">{selectedSupervisorId && getField(currentUser, 'craa5__aa_employeeid') !== selectedSupervisorId ? `🕵️ ${formatFullName(getField(activeSupervisorObj, 'craa5_name'))}` : `👤 ${msUser ? msUser.name : "Signing in..."}`}</Text>
                            {!isLoading && selectedSupervisorId && shiftStartMs !== boardShiftStart && <Button size="small" appearance="primary" className="whitespace-nowrap" onClick={() => refreshShift()}>{currentShift ? `Shift ${currentShift} started: refresh` : 'Shift ended: refresh'}</Button>}
                            <Button size="small" appearance="subtle" className="whitespace-nowrap" onClick={() => setShowData(true)} title="What the app read: who you are, the shift on the clock, each team's lead and crew">Data check</Button>
                            <Badge appearance="filled" color="brand">Shift {currentShift || '?'}</Badge>
                            <div className="hidden sm:block pl-3 border-l border-slate-200"><BrandLogo /></div>
                        </div>
                    </div>
                </header>

                {selectedSupervisorId && currentUser && (
                    <nav className="bg-white border-b border-slate-200 shrink-0 z-10">
                        <div className="px-4 py-2 flex flex-wrap items-center justify-between gap-2">
                            <div className="flex gap-1.5 overflow-x-auto">
                                {steps.map((l, i) => (
                                    <button key={l} onClick={() => setCurrentStep(i)} className={`px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.08em] rounded-xl whitespace-nowrap transition-colors ${currentStep === i ? 'bg-[#0072CE] text-white shadow-[0_6px_14px_rgba(0,114,206,0.25)]' : 'text-slate-500 hover:bg-[#E6F1FB] hover:text-[#0072CE]'}`}>
                                        <span className="opacity-60 mr-1">{i + 1}</span>{l}
                                    </button>
                                ))}
                            </div>
                            <div className="flex items-center gap-2 flex-wrap">
                                <button data-chat-open aria-pressed={chatOpen} onClick={() => setChatOpen(v => !v)} title="Type or paste what happened (we finished ibl4, sending a team to ibl5 with porfirio). You look it over before anything changes on the board" className={`relative px-3 py-1 text-[11px] font-extrabold rounded-lg border whitespace-nowrap ${chatOpen ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'text-[#00468B] border-[#0072CE] bg-white hover:bg-[#E6F1FB]'}`}>💬 Chat{chatDirty && <span aria-hidden="true" style={{ position: 'absolute', top: -3, right: -3, width: 8, height: 8, borderRadius: 8, background: BRAND.yellow }} />}</button>
                                <div className="flex items-center gap-1.5" aria-label="Shift selector">
                                    {crewLetters.length > 1 && <span className="text-[11px] font-extrabold text-slate-500">Shift</span>}
                                    {crewLetters.map(l => { const how = crewOpens(l), off = how === 'none'; return (
                                        <button key={l} disabled={off} onClick={() => chooseCrew(l)} data-crew={l} title={off ? `Shift ${l} has no shift in the work schedule` : how === 'plan' ? (crewIsLive(l) ? `Shift ${l} ${crewWhen(l)}: plan its next shift here (tick Acting Sup. to work on its live board)` : `Shift ${l}: plan its next shift`) : l === clockCrew ? `Shift ${l} is on now` : crewIsLive(l) && l === upNextCrew ? `Shift ${l} ${crewWhen(l)}` : `Shift ${l}`} className={`relative px-2.5 py-1 text-[11px] font-extrabold rounded-lg border ${shownCrew === l ? 'bg-[#0072CE] text-white border-[#0072CE]' : off ? 'text-slate-300 border-slate-200' : 'text-slate-600 border-slate-300 hover:bg-[#E6F1FB]'} ${l === ownCrew && shownCrew !== l ? 'border-[#0072CE]' : ''}`}>{l}{l === clockCrew && <span aria-hidden="true" style={{ position: 'absolute', top: -3, right: -3, width: 8, height: 8, borderRadius: 8, background: BRAND.yellow }} />}</button>
                                    ); })}
                                    <div className="flex rounded-lg border border-slate-300 overflow-hidden">
                                        <button disabled={!liveOk} onClick={() => chooseMode(false)} title={liveOk ? (shownCrew !== clockCrew && shownCrew === upNextCrew && upNextStartMs > 0 ? `Shift ${shownCrew} starts ${clockTime(upNextStartMs)}: this is the board it starts with` : 'Today: the shift on now') : crewIsLive(shownCrew) ? `Shift ${shownCrew} ${crewWhen(shownCrew)}: tick Acting Sup. to work on its live board` : `Shift ${shownCrew} is not on right now`} className={`px-2.5 py-1 text-[11px] font-extrabold ${boardMode === 'live' ? 'bg-[#0072CE] text-white' : liveOk ? 'text-slate-600 hover:bg-[#E6F1FB]' : 'text-slate-300'}`}>Live</button>
                                        {peekNext && <button onClick={() => chooseMode(true)} title="Plan this crew's next shift ahead of time. Nothing here changes the shift that is on now" className={`px-2.5 py-1 text-[11px] font-extrabold border-l border-slate-300 ${boardMode === 'next' ? 'bg-[#FFB81C] text-slate-900' : 'text-slate-600 hover:bg-[#FFF6E0]'}`}>Next shift · {slotLabel((nextPillSlot || peekNext).startMs)}</button>}
                                    </div>
                                </div>
                                {currentStep === 4 && (
                                    <div className="flex items-center gap-2 bg-[#F7F9FC] border border-slate-200 px-2 py-1 rounded-xl">
                                        {boardMode === 'live' && <select value={clipboardFormat} onChange={(e) => setClipboardFormat(e.target.value as any)} className="px-2 py-1 rounded-lg border border-slate-300 text-xs font-semibold outline-none bg-white"><option value="headcount">Headcount</option><option value="initials">Initials</option><option value="fullname">Full Name</option></select>}
                                        {boardMode === 'live' && <Button appearance="secondary" size="small" onClick={handleCopyToClipboard}>Copy</Button>}
                                        <Button appearance="primary" size="small" onClick={handleSubmission}>{boardMode === 'next' ? 'Save Setup' : 'Save Progress'}</Button>
                                    </div>
                                )}
                            </div>
                        </div>
                        <ProgressBar value={(currentStep + 1) / steps.length} color={currentStep === steps.length - 1 ? "success" : "brand"} />
                    </nav>
                )}

                {showData && <DataCheckPanel onClose={() => setShowData(false)} msUser={msUser} currentUser={currentUser} slotCount={(GLOBAL_DATA_CACHE?.slots || []).length} currentShift={currentShift} shiftStartMs={shiftStartMs} upNextShift={upNextShift} teams={GLOBAL_DATA_CACHE?.teams || []} teamsRead={GLOBAL_DATA_CACHE?.teamsRead || 0} employees={allEmployees} supervisors={supervisors} taskStatus={taskStatus} areaCount={areas.length} boardCrew={boardCrew} ownerName={ownerLabel} presets={presets} presetStore={presetStore} presetLog={presetLog} prd={prd.keyOf === prdKey ? prd : PRD_IDLE} prdWindow={prdWindow} hist={histNow} histStatus={histStatus.key === histKey ? histStatus : HIST_IDLE} histNames={histNames} remembered={rememberedLog} onReread={() => { histForce.current = true; setHistReload(n => n + 1); }} suggestMode={suggestMode} leadSuggestCount={leadSuggestCount} memberSuggestCount={suggestionCount} />}
                <main style={{ flex: 1, overflow: "hidden", display: "flex", flexDirection: "column", position: 'relative' }}>{SC}{chatPanel}</main>
            </div>
        </FluentProvider>
    );
}

const App = (props: any) => <MainComponent {...props} />;
export default App;
