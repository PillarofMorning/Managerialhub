            if (!as[aId]) as[aId] = [];
            if (!as[aId].includes(eid)) { as[aId].push(eid); est[eid] = getField(r, 'craa5_starttime') || getField(r, 'craa5_datetimeofassignment') || new Date().toISOString(); }
        });
        Array.from(latestAreaState.values()).forEach(r => { if (!isTaskDone(r)) ensureAreaAndLead(r); });

        if (cl.length) setCustomLeads(p => [...p, ...cl]);
        if (ca.length) setCustomAreas(p => [...p, ...ca]);
        if (ce.length) setCustomEmployees(p => [...p, ...ce]);
        setSelectedLeadIds(nl); setSelectedAreaIds(na); setAreaAssignments(aa); setAssignments(as); setAreaDetails(ad); setEmployeeStartTimes(est); setPresetsApplied(true);
        const areaCount = Object.keys(aa).length, people = Object.keys(as).reduce((n, k) => n + as[k].length, 0);
        if (areaCount > 0) { setBoardNote({ tone: 'ok', text: `Restored ${people} ${people === 1 ? 'person' : 'people'} in ${areaCount} ${areaCount === 1 ? 'area' : 'areas'} from the last save` }); setCurrentStep(4); }
        else setBoardNote({ tone: 'none', text: `Everything this supervisor saved ${shiftStartMs ? 'this shift' : 'in the last 16 h'} is already finished` });
    // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [presetRecords, presetsApplied, supervisors, areas, selectedSupervisorId, allEmployees, currentShift, shiftStartMs]);

    // Everyday areas start in "Assigned For Today"
