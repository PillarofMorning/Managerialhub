    // Collapsible states for Easy Room Completion & Shift Passoff Status
    const [isEasyCompCollapsed, setIsEasyCompCollapsed] = useState(false);
    const [isPassoffCollapsed, setIsPassoffCollapsed] = useState(false);

    // Secret Logo-Gating: click Schwan's logo to unlock full administrative & Dataverse tools
    const [fullAccess, setFullAccess] = useState(false);
    const [showGuide, setShowGuide] = useState(false);
    const toggleFullAccess = () => setFullAccess(prev => !prev);

    // Core collections
    const [supervisors, setSupervisors] = useState<any[]>([]);
    const [leads, setLeads] = useState<any[]>([]);
    const [employees, setEmployees] = useState<any[]>([]);
    const [allEmployees, setAllEmployees] = useState<any[]>([]);
    const [areas, setAreas] = useState<any[]>([]);
    const [assets, setAssets] = useState<any[]>(() => GLOBAL_DATA_CACHE?.assets || []);
    const [presetRecords, setPresetRecords] = useState<any[]>([]);

    // Board
    const [customLeads, setCustomLeads] = useState<any[]>([]);
    const [selectedLeadIds, setSelectedLeadIds] = useState<Set<string>>(new Set());
    const [customEmployees, setCustomEmployees] = useState<any[]>([]);
    const [customAreas, setCustomAreas] = useState<any[]>([]);
    const [selectedAreaIds, setSelectedAreaIds] = useState<Set<string>>(new Set());
    const [empSearchText, setEmpSearchText] = useState("");
    const [searchSuggestions, setSearchSuggestions] = useState<any[]>([]);
    const [areaAssignments, setAreaAssignments] = useState<Record<string, string>>({});
    const [assignments, setAssignments] = useState<Record<string, string[]>>({});
    const [collapsedRooms, setCollapsedRooms] = useState<Record<string, boolean>>({});
    const [collapsedSubcatBoxes, setCollapsedSubcatBoxes] = useState<Record<string, boolean>>({});
    const [isSupportSectionCollapsed, setIsSupportSectionCollapsed] = useState(false);

    const isRoomCollapsed = (aid: string, idx: number) => {
        return collapsedRooms[aid] !== undefined ? collapsedRooms[aid] : idx !== 0;
    };

    const toggleRoomCollapse = useCallback((aid: string, idx: number) => {
        setCollapsedRooms(prev => {
            const current = prev[aid] !== undefined ? prev[aid] : idx !== 0;
            return { ...prev, [aid]: !current };
        });
    }, []);

    const toggleSubcatBox = useCallback((aid: string) => {
        setCollapsedSubcatBoxes(prev => ({ ...prev, [aid]: !prev[aid] }));
    }, []);

    // Lifted state & fast-lookups to eliminate Temporal Dead Zone (TDZ)

    // The shift on the clock (and the one about to start), as the employee table writes its letters.
    const clockCrew = crewLetterOf(currentShift), upNextCrew = crewLetterOf(upNextShift);
    const boardMode: 'live' | 'next' = nextSlot && viewCrew ? 'next' : 'live';
    const effClock = boardMode === 'next' ? viewCrew : clockCrew, effUp = boardMode === 'next' ? "" : upNextCrew;

    const allKnownEmps = useMemo(() => [...allEmployees, ...customEmployees, ...leads, ...customLeads], [allEmployees, customEmployees, leads, customLeads]);
    const employeeMap = useMemo(() => { const m = new Map(); allKnownEmps.forEach(e => { const id = getField(e, 'craa5__aa_employeeid') || getField(e, 'craa5_aa_employeeid'); if (id) m.set(id, e); }); return m; }, [allKnownEmps]);
    const areaMap = useMemo(() => { const m = new Map(); [...areas, ...customAreas].forEach(a => { const aId = getField(a, 'craa5_aa_mss_areaid'); if (aId) m.set(aId, a); }); return m; }, [areas, customAreas]);
    const activeSupervisorObj = useMemo(() => supervisors.find(s => getField(s, 'craa5__aa_employeeid') === selectedSupervisorId), [supervisors, selectedSupervisorId]);
    const boardCrew = useMemo(() => activeSupervisorObj ? crewLetterFor(activeSupervisorObj, allEmployees, effClock, effUp) : "", [activeSupervisorObj, allEmployees, effClock, effUp]);
    // Ganttly Dashboard-aligned Room Subcategory Mappings
    const ROOM_SUBCAT_MAP: Record<string, string[]> = {
        'waterjet': [
            '1 - High Pressure Cutting Deck',
            '2 - Catch Tanks & Slurry Extraction',
            '3 - Foam, Scrub & Wash',
            '4 - Drains & Trench',
            '5 - FSQ Swabs & Release'
        ],
        'breading': [
            '1 - Breading Applicator & Shaker',
            '2 - Recirculation Auger & Sifter',
            '3 - Foam, Scrub & Wash',
            '4 - Drains & Trench',
            '5 - FSQ Swabs & Release'
        ],
        'custard': [
            '1 - Cooking Kettles & CIP',
            '2 - Depositors & Packaging Heads',
            '3 - Foam, Scrub & Wash',
            '4 - Drains & Trench',
            '5 - FSQ Swabs & Release'
        ],
        'dough': [
            '1 - Dough Mixing Bowls & CIP',
            '2 - Transfer Belts & Sheeter',
            '3 - Foam, Scrub & Wash',
            '4 - Drains & Trench',
            '5 - FSQ Swabs & Release'
        ],
        'packaging': [
            '1 - Cartoner & Feed Belts',
            '2 - Case Packer & Sealers',
            '3 - Foam, Scrub & Wash',
            '4 - Drains & Floor Area',
            '5 - FSQ Swabs & Release'
        ],
        'ibl': [
            '1 - PIC & Teardown',
            '2 - Transfer Belts & Guides',
            '3 - Foam, Scrub & Wash',
            '4 - Drains, Trench & Post-San',
            '5 - FSQ Swabs & Release'
        ]
    };

    const DEFAULT_SUBCATS = [
        '1 - PIC & Teardown',
        '2 - Transfer Belts & Guides',
        '3 - Foam, Scrub & Wash',
        '4 - Drains, Trench & Post-San',
        '5 - FSQ Swabs & Release'
    ];

    // Detect Previous-Shift In-Progress Rooms & Passoff Notes (Cross-Shift Continuation)
    const priorShiftRoomState = useMemo(() => {
        const map = new Map<string, {
            isContinuing: boolean;
            startedAt: string;
            priorShift: string;
            priorDone: string[];
            priorInProg: string[];
            priorLeftToDo?: string;
            priorStatus?: string;
            priorCallout?: string;
            priorLead?: string;
            priorPct?: number;
        }>();

        const currentSlotStart = shiftStartMs || shiftBucketMs(Date.now(), GLOBAL_DATA_CACHE?.slots || [], boardCrew);
        const currentShiftBoundaryMs = currentSlotStart ? (currentSlotStart - SHIFT_PREP_MS) : (Date.now() - 12 * 3600000);
        // Only the shift just before this one passes rooms on: boards that started 2 to 16 hours before this shift, never older shifts
        const prevFrom = (currentSlotStart || Date.now()) - PREV_SHIFT_MAX_MS, prevTo = (currentSlotStart || Date.now()) - PREV_SHIFT_MIN_MS;
        const inPrevShift = (ms: number) => ms > 0 && ms >= prevFrom && ms <= prevTo;
        const activeSupName = activeSupervisorObj ? String(getField(activeSupervisorObj, 'craa5_name') || '') : '';
        const allAreaPool = [...areas, ...customAreas];
        const findMatchingArea = (areaGuid: string, areaName: string) => {
            const g = String(areaGuid || '').replace(/[{}]/g, '').toLowerCase().trim();
            const n = normText(areaName || '');
            const ck = cleanAreaKey(areaName || '');
            return allAreaPool.find(a => {
                const aid = String(getField(a, 'craa5_aa_mss_areaid') || '').replace(/[{}]/g, '').toLowerCase().trim();
                const an = normText(getField(a, 'craa5_area') || '');
                const ack = cleanAreaKey(getField(a, 'craa5_area') || '');
                return (g && aid === g) || (n && an === n) || (ck && ack === ck);
            });
        };

        // 1. Inspect RECENT_ARCHIVES, LIVE_BOARDS, and browser-stored boards from earlier shifts (oldest to newest so newest prior shift wins)
        const priorBoardsPool: ShiftBoard[] = [
            ...(RECENT_ARCHIVES || []),
            ...(recentArchives || []),
            ...(LIVE_BOARDS || []),
            ...readLocalArchives(),
            ...readLocalLiveBoards(true),
        ].filter(Boolean);
        priorBoardsPool.sort((a, b) => (Number(a.slotStart || 0) - Number(b.slotStart || 0)) || (new Date(a.savedAt || 0).getTime() - new Date(b.savedAt || 0).getTime()));

        priorBoardsPool.forEach((arch: ShiftBoard) => {
            if (!arch) return;
            const archShift = String(arch.crew || '').trim();
            const archSlot = Number(arch.slotStart || 0);
            const sameSup = activeSupName && (sameText(arch.team, activeSupName) || (personKey(arch.team) !== '' && personKey(arch.team) === personKey(activeSupName)));
            const isCurrentSlot = archSlot > 0 && currentSlotStart > 0 && Math.abs(archSlot - currentSlotStart) < 2 * 3600000;
            if (isCurrentSlot && (sameSup || (archShift && boardCrew && archShift === boardCrew))) return;
            if (!inPrevShift(archSlot)) return;
            if (Array.isArray(arch.rows)) {
                arch.rows.forEach((r: any) => {
                    const leftNote = String(getField(r, 'craa5_whatislefttodo') || getField(r, 'craa5__future_or_notes') || getField(r, 'futureNotes') || r?.notes || '').trim();
                    const statNote = String(getField(r, 'craa5_whatisbeingdone') || getField(r, 'currentStatus') || r?.status || '').trim();
                    const doneFlag = isAreaRowExplicitlyCompleted(r);
                    if (doneFlag && !leftNote) return;
                    const matchArea = findMatchingArea(getField(r, 'craa5_areaid') || '', getField(r, 'craa5_area') || getField(r, 'area') || r?.area || '');
                    if (!matchArea) return;
                    const aid = String(getField(matchArea, 'craa5_aa_mss_areaid'));
                    const existing = map.get(aid);
                    const subStr = String(getField(r, 'craa5_subcategory') || '');
                    const subDone = subStr ? subStr.split(',').map(s => s.trim()).filter(Boolean) : [];
                    const pctNum = parseInt(String(getField(r, 'craa5_percentagecomplete') ?? getField(r, 'percentage') ?? '0'), 10);
                    map.set(aid, {
                        isContinuing: true,
                        startedAt: existing?.startedAt || String(getField(r, 'craa5_starttime') || arch.savedAt || new Date().toISOString()),
                        priorShift: archShift || existing?.priorShift || '',
                        priorDone: Array.from(new Set([...(existing?.priorDone || []), ...subDone])),
                        priorInProg: existing?.priorInProg || [],
                        priorLeftToDo: leftNote || existing?.priorLeftToDo || '',
                        priorStatus: (statNote && statNote !== 'Superseded') ? statNote : (existing?.priorStatus || ''),
                        priorLead: String(getField(r, 'craa5_lead') || r?.lead || arch.team || existing?.priorLead || '').trim(),
                        priorPct: !isNaN(pctNum) && pctNum > 0 ? pctNum : (existing?.priorPct || 0),
                    });
                });
            }
            if (arch.state?.areaDetails && typeof arch.state.areaDetails === 'object') {
                Object.entries(arch.state.areaDetails).forEach(([rawAid, det]: [string, any]) => {
                    if (!det) return;
                    const matchArea = findMatchingArea(rawAid, rawAid);
                    if (!matchArea) return;
                    const aid = String(getField(matchArea, 'craa5_aa_mss_areaid'));
                    const leftNote = String(det.futureNotes || '').trim();
                    const statNote = String(det.currentStatus || '').trim();
                    if (det.isFinished && !leftNote) return;
                    const existing = map.get(aid);
                    const subProg = arch.state?.subcatProgress?.[rawAid] || arch.state?.subcatProgress?.[aid] || {};
                    const subDone = Object.keys(subProg).filter(k => subProg[k] === 'done');
                    const subInProg = Object.keys(subProg).filter(k => subProg[k] === 'in_progress');
                    const sanStep = arch.state?.sanitationProgress?.[rawAid] ?? arch.state?.sanitationProgress?.[aid];
                    const stepPct = typeof sanStep === 'number' && sanStep > 0 ? Math.min(95, Math.round((sanStep / Math.max(1, SANITATION_STEPS.length - 1)) * 85)) : 0;
                    map.set(aid, {
                        isContinuing: true,
                        startedAt: existing?.startedAt || arch.savedAt || new Date().toISOString(),
                        priorShift: archShift || existing?.priorShift || '',
                        priorDone: Array.from(new Set([...(existing?.priorDone || []), ...subDone])),
                        priorInProg: Array.from(new Set([...(existing?.priorInProg || []), ...subInProg])),
                        priorLeftToDo: leftNote || existing?.priorLeftToDo || '',
                        priorStatus: statNote || existing?.priorStatus || '',
                        priorLead: existing?.priorLead || arch.team || '',
                        priorPct: stepPct || existing?.priorPct || 0,
                    });
                });
            }
        });

        // 2. Inspect presetRecords from Dataverse and local task cache
        (presetRecords || []).forEach((r: any) => {
            const tMs = taskTime(r);
            const rSlot = Number(r?._slotStart || 0);
            const belongsToActiveSup = activeSupervisorObj ? rowBelongsTo(r, activeSupervisorObj) : false;
            const isCurrentShiftRow = (rSlot > 0 && currentSlotStart > 0)
                ? (Math.abs(rSlot - currentSlotStart) < 2 * 3600000 && belongsToActiveSup)
                : (tMs >= currentShiftBoundaryMs && belongsToActiveSup);
            if (isCurrentShiftRow) return; // Belongs to current supervisor's active shift, not prior shift
            if (!inPrevShift(rSlot || tMs)) return;
            const leftNote = String(getField(r, 'craa5_whatislefttodo') || getField(r, 'craa5__future_or_notes') || getField(r, 'futureNotes') || '').trim();
            const statNote = String(getField(r, 'craa5_whatisbeingdone') || getField(r, 'craa5__currentstatus') || '').trim();
            if (isTaskDone(r) && !leftNote) return; // Already completed with no passoff note

            const areaName = String(getField(r, 'craa5_area') || '');
            const areaGuid = String(getField(r, 'craa5_areaid') || getField(r, '_craa5_areaid_value') || '');
            const rShift = String(getField(r, 'craa5_shift') || '').trim();
            const rStart = String(getField(r, 'craa5_starttime') || '');

            const matchArea = findMatchingArea(areaGuid, areaName);
            if (matchArea) {
                const aid = String(getField(matchArea, 'craa5_aa_mss_areaid'));
                const existing = map.get(aid);
                const subStr = String(getField(r, 'craa5_subcategory') || '');
                const subDone = subStr ? subStr.split(',').map(s => s.trim()).filter(Boolean) : [];
                const pctNum = parseInt(String(getField(r, 'craa5_percentagecomplete') ?? getField(r, 'craa5_completionpct') ?? getField(r, 'percentage') ?? '0'), 10);
                map.set(aid, {
                    isContinuing: true,
                    startedAt: existing?.startedAt || rStart || (tMs ? new Date(tMs).toISOString() : new Date().toISOString()),
                    priorShift: rShift || existing?.priorShift || '',
                    priorDone: Array.from(new Set([...(existing?.priorDone || []), ...subDone])),
                    priorInProg: existing?.priorInProg || [],
                    priorLeftToDo: leftNote || existing?.priorLeftToDo || '',
                    priorStatus: (statNote && statNote !== 'Superseded') ? statNote : (existing?.priorStatus || ''),
                    priorLead: String(getField(r, 'craa5_lead') || getField(r, 'craa5_team') || existing?.priorLead || '').trim(),
                    priorPct: !isNaN(pctNum) && pctNum > 0 ? pctNum : (existing?.priorPct || 0),
                });
            }
        });

        return map;
    }, [presetRecords, recentArchives, shiftStartMs, areas, customAreas, boardCrew, activeSupervisorObj]);
    // The same rooms as a list, with the room's id and name (the map holds them by id only)
    const priorRooms = useMemo(() => Array.from(priorShiftRoomState.entries()).map(([areaId, v]) => ({
        ...v, areaId, areaName: renderSafe(getField(areaMap.get(areaId), 'craa5_area')) || areaId, pct: v.priorPct || 0, shift: v.priorShift || '', notes: v.priorLeftToDo || v.priorStatus || '', status: v.priorStatus || '',
    })), [priorShiftRoomState, areaMap]);
    const priorById = useMemo(() => new Map(priorRooms.map(r => [r.areaId, r] as [string, typeof r])), [priorRooms]);
    // From the last shift: each board of the shift just before this one (a double shift has two), with the rooms it finished,
    // the rooms it left (what is left, callouts) and who was out. Shown from the Today's shifts bar.
    const prevShiftBoards = useMemo(() => {
        const cur = shiftStartMs || shiftBucketMs(Date.now(), GLOBAL_DATA_CACHE?.slots || [], boardCrew) || Date.now();
        const from = cur - PREV_SHIFT_MAX_MS, to = cur - PREV_SHIFT_MIN_MS;
        const pool: ShiftBoard[] = [...(RECENT_ARCHIVES || []), ...(LIVE_BOARDS || []), ...readLocalArchives(), ...readLocalLiveBoards(true)]
            .filter(b => b && Number(b.slotStart) >= from && Number(b.slotStart) <= to);
        const best = new Map<string, ShiftBoard>();
        pool.forEach(b => {
            const k = `${b.crew}|${personKey(b.team) || normText(b.team)}|${Math.round(Number(b.slotStart) / 60000)}`, o = best.get(k);
            const better = !o || (b.status === 'archived' && o.status !== 'archived') || (b.status === o.status && String(b.savedAt || '') > String(o.savedAt || ''));
            if (better) best.set(k, b);
        });
        const areaPool = [...areas, ...customAreas];
        const areaName = (id: string) => { const a = areaPool.find(x => String(getField(x, 'craa5_aa_mss_areaid')) === id); return a ? renderSafe(getField(a, 'craa5_area')) : ''; };
        const typed = (v: any) => { const t = String(v || '').trim(); return /^(completed|complete|done|superseded)$/i.test(t) ? '' : t; };
        return Array.from(best.values()).sort((a, b) => a.slotStart - b.slotStart).map(b => {
            const rooms = new Map<string, { name: string; done: boolean; pct: number; status: string; left: string; callout: string }>();
            const room = (n: string) => { const k = normText(n); if (!rooms.has(k)) rooms.set(k, { name: n, done: false, pct: 0, status: '', left: '', callout: '' }); return rooms.get(k)!; };
            (b.rows || []).forEach((r: any) => {
                const n = String(getField(r, 'craa5_area') || r?.area || '').trim();
                if (!n || isStatusArea(n)) return;
                const x = room(n), pc = Number(getField(r, 'craa5_percentagecomplete')) || 0;
                if (isAreaRowExplicitlyCompleted(r)) x.done = true;
                x.status = x.status || typed(getField(r, 'craa5_whatisbeingdone'));
                x.left = x.left || typed(getField(r, 'craa5_whatislefttodo'));
                if (pc > x.pct) x.pct = pc;
            });
            const det = b.state?.areaDetails || {}, sub = b.state?.subcatProgress || {};
            Object.keys(det).forEach(id => {
                const d = det[id], n = areaName(id);
                if (!d || !n || isStatusArea(n)) return;
                const x = room(n);
                if (d.isFinished) x.done = true;
                x.status = typed(d.currentStatus) || x.status;
                x.left = typed(d.futureNotes) || x.left;
                x.callout = String(d.subcategoryNotes || sub[id]?.callout || '').trim() || x.callout;
            });
            const out = (b.attendance || []).filter(g => g && g.people && g.people.length).map(g => `${trDv(g.status)}: ${g.people.map(q => q.name).join(', ')}`);
            return { key: boardName(b), crew: b.crew, team: b.team, slotStart: b.slotStart, handedOffAt: b.status === 'archived' ? String(b.archivedAt || '') : '', rooms: Array.from(rooms.values()), out };
        });
    // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [shiftStartMs, boardCrew, areas, customAreas, hydrateTick]);

    // Pre-indexed asset lookup map: O(Assets + Areas) single-pass index for subcategories and clean hours per area
    const assetLookupByArea = useMemo(() => {
        const map = new Map<string, { subcats: string[]; totalCleanHours: number; laborHours: number; matchedAssets: any[] }>();
        const allAreas = [...areas, ...customAreas];

        const indexedAssets: { raw: any; areaName: string; mssGuid: string; sub: string; hrs: number }[] = [];
        if (assets && assets.length > 0) {
            for (let i = 0; i < assets.length; i++) {
                const asset = assets[i];
                if (!asset) continue;
                const assetArea = String(asset.craa5_area || asset.craa5_areaname || asset.craa5_line || asset.craa5_roomname || getField(asset, 'craa5_area') || getField(asset, 'craa5_areaname') || getField(asset, 'craa5_roomname') || '').toLowerCase().trim();
                const assetMssGuid = String(asset.craa5_mssareaguid || asset._craa5_mssareaguid_value || getField(asset, 'craa5_mssareaguid') || getField(asset, '_craa5_mssareaguid_value') || '').toLowerCase().trim();
                if (!assetArea && !assetMssGuid) continue;
                const rawSub = String(asset['craa5_subcategory@OData.Community.Display.V1.FormattedValue'] || asset.craa5_subcategory || asset.craa5_Subcategory || getFormattedField(asset, 'craa5_subcategory') || getField(asset, 'craa5_subcategory') || '').trim();
                const sub = (rawSub && rawSub !== 'null' && rawSub !== 'undefined') ? rawSub : '';
                const rawHrs = parseFloat(String(asset.craa5_hoursrequired ?? getField(asset, 'craa5_hoursrequired') ?? '0'));
                const hrsVal = (isNaN(rawHrs) || rawHrs <= 0) ? 0 : (rawHrs > 8 ? (rawHrs / 60) : rawHrs);
                indexedAssets.push({
                    raw: asset,
                    areaName: assetArea,
                    mssGuid: assetMssGuid,
                    sub,
                    hrs: hrsVal
                });
            }
        }

        allAreas.forEach((a: any) => {
            const aid = String(getField(a, 'craa5_aa_mss_areaid') || '').trim();
            if (!aid) return;
            const areaName = String(getField(a, 'craa5_area') || getFormattedField(a, 'craa5_area') || '').toLowerCase().trim();
            const areaGuid = aid.toLowerCase();

            const pulledSubcats = new Set<string>();
            const matchedAssets: any[] = [];
            let sumAssetHrs = 0;
            let matchCount = 0;

            for (let i = 0; i < indexedAssets.length; i++) {
                const ia = indexedAssets[i];
                const guidMatch = !!(areaGuid && ia.mssGuid && (ia.mssGuid.includes(areaGuid) || areaGuid.includes(ia.mssGuid)));
                const nameMatch = !!(areaName && ia.areaName && (ia.areaName === areaName || ia.areaName.includes(areaName) || areaName.includes(ia.areaName)));
                if (guidMatch || nameMatch) {
                    matchCount++;
                    matchedAssets.push(ia.raw);
                    if (ia.sub) pulledSubcats.add(ia.sub);
                    sumAssetHrs += ia.hrs;
                }
            }

            let subcats: string[] = [];
            if (pulledSubcats.size > 0) {
                subcats = Array.from(pulledSubcats).sort((x, y) => {
                    const nx = parseInt((x.match(/\d+/) || [99])[0], 10);
                    const ny = parseInt((y.match(/\d+/) || [99])[0], 10);
                    return nx - ny || x.localeCompare(y);
                });
            } else {
                let foundFallback = false;
                for (const [key, list] of Object.entries(ROOM_SUBCAT_MAP)) {
                    if (areaName.includes(key)) {
                        subcats = list;
                        foundFallback = true;
                        break;
                    }
                }
                if (!foundFallback) {
                    subcats = DEFAULT_SUBCATS;
                }
            }

            let totalCleanHours = isProductionArea(a) ? 4.5 : 2.0;
            if (matchCount > 0 && sumAssetHrs > 0) {
                totalCleanHours = Math.max(0.5, Math.round(sumAssetHrs * 10) / 10);
            }

            map.set(aid, { subcats, totalCleanHours, laborHours: totalCleanHours, matchedAssets });
        });

        return map;
    }, [assets, areas, customAreas]);

    const [areaDetails, setAreaDetails] = useState<Record<string, { currentStatus: string; futureNotes: string; subcategoryNotes?: string; includeInUpdate?: boolean; userSetInclude?: boolean; isFinished?: boolean; cleanType?: string }>>({});
    const [cleanTypesByArea, setCleanTypesByArea] = useState<Record<string, string>>(() => readSavedCleanTypes());

    // Type of Clean: manual override -> Production Scheduler auto-default -> area type default
    const getAreaCleanType = useCallback((aid: string): string => {
        if (!aid) return 'Daily Clean';
        const manual = areaDetails[aid]?.cleanType || cleanTypesByArea[aid];
        if (manual) return manual;
        const fromPrd = prd?.cleanTypes?.[aid];
        if (fromPrd) return fromPrd;
        const a = areaMap.get(aid);
        if (a && (isEverydayArea(a) || !isProductionArea(a))) return 'Everyday Clean';
        return 'Daily Clean';
    }, [areaDetails, cleanTypesByArea, prd, areaMap]);

    const setAreaCleanType = useCallback((aid: string, cleanType: string) => {
        if (!aid) return;
        setCleanTypesByArea(prev => {
            const next = { ...prev, [aid]: cleanType };
            writeSavedCleanTypes(next);
            return next;
        });
        setAreaDetails(prev => ({
            ...prev,
            [aid]: {
                ...(prev[aid] || { currentStatus: '', futureNotes: '' }),
                cleanType
            }
        }));
    }, []);

    const cycleAreaCleanType = useCallback((aid: string) => {
        if (!aid) return;
        const cur = getAreaCleanType(aid);
        const next = nextCleanType(cur);
        setAreaCleanType(aid, next);
    }, [getAreaCleanType, setAreaCleanType]);

    const [sanitationProgress, setSanitationProgress] = useState<Record<string, number>>(() => {
        try {
            const s = typeof localStorage !== 'undefined' ? localStorage.getItem('ganttly_step_sync') : null;
            if (!s) return {};
            const parsed = JSON.parse(s) || {};
            const clamped: Record<string, number> = {};
            Object.keys(parsed).forEach(k => {
                const v = Number(parsed[k]);
                if (!isNaN(v)) clamped[k] = Math.max(0, Math.min(SANITATION_STEPS.length - 1, v));
            });
            return clamped;
        } catch (e) { return {}; }
    });

    // Whether an area has been explicitly marked finished on this shift (NEVER triggered by FSQ Inspect or subcategory ETA pills)
    const isAreaFinished = useCallback((aid: string): boolean => {
        const d = areaDetails[aid];
        if (!d) return false;
        if (d.isFinished !== undefined) return !!d.isFinished;
        const st = String(d.currentStatus || '').trim().toLowerCase();
        return st === 'completed' || st === 'done';
    }, [areaDetails]);

    // Whether an area is included in the shift update: finished areas on the shift are always included unless explicitly unchecked
    const isAreaIncludedInUpdate = useCallback((aid: string): boolean => {
        const d = areaDetails[aid];
        if (d?.userSetInclude && d.includeInUpdate !== undefined) return !!d.includeInUpdate;
        if (isAreaFinished(aid)) return true;
        if (d?.includeInUpdate !== undefined) return !!d.includeInUpdate;
        return isProductionArea(areaMap.get(aid));
    }, [areaDetails, isAreaFinished, areaMap]);

    // Explicit room-level Done toggle (independent of subcategories/ETA stages); finishing an area auto-includes it in the update unless unselected
    const toggleAreaFinished = useCallback((aid: string, forceState?: boolean) => {
        setAreaDetails(prev => {
            const cur = prev[aid] || { currentStatus: '', futureNotes: '' };
            const curDone = cur.isFinished !== undefined ? !!cur.isFinished : (String(cur.currentStatus || '').trim().toLowerCase() === 'completed' || String(cur.currentStatus || '').trim().toLowerCase() === 'done');
            const nextDone = forceState !== undefined ? forceState : !curDone;
            const curStatLower = String(cur.currentStatus || '').trim().toLowerCase();
            const nextStatus = nextDone
                ? ((curStatLower && curStatLower !== 'completed' && curStatLower !== 'done') ? cur.currentStatus : 'Completed')
                : ((curStatLower === 'completed' || curStatLower === 'done') ? '' : cur.currentStatus);
            const nextInclude = nextDone
                ? (cur.userSetInclude ? !!cur.includeInUpdate : true)
                : (cur.includeInUpdate ?? isProductionArea(areaMap.get(aid)));

            const a = areaMap.get(aid);
            const an = renderSafe(getField(a, 'craa5_area'));
            const crewStr = viewCrew || boardCrew || clockCrew || 'A';

            try {
                if (typeof localStorage !== 'undefined') {
                    const existingComps = JSON.parse(localStorage.getItem('ganttly_area_completions') || '{}');
                    const shiftLabel = 'Shift ' + crewStr;
                    const timeStr = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                    const compObj = {
                        ...(existingComps[aid] || {}),
                        isComplete: nextDone,
                        pct: nextDone ? 100 : (existingComps[aid]?.pct && existingComps[aid].pct < 100 ? existingComps[aid].pct : 50),
                        ganttStatus: nextDone ? 'Completed' : 'Started',
                        shiftLabel,
                        timeStr,
                        crew: crewStr
                    };
                    existingComps[aid] = compObj;
                    if (an) existingComps[an] = compObj;
                    localStorage.setItem('ganttly_area_completions', JSON.stringify(existingComps));
                }
            } catch (e) {}

            try {
                const uName = String(msUser?.name || formatFullName(getField(currentUser, 'craa5_name')) || 'User');
                const uEmail = String(msUser?.email || getEmployeeEmail(currentUser) || '');
                logAccessEvent(propsRef.current, `room_done_${aid}_${nextDone ? '1' : '0'}`, {
                    action: nextDone ? 'room_completed' : 'room_reopened',
                    user: uName,
                    email: uEmail,
                    role: String(currentUser?.calculatedRole || 'user'),
                    crew: crewStr,
                    board: an || aid,
                    summary: `${nextDone ? 'Marked room Completed' : 'Reopened room'}: ${an || aid} (Shift ${crewStr})`
                }, 1500);
            } catch (e) {}

            return {
                ...prev,
                [aid]: {
                    ...cur,
                    isFinished: nextDone,
                    currentStatus: nextStatus,
                    includeInUpdate: nextInclude
                }
            };
        });
    }, [areaMap, viewCrew, boardCrew, clockCrew, msUser, currentUser]);

    // Subcategories & Sanitation stages (0..5, ending at 'FSQ Inspect') are linked to ETA only and NEVER mark any item or room as Complete
    const setAreaSanitationStep = useCallback((aid: string, stepIdx: number) => {
        const maxStepIdx = SANITATION_STEPS.length - 1; // 5 = 'FSQ Inspect'
        const clampedStep = Math.max(0, Math.min(maxStepIdx, stepIdx));
        const stepName = SANITATION_STEPS[clampedStep] || SANITATION_STEPS[0];
        const stepPct = Math.round((clampedStep / 6) * 100); // max 83% at FSQ Inspect (ETA only)
        const finished = isAreaFinished(aid);

        setSanitationProgress(prev => {
            const next = { ...prev, [aid]: clampedStep };
            try {
                if (typeof localStorage !== 'undefined') {
                    localStorage.setItem('ganttly_step_sync', JSON.stringify(next));
                }
            } catch (e) {}
            return next;
        });

        try {
            if (typeof localStorage !== 'undefined') {
                const a = areaMap.get(aid);
                const an = renderSafe(getField(a, 'craa5_area'));
                const existingComps = JSON.parse(localStorage.getItem('ganttly_area_completions') || '{}');
                const shiftLabel = 'Shift ' + (viewCrew || boardCrew || clockCrew || 'A');
                const timeStr = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });

                const compObj = {
                    ...(existingComps[aid] || {}),
                    isComplete: finished,
                    pct: finished ? 100 : stepPct,
                    sanitationStep: clampedStep,
                    sanitationStepName: stepName,
                    shiftLabel,
                    timeStr,
                    crew: viewCrew || boardCrew || clockCrew || 'A'
                };

                existingComps[aid] = compObj;
                if (an) existingComps[an] = compObj;
                localStorage.setItem('ganttly_area_completions', JSON.stringify(existingComps));
            }
        } catch (e) {}
    }, [areaMap, viewCrew, boardCrew, clockCrew, isAreaFinished]);

    const [subcatProgress, setSubcatProgress] = useState<Record<string, { done: string[], inProg?: string[], callout?: string }>>(() => {
        try {
            const s = localStorage.getItem('ganttly_subcats_sync');
            return s ? JSON.parse(s) : {};
        } catch (e) { return {}; }
    });

    const getSubcatsForArea = useCallback((aid: string): string[] => {
        return assetLookupByArea.get(aid)?.subcats || DEFAULT_SUBCATS;
    }, [assetLookupByArea]);

    const getAreaSubcatState = useCallback((aid: string) => {
        const sc = subcatProgress[aid] || { done: [], inProg: [], callout: '' };
        const allSubs = getSubcatsForArea(aid);
        const doneList = (sc.done || []).filter(s => allSubs.includes(s));
        const inProgList = (sc.inProg || []).filter(s => allSubs.includes(s) && !doneList.includes(s));
        const notStartedList = allSubs.filter(s => !doneList.includes(s) && !inProgList.includes(s));
        
        const doneCount = doneList.length;
        const totalCount = allSubs.length;

        const a = areaMap.get(aid);
        const lookup = assetLookupByArea.get(aid);
        const cleanType = getAreaCleanType(aid);
        const cleanMeta = getCleanTypeMeta(cleanType);
        const rawBaseHours = lookup?.totalCleanHours ?? lookup?.laborHours ?? (isProductionArea(a) ? 4.5 : 2.0);
        // Total labor hours for the room (after Clean Type multiplier)
        const baseHours = Math.max(0.5, Math.round(rawBaseHours * (cleanMeta.mult || 1.0) * 10) / 10);

        // Divide ETA hours by headcount assigned (minimum 1 so unassigned rooms still show baseline 1-person ETA)
        const staffCount = assignments[aid]?.length || 0;
        const effectiveHc = Math.max(staffCount, 1);
        const hcHours = baseHours / effectiveHc;
        const totalHours = Math.max(0.2, Math.round(hcHours * 10) / 10);

        // Factor in the Stage (0..5 out of 6) and Subcategory progress (capped at 5/6 = 83%) to reduce the ETA
        const stepIdx = Math.min(SANITATION_STEPS.length - 1, Math.max(0, sanitationProgress[aid] ?? 0));
        const stepRatio = stepIdx / 6;
        const subcatRatio = totalCount > 0 ? Math.min(5 / 6, doneCount / (totalCount + 1)) : 0;
        const effectiveRatio = Math.min(5 / 6, Math.max(stepRatio, subcatRatio));
        const pct = Math.min(83, Math.round(effectiveRatio * 100));
        const finished = isAreaFinished(aid);

        // Remaining wall-clock hours = (baseHours / effectiveHc) * (1 - effectiveRatio)
        const remHours = finished ? 0 : Math.max(0.1, Math.round(hcHours * (1 - effectiveRatio) * 10) / 10);
        // Remaining total labor person-hours (before dividing by team headcount)
        const remLaborHours = finished ? 0 : Math.max(0.2, Math.round(baseHours * (1 - effectiveRatio) * 10) / 10);

        const perSubHours = Math.max(0.1, Math.round((hcHours / Math.max(totalCount + 1, 1)) * 10) / 10);
        const subHoursMap: Record<string, number> = {};
        allSubs.forEach(s => { subHoursMap[s] = perSubHours; });

        return {
            allSubs,
            notStartedList,
            inProgList,
            doneList,
            pct,
            isComplete: finished,
            callout: sc.callout || '',
            baseHours,
            staffCount,
            effectiveHc,
            totalHours,
            remHours,
            remLaborHours,
            subHoursMap,
            cleanType,
            cleanMeta
        };
    }, [subcatProgress, getSubcatsForArea, areaMap, assetLookupByArea, getAreaCleanType, assignments, sanitationProgress, isAreaFinished]);

    const getAreaExpectedFinish = useCallback((aid: string) => {
        if (!aid || isAreaFinished(aid)) return null;
        const sc = getAreaSubcatState(aid);
        const baseStartMs = boardMode === 'next' && nextSlot ? nextSlot.startMs : (shiftStartMs || Date.now());
        // sc.remHours is already (baseHours / effectiveHc) * (1 - stageRatio)
        const estDurationHours = Math.max(0.1, sc.remHours);
        const durationMs = Math.round(estDurationHours * 3600000);
        const finishMs = (boardMode === 'live' && shiftStartMs && Date.now() > shiftStartMs)
            ? Math.max(shiftStartMs + durationMs, Date.now() + durationMs)
            : (baseStartMs + durationMs);
        const hrs = Math.floor(estDurationHours);
        const mins = Math.round((estDurationHours % 1) * 60);
        const durationStr = hrs > 0 ? (mins > 0 ? (hrs + 'h ' + mins + 'm') : (hrs + 'h')) : (mins + 'm');
        return {
            timeStr: clockTime(finishMs),
            shortTimeStr: clockTime(finishMs).replace(/\s+[AP]M/i, (m) => m.trim().toLowerCase()),
            durationStr,
            remHours: sc.remHours,
            baseHours: sc.baseHours,
            effectiveHc: sc.effectiveHc,
            staffCount: sc.staffCount,
            finishMs
        };
    }, [isAreaFinished, getAreaSubcatState, boardMode, nextSlot, shiftStartMs]);

    const getTeamExpectedFinish = useCallback((leadId: string) => {
        const bAreas = Object.keys(areaAssignments).filter(aid => areaAssignments[aid] === leadId);
        if (!bAreas || bAreas.length === 0) return null;

        const bStaff = bAreas.reduce((sum, aid) => sum + (assignments[aid]?.length || 0), 0);
        const effectiveHc = Math.max(bStaff, 1);

        const baseStartMs = boardMode === 'next' && nextSlot ? nextSlot.startMs : (shiftStartMs || Date.now());

        let totalLaborHours = 0;
        bAreas.forEach(aid => {
            if (isAreaFinished(aid)) return;
            const sc = getAreaSubcatState(aid);
            totalLaborHours += sc.remLaborHours;
        });

        if (totalLaborHours <= 0) return null;

        const estDurationHours = Math.max(0.1, Math.round((totalLaborHours / effectiveHc) * 10) / 10);
        const durationMs = Math.round(estDurationHours * 3600000);
        const finishMs = (boardMode === 'live' && shiftStartMs && Date.now() > shiftStartMs)
            ? Math.max(shiftStartMs + durationMs, Date.now() + durationMs)
            : (baseStartMs + durationMs);

        const hrs = Math.floor(estDurationHours);
        const mins = Math.round((estDurationHours % 1) * 60);
        const durationStr = hrs > 0 ? (mins > 0 ? (hrs + 'h ' + mins + 'm') : (hrs + 'h')) : (mins + 'm');

        return {
