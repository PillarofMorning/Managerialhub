// --- TYPES ---
type Slot = { crew: string; day: number; startHour: number; lengthHours: number };
type ShiftWin = { crew: string; start: Date; end: Date; auto: boolean };
type Job = 'tech' | 'tech3' | 'inspector' | 'clerk' | 'janitorial' | 'admin';
type Emp = { id: string; raw: string; name: string; email: string; badge: string; crew: string; role: 'lead' | 'supervisor' | 'manager' | 'employee'; job: Job; jobName: string };
type Asset = { id: string; name: string; pic: boolean };
type Line = { id: string; name: string; production: boolean; everyday: boolean; manual: boolean; assets: Asset[] };
type TaskRowRef = { rowId: string; lineId: string; hash: string };
type Board = {
  v: 1;
  leads: string[];                          // lead employee ids, in column order
  members: Record<string, string>;          // employee id -> lead id
  overtime: string[];                       // employees pulled in from another crew
  out: Record<string, string>;              // employee id -> PTO / Sick / ...
  downLines: string[];                      // lines being cleaned this shift
  manualLines: { id: string; name: string }[];
  teamLines: Record<string, string[]>;      // lead id -> line ids the team covers
  workerLine: Record<string, string>;       // person (member or lead) -> line they are on
  equip: Record<string, string>;            // asset id -> person, only for lines edited by hand
  equipManual: string[];                    // line ids with hand-placed equipment
  equipDone: Record<string, boolean>;
  progress: Record<string, number>;         // production: steps done (0..8). Other: 0 / 1 (in progress) / 8 (done)
  notes: Record<string, string>;
  autoSend: boolean;
  sentSlots: string[];
  lastSentAt?: string;
  taskRows: Record<string, TaskRowRef>;     // person -> their open craa5_taskassignment row
};
