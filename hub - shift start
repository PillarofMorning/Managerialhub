            const [r, d] = await Promise.all([readAssignments(hostProps, shiftDate, crew), readProgress(hostProps, shiftDate, slotStartMs - 3600000)]);
            setRead(r); setProg(d);
        } finally { busy.current = false; }
    }, [hostProps, shiftDate, crew, slotStartMs]);
