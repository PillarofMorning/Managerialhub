    // ============================================================================
    // RENDER
    // ============================================================================
    const subtitleHead = boardMode === 'next' && nextSlot ? `Setting up shift ${viewCrew} · ${slotLabel(nextSlot.startMs)}` : gettingReady ? `Getting ready for shift ${boardCrew} · starts ${clockTime(upNextStartMs)}` : `Shift ${currentShift || '?'}${boardCrew && boardCrew !== currentShift ? ` · crew ${boardCrew}` : ''}`;
    // The shift selector: which crew the board is about, and whether it is that crew's shift on now (live) or its next one (a setup).
    const slotList: Slot[] = GLOBAL_DATA_CACHE?.slots || [];
    const shownCrew = boardMode === 'next' ? viewCrew : boardCrew;
    const crewLetters = ['A', 'B', 'C', 'D'].filter(l => TEAMS.some(t => t.letter === l) || allEmployees.some(e => crewOfPerson(e) === l));
    // A supervisor works the live board of their own crew; another crew's live board is for a manager or someone who ticked Acting Sup.
    // Everyone can plan any crew's next shift: a setup board never reads or writes today's assignments.
    const ownCrew = currentUser ? crewOfPerson(currentUser) : "";
    const myId = currentUser ? String(getField(currentUser, 'craa5__aa_employeeid') || "") : "";
    const meSup = myId ? supervisors.find(s => String(getField(s, 'craa5__aa_employeeid') || "") === myId && isSupervisorLike(s)) : undefined;   // the signed-in supervisor's own record: their own letter always opens them, never a colleague on the same crew
    const crewCovered = (letter: string) => supervisors.some(s => isSupervisorLike(s) && crewOfPerson(s) === letter);   // somebody is listed to run that crew
    const mayWorkLive = (letter: string) => adminMode || currentUser?.calculatedRole !== 'supervisor' || !ownCrew || !clockCrew || letter === ownCrew || !crewCovered(letter);
    // Who owns the board decides whether a plain supervisor may save it live (checked again where the write happens, because a plan board turns into a live board by itself when its shift starts).
    const mayWorkLiveOf = (sup: any) => !sup || (!!myId && String(getField(sup, 'craa5__aa_employeeid') || "") === myId) || mayWorkLive(crewOfPerson(sup));
    const crewIsLive = (letter: string) => !clockCrew || letter === clockCrew || letter === upNextCrew;
    const crewWhen = (letter: string) => letter !== clockCrew && letter === upNextCrew && upNextStartMs > 0 ? `starts ${clockTime(upNextStartMs)}` : 'is on now';   // the crew starting within the hour is not on yet
    const liveOk = crewIsLive(shownCrew) && mayWorkLive(shownCrew) && mayWorkLiveOf(activeSupervisorObj);
