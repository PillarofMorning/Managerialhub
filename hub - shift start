        const shiftLeads = crewOf(sup, allEmployees, currentShift).leads;
        const idOf = (e: any) => getField(e, 'craa5__aa_employeeid') || getField(e, 'craa5_aa_employeeid');
        const nl = new Set<string>(), na = new Set<string>(selectedAreaIds), aa: any = {}, as: any = {}, ad: any = {}, est: any = {}, cl: any[] = [], ca: any[] = [], ce: any[] = [];
        const activeEmpRecords = new Map(), latestAreaState = new Map(), latestOpenArea = new Map();
        // Replay oldest to newest: a finished row takes the person off the board, an open row puts them (back) on it.
        [...tr].sort(byTaskTime).forEach(r => {
            const id = String(getField(r, 'craa5_id') || "").trim(), area = String(getField(r, 'craa5_area') || "").trim();
            if (area) { latestAreaState.set(normText(area), r); if (!isTaskDone(r)) latestOpenArea.set(normText(area), r); }
            if (id && !id.toLowerCase().includes('unassigned')) {
                const guid = String(getField(r, 'craa5__aaemp_guid') || "").toLowerCase(), nameKey = normText(id), empKey = guid || nameKey;
