import React, { useState, useMemo, useEffect, useRef } from 'react';

// --- CIRCUMVENTION: Replaced lucide-react with inline SVGs ---
// This ensures the app is 100% self-contained for PowerApps and doesn't require a package bundler.
const SvgIcon = ({ children, className = "w-6 h-6", ...props }: any) => (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className} {...props}>
    {children}
  </svg>
);

const ChevronDown = (props: any) => <SvgIcon {...props}><path d="m6 9 6 6 6-6"/></SvgIcon>;
const ChevronRight = (props: any) => <SvgIcon {...props}><path d="m9 18 6-6-6-6"/></SvgIcon>;
const ClipboardCopy = (props: any) => <SvgIcon {...props}><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></SvgIcon>;
const CheckCircle2 = (props: any) => <SvgIcon {...props}><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></SvgIcon>;
const Settings2 = (props: any) => <SvgIcon {...props}><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="7" r="3"/><circle cx="8" cy="17" r="3"/></SvgIcon>;
const AlertCircle = (props: any) => <SvgIcon {...props}><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></SvgIcon>;
const Save = (props: any) => <SvgIcon {...props}><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></SvgIcon>;
const Users = (props: any) => <SvgIcon {...props}><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></SvgIcon>;
const Plus = (props: any) => <SvgIcon {...props}><path d="M5 12h14"/><path d="M12 5v14"/></SvgIcon>;
const Trash2 = (props: any) => <SvgIcon {...props}><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></SvgIcon>;
const Loader = (props: any) => <SvgIcon {...props} className={`animate-spin ${props.className}`}><path d="M21 12a9 9 0 1 1-6.219-8.56"/></SvgIcon>;
// --- END CIRCUMVENTION ---

// --- UTILITIES ---
function safeGetXrm() { if (typeof window === 'undefined') return null; if ((window as any).Xrm) return (window as any).Xrm; try { if (window.parent && (window.parent as any).Xrm) return (window.parent as any).Xrm; } catch (e) {} return null; }
function getWebApi(props?: any) { const xrm = safeGetXrm(); if (xrm?.WebApi) return xrm.WebApi; if (props?.context?.webAPI) return props.context.webAPI; return props?.webAPI || null; }
const asyncRace = async (p: any, ms: number, l: string) => { if (!p) return Promise.reject(new Error(`No query for ${l}`)); return Promise.race([Promise.resolve(p), new Promise((_, r) => setTimeout(() => r(new Error(`TIMEOUT: ${l}`)), ms))]); };

const getField = (obj: any, fn: string) => {
    if (!obj) return undefined; if (obj[fn] !== undefined) return obj[fn];
    const lf = fn.toLowerCase(), k = Object.keys(obj).find(x => x.toLowerCase() === lf);
    return k ? obj[k] : undefined;
};

const CLEAN_STEPS = ["Dry Clean", "Rinse", "Foam", "Rinse", "Post Clean Inspect", "Sanitize", "FSQ Inspection", "Swab"];
const ITEMS_PER_PAGE = 3;
const DEAD_APIS = new Set<string>();

// Dataverse Fetch Fallback Engine
async function fetchFallbackRecords(entityNames: string | string[], props?: any): Promise<any[]> {
    const webApi = getWebApi(props); const names = Array.isArray(entityNames) ? entityNames : [entityNames];
    for (const en of names) {
        if (webApi && !DEAD_APIS.has('WebApi')) {
            try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(en, `?$filter=statecode eq 0&$top=5000`), 8000, `WebApi ${en}`); if (res?.entities) return res.entities; } catch (e: any) { if (e.message.includes('TIMEOUT')) DEAD_APIS.add('WebApi'); }
        }
        if (props?.dataApi?.queryTable && !DEAD_APIS.has('queryTable')) {
            try { const res: any = await asyncRace(props.dataApi.queryTable(en, { filter: "statecode eq 0", top: 5000 }), 8000, `queryTable ${en}`); if (res?.rows) return res.rows; } catch (e: any) { if (e.message.includes('TIMEOUT')) DEAD_APIS.add('queryTable'); }
        }
    }
    return [];
}

// --- DYNAMIC STATUS SLIDER WITH N/A SUPPORT ---
const StatusSlider = ({ value = 0, onChange, label, className = "", isNa, onNaToggle, naReason, onNaReasonChange }: any) => {
  const percentage = (value / (CLEAN_STEPS.length - 1)) * 100;
  
  return (
    <div className={`flex flex-col w-full ${className}`}>
      <div className="flex justify-between items-center mb-2">
        <span className="text-sm font-semibold text-slate-700 flex items-center gap-3">
            {label}
            <label className="flex items-center gap-1 cursor-pointer text-xs font-bold text-slate-500 bg-white px-2 py-0.5 rounded border border-slate-200 shadow-sm hover:bg-slate-50 transition-colors">
                <input type="checkbox" checked={isNa} onChange={e => onNaToggle(e.target.checked)} className="accent-slate-500" />
                N/A
            </label>
        </span>
        {!isNa && (
            <span className="text-xs font-bold px-2 py-1 bg-blue-100 text-blue-800 rounded-full border border-blue-200">
              {CLEAN_STEPS[value]} ({value}/7)
            </span>
        )}
      </div>
      
      {isNa ? (
          <div className="animate-in fade-in zoom-in duration-200">
            <input 
                type="text" 
                placeholder="Reason for N/A (Optional)..." 
                value={naReason}
                onChange={e => onNaReasonChange(e.target.value)}
                className="w-full p-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-400 outline-none bg-slate-50 transition-all"
            />
          </div>
      ) : (
          <div className="animate-in fade-in duration-200">
              <input 
                type="range" 
                min="0" 
                max={CLEAN_STEPS.length - 1} 
                value={value} 
                onChange={onChange}
                className="w-full h-3 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
                style={{
                  background: `linear-gradient(to right, #2563eb 0%, #2563eb ${percentage}%, #e2e8f0 ${percentage}%, #e2e8f0 100%)`
                }}
              />
              <div className="flex justify-between text-[10px] text-slate-400 mt-1 px-1">
                <span>Start</span>
                <span>Finish</span>
              </div>
          </div>
      )}
    </div>
  );
};

export default function AreaReportsApp(props: any) {
  // Initialization State
  const [isInitializing, setIsInitializing] = useState(true);
  const [liveAreas, setLiveAreas] = useState<any[]>([]);

  // Tracks which areas the supervisor is actively monitoring
  const [reportAreaIds, setReportAreaIds] = useState<Set<string>>(new Set()); 
  
  // Tracks the numeric slider value (0-7) for Areas AND Equipment
  const [reportSteps, setReportSteps] = useState<Record<string, number>>({});
  
  // Tracks N/A statuses and reasons for equipment
  const [naStatus, setNaStatus] = useState<Record<string, boolean>>({});
  const [naReasons, setNaReasons] = useState<Record<string, string>>({});

  // Tracks which Area cards have their equipment lists toggled open
  const [expandedReports, setExpandedReports] = useState<Set<string>>(new Set());

  // Pagination State
  const [currentPage, setCurrentPage] = useState(1);

  // Headcount data
  const [headcount, setHeadcount] = useState({ scheduled: 25, actual: 20, openSpots: 5 });
  const [attendance, setAttendance] = useState<any[]>([]);
  const [isSaving, setIsSaving] = useState(false);

  // UI state for showing report modal
  const [showReport, setShowReport] = useState(false);
  const [reportText, setReportText] = useState("");
  const [copied, setCopied] = useState(false);

  // --- DATAVERSE HYDRATION ---
  useEffect(() => {
      const bootSequence = async () => {
          setIsInitializing(true);
          try {
              // 1. Fetch Master Data
              const fetchedAreas = await fetchFallbackRecords(["craa5_aa_mss_area", "craa5_aa_mss_areas"], props);
              const fetchedAssets = await fetchFallbackRecords(["craa5_aa_assets", "craa5_aa_asset", "craa5_aa_assetses"], props);
              
              // 2. Fetch 16-Hour Task History to map Shift Active Areas
              let fetchedTasks: any[] = [];
              const sixteenHoursAgoIso = new Date(Date.now() - 16 * 60 * 60 * 1000).toISOString();
              const xrm = safeGetXrm();
              
              if (xrm?.WebApi && !DEAD_APIS.has('WebApi')) {
                  const fetchXml = `<fetch top='5000'><entity name='craa5_taskassignment'><attribute name='craa5_area'/><filter><condition attribute='createdon' operator='last-x-hours' value='16'/></filter></entity></fetch>`.replace(/\s+/g, ' ');
                  try { 
                      const res:any = await asyncRace(xrm.WebApi.retrieveMultipleRecords("craa5_taskassignment", `?fetchXml=${encodeURIComponent(fetchXml)}`), 8000, "Tasks WebApi"); 
                      if (res?.entities) fetchedTasks = res.entities; 
                  } catch (e:any) { if (e.message.includes('TIMEOUT')) DEAD_APIS.add('WebApi'); }
              }
              if (fetchedTasks.length === 0 && props.dataApi?.queryTable && !DEAD_APIS.has('queryTable')) {
                   try { 
                       const res:any = await asyncRace(props.dataApi.queryTable("craa5_taskassignment", { filter: `createdon ge '${sixteenHoursAgoIso}'`, top: 5000 }), 8000, "Tasks queryTable"); 
                       if (res?.rows) fetchedTasks = res.rows; 
                   } catch (e:any) { if (e.message.includes('TIMEOUT')) DEAD_APIS.add('queryTable'); }
              }

              // Extract unique area names worked on this shift
              const shiftActiveAreaNames = new Set(fetchedTasks.map(t => (getField(t, 'craa5_area') || "").toLowerCase().trim()).filter(n => n.length > 0));
              
              const autoSelectedIds = new Set<string>();

              // 3. Map Assets to Areas and Auto-Select Active Rooms
              const processedAreas = fetchedAreas.map(a => {
                  const aName = getField(a, 'craa5_area') || "";
                  const aId = getField(a, 'craa5_aa_mss_areaid');
                  
                  if (shiftActiveAreaNames.has(aName.toLowerCase().trim())) {
                      autoSelectedIds.add(aId);
                  }

                  const relAssets = fetchedAssets.filter(ast => {
                      const astArea = (getField(ast, 'craa5_areaname') || getField(ast, '_craa5_area_lookup_value') || "").toLowerCase();
                      return astArea.includes(aName.toLowerCase().trim());
                  }).map(ast => ({
                      id: getField(ast, 'craa5_aa_assetsid'),
                      name: getField(ast, 'craa5_equipmentidentifier') || "Unknown Equipment"
                  }));
                  
                  return { id: aId, name: aName, assets: relAssets };
              });

              setLiveAreas(processedAreas);
              setReportAreaIds(autoSelectedIds);

          } catch (err) {
              console.error("Initialization failed", err);
          } finally {
              setIsInitializing(false);
          }
      };

      bootSequence();
  }, [props]);

  // --- MEMOIZED ACTIVE AREAS FOR PAGINATION ---
  const activeAreasList = useMemo(() => {
      return liveAreas.filter(a => reportAreaIds.has(a.id));
  }, [reportAreaIds, liveAreas]);

  const totalPages = Math.max(1, Math.ceil(activeAreasList.length / ITEMS_PER_PAGE));

  // Ensure current page is valid if areas are removed
  useEffect(() => {
      if (currentPage > totalPages) {
          setCurrentPage(totalPages);
      }
  }, [totalPages, currentPage]);

  const paginatedAreas = activeAreasList.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);

  const toggleAreaActive = (areaId: string) => {
    setReportAreaIds(prev => {
      const next = new Set(prev);
      if (next.has(areaId)) next.delete(areaId);
      else next.add(areaId);
      return next;
    });
  };

  const toggleExpand = (areaId: string) => {
    setExpandedReports(prev => {
      const next = new Set(prev);
      if (next.has(areaId)) next.delete(areaId);
      else next.add(areaId);
      return next;
    });
  };

  // The Master Slider Logic (The Magic)
  const handleAreaSliderChange = (areaId: string, assets: any[], newValue: number) => {
    setReportSteps(prev => {
      // Update the main Area
      const nextSteps = { ...prev, [areaId]: newValue };
      
      // Cascade the update to all child Equipment (Ignoring N/A equipment)
      assets.forEach(eq => {
        if (!naStatus[eq.id]) {
            nextSteps[eq.id] = newValue;
        }
      });
      
      return nextSteps;
    });
  };

  const handleEquipmentSliderChange = (eqId: string, newValue: number) => {
    setReportSteps(prev => ({
      ...prev,
      [eqId]: newValue
    }));
  };

  // --- NEW FUNCTIONS FOR ATTENDANCE & DATAVERSE ---
  const addAttendanceRecord = () => {
    setAttendance([...attendance, { id: Date.now().toString(), name: '', status: 'PTO', comment: '' }]);
  };

  const updateAttendance = (id: string, field: string, value: string) => {
    setAttendance(attendance.map(a => a.id === id ? { ...a, [field]: value } : a));
  };

  const removeAttendance = (id: string) => {
    setAttendance(attendance.filter(a => a.id !== id));
  };

  const constructReportString = () => {
    let inProgressLines: string[] = [];
    let completedAreas: string[] = [];

    activeAreasList.forEach(area => {
      const areaStep = reportSteps[area.id] || 0;
      let isAreaComplete = areaStep === CLEAN_STEPS.length - 1;
      
      let eqLines: string[] = [];
      area.assets.forEach((eq: any) => {
         const isNa = naStatus[eq.id] || false;
         const eqStep = reportSteps[eq.id] || 0;
         
         if (isNa) {
             eqLines.push(`    - ${eq.name}: N/A (Reason: ${naReasons[eq.id] || "None provided"})`);
         } else {
             if (eqStep !== CLEAN_STEPS.length - 1) isAreaComplete = false;
             eqLines.push(`    - ${eq.name}: ${CLEAN_STEPS[eqStep]}`);
         }
      });

      if (areaStep !== CLEAN_STEPS.length - 1) isAreaComplete = false;

      if (isAreaComplete) {
          completedAreas.push(area.name);
      } else {
          inProgressLines.push(`📍 ${area.name} - Master Status: ${CLEAN_STEPS[areaStep]}`);
          if (eqLines.length > 0) {
              inProgressLines.push(...eqLines);
          } else {
              inProgressLines.push(`    - No equipment tracked.`);
          }
          inProgressLines.push(''); // Spacing
      }
    });

    let textOut = "==== SANITATION SHIFT REPORT ====\n\n";
    
    textOut += "--- SHIFT OVERVIEW ---\n";
    textOut += `Scheduled: ${headcount.scheduled} | Actual: ${headcount.actual} | Open Spots: ${headcount.openSpots}\n`;
    
    const validAtt = attendance.filter(a => a.name.trim() !== "");
    if (validAtt.length > 0) {
      textOut += "Exceptions:\n";
      validAtt.forEach(a => {
        textOut += `  - ${a.name} (${a.status}) ${a.comment ? '- ' + a.comment : ''}\n`;
      });
    }
    textOut += "\n";
    
    textOut += "--- AREA PROGRESS ---\n";
    if (inProgressLines.length > 0) {
      textOut += inProgressLines.join("\n");
    } else {
      textOut += "All active areas are completed.\n\n";
    }
    
    if (completedAreas.length > 0) {
      textOut += `--- COMPLETED ---\n✅ ${completedAreas.join(", ")} and all associated equipment complete.\n`;
    }

    return textOut;
  };

  const generateReport = () => {
    const textOut = constructReportString();
    setReportText(textOut);
    setShowReport(true);
    setCopied(false);
  };

  const handleSaveToDataverse = async () => {
    setIsSaving(true);
    const handoffText = constructReportString();
    
    // --- FLATTENED JSON PAYLOAD FOR DATAVERSE ---
    const payload = {
        craa5_name: `Sanitation Report - ${new Date().toLocaleDateString()}`,
        craa5_scheduledheadcount: headcount.scheduled,
        craa5_actualcrew: headcount.actual,
        craa5_openspots: headcount.openSpots,
        craa5_handofftext: handoffText,
        
        // Serializing the complex child arrays into JSON strings to avoid child table limitations
        craa5_attendancejson: JSON.stringify(attendance),
        craa5_equipmentjson: JSON.stringify(
            activeAreasList.map(area => ({
                areaName: area.name,
                masterStep: reportSteps[area.id] || 0,
                equipment: area.assets.map((eq: any) => ({
                    eqName: eq.name,
                    step: reportSteps[eq.id] ?? reportSteps[area.id] ?? 0,
                    isNa: naStatus[eq.id] || false,
                    naReason: naReasons[eq.id] || ""
                }))
            }))
        )
    };

    try {
        const xrm = safeGetXrm();
        if (xrm?.WebApi) {
            await xrm.WebApi.createRecord("craa5_sanitationshiftreport", payload);
            alert("Successfully saved flattened report to Dataverse!");
        } else {
            console.log("Mock Save Payload:", payload);
            alert("Data prepared for Dataverse! Open your browser console to see the exact flattened JSON payload generated.");
        }
    } catch (e) {
        console.error("Save failed", e);
        alert("Failed to save to Dataverse.");
    } finally {
        setIsSaving(false);
    }
  };

  // --- CIRCUMVENTION: iFrame/PowerApps safe clipboard copy ---
  const copyToClipboard = async () => {
    try {
      if (navigator?.clipboard?.writeText) {
        await navigator.clipboard.writeText(reportText);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = reportText;
        textArea.style.position = "fixed";
        textArea.style.left = "-999999px";
        textArea.style.top = "-999999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        const successful = document.execCommand('copy');
        textArea.remove();
        if (!successful) throw new Error("Fallback copy failed");
      }
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      console.error("Clipboard copy failed:", err);
      alert("Clipboard access is restricted in this environment. Please click inside the text box and press Ctrl+C to copy manually.");
    }
  };

  if (isInitializing) {
      return (
          <div className="min-h-screen bg-slate-50 flex flex-col items-center justify-center">
              <Loader className="w-12 h-12 text-blue-600 mb-4" />
              <h2 className="text-xl font-bold text-slate-700">Loading Shift Data...</h2>
              <p className="text-slate-500">Cross-referencing Task Assignments</p>
          </div>
      );
  }

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans p-4 md:p-8">
      
      <div className="max-w-6xl mx-auto">
        {/* Header Section */}
        <header className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div>
            <h1 className="text-2xl md:text-3xl font-extrabold text-slate-900 flex items-center gap-2">
              <Settings2 className="text-blue-600 h-8 w-8" />
              Area Reports System
            </h1>
            <p className="text-slate-500 mt-1">Live Sanitation Tracking & Hand-off generation</p>
          </div>
          <div className="flex flex-col sm:flex-row gap-3">
            <button 
              onClick={generateReport}
              className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md shadow-blue-200 transition-all active:scale-95 flex items-center gap-2 justify-center"
            >
              <ClipboardCopy className="w-5 h-5" />
              Generate Shift Report
            </button>
            <button 
              onClick={handleSaveToDataverse}
              disabled={isSaving}
              className={`${isSaving ? 'bg-slate-400' : 'bg-emerald-600 hover:bg-emerald-700'} text-white px-6 py-3 rounded-xl font-semibold shadow-md shadow-emerald-200 transition-all active:scale-95 flex items-center gap-2 justify-center`}
            >
              <Save className="w-5 h-5" />
              {isSaving ? 'Saving...' : 'Save to Dataverse'}
            </button>
          </div>
        </header>

        {/* --- NEW HEADCOUNT & ATTENDANCE SECTION --- */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6">
          <div className="flex items-center gap-2 mb-4">
            <Users className="w-6 h-6 text-indigo-600" />
            <h2 className="text-xl font-bold text-slate-800">Shift Headcount & Attendance</h2>
          </div>
          
          <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
            {/* Headcount Summary */}
            <div className="md:col-span-1 bg-indigo-50 rounded-xl p-4 border border-indigo-100 flex flex-col justify-center">
              <div className="flex justify-between items-center mb-2">
                <span className="text-sm font-semibold text-indigo-900">Scheduled:</span>
                <span className="font-bold text-indigo-700">{headcount.scheduled}</span>
              </div>
              <div className="flex justify-between items-center mb-2">
                <span className="text-sm font-semibold text-indigo-900">Actual Crew:</span>
                <span className="font-bold text-emerald-600 text-lg">{headcount.actual}</span>
              </div>
              <div className="flex justify-between items-center pt-2 border-t border-indigo-200/50">
                <span className="text-sm font-semibold text-indigo-900">Open Spots:</span>
                <span className="font-bold text-rose-600">{headcount.openSpots}</span>
              </div>
            </div>

            {/* Attendance Tracker */}
            <div className="md:col-span-3">
              <div className="flex justify-between items-end mb-3">
                <span className="text-sm font-bold text-slate-500 uppercase tracking-wider">Exceptions Log</span>
                <button 
                  onClick={addAttendanceRecord}
                  className="text-xs flex items-center gap-1 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-semibold transition-colors"
                >
                  <Plus className="w-3 h-3" /> Add Exception
                </button>
              </div>
              
              {attendance.length === 0 ? (
                <div className="text-center p-4 border-2 border-dashed border-slate-200 rounded-xl text-slate-400 text-sm font-medium">
                  No attendance exceptions logged yet.
                </div>
              ) : (
                <div className="flex flex-col gap-2">
                  {attendance.map((record) => (
                    <div key={record.id} className="flex flex-wrap md:flex-nowrap items-center gap-2 bg-slate-50 p-2 rounded-lg border border-slate-200 focus-within:border-indigo-300 transition-colors">
                      <input 
                        type="text" 
                        placeholder="Employee Name"
                        value={record.name}
                        onChange={(e) => updateAttendance(record.id, 'name', e.target.value)}
                        className="flex-1 min-w-[150px] text-sm p-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-indigo-500 outline-none bg-white"
                      />
                      <select
                        value={record.status}
                        onChange={(e) => updateAttendance(record.id, 'status', e.target.value)}
                        className="w-32 text-sm p-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-indigo-500 outline-none bg-white font-semibold text-slate-700"
                      >
                        <option value="PTO">PTO</option>
                        <option value="LATE">LATE</option>
                        <option value="SICK">SICK</option>
                        <option value="NCNS">NCNS</option>
                      </select>
                      <input 
                        type="text" 
                        placeholder="Comments (optional)..."
                        value={record.comment}
                        onChange={(e) => updateAttendance(record.id, 'comment', e.target.value)}
                        className="flex-[2] min-w-[200px] text-sm p-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-indigo-500 outline-none bg-white"
                      />
                      <button 
                        onClick={() => removeAttendance(record.id)}
                        title="Remove Record"
                        className="p-2 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          
          {/* Sidebar: Area Selector */}
          <div className="lg:col-span-1">
            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sticky top-8">
              <h2 className="text-sm uppercase tracking-wider font-bold text-slate-400 mb-4 flex items-center gap-2">
                Active Areas
                <span className="bg-slate-100 text-slate-600 py-0.5 px-2 rounded-full text-xs">
                  {reportAreaIds.size} / {liveAreas.length}
                </span>
              </h2>
              <div className="flex flex-col gap-2 max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                {liveAreas.map(area => {
                  const isActive = reportAreaIds.has(area.id);
                  return (
                    <button
                      key={area.id}
                      onClick={() => toggleAreaActive(area.id)}
                      className={`flex items-center justify-between w-full text-left px-4 py-3 rounded-xl border transition-all ${
                        isActive 
                          ? 'bg-blue-50 border-blue-200 text-blue-900 shadow-inner' 
                          : 'bg-white border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-600'
                      }`}
                    >
                      <span className={`font-semibold ${isActive ? 'text-blue-700' : ''}`}>
                        {area.name}
                      </span>
                      {isActive && <CheckCircle2 className="w-5 h-5 text-blue-600 shrink-0" />}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Main Content: Tracking Cards */}
          <div className="lg:col-span-3 flex flex-col gap-5">
            {reportAreaIds.size === 0 ? (
              <div className="bg-white border border-dashed border-slate-300 rounded-2xl p-12 text-center flex flex-col items-center justify-center text-slate-500">
                <AlertCircle className="w-12 h-12 mb-4 text-slate-300" />
                <h3 className="text-xl font-bold text-slate-700 mb-2">No Areas Selected</h3>
                <p>Select areas from the sidebar to begin tracking sanitation steps.</p>
              </div>
            ) : (
              <>
                  {paginatedAreas.map(area => {
                    const isExpanded = expandedReports.has(area.id);
                    const areaStep = reportSteps[area.id] || 0;
                    
                    // Calculate if waiting on equipment (ignoring N/A)
                    const laggingCount = areaStep === 7 
                      ? area.assets.filter((eq: any) => {
                          if (naStatus[eq.id]) return false;
                          return (reportSteps[eq.id] || 0) < 7;
                        }).length 
                      : 0;

                    return (
                      <div key={area.id} className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition-all">
                        
                        {/* Area Header (Master Control) */}
                        <div className="bg-[#004aad] text-white p-5 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
                          <div className="flex items-center gap-4 flex-1">
                            <button 
                              onClick={() => toggleExpand(area.id)}
                              className="p-2 hover:bg-white/10 rounded-lg transition-colors"
                            >
                              {isExpanded ? <ChevronDown className="w-6 h-6" /> : <ChevronRight className="w-6 h-6" />}
                            </button>
                            <div>
                              <h2 className="text-2xl font-black tracking-wide">{area.name}</h2>
                              <div className="flex gap-2 mt-1">
                                <span className="text-xs bg-white/20 px-2 py-1 rounded">
                                  {area.assets.length} Equipment Assets
                                </span>
                                {laggingCount > 0 && (
                                  <span className="text-xs bg-amber-500/90 text-amber-50 px-2 py-1 rounded font-semibold flex items-center gap-1">
                                    <AlertCircle className="w-3 h-3" />
                                    Waiting on {laggingCount} items
                                  </span>
                                )}
                              </div>
                            </div>
                          </div>

                          {/* Master Slider */}
                          <div className="w-full md:w-1/2 lg:w-2/5 bg-white/10 p-4 rounded-xl border border-white/20 shadow-inner backdrop-blur-sm">
                            <div className="flex justify-between items-center mb-2">
                              <span className="text-sm font-bold text-white uppercase tracking-wider">Master Control</span>
                              <span className="text-xs font-bold px-2 py-1 bg-white text-[#004aad] rounded-full shadow-sm">
                                {CLEAN_STEPS[areaStep]}
                              </span>
                            </div>
                            <input 
                              type="range" 
                              min="0" 
                              max={CLEAN_STEPS.length - 1} 
                              value={areaStep} 
                              onChange={(e) => handleAreaSliderChange(area.id, area.assets, parseInt(e.target.value))}
                              className="w-full h-3 bg-black/20 rounded-lg appearance-none cursor-pointer accent-white"
                            />
                          </div>
                        </div>

                        {/* Expandable Equipment List (Scrollable to prevent frame clipping) */}
                        {isExpanded && (
                          <div className="divide-y divide-slate-100 bg-slate-50/50 p-2 max-h-[45vh] overflow-y-auto overscroll-contain shadow-inner">
                            {area.assets.map((asset: any) => {
                              const eqStep = reportSteps[asset.id] || 0;
                              const isNa = naStatus[asset.id] || false;
                              const naReason = naReasons[asset.id] || '';

                              return (
                                <div key={asset.id} className="p-4 flex flex-col md:flex-row items-start md:items-center gap-4 hover:bg-white transition-colors rounded-xl">
                                  <div className="w-full md:w-1/3 flex items-center gap-3">
                                    <div className={`w-2 h-2 rounded-full shrink-0 ${isNa ? 'bg-slate-300' : eqStep === 7 ? 'bg-green-500' : 'bg-blue-400'}`}></div>
                                    <span className={`font-semibold ${isNa ? 'text-slate-400 line-through' : 'text-slate-700'}`}>{asset.name}</span>
                                  </div>
                                  <div className="w-full md:w-2/3">
                                    <StatusSlider 
                                      value={eqStep} 
                                      onChange={(e: any) => handleEquipmentSliderChange(asset.id, parseInt(e.target.value))}
                                      label="Asset Status"
                                      isNa={isNa}
                                      onNaToggle={(checked: boolean) => setNaStatus(p => ({...p, [asset.id]: checked}))}
                                      naReason={naReason}
                                      onNaReasonChange={(val: string) => setNaReasons(p => ({...p, [asset.id]: val}))}
                                    />
                                  </div>
                                </div>
                              );
                            })}
                            {area.assets.length === 0 && (
                                <div className="p-6 text-center text-slate-500 italic">No equipment assets found for this area in Dataverse.</div>
                            )}
                          </div>
                        )}
                      </div>
                    );
                  })}

                  {/* PAGINATION CONTROLS */}
                  {activeAreasList.length > ITEMS_PER_PAGE && (
                      <div className="flex justify-between items-center bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mt-2">
                          <button 
                              onClick={() => setCurrentPage(p => Math.max(1, p - 1))}
                              disabled={currentPage === 1}
                              className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold disabled:opacity-50 transition-colors"
                          >
                              Previous
                          </button>
                          <span className="font-bold text-slate-600">
                              Page {currentPage} of {totalPages}
                          </span>
                          <button 
                              onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}
                              disabled={currentPage === totalPages}
                              className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold disabled:opacity-50 transition-colors"
                          >
                              Next
                          </button>
                      </div>
                  )}
              </>
            )}
          </div>
        </div>
      </div>

      {showReport && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-200 flex flex-col max-h-[90vh]">
            <div className="bg-slate-100 p-4 border-b border-slate-200 flex justify-between items-center">
              <h3 className="font-bold text-slate-800 text-lg flex items-center gap-2">
                <ClipboardCopy className="w-5 h-5 text-slate-500" />
                Shift Handoff Report
              </h3>
              <button onClick={() => setShowReport(false)} className="text-slate-400 hover:text-slate-600 p-2">
                ✕
              </button>
            </div>
            
            <div className="p-6 overflow-y-auto bg-slate-50 flex-1">
              <textarea 
                readOnly
                value={reportText}
                className="w-full h-64 p-4 text-sm font-mono bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-inner"
              />
            </div>
            
            <div className="p-4 bg-white border-t border-slate-200 flex justify-end gap-3">
              <button 
                onClick={() => setShowReport(false)}
                className="px-4 py-2 text-slate-600 font-semibold hover:bg-slate-100 rounded-lg transition-colors"
              >
                Close
              </button>
              <button 
                onClick={copyToClipboard}
                className={`px-6 py-2 text-white font-semibold rounded-lg shadow-sm transition-all flex items-center gap-2 ${
                  copied ? 'bg-green-600 hover:bg-green-700' : 'bg-blue-600 hover:bg-blue-700'
                }`}
              >
                {copied ? <CheckCircle2 className="w-4 h-4" /> : <ClipboardCopy className="w-4 h-4" />}
                {copied ? 'Copied to Clipboard!' : 'Copy to Clipboard'}
              </button>
            </div>
          </div>
        </div>
      )}
      
    </div>
  );
}
