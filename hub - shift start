    }, [rememberedTried, histNow, histStatus.state, prd, prdKey, prdSettled, rememberedFresh, prdApplied, prdWindow, selectedSupervisorId, hasAutoAssignedEveryday, employees, supervisors]);

    // Rooms that are short of their usual headcount, and who could fill them (the people who have worked the room, strongest first, each used once).
