    <div className="mb-1">
        <h1 className="text-xl font-black uppercase tracking-widest" style={{ color: BRAND.blueDark }}>{children}</h1>
        {sub && <Text size={300} color="neutralSecondary" block>{sub}</Text>}
    </div>
);

const Grid = ({ items, columns, selectionMode, selectedItems, onSelectionChange }: any) => (
    <DataGrid items={items} columns={columns} selectionMode={selectionMode} getRowId={(item: any) => getField(item, 'craa5__aa_employeeid')} selectedItems={selectedItems} onSelectionChange={onSelectionChange} className="bg-white rounded-xl border border-slate-200 shadow-sm">
        <DataGridHeader style={{ background: BRAND.blueSoft }}><DataGridRow>{({ renderHeaderCell }: any) => <DataGridHeaderCell>{renderHeaderCell()}</DataGridHeaderCell>}</DataGridRow></DataGridHeader>
        <DataGridBody>{({ item }: any) => <DataGridRow key={getField(item, 'craa5__aa_employeeid')} className="cursor-pointer">{({ renderCell }: any) => <DataGridCell>{renderCell(item)}</DataGridCell>}</DataGridRow>}</DataGridBody>
