}
const ASG_REFRESH_MS = 60000;
const PREV_SHIFT_MIN_MS = 2 * 3600000, PREV_SHIFT_MAX_MS = 16 * 3600000;   // the shift before this one started 2 to 16 hours before it
type AsgRow = { id: string; key: string; guid: string; equipment: string; area: string; room: string; boardId: string; shiftDate: string; crew: string; team: string; kind: string; people: string[]; names: string; plannedStart: string; minutes: number | null; order: number; pinned: boolean; source: string; updatedBy: string; rev: number };
