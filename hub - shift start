        });

        const ensureAreaAndLead = (r: any) => {
            const ln = String(getField(r, 'craa5_lead') || "").trim(), an = String(getField(r, 'craa5_area') || "").trim();
            if (!ln || !an) return null;
            // The area's status and notes come from its newest open row, so a finished row never turns a working area into "Completed" (Save would close it).
            const latestAreaRec = latestOpenArea.get(normText(an)) || r;
            const stat = getField(latestAreaRec, 'craa5_whatisbeingdone') || getField(latestAreaRec, 'craa5__currentstatus') || "";
            const nts = getField(latestAreaRec, 'craa5_whatislefttodo') || getField(latestAreaRec, 'craa5__future_or_notes') || "";
            const isSup = sameText(supName, ln);
            let lId = isSup ? selectedSupervisorId : "";
            if (!isSup) {
                // A lead who isn't one of the shift's leads (overtime, another crew) joins as a custom lead so their column shows.
                let lo = [...shiftLeads, ...customLeads, ...cl].find(l => sameText(getField(l, 'craa5_name'), ln));
                if (!lo) { lo = allEmployees.find(e => sameText(getField(e, 'craa5_name'), ln)) || { craa5__aa_employeeid: `pl_${Date.now()}_${Math.random()}`, craa5_name: ln, craa5_role: 256000001 }; cl.push(lo); }
                lId = getField(lo, 'craa5__aa_employeeid'); nl.add(lId);
            }
            if (!lId) return null;
            let ao = [...areas, ...customAreas, ...ca].find(a => sameText(renderSafe(getField(a, 'craa5_area')), an));
            if (!ao) { ao = { craa5_aa_mss_areaid: `pa_${Date.now()}_${Math.random()}`, craa5_area: an }; ca.push(ao); }
            const aId = getField(ao, 'craa5_aa_mss_areaid');
            na.add(aId); aa[aId] = lId;
