            return out;
        };
        return { rooms, people, free: availableStaff.map(e => String(getField(e, 'craa5__aa_employeeid') || "")).filter(Boolean), supId: selectedSupervisorId || "", plan: boardMode === 'next', usual, pick };
    };
    const chatRead = (text: string) => { const b = buildChatBoard(); return chatPlan(chatParse(text, { rooms: b.rooms, people: b.people, supId: b.supId }), b); };
    const chatSend = (text0?: string) => {
        const text = (text0 !== undefined ? text0 : chatText).trim(); if (!text) return;
