type BoardStatus = 'live' | 'archived' | 'failed' | 'planned' | 'used' | 'cancelled';
// What Ganttly adds to a live board (column craa5_updatesjson): each piece of equipment cleaned, and high fives / remarks.
type BoardUpdates = {
    v?: number;
    work?: { id: string; area: string; equipmentGuid: string; equipment: string; startedAt?: string | null; doneAt?: string | null; workers: { name: string; empId: string }[]; by?: string; at?: string }[];
    remarks?: { id: string; employeeId: string; employeeName: string; type: string; tag: string; text: string; givenBy: string; area: string; at: string }[];
