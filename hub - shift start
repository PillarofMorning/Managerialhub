type Tab = 'teams' | 'lines' | 'equipment' | 'manage';
const TABS: [Tab, string][] = [['teams', '1 · Teams'], ['lines', '2 · Lines'], ['equipment', '3 · Equipment'], ['manage', '4 · Manage & Update']];

export default function ShiftStartBoard(props: any) {
  const propsRef = useRef(props); propsRef.current = props;

  // Reference data
  const [phase, setPhase] = useState<'loading' | 'ready'>('loading');
  const [connected, setConnected] = useState(true);
  const [emps, setEmps] = useState<Emp[]>([]);
  const [dvLines, setDvLines] = useState<Line[]>([]);
  const [shift, setShift] = useState<ShiftWin>(() => findShift(DEFAULT_SHIFT_ROTATION, new Date()));
  const [supId, setSupId] = useState<string>("");
  const [takenBy, setTakenBy] = useState<Record<string, string>>({});   // employee name -> other team this shift
  const [loadWarning, setLoadWarning] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);

  // The board (persisted)
  const [board, setBoard] = useState<Board>(emptyBoard);
  const [dirtyTick, setDirtyTick] = useState(0);
  const [save, setSave] = useState<SaveState>({ status: 'idle' });

  // UI
  const [tab, setTab] = useState<Tab>('teams');
  const [picked, setPicked] = useState<DragItem | null>(null);
  const [poolSearch, setPoolSearch] = useState("");
  const [otSearch, setOtSearch] = useState("");
  const [lineSearch, setLineSearch] = useState("");
  const [manualName, setManualName] = useState("");
  const [copied, setCopied] = useState<'idle' | 'ok' | 'manual'>('idle');
  const [sending, setSending] = useState(false);
  const [now, setNow] = useState(() => Date.now());
  const dragRef = useRef<DragItem | null>(null);
  const updateBoxRef = useRef<HTMLTextAreaElement>(null);

  // Save loop refs
  const boardRef = useRef(board); boardRef.current = board;
  const dirtyTickRef = useRef(dirtyTick); dirtyTickRef.current = dirtyTick;
  const ctxRef = useRef<any>(null);
  const recordIdRef = useRef<string | null>(null);
  const savingRef = useRef(false), queuedRef = useRef(false), loadIdRef = useRef(0);

  const edit = useCallback((fn: (b: Board) => Board) => { setBoard(fn); setDirtyTick(t => t + 1); }, []);

  // --- DERIVED ---
  const empById = useMemo(() => new Map(emps.map(e => [e.id, e])), [emps]);
  const supervisors = useMemo(() => emps.filter(e => e.role === 'supervisor').sort(byName), [emps]);
  const sup = empById.get(supId);
  const teamName = sup?.raw || "";
  const lines = useMemo(() => [...dvLines, ...board.manualLines.map(m => ({ id: m.id, name: m.name, production: false, everyday: false, manual: true, assets: [] as Asset[] }))], [dvLines, board.manualLines]);
  const lineById = useMemo(() => new Map(lines.map(l => [l.id, l])), [lines]);
  const downLines = useMemo(() => lines.filter(l => board.downLines.includes(l.id)).sort(lineOrder), [lines, board.downLines]);
  const onBoard = useMemo(() => new Set([...board.leads, ...Object.keys(board.members), ...Object.keys(board.out)]), [board]);
  const crewRoster = useMemo(() => emps.filter(e => e.crew === shift.crew && e.role !== 'supervisor' && e.role !== 'manager'), [emps, shift.crew]);
  const pool = useMemo(() => {
    const q = norm(poolSearch);
    return [...crewRoster, ...board.overtime.map(id => empById.get(id)).filter(Boolean) as Emp[]]
      .filter((e, i, a) => a.findIndex(x => x.id === e.id) === i)
      .filter(e => !onBoard.has(e.id) && !takenBy[norm(e.raw)] && (!q || norm(e.name).includes(q)))
      .sort(byName);
  }, [crewRoster, board.overtime, empById, onBoard, takenBy, poolSearch]);
  const hiddenTaken = crewRoster.filter(e => !onBoard.has(e.id) && takenBy[norm(e.raw)]).length;
  const otCandidates = useMemo(() => {
    const q = norm(otSearch); if (q.length < 2) return [];
    return emps.filter(e => e.crew !== shift.crew && e.role !== 'supervisor' && e.role !== 'manager' && !onBoard.has(e.id) && !board.overtime.includes(e.id) && norm(e.name).includes(q)).sort(byName).slice(0, 8);
  }, [emps, otSearch, shift.crew, onBoard, board.overtime]);
  const leadCandidates = useMemo(() => [...crewRoster, ...board.overtime.map(id => empById.get(id)).filter(Boolean) as Emp[]]
    .filter(e => !board.leads.includes(e.id) && !board.out[e.id] && !takenBy[norm(e.raw)])
    .sort((a, b) => (a.role === 'lead' ? 0 : 1) - (b.role === 'lead' ? 0 : 1) || byName(a, b)), [crewRoster, board, empById, takenBy]);
  const updateText = useMemo(() => buildUpdateText({ b: board, lines, shift, team: teamName ? displayName(teamName) : '', empById, now: new Date(now) }), [board, lines, shift, teamName, empById, now]);
  const headsOnFloor = useMemo(() => uniq(downLines.flatMap(l => workersOn(board, l.id))).length, [downLines, board]);
  ctxRef.current = { lines, shift, teamName, sup, empById };

  // --- LOAD ---
  const loadBoard = useCallback(async (supervisor: Emp | undefined, sh: ShiftWin, allLines: Line[]) => {
    const loadId = ++loadIdRef.current;
    const p = propsRef.current;
    setLoadWarning(null);
    const name = supervisor && sh.crew ? `Board · ${supervisor.raw} · ${sh.crew} · ${ymd(sh.start)} ${pad(sh.start.getHours())}:00` : '';
    const since = new Date(sh.start.getTime() - PRE_SHIFT_BUFFER_MIN * 60000).toISOString().replace(/\.\d{3}Z$/, 'Z');
    const [saved, tasks] = await Promise.all([
      name ? findReportRow(p, name) : Promise.resolve(null),
      queryRecords(p, T.task, { select: ['craa5_id', 'craa5_team', 'craa5_endtime', 'createdon'], filter: `createdon ge ${since}` }),
    ]);
    if (loadId !== loadIdRef.current) return;
    // People already on another supervisor's open rows this shift
    const taken: Record<string, string> = {};
    (tasks || []).forEach(t => {
      const team = String(getField(t, 'craa5_team') || ''), who = norm(getField(t, 'craa5_id'));
      if (who && team && norm(team) !== norm(supervisor?.raw) && !getField(t, 'craa5_endtime')) taken[who] = team;
    });
    let b = emptyBoard();
    if (saved?.json) { try { b = { ...emptyBoard(), ...JSON.parse(saved.json) }; } catch (e) {} }
    else b.downLines = allLines.filter(l => l.everyday).map(l => l.id);   // everyday tasks are always on
    recordIdRef.current = saved?.id || null;
    setTakenBy(taken); setBoard(b); setDirtyTick(0);
    setSave(saved ? { status: 'saved', at: saved.modifiedon ? new Date(saved.modifiedon) : undefined } : { status: 'idle' });
    setTab(Object.keys(b.workerLine).length ? 'manage' : 'teams');
    if (saved === undefined) setLoadWarning("Couldn't load this shift's saved board. Autosave is paused so it isn't overwritten.");
  }, []);

  const boot = useCallback(async () => {
    setPhase('loading'); setNotice(null);
    const p = propsRef.current;
    try {
      if (!hasReadApi(p)) { setConnected(false); setSave({ status: 'offline' }); return; }
      const [rawEmps, rawAreas, rawAssets, rawShifts] = await Promise.all([
        queryRecords(p, T.employee, { filter: 'statecode eq 0' }),
        queryRecords(p, T.area, { select: ['craa5_aa_mss_areaid', 'craa5_area', 'craa5_production', 'craa5_everyday'], filter: 'statecode eq 0' })
          .then(r => r ?? queryRecords(p, T.area, { filter: 'statecode eq 0' })),
        queryRecords(p, T.asset, { select: ['craa5_aa_assetsid', 'craa5_equipmentidentifier', 'craa5_areaname', 'craa5_subcategory'], filter: 'statecode eq 0' })
          .then(r => r ?? queryRecords(p, T.asset, { filter: 'statecode eq 0' })),
        queryRecords(p, T.workshift, { filter: 'statecode eq 0' }),
      ]);
      const allEmps = (rawEmps || []).map(readEmployee).filter(Boolean) as Emp[];
      const allLines = buildLines(rawAreas || [], rawAssets || []);
      const rot = (rawShifts && parseWorkShiftRows(rawShifts)) || DEFAULT_SHIFT_ROTATION;
      const sh = findShift(rot, new Date());
      // Who is using the app: match the signed-in user's email to a supervisor, else the on-shift supervisor.
      let email = "";
      try { const xrm = safeGetXrm(); const us = xrm?.Utility?.getGlobalContext?.()?.userSettings; email = us?.userName || ""; } catch (e) {}
      email = email || p?.context?.userSettings?.userName || p?.userEmail || "";
      const sups = allEmps.filter(e => e.role === 'supervisor');
      const me = sups.find(s => norm(s.email) && norm(s.email) === norm(email)) || sups.find(s => s.crew === sh.crew) || sups[0];
      JOBS.clear(); allEmps.forEach(e => JOBS.set(e.id, e.job)); setConnected(true); setEmps(allEmps); setDvLines(allLines); setShift(sh); setSupId(me?.id || "");
      const missing = [!rawEmps && "employees", !rawAreas && "lines", !rawAssets && "equipment"].filter(Boolean);
      if (missing.length) setNotice(`Couldn't load ${missing.join(", ")} from Dataverse.`);
      await loadBoard(me, sh, allLines);
    } catch (e) {
      console.error("[Shift Start] load failed", e);
      setNotice(`Loading failed: ${errMsg(e)}`);
    } finally { setPhase('ready'); }
  }, [loadBoard]);

  useEffect(() => { boot(); }, [boot]);   // once; Power Apps re-sends props often

  // Clerks, admin and janitorial go to their own area automatically (inspectors join admin on nights).
  useEffect(() => {
    if (phase !== 'ready') return;
    const night = isNightShift(shift), want: Record<string, string> = {};
    [...board.leads, ...Object.keys(board.members)].forEach(id => {
      const e = empById.get(id), area = e && fixedAreaFor(e.job, night), line = area ? findAreaLine(dvLines, area) : undefined;
      if (line && !board.out[id] && board.workerLine[id] !== line.id) want[id] = line.id;
    });
    const ids = Object.keys(want); if (!ids.length) return;
    edit(b => ({ ...b, workerLine: { ...b.workerLine, ...want }, downLines: uniq([...b.downLines, ...Object.values(want)]) }));
  }, [phase, board.leads, board.members, board.workerLine, board.out, empById, dvLines, shift, edit]);

  const switchSupervisor = (id: string) => { setSupId(id); loadBoard(empById.get(id), shift, dvLines); };
  const switchCrew = (crew: string) => { const sh = { ...shift, crew, auto: false }; setShift(sh); loadBoard(sup, sh, dvLines); };

  // --- SAVE: task rows (official record) + board row (restore) ---
  const taskPayload = (empId: string, line: Line | null, reason: string | null, b: Board) => {
    const c = ctxRef.current, e: Emp | undefined = c.empById.get(empId);
    const leadId = b.leads.includes(empId) ? empId : b.members[empId];
    const lead: Emp | undefined = leadId ? c.empById.get(leadId) : undefined;
    const st = line ? lineStatus(line, b) : null;
    const eq = line ? equipmentFor(b, line) : {};
    const myEquip = line ? line.assets.filter(a => eq[a.id] === empId).map(a => `${a.name}${b.equipDone[a.id] ? ' ✓' : ''}`).join(', ') : '';
    return {
      craa5_id: e?.raw || '', craa5_email: e?.email || '', craa5_badgenumber: e?.badge || '', craa5__aaemp_guid: empId,
      craa5_lead: lead?.raw || '', craa5_leademail: lead?.email || '',
      craa5_team: c.teamName, craa5_supervisoremail: c.sup?.email || '', craa5_shift: c.shift.crew,
      craa5_area: line ? line.name : (reason || ''), craa5_equip: myEquip,
      craa5_percentagecomplete: st ? st.pct : 0, craa5_complete: !!st?.done,
      craa5_whatisbeingdone: st ? st.label : (reason || ''), craa5_whatislefttodo: st?.left || '',
    };
  };

  // Mutates `rows` as it goes, so rows created before a failure are remembered (no duplicates on retry).
  const syncTaskRows = async (api: NonNullable<ReturnType<typeof getWriteApi>>, b: Board, rows: Record<string, TaskRowRef>) => {
    const c = ctxRef.current, nowIso = new Date().toISOString();
    const want: Record<string, { lineId: string; payload: any }> = {};
    b.downLines.forEach(lid => { const line = c.lines.find((l: Line) => l.id === lid); if (line) workersOn(b, lid).forEach(id => { want[id] = { lineId: lid, payload: taskPayload(id, line, null, b) }; }); });
    Object.entries(b.out).forEach(([id, reason]) => { want[id] = { lineId: `out:${reason}`, payload: taskPayload(id, null, reason, b) }; });
    // Close rows for people who left a line or the board
    for (const [id, ref] of Object.entries(rows)) {
      if (want[id]?.lineId === ref.lineId) continue;
      const line = c.lines.find((l: Line) => l.id === ref.lineId);
      await api.update(T.task, ref.rowId, { craa5_endtime: nowIso, ...(line ? { craa5_complete: lineStatus(line, b).done } : {}) });
      delete rows[id];
    }
    for (const [id, w] of Object.entries(want)) {
      const hash = JSON.stringify(w.payload);
      if (rows[id]) { if (rows[id].hash !== hash) { await api.update(T.task, rows[id].rowId, w.payload); rows[id] = { ...rows[id], hash }; } continue; }
      const rowId = await api.create(T.task, { ...w.payload, craa5_datetimeofassignment: nowIso, craa5_starttime: nowIso });
      if (rowId) rows[id] = { rowId, lineId: w.lineId, hash };
    }
  };

  const boardName = () => { const c = ctxRef.current; return c.sup && c.shift.crew ? `Board · ${c.sup.raw} · ${c.shift.crew} · ${ymd(c.shift.start)} ${pad(c.shift.start.getHours())}:00` : ''; };

  const persist = useCallback(async () => {
    if (savingRef.current) { queuedRef.current = true; return; }
    const api = getWriteApi(propsRef.current), name = boardName();
    if (!api) { setSave({ status: 'offline' }); return; }
    if (!name) { setSave({ status: 'error', error: 'Pick a supervisor and crew first' }); return; }
    savingRef.current = true; setSave(s => ({ ...s, status: 'saving' }));
    let tick = dirtyTickRef.current;
    try {
      do {
        queuedRef.current = false; tick = dirtyTickRef.current;
        const b = boardRef.current;
        const taskRows = { ...b.taskRows };
        try { await syncTaskRows(api, b, taskRows); }
        finally { boardRef.current = { ...boardRef.current, taskRows }; setBoard(cur => ({ ...cur, taskRows })); }   // not an edit: no new autosave
        const c = ctxRef.current;
        const payload = {
          craa5_name: name,
          craa5_actualcrew: uniq(b.downLines.flatMap(l => workersOn(b, l))).length,
          craa5_scheduledheadcount: emps.filter(e => e.crew === c.shift.crew && e.role !== 'supervisor' && e.role !== 'manager').length,
          craa5_openspots: Object.keys(b.out).length,
          craa5_handofftext: buildUpdateText({ b, lines: c.lines, shift: c.shift, team: c.teamName ? displayName(c.teamName) : '', empById: c.empById, now: new Date() }),
          craa5_equipmentjson: JSON.stringify({ ...b, taskRows }),
        };
        if (!recordIdRef.current) { const existing = await findReportRow(propsRef.current, name); if (existing) recordIdRef.current = existing.id; }
        if (recordIdRef.current) await api.update(T.report, recordIdRef.current, payload);
        else recordIdRef.current = await api.create(T.report, payload);
      } while (queuedRef.current);
      setSave({ status: dirtyTickRef.current !== tick ? 'dirty' : 'saved', at: new Date() });
    } catch (e) {
      console.error("[Shift Start] save failed", e);
      setSave({ status: 'error', error: errMsg(e) });
    } finally { savingRef.current = false; }
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [emps]);

  const autosavePaused = !connected || !!loadWarning;
  useEffect(() => {
    if (!dirtyTick) return;
    setSave(s => s.status === 'saving' ? s : { ...s, status: connected ? 'dirty' : 'offline' });
    if (autosavePaused) return;
    const t = setTimeout(() => { persist(); }, AUTOSAVE_DELAY_MS);
    return () => clearTimeout(t);
  }, [dirtyTick, autosavePaused, connected, persist]);

  // --- TEAMS UPDATE ---
  const sendToTeams = async (slotKey?: string) => {
    const api = getWriteApi(propsRef.current);
    if (!api) { setNotice("Not connected to Dataverse, so nothing was sent. Use Copy instead."); return; }
    const stamp = slotKey || `${ymd(new Date())} ${pad(new Date().getHours())}:${pad(new Date().getMinutes())}`;
    const name = `Teams Update · ${teamName ? displayName(teamName) : 'Sanitation'} · ${stamp}`;
    setSending(true);
    try {
      if (slotKey && await findReportRow(propsRef.current, name)) { /* another device already sent this slot */ }
      else await api.create(T.report, { craa5_name: name, craa5_handofftext: updateText, craa5_actualcrew: headsOnFloor });
      edit(b => ({ ...b, lastSentAt: new Date().toISOString(), sentSlots: slotKey ? uniq([...b.sentSlots, slotKey]) : b.sentSlots }));
      setNotice(slotKey ? `Scheduled update for ${stamp.slice(11)} sent to Teams.` : "Update sent to Teams.");
    } catch (e) { setNotice(`Send to Teams failed: ${errMsg(e)}`); }
    finally { setSending(false); }
  };
  const lastSlot = useMemo(() => {
    const d = new Date(now); let best: Date | null = null;
    for (let back = 0; back <= 1; back++) SEND_HOURS.forEach(h => { const s = new Date(d); s.setDate(s.getDate() - back); s.setHours(h, 0, 0, 0); if (s.getTime() <= now && (!best || s > best)) best = s; });
    return best as Date | null;
  }, [now]);
  const nextSlot = useMemo(() => {
    const d = new Date(now); let best: Date | null = null;
    for (let fwd = 0; fwd <= 1; fwd++) SEND_HOURS.forEach(h => { const s = new Date(d); s.setDate(s.getDate() + fwd); s.setHours(h, 0, 0, 0); if (s.getTime() > now && (!best || s < best)) best = s; });
    return best as Date | null;
  }, [now]);
  const sendRef = useRef(sendToTeams); sendRef.current = sendToTeams;
  const triedSlots = useRef(new Set<string>());
  useEffect(() => {
    if (phase !== 'ready' || !connected || !board.autoSend || !lastSlot || sending) return;
    const key = `${ymd(lastSlot)} ${pad(lastSlot.getHours())}:00`;
    if (board.sentSlots.includes(key) || triedSlots.current.has(key) || lastSlot < shift.start || now - lastSlot.getTime() > 30 * 60000) return;
    triedSlots.current.add(key);
    sendRef.current(key);
  }, [phase, connected, board.autoSend, board.sentSlots, lastSlot, now, shift.start, sending]);
  useEffect(() => { const t = setInterval(() => setNow(Date.now()), 30000); return () => clearInterval(t); }, []);

  const handleCopy = async () => {
    if (await copyText(updateText)) { setCopied('ok'); setTimeout(() => setCopied('idle'), 2000); }
    else { setCopied('manual'); setTimeout(() => { updateBoxRef.current?.focus(); updateBoxRef.current?.select(); }, 0); }
  };

  // --- BOARD ACTIONS ---
  const addLead = (id: string) => edit(b => {
    const members = { ...b.members }; delete members[id];
    const out = { ...b.out }; delete out[id];
    return { ...b, leads: uniq([...b.leads, id]), members, out };
  });
  const removeLead = (leadId: string) => edit(b => {
    const members = { ...b.members }, workerLine = { ...b.workerLine }, teamLines = { ...b.teamLines };
    Object.keys(members).forEach(m => { if (members[m] === leadId) { delete members[m]; delete workerLine[m]; } });
    delete workerLine[leadId]; delete teamLines[leadId];
    return { ...b, leads: b.leads.filter(x => x !== leadId), members, workerLine, teamLines };
  });
  const assignTeamToLine = (leadId: string, lineId: string) => edit(b => {
    const teamLines = { ...b.teamLines, [leadId]: uniq([...(b.teamLines[leadId] || []), lineId]) };
    const workerLine = { ...b.workerLine };
    [leadId, ...Object.keys(b.members).filter(m => b.members[m] === leadId)].forEach(id => {
      if (!workerLine[id] || !teamLines[leadId].includes(workerLine[id])) workerLine[id] = lineId;
    });
    return { ...b, teamLines, workerLine, downLines: uniq([...b.downLines, lineId]) };
  });
  const unassignTeamFromLine = (leadId: string, lineId: string) => edit(b => {
    const rest = (b.teamLines[leadId] || []).filter(x => x !== lineId);
    const workerLine = { ...b.workerLine };
    [leadId, ...Object.keys(b.members).filter(m => b.members[m] === leadId)].forEach(id => { if (workerLine[id] === lineId) { if (rest[0]) workerLine[id] = rest[0]; else delete workerLine[id]; } });
    return { ...b, teamLines: { ...b.teamLines, [leadId]: rest }, workerLine };
  });
  const toggleDown = (lineId: string) => edit(b => {
    if (!b.downLines.includes(lineId)) return { ...b, downLines: [...b.downLines, lineId] };
    const workerLine = { ...b.workerLine }, teamLines: Record<string, string[]> = {};
    Object.keys(workerLine).forEach(id => { if (workerLine[id] === lineId) delete workerLine[id]; });
    Object.entries(b.teamLines).forEach(([l, ls]) => { teamLines[l] = ls.filter(x => x !== lineId); });
    return { ...b, downLines: b.downLines.filter(x => x !== lineId), workerLine, teamLines };
  });
  const addManualTask = () => {
    const name = manualName.trim(); if (!name) return;
    const id = `manual-${Date.now()}`;
    edit(b => ({ ...b, manualLines: [...b.manualLines, { id, name }], downLines: [...b.downLines, id] }));
    setManualName("");
  };
  const copyLastShiftTeams = async () => {
    if (!sup || !shift.crew) return;
    const current = boardName();
    const rows = await queryRecords(propsRef.current, T.report, { select: ['craa5_name', 'craa5_equipmentjson'], filter: `startswith(craa5_name,'${odataText(`Board · ${sup.raw} · ${shift.crew} · `)}') and craa5_name ne '${odataText(current)}'`, orderby: 'modifiedon desc', top: 1 });
    const prev = rows?.[0];
    if (!prev) { setNotice(rows ? "No earlier board found for this crew." : "Couldn't reach Dataverse."); return; }
    let old: Board; try { old = { ...emptyBoard(), ...JSON.parse(getField(prev, 'craa5_equipmentjson')) }; } catch (e) { setNotice("The last board couldn't be read."); return; }
    const known = (id: string) => empById.has(id);
    edit(b => {
      const leads = old.leads.filter(known), members: Record<string, string> = {};
      Object.entries(old.members).forEach(([m, l]) => { if (known(m) && leads.includes(l) && !b.out[m] && !takenBy[norm(empById.get(m)!.raw)]) members[m] = l; });
      return { ...b, leads: uniq([...b.leads, ...leads]), members: { ...members, ...b.members } };
    });
    setNotice(`Copied teams from ${String(getField(prev, 'craa5_name')).split(' · ').slice(-1)[0]}. Adjust as needed.`);
  };
  const removeManualTask = (id: string) => { toggleDown(id); edit(b => ({ ...b, manualLines: b.manualLines.filter(m => m.id !== id) })); };

  const handleDrop = (item: DragItem, target: DropTarget) => {
    setPicked(null);
    if (item.kind === 'emp') {
      const id = item.id;
      if (target.type === 'line' || target.type === 'worker') {
        const lineId = target.lineId;
        edit(b => ({ ...b, workerLine: { ...b.workerLine, [id]: lineId }, downLines: uniq([...b.downLines, lineId]) }));
        return;
      }
      if (target.type === 'lead' && target.leadId === id) return;
      edit(b => {
        const members = { ...b.members }, out = { ...b.out }, workerLine = { ...b.workerLine }, teamLines = { ...b.teamLines };
        delete members[id]; delete out[id]; delete workerLine[id];
        let leads = b.leads;
        if (b.leads.includes(id)) {   // a lead moved elsewhere stops being a lead; their people go back to the pool
          leads = b.leads.filter(x => x !== id); delete teamLines[id];
          Object.keys(members).forEach(m => { if (members[m] === id) { delete members[m]; delete workerLine[m]; } });
        }
        if (target.type === 'lead' && target.leadId !== id) { members[id] = target.leadId; const tl = b.teamLines[target.leadId]?.[0]; if (tl) workerLine[id] = tl; }
        if (target.type === 'out') out[id] = target.reason;
        return { ...b, leads, members, out, workerLine, teamLines };
      });
    } else if (item.kind === 'team' && target.type === 'line') {
      assignTeamToLine(item.id, target.lineId);
    } else if (item.kind === 'equip' && (target.type === 'worker' || target.type === 'unassigned') && item.lineId === target.lineId) {
      const line = lineById.get(target.lineId); if (!line) return;
      edit(b => {
        const current = equipmentFor(b, line), equip = { ...b.equip };
        line.assets.forEach(a => { if (current[a.id]) equip[a.id] = current[a.id]; else delete equip[a.id]; });   // freeze the auto split
        if (target.type === 'worker') equip[item.id] = target.empId; else delete equip[item.id];
        return { ...b, equip, equipManual: uniq([...b.equipManual, line.id]) };
      });
    }
  };

  // Drag (mouse) + tap-to-pick / tap-to-drop (tablets)
  const dragProps = (item: DragItem) => ({
    draggable: true,
    onDragStart: (e: React.DragEvent) => { dragRef.current = item; e.dataTransfer.setData('text/plain', item.id); e.dataTransfer.effectAllowed = 'move'; },
    onDragEnd: () => { dragRef.current = null; },
    onClick: (e: React.MouseEvent) => { if (picked && picked.id !== item.id) return; e.stopPropagation(); setPicked(p => p?.id === item.id ? null : item); },
  });
  const dropProps = (target: DropTarget, accepts: DragItem['kind'][]) => ({
    onDragOver: (e: React.DragEvent) => { if (dragRef.current && accepts.includes(dragRef.current.kind)) e.preventDefault(); },
    onDrop: (e: React.DragEvent) => { e.preventDefault(); const it = dragRef.current; dragRef.current = null; if (it && accepts.includes(it.kind)) handleDrop(it, target); },
    onClick: (e: React.MouseEvent) => { if (picked && accepts.includes(picked.kind)) { e.stopPropagation(); handleDrop(picked, target); } },
  });
  const zoneCls = (accepts: DragItem['kind'][]) => picked && accepts.includes(picked.kind) ? 'ring-2 ring-blue-400 ring-offset-1 cursor-pointer' : '';
  const isPicked = (id: string) => picked?.id === id;

  // --- RENDER ---
  if (phase === 'loading') {
    return (
      <div className="bg-slate-50 flex flex-col items-center justify-center py-24">
        <Loader className="w-12 h-12 text-blue-600 mb-4" />
        <h2 className="text-xl font-bold text-slate-700">Loading shift…</h2>
        <p className="text-slate-500">Roster, lines, equipment and today's assignments</p>
      </div>
    );
  }

  const badge = SAVE_BADGE[save.status];
  const teamsOf = (lineId: string) => board.leads.filter(l => (board.teamLines[l] || []).includes(lineId));
  const filteredLines = lines.filter(l => !norm(lineSearch) || norm(l.name).includes(norm(lineSearch))).sort(lineOrder);

  const lineHeader = (line: Line) => {
    const heads = workersOn(board, line.id).length;
    return (
      <div className="flex items-center gap-2 min-w-0">
        <span className={`text-[10px] font-black uppercase px-1.5 py-0.5 rounded ${line.production ? 'bg-blue-100 text-blue-800' : line.manual ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'}`}>{line.production ? 'Prod' : line.manual ? 'Task' : 'Other'}</span>
        <h3 className="font-bold text-slate-900 truncate">{line.name}</h3>
        <span className="ml-auto shrink-0 text-sm font-bold text-slate-600 flex items-center gap-1"><Users className="w-4 h-4" />{heads}</span>
      </div>
    );
  };

  return (
    <div className="bg-slate-50 text-slate-800 font-sans p-3 md:p-6">
      <div className="max-w-7xl mx-auto">

        {/* Header */}
        <header className="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-3 bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
          <div className="min-w-0">
            <h1 className="text-2xl font-extrabold text-slate-900">Shift Start</h1>
            <div className="flex flex-wrap items-center gap-2 mt-1 text-sm text-slate-600">
              <span className="font-bold">Crew</span>
              <select value={shift.crew} onChange={e => switchCrew(e.target.value)} className="border border-slate-300 rounded-lg px-2 py-1 font-bold bg-white" aria-label="Crew">
                {!shift.crew && <option value="">?</option>}
                {['A', 'B', 'C', 'D'].map(c => <option key={c} value={c}>{c}</option>)}
              </select>
              <span>{shift.auto ? 'detected' : 'set by hand'} · {hm(shift.start)}–{hm(shift.end)}</span>
              <span className="text-slate-300">|</span>
              <span className="font-bold">Supervisor</span>
              <select value={supId} onChange={e => switchSupervisor(e.target.value)} className="border border-slate-300 rounded-lg px-2 py-1 bg-white max-w-[12rem]" aria-label="Supervisor">
                {!supId && <option value="">Choose…</option>}
                {supervisors.map(s => <option key={s.id} value={s.id}>{s.name}{s.crew ? ` (${s.crew})` : ''}</option>)}
              </select>
            </div>
          </div>
          <div className="flex flex-wrap items-center gap-2">
            <span title={save.error || ''} className={`text-xs font-semibold px-3 py-1.5 rounded-full border flex items-center gap-1 ${badge.cls}`}>
              {save.status === 'saving' && <Loader className="w-3 h-3" />}{badge.text}{save.status === 'saved' && save.at ? ` ${hm(save.at)}` : ''}
            </span>
            <span className="text-sm font-bold text-slate-700 bg-slate-100 rounded-full px-3 py-1.5 flex items-center gap-1"><Users className="w-4 h-4" />{headsOnFloor} on the floor</span>
            <button onClick={() => persist()} disabled={!connected || !!loadWarning || save.status === 'saving'} className="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold disabled:bg-slate-300">Save now</button>
          </div>
        </header>

        {!connected && <div className="mb-3 p-3 rounded-xl border border-slate-300 bg-white text-sm flex gap-2"><Alert className="w-5 h-5 shrink-0" />Not connected to Dataverse. Open this inside the Power Apps model-driven app.</div>}
        {loadWarning && (
          <div className="mb-3 p-3 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-sm flex flex-wrap items-center gap-2">
            <Alert className="w-5 h-5 shrink-0" /><span className="flex-1">{loadWarning}</span>
            <button onClick={() => loadBoard(sup, shift, dvLines)} className="px-3 py-1 rounded-lg bg-amber-600 text-white font-semibold">Retry</button>
            <button onClick={() => { setLoadWarning(null); persist(); }} className="px-3 py-1 rounded-lg border border-amber-400 font-semibold">Save anyway</button>
          </div>
        )}
        {save.status === 'error' && <div className="mb-3 p-3 rounded-xl border border-rose-300 bg-rose-50 text-rose-900 text-sm">Couldn't save: {save.error}. Your changes are still here, so use "Save now" to retry.</div>}
        {notice && <div className="mb-3 p-3 rounded-xl border border-slate-200 bg-white text-sm flex items-center gap-2"><span className="flex-1">{notice}</span><button onClick={() => setNotice(null)} aria-label="Dismiss"><X className="w-4 h-4 text-slate-400" /></button></div>}
        {picked && (
          <div className="mb-3 p-2 rounded-xl bg-blue-600 text-white text-sm font-semibold flex items-center gap-2">
            Moving {picked.kind === 'team' ? `team ${empById.get(picked.id)?.name}` : picked.kind === 'equip' ? lineById.get(picked.lineId || '')?.assets.find(a => a.id === picked.id)?.name : empById.get(picked.id)?.name}: tap where it should go.
            <button onClick={() => setPicked(null)} className="ml-auto px-2 py-0.5 rounded bg-white/20">Cancel</button>
          </div>
        )}

        {/* Tabs */}
        <nav className="flex gap-1 mb-4 overflow-x-auto" role="tablist">
          {TABS.map(([key, label]) => (
            <button key={key} role="tab" aria-selected={tab === key} onClick={() => setTab(key)}
              className={`px-4 py-2 rounded-xl font-semibold whitespace-nowrap ${tab === key ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'}`}>{label}</button>
          ))}
        </nav>

        {/* ===== 1. TEAMS ===== */}
        {tab === 'teams' && (
          <div className="grid grid-cols-1 lg:grid-cols-4 gap-4">
            <aside className="lg:col-span-1 flex flex-col gap-4">
              <div {...dropProps({ type: 'pool' }, ['emp'])} className={`bg-white rounded-2xl border border-slate-200 p-4 ${zoneCls(['emp'])}`}>
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Crew {shift.crew} · available ({pool.length})</h2>
                <div className="relative mb-2">
                  <Search className="w-4 h-4 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" />
                  <input value={poolSearch} onChange={e => setPoolSearch(e.target.value)} placeholder="Find someone…" className="w-full pl-8 pr-2 py-2 text-sm border border-slate-200 rounded-lg" />
                </div>
                <div className="flex flex-col gap-1.5 max-h-[50vh] overflow-y-auto pr-1">
                  {pool.map(e => <Chip key={e.id} emp={e} picked={isPicked(e.id)} ot={board.overtime.includes(e.id)} drag={dragProps({ kind: 'emp', id: e.id })}
                    extra={e.role === 'lead' ? <span className="text-[10px] font-bold text-blue-500">LEAD</span> : e.jobName ? <span className="text-[10px] font-semibold text-slate-400">{e.jobName}</span> : null} />)}
                  {!pool.length && <p className="text-sm text-slate-400 text-center py-4">Everyone on crew {shift.crew} is placed.</p>}
                </div>
                {hiddenTaken > 0 && <p className="text-[11px] text-slate-400 mt-2">{hiddenTaken} already on another supervisor's board.</p>}
              </div>

              <div className="bg-white rounded-2xl border border-slate-200 p-4">
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Overtime (other crews)</h2>
                <input value={otSearch} onChange={e => setOtSearch(e.target.value)} placeholder="Type a name…" className="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg" />
                <div className="flex flex-col gap-1 mt-2">
                  {otCandidates.map(e => (
                    <button key={e.id} onClick={() => { edit(b => ({ ...b, overtime: uniq([...b.overtime, e.id]) })); setOtSearch(""); }} className="text-left text-sm px-3 py-1.5 rounded-lg hover:bg-amber-50 flex items-center gap-2">
                      <Plus className="w-4 h-4 text-amber-600" />{e.name}<span className="ml-auto text-xs text-slate-400">Crew {e.crew || '?'}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div className="bg-white rounded-2xl border border-slate-200 p-4">
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Out today</h2>
                <div className="grid grid-cols-2 gap-2">
                  {OUT_REASONS.map(r => {
                    const people = Object.keys(board.out).filter(id => board.out[id] === r);
                    return (
                      <div key={r} {...dropProps({ type: 'out', reason: r }, ['emp'])} className={`rounded-xl border border-dashed border-slate-300 p-2 min-h-[3rem] ${zoneCls(['emp'])}`}>
                        <div className="text-xs font-bold text-slate-500 mb-1">{r} ({people.length})</div>
                        <div className="flex flex-col gap-1">{people.map(id => { const e = empById.get(id); return e ? <Chip key={id} emp={e} picked={isPicked(id)} drag={dragProps({ kind: 'emp', id })} onRemove={() => handleDrop({ kind: 'emp', id }, { type: 'pool' })} /> : null; })}</div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </aside>

            <section className="lg:col-span-3 flex flex-col gap-3">
              <div className="bg-white rounded-2xl border border-slate-200 p-3 flex flex-wrap items-center gap-2">
                <span className="text-sm font-bold text-slate-600">Add lead:</span>
                <select value="" onChange={e => e.target.value && addLead(e.target.value)} className="border border-slate-300 rounded-lg px-2 py-1.5 text-sm bg-white min-w-[14rem]" aria-label="Add lead">
                  <option value="">Choose a lead…</option>
                  {leadCandidates.map(e => <option key={e.id} value={e.id}>{e.name}{e.role === 'lead' ? ' · Lead' : ''}{board.overtime.includes(e.id) ? ' · OT' : ''}</option>)}
                </select>
                <span className="text-xs text-slate-400">Then drag people under a lead, or tap a person and tap the lead's column.</span>
                {!board.leads.length && connected && <button onClick={copyLastShiftTeams} className="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-sm font-semibold">Start from last shift's teams</button>}
                {board.leads.length > 0 && <button onClick={() => setTab('lines')} className="ml-auto px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold">Next: Lines →</button>}
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                {board.leads.map(leadId => {
                  const lead = empById.get(leadId); if (!lead) return null;
                  const members = Object.keys(board.members).filter(m => board.members[m] === leadId).map(id => empById.get(id)).filter(Boolean) as Emp[];
                  return (
                    <div key={leadId} {...dropProps({ type: 'lead', leadId }, ['emp'])} className={`bg-white rounded-2xl border border-slate-200 overflow-hidden ${zoneCls(['emp'])}`}>
                      <div className="bg-[#004aad] text-white px-4 py-3 flex items-center gap-2">
                        <div className="min-w-0"><div className="text-[10px] font-bold uppercase opacity-70">Lead</div><div className="font-bold truncate">{lead.name}{board.overtime.includes(leadId) ? ' · OT' : ''}</div></div>
                        <span className="ml-auto font-bold flex items-center gap-1"><Users className="w-4 h-4" />{members.length + 1}</span>
                        <button onClick={() => removeLead(leadId)} aria-label={`Remove lead ${lead.name}`} className="p-1 rounded hover:bg-white/20"><X className="w-4 h-4" /></button>
                      </div>
                      <div className="p-3 flex flex-col gap-1.5 min-h-[5rem]">
                        {members.sort(byName).map(m => <Chip key={m.id} emp={m} picked={isPicked(m.id)} ot={board.overtime.includes(m.id)} drag={dragProps({ kind: 'emp', id: m.id })} onRemove={() => handleDrop({ kind: 'emp', id: m.id }, { type: 'pool' })} />)}
                        {!members.length && <p className="text-sm text-slate-400 text-center py-3">Drop people here</p>}
                      </div>
                    </div>
                  );
                })}
                {!board.leads.length && <div className="md:col-span-2 xl:col-span-3 bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center text-slate-500">Start by adding your leads for crew {shift.crew || '?'}.</div>}
              </div>
            </section>
          </div>
        )}

        {/* ===== 2. LINES ===== */}
        {tab === 'lines' && (
          <div className="grid grid-cols-1 lg:grid-cols-4 gap-4">
            <aside className="lg:col-span-1 flex flex-col gap-4">
              <div className="bg-white rounded-2xl border border-slate-200 p-4">
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">What's down for cleaning ({board.downLines.length})</h2>
                <input value={lineSearch} onChange={e => setLineSearch(e.target.value)} placeholder="Find a line…" className="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg mb-2" />
                <div className="flex flex-col gap-1 max-h-[55vh] overflow-y-auto pr-1">
                  {filteredLines.filter(l => !l.manual).map((l, i, arr) => (
                    <React.Fragment key={l.id}>
                      {(i === 0 || arr[i - 1].production !== l.production) && <div className="text-[10px] font-black uppercase text-slate-400 mt-2">{l.production ? 'Production' : 'Non-production'}</div>}
                      <label className="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-slate-50 cursor-pointer text-sm">
                        <input type="checkbox" checked={board.downLines.includes(l.id)} onChange={() => toggleDown(l.id)} className="accent-blue-600 w-4 h-4" />
                        <span className={`truncate ${board.downLines.includes(l.id) ? 'font-bold text-slate-900' : 'text-slate-600'}`}>{l.name}</span>
                        {l.everyday && <span className="ml-auto text-[10px] font-bold text-slate-400">DAILY</span>}
                      </label>
                    </React.Fragment>
                  ))}
                </div>
              </div>
              <div className="bg-white rounded-2xl border border-slate-200 p-4">
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Manual task</h2>
                <div className="flex gap-2">
                  <input value={manualName} onChange={e => setManualName(e.target.value)} onKeyDown={e => e.key === 'Enter' && addManualTask()} placeholder="e.g. Trash run, Drains" className="flex-1 min-w-0 px-3 py-2 text-sm border border-slate-200 rounded-lg" />
                  <button onClick={addManualTask} className="px-3 rounded-lg bg-slate-900 text-white" aria-label="Add manual task"><Plus className="w-4 h-4" /></button>
                </div>
              </div>
              <div className="bg-white rounded-2xl border border-slate-200 p-4">
                <h2 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Teams</h2>
                <p className="text-[11px] text-slate-400 mb-2">Drag a team onto a line (or tap, then tap the line).</p>
                <div className="flex flex-col gap-1.5">
                  {board.leads.map(l => { const e = empById.get(l); return e ? (
                    <div key={l} {...dragProps({ kind: 'team', id: l })} className={`px-3 py-2 rounded-lg border text-sm font-semibold cursor-grab flex items-center gap-2 ${isPicked(l) ? 'bg-blue-600 text-white border-blue-700' : 'bg-white border-slate-200 hover:border-blue-300'}`}>
                      <Users className="w-4 h-4" /><span className="truncate">Team {e.name}</span>
                      <span className="ml-auto text-xs">{1 + Object.values(board.members).filter(x => x === l).length}</span>
                    </div>) : null; })}
                  {!board.leads.length && <button onClick={() => setTab('teams')} className="text-sm text-blue-600 font-semibold text-left">← Set up teams first</button>}
                </div>
              </div>
            </aside>
            <section className="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 content-start">
              {downLines.map(line => (
                <div key={line.id} {...dropProps({ type: 'line', lineId: line.id }, ['team', 'emp'])} className={`bg-white rounded-2xl border p-4 ${line.production ? 'border-blue-200' : 'border-slate-200'} ${zoneCls(['team', 'emp'])}`}>
                  {lineHeader(line)}
                  <div className="flex flex-wrap gap-1.5 mt-3">
                    {teamsOf(line.id).map(l => (
                      <span key={l} className="text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200 rounded-full pl-3 pr-1 py-1 flex items-center gap-1">
                        Team {empById.get(l)?.name}
                        <button onClick={e => { e.stopPropagation(); unassignTeamFromLine(l, line.id); }} aria-label="Remove team from line" className="p-0.5 rounded-full hover:bg-blue-100"><X className="w-3 h-3" /></button>
                      </span>
                    ))}
                    {!teamsOf(line.id).length && <span className="text-sm text-slate-400">No team yet</span>}
                  </div>
                  <div className="flex items-center justify-between mt-3 text-xs text-slate-500">
                    <span>{line.assets.length ? `${line.assets.length} equipment` : line.manual ? 'Manual task' : 'No equipment listed'}</span>
                    {line.manual
                      ? <button onClick={e => { e.stopPropagation(); removeManualTask(line.id); }} className="text-rose-600 font-semibold">Delete task</button>
                      : <button onClick={e => { e.stopPropagation(); toggleDown(line.id); }} className="text-slate-500 hover:text-rose-600 font-semibold">Not down</button>}
                  </div>
                </div>
              ))}
              {!downLines.length && <div className="md:col-span-2 xl:col-span-3 bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center text-slate-500">Tick the lines that are down for cleaning.</div>}
              {downLines.length > 0 && <div className="md:col-span-2 xl:col-span-3 flex justify-end"><button onClick={() => setTab('equipment')} className="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold">Next: Equipment →</button></div>}
            </section>
          </div>
        )}

        {/* ===== 3. EQUIPMENT ===== */}
        {tab === 'equipment' && (
          <div className="flex flex-col gap-4">
            {downLines.map(line => {
              const people = workersOn(board, line.id), eq = equipmentFor(board, line);
              const unassigned = line.assets.filter(a => !eq[a.id]);
              const manual = board.equipManual.includes(line.id);
              const equipChip = (a: Asset) => (
                <React.Fragment key={a.id}>
                <span {...dragProps({ kind: 'equip', id: a.id, lineId: line.id })} className={`text-xs font-semibold px-2 py-1 rounded-md border cursor-grab select-none ${isPicked(a.id) ? 'bg-blue-600 text-white border-blue-700' : board.equipDone[a.id] ? 'bg-emerald-50 text-emerald-800 border-emerald-200 line-through' : 'bg-slate-50 text-slate-700 border-slate-200'}`}>{a.name}</span>
                </React.Fragment>
              );
              return (
                <div key={line.id} {...dropProps({ type: 'line', lineId: line.id }, ['emp'])} className={`bg-white rounded-2xl border border-slate-200 p-4 ${zoneCls(['emp'])}`}>
                  <div className="flex flex-wrap items-center gap-3 mb-3">
                    <div className="flex-1 min-w-0">{lineHeader(line)}</div>
                    {line.assets.length > 0 && (manual
                      ? <button onClick={e => { e.stopPropagation(); edit(b => ({ ...b, equipManual: b.equipManual.filter(x => x !== line.id) })); }} className="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200">Re-split automatically</button>
                      : <span className="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-1 rounded">AUTO SPLIT</span>)}
                  </div>
                  {!people.length ? <p className="text-sm text-slate-400">Nobody on this line yet. Assign a team on the Lines tab, or drop a person here.</p> : (
                    <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-2">
                      {people.map(id => { const e = empById.get(id); if (!e) return null; const mine = line.assets.filter(a => eq[a.id] === id); return (
                        <div key={id} {...dropProps({ type: 'worker', lineId: line.id, empId: id }, ['equip', 'emp'])} className={`rounded-xl border border-slate-200 bg-slate-50/60 p-2 ${zoneCls(['equip'])}`}>
                          <div {...dragProps({ kind: 'emp', id })} className={`text-sm font-bold mb-1.5 flex items-center gap-1 cursor-grab ${isPicked(id) ? 'text-blue-600' : 'text-slate-800'}`}>
                            {e.name}{board.leads.includes(id) && <span className="text-[10px] text-blue-500">LEAD</span>}{board.overtime.includes(id) && <span className="text-[10px] text-amber-600">OT</span>}
                            <span className="ml-auto text-xs text-slate-400">{mine.length}</span>
                          </div>
                          <div className="flex flex-wrap gap-1">{mine.map(equipChip)}</div>
                        </div>); })}
                      {(unassigned.length > 0 || manual) && line.assets.length > 0 && (
                        <div {...dropProps({ type: 'unassigned', lineId: line.id }, ['equip'])} className={`rounded-xl border border-dashed border-amber-300 bg-amber-50/50 p-2 ${zoneCls(['equip'])}`}>
                          <div className="text-sm font-bold text-amber-800 mb-1.5">Unassigned ({unassigned.length})</div>
                          <div className="flex flex-wrap gap-1">{unassigned.map(equipChip)}</div>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
            {!downLines.length && <div className="bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center text-slate-500">No lines down yet.</div>}
            {downLines.length > 0 && <div className="flex justify-end"><button onClick={() => setTab('manage')} className="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold">Next: Manage →</button></div>}
          </div>
        )}

        {/* ===== 4. MANAGE & UPDATE ===== */}
        {tab === 'manage' && (
          <div className="grid grid-cols-1 xl:grid-cols-5 gap-4">
            <section className="xl:col-span-3 flex flex-col gap-3">
              {downLines.map(line => {
                const st = lineStatus(line, board), p = board.progress[line.id] || 0;
                const eq = equipmentFor(board, line), eqIds = Object.keys(eq);
                const setP = (v: number) => edit(b => ({ ...b, progress: { ...b.progress, [line.id]: v } }));
                return (
                  <div key={line.id} className={`bg-white rounded-2xl border p-4 ${st.done ? 'border-emerald-300' : 'border-slate-200'}`}>
                    {lineHeader(line)}
                    {line.production ? (
                      <div className="mt-3">
                        <div className="flex justify-between text-xs font-semibold mb-1">
                          <span className={st.done ? 'text-emerald-700' : 'text-blue-700'}>{st.label} · {st.pct}%</span>
                          {!st.done && <span className="text-slate-400">Next: {STEP_LABELS[p]}</span>}
                        </div>
                        <input type="range" min={0} max={TOTAL_STEPS} step={1} value={p} onChange={e => setP(Number(e.target.value))} aria-label={`${line.name} progress`} className="w-full accent-blue-600" />
                      </div>
                    ) : (
                      <div className="mt-3 flex gap-1">
                        {([[0, 'Not started'], [1, 'In progress'], [TOTAL_STEPS, 'Done']] as const).map(([v, label]) => (
                          <button key={v} onClick={() => setP(v)} className={`flex-1 text-xs font-semibold py-1.5 rounded-lg border ${(v === 0 ? p === 0 : v === 1 ? p > 0 && p < TOTAL_STEPS : p >= TOTAL_STEPS) ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200'}`}>{label}</button>
                        ))}
                      </div>
                    )}
                    {eqIds.length > 0 && (
                      <details className="mt-2">
                        <summary className="text-xs font-semibold text-slate-500 cursor-pointer">Equipment {eqIds.filter(id => board.equipDone[id]).length}/{eqIds.length} done</summary>
                        <div className="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-1">
                          {line.assets.filter(a => eq[a.id]).map(a => (
                            <label key={a.id} className="flex items-center gap-2 text-sm">
                              <input type="checkbox" checked={!!board.equipDone[a.id]} onChange={e => { const v = e.target.checked; edit(b => ({ ...b, equipDone: { ...b.equipDone, [a.id]: v } })); }} className="accent-emerald-600" />
                              <span className={board.equipDone[a.id] ? 'line-through text-slate-400' : ''}>{a.name}</span>
                              <span className="ml-auto text-xs text-slate-400">{empById.get(eq[a.id])?.name}</span>
                            </label>
                          ))}
                        </div>
                      </details>
                    )}
                    <input value={board.notes[line.id] || ''} onChange={e => { const v = e.target.value; edit(b => ({ ...b, notes: { ...b.notes, [line.id]: v } })); }} placeholder="Note for the update (optional)" className="mt-2 w-full px-3 py-1.5 text-sm border border-slate-200 rounded-lg" />
                  </div>
                );
              })}
              {!downLines.length && <div className="bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center text-slate-500">Set up teams and lines first.</div>}
            </section>

            <section className="xl:col-span-2">
              <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden xl:sticky xl:top-4">
                <div className="bg-slate-100 p-3 border-b border-slate-200 flex flex-wrap items-center gap-2">
                  <h3 className="font-bold text-slate-800 mr-auto">Shift update</h3>
                  <button onClick={handleCopy} className={`px-3 py-2 rounded-lg text-white text-sm font-semibold flex items-center gap-1.5 ${copied === 'ok' ? 'bg-green-600' : 'bg-blue-600 hover:bg-blue-700'}`}>
                    {copied === 'ok' ? <Check className="w-4 h-4" /> : <ClipboardCopy className="w-4 h-4" />}{copied === 'ok' ? 'Copied' : 'Copy'}
                  </button>
                  <button onClick={() => sendToTeams()} disabled={sending || !connected} className="px-3 py-2 rounded-lg bg-[#5b5fc7] hover:bg-[#4f52b2] text-white text-sm font-semibold flex items-center gap-1.5 disabled:opacity-50">
                    {sending ? <Loader className="w-4 h-4" /> : <Send className="w-4 h-4" />}Send to Teams
                  </button>
                </div>
                <div className="px-3 py-2 border-b border-slate-100 flex flex-wrap items-center gap-2 text-xs text-slate-600">
                  <label className="flex items-center gap-1.5 font-semibold cursor-pointer">
                    <input type="checkbox" checked={board.autoSend} onChange={e => { const v = e.target.checked; edit(b => ({ ...b, autoSend: v })); }} className="accent-[#5b5fc7]" />
                    Auto-send at 3, 9, 12 AM/PM
                  </label>
                  <span className="ml-auto">{nextSlot ? `Next: ${hm(nextSlot)}` : ''}{board.lastSentAt ? ` · Last sent ${hm(new Date(board.lastSentAt))}` : ''}</span>
                </div>
                {copied === 'manual' && <div className="px-3 py-2 bg-amber-50 text-amber-900 text-xs">Clipboard is blocked here. The text is selected, so press Ctrl+C.</div>}
                <textarea ref={updateBoxRef} readOnly value={updateText} onFocus={e => e.target.select()} aria-label="Shift update text" className="w-full min-h-[24rem] p-3 text-sm font-mono bg-white outline-none" />
              </div>
            </section>
          </div>
        )}
      </div>
    </div>
  );
}
