function parseTeams(rows: any[]): TeamRow[] {
    const out: TeamRow[] = [];
    (rows || []).forEach(r => {
        const id = lookupId(getField(r, 'craa5__aa_leadershipteamid') ?? getField(r, 'craa5_aa_leadershipteamid') ?? getField(r, 'craa5_leadershipteamid') ?? getField(r, 'craa5_teamid'));
