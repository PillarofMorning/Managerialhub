                                                                <td style={td}>{inp(i, 'craa5_whatislefttodo', 140)}</td>
                                                                <td style={td}>{inp(i, 'craa5_percentagecomplete', 44, 'number')}</td>
                                                                <td style={td}><input type="checkbox" aria-label="Done" checked={isBoolTrue(r.craa5_complete)} onChange={(e) => setCell(i, 'craa5_complete', e.target.checked)} /></td>
                                                                <td style={td}>{inp(i, 'craa5_equipment', 120)}</td>
                                                                <td style={{ ...td, whiteSpace: 'nowrap', color: '#64748B' }}>{r.craa5_starttime ? clockTime(new Date(r.craa5_starttime).getTime()) : '-'}</td>
                                                                <td style={{ ...td, whiteSpace: 'nowrap', color: '#64748B' }}>{r.craa5_endtime ? clockTime(new Date(r.craa5_endtime).getTime()) : '-'}</td>
                                                                <td style={td}><Button size="small" appearance="subtle" style={{ color: BRAND.red, minWidth: 0 }} onClick={() => delRow(i)}>Remove</Button></td>
