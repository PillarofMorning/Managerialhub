// ---- Live boards (craa5_shiftboard + local device fallback ss_live_boards_local_v1) ----
const LOCAL_LIVE_BOARDS_KEY = "ss_live_boards_local_v1";
const LOCAL_ARCHIVES_KEY = "ss_archives_local_v1";
function readLocalLiveBoards(includeArchived: boolean = false): ShiftBoard[] {
    try {
        const raw = typeof window !== 'undefined' && window.localStorage ? window.localStorage.getItem(LOCAL_LIVE_BOARDS_KEY) : null;
        if (!raw) return [];
        const list = JSON.parse(raw);
        return Array.isArray(list) ? list.filter((b: any) => b && (includeArchived || b.status !== 'archived') && b.slotStart >= Date.now() - 45 * 86400000) : [];
    } catch (e) { return []; }
}
function removeLocalLiveBoard(b: ShiftBoard | { recordId?: string; crew?: string; team?: string; slotStart?: number }) {
    try {
        if (typeof window === 'undefined' || !window.localStorage) return;
        const raw = window.localStorage.getItem(LOCAL_LIVE_BOARDS_KEY);
        if (!raw) return;
        const list = JSON.parse(raw);
        if (!Array.isArray(list)) return;
        const bName = (b && b.crew && b.team && b.slotStart) ? boardName(b as any) : '';
        const next = list.filter((x: any) => {
            if (!x) return false;
            if (b.recordId && x.recordId && x.recordId === b.recordId) return false;
            if (bName && boardName(x) === bName) return false;
            if (b.team && b.slotStart && sameText(x.team, b.team) && Math.abs(Number(x.slotStart) - Number(b.slotStart)) < 2 * 3600000) return false;
            return true;
        });
        window.localStorage.setItem(LOCAL_LIVE_BOARDS_KEY, JSON.stringify(next.slice(-60)));
    } catch (e) {}
}
function saveLocalLiveBoard(b: ShiftBoard) {
    try {
        if (b.status === 'archived') {
            removeLocalLiveBoard(b);
            return;
        }
        const cur = readLocalLiveBoards(true).filter(x => x.recordId !== b.recordId && boardName(x) !== boardName(b) && !(sameText(x.team, b.team) && Math.abs(Number(x.slotStart) - Number(b.slotStart)) < 2 * 3600000));
        cur.push(b);
        if (typeof window !== 'undefined' && window.localStorage) {
            window.localStorage.setItem(LOCAL_LIVE_BOARDS_KEY, JSON.stringify(cur.slice(-60)));
        }
    } catch (e) {}
}
function readLocalArchives(): ShiftBoard[] {
    try {
        const raw = typeof window !== 'undefined' && window.localStorage ? window.localStorage.getItem(LOCAL_ARCHIVES_KEY) : null;
        if (!raw) return [];
        const list = JSON.parse(raw);
        return Array.isArray(list) ? list.filter((b: any) => b && b.slotStart >= Date.now() - 45 * 86400000) : [];
    } catch (e) { return []; }
}
function saveLocalArchive(b: ShiftBoard) {
    try {
        const cur = readLocalArchives().filter(x => x.recordId !== b.recordId && boardName(x) !== boardName(b));
        cur.push({ ...b, kind: 'archive', status: 'archived', modifiedOn: b.archivedAt || new Date().toISOString() });
        if (typeof window !== 'undefined' && window.localStorage) {
            window.localStorage.setItem(LOCAL_ARCHIVES_KEY, JSON.stringify(cur.slice(-60)));
        }
    } catch (e) {}
}
const readBoardById = (props: any, id: string) => readRecordById(props, BOARD_TABLE, id);
const readBoardByName = async (props: any, name: string): Promise<ShiftBoard | null> => {
    const inMem = LIVE_BOARDS.find(b => boardName(b) === name);
    if (inMem) return inMem;
    const remote = await readRecordByName(props, BOARD_TABLE, name, false);
    if (remote) return remote;
    return readLocalLiveBoards(true).find(b => boardName(b) === name) || null;
};
const boardModifiedOn = (props: any, id: string) => recordModifiedOn(props, BOARD_TABLE, id);
async function readLiveBoards(props: any): Promise<ShiftBoard[]> {
    const nowMs = Date.now();
    const rawLocal = readLocalLiveBoards();
    const freshLocal = rawLocal.filter(lb => !boardIsOverdue(lb, nowMs));
    if (freshLocal.length !== rawLocal.length) {
        rawLocal.filter(lb => boardIsOverdue(lb, nowMs)).forEach(lb => removeLocalLiveBoard(lb));
    }
    if (BOARD_STORE === 'missing') {
        if (freshLocal.length && !LIVE_BOARDS.length) LIVE_BOARDS = freshLocal;
        return LIVE_BOARDS;
    }
    try {
        const rows = await tableQuery(props, BOARD_TABLE, 'statecode eq 0', fullSelect(BOARD_TABLE), 300);
        const remoteBoards = rows.map(r => parseBoardRow(r, BOARD_TABLE)).filter((b): b is ShiftBoard => !!b && b.status !== 'archived');
        const remoteNames = new Set(remoteBoards.map(b => boardName(b)));
        const remoteIds = new Set(remoteBoards.map(b => String(b.recordId || '').trim().toLowerCase()).filter(Boolean));
        const keptLocal: ShiftBoard[] = [];
        freshLocal.forEach(lb => {
            const lbName = boardName(lb);
            if (remoteNames.has(lbName)) return;
            const lbId = String(lb.recordId || '').trim().toLowerCase();
            // If this local board previously had a Dataverse GUID (not local_) and is no longer active in Dataverse, it was archived/deactivated remotely: purge it!
            if (lbId && !lbId.startsWith('local_') && !remoteIds.has(lbId)) {
                removeLocalLiveBoard(lb);
                return;
            }
            keptLocal.push(lb);
        });
        LIVE_BOARDS = remoteBoards.concat(keptLocal);
    } catch (e) {
        if (freshLocal.length && !LIVE_BOARDS.length) LIVE_BOARDS = freshLocal;
    }
    return LIVE_BOARDS;
}
async function writeBoard(props: any, b: ShiftBoard, reactivate: boolean = false): Promise<{ ok: boolean; board: ShiftBoard; error: string; refused: string[] }> {
    if ((BOARD_STORE === 'missing' || BOARD_STORE === 'error') && isColumnError(BOARD_ERROR, BOARD_TABLE)) setTableState(BOARD_TABLE, 'unknown', '');
    const data = boardData({ ...b, kind: 'live' }, false);   // the updates column belongs to Ganttly: never written here
    data.craa5_archivedon = b.archivedAt || null; data.craa5_archivedby = b.archivedBy || '';
    if (reactivate) { data.statecode = 0; data.statuscode = 1; }
    const w = BOARD_STORE === 'missing' ? { ok: false, id: '', error: `Table ${BOARD_TABLE} is not created in Dataverse yet`, refused: [] as string[] } : await tableWrite(props, BOARD_TABLE, b.recordId || '', data);
    if (!w.ok) {
        const localSaved: ShiftBoard = { ...b, kind: 'live', recordId: b.recordId || `local_${Date.now()}` };
        saveLocalLiveBoard(localSaved);
        LIVE_BOARDS = LIVE_BOARDS.filter(x => x.recordId !== localSaved.recordId && boardName(x) !== boardName(b)).concat(localSaved.status === 'live' ? [localSaved] : []);
        return { ok: false, board: localSaved, error: w.error, refused: w.refused };
    }
    const saved: ShiftBoard = { ...b, kind: 'live', recordId: w.id };
    saveLocalLiveBoard(saved);
    LIVE_BOARDS = LIVE_BOARDS.filter(x => x.recordId !== w.id && boardName(x) !== boardName(b)).concat(saved.status === 'live' ? [saved] : []);
    return { ok: true, board: saved, error: '', refused: w.refused };
}

// ---- Archive (craa5_shiftarchive + craa5_shiftboard + local fallback ss_archives_local_v1 / ss_live_boards_local_v1) ----
async function writeArchive(props: any, a: ShiftBoard): Promise<{ ok: boolean; board: ShiftBoard; error: string; refused: string[] }> {
    const data = boardData({ ...a, kind: 'archive' }, true);
    data.craa5_archivedon = a.archivedAt || new Date().toISOString(); data.craa5_archivedby = a.archivedBy || '';
    data.craa5_source = a.source || (a.imported ? 'import' : 'live'); data.craa5_sourceboardid = a.sourceBoardId || ''; data.craa5_retiredon = a.retiredAt || null;
    let id = a.recordId || '';
    if (!id && TABLE_STATE[ARCHIVE_TABLE] !== 'missing') {
        const same = await readRecordByName(props, ARCHIVE_TABLE, boardName(a), false);
        if (same) id = same.recordId || '';
    }
    const w = TABLE_STATE[ARCHIVE_TABLE] === 'missing'
        ? { ok: false, id: '', error: `Table ${ARCHIVE_TABLE} is not created in Dataverse yet`, refused: [] as string[] }
        : await tableWrite(props, ARCHIVE_TABLE, id, data);
    const savedBoard: ShiftBoard = { ...a, kind: 'archive', recordId: w.ok ? w.id : (id || `local_arch_${Date.now()}`) };
    saveLocalArchive(savedBoard);
    return w.ok ? { ok: true, board: savedBoard, error: '', refused: w.refused } : { ok: false, board: savedBoard, error: w.error, refused: w.refused };
}
// Archived and prior shifts that started in a window (for history, continuation and Ganttly). Reads both craa5_shiftarchive and craa5_shiftboard
// (plus local browser storage) and falls back to unfiltered queries whenever craa5_slotstart is unpopulated, so no saved Shift Startup board is missed.
async function readArchiveRange(props: any, fromMs: number, toMs: number, teams?: string[]): Promise<ShiftBoard[]> {
    const keep = (b: ShiftBoard | null): b is ShiftBoard => !!b && b.slotStart >= fromMs && b.slotStart < toMs && (!teams || !teams.length || teams.some(t => sameText(t, b.team) || (personKey(t) && personKey(t) === personKey(b.team))));
    const localList = readLocalArchives().concat(readLocalLiveBoards(true)).filter(keep);
    const q = (n: string) => n.replace(/'/g, "''");
    const tf = teams && teams.length ? ` and (${teams.map(t => `craa5_team eq '${q(t)}'`).join(' or ')})` : '';
    const readTableBoards = async (table: string): Promise<ShiftBoard[]> => {
        if (TABLE_STATE[table] === 'missing') return [];
        try {
            const rows = await tableQuery(props, table, `statecode eq 0 and craa5_slotstart ge ${odataDate(fromMs)} and craa5_slotstart lt ${odataDate(toMs)}${tf}`, fullSelect(table), 1000, 'craa5_slotstart desc');
            const parsed = rows.map(r => parseBoardRow(r, table)).filter(keep);
            if (parsed.length > 0) return parsed;
        } catch (e: any) {
            if (TABLE_STATE[table] === 'missing') return [];
        }
        try {
            const rows2 = await tableQuery(props, table, '', fullSelect(table), 500);
            const parsed2 = rows2.map(r => parseBoardRow(r, table)).filter(keep);
            if (parsed2.length > 0) return parsed2;
        } catch (e2: any) {
            if (TABLE_STATE[table] === 'missing') return [];
        }
        try {
            const rows3 = await tableQuery(props, table, 'statecode eq 0', fullSelect(table), 500);
            return rows3.map(r => parseBoardRow(r, table)).filter(keep);
        } catch (e3) {
            return [];
        }
    };
    const [archRemote, boardRemote] = await Promise.all([
        readTableBoards(ARCHIVE_TABLE),
        readTableBoards(BOARD_TABLE),
    ]);
    const byName = new Map<string, ShiftBoard>();
    const addBoard = (b: ShiftBoard) => {
        const k = boardName(b);
        const cur = byName.get(k);
        if (!cur) { byName.set(k, b); return; }
        const bRows = Array.isArray(b.rows) ? b.rows.length : 0;
        const curRows = Array.isArray(cur.rows) ? cur.rows.length : 0;
        const bTime = String(b.modifiedOn || b.savedAt || '');
        const curTime = String(cur.modifiedOn || cur.savedAt || '');
        if (bRows > curRows || (bRows === curRows && bTime > curTime)) byName.set(k, b);
    };
    archRemote.forEach(addBoard);
    boardRemote.forEach(addBoard);
    LIVE_BOARDS.filter(keep).forEach(addBoard);
    localList.forEach(addBoard);
    return Array.from(byName.values()).sort((a, b) => b.slotStart - a.slotStart);
}
// Shifts handed off or archived in the last hours (names only, for the Today strip)
async function readRecentArchives(props: any, hours: number = 20): Promise<{ id: string; name: string; modifiedOn: string }[]> {
    const cutoff = Date.now() - 30 * 3600000;
    const localItems = readLocalArchives()
        .filter(b => b.slotStart > cutoff)
        .map(b => ({ id: b.recordId || boardName(b), name: boardName(b), modifiedOn: b.archivedAt || b.savedAt || new Date().toISOString() }));
    if (TABLE_STATE[ARCHIVE_TABLE] === 'missing') return localItems;
    const r = await readRecordNames(props, ARCHIVE_TABLE, `statecode eq 0 and modifiedon ge ${odataDate(Date.now() - hours * 3600000)}`, 100);
    const remoteItems = r.list.filter(x => parseBoardName(x.name).slotStart > cutoff);
    const seen = new Set(remoteItems.map(x => x.name));
    return remoteItems.concat(localItems.filter(x => !seen.has(x.name)));
}

type ArchiveResult = { ok: boolean; skipped: boolean; board: ShiftBoard; written: number; error: string };
// Archives a live board: claims it (so two people opening the apps at once never do it twice), writes the shift to craa5_shiftarchive
// with Ganttly's equipment and end times on its rows, then deactivates the live row. Nothing is ever deleted.
async function archiveBoard(props: any, board: ShiftBoard, by: string, why: 'handoff' | 'auto' | 'manual'): Promise<ArchiveResult> {
    const fail = (b: ShiftBoard, error: string, skipped = false): ArchiveResult => ({ ok: false, skipped, board: b, written: 0, error });
    let b: ShiftBoard = board;
    const hasWriteApi = !!getWriteApi(props);
    if (hasWriteApi && board.recordId && !String(board.recordId).startsWith('local_')) {
        const fresh = await readBoardById(props, board.recordId);
        if (fresh) b = fresh;
        if (b.status === 'archived') return { ok: true, skipped: true, board: b, written: 0, error: 'already archived' };
        const held = b.claim && b.claim.id && Date.now() - new Date(b.claim.at).getTime() < 10 * 60000;
        if (held && why === 'auto') return fail(b, `${b.claim!.by || 'someone'} is archiving it right now`, true);
        const claim = { id: `${by}|${Date.now()}|${Math.random().toString(36).slice(2, 8)}`, by, at: new Date().toISOString() };
        const w = await writeBoard(props, { ...b, claim, error: '' });
        if (w.ok && why === 'auto') {
            await sleepMs(1200);
            const check = await readBoardById(props, board.recordId);
            if (check && (!check.claim || check.claim.id !== claim.id)) return fail(check, `${check.claim?.by || 'someone else'} took it over`, true);
            b = { ...(check || b), claim };
        }
    }
    const now = new Date().toISOString(), rows = applyBoardUpdates(b.rows || [], b.updates);
    let arch: ShiftBoard = { ...b, kind: 'archive', rows, status: 'archived', archivedAt: now, archivedBy: why === 'auto' ? `auto (${by})` : by, source: 'live', sourceBoardId: b.recordId, claim: null, reopened: false, error: '', recordId: b.archiveId };
    arch = boardLog(arch, by, `archived (${why}): ${rows.length} rows`);
    const wa = hasWriteApi ? await writeArchive(props, arch) : { ok: false, board: { ...arch, recordId: `local_arch_${Date.now()}` }, error: 'Saved to local device archive', refused: [] as string[] };
    saveLocalArchive(wa.board);
    const closed = boardLog({ ...b, status: 'archived', archivedAt: now, archivedBy: arch.archivedBy, archiveId: wa.board.recordId, claim: null, reopened: false, error: '' }, by, `archived (${why}) to ${ARCHIVE_TABLE}`);
    removeLocalLiveBoard(closed);
    const wl = hasWriteApi ? await writeBoard(props, closed) : { ok: true, board: closed, error: '', refused: [] as string[] };
    if (hasWriteApi && wl.ok && b.recordId && !String(b.recordId).startsWith('local_')) await deactivateRecord(props, BOARD_TABLE, b.recordId);
    removeLocalLiveBoard(b);
    LIVE_BOARDS = LIVE_BOARDS.filter(x => x.recordId !== b.recordId && boardName(x) !== boardName(b));
    if (GLOBAL_DATA_CACHE) saveSessionCache({ ...GLOBAL_DATA_CACHE, liveBoards: LIVE_BOARDS });
    if (!wa.ok && why === 'auto') {
        return fail(b, `the archive could not be written: ${wa.error}`);
    }
    const noteErr = !wa.ok ? `(Archived on this device & live board closed; Dataverse archive table note: ${wa.error})` : (wl.ok ? '' : `archived, but the live row could not be closed: ${wl.error}`);
    return { ok: true, skipped: false, board: wa.board, written: rows.length, error: noteErr };
}
// Every shift on the live table that ended more than 4 hours ago is archived (oldest first).
async function archiveOverdueBoards(props: any, by: string): Promise<{ results: ArchiveResult[] }> {
    const list = await readLiveBoards(props);
    const due = list.filter(b => boardIsOverdue(b)).sort((a, b) => a.slotStart - b.slotStart);
    const results: ArchiveResult[] = [];
    for (const b of due) {
        try { results.push(await archiveBoard(props, b, by, 'auto')); } catch (e: any) { results.push({ ok: false, skipped: false, board: b, written: 0, error: String(e?.message || e) }); }
    }
    if (due.length) {
        await readLiveBoards(props);
        if (GLOBAL_DATA_CACHE) saveSessionCache({ ...GLOBAL_DATA_CACHE, liveBoards: LIVE_BOARDS });
    }
    return { results };
}

// ---- Plans (craa5_shiftplan): setups for future shifts, in the shift board layout ----
const PLAN_KEEP_MS = 36 * 3600000;   // a plan is dropped this long after the shift it was for began
async function readPlans(props: any): Promise<ShiftBoard[]> {
    if (TABLE_STATE[PLAN_TABLE] === 'missing') return [];
    try {
        const rows = await tableQuery(props, PLAN_TABLE, 'statecode eq 0', fullSelect(PLAN_TABLE), 200);
        return rows.map(r => parseBoardRow(r, PLAN_TABLE)).filter((b): b is ShiftBoard => !!b && (b.status === 'planned' || !b.status) && b.slotStart >= Date.now() - PLAN_KEEP_MS);
    } catch (e) { return []; }
}
async function writePlan(props: any, p: ShiftBoard): Promise<{ ok: boolean; board: ShiftBoard; error: string; refused: string[] }> {
    const w = await tableWrite(props, PLAN_TABLE, p.recordId || '', boardData({ ...p, kind: 'plan' }, false));
    return w.ok ? { ok: true, board: { ...p, kind: 'plan', recordId: w.id }, error: '', refused: w.refused } : { ok: false, board: p, error: w.error, refused: w.refused };
}
// A plan that has become the live board is marked used and deactivated, so it is never offered again.
async function markPlanUsed(props: any, planId: string, by: string, liveId: string): Promise<string> {
    const p = await readRecordById(props, PLAN_TABLE, planId);
    if (!p) return 'plan not found';
    const used = boardLog({ ...p, status: 'used', usedAt: new Date().toISOString(), usedBy: by, liveBoardId: liveId }, by, 'loaded and saved as the live board');
    const data = boardData(used, false);
    data.craa5_usedon = used.usedAt; data.craa5_usedby = by; data.craa5_liveboardid = liveId;
    const w = await tableWrite(props, PLAN_TABLE, planId, data);
    if (!w.ok) return w.error;
    return deactivateRecord(props, PLAN_TABLE, planId);
}
