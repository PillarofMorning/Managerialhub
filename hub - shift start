);
const nameColumn = (label: string) => createTableColumn({ columnId: "craa5_name", renderHeaderCell: () => <Text weight="bold">{label}</Text>, renderCell: (item: any) => <TableCellLayout media={<span>👤</span>}>{renderSafe(formatFullName(getField(item, 'craa5_name')))}</TableCellLayout> });
const shiftColumn = createTableColumn({ columnId: "craa5_shift", renderHeaderCell: () => <Text weight="bold">Shift</Text>, renderCell: (item: any) => <TableCellLayout>{renderSafe(crewOfPerson(item) || getFormattedField(item, 'craa5_shift') || getField(item, 'craa5_shift') || "N/A")}</TableCellLayout> });

