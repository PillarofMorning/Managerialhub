                            <div style={{ display: 'flex', gap: 6, padding: 10, alignItems: 'center', flexWrap: 'wrap' }}>
                                <input aria-label="Filter" value={q} onChange={(e) => setQ(e.target.value)} placeholder="Crew, supervisor or date" className="px-2 py-1 rounded border border-slate-300 text-xs" style={{ flex: 1, minWidth: 140 }} />
                                <label style={{ fontSize: 11, display: 'flex', gap: 4, alignItems: 'center' }}><input type="checkbox" checked={showInactive} onChange={(e) => setShowInactive(e.target.checked)} /> Inactive too</label>
