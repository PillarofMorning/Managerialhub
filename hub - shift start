                        <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Columns this screen reads</Text></div>
                        {col('craa5__aa_leadershipteam.craa5_teamname', teamsRead > 0, 'text: the crew letter A-D')}
                        {col('craa5__aa_leadershipteam._craa5_teamleademployeeid_value', teams.some((t: TeamRow) => !!t.leadId), 'lookup to the employee: the leader of that crew')}
                        {col('craa5__aa_employee._craa5_leadershipteamid_value', hasKey('_craa5_leadershipteamid_value') || hasKey('craa5_leadershipteamid'), 'lookup to the team: which crew the employee is on')}
                        {col('craa5__aa_employee.craa5_shift', hasKey('craa5_shift'), 'choice: the crew letter used when the team lookup is empty')}
                        {col('craa5_workshift (craa5_shiftcode, craa5_dayname, craa5_shiftstarthour, craa5_shiftendhour)', slotCount > 0, 'which crew is on the clock')}
                        <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Production schedule (table {PROD_TABLE})</Text></div>
                        <Text size={200} block style={{ color: prd && (prd.status === 'missing' || prd.status === 'error') ? BRAND.red : undefined }}>
                            {!prdWindow ? 'No shift window to read for (no shift covers this board).' : !prd || prd.status === 'idle' ? 'Not read yet (it is read when a board opens).' : prd.status === 'reading' ? 'Reading...'
                                : prd.status === 'missing' ? `The table was not found, so no rooms are picked from it. ${String(prd.error).slice(0, 160)}` : prd.status === 'error' ? `Could not be read: ${String(prd.error).slice(0, 200)}`
                                    : `Read through ${prd.source}: ${prd.read} run${prd.read === 1 ? '' : 's'} (a week either side of ${slotLabel(prdWindow.from)} to ${clockTime(prdWindow.to)}), ${prd.lineCount} line${prd.lineCount === 1 ? '' : 's'} known, ${prd.planLines} with a run in this shift.${prd.status === 'empty' ? ' No line has a run in this shift, so the plan is not entered yet and no room is picked from it.' : ''}`}
                        </Text>
                        {prd && prd.status === 'ok' && <Text size={200} block className="mt-1">{prd.down.length ? `Rooms with a line down for an hour or more: ${prd.down.map((d: any) => `${d.name} (${d.lines.join(', ')}; ${d.open ? `from ${clockTime(d.from)}, no restart planned` : `${clockTime(d.from)} to ${clockTime(d.to)}`} - ${d.cleanType || 'Daily Clean'})`).join(' - ')}` : prd.matched.length ? 'Every line that matches a room is running through the shift.' : 'No room name matches a line in the schedule.'}</Text>}
                        {prd && (prd.status === 'ok' || prd.status === 'empty') && prd.unmatched.length > 0 && <Text size={200} block className="mt-1" style={{ color: '#8A5A00' }}>Production rooms with no line of that name in the schedule (rename the room or the schedule line to match, for example IBL5 = area IBL line 5): {prd.unmatched.join(', ')}</Text>}
                        {prd && prd.query && <Text size={200} color="neutralSecondary" block className="mt-1" style={{ wordBreak: 'break-all' }}>Query sent: {prd.query}</Text>}
                        {PROD_FIELDS.slice(1).map(c => col(`${PROD_TABLE}.${c}`, prd && prd.read > 0 ? prd.hasColumns.some((k: string) => k.toLowerCase() === c) : null, c === 'craa5_area' ? 'text: the production area, e.g. IBL, Breading' : c === 'craa5_line' ? 'whole number: the line number inside that area' : c === 'craa5_product' ? 'text: the product (a Maintenance run keeps the line busy)' : 'date and time: when the run starts / ends'))}
                        <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>This crew's earlier boards (table {TASK_TABLE}, last {HIST_DAYS} days)</Text></div>
                        <Text size={200} block style={{ color: histStatus.state === 'error' || (hist && (hist.failedPieces > 0 || hist.capped > 0)) ? BRAND.red : undefined }}>
                            {!histNames.length ? 'No supervisor name to read for (no board is open).' : histStatus.state === 'idle' ? 'Not read yet (it is read a moment after a board opens).' : histStatus.state === 'reading' ? 'Reading...' : histStatus.state === 'error' ? `Could not be read: ${String(histStatus.error).slice(0, 220)}` : hist ? `${histStatus.fromCache ? `Kept on this computer since ${clockTime(hist.at)}` : `Read through ${hist.source}`}: ${hist.rows} row${hist.rows === 1 ? '' : 's'} in ${hist.pieces} piece${hist.pieces === 1 ? '' : 's'} of up to ${HIST_PIECE_DAYS} days, ${hist.boards.length} shift board${hist.boards.length === 1 ? '' : 's'} kept (the newest ${HIST_KEEP_BOARDS} are kept), ${Object.keys(hist.strength).length} names with room history.${hist.capped ? ` ${hist.capped} piece${hist.capped === 1 ? '' : 's'} hit the ${HIST_CAP} row limit, so the oldest rows of ${hist.capped === 1 ? 'it' : 'them'} are missing.` : ''}${hist.failedPieces ? ` ${hist.failedPieces} piece${hist.failedPieces === 1 ? '' : 's'} could not be read (${String(hist.error).slice(0, 120)}).` : ''}` : 'Nothing kept.'}
                        </Text>
                        {histNames.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Teams read (the supervisor name each board was saved under): {histNames.join(' - ')}</Text>}
                        {hist && hist.query && <Text size={200} color="neutralSecondary" block className="mt-1" style={{ wordBreak: 'break-all' }}>Query sent: {hist.query}</Text>}
                        {HIST_COLUMNS.map(c => col(`${TASK_TABLE}.${c}`, hist && hist.rows > 0 ? hist.columns.some((k: string) => k.toLowerCase() === c) : null, HIST_COLUMN_WHY[c] || ''))}
                        {hist && hist.boards.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Boards kept: {hist.boards.slice(0, 8).map((b: HistBoard) => `${formatFullName(b.team)} ${boardLabel(b.startMs)} (${b.people.filter(p => !!p.emp).length} people)`).join(' - ')}</Text>}
                        <Text size={200} block className="mt-1" style={{ color: remembered && !remembered.applied ? '#8A5A00' : undefined }}>{remembered ? `Remembered team: ${remembered.text}${remembered.applied ? ` ${remembered.people} ${remembered.people === 1 ? 'person' : 'people'} in ${remembered.rooms} ${remembered.rooms === 1 ? 'room' : 'rooms'}${remembered.skipped.length ? `; left out because they are away or busy: ${remembered.skipped.join(', ')}` : ''}.` : ''} (${remembered.sameTime} earlier board${remembered.sameTime === 1 ? '' : 's'} at this start time${remembered.matching >= 0 ? `, ${remembered.matching} with the same lines down` : ', lines down not compared'}.)` : 'Remembered team: not looked for on this board yet (it needs the history, the production schedule and an untouched board).'}</Text>
                        <div className="mt-1"><Button size="small" appearance="secondary" onClick={onReread}>Read history again</Button></div>
                        <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Next-shift setups (table {PRESET_TABLE})</Text></div>
                        <Text size={200} block style={{ color: presetStore.remote === 'ok' ? undefined : presetStore.remote === 'unknown' ? undefined : BRAND.red }}>
                            {presetStore.remote === 'ok' ? `The table was read: ${presets.filter((b: any) => b.where === 'dataverse').length} setup${presets.filter((b: any) => b.where === 'dataverse').length === 1 ? '' : 's'} in it.` : presetStore.remote === 'missing' ? `The table ${PRESET_TABLE} was not found, so setups are kept on this computer (${presetStore.localCount} here). Create it with the columns below and save again to share setups through Dataverse.` : presetStore.remote === 'error' ? `The table could not be read (${String(presetStore.error).slice(0, 160)}); setups are kept on this computer (${presetStore.localCount} here).` : 'Not read yet.'}
                        </Text>
                        {PRESET_COLUMNS.map(c => col(`${PRESET_TABLE}.${c.name}`, c.name === 'craa5_title' || c.name === 'craa5_boardjson' ? (presetStore.remote === 'ok' && presetLog && presetLog.where === 'dataverse' ? colState(c.name) : null) : colState(c.name), `${c.type} - ${c.optional ? 'optional' : 'needed'} - ${c.why}`))}
                        {presets.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Setups held: {presets.map((b: any) => `${b.crew} ${slotLabel(b.slotStart)} by ${b.supervisor || '?'} (${b.where === 'device' ? 'this computer' : 'Dataverse'})`).join(' - ')}</Text>}
                        {presetLog && <div className="mt-2 p-2 rounded-lg border border-slate-200" style={{ background: BRAND.blueSoft }}><Text size={200} weight="semibold" block>Last setup save - {clockTime(new Date(presetLog.at).getTime())} - {presetLog.where === 'dataverse' ? 'sent to Dataverse' : 'kept on this computer'} - {presetLog.rows} board row{presetLog.rows === 1 ? '' : 's'}</Text>
                            <Text size={200} block style={{ color: presetLog.error ? BRAND.red : undefined, wordBreak: 'break-all' }}>{presetLog.error ? `Why: ${String(presetLog.error).slice(0, 220)}. ` : ''}{presetLog.refused && presetLog.refused.length ? `Refused: ${presetLog.refused.length ? presetLog.refused.join(', ') : ''}. ` : ''}Sent: {Object.keys(presetLog.sent || {}).map(k => k === 'craa5_boardjson' ? `${k} (${String(presetLog.sent[k]).length} characters)` : `${k} = ${String(presetLog.sent[k]).slice(0, 60)}`).join(' - ')}</Text></div>}
                        {employees.length > 0 && <div className="mt-3"><Text size={200} weight="bold" block className="mb-1">Who is on crew {currentShift || boardCrew || '?'} and how they were placed</Text>
                            <Text size={200} color="neutralSecondary" block>{employees.filter((e: any) => crewOfPerson(e) === (currentShift || boardCrew)).map((e: any) => `${formatFullName(getField(e, 'craa5_name'))} (${roleOf(e)}, ${sourceOf(e)})`).join(' - ') || 'nobody'}</Text></div>}
                    </div>
                </div>
            </div>
        </div>
    );
}

const ScreenTitle = ({ children, sub }: any) => (
    <div className="mb-1">
        <h1 className="ss-dark-title text-xl font-black uppercase tracking-widest" style={{ color: BRAND.blueDark }}>{children}</h1>
        {sub && <Text size={300} color="neutralSecondary" block>{sub}</Text>}
    </div>
);

const Grid = ({ items, columns, selectionMode, selectedItems, onSelectionChange }: any) => (
    <DataGrid items={items} columns={columns} selectionMode={selectionMode} getRowId={(item: any) => getField(item, 'craa5__aa_employeeid')} selectedItems={selectedItems} onSelectionChange={onSelectionChange} className="ss-datagrid bg-white rounded-xl border border-slate-200 shadow-sm">
        <DataGridHeader className="ss-grid-header" style={{ background: BRAND.blueSoft }}><DataGridRow>{({ renderHeaderCell }: any) => <DataGridHeaderCell>{renderHeaderCell()}</DataGridHeaderCell>}</DataGridRow></DataGridHeader>
        <DataGridBody>{({ item }: any) => <DataGridRow key={getField(item, 'craa5__aa_employeeid')} className="cursor-pointer">{({ renderCell }: any) => <DataGridCell>{renderCell(item)}</DataGridCell>}</DataGridRow>}</DataGridBody>
    </DataGrid>
);
const nameColumn = (label: string) => createTableColumn({ columnId: "craa5_name", renderHeaderCell: () => <Text weight="bold">{label}</Text>, renderCell: (item: any) => <TableCellLayout media={<span></span>}>{renderSafe(formatFullName(getField(item, 'craa5_name')))}</TableCellLayout> });
const makeShiftColumn = () => createTableColumn({ columnId: "craa5_shift", renderHeaderCell: () => <Text weight="bold">{tx("Shift", "Turno")}</Text>, renderCell: (item: any) => <TableCellLayout>{renderSafe(crewOfPerson(item) || getFormattedField(item, 'craa5_shift') || getField(item, 'craa5_shift') || "N/A")}</TableCellLayout> });

function SupervisorSelectionScreen({ supervisors, selectedSupervisorId, onSelect, note }: any) {
    const columns = [
        nameColumn(tx("Supervisor Name", "Nombre del Supervisor")),
        createTableColumn({ columnId: "craa5_role", renderHeaderCell: () => <Text weight="bold">{tx("Role", "Puesto")}</Text>, renderCell: (item: any) => <TableCellLayout>{trDv(hasSupervisorInTitle(item) ? "Supervisor" : roleOf(item) === 'manager' ? "Manager" : roleOf(item) === 'lead' ? "Lead" : renderSafe(getFormattedField(item, 'craa5_role') || getField(item, 'craa5_role') || "Employee"))}</TableCellLayout> }),
        makeShiftColumn(),
    ];
    return (
        <div className="p-5 h-full flex flex-col max-w-[800px] mx-auto w-full box-border">
            <div className="mb-6 text-center mt-10"><Text as="h1" size={600} weight="semibold" block className="ss-dark-title mb-2" style={{ color: BRAND.blueDark }}>{tx("Welcome to Shift Assignment", "Bienvenido a Asignacion de Turno")}</Text><Text size={400} color="neutralSecondary" block>{tx("Select a Supervisor below to view or manage their board.", "Selecciona un Supervisor abajo para ver o administrar su tablero.")}</Text>{note && <Text size={300} weight="semibold" block className="mt-2" style={{ color: BRAND.red }}>{note}</Text>}</div>
            <Grid items={filterActiveEmployees(supervisors)} columns={columns} selectionMode="single" selectedItems={selectedSupervisorId ? new Set([selectedSupervisorId]) : new Set()} onSelectionChange={(e: any, data: any) => { const selected = Array.from(getSelectionValue(e, data))[0]; if (selected) onSelect(selected); }} />
        </div>
    );
}

function LeadSelectionScreen({ leads, selectedLeadIds, onSelectChange, onSearchCustom, crewNote, allEmployees, onAddLead, selectedSupervisorId, currentUser }: any) {
    const [searchText, setSearchText] = useState("");
    const [isFocused, setIsFocused] = useState(false);
    const activeLeads = useMemo(() => filterActiveEmployees(leads || []), [leads]);
    const columns = [nameColumn(tx("Lead Name", "Nombre del Lider")), makeShiftColumn()];

    // Lazy load / typeahead potential matches from all active workforce (including off-shift leads)
    const suggestions = useMemo(() => {
        const query = (searchText || "").trim().toLowerCase();
        if (!query || !allEmployees || !allEmployees.length) return [];
        return filterActiveEmployees(allEmployees)
            .filter((e: any) => {
                const id = getField(e, 'craa5__aa_employeeid');
                if (id === selectedSupervisorId) return false;
                const name = renderSafe(getField(e, 'craa5_name')).toLowerCase();
                const badge = renderSafe(getField(e, 'craa5_badgenumber')).toLowerCase();
                return name.includes(query) || badge.includes(query);
            })
            .slice(0, 8);
    }, [searchText, allEmployees, selectedSupervisorId]);

    const handleSelectCandidate = (emp: any) => {
        const id = getField(emp, 'craa5__aa_employeeid');
        if (onAddLead) onAddLead(emp);
        else if (onSearchCustom) onSearchCustom(renderSafe(getField(emp, 'craa5_name')));
        const next = new Set(selectedLeadIds);
        next.add(id);
        onSelectChange(next);
        setSearchText("");
        setIsFocused(false);
    };

    const myId = currentUser ? getField(currentUser, 'craa5__aa_employeeid') : "";
    const isCurrentUserLead = currentUser && (roleOf(currentUser) === 'lead' || currentUser.calculatedRole === 'lead');
    const isMeInLeadList = !!myId && selectedLeadIds.has(myId);

    return (
        <div className="p-5 h-full flex flex-col box-border overflow-y-auto">
            <div className="flex items-center justify-between flex-wrap gap-2">
                <ScreenTitle sub={crewNote}>{tx("Select Leads", "Seleccionar Lideres")}</ScreenTitle>
                {isCurrentUserLead && myId !== selectedSupervisorId && !isMeInLeadList && (
                    <Button
                        size="small"
                        appearance="primary"
                        onClick={() => handleSelectCandidate(currentUser)}
                    >
                        {tx(`+ Add Myself (${formatFullName(getField(currentUser, 'craa5_name'))}) as Active Lead`, `+ Agregarme (${formatFullName(getField(currentUser, 'craa5_name'))}) como Lider Activo`)}
                    </Button>
                )}
            </div>
            <div className="relative my-4 max-w-[650px] z-30">
                <div className="flex gap-2">
                    <Input
                        placeholder={tx("Search any lead or off-shift lead by name or badge...", "Buscar lider o lider de otro turno por nombre o gafete...")}
                        value={searchText}
                        onChange={(e: any, d: any) => setSearchText(getInputValue(e, d))}
                        onFocus={() => setIsFocused(true)}
                        onBlur={() => setTimeout(() => setIsFocused(false), 250)}
                        onKeyDown={(e) => {
                            if (e.key === 'Enter') {
                                if (suggestions.length > 0) handleSelectCandidate(suggestions[0]);
                                else if (searchText.trim()) { onSearchCustom(searchText.trim()); setSearchText(""); }
                            }
                        }}
                        className="flex-1"
                    />
                    <Button appearance="primary" onClick={() => {
                        if (suggestions.length > 0) handleSelectCandidate(suggestions[0]);
                        else if (searchText.trim()) { onSearchCustom(searchText.trim()); setSearchText(""); }
                    }}>
                        {tx("Add", "Agregar")}
                    </Button>
                </div>
                {isFocused && suggestions.length > 0 && (
                    <div className="absolute top-full left-0 right-0 bg-white border border-slate-300 rounded-xl shadow-xl mt-1.5 overflow-hidden z-50 divide-y divide-slate-100 max-h-[280px] overflow-y-auto">
                        <div className="px-3 py-1.5 bg-[#E6F1FB] text-[10px] font-black uppercase tracking-wider text-[#00468B]">
                            {tx(`Potential Matches (${suggestions.length}) - Click to Add as Lead`, `Coincidencias (${suggestions.length}) - Toca para Agregar como Lider`)}
                        </div>
                        {suggestions.map((s: any) => {
                            const sId = getField(s, 'craa5__aa_employeeid');
                            const sName = formatFullName(getField(s, 'craa5_name'));
                            const sCrew = crewOfPerson(s);
                            const sRole = roleOf(s);
                            const isSelected = selectedLeadIds.has(sId);
                            return (
                                <div
                                    key={sId}
                                    onMouseDown={(e) => { e.preventDefault(); handleSelectCandidate(s); }}
                                    className="px-3.5 py-2.5 hover:bg-[#F0F7FD] cursor-pointer flex items-center justify-between transition-colors"
                                >
                                    <div className="flex items-center gap-2">
                                        <span className="font-bold text-xs text-slate-800">{sName}</span>
                                        {sCrew && <Badge size="small" appearance="outline" color="brand">{tx('Shift', 'Turno')} {sCrew}</Badge>}
                                        <span className="text-[10px] font-semibold text-slate-400 capitalize">{trDv(sRole)}</span>
                                    </div>
                                    <span className={`text-[10px] font-extrabold px-2.5 py-0.5 rounded-full ${isSelected ? 'bg-green-100 text-green-800' : 'bg-[#0072CE] text-white shadow-2xs'}`}>
                                        {isSelected ? tx('Added', 'Agregado') : tx('+ Add Lead', '+ Agregar Lider')}
                                    </span>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
            <Grid items={activeLeads} columns={columns} selectionMode="multiselect" selectedItems={selectedLeadIds} onSelectionChange={(e: any, data: any) => onSelectChange(getSelectionValue(e, data))} />
        </div>
    );
}

function AreaSelectionScreen({ areas, selectedAreaIds, onSelectChange, onAddCustomArea, prd, prdReasons, prdWindowLabel, getAreaCleanType, onCycleAreaCleanType, priorShiftRoomState, onApplyPassoffRooms }: any) {
    const [searchText, setSearchText] = useState("");
    const [customText, setCustomText] = useState("");
    const filtered = areas.filter((a: any) => {
        const raw = renderSafe(getField(a, 'craa5_area')).toLowerCase();
        const tr = trDv(renderSafe(getField(a, 'craa5_area'))).toLowerCase();
        const q = searchText.toLowerCase();
        return raw.includes(q) || tr.includes(q);
    });
    const assignedList = filtered.filter((a: any) => selectedAreaIds.has(getField(a, 'craa5_aa_mss_areaid')));
    const unassignedList = filtered.filter((a: any) => !selectedAreaIds.has(getField(a, 'craa5_aa_mss_areaid')));
    const productionList = unassignedList.filter((a: any) => isProductionArea(a));
    const supportingList = unassignedList.filter((a: any) => !isProductionArea(a));

    const handleDrop = (e: React.DragEvent, assign: boolean) => {
        const areaId = e.dataTransfer?.getData("areaId") || GLOBAL_DRAG_PAYLOAD;
        if (!areaId) return;
        const next = new Set(selectedAreaIds);
        if (assign) next.add(areaId); else next.delete(areaId);
        onSelectChange(next);
        GLOBAL_DRAG_PAYLOAD = null;
    };

    const toggleSingleArea = (areaId: string, assign: boolean) => {
        if (!areaId) return;
        const next = new Set(selectedAreaIds);
        if (assign) next.add(areaId); else next.delete(areaId);
        onSelectChange(next);
    };

    const renderDraggableArea = (a: any, isAssignedCol: boolean) => {
        const aId = String(getField(a, 'craa5_aa_mss_areaid') || '');
        const aNameRaw = String(getFormattedField(a, 'craa5_area') || getField(a, 'craa5_area') || getField(a, 'craa5_areaname') || 'Unnamed Area').trim();
        const aName = trDv(aNameRaw);
        const cType = getAreaCleanType ? getAreaCleanType(aId) : (isEverydayArea(a) || !isProductionArea(a) ? 'Everyday Clean' : 'Daily Clean');
        const cMeta = getCleanTypeMeta(cType);
        const passoff = priorShiftRoomState ? priorShiftRoomState.get(aId) : null;

        return (
            <div
                key={aId}
                draggable={true}
                onDragStart={e => { GLOBAL_DRAG_PAYLOAD = aId; if (e.dataTransfer) e.dataTransfer.setData("areaId", aId); }}
                onDoubleClick={() => toggleSingleArea(aId, !isAssignedCol)}
                title={isAssignedCol ? tx("Drag or double-click to remove from today's areas", "Arrastra o haz doble clic para quitar de las areas de hoy") : tx("Drag or double-click to assign for today", "Arrastra o haz doble clic para asignar hoy")}
                className="px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg cursor-grab text-xs font-semibold text-slate-700 shadow-2xs hover:border-[#0072CE] transition-all select-none shrink-0 flex flex-col justify-center gap-1"
            >
                <div className="flex items-center justify-between gap-1">
                    <span className="truncate font-bold">{aName}</span>
                    <div className="flex items-center gap-1 shrink-0">
                        <span>{getAreaEmoji(a)}</span>
                        {!isStatusArea(aNameRaw) && onCycleAreaCleanType && (
                            <button
                                type="button"
                                onClick={(e) => { e.stopPropagation(); onCycleAreaCleanType(aId); }}
                                style={{ background: cMeta.bg, color: cMeta.fg, borderColor: cMeta.border }}
                                className="text-[9px] font-extrabold px-1.5 py-0.5 rounded border transition-colors cursor-pointer whitespace-nowrap"
                                title={tx(`Type of Clean: ${cMeta.label} (auto-loaded from Production Scheduler; click to change clean type)`, `Tipo de Limpieza: ${cMeta.label} (cargado del Horario de Produccion; toca para cambiar)`)}
                            >
                                {cMeta.short}
                            </button>
                        )}
                        <button
                            type="button"
                            onClick={(e) => { e.stopPropagation(); toggleSingleArea(aId, !isAssignedCol); }}
                            className={`text-[10px] font-black px-1.5 py-0.2 rounded transition-colors cursor-pointer ${isAssignedCol ? 'text-slate-400 hover:text-red-600 hover:bg-red-50' : 'text-[#0072CE] hover:bg-blue-50'}`}
                            title={isAssignedCol ? tx("Remove area", "Quitar cuarto") : tx("Add area", "Agregar cuarto")}
                        >
                            {isAssignedCol ? 'X' : '+'}
                        </button>
                    </div>
                </div>
                {prdReasons && prdReasons[aId] && (
                    <div className="text-[9px] font-bold text-[#0072CE] truncate" title={tx("From the production schedule (craa5__aa_prd_schd)", "Del horario de produccion (craa5__aa_prd_schd)")}>
                        {trDv(prdReasons[aId])}
                    </div>
                )}
                {passoff && (
                    <div className="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200 truncate" title={tx(`Prior shift passoff${passoff.priorShift ? ` (Shift ${passoff.priorShift})` : ''}: ${passoff.priorStatus || 'In Progress'}${passoff.priorLeftToDo ? ` - Left: ${passoff.priorLeftToDo}` : ''}`, `Entrega turno anterior${passoff.priorShift ? ` (Turno ${passoff.priorShift})` : ''}: ${trDv(passoff.priorStatus || 'In Progress')}${passoff.priorLeftToDo ? ` - Falta: ${trDv(passoff.priorLeftToDo)}` : ''}`)}>
                        {tx('Passoff', 'Entrega')}{passoff.priorShift ? ` (${tx('Shift', 'Turno')} ${passoff.priorShift})` : ''}: {trDv(passoff.priorLeftToDo || passoff.priorStatus || `${passoff.priorPct || 0}% in progress`)}
                    </div>
                )}
            </div>
        );
    };

    const prdMissing = prd && prd.status === 'ok' ? prd.down.filter((d: any) => !selectedAreaIds.has(d.areaId)) : [];
    const prdLine = !prd ? null : prd.status === 'reading' ? tx('Reading the production schedule...', 'Leyendo el horario de produccion...')
        : prd.status === 'ok' ? (prd.down.length ? tx(`Production schedule${prdWindowLabel}: ${prd.down.length} room${prd.down.length === 1 ? ' has' : 's have'} a line down (${prd.down.map((d: any) => `${d.name} - ${d.cleanType || 'Daily Clean'}`).join(', ')}).`, `Horario de produccion${prdWindowLabel}: ${prd.down.length} ${prd.down.length === 1 ? 'cuarto tiene' : 'cuartos tienen'} linea parada (${prd.down.map((d: any) => `${trDv(d.name)} - ${trDv(d.cleanType || 'Daily Clean')}`).join(', ')}).`)
            : prd.matched.length ? tx(`Production schedule${prdWindowLabel}: every room that matches a line has it running through the shift.`, `Horario de produccion${prdWindowLabel}: todas las lineas estan corriendo durante el turno.`) : tx(`Production schedule${prdWindowLabel}: no room name matches a line in the schedule, so nothing is picked from it (Data check lists the names).`, `Horario de produccion${prdWindowLabel}: ningun cuarto coincide con una linea del horario.`))
            : prd.status === 'empty' ? tx(`Production schedule${prdWindowLabel}: no runs are entered for this shift yet, so nothing is picked from it.`, `Horario de produccion${prdWindowLabel}: aun no hay corridas registradas para este turno.`)
                : prd.status === 'missing' ? tx(`The production schedule table (${PROD_TABLE}) was not found, so nothing is picked from it.`, `No se encontro la tabla de horario de produccion (${PROD_TABLE}).`)
                    : prd.status === 'error' ? tx(`The production schedule could not be read (${String(prd.error).slice(0, 140)}), so nothing is picked from it.`, `No se pudo leer el horario de produccion (${String(prd.error).slice(0, 140)}).`) : null;

    const passoffEntries = priorShiftRoomState ? Array.from(priorShiftRoomState.entries()) : [];

    const column = (title: string, list: any[], assign: boolean, cls: string, titleColor: string, empty: string) => (
        <div onDragOver={(e) => e.preventDefault()} onDrop={(e) => handleDrop(e, assign)} className={`flex-1 min-w-[240px] rounded-xl border-2 border-dashed p-3 flex flex-col box-border overflow-hidden min-h-0 ${cls}`}>
            <div className="mb-2 shrink-0 pb-1.5 border-b border-slate-200/80 flex items-center justify-between">
                <Text weight="bold" block className="ss-area-col-title uppercase tracking-wider text-xs font-black" style={{ color: titleColor }}>
                    {title} ({list.length})
                </Text>
                <span className="text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-white/90 border border-slate-200 text-slate-600">
                    {list.length} {list.length === 1 ? tx('Area', 'Cuarto') : tx('Areas', 'Cuartos')}
                </span>
            </div>
            <div className="flex-1 overflow-y-auto pr-1 pb-2 min-h-0 grid grid-cols-1 xl:grid-cols-2 gap-1.5 content-start">
                {list.map(a => renderDraggableArea(a, assign))}
                {list.length === 0 && <Text size={200} color="neutralSecondary" className="italic text-center py-4 col-span-full">{empty}</Text>}
            </div>
        </div>
    );

    return (
        <div className="p-3 md:p-4 h-full max-h-full min-h-0 flex flex-col box-border overflow-hidden">
            <div className="flex items-center justify-between flex-wrap gap-2 shrink-0">
                <div className="flex items-center gap-2 flex-wrap">
                    <ScreenTitle>{tx("Select Active Areas", "Seleccionar Cuartos Activos")}</ScreenTitle>
                    <span className="text-[11px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-lg">
                        {tx("Tip: Click the Clean Type pill (Daily / Allergen / 72h / EOW) on any room to change its clean type", "Tip: Toca la etiqueta de Tipo de Limpieza (Diaria / Alergenos / 72h / EOW) en cualquier cuarto para cambiarla")}
                    </span>
                </div>
                <div className="flex items-center gap-2 flex-wrap">
                    <Input size="small" placeholder={tx("Filter areas...", "Filtrar cuartos...")} value={searchText} onChange={(e: any, d: any) => setSearchText(getInputValue(e, d))} />
                    <Input size="small" placeholder={tx("Custom area...", "Nuevo cuarto...")} value={customText} onChange={(e: any, d: any) => setCustomText(getInputValue(e, d))} />
                    <Button size="small" onClick={() => { if (customText.trim()) onAddCustomArea(customText.trim()); setCustomText(""); }}>{tx("Add Custom", "Agregar Cuarto")}</Button>
                    <Button size="small" appearance="primary" onClick={() => {
                        const next = new Set(selectedAreaIds);
                        areas.filter((a: any) => !isEverydayArea(a) && isProductionArea(a)).forEach((a: any) => next.add(getField(a, 'craa5_aa_mss_areaid')));
                        onSelectChange(next);
                    }}>{tx("Auto-Complete Non-Everyday", "Agregar Todos Produccion")}</Button>
                </div>
            </div>
            {prdLine && <div className="ss-prd-banner mt-1.5 mb-1.5 px-3 py-1.5 rounded-lg border text-xs font-semibold flex items-center justify-between gap-2 flex-wrap shrink-0" style={{ background: prd.status === 'ok' ? BRAND.blueSoft : BRAND.yellowSoft, borderColor: prd.status === 'ok' ? BRAND.blue : BRAND.yellow, color: prd.status === 'ok' ? BRAND.blueDark : '#8A5A00' }}>
                <span>{prdLine}</span>
                {prdMissing.length > 0 && <Button size="small" appearance="primary" onClick={() => { const next = new Set(selectedAreaIds); prdMissing.forEach((d: any) => next.add(d.areaId)); onSelectChange(next); }}>{tx(`Add ${prdMissing.length} from production schedule`, `Agregar ${prdMissing.length} del horario de produccion`)}</Button>}
            </div>}
            {passoffEntries.length > 0 && (
                <div className="mb-1.5 px-3 py-1.5 rounded-lg border border-amber-300 bg-amber-50 text-amber-900 text-xs font-semibold flex items-center justify-between gap-2 flex-wrap shrink-0">
                    <span>
                        {tx(`Incoming Shift Passoff (${passoffEntries.length} ${passoffEntries.length === 1 ? 'room' : 'rooms'} with unfinished work or passoff notes): `, `Entrega del Turno Anterior (${passoffEntries.length} ${passoffEntries.length === 1 ? 'cuarto' : 'cuartos'} pendientes o con notas): `)}
                        {passoffEntries.slice(0, 5).map(([aid, st]: [string, any]) => {
                            const ao = areas.find((x: any) => String(getField(x, 'craa5_aa_mss_areaid')) === aid);
                            const nm = trDv(ao ? renderSafe(getField(ao, 'craa5_area')) : aid);
                            return `${nm}${st.priorLeftToDo ? ` (${tx('Left', 'Falta')}: ${trDv(st.priorLeftToDo)})` : st.priorStatus ? ` (${trDv(st.priorStatus)})` : ''}`;
                        }).join(' - ')}
                    </span>
                    {onApplyPassoffRooms && (
                        <Button size="small" appearance="primary" onClick={onApplyPassoffRooms}>
                            {tx("Include Passoff Rooms & Notes", "Incluir Cuartos y Notas de Entrega")}
                        </Button>
                    )}
                </div>
            )}
            <div className="flex gap-3 flex-1 overflow-hidden min-h-0 mt-1">
                {column(tx("Supporting Areas", "Areas de Soporte"), supportingList, false, "bg-slate-50 border-slate-300", "#334155", tx("No unassigned supporting areas found.", "No hay areas de soporte sin asignar."))}
                {column(tx("Production Areas", "Cuartos de Produccion"), productionList, false, "bg-[#FFF6E0] border-[#FFB81C]", "#8A5A00", tx("No unassigned production areas found.", "No hay cuartos de produccion sin asignar."))}
                {column(tx("Assigned For Today", "Asignados Para Hoy"), assignedList, true, "bg-[#E6F1FB] border-[#0072CE]", BRAND.blueDark, tx("Drag or click + on areas to assign...", "Arrastra o toca + en los cuartos para asignar..."))}
            </div>
        </div>
    );
}

