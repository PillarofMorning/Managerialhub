    const runLiveSchemaRefresh = async () => {
        setCheckingSchema(true);
        try {
            // 1. Reset negative caches so newly added background columns/tables in Dataverse are discovered immediately
            ENDPOINT_META.noSelectTables = {};
            ENDPOINT_META.taskCoreOnly = false;
            saveEndpointMeta();
            PRD_CACHE = {};
            Object.keys(TABLE_STATE).forEach(k => { TABLE_STATE[k] = 'unknown'; delete TABLE_ERROR[k]; });

            const webApi = getWebApi(hostProps), dataApi = hostProps?.dataApi;
            const results: Record<string, { status: 'ok' | 'missing' | 'error'; rowCount: number; foundCols: string[]; missingCols: string[]; error: string }> = {};

            await Promise.all(PROBE_SPECS.map(async (spec) => {
                try {
                    let rows: any[] = [];
                    if (webApi?.retrieveMultipleRecords) {
                        const res: any = await asyncRace(webApi.retrieveMultipleRecords(spec.table, `?$top=5`), API_TIMEOUT_MS, `probe ${spec.table}`);
                        rows = Array.isArray(res?.entities) ? res.entities : [];
                    } else if (dataApi?.queryTable) {
                        rows = await queryDataApi(dataApi, spec.table, "", { top: 5 });
                    } else {
                        throw new Error("No Dataverse WebApi/dataApi connection in this host");
                    }
                    sniffTableCols(spec.table, rows);
                    const keySet = new Set<string>();
                    rows.forEach(r => Object.keys(r || {}).forEach(k => keySet.add(k.toLowerCase())));
                    const foundCols: string[] = [];
                    const missingCols: string[] = [];
                    spec.expectedCols.forEach(ec => {
                        const ecLow = ec.toLowerCase();
                        const alts = FIELD_ALIASES[ecLow] || [];
                        if (rows.length === 0 || keySet.has(ecLow) || alts.some(a => keySet.has(a))) foundCols.push(ec);
                        else missingCols.push(ec);
                    });
                    setTableState(spec.table, 'ok');
                    results[spec.table] = { status: 'ok', rowCount: rows.length, foundCols, missingCols, error: '' };
                } catch (e: any) {
                    const msg = String(e?.message || e || 'Failed');
                    const isMiss = looksMissing(msg);
                    setTableState(spec.table, isMiss ? 'missing' : 'error', msg);
                    results[spec.table] = { status: isMiss ? 'missing' : 'error', rowCount: 0, foundCols: [], missingCols: spec.expectedCols, error: msg.slice(0, 180) };
                }
            }));

            setLiveProbeResults(results);
            setSchemaLastChecked(new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', second: '2-digit' }));

            // 2. Pull fresh background records into the live application state
            if (onRefreshBackground) {
                await onRefreshBackground();
            }
        } finally {
            setCheckingSchema(false);
        }
    };

    const nameOf = (id: string) => { const e = employees.find((x: any) => empIdOf(x) === id); return e ? formatFullName(getField(e, 'craa5_employeename')) : ""; };
    const withLookup = employees.filter((e: any) => !!teamIdOfEmp(e)).length;
    const sample = employees[0] || {}, hasKey = (k: string) => Object.keys(sample).some(x => x.toLowerCase() === k.toLowerCase() || (FIELD_ALIASES[k.toLowerCase()] || []).includes(x.toLowerCase()));
    const sourceOf = (e: any) => teamLedBy(e) ? 'lead of the team' : teamIdOfEmp(e) && TEAMS.some(t => t.id === teamIdOfEmp(e)) ? 'team lookup' : 'shift letter';
    const row = (k: string, v: any, bad?: boolean) => <div key={k} className="flex gap-3 py-1 border-b border-slate-100"><Text size={200} weight="semibold" style={{ width: 150, flexShrink: 0 }}>{k}</Text><Text size={200} style={{ color: bad ? BRAND.red : undefined }}>{v}</Text></div>;
    const col = (name: string, ok: boolean | null, why: string) => <div key={name} className="flex gap-2 py-0.5 items-center flex-wrap"><Badge size="small" appearance="filled" color={ok === null ? 'informative' : ok ? 'success' : 'danger'}>{ok === null ? 'not checked' : ok ? 'found' : 'missing'}</Badge><Text size={200} weight="semibold">{name}</Text><Text size={200} color="neutralSecondary">{why}</Text></div>;
    const sentKeys = presetLog && presetLog.where === 'dataverse' ? Object.keys(presetLog.sent || {}) : [];
    const colState = (name: string): boolean | null => presetLog && presetLog.refused && presetLog.refused.indexOf(name) >= 0 ? false : sentKeys.indexOf(name) >= 0 ? true : null;

    return (
        <div style={{ position: 'absolute', inset: 0, background: 'rgba(0,30,60,0.45)', zIndex: 10000, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 16 }} onClick={onClose}>
            <div className="bg-white rounded-2xl shadow-lg border border-slate-200 w-full max-w-[960px] flex flex-col" style={{ maxHeight: '100%' }} onClick={e => e.stopPropagation()}>
                <div className="flex justify-between items-center px-5 py-3 border-b-4 border-[#FFB81C] shrink-0 flex-wrap gap-2">
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
