export function MainComponent(props: any) {
    const propsRef = useRef(props); useEffect(() => { propsRef.current = props; }, [props]);
    const reopenSeq = useRef(0);   // each reopenBoard takes a number; an older one that finishes late does nothing

    const [msUser, setMsUser] = useState<any>(null);
    const [presetsApplied, setPresetsApplied] = useState(false);
    const [hasAutoAssignedEveryday, setHasAutoAssignedEveryday] = useState(false);
    const [prd, setPrd] = useState<PrdState>(PRD_IDLE);                  // what the production schedule says about this shift's window
    const [prdApplied, setPrdApplied] = useState(false);                 // the prd rooms were added (or decided against) for this board
    const prdSeq = useRef(0), prdInFlight = useRef("");
    const [histByKey, setHistByKey] = useState<Record<string, History>>({});   // each crew's last six weeks of saved boards, summarised (a few crews at most)
    const [histStatus, setHistStatus] = useState<HistStatus>(HIST_IDLE);
    const [histReload, setHistReload] = useState(0);                     // the Data check button asks for a fresh read
    const histSeq = useRef(0), histInFlight = useRef(""), histForce = useRef(false), histDone = useRef<Record<string, number>>({});   // histDone: read token -> when it is read again
    const [rememberedTried, setRememberedTried] = useState(false);       // the remembered team was looked for (and used, or decided against) for this board
    const [rememberedLog, setRememberedLog] = useState<RememberedLog | null>(null);
    const [suggestMode, setSuggestMode] = useState<SuggestMode>('normal');  // the suggestion preset: Normal = best fit, Training = the reverse (kept while the app is open, Normal each time it opens)
    const [boardFresh, setBoardFresh] = useState(false);                  // the board is empty because nothing was saved or set up for this shift (not because what was saved came out empty)
    const [collapsedBuckets, setCollapsedBuckets] = useState<Set<string>>(new Set());
    const [currentStep, setCurrentStep] = useState(0);
    const [currentShift, setCurrentShift] = useState("");          // from craa5_workshift
    const [shiftStartMs, setShiftStartMs] = useState(0);
    const [upNextShift, setUpNextShift] = useState("");           // the crew starting within the hour, if any
    const [boardShiftStart, setBoardShiftStart] = useState(0);     // the shift start the board was opened under (the clock moving past it offers a refresh)
    const [hydrateTick, setHydrateTick] = useState(0);              // counts loads, so the crew lists are worked out again after every one (sign-in included)
    const [appHeight, setAppHeight] = useState(window.innerHeight);
    const [isLoading, setIsLoading] = useState(true);   // the saved assignments are read on every open, so there is always a short load
    const [adminMode, setAdminMode] = useState(false);
    const [currentUser, setCurrentUser] = useState<any>(null);
    const [selectedSupervisorId, setSelectedSupervisorId] = useState<string | null>(null);

    // Core collections
    const [supervisors, setSupervisors] = useState<any[]>([]);
    const [leads, setLeads] = useState<any[]>([]);
    const [employees, setEmployees] = useState<any[]>([]);
    const [allEmployees, setAllEmployees] = useState<any[]>([]);
    const [areas, setAreas] = useState<any[]>([]);
    const [presetRecords, setPresetRecords] = useState<any[]>([]);

    // Board
