// One 14 day piece of task assignment rows across all supervisors/teams, newest first, so employee experience across all shifts is accurately counted.
async function readHistoryPiece(props: any, names: string[], fromMs: number, toMs: number): Promise<{ rows: any[]; source: string; query: string }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, problems: string[] = [], quote = (n: string) => n.replace(/'/g, "''");
    const winAll = `createdon ge ${odataDate(fromMs)} and createdon lt ${odataDate(toMs)}`;
    const fNames = names.length ? '(' + names.map(n => `craa5_team eq '${quote(n)}'`).join(' or ') + ') and ' : '';
    const fWebNames = names.length ? '(' + names.map(n => `craa5_team eq '${encodeURIComponent(quote(n))}'`).join(' or ') + ') and ' : '';
    const query = `${TASK_TABLE}: ${winAll}, newest first, up to ${HIST_CAP}, columns ${HIST_COLUMNS.join(', ')}`;
    if (webApi?.retrieveMultipleRecords) {
        try {
            const res: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${HIST_COLUMNS.join(',')}&$filter=${winAll}&$orderby=createdon desc&$top=${HIST_CAP}`), HIST_TIMEOUT_MS, "history");
            if (Array.isArray(res?.entities)) return { rows: res.entities, source: 'Xrm.WebApi', query };
            problems.push("no rows came back");
        } catch (e: any) {
            if (fNames) {
                try {
                    const res2: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${HIST_COLUMNS.join(',')}&$filter=${fNames}${winAll}&$orderby=createdon desc&$top=${HIST_CAP}`), HIST_TIMEOUT_MS, "history");
                    if (Array.isArray(res2?.entities)) return { rows: res2.entities, source: 'Xrm.WebApi', query };
                } catch (e2: any) {
                    if (fWebNames) {
                        try {
                            const res3: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${HIST_COLUMNS.join(',')}&$filter=${fWebNames}${winAll}&$orderby=createdon desc&$top=${HIST_CAP}`), HIST_TIMEOUT_MS, "history");
                            if (Array.isArray(res3?.entities)) return { rows: res3.entities, source: 'Xrm.WebApi', query };
                        } catch (e3: any) { /* fall through */ }
                    }
                }
            }
            problems.push(String(e?.message || e || "failed"));
        }
    }
    if (dataApi?.queryTable) {
        try { return { rows: await queryDataApi(dataApi, TASK_TABLE, winAll, { select: HIST_COLUMNS, orderBy: 'createdon desc', top: HIST_CAP }), source: 'data API', query }; } catch (e: any) {
            if (fNames) {
                try { return { rows: await queryDataApi(dataApi, TASK_TABLE, `${fNames}${winAll}`, { select: HIST_COLUMNS, orderBy: 'createdon desc', top: HIST_CAP }), source: 'data API', query }; } catch (e2: any) { /* fall through */ }
            }
            problems.push(String(e?.message || e || "failed"));
        }
    }
    throw new Error(problems.join("; ") || "no Dataverse connection");
}
// The crew's last six weeks, read in pieces side by side; a piece that cannot be read is counted and left out, and only when none can is the whole read an error.
async function readHistory(props: any, slots: Slot[], crew: string, names: string[], key: string): Promise<History> {
    const to = Date.now(), from = to - HIST_DAYS * 86400000, step = HIST_PIECE_DAYS * 86400000, spans: { from: number; to: number }[] = [];
    for (let t = to; t > from; t -= step) spans.push({ from: Math.max(from, t - step), to: t });
    const [got, archived] = await Promise.all([
        Promise.all(spans.map(s => readHistoryPiece(props, names, s.from, s.to).then(r => ({ ok: true, rows: r.rows, source: r.source, query: r.query, error: "" }), (e: any) => ({ ok: false, rows: [], source: "", query: "", error: String(e?.message || e || "failed") })))),
        readArchiveRange(props, from - 86400000, to).catch(() => [] as ShiftBoard[]),
    ]);
    // Combine archive boards, live boards, browser-cached boards, startup bundle task rows, and 6-week task rows so no room experience or previous board is missed.
    const archRows: any[] = [];
    archived.forEach(a => { archRows.push.apply(archRows, boardTaskRows(a, 'archive')); });
    if (Array.isArray(RECENT_ARCHIVES) && RECENT_ARCHIVES.length > 0) {
        RECENT_ARCHIVES.forEach(a => { archRows.push.apply(archRows, boardTaskRows(a, 'archive')); });
    }
    if (Array.isArray(RECENT_ARCHIVE_ROWS) && RECENT_ARCHIVE_ROWS.length > 0) {
        archRows.push.apply(archRows, RECENT_ARCHIVE_ROWS);
    }
    if (Array.isArray(LIVE_BOARDS) && LIVE_BOARDS.length > 0) {
        LIVE_BOARDS.forEach(lb => { archRows.push.apply(archRows, boardTaskRows(lb, 'live')); });
    }
    readLocalArchives().forEach(a => { archRows.push.apply(archRows, boardTaskRows(a, 'archive')); });
    readLocalLiveBoards(true).forEach(lb => { archRows.push.apply(archRows, boardTaskRows(lb, 'live')); });
    const localSsRows = readLocalShiftStartRows();
    if (localSsRows.length > 0) {
        archRows.push.apply(archRows, localSsRows);
    }
    const cachePresets = GLOBAL_DATA_CACHE?.presetRecords || [];
    if (Array.isArray(cachePresets) && cachePresets.length > 0) {
        archRows.push.apply(archRows, cachePresets);
    }
    const covered = (r: any) => { const tm = taskTime(r), team = getField(r, 'craa5_team'); return archived.some(a => sameText(a.team, team) && tm >= a.slotStart - SHIFT_PREP_MS && tm < boardEndOf(a)); };
    const okPieces = got.filter(g => g.ok);
    if (!okPieces.length && !archRows.length) throw new Error(got[0] ? got[0].error : "nothing was read");
    let all: any[] = archRows.slice();
    okPieces.forEach(g => { all = all.concat(g.rows.filter((r: any) => !covered(r))); });
    if (!okPieces.length) okPieces.push({ ok: true, rows: archRows, source: `${BOARD_TABLE} + ${ARCHIVE_TABLE}`, query: `boards and archives of ${names.join(', ') || 'all teams'}`, error: "" });
    const agg = aggregateHistory(all, slots, crew), first = okPieces.filter(g => g.rows.length)[0];
    return {
        v: 4, key, crew, names, at: Date.now(), from, to, boards: agg.boards, strength: agg.strength, rows: all.length, pieces: okPieces.length, failedPieces: got.length - okPieces.length,
        capped: okPieces.filter(g => g.rows.length >= HIST_CAP).length, source: okPieces[0].source, query: okPieces[0].query, columns: first && first.rows[0] ? Object.keys(first.rows[0]).filter(k => k.charAt(0) !== '@' && k.indexOf('@') < 0) : [], error: got.filter(g => !g.ok).map(g => g.error)[0] || "",
    };
}

