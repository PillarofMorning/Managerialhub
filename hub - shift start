type AsgProgress = { logIds: Set<string>; started: Set<string> };
async function readProgress(props: any, shiftDate: string, fromMs: number): Promise<AsgProgress> {
    const out: AsgProgress = { logIds: new Set<string>(), started: new Set<string>() };
    for (const f of [`statecode eq 0 and craa5_lastcleaned eq ${shiftDate}`, `statecode eq 0 and craa5_lastcleaned ge ${shiftDate}T00:00:00Z and craa5_lastcleaned le ${shiftDate}T23:59:59Z`]) {
        try {
            const rows = await tableQuery(props, MSS_LOG_TABLE, f, [MSS_LOG_ID], 5000, 'createdon desc');
            rows.forEach((r: any) => { const id = hubGuid(getField(r, MSS_LOG_ID)); if (id) out.logIds.add(id); });
            break;
        } catch (e) { /* try the next date style */ }
    }
    try {
        const rows = await tableQuery(props, CHECKOFF_TABLE, `modifiedon ge ${odataDate(fromMs)}`, ['craa5_equipmentguid', 'craa5_status'], 5000, 'modifiedon desc');
        rows.forEach((r: any) => { const g = hubGuid(getField(r, 'craa5_equipmentguid')); if (g && String(getField(r, 'craa5_status') || '').toLowerCase() === 'started') out.started.add(g); });
