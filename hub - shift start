    const applyChatOps = (ops: ChatOp[]) => {
        const stArea: Record<string, string> = {}, nowIso = new Date().toISOString();
        ops.forEach(op => {
            if (op.op !== 'away' || stArea[op.status]) return;
            const found = [...areas, ...customAreas].find(a => renderSafe(getField(a, 'craa5_area')).toLowerCase() === op.status.toLowerCase());
            if (found) { stArea[op.status] = String(getField(found, 'craa5_aa_mss_areaid')); return; }
            const made = { craa5_aa_mss_areaid: `status_${compactKey(op.status)}_${Date.now()}`, craa5_area: op.status }; stArea[op.status] = made.craa5_aa_mss_areaid; setCustomAreas(p => p.concat([made]));
        });
        ops.forEach(op => {
            if (op.op === 'room') {
                setSelectedAreaIds(p => { const n = new Set(p); n.add(op.areaId); return n; });
