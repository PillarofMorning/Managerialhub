                list.push({
                    key: row?.key || asgKeyOf(shiftDate, crew, guid, scope.code), guid, row, areaId: room.areaId, area: room.name, kind: row?.kind || hubCleanKind(scope.code),
                    name: String(a.craa5_equipmentidentifier || a.craa5_ValidationName || a.craa5_validationname || a.craa5_equipment || a.craa5_name || getField(a, 'craa5_equipmentidentifier') || getField(a, 'craa5_equipment') || 'Equipment').trim(),
                    room: String(a.craa5_roomname || a.craa5_room || getField(a, 'craa5_roomname') || room.name).trim(),
