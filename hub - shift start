// ---- Who can edit a board (from the Microsoft sign-in, matched to the employee table) ----
// Managers and Full Access: every board. A supervisor: their own board(s), on any crew they run (a double shift included).
// A lead (including off-shift leads): can assign team members and areas to themselves and view what other team leads/members have assigned.
function editAccessFor(user: any, sup: any, boardCrewLetter: string, leadIds: Set<string>, fullAccess: boolean): { can: boolean; why: string; role: string } {
    if (fullAccess) return { can: true, why: 'Full Access', role: 'full access' };
    if (!user) return { can: false, why: 'Your Microsoft account is not matched to an employee, so boards are view only', role: 'unknown' };
    const role = String(user.calculatedRole || roleOf(user)), myId = String(empIdOf(user) || '');
    if (role === 'manager') return { can: true, why: 'Manager', role };
    if (!sup) return { can: false, why: 'No board is open', role };
    const supId = String(empIdOf(sup) || '');
    if (role === 'supervisor') return supId && supId === myId ? { can: true, why: 'Your board', role } : { can: true, why: `Supervisor viewing ${formatFullName(getField(sup, 'craa5_name'))}'s board`, role };
    if (role === 'lead' || roleOf(user) === 'lead') {
        if (myId && leadIds.has(myId)) return { can: true, why: 'You are a lead on this board', role: 'lead' };
        const mine = crewOfPerson(user);
        if (mine && boardCrewLetter && mine === boardCrewLetter) return { can: true, why: `Lead on crew ${mine}`, role: 'lead' };
        return { can: true, why: `Team Lead${mine ? ` (Shift ${mine} - off-shift lead access)` : ''}`, role: 'lead' };
    }
    return { can: false, why: 'Boards are view only for your role', role };
}

// ---- Import of the old task rows into the archive, and retiring them once checked ----
type ImportGroup = { key: string; name: string; team: string; crew: string; supervisorEmail: string; slotStart: number; slotEnd: number; rowCount: number; finalRows: any[]; sourceRowIds: string[]; lastSave: number; exists: boolean };
async function readTaskRowsRange(props: any, fromMs: number, toMs: number, onStep?: (text: string) => void): Promise<{ rows: any[]; error: string }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, step = 3 * 86400000, out: any[] = [], seen: Record<string, boolean> = {};
    let error = '';
    for (let a = fromMs; a < toMs; a += step) {
        const b = Math.min(toMs, a + step), filter = `createdon ge ${odataDate(a)} and createdon lt ${odataDate(b)} and statecode eq 0`;
        if (onStep) onStep(`Reading ${new Date(a).toLocaleDateString()} to ${new Date(b).toLocaleDateString()}... (${out.length} rows so far)`);
        let got: any[] | null = null;
        for (const cols of [TASK_COLUMNS, TASK_CORE_COLUMNS]) {
            if (got) break;
            if (webApi?.retrieveMultipleRecords) { try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${cols.join(',')}&$filter=${filter}&$orderby=createdon asc&$top=5000`), API_TIMEOUT_MS, 'history'); if (Array.isArray(res?.entities)) got = res.entities; } catch (e: any) { error = String(e?.message || e); } }
            if (!got && dataApi?.queryTable) { try { got = await queryDataApi(dataApi, TASK_TABLE, filter, { select: cols, orderBy: 'createdon asc', top: 5000 }); } catch (e: any) { error = String(e?.message || e); } }
        }
        (got || []).forEach(r => { const id = String(getField(r, 'craa5_taskassignmentid') || ''); if (id && seen[id]) return; if (id) seen[id] = true; out.push(r); });
    }
    return { rows: out, error: out.length ? '' : error };
}
function groupRowsIntoBoards(rows: any[], slots: Slot[]): ImportGroup[] {
    const byTeam = new Map<string, any[]>();
    rows.forEach(r => {
        if (isBoardRow(r)) return;
        const team = String(getField(r, 'craa5_team') || '').trim();
        if (!team || !String(getField(r, 'craa5_area') || '').trim()) return;
        const k = normText(team);
        if (!byTeam.has(k)) byTeam.set(k, []);
        byTeam.get(k)!.push(r);
    });
    const out: ImportGroup[] = [];
    const build = (list: any[]) => {
        const first = taskTime(list[0]), last = taskTime(list[list.length - 1]);
        let sl = slots.length ? findCurrentShift(slots, new Date(first + SHIFT_PREP_MS)) : { crew: '', startMs: 0, endMs: 0 };
        if (!sl.crew && slots.length) sl = findCurrentShift(slots, new Date(first));
        const team = String(getField(list[list.length - 1], 'craa5_team') || '').trim();
        const crew = sl.crew || normalizeShift(getField(list[list.length - 1], 'craa5_shift')) || '?';
        const slotStart = sl.crew ? sl.startMs : Math.floor(first / 3600000) * 3600000;
        const slotEnd = sl.crew ? sl.endMs : last + 3600000;
        // The board as the shift ended: the newest row of each person in each area that a later save did not close, plus the last save
        const latest = new Map<string, any>();
        list.forEach(r => { const w = String(getField(r, 'craa5__aaemp_guid') || '').toLowerCase() || normText(getField(r, 'craa5_id')); latest.set(`${normText(getField(r, 'craa5_area'))}|${w}`, r); });
        const finalRows = Array.from(latest.values()).filter(r => !isTaskDone(r) || last - taskTime(r) <= 120000 || isAreaRowExplicitlyCompleted(r)).sort(byTaskTime).map(taskRowFields);
        const name = boardName({ crew, team, slotStart });
        out.push({ key: name, name, team, crew, supervisorEmail: String(getField(list[list.length - 1], 'craa5_supervisoremail') || ''), slotStart, slotEnd, rowCount: list.length, finalRows, sourceRowIds: list.map(r => String(getField(r, 'craa5_taskassignmentid') || '')).filter(Boolean), lastSave: last, exists: false });
    };
    byTeam.forEach(list => {
        list.sort(byTaskTime);
        let cur: any[] = [];
        list.forEach(r => { if (cur.length && taskTime(r) - taskTime(cur[cur.length - 1]) > 8 * 3600000) { build(cur); cur = []; } cur.push(r); });
        if (cur.length) build(cur);
    });
    return out.sort((a, b) => b.slotStart - a.slotStart);
}
// Deactivates the old task rows an imported archive came from (statecode 1; a row already gone counts as done). Nothing is deleted.
async function retireTaskRows(props: any, ids: string[]): Promise<{ done: number; failed: number; error: string }> {
    const list = Array.from(new Set(ids.filter(id => /^[0-9a-f-]{36}$/i.test(String(id)))));
    let done = 0, failed = 0, error = '';
    for (let i = 0; i < list.length; i += 6) {
        await Promise.all(list.slice(i, i + 6).map(async id => { const e = await deactivateRecord(props, TASK_TABLE, id); if (!e || /does not exist|0x80040217/i.test(e)) done++; else { failed++; error = e; } }));
    }
    return { done, failed, error };
}

// Imported shifts whose old task rows have not been retired yet (read with the source / retired columns when the table has them)
async function readImportedPending(props: any): Promise<ShiftBoard[]> {
    const keep = (b: ShiftBoard | null): b is ShiftBoard => !!b && !!b.imported && !b.retiredAt;
    try { const rows = await tableQuery(props, ARCHIVE_TABLE, "statecode eq 0 and craa5_source eq 'import' and craa5_retiredon eq null", fullSelect(ARCHIVE_TABLE), 500, 'craa5_slotstart desc'); return rows.map(r => parseBoardRow(r, ARCHIVE_TABLE)).filter(keep); }
    catch (e) {
        try { const rows = await tableQuery(props, ARCHIVE_TABLE, 'statecode eq 0', fullSelect(ARCHIVE_TABLE), 400); return rows.map(r => parseBoardRow(r, ARCHIVE_TABLE)).filter(keep).sort((a, b) => b.slotStart - a.slotStart); }
        catch (e2) { return []; }
    }
}
