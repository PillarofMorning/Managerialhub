async function readAssignments(props: any, shiftDate: string, crew: string): Promise<AsgRead> {
    const found = await findAssignmentTable(props);
    if (!found.table) return { state: 'missing', rows: [], error: `${ASG_TABLE_NAMES.join(', ')}: ${found.error || 'no answer'}`, at: Date.now() };
    try {
        // Every column (no column list), so a column named differently never hides the table
        const rows = await tableQuery(props, found.table, `craa5_shiftdate eq '${shiftDate}' and craa5_crew eq '${hubCrew(crew)}'`, [], 3000, 'createdon asc');
        return { state: 'ok', rows: rows.map(asgParse).filter(r => r.guid).sort((a, b) => a.order - b.order), error: '', at: Date.now() };
    } catch (e: any) {
        // The table is there, so this is a column (craa5_shiftdate, craa5_crew) or a permission problem: say exactly what Dataverse said
