// One 14 day piece of the team's rows, newest first. Each way of reading only falls through when it fails.
async function readHistoryPiece(props: any, names: string[], fromMs: number, toMs: number): Promise<{ rows: any[]; source: string; query: string }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, problems: string[] = [], quote = (n: string) => n.replace(/'/g, "''");
    const win = `createdon ge ${odataDate(fromMs)} and createdon lt ${odataDate(toMs)}`;
    const fApi = '(' + names.map(n => `craa5_team eq '${quote(n)}'`).join(' or ') + ')', fWeb = '(' + names.map(n => `craa5_team eq '${encodeURIComponent(quote(n))}'`).join(' or ') + ')';
    const query = `${TASK_TABLE}: ${fApi} and ${win}, newest first, up to ${HIST_CAP}, columns ${HIST_COLUMNS.join(', ')}`;
    if (webApi?.retrieveMultipleRecords) {
        try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${HIST_COLUMNS.join(',')}&$filter=${fWeb} and ${win}&$orderby=createdon desc&$top=${HIST_CAP}`), HIST_TIMEOUT_MS, "history"); if (Array.isArray(res?.entities)) return { rows: res.entities, source: 'Xrm.WebApi', query }; problems.push("no rows came back"); } catch (e: any) { problems.push(String(e?.message || e || "failed")); }
    }
    if (dataApi?.queryTable) {
        try { return { rows: await queryDataApi(dataApi, TASK_TABLE, `${fApi} and ${win}`, { select: HIST_COLUMNS, orderBy: 'createdon desc', top: HIST_CAP }), source: 'data API', query }; } catch (e: any) { problems.push(String(e?.message || e || "failed")); }
    }
    throw new Error(problems.join("; ") || "no Dataverse connection");
}
// The crew's last six weeks, read in pieces side by side; a piece that cannot be read is counted and left out, and only when none can is the whole read an error.
async function readHistory(props: any, slots: Slot[], crew: string, names: string[], key: string): Promise<History> {
    const to = Date.now(), from = to - HIST_DAYS * 86400000, step = HIST_PIECE_DAYS * 86400000, spans: { from: number; to: number }[] = [];
    for (let t = to; t > from; t -= step) spans.push({ from: Math.max(from, t - step), to: t });
    const got = await Promise.all(spans.map(s => readHistoryPiece(props, names, s.from, s.to).then(r => ({ ok: true, rows: r.rows, source: r.source, query: r.query, error: "" }), (e: any) => ({ ok: false, rows: [] as any[], source: "", query: "", error: String(e?.message || e || "failed") }))));
    const okPieces = got.filter(g => g.ok);
    if (!okPieces.length) throw new Error(got[0] ? got[0].error : "nothing was read");
    let all: any[] = []; okPieces.forEach(g => { all = all.concat(g.rows); });
    const agg = aggregateHistory(all, slots, crew), first = okPieces.filter(g => g.rows.length)[0];
    return {
        v: 2, key, crew, names, at: Date.now(), from, to, boards: agg.boards, strength: agg.strength, withLead: agg.withLead, rows: all.length, pieces: okPieces.length, failedPieces: got.length - okPieces.length,
        capped: okPieces.filter(g => g.rows.length >= HIST_CAP).length, source: okPieces[0].source, query: okPieces[0].query, columns: first ? Object.keys(first.rows[0]).filter(k => k.charAt(0) !== '@' && k.indexOf('@') < 0) : [], error: got.filter(g => !g.ok).map(g => g.error)[0] || "",
    };
}

