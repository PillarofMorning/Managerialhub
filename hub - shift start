const importBoardJson = (rawJson: string): { ok: boolean; message: string } => {
    try {
        const parsed = JSON.parse(String(rawJson || '').trim());
        if (!parsed || typeof parsed !== 'object') return { ok: false, message: 'Invalid JSON object.' };
        const st = parsed.state && typeof parsed.state === 'object' ? parsed.state : parsed;
        if (!st.areaAssignments && !st.assignments && !Array.isArray(parsed.rows)) {
            return { ok: false, message: 'JSON does not contain board assignments or rows.' };
        }
        if (Array.isArray(parsed.selectedLeadIds)) setSelectedLeadIds(new Set(parsed.selectedLeadIds));
        if (Array.isArray(parsed.selectedAreaIds)) setSelectedAreaIds(new Set(parsed.selectedAreaIds));
        if (st.areaAssignments && typeof st.areaAssignments === 'object') {
            setAreaAssignments(st.areaAssignments);
            setSelectedAreaIds(prev => {
                const next = new Set(prev);
                Object.keys(st.areaAssignments).forEach(k => next.add(k));
                return next;
            });
            setSelectedLeadIds(prev => {
                const next = new Set(prev);
                Object.values(st.areaAssignments).forEach((lid: any) => { if (lid) next.add(String(lid)); });
                return next;
            });
        }
        if (st.assignments && typeof st.assignments === 'object') setAssignments(st.assignments);
        applyBoardState(st);
        setBoardFresh(false);
        const roomCount = st.areaAssignments ? Object.keys(st.areaAssignments).length : (parsed.rows?.length || 0);
        setBoardNote({ tone: 'ok', text: `Restored board from pasted JSON (${roomCount} rooms). Click Save Progress to commit.` });
        return { ok: true, message: `Restored ${roomCount} rooms onto the board. Click Save Progress to save.` };
    } catch (e: any) {
        return { ok: false, message: `Could not parse JSON: ${String(e?.message || e)}` };
    }
};

const handleSubmission = async (): Promise<boolean> => {
    if (boardMode === 'next') { await handleSavePreset(); return false; }
    if (!access.can) { setSubmissionError(`View only: ${access.why}. Nothing was saved.`); return false; }
    setBusyLabel("Updating Dataverse..."); setIsLoading(true); setSaveSuccess(false); setSaveWarning(""); setSubmissionError(null);
    if ((BOARD_STORE === 'missing' || BOARD_STORE === 'error') && isColumnError(BOARD_ERROR, BOARD_TABLE)) setTableState(BOARD_TABLE, 'unknown', '');
    const supervisor = supervisors.find(s => getField(s, 'craa5__aa_employeeid') === selectedSupervisorId);
    // Rows carry the letter of the crew the board draws from (the letter the employee table uses); the supervisor's own letter or the work shift stand in when there is none.
    const boardShift = boardCrew || crewOfPerson(supervisor) || clockCrew;
    const boardMode2 = BOARD_STORE === 'ok';
    try {
        Object.keys(areaAssignments).forEach(areaId => {
            const areaObj = areaMap.get(areaId);
            const targetClipboard = isAreaIncludedInUpdate(areaId);
            const currentClipboard = isBoolTrue(getField(areaObj, 'craa5_clipboard'));
            // Only fire updateAreaRecord PATCH if clipboard state actually changed
            if (targetClipboard !== currentClipboard) {
                updateAreaRecord(areaId, { craa5_clipboard: targetClipboard });
            }
        });

        const supNameRaw = renderSafe(getField(supervisor, 'craa5_name'));
        // With shift boards, nothing is read here: the rows loaded with the board are enough (only rows saved the old way can still be open).
        // Without them, a targeted read of this team's assignments finds the open rows to close.
        const ownRows = boardMode2 ? { recent: [] as any[], status: taskStatus || { ok: true, source: 'loaded', error: '', read: 0 } }
            : (supNameRaw ? await readSavedAssignments(propsRef.current, supNameRaw) : await readSavedAssignments(propsRef.current));
        const readStatus = ownRows?.status || { ok: true, source: 'cache', error: '' };
        const seenIds: Record<string, boolean> = {}, fetchedTasks: any[] = [];
        (presetRecords || []).concat(ownRows?.recent || []).forEach((r: any) => {
            const rid = r.craa5_taskassignmentid; if (!rid || seenIds[rid] || isBoardRow(r) || !rowBelongsTo(r, supervisor)) return;
            seenIds[rid] = true; fetchedTasks.push(r);
        });
        setTaskStatus(readStatus as TaskStatus);

        const findEmpByName = (name: string) => name ? allKnownEmps.find((e: any) => renderSafe(getField(e, 'craa5_name')).trim().toLowerCase() === name.trim().toLowerCase()) : null;
        const getEmailForName = (name: string) => renderSafe(getEmployeeEmail(findEmpByName(name)));
        const getBadgeForName = (name: string) => renderSafe(getEmployeeBadge(findEmpByName(name)));
        const nowIso = new Date().toISOString();
        const taskPayloads: any[] = [];

        // 1. Close every still-open task already logged for this team in the shift (preserving prior percentage/status so it is not mistaken for an area completion)
        fetchedTasks.forEach((t: any) => {
            if (isTaskDone(t)) return;
            const priorPct = String(getField(t, 'craa5_percentagecomplete') ?? getField(t, 'craa5_completionpct') ?? getField(t, 'percentage') ?? "0");
            const priorStat = String(getField(t, 'craa5_whatisbeingdone') || getField(t, 'craa5__currentstatus') || "Superseded");
            taskPayloads.push({
                taskId: t.craa5_taskassignmentid, craa5_taskassignmentid: t.craa5_taskassignmentid,
                isComplete: true, craa5_complete: true, statecode: 0,
                percentage: priorPct, craa5_percentagecomplete: Number(priorPct) || 0, craa5_completionpct: Number(priorPct) || 0,
                currentStatus: priorStat, craa5_whatisbeingdone: priorStat,
                futureNotes: t.craa5_whatislefttodo || t.craa5__future_or_notes || "", craa5_whatislefttodo: t.craa5_whatislefttodo || t.craa5__future_or_notes || "",
                endTime: nowIso, craa5_endtime: nowIso,
                area: t.craa5_area, craa5_area: t.craa5_area,
                lead: t.craa5_lead, craa5_lead: t.craa5_lead,
                leadEmail: t.craa5_leademail, craa5_leademail: t.craa5_leademail, "Lead Email": t.craa5_leademail,
                empName: t.craa5_id || "", craa5_id: t.craa5_id || "",
                empEmail: t.craa5_email, craa5_email: t.craa5_email, Email: t.craa5_email,
                empGuid: t.craa5__aaemp_guid, craa5__aaemp_guid: t.craa5__aaemp_guid,
                badgeNumber: t.craa5_badgenumber, craa5_badgenumber: t.craa5_badgenumber, badgenumber: t.craa5_badgenumber,
                supervisorEmail: t.craa5_supervisoremail, craa5_supervisoremail: t.craa5_supervisoremail, "supervisor email": t.craa5_supervisoremail,
                shift: String(t.craa5_shift || boardShift), craa5_shift: String(t.craa5_shift || boardShift),
                team: t.craa5_team, craa5_team: t.craa5_team,
                equipment: "", equipGuid: "",
                startTime: t.craa5_starttime, craa5_starttime: t.craa5_starttime,
                craa5_datetimeofassignment: t.craa5_datetimeofassignment || t.craa5_starttime || nowIso,
                createdon: t.createdon || t.craa5_starttime || nowIso,
            });
        });

        // 2. Fresh rows for the whole board as it stands now
        const supEmail = renderSafe(getEmployeeEmail(supervisor));
        const updatedSubcatProgress = { ...subcatProgress };
        let progressChanged = false;
        const activeRoomsMap: Record<string, any> = {};
        const mssJobs: MssAreaJob[] = [];

        for (const areaId of Object.keys(areaAssignments)) {
            const lead = employeeMap.get(areaAssignments[areaId]) || supervisor;
            const leadEmail = getEmailForName(getField(lead, 'craa5_name')) || renderSafe(getEmployeeEmail(lead));
            const details = areaDetails[areaId] || { currentStatus: '', futureNotes: '' };
            const sc = getAreaSubcatState(areaId);
            const stepIdx = Math.min(SANITATION_STEPS.length - 1, Math.max(0, sanitationProgress[areaId] ?? 0));
            const stepPct = Math.round((stepIdx / SANITATION_STEPS.length) * 100);
            // Room is ONLY complete when explicitly marked finished via toggleAreaFinished / Mark Done (never from FSQ Inspect or subcategory ETA items)
            const finished = isAreaFinished(areaId);
            const empIds = assignments[areaId] || [];
            const hasStaff = empIds.length > 0;
            const priorState = priorShiftRoomState.get(areaId);

            let resolvedStatus = "Working";
            let effectiveStartTime = nowIso;
            let subcatsDone = [...sc.doneList];
            let subcatsInProg = [...sc.inProgList];

            if (finished) {
                resolvedStatus = "Completed";
            } else if (details.currentStatus && details.currentStatus.trim()) {
                resolvedStatus = details.currentStatus.trim();
            } else if (hasStaff && priorState?.isContinuing) {
                resolvedStatus = details.currentStatus || ("In Progress (Continued) - " + (SANITATION_STEPS[stepIdx] || SANITATION_STEPS[0]));
                effectiveStartTime = priorState.startedAt || nowIso;
                if (subcatsDone.length === 0 && subcatsInProg.length === 0) {
                    if (priorState.priorDone?.length) subcatsDone = priorState.priorDone;
                    if (priorState.priorInProg?.length) subcatsInProg = priorState.priorInProg;
                    if (subcatsDone.length === 0 && subcatsInProg.length === 0 && sc.allSubs.length > 0) {
                        subcatsInProg = [sc.allSubs[0]];
                    }
                    updatedSubcatProgress[areaId] = {
                        done: subcatsDone,
                        inProg: subcatsInProg,
                        callout: updatedSubcatProgress[areaId]?.callout || ''
                    };
                    progressChanged = true;
                }
            } else if (hasStaff) {
                resolvedStatus = details.currentStatus || ("Started - " + (SANITATION_STEPS[stepIdx] || SANITATION_STEPS[0]));
                if (subcatsDone.length === 0 && subcatsInProg.length === 0 && sc.allSubs.length > 0) {
                    subcatsInProg = [sc.allSubs[0]];
                    updatedSubcatProgress[areaId] = {
                        done: subcatsDone,
                        inProg: subcatsInProg,
                        callout: updatedSubcatProgress[areaId]?.callout || ''
                    };
                    progressChanged = true;
                }
            }

            const pctVal = finished ? 100 : Math.min(85, Math.max(sc.pct, stepPct));
            const areaNameStr = renderSafe(getField(areaMap.get(areaId), 'craa5_area'));
            const leadNameStr = renderSafe(getField(lead, 'craa5_name'));

            const activeRoomEntry = {
                status: finished ? 'Completed' : (priorState?.isContinuing ? 'Continued' : (hasStaff ? 'Started' : 'Idle')),
                startedAt: effectiveStartTime,
                shift: boardShift,
                lead: leadNameStr,
                headcount: empIds.length,
                pct: pctVal,
                cleanType: sc.cleanType
            };
            activeRoomsMap[areaId] = activeRoomEntry;
            if (areaNameStr) activeRoomsMap[areaNameStr] = activeRoomEntry;

            const base: any = {
                taskId: "",
                area: areaNameStr, craa5_area: areaNameStr,
                lead: leadNameStr, craa5_lead: leadNameStr,
                leadEmail, craa5_leademail: leadEmail, "Lead Email": leadEmail,
                supervisorEmail: supEmail, craa5_supervisoremail: supEmail, "supervisor email": supEmail,
                shift: boardShift, craa5_shift: boardShift,
                team: supNameRaw, craa5_team: supNameRaw,
                equipment: "", equipGuid: "",
                percentage: String(pctVal),
                craa5_percentagecomplete: pctVal,
                craa5_completionpct: pctVal,
                isComplete: finished, craa5_complete: finished, statecode: 0,
                currentStatus: resolvedStatus, craa5_whatisbeingdone: resolvedStatus,
                futureNotes: details.futureNotes || "", craa5__future_or_notes: details.futureNotes || "", craa5_whatislefttodo: details.futureNotes || "",
                craa5_notes: details.futureNotes || "",
                craa5_subcategory: subcatsDone.join(", ") || details.subcategoryNotes || "",
                endTime: finished ? nowIso : "", craa5_endtime: finished ? nowIso : "",
                craa5_datetimeofassignment: nowIso,
                createdon: nowIso,
            };

            if (empIds.length === 0) {
                taskPayloads.push({ ...base, empName: "", craa5_id: "", empEmail: "", craa5_email: "", Email: "", empGuid: "", craa5__aaemp_guid: "", badgeNumber: "", craa5_badgenumber: "", badgenumber: "", startTime: effectiveStartTime, craa5_starttime: effectiveStartTime });
            } else {
                const areaWorkerNames: string[] = [];
                for (const eid of empIds) {
                    const emp = employeeMap.get(eid); if (!emp) continue;
                    const name = renderSafe(getField(emp, 'craa5_name'));
                    if (name && !areaWorkerNames.includes(name)) areaWorkerNames.push(name);
                    const empEmail = getEmailForName(name) || renderSafe(getEmployeeEmail(emp));
                    const empBadge = getBadgeForName(name) || renderSafe(getEmployeeBadge(emp));
                    const empGuid = getField(emp, 'craa5__aa_employeeid') || "";
                    const est = employeeStartTimes[eid] || effectiveStartTime;
                    taskPayloads.push({ ...base, empName: name, craa5_id: name, empEmail, craa5_email: empEmail, Email: empEmail, empGuid, craa5__aaemp_guid: empGuid, badgeNumber: empBadge, craa5_badgenumber: empBadge, badgenumber: empBadge, startTime: est, craa5_starttime: est });
                }
                if (finished) {
                    // Logged to the MSS calendar after the board is saved (writeMssLogs: only the pieces of this area's clean)
                    const areaLookup = assetLookupByArea.get(areaId);
                    mssJobs.push({ areaId, areaName: areaNameStr, cleanType: sc.cleanType || getAreaCleanType(areaId), assets: areaLookup?.matchedAssets || [], cleanedBy: areaWorkerNames.length > 0 ? areaWorkerNames.join(' / ') : (leadNameStr || supNameRaw || 'Crew'), totalAreaHrs: areaLookup?.totalCleanHours || (isProductionArea(areaMap.get(areaId)) ? 4.5 : 2.0) });
                }
            }
        }

        if (progressChanged) {
            setSubcatProgress(updatedSubcatProgress);
        }

        // Redundant localStorage sync to Ganttly & active rooms
        try {
            const comps = buildAreaCompletionsPayload();
            const existingComps = JSON.parse(localStorage.getItem('ganttly_area_completions') || '{}');
            localStorage.setItem('ganttly_area_completions', JSON.stringify({ ...existingComps, ...comps }));
            localStorage.setItem('ganttly_subcats_sync', JSON.stringify(updatedSubcatProgress));
            localStorage.setItem('ganttly_active_rooms', JSON.stringify(activeRoomsMap));
            localStorage.setItem('ganttly_step_sync', JSON.stringify(sanitationProgress));
        } catch (e) {}

        // Shift board: save to craa5_shiftboard when present, or fall back to local storage + craa5_taskassignment when craa5_shiftboard is missing
        let savedBoard: ShiftBoard | null = null;
        const freshPayloads = taskPayloads.filter(r => !r.taskId);
        const slot = boardSlotNow(), me = myName, name = boardName({ crew: boardShift, team: supNameRaw, slotStart: slot.start });
        let base: ShiftBoard | null = LIVE_BOARDS.find(b => b.status === 'live' && sameText(b.team, supNameRaw) && Math.abs(b.slotStart - slot.start) < 2 * 3600000) || ownLiveBoard(supervisor);
