            // 2. Safe path: Query without $select
            try {
                const fallbackRes: any = await asyncRace(webApi.retrieveMultipleRecords(en, `${filter ? `?$filter=${filter}&` : '?'}$top=5000`), API_TIMEOUT_MS, `WebApi ${en} fallback`);
                if (Array.isArray(fallbackRes?.entities)) {
                    if (fallbackRes.entities.length > 0) {
                        if (ENDPOINT_META.workingTables[groupKey] !== en) { ENDPOINT_META.workingTables[groupKey] = en; saveEndpointMeta(); }
                        return fallbackRes.entities;
                    }
                    if (filter === "statecode eq 0" && TEAM_TABLES.includes(en)) {
                        try {
                            const unfilteredRes: any = await asyncRace(webApi.retrieveMultipleRecords(en, `?$top=5000`), API_TIMEOUT_MS, `WebApi ${en} unfiltered`);
                            if (Array.isArray(unfilteredRes?.entities) && unfilteredRes.entities.length > 0) {
                                if (ENDPOINT_META.workingTables[groupKey] !== en) { ENDPOINT_META.workingTables[groupKey] = en; saveEndpointMeta(); }
                                return unfilteredRes.entities;
                            }
                        } catch (eUnf) {}
                    }
                }
            } catch (e2: any) {
                logError(`${en} via WebApi`, e2?.message || e2);
            }
        }
        if (dataApi?.queryTable) {
            try {
                const rows = await queryDataApi(dataApi, en, filter);
                if (rows.length > 0) {
                    if (ENDPOINT_META.workingTables[groupKey] !== en) { ENDPOINT_META.workingTables[groupKey] = en; saveEndpointMeta(); }
                    return rows;
                }
                if (filter === "statecode eq 0" && TEAM_TABLES.includes(en)) {
                    try {
                        const unfilteredRows = await queryDataApi(dataApi, en, "");
                        if (unfilteredRows.length > 0) {
                            if (ENDPOINT_META.workingTables[groupKey] !== en) { ENDPOINT_META.workingTables[groupKey] = en; saveEndpointMeta(); }
                            return unfilteredRows;
                        }
                    } catch (eUnf2) {}
                }
            } catch (e: any) { logError(`${en} via dataApi`, e?.message || e); }
        }
    }
    return [];
}

let LAST_ASSET_SOURCE = 'initial';

async function fetchAssetsQuickload(props: any): Promise<{ items: any[]; source: string }> {
    const webApi = getWebApi(props);
    const dbXrm = safeGetXrm();
    const execApi = dbXrm?.WebApi?.online?.execute ? dbXrm.WebApi.online : (webApi?.execute ? webApi : null);

    // 1. Try Instant Plugin quickload_assets (~15ms execution), skipping if already known missing this session
    if (execApi?.execute && ENDPOINT_META.quickloadOp !== null) {
        const candidateNames = ENDPOINT_META.quickloadOp ? [ENDPOINT_META.quickloadOp] : ["craa5_quickload_assets", "new_quickload_assets", "quickload_assets"];
        for (const opName of candidateNames) {
            try {
                const req = {
                    getMetadata: () => ({
                        boundParameter: null,
                        parameterTypes: {},
                        operationType: 0,
                        operationName: opName,
                    })
                };
                const res: any = await asyncRace(execApi.execute(req), 2000, `Action ${opName}`);
                if (res && (res.ok || res.status === 200)) {
                    const data = await res.json();
                    const rawStr = data?.payload || data?.Payload;
                    if (rawStr && typeof rawStr === 'string' && rawStr.includes(':')) {
                        const parsed = rawStr.split(';').map((entry: string) => {
                            const parts = entry.split(':');
                            if (parts.length < 2) return null;
                            const area = parts[0].trim();
                            const sub = parts[1].trim();
                            const hrs = parseFloat(parts[2] || '0') || 0;
                            if (!area || !sub) return null;
                            return { craa5_area: area, craa5_areaname: area, craa5_line: area, craa5_subcategory: sub, craa5_hoursrequired: hrs };
                        }).filter(Boolean);
                        if (parsed.length > 0) {
                            ENDPOINT_META.quickloadOp = opName;
                            saveEndpointMeta();
                            LAST_ASSET_SOURCE = `Accelerator (${opName})`;
                            return { items: parsed, source: LAST_ASSET_SOURCE };
                        }
                    }
                }
            } catch (e: any) {
                // Try next candidate or fallback
            }
        }
        if (!ENDPOINT_META.quickloadOp) {
            ENDPOINT_META.quickloadOp = null;
            saveEndpointMeta();
        }
    }

    // 2. Safe fallback: Query table with $select column pruning
    const tableItems = await fetchFallbackRecords(ASSET_TABLES, props);
    LAST_ASSET_SOURCE = 'Dataverse Table';
    return { items: tableItems, source: LAST_ASSET_SOURCE };
}

