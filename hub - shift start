                if (!dbXrm?.WebApi?.online?.execute) throw new Error("Dataverse Action API not available.");
                const res = await dbXrm.WebApi.online.execute({
                    TaskPayloadJSON: JSON.stringify(taskPayloads),
                    getMetadata: () => ({ boundParameter: null, parameterTypes: { "TaskPayloadJSON": { typeName: "Edm.String", structuralProperty: 1 } }, operationType: 0, operationName: "new_BulkUpsertTaskAssignments" }),
                });
                if (!res.ok) throw new Error("Plugin execution failed.");
            }
            histDone.current = {}; histForce.current = true; lsDropHist(histKey);   // the board just saved belongs in the history: the next read is a fresh one
