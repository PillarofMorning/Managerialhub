const minutesOfDay = (ms: number) => { const d = new Date(ms); return d.getHours() * 60 + d.getMinutes(); };
// How many people a room usually takes (the middle of its headcount across the boards kept; at the same start time of day when atMin is given); 0 when there is no history for it.
function typicalHeadcount(h: History | null, areaName: string, atMin: number = -1): number {
    if (!h) return 0;
    const a = normText(areaName), ck = cleanAreaKey(areaName), counts: number[] = [];
    h.boards.forEach(b => { if (atMin >= 0 && minutesOfDay(b.startMs) !== atMin) return; const n = b.people.filter(p => !!p.emp && (normText(p.area) === a || (ck && cleanAreaKey(p.area) === ck))).length; if (n > 0) counts.push(n); });
    if (!counts.length) return 0;
    counts.sort((x, y) => x - y); return counts[Math.floor((counts.length - 1) / 2)];
