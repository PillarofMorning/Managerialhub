    const leadSuggestCount = Object.keys(leadSuggest).length;
    const assignLeads = (picks: { areaId: string; leadId: string }[]) => { if (picks.length) setAreaAssignments(p => { const n = { ...p }; picks.forEach(pk => { n[pk.areaId] = pk.leadId; }); return n; }); };
