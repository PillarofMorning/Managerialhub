        }
        histDone.current = {}; histForce.current = true; lsDropHist(histKey);   // the board just saved belongs in the history: the next read is a fresh one
        const otherTeamRecords = (presetRecords || []).filter((r: any) => !rowBelongsTo(r, supervisor));
        const ownRecords = savedBoard ? boardTaskRows(savedBoard) : taskPayloads;
        const updatedRecords = otherTeamRecords.concat(fetchedTasks.map((t: any) => ({ ...t, craa5_complete: true, craa5_endtime: nowIso })), ownRecords);
