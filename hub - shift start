type EquipmentAssignProps = {
    hostProps: any; rooms: AsgRoom[]; assets: any[]; shiftDate: string; crew: string; slotStartMs: number; boardId: string;
    canEdit: boolean; onlyTeam: string; me: string; nameOf: (id: string) => string;
