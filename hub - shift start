            const pool = [...allEmployees, ...customEmployees, ...ce];
            // The employee id saved on the row is the surest match; the name covers rows saved without one.
            let eo = (rowGuid && pool.find(e => String(idOf(e) || "").toLowerCase() === rowGuid.toLowerCase())) || pool.find(e => sameText(getField(e, 'craa5_name'), en));
