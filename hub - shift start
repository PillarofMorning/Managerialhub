        getFormattedField(e, '_craa5_leadershipteamid_value') ||
        getFormattedField(e, 'craa5_leadershipteamid') ||
        (teamRef && typeof teamRef === 'object' ? (teamRef.craa5_teamname || teamRef.craa5_title || teamRef.craa5_name || teamRef.name || teamRef.Label || '') : '')
