    const shown = onlyTeam ? rooms.filter(r => r.leadId === onlyTeam) : rooms;
    // Tonight's pieces per room: the room's clean from the equipment list, plus any piece Ganttly placed in that area. One piece is one row, whatever kind it was saved under.
    const piecesByRoom = useMemo(() => {
