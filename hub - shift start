        : `${formatFullName(sg.name)} has worked ${room} on ${sg.days} ${sg.days === 1 ? 'shift' : 'shifts'} in the last six weeks${sg.total && sg.share !== undefined && sg.total >= SPECIALIST_MIN_SHIFTS && sg.share >= SPECIALIST_SHARE ? `; ${sg.share}% of their ${sg.total} room assignments are in ${roomNameByNorm[sg.topArea || ''] || sg.topArea}` : ''}. Balanced puts people where they have worked least compared with their other rooms`;
    const suggestions = useMemo((): Record<string, Suggest[]> => {
