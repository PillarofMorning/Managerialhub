// --- UTILITIES ---
const FMT = '@OData.Community.Display.V1.FormattedValue';
function safeGetXrm() { if (typeof window === 'undefined') return null; if ((window as any).Xrm) return (window as any).Xrm; try { if (window.parent && (window.parent as any).Xrm) return (window.parent as any).Xrm; } catch (e) {} return null; }
function getReadApi(props?: any) { const xrm = safeGetXrm(); if (xrm?.WebApi) return xrm.WebApi; if (props?.context?.webAPI) return props.context.webAPI; return props?.webAPI || null; }
const errMsg = (e: any) => String(e?.message || e || "Unknown error");
const norm = (v: any) => String(v ?? "").toLowerCase().trim();
const uniq = <X,>(a: X[]) => Array.from(new Set(a));
const getField = (obj: any, fn: string) => {
  if (!obj) return undefined; if (obj[fn] !== undefined) return obj[fn];
  const lf = fn.toLowerCase(), k = Object.keys(obj).find(x => x.toLowerCase() === lf);
  return k ? obj[k] : undefined;
};
const isBoolTrue = (v: any) => v === true || v === 1 || /^(yes|true)$/i.test(String(v ?? ""));
const pad = (n: number) => String(n).padStart(2, '0');
const ymd = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const hm = (d: Date) => d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' });
// "Doe, John" -> "John Doe"
const displayName = (n: string) => { const p = String(n || "").split(","); return p.length > 1 ? `${p.slice(1).join(",").trim()} ${p[0].trim()}` : String(n || "").trim(); };

function withTimeout<R = any>(p: any, ms: number, label: string): Promise<R> {
  if (!p) return Promise.reject(new Error(`No query for ${label}`));
  let timer: any;
  return Promise.race([Promise.resolve(p), new Promise<R>((_, reject) => { timer = setTimeout(() => reject(new Error(`TIMEOUT: ${label}`)), ms); })]).finally(() => clearTimeout(timer));
}

function normalizeShift(val: any): string {
  if (val === undefined || val === null || val === "") return "";
  const s = String(typeof val === 'object' ? (val.Label || val.Value || val.name || '') : val).toUpperCase().trim();
  if (s.includes("256000000") || s === "1") return "A";
  if (s.includes("256000001") || s === "2") return "B";
  if (s.includes("256000002") || s === "3") return "C";
  if (s.includes("256000003") || s === "4") return "D";
  const m = s.match(/(?:^|[^A-Z])([ABCD])(?=$|[^A-Z])/);
  return m ? m[1] : "";
}

// --- SHIFT DETECTION (craa5_workshift, same reading rules as Ganttly) ---
function parseWorkShiftRows(rows: any[]): Slot[] | null {
  const read = (r: any, n: string) => getField(r, n + FMT) ?? getField(r, n);
  const raw = rows.map(r => ({ crew: normalizeShift(read(r, 'craa5_shiftcode')), dayName: String(read(r, 'craa5_dayname') || ''), dayNum: parseInt(read(r, 'craa5_daynumber'), 10), startH: parseInt(read(r, 'craa5_shiftstarthour'), 10), endH: parseInt(read(r, 'craa5_shiftendhour'), 10) }));
  const hours: number[] = [];
  raw.forEach(x => { if (!isNaN(x.startH)) hours.push(x.startH); if (!isNaN(x.endH)) hours.push(x.endH); });
  // Dataverse can't store 0 here: midnight is 1, or every hour is stored +1 (1/7/13/19).
  const plusOne = hours.length > 0 && hours.every(h => h >= 1 && (h - 1) % 6 === 0);
  const hasZeroDay = raw.some(x => x.dayNum === 0);
  const fixHour = (h: number) => plusOne ? (h - 1 + 24) % 24 : (h === 1 || h === 24) ? 0 : ((h % 24) + 24) % 24;
  const slots: Slot[] = [], pending: Slot[] = [];
  raw.forEach(x => {
    const m = x.dayName.toLowerCase().match(/sun|mon|tue|wed|thu|fri|sat/);
    let day = m ? ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'].indexOf(m[0]) : (isNaN(x.dayNum) ? -1 : (hasZeroDay ? x.dayNum : x.dayNum - 1));
    if (!x.crew || day < 0 || isNaN(x.startH) || isNaN(x.endH)) return;
    day = ((day % 7) + 7) % 7;
    const sH = fixHour(x.startH), eH = fixHour(x.endH);
    const slot = { crew: x.crew, day, startHour: sH, lengthHours: ((eH - sH + 24) % 24) || 24 };
    (sH < 4 ? pending : slots).push(slot);
  });
  // After-midnight rows belong to the named day or the next one, whichever overlaps the other rows less.
  const hoursOf = (s: Slot) => Array.from({ length: s.lengthHours }, (_, h) => (s.day * 24 + s.startHour + h) % 168);
  pending.forEach(p => {
    const taken = new Set<number>(); slots.forEach(s => hoursOf(s).forEach(h => taken.add(h)));
    const next = { ...p, day: (p.day + 1) % 7 };
    const clash = (s: Slot) => hoursOf(s).filter(h => taken.has(h)).length;
    slots.push(clash(p) < clash(next) ? p : next);
  });
  return slots.length ? slots : null;
}

function findShift(slots: Slot[], now: Date): ShiftWin {
  for (const s of slots) {
    for (let back = 0; back <= 1; back++) {
      const d = new Date(now); d.setDate(d.getDate() - back);
      if (d.getDay() !== s.day) continue;
      const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
      const end = new Date(start.getTime() + s.lengthHours * 3600000);
      if (now >= start && now < end) return { crew: s.crew, start, end, auto: true };
    }
  }
  // Not covered by the rotation: plain 6-to-6 window, crew picked by hand.
  const h = now.getHours(), start = new Date(now);
  if (h < 6) start.setDate(start.getDate() - 1);
  start.setHours(h >= 6 && h < 18 ? 6 : 18, 0, 0, 0);
  return { crew: '', start, end: new Date(start.getTime() + 12 * 3600000), auto: false };
}

// --- DATAVERSE ---
// Xrm.WebApi first, then the generative page's dataApi. A failure only affects that one call.
async function queryRecords(props: any, entityNames: string | string[], q: { select?: string[]; filter?: string; orderby?: string; top?: number } = {}): Promise<any[] | null> {
  const webApi = getReadApi(props), dataApi = props?.dataApi, names = Array.isArray(entityNames) ? entityNames : [entityNames], top = q.top ?? 5000;
  const odata = [q.select?.length ? `$select=${q.select.join(',')}` : '', q.filter ? `$filter=${q.filter}` : '', q.orderby ? `$orderby=${q.orderby}` : '', `$top=${top}`].filter(Boolean).join('&');
  for (const en of names) {
    if (webApi?.retrieveMultipleRecords) {
      try {
        const res: any = await withTimeout(webApi.retrieveMultipleRecords(en, `?${odata}`), API_TIMEOUT_MS, `Xrm.WebApi ${en}`);
        if (Array.isArray(res?.entities)) return res.entities;
      } catch (e) { console.warn(`[Shift Start] ${en} via Xrm.WebApi:`, errMsg(e)); }
    }
    if (dataApi?.queryTable) {
      try {
        const opts: any = { pageSize: Math.min(top, 500) };
        if (q.select?.length) opts.select = q.select;
        if (q.filter) opts.filter = q.filter;
        if (q.orderby) opts.orderBy = q.orderby;
        let page: any = await withTimeout(dataApi.queryTable(en, opts), API_TIMEOUT_MS, `dataApi ${en}`);
        if (!Array.isArray(page?.rows)) throw new Error("no rows");
        const rows = [...page.rows];
        while (page?.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < top) {
          page = await withTimeout(page.loadMoreRows(), API_TIMEOUT_MS, `dataApi ${en}`);
          rows.push(...(Array.isArray(page?.rows) ? page.rows : []));
        }
        return rows.slice(0, top);
      } catch (e) { console.warn(`[Shift Start] ${en} via dataApi:`, errMsg(e)); }
    }
  }
  return null;
}

const idOf = (res: any) => { const id = typeof res === 'string' ? res : res?.id; return id ? String(id).replace(/[{}]/g, '') : null; };
function getWriteApi(props?: any): { create: (t: string, d: any) => Promise<string | null>; update: (t: string, id: string, d: any) => Promise<any> } | null {
  const web = getReadApi(props), dataApi = props?.dataApi;
  if (web?.createRecord && web?.updateRecord) return { create: async (t, d) => idOf(await web.createRecord(t, d)), update: (t, id, d) => web.updateRecord(t, id, d) };
  if (dataApi?.createRow && dataApi?.updateRow) return { create: async (t, d) => idOf(await dataApi.createRow(t, d)), update: (t, id, d) => dataApi.updateRow(t, id, d) };
  return null;
}
const hasReadApi = (props?: any) => !!(getReadApi(props)?.retrieveMultipleRecords || props?.dataApi?.queryTable);
const odataText = (s: string) => s.replace(/'/g, "''");

async function findReportRow(props: any, name: string) {
  const rows = await queryRecords(props, T.report, { select: ['craa5_sanitationshiftreportid', 'craa5_equipmentjson', 'modifiedon'], filter: `craa5_name eq '${odataText(name)}' and statecode eq 0`, orderby: 'modifiedon desc', top: 1 });
  if (!rows) return undefined;                  // lookup failed
  const id = rows[0] && getField(rows[0], 'craa5_sanitationshiftreportid');
  return id ? { id: String(id), json: getField(rows[0], 'craa5_equipmentjson'), modifiedon: getField(rows[0], 'modifiedon') } : null;
}

// --- DOMAIN ---
function readEmployee(e: any): Emp | null {
  const id = String(getField(e, 'craa5__aa_employeeid') || getField(e, 'craa5_aa_employeeid') || '');
  const raw = String(getField(e, 'craa5_name') || '').trim();
  if (!id || !raw) return null;
  const r = norm(getField(e, 'craa5_role' + FMT) ?? getField(e, 'craa5_role'));
  const role = /256000002|super/.test(r) ? 'supervisor' : /256000003|manag/.test(r) ? 'manager' : /256000001|lead/.test(r) ? 'lead' : 'employee';
  const crew = normalizeShift(getField(e, 'craa5_shift' + FMT) ?? getField(e, 'craa5_shift'));
  const jobName = String(getField(e, '_craa5_roleid_value' + FMT) ?? getField(e, '_craa5_roleid_value') ?? '').replace(/^[0-9a-f-]{36}$/i, '');
  return { id, raw, name: displayName(raw), email: String(getField(e, 'craa5_email') || getField(e, 'emailaddress1') || getField(e, 'internalemailaddress') || ''), badge: String(getField(e, 'craa5_badgenumber') || ''), crew, role, job: jobOf(jobName), jobName };
}

// Job role (craa5__aa_role lookup on the employee). Only Sanitation Tech 1 / 2 (and anyone with no role set) get the
// regular equipment split; Tech 3 and Inspectors only get assets whose subcategory is "1 - pic"; the rest sit in a fixed area.
function jobOf(name: string): Job {
  const n = norm(name);
  if (/chem/.test(n)) return 'clerk';
  if (/admin/.test(n)) return 'admin';
  if (/janitor/.test(n)) return 'janitorial';
  if (/inspect/.test(n)) return 'inspector';
  if (/tech\w*\s*3\b/.test(n)) return 'tech3';
  return 'tech';
}
const isPicOnly = (j?: Job) => j === 'inspector' || j === 'tech3';
const isPic = (v: any) => /^1\s*[-–]?\s*pic\b/.test(norm(v));
// Area a role is placed in automatically (inspectors only on nights).
function fixedAreaFor(job: Job, night: boolean): string | null {
  return job === 'clerk' ? 'chemical' : job === 'admin' ? 'admin' : job === 'janitorial' ? 'janitorial' : job === 'inspector' && night ? 'admin' : null;
}
const isNightShift = (sh: { start: Date }) => sh.start.getHours() >= 18 || sh.start.getHours() < 6;
const findAreaLine = (ls: Line[], area: string) => ls.find(l => norm(l.name) === area) || ls.find(l => new RegExp(`\\b${area}`).test(norm(l.name)));
// employee id -> job, filled at load so the pure board helpers below can see roles.
const JOBS = new Map<string, Job>();

// Each asset belongs to ONE line: exact name, else the longest line name it contains as whole words.
function buildLines(rawAreas: any[], rawAssets: any[]): Line[] {
  const lines: Line[] = rawAreas.map(a => ({
    id: String(getField(a, 'craa5_aa_mss_areaid') || ''), name: String(getField(a, 'craa5_area') || '').trim(),
    production: isBoolTrue(getField(a, 'craa5_production' + FMT) ?? getField(a, 'craa5_production')),
    everyday: isBoolTrue(getField(a, 'craa5_everyday' + FMT) ?? getField(a, 'craa5_everyday')),
    manual: false, assets: [] as Asset[],
  })).filter(a => a.id && a.name && !STATUS_AREAS.has(norm(a.name)));
  const words = (v: any) => norm(v).split(/[^a-z0-9]+/).filter(Boolean);
  const has = (hay: string[], needle: string[]) => hay.some((_, i) => needle.length > 0 && needle.every((w, j) => hay[i + j] === w));
  rawAssets.forEach((ast, i) => {
    const label = String(getField(ast, 'craa5_areaname') || '');
    let line = lines.find(l => norm(l.name) === norm(label));
    if (!line && label) line = lines.filter(l => has(words(label), words(l.name))).sort((a, b) => words(b.name).length - words(a.name).length)[0];
    if (line) line.assets.push({ id: String(getField(ast, 'craa5_aa_assetsid') || `${line.id}-asset-${i}`), name: String(getField(ast, 'craa5_equipmentidentifier') || 'Equipment'), pic: isPic(getField(ast, 'craa5_subcategory' + FMT) ?? getField(ast, 'craa5_subcategory')) });
  });
  lines.forEach(l => l.assets.sort(byName));
  return lines.sort(byName);
}

const lineOrder = (a: Line, b: Line) => (a.production === b.production ? byName(a, b) : a.production ? -1 : 1);

// People working a line (members and leads), in board order.
function workersOn(b: Board, lineId: string): string[] {
  const order = [...b.leads, ...Object.keys(b.members)];
  return uniq(order).filter(id => b.workerLine[id] === lineId && !b.out[id]);
}

// Equipment split: hand-edited lines keep their placement, others are dealt out evenly by role (see jobOf).
// Leads only get equipment when nobody else on the line is eligible.
function equipmentFor(b: Board, line: Line): Record<string, string> {
  const people = workersOn(b, line.id);
  const out: Record<string, string> = {};
  if (b.equipManual.includes(line.id)) {
    line.assets.forEach(a => { if (b.equip[a.id] && people.includes(b.equip[a.id])) out[a.id] = b.equip[a.id]; });
    return out;
  }
  const crew = people.filter(id => !b.leads.includes(id));
  const clerks = people.filter(id => JOBS.get(id) === 'clerk');
  if (norm(line.name) === 'chemical' && clerks.length) {   // the chemical clerk takes everything on the chemical line
    line.assets.forEach((a, i) => { out[a.id] = clerks[i % clerks.length]; });
    return out;
  }
  const regular = (list: string[]) => list.filter(id => (JOBS.get(id) || 'tech') === 'tech');
  const picOnly = (list: string[]) => list.filter(id => isPicOnly(JOBS.get(id)));
  const regs = regular(crew).length ? regular(crew) : regular(people);
  const pics = picOnly(crew);
  let r = 0, q = 0;
  line.assets.forEach(a => {
    if (a.pic && pics.length) out[a.id] = pics[q++ % pics.length];
    else if (regs.length) out[a.id] = regs[r++ % regs.length];
  });
  return out;
}

function lineStatus(line: Line, b: Board) {
  const p = Math.max(0, Math.min(TOTAL_STEPS, Math.round(b.progress[line.id] || 0)));
  if (!line.production) return { done: p >= TOTAL_STEPS, pct: p >= TOTAL_STEPS ? 100 : p > 0 ? 50 : 0, label: p >= TOTAL_STEPS ? 'Done' : p > 0 ? 'In progress' : 'Not started', left: '', stepsLeft: 0, next: '' };
  return {
    done: p >= TOTAL_STEPS, pct: Math.round((p / TOTAL_STEPS) * 100), stepsLeft: TOTAL_STEPS - p, next: STEP_LABELS[p] || '',
    label: p === 0 ? 'Not started' : p >= TOTAL_STEPS ? 'Complete' : `${STEP_LABELS[p - 1]} done`,
    left: p < TOTAL_STEPS ? STEP_LABELS.slice(p).join(' → ') : '',
  };
}

function buildUpdateText(ctx: { b: Board; lines: Line[]; shift: ShiftWin; team: string; empById: Map<string, Emp>; now: Date }): string {
  const { b, lines, shift, team, now } = ctx;
  const active = lines.filter(l => b.downLines.includes(l.id)).sort(lineOrder);
  const onFloor = uniq(active.flatMap(l => workersOn(b, l.id)));
  const ot = onFloor.filter(id => b.overtime.includes(id)).length;
  const outCounts = OUT_REASONS.map(r => [r, Object.values(b.out).filter(x => x === r).length] as const).filter(([, n]) => n > 0);
  const L: string[] = [];
  L.push(`SANITATION UPDATE · ${now.toLocaleDateString(undefined, { weekday: 'short', month: 'numeric', day: 'numeric' })} · ${hm(now)}`);
  L.push(`${shift.crew || '?'} Shift${team ? ` · Team ${team}` : ''}`);
  L.push(`👥 ${onFloor.length} heads on the floor${ot ? ` (${ot} OT)` : ''}${outCounts.length ? ` · Out: ${outCounts.map(([r, n]) => `${n} ${r}`).join(', ')}` : ''}`);
  const done = active.filter(l => lineStatus(l, b).done).length;
  L.push(`✅ ${done}/${active.length} complete`);
  const section = (title: string, list: Line[]) => {
    if (!list.length) return;
    L.push('', title);
    list.forEach(l => {
      const s = lineStatus(l, b), heads = workersOn(b, l.id).length;
      const eq = equipmentFor(b, l), eqIds = Object.keys(eq), eqDone = eqIds.filter(id => b.equipDone[id]).length;
      const detail = s.done ? (l.production ? '✅ Complete' : '✅ Done')
        : l.production ? (s.pct === 0 ? 'Not started' : `${s.pct}% · ${s.label} · ${s.stepsLeft} step${s.stepsLeft === 1 ? '' : 's'} left (next: ${s.next})`) : s.label;
      L.push(`• (${heads}) ${l.name} — ${detail}${l.production && eqIds.length && !s.done && s.pct > 0 ? ` · ${eqDone}/${eqIds.length} equipment` : ''}`);
      if (b.notes[l.id]?.trim()) L.push(`   ↳ ${b.notes[l.id].trim()}`);
    });
  };
  section('PRODUCTION', active.filter(l => l.production));
  section('OTHER', active.filter(l => !l.production));
  if (!active.length) L.push('', 'No lines set for cleaning yet.');
  return L.join('\n');
}

async function copyText(text: string): Promise<boolean> {
  try { if (navigator?.clipboard?.writeText && window.isSecureContext) { await navigator.clipboard.writeText(text); return true; } } catch (e) {}
  try {
    const ta = document.createElement("textarea"); ta.value = text; ta.setAttribute("readonly", ""); ta.style.cssText = "position:fixed;top:0;left:0;opacity:0;";
    document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); ta.remove(); return ok;
  } catch (e) { return false; }
}

