    if (ASG_DROPPED.has('craa5_assignmentkey') && !ASG_DROPPED.has('craa5_name')) d.craa5_name = row.craa5_assignmentkey;
    let isNew = !exists;
    for (let attempt = 0; attempt < 8; attempt++) {
        try {
            if (!isNew) await asyncRace(api.update(ASG_TABLE, id, d), API_TIMEOUT_MS, 'equipment save');
            else {
                try { await asyncRace(api.create(ASG_TABLE, { ...d, [idCol]: id }), API_TIMEOUT_MS, 'equipment save'); }
                catch (e: any) { if (!isDuplicateError(extractDvError(e))) throw e; isNew = false; continue; }
            }
            return '';
        } catch (e: any) {
            const msg = extractDvError(e) || 'not saved';
            const bad = (msg.match(/craa5_[a-z0-9_]+/gi) || []).map(x => x.toLowerCase()).find(c => c in d);
