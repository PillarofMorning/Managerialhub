            else if (op.op === 'detail') setAreaDetails(p => { const cur = p[op.areaId] || { currentStatus: "", futureNotes: "" }; return { ...p, [op.areaId]: { ...cur, currentStatus: op.status !== undefined ? op.status : cur.currentStatus, futureNotes: op.left !== undefined ? op.left : cur.futureNotes } }; });
            else if (op.op === 'overtime') { const emp = employeeMap.get(op.empId); if (emp) setCustomEmployees(p => p.some(x => getField(x, 'craa5__aa_employeeid') === op.empId) ? p : p.concat([emp])); }
            else if (op.op === 'away') {
                const aId = stArea[op.status];
                setEmployeeStartTimes(p => ({ ...p, [op.empId]: nowIso }));
                setSelectedAreaIds(p => { const n = new Set(p); n.add(aId); return n; });
                setAreaAssignments(p => p[aId] ? p : { ...p, [aId]: selectedSupervisorId || "" });
                setAssignments(prev => { const next: Record<string, string[]> = {}; Object.keys(prev).forEach(k => { next[k] = prev[k].filter(id => id !== op.empId); }); next[aId] = (next[aId] || []).concat([op.empId]); return next; });
            }
        });
    };
    const chatApply = (entryId: number) => {
        const e = chatBox.thread.find(x => x.id === entryId); if (!e || e.state !== 'preview') return;
        const plan = chatRead(e.text), now = Date.now();
        if (!plan.ops.length) { setChatBox(b => ({ ...b, thread: b.thread.map(x => x.id === entryId ? { ...x, items: plan.items, ops: plan.ops } : x) })); return; }
        chatUndo.current = { id: entryId, snap: { selectedAreaIds, areaAssignments, assignments, areaDetails, employeeStartTimes, customEmployees, customAreas, selectedLeadIds } };
        applyChatOps(plan.ops);
        const rows = plan.items.filter(i => i.ops.length).map(i => ({ at: now, kind: i.kind, text: i.text }));
        setChatBox(b => ({ ...b, thread: b.thread.map(x => x.id === entryId ? { ...x, items: plan.items, ops: plan.ops, state: 'applied', appliedAt: now } : x), log: b.log.concat(rows) }));
        setChatDirty(true);
    };
    const chatUndoLast = () => {
