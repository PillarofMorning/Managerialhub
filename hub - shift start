    });
    const resolveRoom = (area: string) => canonicalRoom[normText(area)] || canonicalRoom['ck:' + cleanAreaKey(area)] || "";
    const mk = (area: string, lead: string, name: string, guid: string) => ({ craa5_taskassignmentid: "", craa5_id: name, craa5__aaemp_guid: guid, craa5_lead: lead, craa5_area: area, craa5_team: supName, craa5_whatisbeingdone: "", craa5_whatislefttodo: "", craa5_starttime: now, craa5_datetimeofassignment: now, createdon: now, craa5_percentagecomplete: 0, craa5_complete: false, statecode: 0 });
    const leadOf = (p: HistPerson) => {
        if (!p.lead) return supName;
        if (sameText(p.lead, supName) || (personKey(p.lead) && personKey(p.lead) === personKey(supName))) return supName;
        const matchedLead = leadSet[normText(p.lead)] || leadSet['pk:' + personKey(p.lead)];
        return matchedLead || supName;
    };
    b.people.forEach(p => {
        const roomName = resolveRoom(p.area);
        if (!roomName) { if (p.area && droppedRooms.indexOf(p.area) < 0) droppedRooms.push(p.area); return; }
        if (!p.emp) return;
        const cleanPid = String(p.id || "").replace(/[{}]/g, '').trim().toLowerCase();
        const e = (cleanPid && byId[cleanPid]) || byName[normText(p.emp)] || byName[normText(formatFullName(p.emp))] || byName['pk:' + personKey(p.emp)];
        if (!e) { if (skipped.indexOf(p.emp) < 0) skipped.push(p.emp); return; }
        roomHas[normText(roomName)] = true;
        rows.push(mk(roomName, leadOf(p), renderSafe(getField(e, 'craa5_name')), String(empIdOf(e) || "")));
    });
    b.people.forEach(p => {
        const roomName = resolveRoom(p.area);
        if (!roomName) return;
        const k = normText(roomName);
        if (roomHas[k]) return;
        roomHas[k] = true;
        rows.push(mk(roomName, leadOf(p), "", ""));
    });
    return { rows, skipped, droppedRooms };
}

