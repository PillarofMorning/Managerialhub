        txt += "\n";

        const getInitials = (fn: string) => { const parts = (fn || "").trim().split(/\s+/).filter(Boolean); if (!parts.length) return ""; return parts.length === 1 ? parts[0].charAt(0).toUpperCase() : (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase(); };
        const fes = (id: string) => { const empName = formatFullName(getField(employeeMap.get(id), 'craa5_name')); return `${clipboardFormat === 'fullname' ? empName : getInitials(empName)} [${formatDuration(employeeStartTimes[id])}]`; };
