const isDuplicateError = (msg: string) => /duplicate|already exists|matching key|0x80040237/i.test(msg);
async function writeMssLogs(props: any, jobs: MssAreaJob[], slotStartMs: number): Promise<{ written: number; skipped: number; failed: number; error: string }> {
    const res = { written: 0, skipped: 0, failed: 0, error: '' };
    const wApi = getWriteApi(props);
    if (!SHIFT_START_LOGS_MSS || !wApi || !jobs.length) return res;
    const shiftDate = hubShiftDate(slotStartMs);
    if (!shiftDate) return res;
    const already = await mssLoggedOn(props, shiftDate);
    const pending: any[] = [];
    jobs.forEach(job => {
        const scope = mssCleanScope(job.cleanType);
        const pieces = mssPiecesFor(job);
        if (!scope || !pieces.length) return;
        const perPieceHrs = Math.max(0.08, (job.totalAreaHrs || 2) / Math.max(1, pieces.length));
        pieces.forEach((a: any) => {
            const guid = assetGuidOf(a), key = hubCompletionKey(guid, shiftDate, scope.code), id = hubLogIdOf(key);
            if (!id || already.has(guid)) { res.skipped++; return; }
            const rawHrs = parseFloat(String(a.craa5_hoursrequired ?? getField(a, 'craa5_hoursrequired') ?? '0'));
            const pieceHrs = (!isNaN(rawHrs) && rawHrs > 0 && rawHrs <= 16) ? rawHrs : perPieceHrs;
            pending.push({
                [MSS_LOG_ID]: id,
                craa5_completionkey: key,
                craa5_source: 'Shift Start',
                craa5_sap: 'auto-' + scope.code,
                craa5_room: String(a.craa5_room || a.craa5_roomname || getField(a, 'craa5_room') || getField(a, 'craa5_roomname') || job.areaName).trim(),
                craa5_area: String(a.craa5_area || a.craa5_areaname || getField(a, 'craa5_area') || getField(a, 'craa5_areaname') || job.areaName).trim(),
                craa5_equipment: String(a.craa5_ValidationName || a.craa5_validationname || a.craa5_equipment || a.craa5_equipmentidentifier || a.craa5_name || getField(a, 'craa5_validationname') || getField(a, 'craa5_equipment') || getField(a, 'craa5_equipmentidentifier') || 'Equipment').trim(),
                craa5_equipmentguid: guid,
                craa5_lastcleaned: hubDateOnlyUtc(shiftDate),
                craa5_lastcleanedby: job.cleanedBy,
                craa5_hoursworked: Math.max(1, Math.round(pieceHrs)),   // whole number column
                ...scope.logFlags,
            });
        });
    });
    // Without the columns the table may not have yet; the row id, equipment, date and clean flags always stay.
    const lean = (r: any) => { const o = { ...r }; ['craa5_completionkey', 'craa5_source', 'craa5_sap', 'craa5_hoursworked', 'craa5_room'].forEach(c => { delete o[c]; }); return o; };
    for (let i = 0; i < pending.length; i += 4) {
        const batch = pending.slice(i, i + 4);
        await Promise.all(batch.map((row: any) => wApi.create(MSS_LOG_TABLE, row)
            .catch((e: any) => { if (isDuplicateError(extractDvError(e))) throw e; return wApi.create(MSS_LOG_TABLE, lean(row)); })
            .then(() => { res.written++; })
            .catch((e: any) => { const m = extractDvError(e); if (isDuplicateError(m)) { res.skipped++; return; } res.failed++; res.error = res.error || m; })));
    }
    if (res.failed) logError(`MSS log: ${res.failed} piece(s) not saved`, res.error);
    return res;
}

// ---- Equipment to people, shared with Ganttly (craa5__g_assignment) ----
// Spec: /mnt/project-files/ganttly-overhaul/shared-assignment.md. One row per piece per shift, updated in place.
// Ganttly's engine places the pieces (source 'auto'); Shift Start never splits pieces itself. A piece a person places, here or in Ganttly, is pinned,
// and Ganttly plans everything else around it. Shift Start reads the rows every 60 s and when the tab gets focus; Done comes from the MSS log row Ganttly writes when a piece is finished.
// The table's name as the spec gives it first; the others are names the table maker may have produced. The first that answers is used.
const ASG_TABLE_NAMES = ['craa5__g_assignment', 'craa5_g_assignment', 'craa5__g_assignments', 'craa5_gassignment'], CHECKOFF_TABLE = 'craa5_cleancheckoff';
