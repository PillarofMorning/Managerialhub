type ShiftBoardsPanelProps = { hostProps: any; by: string; byEmail: string; slots: Slot[]; onClose: () => void; onChanged: () => void };
function ShiftBoardsPanel({ hostProps, by, byEmail, slots, onClose, onChanged }: ShiftBoardsPanelProps) {
    type Tab = 'live' | 'plans' | 'archive' | 'import' | 'activity' | 'setup';
    const [tab, setTab] = useState<Tab>('live');
