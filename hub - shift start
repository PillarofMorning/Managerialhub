function pickRemembered(h: History | null, slotStartMs: number, ctx: RememberCtx): { board: HistBoard; how: 'matches' | 'newest' } | null {
    const c = rememberedCandidates(h, slotStartMs, ctx); if (!c.pool.length) return null;
