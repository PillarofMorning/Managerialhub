function lsDropHist(key: string) { try { const raw = window.localStorage.getItem(HIST_LS_KEY), o = raw ? JSON.parse(raw) : null; if (o && typeof o === 'object' && o[key]) { delete o[key]; window.localStorage.setItem(HIST_LS_KEY, JSON.stringify(o)); } } catch (e) { /* nothing kept */ } }
const histCacheKey = (crew: string, names: string[]) => (crew || 'ALL') + '|' + names.map(normText).sort().join('|');
