            } else {
                setSaveWarning(`Saved to browser storage on this device (${w.error || 'offline'}). Use Copy Board JSON in Console to back up or transfer.`);
            }
        }
        logActivity(propsRef.current, { action: reactivate ? 'saved (reopened)' : 'saved', user: me, email: myEmail, role: access.role, board: boardName(savedBoard), boardId: savedBoard.recordId, crew: savedBoard.crew, team: savedBoard.team, changes });
        // Finished areas go to the MSS calendar only now that the board is saved (in the background; a failure is shown and retried on the next save)
        if (mssJobs.length) {
            // Dated by the shift: a night shift's 2 AM clean stays on the day the shift began
            writeMssLogs(propsRef.current, mssJobs, Number(savedBoard?.slotStart) || Date.now()).then(r => {
                if (r.failed) setSaveWarning(prev => `${prev ? prev + ' ' : ''}${tx(`MSS calendar: ${r.failed} piece${r.failed === 1 ? '' : 's'} not logged (${r.error.slice(0, 120)}); saving again retries them.`, `Calendario MSS: ${r.failed} pieza${r.failed === 1 ? '' : 's'} sin registrar (${r.error.slice(0, 120)}); guardar de nuevo lo reintenta.`)}`);
