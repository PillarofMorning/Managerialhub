    // SAVE SETUP — a next-shift board is stored as a setup (the table craa5_shiftpreset, or this computer until that exists), never as today's assignments.
    const handleSavePreset = async () => {
        if (!nextSlot || !viewCrew) return;
        if (nextSlot.startMs <= Date.now()) { setNextSlot(null); setSubmissionError(mayWorkLiveOf(activeSupervisorObj) ? "That shift has started, so this board is today's now. Press Save Progress to start the shift with it." : `That shift has started, so this board is ${formatFullName(getField(activeSupervisorObj, 'craa5_name'))}'s live board now. Tick Acting Sup. to save it, or click your own shift letter to go back to your own board.`); return; }
        setBusyLabel("Saving setup..."); setIsLoading(true); setSaveSuccess(false); setSaveWarning(""); setSubmissionError(null);
