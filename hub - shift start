// What the app read and how it used it, so a wrong crew can be traced without a console: who is signed in, the shift on the clock,
// each team's lead and crew size, and which columns were found.
function DataCheckPanel({ onClose, msUser, currentUser, slotCount, currentShift, shiftStartMs, upNextShift, teams, teamsRead, employees, supervisors, taskStatus, areaCount, boardCrew, ownerName, presets, presetStore, presetLog, prd, prdWindow, hist, histStatus, histNames, remembered, onReread, suggestMode, leadSuggestCount, memberSuggestCount }: any) {
    const nameOf = (id: string) => { const e = employees.find((x: any) => empIdOf(x) === id); return e ? formatFullName(getField(e, 'craa5_name')) : ""; };
    const withLookup = employees.filter((e: any) => !!teamIdOfEmp(e)).length;
    const sample = employees[0] || {}, hasKey = (k: string) => Object.keys(sample).some(x => x.toLowerCase() === k.toLowerCase());
    const sourceOf = (e: any) => teamLedBy(e) ? 'lead of the team' : teamIdOfEmp(e) && TEAMS.some(t => t.id === teamIdOfEmp(e)) ? 'team lookup' : 'shift letter';
    const row = (k: string, v: any, bad?: boolean) => <div key={k} className="flex gap-3 py-1 border-b border-slate-100"><Text size={200} weight="semibold" style={{ width: 150, flexShrink: 0 }}>{k}</Text><Text size={200} style={{ color: bad ? BRAND.red : undefined }}>{v}</Text></div>;
    const col = (name: string, ok: boolean | null, why: string) => <div key={name} className="flex gap-2 py-0.5 items-center flex-wrap"><Badge size="small" appearance="filled" color={ok === null ? 'informative' : ok ? 'success' : 'danger'}>{ok === null ? 'not checked' : ok ? 'found' : 'missing'}</Badge><Text size={200} weight="semibold">{name}</Text><Text size={200} color="neutralSecondary">{why}</Text></div>;
    const sentKeys = presetLog && presetLog.where === 'dataverse' ? Object.keys(presetLog.sent || {}) : [];
    const colState = (name: string): boolean | null => presetLog && presetLog.refused && presetLog.refused.indexOf(name) >= 0 ? false : sentKeys.indexOf(name) >= 0 ? true : null;
    return (
        <div style={{ position: 'absolute', inset: 0, background: 'rgba(0,30,60,0.45)', zIndex: 10000, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 16 }} onClick={onClose}>
            <div className="bg-white rounded-2xl shadow-lg border border-slate-200 w-full max-w-[860px] flex flex-col" style={{ maxHeight: '100%' }} onClick={e => e.stopPropagation()}>
                <div className="flex justify-between items-center px-5 py-3 border-b-4 border-[#FFB81C] shrink-0"><Text size={500} weight="bold" style={{ color: BRAND.blueDark }}>Data check</Text><Button size="small" appearance="primary" onClick={onClose}>Close</Button></div>
                <div className="p-5 overflow-y-auto">
                    {row('Signed in', msUser ? `${msUser.name || '?'}${msUser.email ? ` <${msUser.email}>` : ' (no email came from the host)'}` : 'nobody yet')}
                    {row('Matched employee', currentUser ? `${formatFullName(getField(currentUser, 'craa5_name'))} · ${currentUser.calculatedRole}${currentUser.calculatedRole === 'supervisor' && roleOf(currentUser) !== 'supervisor' ? ' (leads a team)' : ''}` : 'no employee matched, so a profile was picked from the list', !currentUser)}
                    {row('Work schedule', `${slotCount} shift slot${slotCount === 1 ? '' : 's'} read · ${currentShift ? `shift ${currentShift} on now since ${clockTime(shiftStartMs)}` : 'no shift covers now'}${upNextShift ? ` · shift ${upNextShift} starts within the hour` : ''}`, !slotCount)}
                    {row('Board', `${ownerName || 'no board open'}${boardCrew ? ` · drawing from crew ${boardCrew}` : ''}`)}
                    {row('Saved assignments', taskStatus ? (taskStatus.ok ? `read through ${taskStatus.source}: ${taskStatus.read} row${taskStatus.read === 1 ? '' : 's'} from the last 24 h` : `could not be read: ${String(taskStatus.error).slice(0, 160)}`) : 'not read yet', !!taskStatus && !taskStatus.ok)}
                    {row('Employees', `${employees.length} read · ${withLookup} with a team set · ${employees.length - withLookup} on their shift letter · ${supervisors.length} supervisors · ${areaCount} areas`)}
                    <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Teams table (craa5__aa_leadershipteam)</Text></div>
                    {teamsRead === 0
                        ? <Text size={200} block style={{ color: BRAND.red }}>No team rows were read (the table was not found or is empty), so every crew comes from the shift letter on each employee.</Text>
                        : <table className="w-full text-sm" style={{ borderCollapse: 'collapse' }}><thead><tr style={{ background: BRAND.blueSoft }}>{['Team', 'Team lead (supervisor)', 'Crew size', 'How the crew is found', 'On the clock'].map(h => <th key={h} className="text-left px-2 py-1"><Text size={200} weight="bold">{h}</Text></th>)}</tr></thead>
                            <tbody>{teams.map((t: TeamRow) => {
                                const crew = employees.filter((e: any) => crewOfPerson(e) === t.letter), viaLookup = crew.filter((e: any) => teamIdOfEmp(e) === t.id).length;
                                const lead = nameOf(t.leadId);
                                return <tr key={t.id} className="border-b border-slate-100"><td className="px-2 py-1"><Text size={200} weight="bold">{t.letter}</Text></td>
                                    <td className="px-2 py-1"><Text size={200} style={{ color: lead ? undefined : BRAND.red }}>{lead || (t.leadId ? 'lead id is not in the employee list' : 'no lead set')}</Text></td>
                                    <td className="px-2 py-1"><Text size={200}>{crew.length}</Text></td>
                                    <td className="px-2 py-1"><Text size={200}>{viaLookup} by team lookup, {crew.length - viaLookup} by shift letter</Text></td>
                                    <td className="px-2 py-1"><Text size={200} weight={t.letter === currentShift ? 'bold' : 'regular'}>{t.letter === currentShift ? 'on now' : t.letter === upNextShift ? 'starts soon' : ''}</Text></td></tr>;
                            })}</tbody></table>}
                    <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Columns this screen reads</Text></div>
                    {col('craa5__aa_leadershipteam.craa5_teamname', teamsRead > 0, 'text: the crew letter A-D')}
                    {col('craa5__aa_leadershipteam._craa5_teamleademployeeid_value', teams.some((t: TeamRow) => !!t.leadId), 'lookup to the employee: the supervisor of that crew')}
                    {col('craa5__aa_employee._craa5_leadershipteamid_value', hasKey('_craa5_leadershipteamid_value') || hasKey('craa5_leadershipteamid'), 'lookup to the team: which crew the employee is on')}
                    {col('craa5__aa_employee.craa5_shift', hasKey('craa5_shift'), 'choice: the crew letter used when the team lookup is empty')}
                    {col('craa5_workshift (craa5_shiftcode, craa5_dayname, craa5_shiftstarthour, craa5_shiftendhour)', slotCount > 0, 'which crew is on the clock')}
                    <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Production schedule (table {PROD_TABLE})</Text></div>
                    <Text size={200} block style={{ color: prd && (prd.status === 'missing' || prd.status === 'error') ? BRAND.red : undefined }}>
                        {!prdWindow ? 'No shift window to read for (no shift covers this board).' : !prd || prd.status === 'idle' ? 'Not read yet (it is read when a board opens).' : prd.status === 'reading' ? 'Reading...'
                            : prd.status === 'missing' ? `The table was not found, so no rooms are picked from it. ${String(prd.error).slice(0, 160)}` : prd.status === 'error' ? `Could not be read: ${String(prd.error).slice(0, 200)}`
                            : `Read through ${prd.source}: ${prd.read} run${prd.read === 1 ? '' : 's'} (a week either side of ${slotLabel(prdWindow.from)} to ${clockTime(prdWindow.to)}), ${prd.lineCount} line${prd.lineCount === 1 ? '' : 's'} known, ${prd.planLines} with a run in this shift${prd.status === 'ok' && prd.planEnd > 0 && prd.planEnd < prd.to ? `, the plan is entered through ${slotLabel(prd.planEnd)} (the hours after that are not judged)` : ''}.${prd.status === 'ok' && prd.planLines === 0 ? ' No line runs in this shift, but the plan has runs before and after it, so every line is judged idle for it.' : ''}${prd.status === 'empty' ? ' No line has a run in this shift and there are no runs on both sides of it, so the plan is not entered yet and no room is picked from it.' : ''}${prd.status === 'partial' ? ' Every run in this shift began before it and none starts in or after it, so the plan looks like it stops before this shift (not entered yet): no room is picked by itself.' : ''}`}
                    </Text>
                    {prd && (prd.status === 'ok' || prd.status === 'partial') && <Text size={200} block className="mt-1">{prd.down.length ? `${prd.status === 'partial' ? 'Rooms that would be down if nothing else is planned (offered, not added by themselves)' : 'Rooms with a line down for an hour or more'}: ${prd.down.map((d: any) => `${d.name} (${d.stretches.map((x: any) => `${x.line} ${clockTime(x.from)} to ${clockTime(x.to)}`).join(', ')})`).join(' · ')}` : prd.matched.length ? (prd.status === 'ok' && prd.planEnd > 0 && prd.planEnd < prd.to ? `Every line that matches a room is running through the planned part of the shift (to ${slotLabel(prd.planEnd)}).` : 'Every line that matches a room is running through the shift.') : 'No room name matches a line in the schedule.'}</Text>}
                    {prd && (prd.status === 'ok' || prd.status === 'partial' || prd.status === 'empty') && prd.unmatched.length > 0 && <Text size={200} block className="mt-1" style={{ color: '#8A5A00' }}>Production rooms with no run of that name within a week of this shift (the line may just be idle, or the room and the schedule spell it differently: IBL5 = area IBL line 5, WJ = Waterjet): {prd.unmatched.join(', ')}</Text>}
                    {prd && prd.query && <Text size={200} color="neutralSecondary" block className="mt-1" style={{ wordBreak: 'break-all' }}>Query sent: {prd.query}</Text>}
                    {PROD_FIELDS.slice(1).map(c => col(`${PROD_TABLE}.${c}`, prd && prd.read > 0 ? prd.hasColumns.some((k: string) => k.toLowerCase() === c) : null, c === 'craa5_area' ? 'text: the production area, e.g. IBL, Breading' : c === 'craa5_line' ? 'whole number: the line number inside that area' : c === 'craa5_product' ? 'text: the product (a Maintenance run keeps the line busy)' : 'date and time: when the run starts / ends'))}
                    <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>This crew's earlier boards (table {TASK_TABLE}, last {HIST_DAYS} days)</Text></div>
                    <Text size={200} block style={{ color: histStatus.state === 'error' || (hist && (hist.failedPieces > 0 || hist.capped > 0)) ? BRAND.red : undefined }}>
                        {!histNames.length ? 'No supervisor name to read for (no board is open).' : !slotCount ? 'Not read: the work schedule has no shifts, so boards cannot be grouped by shift.' : histStatus.state === 'idle' ? 'Not read yet (it is read a moment after a board opens).' : histStatus.state === 'reading' ? 'Reading...' : histStatus.state === 'error' ? `Could not be read: ${String(histStatus.error).slice(0, 220)}` : hist ? `${histStatus.fromCache ? `Kept on this computer since ${clockTime(hist.at)}` : `Read through ${hist.source}`}: ${hist.rows} row${hist.rows === 1 ? '' : 's'} in ${hist.pieces} piece${hist.pieces === 1 ? '' : 's'} of up to ${HIST_PIECE_DAYS} days, ${hist.boards.length} shift board${hist.boards.length === 1 ? '' : 's'} kept (the newest ${HIST_KEEP_BOARDS} are kept), ${Object.keys(hist.strength).length} names with room history.${hist.capped ? ` ${hist.capped} piece${hist.capped === 1 ? '' : 's'} hit the ${HIST_CAP} row limit, so the oldest rows of ${hist.capped === 1 ? 'it' : 'them'} are missing.` : ''}${hist.failedPieces ? ` ${hist.failedPieces} piece${hist.failedPieces === 1 ? '' : 's'} could not be read (${String(hist.error).slice(0, 120)}).` : ''}` : 'Nothing kept.'}
                    </Text>
                    {histNames.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Teams read (the supervisor name each board was saved under): {histNames.join(' · ')}</Text>}
                    {hist && hist.query && <Text size={200} color="neutralSecondary" block className="mt-1" style={{ wordBreak: 'break-all' }}>Query sent: {hist.query}</Text>}
                    {HIST_COLUMNS.map(c => col(`${TASK_TABLE}.${c}`, hist && hist.rows > 0 ? hist.columns.some((k: string) => k.toLowerCase() === c) : null, HIST_COLUMN_WHY[c] || ''))}
                    {hist && hist.boards.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Boards kept: {hist.boards.slice(0, 8).map((b: HistBoard) => `${formatFullName(b.team)} ${boardLabel(b.startMs)} (${b.people.filter(p => !!p.emp).length} people)`).join(' · ')}</Text>}
                    <Text size={200} block className="mt-1" style={{ color: remembered && !remembered.applied ? '#8A5A00' : undefined }}>{remembered ? `Remembered team: ${remembered.text}${remembered.applied ? ` ${remembered.people} ${remembered.people === 1 ? 'person' : 'people'} in ${remembered.rooms} ${remembered.rooms === 1 ? 'room' : 'rooms'}${remembered.skipped.length ? `; left out because they are away or busy: ${remembered.skipped.join(', ')}` : ''}.` : ''} (${remembered.sameTime} earlier board${remembered.sameTime === 1 ? '' : 's'} at this start time${remembered.matching >= 0 ? `, ${remembered.matching} with the same lines down` : ', lines down not compared'}.)` : 'Remembered team: not looked for on this board yet (it needs the history, the production schedule and an untouched board).'}</Text>
                    <Text size={200} block className="mt-1">Suggestions: preset {suggestMode === 'training' ? 'Training (the reverse of best fit)' : suggestMode === 'balanced' ? 'Balanced (spreads skills, no specialists)' : 'Normal (best fit)'} · {leadSuggestCount} lead suggestion{leadSuggestCount === 1 ? '' : 's'} for the rooms still without a lead · {memberSuggestCount} employee suggestion{memberSuggestCount === 1 ? '' : 's'} for the rooms short of people · {hist && hist.withLead ? `${Object.keys(hist.withLead).length} ${Object.keys(hist.withLead).length === 1 ? 'person has' : 'people have'} shifts under a lead on record` : 'no lead history read yet'}.</Text>
                    <div className="mt-1"><Button size="small" appearance="secondary" onClick={onReread}>Read history again</Button></div>
                    <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Next-shift setups (table {PRESET_TABLE})</Text></div>
                    <Text size={200} block style={{ color: presetStore.remote === 'ok' ? undefined : presetStore.remote === 'unknown' ? undefined : BRAND.red }}>
                        {presetStore.remote === 'ok' ? `The table was read: ${presets.filter((b: any) => b.where === 'dataverse').length} setup${presets.filter((b: any) => b.where === 'dataverse').length === 1 ? '' : 's'} in it.` : presetStore.remote === 'missing' ? `The table ${PRESET_TABLE} was not found, so setups are kept on this computer (${presetStore.localCount} here). Create it with the columns below and save again to share setups through Dataverse.` : presetStore.remote === 'error' ? `The table could not be read (${String(presetStore.error).slice(0, 160)}); setups are kept on this computer (${presetStore.localCount} here).` : 'Not read yet.'}
                    </Text>
                    {PRESET_COLUMNS.map(c => col(`${PRESET_TABLE}.${c.name}`, c.name === 'craa5_name' || c.name === 'craa5_boardjson' ? (presetStore.remote === 'ok' && presetLog && presetLog.where === 'dataverse' ? colState(c.name) : null) : colState(c.name), `${c.type} · ${c.optional ? 'optional' : 'needed'} · ${c.why}`))}
                    {presets.length > 0 && <Text size={200} color="neutralSecondary" block className="mt-1">Setups held: {presets.map((b: any) => `${b.crew} ${slotLabel(b.slotStart)} by ${b.supervisor || '?'} (${b.where === 'device' ? 'this computer' : 'Dataverse'})`).join(' · ')}</Text>}
                    {presetLog && <div className="mt-2 p-2 rounded-lg border border-slate-200" style={{ background: BRAND.blueSoft }}><Text size={200} weight="semibold" block>Last setup save · {clockTime(new Date(presetLog.at).getTime())} · {presetLog.where === 'dataverse' ? 'sent to Dataverse' : 'kept on this computer'} · {presetLog.rows} board row{presetLog.rows === 1 ? '' : 's'}</Text>
                        <Text size={200} block style={{ color: presetLog.error ? BRAND.red : undefined, wordBreak: 'break-all' }}>{presetLog.error ? `Why: ${String(presetLog.error).slice(0, 220)}. ` : ''}{presetLog.refused && presetLog.refused.length ? `Refused: ${presetLog.refused.join(', ')}. ` : ''}Sent: {Object.keys(presetLog.sent || {}).map(k => k === 'craa5_boardjson' ? `${k} (${String(presetLog.sent[k]).length} characters)` : `${k} = ${String(presetLog.sent[k]).slice(0, 60)}`).join(' · ')}</Text></div>}
                    {employees.length > 0 && <div className="mt-3"><Text size={200} weight="bold" block className="mb-1">Who is on crew {currentShift || boardCrew || '?'} and how they were placed</Text>
                        <Text size={200} color="neutralSecondary" block>{employees.filter((e: any) => crewOfPerson(e) === (currentShift || boardCrew)).map((e: any) => `${formatFullName(getField(e, 'craa5_name'))} (${roleOf(e)}, ${sourceOf(e)})`).join(' · ') || 'nobody'}</Text></div>}
                </div>
            </div>
        </div>
    );
}

