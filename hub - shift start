// The crew's shift (slot) a moment belongs to: the one it falls inside (the prep hour before it counts).
function slotInstanceFor(slots: Slot[], crew: string, t: number): { startMs: number; endMs: number } | null {
    let bestStart = 0, bestEnd = 0;
    for (let i = 0; i < slots.length; i++) {
        const s = slots[i]; if (crew && crewLetterOf(s.crew) !== crew) continue;
        for (let back = -1; back <= 1; back++) {
            const d = new Date(t); d.setDate(d.getDate() + back);
            if (d.getDay() !== s.day) continue;
            const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
            const st = start.getTime(), en = slotEndMs(start, s.lengthHours);
            if (t >= st - SHIFT_PREP_MS && t < en && (!bestStart || st < bestStart)) { bestStart = st; bestEnd = en; }
        }
    }
    return bestStart ? { startMs: bestStart, endMs: bestEnd } : null;
}

// Resolves a shift start bucket timestamp for any task/archive row even when work schedule slots or crew letters do not strictly match.
function shiftBucketMs(t: number, slots: Slot[], crew: string, rowSlotStart?: number): number {
    if (rowSlotStart && rowSlotStart > 0) return rowSlotStart;
    if (!t || isNaN(t)) return 0;
    if (slots && slots.length) {
        if (crew) {
            const byCrew = slotInstanceFor(slots, crew, t);
            if (byCrew) return byCrew.startMs;
        }
        const anyInst = findCurrentShift(slots, new Date(t)) || findCurrentShift(slots, new Date(t + SHIFT_PREP_MS));
        if (anyInst && anyInst.startMs) return anyInst.startMs;
        const anySlot = slotInstanceFor(slots, "", t);
        if (anySlot) return anySlot.startMs;
    }
    const d = new Date(t);
    const h = d.getHours();
    if (h >= 6 && h < 18) {
        d.setHours(6, 0, 0, 0);
        return d.getTime();
    } else if (h < 6) {
        d.setDate(d.getDate() - 1);
        d.setHours(18, 0, 0, 0);
        return d.getTime();
    } else {
        d.setHours(18, 0, 0, 0);
        return d.getTime();
    }
}

// The summary kept from rows: its final board of each shift, and how many shifts each person (employee or lead) worked each room.
function aggregateHistory(rows: any[], slots: Slot[], crew: string): { boards: HistBoard[]; strength: Record<string, Record<string, number>> } {
