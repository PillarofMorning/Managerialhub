function withActingManagers(sups: any[], user: any, everyone: any[], rows: any[]): any[] {
    const out = filterActiveEmployees(sups), have: Record<string, boolean> = {};
    out.forEach(x => { have[String(getField(x, 'craa5__aa_employeeid'))] = true; });
    const add = (e: any) => { if (!e || isEmployeeDeactivated(e)) return; const id = String(getField(e, 'craa5__aa_employeeid') || ""); if (id && !have[id]) { have[id] = true; out.push(e); } };
