// Creates or updates a row; any column the table refuses (including craa5_title / craa5_name if the table's primary column has another logical name) is left out and remembered.
async function tableWrite(props: any, table: string, id: string, data: any): Promise<{ ok: boolean; id: string; error: string; refused: string[] }> {
