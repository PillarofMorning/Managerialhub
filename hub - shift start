function fallbackCopy(text: string): boolean {
    try {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.cssText = "top:0;left:0;position:fixed;opacity:0;pointer-events:none;z-index:-1;";
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, text.length);
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return !!ok;
    } catch (err) {
        logError('Fallback copy failed', err);
        return false;
    }
}
function copyTextToClipboard(text: string): boolean {
    const syncOk = fallbackCopy(text);
    if (typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        navigator.clipboard.writeText(text).catch(() => { if (!syncOk) fallbackCopy(text); });
    }
    return true;
}
