                                                {(sel.attendance || []).length > 0 && <div style={{ marginTop: 10, fontSize: 11, color: '#475569' }}><b>Attendance:</b> {(sel.attendance || []).map(g => `${g.status}: ${g.people.map(p => p.name).join(', ')}`).join(' - ')}</div>}
