function chatCompact(s: string): string { return String(s == null ? '' : s).toLowerCase().replace(/[^a-z0-9]+/g, ''); }
function chatEdit(a: string, b: string, max: number): number {   // edit distance, stopping early once it passes max
    if (Math.abs(a.length - b.length) > max) return max + 1;
    let prev: number[] = [], cur: number[] = [], i: number, j: number;
    for (j = 0; j <= b.length; j++) prev.push(j);
    for (i = 1; i <= a.length; i++) {
        cur = [i]; let lo = i;
        for (j = 1; j <= b.length; j++) { const v = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1)); cur.push(v); if (v < lo) lo = v; }
        if (lo > max) return max + 1;
        prev = cur;
    }
    return prev[b.length];
}
function chatWords(s: string): { w: string; at: number; end: number }[] {
    const out: { w: string; at: number; end: number }[] = [], re = /[a-z0-9]+(?:'[a-z]+)?/gi; let m: RegExpExecArray | null;
    while ((m = re.exec(s)) !== null) out.push({ w: m[0].toLowerCase(), at: m.index, end: m.index + m[0].length });
    return out;
}
// "Last, First" -> "First Last" for what the supervisor reads.
function chatFull(n: string): string { const p = String(n || '').split(','); return p.length > 1 ? (p.slice(1).join(',').trim() + ' ' + p[0].trim()).trim() : String(n || '').trim(); }
// Emoji, [2h 10m] timers, (3) head counts and curly quotes out of what was typed or pasted.
function chatTypo(s: string): string { CHAT_TYPOS.forEach(t => { s = s.replace(t[0], t[1]); }); return s; }
function chatClean(s: string): string { return String(s == null ? '' : s).replace(/[\u2018\u2019]/g, "'").replace(/[\u2705\u2714\u2611]\uFE0F?/g, ' done ').replace(CHAT_EMOJI_RE, ' ').replace(/\[[^\]]*\]/g, ' ').replace(/\(\s*\d+\s*\)/g, ' '); }

type ChatRoomIdx = { keys: Record<string, string[]>; fam: Record<string, string[]>; alpha: { key: string; ids: string[] }[] };
function chatRoomIndex(rooms: ChatRoom[]): ChatRoomIdx {
    const keys: Record<string, string[]> = {}, fam: Record<string, string[]> = {}, prefixes: Record<string, string[]> = {};
    const add = (k: string, id: string, into: Record<string, string[]>) => { if (!k) return; const l = into[k] = into[k] || []; if (l.indexOf(id) < 0) l.push(id); };
    rooms.forEach(r => {
        const toks = chatWords(r.name).map(t => t.w), main = toks.filter(t => !CHAT_FILL_ROOM[t]).join(''), all = chatCompact(r.name);
        const mine: string[] = [all, main];
        const first = toks.filter(t => !CHAT_FILL_ROOM[t])[0] || '';
        CHAT_ROOM_ALIASES.forEach(g => { if (g.indexOf(all) >= 0 || g.indexOf(main) >= 0 || g.indexOf(first) >= 0) g.forEach(a => { mine.push(a); }); });
        mine.forEach(k => add(k, r.id, keys));
        const m = /^([a-z]+)(\d+)$/.exec(main); if (m) add(m[1], r.id, fam);
        if (/^[a-z]{6,}$/.test(main)) { add(main.slice(0, 4), r.id, prefixes); add(main.slice(0, 5), r.id, prefixes); }
        if (/^[a-z]{6,}$/.test(first)) { add(first.slice(0, 4), r.id, prefixes); }
    });
    Object.keys(prefixes).forEach(k => { if (prefixes[k].length === 1 && !keys[k]) keys[k] = prefixes[k]; });
    const famKeys = Object.keys(fam);
    if (famKeys.length === 1) rooms.forEach(r => { const m = /^[a-z]+(\d+)$/.exec(toksMain(r.name)); if (m && fam[famKeys[0]].indexOf(r.id) >= 0) add('line' + m[1], r.id, keys); });   // "line 5" when IBL is the only numbered family
    const alpha: { key: string; ids: string[] }[] = Object.keys(keys).filter(k => /^[a-z]{5,}$/.test(k)).map(k => ({ key: k, ids: keys[k] }));
    return { keys, fam, alpha };
}
function toksMain(name: string): string { return chatWords(name).map(t => t.w).filter(t => !CHAT_FILL_ROOM[t]).join(''); }
// The rooms a line mentions, left to right (token runs of one to three words; "ibl 4", "ibl-4", "ibl line 4", "IBL4" are one room; a one-letter slip is read as the room).
