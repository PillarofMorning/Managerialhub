                        const bgCloseList = Object.values(bgOpenMap);
                        for (let i = 0; i < bgCloseList.length; i += 6) {
                            const batch = bgCloseList.slice(i, i + 6);
                            await Promise.all(batch.map((t: any) => {
                                const priorPct = Number(getField(t, 'craa5_percentagecomplete') ?? getField(t, 'craa5_completionpct') ?? getField(t, 'percentage') ?? 0) || 0;
                                const priorStat = String(getField(t, 'craa5_whatisbeingdone') || getField(t, 'craa5__currentstatus') || 'Superseded');
                                return wApi.update(TASK_TABLE, t.craa5_taskassignmentid, { craa5_complete: true, craa5_endtime: nowIso, craa5_percentagecomplete: priorPct, craa5_whatisbeingdone: priorStat }).catch(() => {});
                            }));
                        }
                        for (let i = 0; i < freshPayloads.length; i += 6) {
                            const batch = freshPayloads.slice(i, i + 6);
                            await Promise.all(batch.map((p: any) => wApi.create(TASK_TABLE, toTaskEntity(p)).catch(() => {})));
                        }
                    } catch (e) {}
                }, 120);
            }
        } else {
            savedBoard = { ...w.board, modifiedOn: nowIso };
            if (wApi) {
                for (let i = 0; i < taskPayloads.length; i += 6) {
                    const batch = taskPayloads.slice(i, i + 6);
                    await Promise.all(batch.map((p: any) => {
                        const ent = toTaskEntity(p);
                        if (p.taskId) return wApi.update(TASK_TABLE, p.taskId, { craa5_complete: true, craa5_endtime: nowIso, craa5_percentagecomplete: ent.craa5_percentagecomplete, craa5_whatisbeingdone: ent.craa5_whatisbeingdone }).catch(() => {});
