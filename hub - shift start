            const [earlier, ownRows] = await Promise.all([readSavedAssignments(propsRef.current), supNameRaw ? readSavedAssignments(propsRef.current, supNameRaw) : Promise.resolve(null)]);
            const readStatus = earlier.status.ok || !ownRows ? earlier.status : ownRows.status;
            const seenIds: Record<string, boolean> = {}, fetchedTasks: any[] = [];
            earlier.recent.concat(ownRows ? ownRows.recent : []).forEach((r: any) => {
