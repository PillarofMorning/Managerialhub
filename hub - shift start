        }
        let board: ShiftBoard = {
            v: 1, kind: 'live', crew: boardShift, team: supNameRaw, supervisorEmail: supEmail, slotStart: base ? base.slotStart : slot.start, slotEnd: base ? boardEndOf(base) : slot.end,
            status: 'live', savedAt: nowIso, savedBy: me, saveCount: (base?.saveCount || 0) + 1,
            rows: freshPayloads.map(taskRowFields),
            supervisor: { name: supNameRaw, email: supEmail, id: String(selectedSupervisorId || '') },
            attendance: Object.keys(areaAssignments).filter(id => isStatusArea(renderSafe(getField(areaMap.get(id), 'craa5_area')))).map(id => ({
                status: renderSafe(getField(areaMap.get(id), 'craa5_area')),
                people: (assignments[id] || []).map(eid => ({ name: renderSafe(getField(employeeMap.get(eid), 'craa5_name')), guid: String(eid) })),
            })).filter(g => g.people.length > 0),
            state: { areaAssignments, assignments, areaDetails, subcatProgress: updatedSubcatProgress, sanitationProgress, employeeStartTimes, cleanTypesByArea, areaCompletions: buildAreaCompletionsPayload() },
            recordId: base?.recordId, reopened: !!base?.reopened, archiveId: base?.archiveId, sourceRowIds: base?.sourceRowIds, imported: base?.imported, log: base?.log, claim: null,
        };
        const changes = diffBoardRows(base ? (base.rows || []) : [], board.rows);
        board = boardLog(board, me, `saved: ${changes.length} change${changes.length === 1 ? '' : 's'}`);
        const w = await writeBoard(propsRef.current, board, reactivate);
        const wApi = getWriteApi(propsRef.current);
        const toTaskEntity = (p: any) => ({
            craa5_area: String(p.craa5_area || p.area || ''),
            craa5_lead: String(p.craa5_lead || p.lead || ''),
            craa5_shift: String(p.craa5_shift || p.shift || ''),
            craa5_team: String(p.craa5_team || p.team || ''),
            craa5_id: String(p.craa5_id || p.empName || ''),
            craa5__aaemp_guid: String(p.craa5__aaemp_guid || p.empGuid || ''),
            craa5_starttime: p.craa5_starttime || p.startTime || nowIso,
