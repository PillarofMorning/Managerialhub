    let SC;
    if (!currentUser) SC = (
        <div className="flex items-center justify-center min-h-full p-5">
            <div className="bg-white shadow-lg border border-slate-200 rounded-2xl w-full max-w-[400px] overflow-hidden">
                <div className="bg-white border-b-4 border-[#FFB81C] p-5 flex flex-col items-center gap-2"><BrandLogo /><h2 className="text-lg font-black uppercase tracking-widest" style={{ color: BRAND.blueDark }}>Supervisor Hub</h2></div>
                <AuthBox users={allEmployees} onLogin={(u: any) => hydrateState({ ...GLOBAL_DATA_CACHE, resolvedUser: { ...u, calculatedRole: roleOf(u) } })} />
            </div>
        </div>
    );
    else if (!selectedSupervisorId) SC = <SupervisorSelectionScreen supervisors={supervisors} selectedSupervisorId={selectedSupervisorId} onSelect={switchBoard} />;
    else if (currentStep === 0) SC = <LeadSelectionScreen leads={[...leads, ...customLeads]} selectedLeadIds={selectedLeadIds} onSelectChange={setSelectedLeadIds} onSearchCustom={handleSearchCustomLead} />;
    else if (currentStep === 1) SC = <AreaSelectionScreen areas={[...areas, ...customAreas]} selectedAreaIds={selectedAreaIds} onSelectChange={setSelectedAreaIds} onAddCustomArea={(n: string) => setCustomAreas(p => [...p, { craa5_aa_mss_areaid: `c_${Date.now()}`, craa5_area: n, craa5_production: true }])} />;
    else if (currentStep === 2 || currentStep === 3) SC = (
        <div className="flex flex-col h-full p-5 overflow-x-auto box-border">
            <div className="flex gap-6 flex-1 items-stretch min-h-0">
                <div className="w-[280px] shrink-0 bg-white rounded-xl border border-slate-200 p-4 flex flex-col h-full max-h-[calc(100vh-250px)] shadow-sm">
                    <div className="shrink-0 flex flex-col gap-3 mb-3">
                        <Text weight="bold" className="uppercase tracking-wider" style={{ color: BRAND.blueDark }}>{currentStep === 2 ? "Select Areas" : "Available Staff"}</Text>
                        {currentStep > 2 && (
                            <div className="relative">
                                <div className="flex gap-2">
                                    <Input size="small" placeholder="Search OT staff..." value={empSearchText} onChange={(e: any, d: any) => setEmpSearchText(getInputValue(e, d))} className="flex-1" onKeyDown={(e) => { if (e.key === 'Enter') { if (searchSuggestions.length > 0) handleAddSuggestedEmployee(searchSuggestions[0]); else handleSearchCustomEmployee(empSearchText); } }} />
                                    <Button size="small" appearance="primary" onClick={() => handleSearchCustomEmployee(empSearchText)}>Add</Button>
                                </div>
                                {searchSuggestions.length > 0 && (
                                    <div className="absolute top-full left-0 right-0 bg-white border border-slate-300 rounded-lg z-50 max-h-[150px] overflow-y-auto shadow-md mt-1">
                                        {searchSuggestions.map(s => <div key={getField(s, 'craa5__aa_employeeid')} onClick={() => handleAddSuggestedEmployee(s)} className="p-2 cursor-pointer border-b border-slate-100 hover:bg-[#E6F1FB] flex justify-between items-center"><Text>{formatFullName(getField(s, 'craa5_name'))}</Text>{getShiftOf(s) && <Badge size="small" appearance="outline" color="brand">Shift {getShiftOf(s)}</Badge>}</div>)}
                                    </div>
                                )}
                            </div>
                        )}
                        <Divider />
                    </div>
                    <div className="flex-1 overflow-y-auto pr-1">
                        {currentStep === 2
                            ? [...areas, ...customAreas].filter(a => selectedAreaIds.has(getField(a, 'craa5_aa_mss_areaid')) && !areaAssignments[getField(a, 'craa5_aa_mss_areaid')]).map(a => (
                                <div key={getField(a, 'craa5_aa_mss_areaid')} draggable={true} onDragStart={e => { GLOBAL_DRAG_PAYLOAD = getField(a, 'craa5_aa_mss_areaid'); if (e.dataTransfer) e.dataTransfer.setData("areaId", getField(a, 'craa5_aa_mss_areaid')); }} className={`p-3 rounded-lg mb-2 cursor-grab text-sm font-semibold border ${isProductionArea(a) ? 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800' : 'bg-slate-50 border-slate-200 text-slate-700'}`}>{renderSafe(getField(a, 'craa5_area'))} {getAreaEmoji(a)}</div>
                            ))
                            : availableStaff.map(e => (
                                <div key={getField(e, 'craa5__aa_employeeid')} draggable={true} onDragStart={ev => { ev.dataTransfer.setData("empId", getField(e, 'craa5__aa_employeeid')); ev.stopPropagation(); }} className="p-3 bg-white border border-slate-200 rounded-lg mb-2 cursor-grab shadow-sm hover:border-[#0072CE]">
                                    <Text size={200} weight="semibold" block>{formatFullName(getField(e, 'craa5_name'))}</Text>
                                    {getField(e, 'craa5_email') && <Badge size="small" appearance="outline" color="brand">AAD Linked</Badge>}
                                    <div className="flex flex-wrap gap-1 mt-2">{["PTO", "Sick", "Late", "Left Early"].map(s => <Button key={s} size="small" appearance="subtle" className="px-1 text-[9px] h-5" onClick={() => handleSetEmployeeStatus(getField(e, 'craa5__aa_employeeid'), s)}>{s}</Button>)}</div>
                                </div>
                            ))}
                    </div>
                </div>
                <div className="flex gap-5 flex-1 h-full items-stretch overflow-x-auto pb-2">
                    {activeBuckets.map(lead => {
                        const leadId = getField(lead, 'craa5__aa_employeeid');
                        return (
                            <BucketColumn key={leadId} lead={lead} isSupervisor={roleOf(lead) === 'supervisor'} isCollapsed={collapsedBuckets.has(leadId)} onToggle={() => toggleBucket(leadId)} onRemoveLead={() => handleRemoveLead(leadId)}
                                onDrop={(e: any) => { const aid = e.dataTransfer?.getData("areaId") || GLOBAL_DRAG_PAYLOAD; if (aid) setAreaAssignments(p => ({ ...p, [aid]: leadId })); GLOBAL_DRAG_PAYLOAD = null; }}
                                onSetStatus={(s: string) => handleSetEmployeeStatus(leadId, s)}>
                                {Object.keys(areaAssignments).filter(aid => areaAssignments[aid] === leadId).map(aid => {
                                    const a = areaMap.get(aid);
                                    return (
                                        <div key={aid} draggable={true} onDragStart={ev => { GLOBAL_DRAG_PAYLOAD = aid; if (ev.dataTransfer) ev.dataTransfer.setData("areaId", aid); }} className={`p-2 bg-white rounded-lg border border-slate-200 border-l-4 relative shadow-sm cursor-grab flex flex-col ${isProductionArea(a) ? 'border-l-[#FFB81C]' : 'border-l-[#0072CE]'}`}>
                                            <div className="flex justify-between mb-2"><Text weight="bold" size={200}>{renderSafe(getField(a, 'craa5_area'))}{getAreaEmoji(a)}</Text><Button appearance="subtle" size="small" className="min-w-0 px-1" onClick={() => setAreaAssignments(p => { const n = { ...p }; delete n[aid]; return n; })}>✖</Button></div>
                                            <div onDragOver={e => e.preventDefault()} onDrop={e => { const eid = e.dataTransfer.getData("empId"); if (!eid) return; e.stopPropagation(); setAssignments(p => { const x = { ...p }; Object.keys(x).forEach(k => x[k] = x[k].filter(i => i !== eid)); if (!x[aid]) x[aid] = []; if (!x[aid].includes(eid)) x[aid] = [...x[aid], eid]; return x; }); setEmployeeStartTimes(s => ({ ...s, [eid]: new Date().toISOString() })); }} className="min-h-[40px] bg-slate-50 border border-dashed border-slate-300 rounded p-1 w-full">
                                                {(assignments[aid] || []).map(eid => (
                                                    <div key={eid} draggable={true} onDragStart={ev => { ev.dataTransfer.setData("empId", eid); ev.stopPropagation(); }} className="text-xs bg-white px-2 py-1 rounded mt-1 cursor-grab border border-slate-300 flex justify-between items-center shadow-sm">
                                                        <div className="flex items-center gap-1 overflow-hidden"><Text truncate>{formatFullName(getField(employeeMap.get(eid), 'craa5_name'))}</Text><Badge color="brand" appearance="tint" size="small" className="text-[10px]">{formatDuration(employeeStartTimes[eid])}</Badge></div>
                                                        <Button appearance="transparent" size="small" className="min-w-0 px-1" style={{ color: BRAND.red }} onClick={(e) => { e.stopPropagation(); setAssignments(p => ({ ...p, [aid]: p[aid].filter(i => i !== eid) })); }}>✖</Button>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    );
                                })}
                            </BucketColumn>
                        );
                    })}
                </div>
            </div>
        </div>
    );
    else {
        const statusIds = Object.keys(areaAssignments).filter(id => isStatusArea(getField(areaMap.get(id), 'craa5_area')));
        SC = (
            <div className="flex flex-col h-full p-5 overflow-y-auto flex-1 box-border">
                {saveSuccess && <div className="bg-green-50 text-green-800 p-3 rounded-lg mb-4 border border-green-200 font-semibold">✅ Success! Assignments saved.</div>}
                {saveWarning && <div className="p-3 rounded-lg mb-4 border font-semibold" style={{ background: BRAND.yellowSoft, color: '#8A5A00', borderColor: BRAND.yellow }}>⚠️ {saveWarning}</div>}
                {submissionError && <div className="p-3 rounded-lg mb-4 border font-semibold" style={{ background: BRAND.redSoft, color: BRAND.red, borderColor: BRAND.red }}>❌ Submission Failed: {submissionError}</div>}
                <ScreenTitle>Update Teams</ScreenTitle>
                {Object.keys(areaAssignments).length === 0 ? <Text className="mt-4">No areas assigned.</Text> : (
                    <div className="flex flex-col gap-8 mt-5">
                        {statusIds.length > 0 && (
                            <div>
                                <h3 className="text-sm font-black uppercase tracking-widest mb-4 pb-1 border-b-2" style={{ color: BRAND.red, borderColor: BRAND.red }}>Time & Attendance</h3>
                                <div className="grid grid-cols-1 gap-4">{statusIds.map(aid => {
                                    const inc = areaDetails[aid]?.includeInUpdate ?? false;
                                    return (
                                        <div key={aid} className="bg-white p-3 rounded-xl border border-slate-200 flex justify-between items-center shadow-sm">
                                            <div className="flex items-center gap-2"><Checkbox checked={inc} onChange={(e, d) => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], includeInUpdate: !!d.checked } }))} /><Text weight="bold" size={400} className="cursor-pointer" onClick={() => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], includeInUpdate: !inc } }))}>Add to Update - {renderSafe(getField(areaMap.get(aid), 'craa5_area'))}</Text></div>
                                            <Text>{(assignments[aid] || []).map(eid => formatFullName(getField(employeeMap.get(eid), 'craa5_name'))).join(", ")}</Text>
                                        </div>
                                    );
                                })}</div>
                            </div>
                        )}
                        {['Production Areas', 'Everyday Tasks'].map((group, gIdx) => {
                            const rA = Object.keys(areaAssignments).filter(id => { const a = areaMap.get(id); return !isStatusArea(getField(a, 'craa5_area')) && (gIdx === 0 ? !isEverydayArea(a) : isEverydayArea(a)); });
                            if (rA.length === 0) return null;
                            const accent = gIdx === 0 ? BRAND.blue : '#B27B00';
                            return (
                                <div key={group}>
                                    <h3 className="text-sm font-black uppercase tracking-widest mb-4 pb-1 border-b-2" style={{ color: accent, borderColor: gIdx === 0 ? BRAND.blue : BRAND.yellow }}>{group}</h3>
                                    <div className="grid grid-cols-1 gap-4">{rA.map(aid => {
                                        const a = areaMap.get(aid), ld = employeeMap.get(areaAssignments[aid]) || activeSupervisorObj, d = areaDetails[aid] || {} as any;
                                        const inc = d.includeInUpdate ?? isProductionArea(a);
                                        return (
                                            <div key={aid} className="bg-white p-5 rounded-xl border border-slate-200 border-l-4 shadow-sm" style={{ borderLeftColor: gIdx === 0 ? BRAND.blue : BRAND.yellow }}>
                                                <div className="flex justify-between items-center mb-2">
                                                    <div className="flex items-center gap-2"><Checkbox checked={inc} onChange={(e, cb) => toggleIncludeInUpdate(aid, !!cb.checked)} /><Text weight="bold" size={400} className="cursor-pointer" onClick={() => toggleIncludeInUpdate(aid, !inc)}>Add to Update - {renderSafe(getField(a, 'craa5_area'))}{getAreaEmoji(a)}</Text></div>
                                                    <Badge appearance="filled" color="brand">Headcount: {assignments[aid]?.length || 0}</Badge>
                                                </div>
                                                <Text size={200} color="neutralSecondary" block className="mb-4">Lead: {formatFullName(getField(ld, 'craa5_name'))}</Text>
                                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                    <div className="flex flex-col gap-1"><Text size={200} weight="semibold">Completed and in process</Text><Input placeholder="Enter completed and in process..." value={d.currentStatus || ""} onChange={(e: any, dObj: any) => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], currentStatus: getInputValue(e, dObj) } }))} /></div>
                                                    <div className="flex flex-col gap-1"><Text size={200} weight="semibold">What is left to do</Text><Input placeholder="Enter what is left to do..." value={d.futureNotes || ""} onChange={(e: any, dObj: any) => setAreaDetails(p => ({ ...p, [aid]: { ...p[aid], futureNotes: getInputValue(e, dObj) } }))} /></div>
                                                </div>
                                            </div>
                                        );
                                    })}</div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
        );
    }

    return (
        <FluentProvider theme={cjTheme} style={{ background: 'transparent' }}>
            <div style={{ width: "100%", height: `${appHeight}px`, display: "flex", flexDirection: "column", background: "#F7F9FC", overflow: "hidden", position: 'relative', fontFamily: BRAND_FONT }}>
                {isLoading && (
                    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 20, background: '#F7F9FC', zIndex: 9999 }}>
                        <BrandLogo />
                        <Spinner size="large" label={busyLabel} />
                    </div>
                )}

                <header className="bg-white border-b-4 border-[#FFB81C] shrink-0 z-20">
                    <div className="px-5 h-[64px] flex items-center justify-between gap-4">
                        <div className="min-w-0">
                            <h1 className="text-lg font-black leading-tight tracking-tight truncate" style={{ color: BRAND.blueDark }}>Shift Assignment</h1>
                            <p className="text-[11px] font-bold text-slate-500 truncate" title={headerNote ? headerNote.text : undefined}>Shift {currentShift || '?'}{activeSupervisorObj ? ` · ${formatFullName(getField(activeSupervisorObj, 'craa5_name'))}` : ''}{headerNote && <span style={{ color: headerNote.tone === 'error' ? BRAND.red : headerNote.tone === 'ok' ? BRAND.blue : undefined }}>{` · ${headerNote.text}`}</span>}</p>
                        </div>
                        <div className="flex items-center gap-3">
                            {adminMode && (
                                <div className="flex items-center gap-1.5 px-2 py-1 rounded-lg border" style={{ background: BRAND.redSoft, borderColor: '#F6B3C0' }}>
                                    <Text size={200} weight="semibold" style={{ color: BRAND.red }}>View As:</Text>
                                    <select value={selectedSupervisorId || ""} onChange={(e) => switchBoard(e.target.value)} className="px-1 py-0.5 rounded border border-[#F6B3C0] text-xs outline-none bg-white"><option value="" disabled>-- Select Supervisor --</option>{supervisors.map(s => <option key={getField(s, 'craa5__aa_employeeid')} value={getField(s, 'craa5__aa_employeeid')}>{formatFullName(getField(s, 'craa5_name'))}</option>)}</select>
                                </div>
                            )}
                            <div className={`flex items-center gap-1 px-2 py-0.5 rounded-lg border ${adminMode ? 'bg-[#E6F1FB] border-[#B3D4F2]' : 'border-transparent'}`}>
                                <Checkbox checked={adminMode} onChange={(e, d) => setAdminMode(!!d.checked)} /><Text size={200} weight={adminMode ? "semibold" : "regular"} style={{ color: adminMode ? BRAND.blueDark : 'inherit', cursor: 'pointer' }} onClick={() => setAdminMode(!adminMode)}>Acting Sup.</Text>
                            </div>
                            <Text size={200} weight="semibold" className="hidden md:block">{selectedSupervisorId && getField(currentUser, 'craa5__aa_employeeid') !== selectedSupervisorId ? `🕵️ ${formatFullName(getField(activeSupervisorObj, 'craa5_name'))}` : `👤 ${msUser ? msUser.name : "Signing in..."}`}</Text>
                            <Badge appearance="filled" color="brand">Shift {currentShift || '?'}</Badge>
                            <div className="hidden sm:block pl-3 border-l border-slate-200"><BrandLogo /></div>
                        </div>
                    </div>
                </header>

                {selectedSupervisorId && currentUser && (
                    <nav className="bg-white border-b border-slate-200 shrink-0 z-10">
                        <div className="px-4 py-2 flex flex-wrap items-center justify-between gap-2">
                            <div className="flex gap-1.5 overflow-x-auto">
                                {steps.map((l, i) => (
                                    <button key={l} onClick={() => setCurrentStep(i)} className={`px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.08em] rounded-xl whitespace-nowrap transition-colors ${currentStep === i ? 'bg-[#0072CE] text-white shadow-[0_6px_14px_rgba(0,114,206,0.25)]' : 'text-slate-500 hover:bg-[#E6F1FB] hover:text-[#0072CE]'}`}>
                                        <span className="opacity-60 mr-1">{i + 1}</span>{l}
                                    </button>
                                ))}
                            </div>
                            {currentStep === 4 && (
                                <div className="flex items-center gap-2 bg-[#F7F9FC] border border-slate-200 px-2 py-1 rounded-xl">
                                    <select value={clipboardFormat} onChange={(e) => setClipboardFormat(e.target.value as any)} className="px-2 py-1 rounded-lg border border-slate-300 text-xs font-semibold outline-none bg-white"><option value="headcount">Headcount</option><option value="initials">Initials</option><option value="fullname">Full Name</option></select>
                                    <Button appearance="secondary" size="small" onClick={handleCopyToClipboard}>Copy</Button>
                                    <Button appearance="primary" size="small" onClick={handleSubmission}>Save Progress</Button>
                                </div>
                            )}
                        </div>
                        <ProgressBar value={(currentStep + 1) / steps.length} color={currentStep === steps.length - 1 ? "success" : "brand"} />
                    </nav>
                )}

                <main style={{ flex: 1, overflow: "hidden", display: "flex", flexDirection: "column", position: 'relative' }}>{SC}</main>
            </div>
        </FluentProvider>
    );
}

const App = (props: any) => <MainComponent {...props} />;
export default App;
