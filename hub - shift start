        for (let j = 0; j <= n; j++) { minv.push(INF); used.push(false); }
        do {
            used[j0] = true; const i0 = p[j0]; let delta = INF, j1 = 0;
            for (let j = 1; j <= n; j++) {
                if (used[j]) continue;
                const cur = cost[i0 - 1][j - 1] - u[i0] - v[j];
                if (cur < minv[j]) { minv[j] = cur; way[j] = j0; }
                if (minv[j] < delta) { delta = minv[j]; j1 = j; }
            }
            for (let j = 0; j <= n; j++) { if (used[j]) { u[p[j]] += delta; v[j] -= delta; } else minv[j] -= delta; }
            j0 = j1;
        } while (p[j0] !== 0);
        do { const j1 = way[j0]; p[j0] = p[j1]; j0 = j1; } while (j0);
    }
    for (let j = 1; j <= n; j++) res[p[j] - 1] = j - 1;
    return res;
}
// Who could fill the rooms that are short of their usual headcount. Every empty place is matched to a person, each person used once, so the most places are
// filled and, among those, the total is the best possible: Normal = the people who have worked under the room's lead most (then in the room most), only people
// with some time under the lead or in the room; Training = the reverse, everyone is a candidate and the people with the least time under that lead and in that
// room come first.
type Suggest = { id: string; name: string; days: number; withLead: number };
function suggestMembers(h: History | null, rooms: { id: string; name: string; have: number; lead: string }[], staff: { id: string; name: string }[], atMin: number, mode: SuggestMode = 'normal'): Record<string, Suggest[]> {
    const out: Record<string, Suggest[]> = {};
    if (!h || !rooms.length || !staff.length) return out;
    const once: Record<string, boolean> = {}; staff = staff.filter(s => { if (once[s.id]) return false; once[s.id] = true; return true; }).sort((a, b) => (normText(a.name) < normText(b.name) ? -1 : normText(a.name) > normText(b.name) ? 1 : 0) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
    const sign = mode === 'training' ? -1 : 1, slots: number[] = [], pair: { days: number; withLead: number }[][] = [];   // slots: the room of each empty place
    rooms.forEach((r, ri) => {
        const usual = typicalHeadcount(h, r.name, atMin) || typicalHeadcount(h, r.name), n = usual - r.have;
        for (let k = 0; k < n; k++) slots.push(ri);
        pair[ri] = staff.map(s => ({ days: shiftsInArea(h, s.id, s.name, r.name), withLead: shiftsUnderLead(h, s.id, s.name, r.lead) }));
    });
    if (!slots.length) return out;
    const eligible = (ri: number, si: number) => mode === 'training' || pair[ri][si].days > 0 || pair[ri][si].withLead > 0;
    const people = staff.map((_, si) => si).filter(si => rooms.some((_r, ri) => slots.indexOf(ri) >= 0 && eligible(ri, si)));
    if (!people.length) return out;
    const N = people.length + slots.length, BONUS = 1e7, FORBIDDEN = 1e10, cost: number[][] = [];
    for (let i = 0; i < N; i++) {
        const row: number[] = [];
        for (let j = 0; j < N; j++) {
            if (i < people.length && j < slots.length) { const ri = slots[j], si = people[i]; row.push(eligible(ri, si) ? -(BONUS + sign * (pair[ri][si].withLead * 1000 + pair[ri][si].days)) : FORBIDDEN); }
            else row.push(0);   // a person with no place, a place with nobody
        }
        cost.push(row);
    }
    const col = minCostMatch(cost);
    people.forEach((si, i) => {
        const j = col[i]; if (j >= slots.length) return;
        const ri = slots[j], id = rooms[ri].id, list = out[id] = out[id] || [];
        list.push({ id: staff[si].id, name: staff[si].name, days: pair[ri][si].days, withLead: pair[ri][si].withLead });
    });
    Object.keys(out).forEach(k => out[k].sort((a, b) => sign * (b.withLead - a.withLead) || sign * (b.days - a.days) || (normText(a.name) < normText(b.name) ? -1 : normText(a.name) > normText(b.name) ? 1 : 0)));
    return out;
}

// The boards this shift could start from: the earlier boards of the same crew at the same start time of day, and of those the ones whose rooms match today's.
// matched = the rooms (normalised names) that have a line in the production schedule, down = the ones with a line down. Boards are compared only on matched
// rooms, so Everyday and support rooms don't matter. With the schedule unknown the newest board of that start time is used and the answer says so.
type RememberCtx = { known: boolean; matched: string[]; down: string[]; supName: string };
function rememberedCandidates(h: History | null, slotStartMs: number, ctx: RememberCtx): { sameTime: HistBoard[]; pool: HistBoard[]; useful: boolean } {
    if (!h || !slotStartMs) return { sameTime: [], pool: [], useful: false };
    const want = ctx.down.slice().sort().join('|'), at = minutesOfDay(slotStartMs), matchedSet: Record<string, boolean> = {};
    ctx.matched.forEach(m => { matchedSet[m] = true; });
    const sameTime = h.boards.filter(b => b.startMs < slotStartMs && minutesOfDay(b.startMs) === at && b.people.some(p => !!p.emp));
    const useful = ctx.known && ctx.matched.length > 0;
    const pool = useful ? sameTime.filter(b => { const rooms: Record<string, boolean> = {}; b.people.forEach(p => { const n = normText(p.area); if (matchedSet[n]) rooms[n] = true; }); return Object.keys(rooms).sort().join('|') === want; }) : sameTime;
    return { sameTime, pool, useful };
}
function pickRemembered(h: History | null, slotStartMs: number, ctx: RememberCtx): { board: HistBoard; how: 'matches' | 'newest' } | null {
    const c = rememberedCandidates(h, slotStartMs, ctx); if (!c.pool.length) return null;
    // newest shift first; on the same shift the supervisor's own board, then the one with more people
    const best = c.pool.slice().sort((a, b) => b.startMs - a.startMs || (sameText(b.team, ctx.supName) ? 1 : 0) - (sameText(a.team, ctx.supName) ? 1 : 0) || b.people.length - a.people.length)[0];
    return { board: best, how: c.useful ? 'matches' : 'newest' };
}
// A remembered board as the rows a save would have written: people who are not available today are left out, and a lead who is not one of the crew's leads is
// replaced by the supervisor. A room whose people are all away stays with its lead; a room that no longer exists is dropped.
function rowsOfRemembered(b: HistBoard, supName: string, leadNames: string[], staff: any[], roomNames: string[]): { rows: any[]; skipped: string[]; droppedRooms: string[] } {
    const now = new Date().toISOString(), byId: Record<string, any> = {}, byName: Record<string, any> = {}, leadSet: Record<string, boolean> = {}, roomSet: Record<string, boolean> = {}, skipped: string[] = [], droppedRooms: string[] = [], rows: any[] = [], roomHas: Record<string, boolean> = {};
    roomNames.forEach(n => { roomSet[normText(n)] = true; });
    staff.forEach(e => { const id = String(empIdOf(e) || "").toLowerCase(); if (id) byId[id] = e; byName[normText(getField(e, 'craa5_name'))] = e; });
    leadNames.forEach(n => { leadSet[normText(n)] = true; });
    const mk = (area: string, lead: string, name: string, guid: string) => ({ craa5_taskassignmentid: "", craa5_id: name, craa5__aaemp_guid: guid, craa5_lead: lead, craa5_area: area, craa5_team: supName, craa5_whatisbeingdone: "", craa5_whatislefttodo: "", craa5_starttime: now, craa5_datetimeofassignment: now, createdon: now, craa5_percentagecomplete: 0, craa5_complete: false, statecode: 0 });
    const leadOf = (p: HistPerson) => p.lead && (sameText(p.lead, supName) || leadSet[normText(p.lead)]) ? p.lead : supName;
    b.people.forEach(p => {
        if (!roomSet[normText(p.area)]) { if (droppedRooms.indexOf(p.area) < 0) droppedRooms.push(p.area); return; }
        if (!p.emp) return;
        const e = (p.id && byId[p.id]) || byName[normText(p.emp)];
        if (!e) { skipped.push(p.emp); return; }
        roomHas[normText(p.area)] = true;
        rows.push(mk(p.area, leadOf(p), renderSafe(getField(e, 'craa5_name')), String(empIdOf(e) || "")));
    });
    b.people.forEach(p => { const k = normText(p.area); if (roomHas[k] || !roomSet[k]) return; roomHas[k] = true; rows.push(mk(p.area, leadOf(p), "", "")); });   // a room with nobody available (or no one under its lead) still has its lead
    return { rows, skipped, droppedRooms };
}

