            const existing = presetFor(viewCrew, nextSlot.startMs);
            const board: PresetBoard = { v: 1, crew: viewCrew, slotStart: nextSlot.startMs, supervisor: renderSafe(getField(supervisor, 'craa5_name')), savedAt: new Date().toISOString(), savedBy: String(msUser?.name || ""), rows, recordId: existing?.recordId };
            const res = await writePreset(propsRef.current, board);
            const saved: PresetBoard = { ...board, recordId: res.recordId || undefined, where: res.where };
            const list = presets.filter(x => !(x.crew === saved.crew && Math.abs(x.slotStart - saved.slotStart) < 60000)).concat([saved]);
            const store: PresetStore = { remote: res.where === 'dataverse' ? 'ok' : (looksMissing(res.error) ? 'missing' : 'error'), error: res.error, localCount: Object.keys(lsReadPresets()).length };
            if (GLOBAL_DATA_CACHE) GLOBAL_DATA_CACHE = { ...GLOBAL_DATA_CACHE, presets: list, presetStore: store };
            setPresets(list); setPresetStore(store);
            setPresetLog({ at: new Date().toISOString(), where: res.where, error: res.error, refused: res.refused, sent: res.sent, rows: rows.length });
            setSaveSuccess(true); setCurrentStep(4);
            setBoardNote({ tone: 'ok', text: `Setup saved ${clockTime(Date.now())} for ${slotLabel(nextSlot.startMs)}` });
            if (res.where === 'device') setSaveWarning(`Saved on this computer only (${String(res.error).slice(0, 140)}). Create the table ${PRESET_TABLE} (Data check lists its columns) and save again to keep it in Dataverse for everyone.`);
            else if (res.refused.length) setSaveWarning(`Saved to Dataverse without ${res.refused.join(', ')}: the table refused ${res.refused.length === 1 ? 'that column' : 'those columns'}. Data check lists them.`);
        } catch (err: any) {
