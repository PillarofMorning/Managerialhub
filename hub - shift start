            const rows = await tableQuery(props, MSS_LOG_TABLE, f, ['craa5_equipmentguid'], 5000, 'createdon desc');
            rows.forEach((r: any) => { const g = String(getField(r, 'craa5_equipmentguid') || '').replace(/[{}]/g, '').trim().toLowerCase(); if (g) out.add(g); });
