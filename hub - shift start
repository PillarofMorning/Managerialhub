                    craa5_boardid: boardId, craa5_shiftdate: shiftDate, craa5_crew: hubCrew(crew), craa5_team: hubGuid(room?.leadId || ''), craa5_cleankind: p.kind,
                    craa5_employeeguids: hubGuidList(e.people), craa5_employees: names.slice(0, 400), craa5_pinned: e.pinned, craa5_source: 'shiftstart',
                    craa5_updatedby: me.slice(0, 200), craa5_rev: (now ? now.rev : readRev) + 1,
                };
                if (p.minutes && !now?.minutes) row.craa5_plannedminutes = Math.round(p.minutes);
                const m = await writeAssignment(hostProps, row, !!now);
                if (m) { failed++; err = err || m; keep[key] = e; } else saved++;
            }
            setEdits(keep);
            const parts: string[] = [];
            if (saved) parts.push(tx(`${saved} saved, Ganttly follows on its next read`, `${saved} guardados, Ganttly los toma en su siguiente lectura`));
            if (lost) parts.push(tx(`${lost} changed on another device first, so theirs stays`, `${lost} cambiados antes en otro equipo, se queda ese cambio`));
