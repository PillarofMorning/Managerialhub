            const matches = allEmployees.filter((e: any) => renderSafe(getField(e, 'craa5_name')).toLowerCase().includes(q) && isOvertimeCandidate(e));
            setSearchSuggestions(Array.from(new Map(matches.map(item => [getField(item, 'craa5__aa_employeeid'), item])).values()));
        }, 300);
