    const when = (v: any) => (v ? new Date(v).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '-');
    const listTab = tab === 'live' || tab === 'plans' || tab === 'archive';

    return (
