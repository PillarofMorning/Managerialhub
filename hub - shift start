    }, [empSearchText, allEmployees, isOvertimeCandidate]);

    const removeFromAllAreas = (ids: string[]) => setAssignments(prev => { const next = { ...prev }; Object.keys(next).forEach(areaId => { next[areaId] = next[areaId].filter(id => !ids.includes(id)); }); return next; });

    const handleAddSuggestedEmployee = (emp: any) => {
