// The boards this shift could start from: the earlier boards of the same crew/supervisor, preferring boards at the same start time of day and matching down lines,
// but gracefully falling back to the supervisor's or crew's newest earlier board when today's down lines differ.
type RememberCtx = { known: boolean; matched: string[]; down: string[]; supName: string };
function rememberedCandidates(h: History | null, slotStartMs: number, ctx: RememberCtx): { sameTime: HistBoard[]; pool: HistBoard[]; useful: boolean } {
    if (!h || !Array.isArray(h.boards) || h.boards.length === 0) return { sameTime: [], pool: [], useful: false };
    const effSlot = slotStartMs || shiftBucketMs(Date.now(), [], "");
    const want = ctx.down.slice().sort().join('|'), at = minutesOfDay(effSlot), matchedSet: Record<string, boolean> = {};
    ctx.matched.forEach(m => { matchedSet[m] = true; });
    const isSupMatch = (team: string) => !!ctx.supName && (sameText(team, ctx.supName) || (personKey(team) !== '' && personKey(team) === personKey(ctx.supName)));
    let earlier = h.boards.filter(b => b.startMs < effSlot - 1800000 && b.people.length > 0);
    if (!earlier.length) earlier = h.boards.filter(b => b.people.length > 0);
    let sameTime = earlier.filter(b => minutesOfDay(b.startMs) === at || isSupMatch(b.team));
    if (!sameTime.length) sameTime = earlier;
