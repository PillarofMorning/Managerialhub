            if (!eo) { eo = { craa5__aa_employeeid: fallbackGuid, craa5_name: en, craa5_email: getField(r, 'craa5_email') || "", craa5_badgenumber: getField(r, 'craa5_badgenumber') || "" }; ce.push(eo); }
