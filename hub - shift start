const buildUpdateData = useCallback((): UpdateData => {
    const uniqueAreasToPrint = new Map<string, string>();
    Object.keys(areaAssignments).forEach(id => {
        const hasStaff = (assignments[id]?.length || 0) > 0;
        const finishedOnShift = isAreaFinished(id);
        if (!isAreaIncludedInUpdate(id) || (!hasStaff && !finishedOnShift)) return;
        const an = renderSafe(getField(areaMap.get(id), 'craa5_area'));
        if (!uniqueAreasToPrint.has(an)) uniqueAreasToPrint.set(an, id);
    });
    const validIds = Array.from(uniqueAreasToPrint.values());
    const isStatus = (id: string) => isStatusArea(getField(areaMap.get(id), 'craa5_area'));

    let th = 0, osh = 0;
    const crewRef = boardCrew || clockCrew;
    activeBuckets.forEach(l => {
        validIds.filter(id => areaAssignments[id] === getField(l, 'craa5__aa_employeeid') && !isStatus(id)).forEach(id => {
            const ea = assignments[id] || [];
            th += ea.length;
            ea.forEach(eId => { const e = employeeMap.get(eId); if (e && crewRef && crewOfPerson(e) !== crewRef) osh++; });
        });
    });

    const now = new Date();
    const crewNow = boardCrew || clockCrew || 'A';
    const cleanName = (s: string) => s.replace(/^\d+\s*[-_]\s*/, '').trim();
    const namesIn = (id: string) => (assignments[id] || []).map(eid => formatFullName(getField(employeeMap.get(eid), 'craa5_name'))).filter(Boolean);
    const areaOf = (id: string): UpdateArea => {
        const a = areaMap.get(id), d = areaDetails[id] || ({} as any), subState = getAreaSubcatState(id);
        const curStep = Math.min(SANITATION_STEPS.length - 1, Math.max(0, sanitationProgress[id] ?? 0));
        const callout = String(subState.callout || d.subcategoryNotes || '').trim();
        return {
            id, name: renderSafe(getField(a, 'craa5_area')), emoji: getAreaEmoji(a).trim(), hc: assignments[id]?.length || 0, done: isAreaFinished(id),
            stage: SANITATION_STEPS[curStep], remHours: Number(subState.remHours) || 0,
            subcatsDone: (subState.doneList || []).map(cleanName), subcatsInProg: (subState.inProgList || []).map(cleanName),
            status: String(d.currentStatus || '').trim(), left: String(d.futureNotes || '').trim(), callout, people: namesIn(id),
        };
    };

    // Attendance (Sick, PTO, Late, Left Early)
    const statusGroups: Record<string, string[]> = {};
    Object.keys(areaAssignments).forEach(id => {
        const areaName = renderSafe(getField(areaMap.get(id), 'craa5_area'));
        if (!isStatusArea(areaName)) return;
        const empNames = namesIn(id);
        if (empNames.length > 0) { const key = areaName.toUpperCase(); statusGroups[key] = (statusGroups[key] || []).concat(empNames); }
    });

    // Production areas (priority lines first), then support functions (A-Z)
    const pa = validIds.filter(id => isProductionArea(areaMap.get(id)) && !isStatus(id));
    pa.sort((idA, idB) => {
        const nameA = renderSafe(getField(areaMap.get(idA), 'craa5_area')), nameB = renderSafe(getField(areaMap.get(idB), 'craa5_area'));
        return (productionSortWeight(nameA) - productionSortWeight(nameB)) || nameA.localeCompare(nameB);
    });
    const ed = validIds.filter(id => !isProductionArea(areaMap.get(id)) && !isStatus(id));
    ed.sort((idA, idB) => renderSafe(getField(areaMap.get(idA), 'craa5_area')).localeCompare(renderSafe(getField(areaMap.get(idB), 'craa5_area'))));

    return {
        date: now.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' }),
        time: now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }),
        day: now.toLocaleDateString('en-US', { weekday: 'long' }),
        shift: crewNow,
        supervisor: formatFullName(getField(activeSupervisorObj, 'craa5_name')) || (msUser ? String(msUser.name || '') : ''),
        totalHC: th, offShift: osh,
        attendance: Object.keys(statusGroups).map(k => ({ status: k, names: statusGroups[k] })),
        production: pa.map(areaOf),
        support: ed.map(areaOf),
    };
}, [areaDetails, areaMap, activeBuckets, areaAssignments, assignments, employeeMap, boardCrew, clockCrew, getAreaSubcatState, sanitationProgress, isAreaFinished, isAreaIncludedInUpdate, activeSupervisorObj, msUser]);

