                    empName: t.craa5_id || "", empEmail: t.craa5_email, craa5_email: t.craa5_email, Email: t.craa5_email, empGuid: t.craa5__aaemp_guid,
                    badgeNumber: t.craa5_badgenumber, craa5_badgenumber: t.craa5_badgenumber, badgenumber: t.craa5_badgenumber,
