async function fetchTaskRows(props: any, team: string = ""): Promise<{ rows: any[]; status: TaskStatus }> {
    const xrm = safeGetXrm(), webApi = getWebApi(props), dataApi = props?.dataApi, since = odataDate(Date.now() - TASK_FETCH_HOURS * 3600000), problems: string[] = [];
    const quoted = team.replace(/'/g, "''");
    const failed = (where: string, e: any) => { const m = String(e?.message || e || "failed"); logError(`Saved assignments via ${where}`, m); problems.push(`${where}: ${m}`); };
    const got = (rows: any[], source: string) => ({ rows, status: { ok: true, error: "", source, read: rows.length } });

    if (xrm?.WebApi?.retrieveMultipleRecords && !ENDPOINT_META.taskCoreOnly) {
        const attrs = TASK_COLUMNS.map(c => `<attribute name='${c}'/>`).join('');
        const fetchXml = `<fetch top='5000'><entity name='${TASK_TABLE}'>${attrs}<filter><condition attribute='createdon' operator='last-x-hours' value='${TASK_FETCH_HOURS}'/><condition attribute='statecode' operator='eq' value='0'/>${team ? `<condition attribute='craa5_team' operator='eq' value='${team.replace(/&/g, '&amp;').replace(/'/g, '&apos;').replace(/</g, '&lt;')}'/>` : ''}</filter><order attribute='createdon' descending='true'/></entity></fetch>`;
        try { const res: any = await asyncRace(xrm.WebApi.retrieveMultipleRecords(TASK_TABLE, `?fetchXml=${encodeURIComponent(fetchXml)}`), TASK_TIMEOUT_MS, "FetchXML"); if (Array.isArray(res?.entities)) return got(res.entities, "FetchXML"); failed("FetchXML", "no rows came back"); } catch (e: any) {
            const msg = String(e?.message || e || "");
            if (/doesn't contain|invalid attribute|0x80040203|0x80041103/i.test(msg)) {
                ENDPOINT_META.taskCoreOnly = true;
                saveEndpointMeta();
            }
            failed("FetchXML", e);
        }
    }
    if (webApi?.retrieveMultipleRecords) {
        try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${TASK_CORE_COLUMNS.join(',')}&$filter=statecode eq 0 and createdon ge ${since}${team ? ` and craa5_team eq '${quoted}'` : ''}&$orderby=createdon desc&$top=5000`), TASK_TIMEOUT_MS, "OData"); if (Array.isArray(res?.entities)) return got(res.entities, "OData"); failed("OData", "no rows came back"); } catch (e: any) { failed("OData", e); }
    }
    if (dataApi?.queryTable) {
