// Moves the setups still in the old table craa5_shiftpreset into craa5_shiftplan, then deactivates the old rows that moved.
async function moveLegacySetups(props: any, by: string, onStep?: (t: string) => void): Promise<{ moved: number; expired: number; failed: number; error: string }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, idCol = PRESET_TABLE + 'id', pick = [idCol, 'craa5_boardjson', 'createdon'];
    let recs: any[] = [];
    try {
        if (webApi?.retrieveMultipleRecords) { const res: any = await asyncRace(webApi.retrieveMultipleRecords(PRESET_TABLE, `?$select=${pick.join(',')}&$filter=statecode eq 0&$top=500`), API_TIMEOUT_MS, 'old setups'); recs = Array.isArray(res?.entities) ? res.entities : []; }
        else if (dataApi?.queryTable) recs = await queryDataApi(dataApi, PRESET_TABLE, 'statecode eq 0', { select: pick, top: 500 });
    } catch (e: any) { return { moved: 0, expired: 0, failed: 0, error: String(e?.message || e) }; }
    let moved = 0, expired = 0, failed = 0, error = '';
    for (const r of recs) {
        let pb: PresetBoard | null = null;
        try { pb = JSON.parse(String(getField(r, 'craa5_boardjson') || '')); } catch (e) { pb = null; }
        const oldId = String(getField(r, idCol) || '').replace(/[{}]/g, '');
        if (!pb || !pb.crew || !pb.slotStart || !Array.isArray(pb.rows)) continue;
        if (pb.slotStart < Date.now() - PLAN_KEEP_MS) { expired++; continue; }   // its shift is long over: left where it is
        if (onStep) onStep(`Moving setup ${moved + failed + 1}: shift ${pb.crew} ${slotLabel(pb.slotStart)}`);
        const plan = boardLog({ ...presetToPlan({ ...pb, where: 'device' }), recordId: undefined }, by, `moved from ${PRESET_TABLE}`);
        const same = await readRecordByName(props, PLAN_TABLE, boardName(plan), true);
        const w = await writePlan(props, same ? { ...plan, recordId: same.recordId } : plan);
        if (!w.ok) { failed++; error = w.error; if (TABLE_STATE[PLAN_TABLE] === 'missing') break; continue; }
        moved++;
        await deactivateRecord(props, PRESET_TABLE, oldId);
    }
    try { window.localStorage.removeItem(PRESET_LS_KEY); } catch (e) { /* nothing kept */ }
    return { moved, expired, failed, error };
}

// ---- Activity & User Access log (craa5_shiftlog + optional craa5_useraccesslog) ----
type LogEntry = { action: string; user: string; email: string; role?: string; board?: string; boardId?: string; crew?: string; team?: string; summary?: string; changes?: string[]; details?: any; app?: string; at?: string };
let LOG_CHAIN: Promise<any> = Promise.resolve();
function lsReadLog(): LogEntry[] { try { const a = JSON.parse(window.localStorage.getItem(LOG_LS_KEY) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
function logActivity(props: any, e: LogEntry): Promise<any> {
    const entry: LogEntry = { app: 'Shift Start', ...e, at: e.at || new Date().toISOString() };
    try { console.info(`[Shift Start activity] ${entry.at} - ${entry.user || 'unknown'} (${entry.email || 'no email'}) - ${entry.action}${entry.board ? ' - ' + entry.board : ''}`, entry.changes && entry.changes.length ? entry.changes : (entry.summary || '')); } catch (x) { /* console only */ }
    try {
        const prev = lsReadLog().filter(x => !(x.at === entry.at && x.action === entry.action && x.user === entry.user));
        window.localStorage.setItem(LOG_LS_KEY, JSON.stringify([entry].concat(prev).slice(0, 400)));
    } catch (x) {}
    LOG_CHAIN = LOG_CHAIN.then(async () => {
        const summary = entry.summary || (entry.changes || []).slice(0, 25).join('; ');
        const data: any = {
            craa5_title: `${entry.action} - ${entry.user || '?'} - ${entry.at}`.slice(0, 200),
            craa5_details: JSON.stringify(entry),
            craa5_action: entry.action,
            craa5_user: entry.user || '',
            craa5_useremail: entry.email || '',
            craa5_role: entry.role || '',
            craa5_board: entry.board || '',
            craa5_boardid: entry.boardId || '',
            craa5_crew: entry.crew || '',
            craa5_team: entry.team || '',
            craa5_summary: summary.slice(0, 3900),
            craa5_app: entry.app,
            craa5_at: entry.at,
        };
        if (TABLE_STATE[LOG_TABLE] !== 'missing') {
            await tableWrite(props, LOG_TABLE, '', data);
        }
        if (TABLE_STATE[ACCESS_LOG_TABLE] === 'ok') {
            await tableWrite(props, ACCESS_LOG_TABLE, '', data);
        }
    }).catch(() => {});
    return LOG_CHAIN;
}
// Logs user access & navigation events with configurable deduplication cooldown so every access is captured without duplicate spam
const ACCESS_DEDUPE_MEM: Record<string, number> = {};
function logAccessEvent(props: any, dedupeKey: string, e: LogEntry, cooldownMs: number = 60000) {
    const now = Date.now();
    const memKey = `${e.action}_${keyText(e.email || e.user)}_${keyText(dedupeKey)}`;
    if (cooldownMs > 0 && ACCESS_DEDUPE_MEM[memKey] && (now - ACCESS_DEDUPE_MEM[memKey] < cooldownMs)) return;
    ACCESS_DEDUPE_MEM[memKey] = now;
    logActivity(props, e);
}
// "Opened" is kept at most once an hour for each person and board
function logOpened(props: any, e: LogEntry) {
    const k = `ss_logopen_${keyText(e.email || e.user)}_${keyText(e.board || e.team)}_${Math.floor(Date.now() / 3600000)}`;
    try { if (window.localStorage.getItem(k)) return; window.localStorage.setItem(k, '1'); } catch (x) { /* log anyway */ }
    logActivity(props, { ...e, action: 'board_opened' });
}
async function readActivity(props: any, top: number = 500): Promise<{ list: LogEntry[]; error: string; local: boolean }> {
    const local = lsReadLog();
    try {
        const rows = await tableQuery(props, LOG_TABLE, '', [], top, 'createdon desc');
        const list = rows.map(r => {
            const rawDetails = String(getField(r, 'craa5_details') || '');
            const createdOn = getField(r, 'createdon') || new Date().toISOString();
            try {
                const o = rawDetails ? JSON.parse(rawDetails) : {};
                if (o && typeof o === 'object' && (o.action || o.user)) {
                    return { ...o, at: o.at || createdOn };
                }
            } catch (e) {}
            return {
                action: String(getField(r, 'craa5_action') || 'activity'),
                user: String(getField(r, 'craa5_user') || getField(r, 'craa5_title') || 'User'),
                email: String(getField(r, 'craa5_useremail') || ''),
                role: String(getField(r, 'craa5_role') || ''),
                board: String(getField(r, 'craa5_board') || ''),
                crew: String(getField(r, 'craa5_crew') || ''),
                team: String(getField(r, 'craa5_team') || ''),
                summary: rawDetails || String(getField(r, 'craa5_summary') || getField(r, 'craa5_title') || ''),
                app: String(getField(r, 'craa5_app') || 'Shift Start'),
                at: String(getField(r, 'craa5_at') || createdOn)
            } as LogEntry;
        }).filter(Boolean) as LogEntry[];
        const seen = new Set<string>();
        const merged: LogEntry[] = [];
        list.concat(local).forEach(item => {
            const sig = `${item.action || ''}_${item.user || ''}_${String(item.at || '').slice(0, 19)}`;
            if (!seen.has(sig)) {
                seen.add(sig);
                merged.push(item);
            }
        });
        return { list: merged.sort((a, b) => String(b.at).localeCompare(String(a.at))), error: '', local: false };
    } catch (e: any) { return { list: local, error: String(e?.message || e), local: true }; }
}
