    const histSeq = useRef(0), histInFlight = useRef(""), histForce = useRef(false), histDone = useRef<Record<string, number>>({});   // histDone: read token -> when it is read again
    const [rememberedTried, setRememberedTried] = useState(false);       // the remembered team was looked for (and used, or decided against) for this board
