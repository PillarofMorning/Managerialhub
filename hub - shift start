        });
        const existing = presetFor(viewCrew, nextSlot.startMs);
        const board: PresetBoard = { 
            v: 1, 
            crew: viewCrew, 
            slotStart: nextSlot.startMs, 
            slotEnd: nextSlot.endMs,
            supervisor: renderSafe(getField(supervisor, 'craa5_name')), 
            supervisorEmail: getEmployeeEmail(supervisor),
            savedAt: new Date().toISOString(), 
            savedBy: String(msUser?.name || ""), 
            rows, 
            recordId: existing?.recordId,
            where: existing?.where,
            saveCount: existing?.saveCount,
            log: existing?.log,
            areaAssignments,
            assignments,
            areaDetails,
            subcatProgress,
            sanitationProgress,
            areaCompletions: buildAreaCompletionsPayload()
        };
        const res = await writePreset(propsRef.current, board);
        const cleanRefused = (res.refused || []).filter(c => c !== 'craa5_title' && c !== 'craa5_name');
        const saved: PresetBoard = { ...board, recordId: res.recordId || undefined, where: res.where === 'dataverse' ? 'plan' : 'device' };
        const list = presets.filter(x => !(x.crew === saved.crew && Math.abs(x.slotStart - saved.slotStart) < 60000)).concat([saved]);
        const store: PresetStore = { remote: res.where === 'dataverse' ? 'ok' : (looksMissing(res.error) && !isColumnError(res.error, PLAN_TABLE) ? 'missing' : 'error'), error: res.error, localCount: Object.keys(lsReadPresets()).length };
        if (GLOBAL_DATA_CACHE) {
            GLOBAL_DATA_CACHE = { ...GLOBAL_DATA_CACHE, presets: list, presetStore: store };
            saveSessionCache({ ...GLOBAL_DATA_CACHE, liveBoards: LIVE_BOARDS });
        }
        setPresets(list); setPresetStore(store);
        setPresetLog({ at: new Date().toISOString(), where: res.where, error: res.error, refused: cleanRefused, sent: res.sent, rows: rows.length });
        // Activity log: what changed in the plan, in plain words
        const asTaskRows = (rs: PresetRow[]) => (rs || []).map(r => ({ craa5_id: r.emp, craa5__aaemp_guid: r.empId, craa5_area: r.area, craa5_lead: r.lead, craa5_whatisbeingdone: r.status, craa5_whatislefttodo: r.notes }));
        const team = String(getField(supervisor, 'craa5_name') || '');
        logActivity(propsRef.current, { action: 'plan saved', user: myName, email: myEmail, role: access.role, board: boardName({ crew: viewCrew, team, slotStart: nextSlot.startMs }), boardId: res.recordId || '', crew: viewCrew, team, changes: diffBoardRows(asTaskRows(existing?.rows || []), asTaskRows(rows)), details: { where: res.where, slotStart: nextSlot.startMs } });
        setSaveSuccess(true); setCurrentStep(4);
        setBoardNote({ tone: 'ok', text: `Plan saved ${clockTime(Date.now())} for ${slotLabel(nextSlot.startMs)}` });
        if (res.where === 'device') setSaveWarning(`Saved on this computer only (${String(res.error).slice(0, 140)}). Create the table ${PLAN_TABLE} (Data check lists its columns) and save again to keep it in Dataverse for everyone.`);
        else if (cleanRefused.length) setSaveWarning(`Saved to Dataverse without ${cleanRefused.join(', ')}: the table refused ${cleanRefused.length === 1 ? 'that column' : 'those columns'}. Data check lists them.`);
    } catch (err: any) {
        logError('Save setup failed', err?.message || err);
        setSubmissionError(renderSafe(err?.message || err || "An unexpected error occurred while saving the setup."));
    } finally { setIsLoading(false); }
