// The rows the board is built from and how the read went. The shifts still open live in craa5_shiftboard (one JSON per
// crew and shift); their rows are added here in the craa5_taskassignment shape, so everything that reads rows sees them unchanged.
async function readSavedAssignments(props: any, team: string = ""): Promise<{ recent: any[]; status: TaskStatus }> {
    const [{ rows, status }, boards] = await Promise.all([fetchTaskRows(props, team), readLiveBoards(props).catch(() => [] as ShiftBoard[]), readRecentArchiveRows(props).catch(() => [])]);
    const cutoff = Date.now() - TASK_LOOKBACK_MS;
    const live: any[] = [];
    boards.forEach(b => { if (b.status !== 'archived' && (!team || sameText(b.team, team) || (personKey(b.team) && personKey(b.team) === personKey(team)))) live.push.apply(live, boardTaskRows(b)); });
    const archived = RECENT_ARCHIVE_ROWS.filter(r => !team || sameText(getField(r, 'craa5_team'), team) || (personKey(getField(r, 'craa5_team')) && personKey(getField(r, 'craa5_team')) === personKey(team)));
    const localRows = readLocalShiftStartRows().filter(r => !isBoardRow(r) && (!team || sameText(getField(r, 'craa5_team'), team)));
    const combinedTasks = rows.concat(localRows);
    return { recent: dropCoveredTaskRows(combinedTasks.filter(r => (taskTime(r) || Number(r?._slotStart || 0)) >= cutoff)).concat(live.filter(r => (taskTime(r) || Number(r?._slotStart || 0)) >= cutoff), archived.filter(r => (taskTime(r) || Number(r?._slotStart || 0)) >= cutoff)), status };
