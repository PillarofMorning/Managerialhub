// Explicit recognition for known day-shift team leaders: Robert Lewis (Day Shift A) and Timoteo Ramirez (Day Shift B).
function knownLeaderCrew(e: any): string {
    const pk = personKey(getField(e, 'craa5_name') || getField(e, 'fullname') || "");
