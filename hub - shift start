    }, [chatKey]);
    useEffect(() => {
        if (!chatKey || chatBox.key !== chatKey) return;
        try { window.localStorage.setItem(chatKey, JSON.stringify({ thread: chatBox.thread.slice(-30), log: chatBox.log.slice(-200) })); } catch (e) { /* storage blocked */ }
    }, [chatKey, chatBox]);
    useEffect(() => { if (saveSuccess) setChatDirty(false); }, [saveSuccess]);
    useEffect(() => { if (chatOpen && chatBottom.current && chatBottom.current.scrollIntoView) chatBottom.current.scrollIntoView({ block: 'end' }); }, [chatOpen, chatBox.thread.length]);

    // The board as the chat reads it: rooms (on the board or not), people (this crew and everyone else, so an overtime pick can be named), who is free right now.
    const buildChatBoard = (): ChatBoard => {
        const hereIds: Record<string, boolean> = {}, atMin = prdWindow ? minutesOfDay(prdWindow.from) : -1;
        [...employees, ...leads, ...customEmployees, ...customLeads].forEach(e => { hereIds[String(getField(e, 'craa5__aa_employeeid') || "")] = true; });
        Object.keys(assignments).forEach(k => (assignments[k] || []).forEach(id => { hereIds[String(id)] = true; }));
        const people: ChatPerson[] = [], seen: Record<string, boolean> = {};
        allKnownEmps.forEach(e => { const id = String(getField(e, 'craa5__aa_employeeid') || ""), nm = renderSafe(getField(e, 'craa5_name')); if (!id || !nm || id === selectedSupervisorId || seen[id]) return; seen[id] = true; people.push({ id, name: nm, lead: selectedLeadIds.has(id), here: !!hereIds[id] }); });
        const rooms: ChatRoom[] = [];
        areaMap.forEach((a: any, id: string) => { const nm = renderSafe(getField(a, 'craa5_area')); if (!nm || isStatusArea(nm)) return; rooms.push({ id: String(id), name: nm, onBoard: !!areaAssignments[id], lead: areaAssignments[id] || "", people: (assignments[id] || []).map(String), done: String((areaDetails[id] || {} as any).currentStatus || "").trim().toLowerCase() === "completed" }); });
        const usual = (name: string) => typicalHeadcount(histNow, name, atMin) || typicalHeadcount(histNow, name);
        const nameOf = (id: string) => renderSafe(getField(employeeMap.get(id), 'craa5_name'));
        const pick = (roomId: string, n: number, from: string[], have: string[]): string[] => {
