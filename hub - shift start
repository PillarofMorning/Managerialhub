                                    <tbody>{s.cols.map(c => <tr key={c.name}><td style={{ ...td, fontFamily: 'Consolas, monospace', fontWeight: 700, width: 210 }}>{c.name}</td><td style={{ ...td, width: 260 }}>{c.type}</td><td style={{ ...td, width: 80 }}>{c.optional ? 'Optional' : 'Required'}</td><td style={td}>{c.why}</td></tr>)}</tbody>
                                </table>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    );
}

