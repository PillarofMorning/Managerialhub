function EquipmentAssignPanel({ hostProps, rooms, assets, shiftDate, crew, slotStartMs, boardId, canEdit, onlyTeam, me, nameOf }: EquipmentAssignProps) {
    const [read, setRead] = useState<AsgRead | null>(null);
    const [prog, setProg] = useState<AsgProgress>({ logIds: new Set<string>(), started: new Set<string>() });
    const [edits, setEdits] = useState<Record<string, AsgEdit>>({});
    const [picked, setPicked] = useState('');
    const [saving, setSaving] = useState(false);
    const [note, setNote] = useState<{ tone: 'ok' | 'warn'; text: string } | null>(null);
    const [open, setOpen] = useState(true);
    const busy = useRef(false);

    const load = useCallback(async () => {
        if (busy.current || !shiftDate || !crew) return;
