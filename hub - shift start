const looksMissing = (msg: string) => /does not exist|not found|could not find|doesn't contain|0x80060888|0x80040217|resource not found|no table|entity .* not/i.test(msg);

// Xrm.WebApi first, then the generative page's own data calls.
function unwrapWriteResult(res: any): any {
    if (res && typeof res === 'object' && (res.error || res.success === false)) {
        throw (res.error || new Error(String(res.message || 'Dataverse write error')));
    }
    return res;
}
function getWriteApi(props: any): { create: (t: string, d: any) => Promise<any>; update: (t: string, id: string, d: any) => Promise<any> } | null {
    const xrm = safeGetXrm(), web = xrm?.WebApi?.createRecord ? xrm.WebApi : props?.context?.webAPI?.createRecord ? props.context.webAPI : null, dataApi = props?.dataApi;
    if (web) return { create: (t, d) => Promise.resolve(web.createRecord(t, d)).then(unwrapWriteResult), update: (t, id, d) => Promise.resolve(web.updateRecord(t, id, d)).then(unwrapWriteResult) };
    if (dataApi?.createRow && dataApi?.updateRow) return { create: (t, d) => Promise.resolve(dataApi.createRow(t, d)).then(unwrapWriteResult), update: (t, id, d) => Promise.resolve(dataApi.updateRow(t, id, d)).then(unwrapWriteResult) };
    return null;
}

type PresetStore = { remote: 'unknown' | 'ok' | 'missing' | 'error'; error: string; localCount: number };
// Every setup still worth keeping: the plans in craa5_shiftplan, any setup not yet moved out of the old table craa5_shiftpreset, and
// any kept on this computer. The newest save of each crew-and-shift wins. A setup is only ever used for its own crew and exact shift start.
async function readPresets(props: any): Promise<{ list: PresetBoard[]; store: PresetStore }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, keep = Date.now() - PRESET_KEEP_MS;
    const since = odataDate(Date.now() - PRESET_READ_DAYS * 86400000), pick = ['craa5_shiftpresetid', 'craa5_boardjson', 'createdon'];
    const plans = await readPlans(props);
    let remote: PresetStore['remote'] = TABLE_STATE[PLAN_TABLE] === 'ok' ? 'ok' : TABLE_STATE[PLAN_TABLE] === 'missing' ? 'missing' : TABLE_STATE[PLAN_TABLE] === 'error' ? 'error' : 'unknown';
    let error = TABLE_ERROR[PLAN_TABLE] || '';
    const all: PresetBoard[] = plans.map(planToPreset);
    // The old table: read only, until its setups are moved (Shifts console, Plans tab)
    let legacy: any[] = [];
    try {
        if (webApi?.retrieveMultipleRecords) { const res: any = await asyncRace(webApi.retrieveMultipleRecords(PRESET_TABLE, `?$select=${pick.join(',')}&$filter=statecode eq 0 and createdon ge ${since}&$orderby=createdon desc&$top=60`), TASK_TIMEOUT_MS, "old setups"); legacy = Array.isArray(res?.entities) ? res.entities : []; }
        else if (dataApi?.queryTable) legacy = await queryDataApi(dataApi, PRESET_TABLE, `statecode eq 0 and createdon ge ${since}`, { select: pick, orderBy: 'createdon desc', top: 60 });
    } catch (e) { legacy = []; }
    legacy.forEach(r => {
        try { const b = JSON.parse(String(getField(r, 'craa5_boardjson') || "")); if (b && b.crew && b.slotStart && Array.isArray(b.rows)) all.push({ ...b, recordId: String(getField(r, PRESET_TABLE + 'id') || ""), where: 'legacy' }); } catch (e) { /* not a setup */ }
    });
    const local = lsReadPresets(), localList = Object.keys(local).map(k => ({ ...local[k], where: 'device' }));
    all.push.apply(all, localList);
    const best: Record<string, PresetBoard> = {};
    all.forEach(b => { if (b.slotStart < keep) return; const k = presetKey(b.crew, b.slotStart), cur = best[k]; if (!cur || (b.where === 'plan' && cur.where !== 'plan') || (b.where === cur.where && String(b.savedAt) > String(cur.savedAt))) best[k] = b; });
    return { list: Object.keys(best).map(k => best[k]), store: { remote, error, localCount: localList.length } };
}

// Saves a setup as a plan in craa5_shiftplan (the old table is never written again). When the plan table cannot take it, the setup is
// kept on this computer. Returns where it went and exactly what was sent.
async function writePreset(props: any, board: PresetBoard): Promise<{ where: 'dataverse' | 'device'; error: string; refused: string[]; sent: any; recordId: string }> {
    const plan = presetToPlan(board, { supervisorEmail: board.supervisorEmail, slotEnd: board.slotEnd });
    const existing = board.where === 'plan' && board.recordId ? board.recordId : '';
    let p: ShiftBoard = { ...plan, recordId: existing || undefined, saveCount: (board.saveCount || 0) + 1, log: board.log };
    if (!existing) { const same = await readRecordByName(props, PLAN_TABLE, boardName(p), true); if (same) p = { ...p, recordId: same.recordId, log: same.log, saveCount: (same.saveCount || 0) + 1 }; }
    p = boardLog(p, board.savedBy || '', `plan saved (${p.rows.length} rows)`);
    const w = await writePlan(props, p);
    if (w.ok) {
        const local = lsReadPresets(), k = presetKey(board.crew, board.slotStart); if (local[k]) { delete local[k]; lsWritePresets(local); }
        if (board.where === 'legacy' && board.recordId) await deactivateRecord(props, PRESET_TABLE, board.recordId);   // a setup edited from the old table moves for good
        return { where: 'dataverse', error: "", refused: w.refused, sent: { table: PLAN_TABLE, name: boardName(p) }, recordId: w.board.recordId || "" };
    }
    const local = lsReadPresets(), k = presetKey(board.crew, board.slotStart); local[k] = { ...board, recordId: undefined, where: 'device' };
    const kept = lsWritePresets(local);
    return { where: 'device', error: kept ? w.error : `${w.error} (and this browser would not keep it either)`, refused: w.refused, sent: { table: PLAN_TABLE }, recordId: "" };
}

