        rows.forEach(r => { if (!byGuid.has(r.guid) || r.rev > (byGuid.get(r.guid) as AsgRow).rev) byGuid.set(r.guid, r); });
        const used = new Set<string>(), out: Record<string, AsgPiece[]> = {};
        shown.forEach(room => {
            const scope = mssCleanScope(room.cleanType), list: AsgPiece[] = [];
            if (scope) mssPiecesFor({ areaId: room.areaId, areaName: room.name, cleanType: room.cleanType, assets, cleanedBy: '', totalAreaHrs: 0 }).forEach((a: any) => {
                const guid = assetGuidOf(a);
