// Helper to gather all strength dictionaries for an employee across ID, raw name, formatted name, and personKey.
function empStrengthSources(h: History | null, empId: string, empName: string): Record<string, number>[] {
    if (!h || !h.strength) return [];
    const out: Record<string, number>[] = [];
    const seen = new Set<string>();
    const addKey = (k: string) => {
        if (!k || seen.has(k)) return;
        seen.add(k);
        const s = h.strength[k];
        if (s) out.push(s);
    };
    if (empId) addKey(String(empId).replace(/[{}]/g, '').trim().toLowerCase());
    if (empName) {
        addKey(normText(empName));
        addKey(normText(formatFullName(empName)));
        const pk = personKey(empName);
        if (pk) addKey('pk:' + pk);
    }
    return out;
}

// How many shifts a person has worked a room (looked up by employee id, raw name, formatted name, and personKey).
function shiftsInArea(h: History | null, empId: string, empName: string, areaName: string): number {
    if (!h || !areaName) return 0;
    const a = normText(areaName);
    const ck = 'ck:' + cleanAreaKey(areaName);
    const srcs = empStrengthSources(h, empId, empName);
    let best = 0;
    srcs.forEach(src => {
        if (src[a] && src[a] > best) best = src[a];
        if (ck !== 'ck:' && src[ck] && src[ck] > best) best = src[ck];
    });
    return best;
}
function strengthTier(days: number): { label: string; pct: number; color: string } {
    const safeDays = Math.max(0, days);
    const pct = safeDays <= 0 ? 0.08 : Math.max(0.18, Math.min(1, safeDays / HIST_FULL_DAYS));
    return safeDays >= HIST_FULL_DAYS
        ? { label: tx('Strong', 'Fuerte'), pct: 1, color: BRAND.blueDark }
        : safeDays >= 2
            ? { label: tx('Familiar', 'Conoce'), pct, color: BRAND.blue }
            : safeDays === 1
                ? { label: tx('Learning', 'Aprendiendo'), pct, color: BRAND.yellow }
                : { label: tx('No history', 'Sin historial'), pct, color: '#94A3B8' };
}
// The rooms a person has worked most (names are the normalised room names).
function strongestAreas(h: History | null, empId: string, empName: string, limit: number): { area: string; days: number }[] {
    if (!h) return [];
    const merged: Record<string, number> = {}, srcs = empStrengthSources(h, empId, empName);
    srcs.forEach(src => {
        Object.keys(src).forEach(a => {
            if (a.indexOf('ck:') === 0) return;
            merged[a] = Math.max(merged[a] || 0, src[a]);
        });
    });
    return Object.keys(merged).map(a => ({ area: a, days: merged[a] })).sort((x, y) => y.days - x.days || (x.area < y.area ? -1 : x.area > y.area ? 1 : 0)).slice(0, limit);
