    useEffect(() => {
        let thread: ChatEntry[] = [], log: ChatLogRow[] = [];
        if (chatKey) { try { const raw = window.localStorage.getItem(chatKey), o = raw ? JSON.parse(raw) : null; if (o && Array.isArray(o.thread)) thread = o.thread.slice(-30); if (o && Array.isArray(o.log)) log = o.log.slice(-200); } catch (e) { /* storage blocked: the chat still works for this session */ } }
        chatSeq.current = thread.reduce((m, x) => Math.max(m, x.id), 0) + 1; chatUndo.current = null;
