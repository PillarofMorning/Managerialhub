export function MainComponent(props: any) {
    const propsRef = useRef(props); useEffect(() => { propsRef.current = props; }, [props]);

    const [msUser, setMsUser] = useState<any>(null);
    const [presetsApplied, setPresetsApplied] = useState(false);
    const [hasAutoAssignedEveryday, setHasAutoAssignedEveryday] = useState(false);
    const [collapsedBuckets, setCollapsedBuckets] = useState<Set<string>>(new Set());
    const [currentStep, setCurrentStep] = useState(0);
    const [currentShift, setCurrentShift] = useState("");          // from craa5_workshift
    const [shiftStartMs, setShiftStartMs] = useState(0);
    const [appHeight, setAppHeight] = useState(window.innerHeight);
    const [isLoading, setIsLoading] = useState(true);   // the saved assignments are read on every open, so there is always a short load
    const [adminMode, setAdminMode] = useState(false);
    const [currentUser, setCurrentUser] = useState<any>(null);
    const [selectedSupervisorId, setSelectedSupervisorId] = useState<string | null>(null);

    // Core collections
    const [supervisors, setSupervisors] = useState<any[]>([]);
    const [leads, setLeads] = useState<any[]>([]);
    const [employees, setEmployees] = useState<any[]>([]);
    const [allEmployees, setAllEmployees] = useState<any[]>([]);
    const [areas, setAreas] = useState<any[]>([]);
    const [presetRecords, setPresetRecords] = useState<any[]>([]);

    // Board
    const [customLeads, setCustomLeads] = useState<any[]>([]);
    const [selectedLeadIds, setSelectedLeadIds] = useState<Set<string>>(new Set());
    const [customEmployees, setCustomEmployees] = useState<any[]>([]);
    const [customAreas, setCustomAreas] = useState<any[]>([]);
    const [selectedAreaIds, setSelectedAreaIds] = useState<Set<string>>(new Set());
    const [empSearchText, setEmpSearchText] = useState("");
    const [searchSuggestions, setSearchSuggestions] = useState<any[]>([]);
    const [areaAssignments, setAreaAssignments] = useState<Record<string, string>>({});
    const [assignments, setAssignments] = useState<Record<string, string[]>>({});
    const [areaDetails, setAreaDetails] = useState<Record<string, { currentStatus: string, futureNotes: string, includeInUpdate?: boolean }>>({});
    const [employeeStartTimes, setEmployeeStartTimes] = useState<Record<string, string>>({});
    const [currentTime, setCurrentTime] = useState(Date.now());

    const [clipboardFormat, setClipboardFormat] = useState<"headcount" | "initials" | "fullname">("headcount");
    const [disableAutoLogin, setDisableAutoLogin] = useState(false);
    const [saveSuccess, setSaveSuccess] = useState(false);
    const [saveWarning, setSaveWarning] = useState("");
    const [submissionError, setSubmissionError] = useState<string | null>(null);
    const [busyLabel, setBusyLabel] = useState("Loading shift...");
    const [taskStatus, setTaskStatus] = useState<TaskStatus | null>(null);                        // how the last read of the saved assignments went
    const [boardNote, setBoardNote] = useState<{ tone: 'ok' | 'none'; text: string } | null>(null);   // how the board got its contents

    const steps = ["Leads", "Areas", "Assign Areas", "Assign Employees", "Update Teams"];
    const allKnownEmps = useMemo(() => [...allEmployees, ...customEmployees, ...leads, ...customLeads], [allEmployees, customEmployees, leads, customLeads]);

    // Writes the area "include in update" flag (Xrm.WebApi, or the generative page's dataApi).
    const updateAreaRecord = useCallback((areaId: string, data: any) => {
        if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(areaId)) return;   // custom / status areas aren't in Dataverse
        const web = getWebApi(propsRef.current), dataApi = propsRef.current?.dataApi;
        const p = web?.updateRecord ? web.updateRecord("craa5_aa_mss_area", areaId, data) : dataApi?.updateRow ? dataApi.updateRow("craa5_aa_mss_area", areaId, data) : null;
        if (p) Promise.resolve(p).catch((e: any) => logError('Clipboard flag update failed', e?.message || e));
    }, []);

    const resolveUserIdentity = useCallback((u: any, ed: any[]) => {
        if (!u?.email) return null;
        const m = ed.find(e => getEmployeeEmail(e).toLowerCase().trim() === String(u.email).toLowerCase().trim());
        return m ? { ...m, calculatedRole: roleOf(m) } : null;
    }, []);

    const hydrateState = useCallback((c: any) => {
        if (!c) return;
        // Shift and user first: React 17 renders each set separately, and the board defaults read these.
        // The shift is worked out again every time the app opens, so a page that has been loaded for hours still knows which shift it is.
        const sh = findCurrentShift(c.slots || []);
        setCurrentShift(sh.crew); setShiftStartMs(sh.startMs); setMsUser(c.msUser || null);
        setAllEmployees(c.allEmployees || []); setSupervisors(c.supervisors || []); setLeads(c.leads || []); setAreas(c.areas || []); setTaskStatus(c.taskStatus || null); setPresetRecords(c.presetRecords || []);
        if (c.resolvedUser) {
            setCurrentUser(c.resolvedUser);
            if (c.resolvedUser.calculatedRole === 'manager') setAdminMode(true);
            else if (c.resolvedUser.calculatedRole === 'supervisor') setSelectedSupervisorId(getField(c.resolvedUser, 'craa5__aa_employeeid'));
        } else if ((c.msUser?.email || '').toLowerCase().includes('admin') || (c.msUser?.name || '').toLowerCase().includes('dev')) setAdminMode(true);
    }, []);

    // Empties the board (and the rows it was built from) so the next supervisor's saved rows can be rebuilt into it.
    const resetBoard = useCallback(() => {
        setPresetsApplied(false); setHasAutoAssignedEveryday(false); setPresetRecords([]); setBoardNote(null); setSaveSuccess(false); setSaveWarning(""); setSubmissionError(null);
        setSelectedLeadIds(new Set()); setSelectedAreaIds(new Set()); setAreaAssignments({}); setAssignments({}); setAreaDetails({}); setEmployeeStartTimes({}); setCustomLeads([]); setCustomAreas([]); setCustomEmployees([]); setCurrentStep(0);
    }, []);

    // View As: another supervisor's board, rebuilt from what they saved — the same as if they had opened the app themselves.
    const switchBoard = useCallback(async (supId: string) => {
        if (!supId) return;
        setDisableAutoLogin(true); resetBoard(); setSelectedSupervisorId(supId);
        if (GLOBAL_DATA_CACHE?.slots) { const sh = findCurrentShift(GLOBAL_DATA_CACHE.slots); setCurrentShift(sh.crew); setShiftStartMs(sh.startMs); }
        setBusyLabel("Reading saved assignments..."); setIsLoading(true);
        try {
            const t = await readSavedAssignments(propsRef.current);
            if (GLOBAL_DATA_CACHE) GLOBAL_DATA_CACHE = { ...GLOBAL_DATA_CACHE, presetRecords: t.recent, taskStatus: t.status };
            setTaskStatus(t.status); setPresetRecords(t.recent);
        } catch (e: any) { logError('Reading saved assignments failed', e?.message || e); setTaskStatus({ ok: false, error: String(e?.message || e), source: "", read: 0 }); }
        finally { setIsLoading(false); }
    }, [resetBoard]);

    useEffect(() => { const i = setInterval(() => setCurrentTime(Date.now()), 60000); return () => clearInterval(i); }, []);
    useEffect(() => { const r = () => setAppHeight(window.innerHeight); window.addEventListener('resize', r); return () => window.removeEventListener('resize', r); }, []);

    const formatDuration = useCallback((iso?: string) => {
        if (!iso) return "0m"; const ms = new Date(iso).getTime(); if (isNaN(ms)) return "0m";
        return formatMsToDurationStr(currentTime - Math.max(ms, shiftStartMs));
    }, [currentTime, shiftStartMs]);

    // Fast lookups
    const employeeMap = useMemo(() => { const m = new Map(); allKnownEmps.forEach(e => { const id = getField(e, 'craa5__aa_employeeid') || getField(e, 'craa5_aa_employeeid'); if (id) m.set(id, e); }); return m; }, [allKnownEmps]);
    const areaMap = useMemo(() => { const m = new Map(); [...areas, ...customAreas].forEach(a => { const aId = getField(a, 'craa5_aa_mss_areaid'); if (aId) m.set(aId, a); }); return m; }, [areas, customAreas]);
    const unselectedAvailableLeads = useMemo(() => leads.filter(l => !selectedLeadIds.has(getField(l, 'craa5__aa_employeeid')) && !isEmployeeUtilized(l)), [leads, selectedLeadIds]);

    // Available staff: hides anyone whose latest task this shift (and the prep hour before it) is still open; the shift before is over, so its open rows don't count
    const availableStaff = useMemo(() => {
        const latestEmpState = new Map(), liveFrom = shiftStartMs ? shiftStartMs - SHIFT_PREP_MS : 0;
        presetRecords.filter((t: any) => taskTime(t) >= liveFrom).sort(byTaskTime).forEach((t: any) => {
            const eName = (getField(t, 'craa5_id') || "").trim();
            const eGuid = getField(t, 'craa5__aaemp_guid') || getField(t, 'craa5_aaemp_guid') || "";
            const empKey = (eGuid || eName).toLowerCase();
            if (!empKey || empKey.includes('unassigned')) return;
            latestEmpState.set(empKey, { task: t, eGuid, eName });
        });
        const activeDbGuids = new Set<string>(), activeDbNames = new Set<string>();
        Array.from(latestEmpState.values()).forEach((s: any) => {
            if (isTaskDone(s.task)) return;
            if (s.eGuid) activeDbGuids.add(s.eGuid.toLowerCase());
            if (s.eName) activeDbNames.add(s.eName.toLowerCase());
        });
        const assignedIds = new Set(Object.values(assignments).flat().map(id => String(id).toLowerCase()));
        const customIds = new Set(customEmployees.map(ce => String(getField(ce, 'craa5__aa_employeeid')).toLowerCase()));
        return [...employees, ...customEmployees, ...unselectedAvailableLeads].filter((e: any) => {
            const eId = String(getField(e, 'craa5__aa_employeeid') || getField(e, 'craa5_aa_employeeid') || "").toLowerCase();
            const eName = String(getField(e, 'craa5_name') || "").toLowerCase().trim();
            if (selectedLeadIds.has(eId) || assignedIds.has(eId)) return false;
            if (!customIds.has(eId) && (activeDbGuids.has(eId) || activeDbNames.has(eName) || isEmployeeUtilized(e))) return false;
            return true;
        });
    }, [employees, customEmployees, unselectedAvailableLeads, presetRecords, selectedLeadIds, assignments, shiftStartMs]);

    const activeBuckets = useMemo(() => {
        const m = new Map(); const s = supervisors.find(x => getField(x, 'craa5__aa_employeeid') === selectedSupervisorId); if (s) m.set(getField(s, 'craa5__aa_employeeid'), s);
        [...leads, ...customLeads].forEach(l => { const id = getField(l, 'craa5__aa_employeeid'); if (selectedLeadIds.has(id) && id !== selectedSupervisorId) m.set(id, l); });
        return Array.from(m.values());
    }, [supervisors, leads, customLeads, selectedLeadIds, selectedSupervisorId]);
    const activeSupervisorObj = useMemo(() => supervisors.find(s => getField(s, 'craa5__aa_employeeid') === selectedSupervisorId), [supervisors, selectedSupervisorId]);
    // The line under the title: whether the saved board could be read, and what it was rebuilt with.
    const headerNote = useMemo((): { tone: 'ok' | 'none' | 'error'; text: string } | null => {
        if (!selectedSupervisorId || isLoading || !taskStatus) return null;
        if (!taskStatus.ok) return { tone: 'error', text: `Saved assignments could not be read (${String(taskStatus.error).slice(0, 140)})` };
        if (boardNote) return boardNote;
        return presetRecords.length === 0 ? { tone: 'none', text: noSavedNote(0, shiftStartMs, false) } : null;
    }, [selectedSupervisorId, isLoading, taskStatus, boardNote, presetRecords, shiftStartMs]);

    // Tailwind runtime
    useEffect(() => { if (!document.getElementById('tailwind-cdn')) { const s = document.createElement('script'); s.id = 'tailwind-cdn'; s.src = 'https://cdn.tailwindcss.com'; document.head.appendChild(s); } }, []);

    // Failsafe: never leave the user stuck behind the loading screen
    useEffect(() => { if (!isLoading) return; const f = setTimeout(() => { logError('Loading took over 15s; unlocking the screen.'); setIsLoading(false); setAdminMode(true); }, 15000); return () => clearTimeout(f); }, [isLoading]);

    // --- LOAD ---
    // Employees, areas and the work shift are read once per session (remounts reuse them). The saved assignments are read
    // again every time the app opens or resets, so the board always comes back the way it was last saved.
    useEffect(() => {
        if (GLOBAL_INIT_STATUS === 'FETCHING') {
            const i = setInterval(() => {
                if (GLOBAL_INIT_STATUS === 'FETCHING') return;
                clearInterval(i); if (GLOBAL_INIT_STATUS === 'COMPLETE') hydrateState(GLOBAL_DATA_CACHE); setIsLoading(false);
            }, 200);
            return () => clearInterval(i);
        }

        const loadEverything = async () => {
            const cached = GLOBAL_INIT_STATUS === 'COMPLETE' && !!GLOBAL_DATA_CACHE;
            setBusyLabel(cached ? "Reading saved assignments..." : "Loading shift..."); setIsLoading(true);
            try {
                const p = propsRef.current;
                if (cached) {
                    const saved = await readSavedAssignments(p);
                    GLOBAL_DATA_CACHE = { ...GLOBAL_DATA_CACHE, presetRecords: saved.recent, taskStatus: saved.status };
                    hydrateState(GLOBAL_DATA_CACHE);
                    return;
                }

                GLOBAL_INIT_STATUS = 'FETCHING';
                // Microsoft account of whoever opened the app
                const ctx = p.context?.userSettings, xrm = safeGetXrm();
                let uName = ctx?.userName || p.userName, uId = ctx?.userId || p.userId, uEmail = ctx?.email || p.userEmail;
                if ((!uName || !uId) && xrm?.Utility) { try { const xc = xrm.Utility.getGlobalContext().userSettings; uName = uName || xc.userName; uId = uId || xc.userId; } catch (e) {} }
                if (uName) {
                    if (!uEmail && uId && xrm?.WebApi) { try { const u = await asyncRace(xrm.WebApi.retrieveRecord("systemuser", String(uId).replace(/[{}]/g, ''), "?$select=internalemailaddress"), 4000, "systemuser email"); if (u?.internalemailaddress) uEmail = u.internalemailaddress; } catch (e) {} }
                } else { uName = "Local Developer"; uEmail = "dev@localhost"; uId = "DEV-MODE-ID"; }
                const msUser = { name: uName, email: uEmail || "", id: uId };

                const [empRaw, areaRaw, shiftRows, saved] = await Promise.all([
                    fetchFallbackRecords(["craa5__aa_employee", "craa5_aa_employee", "craa5__aa_employees"], p),
                    fetchFallbackRecords(["craa5_aa_mss_area", "craa5_aa_mss_areas"], p),
                    fetchFallbackRecords("craa5_workshift", p),
                    readSavedAssignments(p),
                ]);
                const empData = empRaw.length ? empRaw : (p.inputEmployees || []);
                const areaData = areaRaw.length ? areaRaw : (p.inputAreas || []);
                const slots = parseWorkShiftRows(shiftRows);
                if (!findCurrentShift(slots).crew) logError('No craa5_workshift row covers the current time; shift left blank.');

                const sups = empData.filter((e: any) => roleOf(e) === 'supervisor').sort((a: any, b: any) => (getField(a, 'craa5_name') || "").localeCompare(getField(b, 'craa5_name') || ""));
                const lds = empData.filter((e: any) => roleOf(e) === 'lead');

                GLOBAL_DATA_CACHE = { allEmployees: empData, supervisors: sups, leads: lds, areas: areaData, presetRecords: saved.recent, taskStatus: saved.status, msUser, slots, resolvedUser: resolveUserIdentity(msUser, empData) };
                GLOBAL_INIT_STATUS = 'COMPLETE'; hydrateState(GLOBAL_DATA_CACHE);
            } catch (e: any) { logError('Loading failed', e?.message || e); GLOBAL_INIT_STATUS = GLOBAL_DATA_CACHE ? 'COMPLETE' : 'IDLE'; } finally { setIsLoading(false); }
        };
        loadEverything();
    // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [hydrateState]);

    // Shift staff for the selected supervisor
    useEffect(() => {
        if (!selectedSupervisorId || supervisors.length === 0 || allEmployees.length === 0) return;
        const sup = supervisors.find(s => getField(s, 'craa5__aa_employeeid') === selectedSupervisorId); if (!sup) return;
        const crew = crewOf(sup, allEmployees, currentShift);
        setLeads(crew.leads); setEmployees(crew.employees);
    }, [selectedSupervisorId, supervisors, allEmployees, currentShift]);

    // Default board: supervisors get their own (set at sign-in); everyone else — leads, managers, the app owner — lands on the
    // supervisor on shift now. The shift letters in craa5_workshift and in the employee table don't always line up, so when the
    // supervisor matched by letter has saved nothing this shift but another supervisor has, the one who saved is on shift.
    useEffect(() => {
        if (isLoading || disableAutoLogin || supervisors.length === 0 || selectedSupervisorId) return;
        const byLetter = (l: string) => (l ? supervisors.find(s => getShiftOf(s) === l) : undefined);
        const since = shiftStartMs || Date.now() - 4 * 3600000;   // saves made during this shift (the last hour of the shift before is the outgoing supervisor's)
        const savedSince = (s: any, from: number) => presetRecords.some(r => taskTime(r) >= from && rowBelongsTo(r, s));
        const newestSaver = (from: number) => {
            let best: any = null, bestT = 0;
