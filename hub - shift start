// ============================================================================
// DATAVERSE ACCELERATOR: INSTANT STARTUP BUNDLE (RN-03)
// Consolidates 6-8 separate client-side OData queries (employees, areas, workshifts,
// teams, saved assignments, presets, assets) into a single server-side Dataverse
// Accelerator Instant Plugin execution (<150ms).
// Supported candidate operations: new_GetShiftStartupBundle, craa5_GetShiftStartupBundle, GetShiftStartupBundle.
// Falls back seamlessly to parallel/sequential OData table queries if uninstalled.
// ============================================================================
let LAST_BUNDLE_SOURCE = 'initial';

type ShiftStartupBundle = {
    employees: any[];
    areas: any[];
    slots: Slot[];
    teams: TeamRow[];
    teamsRead: number;
    presetRecords: any[];
    taskStatus: TaskStatus;
    presets: PresetBoard[];
    presetStore: PresetStore;
    assets: any[];
    source: string;
};

function parseDelimitedBundle(rawStr: string): any {
    if (!rawStr || typeof rawStr !== 'string') return null;
    const trimmed = rawStr.trim();
    if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
        try { return JSON.parse(trimmed); } catch (e) {}
    }
    const lines = trimmed.split(/\r?\n/);
    let section = '';
    const areas: any[] = [];
    const employees: any[] = [];
    const workshifts: any[] = [];
    const teams: any[] = [];

    for (const l of lines) {
        const line = l.trim();
        if (!line) continue;
        if (line.startsWith('===') && line.endsWith('===')) {
            section = line.replace(/=/g, '').toUpperCase().trim();
            continue;
        }
        const parts = line.split('|');
        if (section === 'AREAS') {
            const isProd = parts[2] === '1' || parts[2]?.toLowerCase() === 'true';
            areas.push({
                craa5_aa_mss_areaid: parts[0] || '',
                craa5_area: parts[1] || '',
                craa5_runsproduct: isProd,
