function copyTextToClipboard(text: string) { if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).catch(() => fallbackCopy(text)); else fallbackCopy(text); }
function fallbackCopy(text: string) { const ta = document.createElement("textarea"); ta.value = text; ta.style.cssText = "top:0;left:0;position:fixed;"; document.body.appendChild(ta); ta.focus(); ta.select(); try { document.execCommand('copy'); } catch (err) { logError('Fallback copy failed', err); } document.body.removeChild(ta); }
const asyncRace = (p: any, ms: number, l: string): Promise<any> => { if (!p) return Promise.reject(new Error(`No query for ${l}`)); let t: any; return Promise.race([Promise.resolve(p), new Promise((_, r) => { t = setTimeout(() => r(new Error(`TIMEOUT: ${l}`)), ms); })]).finally(() => clearTimeout(t)); };
function safeGetXrm() { if (typeof window === 'undefined') return null; if ((window as any).Xrm) return (window as any).Xrm; try { if (window.parent && (window.parent as any).Xrm) return (window.parent as any).Xrm; } catch (e) {} return null; }
function getWebApi(props: any) { const xrm = safeGetXrm(); if (xrm?.WebApi) return xrm.WebApi; if (props?.context?.webAPI) return props.context.webAPI; return props?.webAPI || null; }
const formatFullName = (n?: string | null) => { if (!n) return ""; const p = n.split(","); return p.length > 1 ? `${p.slice(1).join(",").trim()} ${p[0].trim()}` : n.trim(); };
const renderSafe = (v: any) => v === null || v === undefined ? "" : typeof v === 'object' ? String(v.Label || v.Value || v.name || JSON.stringify(v)) : String(v);

// Crew letter from a choice value, number or label ("256000001", "2", "B", "Shift B").
function normalizeShift(val: any): string {
    if (val === undefined || val === null || val === "") return "";
    const s = String(typeof val === 'object' ? (val.Label || val.Value || val.name || '') : val).toUpperCase().trim();
    if (s.includes("256000000") || s === "1") return "A";
    if (s.includes("256000001") || s === "2") return "B";
    if (s.includes("256000002") || s === "3") return "C";
    if (s.includes("256000003") || s === "4") return "D";
    const m = s.match(/(?:^|[^A-Z])([ABCD])(?=$|[^A-Z])/);
    return m ? m[1] : "";
}

function getField(obj: any, fn: string) {
    if (!obj) return undefined; if (obj[fn] !== undefined) return obj[fn];
    const lf = fn.toLowerCase(), k = Object.keys(obj).find(x => x.toLowerCase() === lf);
    return k ? obj[k] : undefined;
}
const getFormattedField = (obj: any, fn: string) => getField(obj, `${fn}@OData.Community.Display.V1.FormattedValue`);
const getShiftOf = (e: any) => normalizeShift(getFormattedField(e, 'craa5_shift') || getField(e, 'craa5_shift'));
const isBoolTrue = (v: any) => v === true || v === 1 || String(v).toLowerCase() === "yes" || String(v).toLowerCase() === "true";
const isEmployeeUtilized = (e: any) => isBoolTrue(getField(e, 'craa5_utilized') ?? getFormattedField(e, 'craa5_Utilized'));
const isProductionArea = (a: any) => isBoolTrue(getField(a, 'craa5_production') ?? getFormattedField(a, 'craa5_production'));
const isEverydayArea = (a: any) => isBoolTrue(getField(a, 'craa5_everyday') ?? getFormattedField(a, 'craa5_everyday'));
// Whole words only, so rooms like "Chocolate" or "Plate Room" aren't mistaken for "Late".
const isStatusArea = (n?: string) => /\b(pto|sick|late|left early)\b/.test(String(n || "").toLowerCase().trim());
const getEmployeeEmail = (e: any) => getField(e, 'craa5_email') || getField(e, 'emailaddress1') || getField(e, 'internalemailaddress') || "";
const getEmployeeBadge = (e: any) => getField(e, 'craa5_badgenumber') || getField(e, 'badgenumber') || "";
const roleOf = (e: any) => { const r = String(getFormattedField(e, 'craa5_role') || getField(e, 'craa5_role') || '').toLowerCase(); return /lead|256000001/.test(r) ? 'lead' : /super|256000002/.test(r) ? 'supervisor' : /manag|256000003/.test(r) ? 'manager' : 'employee'; };
const formatMsToDurationStr = (ms: number) => ms < 0 ? "0m" : `${Math.floor(ms/3600000) > 0 ? Math.floor(ms/3600000)+'h ' : ''}${Math.floor((ms%3600000)/60000)}m`;
const getInputValue = (e: any, d: any) => typeof d === 'string' ? d : d?.value ?? e?.target?.value ?? "";
const getSelectionValue = (e: any, d: any): Set<any> => d?.selectedItems ?? e?.target?.selectedItems ?? new Set();
const getAreaEmoji = (areaObj: any) => { if (!areaObj) return ""; const em = getField(areaObj, 'craa5_emoji') || getFormattedField(areaObj, 'craa5_emoji'); return em ? ` ${em}` : ""; };

const isTaskDone = (r: any) =>
    getField(r, 'craa5_percentagecomplete') === 100 || isBoolTrue(getField(r, 'craa5_complete')) || getField(r, 'statecode') === 1 ||
    String(getField(r, 'craa5_whatisbeingdone') || getField(r, 'craa5__currentstatus')).trim().toLowerCase() === "completed";
const taskTime = (r: any) => new Date(getField(r, 'craa5_datetimeofassignment') || getField(r, 'createdon') || 0).getTime();
// Oldest first; on a tie the completed row comes first so the open one wins.
const byTaskTime = (a: any, b: any) => (taskTime(a) - taskTime(b)) || ((isTaskDone(b) ? 1 : 0) - (isTaskDone(a) ? 1 : 0));
const normText = (v: any) => String(v ?? "").replace(/\s+/g, " ").trim().toLowerCase();
const sameText = (a: any, b: any) => normText(a) === normText(b);

// The letter the employee table uses for the crew that craa5_workshift calls A-D. Same letters today; change a line here if
// the two tables ever label a crew differently (for example { A: 'A', B: 'C', C: 'B', D: 'D' }).
const CREW_OF_WORKSHIFT: Record<string, string> = { A: 'A', B: 'B', C: 'C', D: 'D' };
const crewLetterOf = (workshiftLetter: string) => (workshiftLetter ? (CREW_OF_WORKSHIFT[workshiftLetter] || workshiftLetter) : "");

// ============================================================================
// LEADERSHIP TEAMS (craa5__aa_leadershipteam: one row per crew, A-D)
// craa5_teamname = the crew letter, _craa5_teamleademployeeid_value = the team lead (the supervisor of that crew, whatever their role is).
// Employees point at their crew with _craa5_leadershipteamid_value; when that is empty the shift letter on the employee decides.
// craa5_active is false on every row in Gerald's table, so it is never used as a filter.
// ============================================================================
type TeamRow = { id: string; letter: string; leadId: string };
const TEAM_TABLES = ["craa5__aa_leadershipteam", "craa5_aa_leadershipteam", "craa5__aa_leadershipteams"];
let TEAMS: TeamRow[] = [];   // the teams as last read; the crew helpers below look people up in it (empty = shift letters only, as before)
const lookupId = (v: any): string => String((v && typeof v === 'object' ? (v.id || v.Id || v.guid || v.value || "") : v) || "").replace(/[{}]/g, "").trim().toLowerCase();
const empIdOf = (e: any) => lookupId(getField(e, 'craa5__aa_employeeid') ?? getField(e, 'craa5_aa_employeeid'));
const teamIdOfEmp = (e: any) => lookupId(getField(e, '_craa5_leadershipteamid_value') ?? getField(e, 'craa5_leadershipteamid'));
function parseTeams(rows: any[]): TeamRow[] {
    const out: TeamRow[] = [];
    (rows || []).forEach(r => {
        const id = lookupId(getField(r, 'craa5__aa_leadershipteamid') ?? getField(r, 'craa5_aa_leadershipteamid') ?? getField(r, 'craa5_leadershipteamid'));
        const letter = normalizeShift(getField(r, 'craa5_teamname')), leadId = lookupId(getField(r, '_craa5_teamleademployeeid_value') ?? getField(r, 'craa5_teamleademployeeid'));
        if (id && letter && !out.some(t => t.letter === letter)) out.push({ id, letter, leadId });
    });
    return out;
}
const teamLedBy = (e: any): TeamRow | undefined => { const id = empIdOf(e); return id ? TEAMS.find(t => t.leadId === id) : undefined; };
// The crew a person belongs to: the team they lead, else the team on their lookup, else their shift letter.
function crewOfPerson(e: any): string {
    const led = teamLedBy(e); if (led) return led.letter;
    const tid = teamIdOfEmp(e), t = tid ? TEAMS.find(x => x.id === tid) : undefined;
    return t ? t.letter : getShiftOf(e);
}
// A supervisor is anyone with the supervisor role, or who leads a team in the teams table.
const isSupervisorLike = (e: any) => roleOf(e) === 'supervisor' || !!teamLedBy(e);
// A signed-in person with the role the app treats them as: a team lead who isn't a manager is a supervisor, whatever their role column says.
const withCalculatedRole = (m: any) => ({ ...m, calculatedRole: roleOf(m) !== 'manager' && teamLedBy(m) ? 'supervisor' : roleOf(m) });
// 'Last, First M' and 'First M Last' (a Microsoft display name) both reduce to 'first last', so the two can be compared.
function personKey(n: any): string {
    const s = String(n ?? "").trim(); if (!s) return "";
    const toks = (t: string) => t.toLowerCase().replace(/[^a-z\s'-]/g, " ").split(/\s+/).filter(Boolean);
    let first: string[], last: string[];
    if (s.indexOf(",") >= 0) { const i = s.indexOf(","); last = toks(s.slice(0, i)); first = toks(s.slice(i + 1)); }
    else { const t = toks(s); first = t.slice(0, 1); last = t.slice(-1); if (t.length < 2) return ""; }
    return first.length && last.length ? `${first[0]} ${last[last.length - 1]}` : "";
}
// The supervisor to open for a crew: the team's lead, else a listed supervisor on that letter, else anyone listed on it (a manager acting).
function supervisorOfCrew(sups: any[], letter: string): any {
    if (!letter) return undefined;
    const t = TEAMS.find(x => x.letter === letter), lead = t && t.leadId ? sups.find(s => empIdOf(s) === t.leadId) : undefined;
    return lead || sups.find(s => roleOf(s) === 'supervisor' && crewOfPerson(s) === letter) || sups.find(s => crewOfPerson(s) === letter);
}

const EMPLOYEE_TABLES = ["craa5__aa_employee", "craa5_aa_employee", "craa5__aa_employees"];
// The supervisors: everyone with the supervisor role plus every team lead (whatever their role), by name.
const supervisorsOf = (everyone: any[]) => everyone.filter(isSupervisorLike).sort((a: any, b: any) => (getField(a, 'craa5_name') || "").localeCompare(getField(b, 'craa5_name') || ""));

// The employee-table letter a board draws its leads and employees from. The work schedule decides which crew is on now: a supervisor
// listed on that crew (or, for a listed supervisor, on the one about to start, while setting up) uses their own letter; anyone else
// (a manager acting, or a supervisor listed under another letter) gets the crew on the clock. With no shift known it is the supervisor's own letter.
function crewLetterFor(sup: any, everyone: any[], onNow: string, upNext: string): string {
    const own = crewOfPerson(sup), has = (l: string) => !!l && everyone.some(e => crewOfPerson(e) === l);
    if (has(own) && (own === onNow || (own === upNext && isSupervisorLike(sup)))) return own;
    if (has(onNow)) return onNow;
    return has(own) ? own : "";
}

// Everyone on that crew (everyone, if that letter matches nobody), except the board's own supervisor.
function crewOf(sup: any, everyone: any[], onNow: string, upNext: string) {
    const letter = crewLetterFor(sup, everyone, onNow, upNext), supId = getField(sup, 'craa5__aa_employeeid');
    const staff = letter ? everyone.filter(e => crewOfPerson(e) === letter) : everyone;
    return {
        letter,
        leads: staff.filter(e => roleOf(e) === 'lead' && getField(e, 'craa5__aa_employeeid') !== supId),
        employees: staff.filter(e => roleOf(e) !== 'lead' && roleOf(e) !== 'supervisor' && getField(e, 'craa5__aa_employeeid') !== supId),
    };
}

// A manager can run a shift that no supervisor is listed for: the manager who opened the app, and any manager who has saved a board in
// the last 24 hours (so others can reach it), join the supervisor list, last, so a real supervisor on the same letter is always found first.
function withActingManagers(sups: any[], user: any, everyone: any[], rows: any[]): any[] {
    const out = sups.slice(), have: Record<string, boolean> = {};
    sups.forEach(x => { have[String(getField(x, 'craa5__aa_employeeid'))] = true; });
    const add = (e: any) => { const id = String(getField(e, 'craa5__aa_employeeid') || ""); if (id && !have[id]) { have[id] = true; out.push(e); } };
    everyone.forEach(e => { if (roleOf(e) === 'manager' && rows.some(r => rowBelongsTo(r, e))) add(e); });
    if (user && user.calculatedRole === 'manager') add(user);
    return out;
}

// ============================================================================
// SAVED ASSIGNMENTS (craa5_taskassignment)
// Save Progress writes one row per person per area (plus an empty row for an area nobody is in). Opening the app reads the last
// 24 hours and rebuilds a supervisor's board from the rows whose team is that supervisor and that were saved since the current
// shift began (minus the prep hour). When no shift covers the clock, the last 16 hours are used instead.
// Rows are matched by team, never by shift letter: the letter on a row comes from whichever app wrote it, and they don't agree.
// Save Progress still closes every open row of the team from the last 16 hours, so the old shift's rows never linger as open.
// ============================================================================
const TASK_TABLE = "craa5_taskassignment";
const TASK_FETCH_HOURS = 24;
const TASK_LOOKBACK_MS = 16 * 3600000;
const SHIFT_PREP_MS = 3600000;   // a board saved up to an hour before the shift began still counts for it (supervisors set up before clock-in)
const TASK_TIMEOUT_MS = 10000;
const TASK_COLUMNS = ['craa5_taskassignmentid', 'craa5_id', 'craa5_lead', 'craa5_area', 'craa5_starttime', 'craa5_endtime', 'craa5_datetimeofassignment', 'createdon', 'craa5_shift', 'craa5_team', 'craa5_percentagecomplete', 'craa5_complete', 'statecode', 'craa5__currentstatus', 'craa5_whatisbeingdone', 'craa5_whatislefttodo', 'craa5__future_or_notes', 'craa5_badgenumber', 'craa5_leademail', 'craa5_supervisoremail', 'craa5_uid_associated', 'craa5__aaemp_guid', 'craa5_email'];
// What the board itself needs; used when this environment refuses the longer list above (a column it doesn't have).
const TASK_CORE_COLUMNS = ['craa5_taskassignmentid', 'craa5_id', 'craa5_lead', 'craa5_area', 'craa5_starttime', 'craa5_endtime', 'craa5_datetimeofassignment', 'createdon', 'craa5_shift', 'craa5_team', 'craa5_percentagecomplete', 'craa5_complete', 'statecode', 'craa5_whatisbeingdone', 'craa5_whatislefttodo', 'craa5__aaemp_guid'];
const clockTime = (ms: number) => new Date(ms).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
// Why a board came up empty. shiftStart is 0 when no shift covers now; earlier is true when this supervisor has saves from before this shift.
const noSavedNote = (others: number, shiftStart: number, earlier: boolean) => {
    const ahead = shiftStart > Date.now();   // the crew starting within the hour: its shift has not begun, it is being got ready
    if (earlier) return ahead ? `New shift starts ${clockTime(shiftStart)}: nothing saved yet` : `New shift since ${clockTime(shiftStart)}: nothing saved yet`;
    const span = shiftStart ? (ahead ? `yet for this shift (starts ${clockTime(shiftStart)})` : `yet this shift (since ${clockTime(shiftStart)})`) : 'in the last 16 h';
    return others ? `Nothing saved for this supervisor ${span}; ${others} saved ${others === 1 ? 'row belongs' : 'rows belong'} to other teams` : `Nothing saved ${span}`;
};
const odataDate = (ms: number) => new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z');
const rowBelongsTo = (r: any, sup: any) => {
    const name = getField(sup, 'craa5_name'), email = getEmployeeEmail(sup);
    return (!!name && sameText(getField(r, 'craa5_team'), name)) || (!!email && sameText(getField(r, 'craa5_supervisoremail'), email));
};

type TaskStatus = { ok: boolean; error: string; source: string; read: number };

// Saved rows from the last 24 hours, newest first (only one team's when a team name is given). Each way of reading only falls through
// to the next when it fails; ok is false only when every way failed, so an empty list with ok = true really means nothing was saved.
async function fetchTaskRows(props: any, team: string = ""): Promise<{ rows: any[]; status: TaskStatus }> {
    const xrm = safeGetXrm(), webApi = getWebApi(props), dataApi = props?.dataApi, since = odataDate(Date.now() - TASK_FETCH_HOURS * 3600000), problems: string[] = [];
    const quoted = team.replace(/'/g, "''");
    const failed = (where: string, e: any) => { const m = String(e?.message || e || "failed"); logError(`Saved assignments via ${where}`, m); problems.push(`${where}: ${m}`); };
    const got = (rows: any[], source: string) => ({ rows, status: { ok: true, error: "", source, read: rows.length } });

    if (xrm?.WebApi?.retrieveMultipleRecords) {
        const attrs = TASK_COLUMNS.map(c => `<attribute name='${c}'/>`).join('');
        const fetchXml = `<fetch top='5000'><entity name='${TASK_TABLE}'>${attrs}<filter><condition attribute='createdon' operator='last-x-hours' value='${TASK_FETCH_HOURS}'/>${team ? `<condition attribute='craa5_team' operator='eq' value='${team.replace(/&/g, '&amp;').replace(/'/g, '&apos;').replace(/</g, '&lt;')}'/>` : ''}</filter><order attribute='createdon' descending='true'/></entity></fetch>`;
        try { const res: any = await asyncRace(xrm.WebApi.retrieveMultipleRecords(TASK_TABLE, `?fetchXml=${encodeURIComponent(fetchXml)}`), TASK_TIMEOUT_MS, "FetchXML"); if (Array.isArray(res?.entities)) return got(res.entities, "FetchXML"); failed("FetchXML", "no rows came back"); } catch (e: any) { failed("FetchXML", e); }
    }
    if (webApi?.retrieveMultipleRecords) {
        try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(TASK_TABLE, `?$select=${TASK_CORE_COLUMNS.join(',')}&$filter=createdon ge ${since}${team ? ` and craa5_team eq '${encodeURIComponent(quoted)}'` : ''}&$orderby=createdon desc&$top=5000`), TASK_TIMEOUT_MS, "OData"); if (Array.isArray(res?.entities)) return got(res.entities, "OData"); failed("OData", "no rows came back"); } catch (e: any) { failed("OData", e); }
    }
    if (dataApi?.queryTable) {
        try { return got(await queryDataApi(dataApi, TASK_TABLE, `createdon ge ${since}${team ? ` and craa5_team eq '${quoted}'` : ''}`), "data API"); } catch (e: any) { failed("data API", e); }
    }
    if (Array.isArray(props?.inputPresets) && props.inputPresets.length) return got(props.inputPresets, "page input");
    return { rows: [], status: { ok: false, error: problems.join("; ") || "no Dataverse connection", source: "", read: 0 } };
}

// The rows the board is built from (last 16 hours) and how the read went.
async function readSavedAssignments(props: any, team: string = ""): Promise<{ recent: any[]; status: TaskStatus }> {
    const { rows, status } = await fetchTaskRows(props, team), cutoff = Date.now() - TASK_LOOKBACK_MS;
    return { recent: rows.filter(r => taskTime(r) >= cutoff), status };
}

// ============================================================================
// CURRENT SHIFT (craa5_workshift: one row per slot — same rules as Ganttly)
// craa5_shiftcode (A–D), craa5_dayname / craa5_daynumber (1 = Sun), craa5_shiftstarthour / craa5_shiftendhour.
// Midnight is stored as 1, or every hour is stored +1 (1/7/13/19).
// ============================================================================
type Slot = { crew: string; day: number; startHour: number; lengthHours: number };
function parseWorkShiftRows(rows: any[]): Slot[] {
    const read = (r: any, n: string) => getFormattedField(r, n) ?? getField(r, n);
    const raw = rows.map(r => ({ crew: normalizeShift(read(r, 'craa5_shiftcode')), dayName: String(read(r, 'craa5_dayname') || ''), dayNum: parseInt(read(r, 'craa5_daynumber'), 10), startH: parseInt(read(r, 'craa5_shiftstarthour'), 10), endH: parseInt(read(r, 'craa5_shiftendhour'), 10) }));
    const hours: number[] = [];
    raw.forEach(x => { if (!isNaN(x.startH)) hours.push(x.startH); if (!isNaN(x.endH)) hours.push(x.endH); });
    const plusOne = hours.length > 0 && hours.every(h => h >= 1 && (h - 1) % 6 === 0);
    const hasZeroDay = raw.some(x => x.dayNum === 0);
    const fixHour = (h: number) => plusOne ? (h - 1 + 24) % 24 : (h === 1 || h === 24) ? 0 : ((h % 24) + 24) % 24;
    const slots: Slot[] = [], pending: Slot[] = [];
    raw.forEach(x => {
        const m = x.dayName.toLowerCase().match(/sun|mon|tue|wed|thu|fri|sat/);
        let day = m ? ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'].indexOf(m[0]) : (isNaN(x.dayNum) ? -1 : (hasZeroDay ? x.dayNum : x.dayNum - 1));
        if (!x.crew || day < 0 || isNaN(x.startH) || isNaN(x.endH)) return;
        day = ((day % 7) + 7) % 7;
        const sH = fixHour(x.startH), eH = fixHour(x.endH);
