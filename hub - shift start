    const lf = fn.toLowerCase();
    if (direct === undefined && obj[lf] !== undefined) direct = obj[lf];
    if (direct === undefined) {
        for (const x in obj) {
            if (Object.prototype.hasOwnProperty.call(obj, x) && x.toLowerCase() === lf) {
                direct = obj[x];
                break;
            }
        }
    }
    if (direct !== undefined && direct !== null && direct !== '') return direct;
    const alts = FIELD_ALIASES[lf];
    if (alts) {
        for (let i = 0; i < alts.length; i++) {
            const a = alts[i];
            if (obj[a] !== undefined && obj[a] !== null && obj[a] !== '') return obj[a];
            for (const x in obj) {
                if (Object.prototype.hasOwnProperty.call(obj, x) && x.toLowerCase() === a && obj[x] !== undefined && obj[x] !== null && obj[x] !== '') return obj[x];
