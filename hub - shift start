        // A plan loaded for this exact shift has now become this board: it is marked used and deactivated, so it is never offered again
        const lp = loadedPlanRef.current;
        if (lp && lp.recordId && Math.abs(lp.slotStart - savedBoard.slotStart) < 2 * 3600000) {
            const pe = lp.where === 'plan' ? await markPlanUsed(propsRef.current, lp.recordId, me, savedBoard.recordId || '') : lp.where === 'legacy' ? await deactivateRecord(propsRef.current, PRESET_TABLE, lp.recordId) : '';
