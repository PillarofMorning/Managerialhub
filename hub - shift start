                                                    <div style={{ marginTop: 12 }}>
                                                        <div style={{ fontSize: 11, fontWeight: 800, color: BRAND.blueDark, marginBottom: 4 }}>FROM GANTTLY (equipment cleaned and high fives)</div>
                                                        {(sel.updates.work || []).slice(0, 80).map((w, i) => <div key={'w' + i} style={{ fontSize: 11, color: '#475569' }}>{w.area} - {w.equipment || w.equipmentGuid}{w.doneAt ? ` - done ${clockTime(new Date(w.doneAt).getTime())}` : w.startedAt ? ` - started ${clockTime(new Date(w.startedAt).getTime())}` : ''} - {(w.workers || []).map(x => x.name).join(', ') || 'crew'}</div>)}
                                                        {(sel.updates.remarks || []).map((m, i) => <div key={'m' + i} style={{ fontSize: 11, color: '#475569' }}>{m.type === 'highfive' ? 'High five' : 'Remark'} for {m.employeeName} from {m.givenBy}{m.tag ? ` (${m.tag})` : ''}{m.text ? `: ${m.text}` : ''}</div>)}
