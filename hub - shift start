                            {checkingSchema ? "Refreshing Dataverse & Pulling Changes..." : "Refresh Schema & Pull Background Changes"}
                        </Button>
                        <Button size="small" appearance="secondary" onClick={() => { copyTextToClipboard(JSON.stringify({ msUser, slotCount, currentShift, boardCrew, taskStatus, employeesCount: employees.length, teamsCount: teams.length, liveProbeResults }, null, 2)); setCopyPasteFeedback("Copied diagnostic telemetry to clipboard!"); }}>
