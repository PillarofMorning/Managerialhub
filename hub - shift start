        if (!readStatus.ok) setSaveWarning(`The earlier assignments could not be read, so they were not closed (${String(readStatus.error).slice(0, 140)}).`);
        return true;
    } catch (err: any) {
        logError('Save Progress failed', err?.message || err);
        setSubmissionError(renderSafe(err?.message || err || "An unexpected error occurred while saving to Dataverse."));
