    const [busy, setBusy] = useState('');
    const [msg, setMsg] = useState<{ tone: 'ok' | 'warn' | 'err'; text: string } | null>(null);
    const [q, setQ] = useState('');
    const [showInactive, setShowInactive] = useState(false);
    const [sel, setSel] = useState<ShiftBoard | null>(null);
    const [selTable, setSelTable] = useState(BOARD_TABLE);
    const [rows, setRows] = useState<any[]>([]);
    const [dirty, setDirty] = useState(false);
    const [rawOpen, setRawOpen] = useState(false);
    const [raw, setRaw] = useState('');
    const [days, setDays] = useState('42');
    const [groups, setGroups] = useState<ImportGroup[]>([]);
    const [pick, setPick] = useState<Record<string, boolean>>({});
    const [progress, setProgress] = useState('');
    const [imported, setImported] = useState<ShiftBoard[]>([]);
    const [verified, setVerified] = useState<Record<string, boolean>>({});
    const [activity, setActivity] = useState<LogEntry[]>([]);
    const [actQ, setActQ] = useState('');
    const [actCat, setActCat] = useState<'all' | 'access' | 'save' | 'room' | 'admin'>('all');
    const [actOpen, setActOpen] = useState<number>(-1);
    const log = (action: string, extra: Partial<LogEntry> = {}) => logActivity(hostProps, { action, user: by, email: byEmail, role: 'full access', ...extra });

    const loadNames = useCallback(async (t: Tab = tab) => {
        if (t === 'import' || t === 'activity' || t === 'setup') return;
        setBusy('Loading...');
        const table = tableOf(t), r = await readRecordNames(hostProps, table, showInactive ? '' : 'statecode eq 0', 2000);
        setNames(r.list.sort((a, b) => parseBoardName(b.name).slotStart - parseBoardName(a.name).slotStart));
        if (r.error) setMsg({ tone: looksMissing(r.error) ? 'warn' : 'err', text: looksMissing(r.error) ? `The table ${table} does not exist yet. See the Table Setup tab.` : `Could not read ${table}: ${r.error}` });
        setBusy('');
    }, [hostProps, tab, showInactive]);
    useEffect(() => { setSel(null); setNames([]); setMsg(null); loadNames(tab); if (tab === 'activity') loadActivity(); if (tab === 'import') loadImported(); }, [tab, showInactive]); // eslint-disable-line react-hooks/exhaustive-deps

    const loadActivity = async () => { setBusy('Loading activity...'); const r = await readActivity(hostProps, 800); setActivity(r.list); setBusy(''); if (r.local) setMsg({ tone: 'warn', text: `The table ${LOG_TABLE} could not be read (${r.error}); showing what this computer kept.` }); };
    const loadImported = async () => { setImported(await readImportedPending(hostProps)); };

    const open = async (id: string, table: string = tableOf(tab)) => {
        if (dirty && !await askConfirm('Discard the unsaved changes?')) return;
        setBusy('Opening...');
        const b = await readRecordById(hostProps, table, id);
        setBusy('');
        if (!b) { setMsg({ tone: 'err', text: 'That shift could not be read.' }); return; }
        setSel(b); setSelTable(table); setRows((b.rows || []).map((r: any) => ({ ...r }))); setDirty(false); setRawOpen(false); setRaw(JSON.stringify({ ...b, recordId: undefined, modifiedOn: undefined }, null, 2)); setMsg(null);
    };
    const setCell = (i: number, k: string, v: any) => { setRows(p => p.map((r, j) => (j === i ? { ...r, [k]: v } : r))); setDirty(true); };
    const addRow = () => { const last = rows[rows.length - 1] || {}; setRows(p => p.concat([{ ...taskRowFields({}), craa5_team: sel?.team || '', craa5_shift: sel?.crew || '', craa5_supervisoremail: sel?.supervisorEmail || '', craa5_lead: last.craa5_lead || '', craa5_datetimeofassignment: last.craa5_datetimeofassignment || sel?.savedAt || new Date().toISOString(), craa5_starttime: last.craa5_starttime || new Date(sel?.slotStart || Date.now()).toISOString() }])); setDirty(true); };
    const delRow = (i: number) => { setRows(p => p.filter((_, j) => j !== i)); setDirty(true); };
    const saveEdits = async (): Promise<ShiftBoard | null> => {
        if (!sel) return null;
        let next: ShiftBoard = { ...sel, rows: rows.map(taskRowFields) };
        if (rawOpen) {
            try { const o = JSON.parse(raw); if (!o || !Array.isArray(o.rows)) throw new Error('the JSON needs a rows list'); next = { ...sel, ...o, recordId: sel.recordId }; }
            catch (e: any) { setMsg({ tone: 'err', text: `The JSON could not be used: ${e?.message || e}` }); return null; }
        }
        const changes = diffBoardRows(sel.rows || [], next.rows || []);
        next = boardLog(next, by, `edited in the console: ${changes.length} change${changes.length === 1 ? '' : 's'}`);
        setBusy('Saving...');
        const w = selTable === ARCHIVE_TABLE ? await writeArchive(hostProps, next) : selTable === PLAN_TABLE ? await writePlan(hostProps, next) : await writeBoard(hostProps, next);
        setBusy('');
        if (!w.ok) { setMsg({ tone: 'err', text: `Could not save: ${w.error}` }); return null; }
        const saved = { ...w.board, modifiedOn: await recordModifiedOn(hostProps, selTable, w.board.recordId || '') };
        setSel(saved); setRows(saved.rows.map((r: any) => ({ ...r }))); setRaw(JSON.stringify({ ...saved, recordId: undefined, modifiedOn: undefined }, null, 2)); setDirty(false);
        setMsg({ tone: 'ok', text: `Saved ${saved.rows.length} rows (${changes.length} change${changes.length === 1 ? '' : 's'}).` });
