const handleSavePreset = async () => {
    if (!nextSlot || !viewCrew) return;
    if (!access.can) { setSubmissionError(`View only: ${access.why}. Nothing was saved.`); return; }
    const SAVE_GRACE_MS = 5 * 60000;   // allow saving as a preset up to five minutes after the shift started
    if (nextSlot.startMs <= Date.now() - SAVE_GRACE_MS) { setNextSlot(null); setSubmissionError("That shift started more than five minutes ago, so this board is today's now. Press Save Progress to start the shift with it."); return; }
    setBusyLabel("Saving setup..."); setIsLoading(true); setSaveSuccess(false); setSaveWarning(""); setSubmissionError(null);
    const supervisor = supervisors.find(s => getField(s, 'craa5__aa_employeeid') === selectedSupervisorId);
    try {
