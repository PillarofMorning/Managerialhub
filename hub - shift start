                className="flex items-center gap-1 px-1.5 py-1 rounded-md border text-[11px] font-semibold cursor-pointer select-none"
                style={{ background: pDone ? '#E7F6EC' : sel ? BRAND.blueSoft : '#fff', borderColor: sel ? BRAND.blue : changed ? BRAND.yellow : '#E2E8F0', color: '#1E293B' }}
                title={`${p.name} (${p.room})${p.minutes ? `, ${p.minutes} min` : ''}`}>
                <span className="truncate flex-1 min-w-0">{p.name}</span>
