    if (table === PLAN_TABLE && origTitle !== undefined) {
        if (!('craa5_shiftplan1' in d)) d.craa5_shiftplan1 = origTitle;
        if (!('craa5_title' in d)) d.craa5_title = origTitle;
        delete d.craa5_name;
    } else if (table === ARCHIVE_TABLE && origTitle !== undefined) {
        if (!('craa5_shiftarchive1' in d)) d.craa5_shiftarchive1 = origTitle;
        if (!('craa5_title' in d)) d.craa5_title = origTitle;
        delete d.craa5_name;
    } else if (table === UPDATE_PRESET_TABLE && origTitle !== undefined) {
        if (!('craa5_updatepreset1' in d)) d.craa5_updatepreset1 = origTitle;
        delete d.craa5_name;
    }
    const knownRefused = TABLE_REFUSED_COLS[table] || {};
    if (knownRefused['craa5_title'] && 'craa5_title' in d) {
        if (!noName && !knownRefused['craa5_name'] && !('craa5_name' in d)) d.craa5_name = d.craa5_title;
        delete d.craa5_title;
    }
    if (noName) delete d.craa5_name;
    Object.keys(knownRefused).forEach(k => {
        if (knownRefused[k] && k in d && k !== 'craa5_boardjson' && k !== 'craa5_details') {
            if (k !== 'craa5_title' && k !== 'craa5_name' && k !== 'craa5_shiftplan1' && k !== 'craa5_shiftarchive1' && k !== 'craa5_updatepreset1') refused.push(k);
            delete d[k];
        }
    });
