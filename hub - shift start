                        {row('Asset source', assetSource || 'Dataverse Table')}
                        {row('Matched employee', currentUser ? `${formatFullName(getField(currentUser, 'craa5_name'))} - ${currentUser.calculatedRole}` : 'no employee matched, so a profile was picked from the list', !currentUser)}
                        {row('Work schedule', `${slotCount} shift slot${slotCount === 1 ? '' : 's'} read - ${currentShift ? `shift ${currentShift} on now since ${clockTime(shiftStartMs)}` : 'no shift covers now'}${upNextShift ? ` - shift ${upNextShift} starts within the hour` : ''}`, !slotCount)}
                        {row('Board', `${ownerName || 'no board open'}${boardCrew ? ` - drawing from crew ${boardCrew}` : ''}`)}
                        {row('Saved assignments', taskStatus ? (taskStatus.ok ? `read through ${taskStatus.source}: ${taskStatus.read} row${taskStatus.read === 1 ? '' : 's'} from the last 24 h` : `could not be read: ${String(taskStatus.error).slice(0, 160)}`) : 'not read yet', !!taskStatus && !taskStatus.ok)}
                        {row('Employees', `${employees.length} active read - ${withLookup} with a team set - ${employees.length - withLookup} on their shift letter - ${supervisors.length} supervisors - ${areaCount} areas`)}
                        <div className="mt-4 mb-1"><Text size={300} weight="bold" style={{ color: BRAND.blueDark }}>Teams table (craa5__aa_leadershipteam)</Text></div>
                        {teamsRead === 0
                            ? <Text size={200} block style={{ color: BRAND.red }}>No team rows were read (the table was not found or is empty), so every crew comes from the shift letter on each employee.</Text>
                            : <table className="w-full text-sm" style={{ borderCollapse: 'collapse' }}><thead><tr style={{ background: BRAND.blueSoft }}>{['Team', 'Team lead', 'Crew size', 'How the crew is found', 'On the clock'].map(h => <th key={h} className="text-left px-2 py-1"><Text size={200} weight="bold">{h}</Text></th>)}</tr></thead>
                                <tbody>{teams.map((t: TeamRow) => {
                                    const crew = employees.filter((e: any) => crewOfPerson(e) === t.letter), viaLookup = crew.filter((e: any) => teamIdOfEmp(e) === t.id).length;
                                    const lead = nameOf(t.leadId);
                                    return <tr key={t.id} className="border-b border-slate-100"><td className="px-2 py-1"><Text size={200} weight="bold">{t.letter}</Text></td>
