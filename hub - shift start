async function findAssignmentTable(props: any): Promise<{ table: string; error: string }> {
    if (ASG_TABLE) return { table: ASG_TABLE, error: '' };
    let first = '';
    for (const t of ASG_TABLE_NAMES) {
        try { await tableQuery(props, t, '', [], 1, 'createdon desc'); ASG_TABLE = t; return { table: t, error: '' }; }
        catch (e: any) { first = first || extractDvError(e); }
    }
