// ---- Shift boards: the team's live board for this shift, its time window, and its exact saved state ----
const boardSlotNow = (): { start: number; end: number } => {
    const slotsNow: Slot[] = GLOBAL_DATA_CACHE?.slots || [];
    const start = boardCrew && boardCrew === upNextCrew && boardCrew !== clockCrew && upNextStartMs ? upNextStartMs : shiftStartMs;
    if (start) { const s = slotsNow.length ? findCurrentShift(slotsNow, new Date(start + 60000)) : null; return { start, end: s && s.crew && s.startMs === start ? s.endMs : start + 12 * 3600000 }; }
    const hour = Math.floor(Date.now() / 3600000) * 3600000;   // no shift in the work schedule covers now
    return { start: hour, end: hour + 12 * 3600000 };
};
// The team's live board for the shift window this board is about (a double shift has two boards; each belongs to its own window).
const ownLiveBoard = (sup: any, restoreFrom?: number): ShiftBoard | null => {
    const name = String(getField(sup, 'craa5_name') || ''), email = getEmployeeEmail(sup), slot = boardSlotNow();
    const mineB = LIVE_BOARDS.filter(b => b.status === 'live' && ((name && sameText(b.team, name)) || (email && sameText(b.supervisorEmail, email))));
    const sameSlot = mineB.filter(b => Math.abs(b.slotStart - slot.start) < 2 * 3600000);
    if (sameSlot.length || shiftStartMs) return sameSlot.sort((a, b) => String(b.savedAt).localeCompare(String(a.savedAt)))[0] || null;
    const from = restoreFrom !== undefined ? restoreFrom : Date.now() - TASK_LOOKBACK_MS;   // no shift in the work schedule covers now
    return mineB.filter(b => new Date(b.savedAt || 0).getTime() >= from).sort((a, b) => String(b.savedAt).localeCompare(String(a.savedAt)))[0] || null;
};
