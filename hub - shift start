    const concL = focus.map(f => f.total <= 0 ? 0 : f.total >= SPECIALIST_MIN_SHIFTS ? Math.round(100 * f.top / f.total) : Math.round(100 * f.top / SPECIALIST_MIN_SHIFTS));
