function renderUpdateText(data: UpdateData, rawCfg: UpdateConfig): string {
    const c = normalizeUpdateConfig(rawCfg);
    const bulletFor = (i: number) => (c.bullet === 'num' ? `${i + 1}. ` : c.bullet === 'none' || !c.bullet ? '' : `${c.bullet} `);
    const header = (t: string) => {
        const s = String(t || '').trim();
        if (!s || c.headerStyle === 'none') return '';
        if (c.headerStyle === 'brackets') return `[${s.toUpperCase()}]`;
        if (c.headerStyle === 'caps') return s.toUpperCase();
        if (c.headerStyle === 'colon') return `${s}:`;
        return s;
    };
    const people = (a: UpdateArea) => a.people.map(n => fmtUpdatePerson(n, c.nameFormat)).filter(Boolean).join(', ');
    const areaVals = (a: UpdateArea): Record<string, string> => ({
        name: a.name, emoji: a.emoji, hc: String(a.hc),
        status: a.done ? c.doneText : (a.status || (a.stage ? `Stage: ${a.stage}` : (a.left ? `Left: ${a.left}` : 'Active'))),
        stage: a.done ? c.doneText : a.stage, eta: a.done ? '' : (a.remHours > 0 ? `~${a.remHours}h left` : ''),
        done: a.subcatsDone.join(', '), inprog: a.subcatsInProg.join(', '), left: a.left, callout: a.callout,
        people: people(a), peopleCount: String(a.people.length),
    });
    const prodLine = (a: UpdateArea, i: number) => {
        if (c.prodLine.trim()) return bulletFor(i) + tidyUpdateLine(fillUpdateTokens(c.prodLine, areaVals(a)));
        const f = c.prodFields, parts: string[] = [`${a.name}${f.hc ? ` (HC: ${a.hc})` : ''}${f.emoji && a.emoji ? ` ${a.emoji}` : ''}`];
        if (a.done) parts.push(c.doneText);
        else {
            if (f.stage && a.stage) parts.push(`Stage: ${a.stage}${f.eta ? ` (~${a.remHours}h left)` : ''}`);
            else if (f.eta) parts.push(`ETA: ~${a.remHours}h left`);
            if (f.subcatsDone && a.subcatsDone.length) parts.push(`Subcats: ${a.subcatsDone.join(', ')}`);
            if (f.subcatsInProg && a.subcatsInProg.length) parts.push(`In-Prog: ${a.subcatsInProg.join(', ')}`);
            if (f.status && a.status) parts.push(`In-Prog: ${a.status}`);
        }
        if (f.left && a.left) parts.push(`Left: ${a.left}`);
        if (f.callout && a.callout) parts.push(`Callout: ${a.callout}`);
        if (f.people && a.people.length) parts.push(`Crew: ${people(a)}`);
        return bulletFor(i) + parts.join(c.sep);
    };
    const supportLine = (a: UpdateArea, i: number) => {
        if (c.supportLine.trim()) return bulletFor(i) + tidyUpdateLine(fillUpdateTokens(c.supportLine, areaVals(a)));
        const f = c.supportFields, stat = a.done ? c.doneText : (a.status || (a.left ? `Left: ${a.left}` : 'Active'));
        let s = `${a.name}${f.hc ? ` (HC: ${a.hc})` : ''}${f.emoji && a.emoji ? ` ${a.emoji}` : ''}`;
        if (f.status) s += ` - ${stat}`;
        if (f.people && a.people.length) s += ` - Crew: ${people(a)}`;
        return bulletFor(i) + s;
    };
    type OutLine = { text: string; header?: boolean };
    const section = (on: boolean, title: string, areas: UpdateArea[], lineFn: (a: UpdateArea, i: number) => string): OutLine[] => {
        if (!on || !areas.length) return [];
        const list = c.maxAreas > 0 ? areas.slice(0, c.maxAreas) : areas, out: OutLine[] = [];
        const h = header(title);
        if (h) out.push({ text: h, header: true });
        list.forEach((a, i) => out.push({ text: lineFn(a, i) }));
        if (list.length < areas.length) out.push({ text: `${bulletFor(list.length)}+${areas.length - list.length} more` });
        return out;
    };
    const att = c.sections.attendance
        ? (data.attendance.length
            ? data.attendance.map(g => `${g.status.toUpperCase()}: ${g.names.map(n => fmtUpdatePerson(n, c.nameFormat)).join(', ')} (${g.names.length})`).join(c.sep)
            : fillUpdateTokens(c.allPresentText, { totalHC: String(data.totalHC) }))
        : '';
    const prod = section(c.sections.production, c.prodTitle, data.production, prodLine);
    const sup = section(c.sections.support, c.supportTitle, data.support, supportLine);
    const listed = (c.sections.production ? data.production : []).concat(c.sections.support ? data.support : []);
    const vals: Record<string, string> = {
        date: data.date, time: data.time, day: data.day, shift: data.shift, supervisor: data.supervisor,
        totalHC: String(data.totalHC), offShift: String(data.offShift), offShiftPart: data.offShift > 0 ? `${c.sep}Off-Shift: ${data.offShift}` : '',
        attendance: att, attendanceCount: String(data.attendance.reduce((s, g) => s + g.names.length, 0)),
        prodCount: String(c.sections.production ? data.production.length : 0), supportCount: String(c.sections.support ? data.support.length : 0),
        doneCount: String(listed.filter(a => a.done).length), areaCount: String(listed.length),
    };
    const blocks: Record<string, OutLine[]> = { production: prod, support: sup };
    const lines: OutLine[] = [];
    String(c.template || '').replace(/\r/g, '').split('\n').forEach(tl => {
        if (!tl.trim()) { lines.push({ text: '' }); return; }   // a blank template line is kept on purpose
        const own = tl.trim();
        if (own === '{production}' || own === '{support}') { lines.push.apply(lines, blocks[own.slice(1, -1)]); return; }
        if (/\{attendance\}/.test(tl) && !att) return;            // attendance switched off: its whole line goes
        let out = fillUpdateTokens(tl, vals);
        ['production', 'support'].forEach(k => { if (out.indexOf(`{${k}}`) >= 0) out = out.split(`{${k}}`).join(blocks[k].map(x => x.text).join(' ')); });
        if (out.trim()) lines.push({ text: out });
    });
    while (lines.length && !lines[lines.length - 1].text.trim()) lines.pop();
    let text: string;
    if (c.spacing === 'double') text = lines.filter(l => l.text.trim()).map(l => l.text).join('\n\n');
    else if (c.spacing === 'sections') text = lines.map((l, i) => (l.header && i > 0 && lines[i - 1].text.trim() ? `\n${l.text}` : l.text)).join('\n');
    else text = lines.map(l => l.text).join('\n');
    if (c.maxChars > 0 && text.length > c.maxChars) {
        let cut = text.slice(0, Math.max(0, c.maxChars - 4));
        const nl = cut.lastIndexOf('\n');
        if (nl > c.maxChars * 0.5) cut = cut.slice(0, nl);
        text = `${cut.trimEnd()} ...`;
    }
    return text;
}

const updateKeyOf = (u: any) => String((u && (u.email || u.id || u.name)) || '').toLowerCase().trim();
const sameUpdateOwner = (a: string, b: string) => !!a && !!b && a.toLowerCase().trim() === b.toLowerCase().trim();
const bySavedDesc = (a: UpdatePreset, b: UpdatePreset) => String(b.savedAt || '').localeCompare(String(a.savedAt || ''));

function lsReadUpdatePresets(): UpdatePreset[] {
    try {
        const raw = window.localStorage.getItem(UPDATE_LS_KEY), a = raw ? JSON.parse(raw) : [];
        return Array.isArray(a) ? a.filter((p: any) => p && p.id && p.config).map((p: any) => ({ ...p, config: normalizeUpdateConfig(p.config), where: 'device' as const })) : [];
    } catch (e) { return []; }
}
function lsWriteUpdatePresets(list: UpdatePreset[]): boolean {
    try { window.localStorage.setItem(UPDATE_LS_KEY, JSON.stringify(list.map(p => ({ ...p, recordId: undefined, where: 'device' })))); return true; } catch (e) { return false; }
}
const lsReadUpdateChoice = (me: string) => { try { return window.localStorage.getItem(`${UPDATE_ACTIVE_LS_KEY}:${me}`) || ''; } catch (e) { return ''; } };
const lsWriteUpdateChoice = (me: string, id: string) => { try { if (id) window.localStorage.setItem(`${UPDATE_ACTIVE_LS_KEY}:${me}`, id); else window.localStorage.removeItem(`${UPDATE_ACTIVE_LS_KEY}:${me}`); } catch (e) { /* only a remembered choice */ } };

type UpdateStore = { remote: 'unknown' | 'ok' | 'missing' | 'error'; error: string };
async function readUpdatePresets(props: any): Promise<{ list: UpdatePreset[]; store: UpdateStore }> {
    const webApi = getWebApi(props), dataApi = props?.dataApi, idCol = UPDATE_PRESET_TABLE + 'id', pick = [idCol, 'craa5_updatepreset1', 'craa5_configjson', 'modifiedon'], fallbackPick = [idCol, 'craa5_configjson', 'modifiedon'];
    let recs: any[] | null = null, remote: UpdateStore['remote'] = 'unknown', error = '';
    const failed = (e: any) => { const m = String(e?.message || e || 'failed'); error = m; remote = looksMissing(m) ? 'missing' : 'error'; };
    if (webApi?.retrieveMultipleRecords) {
        try { const res: any = await asyncRace(webApi.retrieveMultipleRecords(UPDATE_PRESET_TABLE, `?$select=${pick.join(',')}&$filter=statecode eq 0&$orderby=modifiedon desc&$top=250`), TASK_TIMEOUT_MS, 'update presets'); if (Array.isArray(res?.entities)) { recs = res.entities; remote = 'ok'; } } catch (e: any) {
            try { const res2: any = await asyncRace(webApi.retrieveMultipleRecords(UPDATE_PRESET_TABLE, `?$select=${fallbackPick.join(',')}&$filter=statecode eq 0&$orderby=modifiedon desc&$top=250`), TASK_TIMEOUT_MS, 'update presets'); if (Array.isArray(res2?.entities)) { recs = res2.entities; remote = 'ok'; } } catch (e2: any) { failed(e2); }
        }
    }
    if (!recs && dataApi?.queryTable) {
        try { recs = await queryDataApi(dataApi, UPDATE_PRESET_TABLE, 'statecode eq 0', { select: pick, orderBy: 'modifiedon desc', top: 250 }); remote = 'ok'; error = ''; } catch (e: any) {
            try { recs = await queryDataApi(dataApi, UPDATE_PRESET_TABLE, 'statecode eq 0', { select: fallbackPick, orderBy: 'modifiedon desc', top: 250 }); remote = 'ok'; error = ''; } catch (e2: any) { if (!error || remote === 'unknown') failed(e2); }
        }
    }
    const list: UpdatePreset[] = [];
    (recs || []).forEach(r => {
        try {
            const o = JSON.parse(String(getField(r, 'craa5_configjson') || ''));
            const rid = String(getField(r, idCol) || '').replace(/[{}]/g, '');
            if (!o || !o.config || !rid) return;
            list.push({ id: `dv:${rid}`, recordId: rid, name: String(o.name || getField(r, 'craa5_updatepreset1') || getField(r, 'craa5_title') || 'Untitled preset'), ownerKey: String(o.ownerKey || ''), ownerName: String(o.ownerName || ''), useForAll: !!o.useForAll, ownerDefault: !!o.ownerDefault, config: normalizeUpdateConfig(o.config), savedAt: String(o.savedAt || getField(r, 'modifiedon') || ''), editedBy: o.editedBy ? String(o.editedBy) : undefined, where: 'dataverse' });
        } catch (e) { /* a row that is not a preset */ }
    });
    lsReadUpdatePresets().forEach(p => { if (!list.some(x => x.id === p.id)) list.push(p); });
    return { list: list.sort(bySavedDesc), store: { remote, error } };
}

// Saves a preset in the table (a column the table refuses is left out and named); when the table itself cannot take it, on this computer.
async function writeUpdatePreset(props: any, p: UpdatePreset): Promise<{ preset: UpdatePreset; where: 'dataverse' | 'device'; error: string; refused: string[] }> {
    const api = getWriteApi(props), refused: string[] = [], savedAt = new Date().toISOString();
    const body = { v: 1, name: p.name, ownerKey: p.ownerKey, ownerName: p.ownerName, useForAll: p.useForAll, ownerDefault: p.ownerDefault, savedAt, editedBy: p.editedBy, config: normalizeUpdateConfig(p.config) };
    const data: any = { craa5_updatepreset1: p.name, craa5_configjson: JSON.stringify(body), craa5_ownerkey: p.ownerKey, craa5_ownername: p.ownerName, craa5_useforall: !!p.useForAll, craa5_isownerdefault: !!p.ownerDefault };
    const knownRef = ENDPOINT_META.refusedCols?.[UPDATE_PRESET_TABLE] || {};
    Object.keys(knownRef).forEach(k => {
        if (knownRef[k] && k in data && k !== 'craa5_configjson' && k !== 'craa5_updatepreset1') {
            delete data[k];
        }
    });
    delete data.craa5_name;
    const device = (error: string) => {
        const id = p.where === 'device' && p.id ? p.id : `local:${Date.now()}`;
        const saved: UpdatePreset = { ...p, id, recordId: undefined, savedAt, where: 'device' };
        const all = lsReadUpdatePresets().filter(x => x.id !== id);
        const kept = lsWriteUpdatePresets([saved].concat(all));
        return { preset: saved, where: 'device' as const, error: kept ? error : `${error} (and this browser would not keep it either)`, refused };
    };
    if (!api) return device('no way to write to Dataverse from here');
    for (let attempt = 0; attempt < 9; attempt++) {
        try {
            let id = p.where === 'dataverse' ? (p.recordId || '') : '';
            if (id) await asyncRace(api.update(UPDATE_PRESET_TABLE, id, data), TASK_TIMEOUT_MS, 'update preset save');
            else { const res: any = await asyncRace(api.create(UPDATE_PRESET_TABLE, data), TASK_TIMEOUT_MS, 'update preset create'); id = String(typeof res === 'string' ? res : (res?.id || res?.[UPDATE_PRESET_TABLE + 'id'] || res?.rowId || '')).replace(/[{}]/g, ''); }
            if (p.where === 'device' && p.id) lsWriteUpdatePresets(lsReadUpdatePresets().filter(x => x.id !== p.id));   // moved from this computer to the table
            return { preset: { ...p, id: `dv:${id}`, recordId: id, savedAt, where: 'dataverse' }, where: 'dataverse', error: '', refused };
        } catch (e: any) {
            const msg = String(e?.message || e?.error?.message || e?.innerError?.message || e?.raw || e || 'failed');
            const matches = (msg.match(/craa5_[a-z0-9_]+/gi) || []).map(s => s.toLowerCase());
            const bad = matches.find(n => (UPDATE_PRESET_COLUMNS.some(c => c.name === n && c.optional) || n === 'craa5_title' || n === 'craa5_updatepreset1') && n in data);
            if (bad) {
                ENDPOINT_META.refusedCols = { ...(ENDPOINT_META.refusedCols || {}), [UPDATE_PRESET_TABLE]: { ...(ENDPOINT_META.refusedCols?.[UPDATE_PRESET_TABLE] || {}), [bad]: true } };
                saveEndpointMeta();
                if (bad !== 'craa5_title' && bad !== 'craa5_updatepreset1') refused.push(bad);
                delete data[bad];
                delete data.craa5_name;
                continue;
            }
            return device(msg);
        }
    }
    return device('too many columns refused');
}

async function deleteUpdatePreset(props: any, p: UpdatePreset): Promise<string> {
    if (p.where === 'device') { lsWriteUpdatePresets(lsReadUpdatePresets().filter(x => x.id !== p.id)); return ''; }
    if (p.where !== 'dataverse' || !p.recordId) return 'This preset cannot be deleted.';
    const xrm = safeGetXrm(), dataApi = props?.dataApi;
    const web = xrm?.WebApi?.deleteRecord ? xrm.WebApi : props?.context?.webAPI?.deleteRecord ? props.context.webAPI : null;
    try {
        if (web) await asyncRace(web.deleteRecord(UPDATE_PRESET_TABLE, p.recordId), TASK_TIMEOUT_MS, 'update preset delete');
        else if (dataApi?.deleteRow) await asyncRace(dataApi.deleteRow(UPDATE_PRESET_TABLE, p.recordId), TASK_TIMEOUT_MS, 'update preset delete');
        else return 'No way to delete from Dataverse here.';
        return '';
    } catch (e: any) { return String(e?.message || e || 'delete failed'); }
}

// Which preset a person gets: their own pick, then their own default preset, then the newest "Use for all users" preset, then the built-in one.
function resolveUpdatePreset(list: UpdatePreset[], me: string): UpdatePreset {
    const choice = lsReadUpdateChoice(me), picked = choice ? list.find(p => p.id === choice) : null;
    if (picked) return picked;
    if (choice === BUILTIN_UPDATE_PRESET.id) return BUILTIN_UPDATE_PRESET;
    const own = list.filter(p => p.ownerDefault && sameUpdateOwner(p.ownerKey, me)).sort(bySavedDesc)[0];
    if (own) return own;
    const all = list.filter(p => p.useForAll).sort(bySavedDesc)[0];
    return all || BUILTIN_UPDATE_PRESET;
}

type UpdateComposerProps = { data: UpdateData; hostProps: any; meKey: string; meName: string; fullAccess: boolean; onClose: () => void };
function UpdateComposer({ data, hostProps, meKey, meName, fullAccess, onClose }: UpdateComposerProps) {
    const [presets, setPresets] = useState<UpdatePreset[]>([]);
    const [store, setStore] = useState<UpdateStore>({ remote: 'unknown', error: '' });
    const [loading, setLoading] = useState(true);
    const [draft, setDraft] = useState<UpdatePreset>({ ...BUILTIN_UPDATE_PRESET });
    const [activeId, setActiveId] = useState(BUILTIN_UPDATE_PRESET.id);
    const [dirty, setDirty] = useState(false);
    const [tab, setTab] = useState<'components' | 'format' | 'template' | 'everyone'>('components');
    const [busy, setBusy] = useState(false);
    const [msg, setMsg] = useState<{ tone: 'ok' | 'warn' | 'err'; text: string } | null>(null);
    const [copied, setCopied] = useState(false);
    const [showAllSchema, setShowAllSchema] = useState(false);
    const tplRef = useRef<HTMLTextAreaElement | null>(null);
    const [tplFocus, setTplFocus] = useState<'template' | 'prodLine' | 'supportLine'>('template');

    const load = useCallback(async (selectId?: string) => {
        setLoading(true);
        const r = await readUpdatePresets(hostProps);
        setPresets(r.list); setStore(r.store); setLoading(false);
        const resolved = resolveUpdatePreset(r.list, meKey);
        const chosen = (selectId ? r.list.find(p => p.id === selectId) : null) || resolved;
        setDraft({ ...chosen, config: normalizeUpdateConfig(chosen.config) }); setDirty(false);
        setActiveId(resolved.id);
    }, [hostProps, meKey]);
    useEffect(() => { load(); }, []); // eslint-disable-line react-hooks/exhaustive-deps

    const cfg = draft.config;
    const text = useMemo(() => renderUpdateText(data, cfg), [data, cfg]);
    const isMine = draft.where !== 'builtin' && sameUpdateOwner(draft.ownerKey, meKey);
    const canEdit = draft.where !== 'builtin' && (isMine || fullAccess);
    const visible = presets.filter(p => sameUpdateOwner(p.ownerKey, meKey) || p.useForAll || p.id === draft.id || p.id === activeId);
    const setCfg = (patch: Partial<UpdateConfig>) => { setDraft(d => ({ ...d, config: { ...d.config, ...patch } })); setDirty(true); setCopied(false); };
    const setProd = (k: UpdateProdField, v: boolean) => setCfg({ prodFields: { ...cfg.prodFields, [k]: v } });
    const setSup = (k: UpdateSupportField, v: boolean) => setCfg({ supportFields: { ...cfg.supportFields, [k]: v } });
    const choose = async (id: string) => {
        if (id === draft.id) return;
        if (dirty && !await askConfirm('Discard the unsaved changes to this preset?')) return;
        const p = id === BUILTIN_UPDATE_PRESET.id ? BUILTIN_UPDATE_PRESET : presets.find(x => x.id === id);
        if (!p) return;
        setDraft({ ...p, config: normalizeUpdateConfig(p.config) }); setDirty(false); setMsg(null); setCopied(false);
    };

    const doCopy = () => { copyTextToClipboard(text); setCopied(true); setMsg({ tone: 'ok', text: `Copied ${text.length} characters (${text ? text.split('\n').length : 0} lines) to the clipboard.` }); };

    // Only one preset is "Use for all users" at a time: marking a new one clears the flag on the others
    const clearOtherForAll = async (keepId: string) => {
        const others = presets.filter(p => p.useForAll && p.id !== keepId && p.where !== 'builtin');
        for (const o of others) { try { await writeUpdatePreset(hostProps, { ...o, useForAll: false }); } catch (e) { /* the newest one wins anyway */ } }
    };
    const clearOtherOwnDefault = async (keepId: string) => {
        const others = presets.filter(p => p.ownerDefault && p.id !== keepId && sameUpdateOwner(p.ownerKey, meKey));
        for (const o of others) { try { await writeUpdatePreset(hostProps, { ...o, ownerDefault: false }); } catch (e) { /* the newest one wins anyway */ } }
    };

    const save = async (asNew: boolean) => {
        const name = String(draft.name || '').trim() || 'My update preset';
        const fresh = asNew || draft.where === 'builtin';
        if (!fresh && !canEdit) { setMsg({ tone: 'warn', text: 'This is someone else\'s preset. Use Save as New, or unlock Full Access (click the Schwan\'s logo) to edit it.' }); return; }
        setBusy(true); setMsg(null);
        const target: UpdatePreset = fresh
            ? { ...draft, id: '', recordId: undefined, where: 'device', name: draft.where === 'builtin' && name === BUILTIN_UPDATE_PRESET.name ? 'My update preset' : (asNew && draft.where !== 'builtin' && name === draft.name ? `${name} (copy)` : name), ownerKey: meKey, ownerName: meName, ownerDefault: false, editedBy: undefined }
            : { ...draft, name, editedBy: isMine ? undefined : meName };
        const res = await writeUpdatePreset(hostProps, target);
        if (res.preset.useForAll) await clearOtherForAll(res.preset.id);
        setBusy(false);
        const whereText = res.where === 'dataverse' ? `in the table ${UPDATE_PRESET_TABLE}` : `on this computer${res.error ? ` (Dataverse: ${res.error})` : ''}`;
        setMsg({ tone: res.where === 'dataverse' ? 'ok' : 'warn', text: `Saved "${res.preset.name}" ${whereText}.${res.refused.length ? ` Columns not in the table yet (kept in the JSON instead): ${res.refused.join(', ')}.` : ''}${res.preset.useForAll ? ' It is now the default for every user who has not chosen their own.' : ''}` });
        await load(res.preset.id);
    };

    const makeMine = async () => {
        if (dirty) { setMsg({ tone: 'warn', text: 'Save the changes first, then make it your default.' }); return; }
        lsWriteUpdateChoice(meKey, draft.id);
        if (isMine && !draft.ownerDefault) {
            setBusy(true);
            await clearOtherOwnDefault(draft.id);
            await writeUpdatePreset(hostProps, { ...draft, ownerDefault: true });
            setBusy(false);
        }
        await load(draft.id);
        setMsg({ tone: 'ok', text: `"${draft.name}" is now your update preset${isMine ? ' on every device' : ' on this computer'}. Other users keep their own.` });
    };
    const resetMine = async () => {
        lsWriteUpdateChoice(meKey, '');
        setBusy(true);
        await clearOtherOwnDefault('');
        setBusy(false);
        await load();
        setMsg({ tone: 'ok', text: 'You now follow the team default (the preset set for all users, or the built-in one).' });
    };
    const remove = async (p: UpdatePreset) => {
        const editable = p.where !== 'builtin' && (sameUpdateOwner(p.ownerKey, meKey) || fullAccess);
        if (!editable) { setMsg({ tone: 'warn', text: 'Only the owner or Full Access can delete this preset.' }); return; }
        if (!await askConfirm(`Delete the preset "${p.name}"${p.ownerName && !sameUpdateOwner(p.ownerKey, meKey) ? ` owned by ${p.ownerName}` : ''}?`)) return;
        setBusy(true);
        const err = await deleteUpdatePreset(hostProps, p);
        setBusy(false);
        if (err) { setMsg({ tone: 'err', text: `Could not delete: ${err}` }); return; }
        if (lsReadUpdateChoice(meKey) === p.id) lsWriteUpdateChoice(meKey, '');
        await load(draft.id === p.id ? undefined : draft.id);
        setMsg({ tone: 'ok', text: `Deleted "${p.name}".` });
    };

    const insertToken = (tok: string, into?: 'template' | 'prodLine' | 'supportLine') => {
        const key = into || tplFocus, cur = String((cfg as any)[key] || ''), el = tplRef.current;
        if (key === 'template' && el && typeof el.selectionStart === 'number') {
            const s = el.selectionStart, e = el.selectionEnd;
            setCfg({ template: cur.slice(0, s) + tok + cur.slice(e) });
            setTimeout(() => { try { el.focus(); el.selectionStart = el.selectionEnd = s + tok.length; } catch (x) { /* nothing to focus */ } }, 0);
        } else setCfg({ [key]: cur + tok } as any);
    };

    const chip = (on: boolean, text2: string, onClick: () => void, title?: string) => (
        <button key={text2} type="button" title={title} onClick={onClick}
            style={{ padding: '3px 9px', borderRadius: 999, fontSize: 11, fontWeight: 700, cursor: 'pointer', border: `1px solid ${on ? BRAND.blue : '#CBD5E1'}`, background: on ? BRAND.blue : '#fff', color: on ? '#fff' : '#334155' }}>{text2}</button>
    );
    const box = (on: boolean, text2: string, set: (v: boolean) => void, disabled?: boolean, now?: string) => (
        <label key={text2} style={{ display: 'flex', alignItems: 'center', gap: 6, fontSize: 12, color: disabled ? '#94A3B8' : '#1F2937', cursor: disabled ? 'default' : 'pointer' }}>
            <input type="checkbox" checked={on} disabled={disabled} onChange={(e) => set(e.target.checked)} /> {text2}
            {now ? <span style={{ fontSize: 11, color: '#64748B', fontWeight: 600 }}>({now})</span> : null}
        </label>
    );
    // What each choice shows right now, next to its name (e.g. Hours left (ETA) (longest 9h 3m))
    const hm = (h: number) => { const m = Math.max(0, Math.round((h || 0) * 60)); return m >= 60 ? `${Math.floor(m / 60)}h ${m % 60}m` : `${m}m`; };
    const nOf = (n: number, en1: string, enN: string, es1: string, esN: string) => `${n} ${n === 1 ? tx(en1, es1) : tx(enN, esN)}`;
    const sumOf = (list: UpdateArea[], f: (a: UpdateArea) => number) => list.reduce((t, a) => t + (f(a) || 0), 0);
    const nowAreas = (list: UpdateArea[]) => {
        const open = list.filter(a => !a.done);
        return {
            hc: nOf(sumOf(list, a => a.hc), 'person', 'people', 'persona', 'personas'),
            stage: open.filter(a => a.stage).slice(0, 2).map(a => `${a.name}: ${a.stage}`).join(', ') || tx('none yet', 'ninguna aun'),
            eta: open.length ? tx(`longest ${hm(Math.max(...open.map(a => a.remHours || 0)))}`, `la mas larga ${hm(Math.max(...open.map(a => a.remHours || 0)))}`) : tx('all done', 'todo listo'),
            subcatsDone: nOf(sumOf(list, a => a.subcatsDone.length), 'item', 'items', 'parte', 'partes'),
            subcatsInProg: nOf(sumOf(list, a => a.subcatsInProg.length), 'item', 'items', 'parte', 'partes'),
            status: nOf(list.filter(a => a.status).length, 'room typed', 'rooms typed', 'cuarto escrito', 'cuartos escritos'),
            left: nOf(list.filter(a => a.left).length, 'room', 'rooms', 'cuarto', 'cuartos'),
            callout: nOf(list.filter(a => a.callout).length, 'room', 'rooms', 'cuarto', 'cuartos'),
            people: nOf(sumOf(list, a => a.people.length), 'name', 'names', 'nombre', 'nombres'),
        };
    };
    const nowProd = nowAreas(data.production), nowSup = nowAreas(data.support);
    const sel = (value: string, opts: { v: string; label: string }[], onChange: (v: string) => void, aria: string) => (
        <select aria-label={aria} value={value} onChange={(e) => onChange(e.target.value)} className="px-2 py-1 rounded border border-slate-300 text-xs bg-white text-slate-800">
            {opts.map(o => <option key={o.label} value={o.v}>{o.label}</option>)}
        </select>
    );
    const head = (t: string) => <div style={{ fontSize: 11, fontWeight: 800, textTransform: 'uppercase', letterSpacing: '0.05em', color: BRAND.blueDark, margin: '12px 0 6px' }}>{t}</div>;
    const same = (a: any, b: any) => JSON.stringify(a) === JSON.stringify(b);
    const lengthNow = UPDATE_LENGTHS.find(l => { const x = l.apply(cfg); return same(x.prodFields, cfg.prodFields) && same(x.supportFields, cfg.supportFields) && same(x.sections, cfg.sections); });
    const tone = (t: 'ok' | 'warn' | 'err') => (t === 'ok' ? { bg: '#ECFDF5', fg: '#065F46', bd: '#A7F3D0' } : t === 'warn' ? { bg: BRAND.yellowSoft, fg: '#8A5A00', bd: BRAND.yellow } : { bg: BRAND.redSoft, fg: '#9F1239', bd: '#FECDD3' });
    const ownerText = (p: UpdatePreset) => (p.where === 'builtin' ? 'Built-in' : sameUpdateOwner(p.ownerKey, meKey) ? 'You' : (p.ownerName || p.ownerKey || 'Unknown'));
    const presetLabel = (p: UpdatePreset) => `${p.name}${p.useForAll ? ' - for all users' : ''}${p.id === activeId ? ' - in use' : ''}${p.where === 'builtin' ? '' : ` (${ownerText(p)})`}`;
    const tokenBtn = (t: { token: string; what: string }, kind: 'update' | 'area') => (
        <button key={t.token} type="button" title={t.what} onClick={() => insertToken(t.token, kind === 'update' ? 'template' : (tplFocus === 'supportLine' ? 'supportLine' : 'prodLine'))}
            style={{ fontFamily: 'Consolas, monospace', fontSize: 11, padding: '2px 7px', borderRadius: 6, cursor: 'pointer', border: `1px solid ${kind === 'update' ? '#B3D4F2' : '#FCD9A0'}`, background: kind === 'update' ? BRAND.blueSoft : BRAND.yellowSoft, color: kind === 'update' ? BRAND.blueDark : '#8A5A00' }}>{t.token}</button>
    );
    const td = { padding: '5px 6px', borderBottom: '1px solid #F1F5F9' };

    return (
        <div role="dialog" aria-modal="true" aria-label="Shift update composer" style={{ position: 'fixed', inset: 0, zIndex: 1000, background: 'rgba(15,23,42,0.55)', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 12 }}
            onKeyDown={(e) => { if (e.key === 'Escape') onClose(); }}>
            <div style={{ background: '#fff', color: '#1F2937', borderRadius: 14, width: 'min(1180px, 100%)', height: 'min(860px, 94vh)', display: 'flex', flexDirection: 'column', overflow: 'hidden', boxShadow: '0 20px 50px rgba(0,0,0,0.3)', fontFamily: BRAND_FONT }}>
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 10, padding: '10px 16px', borderBottom: `4px solid ${BRAND.yellow}` }}>
                    <div>
                        <div style={{ fontSize: 16, fontWeight: 900, color: BRAND.blueDark }}>Shift Update Composer</div>
                        <div style={{ fontSize: 11, color: '#64748B' }}>Choose what goes in, how long it is and how it looks. Presets are saved {store.remote === 'ok' ? `in the table ${UPDATE_PRESET_TABLE}` : `on this computer until the table ${UPDATE_PRESET_TABLE} exists`}.</div>
                    </div>
                    <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                        <Button appearance="primary" onClick={doCopy}>{copied ? 'Copied' : 'Copy Update'}</Button>
                        <Button appearance="subtle" onClick={onClose}>Close</Button>
                    </div>
                </div>

                <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 8, padding: '8px 16px', background: '#F7F9FC', borderBottom: '1px solid #E2E8F0' }}>
                    <span style={{ fontSize: 11, fontWeight: 800, color: BRAND.blueDark }}>PRESET</span>
                    <select aria-label="Preset" value={draft.id || ''} disabled={loading} onChange={(e) => choose(e.target.value)} className="px-2 py-1 rounded border border-slate-300 text-xs bg-white text-slate-800" style={{ maxWidth: 330 }}>
                        <option value={BUILTIN_UPDATE_PRESET.id}>{presetLabel(BUILTIN_UPDATE_PRESET)}</option>
                        {visible.map(p => <option key={p.id} value={p.id}>{presetLabel(p)}</option>)}
                        {!draft.id && <option value="">{draft.name} (unsaved)</option>}
                    </select>
                    <input aria-label="Preset name" value={draft.name} onChange={(e) => { const v = e.target.value; setDraft(d => ({ ...d, name: v })); setDirty(true); }} placeholder="Preset name" className="px-2 py-1 rounded border border-slate-300 text-xs" style={{ width: 190 }} />
                    <label style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 12, fontWeight: 600 }} title="This preset becomes the default for every user who has not picked their own">
                        <input type="checkbox" checked={!!draft.useForAll} onChange={(e) => { const v = e.target.checked; setDraft(d => ({ ...d, useForAll: v })); setDirty(true); }} /> Use for all users
                    </label>
                    <Button size="small" appearance="primary" disabled={busy || loading || (!canEdit && draft.where !== 'builtin')} onClick={() => save(false)} title={draft.where === 'builtin' ? 'Saves your changes as your own new preset' : 'Save the changes to this preset'}>{busy ? 'Saving...' : 'Save'}</Button>
                    <Button size="small" disabled={busy || loading} onClick={() => save(true)}>Save as New</Button>
                    <Button size="small" disabled={busy || loading || (activeId === draft.id && !dirty)} onClick={makeMine} title="Use this preset every time you copy the update (other users keep theirs)">Make My Default</Button>
                    <Button size="small" appearance="subtle" disabled={busy || loading} onClick={resetMine} title="Stop using your own pick and follow the preset set for all users">Follow Team Default</Button>
                    {canEdit && <Button size="small" appearance="subtle" disabled={busy} onClick={() => remove(draft)} style={{ color: BRAND.red }}>Delete</Button>}
                    <span style={{ fontSize: 11, color: '#64748B' }}>
                        {loading ? 'Loading presets...' : `${ownerText(draft) === 'You' ? 'Your preset' : `Owner: ${ownerText(draft)}`}${draft.editedBy ? ` - last edited by ${draft.editedBy}` : ''}${dirty ? ' - unsaved changes' : ''}${!canEdit && draft.where !== 'builtin' ? ' - view only (Save as New keeps a copy)' : ''}`}
                    </span>
                </div>
                {msg && <div role="status" style={{ margin: '8px 16px 0', padding: '6px 10px', borderRadius: 8, fontSize: 12, fontWeight: 600, background: tone(msg.tone).bg, color: tone(msg.tone).fg, border: `1px solid ${tone(msg.tone).bd}` }}>{msg.text}</div>}

                <div style={{ display: 'flex', flex: 1, minHeight: 0, flexWrap: 'wrap', overflow: 'auto' }}>
                    <div style={{ flex: '1 1 520px', minWidth: 320, display: 'flex', flexDirection: 'column', minHeight: 0, borderRight: '1px solid #E2E8F0' }}>
                        <div style={{ display: 'flex', gap: 4, padding: '8px 16px 0', flexWrap: 'wrap' }}>
                            {([['components', 'Components'], ['format', 'Format & Length'], ['template', 'Template & Placeholders'], ['everyone', `Everyone's Presets (${presets.length})`]] as const).map(([k, l]) => (
                                <button key={k} type="button" onClick={() => setTab(k)} style={{ padding: '6px 10px', fontSize: 11, fontWeight: 800, borderRadius: '8px 8px 0 0', border: '1px solid #E2E8F0', borderBottom: tab === k ? '2px solid #fff' : '1px solid #E2E8F0', background: tab === k ? '#fff' : '#F1F5F9', color: tab === k ? BRAND.blue : '#475569', cursor: 'pointer', marginBottom: -1 }}>{l}</button>
                            ))}
                        </div>
                        <div style={{ flex: 1, overflowY: 'auto', padding: '4px 16px 16px', borderTop: '1px solid #E2E8F0' }}>
                            {tab === 'components' && (
                                <div>
                                    {head('Length')}
                                    <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
                                        {UPDATE_LENGTHS.map(l => chip(!!lengthNow && lengthNow.key === l.key, l.label, () => setCfg(l.apply(cfg)), l.tip))}
                                        {!lengthNow && <span style={{ fontSize: 11, color: '#64748B' }}>Custom mix</span>}
                                    </div>
                                    {head('Sections')}
                                    <div style={{ display: 'flex', gap: 14, flexWrap: 'wrap' }}>
                                        {box(cfg.sections.attendance, 'Attendance (Sick, PTO, Late, Left Early)', v => setCfg({ sections: { ...cfg.sections, attendance: v } }))}
                                        {box(cfg.sections.production, `Production areas (${data.production.length})`, v => setCfg({ sections: { ...cfg.sections, production: v } }))}
                                        {box(cfg.sections.support, `Support functions (${data.support.length})`, v => setCfg({ sections: { ...cfg.sections, support: v } }))}
                                    </div>
                                    {head(tx('Each production area shows', 'Cada area de produccion muestra'))}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(175px, 1fr))', gap: 6 }}>
                                        {box(cfg.prodFields.hc, tx('Headcount', 'Personal'), v => setProd('hc', v), !cfg.sections.production, nowProd.hc)}
                                        {box(cfg.prodFields.emoji, tx('Area emoji', 'Emoji del cuarto'), v => setProd('emoji', v), !cfg.sections.production)}
                                        {box(cfg.prodFields.stage, tx('Sanitation stage', 'Etapa de limpieza'), v => setProd('stage', v), !cfg.sections.production, nowProd.stage)}
                                        {box(cfg.prodFields.eta, tx('Hours left (ETA)', 'Horas restantes (ETA)'), v => setProd('eta', v), !cfg.sections.production, nowProd.eta)}
                                        {box(cfg.prodFields.subcatsDone, tx('Subcategories done', 'Subcategorias listas'), v => setProd('subcatsDone', v), !cfg.sections.production, nowProd.subcatsDone)}
                                        {box(cfg.prodFields.subcatsInProg, tx('Subcategories in progress', 'Subcategorias en proceso'), v => setProd('subcatsInProg', v), !cfg.sections.production, nowProd.subcatsInProg)}
                                        {box(cfg.prodFields.status, tx('Typed status', 'Estatus escrito'), v => setProd('status', v), !cfg.sections.production, nowProd.status)}
                                        {box(cfg.prodFields.left, tx('What is left', 'Lo que falta'), v => setProd('left', v), !cfg.sections.production, nowProd.left)}
                                        {box(cfg.prodFields.callout, tx('Callouts', 'Avisos'), v => setProd('callout', v), !cfg.sections.production, nowProd.callout)}
                                        {box(cfg.prodFields.people, tx('Names of the crew', 'Nombres del equipo'), v => setProd('people', v), !cfg.sections.production, nowProd.people)}
                                    </div>
                                    {cfg.prodLine.trim() && <div style={{ fontSize: 11, color: '#8A5A00', marginTop: 6 }}>A custom production line is set on the Template tab, so these boxes are not used for production areas.</div>}
                                    {head(tx('Each support area shows', 'Cada area de apoyo muestra'))}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(175px, 1fr))', gap: 6 }}>
                                        {box(cfg.supportFields.hc, tx('Headcount', 'Personal'), v => setSup('hc', v), !cfg.sections.support, nowSup.hc)}
                                        {box(cfg.supportFields.emoji, tx('Area emoji', 'Emoji del cuarto'), v => setSup('emoji', v), !cfg.sections.support)}
                                        {box(cfg.supportFields.status, tx('Status', 'Estatus'), v => setSup('status', v), !cfg.sections.support, nowSup.status)}
                                        {box(cfg.supportFields.people, tx('Names of the crew', 'Nombres del equipo'), v => setSup('people', v), !cfg.sections.support, nowSup.people)}
                                    </div>
                                    {cfg.supportLine.trim() && <div style={{ fontSize: 11, color: '#8A5A00', marginTop: 6 }}>A custom support line is set on the Template tab, so these boxes are not used for support areas.</div>}
                                    {head('Names')}
                                    <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                                        {chip(cfg.nameFormat === 'fullname', 'Full name', () => setCfg({ nameFormat: 'fullname' }))}
                                        {chip(cfg.nameFormat === 'first', 'First name + initial', () => setCfg({ nameFormat: 'first' }))}
                                        {chip(cfg.nameFormat === 'initials', 'Initials', () => setCfg({ nameFormat: 'initials' }))}
                                    </div>
                                </div>
                            )}

                            {tab === 'format' && (
                                <div>
                                    {head('How long it can be')}
                                    <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
                                        {[0, 300, 600, 1000, 2000].map(n => chip(cfg.maxChars === n, n ? `${n} characters` : 'No limit', () => setCfg({ maxChars: n })))}
                                        <input aria-label="Maximum characters" type="number" min={0} step={50} value={cfg.maxChars || ''} placeholder="Custom" onChange={(e) => setCfg({ maxChars: Math.max(0, parseInt(e.target.value, 10) || 0) })} className="px-2 py-1 rounded border border-slate-300 text-xs" style={{ width: 90 }} />
                                    </div>
                                    <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center', marginTop: 8 }}>
                                        <span style={{ fontSize: 12 }}>Areas per section:</span>
                                        {[0, 3, 5, 8, 12].map(n => chip(cfg.maxAreas === n, n ? `First ${n}` : 'All', () => setCfg({ maxAreas: n })))}
                                    </div>
                                    {head('Formatting')}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'max-content 1fr', gap: '8px 12px', alignItems: 'center', fontSize: 12 }}>
                                        <span>Bullet</span>{sel(cfg.bullet, UPDATE_BULLETS, v => setCfg({ bullet: v }), 'Bullet')}
                                        <span>Between parts</span>{sel(cfg.sep, UPDATE_SEPS, v => setCfg({ sep: v }), 'Separator')}
                                        <span>Section titles</span>{sel(cfg.headerStyle, UPDATE_HEADERS, v => setCfg({ headerStyle: v as UpdateConfig['headerStyle'] }), 'Section title style')}
                                        <span>Line spacing</span>{sel(cfg.spacing, [{ v: 'single', label: 'Single spaced' }, { v: 'sections', label: 'Blank line between sections' }, { v: 'double', label: 'Double spaced' }], v => setCfg({ spacing: v as UpdateConfig['spacing'] }), 'Line spacing')}
                                        <span>Production title</span><input aria-label="Production title" value={cfg.prodTitle} onChange={(e) => setCfg({ prodTitle: e.target.value })} className="px-2 py-1 rounded border border-slate-300 text-xs" />
                                        <span>Support title</span><input aria-label="Support title" value={cfg.supportTitle} onChange={(e) => setCfg({ supportTitle: e.target.value })} className="px-2 py-1 rounded border border-slate-300 text-xs" />
                                        <span>Finished area text</span><input aria-label="Finished area text" value={cfg.doneText} onChange={(e) => setCfg({ doneText: e.target.value })} className="px-2 py-1 rounded border border-slate-300 text-xs" />
                                        <span>Nobody out text</span><input aria-label="Text when nobody is out" value={cfg.allPresentText} onChange={(e) => setCfg({ allPresentText: e.target.value })} className="px-2 py-1 rounded border border-slate-300 text-xs" />
                                    </div>
                                </div>
                            )}

                            {tab === 'template' && (
                                <div>
                                    {head('Update template')}
                                    <div style={{ fontSize: 11, color: '#64748B', marginBottom: 4 }}>Write the update the way you want it. Placeholders are filled in from the board; a line holding only a section placeholder becomes that whole section. Click a placeholder to insert it at the cursor.</div>
                                    <textarea ref={tplRef} aria-label="Update template" value={cfg.template} onFocus={() => setTplFocus('template')} onChange={(e) => setCfg({ template: e.target.value })} rows={8} spellCheck={false}
                                        style={{ width: '100%', fontFamily: 'Consolas, monospace', fontSize: 12, padding: 8, borderRadius: 8, border: `1px solid ${tplFocus === 'template' ? BRAND.blue : '#CBD5E1'}`, resize: 'vertical' }} />
                                    <Button size="small" appearance="subtle" onClick={() => setCfg({ template: DEFAULT_UPDATE_TEMPLATE })}>Reset template</Button>
                                    {head('Update placeholders')}
                                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>{UPDATE_TOKENS.map(t => tokenBtn(t, 'update'))}</div>
                                    {head('Custom line for each area (optional)')}
                                    <div style={{ fontSize: 11, color: '#64748B', marginBottom: 4 }}>Leave blank to build the line from the Components tab. Parts that come out empty are removed with their separators.</div>
                                    <div style={{ fontSize: 12, fontWeight: 600, marginTop: 4 }}>Production area line</div>
                                    <input aria-label="Production area line" value={cfg.prodLine} onFocus={() => setTplFocus('prodLine')} onChange={(e) => setCfg({ prodLine: e.target.value })} placeholder="e.g. {name} ({hc}) | {status} | {eta} | {callout}" className="px-2 py-1 rounded border text-xs" style={{ width: '100%', fontFamily: 'Consolas, monospace', borderColor: tplFocus === 'prodLine' ? BRAND.blue : '#CBD5E1' }} />
                                    <div style={{ fontSize: 12, fontWeight: 600, marginTop: 8 }}>Support area line</div>
                                    <input aria-label="Support area line" value={cfg.supportLine} onFocus={() => setTplFocus('supportLine')} onChange={(e) => setCfg({ supportLine: e.target.value })} placeholder="e.g. {name} ({hc}) - {status}" className="px-2 py-1 rounded border text-xs" style={{ width: '100%', fontFamily: 'Consolas, monospace', borderColor: tplFocus === 'supportLine' ? BRAND.blue : '#CBD5E1' }} />
                                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginTop: 8 }}>{UPDATE_AREA_TOKENS.map(t => tokenBtn(t, 'area'))}</div>
                                    <div style={{ fontSize: 11, color: '#64748B', marginTop: 4 }}>Area placeholders go into the {tplFocus === 'supportLine' ? 'support' : 'production'} line (click a line field first to switch).</div>
                                </div>
                            )}

                            {tab === 'everyone' && (
                                <div>
                                    {head('Everyone\'s presets')}
                                    <div style={{ fontSize: 11, color: '#64748B', marginBottom: 6 }}>{fullAccess ? 'Full Access is on: you can open, edit and delete anyone\'s preset. Edits keep the original owner and note who changed it.' : 'You can open and copy anyone\'s preset. To edit or delete someone else\'s, unlock Full Access by clicking the Schwan\'s logo.'}</div>
                                    <div style={{ overflowX: 'auto' }}>
                                        <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 12 }}>
                                            <thead><tr>{['Preset', 'Owner', 'For all', 'Owner default', 'Saved', 'Kept', 'Actions'].map(h => <th key={h} style={{ textAlign: 'left', padding: '5px 6px', borderBottom: '2px solid #E2E8F0', fontSize: 11, color: '#475569' }}>{h}</th>)}</tr></thead>
                                            <tbody>
                                                {presets.length === 0 && <tr><td colSpan={7} style={{ padding: 8, color: '#64748B' }}>{loading ? 'Loading...' : 'No presets saved yet.'}</td></tr>}
                                                {presets.map(p => {
                                                    const editable = sameUpdateOwner(p.ownerKey, meKey) || fullAccess;
                                                    return (
                                                        <tr key={p.id} style={{ background: p.id === draft.id ? BRAND.blueSoft : undefined }}>
                                                            <td style={{ ...td, fontWeight: 700 }}>{p.name}{p.id === activeId ? <span style={{ marginLeft: 6, fontSize: 10, color: '#065F46' }}>in use by you</span> : null}</td>
                                                            <td style={td}>{ownerText(p)}{p.editedBy ? <div style={{ fontSize: 10, color: '#64748B' }}>edited by {p.editedBy}</div> : null}</td>
                                                            <td style={td}>{p.useForAll ? 'Yes' : '-'}</td>
                                                            <td style={td}>{p.ownerDefault ? 'Yes' : '-'}</td>
                                                            <td style={{ ...td, whiteSpace: 'nowrap' }}>{p.savedAt ? new Date(p.savedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '-'}</td>
                                                            <td style={td}>{p.where === 'dataverse' ? 'Dataverse' : 'This computer'}</td>
                                                            <td style={{ ...td, whiteSpace: 'nowrap' }}>
                                                                <Button size="small" appearance="secondary" onClick={() => { choose(p.id); setTab('components'); }}>{editable ? 'Open / Edit' : 'Open'}</Button>
                                                                {editable && <Button size="small" appearance="subtle" style={{ color: BRAND.red }} disabled={busy} onClick={() => remove(p)}>Delete</Button>}
                                                            </td>
                                                        </tr>
                                                    );
                                                })}
                                            </tbody>
                                        </table>
                                    </div>
                                    {head('Suggested Dataverse table')}
                                    <div style={{ fontSize: 12, color: '#334155' }}>
                                        Table <code>{UPDATE_PRESET_TABLE}</code> (entity set <code>{UPDATE_PRESET_SET}</code>). Status now: <b>{store.remote === 'ok' ? 'connected' : store.remote === 'missing' ? 'not created yet - presets are kept on this computer' : store.remote === 'error' ? `could not be read (${store.error})` : 'not checked'}</b>.
                                        {' '}Only the two required columns are needed; everything else is also kept inside the JSON, and the optional columns are filled when they exist.
                                    </div>
                                    <Button size="small" appearance="subtle" onClick={() => setShowAllSchema(s => !s)}>{showAllSchema ? 'Hide columns' : 'Show columns'}</Button>
                                    {showAllSchema && (
                                        <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 11, marginTop: 4 }}>
