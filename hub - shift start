    return {
        id: hubGuid(getField(r, asgIdCol())), key: s('craa5_assignmentkey'), guid: hubGuid(getField(r, 'craa5_equipmentguid')), equipment: s('craa5_equipment'),
        area: s('craa5_area'), room: s('craa5_room'), boardId: s('craa5_boardid'), shiftDate: s('craa5_shiftdate'), crew: hubCrew(s('craa5_crew')), team: hubGuid(getField(r, 'craa5_team')),
        kind: hubCleanKind(s('craa5_cleankind')), people: hubSplitGuids(s('craa5_employeeguids')), names: s('craa5_employees'), plannedStart: s('craa5_plannedstart'),
        minutes: isFinite(mins) && mins > 0 ? mins : null, order: Number(getField(r, 'craa5_order')) || 0, pinned: isBoolTrue(getField(r, 'craa5_pinned')),
