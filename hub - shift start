const presetKey = (crew: string, slotStart: number) => `${crew}|${Math.round(slotStart / 60000)}`;

function lsReadPresets(): Record<string, PresetBoard> {
    try {
        const raw = window.localStorage.getItem(PRESET_LS_KEY), o = raw ? JSON.parse(raw) : {}, out: Record<string, PresetBoard> = {};
