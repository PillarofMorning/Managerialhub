        const replCol = table === PLAN_TABLE ? 'craa5_shiftplan1' : table === ARCHIVE_TABLE ? 'craa5_shiftarchive1' : table === UPDATE_PRESET_TABLE ? 'craa5_updatepreset1' : 'craa5_name';
        return tableQuery(props, table, effFilter.replace(/\bcraa5_title\b/gi, replCol), select, top, orderBy);
    }
    const badSel = matches.find(n => sel.indexOf(n) >= 0 && n !== 'craa5_boardjson' && n !== 'craa5_details' && n !== table + 'id');
