    // Copy for Teams (Ganttly): the clipboard, or the old select-and-copy way where the clipboard is not allowed.
    const copyBoardText = function(text) {
        const done = function() { setCopiedAt(Date.now()); setTimeout(function() { setCopiedAt(0); }, 2500); };
        const fallback = function() {
            try {
                const ta = document.createElement('textarea');
                ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.top = '-1000px'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                const ok = document.execCommand('copy');
                document.body.removeChild(ta);
                if (ok) done(); else setPersonnelToast(tr('Copy is blocked here. Open Copy for Teams on another computer or browser.', 'Copiar esta bloqueado aqui. Use Copiar para Teams en otra computadora o navegador.'));
            } catch (e) { setPersonnelToast(tr('Copy is blocked here. Open Copy for Teams on another computer or browser.', 'Copiar esta bloqueado aqui. Use Copiar para Teams en otra computadora o navegador.')); }
        };
        try {
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') navigator.clipboard.writeText(text).then(done, fallback);
            else fallback();
        } catch (e) { fallback(); }
    };
