    // Ganttly (current): a check-off counts for the equipment's cadence (daily = a day, weekly = a week, counted from the shift
    // it was done in; see cadenceMsOf), so a finished clean stays out of the plan that long and then is due again. The check-offs
    // of the newest finished clean (older finished cleans go at once) are kept until the window's start has passed that due time (so the next clean keeps its block id, moves and check-off, and
    // the Dashboard keeps saying when it was last cleaned); a block started but never finished, a move or a downtime goes once
    // its time is before the window. Marks for a shift go a day after its clock-in has left the window (a shift cut at the
    // window's start still shows). A custom task goes a day after it was added has left the window, unless a check-off of it is
    // still inside it; it keeps its check-offs while it exists. Not before the Dataverse data is in: the cadence needs the
    // equipment's yes columns.
    useEffect(function() {
        if (!IS_CURRENT || isLoading) return;
        const DAY = 86400000;
        const markKeep = function(k) { const ms = Number(String(k).split('|')[1]); return !isNaN(ms) && ms >= globalStartMs - DAY; };   // key = crew|clock-in ms
        const prune = function(prev, test) {
            let changed = false;
            const next = {};
            Object.keys(prev).forEach(function(k) { if (test(k, prev[k])) next[k] = prev[k]; else changed = true; });
            return changed ? next : prev;
        };
        const inWindow = {};   // parents with a check-off still inside the window
        Object.keys(taskStatus).forEach(function(k) { const b = taskStatus[k]; if (b && b.startMs + (Number(b.durationMins) || 0) * 60000 >= globalStartMs) inWindow[b.parentId] = true; });
        const taskKeep = function(a) { return !(a && a.createdMs && a.createdMs < globalStartMs - DAY) || !!inWindow[a && a.id]; };   // custom tasks
        const keptCustom = {}, cadById = {};
        assets.forEach(function(a) {
            cadById[a.id] = cadenceMsOf(a);
            if (String(a.id).indexOf('custom_') === 0 && taskKeep(a)) keptCustom[a.id] = true;
        });
        setTaskStatus(function(prev) { return prune(prev, function(k, b) {
            if (!b) return true;
            const endMs = b.startMs + (Number(b.durationMins) || 0) * 60000;
            if (endMs >= globalStartMs) return true;
            if (b.status !== 'done') return false;
            if (String(b.parentId).indexOf('custom_') === 0) return !!keptCustom[b.parentId];   // done once: stays while the task does
            const p = scheduleData.parentById ? scheduleData.parentById[b.parentId] : null;
            if (p && p.keepIds && !p.keepIds[k]) return false;   // an older finished clean: only the newest one matters
            if (p && p.dueMs) return p.dueMs > globalStartMs;   // the finished clean's check-offs expire together, when it is due again
            return endMs + (cadById[b.parentId] !== undefined ? cadById[b.parentId] : DAY) > globalStartMs;
