                csvContent += [q(r.name), '', q(st.name), q(st.dept), q(''), st.heads, q(clk(st.start)), q(clk(st.end)), Math.round(st.end - st.start), '', q(st.early ? 'did not fit' : st.late ? 'after restart' : 'planned')].join(',') + '\n';
