    // 🚨 ARCHITECTURE NOTE: Dynamic Room Caps
    // If a room limit is deleted/empty by the user, we explicitly delete the key from the state dictionary.
    // The engine treats a missing key as "no cap", so the room can use as many on-shift workers as are free
    // (still bounded by the largest crew in the plan window).
    const handleRoomLimitsChange = function(area, val) { 
        setRoomLimits(function(prev) { 
            const parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed <= 0) {
                const next = Object.assign({}, prev);
                delete next[area];
                return next;
            }
            return Object.assign({}, prev, { [area]: parsed }); 
        }); 
    };

    const handleBaseMinsChange = function(assetId, val) { setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, { minutesRequired: Math.max(0, Number(val)||0) }) : a; }); }); };
    const handleAllergenMinsChange = function(assetId, val) { setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, { allergenMins: Math.max(0, Number(val)||0) }) : a; }); }); };
    const handleTaskHeadsChange = function(assetId, val) { setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, { heads: Math.max(1, Number(val)||1) }) : a; }); }); };
    const handlePriorityChange = function(assetId, newPriority) { setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, { priority: Math.max(1, Math.min(50, Number(newPriority)||1)) }) : a; }); }); };
    const handleToggleRoom = function(areaName) { setHiddenRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };
    const toggleDashboardRoom = function(areaName) { setCollapsedDashboardRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };
    const handleCompleteToggle = function(taskId, isComplete) {
        setAssets(function(prev) { return prev.map(function(a) { return a.id === taskId ? Object.assign({}, a, { isComplete: isComplete }) : a; }); });
    };

    const openRoomDowntime = function(areaName) {
        setDtTarget(areaName);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
        setIsRoomDtModalOpen(true);
    };

    const openEquipDowntime = function(equipId) {
        setDtTarget(equipId);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
        setIsEquipDtModalOpen(true);
    };

    const addDowntime = function(type) {
        if (!newDtDate || !newDtTime) return alert("Date and Time required.");
        if (dtTarget === 'GLOBAL') {
             setDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Global Downtime',
                     isCustom: true
                 }]);
             });
        } else {
             setTargetDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     type: type,
                     targetId: dtTarget,
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Maintenance'
                 }]);
             });
        }
        setIsRoomDtModalOpen(false);
        setIsEquipDtModalOpen(false);
    };

    const handleAddCustomTask = function() {
        if (!newTaskName.trim() || !newTaskArea.trim()) return alert("Name and Area are required.");
        const areaNameUpper = newTaskArea.toUpperCase();
        const newTask = {
            id: 'custom_' + Date.now(),
            name: newTaskName,
            area: areaNameUpper,
            minutesRequired: Number(newTaskMins),
            allergenMins: Number(newTaskMins),
            pbMins: 0,
            heads: Number(newTaskHeads),
            priority: Number(newTaskPriority),
            isComplete: false,
            isPinned: false
        };
        setAssets(function(prev) { return prev.concat([newTask]); });
        setIsCustomTaskModalOpen(false);
        setNewTaskName('');
        setNewTaskArea('');
        setNewTaskMins(60);
    };

    // 🚨 ARCHITECTURE NOTE: CSV Exporter
    // Exports precisely the calculated durations (which includes math for inspections and transit)
    // but excludes general shift breaks from the pure "Task Duration" calculation for Excel mapping.
    const handleExportExcel = () => {
        let csvContent = "Crew,Worker,Area,Task Name,Start Time,End Time,Duration (Mins)\n";
        const allTasks = [];
        scheduleData.groups.forEach(function(g) {
            g.tasks.forEach(function(t) { allTasks.push(t); });
        });
        for (let i = 0; i < globalHeadcount; i++) {
            const wName = laneRoster[i].name.replace(/"/g, '""');
            const wCrew = laneRoster[i].crew;
            const workerTasks = allTasks.filter(function(t) { return t.assignedLanes && t.assignedLanes.indexOf(i) > -1; });
            workerTasks.sort(function(a,b) { return a.startMin - b.startMin; });
            workerTasks.forEach(function(t) {
                const sTime = formatClockTime(ganttStartDate, ganttStartHour, t.startMin);
                const eTime = formatClockTime(ganttStartDate, ganttStartHour, t.startMin + t.finalDuration);
                const tName = `"${t.name.replace(/"/g, '""')}"`;
                csvContent += `"${wCrew}","${wName}","${t.originalArea}",${tName},"${sTime}","${eTime}",${Math.round(t.finalDuration)}\n`;
            });
        }
        scheduleData.unscheduled.forEach(function(t) {
            csvContent += `"","UNSCHEDULED","${t.originalArea}","${t.name.replace(/"/g, '""')}","","",${Math.round(t.rawWorkloadMins)}\n`;
        });
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        const url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", `Schedule_Export_${ganttStartDate}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    // ============================================================================
    // SECTION 5: SHIFT-AWARE CASCADE ENGINE (Gap-Finding, Affinity, Shift Handovers)
    // 🚨 ARCHITECTURE NOTE: Event-driven list scheduling across crews.
    // For every task (rooms in handover/priority order, tasks by priority then size) the engine walks
    // candidate start times (room handover, shift starts, the moment any worker frees up) and picks the
    // earliest moment where H on-shift workers are free for the whole (break-stretched) duration.
    // If the task cannot finish before the crew clocks out, it is SPLIT at shift end: the outgoing crew
    // does what fits, and a "(Pt N)" continuation carrying the remaining work + a handover overhead is
    // queued for the next crew. Work that cannot fit inside the planning window is reported as overflow.
    // ============================================================================
    const scheduleData = useMemo(function() {
        const workers = laneRoster.map(function(l) { return new Worker(l.lane, l.crew, l.name, l.windows); });
        const totalLanes = workers.length;
        const virtualRoomsMap = {};
        const CLEAN_TOGETHER_KEY = '__CLEAN_TOGETHER__';
        const globalStartMs = getGlobalStart(ganttStartDate, ganttStartHour).getTime();
        const allTasks = [];
        const unscheduled = [];
        
        // Ensure strictly omitted (hidden) rooms do not enter the mathematical queue
        assets.filter(function(a) { return !hiddenRooms[a.area]; }).forEach(function(rawT) {
            const area = rawT.area;
            const isCleanTogether = roomCleanTogether[area];
            const vRoomKey = isCleanTogether ? CLEAN_TOGETHER_KEY : area;
            
            if (!virtualRoomsMap[vRoomKey]) {
                virtualRoomsMap[vRoomKey] = {
                    id: vRoomKey,
                    name: isCleanTogether ? 'Combined Clean' : area,
                    isCombined: isCleanTogether,
                    tasks: [],
                    limit: Infinity, 
                    startOffset: Infinity,
                    priority: Infinity,
                    areas: {}
                };
            }
            
            const vRoom = virtualRoomsMap[vRoomKey];
            vRoom.areas[area] = true;
            
            // Max Workers = how many people may work in the room at the same time (blank = no cap).
            const rLimit = roomLimits[area] !== undefined ? roomLimits[area] : Infinity;
            if (rLimit < vRoom.limit) vRoom.limit = rLimit; 
            
            let rStartMins = 0;
            if (roomHandovers[area]) {
                const handMs = new Date(roomHandovers[area]).getTime();
                if (!isNaN(handMs)) rStartMins = Math.max(0, Math.round((handMs - globalStartMs) / 60000));
            }
            if (rStartMins < vRoom.startOffset) vRoom.startOffset = rStartMins;
            
            const rPri = roomPriority[area] || 2;
            if (rPri < vRoom.priority) vRoom.priority = rPri;
            
            const t = new Equipment(rawT, roomAllergen[area] || false, pbMode);
            t.isTransitActive = includeTransit;
            t.isInspectionActive = includeInspection;
            t.originalArea = area; 
            
            const rIntsRaw = targetDowntimes.filter(function(dt) { return dt.type === 'room' && dt.targetId === area; });
            const eIntsRaw = targetDowntimes.filter(function(dt) { return dt.type === 'equipment' && dt.targetId === t.id; });
            
            const mappedInts = rIntsRaw.concat(eIntsRaw).map(function(dt) {
                const dtMs = new Date(dt.dateTimeStr).getTime();
                const offset = Math.max(0, Math.round((dtMs - globalStartMs) / 60000));
                return { start: offset, end: offset + dt.duration, duration: dt.duration, label: dt.label, isCustom: true };
            });
            
            t.customInterrupts = mappedInts.concat(allInterrupts).sort(function(a,b){return a.start - b.start;});
            vRoom.tasks.push(t);
            allTasks.push(t);
        });

        const isAreaOf = function(vRoom, area) { return !!vRoom.areas[area]; };

        // Distinct workers (other than `exclude`) already working in this room during [start, end).
        const busyInRoom = function(vRoom, start, end, exclude) {
            let n = 0;
            workers.forEach(function(w) {
                if (exclude.indexOf(w.id) > -1) return;
                if (w.schedule.some(function(s) { return isAreaOf(vRoom, s.area) && Math.max(start, s.start) < Math.min(end, s.end); })) n++;
            });
            return n;
        };

        const capHeads = function(task, vRoom) {
            return Math.max(1, Math.min(task.heads, vRoom.limit, maxCrewSize, Math.max(1, totalLanes)));
        };
        
        // Pass 1: Handle Overrides (Pins) & Define Solid Walls
        Object.values(virtualRoomsMap).forEach(function(vRoom) {
            if (vRoom.startOffset === Infinity) vRoom.startOffset = 0;
            if (vRoom.isCombined) vRoom.limit = Infinity; 
            
            vRoom.unpinnedTasks = [];
            vRoom.tasks.forEach(function(task) {
                if (overrides[task.id] && totalLanes > 0) {
                    task.isPinned = true;
                    task.appliedHeads = Math.min(capHeads(task, vRoom), totalLanes);
                    task.startMin = overrides[task.id].startMin;
                    
                    let safeLane = overrides[task.id].startLane;
                    if (safeLane > totalLanes - task.appliedHeads) {
                        safeLane = Math.max(0, totalLanes - task.appliedHeads);
                    }
                    
                    task.assignedLanes = Array.from({length: task.appliedHeads}, function(_, i) { return safeLane + i; });
                    task.finalDuration = task.getDuration(task.customInterrupts, task.appliedHeads, task.startMin); 
                    task.segments = task.calculateSegments(task.customInterrupts, task.appliedHeads, task.startMin);
                    task.isOffShift = task.assignedLanes.some(function(l) { return !workers[l].isOnShift(task.startMin, task.startMin + task.finalDuration); });
                    
                    task.assignedLanes.forEach(function(l) {
                        workers[l].assign(task.startMin, task.startMin + task.finalDuration, task.id, task.originalArea);
                    });
                } else {
                    vRoom.unpinnedTasks.push(task);
                }
            });
        });

        const taskOrder = function(a, b) {
            if (a.priority !== b.priority) return a.priority - b.priority;
            return b.rawWorkloadMins - a.rawWorkloadMins;
        };

        // Every moment the picture can change: a worker frees up or a crew clocks in.
        const candidateTimes = function(from) {
            const set = {};
            set[from] = true;
            workers.forEach(function(w) {
                w.windows.forEach(function(win) { if (win.start > from) set[win.start] = true; });
                w.schedule.forEach(function(s) { if (s.end > from) set[s.end] = true; });
            });
            return Object.keys(set).map(Number).filter(function(t) { return t < planHorizonMins; }).sort(function(a, b) { return a - b; });
        };

        // Prefer one crew, people who already worked this area (fewer walk-overs), then the tightest fit.
        const pickLanes = function(options, H, task, preferLongest) {
            const crewCount = {};
            options.forEach(function(o) { crewCount[o.w.crew] = (crewCount[o.w.crew] || 0) + 1; });
            return options.slice().sort(function(a, b) {
                const ca = crewCount[a.w.crew] >= H ? 1 : 0, cb = crewCount[b.w.crew] >= H ? 1 : 0;
                if (ca !== cb) return cb - ca;
                const affA = a.w.schedule.some(function(s) { return s.area === task.originalArea; }) ? 1 : 0;
                const affB = b.w.schedule.some(function(s) { return s.area === task.originalArea; }) ? 1 : 0;
                if (affA !== affB) return affB - affA;
                if (a.r.run !== b.r.run) return preferLongest ? b.r.run - a.r.run : a.r.run - b.r.run;
                return a.w.id - b.w.id;
            }).slice(0, H);
        };

        const placeTask = function(task, H, lanes, start, duration) {
            task.startMin = start;
            task.appliedHeads = H;
            task.assignedLanes = lanes.slice().sort(function(a, b) { return a - b; });
            task.segments = task.calculateSegments(task.customInterrupts, H, start);
            task.finalDuration = duration;
            task.crew = workers[task.assignedLanes[0]].crew;
            task.assignedLanes.forEach(function(l) { workers[l].assign(start, start + duration, task.id, task.originalArea); });
        };

        // Pass 2: Cascade loop
        const sortedVRooms = Object.values(virtualRoomsMap).sort(function(a, b) {
            if (a.startOffset !== b.startOffset) return a.startOffset - b.startOffset;
            return a.priority - b.priority;
        });

        sortedVRooms.forEach(function(vRoom) {
            const queue = vRoom.unpinnedTasks.slice().sort(taskOrder);

            while (queue.length > 0) {
                const task = queue.shift();
                if (totalLanes === 0) { unscheduled.push(task); continue; }

                const H = capHeads(task, vRoom);
                const from = Math.max(vRoom.startOffset, task.earliestStart || 0);
                let placed = false;
                let continuation = null;

                const times = candidateTimes(from);
                for (let ci = 0; ci < times.length && !placed; ci++) {
                    const t = times[ci];
                    const dur = task.calculateDuration(t, task.customInterrupts, H);
                    const options = workers.map(function(w) { return { w: w, r: w.runFrom(t) }; }).filter(function(o) { return o.r.run > 0; });
                    if (options.length < H) continue;

                    // (a) Whole task fits before these workers clock out / get booked.
                    const fits = options.filter(function(o) { return o.r.run >= dur - 0.01; });
                    if (fits.length >= H) {
                        const chosen = pickLanes(fits, H, task, false);
                        const ids = chosen.map(function(o) { return o.w.id; });
                        if (busyInRoom(vRoom, t, t + dur, ids) + H <= vRoom.limit) {
                            placeTask(task, H, ids, t, dur);
                            placed = true;
                            break;
                        }
                    }

                    // (b) Shift handover: the outgoing crew works until clock-out, the rest carries over.
                    const handoverReady = options.filter(function(o) { return o.r.freeToShiftEnd; });
                    if (handoverReady.length >= H && task.splitIndex < 40) {
                        const chosen = pickLanes(handoverReady, H, task, true);
                        const ids = chosen.map(function(o) { return o.w.id; });
                        const usable = Math.min.apply(null, chosen.map(function(o) { return o.r.run; }));
                        const done = netWorkingMins(t, t + usable, task.customInterrupts) * H;
                        if (usable >= MIN_SPLIT_MINS && done > 0 && done < task.rawWorkloadMins && busyInRoom(vRoom, t, t + usable, ids) + H <= vRoom.limit) {
                            const remaining = task.rawWorkloadMins - done;

                            continuation = Object.assign(Object.create(Object.getPrototypeOf(task)), task);
                            continuation.splitIndex = task.splitIndex + 1;
                            continuation.id = task.parentId + '_p' + continuation.splitIndex;
                            continuation.name = task.baseName + ' (Pt ' + continuation.splitIndex + ')';
                            continuation.workOverrideMins = remaining + (handoverMins * H);
                            continuation.isSplitPart2 = true;
                            continuation.isSplitPart1 = false;
                            continuation.isTransitActive = false;
                            continuation.isInspectionActive = false;
                            continuation.earliestStart = t + usable;
                            continuation.assignedLanes = [];
                            continuation.segments = [];

                            if (task.splitIndex === 1) task.name = task.baseName + ' (Pt 1)';
                            task.workOverrideMins = done;
                            task.isSplitPart1 = true;
                            placeTask(task, H, ids, t, usable);
                            placed = true;
                            break;
                        }
                    }
                }

                if (!placed) { unscheduled.push(task); continue; }
                if (continuation) {
                    queue.unshift(continuation);
                    allTasks.push(continuation);
                }
            }
        });

        const scheduledTasks = allTasks.filter(function(t) { return unscheduled.indexOf(t) === -1 && t.assignedLanes && t.assignedLanes.length > 0; });

        const finalGrouped = {};
        scheduledTasks.forEach(function(t) {
            const area = t.originalArea;
            if (!finalGrouped[area]) finalGrouped[area] = { name: area, tasks: [], highestLane: 0 };
            finalGrouped[area].tasks.push(t);
            const tHigh = Math.max.apply(null, t.assignedLanes);
            if (tHigh > finalGrouped[area].highestLane) finalGrouped[area].highestLane = tHigh;
        });
        
        workers.forEach(function(w) { w.schedule.sort(function(a, b) { return a.start - b.start; }); });

        return {
            groups: Object.values(finalGrouped).sort(function(a, b) { return a.name.localeCompare(b.name); }),
            workers: workers,
            unscheduled: unscheduled
        };
    }, [assets, roomLimits, roomHandovers, roomPriority, roomCleanTogether, roomAllergen, overrides, targetDowntimes, allInterrupts, includeTransit, includeInspection, pbMode, hiddenRooms, laneRoster, maxCrewSize, planHorizonMins, handoverMins, ganttStartDate, ganttStartHour]);


    // ============================================================================
    // SECTION 6: DRAG AND DROP ENGINE
    // ============================================================================
    useEffect(function() {
        const handlePointerMove = function(e) {
            if (isPanning && scrollRef.current) {
                if (e && typeof e.preventDefault === 'function') e.preventDefault();
                const walk = (e.clientX - panStartX) * 1.5;
                if (Math.abs(walk) > 5) setHasDragged(true); 
                scrollRef.current.scrollLeft = panScrollLeft - walk;
            } else if (dragState) {
                if (e && typeof e.preventDefault === 'function') e.preventDefault();
                const deltaX = e.clientX - dragState.initialX;
                const deltaY = e.clientY - dragState.initialY;
                if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) setHasDragged(true);
                
                let newMin = dragState.initialMin + (deltaX / zoomLevel) * 60;
                newMin = Math.max(0, Math.round(newMin / 15) * 15); 
                let newLane = dragState.initialLane + Math.round(deltaY / LANE_HEIGHT_PX);
                newLane = Math.max(0, Math.min(newLane, globalHeadcount - dragState.appliedHeads));

                setDragState(function(prev) { return Object.assign({}, prev, { currentMin: newMin, currentLane: newLane }); });
            }
        };

        const handlePointerUp = function() {
            if (dragState) {
                if (hasDragged) {
                    setOverrides(function(prev) { return Object.assign({}, prev, { [dragState.taskId]: { startMin: dragState.currentMin, startLane: dragState.currentLane } }); });
                }
                setDragState(null);
            }
            if (isPanning) setIsPanning(false);
        };

        if (dragState || isPanning) {
            window.addEventListener('pointermove', handlePointerMove, {passive: false});
            window.addEventListener('pointerup', handlePointerUp);
            window.addEventListener('pointercancel', handlePointerUp);
        }
        return function() {
            window.removeEventListener('pointermove', handlePointerMove);
            window.removeEventListener('pointerup', handlePointerUp);
            window.removeEventListener('pointercancel', handlePointerUp);
        };
    }, [dragState, isPanning, panStartX, panScrollLeft, zoomLevel, hasDragged, globalHeadcount]);

    const onPanDown = function(e) {
        if (e.target && typeof e.target.closest === 'function' && (e.target.closest('.gantt-block-anim') || e.target.closest('.no-pan') || e.target.closest('input') || e.target.closest('button') || e.target.closest('select'))) return;
        setIsPanning(true); setHasDragged(false); setPanStartX(e.clientX); setPanScrollLeft(scrollRef.current ? scrollRef.current.scrollLeft : 0); 
        if (e.currentTarget && typeof e.currentTarget.setPointerCapture === 'function') e.currentTarget.setPointerCapture(e.pointerId);
    };

    if (isLoading) {
        return (
            <div className="min-h-screen bg-slate-50 flex flex-col items-center justify-center touch-pan">
                <Loader2 className="w-12 h-12 text-indigo-600 animate-spin mb-4" />
                <h2 className="text-xl font-bold text-slate-700">Loading Object-Oriented Intelligence Matrix...</h2>
            </div>
        );
    }

    let globalMaxEnd = 0;
    let totalManpowerMins = 0;
    const metricsWorkers = scheduleData.workers;
    
    scheduleData.groups.forEach(function(g) { 
        g.tasks.forEach(function(t) { 
            if (t.startMin + t.finalDuration > globalMaxEnd) globalMaxEnd = t.startMin + t.finalDuration; 
            totalManpowerMins += (t.finalDuration * t.appliedHeads);
        }); 
    });
    
    // Deep Metrics Calculation
    let deepTransit = 0, deepInspect = 0, deepBreak = 0, deepDown = 0;
    scheduleData.groups.forEach(function(g) {
        g.tasks.forEach(function(t) {
            if (t.isTransitActive && !t.isSplitPart2) deepTransit += (10 * t.appliedHeads);
            if (t.isInspectionActive) {
                let base = t.isPbActive && t.pbMins > 0 ? t.pbMins : (t.isAllergenActive && t.allergenMins > 0 ? t.allergenMins : t.baseMins);
                deepInspect += ((base * 0.10) / t.appliedHeads) * t.appliedHeads; 
            }
        });
    });
    
    // Breaks / downtime that land inside a worker's booked time (absorbed into their blocks).
    metricsWorkers.forEach(function(w) {
        w.schedule.forEach(function(slot) {
            allInterrupts.forEach(function(b) {
                const oStart = Math.max(slot.start, b.start);
                const oEnd = Math.min(slot.end, b.end);
                if (oEnd > oStart) {
                    if (b.isCustom) deepDown += (oEnd - oStart);
                    else deepBreak += (oEnd - oStart);
                }
            });
        });
    });

    // Per-crew utilization inside the plan window.
    const crewStats = [];
    laneRoster.forEach(function(l) {
        let cs = crewStats.find(function(c) { return c.crew === l.crew; });
        if (!cs) {
            cs = { crew: l.crew, heads: 0, availMins: 0, bookedMins: 0, shifts: shiftWindows.filter(function(w) { return w.crew === l.crew; }) };
            crewStats.push(cs);
        }
        const w = metricsWorkers[l.lane];
        cs.heads += 1;
        l.windows.forEach(function(win) { cs.availMins += (win.end - win.start); });
        if (w) w.schedule.forEach(function(s) { cs.bookedMins += (s.end - s.start); });
    });
    const unscheduledWorkMins = scheduleData.unscheduled.reduce(function(acc, t) { return acc + t.rawWorkloadMins; }, 0);
    const handoverCount = scheduleData.groups.reduce(function(acc, g) { return acc + g.tasks.filter(function(t) { return t.isSplitPart2; }).length; }, 0);
    
    const dynamicTotalHours = Math.max(Math.ceil(planHorizonMins / 60), Math.ceil(globalMaxEnd / 60)) + 2; 
    const GANTT_TOTAL_WIDTH_PX = dynamicTotalHours * zoomLevel;
    const hourStep = zoomLevel < 25 ? 4 : 2; 
    const TIME_MARKERS = Array.from({ length: Math.ceil(dynamicTotalHours / hourStep) + 1 }, function(_, i) { return i * hourStep; });
    
    let activeEditorTask = null;
