    }, [roomLimits, roomHandovers, roomPriority, roomCleanTogether, roomAllergen, roomConfigured, hiddenRooms, hideConfiguredRooms, hourlyRate, ganttStartDate, ganttStartHour, planHours, shiftRotation, rotationSource, crewHeadcountOverrides, absentEmployees, jobRoleChoices, handoverMins, includeBreaks, includeTransit, includeInspection, pbMode, liveReforecast]);

