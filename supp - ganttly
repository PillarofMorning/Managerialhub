                                                                                {p.name}{p.isLead ? ' · Lead' : WORK_KIND_SHORT[p.kind] ? ' · ' + WORK_KIND_SHORT[p.kind] : ''}
                                                                            </button>
                                                                        );
                                                                    })}
                                                                </div>
                                                            )}
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>

                        </div>
                    </div>
                );
            })()}

            {/* METRICS & ROI TAB — one-stop shop */}
