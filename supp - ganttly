// ---- Shift Start's saved task assignments (craa5_taskassignment) ----
// 🚨 ARCHITECTURE NOTE: the supervisor board in use ("beta - hub - shift start") saves one row per person instead of a
// board row: craa5_id = employee name, craa5__aaemp_guid = employee id, craa5_area = the room (or PTO / Sick / Late /
// Left Early), craa5_lead = the lead's name (the supervisor's own name for rooms the supervisor holds), craa5_team = the
// supervisor's name. Moving someone saves a new row, so the newest row per person is where they are now. Rows carry no
// reliable shift letter (the apps disagree on B/C), so a row belongs to the shift of its supervisor that was running when
// it was saved. Shift Start always stores the employee id (craa5__aaemp_guid); the employee hubs never do, so their equipment
// progress rows (equipment filled in, no employee id) are skipped. A hub can also write equipment into a Shift Start row in
// place; that row still counts, with its area matched to a room.
const SOURCES_VERSION = 2;       // bumped when Shift Start became the default source (see rosterSource / roomSource)
const TASK_ROW_TOP = 2000;
const TASK_ROW_DAYS = 4;          // never read further back than this, whatever the plan window says
const TASK_PRE_SHIFT_MIN = 60;    // a board saved up to an hour before clock-in counts for that shift
const TASK_ROW_FIELDS = ['craa5_taskassignmentid', 'craa5_id', 'craa5__aaemp_guid', 'craa5_area', 'craa5_lead', 'craa5_team', 'craa5_shift', 'craa5_equip', 'craa5_equipment', 'craa5_datetimeofassignment', 'createdon', 'modifiedon'];
const OUT_AREA_NAMES = ['pto', 'sick', 'late', 'left early', 'ncns'];
function odataDate(ms) { return new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z'); }
// Rows saved between sinceMs and untilMs, newest first. Returns null when the table couldn't be read (a refresh keeps what it had).
async function fetchTaskAssignmentRows(dataApi, sinceMs, untilMs) {
    // Only Shift Start's rows: they carry the employee id, or at least no equipment (the hubs' progress rows have equipment and
    // no id). Filtering on the server keeps the hubs' many progress rows from filling the row cap.
    const filter = 'modifiedon ge ' + odataDate(sinceMs) + ' and createdon le ' + odataDate(untilMs) + " and (craa5__aaemp_guid ne null or craa5_equip eq null or craa5_equip eq '')";
    let failed = false;
    const xrm = safeGetXrm();
    if (xrm && xrm.WebApi && typeof xrm.WebApi.retrieveMultipleRecords === 'function') {
        try {
            const res = await xrm.WebApi.retrieveMultipleRecords('craa5_taskassignment', '?$select=' + TASK_ROW_FIELDS.join(',') + '&$filter=' + filter + '&$orderby=modifiedon desc&$top=' + TASK_ROW_TOP);
            if (res && Array.isArray(res.entities)) return res.entities;
        } catch (e) { failed = true; }
    }
    if (dataApi && typeof dataApi === 'object' && typeof dataApi.queryTable === 'function') {
        try {
            let page = await dataApi.queryTable('craa5_taskassignment', { select: TASK_ROW_FIELDS, filter: filter, orderBy: 'modifiedon desc', pageSize: 250, top: TASK_ROW_TOP });
            if (page && Array.isArray(page.rows)) {
                const rows = page.rows.slice();
                while (page && page.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < TASK_ROW_TOP) {
                    page = await page.loadMoreRows();
                    if (page && Array.isArray(page.rows)) rows.push.apply(rows, page.rows);
                }
                return rows.slice(0, TASK_ROW_TOP);
            }
        } catch (e) { failed = true; }
    }
    return failed ? null : [];
}
function taskRowsSignature(rows) {
    return (rows || []).map(function(r) { return String(getRowField(r, 'craa5_taskassignmentid') || '') + '|' + String(getRowField(r, 'modifiedon') || ''); }).join(';');
}
function rowTimeMs(v) { const t = v ? Date.parse(v) : NaN; return isNaN(t) ? 0 : t; }
// Turns saved task-assignment rows into Shift Start boards (the same shape as a board row's JSON), one per supervisor per
// shift in the plan. who = { idByGuid, idByName, supIds, crewById } from the employee table; lines = Shift Start's lines
// (to match the area a hub wrote into a row). Returns { boards: { windowKey: [{ supervisor, crew, startMs, board,
// fromTasks: true }] }, stats }.
function boardsFromTaskRows(rows, windows, globalStartMs, who, lines) {
    const stats = { read: (rows || []).length, used: 0, equipment: 0, unknownPerson: 0, noShift: 0 };
    const out = {};
    if (!rows || !rows.length || !windows.length) return { boards: out, stats: stats };
    const nameKey = function(v) { return normS(formatFullName(String(v || '').trim())); };
    const idOfName = function(v) { return v ? (who.idByName[normS(v)] || who.idByName[nameKey(v)] || '') : ''; };
    const wins = windows.map(function(w) {
        return { key: w.key, crew: w.crew, s: globalStartMs + w.shiftStart * 60000 - TASK_PRE_SHIFT_MIN * 60000, e: globalStartMs + w.shiftEnd * 60000 };
    });
    const newest = {};   // windowKey -> employeeId -> that person's newest row in the shift (across supervisors)
    rows.forEach(function(r) {
        const empName = String(getRowField(r, 'craa5_id') || '').trim();
        if (/unassigned/i.test(empName)) return;
        const guid = String(getRowField(r, 'craa5__aaemp_guid') || '').replace(/[{}]/g, '').toLowerCase();
        const equipText = String(getRowField(r, 'craa5_equip') || getRowField(r, 'craa5_equipment') || '').trim();
        if (equipText && !guid) { stats.equipment++; return; }   // an employee hub's progress row
        const empId = (guid && who.idByGuid[guid]) || idOfName(empName);
        if (!empId) { stats.unknownPerson++; return; }
        const supName = String(getRowField(r, 'craa5_team') || '').trim();
        const supId = idOfName(supName);
        const supCrew = supId ? (who.crewById[supId] || '') : '';
        const tc = rowTimeMs(getRowField(r, 'craa5_datetimeofassignment')) || rowTimeMs(getRowField(r, 'createdon'));
        const tm = rowTimeMs(getRowField(r, 'modifiedon')) || tc;
        const inWin = function(w, t) { return t >= w.s && t < w.e; };
        // The supervisor's own crew decides the shift; saved again in a later shift (an unchanged row) counts for that shift too.
        // (A supervisor whose crew isn't on during the plan saved for another plan; only rows with no known supervisor go by time.)
        let hit = supCrew ? wins.filter(function(w) { return w.crew === supCrew && (inWin(w, tc) || inWin(w, tm)); }) : [];
        if (!hit.length && !supCrew) {
            hit = wins.filter(function(w) { return inWin(w, tc); });
            const letter = normalizeShift(getRowField(r, 'craa5_shift'));
            if (hit.length > 1 && letter) { const same = hit.filter(function(w) { return w.crew === letter; }); if (same.length) hit = same; }
            hit = hit.slice(0, 1);
        }
        if (!hit.length) { stats.noShift++; return; }
        let area = String(getRowField(r, 'craa5_area') || '').trim();
        if (equipText && area && OUT_AREA_NAMES.indexOf(normS(area)) === -1 && lines && lines.length) {
            // A hub that wrote equipment into the row also wrote that equipment's area; use the room it belongs to.
            const line = lineForArea(lines, area);
            if (line) area = line.name;
        }
        const item = { empId: empId, area: area, lead: String(getRowField(r, 'craa5_lead') || '').trim(), supName: supName, supId: supId, tc: tc, tm: tm, touched: !!equipText };
        hit.forEach(function(w) {
            // Newest row per person (when two were saved at the same moment, the one touched last), so someone moved to
            // another supervisor's board is only on that board.
            const n = newest[w.key] = newest[w.key] || {};
            const cur = n[empId];
            if (!cur || item.tc > cur.tc || (item.tc === cur.tc && item.tm > cur.tm)) n[empId] = item;
        });
    });
    windows.forEach(function(w) {
        const n = newest[w.key];
        if (!n) return;
        const all = Object.keys(n).map(function(id) { return n[id]; });
        // A hub saving into a row may also have put another supervisor's name on it; such a row stays with its lead's supervisor.
        const supOfLead = {};
        all.forEach(function(it) { const lk = nameKey(it.lead); if (lk && !it.touched && !supOfLead[lk]) supOfLead[lk] = it.supName; });
        const groups = {};   // supervisorKey -> { name, items }
        all.forEach(function(it) {
            const name = (it.touched && supOfLead[nameKey(it.lead)]) || it.supName;
            const sk = nameKey(name) || '(no supervisor)';
            const sg = groups[sk] = groups[sk] || { name: name, items: [] };
            sg.items.push(name === it.supName ? it : Object.assign({}, it, { supName: name, supId: idOfName(name) }));
        });
        out[w.key] = Object.keys(groups).map(function(sk) {
            const sg = groups[sk];
            const items = sg.items;
            const supKey = nameKey(sg.name);
            const leadOf = function(it) {
                if (!it.lead || nameKey(it.lead) === supKey) return '';
                const lid = idOfName(it.lead);
                if (!lid || who.supIds[lid] || lid === it.supId) return '';
                return lid;
            };
            // Anyone a row names as lead leads that team; everyone else is crew, whatever their role in the employee table.
            const leads = [];
            items.forEach(function(it) { const l = leadOf(it); if (l && leads.indexOf(l) === -1) leads.push(l); });
            const board = { leads: leads, members: {}, overtime: [], out: {}, downLines: [], manualLines: [], teamLines: {}, workerLine: {}, equip: {}, equipManual: [] };
            const lineIds = {};
            const lineIdOf = function(name) {
                const id = 't:' + normS(name);
                if (!lineIds[id]) { lineIds[id] = true; board.manualLines.push({ id: id, name: name }); }
                return id;
            };
            items.forEach(function(it) {
                stats.used++;
                const area = normS(it.area);
                if (OUT_AREA_NAMES.indexOf(area) > -1) { board.out[it.empId] = it.area; return; }
                const l = leadOf(it);
                const isLeadSelf = leads.indexOf(it.empId) > -1;
                if (!isLeadSelf) board.members[it.empId] = l;
                if (who.crewById[it.empId] && who.crewById[it.empId] !== w.crew && board.overtime.indexOf(it.empId) === -1) board.overtime.push(it.empId);
                if (!area || area === 'unassigned') return;
                const lid = lineIdOf(it.area);
                board.workerLine[it.empId] = lid;
                const owner = isLeadSelf ? it.empId : l;
                if (owner) { const tl = board.teamLines[owner] = board.teamLines[owner] || []; if (tl.indexOf(lid) === -1) tl.push(lid); }
            });
            return { supervisor: formatFullName(sg.name) || 'Shift Start', crew: w.crew, startMs: globalStartMs + w.shiftStart * 60000, board: board, fromTasks: true };
        });
    });
    return { boards: out, stats: stats };
}

