                                pct: pct,
                                isComplete: isComplete,
                                isFutureClean: isAreaFuture,
                                compInfo: compInfo,
                                roomObj: x
                            };

                            if (isComplete) completedAreas.push(areaObj);
                            else remainingAreas.push(areaObj);
                        });
