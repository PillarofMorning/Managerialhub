    }, [assets, roomLimits, roomHandovers, roomPriority, roomCleanTogether, roomAllergen, overrides, taskStatus, targetDowntimes, allInterrupts, includeTransit, includeInspection, pbMode, hiddenRooms, laneRoster, maxCrewSize, planHorizonMins, handoverMins, reforecastFrom, ganttStartDate, ganttStartHour]);

