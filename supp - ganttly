                                                const hasEquip = wk && wk.schedule && wk.schedule.length > 0;
                                                return l.windows.filter(function(w) { return w.start >= seat.start && w.end <= seat.end; }).map(function(w, wi) {
                                                    const leftPx = xOf(w.start);
                                                    const widthPx = Math.max(0, xEnd(w.end) - leftPx);
                                                    const dayDate = new Date(globalStartMs + Math.round(w.start) * 60000);
