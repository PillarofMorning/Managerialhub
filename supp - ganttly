                    className={(isGreen ? 'relative rounded-2xl border-2 p-4 flex flex-col justify-between transition-all duration-200 ' : 'relative bg-white rounded-2xl border border-slate-200 p-4 flex flex-col justify-between transition-all duration-200 ') + (isHovered ? 'shadow-2xl ring-2 ring-[#0072CE] ' : 'shadow-sm ') + (fullAccess ? 'hover:border-[#0072CE] cursor-pointer' : '')}
