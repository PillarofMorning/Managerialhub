                    // Add to obstacle logs
                    setObstacleLogs(function(prev) {
                        const next = [newObs].concat(prev);
                        try { localStorage.setItem('ganttly_obstacle_logs', JSON.stringify(next)); } catch (e) {}
                        return next;
                    });
                    saveObstacle(newObs).then(function(res) { const say = gtSaveSay('obstacle', res); if (say) setPersonnelToast(say); });

                    // Push into Ganttly downtime engine to shift schedule
                    const dtTimeStr = now.toISOString().slice(0, 16);
                    if (obstacleScope === 'global') {
                        setDowntimes(function(prev) {
                            return prev.concat([{
                                id: newObs.id,
                                dateTimeStr: dtTimeStr,
                                duration: dur,
                                label: 'Obstacle: ' + cat + ' - ' + newObs.text.slice(0, 30),
                                isCustom: true
                            }]);
                        });
                    } else {
                        setTargetDowntimes(function(prev) {
                            return prev.concat([{
                                id: newObs.id,
                                type: obstacleScope === 'area' ? 'room' : 'equipment',
                                targetId: targetObj.id,
                                dateTimeStr: dtTimeStr,
                                duration: dur,
                                label: 'Obstacle: ' + cat + ' - ' + newObs.text.slice(0, 30)
                            }]);
                        });
                    }

                    // Reset form
                    setObstacleText('');
                    setObstacleSearch('');
                    setObstacleSelectedTarget(null);
                    setObstacleProperSetup(false);
                    setObstacleSetupItems({ belts: false, clamps: false, reassembly: false, swabbed: false });
                    setPersonnelToast(tr('Downtime & obstacle logged for ', 'Paro y obstaculo registrado para ') + targetObj.name + ' (' + dur + 'm)');
                };

                const handleToggleSetupItem = function(obsId, key) {
                    const cur = obstacleLogs.find(function(item) { return item.id === obsId && item.properSetup; });
                    if (!cur) return;
                    const updatedSetup = Object.assign({}, cur.properSetup);
                    updatedSetup[key] = !updatedSetup[key];
                    const changed = Object.assign({}, cur, { properSetup: updatedSetup });
                    setObstacleLogs(function(prev) {
                        const next = prev.map(function(item) { return item.id === obsId ? Object.assign({}, item, { properSetup: updatedSetup }) : item; });
                        try { localStorage.setItem('ganttly_obstacle_logs', JSON.stringify(next)); } catch (e) {}
                        return next;
                    });
                    saveObstacle(changed).then(function(res) { const say = gtSaveSay('obstacle', res); if (say) setPersonnelToast(say); });
                };

                const handleResolveObstacle = function(obsId) {
                    const cur = obstacleLogs.find(function(item) { return item.id === obsId; });
                    const resolved = { status: 'resolved', resolvedAt: new Date().toISOString(), resolvedBy: gtWho() };
                    setObstacleLogs(function(prev) {
                        const next = prev.map(function(item) {
                            if (item.id === obsId) return Object.assign({}, item, resolved);
                            return item;
                        });
                        try { localStorage.setItem('ganttly_obstacle_logs', JSON.stringify(next)); } catch (e) {}
                        return next;
                    });
                    if (cur) saveObstacle(Object.assign({}, cur, resolved)).then(function(res) { const say = gtSaveSay('obstacle', res); if (say) setPersonnelToast(say); });
                    // Remove from timeline downtime
                    setDowntimes(function(prev) { return prev.filter(function(d) { return d.id !== obsId; }); });
                    setTargetDowntimes(function(prev) { return prev.filter(function(d) { return d.id !== obsId; }); });
                    setPersonnelToast(tr('Obstacle resolved & timeline cleared', 'Obstaculo resuelto y linea de tiempo liberada'));
                };

                const handleDeleteObstacle = function(obsId) {
                    // A shared obstacle is set inactive in the table (never deleted), so every computer drops it.
                    const cur = obstacleLogs.find(function(item) { return item.id === obsId; });
                    if (cur && cur.shared) saveObstacle(cur, { statecode: 1, statuscode: 2 }).then(function(res) { const say = gtSaveSay('obstacle', res); if (say) setPersonnelToast(say); });
                    setObstacleLogs(function(prev) {
                        const next = prev.filter(function(item) { return item.id !== obsId; });
                        try { localStorage.setItem('ganttly_obstacle_logs', JSON.stringify(next)); } catch (e) {}
                        return next;
                    });
                    setDowntimes(function(prev) { return prev.filter(function(d) { return d.id !== obsId; }); });
                    setTargetDowntimes(function(prev) { return prev.filter(function(d) { return d.id !== obsId; }); });
                };

                const activeObstacles = obstacleLogs.filter(function(o) { return o.status === 'active'; });

