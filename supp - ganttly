                        dateFormatted: dateFormatted,
                        scope: obstacleScope,
                        targetId: targetObj.id,
                        targetName: targetObj.name,
                        targetArea: targetObj.area,
                        category: cat,
                        text: obstacleText.trim(),
                        duration: dur,
                        properSetupRequired: !!obstacleProperSetup,
                        properSetup: obstacleProperSetup ? {
                            belts: !!obstacleSetupItems.belts,
                            clamps: !!obstacleSetupItems.clamps,
                            reassembly: !!obstacleSetupItems.reassembly,
                            swabbed: !!obstacleSetupItems.swabbed,
                            signedBy: obstacleSignoffName.trim(),
                            signedAt: obstacleSignoffName.trim() ? now.toISOString() : null
                        } : null,
                        status: 'active'
