                                                            <button onClick={function() { setExpandedRosters(function(prev) { return Object.assign({}, prev, { [crew]: !prev[crew] }); }); }} className="text-[11px] font-black text-[#0072CE] hover:text-[#00468B] flex items-center gap-1">
                                                                {expandedRosters[crew] ? <ChevronDown className="w-3.5 h-3.5" /> : <ChevronRight className="w-3.5 h-3.5" />} Roster / mark absent
                                                            </button>
