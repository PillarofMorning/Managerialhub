            const cStart = x.cleanStartMin !== undefined ? x.cleanStartMin : sMin;
            const cEnd = x.cleanEndMin !== undefined ? x.cleanEndMin : eMin;
            const rawSpan = cEnd > cStart ? (cEnd - cStart) : 60;
            const spanMins = Math.max(25, Math.min(710, rawSpan));
            const startDeg = minToClockDeg(cStart);
            const sweepDeg = Math.max(15, Math.min(352, (spanMins / 720) * 360));
            const endDeg = (startDeg + sweepDeg) % 360;
            const isGreen = !!x.isGreenCard;
