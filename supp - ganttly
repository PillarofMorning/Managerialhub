// The Shift Start board in use today saves craa5_taskassignment rows instead (see fetchTaskAssignmentRows); those rows are
// turned into the same board shape, one per supervisor per shift. Ganttly uses the boards as its roster (leads, their teams,
// who is out) and as its list of rooms. A shift in the plan with nothing saved yet (a future weekend) falls back to the
// employee table, so planning ahead still works.
// ============================================================================
const SPECIALIST_KINDS = ['chemical', 'admin', 'janitorial', 'inspector'];
const BOARD_PREFIX = 'Board · ';
const BOARD_MATCH_TOLERANCE_MS = 90 * 60000;
function parseBoardRow(row) {
    const name = String(getRowField(row, 'craa5_name') || '');
    if (name.indexOf(BOARD_PREFIX) !== 0) return null;
    const parts = name.slice(BOARD_PREFIX.length).split(' · ');
    if (parts.length < 3) return null;
    const when = parts[parts.length - 1].trim().match(/^(\d{4})-(\d{2})-(\d{2}) (\d{1,2}):(\d{2})$/);
    const crew = normalizeShift(parts[parts.length - 2]);
    if (!when || !crew) return null;
    let board = null;
    try { board = JSON.parse(String(getRowField(row, 'craa5_equipmentjson') || '')); } catch (e) {}
    if (!board || typeof board !== 'object') return null;
    return {
        supervisor: parts.slice(0, -2).join(' · '),
        crew: crew,
        startMs: new Date(Number(when[1]), Number(when[2]) - 1, Number(when[3]), Number(when[4]), Number(when[5])).getTime(),
        board: board
    };
}

// ---- Lines (craa5_aa_mss_area) and the equipment split, done the way Shift Start does it so the two screens agree ----
const STATUS_LINE_NAMES = ['pto', 'sick', 'late', 'left early', 'ncns', 'unassigned'];
const FIXED_AREA_KINDS = ['chemical', 'admin', 'janitorial'];
function normS(v) { return String(v === undefined || v === null ? '' : v).toLowerCase().trim(); }
function wordsOf(v) { return normS(v).split(/[^a-z0-9]+/).filter(Boolean); }
function hasWords(hay, needle) {
    return needle.length > 0 && hay.some(function(_, i) { return needle.every(function(w, j) { return hay[i + j] === w; }); });
}
function byNameNum(a, b) { return String(a.name).localeCompare(String(b.name), undefined, { numeric: true, sensitivity: 'base' }); }
// Shift Start's PIC rule for the split (Subcategory "1 - pic").
function isPicSubcategory(v) { return /^1\s*[-–]?\s*pic\b/.test(normS(v)); }
// Lines in table order: Shift Start matches equipment to lines in this order (before it sorts them for display).
function buildLineIndex(lineRows) {
    return lineRows.map(function(r) {
        return { id: String(getRowField(r, 'craa5_aa_mss_areaid') || ''), name: String(getRowField(r, 'craa5_area') || '').trim() };
    }).filter(function(l) { return l.id && l.name && STATUS_LINE_NAMES.indexOf(normS(l.name)) === -1; });
}
const manualLineId = function(name) { return 'manual:' + normS(name); };
// Which line an equipment area belongs to: exact name, else the longest line name it contains as whole words (Shift Start's
// rule). Chemical / admin / janitorial areas also match a line like "Chemical Clerk" (first by name, the line Shift Start puts
// those roles on). Last, a manual task on a board with exactly the area's name. Returns { id, name } or null.
function lineForArea(lines, area, manualNames) {
    const label = String(area === undefined || area === null ? '' : area);
    if (!label) return null;
    let line = lines.find(function(l) { return normS(l.name) === normS(label); });
    if (!line) {
        const w = wordsOf(label);
        line = lines.filter(function(l) { return hasWords(w, wordsOf(l.name)); }).sort(function(a, b) { return wordsOf(b.name).length - wordsOf(a.name).length; })[0];
    }
    if (!line && FIXED_AREA_KINDS.indexOf(normS(label)) > -1) {
        const re = new RegExp('\\b' + normS(label));
        line = lines.filter(function(l) { return re.test(normS(l.name)); }).sort(byNameNum)[0];
    }
    if (!line && manualNames && manualNames[normS(label)]) line = { id: manualLineId(label), name: manualNames[normS(label)] };
    return line || null;
}
// People working a line on a board (leads first, then team members), minus anyone marked out or not kept by `keep`.
function boardWorkersOn(board, lineId, keep) {
    const members = board.members && typeof board.members === 'object' ? board.members : {};
    const wl = board.workerLine && typeof board.workerLine === 'object' ? board.workerLine : {};
    const out = board.out && typeof board.out === 'object' ? board.out : {};
    const seen = {};
    return (Array.isArray(board.leads) ? board.leads : []).concat(Object.keys(members)).filter(function(id) {
        if (seen[id]) return false;
        seen[id] = true;
        return wl[id] === lineId && !out[id] && (!keep || keep(id));
    });
}
// Who gets which equipment on one line: hand-placed lines keep their placement; otherwise the equipment is dealt out evenly by
// role like Shift Start (a fixed area goes to the people whose role belongs there; PIC items to PIC-only roles; the rest to
// Sanitation Techs). Leads never take equipment here, hand-placed or not: what Shift Start gave a lead is left for the room's
// team. kindOf(id) is a person's work kind; keep(id) drops people Ganttly ignores. Returns { assetId: personId }.
function splitLineEquipment(board, line, lineAssets, kindOf, night, keep) {
    const leads = Array.isArray(board.leads) ? board.leads : [];
    const crew = boardWorkersOn(board, line.id, keep).filter(function(id) { return leads.indexOf(id) === -1; });
    const out = {};
    const manual = Array.isArray(board.equipManual) ? board.equipManual : [];
    if (manual.indexOf(line.id) > -1) {
        const eq = board.equip && typeof board.equip === 'object' ? board.equip : {};
        lineAssets.forEach(function(a) { if (eq[a.id] && crew.indexOf(eq[a.id]) > -1) out[a.id] = eq[a.id]; });
        return out;
    }
    const name = normS(line.name);
    const fixed = FIXED_AREA_KINDS.filter(function(k) { return name === k || new RegExp('\\b' + k).test(name); })[0];
    if (fixed) {
        const who = crew.filter(function(id) { return workerCanDo(kindOf(id), fixed, night); });
        if (who.length) { lineAssets.forEach(function(a, i) { out[a.id] = who[i % who.length]; }); return out; }
    }
    const regs = crew.filter(function(id) { return kindOf(id) === 'general'; });
    const pics = crew.filter(function(id) { return kindOf(id) === 'pic' || kindOf(id) === 'inspector'; });
    let r = 0, q = 0;
    lineAssets.forEach(function(a) {
        if (a.pic && pics.length) out[a.id] = pics[q++ % pics.length];
        else if (regs.length) out[a.id] = regs[r++ % regs.length];
    });
    return out;
}
// A board with line ids made canonical: a manual task named like a real line is that line, any other manual task becomes
// 'manual:<name>'. lineByName maps a normalized line name to its id. Returns the board plus { manualNames: { id: name } }.
function normalizeBoard(b, lineById, lineByName) {
    b = b && typeof b === 'object' ? b : {};
    const manualMap = {}, manualNames = {};
    (Array.isArray(b.manualLines) ? b.manualLines : []).forEach(function(ml) {
        if (!ml || !ml.id || !ml.name) return;
        const id = lineByName[normS(ml.name)] || manualLineId(ml.name);
        manualMap[ml.id] = id;
        if (!lineById[id]) manualNames[id] = String(ml.name).trim();
    });
    const canon = function(lid) { return lineById[lid] ? lid : (manualMap[lid] || ''); };
    const obj = function(v) { return v && typeof v === 'object' && !Array.isArray(v) ? v : {}; };
    const wl = {}, tl = {};
    Object.keys(obj(b.workerLine)).forEach(function(id) { const c = canon(b.workerLine[id]); if (c) wl[id] = c; });
    Object.keys(obj(b.teamLines)).forEach(function(lead) { tl[lead] = (Array.isArray(b.teamLines[lead]) ? b.teamLines[lead] : []).map(canon).filter(Boolean); });
    return {
        leads: Array.isArray(b.leads) ? b.leads.slice() : [],
        members: Object.assign({}, obj(b.members)),
        out: Object.assign({}, obj(b.out)),
        workerLine: wl,
        teamLines: tl,
        equip: Object.assign({}, obj(b.equip)),
        equipManual: (Array.isArray(b.equipManual) ? b.equipManual : []).map(canon).filter(Boolean),
        manualNames: manualNames
    };
}
// Every supervisor's board for one crew and shift as one board, so two supervisors on the same room share its equipment.
function mergeBoards(boards) {
    const m = { leads: [], members: {}, out: {}, workerLine: {}, teamLines: {}, equip: {}, equipManual: [], manualNames: {} };
    boards.forEach(function(b) {
        b.leads.forEach(function(id) { if (m.leads.indexOf(id) === -1) m.leads.push(id); });
        Object.keys(b.members).forEach(function(id) { if (!(id in m.members)) m.members[id] = b.members[id]; });
        Object.assign(m.out, b.out);
        Object.keys(b.workerLine).forEach(function(id) { if (!m.workerLine[id]) m.workerLine[id] = b.workerLine[id]; });
        Object.keys(b.teamLines).forEach(function(l) { m.teamLines[l] = (m.teamLines[l] || []).concat(b.teamLines[l]); });
        Object.keys(b.equip).forEach(function(aid) { if (!m.equip[aid]) m.equip[aid] = b.equip[aid]; });
        b.equipManual.forEach(function(l) { if (m.equipManual.indexOf(l) === -1) m.equipManual.push(l); });
        Object.assign(m.manualNames, b.manualNames);
    });
    return m;
}

// "Doe, John" -> "John Doe" (same convention as the Manager hub)
function formatFullName(name) {
    const parsed = String(name || '').trim();
    if (!parsed) return '';
    const parts = parsed.split(',');
    if (parts.length > 1) return parts.slice(1).join(',').trim() + ' ' + parts[0].trim();
    return parsed;
}

function simpleHash(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = ((h << 5) - h + str.charCodeAt(i)) | 0;
    return Math.abs(h).toString(36);
}

// ============================================================================
// SHIFT ROTATION
// 🚨 ARCHITECTURE NOTE: Shift Slots (4 crews, split Wednesday)
// A rotation is a list of slots: { crew, day, startHour, lengthHours }. `day` is the calendar day the slot
// STARTS (JS getDay(): 0 = Sun ... 6 = Sat). Default mirrors the plant pattern:
//   A: Sun–Tue 6a–6p, Wed 6a–12p          B: Wed 12p–6p, Thu–Sat 6a–6p
//   C: Sun–Tue 6p–6a, Wed 6p–12a          D: Wed night 12a–6a (Thu morning), Thu–Sat 6p–6a
// The craa5_workshift table (one row per slot) replaces this on load; Setup can also edit it.
// ============================================================================
const CREW_CODES = ['A', 'B', 'C', 'D'];
const DAY_LETTERS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const DAY_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const FALLBACK_CREW_SIZE = 8;
const MIN_SPLIT_MINS = 60;
const DEFAULT_SHIFT_ROTATION = [
    { crew: 'A', day: 0, startHour: 6, lengthHours: 12 }, { crew: 'A', day: 1, startHour: 6, lengthHours: 12 },
    { crew: 'A', day: 2, startHour: 6, lengthHours: 12 }, { crew: 'A', day: 3, startHour: 6, lengthHours: 6 },
    { crew: 'B', day: 3, startHour: 12, lengthHours: 6 }, { crew: 'B', day: 4, startHour: 6, lengthHours: 12 },
    { crew: 'B', day: 5, startHour: 6, lengthHours: 12 }, { crew: 'B', day: 6, startHour: 6, lengthHours: 12 },
    { crew: 'C', day: 0, startHour: 18, lengthHours: 12 }, { crew: 'C', day: 1, startHour: 18, lengthHours: 12 },
    { crew: 'C', day: 2, startHour: 18, lengthHours: 12 }, { crew: 'C', day: 3, startHour: 18, lengthHours: 6 },
    { crew: 'D', day: 4, startHour: 0, lengthHours: 6 }, { crew: 'D', day: 4, startHour: 18, lengthHours: 12 },
    { crew: 'D', day: 5, startHour: 18, lengthHours: 12 }, { crew: 'D', day: 6, startHour: 18, lengthHours: 12 }
];
const CREW_STYLES = {
    A: { badge: 'bg-sky-600 text-white', soft: 'bg-sky-50 border-sky-200 text-sky-900', line: 'border-sky-500' },
    B: { badge: 'bg-indigo-700 text-white', soft: 'bg-indigo-50 border-indigo-200 text-indigo-900', line: 'border-indigo-600' },
    C: { badge: 'bg-amber-500 text-white', soft: 'bg-amber-50 border-amber-200 text-amber-900', line: 'border-amber-500' },
    D: { badge: 'bg-violet-700 text-white', soft: 'bg-violet-50 border-violet-200 text-violet-900', line: 'border-violet-600' }
};

function getCrewStyle(crew) {
    return CREW_STYLES[crew] || { badge: 'bg-slate-500 text-white', soft: 'bg-slate-50 border-slate-200 text-slate-800', line: 'border-slate-400' };
}

function getRowField(row, name) {
    if (!row) return undefined;
    const fmt = row[name + '@OData.Community.Display.V1.FormattedValue'];
    if (fmt !== undefined) return fmt;
    if (row[name] !== undefined) return row[name];
    const lower = name.toLowerCase();
    const key = Object.keys(row).find(function(k) { return k.toLowerCase() === lower; });
    return key ? row[key] : undefined;
}

function slotLabel(s) {
    return DAY_NAMES[s.day] + ' ' + formatHourLabel(s.startHour) + '–' + formatHourLabel(s.startHour + s.lengthHours);
}

// craa5_workshift: one row per slot. craa5_dayname (text, e.g. "Wednesday"), craa5_daynumber (1 = Sun ... 7 = Sat),
// craa5_shiftcode (text A-D), craa5_shiftstarthour / craa5_shiftendhour (whole numbers).
// Dataverse rows can't hold 0 here, so midnight is stored as 1. If EVERY hour is stored +1 (1/7/13/19), all hours
// are shifted back by one instead. A row that starts after midnight (before 4AM) is the back half of that named
// day's night shift ("Wed 12am–6am" = Thursday 00:00–06:00) unless that would collide with another row, in which
// case it stays on the named day. Setup → "Show shift rows" lists how every row was read.
function parseWorkShiftRows(rows) {
    if (!rows || rows.length === 0) return null;
    const raw = [];
    rows.forEach(function(r) {
        const crew = normalizeShift(getRowField(r, 'craa5_shiftcode'));
        const dayName = String(getRowField(r, 'craa5_dayname') || '');
        const dayNum = parseInt(getRowField(r, 'craa5_daynumber'), 10);
        const startH = parseInt(getRowField(r, 'craa5_shiftstarthour'), 10);
        const endH = parseInt(getRowField(r, 'craa5_shiftendhour'), 10);
        raw.push({ crew: crew, dayName: dayName, dayNum: dayNum, startH: startH, endH: endH });
    });
    const hours = [];
    raw.forEach(function(x) { if (!isNaN(x.startH)) hours.push(x.startH); if (!isNaN(x.endH)) hours.push(x.endH); });
    const plusOne = hours.length > 0 && hours.every(function(h) { return h >= 1 && (h - 1) % 6 === 0; });
    const hasZeroDay = raw.some(function(x) { return x.dayNum === 0; });
    const fixHour = function(h) {
        if (plusOne) return (h - 1 + 24) % 24;
        if (h === 1 || h === 24) return 0;
        return ((h % 24) + 24) % 24;
    };
    const slots = [], details = [];
    const pending = [];
    raw.forEach(function(x) {
        const m = x.dayName.toLowerCase().match(/sun|mon|tue|wed|thu|fri|sat/);
        let day = m ? ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'].indexOf(m[0]) : (isNaN(x.dayNum) ? -1 : (hasZeroDay ? x.dayNum : x.dayNum - 1));
        const label = (x.crew || '?') + ' · ' + (x.dayName || ('day ' + x.dayNum)) + ' ' + x.startH + '→' + x.endH;
        if (!x.crew || day < 0 || isNaN(x.startH) || isNaN(x.endH)) { details.push({ label: label, result: 'skipped (missing crew/day/hours)', ok: false }); return; }
        day = ((day % 7) + 7) % 7;
        const sH = fixHour(x.startH), eH = fixHour(x.endH);
        const len = ((eH - sH + 24) % 24) || 24;
        const slot = { crew: x.crew, day: day, startHour: sH, lengthHours: len };
        if (sH < 4) { pending.push({ slot: slot, label: label }); return; }
        slots.push(slot);
        details.push({ label: label, result: x.crew + ' ' + slotLabel(slot), ok: true });
    });
    // After-midnight rows: named day vs the next calendar day — take whichever overlaps the other rows less.
    const hoursOf = function(s) { const out = []; for (let h = 0; h < s.lengthHours; h++) out.push((s.day * 24 + s.startHour + h) % 168); return out; };
    pending.forEach(function(p) {
        const taken = {};
        slots.forEach(function(s) { hoursOf(s).forEach(function(h) { taken[h] = true; }); });
        const asNamed = p.slot;
        const nextDay = Object.assign({}, p.slot, { day: (p.slot.day + 1) % 7 });
        const clash = function(s) { return hoursOf(s).filter(function(h) { return taken[h]; }).length; };
        const pick = clash(asNamed) < clash(nextDay) ? asNamed : nextDay;
        slots.push(pick);
        details.push({ label: p.label, result: pick.crew + ' ' + slotLabel(pick) + (pick === nextDay ? ' (after-midnight end of that night)' : ''), ok: true });
    });
    if (slots.length === 0) return { slots: null, details: details, hourMode: plusOne ? 'plus-one' : 'clock' };
    return { slots: slots, details: details, hourMode: plusOne ? 'all hours stored +1' : 'clock hours (1 = midnight)' };
}

// Which hours of the week no crew covers, and which have two crews at once.
function weeklyCoverage(slots) {
    const count = new Array(168).fill(0);
    const who = Array.from({ length: 168 }, function() { return []; });
    (slots || []).forEach(function(s) {
        for (let h = 0; h < s.lengthHours; h++) {
            const idx = (s.day * 24 + s.startHour + h) % 168;
            count[idx]++;
            if (who[idx].indexOf(s.crew) === -1) who[idx].push(s.crew);
        }
    });
    const ranges = function(test) {
        const out = [];
        for (let i = 0; i < 168; i++) {
            if (!test(i)) continue;
            let j = i;
            while (j + 1 < 168 && test(j + 1)) j++;
            out.push(DAY_NAMES[Math.floor(i / 24)] + ' ' + formatHourLabel(i % 24) + '–' + DAY_NAMES[Math.floor(((j + 1) % 168) / 24)] + ' ' + formatHourLabel((j + 1) % 24));
            i = j;
        }
        return out;
    };
    const gaps = ranges(function(i) { return count[i] === 0; });
    const overlaps = ranges(function(i) { return count[i] > 1; });
    return { coveredHours: count.filter(function(c) { return c > 0; }).length, gaps: gaps, overlaps: overlaps };
}

function sortSlots(slots) {
    return slots.slice().sort(function(a, b) { return a.crew.localeCompare(b.crew) || (a.day * 24 + a.startHour) - (b.day * 24 + b.startHour); });
}

// Every crew window that overlaps [0, horizonMins), as minutes from the plan start.
// Back-to-back slots of the same crew are merged (no artificial handover at midnight).
function buildShiftWindows(slots, planStart, horizonMins) {
    const raw = [];
    const days = Math.ceil(horizonMins / 1440) + 1;
    for (let day = -2; day <= days; day++) {
        const base = new Date(planStart.getFullYear(), planStart.getMonth(), planStart.getDate() + day);
        (slots || []).forEach(function(slot) {
            if (slot.day !== base.getDay()) return;
            const s = new Date(base.getFullYear(), base.getMonth(), base.getDate(), slot.startHour, 0, 0);
            const startOff = Math.round((s.getTime() - planStart.getTime()) / 60000);
            raw.push({ crew: slot.crew, shiftStart: startOff, shiftEnd: startOff + (slot.lengthHours || 12) * 60, startHour: slot.startHour, dayLabel: DAY_NAMES[base.getDay()] });
        });
    }
    raw.sort(function(a, b) { return a.crew.localeCompare(b.crew) || a.shiftStart - b.shiftStart; });
    const merged = [];
    raw.forEach(function(w) {
        const last = merged[merged.length - 1];
        if (last && last.crew === w.crew && w.shiftStart <= last.shiftEnd) last.shiftEnd = Math.max(last.shiftEnd, w.shiftEnd);
        else merged.push(Object.assign({}, w));
    });
    return merged
        .map(function(w) { return Object.assign(w, { start: Math.max(0, w.shiftStart), end: Math.min(horizonMins, w.shiftEnd) }); })
        .filter(function(w) { return w.end > w.start; })
        .sort(function(a, b) { return a.start - b.start || a.crew.localeCompare(b.crew); });
}

// Working minutes inside [start, end) once breaks / downtimes (possibly overlapping) are removed.
function netWorkingMins(start, end, interrupts) {
    let blocked = 0, cursor = start;
    (interrupts || []).slice().sort(function(a, b) { return a.start - b.start; }).forEach(function(b) {
        const s = Math.max(b.start, cursor), e = Math.min(b.end, end);
        if (e > s) { blocked += e - s; cursor = e; }
    });
    return Math.max(0, end - start - blocked);
}

function formatHourLabel(h) {
    const hh = ((h % 24) + 24) % 24;
    const ampm = hh >= 12 ? 'PM' : 'AM';
    return (hh % 12 || 12) + ampm;
}

function formatMinutesToHours(totalMinutes) {
    if (!totalMinutes && totalMinutes !== 0) return "0h 00m";
    const h = Math.floor(totalMinutes / 60);
    const m = Math.round(totalMinutes % 60);
    return `${h}h ${m < 10 ? '0' : ''}${m}m`;
}

function getGlobalStart(shiftDate, shiftStartHour) {
    if (!shiftDate || typeof shiftDate !== 'string') {
        const fallback = new Date();
        fallback.setHours(shiftStartHour || 0, 0, 0, 0);
        return fallback;
    }
    const parts = shiftDate.split('-');
    if (parts.length !== 3) {
        const fallback = new Date();
        fallback.setHours(shiftStartHour || 0, 0, 0, 0);
        return fallback;
    }
    return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10), shiftStartHour, 0, 0);
}

function getDatetimeLocalString(offsetMins, shiftDate, shiftStartHour) {
    if (!shiftDate || typeof shiftDate !== 'string') return "";
    const d = getGlobalStart(shiftDate, shiftStartHour);
    d.setMinutes(d.getMinutes() + (offsetMins || 0));
    const yyyy = d.getFullYear();
    const MM = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    return yyyy + '-' + MM + '-' + dd + 'T' + hh + ':' + mm;
}

function formatClockTime(shiftDateStr, startHour, elapsedMinutes) {
    if (!shiftDateStr || typeof shiftDateStr !== 'string') return "";
    const d = getGlobalStart(shiftDateStr, startHour);
    d.setMinutes(d.getMinutes() + elapsedMinutes);
    let m = d.getMonth() + 1;
    let dd = d.getDate();
    let h = d.getHours();
    let mins = d.getMinutes();
    let ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    h = h ? h : 12; 
    return m + '/' + (dd < 10 ? '0'+dd : dd) + ' ' + h + ':' + (mins < 10 ? '0'+mins : mins) + ' ' + ampm;
}

function formatGanttHeaderTime(shiftDateStr, startHour, elapsedMinutes) {
    if (!shiftDateStr || typeof shiftDateStr !== 'string') return "";
    const d = getGlobalStart(shiftDateStr, startHour);
    d.setMinutes(d.getMinutes() + elapsedMinutes);
    let m = d.getMonth() + 1;
    let dd = d.getDate();
    let h = d.getHours();
    let ampm = h >= 12 ? 'p' : 'a';
    h = h % 12;
    h = h ? h : 12; 
    return m + '-' + (dd < 10 ? '0'+dd : dd) + ' ' + h + ampm;
}

function getRoomColor(roomName) {
    if (!roomName) return 'bg-slate-500';
    const lower = String(roomName).toLowerCase();
    
    // 🚨 USER PREFERENCE OVERRIDE: Exact hex mapping for specific rooms
    if (lower.indexOf('breading') !== -1) return 'bg-amber-800'; 
    if (lower.indexOf('custard') !== -1) return 'bg-orange-500'; 
    if (lower.indexOf('4') !== -1) return 'bg-red-500';          
    if (lower.indexOf('5') !== -1) return 'bg-purple-500';       
    if (lower.indexOf('wj') !== -1 || lower.indexOf('waterjet') !== -1) return 'bg-blue-500'; 
    
    // Fallback hash logic for dynamic un-mapped rooms
    let hash = 0;
    for (let i = 0; i < roomName.length; i++) {
        hash = roomName.charCodeAt(i) + ((hash << 5) - hash);
    }
    const colors = ['bg-emerald-500', 'bg-teal-500', 'bg-cyan-500', 'bg-indigo-500', 'bg-pink-500'];
    return colors[Math.abs(hash) % colors.length];
}

function getOverlap(pStart, pEnd, sStart, sEnd) {
    const oStart = Math.max(pStart, sStart);
    const oEnd = Math.min(pEnd, sEnd);
    if (oEnd <= oStart) return null;
    return {
        leftPct: ((oStart - sStart) / (sEnd - sStart)) * 100,
        widthPct: ((oEnd - oStart) / (sEnd - sStart)) * 100
    };
}

