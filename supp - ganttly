    // How many pieces Save equipment would save for these shifts (asgUnsaved), and how many of them are a person's changes.
    const asgUnsavedCount = function(wins) {
        let all = 0, edits = 0;
        (wins || []).forEach(function(w) { asgUnsaved(w ? windowPlans[w.key] : null).forEach(function(it) { all++; if (it.why === 'edit') edits++; }); });
        return { all: all, edits: edits };
    };
    // Save equipment: everything not saved for these shifts (asgUnsaved: a person's changes, new pieces of the even split, pieces
    // split again) to _g_ Assignment, after any save already on the way. Pinned rows are saved as source 'ganttly' (Shift Start
    // keeps them), the rest as 'auto'. Each row is read again first: a row a person pinned on another device after this screen
    // read it, or took off the shift there, stays theirs; so does a new piece Shift Start saved first. A change that saved (or
    // stayed theirs) leaves asgEdits; one that failed stays, so Save can be pressed again.
    const asgSaveWin = function(wins) {
        if (!IS_CURRENT || asgState.status !== 'ok') return false;
        const who = String(gtWho() || 'Ganttly').slice(0, 200);
        const jobs = [];
        (wins || []).forEach(function(w) {
            const plan = w ? windowPlans[w.key] : null;
            if (!plan || !plan.asg) return;
            const shiftDate = hubShiftDate(globalStartMs + w.shiftStart * 60000), crew = hubCrew(w.crew), teamOf = asgTeamOf(w);
            asgUnsaved(plan).forEach(function(it) {
                const a = plan.asg[it.aid], ek = shiftDate + '|' + crew + '|' + a.guid;
                const people = it.people.map(hubGuid).filter(function(g, i, arr) { return g && arr.indexOf(g) === i; });
                jobs.push({ a: a, ek: ek, at: asgEdits[ek] ? asgEdits[ek].at : 0, why: it.why, shiftDate: shiftDate, crew: crew, team: people.length ? teamOf(people[0]) : '',
                    people: people, order: Math.max(0, Math.floor(Number(it.order) || 0)), pinned: !!it.pinned, readRev: it.readRev || 0 });
            });
        });
        if (!jobs.length) { setAsgAction({ text: tr('Nothing to save: the shared list is up to date.', 'Nada que guardar: la lista compartida esta al dia.'), tone: 'ok', at: Date.now() }); return false; }
        const dates = jobs.map(function(x) { return x.shiftDate; }).filter(function(d, i, arr) { return arr.indexOf(d) === i; });
        setAsgSaving(function(n) { return n + 1; });
        setAsgAction({ text: tr('Saving ' + jobs.length + ' pieces...', 'Guardando ' + jobs.length + ' piezas...'), tone: 'ok', at: Date.now() });
        const run = function() {
            let saved = 0, lost = 0, failed = 0, err = '';
            const settled = {}, rows = [];
            return asgRead(props.dataApi, dates, true).then(function(fresh) {
                if (fresh.rows === null) { failed = jobs.length; err = fresh.err || fresh.status || ''; return; }
                const byKey = {};
                fresh.rows.forEach(function(r) { if (!byKey[r.key] || r.rev > byKey[r.key].rev) byKey[r.key] = r; });
                const step = function(i) {
                    if (i >= jobs.length) return Promise.resolve();
                    const x = jobs[i], now = byKey[x.a.key] || null;
                    const theirs = !!now && (!now.active || (x.why === 'new') || (x.why === 'resplit' && (now.rev !== x.readRev || now.pinned))
                        || (x.why === 'edit' && now.rev > x.readRev && now.pinned && now.source !== 'ganttly'));
                    if (theirs) { lost++; settled[x.ek] = x.at; return step(i + 1); }
                    const rev = (now ? now.rev : x.readRev) + 1, source = x.pinned ? 'ganttly' : 'auto';
                    return gtSave(props.dataApi, 'assignment', x.a.key, {
                        craa5_equipmentguid: x.a.guid, craa5_equipment: String(x.a.name || '').slice(0, 200), craa5_area: String(x.a.area || '').slice(0, 100), craa5_room: String(x.a.room || x.a.area || '').slice(0, 100),
                        craa5_shiftdate: x.shiftDate, craa5_crew: x.crew, craa5_team: x.team || undefined, craa5_cleankind: x.a.kind,
                        craa5_employeeguids: hubGuidList(x.people), craa5_employees: x.people.map(asgNameOf).filter(Boolean).join(' / ').slice(0, 400),
                        craa5_plannedminutes: x.a.minutes > 0 ? Math.round(x.a.minutes) : undefined,
                        craa5_order: x.order || undefined, craa5_pinned: x.pinned, craa5_source: source,
                        craa5_updatedby: who, craa5_rev: rev
                    }, { rid: asgRowIdOf(x.a.key), update: !!now }).then(function(res) {
                        if (res.ok) {
                            saved++; settled[x.ek] = x.at;
                            rows.push(Object.assign({}, now || { id: asgRowIdOf(x.a.key), boardId: '', plannedStart: '' }, { key: x.a.key, guid: x.a.guid, shiftDate: x.shiftDate, crew: x.crew, kind: x.a.kind,
                                team: x.team, area: x.a.area, room: x.a.room, equipment: x.a.name, plannedMinutes: Math.round(x.a.minutes) || 0, people: x.people, order: x.order, pinned: x.pinned, source: source, rev: rev, active: true }));
                        } else { failed++; err = err || res.err || res.status; }
                        return step(i + 1);
                    });
                };
                return step(0);
            }).then(null, function(e) { failed = failed || jobs.length - saved - lost; err = err || swErrText(e); }).then(function() {
                setAsgSaving(function(n) { return Math.max(0, n - 1); });
                // Saved rows show at once; the read that follows brings the rest.
                if (rows.length) {
                    const by = {};
                    rows.forEach(function(r) { by[r.key] = r; });
                    setAsgState(function(prev) { return Object.assign({}, prev, { rows: prev.rows.filter(function(r) { return !by[r.key]; }).concat(rows), sig: '' }); });
                }
                // A change made again while this save was on the way stays for the next Save.
                setAsgEdits(function(prev) {
                    let changed = false;
                    const next = Object.assign({}, prev);
                    Object.keys(settled).forEach(function(k) { if (next[k] && next[k].at === settled[k]) { delete next[k]; changed = true; } });
                    return changed ? next : prev;
                });
                noteGt('assignment');
                setAsgNote(function(prev) { return Object.assign({}, prev, { saved: prev.saved + saved, failed: failed, lost: lost, err: failed ? err : '', at: Date.now() }); });
                const parts = [];
                if (saved) parts.push(tr('Saved ' + saved + ' pieces: Shift Start shows the same list', 'Se guardaron ' + saved + ' piezas: Shift Start muestra la misma lista'));
                if (lost) parts.push(tr(lost + ' changed on another device first, so that change stays', lost + ' cambiado antes en otro equipo, se queda ese cambio'));
                if (failed) parts.push(tr(failed + ' not saved (press Save equipment again): ', failed + ' sin guardar (presione Guardar equipo otra vez): ') + err);
                setAsgAction({ text: parts.join('. '), tone: failed ? 'bad' : lost ? 'warn' : 'ok', at: Date.now() });
                loadAsgRef.current();
            });
        };
        asgQueueRef.current = asgQueueRef.current.then(run, run);
        return true;
    };
    // A piece moved to a person on the Gantt is pinned on the shared equipment list (_g_ Assignment, spec step 4), so Shift Start
    // shows it on that person too, once Save equipment is pressed; pinned === false hands it back to auto (Unpin). Current and
    // next shift only. A row a person pinned on another device after this screen read it stays theirs.
    const asgPin = function(task, lanes, pinned) {
        if (!IS_CURRENT || !task || asgState.status !== 'ok') return;
        const ppl = (lanes || []).map(function(l) { const lr = laneRoster[l]; return lr && !lr.isPlaceholder && hubIsGuid(lr.empId) ? hubGuid(lr.empId) : ''; }).filter(function(g, i, arr) { return g && arr.indexOf(g) === i; });
        const crew = lanes && lanes.length && laneRoster[lanes[0]] ? laneRoster[lanes[0]].crew : '';
        const nowMs = Date.now();
        const wins = shiftWindows.filter(function(w) { return globalStartMs + w.shiftEnd * 60000 > nowMs; }).sort(function(a, b) { return a.shiftStart - b.shiftStart; }).slice(0, 2);
        const w = wins.find(function(x) { const pl = windowPlans[x.key]; return (!crew || x.crew === crew) && pl && pl.asg && pl.asg[task.parentId]; });
        if (!w) return;
        const plan = windowPlans[w.key], a = plan.asg[task.parentId];
        const people = pinned === false || !ppl.length ? a.people : ppl;
        let order = a.order;
        if (people[0] !== a.people[0]) {
            order = 0;
            Object.keys(plan.asg).forEach(function(k) { const x = plan.asg[k]; if (x.people[0] === people[0] && k !== String(task.parentId)) order = Math.max(order, x.order || 0); });
            order += 1;
        }
        asgEdit(w, [{ aid: task.parentId, people: people, order: order, pinned: pinned !== false }], { keepLocal: true, what: a.name });
    };

    // A piece a person pinned in Shift Start on someone else after this computer moved it by hand: the shared list is the one
    // answer, so the local move is dropped (unless this computer pinned it in the last 2 minutes and its save is on the way).
    useEffect(function() {
        if (!IS_CURRENT || asgState.status !== 'ok') return;
        const pinBy = {};
        asgState.rows.forEach(function(r) { if (r.pinned && r.source !== 'ganttly' && r.people.length) pinBy[r.guid] = r.people; });
        if (!Object.keys(pinBy).length) return;
        const keyEmp = {};
        laneRoster.forEach(function(l) { if (l && l.key) keyEmp[l.key] = hubGuid(l.empId); });
        const recent = asgPinnedAtRef.current, nowMs = Date.now();
        const waiting = {};   // pieces with a change not saved yet: this computer's move stays until Save or Discard
        Object.keys(asgEdits).forEach(function(k) { waiting[asgEdits[k].guid] = true; });
        setOverrides(function(prev) {
            let changed = false;
            const next = {};
            Object.keys(prev).forEach(function(tid) {
                const ov = prev[tid], t = scheduleData.taskById ? scheduleData.taskById[tid] : null;
                const pid = hubGuid(t ? t.parentId : String(tid).split('_')[0]), ppl = pinBy[pid];
                if (ppl && !waiting[pid] && !(recent[pid] && nowMs - recent[pid] < 2 * 60000) && ov && Array.isArray(ov.laneKeys) && ov.laneKeys.length && !ov.laneKeys.some(function(k) { return ppl.indexOf(keyEmp[k]) > -1; })) { changed = true; return; }
                next[tid] = ov;
            });
            return changed ? next : prev;
        });
    }, [asgState.rows, asgEdits]);

    // Move a block to an exact start + exact workers (planned -> manual override, frozen -> edit the record).
    const moveBlock = function(task, startMin, lanes) {
        // A lead set to no tasks can't be given a block (one already on them, e.g. checked off before the setting changed, can still move).
        const was = task.assignedLanes || [];
        if (lanes.some(function(l) { return was.indexOf(l) === -1 && laneRoster[l] && laneRoster[l].isLead && laneRoster[l].kind === 'leadership'; })) return;
        const keys = laneKeysOf(lanes);
        if (task.isFrozen) {
            setTaskStatus(function(prev) {
                if (!prev[task.id]) return prev;
                const moved = { startMs: globalStartMs + startMin * 60000, laneKeys: keys };
                if (IS_CURRENT) { moved.syncKey = checkoffKeyOf(task.id, prev[task.id]); moved.syncAt = Date.now(); }
                return Object.assign({}, prev, { [task.id]: Object.assign({}, prev[task.id], moved) });
            });
        } else {
            // A split part keeps only its own share of the work; the remainder keeps flowing (later this shift or on a later one).
            const ov = { startMs: globalStartMs + startMin * 60000, laneKeys: keys };
            if (task.isSplitPart1 || task.isSplitPart2) ov.workMins = task.rawWorkloadMins;
            setOverrides(function(prev) { return Object.assign({}, prev, { [task.id]: ov }); });
            asgPin(task, lanes, true);
        }
    };

    // Swap one worker on a block for another, keeping the time.
    const reassignWorker = function(task, fromLane, toLane) {
        if (fromLane === toLane) return;
        const currentLanes = task.assignedLanes || [];
        const lanes = currentLanes.map(function(l) { return l === fromLane ? toLane : l; });
        moveBlock(task, task.startMin, lanes.filter(function(l, i) { return lanes.indexOf(l) === i; }));
    };

    const unassignTask = function(task, fromLane) {
        if (!task) return;
        if (task.isFrozen) {
            setTaskStatus(function(prev) {
                const n = Object.assign({}, prev);
                delete n[task.id];
                return n;
            });
        }
        const currentLanes = task.assignedLanes || [];
        const remainingLanes = (fromLane !== undefined && fromLane !== null)
            ? currentLanes.filter(function(l) { return l !== fromLane; })
            : [];
        if (remainingLanes.length > 0) {
            moveBlock(task, task.startMin, remainingLanes);
        } else {
            setOverrides(function(prev) {
                return Object.assign({}, prev, { [task.id]: { unassigned: true, laneKeys: [] } });
            });
        }
    };

    const assignTaskToLane = function(task, toLane, customStartMin) {
        if (!task || toLane === undefined || toLane === null) return;
        let curWin = null;
        if (typeof activeBoardKey !== 'undefined' && shiftWindows) {
            curWin = shiftWindows.find(function(w) { return w.key === activeBoardKey; });
        }
        if (!curWin && laneRoster[toLane] && shiftWindows) {
            curWin = shiftWindows.find(function(w) { return w.crew === laneRoster[toLane].crew; });
        }
        const startM = (customStartMin !== undefined && customStartMin >= 0)
            ? customStartMin
            : (task.startMin >= 0 && curWin && task.startMin >= curWin.start && task.startMin < curWin.end)
                ? task.startMin
                : (curWin ? Math.max(curWin.start, (nowMin > curWin.start && nowMin < curWin.end) ? Math.ceil(nowMin / 5) * 5 : curWin.start) : 0);
        const keys = laneKeysOf([toLane]);
        if (task.isFrozen) {
            setTaskStatus(function(prev) {
                if (!prev[task.id]) return prev;
                return Object.assign({}, prev, { [task.id]: Object.assign({}, prev[task.id], { laneKeys: keys }) });
            });
        } else {
            setOverrides(function(prev) {
                return Object.assign({}, prev, { [task.id]: { startMs: globalStartMs + startM * 60000, laneKeys: keys, unassigned: false } });
            });
            asgPin(task, [toLane], true);
        }
    };

    const findTask = function(taskId) {
        if (scheduleData && scheduleData.taskById && scheduleData.taskById[taskId]) return scheduleData.taskById[taskId];
        let found = null;
        if (scheduleData && scheduleData.groups) {
            scheduleData.groups.some(function(g) {
                found = (g.tasks || []).find(function(t) { return t.id === taskId; });
                return !!found;
            });
        }
        if (found) return found;
        if (scheduleData && scheduleData.unscheduled) {
            return scheduleData.unscheduled.find(function(t) { return t.id === taskId; });
        }
        return null;
    };

    const clearOverride = function(taskId) {
        setOverrides(function(prev) { const n = Object.assign({}, prev); delete n[taskId]; return n; });
    };

    const removeTaskFromGantt = function(task) {
        if (!task) return;
        const tid = task.id;
        const pid = task.parentId || task.id;
        saveRemovedGanttTasks(function(prev) {
            const next = Object.assign({}, prev);
            if (tid) next[tid] = true;
            if (pid) next[pid] = true;
            return next;
        });
        setTaskStatus(function(prev) {
            const next = Object.assign({}, prev);
            if (tid && next[tid]) delete next[tid];
            Object.keys(next).forEach(function(k) {
                if (next[k] && next[k].parentId === pid) delete next[k];
            });
            return next;
        });
        setOverrides(function(prev) {
            const next = Object.assign({}, prev);
            if (tid && next[tid]) delete next[tid];
            return next;
        });
    };

    // [!] ARCHITECTURE NOTE: CSV Exporter
    // One row per worker per block, in time order, plus overflow rows. Status column reflects check-offs.
    const handleExportExcel = () => {
        let csvContent = "Crew,Worker,Area,Task Name,Status,Start Time,End Time,Duration (Mins)\n";
        const allTasks = [];
        scheduleData.groups.forEach(function(g) {
            g.tasks.forEach(function(t) { allTasks.push(t); });
