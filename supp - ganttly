                            name: a.craa5_equipmentidentifier || 'Unnamed Equipment',
                            area: a.craa5_areaname || 'General Area',
                            room: a.craa5_roomname || '',
                            subcategory: String(a.craa5_subcategory || a.craa5_Subcategory || '').trim(),
                            minutesRequired: parseFloat(a.craa5_hoursrequired) || 0,
