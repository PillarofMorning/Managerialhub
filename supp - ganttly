        if (cp.workers.length > 0) return cp.workers.length;
        const anyone = cp.everyone.some(function(x) { return !x.rec.isLead && x.rec.kind !== 'none'; });
        return anyone || cp.boardWindows > 0 ? 0 : FALLBACK_CREW_SIZE;   // placeholder seats only when no names were found at all
    };
    const getCrewHeadcount = function(crew) {
        if (crewHeadcountOverrides[crew] !== undefined) return crewHeadcountOverrides[crew];
        return defaultCrewCount(crew);
    };

    const planHorizonMins = Math.max(60, Math.round(Number(planHours) || 12) * 60);
    const globalStartMs = getGlobalStart(ganttStartDate, ganttStartHour).getTime();
    const nowMin = Math.round((liveTime.getTime() - globalStartMs) / 60000);
    // Rounded to 15 min so the plan only re-flows a few times an hour.
    const reforecastFrom = liveReforecast && nowMin > 0 ? Math.ceil(nowMin / 15) * 15 : 0;

    // Shift Start's saved task assignments for the shifts in this plan that have started (an hour early counts), read again
    // whenever the plan window moves, every 5 minutes, and on "Reload from Shift Start". Never more than a few days back.
    const shiftWindows = useMemo(function() {
        return buildShiftWindows(shiftRotation, getGlobalStart(ganttStartDate, ganttStartHour), planHorizonMins)
            .map(function(w) { return Object.assign({}, w, { key: w.crew + '|' + w.start }); });
    }, [shiftRotation, ganttStartDate, ganttStartHour, planHorizonMins]);
    // From the earliest clock-in of a shift in the plan (a plan can start mid-shift), an hour early.
    const taskSinceMs = shiftWindows.reduce(function(m, w) { return Math.min(m, globalStartMs + w.shiftStart * 60000); }, globalStartMs) - TASK_PRE_SHIFT_MIN * 60000;
    const taskReqRef = useRef(0);
    const loadTaskRows = function() {
        const req = ++taskReqRef.current;   // a slower answer for an earlier plan window is dropped
        const now = Date.now();
        const since = Math.max(taskSinceMs, now - TASK_ROW_DAYS * 86400000);
        const until = Math.min(globalStartMs + planHorizonMins * 60000, now + TASK_PRE_SHIFT_MIN * 60000);
        if (since >= until) { applyTaskRows([]); return Promise.resolve(); }
        return fetchTaskAssignmentRows(props.dataApi, since, until).then(function(rows) { if (req === taskReqRef.current) applyTaskRows(rows); });
    };
    loadTaskRowsRef.current = loadTaskRows;
    useEffect(function() { loadTaskRowsRef.current(); }, [props.dataApi, globalStartMs, planHorizonMins, taskSinceMs]);

    const lineIndex = useMemo(function() { return buildLineIndex(lineRows); }, [lineRows]);
    // Shift Start's saved task assignments as boards, one per supervisor per shift.
    const taskBoards = useMemo(function() {
        return boardsFromTaskRows(taskRows, shiftWindows, globalStartMs, rosterInfo.who, lineIndex);
    }, [taskRows, shiftWindows, globalStartMs, rosterInfo, lineIndex]);
    // Shift Start boards that line up with each shift in the plan (same crew, started within 90 min of the shift). A supervisor
    // with no board row gets the board built from their saved task assignments instead.
    const windowBoards = useMemo(function() {
        const parsed = boardRows.map(parseBoardRow).filter(Boolean);
        const map = {};
        shiftWindows.forEach(function(w) {
            const abs = globalStartMs + w.shiftStart * 60000;   // the real clock-in, even when the plan window cuts the shift short
            const bySup = {};
            parsed.forEach(function(b) {
                if (b.crew !== w.crew) return;
                const d = Math.abs(b.startMs - abs);
                if (d > BOARD_MATCH_TOLERANCE_MS) return;
                if (!bySup[b.supervisor] || d < bySup[b.supervisor].d) bySup[b.supervisor] = { d: d, b: b };
            });
            const list = Object.keys(bySup).map(function(k) { return bySup[k].b; });
            const covered = {};
            const supKey = function(v) { return normS(formatFullName(v)); };   // board rows say "Last, First"
            list.forEach(function(b) { covered[supKey(b.supervisor)] = true; });
            (taskBoards.boards[w.key] || []).forEach(function(b) { if (!covered[supKey(b.supervisor)]) list.push(b); });
            map[w.key] = list;
        });
        return map;
    }, [boardRows, taskBoards, shiftWindows, globalStartMs]);
    const boardWindowCount = shiftWindows.filter(function(w) { return (windowBoards[w.key] || []).length > 0; }).length;

    // ---- Shift Start rooms: which room each person is set up on, and which equipment goes to whom ----
    const lineById = useMemo(function() { const m = {}; lineIndex.forEach(function(l) { m[l.id] = l; }); return m; }, [lineIndex]);
    const lineByName = useMemo(function() {
        const m = {};
        lineIndex.slice().sort(byNameNum).forEach(function(l) { const k = normS(l.name); if (!(k in m)) m[k] = l.id; });
        return m;
    }, [lineIndex]);
    // Each shift's Shift Start boards with canonical line ids, and all of them merged (one entry per shift that has a board).
    const shiftBoards = useMemo(function() {
        const out = {};
        shiftWindows.forEach(function(w) {
            const bs = windowBoards[w.key] || [];
            if (bs.length === 0) return;
            const norm = bs.map(function(bd) { return Object.assign(normalizeBoard(bd.board, lineById, lineByName), { supervisor: bd.supervisor }); });
            out[w.key] = { boards: norm, merged: mergeBoards(norm) };
        });
        return out;
    }, [shiftWindows, windowBoards, lineById, lineByName]);
    // Manual tasks on the boards in this plan, by name: an equipment area with exactly that name counts as that room.
    const manualNames = useMemo(function() {
        const m = {};
        Object.keys(shiftBoards).forEach(function(k) { const mn = shiftBoards[k].merged.manualNames; Object.keys(mn).forEach(function(id) { m[normS(mn[id])] = mn[id]; }); });
        return m;
    }, [shiftBoards]);
    // Equipment area -> line id ('' when no line matches). Areas that only hold custom tasks are never hidden by Shift Start.
    const areaLine = useMemo(function() {
        const m = {};
        assets.forEach(function(a) { const k = String(a.area); if (!(k in m)) { const l = lineForArea(lineIndex, k, manualNames); m[k] = l ? l.id : ''; } });
        return m;
    }, [assets, lineIndex, manualNames]);
    const customOnlyAreas = useMemo(function() {
        const real = {}, custom = {};
        assets.forEach(function(a) { if (String(a.id).indexOf('custom_') === 0) custom[String(a.area)] = true; else real[String(a.area)] = true; });
        const out = {};
        Object.keys(custom).forEach(function(k) { if (!real[k]) out[k] = true; });
        return out;
    }, [assets]);
    // Every equipment row on each line, in name order like Shift Start (rows with no minutes count too, so the split matches).
    const lineAssets = useMemo(function() {
        const m = {}, cache = {};
        (assetStubs.length ? assetStubs : assets).forEach(function(a) {
            const k = String(a.area);
            if (!(k in cache)) { const l = lineForArea(lineIndex, k, manualNames); cache[k] = l ? l.id : ''; }
            if (!cache[k]) return;
            (m[cache[k]] = m[cache[k]] || []).push({ id: String(a.id), name: String(a.name), pic: a.pic !== undefined ? !!a.pic : isPicSubcategory(a.subcategory) });
        });
        Object.keys(m).forEach(function(k) { m[k].sort(byNameNum); });
        return m;
    }, [assetStubs, assets, lineIndex, manualNames]);

    // For each shift with a Shift Start board: who is on which room, which equipment each person gets, which rooms' teams can
    // help, and a read-only view of each board's columns for Setup. People Ganttly ignores (left the company, marked absent,
    // a role that gets no tasks) don't count as set up on a room and get no equipment.
    const windowPlans = useMemo(function() {
        const out = {};
        const kindOf = function(id) { const r = empById[id]; return r ? r.kind : 'none'; };
        // A lead in the employee table who is on someone's crew in Shift Start does regular cleaning that shift.
        const kindOn = function(board) { return function(id) { const k = kindOf(id); return k === 'leadership' && board.leads.indexOf(id) === -1 ? 'general' : k; }; };
        const keep = function(id) { return !!empById[id] && !absentEmployees[id]; };
        const nameOf = function(id) { return rosterInfo.namesById[id] || 'Unknown'; };
        const whyOut = function(id) { return absentEmployees[id] ? 'marked absent in Ganttly' : (rosterInfo.whyIgnored[id] || 'not on the Ganttly roster'); };
        shiftWindows.forEach(function(w) {
            const sb = shiftBoards[w.key];
            if (!sb) return;
            const night = isNightHour(new Date(globalStartMs + w.shiftStart * 60000).getHours());
            const mb = sb.merged;
            const lineOf = function(lid) { return lineById[lid] || (mb.manualNames[lid] ? { id: lid, name: mb.manualNames[lid] } : null); };
            const ownerOf = function(id) { return mb.leads.indexOf(id) > -1 ? id : (mb.members[id] || ''); };
            const plan = { assign: {}, lineWorkers: {}, lineTeam: {}, lineUnassigned: {}, personRoom: {}, views: [] };
            const lineIds = {};
            Object.keys(mb.workerLine).forEach(function(id) { if (lineOf(mb.workerLine[id])) lineIds[mb.workerLine[id]] = true; });
            Object.keys(mb.teamLines).forEach(function(l) { mb.teamLines[l].forEach(function(lid) { if (lineOf(lid)) lineIds[lid] = true; }); });
            const counted = mb.leads.concat(Object.keys(mb.members)).filter(function(id, i, arr) { return arr.indexOf(id) === i && !mb.out[id] && keep(id); });
            Object.keys(lineIds).forEach(function(lid) {
                const line = lineOf(lid);
                const people = boardWorkersOn(mb, lid, keep);
                if (people.length === 0) return;
                plan.lineWorkers[lid] = people;
                people.forEach(function(id) { if (!plan.personRoom[id]) plan.personRoom[id] = line.name; });
                const owners = people.map(ownerOf).filter(Boolean);
                plan.lineTeam[lid] = counted.filter(function(id) { return owners.indexOf(ownerOf(id)) > -1; });
                const list = lineAssets[lid] || [];
                const split = splitLineEquipment(mb, line, list, kindOn(mb), night, keep);
                Object.assign(plan.assign, split);   // an asset belongs to one line, so lines never clash
                plan.lineUnassigned[lid] = list.filter(function(a) { return !split[a.id]; }).length;
            });
            const eqCount = {};
            Object.keys(plan.assign).forEach(function(aid) { eqCount[plan.assign[aid]] = (eqCount[plan.assign[aid]] || 0) + 1; });
            // Columns like Shift Start: one per lead (their team), plus one for anyone under the supervisor directly.
            sb.boards.forEach(function(nb) {
                const lineOfB = function(lid) { return lineById[lid] || (nb.manualNames[lid] ? { id: lid, name: nb.manualNames[lid] } : lineOf(lid)); };
                const onBoard = nb.leads.concat(Object.keys(nb.members)).filter(function(id, i, arr) { return arr.indexOf(id) === i && !nb.out[id]; });
                const cols = nb.leads.map(function(id) { return { ownerId: id, isLead: true, name: nameOf(id), ids: [] }; });
                let supCol = null;
                onBoard.forEach(function(id) {
                    const owner = nb.leads.indexOf(id) > -1 ? id : nb.members[id];
                    let col = cols.find(function(c) { return c.ownerId === owner; });
                    if (!col) { if (!supCol) { supCol = { ownerId: '', isLead: false, name: nb.supervisor, ids: [] }; cols.unshift(supCol); } col = supCol; }
                    col.ids.push(id);
                });
                cols.forEach(function(col) {
                    const byLine = {}, order = [], noRoom = [];
                    const lineCard = function(lid) {
                        if (!byLine[lid]) {
                            byLine[lid] = { lineId: lid, name: lineOfB(lid).name, assetCount: (lineAssets[lid] || []).length, unassigned: plan.lineWorkers[lid] ? (plan.lineUnassigned[lid] || 0) : 0, people: [] };
                            order.push(lid);
                        }
                        return byLine[lid];
                    };
                    col.ids.forEach(function(id) {
                        const lid = nb.workerLine[id] && lineOfB(nb.workerLine[id]) ? nb.workerLine[id] : '';
                        const counts = keep(id);
                        const person = { id: id, name: nameOf(id), isLead: nb.leads.indexOf(id) > -1, counted: counts, why: counts ? '' : whyOut(id), equipCount: eqCount[id] || 0 };
                        if (lid) lineCard(lid).people.push(person); else if (!person.isLead) noRoom.push(person);   // a lead leads; no room needed
                    });
                    (nb.teamLines[col.ownerId] || []).forEach(function(lid) { if (lineOfB(lid)) lineCard(lid); });
                    col.lines = order.map(function(lid) { return byLine[lid]; }).sort(byNameNum);
                    col.noRoom = noRoom;
                });
                plan.views.push({
                    supervisor: nb.supervisor,
                    columns: cols,
                    out: Object.keys(nb.out).map(function(id) { return { name: nameOf(id), reason: String(nb.out[id] || '') }; })
                });
            });
            out[w.key] = plan;
        });
        return out;
    }, [shiftBoards, shiftWindows, lineById, lineAssets, empById, rosterInfo, absentEmployees, globalStartMs]);
    // Lines with someone set up on them in any board of this plan; null when nobody is set up on a room yet (then every room is shown).
    const shiftStartLines = useMemo(function() {
        const set = {};
        let n = 0;
        Object.keys(windowPlans).forEach(function(k) { Object.keys(windowPlans[k].lineWorkers).forEach(function(lid) { if (!set[lid]) n++; set[lid] = true; }); });
        return n > 0 ? set : null;
    }, [windowPlans]);
    const roomHidden = function(area) {
        if (hiddenRooms[area]) return true;
        if (roomSource !== 'shiftstart' || !shiftStartLines || customOnlyAreas[String(area)]) return false;
        const lid = areaLine[String(area)];
        return !(lid && shiftStartLines[lid]);
    };
    // ---- Type of clean (see TYPE OF CLEAN) ----
    const cleanTypeLabel = function(k) { return cleanTypeLabels[k] || CLEAN_TYPE_LABELS[k] || humanizeColumn(k); };
    const planCleanTypes = cleanTypes.filter(function(k) { return cleanTypeCols.indexOf(k) > -1; });
    // The types a room plans: its own pick, else the plan's ([] = every piece of equipment).
    const roomCleanTypes = function(area) {
        const own = roomCleanType[String(area)];
        if (own === 'all') return [];
        if (own && cleanTypeCols.indexOf(own) > -1) return [own];
        return planCleanTypes;
    };
    const inCleanType = function(a) {
        if (!Array.isArray(a.flags)) return true;   // custom tasks and sample data have no yes/no columns
        const types = roomCleanTypes(a.area);
        return !types.length || types.some(function(k) { return a.flags.indexOf(k) > -1; });
    };
    const toggleCleanType = function(k) {
        setCleanTypes(function(prev) { const cur = prev.filter(function(x) { return cleanTypeCols.indexOf(x) > -1; }); return cur.indexOf(k) > -1 ? cur.filter(function(x) { return x !== k; }) : cur.concat([k]); });
    };
    const handleRoomCleanTypeChange = function(area, val) { setRoomCleanType(function(prev) { const n = Object.assign({}, prev); if (val) n[area] = val; else delete n[area]; return n; }); };
    // Equipment per type, and per room how much of it the current pick plans.
    const cleanTypeCounts = useMemo(function() {
        const byType = {}, rooms = {};
        let flagged = 0, planned = 0, inRooms = 0;
        assets.forEach(function(a) {
            const room = String(a.area);
            const rc = rooms[room] = rooms[room] || { total: 0, planned: 0 };
            rc.total++;
            const ok = inCleanType(a);
            if (ok) rc.planned++;
            if (!roomHidden(a.area)) { inRooms++; if (ok) planned++; }
            if (!Array.isArray(a.flags)) return;
            flagged++;
            a.flags.forEach(function(k) { byType[k] = (byType[k] || 0) + 1; });
        });
        return { byType: byType, rooms: rooms, flagged: flagged, planned: planned, inRooms: inRooms };
    }, [assets, cleanTypes, roomCleanType, cleanTypeCols, hiddenRooms, roomSource, shiftStartLines, areaLine, customOnlyAreas]);

    // How many tasks fall in each kind of work, so Setup shows whether PIC / chemical / janitorial are being picked up.
    const taskKindCounts = useMemo(function() {
        const c = { general: 0, pic: 0, chemical: 0, admin: 0, janitorial: 0 };
        assets.forEach(function(a) { if (!roomHidden(a.area) && inCleanType(a)) c[a.kind || taskKind(a)]++; });
        return c;
    }, [assets, hiddenRooms, roomSource, shiftStartLines, areaLine, customOnlyAreas, cleanTypes, roomCleanType, cleanTypeCols]);

    // Who works each crew, when, and which lead they sit under.
    //  - 'table': the employee table (workers by Shift, leads by Role). A lead's team = people on the same Leadership Team.
    //  - 'shiftstart': for a shift that has a Shift Start board, that board's leads, teams, overtime and who is out; a shift
    //    with no board yet uses the employee table, so a future weekend can still be planned.
    const crewPeople = useMemo(function() {
        const out = {};
        CREW_CODES.forEach(function(crew) {
            const wins = shiftWindows.filter(function(w) { return w.crew === crew; }).map(function(w) { return { start: w.start, end: w.end, key: w.key }; });
            const people = {};
            const addPerson = function(rec, win) {
                if (!people[rec.id]) people[rec.id] = { rec: rec, windows: [], absent: !!absentEmployees[rec.id] };
                people[rec.id].windows.push({ start: win.start, end: win.end });
            };
            let teams = null;
            let boardWins = 0;
            wins.forEach(function(win) {
                const boards = rosterSource === 'shiftstart' ? (windowBoards[win.key] || []) : [];
                if (boards.length === 0) {
                    crewRosters[crew].forEach(function(p) { addPerson(p, win); });
                    leadRosters[crew].forEach(function(p) { addPerson(p, win); });
                    return;
                }
                boardWins++;
                const theseTeams = [];
                boards.forEach(function(b) {
                    const bd = b.board;
                    const leadsB = Array.isArray(bd.leads) ? bd.leads : [];
                    const members = bd.members && typeof bd.members === 'object' ? bd.members : {};
                    const outB = bd.out && typeof bd.out === 'object' ? bd.out : {};
                    const ids = leadsB.concat(Object.keys(members), Array.isArray(bd.overtime) ? bd.overtime : []);
                    const seen = {};
                    ids.forEach(function(id) {
                        if (seen[id] || outB[id]) return;
                        seen[id] = true;
                        const rec = empById[id];
                        if (!rec) return;
                        // Shift Start decides who leads: a lead placed on another lead's crew works as crew (regular cleaning).
                        addPerson(leadsB.indexOf(id) > -1 ? Object.assign({}, rec, { kind: 'leadership', isLead: true, jobRole: 'Lead' })
                            : rec.isLead ? Object.assign({}, rec, { kind: 'general', isLead: false, jobRole: 'Lead, on a crew in Shift Start' }) : rec, win);
                    });
                    leadsB.forEach(function(leadId) {
                        if (outB[leadId] || !empById[leadId]) return;
                        theseTeams.push({ leadId: leadId, memberIds: Object.keys(members).filter(function(id) { return members[id] === leadId && !outB[id]; }) });
                    });
                });
                // Chemical clerk, admin, janitorial and inspectors work their own area rather than under a lead, so Shift Start
                // doesn't need to place them: keep the ones from this crew unless the board marks them out.
                const outAny = {};
                boards.forEach(function(b) { if (b.board.out && typeof b.board.out === 'object') Object.assign(outAny, b.board.out); });
                crewRosters[crew].forEach(function(p) { if (SPECIALIST_KINDS.indexOf(p.kind) > -1 && !outAny[p.id]) addPerson(p, win); });
                if (!teams) teams = theseTeams;   // the first shift with a board decides the grouping
            });
            if (!teams) {
                // No board: leads own the people on their Leadership Team (if any).
                teams = leadRosters[crew].map(function(l) {
                    return { leadId: l.id, memberIds: l.teamId ? crewRosters[crew].filter(function(p) { return p.teamId === l.teamId; }).map(function(p) { return p.id; }) : [] };
                });
            }
            const all = Object.keys(people).map(function(id) { return people[id]; });
            const byName = function(a, b) { return a.rec.name.localeCompare(b.rec.name); };
            out[crew] = {
                everyone: all.slice().sort(byName),   // includes people marked absent, so the Crew tab can un-mark them
                workers: all.filter(function(x) { return !x.absent && !x.rec.isLead && x.rec.kind !== 'none'; }).sort(byName),
                leads: all.filter(function(x) { return !x.absent && x.rec.isLead; }).sort(byName),
                teams: teams,
                boardWindows: boardWins
            };
        });
        return out;
    }, [shiftWindows, windowBoards, rosterSource, crewRosters, leadRosters, empById, absentEmployees]);

    // One lane per person per crew working inside the plan window, ordered by when the crew first clocks in.
    // Inside a crew: each lead (marked Leadership) followed by their team, then anyone not on a team, then placeholder seats.
    const laneRoster = useMemo(function() {
        const crewOrder = [];
        shiftWindows.forEach(function(w) { if (crewOrder.indexOf(w.crew) === -1) crewOrder.push(w.crew); });
        const lanes = [];
        const usedKeys = {};
        crewOrder.forEach(function(crew) {
            const cp = crewPeople[crew] || { everyone: [], workers: [], leads: [], teams: [], boardWindows: 0 };
            const crewWindows = shiftWindows.filter(function(w) { return w.crew === crew; }).map(function(w) { return { start: w.start, end: w.end }; });
            const n = Math.max(0, Math.round(getCrewHeadcount(crew)));
            const workers = cp.workers.slice(0, n);
            const workerById = {};
            workers.forEach(function(x) { workerById[x.rec.id] = x; });
            const leadById = {};
            cp.leads.forEach(function(x) { leadById[x.rec.id] = x; });
            const placed = {};
            // The room Shift Start has this person on (first shift of this crew with a board that places them).
            const crewWins = shiftWindows.filter(function(w) { return w.crew === crew; });
            const roomOf = function(empId) {
                if (rosterSource !== 'shiftstart' && roomSource !== 'shiftstart') return '';
                for (let i = 0; i < crewWins.length; i++) { const pl = windowPlans[crewWins[i].key]; if (pl && pl.personRoom[empId]) return pl.personRoom[empId]; }
                return '';
            };
            const pushPerson = function(x, extra) {
                let key = x.rec.id;
                if (usedKeys[key]) key = x.rec.id + '@' + crew;
                usedKeys[key] = true;
                const lane = Object.assign({
                    lane: lanes.length, crew: crew, key: key, empId: x.rec.id, room: roomOf(x.rec.id), name: x.rec.name, isPlaceholder: false,
                    kind: x.rec.kind, jobRole: x.rec.jobRole, isLead: !!x.rec.isLead,
                    windows: x.windows.length ? x.windows : crewWindows
                }, extra || {});
                lanes.push(lane);
                return lane;
            };
            let groupIdx = 0;
            (cp.teams || []).forEach(function(t) {
                const lead = leadById[t.leadId];
                if (!lead || placed[t.leadId]) return;
                const members = t.memberIds.filter(function(id) { return workerById[id] && !placed[id]; }).map(function(id) { return workerById[id]; })
                    .sort(function(a, b) {   // team members sit together by room, then by name
                        const ra = roomOf(a.rec.id) || '\uffff', rb = roomOf(b.rec.id) || '\uffff';
                        return ra.localeCompare(rb, undefined, { numeric: true, sensitivity: 'base' }) || a.rec.name.localeCompare(b.rec.name);
                    });
                const leadLane = pushPerson(lead, { groupIdx: groupIdx, teamNames: members.map(function(m) { return m.rec.name; }) });
                placed[t.leadId] = true;
                members.forEach(function(m) { placed[m.rec.id] = true; pushPerson(m, { groupIdx: groupIdx, leadKey: leadLane.key }); });
                groupIdx++;
            });
            cp.leads.forEach(function(x) { if (!placed[x.rec.id]) { placed[x.rec.id] = true; pushPerson(x, { groupIdx: groupIdx++, teamNames: [] }); } });
            workers.forEach(function(x) { if (!placed[x.rec.id]) { placed[x.rec.id] = true; pushPerson(x, { groupIdx: -1 }); } });
            for (let k = workers.length; k < n; k++) {
                lanes.push({
                    lane: lanes.length, crew: crew, key: crew + '#' + (k + 1), empId: '', room: '', name: crew + ' Crew Seat ' + (k + 1), isPlaceholder: true,
                    kind: 'general', jobRole: '', isLead: false, groupIdx: -1, windows: crewWindows
                });
            }
        });
        return lanes;
    }, [shiftWindows, crewPeople, crewHeadcountOverrides, windowPlans, rosterSource, roomSource]);
    // Lane of a person in a crew's shift (the same person can have a lane in more than one crew when pulled in on overtime).
    const laneByEmpCrew = useMemo(function() {
        const m = {};
        laneRoster.forEach(function(l) { if (l.empId && !l.isPlaceholder) m[l.empId + '|' + l.crew] = l.lane; });
        return m;
    }, [laneRoster]);

    const globalHeadcount = laneRoster.filter(function(l) { return !l.isLead; }).length;   // leads are shown, not counted as cleaners
    const maxCrewSize = CREW_CODES.reduce(function(m, c) { return laneRoster.some(function(l) { return l.crew === c; }) ? Math.max(m, getCrewHeadcount(c)) : m; }, 0) || 1;
    const laneByKey = {};
    laneRoster.forEach(function(l) { laneByKey[l.key] = l.lane; });

    const removeSlot = function(slot) {
        setRotationSource('Saved');
        setShiftRotation(function(prev) { return prev.filter(function(s) { return s !== slot; }); });
    };
    const addSlot = function(crew) {
        const d = Object.assign({ day: 0, startHour: 6, endHour: 18 }, newSlot[crew] || {});
        const len = ((Number(d.endHour) - Number(d.startHour) + 24) % 24) || 24;
        setRotationSource('Saved');
        setShiftRotation(function(prev) { return prev.concat([{ crew: crew, day: Number(d.day), startHour: Number(d.startHour), lengthHours: len }]); });
    };
    const setNewSlotField = function(crew, field, val) {
        setNewSlot(function(prev) { return Object.assign({}, prev, { [crew]: Object.assign({ day: 0, startHour: 6, endHour: 18 }, prev[crew] || {}, { [field]: Number(val) }) }); });
    };
    const handleCrewHeadcountChange = function(crew, val) {
        setCrewHeadcountOverrides(function(prev) {
            const next = Object.assign({}, prev);
            const parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed < 0) delete next[crew]; else next[crew] = parsed;
            return next;
        });
    };
    const toggleAbsent = function(empId) {
        setAbsentEmployees(function(prev) { const next = Object.assign({}, prev); if (next[empId]) delete next[empId]; else next[empId] = true; return next; });
    };
    // Back to the Dataverse shift table if it loaded, otherwise the built-in pattern.
    const resetRotation = function() {
        if (shiftTableInfo && shiftTableInfo.slots) { setShiftRotation(shiftTableInfo.slots); setRotationSource('Dataverse'); }
        else { setShiftRotation(DEFAULT_SHIFT_ROTATION); setRotationSource('Default'); }
    };
    const coverage = weeklyCoverage(shiftRotation);
    const startNewPlan = function() {
        if (!window.confirm('Clear all check-offs, manual moves and downtimes for a fresh plan? Room setup, crews and custom tasks are kept.')) return;
        setOverrides({});
        setTaskStatus({});
        setDowntimes([]);
        setTargetDowntimes([]);
    };

    // Plan presets. "Weekend" = Friday 6PM through Monday 6AM (D → C → D → A → B).
    const applyPlanPreset = function(preset) {
        if (preset === 'shift') { setPlanHours(12); return; }
        if (preset === 'week') { setPlanHours(168); return; }
        if (preset === 'weekend') {
            const d = new Date();
            d.setDate(d.getDate() + ((5 - d.getDay() + 7) % 7));
            setGanttStartDate(getLocalYMD(d));
            setGanttStartHour(18);
            setPlanHours(60);
        }
    };

    const allUniqueRooms = Array.from(new Set(assets.map(function(a) { return String(a.area); }))).sort();

    // Filtered list strictly omitting skipped rooms to clean up UI rendering loops downstream
    const activeRooms = allUniqueRooms.filter(function(r) { return !roomHidden(r); });

    const activeBreaks = useMemo(function() {
        let breaks = [];
        if (includeBreaks && ganttStartDate && typeof ganttStartDate === 'string') {
            const globalStart = getGlobalStart(ganttStartDate, ganttStartHour);
            for (let day = -1; day <= Math.ceil(planHorizonMins / 1440) + 1; day++) {
                const base = new Date(globalStart.getTime());
                base.setDate(base.getDate() + day);
                const y = base.getFullYear();
                const m = base.getMonth();
                const d = base.getDate();

                const addB = function(h, min, dur, label) {
                    const bTime = new Date(y, m, d, h, min, 0);
                    const offset = Math.round((bTime.getTime() - globalStart.getTime()) / 60000);
                    if (offset >= 0 && offset < planHorizonMins + 1440) {
                        breaks.push({ start: offset, end: offset + dur, duration: dur, label: label, isCustom: false });
                    }
                };

                addB(9, 30, 20, '20m Break');
                addB(11, 30, 40, '40m Lunch');
                addB(14, 30, 20, '20m Break');
                addB(16, 30, 20, '20m Break');
                addB(21, 30, 20, '20m Break');
                addB(23, 30, 40, '40m Lunch');
                addB(2, 30, 20, '20m Break');
                addB(4, 30, 20, '20m Break');
            }
        }
        return breaks;
    }, [includeBreaks, ganttStartDate, ganttStartHour, planHorizonMins]);

    const allInterrupts = useMemo(function() {
        const startMs = getGlobalStart(ganttStartDate, ganttStartHour).getTime();
        const customInts = downtimes.map(function(dt) {
            const dtMs = new Date(dt.dateTimeStr).getTime();
            const offset = Math.max(0, Math.round((dtMs - startMs) / 60000));
            return { start: offset, end: offset + dt.duration, duration: dt.duration, label: dt.label, isCustom: true, type: dt.type, targetId: dt.targetId };
        });
        return activeBreaks.concat(customInts).sort(function(a,b) { return a.start - b.start; });
    }, [activeBreaks, downtimes, ganttStartDate, ganttStartHour]);

    // Mutators
    const handleRoomHandoverChange = function(area, val) { setRoomHandovers(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomPriorityChange = function(area, val) { setRoomPriority(function(prev) { return Object.assign({}, prev, { [area]: Math.max(1, Math.min(50, Number(val)||1)) }); }); };
    const handleRoomCleanTogetherChange = function(area, val) { setRoomCleanTogether(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomAllergenChange = function(area, val) { setRoomAllergen(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomConfiguredChange = function(area, val) { setRoomConfigured(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };

    // 🚨 ARCHITECTURE NOTE: Dynamic Room Caps
    // If a room limit is deleted/empty by the user, we explicitly delete the key from the state dictionary.
    // The engine treats a missing key as "no cap", so the room can use as many on-shift workers as are free
    // (still bounded by the largest crew in the plan window).
    const handleRoomLimitsChange = function(area, val) {
        setRoomLimits(function(prev) {
            const parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed <= 0) {
                const next = Object.assign({}, prev);
                delete next[area];
                return next;
            }
            return Object.assign({}, prev, { [area]: parsed });
        });
    };

    // Equipment edits are kept in `assetEdits` so they survive a reload of the Dataverse rows.
    const editAsset = function(assetId, patch) {
        setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, patch) : a; }); });
        setAssetEdits(function(prev) { return Object.assign({}, prev, { [assetId]: Object.assign({}, prev[assetId] || {}, patch) }); });
    };
    const handleBaseMinsChange = function(assetId, val) { editAsset(assetId, { minutesRequired: Math.max(0, Number(val)||0) }); };
    const handleAllergenMinsChange = function(assetId, val) { editAsset(assetId, { allergenMins: Math.max(0, Number(val)||0) }); };
    const handleTaskHeadsChange = function(assetId, val) { editAsset(assetId, { heads: Math.max(1, Number(val)||1) }); };
    const handlePriorityChange = function(assetId, newPriority) { editAsset(assetId, { priority: Math.max(1, Math.min(50, Number(newPriority)||1)) }); };
    const handleToggleRoom = function(areaName) { setHiddenRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };
    const toggleDashboardRoom = function(areaName) { setCollapsedDashboardRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };

    const openRoomDowntime = function(areaName) {
        setDtTarget(areaName);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
        setIsRoomDtModalOpen(true);
    };

    const openEquipDowntime = function(equipId) {
        setDtTarget(equipId);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
        setIsEquipDtModalOpen(true);
    };

    const addDowntime = function(type) {
        if (!newDtDate || !newDtTime) return alert("Date and Time required.");
        if (dtTarget === 'GLOBAL') {
             setDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Global Downtime',
                     isCustom: true
                 }]);
             });
        } else {
             setTargetDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     type: type,
                     targetId: dtTarget,
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Maintenance'
                 }]);
             });
        }
        setIsRoomDtModalOpen(false);
        setIsEquipDtModalOpen(false);
    };

    const handleAddCustomTask = function() {
        if (!newTaskName.trim() || !newTaskArea.trim()) return alert("Name and Area are required.");
        const areaNameUpper = newTaskArea.toUpperCase();
        const newTask = {
            id: 'custom_' + Date.now(),
            name: newTaskName,
            area: areaNameUpper,
            minutesRequired: Number(newTaskMins),
            allergenMins: Number(newTaskMins),
            pbMins: 0,
            heads: Number(newTaskHeads),
            priority: Number(newTaskPriority),
            isComplete: false,
            isPinned: false
        };
        setAssets(function(prev) { return prev.concat([newTask]); });
        setCustomTasks(function(prev) { return prev.concat([newTask]); });
        setIsCustomTaskModalOpen(false);
        setNewTaskName('');
        setNewTaskArea('');
        setNewTaskMins(60);
    };

    // ============================================================================
    // SECTION 5: SHIFT-AWARE CASCADE ENGINE (Frozen Progress, Pins, Gap-Finding, Shift Handovers)
    // 🚨 ARCHITECTURE NOTE: Event-driven list scheduling across crews.
    //  Pass 0  Started / done blocks are frozen exactly where they happened. Only the parent's remaining
    //          work is re-planned (as "(Pt N)").
    //  Pass 1  Manual moves (overrides) are placed on the exact workers chosen.
    //  Pass 2  Everything else, room by room (handover time, then priority), task by task (priority, size):
    //          walk candidate start times (room handover, shift starts, the moment anyone frees up) and take
    //          the earliest where H on-shift workers are free for the whole break-stretched duration.
    //          If the job can't finish before clock-out it is SPLIT: the outgoing crew does what fits, the
    //          rest (+ handover overhead) is queued for the next crew. With Live Reforecast on, nothing
    //          un-started is scheduled before "now". Work that can't fit in the window = overflow.
    // ============================================================================
    const scheduleData = useMemo(function() {
        const workers = laneRoster.map(function(l) { const w = new Worker(l.lane, l.crew, l.name, l.windows); w.kind = l.kind || 'general'; return w; });
        const laneIndex = {};
        laneRoster.forEach(function(l) { laneIndex[l.key] = l.lane; });
        const totalLanes = workers.length;
        const virtualRoomsMap = {};
        const CLEAN_TOGETHER_KEY = '__CLEAN_TOGETHER__';
        const startMs = getGlobalStart(ganttStartDate, ganttStartHour).getTime();
        const allTasks = [];
        const unscheduled = [];
        const parents = [];

        const statusByParent = {};
        Object.keys(taskStatus).forEach(function(blockId) {
            const b = Object.assign({ id: blockId }, taskStatus[blockId]);
            if (!statusByParent[b.parentId]) statusByParent[b.parentId] = [];
            statusByParent[b.parentId].push(b);
        });

        // Workers whose role allows this kind of task, and the biggest group of them on one crew.
        const isNightAt = function(min) { return isNightHour(new Date(startMs + min * 60000).getHours()); };
        // Anyone who could ever take this kind of task (an Inspector counts for admin because of nights).
        const eligibleFor = function(kind) { return workers.filter(function(w) { return w.canDo(kind, true); }); };
        const maxEligibleOnCrew = function(kind) {
            const per = {};
            eligibleFor(kind).forEach(function(w) { per[w.crew] = (per[w.crew] || 0) + 1; });
            return Object.keys(per).reduce(function(m, c) { return Math.max(m, per[c]); }, 0);
        };

        // Shift Start link: for a shift with a board, the person each piece of equipment was given to, and everyone set up on its room.
        // Only shifts whose board has somebody on a room count; a board with no rooms set yet plans like a shift with no board.
        const useRooms = roomSource === 'shiftstart';
        const planWins = !useRooms ? [] : shiftWindows.filter(function(w) { return windowPlans[w.key] && Object.keys(windowPlans[w.key].lineWorkers).length > 0; }).map(function(w) { return { start: w.start, end: w.end, crew: w.crew, plan: windowPlans[w.key] }; });
        const plansAt = function(t) { return planWins.filter(function(pw) { return t >= pw.start && t < pw.end; }); };
        const lanesOfEmps = function(ids, crew, out) {
            out = out || [];
            (ids || []).forEach(function(id) { const l = laneByEmpCrew[id + '|' + crew]; if (l !== undefined && out.indexOf(l) === -1) out.push(l); });
            return out;
        };
        const isCustomTask = function(task) { return String(task.parentId).indexOf('custom_') === 0; };
        // Who Shift Start says should do this task if it starts at t:
        //  must - the person the equipment was given to (any one of them when two crews overlap). Dropped when that person
        //         is already booked up for the rest of their shift, so their roommates pick it up instead of it slipping a shift.
        //  room / team - everyone on the task's room, then the rest of their team.
        //  skip - the room isn't on the board of the shift running at t but a later shift's board has it, so wait for that
        //         shift. Work carried over from an earlier shift, and rooms whose shift is already over, go to whoever is on.
        const shiftStartAt = function(task, t, dur) {
            const res = { must: [], room: [], team: [], skip: false };
            if (planWins.length === 0) return res;
            const pws = plansAt(t);
            const lid = areaLine[String(task.originalArea)];
            let staffed = false;
            pws.forEach(function(pw) {
                const emp = pw.plan.assign[task.parentId];
                if (emp) {
                    const l = laneByEmpCrew[emp + '|' + pw.crew];
                    if (l !== undefined && workers[l].freeBetween(t, pw.end) >= Math.min(MIN_SPLIT_MINS, dur) && res.must.indexOf(l) === -1) res.must.push(l);
                }
                if (lid && pw.plan.lineWorkers[lid]) {
                    staffed = true;
                    lanesOfEmps(pw.plan.lineWorkers[lid], pw.crew, res.room);
                    lanesOfEmps(pw.plan.lineTeam[lid], pw.crew, res.team);
                }
            });
            if (!staffed && lid && !task.isSplitPart2 && !isCustomTask(task) && planWins.some(function(pw) { return pw.start > t && pw.plan.lineWorkers[lid]; })) res.skip = true;
            return res;
        };
        const hasPlanFor = function(task) {
            return planWins.some(function(pw) { return !!pw.plan.assign[task.parentId]; });
        };

        const resolveLanes = function(keys, heads, kind) {
            const lanes = (keys || []).map(function(k) { return laneIndex[k]; }).filter(function(l) { return l !== undefined; });
            if (lanes.length >= heads || lanes.length === 0) return lanes.slice(0, heads);
            // Fill missing seats with neighbours of the first known worker (only people allowed to do this kind of task).
            let next = lanes[lanes.length - 1] + 1;
            while (lanes.length < heads && next < totalLanes) { if (lanes.indexOf(next) === -1 && (!kind || workers[next].canDo(kind, true))) lanes.push(next); next++; }
            return lanes;
        };

        // Ensure strictly omitted (hidden) rooms do not enter the mathematical queue
        assets.filter(function(a) { return !roomHidden(a.area) && inCleanType(a); }).forEach(function(rawT) {
            const area = rawT.area;
            const isCleanTogether = roomCleanTogether[area];
            const vRoomKey = isCleanTogether ? CLEAN_TOGETHER_KEY : area;

            if (!virtualRoomsMap[vRoomKey]) {
                virtualRoomsMap[vRoomKey] = {
                    id: vRoomKey,
                    name: isCleanTogether ? 'Combined Clean' : area,
                    isCombined: isCleanTogether,
                    tasks: [],
                    limit: Infinity,
                    startOffset: Infinity,
                    priority: Infinity,
                    areas: {}
                };
            }

            const vRoom = virtualRoomsMap[vRoomKey];
            vRoom.areas[area] = true;

            // Max Workers = how many people may work in the room at the same time (blank = no cap).
            const rLimit = roomLimits[area] !== undefined ? roomLimits[area] : Infinity;
            if (rLimit < vRoom.limit) vRoom.limit = rLimit;

            let rStartMins = 0;
            if (roomHandovers[area]) {
                const handMs = new Date(roomHandovers[area]).getTime();
                if (!isNaN(handMs)) rStartMins = Math.max(0, Math.round((handMs - startMs) / 60000));
            }
            if (rStartMins < vRoom.startOffset) vRoom.startOffset = rStartMins;

            const rPri = roomPriority[area] || 2;
            if (rPri < vRoom.priority) vRoom.priority = rPri;

            const t = new Equipment(rawT, roomAllergen[area] || false, pbMode);
            t.isComplete = false;
            t.isTransitActive = includeTransit;
            t.isInspectionActive = includeInspection;
            t.originalArea = area;
            t.kind = t.kind || taskKind(rawT);

            const rIntsRaw = targetDowntimes.filter(function(dt) { return dt.type === 'room' && dt.targetId === area; });
            const eIntsRaw = targetDowntimes.filter(function(dt) { return dt.type === 'equipment' && dt.targetId === t.id; });

            const mappedInts = rIntsRaw.concat(eIntsRaw).map(function(dt) {
                const dtMs = new Date(dt.dateTimeStr).getTime();
                const offset = Math.max(0, Math.round((dtMs - startMs) / 60000));
                return { start: offset, end: offset + dt.duration, duration: dt.duration, label: dt.label, isCustom: true };
            });

            t.customInterrupts = mappedInts.concat(allInterrupts).sort(function(a,b){return a.start - b.start;});

            const baseMins = t.isPbActive && t.pbMins > 0 ? t.pbMins : (t.isAllergenActive && t.allergenMins > 0 ? t.allergenMins : t.baseMins);
            const parent = {
                id: t.parentId, name: t.baseName, area: area, heads: t.heads,
                totalWork: t.rawWorkloadMins,
                inspectMins: includeInspection ? baseMins * 0.10 : 0,
                transitMins: includeTransit ? 10 * t.heads : 0,
                blocks: [], unscheduledWork: 0
            };
            parents.push(parent);

            // Pass 0: frozen (started / done) blocks.
            const frozen = (statusByParent[t.parentId] || []).sort(function(a, b) { return a.startMs - b.startMs; });
            let frozenWork = 0;
            frozen.forEach(function(b) {
                const blk = Object.assign(Object.create(Object.getPrototypeOf(t)), t);
                blk.id = b.id;
                blk.name = b.name || t.baseName;
                blk.workOverrideMins = b.workMins;
                blk.isFrozen = true;
                blk.status = b.status;
                blk.isComplete = b.status === 'done';
                blk.isInProgress = b.status === 'started';
                blk.isSplitPart1 = false;
                blk.isSplitPart2 = false;
                blk.isTransitActive = false;
                blk.isInspectionActive = false;
                blk.startMin = Math.round((b.startMs - startMs) / 60000);
                blk.appliedHeads = b.heads || 1;
                blk.finalDuration = b.durationMins;
                blk.assignedLanes = resolveLanes(b.laneKeys, blk.appliedHeads, blk.kind);
                blk.lostWorkers = blk.assignedLanes.length < (b.laneKeys || []).length;
                blk.segments = [{ startMin: blk.startMin, duration: blk.finalDuration }];
                blk.crew = blk.assignedLanes.length ? workers[blk.assignedLanes[0]].crew : '';
                blk.assignedLanes.forEach(function(l) { workers[l].assign(blk.startMin, blk.startMin + blk.finalDuration, blk.id, area); });
                frozenWork += b.workMins;
                allTasks.push(blk);
            });

            if (frozen.length > 0) {
                const remaining = t.rawWorkloadMins - frozenWork;
                if (remaining <= 1) return; // fully covered by started / done work
                t.workOverrideMins = remaining;
                t.id = t.parentId + '_g' + simpleHash(frozen.map(function(b) { return b.id; }).sort().join('|'));
                t.ptOffset = frozen.length;
                t.name = t.baseName + ' (Pt ' + (frozen.length + 1) + ')';
                t.isTransitActive = false;
                t.isInspectionActive = false;
                t.isSplitPart2 = true;
                // The rest of the job picks up where the last started / finished part left off.
                t.earliestStart = Math.max.apply(null, frozen.map(function(b) { return Math.round((b.startMs - startMs) / 60000) + b.durationMins; }));
            } else {
                t.ptOffset = 0;
            }

            vRoom.tasks.push(t);
            allTasks.push(t);
        });

        const isAreaOf = function(vRoom, area) { return !!vRoom.areas[area]; };

        // Distinct workers (other than `exclude`) already working in this room during [start, end).
        const busyInRoom = function(vRoom, start, end, exclude) {
            let n = 0;
            workers.forEach(function(w) {
                if (exclude.indexOf(w.id) > -1) return;
                if (w.schedule.some(function(s) { return isAreaOf(vRoom, s.area) && Math.max(start, s.start) < Math.min(end, s.end); })) n++;
            });
            return n;
        };

        const capHeads = function(task, vRoom) {
            return Math.max(1, Math.min(task.heads, vRoom.limit, maxEligibleOnCrew(task.kind) || 1, Math.max(1, eligibleFor(task.kind).length)));
        };

        // Returns a continuation when the moved block was only part of a split task (the rest keeps flowing).
        const placePinned = function(task, vRoom) {
            const ov = overrides[task.id];
            let continuation = null;
            if (ov.workMins !== undefined && ov.workMins < task.rawWorkloadMins - 1) {
                const remaining = task.rawWorkloadMins - ov.workMins;
                const baseId = task.genBaseId || task.id;
                continuation = Object.assign(Object.create(Object.getPrototypeOf(task)), task);
                continuation.genBaseId = baseId;
                continuation.splitIndex = task.splitIndex + 1;
                continuation.id = baseId + '_p' + continuation.splitIndex;
                continuation.name = task.baseName + ' (Pt ' + (task.ptOffset + continuation.splitIndex) + ')';
                continuation.workOverrideMins = remaining + handoverMins;
                continuation.isSplitPart2 = true;
                continuation.isSplitPart1 = false;
                continuation.isTransitActive = false;
                continuation.isInspectionActive = false;
                continuation.assignedLanes = [];
                continuation.segments = [];
                if (task.splitIndex === 1 && task.ptOffset === 0) task.name = task.baseName + ' (Pt 1)';
                task.workOverrideMins = ov.workMins;
                task.isSplitPart1 = true;
            }
            task.isPinned = true;
            task.appliedHeads = Math.min(capHeads(task, vRoom), totalLanes);
            task.startMin = ov.startMs !== undefined ? Math.round((ov.startMs - startMs) / 60000) : (ov.startMin || 0);
            let lanes = resolveLanes(ov.laneKeys, task.appliedHeads, task.kind);
            if (lanes.length < task.appliedHeads) {
                // Not enough picked workers: top up from people allowed to do this kind of task, starting near the dropped lane.
                const pool = eligibleFor(task.kind).map(function(w) { return w.id; });
                const startAt = ov.startLane || 0;
                pool.filter(function(l) { return l >= startAt; }).concat(pool.filter(function(l) { return l < startAt; })).forEach(function(l) {
                    if (lanes.length < task.appliedHeads && lanes.indexOf(l) === -1) lanes.push(l);
                });
                if (lanes.length < task.appliedHeads) {
                    const first = Math.max(0, Math.min(startAt, totalLanes - task.appliedHeads));
                    lanes = Array.from({ length: task.appliedHeads }, function(_, i) { return first + i; });
                }
            }
            task.assignedLanes = lanes.sort(function(a, b) { return a - b; });
            task.finalDuration = task.getDuration(task.customInterrupts, task.appliedHeads, task.startMin);
