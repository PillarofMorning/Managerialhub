                                <div className="relative z-10 pt-2 touch-none">
                                    <div className="absolute top-0 bottom-0 left-[190px] z-0 pointer-events-none" style={{ width: `${GANTT_TOTAL_WIDTH_PX}px` }}>

                                        {/* LIVE TIME INDICATOR */}
