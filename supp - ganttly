                    maxHeight: `${LANE_HEIGHT_PX}px`,
                    flex: `0 0 ${LANE_HEIGHT_PX}px`,
                    boxSizing: 'border-box',
                    borderLeft: gc ? `4px solid ${gc}` : supColor ? `4px solid ${supColor}` : ac ? `4px solid ${ac}` : undefined,
                    paddingLeft: isMember ? '16px' : undefined,
                    backgroundColor: l.isLead && gc ? gc + '1f' : l.isLead ? '#f1f5f9' : supColor ? tintOf(supColor, 0.15) : ac ? tintOf(ac, 0.12) : undefined
                }}
                title={
                    l.isLead ? `${l.name} - Lead (${l.crew} crew)${st.tasks ? ' - ' + (st.bookedMins / 60).toFixed(1) + 'h of tasks, the rest is leadership' : ''}${l.teamNames.length ? '\nTeam: ' + l.teamNames.join(', ') : ''}` :
                    isSupWorker ? `${l.name} (${l.crew} crew) - Dedicated Room Support - ${supLabel}${l.room ? ' (' + l.room + ')' : ''} - Active on Demand${st.tasks ? ' - ' + (st.bookedMins / 60).toFixed(1) + 'h of equipment tasks' : ''}` :
                    `${l.name} (${l.crew} crew)${l.room ? ' - room: ' + l.room : ''}${l.leadKey ? ' - team of ' + (laneRoster.find(function(x) { return x.key === l.leadKey; }) || {}).name : ''} - ${(st.bookedMins / 60).toFixed(1)}h assigned of ${(st.availMins / 60).toFixed(0)}h on shift${st.duty > 0 ? ' - ' + fmtMins(st.duty) + ' support duty' : ''}${ac ? '\n' + AREA_ROLE_INFO[l.kind].label + ': the whole shift is the area\'s' + (acTasks.length ? '\n' + acTasks.map(function(t) { return (t.label || 'Task') + ' ' + clockLabelOf(t.from) + ' to ' + clockLabelOf(t.to); }).join('\n') : '') : ''}`
                }
            >
                <div className="flex items-center gap-1.5 min-w-0">
                    <span className={`text-[9px] font-black rounded px-1 py-0.5 flex-shrink-0 ${isSupWorker ? 'text-white' : getCrewStyle(l.crew).badge}`} style={isSupWorker ? { backgroundColor: supColor } : undefined}>{l.crew}</span>
                    <span className={`text-[11px] ${l.isLead ? 'font-black' : 'font-bold'} truncate min-w-0 ${l.isPlaceholder ? 'text-slate-400 italic' : 'text-slate-800'}`}>{l.name}</span>
                    {isSupWorker ? (
                        <span className="text-[8px] font-black uppercase tracking-wider rounded px-1.5 py-0.5 text-white flex items-center gap-0.5 flex-shrink-0 shadow-sm" style={{ backgroundColor: supColor }}>
                            SUPPORT
                        </span>
                    ) : (
                        roleTag(l)
                    )}
                </div>
                {l.isLead ? (
                    <div className="mt-1 text-[9px] font-bold truncate whitespace-nowrap" style={{ color: gc || '#64748b' }}>{teamTxt}</div>
                ) : isSupWorker ? (
                    <div data-on-duty className="mt-1 text-[9px] font-black uppercase tracking-wide truncate whitespace-nowrap flex items-center gap-1" style={{ color: darkOf(supColor) }}>
                        <span className="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: supColor }} />
                        Room Support - {supLabel}
                        {st.tasks > 0 && <span className="text-slate-500 font-semibold lowercase">({(st.bookedMins / 60).toFixed(1)}h equip)</span>}
                    </div>
                ) : ac ? (
                    <div data-on-duty className="mt-1 text-[9px] font-black uppercase tracking-wide truncate whitespace-nowrap" style={{ color: darkOf(ac) }}>On duty{st.done ? ' - ' + st.done + ' logged' : ''}</div>
                ) : (
                    <div className="flex items-center gap-1.5 mt-1">
                        <div className="flex-1 min-w-0 h-1 bg-slate-100 rounded-full overflow-hidden"><div className={`h-full ${pct > 100 ? 'bg-rose-500' : 'bg-[#0072CE]'}`} style={{ width: `${Math.min(100, pct)}%` }} /></div>
                        <span className="text-[9px] font-black text-slate-400 text-right whitespace-nowrap flex-shrink-0">{(st.bookedMins / 60).toFixed(1)}h - {st.done}/{st.tasks}{st.duty > 0 && <span data-duty-mins={Math.round(st.duty)} className="text-slate-500"> - {fmtMins(st.duty)} duty</span>}</span>
                    </div>
                )}
            </div>
        );
    };
    // A person's numbers for one shift of the one-line view (the whole-plan numbers would mix their other shifts in).
    const slotStats = function(sl) {
        const w = metricsWorkers[sl.lane];
        let booked = 0, tasks = 0, done = 0;
        (w ? w.schedule : []).forEach(function(x) {
            if (x.start < sl.start || x.start >= sl.end) return;
            const t = scheduleData.taskById[x.taskId];
            booked += x.end - x.start; tasks++;
            if (t && t.isComplete) done++;
        });
        return { availMins: sl.end - sl.start, bookedMins: booked, tasks: tasks, done: done, idle: idleWithin(laneIdle[sl.lane].gaps, sl.start, sl.end), duty: dutyWithin(sl.lane, sl.start, sl.end) };
    };
    // The names column of one shift on the one-line view: a card on each row somebody works that shift, grey where nobody does.
    const renderStackNames = function(gi, mark) {
        const g = stack.groups[gi];
        const out = [];
        for (let r = 0; r < stack.rows; r++) {
            const sl = g.slots.filter(function(x) { return x.row === r; })[0];
            if (!sl) {
                out.push(<div key={`blank-${gi}-${r}`} data-stack-blank={r} className="border-b border-gray-200/60 bg-slate-200/60 off-shift-stripes" style={{ height: `${LANE_HEIGHT_PX}px`, minHeight: `${LANE_HEIGHT_PX}px`, maxHeight: `${LANE_HEIGHT_PX}px`, flex: `0 0 ${LANE_HEIGHT_PX}px`, boxSizing: 'border-box' }} />);
                continue;
            }
            out.push(renderLaneCard(laneRoster[sl.lane], slotStats(sl), { key: `card-${gi}-${r}`, mark: mark }));
        }
        return out;
    };

    const statusChip = function(t) {
        if (t.isComplete) return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-emerald-100 text-emerald-800 border border-emerald-200">DONE</span>;
        if (t.isInProgress) return <span className={`text-[10px] font-black rounded px-1.5 py-0.5 border ${isLate(t) ? 'bg-rose-100 text-rose-800 border-rose-200' : 'bg-sky-100 text-sky-800 border-sky-200'}`}>{isLate(t) ? 'OVERRUN' : 'IN PROGRESS'}</span>;
        if (isLate(t)) return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-rose-100 text-rose-800 border border-rose-200">LATE</span>;
        return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-slate-100 text-slate-600 border border-slate-200">PLANNED</span>;
    };
    const timeRange = function(t) {
        return formatClockTime(ganttStartDate, ganttStartHour, t.startMin) + ' - ' + formatClockTime(ganttStartDate, ganttStartHour, t.startMin + t.finalDuration).replace(/^\S+ /, '');
    };
    // A tab updates when it is clicked. PBED takes the time and, when the Shift Start / production schedule rows are over 5 minutes old, reads
    // them again as it opens (the Setup and Dashboard tabs don't need them). Ganttly keeps its timers.
    const goTab = function(id) {
        if (!fullAccess && OPEN_TABS.indexOf(id) < 0) {
            return;
        }
        setPrinting(false);
        setActiveTab(id);
        setKeyOpen(false); setToolsOpen(false); setJudgedOpen(false);
        if (!LAZY_ENGINE) return;
        setLiveTime(new Date());
        if (id === 'setup' || id === 'equipment') return;
        if ((!shiftStartCheckedAt || Date.now() - shiftStartCheckedAt.getTime() > 5 * 60000) && !ssBusyRef.current && Date.now() - ssAttemptRef.current > 60000) reloadShiftStart();
        if (odWanted && odState.status !== 'loading' && odState.readAt && Date.now() - odState.readAt > OD_CACHE_MS && Date.now() - odAttemptRef.current > 5 * 60000) loadOverdue(true);   // an open tab reads the cleaning log again once it is 6 hours old
    };
    // ---- Startup board views (Ganttly) ----
    // A room opened from the board: Focus Mode on that room, all shifts.
    const known0 = function(v) { return v !== null && v !== undefined; };
    // Ganttly: stretches of [lo, hi) of at least NOT_LOGGED_MINS on a lane with no started / done block and no break or downtime.
    const notLoggedOf = function(lane, lo, hi) {
        if (!(hi - lo >= NOT_LOGGED_MINS)) return [];
        const w = scheduleData.workers[lane];
        const busy = (w ? w.schedule : []).filter(function(x) { const t = scheduleData.taskById[x.taskId]; return t && t.isFrozen; })
            .concat(allInterrupts).filter(function(b) { return b.end > lo && b.start < hi; }).map(function(b) { return { start: b.start, end: b.end }; })
            .sort(function(a, b) { return a.start - b.start; });
        const out = [];
        let cur = lo;
        busy.forEach(function(b) { if (b.start - cur >= NOT_LOGGED_MINS) out.push({ start: cur, end: Math.min(b.start, hi) }); cur = Math.max(cur, b.end); });
        if (hi - cur >= NOT_LOGGED_MINS) out.push({ start: cur, end: hi });
        return out;
    };
    // Ganttly: what really happened to a block, for its tooltip (when Start and Done were pressed, or that the start was not logged).
    const blockTruthNote = function(task) {
        const rec = taskStatus[task.id];
        const at = function(ms) { return board ? board.clockMs(ms) : formatDayClock(ms); };
        if (task.isComplete && rec) return '\nDone ' + (rec.doneAt ? at(rec.doneAt) : 'at ' + at(rec.startMs + (Number(rec.durationMins) || 0) * 60000)) + (rec.startedAt ? ' | started ' + at(rec.startedAt) : ' | start not logged (counted, not timed)');
        if (task.isInProgress && rec) return '\nStarted ' + at(rec.startedAt || rec.startMs) + (known0(task.overrunFrom) && task.overrunFrom < nowMin ? ' | ' + fmtMins(nowMin - task.overrunFrom) + ' past its plan' : '');
        return '';
    };
    const openBoardRoom = function(room) { if (tvMode) return; setFocusRoom(room); setGanttShift(''); if (!fullAccess) { goTab('gantt'); } else { goTab('focus'); } };
    const boardChip = function(status, big) {
        const st = STARTUP_STYLE[status] || STARTUP_STYLE.NONE;
        return (
            <span data-status-chip={status} className={'inline-flex items-center justify-center gap-1 rounded-md border font-black uppercase tracking-[0.06em] whitespace-nowrap ' + (big ? 'px-2.5 py-1 text-[13px]' : 'px-2 py-0.5 text-[10px]')} style={st.chip}>
                {status === 'READY' && <Check className="w-3 h-3" strokeWidth={3} />}{st.word}
            </span>
        );
    };
    // [{ s, e }] joined where they touch.
    const unionSpans = function(list) {
        const out = [];
        list.filter(function(x) { return x.e > x.s; }).sort(function(a, b) { return a.s - b.s; }).forEach(function(x) {
            const last = out[out.length - 1];
            if (last && x.s <= last.e + 0.5) last.e = Math.max(last.e, x.e); else out.push({ s: x.s, e: x.e });
        });
        return out;
    };
    const HATCH_RED = 'repeating-linear-gradient(135deg, rgba(228,0,43,0.55) 0 4px, rgba(228,0,43,0.15) 4px 8px)';
    const HATCH_GREY = 'repeating-linear-gradient(135deg, rgba(100,116,139,0.30) 0 4px, rgba(100,116,139,0.08) 4px 8px)';
    // One room's runway on the window's time axis: done (grey stripes), still to do (room colour), past its plan (red hatch),
    // won't fit (dashed red), the line still running (grey hatch), the spare up to the ready-by time, the ready-by tick (yellow) and
    // the startup flag (navy). Percent positions only, no chart library.
    const renderRunway = function(x, opts) {
        opts = opts || {};
        const H = board.H;
        const pc = function(m) { return Math.max(0, Math.min(1, m / H)) * 100; };
        const span = function(s, e) { const l = pc(s), r = pc(e); return { left: l + '%', width: Math.max(0, r - l) + '%' }; };
        const hex = roomHexShown(x.room);
        const endOf = function(t) { const e = t.startMin + t.finalDuration; return t.isInProgress ? Math.max(e, nowMin) : e; };
        const done = unionSpans(x.T.filter(function(t) { return t.isComplete; }).map(function(t) { return { s: t.startMin, e: t.startMin + t.finalDuration }; }));
        const doing = unionSpans(x.T.filter(function(t) { return t.isInProgress; }).map(function(t) { return { s: t.startMin, e: Math.min(nowMin, known0(t.overrunFrom) ? t.overrunFrom : nowMin) }; }));
        const todo = unionSpans(x.T.filter(function(t) { return !t.isComplete; }).map(function(t) { return { s: Math.max(t.startMin, nowMin), e: endOf(t) }; }));
        const over = x.overruns.map(function(t) { return { s: t.overrunFrom, e: Math.max(t.overrunFrom, nowMin) }; });
        const lastEnd = x.T.reduce(function(m, t) { return Math.max(m, endOf(t)); }, 0);
        const lanesUsed = x.T.reduce(function(acc, t) { (t.assignedLanes || []).forEach(function(l) { if (acc.indexOf(l) === -1) acc.push(l); }); return acc; }, []).length;
        const tailLen = x.uWork > 0 ? Math.max(H * 0.05, x.uWork / Math.max(1, Math.min(Number(roomLimits[x.room]) || 4, lanesUsed || 1))) : 0;
        const tailS = Math.min(Math.max(lastEnd, nowMin), H - Math.min(tailLen, H * 0.3));
        const showSpare = x.G !== null && x.F !== null && x.F !== Infinity && (x.status === 'ON_TRACK' || x.status === 'AT_RISK' || x.status === 'LATE' || x.status === 'READY' || x.status === 'DONE_LATE');
        const h = opts.tall ? 'h-9' : 'h-7';
        return (
            <div data-runway={x.room} className={'relative w-full rounded-md bg-slate-50 border border-slate-200 ' + h}>
                {(board.w || shiftWindows[0]) && shiftWindows.filter(function(sw) { return sw.start > 0 && sw.start < H; }).map(function(sw) {
                    return <div key={'sb' + sw.key} className="absolute top-0 bottom-0 border-l border-dashed border-slate-300" style={{ left: pc(sw.start) + '%' }} />;
                })}
                {x.running && <div className="absolute top-1 bottom-1 rounded-sm" style={Object.assign(span(0, x.S), { background: HATCH_GREY })} title={'Line running until ' + board.clock(x.S)} />}
                {x.running && pc(x.S) > 22 && <div className="absolute top-1/2 -translate-y-1/2 z-[5] flex justify-center pointer-events-none" style={span(0, x.S)}><span className="px-1.5 py-px rounded bg-white/90 text-[9px] font-black uppercase tracking-wide text-slate-500 truncate">line running until {board.clock(x.S)}</span></div>}
                {showSpare && x.F <= x.G && x.G > x.F + 1 && <div className="absolute top-0 bottom-0" style={Object.assign(span(Math.max(x.F, 0), x.G), { background: 'rgba(0,114,206,0.13)' })} title={'Spare: ' + fmtMins(x.G - x.F) + ' before ' + x.gateLabel} />}
                {showSpare && x.F > x.G && <div className="absolute top-0 bottom-0" style={Object.assign(span(x.G, Math.min(x.F, H)), { background: 'rgba(228,0,43,0.10)' })} title={'Short: ' + fmtMins(x.F - x.G) + ' past ' + x.gateLabel} />}
                {done.map(function(d, i) { return <div key={'d' + i} className="absolute top-1 bottom-1 rounded-sm bg-slate-400 opacity-70 complete-stripes" style={span(d.s, d.e)} title="Done" />; })}
                {doing.map(function(d, i) { return <div key={'g' + i} className="absolute top-1 bottom-1 rounded-sm" style={Object.assign(span(d.s, d.e), { background: hex, opacity: 0.55 })} title="Under way" />; })}
                {todo.map(function(d, i) { return <div key={'t' + i} className="absolute top-1 bottom-1 rounded-sm" style={Object.assign(span(d.s, d.e), { background: hex })} title="Still to do (plan)" />; })}
