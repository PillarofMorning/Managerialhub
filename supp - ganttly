    const openEquipDowntime = function(equipId) {
        setDtTarget(equipId);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
        setIsEquipDtModalOpen(true);
    };

    const addDowntime = function(type) {
        if (!newDtDate || !newDtTime) return alert("Date and Time required.");
        if (dtTarget === 'GLOBAL') {
             setDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Global Downtime',
                     isCustom: true
                 }]);
             });
        } else {
             setTargetDowntimes(function(prev) {
                 return prev.concat([{
                     id: 'dt_' + Date.now(),
                     type: type,
                     targetId: dtTarget,
                     dateTimeStr: newDtDate + 'T' + newDtTime,
                     duration: Number(newDtDuration),
                     label: newDtLabel || 'Maintenance'
                 }]);
             });
        }
        setIsRoomDtModalOpen(false);
        setIsEquipDtModalOpen(false);
    };

    const handleAddCustomTask = function() {
        if (!newTaskName.trim() || !newTaskArea.trim()) return alert("Name and Area are required.");
        const areaNameUpper = newTaskArea.toUpperCase();
        const newTask = {
            id: 'custom_' + Date.now(),
            name: newTaskName,
            area: areaNameUpper,
            minutesRequired: Number(newTaskMins),
            allergenMins: Number(newTaskMins),
            pbMins: 0,
            heads: Number(newTaskHeads),
            priority: Number(newTaskPriority),
            isComplete: false,
            isPinned: false
        };
        setAssets(function(prev) { return prev.concat([newTask]); });
        setCustomTasks(function(prev) { return prev.concat([newTask]); });
