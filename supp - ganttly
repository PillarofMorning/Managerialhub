            });
            const clockRoomTasks = baseClockTasks.length > 0
                ? baseClockTasks.slice().sort(function(a, b) {
                    const fa = (!!a.isNextCycle || (a.earliestStart || 0) > Math.max(0, nowMin) + 15) ? 1 : 0;
                    const fb = (!!b.isNextCycle || (b.earliestStart || 0) > Math.max(0, nowMin) + 15) ? 1 : 0;
