                                                                            {roleLabel} - Area Duty ({Math.max(1, Math.round((dutyEndMin - w.start) / 60))}h)
                                                                        </span>
                                                                    )}
                                                                </div>
                                                            )}
                                                            {tasks.map(function(t) {
