function sourceEmployeeAndLevel(detectedUser, employees) {
    if (!employees || !employees.length) {
        if (detectedUser && detectedUser.roles && detectedUser.roles.length) {
            var rStr = detectedUser.roles.join(' ').toLowerCase();
            if (/system administrator|system customizer|manager/i.test(rStr)) {
                return { level: 'manager', label: 'Manager', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
            if (/supervisor/i.test(rStr)) {
                return { level: 'supervisor', label: 'Supervisor', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
            if (/lead/i.test(rStr)) {
                return { level: 'lead', label: 'Lead', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
        }
        return { level: 'tech', label: 'Sanitation Tech', isLeadOrAbove: false, canLodgeNegative: false, matchedEmp: null };
    }

    var matched = null;
    var uId = detectedUser && detectedUser.userId ? String(detectedUser.userId).replace(/[{}]/g, '').toLowerCase() : '';
    var uEmail = detectedUser && detectedUser.userEmail ? String(detectedUser.userEmail).trim().toLowerCase() : '';
    var uName = detectedUser && detectedUser.userName ? String(detectedUser.userName).trim().toLowerCase() : '';

    // Match 1: By SystemUser GUID / Owning User / Employee ID
    if (uId) {
        matched = employees.find(function(e) {
            var own = String(e._owninguser_value || e._ownerid_value || e._createdby_value || '').replace(/[{}]/g, '').toLowerCase();
            var empGuid = String(e.craa5__aa_employeeid || e.craa5_aa_employeeid || '').replace(/[{}]/g, '').toLowerCase();
            return (own && own === uId) || (empGuid && empGuid === uId);
        });
    }

    // Match 2: By Email
    if (!matched && uEmail) {
        matched = employees.find(function(e) {
            var empEmail = String(e.craa5_email || e.email || '').trim().toLowerCase();
            return empEmail && empEmail === uEmail;
        });
    }

    // Match 3: By Name
    if (!matched && uName) {
        matched = employees.find(function(e) {
            var rawName = String(e.craa5_employeename || e.craa5_EmployeeName || e.craa5_name || e.craa5_Name || e.craa5_fullname || e.fullname || '').trim().toLowerCase();
            var fmtName = typeof formatFullName === 'function' ? formatFullName(rawName).toLowerCase() : '';
            return rawName === uName || fmtName === uName || (fmtName && uName.indexOf(fmtName) > -1) || (rawName && uName.indexOf(rawName) > -1);
        });
    }

    if (!matched) {
        if (detectedUser && detectedUser.roles && detectedUser.roles.length) {
            var rStr2 = detectedUser.roles.join(' ').toLowerCase();
            if (/system administrator|system customizer|manager/i.test(rStr2)) {
                return { level: 'manager', label: 'Manager (Admin)', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
            if (/supervisor/i.test(rStr2)) {
                return { level: 'supervisor', label: 'Supervisor', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
            if (/lead/i.test(rStr2)) {
                return { level: 'lead', label: 'Lead', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: null };
            }
        }
        return { level: 'unmatched', label: 'Unlinked Staff Member', isLeadOrAbove: false, canLodgeNegative: false, matchedEmp: null };
    }

    var roleRaw = matched.craa5_role !== undefined ? matched.craa5_role : matched.craa5_Role;
    var roleFmt = String(matched['craa5_role@OData.Community.Display.V1.FormattedValue'] || matched['craa5_Role@OData.Community.Display.V1.FormattedValue'] || '');
    var jobRole = (typeof readEmployeeJobRole === 'function' ? readEmployeeJobRole(matched) : '') || '';
    var combined = (String(roleRaw || '') + ' ' + roleFmt + ' ' + jobRole + ' ' + String(matched.craa5_employeename || matched.craa5_name || '')).toLowerCase();

    // Check level hierarchy:
    // Manager: 256000003 or contains 'manager' or 'manag'
    if (roleRaw === 256000003 || /manager| manag /i.test(combined)) {
        return { level: 'manager', label: 'Manager', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: matched };
    }
    // Supervisor: 256000002 or contains 'supervisor' or 'super'
    if (roleRaw === 256000002 || /supervisor| super /i.test(combined)) {
        return { level: 'supervisor', label: 'Supervisor', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: matched };
    }
    // Lead: 256000001 or contains 'lead'
    if (roleRaw === 256000001 || / lead /i.test(combined)) {
        return { level: 'lead', label: 'Lead', isLeadOrAbove: true, canLodgeNegative: true, matchedEmp: matched };
    }

    return {
        level: 'tech',
        label: roleFmt || jobRole || 'Sanitation Tech',
        isLeadOrAbove: false,
        canLodgeNegative: false,
        matchedEmp: matched
    };
}

