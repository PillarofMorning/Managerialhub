                    fetchFirstAvailable(["craa5_workshift"], props.dataApi)
                ]);

                setRawEmployees(dvEmps.rows);

                // A rotation the user edited on the Setup tab wins; otherwise use the Dataverse shift table.
                const parsedShifts = parseWorkShiftRows(dvShifts.rows);
                setShiftTableInfo(parsedShifts);
                if (parsedShifts && parsedShifts.slots && !Array.isArray(initialSettings.shiftRotation)) {
