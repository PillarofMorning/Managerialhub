            // Gather tasks & subcategories for unlocked autocomplete under clock (excluding weekly/non-daily items on a daily timeframe)
            const assetByIdMap = {};
            assets.forEach(function(a) { if (a && a.id) assetByIdMap[String(a.id)] = a; });
            const isTaskAllowedOnClock = function(t) {
                if (!t) return false;
