const BOARD_TOP = 200;
async function fetchBoardRows(dataApi) {
    let failed = false;
    const xrm = safeGetXrm();
    if (xrm && xrm.WebApi && typeof xrm.WebApi.retrieveMultipleRecords === 'function') {
        try {
            const fetchXml = "<fetch top='" + BOARD_TOP + "'><entity name='craa5_sanitationshiftreport'><attribute name='craa5_name'/><attribute name='craa5_equipmentjson'/><attribute name='modifiedon'/><filter><condition attribute='statecode' operator='eq' value='0'/><condition attribute='craa5_name' operator='like' value='" + BOARD_PREFIX + "%'/><condition attribute='modifiedon' operator='last-x-days' value='" + BOARD_DAYS + "'/></filter><order attribute='modifiedon' descending='true'/></entity></fetch>";
            const res = await xrm.WebApi.retrieveMultipleRecords('craa5_sanitationshiftreport', "?fetchXml=" + encodeURIComponent(fetchXml));
            if (res && Array.isArray(res.entities)) return res.entities;
        } catch (e) { failed = true; }
    }
    if (dataApi && typeof dataApi === 'object' && typeof dataApi.queryTable === 'function') {
