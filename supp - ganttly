                                                                            <span className="text-xs font-black text-slate-800">{a.name}</span>
                                                                            <span className="text-[10px] font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded">{a.area}</span>
                                                                        </div>
                                                                    );
                                                                })
                                                            )
                                                        ) : (
                                                            matchedRooms.length === 0 ? (
                                                                <div className="p-3 text-center text-xs text-slate-400 font-bold">No rooms matched &ldquo;{obstacleSearch}&rdquo;</div>
                                                            ) : (
                                                                matchedRooms.map(function(r) {
                                                                    return (
                                                                        <div
