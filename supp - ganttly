                    const dur = Number(obstacleDuration) || 30;
                    const cat = obstacleCategory === 'custom' ? (obstacleCustomCat.trim() || 'Custom') : obstacleCategory;
                    const now = new Date();
                    const dateFormatted = now.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' + now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });

