        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        const url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", `${IS_CURRENT ? 'Ganttly' : 'PBED'}_${IS_CURRENT ? getLocalYMD(liveTime) : ganttStartDate}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function() { try { URL.revokeObjectURL(url); } catch (e) {} }, 1000);
    };

    // PBED Generic view: one row per piece of equipment in each room's chain, then the department steps.
    const handleExportGeneric = function() {
        const q = function(v) { return '"' + String(v === undefined || v === null ? '' : v).replace(/"/g, '""') + '"'; };
        const clk = function(m) { return formatClockTime(ganttStartDate, ganttStartHour, m); };
        let csvContent = 'Room,Order,Step,Department,Function,Heads,Start Time,End Time,Duration (Mins),Work (person-mins),Status\n';
