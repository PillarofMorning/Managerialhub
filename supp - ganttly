    }, [props.dataApi]);

    // ============================================================================
    // CREW ROSTERS & WORKER LANES
    // Hourly staff from craa5__aa_employee grouped by craa5_shift. Excluded from the cleaning headcount:
    //  - leadership by the Role column (Lead / Supervisor / Manager)
    //  - non-cleaning job roles from the _aa_Role lookup (Inspector, Chemical Clerk by default; toggle on Setup)
    // Anyone marked absent on the Setup tab is dropped from the lanes.
    // ============================================================================
    // What a job role may be given: Setup's choice if any (older saves stored true / false), else the built-in default.
    const workKindOf = function(jobRole) {
        const key = jobRoleKey(jobRole) || '(no role)';
        const c = jobRoleChoices[key];
        if (c === true) return 'general';
        if (c === false) return 'none';
        if (typeof c === 'string' && WORK_KINDS.some(function(k) { return k.id === c; })) return c;
        return defaultWorkKind(key);
    };
    const rosterInfo = useMemo(function() {
        const rosters = { A: [], B: [], C: [], D: [] };
        const unmatched = [];
        const excluded = [];
        const roleExcluded = [];
        const inactive = [];
        const jobRoles = {};
        rawEmployees.forEach(function(e, i) {
            const name = formatFullName(e.craa5_name || e.craa5_Name || e.craa5_fullname || e.fullname || '') || ('Employee ' + (i + 1));
            const shift = readEmployeeShift(e);
            const roleRaw = e.craa5_role !== undefined ? e.craa5_role : e.craa5_Role;
            const role = String(roleRaw === undefined || roleRaw === null ? '' : roleRaw) + ' ' + String(e['craa5_role@OData.Community.Display.V1.FormattedValue'] || e['craa5_Role@OData.Community.Display.V1.FormattedValue'] || '');
            // Leadership (lead 256000001, supervisor 256000002, manager 256000003) never gets a lane or tasks.
            if (/25600000[123]|lead|super|manag/i.test(role)) { excluded.push(name); return; }
            const jobRole = readEmployeeJobRole(e);
            const jrKey = jobRoleKey(jobRole) || '(no role)';
            if (!jobRoles[jrKey]) jobRoles[jrKey] = { key: jrKey, label: jobRole || '(no role)', count: 0 };
            jobRoles[jrKey].count++;
            const workKind = workKindOf(jobRole);
            jobRoles[jrKey].kind = workKind;
            if (workKind === 'none') { roleExcluded.push(name + ' (' + (jobRole || 'no role') + ')'); return; }
            // A blank Shift means the person has left the company (marking them inactive in Dataverse does nothing), so they are ignored, not flagged.
            if (!shift.crew && shift.raw === '(blank)') { inactive.push(name); return; }
            if (!shift.crew) { unmatched.push({ name: name, raw: typeof shift.raw === 'object' ? JSON.stringify(shift.raw) : String(shift.raw) }); return; }
            rosters[shift.crew].push({
                id: String(e.craa5__aa_employeeid || e.craa5_aa_employeeid || ('emp_' + i)),
                name: name,
                kind: workKind,
                jobRole: jobRole
            });
        });
        CREW_CODES.forEach(function(c) { rosters[c].sort(function(a, b) { return a.name.localeCompare(b.name); }); });
        return { rosters: rosters, unmatched: unmatched, inactive: inactive, excluded: excluded, roleExcluded: roleExcluded, jobRoles: Object.values(jobRoles).sort(function(a, b) { return a.label.localeCompare(b.label); }) };
    }, [rawEmployees, jobRoleChoices]);
    const setJobRoleKind = function(key, kind) {
        setJobRoleChoices(function(prev) { return Object.assign({}, prev, { [key]: kind }); });
    };
    const crewRosters = rosterInfo.rosters;
    // How many tasks fall in each kind of work, so Setup shows whether PIC / chemical / janitorial are being picked up.
    const taskKindCounts = useMemo(function() {
        const c = { general: 0, pic: 0, chemical: 0, admin: 0, janitorial: 0 };
        assets.forEach(function(a) { if (!hiddenRooms[a.area]) c[a.kind || taskKind(a)]++; });
        return c;
    }, [assets, hiddenRooms]);
    const roleTag = function(l) {
        const t = WORK_KIND_SHORT[l && l.kind];
        return t ? <span className="ml-1.5 text-[9px] font-black uppercase tracking-wider rounded px-1 py-0.5 bg-slate-100 text-slate-600 border border-slate-200 align-middle" title={(l.jobRole || 'Role') + ' — ' + (WORK_KINDS.find(function(k) { return k.id === l.kind; }) || {}).label}>{t}</span> : null;
    };

    // Headcount: manual override > present people on the Dataverse roster > placeholder seats (no names found).
    const getCrewHeadcount = function(crew) {
        if (crewHeadcountOverrides[crew] !== undefined) return crewHeadcountOverrides[crew];
        if (crewRosters[crew].length === 0) return FALLBACK_CREW_SIZE;
        return crewRosters[crew].filter(function(p) { return !absentEmployees[p.id]; }).length;
    };

    const planHorizonMins = Math.max(60, Math.round(Number(planHours) || 12) * 60);
    const globalStartMs = getGlobalStart(ganttStartDate, ganttStartHour).getTime();
    const nowMin = Math.round((liveTime.getTime() - globalStartMs) / 60000);
    // Rounded to 15 min so the plan only re-flows a few times an hour.
    const reforecastFrom = liveReforecast && nowMin > 0 ? Math.ceil(nowMin / 15) * 15 : 0;

    const shiftWindows = useMemo(function() {
        return buildShiftWindows(shiftRotation, getGlobalStart(ganttStartDate, ganttStartHour), planHorizonMins)
            .map(function(w) { return Object.assign({}, w, { key: w.crew + '|' + w.start }); });
    }, [shiftRotation, ganttStartDate, ganttStartHour, planHorizonMins]);

    // One lane per person per crew working inside the plan window, ordered by when the crew first clocks in.
    const laneRoster = useMemo(function() {
        const crewOrder = [];
        shiftWindows.forEach(function(w) { if (crewOrder.indexOf(w.crew) === -1) crewOrder.push(w.crew); });
        const lanes = [];
        crewOrder.forEach(function(crew) {
            const crewWindows = shiftWindows.filter(function(w) { return w.crew === crew; }).map(function(w) { return { start: w.start, end: w.end }; });
            const present = crewRosters[crew].filter(function(p) { return !absentEmployees[p.id]; });
            const n = Math.max(0, Math.round(getCrewHeadcount(crew)));
            for (let k = 0; k < n; k++) {
                const person = present[k];
                lanes.push({
                    lane: lanes.length,
                    crew: crew,
                    key: person ? person.id : (crew + '#' + (k + 1)),
                    name: person ? person.name : (crew + ' Crew Seat ' + (k + 1)),
                    isPlaceholder: !person,
                    kind: person ? person.kind : 'general',
                    jobRole: person ? person.jobRole : '',
                    windows: crewWindows
                });
            }
        });
        return lanes;
    }, [shiftWindows, crewRosters, absentEmployees, crewHeadcountOverrides]);

    const globalHeadcount = laneRoster.length;
    const maxCrewSize = CREW_CODES.reduce(function(m, c) { return laneRoster.some(function(l) { return l.crew === c; }) ? Math.max(m, getCrewHeadcount(c)) : m; }, 0) || 1;
    const laneByKey = {};
    laneRoster.forEach(function(l) { laneByKey[l.key] = l.lane; });

    const removeSlot = function(slot) {
        setRotationSource('Saved');
        setShiftRotation(function(prev) { return prev.filter(function(s) { return s !== slot; }); });
    };
    const addSlot = function(crew) {
        const d = Object.assign({ day: 0, startHour: 6, endHour: 18 }, newSlot[crew] || {});
        const len = ((Number(d.endHour) - Number(d.startHour) + 24) % 24) || 24;
        setRotationSource('Saved');
        setShiftRotation(function(prev) { return prev.concat([{ crew: crew, day: Number(d.day), startHour: Number(d.startHour), lengthHours: len }]); });
    };
    const setNewSlotField = function(crew, field, val) {
        setNewSlot(function(prev) { return Object.assign({}, prev, { [crew]: Object.assign({ day: 0, startHour: 6, endHour: 18 }, prev[crew] || {}, { [field]: Number(val) }) }); });
    };
    const handleCrewHeadcountChange = function(crew, val) {
        setCrewHeadcountOverrides(function(prev) {
            const next = Object.assign({}, prev);
            const parsed = parseInt(val, 10);
