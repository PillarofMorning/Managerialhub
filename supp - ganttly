                                                    const baseLane = isDraggingMe ? dragState.currentLane : (task.assignedLanes[0] || 0);
                                                    const rLanes = isDraggingMe
                                                        ? Array.from({ length: task.appliedHeads }, function(_, i) { return baseLane + i; })
                                                        : task.assignedLanes;
                                                    const activeDuration = isDraggingMe && !task.isFrozen ? task.calculateDuration(rMin, task.customInterrupts, task.appliedHeads) : task.finalDuration;
                                                    const sortedLanes = rLanes.slice().sort(function(a,b) { return a-b; }).filter(function(l) { return l >= visibleLaneLo && l < visibleLaneLo + visibleLaneCount; });
                                                    if (sortedLanes.length === 0) return null;

                                                    const late = isLate(task);
                                                    // Layered bands (transit / base / allergen / inspection) only make sense for a whole, un-split task.
                                                    const isSimpleBlock = task.workOverrideMins !== null;
                                                    const transitEnd = task.isTransitActive ? 10 * task.appliedHeads : 0;
                                                    let activeWorkMins = task.baseMins;
                                                    if (task.isPbActive && task.pbMins > 0) activeWorkMins = task.pbMins;
                                                    else if (task.isAllergenActive && task.allergenMins > 0) activeWorkMins = task.allergenMins;
                                                    const startWork = 0;
                                                    const endWork = activeDuration * task.appliedHeads;
                                                    const breakPaddingMins = endWork - task.rawWorkloadMins;
                                                    const baseEnd = transitEnd + task.baseMins + ((task.isAllergenActive || task.isPbActive) ? 0 : breakPaddingMins);
                                                    const allergenEnd = transitEnd + activeWorkMins + breakPaddingMins;
                                                    const inspectEnd = task.isInspectionActive ? allergenEnd + (activeWorkMins * 0.10) : allergenEnd;
                                                    const transitOverlap = getOverlap(0, transitEnd, startWork, endWork);
                                                    const baseOverlap = getOverlap(transitEnd, baseEnd, startWork, endWork);
                                                    const allergenOverlap = getOverlap(baseEnd, allergenEnd, startWork, endWork);
                                                    const inspectOverlap = getOverlap(allergenEnd, inspectEnd, startWork, endWork);

                                                    const leftPx = (rMin / 60) * zoomLevel;
                                                    const widthPx = (activeDuration / 60) * zoomLevel;
                                                    if (leftPx >= GANTT_TOTAL_WIDTH_PX) return null;

                                                    // 🚨 ARCHITECTURE NOTE: Multi-Head Rendering Workaround
                                                    // One DOM block per assigned lane, so split teams (e.g. Worker 1 and Worker 5) don't paint over 2-4.
                                                    return sortedLanes.map(function(lane, laneIdx) {
                                                        const isPrimaryLane = (laneIdx === 0);
                                                        const topPx = (lane - visibleLaneLo) * LANE_HEIGHT_PX;
                                                        const ringCls = task.hasConflict ? 'outline outline-2 outline-dashed outline-amber-500' : late ? 'ring-2 ring-rose-500' : task.isInProgress ? 'ring-2 ring-sky-500' : '';
                                                        return (
                                                            <div
                                                                key={`${task.id}-${lane}`}
                                                                onPointerDown={function(e) {
                                                                    if (e && typeof e.stopPropagation === 'function') e.stopPropagation();
                                                                    draggedRef.current = false;
                                                                    setHasDragged(false);
                                                                    setDragState({ taskId: task.id, initialX: e.clientX, initialY: e.clientY, initialMin: task.startMin, initialLane: task.assignedLanes[0] || 0, currentMin: task.startMin, currentLane: task.assignedLanes[0] || 0, appliedHeads: task.appliedHeads });
                                                                    if (e.currentTarget && typeof e.currentTarget.setPointerCapture === 'function') e.currentTarget.setPointerCapture(e.pointerId);
                                                                }}
                                                                onPointerUp={function(e) {
                                                                    if (e.currentTarget && typeof e.currentTarget.releasePointerCapture === 'function') e.currentTarget.releasePointerCapture(e.pointerId);
                                                                    if (!draggedRef.current) setSelectedTaskEditor(task.id);
                                                                }}
                                                                onPointerEnter={function() { setHoveredTaskId(task.id); }}
                                                                onPointerLeave={function() { setHoveredTaskId(null); }}
                                                                title={`${task.name} · ${task.originalArea}\n${timeRange(task)}`}
                                                                className={`absolute block-draggable flex flex-col justify-center z-20 cursor-grab rounded-md
                                                                    ${task.isComplete ? 'opacity-60 grayscale' : ''}
                                                                    ${ringCls}
                                                                    ${isDraggingMe ? 'z-50 shadow-2xl scale-[1.02] ring-2 ring-white ring-offset-2 ring-offset-indigo-500 opacity-90 cursor-grabbing' : 'gantt-block-anim hover:z-30 hover:brightness-110 hover:shadow-md'}
                                                                    ${hoveredTaskId === task.id && !isDraggingMe ? 'z-30 brightness-110 shadow-lg' : ''}
                                                                `}
                                                                style={{ left: `${leftPx}px`, width: `${Math.max(widthPx, 8)}px`, top: `${topPx + 2}px`, height: `${LANE_HEIGHT_PX - 4}px` }}
                                                            >
                                                                <div className={`absolute inset-0 rounded-md overflow-hidden flex shadow-sm border ${(task.isPinned || task.isFrozen) && !isDraggingMe ? 'border-[2px] border-slate-900/70' : 'border-black/20'}`}>
                                                                    {isSimpleBlock && <div className={`absolute inset-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} />}
                                                                    {isSimpleBlock && task.isSplitPart1 && <div className="absolute top-0 bottom-0 right-0 w-1.5 bg-white/70" title="Handed over to next crew" />}
                                                                    {isSimpleBlock && task.isSplitPart2 && !task.isFrozen && <div className="absolute top-0 bottom-0 left-0 w-1.5 bg-white/70" title="Continued from previous crew" />}
                                                                    {!isSimpleBlock && transitOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${transitOverlap.leftPct}%`, width: `${transitOverlap.widthPct}%` }} title="Transit/Prep (10m)" />}
                                                                    {!isSimpleBlock && baseOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} style={{ left: `${baseOverlap.leftPct}%`, width: `${baseOverlap.widthPct}%` }} />}
                                                                    {!isSimpleBlock && allergenOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} opacity-40 ${task.isComplete ? 'complete-stripes' : ''}`} style={{ left: `${allergenOverlap.leftPct}%`, width: `${allergenOverlap.widthPct}%` }} title="Allergen Extra Time" />}
                                                                    {!isSimpleBlock && inspectOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${inspectOverlap.leftPct}%`, width: `${inspectOverlap.widthPct}%` }} title="Inspection" />}
                                                                </div>

                                                                <div className="relative z-30 pl-2 pr-1 pointer-events-none flex items-center gap-1 w-full h-full">
                                                                    {widthPx > 20 && (isPrimaryLane ? (
                                                                        <span className="text-white font-bold text-[11px] truncate leading-tight drop-shadow-md flex-1 flex items-center gap-1">
                                                                            {task.isComplete && <Check className="w-3 h-3 flex-shrink-0" />}
                                                                            {task.isInProgress && <Play className="w-3 h-3 flex-shrink-0" />}
                                                                            {(task.isAllergenActive || task.isPbActive) && <Biohazard className="w-3 h-3 text-rose-200 flex-shrink-0" />}
                                                                            <span className="truncate">{task.name}</span>
                                                                        </span>
                                                                    ) : (
                                                                        <span className="text-white/80 font-black text-[10px] flex-1 truncate drop-shadow-sm">+ {task.name}</span>
                                                                    ))}
                                                                    {isPrimaryLane && widthPx > 60 && !isDraggingMe && (
                                                                        <button
                                                                            onPointerDown={function(e) { e.stopPropagation(); }}
                                                                            onPointerUp={function(e) { e.stopPropagation(); }}
                                                                            onClick={function(e) { e.stopPropagation(); setBlockStatus(task, task.isComplete ? null : 'done'); }}
                                                                            title={task.isComplete ? 'Undo check-off' : 'Mark done'}
                                                                            className={`pointer-events-auto w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 border ${task.isComplete ? 'bg-white text-emerald-600 border-white' : 'bg-white/20 text-white border-white/60 hover:bg-white hover:text-emerald-600'}`}
                                                                        >
                                                                            <Check className="w-3 h-3" />
                                                                        </button>
                                                                    )}
                                                                </div>
                                                            </div>
                                                        );
                                                    });
                                                });
                                            })}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            )}

            {/* CUSTOM TASK MODAL */}
            {isCustomTaskModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsCustomTaskModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Custom Task</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsCustomTaskModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Task Name</label>
                                <input type="text" value={newTaskName} onChange={function(e) { setNewTaskName(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Special Deep Clean" />
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Area</label>
                                <input list="area-list" type="text" value={newTaskArea} onChange={function(e) { setNewTaskArea(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none uppercase" placeholder="e.g. PACKAGING" />
                                <datalist id="area-list">
                                    {activeRooms.map(function(room) { return <option key={room} value={room} />; })}
                                </datalist>
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Total Mins</label>
                                    <input type="number" min="15" step="15" value={newTaskMins} onChange={function(e) { setNewTaskMins(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Heads</label>
                                    <input type="number" min="1" value={newTaskHeads} onChange={function(e) { setNewTaskHeads(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Priority</label>
                                    <input type="number" min="1" value={newTaskPriority} onChange={function(e) { setNewTaskPriority(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                            </div>
                            <Button className="w-full mt-4" onClick={handleAddCustomTask}>Create Task</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* ROOM DOWNTIME MODAL */}
            {isRoomDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsRoomDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">{dtTarget === 'GLOBAL' ? 'Add Global Downtime' : 'Add Room Downtime'}</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsRoomDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-indigo-600 mb-4 bg-indigo-50 p-2 rounded">Target: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Chemical Refill" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime(dtTarget === 'GLOBAL' ? 'global' : 'room'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* EQUIP DOWNTIME MODAL */}
            {isEquipDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsEquipDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Equipment Downtime</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsEquipDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-indigo-600 mb-4 bg-indigo-50 p-2 rounded">Target Equipment ID: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Blade Swap" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime('equipment'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* POPUP EDITOR FOR TASKS */}
            {selectedTaskEditor && activeEditorTask && (function() {
                const t = activeEditorTask;
                const parentAsset = assets.find(function(a) { return a.id === t.parentId; });
                const onShiftLanes = laneRoster.filter(function(o) { return scheduleData.workers[o.lane] && scheduleData.workers[o.lane].windowAt(t.startMin) && scheduleData.workers[o.lane].canDo(t.kind, scheduleData.isNightAt(t.startMin)); });
                const close = function() { setSelectedTaskEditor(null); };
                return (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 animate-in fade-in duration-200 touch-none" onPointerDown={close}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>

                        <div className="flex justify-between items-start border-b border-slate-100 pb-4 mb-4">
                            <div>
                                <h3 className="text-lg font-black text-slate-800 leading-tight">{t.name}</h3>
                                <p className="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1 flex items-center"><MapPin className="w-3 h-3 mr-1"/> {t.originalArea}</p>
                                <div className="flex items-center gap-2 mt-2">
                                    {statusChip(t)}
                                    <span className="text-[11px] text-slate-600 font-bold">{timeRange(t)}</span>
                                </div>
                            </div>
                            <Button variant="outline" size="sm" onClick={close} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>

                        <div className="space-y-4">
                            <div className="grid grid-cols-3 gap-2">
                                <Button variant="outline" disabled={t.isInProgress || t.isComplete} onClick={function() { setBlockStatus(t, 'started'); }}><Play className="w-4 h-4 mr-1" /> Start</Button>
                                <Button variant="success" disabled={t.isComplete} onClick={function() { setBlockStatus(t, 'done'); close(); }}><Check className="w-4 h-4 mr-1" /> Done</Button>
                                <Button variant="outline" disabled={!t.isFrozen} onClick={function() { setBlockStatus(t, null); }} title="Undo check-off and let the planner re-plan this work">Undo</Button>
                            </div>

                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Assigned Workers</label>
                                <div className="space-y-1.5">
                                    {t.assignedLanes.map(function(l) {
                                        const lr = laneRoster[l];
                                        if (!lr) return null;
                                        return (
                                            <div key={l} className="flex items-center gap-2">
                                                <span className={`text-[10px] font-black rounded px-1.5 py-0.5 ${getCrewStyle(lr.crew).badge}`}>{lr.crew}</span>
                                                <select value={l} onChange={function(e) { reassignWorker(t, l, Number(e.target.value)); }} className="flex-1 border border-slate-300 rounded-lg p-1.5 text-sm font-bold outline-none cursor-pointer">
                                                    {onShiftLanes.concat(onShiftLanes.some(function(o) { return o.lane === l; }) ? [] : [lr]).map(function(o) {
                                                        const ws = workerStats[o.lane];
                                                        return <option key={o.lane} value={o.lane} disabled={o.lane !== l && t.assignedLanes.indexOf(o.lane) > -1}>{o.name} ({o.crew}) — {ws ? (ws.bookedMins / 60).toFixed(1) : 0}h assigned</option>;
                                                    })}
                                                </select>
                                            </div>
                                        );
                                    })}
                                </div>
                                {t.isSplitPart1 && <p className="text-[11px] font-bold text-amber-700 mt-2">Handed over to the next crew at shift end.</p>}
                                {t.isSplitPart2 && !t.isFrozen && <p className="text-[11px] font-bold text-amber-700 mt-2">Continues work from an earlier part (+{handoverMins}m/head handover).</p>}
                                {t.hasConflict && <p className="text-[11px] font-bold text-amber-700 mt-2">A worker on this block is double-booked — reassign or move one of the overlapping tasks.</p>}
                                {t.roleMismatch && <p className="text-[11px] font-bold text-rose-700 mt-2">A worker on this block is not allowed this kind of task ({(WORK_KINDS.find(function(k) { return k.id === t.kind; }) || {}).label}) — reassign to the right role.</p>}
                                {t.isOffShift && <p className="text-[11px] font-bold text-rose-700 mt-2">This block sits outside an assigned worker's shift.</p>}
                            </div>

                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Clock className="w-3 h-3 mr-1"/> Start</label>
                                    <input type="datetime-local" value={getDatetimeLocalString(t.startMin, ganttStartDate, ganttStartHour)} onChange={function(e) {
                                        const ms = new Date(e.target.value).getTime();
                                        if (!isNaN(ms)) moveBlock(t, Math.round((ms - globalStartMs) / 60000), t.assignedLanes);
                                    }} className="w-full text-center border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none" />
                                </div>
                                {parentAsset && (
                                    <div className="w-24">
                                        <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Heads</label>
                                        <input type="number" min="1" value={parentAsset.heads} onChange={function(e) { handleTaskHeadsChange(parentAsset.id, e.target.value); }} className="w-full text-center border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none" />
                                    </div>
                                )}
                            </div>

                            {overrides[t.id] && !t.isFrozen && (
                                <Button className="w-full bg-slate-100 text-slate-700 hover:bg-slate-200 shadow-none border border-slate-300" variant="outline" onClick={function() { clearOverride(t.id); close(); }}>
                                    <RefreshCw className="w-4 h-4 mr-2" /> Undo Move & Auto-Schedule
                                </Button>
                            )}
                        </div>
                    </div>
                </div>
                );
            })()}
        </div>
    );
}
