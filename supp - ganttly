function translateTextToEsMx(raw) {
    if (!raw || typeof raw !== 'string') return raw;
    const trimmed = raw.trim();
    if (!trimmed) return raw;
    if (ES_MX_EXACT[trimmed] !== undefined) {
        const lead = raw.slice(0, raw.indexOf(trimmed));
        const tail = raw.slice(raw.indexOf(trimmed) + trimmed.length);
        return lead + ES_MX_EXACT[trimmed] + tail;
    }
    for (let i = 0; i < ES_MX_PATTERNS.length; i++) {
        const pat = ES_MX_PATTERNS[i][0];
        const rep = ES_MX_PATTERNS[i][1];
        if (pat.test(trimmed)) {
            const lead = raw.slice(0, raw.indexOf(trimmed));
            const tail = raw.slice(raw.indexOf(trimmed) + trimmed.length);
            return lead + trimmed.replace(pat, rep) + tail;
        }
    }
    // Composite inline replacements for dynamic sentences
    let out = raw;
    out = out.replace(/\bON TIME\b/g, 'A TIEMPO')
             .replace(/\bAT RISK\b/g, 'EN RIESGO')
             .replace(/\bLATE\b/g, 'TARDE')
             .replace(/\bRUNNING\b/g, 'CORRIENDO')
             .replace(/\bREADY\b/g, 'LISTO')
             .replace(/\bNO STARTUP\b/g, 'SIN ARRANQUE')
             .replace(/\s-\s+live\s-\s/g, ' - en vivo - ')
             .replace(/(\d+)\s+on now\s+\(([^)]+)\s+crew\)/gi, '$1 en turno (cuadrilla $2)')
             .replace(/\bno shift running now\b/gi, 'sin turno activo ahora')
             .replace(/\bnext startup\b/gi, 'proximo arranque')
             .replace(/\bReady-by Gate:\b/gi, 'Meta Listo:')
             .replace(/\bon schedule\b/gi, 'en tiempo')
             .replace(/\bhrs needed\b/gi, 'hrs requeridas')
             .replace(/\bhrs remaining\b/gi, 'hrs restantes')
             .replace(/\bhrs done\b/gi, 'hrs listas')
             .replace(/\butilized\b/gi, 'utilizado')
             .replace(/\b ahead of plan end\b/gi, ' antes del fin del plan')
             .replace(/\b past plan end\b/gi, ' despues del fin del plan')
             .replace(/\btask\(s\) won't fit by plan end\b/gi, 'tarea(s) no caben antes del fin del plan')
             .replace(/\bAll lines on track for startup\b/gi, 'Todas las lineas a tiempo para el arranque')
             .replace(/\bEvery production room with a startup is on time\b/gi, 'Cada cuarto de produccion con arranque va a tiempo')
             .replace(/\bNo production startup is set in this window\b/gi, 'No hay arranque de produccion programado en esta ventana');
    return out;
}

function applyDomTranslation(rootEl, langMode) {
    if (!rootEl || typeof document === 'undefined') return;
    const isEs = langMode === 'es';
    try {
        const walker = document.createTreeWalker(rootEl, 4 /* NodeFilter.SHOW_TEXT */, null, false);
        let node;
        while ((node = walker.nextNode())) {
            const parent = node.parentNode;
            if (parent && (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE' || (parent.closest && parent.closest('[data-no-translate="true"]')))) continue;
            const curVal = node.nodeValue || '';
            if (!curVal.trim()) continue;
            if (isEs) {
                if (node.__origEnText === undefined || node.__lastEsText !== curVal) {
                    node.__origEnText = curVal;
                }
                const translated = translateTextToEsMx(node.__origEnText);
                if (translated !== curVal) {
                    node.__lastEsText = translated;
                    node.nodeValue = translated;
                } else {
                    node.__lastEsText = curVal;
                }
            } else if (node.__origEnText !== undefined) {
                if (curVal === node.__lastEsText) {
                    node.nodeValue = node.__origEnText;
                }
                delete node.__origEnText;
                delete node.__lastEsText;
            }
        }
        const els = rootEl.querySelectorAll('[placeholder], [title], [aria-label]');
        for (let i = 0; i < els.length; i++) {
            const el = els[i];
            ['placeholder', 'title', 'aria-label'].forEach(function(attr) {
                const val = el.getAttribute(attr);
                if (!val) return;
                const origKey = '__orig_' + attr;
                const lastKey = '__last_' + attr;
                if (isEs) {
                    if (el[origKey] === undefined || el[lastKey] !== val) {
                        el[origKey] = val;
                    }
                    const trVal = translateTextToEsMx(el[origKey]);
                    if (trVal !== val) {
                        el[lastKey] = trVal;
                        el.setAttribute(attr, trVal);
                    } else {
                        el[lastKey] = val;
                    }
                } else if (el[origKey] !== undefined) {
                    if (val === el[lastKey]) {
                        el.setAttribute(attr, el[origKey]);
                    }
                    delete el[origKey];
                    delete el[lastKey];
                }
            });
        }
    } catch (e) {}
}

