                                <Button variant="success" disabled={t.isComplete} onClick={function() { setBlockStatus(t, 'done'); close(); }}><Check className="w-4 h-4 mr-1" /> Done</Button>
                                <Button variant="outline" disabled={!t.isFrozen} onClick={function() { setBlockStatus(t, null); }} title="Undo check-off and let the planner re-plan this work">Undo</Button>
                            </div>

                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Assigned Workers</label>
                                <div className="space-y-1.5">
                                    {t.assignedLanes.map(function(l) {
