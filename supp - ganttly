                    { id: 'loss of utility', label: 'Loss of Utility', icon: '*', color: 'bg-orange-50 text-orange-800 border-orange-200' },
                    { id: 'custom', label: 'Custom Category', icon: '*', color: 'bg-slate-50 text-slate-800 border-slate-300' }
