                    onDrop: function(e) { if (!editable) return; e.preventDefault(); setAsgDropOn(''); let aid = ''; try { aid = e.dataTransfer.getData('text/plain'); } catch (err) {} if (aid) asgMoveTo(w, plan, aid, guid); },
