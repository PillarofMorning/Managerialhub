// TYPE OF CLEAN
// ============================================================================
// The equipment table's yes/no columns (craa5_dailyclean, craa5_weeklyclean, craa5_monthlyclean, craa5_quarterly, ...) say how
// often each piece of equipment is cleaned. Every craa5_ column whose values are all yes/no is offered as a type of clean;
// picking types plans only the equipment marked yes for at least one of them. Nothing picked = every piece of equipment.
const CLEAN_TYPE_LABELS = { craa5_dailyclean: 'Daily', craa5_midweek: 'Midweek', craa5_weeklyclean: 'Weekly', craa5_monthlyclean: 'Monthly', craa5_month: 'Month', craa5_quarterly: 'Quarterly', craa5_annually: 'Annually' };
const CLEAN_TYPE_ORDER = ['craa5_dailyclean', 'craa5_midweek', 'craa5_weeklyclean', 'craa5_monthlyclean', 'craa5_month', 'craa5_quarterly', 'craa5_annually'];
function yesNoValue(v) {
    if (v === true || v === false) return v;
    if (typeof v === 'string') {
        const t = v.trim().toLowerCase();
        if (t === 'true' || t === 'yes') return true;
        if (t === 'false' || t === 'no') return false;
    }
    return null;
}
// Column names (craa5_...) whose filled-in values are all yes/no, frequency columns first.
function detectYesNoColumns(rows) {
    const yes = {}, bad = {};
    (rows || []).forEach(function(r) {
        Object.keys(r || {}).forEach(function(k) {
            if (k.indexOf('craa5_') !== 0 || k.indexOf('@') > -1 || bad[k]) return;
            const v = r[k];
            if (v === null || v === undefined || v === '') return;
            if (yesNoValue(v) === null) { bad[k] = true; delete yes[k]; return; }
            yes[k] = true;
        });
    });
    return Object.keys(yes).sort(function(a, b) {
        const ia = CLEAN_TYPE_ORDER.indexOf(a), ib = CLEAN_TYPE_ORDER.indexOf(b);
        if (ia !== ib) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
        return a < b ? -1 : a > b ? 1 : 0;
    });
}
function humanizeColumn(k) {
    const t = String(k).replace(/^craa5_+/, '').replace(/clean$/, '').replace(/_+/g, ' ').trim() || String(k);
    return t.charAt(0).toUpperCase() + t.slice(1);
}
// The columns' display names from Dataverse, when the host offers table metadata ({} otherwise).
async function fetchColumnLabels(entityName, keys) {
    const out = {};
    const xrm = safeGetXrm();
    if (!keys.length || !xrm || !xrm.Utility || typeof xrm.Utility.getEntityMetadata !== 'function') return out;
    try {
        const md = await xrm.Utility.getEntityMetadata(entityName, keys);
        const attrs = md && md.Attributes;
        keys.forEach(function(k) {
            let a = null;
            if (attrs && typeof attrs.get === 'function') a = attrs.get(k);
            else if (Array.isArray(attrs)) a = attrs.find(function(x) { return x && x.LogicalName === k; });
            else if (attrs && typeof attrs === 'object') a = attrs[k];
            const dn = a && a.DisplayName;
            const label = typeof dn === 'string' ? dn : (dn && dn.UserLocalizedLabel && dn.UserLocalizedLabel.Label) || '';
            if (label && String(label).trim()) out[k] = String(label).trim();
        });
    } catch (e) {}
    return out;
}

