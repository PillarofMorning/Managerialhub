                                <div className="flex items-center justify-between">
                                    <span className="text-[10px] font-black uppercase tracking-wider text-slate-500">Microsoft Account Detected</span>
                                    <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800 border border-blue-200">
                                        {detectedMsUser.source}
                                    </span>
                                </div>
                                <div className="text-xs font-black text-slate-900">
                                    {detectedMsUser.userName || (detectedMsUser.userId ? ('User: ' + detectedMsUser.userId) : 'Active Dataverse Session')}
                                </div>
                                {detectedMsUser.userEmail && (
                                    <div className="text-[11px] font-bold text-slate-600">
                                        Email: {detectedMsUser.userEmail}
                                    </div>
                                )}
                                {detectedMsUser.userId && (
                                    <div className="text-[10px] font-mono text-slate-400 truncate">
                                        ID: {detectedMsUser.userId}
                                    </div>
                                )}
                            </div>

                            {/* EMPLOYEE LEVEL & AUTHORIZATION STATUS */}
                            <div className={'rounded-xl p-4 border ' + (
                                effectiveSupervisorInfo.canLodgeNegative
                                    ? 'bg-emerald-50/70 border-emerald-300 text-emerald-950'
                                    : 'bg-amber-50/70 border-amber-300 text-amber-950'
                            )}>
                                <div className="flex items-center justify-between mb-2">
                                    <div className="text-[11px] font-black uppercase tracking-wider text-slate-700">
                                        Sourced Employee Level:
                                    </div>
                                    <span className={'px-2.5 py-1 rounded-full text-xs font-black flex items-center gap-1 ' + (
                                        effectiveSupervisorInfo.level === 'manager'
                                            ? 'bg-purple-100 text-purple-900 border border-purple-300'
                                            : (effectiveSupervisorInfo.level === 'supervisor'
                                                ? 'bg-blue-100 text-blue-900 border border-blue-300'
                                                : (effectiveSupervisorInfo.level === 'lead'
                                                    ? 'bg-emerald-100 text-emerald-900 border border-emerald-300'
                                                    : 'bg-slate-200 text-slate-800 border border-slate-300'))
                                    )}>
                                        {effectiveSupervisorInfo.level === 'manager' && 'Manager'}
                                        {effectiveSupervisorInfo.level === 'supervisor' && 'Supervisor'}
                                        {effectiveSupervisorInfo.level === 'lead' && 'Lead'}
                                        {effectiveSupervisorInfo.level === 'tech' && 'Tech / Crew'}
                                        {effectiveSupervisorInfo.level === 'unmatched' && 'Unlinked Staff'}
                                    </span>
                                </div>

                                <div className="text-xs font-bold mt-1">
                                    {effectiveSupervisorInfo.canLodgeNegative ? (
                                        <div className="flex items-start gap-2 text-emerald-900">
                                            <span className="text-base leading-none text-emerald-600 mt-0.5"><Check className="w-4 h-4" /></span>
                                            <div>
                                                <div className="font-black">Authorized for Negative &amp; Coaching Remarks</div>
                                                <div className="text-[11px] font-medium text-emerald-800 mt-0.5">
                                                    Employee level ({effectiveSupervisorInfo.label}) qualifies to lodge confidential negative remarks, performance coaching, and incident documentation.
                                                </div>
                                            </div>
                                        </div>
                                    ) : (
                                        <div className="flex items-start gap-2 text-amber-900">
                                            <span className="text-base leading-none text-amber-600 mt-0.5"><AlertTriangle className="w-4 h-4" /></span>
                                            <div>
                                                <div className="font-black">Read-Only / Positive Recognition Access</div>
                                                <div className="text-[11px] font-medium text-amber-800 mt-0.5">
                                                    Lodging negative remarks requires <b>Lead</b>, <b>Supervisor</b>, or <b>Manager</b> status. Current sourced level: <b>{effectiveSupervisorInfo.label}</b>.
                                                </div>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>

                            {/* EMPLOYEE PROFILE SELECTION */}
                            <div>
                                <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                    Employee Profile <span className="font-normal text-slate-400 normal-case">(Auto-matched or select profile)</span>
                                </label>
                                <select
                                    value={supervisorSelectedEmpId || effectiveSupervisorInfo.empId || ''}
                                    onChange={function(e) {
                                        setSupervisorSelectedEmpId(e.target.value);
                                        const found = (rawEmployees || []).find(function(x) {
                                            return String(x.craa5__aa_employeeid || x.craa5_aa_employeeid || '') === e.target.value;
                                        });
                                        if (found) {
                                            const rawName = String(found.craa5_employeename || found.craa5_EmployeeName || found.craa5_name || found.craa5_Name || found.craa5_fullname || found.fullname || '').trim();
                                            const dispName = (typeof formatFullName === 'function' ? formatFullName(rawName) : '') || rawName;
                                            setSupervisorName(dispName);
                                        }
                                    }}
                                    className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs font-bold text-slate-800 outline-none focus:border-indigo-500 bg-white"
                                >
                                    <option value="">{effectiveSupervisorInfo.isAutoDetected ? ('Auto-matched: ' + effectiveSupervisorInfo.name + ' (' + effectiveSupervisorInfo.label + ')') : '-- Select Employee Profile --'}</option>
                                    {(rawEmployees || []).map(function(emp, idx) {
                                        const id = String(emp.craa5__aa_employeeid || emp.craa5_aa_employeeid || ('idx_' + idx));
                                        const rawName = String(emp.craa5_employeename || emp.craa5_EmployeeName || emp.craa5_name || emp.craa5_Name || emp.craa5_fullname || emp.fullname || '').trim();
                                        const dispName = (typeof formatFullName === 'function' ? formatFullName(rawName) : '') || rawName;
                                        const roleSourced = sourceEmployeeAndLevel({ userId: '', userName: '', userEmail: '', roles: [] }, [emp]);
                                        return (
                                            <option key={id} value={id}>
                                                {dispName} - [{roleSourced.label}] {roleSourced.canLodgeNegative ? '(Authorized)' : ''}
                                            </option>
                                        );
                                    })}
                                </select>
                            </div>

                            {/* SUPERVISOR DISPLAY NAME */}
                            <div>
                                <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                    Display Name / Signature
                                </label>
                                <input
                                    type="text"
                                    value={supervisorName}
                                    onChange={function(e) { setSupervisorName(e.target.value); }}
                                    placeholder="e.g. Supervisor Marcus"
                                    className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs font-bold text-slate-800 outline-none focus:border-indigo-500"
                                />
                            </div>

                            {/* PIN / ACCESS CODE */}
                            <div>
                                <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                    PIN / Access Code <span className="font-normal text-slate-400 normal-case">(optional)</span>
                                </label>
                                <input
                                    type="password"
                                    value={supervisorPin}
                                    onChange={function(e) { setSupervisorPin(e.target.value); }}
                                    placeholder="****"
                                    className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs font-bold text-slate-800 outline-none focus:border-indigo-500"
                                />
                            </div>

                            {/* ACTION BUTTONS */}
                            <div className="flex items-center gap-3 pt-3 border-t border-slate-100">
                                <button
                                    type="button"
                                    onClick={function() { setSupervisorLoginOpen(false); }}
                                    className="flex-1 py-2 px-3 rounded-lg border border-slate-300 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors cursor-pointer"
                                >
                                    Cancel
                                </button>
                                <button
                                    type="button"
                                    onClick={function() {
                                        const chosenName = supervisorName.trim() || effectiveSupervisorInfo.name || 'Shift Supervisor';
                                        setSupervisorMode(true);
                                        setSupervisorName(chosenName);
                                        setSupervisorLevel(effectiveSupervisorInfo.level);
                                        setSupervisorCanLodgeNegative(effectiveSupervisorInfo.canLodgeNegative);
                                        setSupervisorEmployeeId(effectiveSupervisorInfo.empId);
                                        setSupervisorLoginOpen(false);

                                        if (effectiveSupervisorInfo.canLodgeNegative) {
                                            setPersonnelToast('Signed in as ' + chosenName + ' (' + effectiveSupervisorInfo.label + ') - Authorized for negative remarks');
                                        } else {
                                            setPersonnelToast('Signed in as ' + chosenName + ' (' + effectiveSupervisorInfo.label + ') - Negative remarks restricted to Lead & above');
                                        }
                                    }}
                                    className={'flex-1 py-2 px-3 rounded-lg text-white text-xs font-black shadow-xs transition-colors cursor-pointer flex items-center justify-center gap-1.5 ' + (
                                        effectiveSupervisorInfo.canLodgeNegative
                                            ? 'bg-indigo-700 hover:bg-indigo-800'
                                            : 'bg-slate-700 hover:bg-slate-800'
                                    )}
                                >
                                    <Shield className="w-3.5 h-3.5" />
                                    <span>Sign In</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* SHIFT HANDOVER REVIEW & CONFIRMATION MODAL */}
            {handoverModal && (
                <div className="fixed inset-0 bg-slate-900/60 z-[130] flex items-center justify-center backdrop-blur-xs p-4 animate-in fade-in duration-150" onClick={function() { setHandoverModal(null); }}>
                    <div className="bg-white rounded-2xl shadow-2xl w-full max-w-lg border border-slate-300 overflow-hidden" onClick={function(e) { e.stopPropagation(); }}>
                        <div className="bg-gradient-to-r from-amber-600 to-orange-600 px-6 py-4 text-white flex items-center justify-between">
                            <div className="flex items-center gap-2.5">
                                <span className="text-2xl">{'->'}</span>
                                <div>
                                    <h3 className="text-base font-black tracking-wide">Shift Handover: Unfulfilled Tasks</h3>
                                    <p className="text-xs font-semibold text-amber-100">
                                        Transfer unfinished work from Shift {handoverModal.outgoingCrew} &rarr; Shift {handoverModal.incomingCrew}
                                    </p>
                                </div>
                            </div>
                            <button type="button" onClick={function() { setHandoverModal(null); }} className="text-white/80 hover:text-white text-lg font-bold cursor-pointer">X</button>
                        </div>

                        <div className="p-6 space-y-4 max-h-[85vh] overflow-y-auto custom-scrollbar">
                            <div className="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-xs text-amber-950 space-y-1">
                                <div className="font-black flex items-center gap-1.5">
                                    <AlertTriangle className="w-4 h-4 text-amber-600 flex-shrink-0" />
                                    <span>{handoverModal.tasks.length} unfulfilled tasks identified</span>
                                </div>
                                <div className="text-[11px] text-amber-800">
                                    These cleaning tasks were planned for Shift {handoverModal.outgoingCrew} but could not be completed. Confirming handover will automatically re-assign and prioritize them on Shift {handoverModal.incomingCrew}&apos;s schedule.
                                </div>
                            </div>

                            {/* List of Tasks to Hand Over */}
                            <div>
                                <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1.5">
                                    Tasks Being Handed Over ({handoverModal.tasks.length})
                                </label>
                                <div className="max-h-48 overflow-y-auto space-y-2 border border-slate-200 rounded-xl p-2.5 bg-slate-50/50 custom-scrollbar">
                                    {handoverModal.tasks.map(function(t, idx) {
                                        return (
                                            <div key={idx} className="bg-white rounded-lg p-2.5 border border-slate-200 text-xs shadow-2xs">
                                                <div className="flex items-center justify-between font-black text-slate-900">
                                                    <span>{t.name || t.equipmentName || 'Cleaning Task'}</span>
                                                    <span className="text-[10px] px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200">
                                                        {t.duration || t.standardMinutes || 30} mins
                                                    </span>
                                                </div>
                                                <div className="text-[11px] text-slate-500 font-bold mt-0.5">
                                                    Room: {t.room || t.originalArea || 'Active Room'} * Area: {t.areaName || t.area || 'Active Line'}
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>

                            {/* Target Next Shift Picker */}
                            <div className="grid grid-cols-2 gap-3">
                                <div>
                                    <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                        Outgoing Shift
                                    </label>
                                    <div className="px-3 py-2 bg-slate-100 rounded-lg text-xs font-black text-slate-700 border border-slate-200">
                                        Shift {handoverModal.outgoingCrew} Crew
                                    </div>
                                </div>
                                <div>
                                    <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                        Incoming Shift
                                    </label>
                                    <select
                                        value={handoverModal.incomingCrew}
                                        onChange={function(e) {
                                            setHandoverModal(Object.assign({}, handoverModal, { incomingCrew: e.target.value }));
                                        }}
                                        className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs font-bold text-slate-800 outline-none bg-white focus:border-amber-500"
                                    >
                                        <option value="B">Shift B Crew (Night)</option>
                                        <option value="C">Shift C Crew</option>
                                        <option value="D">Shift D Crew</option>
                                        <option value="A">Shift A Crew (Day)</option>
                                    </select>
                                </div>
                            </div>

                            {/* Handover Notes */}
                            <div>
                                <label className="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1">
                                    Supervisor Handover Notes <span className="font-normal text-slate-400 normal-case">(optional reason / obstacles)</span>
                                </label>
                                <textarea
                                    rows={2}
                                    value={handoverModal.notes || ''}
                                    onChange={function(e) {
                                        setHandoverModal(Object.assign({}, handoverModal, { notes: e.target.value }));
                                    }}
                                    placeholder="e.g. Line delayed due to late run. Priority washdown needed on infeed belts..."
                                    className="w-full border border-slate-300 rounded-xl p-2.5 text-xs font-medium text-slate-800 outline-none resize-none focus:border-amber-500"
                                />
                            </div>

                            <div className="flex items-center gap-3 pt-3 border-t border-slate-100">
                                <button
                                    type="button"
                                    onClick={function() { setHandoverModal(null); }}
                                    className="flex-1 py-2 px-3 rounded-lg border border-slate-300 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors cursor-pointer"
                                >
                                    Cancel
                                </button>
                                <button
                                    type="button"
                                    onClick={function() {
                                        const hoFacts = doneLogFacts('', null, Date.now());
                                        const newHandover = {
                                            id: gtKey('ho', [hubShiftDate(hoFacts.slotStart), handoverModal.outgoingCrew, handoverModal.incomingCrew], Date.now()),   // the _g_ Handover key
                                            timestamp: new Date().toISOString(),
                                            dateFormatted: new Date().toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }),
                                            outgoingCrew: handoverModal.outgoingCrew,
                                            incomingCrew: handoverModal.incomingCrew,
                                            count: handoverModal.tasks.length,
                                            taskIds: handoverModal.tasks.map(function(t) { return t.id; }),
                                            supervisor: supervisorName,
                                            notes: (handoverModal.notes || '').trim()
                                        };

                                        setHandoverRecords(function(prev) {
                                            const next = [newHandover].concat(prev);
                                            try { localStorage.setItem('ganttly_shift_handovers', JSON.stringify(next)); } catch (e) {}
                                            return next;
                                        });
                                        saveHandover(newHandover, handoverModal.tasks).then(function(res) { const say = gtSaveSay('handover', res); if (say) setPersonnelToast(say); });

                                        // Re-assign tasks to target shift crew
                                        handoverModal.tasks.forEach(function(t) {
                                            if (t.id) {
                                                setTaskStatus(function(prev) {
                                                    const existing = prev[t.id] || {};
                                                    return Object.assign({}, prev, {
                                                        [t.id]: Object.assign({}, existing, {
                                                            isHandover: true,
                                                            originShift: handoverModal.outgoingCrew,
                                                            targetShift: handoverModal.incomingCrew,
                                                            handoverAt: new Date().toISOString()
                                                        })
                                                    });
                                                });
                                            }
                                        });

                                        setPersonnelToast(handoverModal.tasks.length + ' unfulfilled tasks passed to Shift ' + handoverModal.incomingCrew);
                                        setHandoverModal(null);
                                    }}
                                    className="flex-1 py-2 px-3 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-black shadow-xs transition-colors cursor-pointer flex items-center justify-center gap-1.5"
                                >
                                    <span>Confirm &amp; Pass to Next Shift {'->'}</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* REAL-TIME PERSONNEL TOAST BANNER */}
            {personnelToast && (
                <div className="fixed bottom-5 right-5 z-[150] bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 flex items-center gap-3 animate-in slide-in-from-bottom-3 duration-200">
                    <div className="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-base flex-shrink-0">
                        <Check className="w-4 h-4" />
                    </div>
                    <div className="text-xs font-bold">
                        {personnelToast}
                    </div>
                    <button
                        type="button"
                        onClick={function() { setPersonnelToast(null); }}
                        className="text-slate-400 hover:text-white font-bold text-sm ml-2 cursor-pointer"
                    >
                        X
                    </button>
                </div>
            )}
        </div>
    );
}
