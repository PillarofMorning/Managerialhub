        this.windows = windows || [{ start: 0, end: Infinity }];
        this.schedule = []; 
        this.kind = 'general';
        this.isLead = false;
        this.isSupport = false;
        this.room = '';
        this.jobRole = '';
    }
    canDo(taskKindId, night, taskArea) {
        if (this.isLead) {
            return taskKindId === 'pic';
        }
        if (this.isSupport) {
            if (taskArea && !isSupportAreaName(taskArea)) return false;
            if (taskArea && isSupportAreaName(taskArea)) return true;
            if (this.kind === taskKindId) return true;
            return taskKindId !== 'general';
        }
        if (taskArea && isSupportAreaName(taskArea)) return false;
        return workerCanDo(this.kind, taskKindId, night);
    }
    windowAt(t) {
        return this.windows.find(function(w) { return t >= w.start && t < w.end; }) || null;
    }
    isOnShift(start, end) {
        return this.windows.some(function(w) { return start >= w.start && end <= w.end + 0.01; });
    }
    isFree(start, end) {
        return !this.schedule.some(slot => Math.max(start, slot.start) < Math.min(end, slot.end));
    }
    assign(start, end, taskId, areaName) {
        this.schedule.push({ start: start, end: end, taskId: taskId, area: areaName });
    }
