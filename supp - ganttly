                                                                let eMs = dayMs + (to.h * 60 + to.m) * 60000;
                                                                if (eMs <= sMs) eMs += 86400000;
                                                                const wStartMs = globalStartMs + w.start * 60000, wEndMs = globalStartMs + w.end * 60000;
                                                                if (eMs <= wStartMs) { sMs += 86400000; eMs += 86400000; }
                                                                const cs = Math.max(sMs, wStartMs), ce = Math.min(eMs, wEndMs);
                                                                if (ce <= cs) return null;
                                                                const sMin = (cs - globalStartMs) / 60000, eMin = (ce - globalStartMs) / 60000;
                                                                const tl = xOf(sMin), tw = Math.max(6, xEnd(eMin) - tl);
                                                                return (
                                                                    <div key={t.id} data-area-task={t.id} title={`${t.label || 'Task'} - ${clockLabelOf(t.from)} to ${clockLabelOf(t.to)}`} className="absolute z-10 rounded flex items-center px-1.5 overflow-hidden shadow-sm pointer-events-none" style={{ left: `${tl}px`, width: `${tw}px`, top: `${row * LANE_HEIGHT_PX + 6}px`, height: `${LANE_HEIGHT_PX - 12}px`, backgroundColor: barColor }}>
                                                                        {tw > 28 && <span className="text-white font-bold text-[10px] truncate leading-tight drop-shadow-sm">{t.label || 'Task'}</span>}
                                                                    </div>
                                                                );
                                                            })}
                                                        </React.Fragment>
                                                    );
                                                });
                                            })}

