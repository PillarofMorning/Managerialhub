                if (srcAsset && !isAllowedOnDailyClean(srcAsset, x.room)) return false;
                if (t.removed || removedGanttTasks[pid] || removedGanttTasks[t.id] || skippedTasks[pid] || skippedTasks[t.id]) return false;
