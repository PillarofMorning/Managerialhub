        return activeBreaks.concat(customInts).sort(function(a,b) { return a.start - b.start; });
    }, [activeBreaks, downtimes, ganttStartDate, ganttStartHour]);

    // Mutators
    const handleRoomHandoverChange = function(area, val) { setRoomHandovers(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomPriorityChange = function(area, val) { setRoomPriority(function(prev) { return Object.assign({}, prev, { [area]: Math.max(1, Math.min(50, Number(val)||1)) }); }); };
    const handleRoomCleanTogetherChange = function(area, val) { setRoomCleanTogether(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomAllergenChange = function(area, val) { setRoomAllergen(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };
    const handleRoomConfiguredChange = function(area, val) { setRoomConfigured(function(prev) { return Object.assign({}, prev, { [area]: val }); }); };

    // 🚨 ARCHITECTURE NOTE: Dynamic Room Caps
    // If a room limit is deleted/empty by the user, we explicitly delete the key from the state dictionary.
    // The engine treats a missing key as "no cap", so the room can use as many on-shift workers as are free
    // (still bounded by the largest crew in the plan window).
    const handleRoomLimitsChange = function(area, val) {
        setRoomLimits(function(prev) {
            const parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed <= 0) {
                const next = Object.assign({}, prev);
                delete next[area];
                return next;
            }
            return Object.assign({}, prev, { [area]: parsed });
        });
    };

    // Equipment edits are kept in `assetEdits` so they survive a reload of the Dataverse rows.
    const editAsset = function(assetId, patch) {
        setAssets(function(prev) { return prev.map(function(a) { return a.id === assetId ? Object.assign({}, a, patch) : a; }); });
        setAssetEdits(function(prev) { return Object.assign({}, prev, { [assetId]: Object.assign({}, prev[assetId] || {}, patch) }); });
    };
    const handleBaseMinsChange = function(assetId, val) { editAsset(assetId, { minutesRequired: Math.max(0, Number(val)||0) }); };
    const handleAllergenMinsChange = function(assetId, val) { editAsset(assetId, { allergenMins: Math.max(0, Number(val)||0) }); };
    const handleTaskHeadsChange = function(assetId, val) { editAsset(assetId, { heads: Math.max(1, Number(val)||1) }); };
    const handlePriorityChange = function(assetId, newPriority) { editAsset(assetId, { priority: Math.max(1, Math.min(50, Number(newPriority)||1)) }); };
    const handleToggleRoom = function(areaName) { setHiddenRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };
    const toggleDashboardRoom = function(areaName) { setCollapsedDashboardRooms(function(prev) { return Object.assign({}, prev, { [areaName]: !prev[areaName] }); }); };

    const openRoomDowntime = function(areaName) {
        setDtTarget(areaName);
        setNewDtLabel('');
        setNewDtDate(ganttStartDate);
        setNewDtTime('');
