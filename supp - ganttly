                                <span className="text-slate-500">Equipment: {dataDiag.assetCount} ({dataDiag.source}) · Shift table: {dataDiag.shiftRows} rows{shiftTableInfo ? ` (${shiftTableInfo.hourMode})` : ''}</span>
