        overflow.forEach(function(t) { wt += t.rawWorkloadMins; });
        const parentsHere = scheduleData.parents.filter(function(p) { return p.area === room; });
        return {
            room: room, start: start === Infinity ? 0 : start, end: end, manpowerMins: mp,
            pct: wt > 0 ? Math.round((wd / wt) * 100) : 0, late: late, overflow: overflow.length,
