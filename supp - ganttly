        setOverrides(function(prev) { const n = Object.assign({}, prev); delete n[taskId]; return n; });
    };

    // 🚨 ARCHITECTURE NOTE: CSV Exporter
    // One row per worker per block, in time order, plus overflow rows. Status column reflects check-offs.
    const handleExportExcel = () => {
        let csvContent = "Crew,Worker,Area,Task Name,Status,Start Time,End Time,Duration (Mins)\n";
        const allTasks = [];
        scheduleData.groups.forEach(function(g) {
            g.tasks.forEach(function(t) { allTasks.push(t); });
        });
        for (let i = 0; i < globalHeadcount; i++) {
            const wName = laneRoster[i].name.replace(/"/g, '""');
            const wCrew = laneRoster[i].crew;
            const workerTasks = allTasks.filter(function(t) { return t.assignedLanes && t.assignedLanes.indexOf(i) > -1; });
            workerTasks.sort(function(a,b) { return a.startMin - b.startMin; });
            workerTasks.forEach(function(t) {
                const sTime = formatClockTime(ganttStartDate, ganttStartHour, t.startMin);
                const eTime = formatClockTime(ganttStartDate, ganttStartHour, t.startMin + t.finalDuration);
                const tName = `"${t.name.replace(/"/g, '""')}"`;
                csvContent += `"${wCrew}","${wName}","${t.originalArea}",${tName},"${t.status}","${sTime}","${eTime}",${Math.round(t.finalDuration)}\n`;
            });
        }
        scheduleData.unscheduled.forEach(function(t) {
            csvContent += `"","UNSCHEDULED","${t.originalArea}","${t.name.replace(/"/g, '""')}","overflow","","",${Math.round(t.rawWorkloadMins)}\n`;
        });
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        const url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", `Schedule_Export_${ganttStartDate}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    // Default the shift pickers to the shift happening now (or the first one in the plan).
    const currentWindow = shiftWindows.find(function(w) { return nowMin >= w.start && nowMin < w.end; }) || null;
    const defaultShiftKey = currentWindow ? currentWindow.key : (shiftWindows[0] ? shiftWindows[0].key : '');
    const activeBoardKey = shiftWindows.some(function(w) { return w.key === boardShift; }) ? boardShift : defaultShiftKey;
    const ganttWindow = shiftWindows.find(function(w) { return w.key === ganttShift; }) || null;

    // Jump the Gantt to the selected shift.
    useEffect(function() {
        if (ganttWindow && scrollRef.current) scrollRef.current.scrollLeft = Math.max(0, (ganttWindow.start / 60) * zoomLevel - 40);
    }, [ganttShift, activeTab]);

    // ============================================================================
    // SECTION 6: DRAG AND DROP ENGINE
    // Dragging a block = manual move. Vertical movement picks the worker lane (within the visible crew when
    // a shift filter is on). Started / done blocks can be dragged too (corrects where the work happened).
    // ============================================================================
    const visibleLaneLo = ganttWindow ? (laneRoster.find(function(l) { return l.crew === ganttWindow.crew; }) || { lane: 0 }).lane : 0;
    const visibleLaneCount = ganttWindow ? laneRoster.filter(function(l) { return l.crew === ganttWindow.crew; }).length : globalHeadcount;

    useEffect(function() {
        const handlePointerMove = function(e) {
            if (isPanning && scrollRef.current) {
                if (e && typeof e.preventDefault === 'function') e.preventDefault();
                const walk = (e.clientX - panStartX) * 1.5;
                if (Math.abs(walk) > 5) setHasDragged(true);
                scrollRef.current.scrollLeft = panScrollLeft - walk;
            } else if (dragState) {
                if (e && typeof e.preventDefault === 'function') e.preventDefault();
                const deltaX = e.clientX - dragState.initialX;
                const deltaY = e.clientY - dragState.initialY;
                if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) { draggedRef.current = true; setHasDragged(true); }

                let newMin = dragState.initialMin + (deltaX / zoomLevel) * 60;
                newMin = Math.max(0, Math.round(newMin / 15) * 15);
                let newLane = dragState.initialLane + Math.round(deltaY / LANE_HEIGHT_PX);
                newLane = Math.max(visibleLaneLo, Math.min(newLane, visibleLaneLo + visibleLaneCount - dragState.appliedHeads));

                setDragState(function(prev) { return Object.assign({}, prev, { currentMin: newMin, currentLane: newLane }); });
            }
        };

        const handlePointerUp = function() {
            if (dragState) {
                if (draggedRef.current) {
                    const task = scheduleData.taskById[dragState.taskId];
                    if (task) moveBlock(task, dragState.currentMin, Array.from({ length: dragState.appliedHeads }, function(_, i) { return dragState.currentLane + i; }));
                }
                setDragState(null);
            }
            if (isPanning) setIsPanning(false);
        };

        if (dragState || isPanning) {
            window.addEventListener('pointermove', handlePointerMove, {passive: false});
            window.addEventListener('pointerup', handlePointerUp);
            window.addEventListener('pointercancel', handlePointerUp);
        }
        return function() {
            window.removeEventListener('pointermove', handlePointerMove);
            window.removeEventListener('pointerup', handlePointerUp);
            window.removeEventListener('pointercancel', handlePointerUp);
        };
    }, [dragState, isPanning, panStartX, panScrollLeft, zoomLevel, hasDragged, globalHeadcount, visibleLaneLo, visibleLaneCount, scheduleData]);

    const onPanDown = function(e) {
        if (e.target && typeof e.target.closest === 'function' && (e.target.closest('.gantt-block-anim') || e.target.closest('.no-pan') || e.target.closest('input') || e.target.closest('button') || e.target.closest('select'))) return;
        setIsPanning(true); setHasDragged(false); setPanStartX(e.clientX); setPanScrollLeft(scrollRef.current ? scrollRef.current.scrollLeft : 0);
        if (e.currentTarget && typeof e.currentTarget.setPointerCapture === 'function') e.currentTarget.setPointerCapture(e.pointerId);
    };

    if (isLoading) {
        return (
            <div className="min-h-screen bg-slate-50 flex flex-col items-center justify-center touch-pan">
                <Loader2 className="w-12 h-12 text-indigo-600 animate-spin mb-4" />
                <h2 className="text-xl font-bold text-slate-700">Loading Object-Oriented Intelligence Matrix...</h2>
            </div>
        );
    }

    // ============================================================================
    // SECTION 7: METRICS (one-stop shop: progress, ETA, manpower, cost)
    // ============================================================================
    const allBlocks = [];
    scheduleData.groups.forEach(function(g) { g.tasks.forEach(function(t) { allBlocks.push(t); }); });
    const metricsWorkers = scheduleData.workers;

    // Late = should have started by now but hasn't, or started and ran past its planned end.
    const isLate = function(t) {
        if (t.isComplete || nowMin < 0) return false;
        if (t.isInProgress) return t.startMin + t.finalDuration < nowMin;
        return t.startMin < nowMin - 5;
    };

    let globalMaxEnd = 0;
    let totalManpowerMins = 0, doneManpowerMins = 0, activeManpowerMins = 0;
    let workTotal = 0, workDone = 0;
    let countDone = 0, countStarted = 0, countPlanned = 0, countLate = 0, countConflict = 0;
    allBlocks.forEach(function(t) {
        const end = t.startMin + t.finalDuration;
        if (end > globalMaxEnd) globalMaxEnd = end;
        const mp = t.finalDuration * t.appliedHeads;
        totalManpowerMins += mp;
        workTotal += t.rawWorkloadMins;
        if (t.isComplete) { countDone++; doneManpowerMins += mp; workDone += t.rawWorkloadMins; }
        else if (t.isInProgress) { countStarted++; activeManpowerMins += mp; }
        else countPlanned++;
        if (isLate(t)) countLate++;
        if (t.hasConflict) countConflict++;
    });
    const unscheduledWorkMins = scheduleData.unscheduled.reduce(function(acc, t) { return acc + t.rawWorkloadMins; }, 0);
    workTotal += unscheduledWorkMins;
    const progressPct = workTotal > 0 ? Math.round((workDone / workTotal) * 100) : 0;
    const neededManpowerMins = totalManpowerMins + unscheduledWorkMins;
    const remainingManpowerMins = neededManpowerMins - doneManpowerMins;
    const handoverCount = allBlocks.filter(function(t) { return t.isSplitPart2 && !t.isFrozen; }).length;
    const etaSlackMins = planHorizonMins - globalMaxEnd;

    // Deep Metrics Calculation (overheads counted once per piece of equipment)
    let deepTransit = 0, deepInspect = 0, deepBreak = 0, deepDown = 0;
    scheduleData.parents.forEach(function(p) { deepTransit += p.transitMins; deepInspect += p.inspectMins; });

    // Breaks / downtime that land inside a worker's booked time (absorbed into their blocks).
    metricsWorkers.forEach(function(w) {
        w.schedule.forEach(function(slot) {
            allInterrupts.forEach(function(b) {
                const oStart = Math.max(slot.start, b.start);
                const oEnd = Math.min(slot.end, b.end);
                if (oEnd > oStart) {
                    if (b.isCustom) deepDown += (oEnd - oStart);
                    else deepBreak += (oEnd - oStart);
                }
            });
        });
    });

    // Per-worker workload.
    const workerStats = laneRoster.map(function(l) {
        const w = metricsWorkers[l.lane];
        let availMins = 0, bookedMins = 0, doneMins = 0, tasks = 0, done = 0, late = 0;
        l.windows.forEach(function(win) { availMins += (win.end - win.start); });
        (w ? w.schedule : []).forEach(function(s) {
            const t = scheduleData.taskById[s.taskId];
            bookedMins += (s.end - s.start);
            tasks++;
            if (t && t.isComplete) { done++; doneMins += (s.end - s.start); }
            if (t && isLate(t)) late++;
        });
        return { lane: l.lane, crew: l.crew, name: l.name, isPlaceholder: l.isPlaceholder, availMins: availMins, bookedMins: bookedMins, doneMins: doneMins, tasks: tasks, done: done, late: late };
    });

    // Per-crew utilization inside the plan window.
    const crewStats = [];
    workerStats.forEach(function(ws) {
        let cs = crewStats.find(function(c) { return c.crew === ws.crew; });
        if (!cs) {
            cs = { crew: ws.crew, heads: 0, availMins: 0, bookedMins: 0, doneMins: 0, shifts: shiftWindows.filter(function(w) { return w.crew === ws.crew; }) };
            crewStats.push(cs);
        }
        cs.heads += 1;
        cs.availMins += ws.availMins;
        cs.bookedMins += ws.bookedMins;
        cs.doneMins += ws.doneMins;
    });
    const payrollMins = crewStats.reduce(function(acc, c) { return acc + c.availMins; }, 0);
    const bookedMinsTotal = crewStats.reduce(function(acc, c) { return acc + c.bookedMins; }, 0);
    const money = function(mins) { return '$' + ((mins / 60) * hourlyRate).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); };

    // Per-room rollup.
    const roomStats = activeRooms.map(function(room) {
        const g = scheduleData.groups.find(function(x) { return x.name === room; });
        const blocks = g ? g.tasks : [];
        let start = Infinity, end = 0, mp = 0, wt = 0, wd = 0, late = 0;
        blocks.forEach(function(t) {
            start = Math.min(start, t.startMin);
            end = Math.max(end, t.startMin + t.finalDuration);
            mp += t.finalDuration * t.appliedHeads;
            wt += t.rawWorkloadMins;
            if (t.isComplete) wd += t.rawWorkloadMins;
            if (isLate(t)) late++;
        });
        const overflow = scheduleData.unscheduled.filter(function(t) { return t.originalArea === room; });
        overflow.forEach(function(t) { wt += t.rawWorkloadMins; });
        const parentsHere = scheduleData.parents.filter(function(p) { return p.area === room; });
        return {
            room: room, start: start === Infinity ? 0 : start, end: end, manpowerMins: mp,
            pct: wt > 0 ? Math.round((wd / wt) * 100) : 0, late: late, overflow: overflow.length,
            equipCount: parentsHere.length,
            equipDone: parentsHere.filter(function(p) { return p.blocks.length > 0 && p.unscheduledWork === 0 && p.blocks.every(function(b) { return b.isComplete; }); }).length
        };
    });

    const dynamicTotalHours = Math.max(Math.ceil(planHorizonMins / 60), Math.ceil(globalMaxEnd / 60)) + 2;
    const GANTT_TOTAL_WIDTH_PX = dynamicTotalHours * zoomLevel;
    const hourStep = zoomLevel < 25 ? 4 : 2;
    const TIME_MARKERS = Array.from({ length: Math.ceil(dynamicTotalHours / hourStep) + 1 }, function(_, i) { return i * hourStep; });

    const activeEditorTask = selectedTaskEditor ? scheduleData.taskById[selectedTaskEditor] || null : null;

    const displayData = activeTab === 'focus' && focusRoom ? scheduleData.groups.filter(function(g) { return g.name === focusRoom; }) : scheduleData.groups;

    // Grey "off shift" bands per lane (time outside that worker's crew windows).
    const ganttTotalMins = dynamicTotalHours * 60;
    const laneOffShift = laneRoster.map(function(l) {
        const gaps = [];
        let cursor = 0;
        l.windows.forEach(function(w) {
            if (w.start > cursor) gaps.push({ start: cursor, end: w.start });
            cursor = Math.max(cursor, w.end);
        });
        if (cursor < ganttTotalMins) gaps.push({ start: cursor, end: ganttTotalMins });
        return gaps;
    });
    // First lane index of each crew block, for the crew divider lines.
    const crewBlocks = [];
    laneRoster.forEach(function(l) {
        const last = crewBlocks[crewBlocks.length - 1];
        if (!last || last.crew !== l.crew) crewBlocks.push({ crew: l.crew, firstLane: l.lane, count: 1 });
        else last.count += 1;
    });
    const visibleLanes = laneRoster.slice(visibleLaneLo, visibleLaneLo + visibleLaneCount);

    const liveLeftPx = (nowMin / 60) * zoomLevel;

    const statusChip = function(t) {
        if (t.isComplete) return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-emerald-100 text-emerald-800 border border-emerald-200">DONE</span>;
        if (t.isInProgress) return <span className={`text-[10px] font-black rounded px-1.5 py-0.5 border ${isLate(t) ? 'bg-rose-100 text-rose-800 border-rose-200' : 'bg-sky-100 text-sky-800 border-sky-200'}`}>{isLate(t) ? 'OVERRUN' : 'IN PROGRESS'}</span>;
        if (isLate(t)) return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-rose-100 text-rose-800 border border-rose-200">LATE</span>;
        return <span className="text-[10px] font-black rounded px-1.5 py-0.5 bg-slate-100 text-slate-600 border border-slate-200">PLANNED</span>;
    };
    const timeRange = function(t) {
        return formatClockTime(ganttStartDate, ganttStartHour, t.startMin) + ' – ' + formatClockTime(ganttStartDate, ganttStartHour, t.startMin + t.finalDuration).replace(/^\S+ /, '');
    };
    const tabBtn = function(id, label, Icon) {
        return (
            <button key={id} onClick={function() { setActiveTab(id); }} className={`px-4 py-1.5 text-sm font-bold rounded-md flex items-center gap-2 transition-colors ${activeTab === id ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-400 hover:text-white hover:bg-slate-700'}`}>
                <Icon className="w-4 h-4" /> {label}
            </button>
        );
    };

    return (
        <div className="min-h-screen bg-slate-100 font-sans text-gray-900 flex flex-col h-screen overflow-hidden select-none print-expand">

            <header className="bg-slate-900 border-b border-slate-800 shadow-sm flex-shrink-0 z-20 no-print">
                <div className="max-w-[1900px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
                    <div className="flex items-center gap-3">
                        <div className="bg-indigo-600 p-2 rounded-lg shadow-sm"><Layers className="w-6 h-6 text-white" /></div>
                        <div>
                            <h1 className="text-xl font-bold text-white leading-tight tracking-wide flex items-center gap-3">
                                Intelligent Tandem Planner
                            </h1>
                            <p className="text-[11px] font-bold text-slate-400">{formatClockTime(ganttStartDate, ganttStartHour, 0)} → {formatClockTime(ganttStartDate, ganttStartHour, planHorizonMins)} · {globalHeadcount} people · {progressPct}% done</p>
                        </div>
                    </div>

                    <div className="flex bg-slate-800 p-1 rounded-lg border border-slate-700 shadow-inner">
                        {tabBtn('setup', 'Setup', Wrench)}
                        {tabBtn('equipment', 'Dashboard', LayoutDashboard)}
                        {tabBtn('gantt', 'Gantt', GanttChartIcon)}
                        {tabBtn('board', 'Crew Board', ClipboardList)}
                        {tabBtn('focus', 'Focus Mode', Target)}
                        {tabBtn('metrics', 'Metrics', BarChart2)}
                    </div>
                </div>
            </header>

            {/* 🚨 ARCHITECTURE NOTE: Fixed Canvas Scrolling
                Replaced 'overflow-hidden flex-col items-center' with 
                'flex-1 flex flex-col items-center min-h-0 overflow-y-auto' 
                to explicitly prevent flexbox clipping at the bottom of the container. 
            */}
            {/* SETUP TAB */}
            {activeTab === 'setup' && (
                <div className="flex-1 flex flex-col items-center bg-slate-100 p-4 md:p-6 touch-pan overflow-y-auto custom-scrollbar">
                    
                    <div className="w-full max-w-5xl flex flex-col h-full gap-6 pb-24">
                        
                        {/* GLOBAL MASTER CONFIGURATION */}
                        <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex-shrink-0">
                            <div className="bg-indigo-50 border-b border-indigo-100 px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                <h2 className="font-black text-indigo-900 uppercase tracking-widest text-sm flex items-center">
                                    <SettingsIcon className="w-5 h-5 mr-2" /> Planning Window
                                </h2>
                                <label className="flex items-center gap-2 cursor-pointer bg-white px-3 py-1.5 rounded-lg border border-indigo-200 shadow-sm transition-colors hover:bg-indigo-50">
                                    <input type="checkbox" checked={hideConfiguredRooms} onChange={function(e) { setHideConfiguredRooms(e.target.checked); }} className="w-4 h-4 accent-indigo-600 cursor-pointer" />
                                    <span className="text-[11px] font-bold text-slate-700 uppercase tracking-wider cursor-pointer">Hide 'Ready' Rooms</span>
                                </label>
                            </div>
                            <div className="p-6 grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
                                <div>
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Plan Start Date</label>
                                    <input type="date" value={ganttStartDate} onChange={function(e) { setGanttStartDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none no-pan" />
                                </div>
                                <div>
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Plan Start Hour</label>
                                    <div className="flex items-center">
                                        <input type="number" min="0" max="23" value={ganttStartHour} onChange={function(e) { setGanttStartHour(Math.max(0, Math.min(23, Number(e.target.value)||0))); }} className="w-full border border-slate-300 rounded-l p-2 text-sm font-bold outline-none no-pan text-center" />
                                        <span className="bg-slate-100 border-y border-r border-slate-300 rounded-r px-3 py-2 text-sm font-bold text-slate-500">:00</span>
                                    </div>
                                </div>
                                <div>
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Plan Length (Hours)</label>
                                    <input type="number" min="1" max="336" value={planHours} onChange={function(e) { setPlanHours(Math.max(1, Math.min(336, Number(e.target.value)||12))); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none no-pan text-center" />
                                </div>
                                <div>
                                    <label className="block text-[10px] font-black text-indigo-500 uppercase tracking-widest mb-1.5">Workforce In Window</label>
                                    <div className="w-full border-2 border-indigo-400 bg-indigo-50 text-indigo-900 rounded p-2 text-sm font-black text-center" title="Sum of every crew's headcount that works inside the plan window">{globalHeadcount} people · {shiftWindows.length} shifts</div>
                                </div>
                            </div>
                            <div className="px-6 pb-5 flex flex-wrap items-center gap-2">
                                <span className="text-[10px] font-black text-slate-500 uppercase tracking-widest mr-1">Presets:</span>
                                <Button variant="outline" size="sm" onClick={function() { applyPlanPreset('shift'); }}>Single Shift (12h)</Button>
                                <Button variant="outline" size="sm" onClick={function() { applyPlanPreset('weekend'); }}>Weekend (Fri 6PM → Mon 6AM)</Button>
                                <Button variant="outline" size="sm" onClick={function() { applyPlanPreset('week'); }}>Full Rotation (7 days)</Button>
                                <span className="text-xs font-bold text-slate-500 ml-auto">
                                    {formatClockTime(ganttStartDate, ganttStartHour, 0)} → {formatClockTime(ganttStartDate, ganttStartHour, planHorizonMins)}
                                </span>
                            </div>
                        </div>

                        {/* CREW ROTATION & HEADCOUNT */}
                        <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex-shrink-0">
                            <div className="bg-slate-50 border-b border-gray-200 px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                                <h2 className="font-black text-slate-800 uppercase tracking-widest text-sm flex items-center">
                                    <Users className="w-5 h-5 mr-2 text-indigo-500" /> Crew Rotation & Headcount
                                    <span className="ml-3 text-[10px] font-bold normal-case tracking-normal text-slate-500 bg-white border border-slate-200 rounded px-2 py-0.5">Rotation: {rotationSource}</span>
                                </h2>
                                <div className="flex items-center gap-3">
                                    <div className="flex items-center gap-2 bg-white px-2 py-1.5 rounded border border-slate-200 shadow-sm" title="Extra minutes per head added to the continuation when a task is handed to the next crew">
                                        <span className="text-[10px] font-black text-slate-500 uppercase">Handover Overhead:</span>
                                        <input type="number" min="0" value={handoverMins} onChange={function(e) { setHandoverMins(Math.max(0, Number(e.target.value)||0)); }} className="w-12 text-center font-bold text-xs outline-none border-b border-slate-200 no-pan" />
                                        <span className="text-[10px] font-bold text-slate-400">min</span>
                                    </div>
                                    <Button variant="outline" size="sm" onClick={resetRotation}><RefreshCw className="w-3.5 h-3.5 mr-1" /> Reset Rotation</Button>
                                </div>
                            </div>
                            {/* DATA CHECK — shows exactly what came back from Dataverse so missing names are easy to diagnose */}
                            <div className={`px-6 py-3 border-b text-xs font-bold flex flex-wrap items-center gap-x-4 gap-y-1 ${rawEmployees.length === 0 || rosterInfo.unmatched.length > 0 ? 'bg-amber-50 border-amber-200 text-amber-900' : 'bg-emerald-50 border-emerald-200 text-emerald-900'}`}>
                                {rawEmployees.length === 0 ? (
                                    <span><AlertCircle className="w-3.5 h-3.5 inline mr-1" /> No employee rows came back from Dataverse (tried craa5__aa_employee and craa5_aa_employee). Lanes use placeholder seats until the table loads.</span>
                                ) : (
                                    <span><CheckCircle className="w-3.5 h-3.5 inline mr-1" /> {rawEmployees.length} employees loaded from {dataDiag.employeeTable} · A {crewRosters.A.length} · B {crewRosters.B.length} · C {crewRosters.C.length} · D {crewRosters.D.length} · <span title={rosterInfo.excluded.join(', ')} className="underline decoration-dotted">{rosterInfo.excluded.length} leads/supervisors/managers excluded</span> · <span title={rosterInfo.roleExcluded.join(', ')} className="underline decoration-dotted">{rosterInfo.roleExcluded.length} non-cleaning roles excluded</span>{rosterInfo.inactive.length > 0 && <span> · <span title={rosterInfo.inactive.join(', ')} className="underline decoration-dotted text-slate-500">{rosterInfo.inactive.length} blank-shift (left company) ignored</span></span>}{rosterInfo.unmatched.length > 0 ? ` · ${rosterInfo.unmatched.length} with an unreadable shift` : ''}</span>
