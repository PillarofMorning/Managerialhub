                });

                const handleLogObstacle = function() {
                    if (!obstacleText.trim()) { setPersonnelToast(tr("Describe the obstacle first.", "Describa el obstaculo primero.")); return; }
                    
                    let targetObj = obstacleSelectedTarget;
                    if (!targetObj) {
                        if (obstacleScope === 'global') {
                            targetObj = { id: 'GLOBAL', name: 'Plant-wide / Global Shift', area: 'Global', type: 'global' };
