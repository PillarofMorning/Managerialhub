        const pt = function(r, deg) { const rad = (deg - 90) * Math.PI / 180; return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) }; };
        const arcPath = function(r, s, e) {
            const d0 = todayDeg(s), sweep = Math.min(359.8, Math.max(0.8, ((e - s) / 86400000) * 360));
            const a = pt(r, d0), z = pt(r, d0 + sweep);
