        if (!IS_CURRENT || !board) return out;
        board.rows.filter(function(x) { return x.status === 'LATE'; }).forEach(function(x) {
            out.push({ key: 'late-' + x.room, kind: 'late', tone: 'red', text: x.room + (x.wontFit ? ": " + fmtMins(x.uWork) + " won't fit before startup" : ' late for ' + x.gateLabel + ' by ' + fmtMins(-x.spare)), onClick: function() { openBoardRoom(x.room); } });
        });
        allBlocks.filter(function(t) { return t.overrunFrom !== undefined && t.overrunFrom !== null && t.overrunFrom < nowMin && !t.isComplete; }).sort(function(a, b) { return a.overrunFrom - b.overrunFrom; }).forEach(function(t) {
            const who = (t.assignedLanes || []).map(function(i) { return laneRoster[i] ? laneRoster[i].name : ''; }).filter(Boolean);
            out.push({ key: 'over-' + t.id, kind: 'overrun', tone: 'red', text: (t.baseName || t.name) + ' - ' + t.originalArea + (who.length ? ' - ' + who[0] + (who.length > 1 ? ' +' + (who.length - 1) : '') : '') + ' - +' + fmtMins(nowMin - t.overrunFrom) + ' over plan',
                onClick: function() {
                    setGanttShift('');
                    setTimeout(function() { const el = document.querySelector('[data-task="' + t.id + '"]'); if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' }); }, 60);
                } });
        });
        board.rows.filter(function(x) { return x.setStartupLine; }).forEach(function(x) {
            out.push({ key: 'nostart-' + x.room, kind: 'nostartup', tone: 'grey', text: x.room + ': startup not entered', title: 'The down line has no restart time, so the Startup board cannot judge this room. Click to enter it.', onClick: function() { openDownModal(x.setStartupLine); } });
        });
        if (openNow.mins >= IDLE_SHOW_MINS && currentWindow) out.push({ key: 'open', kind: 'open', tone: 'yellow', mins: Math.round(openNow.mins), text: fmtMins(openNow.mins) + ' open on ' + currentWindow.crew + ' shift (' + openNow.people + ' ' + (openNow.people === 1 ? 'person' : 'people') + ')', title: 'Time on shift from now to the end of this shift with no cleaning that fits, outlined in yellow. Click to show this shift only.', onClick: function() { setGanttShift(currentWindow.key); } });
        const scrollToTask = function(id) { setGanttShift(''); setTimeout(function() { const el = document.querySelector('[data-task="' + id + '"]'); if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' }); }, 60); };
        const firstConflict = allBlocks.filter(function(t) { return t.hasConflict; }).sort(function(a, b) { return a.startMin - b.startMin; })[0];
        if (countConflict > 0) out.push({ key: 'conflict', kind: 'conflict', tone: 'yellow', text: countConflict + ' double-booked block' + (countConflict === 1 ? '' : 's'), title: 'Two blocks on one person at the same time. Click to go to the first one.', onClick: function() { if (firstConflict) scrollToTask(firstConflict.id); } });
        // Cleans that don't fit in the view, in any room not already listed above as late (production or support).
        const lateWontFit = {};
        board.rows.forEach(function(x) { if (x.status === 'LATE' && x.wontFit) lateWontFit[x.room] = true; });
        const over = scheduleData.unscheduled.filter(function(t) { return !lateWontFit[String(t.originalArea)]; });
        const overRooms = over.map(function(t) { return String(t.originalArea); }).filter(function(r, i, a) { return a.indexOf(r) === i; });
        if (over.length) out.push({ key: 'overflow', kind: 'overflow', tone: 'grey', text: over.length + ' clean' + (over.length === 1 ? '' : 's') + " don't fit in view (" + overRooms.slice(0, 2).join(', ') + (overRooms.length > 2 ? ' +' + (overRooms.length - 2) : '') + ')', title: overRooms.join(', ') + "\nNo one on these shifts has time for them. Click to open the first room.", onClick: function() { openBoardRoom(overRooms[0]); } });
        downLineList.forEach(function(d) {
            out.push({ key: 'down-' + d.id, kind: 'down', tone: 'down', text: d.line + ' down ' + whenOf(d.startStr) + ' -> ' + (d.endStr ? whenOf(d.endStr) : 'not known yet'), title: 'Down line: change or remove', onClick: function() { openDownModal(d); } });
        });
        return out;
    })();
    // PBED's plan summary strip: what the people shown are doing, in hours (this shift only when one is picked).
    const calmStats = (function() {
        const out = { people: 0, equipMins: 0, dutyMins: 0 };
        const lo = ganttWindow ? ganttWindow.start : 0, hi = ganttWindow ? ganttWindow.end : Infinity;
        visibleLanes.forEach(function(l) {
            if (l.isLead) return;
            out.people++;
            const w = scheduleData.workers[l.lane];
            if (w) w.schedule.forEach(function(x) { const a = Math.max(x.start, lo), b = Math.min(x.end, hi); if (b > a) out.equipMins += b - a; });
            out.dutyMins += dutyWithin(l.lane, lo, hi);
        });
        return out;
    })();
    // Lines picked in Shift Start that no equipment area is named after (so their rooms can't be shown).
    const shiftStartNoEquipLines = shiftStartLines ? lineIndex.filter(function(l) { return shiftStartLines[l.id] && !(lineAssets[l.id] || []).length; }).map(function(l) { return l.name; }) : [];

    const liveLeftPx = xOf(nowMin);

    // One name card (the left column of the Gantt, and each interruption on the one-line view). `st` = the person's numbers for the
    // stretch shown; `o.mark` = this is an interruption's copy, so it carries no data-lane (the left column's cards keep them).
    const renderLaneCard = function(l, st, o) {
        const gc = l.groupIdx >= 0 ? TEAM_COLORS[l.groupIdx % TEAM_COLORS.length] : null;
        const isSupWorker = IS_CURRENT && !l.isLead && isSupportWorker(l);
        const supColor = isSupWorker ? supportWorkerColor(l) : null;
        const supLabel = isSupWorker ? supportWorkerLabel(l) : null;
        const ac = !IS_CURRENT || l.isLead ? null : isAreaRoleKind(l.kind) ? areaColorOf(l.kind) : null;   // an area role carries the area's colour
        const acTasks = ac ? areaTasksOf(l.kind) : [];
        const isMember = !l.isLead && !!l.leadKey;
        const pct = st.availMins > 0 ? Math.round((st.bookedMins / st.availMins) * 100) : 0;
        const teamTxt = l.isLead ? (st.tasks ? st.tasks + ' task' + (st.tasks === 1 ? '' : 's') + ' - ' : '') + (l.teamNames.length ? 'Team of ' + l.teamNames.length + ' - ' + l.teamNames.join(', ') : 'No team assigned') : '';
