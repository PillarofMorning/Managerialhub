// 🚨 ARCHITECTURE NOTE: Absolute Time vs. Relative Offsets
// Originally, the app saved room handovers as relative offsets (e.g., "+180 mins").
// We abandoned this because dragging the Global Start Date would ruin the timeline.
// All functions here now strictly utilize absolute Datetimes converted dynamically 
// into minutes-from-viewport-start to build the array coordinates.
// ============================================================================
function getLocalYMD(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}

// Accepts choice values (256000000..3), ints 1-4, and labels like "A", "A Shift", "Shift C", "D - Nights".
function normalizeShift(val) {
    if (val === undefined || val === null || val === "") return "";
    const s = String(typeof val === 'object' ? (val.Label || val.Value || val.name || '') : val).toUpperCase().trim();
    if (s.indexOf("256000000") > -1 || s === "1") return "A";
    if (s.indexOf("256000001") > -1 || s === "2") return "B";
    if (s.indexOf("256000002") > -1 || s === "3") return "C";
    if (s.indexOf("256000003") > -1 || s === "4") return "D";
    const m = s.match(/(?:^|[^A-Z])([ABCD])(?=$|[^A-Z])/);
    return m ? m[1] : "";
}

// Employee shift can live under several column spellings / formatted values depending on the API used.
function readEmployeeShift(e) {
    const FMT = '@OData.Community.Display.V1.FormattedValue';
    const candidates = [e.craa5_shift, e.craa5_Shift, e['craa5_shift' + FMT], e['craa5_Shift' + FMT], e.craa5_shiftcode, e.craa5_crew];
    Object.keys(e).forEach(function(k) { if (/shift|crew/i.test(k) && candidates.indexOf(e[k]) === -1) candidates.push(e[k]); });
    for (let i = 0; i < candidates.length; i++) {
        const c = normalizeShift(candidates[i]);
        if (c) return { crew: c, raw: candidates[i] };
    }
    const firstRaw = candidates.find(function(c) { return c !== undefined && c !== null && c !== ''; });
    return { crew: '', raw: firstRaw === undefined ? '(blank)' : firstRaw };
}

// Job role from the _aa_Role lookup (craa5_RoleID). Lookups come back as _craa5_roleid_value + a formatted name,
// or as an object / plain text depending on the API, so try each shape.
function readEmployeeJobRole(e) {
    const FMT = '@OData.Community.Display.V1.FormattedValue';
    const direct = e['_craa5_roleid_value' + FMT] || e['_craa5_RoleID_value' + FMT];
    if (direct) return String(direct).trim();
    const key = Object.keys(e).find(function(k) { return /roleid/i.test(k) && k.indexOf(FMT) > -1; });
    if (key && e[key]) return String(e[key]).trim();
    const obj = e.craa5_roleid || e.craa5_RoleID;
    if (obj && typeof obj === 'object') return String(obj.name || obj.Name || obj.craa5_name || obj.primaryName || '').trim();
    if (typeof obj === 'string' && !/^[0-9a-f-]{36}$/i.test(obj)) return obj.trim();
    return '';
}

function jobRoleKey(role) { return String(role || '').trim().toLowerCase().replace(/\s+/g, ' '); }

// ============================================================================
// ROLE ROUTING
// 🚨 ARCHITECTURE NOTE: what each job role (_aa_Role) may be assigned
//   general    Sanitation Tech 1 / 2   regular cleaning, plus PIC items
//   pic        Sanitation Tech 3       only assets whose Subcategory is "1 - pic"
//   inspector  Inspector               PIC items, and on nights also the chemical area (no clerk then)
//   chemical   Chemical Clerk          only assets in area "chemical"
//   admin      Sanitation Admin        only assets in area "admin"
//   janitorial Janitorial              only janitorial tasks
//   none       anyone else (including people with no role)   no tasks
// Setup lets each role be switched to any of these; the defaults below apply until it is.
// ============================================================================
const WORK_KINDS = [
    { id: 'general', label: 'Regular cleaning + PIC' },
    { id: 'pic', label: 'PIC items only' },
    { id: 'inspector', label: 'PIC + chemical on nights' },
    { id: 'chemical', label: 'Chemical area' },
    { id: 'admin', label: 'Admin area' },
    { id: 'janitorial', label: 'Janitorial tasks' },
    { id: 'none', label: 'No tasks' }
];
const WORK_KIND_SHORT = { general: '', pic: 'PIC', inspector: 'PIC', chemical: 'Chem', admin: 'Admin', janitorial: 'Jan', none: '' };
const NIGHT_START_HOUR = 18;
const NIGHT_END_HOUR = 6;
function defaultWorkKind(roleKey) {
    const k = String(roleKey || '');
    if (/chem\w*\s*clerk/.test(k)) return 'chemical';
    if (/admin/.test(k)) return 'admin';
    if (/janitor/.test(k)) return 'janitorial';
    if (/inspect/.test(k)) return 'inspector';
    const m = k.match(/tech\w*\s*([0-9]+)/);
    if (m) return m[1] === '1' || m[1] === '2' ? 'general' : (m[1] === '3' ? 'pic' : 'none');
    return 'none';
}
// Which kind of work an asset is. Area "chemical" and "admin" decide first; then Subcategory "1 - pic"; then janitorial by name.
function taskKind(a) {
    const area = String((a && a.area) || '').trim().toLowerCase();
    if (area === 'chemical') return 'chemical';
    if (area === 'admin') return 'admin';
    const sub = String((a && a.subcategory) || '');
    if (/^\s*1\b/.test(sub) || /\bpic\b/i.test(sub)) return 'pic';
    const hay = [a && a.subcategory, a && a.area, a && a.room, a && a.name].join(' ');
    if (/janitor/i.test(hay)) return 'janitorial';
    return 'general';
}
// `night` = the block starts between 6 PM and 6 AM. Pass true to ask "could this person ever do it?".
function workerCanDo(workKind, taskKindId, night) {
    const wk = workKind || 'general';
    if (wk === 'none') return false;
    if (wk === 'general') return taskKindId === 'general' || taskKindId === 'pic';
    if (wk === 'inspector') return taskKindId === 'pic' || (taskKindId === 'chemical' && !!night);
    return wk === taskKindId;
}
function isNightHour(hour) { return hour >= NIGHT_START_HOUR || hour < NIGHT_END_HOUR; }

// "Doe, John" -> "John Doe" (same convention as the Manager hub)
function formatFullName(name) {
    const parsed = String(name || '').trim();
    if (!parsed) return '';
    const parts = parsed.split(',');
    if (parts.length > 1) return parts.slice(1).join(',').trim() + ' ' + parts[0].trim();
    return parsed;
}

function simpleHash(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = ((h << 5) - h + str.charCodeAt(i)) | 0;
    return Math.abs(h).toString(36);
}

// ============================================================================
// SHIFT ROTATION
// 🚨 ARCHITECTURE NOTE: Shift Slots (4 crews, split Wednesday)
// A rotation is a list of slots: { crew, day, startHour, lengthHours }. `day` is the calendar day the slot
// STARTS (JS getDay(): 0 = Sun ... 6 = Sat). Default mirrors the plant pattern:
//   A: Sun–Tue 6a–6p, Wed 6a–12p          B: Wed 12p–6p, Thu–Sat 6a–6p
//   C: Sun–Tue 6p–6a, Wed 6p–12a          D: Wed night 12a–6a (Thu morning), Thu–Sat 6p–6a
// The craa5_workshift table (one row per slot) replaces this on load; Setup can also edit it.
// ============================================================================
const CREW_CODES = ['A', 'B', 'C', 'D'];
const DAY_LETTERS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const DAY_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
