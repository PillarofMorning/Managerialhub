// 🚨 ARCHITECTURE NOTE: Absolute Time vs. Relative Offsets
// Originally, the app saved room handovers as relative offsets (e.g., "+180 mins").
// We abandoned this because dragging the Global Start Date would ruin the timeline.
// All functions here now strictly utilize absolute Datetimes converted dynamically 
// into minutes-from-viewport-start to build the array coordinates.
// ============================================================================
function getLocalYMD(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}

function normalizeShift(val) {
    let s = "";
    if (val !== undefined && val !== null && val !== "") {
        s = String(val.Label || val.Value || val.name || val || "").toUpperCase().trim();
    }
    if (s.indexOf("256000000") > -1 || s === "A" || s === "1") return "A";
    if (s.indexOf("256000001") > -1 || s === "B" || s === "2") return "B";
    if (s.indexOf("256000002") > -1 || s === "C" || s === "3") return "C";
    if (s.indexOf("256000003") > -1 || s === "D" || s === "4") return "D";
    return "";
}

// ============================================================================
// SHIFT ROTATION
// 🚨 ARCHITECTURE NOTE: 4-Crew 12h Rotation
// `days` uses JS getDay() numbering (0 = Sun ... 6 = Sat) and is the day the shift STARTS.
//   C: Wed–Sat 6a–6p        D: Wed–Sat 6p–6a (last D shift ends Sunday 6a)
//   A: Sun–Tue 6a–6p        B: Sun–Tue 6p–6a (last B shift ends Wednesday 6a)
// If the craa5_workshift table has rows, they replace this default on first load.
// Users can also edit days/hours per crew on the Setup tab (saved to local storage).
// ============================================================================
const CREW_CODES = ['A', 'B', 'C', 'D'];
const DAY_LETTERS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const DAY_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const FALLBACK_CREW_SIZE = 8;
const MIN_SPLIT_MINS = 60;
const DEFAULT_SHIFT_ROTATION = {
    A: { days: [0, 1, 2], startHour: 6, lengthHours: 12 },
    B: { days: [0, 1, 2], startHour: 18, lengthHours: 12 },
    C: { days: [3, 4, 5, 6], startHour: 6, lengthHours: 12 },
    D: { days: [3, 4, 5, 6], startHour: 18, lengthHours: 12 }
};
const CREW_STYLES = {
    A: { badge: 'bg-sky-600 text-white', soft: 'bg-sky-50 border-sky-200 text-sky-900', line: 'border-sky-500' },
    B: { badge: 'bg-indigo-700 text-white', soft: 'bg-indigo-50 border-indigo-200 text-indigo-900', line: 'border-indigo-600' },
    C: { badge: 'bg-amber-500 text-white', soft: 'bg-amber-50 border-amber-200 text-amber-900', line: 'border-amber-500' },
    D: { badge: 'bg-violet-700 text-white', soft: 'bg-violet-50 border-violet-200 text-violet-900', line: 'border-violet-600' }
};

function getCrewStyle(crew) {
    return CREW_STYLES[crew] || { badge: 'bg-slate-500 text-white', soft: 'bg-slate-50 border-slate-200 text-slate-800', line: 'border-slate-400' };
}

function getRowField(row, name) {
    if (!row) return undefined;
    const fmt = row[name + '@OData.Community.Display.V1.FormattedValue'];
    if (fmt !== undefined) return fmt;
    if (row[name] !== undefined) return row[name];
    const lower = name.toLowerCase();
    const key = Object.keys(row).find(function(k) { return k.toLowerCase() === lower; });
    return key ? row[key] : undefined;
}

// craa5_workshift rows: craa5_shiftcode, craa5_daynumber (1 = Sun ... 7 = Sat), craa5_shiftstarthour, craa5_shiftendhour
function buildRotationFromWorkShifts(rows) {
    if (!rows || rows.length === 0) return null;
    const rotation = {};
    rows.forEach(function(r) {
        const crew = normalizeShift(getRowField(r, 'craa5_shiftcode'));
        const dayNum = parseInt(r.craa5_daynumber, 10);
        const startH = parseInt(r.craa5_shiftstarthour, 10);
        const endH = parseInt(r.craa5_shiftendhour, 10);
        if (!crew || isNaN(dayNum) || isNaN(startH) || isNaN(endH)) return;
        if (!rotation[crew]) rotation[crew] = { days: [], startHour: startH, lengthHours: ((endH - startH + 24) % 24) || 24 };
        const jsDay = ((dayNum - 1) % 7 + 7) % 7;
        if (rotation[crew].days.indexOf(jsDay) === -1) rotation[crew].days.push(jsDay);
    });
    if (Object.keys(rotation).length === 0) return null;
    Object.keys(rotation).forEach(function(c) { rotation[c].days.sort(); });
    return rotation;
}

// Every crew shift that overlaps [0, horizonMins), as minutes from the plan start.
function buildShiftWindows(rotation, planStart, horizonMins) {
    const windows = [];
    const days = Math.ceil(horizonMins / 1440) + 1;
    for (let day = -1; day <= days; day++) {
        const base = new Date(planStart.getFullYear(), planStart.getMonth(), planStart.getDate() + day);
        CREW_CODES.forEach(function(crew) {
            const cfg = rotation[crew];
            if (!cfg || !cfg.days || cfg.days.indexOf(base.getDay()) === -1) return;
            const s = new Date(base.getFullYear(), base.getMonth(), base.getDate(), cfg.startHour, 0, 0);
            const startOff = Math.round((s.getTime() - planStart.getTime()) / 60000);
            const endOff = startOff + (cfg.lengthHours || 12) * 60;
            const cs = Math.max(0, startOff), ce = Math.min(horizonMins, endOff);
            if (ce > cs) windows.push({ crew: crew, start: cs, end: ce, shiftStart: startOff, startHour: cfg.startHour, dayLabel: DAY_NAMES[base.getDay()] });
        });
    }
    return windows.sort(function(a, b) { return a.start - b.start || a.crew.localeCompare(b.crew); });
}

// Working minutes inside [start, end) once breaks / downtimes (possibly overlapping) are removed.
function netWorkingMins(start, end, interrupts) {
    let blocked = 0, cursor = start;
    (interrupts || []).slice().sort(function(a, b) { return a.start - b.start; }).forEach(function(b) {
        const s = Math.max(b.start, cursor), e = Math.min(b.end, end);
        if (e > s) { blocked += e - s; cursor = e; }
    });
    return Math.max(0, end - start - blocked);
}

function formatHourLabel(h) {
    const hh = ((h % 24) + 24) % 24;
    const ampm = hh >= 12 ? 'PM' : 'AM';
    return (hh % 12 || 12) + ampm;
}

function formatMinutesToHours(totalMinutes) {
    if (!totalMinutes && totalMinutes !== 0) return "0h 00m";
    const h = Math.floor(totalMinutes / 60);
    const m = Math.round(totalMinutes % 60);
    return `${h}h ${m < 10 ? '0' : ''}${m}m`;
}

function getGlobalStart(shiftDate, shiftStartHour) {
    if (!shiftDate || typeof shiftDate !== 'string') {
        const fallback = new Date();
        fallback.setHours(shiftStartHour || 0, 0, 0, 0);
        return fallback;
    }
    const parts = shiftDate.split('-');
    if (parts.length !== 3) {
        const fallback = new Date();
        fallback.setHours(shiftStartHour || 0, 0, 0, 0);
        return fallback;
    }
    return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10), shiftStartHour, 0, 0);
}

function getDatetimeLocalString(offsetMins, shiftDate, shiftStartHour) {
    if (!shiftDate || typeof shiftDate !== 'string') return "";
    const d = getGlobalStart(shiftDate, shiftStartHour);
    d.setMinutes(d.getMinutes() + (offsetMins || 0));
    const yyyy = d.getFullYear();
    const MM = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    return yyyy + '-' + MM + '-' + dd + 'T' + hh + ':' + mm;
}

function formatClockTime(shiftDateStr, startHour, elapsedMinutes) {
    if (!shiftDateStr || typeof shiftDateStr !== 'string') return "";
    const d = getGlobalStart(shiftDateStr, startHour);
    d.setMinutes(d.getMinutes() + elapsedMinutes);
    let m = d.getMonth() + 1;
    let dd = d.getDate();
    let h = d.getHours();
    let mins = d.getMinutes();
    let ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    h = h ? h : 12; 
    return m + '/' + (dd < 10 ? '0'+dd : dd) + ' ' + h + ':' + (mins < 10 ? '0'+mins : mins) + ' ' + ampm;
}

function formatGanttHeaderTime(shiftDateStr, startHour, elapsedMinutes) {
    if (!shiftDateStr || typeof shiftDateStr !== 'string') return "";
    const d = getGlobalStart(shiftDateStr, startHour);
    d.setMinutes(d.getMinutes() + elapsedMinutes);
    let m = d.getMonth() + 1;
    let dd = d.getDate();
    let h = d.getHours();
    let ampm = h >= 12 ? 'p' : 'a';
    h = h % 12;
    h = h ? h : 12; 
    return m + '-' + (dd < 10 ? '0'+dd : dd) + ' ' + h + ampm;
}

function getRoomColor(roomName) {
    if (!roomName) return 'bg-slate-500';
    const lower = String(roomName).toLowerCase();
    
    // 🚨 USER PREFERENCE OVERRIDE: Exact hex mapping for specific rooms
    if (lower.indexOf('breading') !== -1) return 'bg-amber-800'; 
    if (lower.indexOf('custard') !== -1) return 'bg-orange-500'; 
    if (lower.indexOf('4') !== -1) return 'bg-red-500';          
    if (lower.indexOf('5') !== -1) return 'bg-purple-500';       
    if (lower.indexOf('wj') !== -1 || lower.indexOf('waterjet') !== -1) return 'bg-blue-500'; 
    
    // Fallback hash logic for dynamic un-mapped rooms
    let hash = 0;
    for (let i = 0; i < roomName.length; i++) {
        hash = roomName.charCodeAt(i) + ((hash << 5) - hash);
    }
    const colors = ['bg-emerald-500', 'bg-teal-500', 'bg-cyan-500', 'bg-indigo-500', 'bg-pink-500'];
    return colors[Math.abs(hash) % colors.length];
}

function getOverlap(pStart, pEnd, sStart, sEnd) {
    const oStart = Math.max(pStart, sStart);
    const oEnd = Math.min(pEnd, sEnd);
    if (oEnd <= oStart) return null;
    return {
        leftPct: ((oStart - sStart) / (sEnd - sStart)) * 100,
        widthPct: ((oEnd - oStart) / (sEnd - sStart)) * 100
    };
}

function safeGetXrm() {
    if (typeof window === 'undefined') return null;
    if (window.Xrm) return window.Xrm;
    try { if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm; } catch (e) {}
    return null;
}

async function fetchAllActiveRecords(entityName, dataApi) {
    const xrm = safeGetXrm();
    if (xrm && xrm.WebApi && typeof xrm.WebApi.retrieveMultipleRecords === 'function') {
        try {
            const fetchXml = `<fetch top='5000'><entity name='${entityName}'><all-attributes/><filter><condition attribute='statecode' operator='eq' value='0'/></filter></entity></fetch>`;
            const res = await xrm.WebApi.retrieveMultipleRecords(entityName, "?fetchXml=" + encodeURIComponent(fetchXml));
            if (res && res.entities) return res.entities;
        } catch (e) {}
    }
    if (dataApi && typeof dataApi === 'object' && typeof dataApi.queryTable === 'function') {
        try {
            const res = await dataApi.queryTable(entityName, { filter: "statecode eq 0", top: 5000 });
            if (res && res.rows) return res.rows;
        } catch (e) {}
    }
    return [];
}

// Tries each logical name in turn (e.g. 'craa5__aa_employee' vs 'craa5_aa_employee') and returns the first with rows.
async function fetchFirstAvailable(entityNames, dataApi) {
    for (let i = 0; i < entityNames.length; i++) {
        const rows = await fetchAllActiveRecords(entityNames[i], dataApi);
        if (rows && rows.length > 0) return rows;
    }
    return [];
}

