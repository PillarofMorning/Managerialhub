                        </div>
                    </div>
                </div>
            )}

            {/* EQUIP DOWNTIME MODAL */}
            {isEquipDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsEquipDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
