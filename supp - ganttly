                                                                    className="absolute z-10 rounded-md border shadow-sm flex items-center justify-between px-2.5 overflow-hidden pointer-events-auto cursor-default"
                                                                    style={{
                                                                        left: `${dutyLeftPx}px`,
                                                                        width: `${dutyWidthPx}px`,
                                                                        top: `${row * LANE_HEIGHT_PX + 4}px`,
                                                                        height: `${LANE_HEIGHT_PX - 8}px`,
                                                                        backgroundColor: barColor,
                                                                        borderColor: darkOf(barColor),
                                                                        opacity: 0.75
