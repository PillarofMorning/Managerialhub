                            </div>

                            <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between">
                                <div>
                                    <h2 className="text-xs font-black text-slate-500 uppercase tracking-widest mb-2 flex items-center"><Users className="w-4 h-4 mr-2" /> Manpower</h2>
                                    <div className="text-2xl font-black text-teal-600">{(neededManpowerMins / 60).toFixed(1)} <span className="text-base">hrs needed</span></div>
