                                            <div key={hour} className="absolute top-0 bottom-0 border-l border-gray-300 flex flex-col justify-center -ml-[1px]" style={{ left: `${xOf(hour * 60)}px` }}>
                                                <span className="text-[10px] font-black text-[#00468B] bg-[#E6F1FB] px-2 rounded-br border-b border-r border-[#CFE3F7] absolute top-0 left-0 whitespace-nowrap">
