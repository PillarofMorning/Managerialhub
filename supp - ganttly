                                        <Printer className="w-3.5 h-3.5 mr-1 text-[#0072CE]" /> Print
                                    </Button>
                                </div>
                            </div>

                            {/* 2. WHO IS ON SHIFT + HIGH FIVE (+5) RECOGNITION BOARD */}
                            <div className="bg-white rounded-xl border border-slate-200 shadow-2xs p-4">
                                <div className="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-100 flex-wrap">
                                    <div className="flex items-center gap-2 flex-wrap">
                                        <Users className="w-4 h-4 text-[#0072CE]" />
                                        <h3 className="text-xs font-black uppercase tracking-wider text-slate-800">
                                            Who Is On Shift ({win ? (win.crewLabel || win.crew) + ' Crew' : 'Active Shift'})
                                        </h3>
                                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-50 text-[#00468B] border border-sky-200">
                                            {crewLanes.length} Members ({leadsN} Lead{leadsN === 1 ? '' : 's'})
                                        </span>
                                    </div>
                                    <span className="text-[11px] font-bold text-slate-500">
                                        Click <span className="px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 font-black border border-amber-300">+5 High Five</span> on any team member to send kudos
                                    </span>
                                </div>

                                {crewLanes.length === 0 ? (
                                    <div className="py-4 text-center text-xs font-bold text-slate-400">
                                        No workers matched for this shift. Check the Shift Start link below.
                                    </div>
                                ) : (
                                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2.5">
                                        {crewLanes.map(function(l) {
                                            const isSup = isSupportWorker(l);
                                            const supLabel = isSup ? supportRoleLabelOf(l) : null;
                                            const supColor = isSup ? supportRoleColorOf(l) : null;
                                            const gc = l.groupIdx >= 0 ? TEAM_COLORS[l.groupIdx % TEAM_COLORS.length] : null;

                                            const empRec = (personnelRecords && l.empId && personnelRecords[l.empId]) || { highFives: 0, logs: [] };
                                            const hfCount = empRec.highFives || 0;
                                            const workerArea = (l.room && l.room.trim()) || (isSup ? (supLabel || 'Support Role') : 'Unassigned');
                                            const blocks = blocksFor(l.lane);
                                            const doneCount = blocks.filter(function(t) { return t.isComplete; }).length;

                                            return (
                                                <div
                                                    key={'setup_' + l.lane}
                                                    className="bg-slate-50/80 hover:bg-white border border-slate-200/90 hover:border-slate-300 rounded-xl px-3 py-2.5 flex items-center justify-between gap-2 transition-all shadow-2xs"
                                                    style={
                                                        isSup
                                                            ? { borderLeft: '4px solid ' + (supColor || '#0891b2') }
                                                            : gc
                                                            ? { borderLeft: '4px solid ' + gc }
                                                            : { borderLeft: '4px solid #0072CE' }
                                                    }
                                                >
                                                    <div className="min-w-0 flex-1">
                                                        <div className="flex items-center gap-1.5 flex-wrap">
                                                            <span className="text-xs font-black text-slate-800 truncate" title={l.name}>
                                                                {l.name}
                                                            </span>
                                                            {l.isLead && (
                                                                <span className="text-[8px] font-black rounded px-1.5 py-0.5 bg-purple-100 text-purple-800 border border-purple-200">
                                                                    LEAD
                                                                </span>
                                                            )}
                                                            {isSup && supLabel && (
                                                                <span
                                                                    className="text-[8px] font-black rounded px-1.5 py-0.5 text-white"
                                                                    style={{ backgroundColor: supColor || '#0891b2' }}
                                                                >
                                                                    {supLabel}
                                                                </span>
                                                            )}
                                                        </div>
                                                        <div className="flex items-center gap-1.5 mt-1 text-[10px] font-bold text-slate-500 truncate">
                                                            <span className="w-2 h-2 rounded-full flex-shrink-0" style={{ background: workerArea !== 'Unassigned' ? roomHexShown(workerArea) : '#94A3B8' }} />
                                                            <span className="truncate" title={workerArea}>{workerArea}</span>
                                                            {blocks.length > 0 && (
                                                                <span className="text-[9px] font-black text-slate-400 flex-shrink-0">
                                                                    ({doneCount}/{blocks.length})
                                                                </span>
                                                            )}
                                                        </div>
                                                    </div>

                                                    {/* High Five (+5) & Supervisor Buttons */}
                                                    <div className="flex items-center gap-1 flex-shrink-0">
                                                        <button
                                                            type="button"
                                                            onClick={function(e) {
                                                                e.stopPropagation();
                                                                setHighFiveModal({
                                                                    empId: l.empId,
                                                                    name: l.name,
                                                                    area: workerArea,
                                                                    role: l.jobRole || (l.isLead ? 'Lead' : 'Crew'),
                                                                    crew: l.crew
                                                                });
                                                            }}
                                                            title={'Give High Five (+5) to ' + l.name}
                                                            className="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 transition-all text-[11px] font-black cursor-pointer active:scale-95 shadow-2xs"
                                                        >
                                                            <span>+5</span>
                                                            <span className="hidden sm:inline text-[10px]">High Five</span>
                                                            {hfCount > 0 && (
                                                                <span className="px-1.5 py-0.2 rounded-full bg-amber-200 text-amber-950 text-[9px] font-black">
                                                                    {hfCount}
                                                                </span>
                                                            )}
                                                        </button>

                                                        <button
                                                            type="button"
                                                            onClick={function(e) {
                                                                e.stopPropagation();
                                                                if (!supervisorMode) {
                                                                    setSupervisorLoginOpen(true);
                                                                    return;
                                                                }
                                                                if (!supervisorCanLodgeNegative) {
                                                                    setPersonnelToast('Restricted: Lodging negative remarks requires Lead, Supervisor, or Manager level. Your level: ' + supervisorLevel);
                                                                    return;
                                                                }
                                                                setIncidentModal({
                                                                    empId: l.empId,
                                                                    name: l.name,
                                                                    area: workerArea,
                                                                    role: l.jobRole || (l.isLead ? 'Lead' : 'Crew'),
                                                                    crew: l.crew
                                                                });
                                                            }}
                                                            title={supervisorMode ? (supervisorCanLodgeNegative ? ('Log Coaching / Incident for ' + l.name) : 'Restricted: Lodging negative remarks requires Lead, Supervisor, or Manager level') : 'Supervisor Sign In'}
                                                            className={'p-1.5 rounded-lg border transition-all cursor-pointer active:scale-95 ' + (
                                                                supervisorMode && supervisorCanLodgeNegative
                                                                    ? 'bg-rose-50 hover:bg-rose-100 text-rose-700 border-rose-300 shadow-2xs'
                                                                    : 'bg-slate-100 hover:bg-slate-200 text-slate-400 border-slate-200'
                                                            )}
                                                        >
                                                            <Shield className="w-3 h-3" />
                                                        </button>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                )}
                            </div>

                            {/* 2B. SHIFT START DRAG-AND-DROP TEAM & ROOM ASSIGNMENT BOARD (DAY 0600/0900/1200/1500 & NIGHT 1800/2100/0000/0300) */}
                            {/* Teams are built in Shift Start (its live board); Ganttly only reads them. The old builder stays for testing only:
                                run localStorage.setItem('ganttly_team_builder', '1') in the browser console and reload. */}
                            {!CREW_TEAM_BUILDER && (
                                <div data-crew-note className="bg-sky-50 border border-sky-200 rounded-xl px-4 py-3 text-xs font-bold text-[#00468B]">
                                    {tr('Teams and rooms are set in Shift Start (Assign employees). Ganttly reads them and assigns the equipment. To move someone, change it in Shift Start and save.', 'Los grupos y los cuartos se asignan en Shift Start (Asignar empleados). Ganttly los lee y asigna el equipo. Para mover a alguien, cambielo en Shift Start y guarde.')}
                                </div>
                            )}
                            {CREW_TEAM_BUILDER && win && resolvedCp && currentCpObj && (function() {
                                const cpPersonRoom = currentCpObj.personRoom || {};
                                const cpLeadOf = currentCpObj.leadOf || {};
                                const cpLeadRooms = currentCpObj.leadRooms || {};

                                // Build Lead columns (one per Lead on shift, plus Direct / General Crew fallback column)
                                const leadBuckets = leadsInCrew.map(function(ld, idx) {
                                    return {
                                        leadId: ld.empId,
                                        name: ld.name,
                                        isLead: true,
                                        color: TEAM_COLORS[idx % TEAM_COLORS.length]
                                    };
                                });
                                const hasDirectCrew = leadsInCrew.length === 0 || crewLanes.some(function(m) {
                                    return !m.isLead && m.empId && (!cpLeadOf[m.empId] || !leadsInCrew.some(function(ld) { return ld.empId === cpLeadOf[m.empId]; }));
                                }) || (cpLeadRooms['__direct__'] && cpLeadRooms['__direct__'].length > 0);
                                if (hasDirectCrew) {
                                    leadBuckets.push({
                                        leadId: '__direct__',
                                        name: leadsInCrew.length === 0 ? tr('Shift Crew Rooms', 'Cuartos de Cuadrilla') : tr('General / Direct Crew', 'Cuadrilla Directa / General'),
                                        isLead: false,
                                        color: '#0072CE'
                                    });
                                }

                                // Rooms currently placed in any lead column at this checkpoint
                                const assignedRoomsSet = {};
                                Object.keys(cpLeadRooms).forEach(function(ldId) {
                                    (cpLeadRooms[ldId] || []).forEach(function(rm) { if (rm) assignedRoomsSet[rm] = true; });
                                });
                                Object.keys(cpPersonRoom).forEach(function(empId) {
                                    if (cpPersonRoom[empId]) assignedRoomsSet[cpPersonRoom[empId]] = true;
                                });

                                const allOrderedRooms = orderRooms(allUniqueRooms.filter(function(r) { return !hiddenRooms[r]; }));
                                const unassignedRooms = allOrderedRooms.filter(function(r) { return !assignedRoomsSet[r]; });
                                const assignedRoomsList = allOrderedRooms.filter(function(r) { return !!assignedRoomsSet[r]; });

                                // Crew members not yet assigned to a room at this checkpoint
                                const unassignedTechs = crewLanes.filter(function(l) {
                                    return !l.isLead && l.empId && !cpPersonRoom[l.empId];
                                });
                                const assignedTechs = crewLanes.filter(function(l) {
                                    return !l.isLead && l.empId && !!cpPersonRoom[l.empId];
                                });

                                // Helper: drop a room onto a Lead Column (adds room bucket to that Lead)
                                const handleAssignRoomToLead = function(roomName, targetLeadId) {
                                    if (!roomName || !targetLeadId) return;
                                    const leadObj = leadBuckets.find(function(b) { return b.leadId === targetLeadId; });
                                    updateCheckpointSetup(selCpKey, function(pRoom, lOf, lRooms) {
                                        if (!lRooms[targetLeadId]) lRooms[targetLeadId] = [];
                                        if (lRooms[targetLeadId].indexOf(roomName) === -1) {
                                            lRooms[targetLeadId].push(roomName);
                                        }
                                        if (targetLeadId !== '__direct__' && !pRoom[targetLeadId]) {
                                            pRoom[targetLeadId] = roomName;
                                        }
                                    }, tr('Added room ', 'Cuarto agregado ') + roomName + ' -> ' + (leadObj ? leadObj.name : 'Team') + ' (' + currentCpObj.shortLabel + ')');
                                };

                                // Helper: move an entire group in oldRoom under targetLeadId to newRoom (for scheduling 9, 12/0000, 3/0300 updates!)
                                const handleMoveRoomGroup = function(targetLeadId, oldRoom, newRoom) {
                                    if (!oldRoom || !newRoom || oldRoom === newRoom) return;
                                    updateCheckpointSetup(selCpKey, function(pRoom, lOf, lRooms) {
                                        if (!lRooms[targetLeadId]) lRooms[targetLeadId] = [];
                                        const idx = lRooms[targetLeadId].indexOf(oldRoom);
                                        if (idx > -1) {
                                            if (lRooms[targetLeadId].indexOf(newRoom) === -1) {
                                                lRooms[targetLeadId][idx] = newRoom;
                                            } else {
                                                lRooms[targetLeadId].splice(idx, 1);
                                            }
                                        } else if (lRooms[targetLeadId].indexOf(newRoom) === -1) {
                                            lRooms[targetLeadId].push(newRoom);
                                        }
                                        if (targetLeadId !== '__direct__' && pRoom[targetLeadId] === oldRoom) {
                                            pRoom[targetLeadId] = newRoom;
                                        }
                                        crewLanes.forEach(function(m) {
                                            if (!m.empId || m.isLead) return;
                                            const mLead = lOf[m.empId] || '__direct__';
                                            if (mLead === targetLeadId && pRoom[m.empId] === oldRoom) {
                                                pRoom[m.empId] = newRoom;
                                            }
                                        });
                                    }, tr('Moved group ', 'Grupo movido ') + oldRoom + ' -> ' + newRoom + ' (' + currentCpObj.shortLabel + ')');
                                };

                                // Helper: remove a room bucket from a Lead Column
                                const handleRemoveRoomBucket = function(targetLeadId, roomName) {
                                    updateCheckpointSetup(selCpKey, function(pRoom, lOf, lRooms) {
                                        if (lRooms[targetLeadId]) {
                                            lRooms[targetLeadId] = lRooms[targetLeadId].filter(function(r) { return r !== roomName; });
                                        }
                                        if (targetLeadId !== '__direct__' && pRoom[targetLeadId] === roomName) {
                                            delete pRoom[targetLeadId];
                                        }
                                        crewLanes.forEach(function(m) {
                                            if (!m.empId || m.isLead) return;
                                            const mLead = lOf[m.empId] || '__direct__';
                                            if (mLead === targetLeadId && pRoom[m.empId] === roomName) {
                                                delete pRoom[m.empId];
                                            }
                                        });
                                    }, tr('Removed room ', 'Cuarto quitado ') + roomName + ' (' + currentCpObj.shortLabel + ')');
                                };

                                // Helper: assign a Crew Member to a specific Room Bucket and Lead
                                const handleAssignEmpToRoom = function(empId, empName, roomName, targetLeadId) {
                                    if (!empId) return;
                                    updateCheckpointSetup(selCpKey, function(pRoom, lOf, lRooms) {
                                        if (targetLeadId && targetLeadId !== '__direct__') {
                                            lOf[empId] = targetLeadId;
                                        } else if (targetLeadId === '__direct__') {
                                            delete lOf[empId];
                                        }
                                        if (roomName) {
                                            pRoom[empId] = roomName;
                                            const ldKey = (targetLeadId && targetLeadId !== '__direct__') ? targetLeadId : (lOf[empId] || '__direct__');
                                            if (!lRooms[ldKey]) lRooms[ldKey] = [];
                                            if (lRooms[ldKey].indexOf(roomName) === -1) lRooms[ldKey].push(roomName);
                                        } else {
                                            delete pRoom[empId];
                                        }
                                    }, (empName || 'Crew member') + ' -> ' + (roomName || 'Unassigned') + ' (' + currentCpObj.shortLabel + ')');
                                };

                                // Standard 3:00 / 0300 cascade preset (Trim -> Enrober, Kitchen -> 36, Rice -> Sauce)
                                const handleApplyCascadePreset = function() {
                                    const findRoomMatch = function(pattern) {
                                        return allOrderedRooms.find(function(r) { return pattern.test(r); }) || '';
                                    };
                                    const pairs = [
                                        { from: /trim/i, to: findRoomMatch(/enrober/i) },
                                        { from: /kitchen|kettles/i, to: findRoomMatch(/\b36\b|line\s*36|high\s*speed|ibl/i) },
                                        { from: /rice/i, to: findRoomMatch(/sauce/i) }
                                    ];
                                    updateCheckpointSetup(selCpKey, function(pRoom, lOf, lRooms) {
                                        Object.keys(pRoom).forEach(function(empId) {
                                            const curRm = pRoom[empId] || '';
                                            pairs.forEach(function(pr) {
                                                if (pr.to && pr.from.test(curRm)) {
                                                    pRoom[empId] = pr.to;
                                                }
                                            });
                                        });
                                        Object.keys(lRooms).forEach(function(ldId) {
                                            lRooms[ldId] = (lRooms[ldId] || []).map(function(rm) {
                                                for (let i = 0; i < pairs.length; i++) {
                                                    if (pairs[i].to && pairs[i].from.test(rm)) return pairs[i].to;
                                                }
                                                return rm;
                                            }).filter(function(r, i, self) { return r && self.indexOf(r) === i; });
                                        });
                                    }, tr('Applied cascade rotation to ', 'Rotacion en cascada aplicada a ') + currentCpObj.label);
                                };

                                return (
                                    <div data-checkpoint-board className="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden">
                                        <div className="px-5 py-3.5 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
                                            <div>
                                                <div className="flex items-center gap-2 flex-wrap">
                                                    <ClipboardList className="w-4 h-4 text-[#0072CE]" />
                                                    <h3 className="text-xs font-black uppercase tracking-wider text-slate-800">
                                                        {isNightWin
                                                            ? tr('Night Shift 1800 / 2100 / 0000 / 0300 Drag-and-Drop Scheduler', 'Programador Turno Noche 1800 / 2100 / 0000 / 0300')
                                                            : tr('Day Shift 0600 / 0900 / 1200 / 1500 Drag-and-Drop Scheduler', 'Programador Turno Dia 0600 / 0900 / 1200 / 1500')}
                                                    </h3>
                                                    <span className="px-2 py-0.5 rounded-full text-[10px] font-black bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">
                                                        {tr('Active Floor Setup:', 'Configuracion Activa:')} {resolvedCp.checkpoints[resolvedCp.activeKey] ? resolvedCp.checkpoints[resolvedCp.activeKey].label : activeCpDefs[0].label}
                                                    </span>
                                                </div>
                                                <p className="text-[11px] font-semibold text-slate-500 mt-0.5">
                                                    {tr(
                                                        'Works just like Shift Start: Drag Rooms onto Lead columns and drag Crew Members into Rooms. Setting the first group (0600 or 1800 Set) automatically populates the 9, 12/0000, and 3/0300 updates so you can schedule out each checkpoint!',
                                                        'Funciona igual que Shift Start: Arrastre Cuartos a las columnas de Lider y arrastre Personal a los Cuartos. Configurar el primer grupo (0600 o 1800) llena automaticamente las actualizaciones 9, 12/0000 y 3/0300 para programar cada punto.'
                                                    )}
                                                </p>
                                            </div>
                                            <div className="flex items-center gap-2 flex-wrap">
                                                {checkpointDraftToast && (
                                                    <span className="px-2.5 py-1 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-800 text-[11px] font-black">
                                                        {checkpointDraftToast}
                                                    </span>
                                                )}
                                                {selCpKey !== '0' && (
                                                    <button
                                                        type="button"
                                                        onClick={handleApplyCascadePreset}
                                                        className="px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-[11px] font-black transition-colors cursor-pointer"
                                                        title="Apply standard update cascade (Trim -> Enrober, Kitchen -> 36, Rice -> Sauce)"
                                                    >
                                                        {tr('Cascade Preset (Trim/Kitchen/Rice)', 'Cascada (Trim/Cocina/Arroz)')}
                                                    </button>
                                                )}
                                                <button
                                                    type="button"
                                                    onClick={function() {
                                                        updateCheckpointSetup(selCpKey, function() {}, 'Saved ' + currentCpObj.label + ' team & room setup');
                                                    }}
                                                    className="px-3 py-1.5 rounded-lg bg-[#0072CE] hover:bg-[#005FA8] text-white text-xs font-black shadow-2xs transition-colors cursor-pointer flex items-center gap-1.5"
                                                >
                                                    <Check className="w-3.5 h-3.5" />
