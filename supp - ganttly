                    if (!searchQ) return true;
                    return String(a.name || '').toLowerCase().indexOf(searchQ) > -1 ||
                           String(a.area || '').toLowerCase().indexOf(searchQ) > -1 ||
                           String(a.subcategory || '').toLowerCase().indexOf(searchQ) > -1 ||
                           String(a.id || '').toLowerCase().indexOf(searchQ) > -1;
