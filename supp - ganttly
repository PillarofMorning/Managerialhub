                                        return <span key={l} className={`text-[11px] font-bold rounded px-2 py-0.5 border ${getCrewStyle(lr.crew).soft}`}>{lr.crew} · {lr.name}</span>;
                                    })}
                                </div>
                                {activeEditorTask.isSplitPart1 && <p className="text-[11px] font-bold text-amber-700 mt-2">Handed over to the next crew at shift end.</p>}
                                {activeEditorTask.isSplitPart2 && <p className="text-[11px] font-bold text-amber-700 mt-2">Continues work started by the previous crew (+{handoverMins}m/head handover).</p>}
                                {activeEditorTask.isOffShift && <p className="text-[11px] font-bold text-rose-700 mt-2">Pinned outside these workers' shift.</p>}
                            </div>
                            <div className="flex gap-4">
                                {!activeEditorTask.isSplitPart2 && (
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Clock className="w-3 h-3 mr-1"/> Start (Mins)</label>
                                    <input type="number" min="0" value={activeEditorTask.startMin} onChange={function(e) {
                                        setOverrides(function(prev) { return Object.assign({}, prev, { [activeEditorTask.id]: { startMin: Number(e.target.value), startLane: activeEditorTask.assignedLanes[0]||0 } }); });
                                    }} className="w-full text-center border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none" />
                                </div>
                                )}
                                <div className="flex-1">
