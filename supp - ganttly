    useEffect(() => {
        const applyEdits = function(list) {
            return list.map(function(a) { return assetEdits[a.id] ? Object.assign({}, a, assetEdits[a.id]) : a; });
        };
        async function loadAssets() {
            try {
                const [dvAssets, dvEmps, dvShifts] = await Promise.all([
