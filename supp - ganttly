    const asgMoveTo = function(w, plan, aid, guid) {
        const a = plan.asg[aid];
        if (!a || !guid || (a.people.length === 1 && a.people[0] === guid)) return;
        let last = 0;
        Object.keys(plan.asg).forEach(function(k) { const x = plan.asg[k]; if (k !== aid && x.people.indexOf(guid) > -1) last = Math.max(last, x.order || 0); });
        asgEdit(w, [{ aid: aid, people: [guid], order: last + 1, pinned: true }], { what: a.name + tr(' to ', ' a ') + (asgNameOf(guid) || '?') });
    };
    // Completion order in one person's list: the piece swaps places with its neighbour and the list is numbered 1, 2, 3 ...; the
    // moved piece is pinned, the others only get their new number (the same rule as Shift Start).
    const asgReorder = function(w, list, idx, dir) {
        const j = idx + dir;
        if (j < 0 || j >= list.length) return;
        const next = list.slice(), moved = next[idx];
        next[idx] = next[j]; next[j] = moved;
        const items = [];
        next.forEach(function(p, i) {
            if (p === moved || p.order !== i + 1) items.push({ aid: p.aid, people: p.people, order: i + 1, pinned: p === moved ? true : p.pinned });
        });
        asgEdit(w, items, { what: moved.name + (dir < 0 ? tr(' earlier', ' antes') : tr(' later', ' despues')) });
    };
    // Split evenly: ASSIGN SPLIT again with resplit on, from what the room shows now. Pieces placed by hand and done pieces stay.
    const asgSplitRooms = function(w, plan, rooms) {
        const items = [];
        rooms.forEach(function(room) {
            const inp = plan.asgRoom && plan.asgRoom[room.lid];
            if (!inp) return;
            const res = asgSplit({ resplit: true, members: inp.members, capacityMins: inp.capacityMins, pieces: inp.pieces.map(function(p) {
                const a = plan.asg[p.aid];
                return Object.assign({}, p, a ? { people: a.people, order: a.order, pinned: a.pinned, done: a.done } : {});
            }) });
            inp.pieces.forEach(function(p) {
                const pl = res.placed[p.key], a = plan.asg[p.aid];
                if (!pl || pl.kept || !a) return;
                if (pl.changed || !a.row) items.push({ aid: p.aid, people: pl.people, order: pl.order, pinned: false });
            });
        });
        if (!items.length) { setAsgAction({ text: tr('Already split evenly: nothing to change.', 'Ya esta repartido parejo: nada que cambiar.'), tone: 'ok', at: Date.now() }); return; }
