            let page = await dataApi.queryTable('craa5_sanitationshiftreport', { select: ['craa5_name', 'craa5_equipmentjson', 'modifiedon'], filter: "statecode eq 0 and startswith(craa5_name,'" + BOARD_PREFIX + "') and modifiedon ge " + since, orderBy: 'modifiedon desc', pageSize: 50, top: BOARD_TOP });
