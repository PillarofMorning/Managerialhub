                                                <div key={l.lane} className={`flex-1 border-b border-gray-200/60 flex flex-col justify-center px-2 bg-white ${isCrewStart ? 'border-t-2 border-t-slate-400' : ''}`} style={{ height: `${LANE_HEIGHT_PX}px` }} title={`${l.name} (${l.crew} crew) — ${ws ? (ws.bookedMins / 60).toFixed(1) : 0}h assigned of ${ws ? (ws.availMins / 60).toFixed(0) : 0}h on shift`}>
