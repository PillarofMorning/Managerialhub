        return Object.keys(plan.lineSplit || {}).map(function(lid) {
            const ls = plan.lineSplit[lid];
            const pieces = Object.keys(plan.asg || {}).filter(function(aid) { return plan.asg[aid].lid === lid; }).map(function(aid) {
                const a = plan.asg[aid], par = scheduleData.parentById ? scheduleData.parentById[aid] : null;
                const open = ((par && par.blocks) || []).filter(function(bk) { return !bk.isComplete; });
                const inShift = open.filter(function(bk) { return bk.startMin >= w.shiftStart - 60 && bk.startMin < w.shiftEnd; });
                const startMin = inShift.length ? Math.min.apply(null, inShift.map(function(bk) { return bk.startMin; })) : null;
                const endMin = open.length ? Math.max.apply(null, open.map(function(bk) { return bk.startMin + (bk.finalDuration || 0); })) : null;
                const status = a.done ? 'done' : started[a.guid] ? 'started' : endMin !== null && endMin < nowMin ? 'overdue' : 'planned';
                return Object.assign({ aid: aid, startMin: startMin, status: status, hits: swbOpen.byGuid[a.guid] || [], unsaved: unsaved[aid] || '' }, a);
            });
            const ar = (plan.asgRoom && plan.asgRoom[lid]) || {};
            const members = (ls.members || []).map(function(m) { return { id: m.id, guid: hubGuid(m.id), picOnly: !!m.picOnly, lead: !!m.lead, name: nameOfId(m.id) }; });
            const name = lineName(lid);
            return { lid: lid, name: name, mode: ls.mode, members: members, pieces: pieces, unplaced: ar.unplaced || [], capacityMins: Number(ar.capacityMins) || 0,
