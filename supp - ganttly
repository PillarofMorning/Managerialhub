                                            const wPx = (brk.duration / 60) * zoomLevel;
                                            if (lPx >= GANTT_TOTAL_WIDTH_PX) return null;
                                            return (
                                                <div key={`brk-${idx}`} className={`absolute top-0 bottom-0 border-x border-slate-400/20 z-10 flex items-start justify-center overflow-hidden pointer-events-none ${brk.isCustom ? 'bg-slate-900/80' : 'bg-slate-400/60'}`} style={{ left: `${lPx}px`, width: `${wPx}px` }}>
                                                    {wPx > 15 && <span className={`text-[9px] font-black uppercase mt-4 transform -rotate-90 origin-center whitespace-nowrap text-white/90`}>{brk.label}</span>}
                                                </div>
                                            );
                                        })}
                                    </div>

                                    <div className="flex relative z-10 bg-transparent touch-none">
                                        <div className="sticky left-0 w-[170px] flex-shrink-0 bg-slate-50 border-r border-gray-300 z-30 shadow-[4px_0_10px_rgba(0,0,0,0.03)] flex flex-col relative no-pan">
                                            {laneRoster.map(function(l) {
                                                const isCrewStart = crewBlocks.some(function(b) { return b.firstLane === l.lane && l.lane > 0; });
                                                return (
                                                <div key={l.lane} className={`flex-1 border-b border-gray-200/60 flex items-center justify-start gap-1.5 px-2 bg-white ${isCrewStart ? 'border-t-2 border-t-slate-400' : ''}`} style={{ height: `${LANE_HEIGHT_PX}px` }} title={`${l.name} (${l.crew} crew)`}>
                                                    <span className={`text-[9px] font-black rounded px-1 py-0.5 flex-shrink-0 ${getCrewStyle(l.crew).badge}`}>{l.crew}</span>
                                                    <span className="text-[10px] font-bold text-slate-700 truncate w-full">{l.name}</span>
                                                </div>
                                                );
                                            })}
                                        </div>
                                        
                                        <div className="relative no-pan touch-none" style={{ width: `${GANTT_TOTAL_WIDTH_PX}px`, height: `${globalHeadcount * LANE_HEIGHT_PX}px` }}>
                                            {Array.from({ length: globalHeadcount }).map(function(_, i) {
                                                return <div key={i} className="absolute w-full border-t border-gray-200 border-dashed pointer-events-none" style={{ top: `${i * LANE_HEIGHT_PX}px` }} />;
                                            })}
                                            {laneOffShift.map(function(gaps, lane) {
                                                return gaps.map(function(g, gi) {
                                                    return <div key={`off-${lane}-${gi}`} className="absolute bg-slate-300/40 off-shift-stripes pointer-events-none" style={{ left: `${(g.start / 60) * zoomLevel}px`, width: `${((g.end - g.start) / 60) * zoomLevel}px`, top: `${lane * LANE_HEIGHT_PX}px`, height: `${LANE_HEIGHT_PX}px` }} />;
                                                });
                                            })}

                                            {displayData.map(function(areaGroup) {
                                                return areaGroup.tasks.map(function(task) {
                                                    const isDraggingMe = (dragState && dragState.taskId === task.id);
                                                    const rMin = isDraggingMe ? dragState.currentMin : task.startMin;
                                                    
                                                    const rLanes = task.isPinned || isDraggingMe 
                                                        ? Array.from({ length: task.appliedHeads }, function(_, i) { return (isDraggingMe ? dragState.currentLane : (task.assignedLanes[0]||0)) + i; }) 
                                                        : task.assignedLanes;

                                                    const activeSegments = isDraggingMe ? task.calculateSegments(task.customInterrupts, task.appliedHeads, rMin) : task.segments;
                                                    const activeDuration = isDraggingMe ? task.calculateDuration(rMin, task.customInterrupts, task.appliedHeads) : task.finalDuration;

                                                    const sortedLanes = rLanes.slice().sort(function(a,b) { return a-b; });

                                                    const isHandoverPart = task.isSplitPart1 || task.isSplitPart2;
                                                    const transitEnd = task.isTransitActive && !task.isSplitPart2 ? 10 * task.appliedHeads : 0;
                                                    let activeWorkMins = task.baseMins;
                                                    if (task.isPbActive && task.pbMins > 0) activeWorkMins = task.pbMins;
                                                    else if (task.isAllergenActive && task.allergenMins > 0) activeWorkMins = task.allergenMins;
                                                    
                                                    const breakPaddingMins = (activeDuration * task.appliedHeads) - task.rawWorkloadMins;

                                                    const baseEnd = transitEnd + task.baseMins + ((task.isAllergenActive || task.isPbActive) ? 0 : breakPaddingMins);
                                                    const allergenEnd = transitEnd + activeWorkMins + breakPaddingMins;
                                                    const inspectEnd = task.isInspectionActive ? allergenEnd + (activeWorkMins * 0.10) : allergenEnd;

                                                    // 🚨 ARCHITECTURE NOTE: Multi-Head Rendering Workaround
                                                    // By mapping explicitly over 'sortedLanes', we generate completely distinct block DOM elements.
                                                    // This correctly renders split-team tasks (e.g. Worker 1 and Worker 5) without creating a solid 
                                                    // color box that bleeds over Workers 2, 3, and 4.
                                                    return sortedLanes.map(function(lane, laneIdx) {
                                                        const isPrimaryLane = (laneIdx === 0);
                                                        let cumMins = 0;
                                                        
                                                        return activeSegments.map(function(seg, segIdx) {
                                                            const leftPx = (seg.startMin / 60) * zoomLevel;
                                                            const widthPx = (seg.duration / 60) * zoomLevel;
                                                            const topPx = lane * LANE_HEIGHT_PX;
                                                            const heightPx = LANE_HEIGHT_PX;
                                                            
                                                            if (leftPx >= GANTT_TOTAL_WIDTH_PX) return null;
                                                            const isFirstSegment = segIdx === 0;

                                                            const startWork = cumMins;
                                                            const endWork = cumMins + (seg.duration * task.appliedHeads);
                                                            if (laneIdx === sortedLanes.length - 1) cumMins += (seg.duration * task.appliedHeads); 

                                                            const transitOverlap = getOverlap(0, transitEnd, startWork, endWork);
                                                            const baseOverlap = getOverlap(transitEnd, baseEnd, startWork, endWork);
                                                            const allergenOverlap = getOverlap(baseEnd, allergenEnd, startWork, endWork);
                                                            const inspectOverlap = getOverlap(allergenEnd, inspectEnd, startWork, endWork);

                                                            return (
                                                                <div 
                                                                    key={`${task.id}-${laneIdx}-${segIdx}`}
                                                                    onPointerDown={function(e) {
                                                                        if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); 
                                                                        setHasDragged(false);
                                                                        // Handover continuations are generated by the engine; pin the Pt 1 block instead.
                                                                        if (task.isSplitPart2) return;
                                                                        setDragState({ taskId: task.id, areaName: areaGroup.name, initialX: e.clientX, initialY: e.clientY, initialMin: task.startMin, initialLane: task.isPinned ? (task.assignedLanes[0]||0) : (task.assignedLanes[0]||0), currentMin: task.startMin, currentLane: task.isPinned ? (task.assignedLanes[0]||0) : (task.assignedLanes[0]||0), appliedHeads: task.appliedHeads, duration: activeDuration });
                                                                        if (e.currentTarget && typeof e.currentTarget.setPointerCapture === 'function') e.currentTarget.setPointerCapture(e.pointerId);
                                                                    }}
                                                                    onPointerUp={function(e) {
                                                                        if (e.currentTarget && typeof e.currentTarget.releasePointerCapture === 'function') e.currentTarget.releasePointerCapture(e.pointerId);
                                                                        if (!hasDragged) setSelectedTaskEditor(task.id);
                                                                    }}
                                                                    onPointerEnter={function() { setHoveredTaskId(task.id); }}
                                                                    onPointerLeave={function() { setHoveredTaskId(null); }}
                                                                    className={`absolute block-draggable flex flex-col justify-center z-20 cursor-grab 
                                                                        ${task.isComplete ? 'opacity-70 grayscale' : ''}
                                                                        ${isDraggingMe ? 'z-50 shadow-2xl scale-[1.02] ring-2 ring-white ring-offset-2 ring-offset-indigo-500 opacity-90 cursor-grabbing' : 'gantt-block-anim hover:z-30 hover:brightness-110 hover:shadow-md hover:scale-[1.01] hover:ring-2 hover:ring-white hover:ring-offset-1 hover:ring-offset-indigo-500'}
                                                                        ${hoveredTaskId === task.id && !isDraggingMe ? 'ring-2 ring-white ring-offset-2 ring-offset-indigo-500 z-30 brightness-110 shadow-lg' : ''}
                                                                    `}
                                                                    style={{ left: `${leftPx}px`, width: `${Math.max(widthPx, 8)}px`, top: `${topPx + 2}px`, height: `${heightPx - 4}px` }} 
                                                                >
                                                                    <div className={`absolute inset-0 rounded-md overflow-hidden flex shadow-sm border ${task.isPinned && !isDraggingMe ? 'border-[2px] border-slate-900 border-dashed opacity-90' : 'border-black/20'} ${task.isOffShift ? 'ring-2 ring-rose-500' : ''}`}>
                                                                        {isHandoverPart && <div className={`absolute inset-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} />}
                                                                        {isHandoverPart && task.isSplitPart1 && <div className="absolute top-0 bottom-0 right-0 w-1.5 bg-white/70" title="Handed over to next crew" />}
                                                                        {isHandoverPart && task.isSplitPart2 && <div className="absolute top-0 bottom-0 left-0 w-1.5 bg-white/70" title="Continued from previous crew" />}
                                                                        {!isHandoverPart && transitOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${transitOverlap.leftPct}%`, width: `${transitOverlap.widthPct}%` }} title="Transit/Prep (10m)" />}
                                                                        {!isHandoverPart && baseOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} style={{ left: `${baseOverlap.leftPct}%`, width: `${baseOverlap.widthPct}%` }} />}
                                                                        {!isHandoverPart && allergenOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} opacity-40 ${task.isComplete ? 'complete-stripes' : ''}`} style={{ left: `${allergenOverlap.leftPct}%`, width: `${allergenOverlap.widthPct}%` }} title="Allergen Extra Time" />}
                                                                        {!isHandoverPart && inspectOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${inspectOverlap.leftPct}%`, width: `${inspectOverlap.widthPct}%` }} title="Inspection" />}
                                                                    </div>

                                                                    {isFirstSegment && task.isPinned && !isDraggingMe && <div className="absolute top-0 right-0 w-0 h-0 border-l-[12px] border-l-transparent border-t-[12px] border-t-white/80 z-30 pointer-events-none" />}
                                                                    
                                                                    <div className="relative z-30 px-2.5 pointer-events-none flex items-center justify-between w-full h-full">
                                                                        {isFirstSegment && widthPx > 20 && (
                                                                            <div className="flex items-center justify-center gap-1 w-full" style={{ marginLeft: task.isTransitActive && !task.isSplitPart2 ? `${(10 / 60) * zoomLevel}px` : '0px' }}>
                                                                                {isPrimaryLane ? (
                                                                                    <span className="text-white font-bold text-[11px] truncate leading-tight drop-shadow-md flex-1 flex items-center gap-1">
                                                                                        {(task.isAllergenActive || task.isPbActive) && <Biohazard className="w-3 h-3 text-rose-200" />} {task.name}
                                                                                    </span>
                                                                                ) : (
                                                                                    <span className="text-white/80 font-black text-sm w-full text-center drop-shadow-sm leading-none flex items-center justify-center h-full pt-0.5">+</span>
                                                                                )}
                                                                            </div>
                                                                        )}
                                                                    </div>
                                                                </div>
                                                            );
                                                        });
                                                    });
                                                });
                                            })}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            )}

            {/* CUSTOM TASK MODAL */}
            {isCustomTaskModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsCustomTaskModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Custom Task</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsCustomTaskModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Task Name</label>
                                <input type="text" value={newTaskName} onChange={function(e) { setNewTaskName(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Special Deep Clean" />
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Area</label>
                                <input list="area-list" type="text" value={newTaskArea} onChange={function(e) { setNewTaskArea(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none uppercase" placeholder="e.g. PACKAGING" />
                                <datalist id="area-list">
                                    {activeRooms.map(function(room) { return <option key={room} value={room} />; })}
                                </datalist>
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Total Mins</label>
                                    <input type="number" min="15" step="15" value={newTaskMins} onChange={function(e) { setNewTaskMins(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Heads</label>
                                    <input type="number" min="1" value={newTaskHeads} onChange={function(e) { setNewTaskHeads(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Priority</label>
                                    <input type="number" min="1" value={newTaskPriority} onChange={function(e) { setNewTaskPriority(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                            </div>
                            <Button className="w-full mt-4" onClick={handleAddCustomTask}>Create Task</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* ROOM DOWNTIME MODAL */}
            {isRoomDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsRoomDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">{dtTarget === 'GLOBAL' ? 'Add Global Downtime' : 'Add Room Downtime'}</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsRoomDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-indigo-600 mb-4 bg-indigo-50 p-2 rounded">Target: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Chemical Refill" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime(dtTarget === 'GLOBAL' ? 'global' : 'room'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* EQUIP DOWNTIME MODAL */}
            {isEquipDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsEquipDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Equipment Downtime</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsEquipDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-indigo-600 mb-4 bg-indigo-50 p-2 rounded">Target Equipment ID: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Blade Swap" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime('equipment'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* POPUP EDITOR FOR TASKS */}
            {selectedTaskEditor && activeEditorTask && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 animate-in fade-in duration-200 touch-none" onPointerDown={function() { setSelectedTaskEditor(null); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        
                        <div className="flex justify-between items-start border-b border-slate-100 pb-4 mb-4">
                            <div>
                                <h3 className="text-lg font-black text-slate-800 leading-tight">{activeEditorTask.name}</h3>
                                <p className="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1 flex items-center"><MapPin className="w-3 h-3 mr-1"/> {activeEditorTask.area}</p>
                                <p className="text-[11px] text-slate-600 font-bold mt-1">{formatClockTime(ganttStartDate, ganttStartHour, activeEditorTask.startMin)} → {formatClockTime(ganttStartDate, ganttStartHour, activeEditorTask.startMin + activeEditorTask.finalDuration)}</p>
                            </div>
                            <Button variant="outline" size="sm" onClick={function() { setSelectedTaskEditor(null); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>

                        <div className="space-y-5">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Assigned Workers</label>
                                <div className="flex flex-wrap gap-1.5">
                                    {(activeEditorTask.assignedLanes || []).map(function(l) {
                                        const lr = laneRoster[l];
