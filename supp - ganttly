                }

                setDataDiag({ source: dvAssets && dvAssets.length > 0 ? 'Dataverse' : 'Sample data', assetCount: parsed.length, employeeTable: dvEmps.table, shiftRows: dvShifts.rows.length });
                parsed = applyEdits(parsed.concat(customTasks));
                setAssets(parsed);
                const initialPri = {};
                parsed.forEach(function(a) { if (!initialPri[a.area]) initialPri[a.area] = 2; });
                setRoomPriority(function(prev) { return Object.assign({}, initialPri, prev); });

            } catch (e) {
                setDataDiag({ source: 'Sample data (load error: ' + (e && e.message ? e.message : e) + ')', assetCount: MOCK_ASSETS.length, employeeTable: '', shiftRows: 0 });
                setAssets(applyEdits(MOCK_ASSETS.map(function(a) { return Object.assign({}, a, { pbMins: 0, allergenMins: 45 }); }).concat(customTasks)));
                setRoomPriority(function(prev) { return Object.assign({}, { 'CUSTARD': 2, 'WATERJET': 2, 'PACKAGING': 2 }, prev); });
