// ==== PBED DEBRIEF TAB ====
// Monday debrief, executive first: one headline, five numbers, the takeaways, a scorecard per line. Detail sits below.

function pbDebriefText(m: any, d: any) {
    var out = [pbT('PBED DEBRIEF - weekend of {date}', { date: pbFmtDate(m.frame.sat.getTime()) }), ''];
    if (d.take.length) { out.push(pbT('HEADLINES')); d.take.forEach(function (t: string, i: number) { out.push((i + 1) + '. ' + t); }); out.push(''); }
    out.push(pbT('SCORECARD'));
    d.lines.forEach(function (x: any) {
        out.push('- ' + x.l.name + ': ' + (x.actClean !== null ? pbT('clean done {at} (plan {plan}, {delta})', { at: pbFmtDayTime(x.actClean), plan: pbFmtDayTime(x.planClean), delta: (x.cleanDelta > 0 ? '+' : '') + pbFmtHours(x.cleanDelta) }) : pbT('clean not finished or not recorded ({d} of {n} milestones)', { d: x.done, n: x.total })) + (x.ready !== null ? '; ' + pbT('ready {at}{proj}, restart {restart}', { at: pbFmtDayTime(x.ready), proj: x.readyProjected ? ' ' + pbT('(projected)') : '', restart: pbFmtDayTime(x.restart) }) : ''));
    });
    if (d.keys.length) {
        out.push(''); out.push(pbT('KEY GOALPOSTS: {hit} of {n} hit', { hit: d.keyHit, n: d.keys.length }));
        d.keys.forEach(function (r: any) { out.push('* ' + r.l.name + ' ' + pbBlockName(r.b) + ': ' + pbT('plan {plan}, actual {act} - {state}', { plan: pbFmtDayTime(r.b.end), act: r.a && r.a.actualEnd !== null ? pbFmtDayTime(r.a.actualEnd) : '--', state: pbT((PB_GOAL_CHIP[r.state] || PB_GOAL_CHIP.open).label) })); });
    }
    out.push('');
    out.push(pbT('TIME LOST: {t} ({ph} people-hours)', { t: pbFmtHours(d.lossMin), ph: pbFmtNum(d.lossPH, 1) }));
    d.reasons.forEach(function (x: any) { out.push('  - ' + pbT(x.what) + ': ' + pbT('{ph} people-hours', { ph: pbFmtNum(x.hours, 1) })); });
    if (d.costs.length) {
        out.push(''); out.push(pbT('BIGGEST COSTS'));
        d.costs.slice(0, 6).forEach(function (c: any) { out.push('  - ' + c.what + ': ' + pbT('{ph} people-hours', { ph: pbFmtNum(c.hours, 1) }) + (m.rate !== null ? ' (' + pbFmtMoney(c.hours * m.rate) + ')' : '')); });
    }
    return out.join('\n');
}

function PbBars(props: any) {
    var max = 0; props.items.forEach(function (x: any) { max = Math.max(max, x.hours); });
    return (
        <div className="space-y-1.5">
            {props.items.map(function (x: any) {
                return (
                    <div key={x.what} className="flex items-center gap-2 text-sm">
                        <span className="w-44 shrink-0 truncate text-slate-700" title={pbT(x.what)}>{pbT(x.what)}</span>
                        <div className="flex-1 h-3 rounded bg-slate-100 overflow-hidden"><div className="h-3 rounded" style={{ width: (max ? Math.max(3, 100 * x.hours / max) : 0) + '%', backgroundColor: props.color || '#DC2626' }} /></div>
                        <span className="w-24 text-right text-xs text-slate-600 whitespace-nowrap">{pbFmtNum(x.hours, 1)} {pbT('p-h')}</span>
                    </div>
