    return (
        <div className="space-y-4">
            <PbNote>Tap Started and Done as each milestone happens. Times save {props.canSave.milestone ? 'to Dataverse (_p_ Milestone)' : 'on this computer only, because the _p_ Milestone table was not found'}. Ganttly check-offs show how many pieces are done.</PbNote>
