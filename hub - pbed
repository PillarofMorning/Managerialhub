            <td className="py-2"><input type="checkbox" checked={w.weekendKey === m.weekend} disabled={props.busy} onChange={function (e: any) { act.saveWo(w, { craa5_weekendkey: e.target.checked ? m.weekend : '' }); }} aria-label={pbT('This weekend')} /></td>
