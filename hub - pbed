                </div>
            </td>
            <td className="py-2 pr-2"><input type="number" inputMode="decimal" min={0} step={0.5} placeholder={pbT('hours')} aria-label={pbT('Planned hours')} className="border border-slate-300 rounded-lg px-2 py-1 text-sm w-20"
                value={hrsState[0]} onChange={function (e: any) { hrsState[1](e.target.value); }}
