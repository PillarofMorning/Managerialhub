                        <button type="button" className="px-3 py-1.5 rounded-lg text-sm font-bold" style={{ background: '#fff', color: PB_NAVY }} onClick={function () { pbCopy(pbDebriefText(m, d), function (ok: boolean) { copiedState[1](ok ? pbT('Copied') : pbT('Copy failed')); }); }}>{pbT('Copy debrief as text')}</button>
