            <label className="block text-sm"><span className="font-bold">{pbT('Notes')}</span><textarea rows={3} className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={v.n} onChange={function (e: any) { set({ s: v.s, e: v.e, n: e.target.value, h: v.h }); }} /></label>
            {v.s !== null && v.e !== null && v.e < v.s && <PbNote tone="warn">{pbT('The end is before the start.')}</PbNote>}
            <div className="flex gap-2 justify-end"><PbBtn onClick={props.onClose}>{pbT('Cancel')}</PbBtn><PbBtn kind="primary" disabled={props.busy || (v.s !== null && v.e !== null && v.e < v.s)} onClick={function () { props.onSave({ actualStart: v.s, actualEnd: v.e, notes: v.n, headcount: v.h }); }}>{pbT('Save')}</PbBtn></div>
        </PbModal>
    );
}
