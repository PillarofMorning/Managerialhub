// ==== PBED EXECUTE TAB ====
// Live: Ganttly check-offs and the Shift Start board are read again every 2 minutes while this tab is open.
// A milestone fills in by itself: started = its first piece started, done = its last piece done once every piece is done.
// Started / Done / Edit typed here win over what was filled in.
var PB_LIVE_MS = 2 * 60000;

function PbSrcTag(props: any) {
    if (props.src !== 'auto') return null;
    return <span className="ml-1 text-[10px] font-bold uppercase tracking-wider px-1 rounded bg-violet-50 text-violet-700 border border-violet-200" title={pbT('Filled in from Ganttly check-offs and the Shift Start board')}>{pbT('auto')}</span>;
}

function PbExecuteTab(props: any) {
    var m = props.m; var act = props.act;
    var nowState = useState(Date.now()); var now = nowState[0];
    var actRef = useRef(act); actRef.current = act;
    useEffect(function () {
        var t = setInterval(function () { nowState[1](Date.now()); }, 60000);
        var r = setInterval(function () { actRef.current.refreshLive(); }, PB_LIVE_MS);
        return function () { clearInterval(t); clearInterval(r); };
    }, []);
    var dbf = pbDebrief(m, now);
    var totPieces = pbSum(m.included, function (l: any) { return l.pieces; });
    var totDone = pbSum(m.included, function (l: any) { return l.done; });
    return (
        <div className="space-y-4">
            <div className="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3">
                <div className="flex-1 min-w-[220px]">
                    <div className="text-[11px] font-bold uppercase tracking-wider text-slate-400">{pbT('Live from Ganttly and Shift Start')}</div>
                    <div className="text-sm text-slate-700">{props.liveAt ? pbT('Read {at}. Reads again every 2 minutes while this tab is open.', { at: pbFmtTime(props.liveAt) }) : pbT('Reading...')}</div>
                </div>
                <div className="text-right">
                    <div className="text-2xl font-black text-slate-800">{pbFmtPct(totDone, totPieces)}</div>
                    <div className="text-xs text-slate-500">{pbT('{d} of {n} pieces done', { d: totDone, n: totPieces })}</div>
                </div>
                <PbBtn onClick={act.refreshLive} disabled={props.liveBusy}><PbIcon name="refresh" />{props.liveBusy ? pbT('Reading...') : pbT('Read now')}</PbBtn>
            </div>
            {dbf.unsavedAuto.length > 0 && (
                <PbNote tone="info">
                    <div className="flex flex-wrap items-center gap-2">
                        <span className="flex-1">{pbTn(dbf.unsavedAuto.length, '{n} time was filled in from Ganttly and Shift Start but is not kept in the plan yet. Keep it so the debrief still has it after Ganttly clears its check-offs.', '{n} times were filled in from Ganttly and Shift Start but are not kept in the plan yet. Keep them so the debrief still has them after Ganttly clears its check-offs.')}</span>
                        <PbBtn kind="primary" disabled={props.busy} onClick={act.keepAuto}>{pbT('Keep these times')}</PbBtn>
                    </div>
                </PbNote>
            )}
            <PbKeyStrip m={m} act={act} now={now} />
            {m.included.map(function (l: any) {
                var s = l.sched; if (!s) return null;
                var ob = m.onBoard(l.key, now);
                var pct = l.pieces ? Math.round(100 * l.done / l.pieces) : 0;
                return (
                    <PbCard key={l.key} title={l.name} right={
                        <div className="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                            {ob ? <span title={pbT('People in this area on the Shift Start board now')}>{pbTn(ob.ids.length, '{n} person on the board now', '{n} people on the board now')}</span> : <span>{pbT('No live Shift Start board now')}</span>}
                            <span className="font-bold text-slate-700">{pbT('{d} of {n} pieces done', { d: l.done, n: l.pieces })}</span>
                        </div>
                    }>
                        <div className="h-2 rounded-full bg-slate-100 overflow-hidden mb-3" aria-label={pbT('{p} percent done', { p: pct })}><div className="h-2 rounded-full" style={{ width: pct + '%', backgroundColor: '#059669' }} /></div>
                        <div className="divide-y divide-slate-100">
                            {s.blocks.map(function (b: any) {
                                var a = m.act[l.key + '|' + b.id] || {};
                                var man = a.manual || null;
                                var st = pbGoalState(b, a, now);
                                var g = b.group;
                                return (
                                    <div key={b.id} className={'flex flex-wrap items-center gap-2 py-2 ' + (b.key ? 'bg-[#FFF6E0] px-2 rounded' : '')}>
                                        <span className="inline-flex items-center gap-1.5 min-w-[200px] flex-1 font-semibold text-slate-800">{b.key ? <PbStar on={true} /> : null}<PbDot dept={b.dept} />{pbBlockName(b)}{g ? <span className="text-xs font-normal text-slate-500">{pbT('{d}/{n} done', { d: g.prog ? g.prog.done : 0, n: g.pieces.length })}</span> : null}</span>
                                        <span className="text-xs text-slate-500 whitespace-nowrap w-[160px]">{pbT('plan')} {pbFmtTime(b.start)} - {pbFmtDayTime(b.end)}</span>
                                        <span className="text-xs whitespace-nowrap w-[160px]">{a.actualStart ? pbT('started {at}', { at: pbFmtDayTime(a.actualStart) }) : ''}<PbSrcTag src={a.startSrc} /></span>
                                        <span className={'text-xs whitespace-nowrap w-[160px] ' + (st === 'hit' ? 'text-emerald-700 font-bold' : st === 'missed' ? 'text-red-700 font-bold' : st === 'overdue' ? 'text-amber-700' : '')}>{a.actualEnd ? pbT('done {at}', { at: pbFmtDayTime(a.actualEnd) }) : st === 'overdue' ? pbT('past its goalpost') : ''}<PbSrcTag src={a.endSrc} /></span>
                                        <PbBtn disabled={props.busy || !!a.actualEnd} onClick={function () { act.actual(l, b, { actualStart: Date.now() }); }}>{man && man.actualStart !== null ? pbT('Restart time') : pbT('Started')}</PbBtn>
                                        <PbBtn kind={a.actualEnd ? 'plain' : 'primary'} disabled={props.busy} onClick={function () { var nowMs = Date.now(); act.actual(l, b, man && man.actualStart !== null ? { actualEnd: nowMs } : { actualStart: a.actualStart || (b.start <= nowMs ? b.start : nowMs - (b.end - b.start)), actualEnd: nowMs }); }}>{pbT('Done')}</PbBtn>
                                        <PbBtn kind="ghost" onClick={function () { act.openActual(l, b); }}>{pbT('Edit')}</PbBtn>
                                    </div>
                                );
                            })}
                        </div>
                    </PbCard>
                );
            })}
            <p className="text-xs text-slate-500">{pbT('Times you press or type save {where}.', { where: props.canSave.milestone ? pbT('to Dataverse (_p_ Milestone)') : pbT('on this computer only, because the _p_ Milestone table was not found') })} {pbT('"auto" = filled in from Ganttly check-offs and the Shift Start board; a time you press or type wins.')}</p>
        </div>
    );
}
function PbActualModal(props: any) {
    var l = props.line; var b = props.block; var a = props.actual || {};
    var st = useState({ s: a.actualStart || null, e: a.actualEnd || null, n: a.notes || '', h: a.headcount === null || a.headcount === undefined ? null : a.headcount });
    var v = st[0]; var set = st[1];
    return (
