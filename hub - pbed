            {a.auto && (a.startSrc === 'auto' || a.endSrc === 'auto') && <PbNote>{pbT('These times were filled in from Ganttly and Shift Start. Saving keeps them in the plan.')}</PbNote>}
            <div className="grid sm:grid-cols-2 gap-3">
                <label className="block text-sm"><span className="font-bold">{pbT('Actual start')}</span><input type="datetime-local" className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={pbToLocalInput(v.s)} onChange={function (e: any) { set({ s: pbFromLocalInput(e.target.value), e: v.e, n: v.n, h: v.h }); }} /></label>
                <label className="block text-sm"><span className="font-bold">{pbT('Actual end')}</span><input type="datetime-local" className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={pbToLocalInput(v.e)} onChange={function (e: any) { set({ s: v.s, e: pbFromLocalInput(e.target.value), n: v.n, h: v.h }); }} /></label>
            </div>
