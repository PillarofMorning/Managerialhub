function pbEnc(s) { return String(s).replace(/%/g, '%25').replace(/&/g, '%26').replace(/#/g, '%23').replace(/\+/g, '%2B'); }
function pbIdCol(table) { return table + 'id'; }

// What an error means for "does this table / column exist".
function pbErrKind(msg) {
