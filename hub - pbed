                        <PbLogo onClick={onLogo} open={devOpen} allowed={devAllowed} />
                        <div>
                            <div className="font-black text-[#00468B] leading-tight" data-welcome="1">{first ? pbT('Welcome, {name}, to the PBED', { name: first }) : pbT('Welcome to the PBED')}</div>
                            <div className="text-[11px] text-slate-500 leading-tight">{pbT('Plan - Brief - Execute - Debrief')} - {pbT('weekend cleans')}</div>
                        </div>
                    </div>
                    <div className="flex flex-wrap items-center gap-1">
                        <PbBtn onClick={function () { shiftWeekend(-1); }} title={pbT('Weekend before')}>{pbT('Prev')}</PbBtn>
                        <input type="date" key={weekend} className="border border-slate-300 rounded-lg px-2 py-1.5 text-sm" defaultValue={weekend} onChange={function (e: any) { var s = pbSatOf(e.target.value); if (s) goWeekend(s); }} aria-label={pbT('Weekend')} />
                        <PbBtn onClick={function () { shiftWeekend(1); }} title={pbT('Weekend after')}>{pbT('Next')}</PbBtn>
                        <span className="text-sm font-bold text-slate-600 ml-1">{pbT('Weekend of {date}', { date: pbFmtDate(m.frame.sat.getTime()) })}{m.secondWeekend ? ' ' + pbT('(2nd of the month)') : ''}</span>
                    </div>
                    <div className="flex-1" />
                    <div className="flex flex-wrap items-center gap-2">
                        <div className="inline-flex rounded-lg border border-slate-300 overflow-hidden" role="group" aria-label={pbT('Language')}>
                            {[['en', 'EN'], ['es', 'ES']].map(function (x: any) { return <button key={x[0]} type="button" data-lang={x[0]} onClick={function () { setLang(x[0]); }} aria-pressed={lang === x[0]} title={x[0] === 'en' ? 'English' : 'Espa' + String.fromCharCode(241) + 'ol (M' + String.fromCharCode(233) + 'xico)'} className={'px-2.5 py-1.5 text-xs font-black ' + (lang === x[0] ? 'bg-[#0072CE] text-white' : 'bg-white text-slate-600 hover:bg-slate-100')}>{x[1]}</button>; })}
                        </div>
                        <PbBtn kind="ghost" onClick={function () { setTheme(dark ? 'light' : 'dark'); }} title={dark ? pbT('Light mode') : pbT('Dark mode')} label={dark ? pbT('Light mode') : pbT('Dark mode')} pressed={dark}><PbIcon name={dark ? 'sun' : 'moon'} size={18} /></PbBtn>
                        {planMeta.dirty ? <PbChip cls="bg-amber-50 text-amber-700 border-amber-200">{pbT('Unsaved changes')}{planMeta.draftAt ? ' ' + pbT('from {at}', { at: pbFmtDayTime(planMeta.draftAt) }) : ''}</PbChip> : planMeta.savedOn ? <PbChip cls="bg-emerald-50 text-emerald-700 border-emerald-200" title={pbT('Version {v}', { v: planMeta.version })}>{pbT('Saved {at}', { at: pbFmtDayTime(planMeta.savedOn) })}{planMeta.savedBy ? ' ' + pbT('by {who}', { who: planMeta.savedBy }) : ''}</PbChip> : <PbChip>{pbT('Not saved yet')}</PbChip>}
                        <PbBtn kind="primary" disabled={busy || !planMeta.dirty || !planReady} onClick={function () { savePlan(false); }}>{busy ? pbT('Saving...') : pbT('Save plan')}</PbBtn>
                    </div>
                </div>
                <nav className="flex gap-1 px-3 pb-2 pb-tabs" style={{ overflowX: 'auto' }} role="tablist">
                    {tabs.map(function (t: any) { return <button key={t[0]} type="button" data-testtab={t[0]} role="tab" aria-selected={shownTab === t[0]} onClick={function () { tabState[1](t[0]); }} className={'px-3 py-1.5 rounded-full text-sm font-bold whitespace-nowrap inline-flex items-center gap-1 ' + (shownTab === t[0] ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]')}>{t[0] === 'setup' || t[0] === 'data' ? <PbIcon name="lock" size={12} /> : null}{pbT(t[1])}</button>; })}
                </nav>
            </header>
            <main className="p-3 sm:p-4 space-y-4 max-w-[1600px] mx-auto">
                {twState[0] === 'failed' && <PbNote tone="warn">{pbT('The page styling (cdn.tailwindcss.com) did not load on this computer, so the page looks plain. Everything still works.')}</PbNote>}
                {noHost && <PbNote tone="bad">{pbT('This page is not connected to Dataverse (no Xrm.WebApi and no dataApi). Open it inside the model-driven app. Nothing below is real data until it is.')}</PbNote>}
                {loadingState[0] && !noHost && <PbNote>{pbT('Reading equipment, shifts and employees from Dataverse...')}</PbNote>}
                {problems.map(function (p: string, i: number) { return <PbNote key={i} tone="warn">{p}</PbNote>; })}
                {msg && <PbNote tone={msg.tone}><div className="flex items-start gap-2"><span className="flex-1">{msg.text}</span><button type="button" className="font-bold" onClick={function () { setMsg(null); }}>{pbT('Dismiss')}</button></div></PbNote>}
                {devOpen && (!config.devUsers || !config.devUsers.length) && shownTab !== 'setup' && <PbNote tone="warn"><div className="flex flex-wrap items-center gap-2"><span className="flex-1">{pbT('The developer tools are not locked to anyone yet. Lock them on Setup.')}</span><PbBtn onClick={function () { tabState[1]('setup'); }}>{pbT('Open Setup')}</PbBtn></div></PbNote>}
                {planMeta.draftAt && planMeta.dirty && <PbNote tone="warn"><div className="flex flex-wrap items-center gap-2"><span className="flex-1">{pbT('These are unsaved changes kept on this computer from {at}', { at: pbFmtDayTime(planMeta.draftAt) })}{planMeta.savedOn ? ', ' + pbT('newer than the plan saved {at}', { at: pbFmtDayTime(planMeta.savedOn) }) : ''}.</span><PbBtn onClick={function () { pbDropLocal('pb_draft_' + weekend); reloadState[1](reloadState[0] + 1); }}>{pbT('Throw them away')}</PbBtn></div></PbNote>}
                {shownTab === 'plan' && <PbPlanTab m={m} act={act} plan={plan} />}
                {shownTab === 'brief' && <PbBriefTab m={m} act={act} plan={plan} busy={busy} />}
                {shownTab === 'execute' && <PbExecuteTab key={weekend} m={m} act={act} busy={busy} canSave={canSave} liveAt={liveState[0].at} liveBusy={liveState[0].busy} />}
                {shownTab === 'debrief' && <PbDebriefTab m={m} act={act} busy={busy} canSave={canSave} />}
                {shownTab === 'workorders' && <PbWorkOrdersTab m={m} act={act} busy={busy} canSave={canSave} />}
                {shownTab === 'crew' && <PbCrewTab m={m} act={act} expState={expNoteState[0]} />}
                {shownTab === 'setup' && <PbSetupTab m={m} act={act} config={config} busy={busy} configDirty={configMetaState[0].dirty} canSave={canSave} user={user} />}
                {shownTab === 'data' && <PbDataTab data={data} probes={probes} dataApi={dataApi} busy={busy} onReload={function () { pbDropLocal(PB_EXP_CACHE); reloadState[1](reloadState[0] + 1); }} />}
            </main>
            {mdl && mdl.type === 'sub' && ml && mb && <PbSubModal m={m} line={ml} block={mb} act={act} plan={plan} exp={exp} onClose={close} />}
            {mdl && mdl.type === 'mnt' && ml && <PbMntModal m={m} line={ml} block={mb} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'step' && ml && mb && <PbStepModal line={ml} block={mb} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'line' && ml && <PbLineModal line={ml} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'slot' && ms && <PbSlotModal m={m} slot={ms} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'person' && <PbPersonModal m={m} id={mdl.id} exp={exp} onClose={close} />}
            {mdl && mdl.type === 'actual' && ml && mb && <PbActualModal line={ml} block={mb} actual={m.act[ml.key + '|' + mb.id]} busy={busy} onClose={close} onSave={function (p: any) { saveActual(ml, mb, p); close(); }} />}
            {mdl && mdl.type === 'conflict' && (
                <PbModal title={pbT('Someone saved this plan after you opened it')} sub={pbT('Version {v}', { v: mdl.version }) + (mdl.by ? ' ' + pbT('by {who}', { who: mdl.by }) : '')} onClose={close}>
                    <p className="text-sm text-slate-600">{pbT('Saving now would replace their changes with yours.')}</p>
                    <div className="flex flex-wrap gap-2 justify-end">
                        <PbBtn onClick={function () { pbDropLocal('pb_draft_' + weekend); close(); reloadState[1](reloadState[0] + 1); }}>{pbT('Load theirs (drop mine)')}</PbBtn>
                        <PbBtn kind="danger" onClick={function () { close(); savePlan(true, mdl.version); }}>{pbT('Save mine over theirs')}</PbBtn>
                    </div>
                </PbModal>
            )}
        </div>
    );
}
// ==== END PBED APP ====
