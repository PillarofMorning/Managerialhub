function PbDebriefTab(props: any) {
    var m = props.m; var act = props.act;
    var formState = useState({ area: '', step: '', dept: 'Sanitation', reason: PB_LOSS_REASONS[0], minutes: null, heads: null, text: '' });
    var f: any = formState[0]; var setF = formState[1];
    var copiedState = useState('');
    function upd(k: string, v: any) { var n = pbClone(f); n[k] = v; setF(n); }
    var rows: any[] = []; var overrunMin = 0;
    m.included.forEach(function (l: any) {
        if (!l.sched) return;
        l.sched.blocks.forEach(function (b: any) {
            var a = m.actuals[l.key + '|' + b.id];
            var varMin = a && a.actualEnd ? (a.actualEnd - b.end) / PB_MIN : null;
            var durVar = a && a.actualEnd && a.actualStart ? ((a.actualEnd - a.actualStart) - (b.end - b.start)) / PB_MIN : null;
            rows.push({ l: l, b: b, a: a, varMin: varMin, durVar: durVar });
            if (durVar && durVar > 0 && b.dept === 'SAN') overrunMin += durVar * (a.headcount || b.hc || 1);
        });
    });
    var losses = m.losses;
    var lossMin = pbSum(losses, function (x: any) { return x.minutes; });
    var lossHeadMin = pbSum(losses, function (x: any) { return x.minutes * (x.heads || 1); });
    var byReason: any = {}; losses.forEach(function (x: any) { byReason[x.reason || 'Other'] = (byReason[x.reason || 'Other'] || 0) + x.minutes * (x.heads || 1); });
    var idle = pbSum(m.use, function (u: any) { return u.idleHours || 0; });
    // The biggest costs of the weekend, largest first (people-hours; dollars when a labor rate is set).
    var costs: any[] = [];
    pbKeys(byReason).forEach(function (k: string) { costs.push({ what: 'Time loss: ' + k, hours: byReason[k] / 60 }); });
    rows.forEach(function (r: any) { if (r.durVar && r.durVar > 15 && r.b.dept === 'SAN') costs.push({ what: 'Overran: ' + r.l.name + ' - ' + pbBlockLabel(r.b), hours: r.durVar * (r.a.headcount || r.b.hc || 1) / 60 }); });
    if (idle > 0) costs.push({ what: 'People on shift but not booked on a weekend clean', hours: idle });
    costs.sort(function (a: any, b: any) { return b.hours - a.hours; });
    var lineFinish = m.included.map(function (l: any) {
        var ends = rows.filter(function (r: any) { return r.l.key === l.key && r.a && r.a.actualEnd && r.b.anchor !== 'restart'; }).map(function (r: any) { return r.a.actualEnd; });
        return { l: l, actual: ends.length ? Math.max.apply(null, ends) : null };
    });
    function debriefText() {
        var out = ['PBED debrief - weekend of ' + pbFmtDate(m.frame.sat.getTime())];
        lineFinish.forEach(function (x: any) { out.push(x.l.name + ': planned done ' + pbFmtDayTime(x.l.sched.finish) + ', actual ' + (x.actual ? pbFmtDayTime(x.actual) : 'not recorded') + ', restart ' + pbFmtDayTime(x.l.restart)); });
        out.push(''); out.push('Time lost: ' + pbFmtHours(lossMin) + ' (' + pbFmtNum(lossHeadMin / 60, 1) + ' people-hours)');
        losses.forEach(function (x: any) { out.push('  - ' + x.area + ' ' + (x.step || '') + ': ' + x.reason + ', ' + pbFmtHours(x.minutes) + (x.heads > 1 ? ' x ' + x.heads + ' people' : '') + (x.description ? ' - ' + x.description : '')); });
        out.push(''); out.push('Biggest costs:');
        costs.slice(0, 8).forEach(function (c: any) { out.push('  - ' + c.what + ': ' + pbFmtNum(c.hours, 1) + ' people-hours' + (m.rate !== null ? ' (' + pbFmtMoney(c.hours * m.rate) + ')' : '')); });
        return out.join('\n');
    }
    return (
        <div className="space-y-4">
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                <PbStat label="Time lost" value={pbFmtHours(lossMin)} sub={pbFmtNum(lossHeadMin / 60, 1) + ' people-hours'} tone={lossMin ? 'warn' : 'good'} />
                <PbStat label="Overruns" value={pbFmtNum(overrunMin / 60, 1) + ' h'} sub="people-hours over plan" tone={overrunMin ? 'warn' : 'good'} />
                <PbStat label="Planned labor" value={pbFmtNum(m.laborMin / 60, 1) + ' h'} sub={m.cost !== null ? pbFmtMoney(m.cost) : 'no labor rate set'} />
                <PbStat label="Hours not used" value={m.slotsOk ? pbFmtNum(idle, 1) + ' h' : '--'} sub="on shift, not booked" />
            </div>
            <PbCard title="Lines: plan against actual" right={<PbBtn kind="primary" onClick={function () { pbCopy(debriefText(), function (ok: boolean) { copiedState[1](ok ? 'Copied' : 'Copy failed'); }); }}>Copy debrief as text</PbBtn>}>
                {copiedState[0] && <PbNote className="mb-3">{copiedState[0]}</PbNote>}
                <div className="overflow-x-auto">
                    <table className="w-full text-sm">
                        <thead><tr className="text-left text-[11px] uppercase tracking-wider text-slate-400"><th className="py-1 pr-2">Line</th><th className="py-1 pr-2">Milestone</th><th className="py-1 pr-2">Planned end</th><th className="py-1 pr-2">Actual end</th><th className="py-1 text-right">Off by</th></tr></thead>
                        <tbody>{rows.filter(function (r: any) { return r.b.kind !== 'step' || r.a; }).map(function (r: any) {
                            return <tr key={r.l.key + r.b.id} className="border-t border-slate-100"><td className="py-1.5 pr-2 font-semibold">{r.l.name}</td><td className="py-1.5 pr-2">{pbBlockLabel(r.b)}</td><td className="py-1.5 pr-2 whitespace-nowrap">{pbFmtDayTime(r.b.end)}</td><td className="py-1.5 pr-2 whitespace-nowrap">{r.a && r.a.actualEnd ? pbFmtDayTime(r.a.actualEnd) : <span className="text-slate-400">not recorded</span>}</td><td className={'py-1.5 text-right whitespace-nowrap ' + (r.varMin > 0 ? 'text-red-700 font-bold' : r.varMin !== null ? 'text-emerald-700' : '')}>{r.varMin === null ? '' : (r.varMin > 0 ? '+' : '') + pbFmtHours(r.varMin)}</td></tr>;
                        })}</tbody>
                    </table>
                </div>
            </PbCard>
            <PbCard title="Time loss">
                <div className="grid md:grid-cols-3 gap-3">
                    <label className="block text-sm"><span className="font-bold">Line</span><select className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={f.area} onChange={function (e: any) { upd('area', e.target.value); }}><option value="">Pick a line</option>{m.included.map(function (l: any) { return <option key={l.key} value={l.key}>{l.name}</option>; })}</select></label>
                    <label className="block text-sm"><span className="font-bold">Milestone</span><select className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={f.step} onChange={function (e: any) { upd('step', e.target.value); }}><option value="">Whole line</option>{(m.included.filter(function (l: any) { return l.key === f.area; })[0] || { sched: { blocks: [] } }).sched.blocks.map(function (b: any) { return <option key={b.id} value={b.id}>{pbBlockLabel(b)}</option>; })}</select></label>
                    <label className="block text-sm"><span className="font-bold">Department responsible</span><select className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={f.dept} onChange={function (e: any) { upd('dept', e.target.value); }}>{PB_LOSS_DEPTS.map(function (d: string) { return <option key={d}>{d}</option>; })}</select></label>
                    <label className="block text-sm"><span className="font-bold">Reason</span><select className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={f.reason} onChange={function (e: any) { upd('reason', e.target.value); }}>{PB_LOSS_REASONS.map(function (d: string) { return <option key={d}>{d}</option>; })}</select></label>
                    <label className="block text-sm"><span className="font-bold">Minutes lost</span><PbNumInput className="mt-1 block w-full" value={f.minutes} min={0} step={5} onChange={function (v: any) { upd('minutes', v); }} label="Minutes lost" /></label>
                    <label className="block text-sm"><span className="font-bold">People waiting</span><PbNumInput className="mt-1 block w-full" value={f.heads} min={1} placeholder="1" onChange={function (v: any) { upd('heads', v); }} label="People" /></label>
                </div>
                <label className="block text-sm mt-3"><span className="font-bold">What happened</span><textarea rows={2} className="mt-1 block w-full border border-slate-300 rounded-lg px-2 py-1.5" value={f.text} onChange={function (e: any) { upd('text', e.target.value); }} /></label>
                <div className="flex flex-wrap items-center gap-2 mt-3">
                    <PbBtn kind="primary" disabled={!f.area || !f.minutes || props.busy} onClick={function () { act.addLoss(f, function () { setF({ area: f.area, step: '', dept: f.dept, reason: f.reason, minutes: null, heads: null, text: '' }); }); }}>Add time loss</PbBtn>
                    <span className="text-xs text-slate-500">{props.canSave.timeloss ? 'Saved to the time loss log the manager hub reads (kind "Weekend clean").' : 'The time loss log table was not found: entries stay on this computer.'}</span>
                </div>
                {losses.length > 0 && (
                    <table className="w-full text-sm mt-4">
                        <thead><tr className="text-left text-[11px] uppercase tracking-wider text-slate-400"><th className="py-1 pr-2">Line</th><th className="py-1 pr-2">Milestone</th><th className="py-1 pr-2">Reason</th><th className="py-1 pr-2">Dept</th><th className="py-1 pr-2 text-right">Lost</th><th className="py-1"></th></tr></thead>
                        <tbody>{losses.map(function (x: any) { return <tr key={x.id} className="border-t border-slate-100 align-top"><td className="py-1.5 pr-2 font-semibold">{x.area}</td><td className="py-1.5 pr-2">{x.step}</td><td className="py-1.5 pr-2">{x.reason}{x.description ? <div className="text-xs text-slate-500">{x.description}</div> : null}</td><td className="py-1.5 pr-2">{x.dept}</td><td className="py-1.5 pr-2 text-right whitespace-nowrap">{pbFmtHours(x.minutes)}{x.heads > 1 ? ' x ' + x.heads : ''}</td><td className="py-1.5 text-right"><button type="button" className="text-xs font-bold text-red-700 hover:underline" onClick={function () { act.removeLoss(x); }}>Remove</button></td></tr>; })}</tbody>
                    </table>
                )}
            </PbCard>
            <PbCard title="Biggest costs this weekend">
                {costs.length === 0 ? <p className="text-sm text-slate-500">Nothing yet: record actual times on Execute and time loss above.</p> : (
                    <table className="w-full text-sm"><tbody>{costs.slice(0, 10).map(function (c: any, i: number) { return <tr key={i} className="border-t border-slate-100"><td className="py-1.5 pr-2">{c.what}</td><td className="py-1.5 pr-2 text-right whitespace-nowrap">{pbFmtNum(c.hours, 1)} people-hours</td><td className="py-1.5 text-right whitespace-nowrap font-bold">{m.rate !== null ? pbFmtMoney(c.hours * m.rate) : ''}</td></tr>; })}</tbody></table>
                )}
                {m.rate === null && <p className="text-xs text-slate-500 mt-2">Set an hourly labor rate on Setup to see dollars.</p>}
            </PbCard>
        </div>
    );
}

