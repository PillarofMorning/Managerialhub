                                        <PbBtn disabled={props.busy} onClick={function () { act.actual(l, b, { actualStart: Date.now() }); }}>{a && a.actualStart ? 'Restart time' : 'Started'}</PbBtn>
                                        <PbBtn kind={a && a.actualEnd ? 'plain' : 'primary'} disabled={props.busy} onClick={function () { act.actual(l, b, a && a.actualStart ? { actualEnd: Date.now() } : { actualStart: b.start, actualEnd: Date.now() }); }}>Done</PbBtn>
                                        <PbBtn kind="ghost" onClick={function () { act.openActual(l, b); }}>Edit</PbBtn>
                                    </div>
