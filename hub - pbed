function pbReadLocal(key, dflt) { try { var raw = window.localStorage.getItem(key); return raw ? JSON.parse(raw) : dflt; } catch (e) { return dflt; } }
function pbWriteLocal(key, val) { try { window.localStorage.setItem(key, JSON.stringify(val)); return true; } catch (e) { return false; } }
function pbDropLocal(key) { try { window.localStorage.removeItem(key); } catch (e) { /* storage blocked */ } }
function pbReadSession(key) { try { return window.sessionStorage.getItem(key); } catch (e) { return null; } }
function pbWriteSession(key, v) { try { if (v === null) window.sessionStorage.removeItem(key); else window.sessionStorage.setItem(key, v); } catch (e) { /* storage blocked */ } }

function pbClone(o) { return o === undefined ? undefined : JSON.parse(JSON.stringify(o)); }
function pbErrText(e) {
    if (!e) return 'Unknown error';
    var m = e.message || e.errorMessage || (e.error && e.error.message) || (typeof e === 'string' ? e : '');
    if (!m) { try { m = JSON.stringify(e).slice(0, 200); } catch (x) { m = String(e); } }
    return String(m).replace(/[^\x20-\x7E]/g, ' ').slice(0, 300);
}
// Reads a column from a Xrm or dataApi row: formatted value first only when asked, then the raw value, then a key in any case.
function pbField(row, name, formatted) {
    if (!row) return undefined;
    if (formatted) { var f = row[name + '@OData.Community.Display.V1.FormattedValue']; if (f !== undefined && f !== null && f !== '') return f; }
    if (row[name] !== undefined) return row[name];
    var low = name.toLowerCase();
    for (var k in row) { if (Object.prototype.hasOwnProperty.call(row, k) && k.toLowerCase() === low) return row[k]; }
    return undefined;
}
