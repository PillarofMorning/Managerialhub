    function setHc(v: number) { var hc = pbClone(p.hc); if (v === defHc) delete hc[g.key]; else hc[g.key] = v; act.line(l.key, { hc: hc }); }
    function toggleAsset(id: string) { var ex = exclude.slice(); var i = ex.indexOf(id); if (i >= 0) ex.splice(i, 1); else ex.push(id); act.line(l.key, { exclude: ex }); }
    function togglePerson(id: string) { var all = pbClone(p.people); var list = (all[g.key] || []).slice(); var i = list.indexOf(id); if (i >= 0) list.splice(i, 1); else list.push(id); all[g.key] = list; act.line(l.key, { people: all }); }
