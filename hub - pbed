function pbCopy(text: string, done: any) {
    function legacy() { try { var ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); var ok = document.execCommand('copy'); document.body.removeChild(ta); done(ok); } catch (e2) { done(false); } }
    try {
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(function () { done(true); }, legacy); return; }
    } catch (e) { /* fall through */ }
    legacy();
}
// Shown when copying is refused (some Power Apps frames block the clipboard): the text, ready to select and copy by hand.
function PbCopyBox(props: any) {
    if (!props.text) return null;
    return <textarea readOnly rows={10} className="w-full text-xs font-mono border border-slate-300 rounded-lg p-2 mb-3 pb-noprint" value={props.text} onFocus={function (e: any) { e.target.select(); }} aria-label={pbT('Copy brief as text')} />;
}

// The steps before and after the sanitation milestones (handoff, FSQ inspect, swab, preflight, 1st pie).
// props: { pre, tail, onChange(listName, newList) }. Used on Brief (this weekend) and on Setup (the default for every weekend).
function PbPresetEditor(props: any) {
    function edit(list: string, i: number, k: string, v: any) { var arr = pbClone(props[list]); arr[i][k] = v; props.onChange(list, arr); }
    function move(list: string, i: number, d: number) { var arr = pbClone(props[list]); var j = i + d; if (j < 0 || j >= arr.length) return; var t = arr[i]; arr[i] = arr[j]; arr[j] = t; props.onChange(list, arr); }
    function del(list: string, i: number) { var arr = pbClone(props[list]); arr.splice(i, 1); props.onChange(list, arr); }
    function add(list: string) { var arr = pbClone(props[list]); arr.push({ id: 's' + Date.now().toString(36), dept: 'FSQ', name: 'New step', anchor: list === 'pre' ? 'stop' : 'chain', offset: 0, minutes: 60, hc: 0, key: false }); props.onChange(list, arr); }
    function table(list: string, title: string) {
        return (
            <div className="space-y-2">
                <div className="flex items-center gap-2"><h4 className="text-sm font-black text-slate-700 flex-1">{title}</h4><PbBtn onClick={function () { add(list); }}>{pbT('Add a step')}</PbBtn></div>
                {props[list].length === 0 && <p className="text-sm text-slate-500">{pbT('None.')}</p>}
                {props[list].map(function (st: any, i: number) {
                    return (
                        <div key={st.id} className="flex flex-wrap items-center gap-2 border-b border-slate-100 pb-2" data-preset={st.id}>
                            <PbStar on={!!st.key} onClick={function () { edit(list, i, 'key', !st.key); }} />
                            <select className="border border-slate-300 rounded px-1 py-1 text-xs" value={st.dept} onChange={function (e: any) { edit(list, i, 'dept', e.target.value); }} aria-label={pbT('Department')}>{PB_DEPTS.map(function (d: string) { return <option key={d} value={d}>{d}</option>; })}</select>
                            <PbTextSave className="flex-1 min-w-[180px]" value={pbTName(st.name)} onSave={function (v: string) { edit(list, i, 'name', v); }} label={pbT('Step name')} />
                            <select className="border border-slate-300 rounded px-1 py-1 text-xs" value={st.anchor} onChange={function (e: any) { edit(list, i, 'anchor', e.target.value); }} aria-label={pbT('Starts')}>
                                <option value="stop">{pbT('at the stop, plus')}</option><option value="chain">{pbT('after the step before, plus')}</option><option value="restart">{pbT('at the restart, plus')}</option>
                            </select>
                            <PbNumInput value={st.offset} step={15} onChange={function (v: any) { edit(list, i, 'offset', v); }} label={pbT('Offset minutes')} className="w-20" /><span className="text-xs text-slate-500">{pbT('min, lasts')}</span>
                            <PbNumInput value={st.minutes} min={0} step={15} onChange={function (v: any) { edit(list, i, 'minutes', v || 0); }} label={pbT('Minutes')} className="w-20" /><span className="text-xs text-slate-500">{pbT('min')}</span>
                            {st.dept === 'SAN' && <span className="inline-flex items-center gap-1 text-xs text-slate-500"><PbNumInput value={st.hc} min={0} onChange={function (v: any) { edit(list, i, 'hc', v || 0); }} label={pbT('People')} className="w-16" />{pbT('people')}</span>}
                            <PbBtn kind="ghost" onClick={function () { move(list, i, -1); }} title={pbT('Move up')}>{pbT('Up')}</PbBtn>
                            <PbBtn kind="ghost" onClick={function () { move(list, i, 1); }} title={pbT('Move down')}>{pbT('Down')}</PbBtn>
                            <PbBtn kind="danger" onClick={function () { del(list, i); }}>{pbT('Remove')}</PbBtn>
                        </div>
                    );
                })}
            </div>
        );
    }
    return (
        <div className="space-y-4">
            {table('pre', pbT('Before the sanitation milestones'))}
            {table('tail', pbT('After the sanitation milestones'))}
        </div>
    );
}

