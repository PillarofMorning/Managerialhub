                        <input type="date" className="border border-slate-300 rounded-lg px-2 py-1.5 text-sm" value={weekend} onChange={function (e: any) { var s = pbSatOf(e.target.value); if (s) { setWeekend(s); setModal(null); } }} aria-label="Weekend" />
                        <PbBtn onClick={function () { shiftWeekend(1); }} title="Weekend after">Next</PbBtn>
                        <span className="text-sm font-bold text-slate-600 ml-1">Weekend of {pbFmtDate(m.frame.sat.getTime())}{m.secondWeekend ? ' (2nd of the month)' : ''}</span>
                    </div>
                    <div className="flex-1" />
                    <div className="flex items-center gap-2">
                        {planMeta.dirty ? <PbChip cls="bg-amber-50 text-amber-700 border-amber-200">Unsaved changes{planMeta.draftAt ? ' from ' + pbFmtDayTime(planMeta.draftAt) : ''}</PbChip> : planMeta.savedOn ? <PbChip cls="bg-emerald-50 text-emerald-700 border-emerald-200" title={'Version ' + planMeta.version}>Saved {pbFmtDayTime(planMeta.savedOn)}{planMeta.savedBy ? ' by ' + planMeta.savedBy : ''}</PbChip> : <PbChip>Not saved yet</PbChip>}
                        <PbBtn kind="primary" disabled={busy || !planMeta.dirty} onClick={function () { savePlan(false); }}>{busy ? 'Saving...' : 'Save plan'}</PbBtn>
                    </div>
                </div>
                <nav className="flex gap-1 px-3 pb-2 overflow-x-auto pb-tabs" role="tablist">
                    {PB_TABS.map(function (t: any) { return <button key={t[0]} type="button" data-testtab={t[0]} role="tab" aria-selected={tab === t[0]} onClick={function () { tabState[1](t[0]); }} className={'px-3 py-1.5 rounded-full text-sm font-bold whitespace-nowrap ' + (tab === t[0] ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]')}>{t[1]}</button>; })}
                </nav>
            </header>
            <main className="p-3 sm:p-4 space-y-4 max-w-[1600px] mx-auto">
                {noHost && <PbNote tone="bad">This page is not connected to Dataverse (no Xrm.WebApi and no dataApi). Open it inside the model-driven app. Nothing below is real data until it is.</PbNote>}
                {loadingState[0] && !noHost && <PbNote>Reading equipment, shifts and employees from Dataverse...</PbNote>}
                {problems.map(function (p: string, i: number) { return <PbNote key={i} tone="warn">{p}</PbNote>; })}
                {msg && <PbNote tone={msg.tone}><div className="flex items-start gap-2"><span className="flex-1">{msg.text}</span><button type="button" className="font-bold" onClick={function () { setMsg(null); }}>Dismiss</button></div></PbNote>}
                {planMeta.draftAt && planMeta.dirty && <PbNote tone="warn"><div className="flex flex-wrap items-center gap-2"><span className="flex-1">These are unsaved changes kept on this computer from {pbFmtDayTime(planMeta.draftAt)}{planMeta.savedOn ? ', newer than the plan saved ' + pbFmtDayTime(planMeta.savedOn) : ''}.</span><PbBtn onClick={function () { pbDropLocal('pb_draft_' + weekend); reloadState[1](reloadState[0] + 1); }}>Throw them away</PbBtn></div></PbNote>}
                {tab === 'plan' && <PbPlanTab m={m} act={act} plan={plan} />}
                {tab === 'brief' && <PbBriefTab m={m} act={act} plan={plan} />}
                {tab === 'execute' && <PbExecuteTab m={m} act={act} busy={busy} canSave={canSave} />}
                {tab === 'debrief' && <PbDebriefTab m={m} act={act} busy={busy} canSave={canSave} />}
                {tab === 'workorders' && <PbWorkOrdersTab m={m} act={act} busy={busy} canSave={canSave} />}
                {tab === 'crew' && <PbCrewTab m={m} act={act} expState={expNoteState[0]} />}
                {tab === 'setup' && <PbSetupTab m={m} act={act} config={config} busy={busy} configDirty={configMetaState[0].dirty} canSave={canSave} />}
                {tab === 'data' && <PbDataTab data={data} probes={probes} dataApi={dataApi} busy={busy} onReload={function () { pbDropLocal(PB_EXP_CACHE); reloadState[1](reloadState[0] + 1); }} />}
            </main>
            {mdl && mdl.type === 'sub' && ml && mb && <PbSubModal m={m} line={ml} block={mb} act={act} plan={plan} exp={exp} onClose={close} />}
            {mdl && mdl.type === 'mnt' && ml && <PbMntModal m={m} line={ml} block={mb} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'step' && ml && mb && <PbStepModal line={ml} block={mb} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'line' && ml && <PbLineModal line={ml} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'slot' && ms && <PbSlotModal m={m} slot={ms} act={act} plan={plan} onClose={close} />}
            {mdl && mdl.type === 'person' && <PbPersonModal m={m} id={mdl.id} exp={exp} onClose={close} />}
            {mdl && mdl.type === 'actual' && ml && mb && <PbActualModal line={ml} block={mb} actual={m.actuals[ml.key + '|' + mb.id]} busy={busy} onClose={close} onSave={function (p: any) { saveActual(ml, mb, p); close(); }} />}
            {mdl && mdl.type === 'conflict' && (
                <PbModal title="Someone saved this plan after you opened it" sub={'Version ' + mdl.version + (mdl.by ? ' by ' + mdl.by : '')} onClose={close}>
                    <p className="text-sm text-slate-600">Saving now would replace their changes with yours.</p>
                    <div className="flex flex-wrap gap-2 justify-end">
                        <PbBtn onClick={function () { pbDropLocal('pb_draft_' + weekend); close(); reloadState[1](reloadState[0] + 1); }}>Load theirs (drop mine)</PbBtn>
                        <PbBtn kind="danger" onClick={function () { close(); savePlan(true, mdl.version); }}>Save mine over theirs</PbBtn>
                    </div>
                </PbModal>
            )}
        </div>
    );
}
// ==== END PBED APP ====
