                <div className="flex gap-1">{[['weekend', pbT('This weekend')], ['unmapped', pbT('Needs equipment')], ['all', pbT('All')]].map(function (o: any) { return <PbBtn key={o[0]} kind={filterState[0] === o[0] ? 'primary' : 'plain'} onClick={function () { filterState[1](o[0]); }}>{o[1]}</PbBtn>; })}</div>
            }>
                {!props.canSave.workorder && <PbNote tone="warn" className="mb-3">{pbT('The _p_ Work order table was not found, so work orders are kept on this computer only. Make the table from the prompts (Data tab).')}</PbNote>}
                {list.length === 0 ? <p className="text-sm text-slate-500">{pbT('None here.')}</p> : (
                    <div style={{ overflowX: 'auto' }}>
                        <table className="w-full text-sm">
                            <thead><tr className="text-left text-[11px] uppercase tracking-wider text-slate-400"><th className="py-1 pr-2">{pbT('Order')}</th><th className="py-1 pr-2">{pbT('Pri')}</th><th className="py-1 pr-2">{pbT('What')}</th><th className="py-1 pr-2">{pbT('SAP asset and location')}</th><th className="py-1 pr-2">{pbT('Equipment in the plan')}</th><th className="py-1 pr-2">{pbT('Hours')}</th><th className="py-1">{pbT('This weekend')}</th></tr></thead>
