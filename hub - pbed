// Setup and Data are developer tools: shown after the logo is clicked by an account on the developer list.
function PbSetupTab(props: any) {
    var cfg = props.config; var act = props.act; var m = props.m; var user = props.user || {};
    var emailState = useState('');
    function setCfg(patch: any) { var n = pbClone(cfg); pbKeys(patch).forEach(function (k: string) { n[k] = patch[k]; }); act.config(n); }
    var order = (cfg.lineOrder || []).slice();
    m.lines.forEach(function (l: any) { if (order.indexOf(l.key) < 0 && l.include) order.push(l.key); });
    function moveLine(i: number, d: number) { var arr = order.slice(); var j = i + d; if (j < 0 || j >= arr.length) return; var t = arr[i]; arr[i] = arr[j]; arr[j] = t; setCfg({ lineOrder: arr }); }
    var devs = cfg.devUsers || [];
    var meListed = devs.some(function (d: any) { return (d.id && d.id === user.id) || (d.email && user.email && d.email === user.email); });
    // A list that does not include you would shut you out of Setup before you could save it: adding someone else adds you too,
    // and nothing is locked when your own account could not be read.
    var meKnown = !!(user.id || user.email);
    function addDev(d: any) { var list = devs.slice(); if (!pbIsDev(user, list.concat([d]))) { if (!meKnown) return; list.push({ id: user.id, email: user.email, name: user.name }); } list.push(d); setCfg({ devUsers: list }); }
    function canDrop(i: number) { var rest = devs.filter(function (x: any, j: number) { return j !== i; }); return pbIsDev(user, rest); }
    function dropDev(i: number) { var list = devs.slice(); list.splice(i, 1); setCfg({ devUsers: list }); }
    return (
        <div className="space-y-4">
            <PbNote>{pbT('Setup applies to every weekend and every line.')} {props.canSave.plan ? pbT('It is saved to the _p_ Plan table (row "config") when you press Save setup.') : pbT('The _p_ Plan table was not found, so setup is kept on this computer.')}</PbNote>
            <PbCard title={pbT('Developer access')} icon={<PbIcon name="lock" />} right={<PbBtn kind="primary" disabled={props.busy || !props.configDirty} onClick={act.saveConfig}>{props.configDirty ? pbT('Save setup') : pbT('Setup saved')}</PbBtn>}>
                <p className="text-sm text-slate-600 mb-2">{pbT('Setup and Data open only when one of these Microsoft accounts clicks the logo. It hides the tools on this page; what each person can change in Dataverse is still set by their security role.')}</p>
                {devs.length === 0 && <PbNote tone="warn" className="mb-2">{pbT('Not locked yet: anyone who clicks the logo can open Setup and Data. Add yourself to lock it.')}</PbNote>}
                <ul className="space-y-1 mb-3">
                    {devs.map(function (d: any, i: number) { return <li key={i} className="flex items-center gap-2 text-sm"><span className="flex-1"><b>{d.name || d.email || d.id}</b> <span className="text-xs text-slate-500">{d.email}</span></span><PbBtn kind="danger" disabled={!canDrop(i)} onClick={function () { dropDev(i); }} title={pbT('Remove')}>{pbT('Remove')}</PbBtn></li>; })}
                </ul>
                <div className="flex flex-wrap items-center gap-2">
                    {!meListed && (user.id || user.email) && <PbBtn kind="primary" onClick={function () { addDev({ id: user.id, email: user.email, name: user.name }); }}>{pbT('Add me ({who})', { who: user.name || user.email })}</PbBtn>}
