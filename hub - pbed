function PbWorkOrdersTab(props: any) {
    var m = props.m; var act = props.act;
    var textState = useState(''); var parsedState = useState(null); var filterState = useState('weekend');
    var parsed: any = parsedState[0];
    var areaKeys = pbKeys(m.areas).sort();
