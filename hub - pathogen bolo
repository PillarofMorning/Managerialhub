              </div>
              <p className={`text-xs mt-0.5 ${theme.textMuted}`}>
                Strict separation between true Pathogen positives and sanitation/hygiene indicator failures (APC & ATP). Click any card or filter below to isolate.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-1.5 text-xs">
              <select
                value={sepSideFilter}
                onChange={e => setSepSideFilter(e.target.value)}
