  // --- MERGE ALL HITS (lab rows + email lines not in the lab rows + custom entries), SORTED, WITH SITE COORDINATES ---
  const allHits = useMemo(() => {
    const combined = emailLabMatch.emailOnly.concat(customHits).concat(parsedCsv.hits);
    const seenHitKeys = {};
    const dedupedHits = [];

    for (let i = 0; i < combined.length; i += 1) {
      const hit = combined[i];
      const effectiveDate = dateOverrides[hit.id] || hit.date || '';
      let matchedSite = hit.siteCode ? siteByCode[hit.siteCode] : null;
      if (!matchedSite) {
        matchedSite = matchSiteFromCatalog(hit.room, hit.surface, hit.description, fullSiteCatalog, roomAliases);
      }
      const siteCode = hit.siteCode || (matchedSite ? matchedSite.siteCode : '');
      const assetTag = hit.assetTag || (matchedSite ? matchedSite.assetTag : '');
      const timingStage = hit.timingStage || (hit.stage === 'ST' || hit.stage === 'INP' ? hit.stage : '');

      // Each hit is one lab row or one email line (ids are unique per row): only an exact repeat is dropped
      if (seenHitKeys[hit.id]) continue;
      seenHitKeys[hit.id] = true;

      const fullSite = siteCode ? siteByCode[siteCode] : null;
      const matchedArea = getFacilityAreaByRoom(facilityAreas, hit.room);
      const hasActiveDrawnArea = !!(matchedArea && !matchedArea.isRemoved && !matchedArea.hidden && matchedArea.hasDrawnBoundary && Array.isArray(matchedArea.box) && matchedArea.box.length === 4);
      const areaBox = hasActiveDrawnArea ? matchedArea.box : null;
      const effectiveSpot = fullSite
        ? fullSite.effectiveSpot
        : (roomMappings[hit.room] || (areaBox ? {
            x: areaBox[0] + areaBox[2] / 2,
            y: areaBox[1] + areaBox[3] / 2,
            box: areaBox,
            snapped: true,
            how: 'room'
          } : {
            x: 50,
            y: 50,
            box: null,
            snapped: false,
            how: 'unmapped'
          }));
      const isCustomMapped = !!(siteCode && siteMappings[siteCode]) || !!roomMappings[hit.room];
      dedupedHits.push({
        ...hit,
        date: effectiveDate,
        timingStage,
        siteCode,
        assetTag,
        spot: effectiveSpot,
        isCustomMapped
      });
    }

    dedupedHits.sort((a, b) => {
      const dCmp = String(a.date || '').localeCompare(String(b.date || ''));
      if (dCmp !== 0) return dCmp;
      const rCmp = String(a.room || '').localeCompare(String(b.room || ''));
      if (rCmp !== 0) return rCmp;
      return String(a.siteCode || a.id || '').localeCompare(String(b.siteCode || b.id || ''));
