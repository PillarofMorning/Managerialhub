// PAGE STYLING (Tailwind)
// =======================================================================
// The screens are drawn with Tailwind class names. Like the other hub pages, this page loads https://cdn.tailwindcss.com
// itself (script id tailwind-cdn, shared with the manager hub). Up to v2.3 it relied on the host page for Tailwind and
// showed up unstyled where the host has none. This page's Tailwind options: dark mode follows the app's own switch (the
// root gets class "dark"), and shadow-2xs / shadow-xs / blur-xs (newer Tailwind names this file uses) are defined.
const BOLO_TW_EXTEND = {
  boxShadow: { '2xs': '0 1px rgb(0 0 0 / 0.05)', xs: '0 1px 2px 0 rgb(0 0 0 / 0.05)' },
  blur: { xs: '4px' }
};
let boloTwConfigured = null; // the window.tailwind object this page last gave its options to

// True once Tailwind styles the app root (its "flex" class applies), whoever loaded Tailwind
function boloStylesApplied(el) {
  try { return !!el && window.getComputedStyle(el).display === 'flex'; } catch (e) { return false; }
}

// Gives this page's options to the Tailwind CDN (setting tailwind.config makes it rebuild); options already set are kept
function boloConfigureTailwind() {
  const tw = typeof window !== 'undefined' ? window.tailwind : null;
  if (!tw || typeof tw !== 'object' || boloTwConfigured === tw) return;
  boloTwConfigured = tw;
  try {
    const cur = tw.config || {};
    const theme = cur.theme || {};
    const ext = theme.extend || {};
    tw.config = {
      ...cur,
      darkMode: 'class',
      theme: {
        ...theme,
        extend: {
          ...ext,
          boxShadow: { ...(ext.boxShadow || {}), ...BOLO_TW_EXTEND.boxShadow },
          blur: { ...(ext.blur || {}), ...BOLO_TW_EXTEND.blur }
        }
      }
    };
  } catch (e) { /* a Tailwind that takes no options */ }
}

// Loads Tailwind once (unless the page already styles the app) and reports through onState: 'ok' once the root's classes
// apply, 'shown' after 4 s (the page is shown plain while it keeps waiting), 'failed' after 8 s (a note says so). It keeps
// watching for 2 minutes, so a slow network still ends at 'ok'. Returns the stop function for the effect cleanup.
function boloEnsureStyles(getRoot, onState) {
  if (typeof document === 'undefined') return () => {};
  boloConfigureTailwind();
  if (boloStylesApplied(getRoot())) {
    onState('ok');
    return () => {};
  }
  if (!document.getElementById('tailwind-cdn')) {
    const sc = document.createElement('script');
    sc.id = 'tailwind-cdn';
    sc.src = 'https://cdn.tailwindcss.com';
    document.head.appendChild(sc);
  }
  const t0 = Date.now();
  let last = 'loading';
  const timer = setInterval(() => {
    boloConfigureTailwind();
    if (boloStylesApplied(getRoot())) {
      clearInterval(timer);
      onState('ok');
      return;
    }
    const waited = Date.now() - t0;
    const next = waited > 8000 ? 'failed' : (waited > 4000 ? 'shown' : 'loading');
    if (next !== last) {
      last = next;
      onState(next);
    }
    if (waited > 120000) clearInterval(timer);
  }, 100);
  return () => clearInterval(timer);
}

