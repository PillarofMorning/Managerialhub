// Each view is built for the person who opens it: This week for supervisors and leads (daily), Trends for managers
// and directors (weekly or monthly), Sites when a site is in question, Data for admins. A view has sections; a section
// id is the old tab id, so every jump inside the app (a Map button, the Import check...) still lands in the right place.
// The map belongs to This week (a day's swabs pinned on it) and to Sites.
const BOLO_VIEWS = [
  { id: 'week', sections: ['calendar', 'map'] },
  { id: 'trends', sections: ['trends'] },
  { id: 'sites', sections: ['sites', 'map', 'harborage', 'explorer'] },
