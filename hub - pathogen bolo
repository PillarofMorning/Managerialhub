  const setRotationByPct = useCallback((nextPct) => {
    const num = Number(nextPct);
    if (!Number.isFinite(num)) {
      setRotationPct(0);
      return;
    }
    const wrapped = ((num % 100) + 100) % 100;
    // Allow exact 100% when explicitly set via slider
    setRotationPct(num === 100 ? 100 : round2(wrapped));
  }, []);

  const [dragMode, setDragMode] = useState('box'); // 'box' | 'move'
  const [snapOn, setSnapOn] = useState(true);
  const [snapBusy, setSnapBusy] = useState(false);
