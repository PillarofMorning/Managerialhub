      {/* PATHOGEN VS. APC & OTHER INDICATORS SEPARATION MATRIX (FILTERABLE) */}
      {emSep && (
        <div className={`rounded-2xl border p-4 shadow-xs space-y-3 ${theme.bgCard}`}>
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-[#00468B] text-white">
