                <button
                  type="button"
                  onClick={() => onSyncConfig()}
                  disabled={syncBusy}
                  className="inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-black bg-[#0072CE] text-white hover:bg-[#00468B]"
