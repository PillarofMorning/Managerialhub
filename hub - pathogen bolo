// takes a few days to answer, then a clean is due; Gerald has not set a number, so 7 is the stated default)
const BOLO_RULES_DEFAULT = { targets: { pathogen: 2, apc: 5, atp: 5 }, repeatDays: 21, alertMonths: 2, closeDays: 7 };
