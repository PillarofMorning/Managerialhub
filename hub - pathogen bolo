                            </span>
                          </div>
                          <h4 className="text-base font-black">{item.title}</h4>
                          <div className={`text-[11px] ${theme.textMuted}`}>
                            Logged by <b className={darkMode ? 'text-slate-200' : 'text-slate-800'}>{item.submittedBy}</b> on <span className="font-mono">{item.submittedAt}</span>
                          </div>
                        </div>

                        <div className="flex items-center gap-1.5">
                          <select
                            value={item.status || 'Open Investigation'}
                            onChange={e => handleUpdateConcernStatus(item.id, e.target.value)}
                            className={`rounded-lg border px-2 py-1 text-[11px] font-black ${theme.bgInput}`}
                          >
                            <option value="Open Investigation">Open Investigation</option>
                            <option value="Escalated to Maintenance">Escalated to Maintenance</option>
                            <option value="Verified / Resolved">Verified / Resolved</option>
                          </select>

                          <button
                            type="button"
                            onClick={() => onLocateOnMap({ siteCode: item.siteCode !== 'Unlinked' ? item.siteCode : null, room: item.room, description: item.title })}
                            className="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-[#0072CE] text-white hover:bg-[#00468B]"
                          >
                            <MapPinIcon className="w-3.5 h-3.5" /> Map
                          </button>

                          {isDevAuthorized && (
                            <ConfirmButton
                              label={<TrashIcon className="w-3.5 h-3.5" />}
                              question={tr('Remove this concern?', 'Quitar este hallazgo?')}
                              yesLabel={tr('Remove', 'Quitar')}
                              onConfirm={() => handleDeleteConcern(item.id)}
                              className="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-500/15"
                              yesClassName="px-2 py-0.5 rounded-lg text-[11px] font-black bg-slate-700 text-white"
                            />
                          )}
                        </div>
                      </div>

                      {/* Photo + "What Do You Think About It?" Split */}
                      <div className="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-stretch">
                        {item.photoDataUrl && (
                          <div className="md:col-span-5 rounded-xl overflow-hidden border bg-slate-950 flex items-center justify-center">
                            <img
                              src={item.photoDataUrl}
                              alt={item.title}
                              className="w-full h-44 object-cover"
                            />
                          </div>
                        )}
                        <div className={`${item.photoDataUrl ? 'md:col-span-7' : 'md:col-span-12'} flex flex-col justify-between gap-2.5`}>
                          <div className={`p-3.5 rounded-xl border flex-1 ${theme.bgSubtle}`}>
                            <div className={`text-[10px] font-black uppercase tracking-wider mb-1 ${theme.textMuted}`}>
                              What the Submitter Thinks About This Harborage Point:
                            </div>
                            <p className="text-xs font-semibold leading-relaxed">
                              "{item.userThought}"
                            </p>
                          </div>

                          <div className={`p-2.5 rounded-xl border text-xs ${theme.bgSubtle}`}>
                            <span className={`font-black uppercase text-[10px] block ${theme.textMuted}`}>
                              Proposed Fix / Corrective Action:
                            </span>
                            <span className="font-semibold">{item.proposedAction}</span>
                          </div>
                        </div>
                      </div>

                      {/* Peer Thoughts & Upvotes Footer */}
                      <div className="pt-2 border-t border-slate-200 dark:border-slate-800 space-y-2.5">
                        <div className="flex items-center justify-between">
                          <span className="text-[11px] font-black uppercase tracking-wider opacity-75">
                            Team Thoughts & Floor Observations ({(item.comments || []).length})
                          </span>
                          <button
                            type="button"
                            onClick={() => handleUpvoteConcern(item.id)}
                            className="px-2.5 py-1 rounded-lg text-xs font-black bg-[#00468B]/15 text-[#0072CE] dark:text-sky-300 hover:bg-[#0072CE] hover:text-white transition-colors"
                          >
                            Agree / Escalate Priority ({item.upvotes || 1})
                          </button>
                        </div>

                        {(item.comments || []).length > 0 && (
                          <div className="space-y-1.5">
                            {item.comments.map(cm => (
                              <div key={cm.id} className={`p-2.5 rounded-xl border text-xs ${theme.bgSubtle}`}>
                                <div className="flex items-center justify-between text-[10px] opacity-75 mb-0.5">
                                  <span className="font-black">{cm.author}</span>
                                  <span className="font-mono">{cm.date}</span>
                                </div>
                                <div className="font-medium">"{cm.thought}"</div>
                              </div>
                            ))}
                          </div>
                        )}

                        <div className="flex gap-2">
                          <input
                            type="text"
                            value={commentInputs[item.id] || ''}
                            onChange={e => setCommentInputs(prev => ({ ...prev, [item.id]: e.target.value }))}
                            placeholder="Add what you think about this harborage concern..."
                            className={`flex-1 rounded-xl border px-3 py-1.5 text-xs ${theme.bgInput}`}
                          />
                          <button
                            type="button"
                            onClick={() => handleAddPeerThought(item.id)}
                            className="px-3.5 py-1.5 rounded-xl bg-[#00468B] text-white text-xs font-black hover:bg-[#0072CE]"
                          >
                            Post Thought
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <div className="h-28 shrink-0" aria-hidden="true" />
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

// =======================================================================
// MODAL: 'SELECT FEATURE' USER SETUP (JSON PREFERENCES) & ADMIN PROFILE CONTROL
// Allows any user to choose what they want to see (e.g., "only wants to see X" rooms/tests/widgets)
// and save their preferences in JSON (LocalStorage + Dataverse).
// Also allows the MS-ID Admin to inspect/alter any user's preferences and enforce role profiles.
// =======================================================================
function UserSelectFeaturesModal({
  darkMode,
  theme,
  msIdentity,
  isDevAuthorized,
  activeUserProfile,
  userProfilesRegistry,
  onSaveUserProfiles,
  facilityAreas,
  bypassUserPrefFilter,
  setBypassUserPrefFilter,
  setMsIdentityOverride,
  onClose
}) {
  const usersMap = (userProfilesRegistry && userProfilesRegistry.users) || DEFAULT_USER_PROFILES_REGISTRY.users;
  const rolesMap = (userProfilesRegistry && userProfilesRegistry.roles) || DEFAULT_USER_PROFILES_REGISTRY.roles;

  const [modalTab, setModalTab] = useState('my_features'); // 'my_features' | 'json_editor' | 'admin_users'
  const [targetMsId, setTargetMsId] = useState(msIdentity.microsoftId || '');

  const currentTargetRecord = usersMap[targetMsId] || activeUserProfile.userRecord;
  const [draftPrefs, setDraftPrefs] = useState(() => ({
    ...(currentTargetRecord.viewPreferences || {
      onlyShowRooms: [],
      onlyShowTests: [],
      defaultCalendarTimeframe: '1w',
      defaultCellDisplayMode: 'hits_pending',
      defaultLandingTab: 'calendar',
      darkModePreferred: true,
      visibleWidgets: {
        pressure_points: true,
        kpi_strip: true,
        room_matrix: true,
        active_hits_table: true,
        harborage_feed: true
      }
    })
  }));
  const [draftRoleProfile, setDraftRoleProfile] = useState(currentTargetRecord.assignedRoleProfile || 'qa_lead');
  const [draftLockedByAdmin, setDraftLockedByAdmin] = useState(!!currentTargetRecord.lockedByAdmin);
  const [jsonText, setJsonText] = useState(() => JSON.stringify(draftPrefs, null, 2));
  const [jsonErr, setJsonErr] = useState('');
  const [saveNotice, setSaveNotice] = useState('');

  // Sync draft when targetMsId changes
  useEffect(() => {
    const rec = usersMap[targetMsId] || activeUserProfile.userRecord;
    if (rec && rec.viewPreferences) {
      setDraftPrefs(rec.viewPreferences);
      setDraftRoleProfile(rec.assignedRoleProfile || 'qa_lead');
      setDraftLockedByAdmin(!!rec.lockedByAdmin);
      setJsonText(JSON.stringify(rec.viewPreferences, null, 2));
      setJsonErr('');
    }
  }, [targetMsId, usersMap, activeUserProfile.userRecord]);

  const isLockedForCurrentUser = !isDevAuthorized && activeUserProfile.isLockedByAdmin && targetMsId === msIdentity.microsoftId;

  const toggleRoomPref = (roomKey) => {
    if (isLockedForCurrentUser) return;
    setDraftPrefs(prev => {
      const cur = Array.isArray(prev.onlyShowRooms) ? prev.onlyShowRooms : [];
      const nextRooms = cur.includes(roomKey) ? cur.filter(r => r !== roomKey) : [...cur, roomKey];
      const next = { ...prev, onlyShowRooms: nextRooms };
      setJsonText(JSON.stringify(next, null, 2));
      return next;
    });
  };

  const toggleTestPref = (testKey) => {
    if (isLockedForCurrentUser) return;
    setDraftPrefs(prev => {
      const cur = Array.isArray(prev.onlyShowTests) ? prev.onlyShowTests : [];
      const nextTests = cur.includes(testKey) ? cur.filter(t => t !== testKey) : [...cur, testKey];
      const next = { ...prev, onlyShowTests: nextTests };
      setJsonText(JSON.stringify(next, null, 2));
      return next;
    });
  };


  const handleSavePreferences = async () => {
    let finalPrefs = draftPrefs;
    if (modalTab === 'json_editor') {
      try {
        finalPrefs = JSON.parse(jsonText);
        setJsonErr('');
      } catch (e) {
        setJsonErr(`JSON Syntax Error: ${e.message}`);
        return;
      }
    }

    const currentReg = userProfilesRegistry || DEFAULT_USER_PROFILES_REGISTRY;
    const baseUser = (currentReg.users && currentReg.users[targetMsId]) || {
      microsoftId: targetMsId,
      userName: targetMsId === msIdentity.microsoftId ? msIdentity.userName : `User (${targetMsId})`,
      email: targetMsId === msIdentity.microsoftId ? msIdentity.email : `${targetMsId.toLowerCase()}@schwans.com`,
      domainAccount: `SCHWANS\\${targetMsId}`
    };

    const updatedUser = {
      ...baseUser,
      assignedRoleProfile: isDevAuthorized ? draftRoleProfile : (baseUser.assignedRoleProfile || 'qa_lead'),
      lockedByAdmin: isDevAuthorized ? draftLockedByAdmin : !!baseUser.lockedByAdmin,
      updatedAt: new Date().toISOString().slice(0, 10),
      updatedBy: msIdentity.userName,
      viewPreferences: finalPrefs
    };

    const nextReg = {
      ...currentReg,
      users: {
        ...(currentReg.users || {}),
        [targetMsId]: updatedUser
      }
    };

    await onSaveUserProfiles(nextReg, `Saved Select Feature JSON preferences for ${targetMsId}`);
    setBypassUserPrefFilter(false);
    setSaveNotice(`Saved JSON feature preferences for ${updatedUser.userName} (${targetMsId}) to Dataverse & local storage!`);
    setTimeout(() => setSaveNotice(''), 4000);
  };

  return localizeReactTree((
    <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-xs z-50 flex items-center justify-center p-4" onClick={onClose}>
      <div
        className={`w-full max-w-4xl max-h-[90vh] rounded-2xl border shadow-2xl flex flex-col overflow-hidden ${theme.bgCard}`}
        onClick={e => e.stopPropagation()}
      >
        {/* Modal Header */}
        <div className="px-5 py-4 bg-gradient-to-r from-[#00468B] to-[#0072CE] text-white flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#FFB81C]">
          <div>
            <div className="flex items-center gap-2">
              <UsersIcon className="w-4 h-4 text-[#FFB81C]" />
              <span className="text-[10px] font-black uppercase tracking-widest text-[#FFB81C]">
                Select Feature User Setup & JSON View Control
              </span>
            </div>
            <h3 className="text-base sm:text-lg font-black">
              Customize What You See ({targetMsId === msIdentity.microsoftId ? `My Profile: ${msIdentity.userName}` : `Editing User: ${targetMsId}`})
            </h3>
          </div>
          <button type="button" onClick={onClose} className="p-1.5 rounded-lg bg-white/10 hover:bg-white/20">
            <XIcon className="w-4 h-4" />
          </button>
        </div>

        {/* Sub-Navigation Bar */}
        <div className={`px-5 py-2.5 border-b flex flex-wrap items-center justify-between gap-2 ${theme.bgSubtle}`}>
          <div className="flex flex-wrap items-center gap-1.5">
            <button
              type="button"
              onClick={() => setModalTab('my_features')}
              className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                modalTab === 'my_features' ? 'bg-[#00468B] text-white' : theme.bgCard
              }`}
            >
              1. Visual Feature & Room Selector
            </button>
            <button
              type="button"
              onClick={() => {
                setJsonText(JSON.stringify(draftPrefs, null, 2));
                setModalTab('json_editor');
              }}
              className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                modalTab === 'json_editor' ? 'bg-[#00468B] text-white' : theme.bgCard
              }`}
            >
              2. Raw JSON Preferences Editor
            </button>
            {isDevAuthorized && (
              <button
                type="button"
                onClick={() => setModalTab('admin_users')}
                className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                  modalTab === 'admin_users' ? 'bg-[#00468B] text-white' : theme.bgCard
                }`}
              >
                3. Admin: All Plant Users & Access Profiles ({Object.keys(usersMap).length})
              </button>
            )}
          </div>

          {/* Admin User Target Selector */}
          {isDevAuthorized && (
            <div className="flex items-center gap-1.5 text-xs">
              <span className="font-bold opacity-75">Target User:</span>
              <select
                value={targetMsId}
                onChange={e => setTargetMsId(e.target.value)}
                className={`rounded-lg border px-2 py-1 text-xs font-mono font-bold ${theme.bgInput}`}
              >
                {Object.values(usersMap).map(u => (
                  <option key={u.microsoftId} value={u.microsoftId}>
                    {u.microsoftId} - {u.userName}
                  </option>
                ))}
              </select>
            </div>
          )}
        </div>

        {/* Body */}
        <div className="p-5 overflow-y-auto space-y-5 flex-1 text-xs">
          {saveNotice && (
            <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 p-3 font-bold text-emerald-700 dark:text-emerald-300">
              {saveNotice}
            </div>
          )}

          {isLockedForCurrentUser && (
            <div className={`rounded-xl border p-3 font-bold ${theme.bgSubtle}`}>
              Your view profile ({activeUserProfile.roleProfile.name}) is currently locked and managed by the plant administrator (admin).
            </div>
          )}

          {modalTab === 'my_features' && (
            <div className="space-y-5">
              {/* Quick "Only Want to See X" Presets */}
              <div className={`p-3.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                <div className="text-[10px] font-black uppercase tracking-wider text-[#0072CE] dark:text-sky-300">
                  Quick "Only Want to See X" Setup Presets
                </div>
                <div className="flex flex-wrap gap-1.5">
                  {[
                    { label: 'Show All Plant Rooms (Default)', rooms: [], tests: [] },
                    { label: 'Only WJ1 / Waterjet Slicers', rooms: ['WJ'], tests: [] },
                    { label: 'Only Creme Lines (IBL5 + IBL4 + Creme)', rooms: ['IBL5', 'IBL4', 'Creme'], tests: [] },
                    { label: 'Only Bakery (Dough Rm + Highspeed + Custard)', rooms: ['Dough Room', 'Highspeed', 'Custard', 'Bakery'], tests: [] },
                    { label: 'Only Listeria & Retest Positives', rooms: [], tests: ['LIS', 'RETEST-LIS'] }
                  ].map((preset, idx) => (
                    <button
                      key={idx}
                      type="button"
                      disabled={isLockedForCurrentUser}
                      onClick={() => {
                        const next = { ...draftPrefs, onlyShowRooms: preset.rooms, onlyShowTests: preset.tests };
                        setDraftPrefs(next);
                        setJsonText(JSON.stringify(next, null, 2));
                      }}
                      className={`px-2.5 py-1.5 rounded-lg font-bold border ${theme.bgCard} hover:border-[#0072CE]`}
                    >
                      {preset.label}
                    </button>
                  ))}
                </div>
              </div>

              {/* 1. Select Rooms to Display */}
              <div>
                <div className="flex items-center justify-between mb-2">
                  <label className="font-black uppercase tracking-wider text-[11px]">
                    1. Select Rooms / Areas to See ({draftPrefs.onlyShowRooms && draftPrefs.onlyShowRooms.length > 0 ? `${draftPrefs.onlyShowRooms.length} Selected` : 'All Rooms Shown'})
                  </label>
                  <button
                    type="button"
                    onClick={() => setDraftPrefs(prev => ({ ...prev, onlyShowRooms: [] }))}
                    className="text-[11px] font-bold text-[#0072CE] underline"
                  >
                    Reset to All Rooms
                  </button>
                </div>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {Object.keys(ROOM_META).map(rk => {
                    const checked = Array.isArray(draftPrefs.onlyShowRooms) && draftPrefs.onlyShowRooms.includes(rk);
                    return (
                      <button
                        key={rk}
                        type="button"
                        onClick={() => toggleRoomPref(rk)}
                        className={`p-2.5 rounded-xl border text-left transition-all flex items-center justify-between ${
                          checked
                            ? 'bg-[#00468B] text-white border-[#00468B] shadow-xs'
                            : `${theme.bgSubtle} hover:border-[#0072CE]`
                        }`}
                      >
                        <span className="font-bold truncate">{ROOM_META[rk].label}</span>
                        <span className={`px-1.5 py-px rounded text-[9px] font-black ${checked ? 'bg-[#FFB81C] text-slate-950' : 'bg-slate-500/20'}`}>
                          {checked ? 'ON' : 'ALL'}
                        </span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* 2. Select Pathogen / Swab Test Types */}
              <div>
                <label className="block font-black uppercase tracking-wider text-[11px] mb-2">
                  2. Select Test Types to See ({draftPrefs.onlyShowTests && draftPrefs.onlyShowTests.length > 0 ? draftPrefs.onlyShowTests.join(', ') : 'All Test Types'})
                </label>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {Object.keys(TEST_BADGE).map(tk => {
                    const checked = Array.isArray(draftPrefs.onlyShowTests) && draftPrefs.onlyShowTests.includes(tk);
                    return (
                      <button
                        key={tk}
                        type="button"
                        onClick={() => toggleTestPref(tk)}
                        className={`p-2.5 rounded-xl border text-left font-bold flex items-center justify-between ${
                          checked ? 'bg-[#0072CE] text-white border-[#0072CE]' : theme.bgSubtle
                        }`}
                      >
                        <span>{TEST_BADGE[tk].label}</span>
                        <span className="text-[10px] font-mono">{checked ? 'FILTERED' : 'ALL'}</span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* 3. Default Calendar Timeframe (v2.5: the old dashboard module switches are gone with the dashboard) */}
              <div className="grid grid-cols-1 gap-4">
                <div className={`p-3.5 rounded-xl border space-y-2.5 ${theme.bgSubtle}`}>
                  <div className="font-black uppercase text-[11px]">3. Default Calendar & Landing Preferences</div>
                  <div>
                    <label className="block text-[10px] font-bold uppercase opacity-75 mb-1">Default Calendar Timeframe</label>
                    <select
                      value={CALENDAR_VIEW_FROM_PREF[draftPrefs.defaultCalendarTimeframe] === 'exec_overview' || !draftPrefs.defaultCalendarTimeframe ? 'exec_overview' : draftPrefs.defaultCalendarTimeframe}
                      onChange={e => setDraftPrefs(prev => ({ ...prev, defaultCalendarTimeframe: e.target.value }))}
                      className={`w-full rounded-lg border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                    >
                      <option value="exec_overview">{tr('Last week + this week', 'Semana pasada + esta semana')}</option>
                      <option value="one_week">{tr('One week', 'Una semana')}</option>
                      <option value="month">{tr('Month', 'Mes')}</option>
                      <option value="8w">{tr('8 weeks', '8 semanas')}</option>
                      <option value="archive">{tr('All months', 'Todos los meses')}</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-[10px] font-bold uppercase opacity-75 mb-1">Default Calendar Cell Content</label>
                    <select
                      value={draftPrefs.defaultCellDisplayMode || 'hits_pending'}
                      onChange={e => setDraftPrefs(prev => ({ ...prev, defaultCellDisplayMode: e.target.value }))}
                      className={`w-full rounded-lg border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                    >
                      <option value="hits">Show BOLO Hits Only</option>
                      <option value="hits_pending">Show Hits + Blank/Pending Swabs</option>
                      <option value="all_mss">Show All Room Swabs (MSS Full View)</option>
                    </select>
                  </div>
                </div>

              </div>

              {/* Admin Role & Lock Controls when MS ID is active */}
              {isDevAuthorized && (
                <div className={`p-3.5 rounded-xl border flex flex-wrap items-center justify-between gap-3 ${theme.bgSubtle}`}>
                  <div>
                    <div className={`text-[10px] font-black uppercase ${theme.textMuted}`}>
                      Admin Profile & Access Enforcement for {targetMsId}
                    </div>
                    <div className="text-xs font-bold">
                      Assign a Role Profile or lock this user's view so they only see their assigned rooms and tabs whenever they open the app.
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <select
                      value={draftRoleProfile}
                      onChange={e => setDraftRoleProfile(e.target.value)}
                      className={`rounded-lg border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                    >
                      {Object.values(rolesMap).map(r => (
                        <option key={r.id} value={r.id}>Role: {r.name}</option>
                      ))}
                    </select>
                    <label className="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 text-white font-bold cursor-pointer">
                      <input
                        type="checkbox"
                        checked={draftLockedByAdmin}
                        onChange={e => setDraftLockedByAdmin(e.target.checked)}
                      />
                      <span>Lock User View</span>
                    </label>
                  </div>
                </div>
              )}
            </div>
          )}

          {modalTab === 'json_editor' && (
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <span className="font-black uppercase text-[11px]">
                  User View Preferences JSON (<span className="font-mono">{targetMsId}</span>)
                </span>
                {jsonErr && <span className="text-rose-500 font-bold">{jsonErr}</span>}
              </div>
              <textarea
                rows={14}
                value={jsonText}
                onChange={e => {
                  setJsonText(e.target.value);
                  setJsonErr('');
                }}
                className={`w-full rounded-xl border p-3 font-mono text-xs ${theme.bgInput}`}
              />
            </div>
          )}

          {modalTab === 'admin_users' && isDevAuthorized && (
            <div className="space-y-3">
              <div className="font-black uppercase text-[11px]">
                All Saved User Preference Profiles in Dataverse (<span className="font-mono">PATHOGEN_BOLO_USER_PROFILES_JSON</span>)
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                {Object.values(usersMap).map(u => {
                  const rDef = rolesMap[u.assignedRoleProfile] || rolesMap.qa_lead;
                  return (
                    <div key={u.microsoftId} className={`p-3.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                      <div className="flex items-center justify-between">
                        <div>
                          <span className="font-mono font-black text-xs text-[#0072CE] dark:text-sky-300">{u.microsoftId}</span>
                          <span className="mx-1.5">-</span>
                          <span className="font-black text-xs">{u.userName}</span>
                        </div>
                        {u.lockedByAdmin && (
                          <span className="px-2 py-0.5 rounded text-[9px] font-black bg-slate-600 text-white">LOCKED</span>
                        )}
                      </div>
                      <div className="text-[11px]">
                        Role: <b>{rDef.name}</b> - Rooms: <b>{(u.viewPreferences && u.viewPreferences.onlyShowRooms && u.viewPreferences.onlyShowRooms.length > 0) ? u.viewPreferences.onlyShowRooms.join(', ') : 'All Rooms'}</b>
                      </div>
                      <div className="flex gap-2 pt-1">
                        <button
                          type="button"
                          onClick={() => {
                            setTargetMsId(u.microsoftId);
                            setModalTab('my_features');
                          }}
                          className="px-2.5 py-1 rounded bg-[#00468B] text-white font-bold text-[11px]"
                        >
                          Edit User Preferences
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            setMsIdentityOverride({
                              microsoftId: u.microsoftId,
                              systemUserId: '',
                              aadObjectId: '',
                              userName: u.userName,
                              email: u.email,
                              domainAccount: u.domainAccount || `SCHWANS\\${u.microsoftId}`,
                              roles: [rDef.name],
                              source: 'Admin Profile Simulation'
                            });
                            onClose();
                          }}
                          className="px-2.5 py-1 rounded bg-[#FFB81C] text-slate-950 font-black text-[11px]"
                        >
                          Simulate This User
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        {/* Modal Footer */}
        <div className={`px-5 py-3.5 border-t flex flex-wrap items-center justify-between gap-2 ${theme.bgSubtle}`}>
          <div className="text-[11px] font-mono opacity-80">
            Stored in JSON key <span className="font-bold">PATHOGEN_BOLO_USER_PROFILES_JSON</span>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={onClose}
              className={`px-3.5 py-1.5 rounded-xl border text-xs font-bold ${theme.bgCard}`}
            >
              Close
            </button>
            {!isLockedForCurrentUser && (
              <button
                type="button"
                onClick={handleSavePreferences}
                className="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl bg-[#0072CE] text-white text-xs font-black hover:bg-[#00468B] shadow-sm cursor-pointer"
              >
                <SaveIcon className="w-3.5 h-3.5" />
                <span>Save JSON Preferences to Dataverse</span>
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

