// --- MICROSOFT ID & DATAVERSE IDENTITY READER FOR DEV CONSOLE ---
// Admin access comes from the user's real Dataverse security roles, or from a user marked
// 'dev_admin' in the PATHOGEN_BOLO_USER_PROFILES_JSON config row. No person is built in.
const AUTHORIZED_DEV_TOKENS = [
  'system administrator',
  'system customizer',
  'fsq admin'
];
let BOLO_ADMIN_MS_IDS = [];
function setBoloAdminMsIds(registry) {
  const out = [];
  const users = (registry && registry.users) || {};
  Object.keys(users).forEach(k => {
    const u = users[k] || {};
    if ((u.assignedRoleProfile || u.assignedProfileId) === 'dev_admin') out.push(String(u.microsoftId || k).toUpperCase());
  });
  BOLO_ADMIN_MS_IDS = out;
}

function isDevMicrosoftIdentity(identity) {
  if (!identity) return false;
  if (identity.forceRole === 'operator') return false;
  if (identity.forceRole === 'dev') return true;
  // An ID-based grant only counts when the ID was read from Dataverse, not typed in
  const fromHost = /Dataverse|Xrm/.test(String(identity.source || ''));
  if (fromHost && identity.microsoftId && BOLO_ADMIN_MS_IDS.indexOf(String(identity.microsoftId).toUpperCase()) !== -1) return true;
  const hay = (Array.isArray(identity.roles) ? identity.roles.join(' ') : '').toLowerCase();
  for (let i = 0; i < AUTHORIZED_DEV_TOKENS.length; i += 1) {
    if (hay.indexOf(AUTHORIZED_DEV_TOKENS[i]) !== -1) return true;
  }
  return false;
}

function readSyncMicrosoftIdentity(overrideObj) {
  if (overrideObj && overrideObj.microsoftId) {
    return {
      ...overrideObj,
      isDev: isDevMicrosoftIdentity(overrideObj)
    };
  }
  try {
    const xrm = (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility)
      ? window.Xrm
      : ((typeof window !== 'undefined' && window.parent && window.parent.Xrm && window.parent.Xrm.Utility)
          ? window.parent.Xrm
          : (typeof window !== 'undefined' && window.top && window.top.Xrm && window.top.Xrm.Utility ? window.top.Xrm : null));
    if (xrm && typeof xrm.Utility.getGlobalContext === 'function') {
      const ctx = xrm.Utility.getGlobalContext();
      const us = ctx && ctx.userSettings ? ctx.userSettings : null;
      if (us && (us.userId || us.userName)) {
        const cleanId = String(us.userId || '').replace(/[{}]/g, '');
        const roleList = [];
        try {
          if (us.roles && typeof us.roles.forEach === 'function') {
            us.roles.forEach(r => { if (r && r.name) roleList.push(r.name); });
          }
        } catch (e) { /* ignore */ }
        const msMatch = String(us.userName || '').match(/u\d{6,8}/i);
        const msIdVal = msMatch ? msMatch[0].toUpperCase() : (cleanId ? cleanId.slice(0, 8).toUpperCase() : '');
        const identity = {
          microsoftId: msIdVal,
          systemUserId: cleanId,
          aadObjectId: String(us.aadObjectId || cleanId || ''),
          userName: us.userName || msIdVal,
          email: us.userName && us.userName.indexOf('@') !== -1 ? us.userName : '',
          domainAccount: us.userName || '',
          roles: roleList,
          source: 'Dataverse Xrm.Utility.getGlobalContext().userSettings'
        };
        return { ...identity, isDev: isDevMicrosoftIdentity(identity) };
      }
    }
  } catch (e) { /* fallback */ }

  try {
    if (typeof window !== 'undefined' && window.localStorage) {
      const rawShared = window.localStorage.getItem('stillwell_active_ms_user_v1');
      if (rawShared) {
        const parsedShared = JSON.parse(rawShared);
        if (parsedShared && (parsedShared.microsoftId || parsedShared.userName)) {
          // Roles are never trusted from browser storage; they are re-read from Dataverse on load.
          const sharedIdentity = {
            microsoftId: String(parsedShared.microsoftId || '').trim(),
            systemUserId: String(parsedShared.systemUserId || ''),
            aadObjectId: String(parsedShared.aadObjectId || ''),
            userName: String(parsedShared.userName || parsedShared.microsoftId || '').trim(),
            email: String(parsedShared.email || '').trim(),
            domainAccount: String(parsedShared.domainAccount || '').trim(),
            roles: [],
            source: parsedShared.source || 'Stillwell Active MS User Session'
          };
          return { ...sharedIdentity, isDev: isDevMicrosoftIdentity(sharedIdentity) };
        }
      }
    }
  } catch (e) { /* ignore storage error */ }

  // Not running inside Power Apps / Dataverse and no shared session: unknown user, no admin rights
  const fallbackIdentity = {
    microsoftId: '',
    systemUserId: '',
    aadObjectId: '',
    userName: 'Not signed in',
    email: '',
    domainAccount: '',
    roles: [],
    source: 'No Power Apps session'
  };
  return { ...fallbackIdentity, isDev: isDevMicrosoftIdentity(fallbackIdentity) };
}

