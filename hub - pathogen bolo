    viewPreferences: mergedViewPreferences,
    updatedAt: (existingUser && existingUser.updatedAt) || '2026-10-17',
    updatedBy: (existingUser && existingUser.updatedBy) || ''
  };

  return {
    ...userRec,
    userRecord: userRec,
    roleProfile: profileObj,
    profileName: profileObj ? profileObj.name : assignedKey,
    isLockedByAdmin: isLocked,
    accessControl: {
      allowLogoUnlock: profileObj ? profileObj.allowLogoUnlock !== false : true,
      autoUnlockOnLoad: !!(profileObj && profileObj.autoUnlockOnLoad),
      allowedTabs: (profileObj && Array.isArray(profileObj.allowedTabs)) ? profileObj.allowedTabs : [...ALL_SUBTAB_KEYS],
      canEditSuggestedActions: !!(profileObj && profileObj.canEditSuggestedActions),
