                      <td className="py-2 px-2 text-right font-mono">
                        <div className="font-black text-[#E4002B] dark:text-rose-400">
                          {fmtPct(rm.pathogenRate)} <span className={`font-normal text-[10px] ${theme.textMuted}`}>({rm.pathogenPos}/{rm.pathogenSwabs})</span>
