    <div className={`shrink-0 rounded-xl border p-4 shadow-xs ${theme.bgCard}`}>
      <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
        <div>
          <h3 className={`text-sm font-black ${theme.textHeading}`}>Swab Zone to MSS Area</h3>
          <p className={`text-[11px] ${theme.textMuted}`}>
            Each BOLO zone points to one MSS area (exact name from the Areas table). Sites without their own link use this.
            {!zoneAreasSaved && ' Not saved yet: only zones with the same name as an area are matched.'}
          </p>
        </div>
        {canEdit && (
          <button
            type="button"
            onClick={async () => {
              setMsg('Saving...');
