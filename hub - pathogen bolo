  const defaultProfileKey = isDev ? 'dev_admin' : 'qa_lead';
  const assignedKey = (existingUser && (existingUser.assignedRoleProfile || existingUser.assignedProfileId)) || defaultProfileKey;
  const profileObj = rolesDict[assignedKey] || rolesDict[defaultProfileKey] || DEFAULT_ROLE_PROFILES_MAP.qa_lead;

  const rawVp = {
    ...(profileObj && profileObj.defaultViewPreferences ? profileObj.defaultViewPreferences : {}),
