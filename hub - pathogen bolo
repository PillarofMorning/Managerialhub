// Uniform Key Metric Card:
// Always displays:
// 1. Percent Positive This Year (% Pos TY) + (positives/swabs)
// 2. Start-Up (ST) / In-Process (INP) This Year
// 3. Last Year (LY) same metrics in smaller print underneath, GREEN if better, with YoY change
function UniformKeyMetricBox({
  title,
  tyPosRate,
  tyHits,
  tySwabs,
  tyStRate,
  tyInpRate,
  lyPosRate,
  lyStRate,
  lyInpRate,
  yoyDeltaPct,
  accentClass = 'text-[#E4002B] dark:text-rose-400',
  theme,
  extraLine = null
}) {
  const has = (v) => v !== undefined && v !== null && !isNaN(Number(v));
  const show = (v) => (has(v) ? `${round2(Number(v))}%` : '--');
  const numTy = show(tyPosRate);
  const numLy = show(lyPosRate);
  const delta = has(yoyDeltaPct) ? round2(Number(yoyDeltaPct)) : (has(tyPosRate) && has(lyPosRate) ? round2(Number(tyPosRate) - Number(lyPosRate)) : null);
  const isBetterOrEqual = delta !== null && delta <= 0;
  const noLy = delta === null;
  const formattedDelta = delta === null ? '--' : `${delta > 0 ? '+' : ''}${delta}%`;
  const stTyVal = show(tyStRate);
  const inpTyVal = show(tyInpRate);
  const stLyVal = show(lyStRate);
  const inpLyVal = show(lyInpRate);

  return (
    <div className={`p-2.5 rounded-xl border min-w-0 overflow-hidden ${theme ? theme.bgSubtle : ''}`}>
      {/* Header: Metric Title + YoY Change Badge */}
      <div className="flex flex-wrap items-center justify-between gap-1.5 mb-1 min-w-0">
        <span className={`text-[10px] font-black uppercase tracking-wider break-words min-w-0 ${theme ? theme.textMuted : ''}`}>
          {title}
        </span>
        <span className={`shrink-0 px-1.5 py-0.5 rounded text-[10px] font-mono font-black whitespace-nowrap ${
          noLy
            ? 'bg-slate-500/10 text-slate-600 dark:text-slate-300 border border-slate-500/30'
            : (isBetterOrEqual
              ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30'
              : 'bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30')
        }`}>
          {formattedDelta} YoY
        </span>
      </div>

      {/* Row 1: Percent Positive This Year */}
      <div className="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5 my-0.5 min-w-0">
        <div className="flex flex-wrap items-baseline gap-1.5 min-w-0">
          <span className={`text-xl sm:text-2xl font-black font-mono leading-none ${accentClass}`}>
            {numTy}
          </span>
          <span className="text-[10px] font-extrabold uppercase opacity-80 whitespace-nowrap">
            % Pos This Year (TY)
          </span>
        </div>
        {tySwabs !== undefined && tySwabs !== null && (
          <span className={`text-[10px] font-mono font-bold whitespace-nowrap ${theme ? theme.textMuted : ''}`}>
            ({tyHits !== undefined && tyHits !== null ? tyHits : 0}/{tySwabs} swabs)
          </span>
        )}
      </div>

      {/* Row 2: Start-Up / In-Process This Year */}
      <div className="mt-1 px-2 py-1 rounded-lg bg-black/5 dark:bg-white/5 flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5 text-[11px] font-mono font-bold min-w-0">
        <span className="text-[10px] uppercase font-black opacity-80">Start-Up / In-Process (TY):</span>
        <span className="whitespace-nowrap">
          ST: <b className="text-[#0072CE] dark:text-sky-400">{stTyVal}</b>
          {' - '}
          INP: <b className="text-[#D97706] dark:text-amber-400">{inpTyVal}</b>
        </span>
      </div>

      {/* Row 3: Last Year Same Metrics in Smaller Print Underneath & GREEN if Better, with YoY Change */}
      <div className={`mt-1.5 pt-1 border-t border-slate-300/60 dark:border-slate-700/60 text-[10px] font-mono leading-snug min-w-0 ${
        noLy
          ? (theme ? theme.textMuted : 'opacity-70')
          : (isBetterOrEqual
            ? 'text-emerald-600 dark:text-emerald-400 font-bold'
            : 'text-amber-700 dark:text-amber-400 font-bold')
      }`}>
        <div className="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5 min-w-0">
          <span className="break-words min-w-0">
            Last Year (LY): <b>{numLy}</b> Pos - ST: <b>{stLyVal}</b> / INP: <b>{inpLyVal}</b>
          </span>
          <span className="font-black whitespace-nowrap">
            {delta === null ? '(no last-year swabs)' : `(${formattedDelta} YoY ${isBetterOrEqual ? 'Better' : 'Higher'})`}
          </span>
        </div>
      </div>

      {extraLine && (
        <div className={`mt-1 text-[10px] font-mono break-words ${theme ? theme.textMuted : ''}`}>
          {extraLine}
        </div>
      )}
    </div>
  );
}

