              onClick={() => onPinOnMap(dateKey)}
              data-pin-day={dateKey}
              className="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-black bg-[#00468B] text-white hover:bg-[#0072CE] disabled:opacity-50"
            >
