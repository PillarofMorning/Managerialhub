                  <button
                    type="button"
                    onClick={() => {
                      const headers = ['Timestamp', 'Microsoft ID', 'User Name', 'Email', 'Domain Account', 'Role', 'Auth Source', 'Tabs Visited', 'Action Summary'];
                      const csvRows = [headers.join(',')].concat(
                        filteredAccessLog.map(a => [
                          `"${a.timestampLabel || ''}"`,
                          `"${a.microsoftId || ''}"`,
                          `"${a.userName || ''}"`,
                          `"${a.email || ''}"`,
                          `"${a.domainAccount || ''}"`,
                          `"${a.role || ''}"`,
                          `"${a.authSource || ''}"`,
                          `"${a.tabVisited || ''}"`,
                          `"${String(a.actionSummary || '').replace(/"/g, '""')}"`
