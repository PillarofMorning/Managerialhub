    return Object.keys(ROOM_META).map(rKey => {
      const meta = ROOM_META[rKey];
      const promptRoom = s.rooms[rKey] || null;
      const sepRm = sepByRoom[rKey] || null;
      const roomHits = activeHitsForRooms.filter(h => h.room === rKey);
      const lisHits = roomHits.filter(h => h.testType === 'LIS' || h.testType === 'RETEST-LIS' || h.testType === 'SAL');
      const apcHits = roomHits.filter(h => h.testType === 'APC');
      const atpHits = roomHits.filter(h => h.testType === 'ATP');
      const sitesInRoom = fullSiteCatalog.filter(sc => sc.room === rKey);
      const customMapped = sitesInRoom.filter(sc => sc.mappingStatus === 'site-mapped').length;
      const totalSwabs = (promptRoom && promptRoom.totalSwabs) || (sepRm && sepRm.pathogenSwabs) || sitesInRoom.length;
      const lisCountVal = sepRm ? sepRm.pathogenPos : lisHits.length;
      const rate = totalSwabs > 0 ? round2((lisCountVal / totalSwabs) * 100) : 0;
      return {
        key: rKey,
        meta,
        totalSwabs,
        salmonellaSwabs: promptRoom ? promptRoom.salmonellaSwabs : 0,
        totalHits: roomHits.length,
        lisHits: lisCountVal,
        apcHits: sepRm ? sepRm.apcFail : apcHits.length,
        atpHits: sepRm ? sepRm.atpFail : atpHits.length,
        rate,
        siteCount: sitesInRoom.length,
        customMapped
      };
    }).filter(r => r.totalSwabs > 0 || r.totalHits > 0 || r.siteCount > 0);
  }, [s.rooms, allHits, fullSiteCatalog, emSep]);

  const filteredSeparationRooms = useMemo(() => {
    const list = (emSep && Array.isArray(emSep.roomSeparationList)) ? emSep.roomSeparationList : [];
    return list.filter(r => {
      if (sepSideFilter !== 'ALL' && r.side !== sepSideFilter) return false;
      if (sepIndicatorFocus === 'PATHOGEN' && r.pathogenPos === 0 && r.pathogenSwabs === 0) return false;
      if (sepIndicatorFocus === 'APC' && r.apcFail === 0) return false;
      if (sepIndicatorFocus === 'ATP' && r.atpFail === 0) return false;
      return true;
    });
  }, [emSep, sepSideFilter, sepIndicatorFocus]);

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-3 sm:p-4 pb-32 space-y-4">
      {savedBannerMsg && (
        <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 px-4 py-2.5 flex items-center justify-between text-xs font-bold text-emerald-700 dark:text-emerald-300">
          <div className="flex items-center gap-2">
            <CheckCircleIcon className="w-4 h-4 text-emerald-500 shrink-0" />
            <span>{savedBannerMsg}</span>
          </div>
          <button type="button" onClick={() => setSavedBannerMsg('')} className="underline">Dismiss</button>
        </div>
      )}

      {/* SHARED CORE EXECUTIVE PERCENTAGES & DATAVERSE-EDITABLE YOY SYNOPSES */}
      <ExecutivePercentagesAndSynopsisDeck
        darkMode={darkMode}
        theme={theme}
        pressureAnalysis={pressureAnalysis}
        resultCategoryMode={resultCategoryMode}
        setResultCategoryMode={setResultCategoryMode}
        executiveSynopses={executiveSynopses}
        onSaveExecutiveSynopsis={onSaveExecutiveSynopsis}
