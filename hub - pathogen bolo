  const baseSiteCatalog = useMemo(() => buildInitialSiteCatalog(RAW_SITE_CATALOG, roomAliases), [roomAliases]);

  // --- PARSE PROMPT & CSV + MERGE WITH HISTORICAL 18K LEDGER (DEDUPLICATED) ---
  const parsedPrompt = useMemo(
