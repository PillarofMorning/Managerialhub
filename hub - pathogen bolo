            {[
              { key: 'pathogen', data: emSep.pathogen, borderCls: 'border-l-4 border-l-[#E4002B]', badgeCls: 'bg-[#E4002B] text-white', tag: 'Default Main %' },
              { key: 'apc', data: emSep.apc, borderCls: 'border-l-4 border-l-orange-500', badgeCls: 'bg-orange-600 text-white', tag: 'Hygiene Indicator' },
              { key: 'atp', data: emSep.atp, borderCls: 'border-l-4 border-l-amber-500', badgeCls: 'bg-amber-500 text-slate-950', tag: 'Rapid Pre-Op Indicator' },
