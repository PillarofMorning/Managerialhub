                      <th className="py-3 px-4">Microsoft ID</th>
                      <th className="py-3 px-4">User Name & Email</th>
                      <th className="py-3 px-4">Role & Auth Source</th>
                      <th className="py-3 px-4">Tab(s)</th>
                      <th className="py-3 px-4">Activity / Session Summary</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 dark:divide-slate-800">
                    {filteredAccessLog.map(entry => (
                      <tr key={entry.id} className={darkMode ? 'hover:bg-slate-800/50' : 'hover:bg-slate-50'}>
                        <td className="py-3 px-4 font-mono font-bold whitespace-nowrap">{entry.timestampLabel}</td>
                        <td className="py-3 px-4 whitespace-nowrap">
                          <span className="px-2.5 py-0.5 rounded-full font-mono font-black text-[11px] bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-500/30">
                            {entry.microsoftId}
                          </span>
                        </td>
                        <td className="py-3 px-4">
                          <div className="font-black">{entry.userName}</div>
                          <div className={`text-[11px] font-mono ${theme.textMuted}`}>{entry.email} ({entry.domainAccount})</div>
                        </td>
                        <td className="py-3 px-4">
                          <div className="font-bold">{entry.role}</div>
                          <div className={`text-[11px] ${theme.textMuted}`}>{entry.authSource}</div>
