  const dayEmailsOf = useCallback((dateKey) => allHits.filter(h => h.emailOnly && h.date === dateKey && (!userPrefRooms || userPrefRooms.indexOf(h.room) !== -1)), [allHits, userPrefRooms]);
  // The swabs of the pinned day on the map, colored by result; several on one spot are spread in a small spiral
  const mapDayPins = useMemo(() => {
    if (!mapDayLayer || !mapDayLayer.dateKey) return null;
    const dateKey = mapDayLayer.dateKey;
    const rows = dayRowsOf(dateKey);
    const emails = dayEmailsOf(dateKey);
    const counts = { act: 0, watch: 0, unknown: 0, done: 0 };
    const pins = [];
    let estimated = 0;
    let unplaced = 0;
    const add = (o, siteCode, room) => {
      const sp = boloSpotFor(siteCode, room, siteByCode, siteMappings, roomMappings, facilityAreas);
      if (!sp.spot) { unplaced += 1; return; }
      if (sp.estimated) estimated += 1;
      pins.push({ ...o, estimated: sp.estimated, x: sp.spot.x, y: sp.spot.y });
    };
    rows.forEach((r, i) => {
      const tone = rowToneOf(r) === 'plain' ? 'done' : rowToneOf(r);
      counts[tone] += 1;
      add({ id: `${swabRowKey(r)}#${i}`, siteCode: r.siteCode, room: r.room, surface: r.surface, description: r.description, label: rowTestLabel(r), tone, sampleId: r.sampleId }, r.siteCode, r.room);
    });
    emails.forEach(h => {
      counts.unknown += 1;
      add({ id: h.id, siteCode: h.siteCode, room: h.room, surface: h.surface, description: h.description, label: tr('Email only', 'Solo correo'), tone: 'unknown', sampleId: h.sampleId || '' }, h.siteCode, h.room);
    });
    const bySpot = {};
    pins.forEach(p => {
      const k = `${Math.round(p.x * 4)}|${Math.round(p.y * 4)}`;
      (bySpot[k] || (bySpot[k] = [])).push(p);
    });
    Object.keys(bySpot).forEach(k => {
      const g = bySpot[k];
      if (g.length < 2) return;
      g.sort((a, b) => (BOLO_TONE_RANK[a.tone] - BOLO_TONE_RANK[b.tone]) || String(a.siteCode || '').localeCompare(String(b.siteCode || '')));
      g.forEach((p, i) => {
        if (i === 0) return;
        const a = i * 2.4;
        const rr = 0.9 * Math.sqrt(i);
        p.x = Math.max(0.5, Math.min(99.5, p.x + Math.cos(a) * rr));
        p.y = Math.max(0.5, Math.min(99.5, p.y + Math.sin(a) * rr));
      });
    });
    return { dateKey, n: mapDayLayer.n, total: rows.length + emails.length, pinned: pins.length, counts, estimated, unplaced, pins };
  }, [mapDayLayer, dayRowsOf, dayEmailsOf, siteByCode, siteMappings, roomMappings, facilityAreas]);

  // Save one JSON setting to Hub config (new _e_ table first, the old _0_ one second; see boloSaveConfig)
