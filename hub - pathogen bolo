  };
  const levelWord = (lv) => (lv === 'bad' ? tr('Re-upload', 'Volver a subir') : (lv === 'warn' ? tr('Look at', 'Revisar') : tr('Note', 'Nota')));
  const fmtRate = (v) => (v === null || v === undefined ? '--' : `${v.toFixed(2)}%`);
  const weeksShown = showAllWeeks ? check.weeks : check.weeks.slice(-8);
  const statusWord = (s) => {
    if (s === 'agree') return tr('agree', 'coinciden');
    if (s === 'differ') return tr('differ', 'no coinciden');
    if (s === 'no_lab') return tr('no lab rows', 'sin filas del laboratorio');
    return tr('no email', 'sin correo');
  };
  const startOverOpen = showStartOver || check.verdict === 'reupload' || check.verdict === 'empty';
  // Start over also marks the stored Dataverse swab rows replaced when the box is ticked and there are any
  const startOverWithDv = retireDv && dvStored > 0;

  return (
    <section className={`rounded-2xl border shadow-xs ${theme.bgCard}`}>
      <div className="px-4 py-3 flex flex-wrap items-center justify-between gap-2">
        <div className="flex flex-wrap items-center gap-2 min-w-0">
          <h2 className={`text-base font-black ${theme.textHeading}`}>{tr('Import check', 'Revision de carga')}</h2>
          <span className={`px-2 py-0.5 rounded-full text-[11px] font-black border ${verdictInfo.cls}`}>{verdictInfo.chip}</span>
          <span className={`text-xs ${theme.textMuted}`}>
            {tr(`${check.rowsTotal.toLocaleString()} lab rows loaded`, `${check.rowsTotal.toLocaleString()} filas del laboratorio cargadas`)}
            {check.matchedEmailHits === 1 ? tr(', 1 email positive matched to a lab row', ', 1 positivo del correo enlazado a una fila del laboratorio') : ''}
            {check.matchedEmailHits > 1 ? tr(`, ${check.matchedEmailHits} email positives matched to lab rows`, `, ${check.matchedEmailHits} positivos del correo enlazados a filas del laboratorio`) : ''}
          </span>
        </div>
        <button
          type="button"
          onClick={() => setOpen(v => !v)}
          className={`px-2.5 py-1 rounded-lg text-xs font-black border ${theme.bgSubtle}`}
          aria-expanded={open}
        >
          {open ? tr('Hide details', 'Ocultar detalles') : tr('Show details', 'Ver detalles')}
        </button>
      </div>
      <p className="px-4 -mt-1 pb-3 text-sm font-semibold">{verdictInfo.line}</p>

      {open && (
        <div className="px-4 pb-4 space-y-4">
          {check.items.length > 0 && (
            <div className="space-y-2">
              {check.items.map(item => {
                const txt = importCheckText(item);
                return (
                  <div key={item.id} className={`rounded-xl border px-3 py-2 ${levelCls(item.level)}`}>
                    <div className="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                      <span className={`text-[10px] font-black uppercase tracking-wider ${item.level === 'bad' ? (darkMode ? 'text-amber-300' : 'text-amber-800') : theme.textMuted}`}>{levelWord(item.level)}</span>
                      <span className="text-sm font-black">{txt.title}</span>
                    </div>
                    {txt.body && <div className={`text-xs mt-0.5 ${theme.textMuted}`}>{txt.body}</div>}
                    {item.examples.length > 0 && (
                      <ul className="mt-1 space-y-0.5" data-no-translate="1">
                        {item.examples.map((ex, i) => (
                          <li key={i} className="text-[11px] font-mono break-all">
                            {item.id === 'week_differ' ? formatWeekRangeLabel(ex, true) : ex}
                          </li>
                        ))}
                      </ul>
                    )}
                    {txt.fix && <div className="text-xs font-bold mt-1">{txt.fix}</div>}
                    {(item.id === 'typed_yoy' || item.id === 'typed_yoy_example') && canEdit && typeof onResetTypedYoY === 'function' && (
                      <div className="mt-1">
                        <ConfirmButton
                          label={tr('Remove typed cells', 'Quitar celdas escritas')}
                          question={tr('Remove every typed cell from the YoY table? Months with swabs are not affected.', 'Quitar todas las celdas escritas de la tabla YoY? Los meses con hisopos no cambian.')}
                          yesLabel={tr('Yes, remove them', 'Si, quitarlas')}
                          onConfirm={onResetTypedYoY}
                          className={`px-2 py-0.5 rounded-lg text-[11px] font-black border ${theme.bgSubtle}`}
                          yesClassName="px-2 py-0.5 rounded-lg text-[11px] font-black border border-amber-400 bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-700"
                        />
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}

          <div className="grid gap-4 lg:grid-cols-2">
            <div className="min-w-0">
              <h3 className="text-xs font-black uppercase tracking-wider mb-1">{tr('QA email vs lab rows, by week (Listeria, routine swabs)', 'Correo de QA vs filas del laboratorio por semana (Listeria, hisopos de rutina)')}</h3>
              <div className="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                <table className="w-full text-left text-xs border-collapse">
                  <thead className={theme.bgSubtle}>
                    <tr>
                      <th className="py-1.5 px-2">{tr('Week', 'Semana')}</th>
                      <th className="py-1.5 px-2">{tr('QA email', 'Correo de QA')}</th>
                      <th className="py-1.5 px-2">{tr('Lab rows', 'Filas del laboratorio')}</th>
                      <th className="py-1.5 px-2">{tr('Result', 'Resultado')}</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 dark:divide-slate-800">
                    {weeksShown.map(w => {
                      const c = w.cmp;
                      return (
                        <tr key={w.weekKey}>
                          <td className="py-1.5 px-2 font-bold whitespace-nowrap">
                            {formatWeekRangeLabel(w.weekKey, true)}
                            {w.weekKey === LIVE_LAST_WEEK_START ? <span className={`ml-1 ${theme.textMuted}`}>{tr('(last week)', '(semana pasada)')}</span> : null}
                            {w.weekKey === LIVE_CURRENT_WEEK_START ? <span className={`ml-1 ${theme.textMuted}`}>{tr('(this week)', '(esta semana)')}</span> : null}
                          </td>
                          <td className="py-1.5 px-2 font-mono whitespace-nowrap">{c.emLis ? tr(`${c.emLis.positives} of ${c.emLis.total}`, `${c.emLis.positives} de ${c.emLis.total}`) : '--'}</td>
                          <td className="py-1.5 px-2 font-mono whitespace-nowrap">
                            {c.labLis ? tr(`${c.labLis.positives} of ${c.labLis.swabs}`, `${c.labLis.positives} de ${c.labLis.swabs}`) : '--'}
                            {w.labPending > 0 ? <span className={`ml-1 ${theme.textMuted}`}>{tr(`+${w.labPending} waiting`, `+${w.labPending} en espera`)}</span> : null}
                          </td>
                          <td className={`py-1.5 px-2 font-bold whitespace-nowrap ${c.status === 'differ' ? (darkMode ? 'text-amber-300' : 'text-amber-800') : (c.status === 'agree' ? (darkMode ? 'text-emerald-300' : 'text-emerald-700') : theme.textMuted)}`}>
                            {statusWord(c.status)}
                            {w.emailOnly > 0 ? <span className={`ml-1 font-semibold ${theme.textMuted}`}>{tr(`(${w.emailOnly} email-only positive${w.emailOnly === 1 ? '' : 's'})`, `(${w.emailOnly} positivo${w.emailOnly === 1 ? '' : 's'} solo del correo)`)}</span> : null}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              {check.weeks.length > 8 && (
                <button type="button" onClick={() => setShowAllWeeks(v => !v)} className={`mt-1 text-[11px] font-black ${theme.accent}`}>
                  {showAllWeeks ? tr('Show the last 8 weeks', 'Ver las ultimas 8 semanas') : tr(`Show all ${check.weeks.length} weeks`, `Ver las ${check.weeks.length} semanas`)}
                </button>
              )}
            </div>

            <div className="min-w-0">
              <h3 className="text-xs font-black uppercase tracking-wider mb-1">{tr('Saved lab rows by year', 'Filas del laboratorio guardadas por ano')}</h3>
              {check.years.length === 0 ? (
                <div className={`text-xs ${theme.textMuted}`}>{tr('None yet.', 'Ninguna todavia.')}</div>
              ) : (
                <div className="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                  <table className="w-full text-left text-xs border-collapse">
                    <thead className={theme.bgSubtle}>
                      <tr>
                        <th className="py-1.5 px-2">{tr('Year', 'Ano')}</th>
                        <th className="py-1.5 px-2 text-right">{tr('Rows', 'Filas')}</th>
                        <th className="py-1.5 px-2 text-right">{tr('Routine swabs', 'Hisopos de rutina')}</th>
                        <th className="py-1.5 px-2 text-right">{tr('Positives', 'Positivos')}</th>
                        <th className="py-1.5 px-2 text-right">{tr('Rate', 'Porcentaje')}</th>
                        <th className="py-1.5 px-2 text-right">{tr('Waiting', 'En espera')}</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-200 dark:divide-slate-800 font-mono">
                      {check.years.map(y => (
                        <tr key={y.year}>
                          <td className="py-1.5 px-2 font-bold">{y.year}</td>
                          <td className="py-1.5 px-2 text-right">{y.rows.toLocaleString()}</td>
                          <td className="py-1.5 px-2 text-right">{y.swabs.toLocaleString()}</td>
                          <td className="py-1.5 px-2 text-right">{y.positives.toLocaleString()}</td>
                          <td className="py-1.5 px-2 text-right">{fmtRate(y.rate)}</td>
                          <td className="py-1.5 px-2 text-right">{y.pending.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              <div className={`text-[11px] mt-1 ${theme.textMuted}`}>
                {tr(
                  `Routine = environmental Listeria and Salmonella swabs with a finished result. Not in the rate: ${(check.kinds.retest || 0).toLocaleString()} retests, ${(check.kinds.indicator || 0).toLocaleString()} APC / ATP / coliform rows, ${((check.kinds.vector || 0) + (check.kinds.product || 0) + (check.kinds.water || 0)).toLocaleString()} vector / product / water rows.`,
                  `Rutina = hisopos ambientales de Listeria y Salmonella con resultado terminado. Fuera del porcentaje: ${(check.kinds.retest || 0).toLocaleString()} re-pruebas, ${(check.kinds.indicator || 0).toLocaleString()} filas de APC / ATP / coliformes, ${((check.kinds.vector || 0) + (check.kinds.product || 0) + (check.kinds.water || 0)).toLocaleString()} filas de vector / producto / agua.`
                )}
              </div>
              {lastReceipt && (
                <div className={`text-[11px] mt-2 ${theme.textMuted}`}>
                  <span className="font-black">{tr('Last load:', 'Ultima carga:')}</span>{' '}
                  <span data-no-translate="1">{lastReceipt.sourceLabel}</span>{' '}
                  {tr(
                    `(${lastReceipt.timestamp}): ${lastReceipt.scanned || 0} rows read, ${lastReceipt.addedNew || 0} new, ${lastReceipt.upsertedBlankResult || 0} results filled in, ${lastReceipt.duplicatesBlocked || 0} already loaded${lastReceipt.skippedLines ? `, ${lastReceipt.skippedLines} lines that are not lab rows skipped` : ''}.`,
                    `(${lastReceipt.timestamp}): ${lastReceipt.scanned || 0} filas leidas, ${lastReceipt.addedNew || 0} nuevas, ${lastReceipt.upsertedBlankResult || 0} resultados completados, ${lastReceipt.duplicatesBlocked || 0} ya cargadas${lastReceipt.skippedLines ? `, ${lastReceipt.skippedLines} lineas que no son filas del laboratorio saltadas` : ''}.`
                  )}
                </div>
              )}
            </div>
          </div>

          {canEdit ? (
            <div className={`rounded-xl border px-3 py-2.5 ${theme.bgSubtle}`}>
              <button type="button" onClick={() => setShowStartOver(v => !v)} className="text-sm font-black" aria-expanded={startOverOpen}>
                {tr('Start over: clear the saved lab rows and upload every file again', 'Empezar de nuevo: borrar las filas guardadas y subir otra vez cada archivo')}
              </button>
              {startOverOpen && (
                <div className="mt-2 space-y-2 text-xs">
                  <ol className="list-decimal pl-5 space-y-1">
                    <li>{tr('Save each lab export as CSV (in Excel: File, Save As, CSV). Excel workbooks (.xlsx) are not read.', 'Guarde cada exportacion del laboratorio como CSV (en Excel: Archivo, Guardar como, CSV). Los libros de Excel (.xlsx) no se leen.')}</li>
                    <li>
                      {tr('Clear the saved lab rows on this computer:', 'Borre las filas guardadas en esta computadora:')}{' '}
                      <ConfirmButton
                        label={tr('Clear saved lab rows', 'Borrar filas guardadas')}
                        question={startOverWithDv
                          ? tr(`Clear all ${check.rowsTotal.toLocaleString()} saved lab rows on this computer, and mark the ${dvStored.toLocaleString()} swab rows in Dataverse replaced until the lab files are loaded again? Nothing is deleted. The QA emails stay.`, `Borrar las ${check.rowsTotal.toLocaleString()} filas guardadas en esta computadora y marcar las ${dvStored.toLocaleString()} filas de hisopos en Dataverse como reemplazadas hasta que se carguen otra vez los archivos? No se borra nada. Los correos de QA se quedan.`)
                          : tr(`Clear all ${check.rowsTotal.toLocaleString()} saved lab rows on this computer? The QA emails stay.`, `Borrar las ${check.rowsTotal.toLocaleString()} filas guardadas en esta computadora? Los correos de QA se quedan.`)}
                        yesLabel={startOverWithDv ? tr('Yes, clear and mark replaced', 'Si, borrar y marcar reemplazadas') : tr('Yes, clear them', 'Si, borrarlas')}
                        disabled={!!dvSaving}
                        onConfirm={() => onStartFresh({ retireDv: startOverWithDv })}
                        className="ml-1 px-2 py-0.5 rounded-lg text-[11px] font-black border border-amber-400 bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-700 disabled:opacity-50"
                      />
                      {dvStored > 0 && (
                        <label className="mt-1.5 flex items-start gap-2">
                          <input type="checkbox" className="mt-0.5" checked={retireDv} onChange={e => setRetireDv(e.target.checked)} />
                          <span>
                            {tr(`Also take the ${dvStored.toLocaleString()} swab rows saved in Dataverse out of the numbers (marked replaced, not deleted). The upload in step 3 brings back every row the lab files have; a misread row from an older version stays out.`, `Tambien sacar de los numeros las ${dvStored.toLocaleString()} filas de hisopos guardadas en Dataverse (marcadas como reemplazadas, no borradas). La carga del paso 3 regresa cada fila que tienen los archivos; una fila mal leida por una version anterior se queda fuera.`)}
                          </span>
                        </label>
                      )}
                      {dvSaving && (
                        <div className={`mt-1 font-bold ${theme.textMuted}`}>{tr('Saving to Dataverse... wait for it to finish before uploading.', 'Guardando en Dataverse... espere a que termine antes de subir.')}</div>
                      )}
                    </li>
                    <li>
                      {tr('Upload every lab file (you can pick several at once):', 'Suba cada archivo del laboratorio (puede elegir varios a la vez):')}{' '}
                      <button
                        type="button"
                        onClick={() => { if (fileRef.current) fileRef.current.click(); }}
                        className="ml-1 px-2 py-0.5 rounded-lg text-[11px] font-black bg-[#00468B] text-white"
                      >
                        {tr('Upload lab files', 'Subir archivos del laboratorio')}
                      </button>
                      <input
                        ref={fileRef}
                        type="file"
                        multiple
                        accept=".csv,.tsv,.txt"
                        className="hidden"
                        onChange={e => {
                          onUploadFiles(e.target.files);
                          e.target.value = '';
                        }}
                      />
                    </li>
                    <li>{tr('Come back here: the check runs again on its own.', 'Regrese aqui: la revision corre otra vez sola.')}</li>
                  </ol>
                  <div className={theme.textMuted}>
                    {tr('Rows match on Sample ID + description + test, so loading a file twice never counts a swab twice. Swab results already saved to Dataverse are updated, not doubled. Another computer keeps its own saved rows: if someone else loads lab files, they use Start over there too.', 'Las filas se enlazan por Sample ID + descripcion + prueba, asi que subir un archivo dos veces nunca cuenta un hisopo dos veces. Los resultados ya guardados en Dataverse se actualizan, no se duplican. Otra computadora guarda sus propias filas: si alguien mas carga archivos del laboratorio, tambien usa Empezar de nuevo alli.')}
                  </div>
                </div>
              )}
            </div>
          ) : (
            check.verdict === 'reupload' && (
              <div className={`text-xs font-bold ${theme.textMuted}`}>{tr('An admin can clear and re-upload the lab files here.', 'Un admin puede borrar y volver a subir los archivos del laboratorio aqui.')}</div>
            )
          )}
        </div>
      )}
    </section>
  );
}

function DataManipulationLabView({
  darkMode,
  theme: appTheme,
  pressureAnalysis,
  monthlyYoYSeries,
  typedYoYCells,
  onSaveYoYBenchmarks,
  resultCategoryMode,
  setResultCategoryMode,
  parsedCsv,
  importCheck,
  canEdit,
  lastReceipt,
  onStartFresh,
  onUploadFiles,
  dvStored,
  dvSaving,
  onOpenGraphs
}) {
  const theme = INLINE_THEME[darkMode ? 'dark' : 'light'];
  const [labMode, setLabMode] = useState('pivot'); // 'pivot' | 'simulator' | 'benchmarks'
  const [pivotDimension, setPivotDimension] = useState('room'); // 'room' | 'phase' | 'side' | 'category' | 'month'
  const [pivotMetric, setPivotMetric] = useState('positivity'); // 'positivity' | 'positives' | 'share' | 'yoy_delta'
  const [pivotSideFilter, setPivotSideFilter] = useState('ALL'); // 'ALL' | 'Creme Side' | 'Bakery'
  const [pivotCategoryFilter, setPivotCategoryFilter] = useState('ALL'); // 'ALL' | 'Pathogen' | 'APC' | 'ATP'
  const yr = LIVE_CURRENT_YEAR;

  // Multi-Dimensional Pivot Engine (every figure from computePlantPressurePoints and real monthly counts)
  const pivotRows = useMemo(() => {
    const num = (v) => (v === null || v === undefined || isNaN(Number(v)) ? 0 : Number(v));
    const rateOrNull = (v) => (v === null || v === undefined || isNaN(Number(v)) ? null : Number(v));
    const sepRooms = (pressureAnalysis && pressureAnalysis.separation && pressureAnalysis.separation.roomSeparationList) || [];
    const months = Array.isArray(monthlyYoYSeries) ? monthlyYoYSeries.filter((m) => num(m.pathogenSwabsTY) + num(m.apcSwabsTY) + num(m.atpSwabsTY) > 0) : [];
    const mkRow = (key, label, swabs, positives, rate, lyRate, counts, totalPos) => ({
      key,
      label,
      subLabel: tr(`${swabs} swabs`, `${swabs} hisopos`),
      swabs,
      positives,
      positivity: swabs > 0 ? rateOrNull(rate) : null,
      lyPositivity: rateOrNull(lyRate),
      yoyDelta: swabs > 0 && rateOrNull(lyRate) !== null && rateOrNull(rate) !== null ? Number((num(rate) - num(lyRate)).toFixed(2)) : null,
      share: totalPos > 0 ? Number(((positives / totalPos) * 100).toFixed(1)) : 0,
      pathogenCount: counts[0],
      apcCount: counts[1],
      atpCount: counts[2]
    });

    if (pivotDimension === 'month') {
      const totalPos = months.reduce((acc, m) => acc + num(m.pathogenPosTY), 0);
      return months.map((m) => mkRow(m.month, `${m.month} ${yr}`, num(m.pathogenSwabsTY), num(m.pathogenPosTY), m.pathogenTY, m.pathogenLY,
        [num(m.pathogenPosTY), num(m.apcPosTY), num(m.atpPosTY)], totalPos));
    }

    const cats = (pressureAnalysis && pressureAnalysis.byCategory) || {};
    const pick = (cat, path) => path.reduce((o, k) => (o ? o[k] : undefined), cats[cat]) || {};

    if (pivotDimension === 'side') {
      const sides = [['Creme Side', tr('Creme side (WJ, IBL4, IBL5)', 'Lado crema (WJ, IBL4, IBL5)'), 'creme'], ['Bakery', tr('Bakery (Custard, Dough, Cook, Highspeed)', 'Panaderia (Custard, Dough, Cook, Highspeed)'), 'bakery']];
      const totalPos = sides.reduce((acc, s) => acc + num(pick('pathogen', ['cremeAndBakery', s[2]]).positives), 0);
      return sides.map(([key, label, k]) => {
        const p = pick('pathogen', ['cremeAndBakery', k]);
        return mkRow(key, label, num(p.totalSwabs), num(p.positives), p.thisYearRate, p.lastYearRate,
          [num(p.positives), num(pick('apc', ['cremeAndBakery', k]).positives), num(pick('atp', ['cremeAndBakery', k]).positives)], totalPos);
      });
    }

    if (pivotDimension === 'phase') {
      const phases = [['In-Process', tr('In-process (INP)', 'En proceso (INP)'), 'inp'], ['Start-Up', tr('Start-up (ST)', 'Arranque (ST)'), 'startup']];
      const totalPos = phases.reduce((acc, s) => acc + num(pick('pathogen', ['inProcessAndStartup', s[2]]).positives), 0);
      return phases.map(([key, label, k]) => {
        const p = pick('pathogen', ['inProcessAndStartup', k]);
        return mkRow(key, label, num(p.totalSwabs), num(p.positives), p.thisYearRate, p.lastYearRate,
          [num(p.positives), num(pick('apc', ['inProcessAndStartup', k]).positives), num(pick('atp', ['inProcessAndStartup', k]).positives)], totalPos);
      });
    }

    if (pivotDimension === 'category') {
      const list = [['Pathogen', tr('Pathogen (Listeria, Salmonella)', 'Patogenos (Listeria, Salmonella)'), 'pathogen', 0], ['APC', 'APC', 'apc', 1], ['ATP', 'ATP', 'atp', 2]];
      const totalPos = list.reduce((acc, c) => acc + num(pick(c[2], ['overall']).positives), 0);
      return list.map(([key, label, cat, idx]) => {
        const o = pick(cat, ['overall']);
        const counts = [0, 0, 0];
        counts[idx] = num(o.positives);
        return mkRow(key, label, num(o.totalSwabs), num(o.positives), o.thisYearRate, o.lastYearRate, counts, totalPos);
      });
    }

    // Default: rooms, filtered by side and test
    const filteredRooms = sepRooms.filter((r) => r.hasData && (pivotSideFilter === 'ALL' || r.side === pivotSideFilter));
    const pick3 = (r) => {
      if (pivotCategoryFilter === 'Pathogen') return [num(r.pathogenSwabs), num(r.pathogenPos), r.pathogenRate, r.lyPathRate];
      if (pivotCategoryFilter === 'APC') return [num(r.apcSwabs), num(r.apcFail), r.apcRate, r.apc ? r.apc.lastYearRate : null];
      if (pivotCategoryFilter === 'ATP') return [num(r.atpSwabs), num(r.atpFail), r.atpRate, null];
      return [num(r.combinedSwabs), num(r.combinedHits), r.combinedRate, null];
    };
    const totalRoomPos = filteredRooms.reduce((acc, r) => acc + pick3(r)[1], 0);
    return filteredRooms.map((r) => {
      const [swabs, pos, rate, lyRate] = pick3(r);
      const row = mkRow(r.room, r.label || r.room, swabs, pos, rate, lyRate, [num(r.pathogenPos), num(r.apcFail), num(r.atpFail)], totalRoomPos);
      row.subLabel = `${r.side} - ${tr(`${swabs} swabs`, `${swabs} hisopos`)}`;
      return row;
    }).filter((row) => row.swabs > 0);
  }, [pressureAnalysis, monthlyYoYSeries, pivotDimension, pivotSideFilter, pivotCategoryFilter, yr]);

  const metricOf = (r) => {
    if (pivotMetric === 'positivity') return r.positivity;
    if (pivotMetric === 'positives') return r.positives;
    if (pivotMetric === 'share') return r.share;
    return r.yoyDelta;
  };
  const pivotMax = Math.max(1, ...pivotRows.map((r) => Math.abs(metricOf(r) || 0)));

  // What-if (count based): one slider per room with positives this year, plus start-up and in-process
  const simCat = resultCategoryMode || 'pathogen';
  const [cutRooms, setCutRooms] = useState({});
  const [cutStages, setCutStages] = useState({ ST: 0, INP: 0 });
  const rowsForSim = parsedCsv && Array.isArray(parsedCsv.rows) ? parsedCsv.rows : [];
  const baseSim = useMemo(() => simulatePositiveCuts(rowsForSim, simCat, {}), [rowsForSim, simCat]);
  const simRooms = useMemo(() => Object.keys(baseSim.rooms)
    .filter((rk) => baseSim.rooms[rk].positives > 0)
    .sort((a, b) => baseSim.rooms[b].positives - baseSim.rooms[a].positives)
    .slice(0, 8), [baseSim]);
  const sim = useMemo(() => simulatePositiveCuts(rowsForSim, simCat, { rooms: cutRooms, stages: cutStages }), [rowsForSim, simCat, cutRooms, cutStages]);
  const simLyCat = pressureAnalysis && pressureAnalysis.byCategory && pressureAnalysis.byCategory[simCat];
  const simLyRate = simLyCat && simLyCat.overall ? simLyCat.overall.lastYearRate : null;
  const fmtPctOrDash = (v) => (v === null || v === undefined ? '--' : `${v.toFixed(2)}%`);

  // YoY table: real months are read only; only months with no swabs can be typed (see mergeYoYBenchmarks)
  const tableMonths = Array.isArray(monthlyYoYSeries) ? monthlyYoYSeries : [];
  const nowMonth = parseInt(LIVE_TODAY_DATE_KEY.slice(5, 7), 10) - 1;
  const [benchmarkDraft, setBenchmarkDraft] = useState({});
  const [benchmarkSaveBanner, setBenchmarkSaveBanner] = useState('');
  useEffect(() => {
    const d = {};
    tableMonths.forEach((m) => {
      (m.typedFields || []).forEach((k) => { d[`${m.month}|${k}`] = String(m[k]); });
    });
    setBenchmarkDraft(d);
  }, [monthlyYoYSeries]);
  const isTypedCell = (m, k) => (m.typedFields || []).indexOf(k) !== -1;
  const isRealCell = (m, k) => m[k] !== null && m[k] !== undefined && !isTypedCell(m, k);
  const isLockedFuture = (m, k) => /TY$/.test(k) && m.monthIndex > nowMonth;

  const handleSaveBenchmarks = () => {
    if (typeof onSaveYoYBenchmarks !== 'function') return;
    let any = false;
    const series = tableMonths.map((m) => {
      const o = { month: m.month, monthIndex: m.monthIndex };
      YOY_TYPED_FIELDS.forEach((k) => {
        const v = parseFloat(benchmarkDraft[`${m.month}|${k}`]);
        const ok = v > 0 && isFinite(v) && !isRealCell(m, k) && !isLockedFuture(m, k);
        o[k] = ok ? round2(Math.min(100, v)) : null;
        if (ok) any = true;
      });
      return o;
    });
    onSaveYoYBenchmarks(any ? series : null);
    setBenchmarkSaveBanner(any
      ? tr('Saved. The typed cells fill months with no swabs on the graphs (Tab 3).', 'Guardado. Las celdas escritas llenan los meses sin hisopos en las graficas (pestana 3).')
      : tr('Saved with no typed cells: the graphs show only real months.', 'Guardado sin celdas escritas: las graficas muestran solo meses reales.'));
    setTimeout(() => setBenchmarkSaveBanner(''), 4000);
  };

  const exportPivotCsv = () => {
    try {
      const headers = ['Dimension_Key', 'Label', 'Swabs', 'Positives', 'Positivity_Pct', 'LY_Positivity_Pct', 'YoY_Delta_Pct', 'Share_Pct', 'Pathogen_Count', 'APC_Count', 'ATP_Count'];
      const cell = (v) => (v === null || v === undefined ? '' : v);
      const lines = [headers.join(',')];
      pivotRows.forEach((r) => {
        lines.push([
          `"${String(r.key).replace(/"/g, '""')}"`,
          `"${String(r.label).replace(/"/g, '""')}"`,
          r.swabs,
          r.positives,
          cell(r.positivity),
          cell(r.lyPositivity),
          cell(r.yoyDelta),
          r.share,
          r.pathogenCount,
          r.apcCount,
          r.atpCount
        ].join(','));
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Stilwell_Pathogen_BOLO_Pivot_${pivotDimension}_${LIVE_TODAY_DATE_KEY}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    } catch (_e) {}
  };

  const card = { background: theme.cardBg, border: `1px solid ${theme.border}`, borderRadius: '14px', padding: '16px 18px', boxShadow: theme.shadow, color: theme.text };
  const subtleBg = darkMode ? '#0f172a' : '#f8fafc';
  const pillBtn = (active) => ({
    background: active ? theme.accent : (darkMode ? '#1e293b' : '#f1f5f9'),
    color: active ? '#ffffff' : theme.text,
    border: `1px solid ${active ? theme.accent : theme.border}`,
    borderRadius: '8px',
    padding: '7px 11px',
    fontSize: '11px',
    fontWeight: 900,
    cursor: 'pointer'
  });
  const selectStyle = { background: subtleBg, color: theme.text, border: `1px solid ${theme.border}`, borderRadius: '7px', padding: '6px 10px', fontSize: '11px', fontWeight: 800 };
  const catLabel = { pathogen: tr('Pathogen (Listeria, Salmonella)', 'Patogenos (Listeria, Salmonella)'), apc: 'APC', atp: 'ATP', all: tr('All tests', 'Todas las pruebas') };

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-3 sm:p-4 pb-32" style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
      <ImportCheckPanel
        darkMode={darkMode}
        theme={appTheme}
        check={importCheck}
        canEdit={canEdit}
        lastReceipt={lastReceipt}
        onStartFresh={onStartFresh}
        onUploadFiles={onUploadFiles}
        dvStored={dvStored}
        dvSaving={dvSaving}
        onResetTypedYoY={() => { if (typeof onSaveYoYBenchmarks === 'function') onSaveYoYBenchmarks(null); }}
      />

      {/* Mode switcher */}
      <div style={card}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
          <div>
            <h2 style={{ margin: 0, fontSize: '16px', fontWeight: 900, color: theme.text }}>
              {tr(`Data Manipulation: ${yr} to date`, `Manipulacion de datos: ${yr} a la fecha`)}
            </h2>
            <p style={{ margin: '3px 0 0 0', fontSize: '12px', color: theme.textMuted }}>
              {tr('Every number here comes from the lab rows loaded (finished routine and APC / ATP swabs). A slice with no swabs shows --.', 'Cada numero sale de las filas del laboratorio cargadas (hisopos de rutina y APC / ATP terminados). Una parte sin hisopos muestra --.')}
            </p>
          </div>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexWrap: 'wrap' }}>
            {[
              { id: 'pivot', label: tr('Break down', 'Desglose') },
              { id: 'simulator', label: tr('What if', 'Que pasaria si') },
              { id: 'benchmarks', label: tr('YoY table', 'Tabla YoY') }
            ].map((tab) => (
              <button key={tab.id} type="button" onClick={() => setLabMode(tab.id)} style={pillBtn(labMode === tab.id)}>
                {tab.label}
              </button>
            ))}
            {typeof onOpenGraphs === 'function' && (
              <button type="button" onClick={onOpenGraphs} style={{ ...pillBtn(false), background: 'transparent', color: theme.accent, border: `1px solid ${theme.accent}` }}>
                {tr('Graphs (Tab 3)', 'Graficas (pestana 3)')}
              </button>
            )}
          </div>
        </div>
      </div>

      {/* MODE 1: BREAK DOWN */}
      {labMode === 'pivot' && (
        <div style={card}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px', marginBottom: '14px', paddingBottom: '12px', borderBottom: `1px solid ${theme.border}` }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexWrap: 'wrap' }}>
              <span style={{ fontSize: '11px', fontWeight: 900, color: theme.textMuted, textTransform: 'uppercase' }}>{tr('Group by:', 'Agrupar por:')}</span>
              {[
                { id: 'room', label: tr('Room', 'Area') },
                { id: 'side', label: tr('Creme vs Bakery', 'Crema vs Panaderia') },
                { id: 'phase', label: tr('In-process vs Start-up', 'En proceso vs Arranque') },
                { id: 'category', label: tr('Pathogen vs APC vs ATP', 'Patogenos vs APC vs ATP') },
                { id: 'month', label: tr(`Month (${yr})`, `Mes (${yr})`) }
              ].map((dim) => (
                <button key={dim.id} type="button" onClick={() => setPivotDimension(dim.id)} style={{ ...pillBtn(pivotDimension === dim.id), fontWeight: 800, padding: '6px 10px' }}>
                  {dim.label}
                </button>
              ))}
            </div>

            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexWrap: 'wrap' }}>
              <select aria-label={tr('Value to show', 'Valor a mostrar')} value={pivotMetric} onChange={(e) => setPivotMetric(e.target.value)} style={selectStyle}>
                <option value="positivity">{tr('Show: positive rate (%)', 'Mostrar: porcentaje de positivos')}</option>
                <option value="positives">{tr('Show: positives', 'Mostrar: positivos')}</option>
                <option value="share">{tr('Show: share of all positives', 'Mostrar: parte del total de positivos')}</option>
                <option value="yoy_delta">{tr('Show: change vs last year (points)', 'Mostrar: cambio vs ano pasado (puntos)')}</option>
              </select>

              {pivotDimension === 'room' && (
                <>
                  <select aria-label={tr('Side', 'Lado')} value={pivotSideFilter} onChange={(e) => setPivotSideFilter(e.target.value)} style={selectStyle}>
                    <option value="ALL">{tr('Side: whole plant', 'Lado: toda la planta')}</option>
                    <option value="Creme Side">{tr('Side: creme only', 'Lado: solo crema')}</option>
                    <option value="Bakery">{tr('Side: bakery only', 'Lado: solo panaderia')}</option>
                  </select>
                  <select aria-label={tr('Test', 'Prueba')} value={pivotCategoryFilter} onChange={(e) => setPivotCategoryFilter(e.target.value)} style={selectStyle}>
                    <option value="ALL">{tr('Test: all', 'Prueba: todas')}</option>
                    <option value="Pathogen">{tr('Test: pathogen only', 'Prueba: solo patogenos')}</option>
                    <option value="APC">{tr('Test: APC only', 'Prueba: solo APC')}</option>
                    <option value="ATP">{tr('Test: ATP only', 'Prueba: solo ATP')}</option>
                  </select>
                </>
              )}

              <button type="button" onClick={exportPivotCsv} style={{ background: '#047857', color: '#ffffff', border: 'none', borderRadius: '7px', padding: '6px 12px', fontSize: '11px', fontWeight: 900, cursor: 'pointer' }}>
                {tr('Export CSV', 'Exportar CSV')}
              </button>
            </div>
          </div>

          {pivotRows.length === 0 ? (
            <div style={{ fontSize: '12px', color: theme.textMuted }}>{tr(`No finished lab rows for ${yr} in this view yet.`, `Todavia no hay filas terminadas de ${yr} en esta vista.`)}</div>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              {pivotRows.map((row) => {
                const v = metricOf(row);
                const pct = v === null ? 0 : Math.min(100, (Math.abs(v) / pivotMax) * 100);
                let shown = '--';
                if (pivotMetric === 'positivity' && row.positivity !== null) shown = tr(`${row.positivity.toFixed(2)}% (last year ${row.lyPositivity === null ? '--' : `${row.lyPositivity.toFixed(2)}%`})`, `${row.positivity.toFixed(2)}% (ano pasado ${row.lyPositivity === null ? '--' : `${row.lyPositivity.toFixed(2)}%`})`);
                if (pivotMetric === 'positives') shown = tr(`${row.positives} positives`, `${row.positives} positivos`);
                if (pivotMetric === 'share') shown = tr(`${row.share.toFixed(1)}% of positives`, `${row.share.toFixed(1)}% de los positivos`);
                if (pivotMetric === 'yoy_delta' && row.yoyDelta !== null) shown = tr(`${row.yoyDelta > 0 ? '+' : ''}${row.yoyDelta.toFixed(2)} points vs last year`, `${row.yoyDelta > 0 ? '+' : ''}${row.yoyDelta.toFixed(2)} puntos vs ano pasado`);
                return (
                  <div key={row.key} style={{ background: subtleBg, border: `1px solid ${theme.border}`, borderRadius: '10px', padding: '9px 13px' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', marginBottom: '6px', flexWrap: 'wrap' }}>
                      <div>
                        <span style={{ fontSize: '13px', fontWeight: 900, color: theme.text }}>{row.label}</span>
                        <span style={{ fontSize: '11px', color: theme.textMuted, marginLeft: '8px' }}>({row.subLabel})</span>
                      </div>
                      <div style={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: '12px', fontSize: '11px', fontWeight: 800 }}>
                        <span style={{ color: theme.textMuted }}>{tr('Pathogen', 'Patogenos')} {row.pathogenCount} | APC {row.apcCount} | ATP {row.atpCount}</span>
                        <span style={{ fontSize: '13px', fontWeight: 900, color: theme.text }}>{shown}</span>
                      </div>
                    </div>
                    <div style={{ height: '8px', background: darkMode ? '#1e293b' : '#e2e8f0', borderRadius: '999px', overflow: 'hidden' }}>
                      <div style={{ width: `${v === null ? 0 : Math.max(2, pct)}%`, height: '100%', background: pivotMetric === 'yoy_delta' ? (v !== null && v <= 0 ? '#047857' : '#B45309') : '#0072CE', borderRadius: '999px' }} />
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* MODE 2: WHAT IF (counts from the lab rows) */}
      {labMode === 'simulator' && (
        <div style={card}>
          <div style={{ marginBottom: '12px', display: 'flex', justifyContent: 'space-between', gap: '12px', flexWrap: 'wrap', alignItems: 'flex-start' }}>
            <div style={{ maxWidth: '760px' }}>
              <h3 style={{ margin: 0, fontSize: '15px', fontWeight: 900, color: theme.text }}>
                {tr('What if a fix removed some of the positives in a room or a stage?', 'Que pasaria si una correccion quitara parte de los positivos de un area o una etapa?')}
              </h3>
              <p style={{ margin: '4px 0 0 0', fontSize: '12px', color: theme.textMuted }}>
                {tr(`Uses the ${yr} lab rows behind the rates. Each slider removes that share of the positives in its room or stage; the number of swabs stays the same. A swab in a room and a stage counts both cuts once each, never more than the swab.`, `Usa las filas de ${yr} que forman los porcentajes. Cada control quita esa parte de los positivos de su area o etapa; el numero de hisopos no cambia. Un hisopo en un area y una etapa recibe cada recorte una vez, nunca mas que el hisopo.`)}
              </p>
            </div>
            <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap' }}>
              <select aria-label={tr('Test', 'Prueba')} value={simCat} onChange={(e) => setResultCategoryMode(e.target.value)} style={selectStyle}>
                <option value="pathogen">{catLabel.pathogen}</option>
                <option value="apc">APC</option>
                <option value="atp">ATP</option>
                <option value="all">{catLabel.all}</option>
              </select>
              <button type="button" onClick={() => { setCutRooms({}); setCutStages({ ST: 0, INP: 0 }); }} style={pillBtn(false)}>
                {tr('Reset sliders', 'Reiniciar controles')}
              </button>
            </div>
          </div>

          {baseSim.overall.swabs === 0 ? (
            <div style={{ fontSize: '12px', color: theme.textMuted }}>{tr(`No finished ${yr} lab rows for this test yet.`, `Todavia no hay filas terminadas de ${yr} para esta prueba.`)}</div>
          ) : (
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: '16px' }}>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', background: subtleBg, border: `1px solid ${theme.border}`, borderRadius: '12px', padding: '12px 14px' }}>
                {simRooms.length === 0 && (
                  <div style={{ fontSize: '12px', color: theme.textMuted }}>{tr('No positives this year for this test.', 'No hay positivos este ano para esta prueba.')}</div>
                )}
                {simRooms.map((rk) => {
                  const b = baseSim.rooms[rk];
                  const val = cutRooms[rk] || 0;
                  return (
                    <div key={rk}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px', fontWeight: 800, marginBottom: '3px', gap: '6px' }}>
                        <span style={{ color: theme.text }}>{(ROOM_META[rk] && ROOM_META[rk].label) || rk} <span style={{ color: theme.textMuted, fontWeight: 700 }}>{tr(`${b.positives} of ${b.swabs}`, `${b.positives} de ${b.swabs}`)}</span></span>
                        <span style={{ color: theme.text, fontWeight: 900 }}>{val > 0 ? tr(`-${val}% of its positives`, `-${val}% de sus positivos`) : tr('no change', 'sin cambio')}</span>
                      </div>
                      <input
                        type="range"
                        min="0"
                        max="100"
                        step="5"
                        value={val}
                        aria-label={tr(`Cut for ${rk}`, `Recorte para ${rk}`)}
                        onChange={(e) => { const n = Number(e.target.value); setCutRooms((p) => ({ ...p, [rk]: n })); }}
                        style={{ width: '100%', cursor: 'pointer' }}
                      />
                    </div>
                  );
                })}
                {['ST', 'INP'].map((st) => {
                  const b = baseSim.stages[st];
                  const val = cutStages[st] || 0;
                  if (!b || b.swabs === 0) return null;
                  return (
                    <div key={st}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px', fontWeight: 800, marginBottom: '3px', gap: '6px' }}>
                        <span style={{ color: theme.text }}>{st === 'ST' ? tr('Start-up (ST)', 'Arranque (ST)') : tr('In-process (INP)', 'En proceso (INP)')} <span style={{ color: theme.textMuted, fontWeight: 700 }}>{tr(`${b.positives} of ${b.swabs}`, `${b.positives} de ${b.swabs}`)}</span></span>
                        <span style={{ color: theme.text, fontWeight: 900 }}>{val > 0 ? tr(`-${val}% of its positives`, `-${val}% de sus positivos`) : tr('no change', 'sin cambio')}</span>
                      </div>
                      <input
                        type="range"
                        min="0"
                        max="100"
                        step="5"
                        value={val}
                        aria-label={tr(`Cut for ${st}`, `Recorte para ${st}`)}
                        onChange={(e) => { const n = Number(e.target.value); setCutStages((p) => ({ ...p, [st]: n })); }}
                        style={{ width: '100%', cursor: 'pointer' }}
                      />
                    </div>
                  );
                })}
              </div>

              <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                <div style={{ background: darkMode ? 'rgba(4,120,87,0.14)' : '#ecfdf5', border: '1px solid rgba(4,120,87,0.35)', borderRadius: '12px', padding: '12px 14px' }}>
                  <div style={{ fontSize: '11px', fontWeight: 900, color: darkMode ? '#6ee7b7' : '#047857', textTransform: 'uppercase' }}>
                    {tr(`${catLabel[simCat] || simCat}: plant rate ${yr}`, `${catLabel[simCat] || simCat}: porcentaje de planta ${yr}`)}
                  </div>
                  <div style={{ display: 'flex', alignItems: 'baseline', gap: '10px', marginTop: '4px', flexWrap: 'wrap' }}>
                    <span style={{ fontSize: '28px', fontWeight: 900, color: theme.text }}>{fmtPctOrDash(sim.overall.simRate)}</span>
                    <span style={{ fontSize: '13px', fontWeight: 800, color: theme.textMuted }}>
                      {tr(`now ${fmtPctOrDash(sim.overall.rate)} (${sim.overall.positives} of ${sim.overall.swabs})`, `ahora ${fmtPctOrDash(sim.overall.rate)} (${sim.overall.positives} de ${sim.overall.swabs})`)}
                    </span>
                  </div>
                  <div style={{ fontSize: '12px', fontWeight: 800, color: theme.text, marginTop: '4px' }}>
                    {sim.overall.positives - sim.overall.simPositives > 0
                      ? tr(`About ${(sim.overall.positives - sim.overall.simPositives).toFixed(1)} fewer positives this year.`, `Cerca de ${(sim.overall.positives - sim.overall.simPositives).toFixed(1)} positivos menos este ano.`)
                      : tr('Move a slider to see the rate if a fix had removed some of those positives.', 'Mueva un control para ver el porcentaje si una correccion hubiera quitado algunos de esos positivos.')}
                    {simLyRate !== null && simLyRate !== undefined
                      ? tr(` Same span last year: ${fmtPctOrDash(simLyRate)}.`, ` Mismo periodo del ano pasado: ${fmtPctOrDash(simLyRate)}.`)
                      : ''}
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))', gap: '10px' }}>
                  {[
                    { title: tr('Start-up (ST)', 'Arranque (ST)'), b: sim.stages.ST },
                    { title: tr('In-process (INP)', 'En proceso (INP)'), b: sim.stages.INP },
                    { title: tr('Creme side', 'Lado crema'), b: sim.sides.Creme },
                    { title: tr('Bakery', 'Panaderia'), b: sim.sides.Bakery }
                  ].map((c) => (
                    <div key={c.title} style={{ background: subtleBg, border: `1px solid ${theme.border}`, borderRadius: '10px', padding: '9px 11px' }}>
                      <div style={{ fontSize: '11px', fontWeight: 800, color: theme.textMuted }}>{c.title}</div>
                      <div style={{ fontSize: '19px', fontWeight: 900, color: theme.text, marginTop: '2px' }}>{fmtPctOrDash(c.b ? c.b.simRate : null)}</div>
                      <div style={{ fontSize: '10px', color: theme.textMuted }}>
                        {c.b && c.b.swabs > 0
                          ? tr(`now ${fmtPctOrDash(c.b.rate)} (${c.b.positives} of ${c.b.swabs})`, `ahora ${fmtPctOrDash(c.b.rate)} (${c.b.positives} de ${c.b.swabs})`)
                          : tr('no swabs', 'sin hisopos')}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      {/* MODE 3: YOY TABLE (real months read only; empty months can be typed) */}
      {labMode === 'benchmarks' && (
        <div style={card}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px', marginBottom: '10px' }}>
            <div style={{ maxWidth: '760px' }}>
              <h3 style={{ margin: 0, fontSize: '15px', fontWeight: 900, color: theme.text }}>
                {tr('Monthly YoY table', 'Tabla mensual YoY')}
              </h3>
              <p style={{ margin: '3px 0 0 0', fontSize: '12px', color: theme.textMuted }}>
                {tr(`Months with swabs show the real rate and cannot be typed over. A month with no swabs loaded (for example last year before the first upload) can be filled from a past report; typed cells are marked and saved to Dataverse (PATHOGEN_BOLO_YOY_BENCHMARKS). ${typedYoYCells > 0 ? `${typedYoYCells} typed cells in use.` : ''}`, `Los meses con hisopos muestran el porcentaje real y no se pueden escribir encima. Un mes sin hisopos cargados (por ejemplo el ano pasado antes de la primera carga) se puede llenar con un reporte anterior; las celdas escritas se marcan y se guardan en Dataverse (PATHOGEN_BOLO_YOY_BENCHMARKS). ${typedYoYCells > 0 ? `${typedYoYCells} celdas escritas en uso.` : ''}`)}
              </p>
            </div>
            {canEdit && (
              <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
                <button type="button" onClick={handleSaveBenchmarks} style={{ background: '#047857', color: '#ffffff', border: 'none', borderRadius: '8px', padding: '8px 14px', fontSize: '12px', fontWeight: 900, cursor: 'pointer' }}>
                  {tr('Save typed cells', 'Guardar celdas escritas')}
                </button>
              </div>
            )}
