                    }`}
                    style={{ left: `${site.effectiveSpot.x}%`, top: `${site.effectiveSpot.y}%` }}
                  />
                );
              })}

              {/* 5. ACTIVE BOLO HIT PINS & PULSING STREAK RINGS (Hidden in Bare Map Mode) */}
