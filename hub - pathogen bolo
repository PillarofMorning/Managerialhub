  if (Object.prototype.hasOwnProperty.call(ES_MX_EXACT_MAP, trimmed) && typeof ES_MX_EXACT_MAP[trimmed] === 'string') {
    const exactOut = inputStr.replace(trimmed, ES_MX_EXACT_MAP[trimmed]);
    ES_MX_TRANSLATED_VALUES[exactOut.trim()] = true;
    return exactOut;
  }
  let out = inputStr;
  let matchedPhrase = false;
  for (let i = 0; i < ES_MX_PHRASE_PAIRS.length; i += 1) {
    const [enPhrase, esPhrase] = ES_MX_PHRASE_PAIRS[i];
    if (enPhrase === 'Actual' && out.indexOf('Actuales') !== -1) continue;
    if (out.indexOf(enPhrase) !== -1 && out.indexOf(esPhrase) === -1) {
      out = out.split(enPhrase).join(esPhrase);
      matchedPhrase = true;
    }
  }
  const wordTranslated = applyWordLevelEsMx(out);
  const finalOut = wordTranslated || (matchedPhrase ? out : inputStr);
  if (finalOut !== inputStr) {
    ES_MX_TRANSLATED_VALUES[finalOut.trim()] = true;
  }
  return finalOut;
}

