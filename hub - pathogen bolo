function ExecutivePercentagesAndSynopsisDeck({
  darkMode,
  theme,
  pressureAnalysis,
  resultCategoryMode,
  setResultCategoryMode,
  executiveSynopses,
  onSaveExecutiveSynopsis,
  onOpenGraphs,
  compact = false
}) {
  const [editingKey, setEditingKey] = useState(null);
  const [draftText, setDraftText] = useState('');
  const [savingKey, setSavingKey] = useState(null);
  const [statusToast, setStatusToast] = useState('');

  const em = (pressureAnalysis && pressureAnalysis.executiveMetrics) || {};
  const byCategory = em.byCategory || {};
  const activeMode = resultCategoryMode || 'pathogen';
  const EMPTY_METRIC = { overallRate: null, combinedRate: null, positives: 0, totalSwabs: 0, thisYearRate: null, lastYearRate: null, yoyDeltaPct: null, stRateTY: null, inpRateTY: null, stRateLY: null, inpRateLY: null, sharePct: null, lineBreakdown: '', synopsis: '' };
  const catData = byCategory[activeMode] || byCategory.pathogen || {
    label: 'Pathogen Only (Default: LIS / Retest / SAL)',
    shortLabel: 'Pathogen Only',
    overall: em.overall || EMPTY_METRIC,
    inProcessAndStartup: em.inProcessAndStartup || { inp: EMPTY_METRIC, startup: EMPTY_METRIC, synopsis: '' },
    cremeAndBakery: em.cremeAndBakery || { creme: EMPTY_METRIC, bakery: EMPTY_METRIC, synopsis: '' }
  };

  const EMPTY_SEP = { positives: 0, swabs: 0, rate: null, lyRate: null, yoyDelta: null, inpRate: null, stRate: null, cremeRate: null, bakeryRate: null };
  const sep = em.separation || {
    pathogen: { ...EMPTY_SEP, label: 'Pathogen (LIS / Retest / SAL)' },
    apc: { ...EMPTY_SEP, label: 'APC Indicator (Aerobic Plate Count)' },
    atp: { ...EMPTY_SEP, label: 'ATP & Other Rapid Indicators' },
    all: { ...EMPTY_SEP, label: 'All Results Combined' }
  };

  const getEffectiveSynopsis = (metricSlot, defaultAutoSynopsis) => {
    const fullKey = `${activeMode}_${metricSlot}`;
    const savedEntry = executiveSynopses && executiveSynopses[fullKey];
    if (savedEntry && savedEntry.text) {
      return {
        fullKey,
        text: savedEntry.text,
        isCustomSaved: true,
        updatedAt: savedEntry.updatedAt ? String(savedEntry.updatedAt).slice(0, 16).replace('T', ' ') : 'Saved',
        updatedBy: savedEntry.updatedBy || ''
      };
    }
    return {
      fullKey,
      text: defaultAutoSynopsis || '',
      isCustomSaved: false,
      updatedAt: null,
      updatedBy: null
    };
  };

  const startEditingSynopsis = (fullKey, currentText) => {
    setEditingKey(fullKey);
    setDraftText(currentText || '');
  };

  const handleSaveSynopsis = async (fullKey) => {
    if (!onSaveExecutiveSynopsis) return;
    setSavingKey(fullKey);
    const res = await onSaveExecutiveSynopsis(fullKey, draftText, false);
    setSavingKey(null);
    setEditingKey(null);
    setStatusToast(
      res && res.mode === 'dataverse'
        ? 'Saved edited YoY Synopsis to Dataverse (PATHOGEN_BOLO_EXEC_SYNOPSES).'
        : 'Saved edited YoY Synopsis locally & queued for Dataverse sync.'
    );
    window.setTimeout(() => setStatusToast(''), 4500);
  };

  const handleReEvaluateSynopsis = async (fullKey, liveAutoText) => {
    if (!onSaveExecutiveSynopsis) return;
    setSavingKey(fullKey);
    await onSaveExecutiveSynopsis(fullKey, liveAutoText, true);
    setSavingKey(null);
    setEditingKey(null);
    setDraftText(liveAutoText || '');
    setStatusToast('Re-evaluated YoY Synopsis from live plant dataset & updated Dataverse.');
    window.setTimeout(() => setStatusToast(''), 4500);
  };

  const synOverall = getEffectiveSynopsis('overall', catData.overall.synopsis);
  const synInpSt = getEffectiveSynopsis('inProcessAndStartup', catData.inProcessAndStartup.synopsis);
  const synCremeBakery = getEffectiveSynopsis('cremeAndBakery', catData.cremeAndBakery.synopsis);

  const renderSynopsisEditorBlock = (synObj, liveAutoText, accentColorClass) => {
    const isEditing = editingKey === synObj.fullKey;
    const isBusy = savingKey === synObj.fullKey;
    return (
      <div className={`p-2.5 rounded-xl border text-[11px] leading-snug ${
        darkMode ? 'bg-slate-900/80 border-slate-800 text-slate-200' : 'bg-slate-50 border-slate-200/90 text-slate-700'
      }`}>
        <div className="flex flex-wrap items-center justify-between gap-1.5 mb-1">
          <div className="flex items-center gap-1.5 flex-wrap">
            <span className={`font-black uppercase text-[10px] ${accentColorClass}`}>
              YoY Synopsis ({em.thisYearLabel || '2026'} vs {em.lastYearLabel || '2025'}):
            </span>
            <span className={`px-1.5 py-0.2 rounded text-[9px] font-mono font-bold ${
              synObj.isCustomSaved
                ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-500/30'
                : (darkMode ? 'bg-slate-800 text-sky-300' : 'bg-sky-50 text-[#00468B]')
            }`}>
              {synObj.isCustomSaved ? `Dataverse Saved (${synObj.updatedAt})` : 'Live Auto-Evaluated'}
            </span>
          </div>

          {!isEditing && (
            <div className="flex items-center gap-1">
              <button
                type="button"
                onClick={() => startEditingSynopsis(synObj.fullKey, synObj.text)}
                className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-black transition-colors ${
                  darkMode
                    ? 'bg-sky-950/80 text-sky-300 border border-sky-800 hover:bg-sky-900'
                    : 'bg-[#E6F1FB] text-[#00468B] hover:bg-[#0072CE] hover:text-white'
                }`}
                title="Edit this YoY Synopsis and save to Dataverse"
              >
                <EditIcon className="w-2.5 h-2.5" /> Edit Synopsis
              </button>
              {synObj.isCustomSaved && (
                <button
                  type="button"
                  disabled={isBusy}
                  onClick={() => handleReEvaluateSynopsis(synObj.fullKey, liveAutoText)}
                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold border ${
                    darkMode ? 'bg-amber-950/60 text-amber-300 border-amber-800' : 'bg-amber-50 text-amber-900 border-amber-300'
                  }`}
                  title="Re-evaluate synopsis automatically from live BOLO data"
                >
                  Re-Evaluate
                </button>
              )}
            </div>
          )}
        </div>

        {isEditing ? (
          <div className="space-y-1.5 pt-1">
            <textarea
              rows={3}
              value={draftText}
              onChange={e => setDraftText(e.target.value)}
              className={`w-full rounded-lg border p-2 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-[#0072CE] ${theme.bgInput}`}
              placeholder="Enter executive YoY synopsis to save in Dataverse..."
            />
            <div className="flex flex-wrap items-center justify-between gap-1.5">
              <button
                type="button"
                onClick={() => setDraftText(liveAutoText || '')}
                className={`px-2 py-1 rounded text-[10px] font-bold border ${theme.bgSubtle}`}
                title="Load live auto-evaluated synopsis into editor"
              >
                Load Auto-Evaluated Text
              </button>
              <div className="flex items-center gap-1.5">
                <button
                  type="button"
                  onClick={() => setEditingKey(null)}
                  className={`px-2.5 py-1 rounded text-[10px] font-bold border ${theme.bgSubtle}`}
                >
                  Cancel
                </button>
                <button
                  type="button"
                  disabled={isBusy}
                  onClick={() => handleSaveSynopsis(synObj.fullKey)}
                  className="inline-flex items-center gap-1 px-3 py-1 rounded text-[10px] font-black bg-emerald-600 text-white hover:bg-emerald-700"
                >
                  <SaveIcon className="w-3 h-3" />
                  <span>{isBusy ? 'Saving...' : 'Save to Dataverse'}</span>
                </button>
              </div>
            </div>
          </div>
        ) : (
          <div>{synObj.text}</div>
        )}
      </div>
    );
  };

  return localizeReactTree((
    <div className="space-y-2.5">
      {/* TOP FILTER & SEPARATION CONTROL BAR: MAIN % DROPDOWN (DEFAULT: PATHOGEN ONLY) + PATHOGEN VS APC VS ATP SEPARATION PILLS */}
      <div className={`rounded-xl border px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2.5 shadow-2xs ${theme.bgCard}`}>
        <div className="flex flex-wrap items-center gap-2">
          <span className="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-[#E4002B] text-white">
            Core % Metrics
          </span>
          <label className="text-xs font-black flex items-center gap-1.5">
            <span>Main % View:</span>
            <select
              value={activeMode}
              onChange={e => setResultCategoryMode(e.target.value)}
              aria-label="Select Main Percentage Result Category"
              className={`text-xs font-black rounded-lg px-2.5 py-1 border focus:outline-none focus:ring-2 focus:ring-[#0072CE] ${
                activeMode === 'pathogen'
                  ? (darkMode ? 'bg-red-950/70 text-rose-200 border-red-700' : 'bg-[#FDE8EC] text-[#E4002B] border-red-300')
                  : theme.bgInput
              }`}
            >
              <option value="pathogen">Default: Pathogen Only (LIS / Retest / SAL)</option>
              <option value="all">All Results (Pathogen + APC + ATP)</option>
              <option value="apc">APC Results Only (Aerobic Plate Count)</option>
              <option value="atp">Other Indicators (ATP Rapid Swabs)</option>
            </select>
          </label>
        </div>

        {/* Separated Pathogen vs. APC vs. Other Indicators Quick-Filter Pills */}
        <div className="flex flex-wrap items-center gap-1.5 text-[11px]">
          <span className={`text-[10px] font-black uppercase ${theme.textMuted}`}>
            Separated Indicators:
          </span>
          {[
            { id: 'pathogen', label: 'Pathogen Only', rate: sep.pathogen.rate, hits: sep.pathogen.positives, swabs: sep.pathogen.swabs, activeCls: 'bg-[#E4002B] text-white border-[#E4002B]' },
            { id: 'apc', label: 'APC Only', rate: sep.apc.rate, hits: sep.apc.positives, swabs: sep.apc.swabs, activeCls: 'bg-orange-600 text-white border-orange-600' },
            { id: 'atp', label: 'ATP / Other', rate: sep.atp.rate, hits: sep.atp.positives, swabs: sep.atp.swabs, activeCls: 'bg-amber-500 text-slate-950 border-amber-500' },
            { id: 'all', label: 'All Results', rate: sep.all.rate, hits: sep.all.positives, swabs: sep.all.swabs, activeCls: 'bg-[#00468B] text-white border-[#00468B]' }
          ].map(pill => {
            const isSel = activeMode === pill.id;
            return (
              <button
                key={pill.id}
                type="button"
                onClick={() => setResultCategoryMode(pill.id)}
                className={`px-2.5 py-1 rounded-lg font-bold border transition-all flex items-center gap-1.5 ${
                  isSel ? pill.activeCls : `${theme.bgSubtle} hover:border-[#0072CE]`
                }`}
                title={`Switch Main % cards to ${pill.label} (${pill.hits}/${pill.swabs})`}
              >
                <span>{pill.label}:</span>
                <span className="font-mono font-black">{pill.rate === null || pill.rate === undefined ? '--' : `${pill.rate}%`}</span>
                <span className="text-[10px] font-mono opacity-85">({pill.hits}/{pill.swabs})</span>
              </button>
            );
          })}

          {onOpenGraphs && (
            <button
              type="button"
              onClick={onOpenGraphs}
              className="px-2.5 py-1 rounded-lg text-[11px] font-black bg-[#0072CE] text-white hover:bg-[#00468B]"
            >
              YoY & YTD Graphs
            </button>
          )}
        </div>
      </div>

      {statusToast && (
        <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 px-3.5 py-2 flex items-center justify-between text-xs font-bold text-emerald-700 dark:text-emerald-300">
          <div className="flex items-center gap-2">
            <CheckCircleIcon className="w-4 h-4 text-emerald-500 shrink-0" />
            <span>{statusToast}</span>
          </div>
          <button type="button" onClick={() => setStatusToast('')} className="underline text-[11px]">Dismiss</button>
        </div>
      )}

      {/* 3 CORE EXECUTIVE PERCENTAGE CARDS WITH UNIFORM METRIC FORMAT (% POS THIS YEAR, START-UP/IN-PROCESS, AND SMALLER GREEN LAST YEAR + YOY CHANGE UNDERNEATH) */}
      <div className="grid grid-cols-1 xl:grid-cols-3 gap-2.5">
        {/* METRIC CARD 1: % OVERALL (PLANT-WIDE POSITIVITY & YOY SYNOPSIS) */}
        <div className={`min-w-0 overflow-hidden rounded-xl border p-3.5 border-l-4 border-l-[#E4002B] flex flex-col justify-between gap-2 ${theme.bgCard}`}>
          <div className="min-w-0">
            <div className="flex flex-wrap items-center justify-between gap-1.5 mb-1.5">
              <span className={`text-[11px] font-black uppercase tracking-wider ${theme.textMuted}`}>
                1. % Overall ({catData.shortLabel || 'Pathogen Only'})
              </span>
              {catData.overall.yoyDeltaPct === null || catData.overall.yoyDeltaPct === undefined ? (
                <span className={`px-2 py-0.5 rounded text-[10px] font-black whitespace-nowrap border ${theme.border} ${theme.textMuted}`}>
                  {tr('No last-year swabs loaded', 'Sin hisopos del ano pasado')}
                </span>
              ) : (
                <span className={`px-2 py-0.5 rounded text-[10px] font-black whitespace-nowrap ${
                  Number(catData.overall.yoyDeltaPct) <= 0 ? 'bg-emerald-600 text-white' : 'bg-amber-500 text-slate-900'
                }`}>
                  {Number(catData.overall.yoyDeltaPct) > 0 ? `+${catData.overall.yoyDeltaPct}` : catData.overall.yoyDeltaPct}% YoY ({em.thisYearLabel || String(LIVE_CURRENT_YEAR)} vs {em.lastYearLabel || String(LIVE_CURRENT_YEAR - 1)})
                </span>
              )}
            </div>

            <div className="my-1.5">
              <UniformKeyMetricBox
                title={`Plant-Wide % Pos This Year (${catData.shortLabel || 'Pathogen Only'})`}
                tyPosRate={catData.overall.thisYearRate}
                tyHits={catData.overall.positives}
                tySwabs={catData.overall.totalSwabs}
                tyStRate={catData.overall.stRateTY ?? catData.inProcessAndStartup.startup.thisYearRate}
                tyInpRate={catData.overall.inpRateTY ?? catData.inProcessAndStartup.inp.thisYearRate}
                lyPosRate={catData.overall.lastYearRate}
                lyStRate={catData.overall.stRateLY ?? catData.inProcessAndStartup.startup.lastYearRate}
                lyInpRate={catData.overall.inpRateLY ?? catData.inProcessAndStartup.inp.lastYearRate}
                yoyDeltaPct={catData.overall.yoyDeltaPct}
                accentClass="text-[#E4002B] dark:text-rose-400"
                theme={theme}
                extraLine={`Separated Rates - Pathogen: ${fmtPct(sep.pathogen.rate)} - APC: ${fmtPct(sep.apc.rate)} - ATP: ${fmtPct(sep.atp.rate)}`}
              />
            </div>
          </div>

          {renderSynopsisEditorBlock(synOverall, catData.overall.synopsis, 'text-[#E4002B] dark:text-rose-400')}
        </div>

        {/* METRIC CARD 2: % OVERALL FOR % START-UP & % IN-PROCESS + YOY SYNOPSIS */}
        <div className={`min-w-0 overflow-hidden rounded-xl border p-3.5 border-l-4 border-l-[#FF9E1B] flex flex-col justify-between gap-2 ${theme.bgCard}`}>
          <div className="min-w-0">
            <div className="flex flex-wrap items-center justify-between gap-1.5 mb-1.5">
              <span className={`text-[11px] font-black uppercase tracking-wider ${theme.textMuted}`}>
                2. % Overall: Start-Up / In-Process
              </span>
              <span className={`px-2 py-0.5 rounded text-[10px] font-black whitespace-nowrap ${
                darkMode ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-amber-100 text-amber-900'
              }`}>
                {fmtPct(catData.inProcessAndStartup.startup.sharePct)} ST / {fmtPct(catData.inProcessAndStartup.inp.sharePct)} INP Share
              </span>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2 gap-2 my-1.5">
              {/* % Start-Up Box (Uniform Format) */}
              <UniformKeyMetricBox
                title="% Start-Up (ST) This Year"
                tyPosRate={catData.inProcessAndStartup.startup.thisYearRate}
                tyHits={catData.inProcessAndStartup.startup.positives}
                tySwabs={catData.inProcessAndStartup.startup.totalSwabs}
                tyStRate={catData.inProcessAndStartup.startup.thisYearRate}
                tyInpRate={catData.inProcessAndStartup.inp.thisYearRate}
                lyPosRate={catData.inProcessAndStartup.startup.lastYearRate}
                lyStRate={catData.inProcessAndStartup.startup.lastYearRate}
                lyInpRate={catData.inProcessAndStartup.inp.lastYearRate}
                yoyDeltaPct={catData.inProcessAndStartup.startup.yoyDeltaPct}
                accentClass="text-[#0072CE] dark:text-sky-400"
                theme={theme}
              />

              {/* % In-Process Box (Uniform Format) */}
              <UniformKeyMetricBox
                title="% In-Process (INP) This Year"
                tyPosRate={catData.inProcessAndStartup.inp.thisYearRate}
                tyHits={catData.inProcessAndStartup.inp.positives}
                tySwabs={catData.inProcessAndStartup.inp.totalSwabs}
                tyStRate={catData.inProcessAndStartup.startup.thisYearRate}
                tyInpRate={catData.inProcessAndStartup.inp.thisYearRate}
                lyPosRate={catData.inProcessAndStartup.inp.lastYearRate}
                lyStRate={catData.inProcessAndStartup.startup.lastYearRate}
                lyInpRate={catData.inProcessAndStartup.inp.lastYearRate}
                yoyDeltaPct={catData.inProcessAndStartup.inp.yoyDeltaPct}
                accentClass="text-[#D97706] dark:text-amber-400"
                theme={theme}
              />
            </div>
          </div>

          {renderSynopsisEditorBlock(synInpSt, catData.inProcessAndStartup.synopsis, 'text-[#D97706] dark:text-amber-400')}
        </div>

        {/* METRIC CARD 3: % OVERALL FOR % CREME SIDE & % BAKERY + YOY SYNOPSIS */}
        <div className={`min-w-0 overflow-hidden rounded-xl border p-3.5 border-l-4 border-l-[#0072CE] flex flex-col justify-between gap-2 ${theme.bgCard}`}>
          <div className="min-w-0">
            <div className="flex flex-wrap items-center justify-between gap-1.5 mb-1.5">
              <span className={`text-[11px] font-black uppercase tracking-wider ${theme.textMuted}`}>
                3. % Overall: % Creme Side & % Bakery
              </span>
              <span className={`px-2 py-0.5 rounded text-[10px] font-black whitespace-nowrap ${
                darkMode ? 'bg-sky-950 text-sky-300 border border-sky-800' : 'bg-[#E6F1FB] text-[#00468B]'
              }`}>
                {catData.shortLabel || 'Pathogen'} By Facility Side
              </span>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2 gap-2 my-1.5">
              {/* % Creme Side Box (Uniform Format) */}
              <UniformKeyMetricBox
                title="% Creme Side This Year"
                tyPosRate={catData.cremeAndBakery.creme.thisYearRate}
                tyHits={catData.cremeAndBakery.creme.positives}
                tySwabs={catData.cremeAndBakery.creme.totalSwabs}
                tyStRate={catData.cremeAndBakery.creme.stRateTY}
                tyInpRate={catData.cremeAndBakery.creme.inpRateTY}
                lyPosRate={catData.cremeAndBakery.creme.lastYearRate}
                lyStRate={catData.cremeAndBakery.creme.stRateLY}
                lyInpRate={catData.cremeAndBakery.creme.inpRateLY}
                yoyDeltaPct={catData.cremeAndBakery.creme.yoyDeltaPct}
                accentClass="text-[#E4002B] dark:text-rose-400"
                theme={theme}
              />

              {/* % Bakery Box (Uniform Format) */}
              <UniformKeyMetricBox
                title="% Bakery Side This Year"
                tyPosRate={catData.cremeAndBakery.bakery.thisYearRate}
                tyHits={catData.cremeAndBakery.bakery.positives}
                tySwabs={catData.cremeAndBakery.bakery.totalSwabs}
                tyStRate={catData.cremeAndBakery.bakery.stRateTY}
                tyInpRate={catData.cremeAndBakery.bakery.inpRateTY}
                lyPosRate={catData.cremeAndBakery.bakery.lastYearRate}
                lyStRate={catData.cremeAndBakery.bakery.stRateLY}
                lyInpRate={catData.cremeAndBakery.bakery.inpRateLY}
                yoyDeltaPct={catData.cremeAndBakery.bakery.yoyDeltaPct}
                accentClass="text-[#0072CE] dark:text-sky-400"
                theme={theme}
              />
            </div>
          </div>

          {renderSynopsisEditorBlock(synCremeBakery, catData.cremeAndBakery.synopsis, 'text-[#0072CE] dark:text-sky-400')}
        </div>
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

// =======================================================================
// TAB 1: BOLO CALENDAR VIEW (LAST WEEK + CURRENT WEEK + MULTI-TIMEFRAME CALENDAR)
// =======================================================================
// Saved "Default calendar timeframe" -> calendar view. '1w' and '2w' were saved by v2.0-v2.2 (previous week / two
// weeks) and now open last week + this week; 'one_week' is a single week.
const CALENDAR_VIEW_FROM_PREF = { exec_overview: 'exec_overview', '1w': 'exec_overview', '2w': 'exec_overview', one_week: '1w', month: 'month', '8w': '8w', archive: 'archive' };
function MssBoloCalendarView({
  darkMode,
  theme,
  logoUnlocked,
  isAdminVerified,
  allHits,
  rawAllHits,
  parsedCsv,
  parsedPrompt,
  importCheck,
  repeatStreaks,
  pressureAnalysis,
  resultCategoryMode,
  setResultCategoryMode,
  executiveSynopses,
  onSaveExecutiveSynopsis,
  dateOverrides,
  setDateOverrides,
  selectedRoomFilter,
  setSelectedRoomFilter,
  selectedTestFilter,
  setSelectedTestFilter,
  calendarJumpDate,
  activeUserProfile,
  userPrefRooms,
  onLocateOnMap,
  onOpenDashboard,
  onOpenGraphs,
  onOpenQuickEmail,
  onOpenDedupChecker,
  onOpenSelectFeatures,
  onOpenImportCheck
}) {
  const prefCellMode = (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode) || 'hits_pending';
  const prefTimeframe = (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCalendarTimeframe) || '';

  // Views: 'exec_overview' = last week, then this week (default; weeks run Monday to Sunday), '1w' one week,
  // 'month' month grid, '8w' eight weeks, 'archive' every month in the ledger
  const [timeframeMode, setTimeframeMode] = useState(() => CALENDAR_VIEW_FROM_PREF[prefTimeframe] || 'exec_overview');
  const [anchorWeek, setAnchorWeek] = useState(() => getWeekStart(getTodayDateKey()));
  const [monthCursor, setMonthCursor] = useState(() => getTodayDateKey().slice(0, 7));
  const [cellDisplayMode, setCellDisplayMode] = useState(prefCellMode);
  const [expandedCells, setExpandedCells] = useState({});
  const [selectedDayModal, setSelectedDayModal] = useState(null);
  const [showUndatedBar, setShowUndatedBar] = useState(false);

  const lastWeekStart = useMemo(() => addDays(anchorWeek, -7), [anchorWeek]);
  const isViewingLiveCurrentWeek = anchorWeek === LIVE_CURRENT_WEEK_START;
  const catMode = resultCategoryMode || 'pathogen';
  const isPathogenType = (t) => t === 'LIS' || t === 'RETEST-LIS' || t === 'SAL';

  // Hits shown for the chosen results view ('pathogen' default | 'all' | 'apc' | 'atp')
  const categoryFilteredHits = useMemo(() => {
    if (catMode === 'all') return allHits;
    if (catMode === 'apc') return allHits.filter(h => h.testType === 'APC');
    if (catMode === 'atp') return allHits.filter(h => h.testType === 'ATP');
    return allHits.filter(h => isPathogenType(h.testType));
  }, [allHits, catMode]);

  useEffect(() => {
    if (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode) {
      setCellDisplayMode(activeUserProfile.viewPreferences.defaultCellDisplayMode);
    }
  }, [activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode]);

  // Jumps from the dashboard or the archive
  useEffect(() => {
    if (calendarJumpDate && calendarJumpDate.date) {
      setAnchorWeek(getWeekStart(calendarJumpDate.date));
      setMonthCursor(calendarJumpDate.date.slice(0, 7));
      if (calendarJumpDate.mode) setTimeframeMode(calendarJumpDate.mode);
    }
  }, [calendarJumpDate]);

  const dowNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const catWord = catMode === 'apc' ? 'APC' : (catMode === 'atp' ? 'ATP' : (catMode === 'all' ? tr('All tests', 'Todas las pruebas') : tr('Listeria + Salmonella', 'Listeria + Salmonella')));

  // Finished swabs (with a pass/fail call), positives and pending of one day or week for the chosen view.
  // pathogen = routine environmental Listeria + Salmonella (no retests, vectors or product).
  const tallyFor = (b) => {
    if (!b) return newTally();
    if (catMode === 'apc') return b.apc || newTally();
    if (catMode === 'atp') return b.atp || newTally();
    if (catMode === 'all') {
      const r = b.routine || newTally();
      const a = b.apc || newTally();
      const t = b.atp || newTally();
      return { swabs: r.swabs + a.swabs + t.swabs, positives: r.positives + a.positives + t.positives, pending: r.pending + a.pending + t.pending };
    }
    return b.routine || newTally();
  };
  const roomTallyFor = (b, rk) => ((catMode === 'pathogen' || catMode === 'all') && b && b.routineByRoom ? (b.routineByRoom[rk] || null) : null);
  const scopedTally = (b) => (selectedRoomFilter !== 'ALL' ? (roomTallyFor(b, selectedRoomFilter) || newTally()) : tallyFor(b));
  const roomShort = (rk) => (ROOM_META[rk] && ROOM_META[rk].short) || rk;

  // One day: its hits by room, its swab counts, and a status: future / hits / clean (finished swabs, none positive) /
  // pending (swabs waiting on the lab) / none (no swabs loaded)
  const buildDayCellObj = useCallback((dateKey, weekIndex = 1) => {
    const parts = dateKey.split('-').map(Number);
    const d = new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0);
    const isFuture = dateKey > LIVE_TODAY_DATE_KEY;
    const dayHits = isFuture ? [] : categoryFilteredHits.filter(h => h.date === dateKey);
    const byRoomHits = {};
    dayHits.forEach(h => {
      if (!byRoomHits[h.room]) byRoomHits[h.room] = [];
      byRoomHits[h.room].push(h);
    });
    const csvStat = isFuture ? null : (parsedCsv.dailyStats[dateKey] || null);
    const tally = scopedTally(csvStat);

    const roomBlocks = [];
    if (!isFuture) {
      const roomKeys = Object.keys(ROOM_META);
      Object.keys(byRoomHits).forEach(rk => { if (roomKeys.indexOf(rk) === -1) roomKeys.push(rk); });
      roomKeys.forEach(rk => {
        if (selectedRoomFilter !== 'ALL' && rk !== selectedRoomFilter) return;
        if (userPrefRooms && userPrefRooms.length > 0 && userPrefRooms.indexOf(rk) === -1) return;
        const hitsInR = byRoomHits[rk] || [];
        const rt = roomTallyFor(csvStat, rk);
        const swabsInR = rt ? rt.swabs : 0;
        const pendingInR = rt ? rt.pending : 0;
        const rowsInR = (csvStat && csvStat.rowsByRoom && csvStat.rowsByRoom[rk]) || [];
        if (hitsInR.length > 0 || swabsInR > 0 || pendingInR > 0 || (cellDisplayMode === 'all_mss' && rowsInR.length > 0)) {
          roomBlocks.push({ room: rk, hits: hitsInR, swabs: swabsInR, pending: pendingInR, rows: rowsInR });
        }
      });
    }
    roomBlocks.sort((a, b) => (b.hits.length - a.hits.length) || (b.pending - a.pending) || (b.swabs - a.swabs));

    let status = 'none';
    if (isFuture) status = 'future';
    else if (dayHits.length > 0) status = 'hits';
    else if (tally.swabs > 0) status = 'clean';
    else if (tally.pending > 0) status = 'pending';

    return {
      isPadding: false,
      dateKey,
      isToday: dateKey === LIVE_TODAY_DATE_KEY,
      isFuture,
      status,
      tally,
      isCleanDay: status === 'clean',
      dow: dowNames[(d.getDay() + 6) % 7],
      dayNum: d.getDate(),
      monthShort: d.toLocaleDateString('en-US', { month: 'short' }),
      yearNum: parts[0],
      weekIndex,
      hits: dayHits,
      byRoom: byRoomHits,
      roomBlocks,
      csvStat
    };
  }, [categoryFilteredHits, parsedCsv.dailyStats, selectedRoomFilter, userPrefRooms, cellDisplayMode, catMode]);

  const weekDays = useCallback((start) => {
    const out = [];
    for (let i = 0; i < 7; i += 1) out.push(buildDayCellObj(addDays(start, i), 1));
    return out;
  }, [buildDayCellObj]);
  const currentWeekDays = useMemo(() => weekDays(anchorWeek), [weekDays, anchorWeek]);
  const lastWeekDays = useMemo(() => weekDays(lastWeekStart), [weekDays, lastWeekStart]);

  // One week: lab rows (byWeek), the hits shown, and the QA email that reports on that week (if pasted)
  const summarizeWeek = useCallback((weekKey, daysArr) => {
    const b = (parsedCsv.byWeek && parsedCsv.byWeek[weekKey]) || null;
    const tally = scopedTally(b);
    let totalHits = 0;
    let lisHits = 0;
    let salHits = 0;
    let retestHits = 0;
    let indicatorHits = 0;
    let emailOnlyHits = 0;
    let otherKindHits = 0;
    let cleanDays = 0;
    let futureDays = 0;
    const hitsByRoomMap = {};
    daysArr.forEach(d => {
      if (d.isFuture) { futureDays += 1; return; }
      if (d.status === 'clean') cleanDays += 1;
      d.hits.forEach(h => {
        totalHits += 1;
        hitsByRoomMap[h.room] = (hitsByRoomMap[h.room] || 0) + 1;
        if (h.emailOnly) emailOnlyHits += 1;
        if (h.kind === 'vector' || h.kind === 'product' || h.kind === 'other') otherKindHits += 1;
        if (h.testType === 'LIS') lisHits += 1;
        else if (h.testType === 'SAL') salHits += 1;
        else if (h.testType === 'RETEST-LIS') retestHits += 1;
        else indicatorHits += 1;
      });
    });
    const roomKeys = Object.keys(ROOM_META);
    Object.keys(hitsByRoomMap).forEach(rk => { if (roomKeys.indexOf(rk) === -1) roomKeys.push(rk); });
    const roomStats = roomKeys.map(rk => {
      const rt = roomTallyFor(b, rk);
      return { room: rk, swabs: rt ? rt.swabs : 0, positives: rt ? rt.positives : 0, pending: rt ? rt.pending : 0, hits: hitsByRoomMap[rk] || 0 };
    }).filter(x => x.swabs > 0 || x.pending > 0 || x.hits > 0);
    const email = (parsedPrompt && parsedPrompt.byWeek && parsedPrompt.byWeek[weekKey]) || null;
    return { weekKey, b, tally, rate: tallyRate(tally), totalHits, lisHits, salHits, retestHits, indicatorHits, emailOnlyHits, otherKindHits, cleanDays, futureDays, hitsByRoomMap, roomStats, email };
  }, [parsedCsv.byWeek, parsedPrompt, selectedRoomFilter, catMode]);

  const execWeekStats = useMemo(() => ({
    currentWeek: summarizeWeek(anchorWeek, currentWeekDays),
    lastWeek: summarizeWeek(lastWeekStart, lastWeekDays)
  }), [summarizeWeek, anchorWeek, lastWeekStart, currentWeekDays, lastWeekDays]);

  // Day cells for one week, a Monday-first month grid, or eight weeks
  const calendarCells = useMemo(() => {
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      const y = parseInt(yStr, 10) || LIVE_CURRENT_YEAR;
      const m = (parseInt(mStr, 10) || 10) - 1;
      const firstDow = (new Date(y, m, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(y, m + 1, 0).getDate();
      const cells = [];
      for (let p = 0; p < firstDow; p += 1) cells.push({ isPadding: true, key: `pad-start-${p}` });
      for (let day = 1; day <= daysInMonth; day += 1) {
        cells.push(buildDayCellObj(`${y}-${pad2(m + 1)}-${pad2(day)}`, Math.floor((firstDow + day - 1) / 7) + 1));
      }
      return cells;
    }
    const totalDays = timeframeMode === '1w' ? 7 : 56;
    const startKey = timeframeMode === '8w' ? addDays(anchorWeek, -49) : anchorWeek;
    const out = [];
    for (let i = 0; i < totalDays; i += 1) out.push(buildDayCellObj(addDays(startKey, i), Math.floor(i / 7) + 1));
    return out;
  }, [timeframeMode, anchorWeek, monthCursor, buildDayCellObj]);

  // Email lines that carry no date (retest, APC, ATP): they sit on the Friday of the email's week until moved
  const undatedSummaryHits = useMemo(() => rawAllHits.filter(h => !h.dateExplicit && h.emailOnly), [rawAllHits]);

  const stepTimeframe = (dir) => {
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      const d = new Date(parseInt(yStr, 10), parseInt(mStr, 10) - 1 + dir, 1);
      setMonthCursor(`${d.getFullYear()}-${pad2(d.getMonth() + 1)}`);
    } else {
      setAnchorWeek(addDays(anchorWeek, dir * (timeframeMode === '8w' ? 28 : 7)));
    }
  };

  const activeRangeLabel = useMemo(() => {
    if (timeframeMode === 'exec_overview') return `${formatWeekRangeLabel(lastWeekStart)} | ${formatWeekRangeLabel(anchorWeek, true)}`;
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      return new Date(parseInt(yStr, 10), parseInt(mStr, 10) - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }
    if (timeframeMode === 'archive') return tr('Every month in the ledger', 'Cada mes cargado');
    const validDays = calendarCells.filter(c => !c.isPadding);
    if (validDays.length === 0) return '';
    const first = validDays[0].dateKey;
    const last = validDays[validDays.length - 1].dateKey;
    return `${formatShortDate(first)} - ${formatShortDate(last)}, ${last.slice(0, 4)}`;
  }, [timeframeMode, monthCursor, calendarCells, lastWeekStart, anchorWeek]);

  // Archive: every month in the ledger, newest first (lab rows only; a positive is counted once)
  const archiveMonths = useMemo(() => Object.keys(parsedCsv.byMonth || {})
    .sort((a, b) => b.localeCompare(a))
    .map(k => parsedCsv.byMonth[k]), [parsedCsv.byMonth]);

  const statusChip = (day, compact) => {
    const base = 'px-1.5 py-0.2 rounded text-[10px] font-black whitespace-nowrap';
    if (day.status === 'future') return null;
    if (day.status === 'hits') {
      const red = day.hits.some(h => isPathogenType(h.testType));
      return (
        <button type="button" onClick={() => setSelectedDayModal(day)} className={`${base} ${red ? 'bg-[#E4002B] text-white' : 'bg-[#FFB81C] text-slate-950'}`}>
          {day.hits.length} {tr(day.hits.length === 1 ? 'positive' : 'positives', day.hits.length === 1 ? 'positivo' : 'positivos')}
        </button>
      );
    }
    if (day.status === 'clean') {
      return (
        <span className={`${base} ${darkMode ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-emerald-100 text-emerald-800'}`}>
          {compact ? `0/${day.tally.swabs}` : tr(`0 of ${day.tally.swabs}`, `0 de ${day.tally.swabs}`)}
        </span>
      );
    }
    if (day.status === 'pending') {
      return (
        <span className={`${base} ${darkMode ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-amber-100 text-amber-900'}`}>
          {tr(`${day.tally.pending} pending`, `${day.tally.pending} pendientes`)}
        </span>
      );
    }
    return <span className={`${base} font-bold ${theme.textMuted}`}>{tr('no swabs', 'sin hisopos')}</span>;
  };

  // One room with hits (or, in "full list" view, any room with rows) inside a day
  const renderCalendarRoomCard = (rb, isCellExpanded, showMssRows) => {
    const rKey = rb.room;
    const rMeta = ROOM_META[rKey] || ROOM_META['Zone 4 / Mobile'];
    const rHits = rb.hits || [];
    return (
      <div
        key={rKey}
        className="rounded-lg border overflow-hidden"
        style={{ borderColor: darkMode ? (rMeta.borderDark || '#334155') : rMeta.border, backgroundColor: darkMode ? '#0B1120' : '#FFFFFF' }}
      >
        <div
          className="px-2 py-1 flex flex-wrap items-center justify-between gap-x-1.5 gap-y-0.5 text-[10px] font-black uppercase tracking-wider"
          style={{ backgroundColor: darkMode ? rMeta.bgDark : rMeta.bgLight, color: darkMode ? (rMeta.textDark || '#F8FAFC') : rMeta.color }}
        >
          <span className="flex items-center gap-1 shrink-0">
            <span className="w-2 h-2 rounded-full shrink-0" style={{ backgroundColor: rMeta.color }} />
            <span className="whitespace-nowrap">{roomShort(rKey)}</span>
          </span>
          <div className="flex flex-wrap items-center justify-end gap-1 font-mono">
            {rb.swabs > 0 && <span className="text-[9px] opacity-90">{rb.swabs} {tr('swabs', 'hisopos')}</span>}
            {rb.pending > 0 && (
              <span className={`px-1 rounded text-[9px] ${darkMode ? 'bg-amber-950/80 text-amber-300' : 'bg-amber-100 text-amber-900'}`}>
                {rb.pending} {tr('pend', 'pend')}
              </span>
            )}
            {rHits.length > 0 ? (
              <span className="px-1 rounded bg-[#E4002B] text-white text-[9px]">{rHits.length} {tr('pos', 'pos')}</span>
            ) : (
              <span className={`px-1 rounded text-[9px] ${darkMode ? 'bg-emerald-950 text-emerald-300' : 'bg-emerald-100 text-emerald-800'}`}>0 {tr('pos', 'pos')}</span>
            )}
          </div>
        </div>

        {rHits.length > 0 && (
          <div className={`divide-y p-1.5 space-y-1.5 ${darkMode ? 'divide-slate-800/90' : 'divide-slate-100'}`}>
            {rHits.map(hit => {
              const tBadge = TEST_BADGE[hit.testType] || TEST_BADGE.LIS;
              const isRepeat = repeatStreaks.some(s => s.siteCode && s.siteCode === hit.siteCode && s.count >= 3);
              const badgeText = hit.testType === 'LIS' ? (hit.timingStage ? `LIS ${hit.timingStage}` : 'LIS') : tBadge.short;
              return (
                <div key={hit.id} className="pt-1 first:pt-0 text-[11px] leading-snug">
                  <div className="flex items-center justify-between gap-1 mb-0.5">
                    <div className="flex items-center gap-1 flex-wrap">
                      <span
                        className="px-1.5 py-0.2 rounded text-[9px] font-black uppercase border"
                        style={{
                          backgroundColor: darkMode ? tBadge.bgDark : tBadge.bg,
                          color: darkMode ? tBadge.colorDark : tBadge.color,
                          borderColor: darkMode ? tBadge.borderDark : tBadge.border
                        }}
                      >
                        {badgeText}
                      </span>
                      {(hit.kind === 'product' || hit.kind === 'vector') && (
                        <span className={`px-1 py-0.2 rounded text-[8px] font-black uppercase ${theme.bgSubtle}`}>
                          {hit.kind === 'product' ? tr('product', 'producto') : tr('vector', 'vector')}
                        </span>
                      )}
                      {hit.emailOnly && (
                        <span className={`px-1 py-0.2 rounded text-[8px] font-black uppercase ${darkMode ? 'bg-sky-950 text-sky-300' : 'bg-sky-100 text-sky-900'}`} title={tr('Listed in the QA email; no matching lab row is loaded', 'En el correo de QA; no hay fila de laboratorio que coincida')}>
                          {tr('email', 'correo')}
                        </span>
                      )}
                      {isRepeat && (
                        <span className="px-1 py-0.2 rounded text-[8px] font-black uppercase bg-[#E4002B] text-white">{tr('repeat', 'repetido')}</span>
                      )}
                    </div>
                    <button
                      type="button"
                      onClick={() => onLocateOnMap({ siteCode: hit.siteCode, room: hit.room, hitId: hit.id, description: hit.description })}
                      title={tr('Show this site on the facility map', 'Ver este sitio en el mapa')}
                      className={`inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded text-[9px] font-bold ${
                        darkMode ? 'bg-sky-950 text-sky-300 border border-sky-800 hover:bg-sky-900' : 'bg-[#E6F1FB] text-[#00468B] hover:bg-[#0072CE] hover:text-white'
                      }`}
                    >
                      <MapPinIcon className="w-2.5 h-2.5" /> {tr('Map', 'Mapa')}
                    </button>
                  </div>
                  <div className="font-bold break-words">
                    {hit.surface}: <span className={`font-normal ${darkMode ? 'text-slate-300' : 'text-slate-700'}`}>{hit.description}</span>
                  </div>
                  {hit.siteCode && (
                    <div className={`text-[9px] font-mono mt-0.5 ${theme.textMuted}`}>
                      {hit.siteCode}{hit.assetTag ? ` - ${hit.assetTag}` : ''}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        {showMssRows && rb.rows && rb.rows.length > 0 && (
          <div className={`border-t px-1.5 py-1 space-y-1 ${darkMode ? 'border-slate-800 bg-slate-900/50' : 'border-slate-200/60 bg-slate-50/50'}`}>
            {rb.rows.slice(0, isCellExpanded ? 25 : 3).map(sr => (
              <div key={sr.id} className="text-[10px] flex items-center justify-between gap-1 truncate">
                <span className="truncate" title={`${sr.siteCode} ${sr.surface}-${sr.description}`}>
                  <b className="font-mono">{sr.siteCode || sr.scheduleId || sr.sampleId}:</b> {sr.surface} - {sr.description}
                </span>
                <span className={`shrink-0 px-1 rounded text-[9px] font-bold ${
                  sr.result === 'Positive'
                    ? (darkMode ? 'bg-red-950 text-red-300' : 'bg-red-100 text-red-800')
                    : (sr.result === 'Pending'
                        ? (darkMode ? 'bg-amber-950 text-amber-300' : 'bg-amber-100 text-amber-900')
                        : (darkMode ? 'bg-emerald-950 text-emerald-300' : 'bg-emerald-100 text-emerald-800'))
                }`}>
                  {sr.result === 'Pending' ? tr('Pend', 'Pend') : (sr.result === 'Count' ? (sr.rawResult || 'n') : sr.result.slice(0, 3))}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  };

  // The body of one day: rooms with positives as cards; rooms with no positive and rooms waiting on the lab as one line each
  const renderDayBody = (day, maxRoomsShown) => {
    if (day.isFuture) return null;
    const isCellExpanded = !!expandedCells[day.dateKey];
    const fullList = cellDisplayMode === 'all_mss';
    const hitBlocks = day.roomBlocks.filter(rb => rb.hits.length > 0);
    const cardBlocks = fullList ? day.roomBlocks : hitBlocks;
    const visible = cardBlocks.slice(0, isCellExpanded ? 99 : maxRoomsShown);
    const hidden = Math.max(0, cardBlocks.length - visible.length);
    const cleanRooms = fullList ? [] : day.roomBlocks.filter(rb => rb.hits.length === 0 && rb.swabs > 0);
    const pendRooms = day.roomBlocks.filter(rb => rb.pending > 0);
    return (
      <>
        {visible.length > 0 && <div className="space-y-1.5">{visible.map(rb => renderCalendarRoomCard(rb, isCellExpanded, fullList))}</div>}
        {cellDisplayMode !== 'hits' && cleanRooms.length > 0 && (
          <div className={`text-[10px] leading-snug ${darkMode ? 'text-emerald-300' : 'text-emerald-800'}`}>
            <b>{tr('No positives:', 'Sin positivos:')}</b> {cleanRooms.map(rb => `${roomShort(rb.room)} ${rb.swabs}`).join(' | ')}
          </div>
        )}
        {cellDisplayMode !== 'hits' && pendRooms.length > 0 && (
          <div className={`text-[10px] leading-snug ${darkMode ? 'text-amber-300' : 'text-amber-800'}`}>
            <b>{tr('Waiting on lab:', 'Esperando laboratorio:')}</b> {pendRooms.map(rb => `${roomShort(rb.room)} ${rb.pending}`).join(' | ')}
          </div>
        )}
        {(hidden > 0 || isCellExpanded) && (
          <button
            type="button"
            onClick={() => setExpandedCells(prev => ({ ...prev, [day.dateKey]: !isCellExpanded }))}
            className={`w-full text-left text-[10px] font-bold hover:underline pt-0.5 ${darkMode ? 'text-sky-300' : 'text-[#0072CE]'}`}
          >
            {isCellExpanded ? tr('Show fewer', 'Mostrar menos') : tr(`+${hidden} more room(s)`, `+${hidden} area(s) mas`)}
          </button>
        )}
      </>
    );
  };

  const dayBorder = (day) => {
    if (day.isFuture) return darkMode ? 'bg-slate-900/40 border-slate-800/80 opacity-70' : 'bg-slate-50/70 border-slate-200/80 opacity-80';
    if (day.status === 'hits') {
      return day.hits.some(h => isPathogenType(h.testType))
        ? (darkMode ? 'bg-[#111827] border-red-500/70' : 'bg-white border-red-300')
        : (darkMode ? 'bg-[#111827] border-amber-500/60' : 'bg-white border-amber-300');
    }
    if (day.status === 'clean') return darkMode ? 'bg-[#0F172A] border-emerald-700/60' : 'bg-white border-emerald-300';
    return darkMode ? 'bg-[#0F172A] border-slate-700' : 'bg-white border-slate-200';
  };

  // One week (Monday to Sunday): a short header with the lab numbers, the QA email's numbers for the same week and
  // the rooms, then seven day columns
  const renderExecutiveWeekSection = (weekKey, isCurrent, daysList, ws) => {
    const t = ws.tally;
    const b = ws.b;
    const em = ws.email;
    const cmp = compareEmailWeekToLab(em, b);
    const emLis = cmp.emLis;
    const labLis = cmp.labLis;
    const showLisCompare = catMode === 'pathogen' && selectedRoomFilter === 'ALL' && (cmp.status === 'agree' || cmp.status === 'differ');
    const extras = [];
    if (b && catMode === 'pathogen' && selectedRoomFilter === 'ALL') {
      if (b.st.swabs > 0) extras.push(tr(`Start-up ${b.st.positives}/${b.st.swabs}`, `Arranque ${b.st.positives}/${b.st.swabs}`));
      if (b.inp.swabs > 0) extras.push(tr(`In-process ${b.inp.positives}/${b.inp.swabs}`, `En proceso ${b.inp.positives}/${b.inp.swabs}`));
      // Routine swabs with no start-up / in-process timing (Daily/Weekly and the like), so the split adds up to the week
      const otherSwabs = b.routine.swabs - b.st.swabs - b.inp.swabs;
      const otherPos = b.routine.positives - b.st.positives - b.inp.positives;
      if ((b.st.swabs > 0 || b.inp.swabs > 0) && otherSwabs > 0 && otherPos >= 0) extras.push(tr(`Other programs ${otherPos}/${otherSwabs}`, `Otros programas ${otherPos}/${otherSwabs}`));
      if (b.retest.swabs > 0 || b.retest.pending > 0) extras.push(tr(`Retests ${b.retest.positives} failed of ${b.retest.swabs}`, `Re-pruebas ${b.retest.positives} fallidas de ${b.retest.swabs}`));
      if (b.vector.positives > 0) extras.push(tr(`Vector ${b.vector.positives} positive`, `Vector ${b.vector.positives} positivo`));
      if (b.productTally.positives > 0) extras.push(tr(`Product ${b.productTally.positives} positive`, `Producto ${b.productTally.positives} positivo`));
      if (b.apc.swabs > 0) extras.push(`APC ${b.apc.positives}/${b.apc.swabs}`);
      if (b.atp.swabs > 0) extras.push(`ATP ${b.atp.positives}/${b.atp.swabs}`);
    }
    const emailBits = [];
    if (em) {
      if (emLis) emailBits.push(tr(`Listeria ${emLis.positives} of ${emLis.total} (${fmtPct(emLis.rate)})`, `Listeria ${emLis.positives} de ${emLis.total} (${fmtPct(emLis.rate)})`));
      if (em.summary.retests && em.summary.retests.failed > 0) emailBits.push(tr(`retests ${em.summary.retests.failed} failed`, `re-pruebas ${em.summary.retests.failed} fallidas`));
      if (em.summary.apc && em.summary.apc.total > 0) emailBits.push(`APC ${em.summary.apc.failures}/${em.summary.apc.total}`);
      if (em.summary.atp && em.summary.atp.total > 0) emailBits.push(`ATP ${em.summary.atp.failures}/${em.summary.atp.total}`);
    }
    return (
      <section className={`rounded-2xl border overflow-hidden ${theme.bgCard}`}>
        <div className={`px-3 sm:px-4 py-2.5 border-b space-y-1 ${
          isCurrent ? (darkMode ? 'bg-[#162032] border-[#26334D]' : 'bg-[#F0F6FC] border-sky-200/80') : (darkMode ? 'bg-[#131C2E] border-[#1E293B]' : 'bg-slate-50 border-slate-200/90')
        }`}>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span className={`px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider ${isCurrent ? 'bg-[#00468B] text-white' : 'bg-slate-700 text-white'}`}>
              {isCurrent ? tr('This week', 'Esta semana') : tr('Last week', 'Semana pasada')}
            </span>
            <h2 className="text-sm sm:text-base font-black tracking-tight">{formatWeekRangeLabel(weekKey, true)}</h2>
            <span className="text-xs font-bold">
              {catWord}: {t.swabs > 0 ? (
                <>
                  <b className={t.positives > 0 ? 'text-[#E4002B] dark:text-rose-400' : ''}>{fmtPct(ws.rate)}</b> ({tr(`${t.positives} of ${t.swabs} lab swabs`, `${t.positives} de ${t.swabs} hisopos de laboratorio`)})
                </>
              ) : (
                <span className={theme.textMuted}>{tr('no finished lab swabs', 'sin hisopos terminados')}</span>
              )}
              {t.pending > 0 && <span className={`ml-1.5 ${darkMode ? 'text-amber-300' : 'text-amber-700'}`}>{tr(`${t.pending} pending`, `${t.pending} pendientes`)}</span>}
            </span>
            {ws.totalHits > 0 && (
              <button type="button" onClick={() => setSelectedRoomFilter('ALL')} className="text-[11px] font-black text-[#E4002B] dark:text-rose-400">
                {tr(`${ws.totalHits} shown below`, `${ws.totalHits} abajo`)}{ws.emailOnlyHits > 0 ? tr(` (${ws.emailOnlyHits} from the email only)`, ` (${ws.emailOnlyHits} solo del correo)`) : ''}
              </button>
            )}
          </div>
          {extras.length > 0 && <div className={`text-[11px] font-semibold ${theme.textMuted}`}>{extras.join(' | ')}</div>}
          {emailBits.length > 0 && (
            <div className="text-[11px] font-semibold flex flex-wrap items-center gap-x-2">
              <span className={theme.textMuted}>{tr('QA email:', 'Correo de QA:')}</span>
              <span>{emailBits.join(' | ')}</span>
              {showLisCompare && cmp.status === 'differ' && (
                <button
                  type="button"
                  onClick={onOpenImportCheck}
                  className={`px-1.5 py-0.2 rounded font-black ${darkMode ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-amber-100 text-amber-900'}`}
                >
                  {tr(
                    `lab rows differ: ${labLis.positives} of ${labLis.swabs} Listeria`,
                    `filas de laboratorio difieren: ${labLis.positives} de ${labLis.swabs} Listeria`
                  )}
                </button>
              )}
              {showLisCompare && cmp.status === 'agree' && (
                <span className={darkMode ? 'text-emerald-300' : 'text-emerald-700'}>{tr('lab rows agree', 'filas de laboratorio coinciden')}</span>
              )}
            </div>
          )}
          {ws.roomStats.length > 0 && (
            <div className="flex flex-wrap items-center gap-1 pt-0.5">
              {ws.roomStats.map(rs => {
                const isSelected = selectedRoomFilter === rs.room;
                const bad = rs.hits > 0 || rs.positives > 0;
                const done = rs.swabs > 0;
                return (
                  <button
                    key={rs.room}
                    type="button"
                    onClick={() => setSelectedRoomFilter(isSelected ? 'ALL' : rs.room)}
                    title={tr(`${rs.room}: ${rs.positives} positive of ${rs.swabs} finished, ${rs.pending} pending. Tap to show only this room.`, `${rs.room}: ${rs.positives} positivos de ${rs.swabs} terminados, ${rs.pending} pendientes. Toque para ver solo esta area.`)}
                    className={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-black border ${isSelected ? 'ring-2 ring-[#0072CE] ' : ''}${
                      bad
                        ? (darkMode ? 'bg-red-950/70 text-rose-200 border-red-800' : 'bg-[#FDE8EC] text-[#B00020] border-red-200')
                        : (done
                            ? (darkMode ? 'bg-emerald-950/60 text-emerald-200 border-emerald-800' : 'bg-emerald-50 text-emerald-800 border-emerald-200')
                            : `${theme.bgSubtle}`)
                    }`}
                  >
                    <span>{roomShort(rs.room)}</span>
                    <span className="font-mono">{rs.swabs > 0 ? `${rs.positives}/${rs.swabs}` : (rs.hits > 0 ? `${rs.hits}` : tr('pend', 'pend'))}</span>
                  </button>
                );
              })}
            </div>
          )}
        </div>

        <div className="p-2 grid grid-cols-1 md:grid-cols-7 gap-2">
          {daysList.map(day => (
            <div key={day.dateKey} className={`min-h-[150px] rounded-xl border flex flex-col overflow-hidden ${day.isToday ? 'ring-2 ring-[#0072CE] ' : ''}${dayBorder(day)}`}>
              <div className={`px-2 py-1.5 border-b flex items-center justify-between gap-1 shrink-0 ${darkMode ? 'border-slate-800' : 'border-slate-200'}`}>
                <div className="flex items-center gap-1.5">
                  <span className="text-[10px] font-black uppercase">{day.dow}</span>
                  <span className="text-xs font-black">{day.monthShort} {day.dayNum}</span>
                  {day.isToday && <span className="px-1 py-0.2 rounded text-[9px] font-black uppercase bg-[#0072CE] text-white">{tr('Today', 'Hoy')}</span>}
                </div>
                {statusChip(day, true)}
              </div>
              <div className="p-1.5 flex-1 space-y-1.5 overflow-y-auto">{renderDayBody(day, 4)}</div>
            </div>
          ))}
        </div>
      </section>
    );
  };

  const em = (pressureAnalysis && pressureAnalysis.executiveMetrics) || {};
  const byCat = em.byCategory || {};
  const catData = byCat[catMode] || byCat.pathogen || null;
  // What a year-to-date split leaves out, so each line adds up to the plant rate: swabs whose program has no start-up /
  // in-process timing, and swabs in rooms that are neither Creme nor Bakery. null when there are none.
  const remainderOf = (whole, parts) => {
    if (!whole || !(whole.totalSwabs > 0)) return null;
    let p = whole.positives;
    let s = whole.totalSwabs;
    parts.forEach(x => {
      p -= (x && x.positives) || 0;
      s -= (x && x.totalSwabs) || 0;
    });
    return s > 0 && p >= 0 && p <= s ? { positives: p, swabs: s, rate: round2((p / s) * 100) } : null;
  };
  const ytdOtherPrograms = catData && catData.inProcessAndStartup ? remainderOf(catData.overall, [catData.inProcessAndStartup.startup, catData.inProcessAndStartup.inp]) : null;
  const ytdOtherAreas = catData && catData.cremeAndBakery ? remainderOf(catData.overall, [catData.cremeAndBakery.creme, catData.cremeAndBakery.bakery]) : null;

  return localizeReactTree((
    <div className="h-full w-full flex flex-col overflow-hidden p-2 sm:p-3 gap-2">
      {/* VIEW, WEEK STEPPER AND DISPLAY */}
      <div className={`shrink-0 rounded-xl border px-3 py-2 flex flex-wrap items-center justify-between gap-2 ${theme.bgCard}`}>
        <div className="flex flex-wrap items-center gap-1">
          {[
            { id: 'exec_overview', label: tr('Last week + this week', 'Semana pasada + esta semana') },
            { id: '1w', label: tr('One week', 'Una semana') },
            { id: 'month', label: tr('Month', 'Mes') },
            { id: '8w', label: tr('8 weeks', '8 semanas') },
            { id: 'archive', label: tr('All months', 'Todos los meses') }
          ].map(tf => (
            <button
              key={tf.id}
              type="button"
              onClick={() => setTimeframeMode(tf.id)}
              className={`px-2.5 py-1 rounded-lg text-xs font-bold border ${timeframeMode === tf.id ? 'bg-[#00468B] text-white border-[#00468B]' : `${theme.bgSubtle} hover:border-[#0072CE]`}`}
            >
              {tf.label}
            </button>
          ))}
        </div>

        {timeframeMode !== 'archive' && (
          <div className="flex flex-wrap items-center gap-1.5">
            <div className={`inline-flex items-center rounded-lg border overflow-hidden ${theme.border}`}>
              <button type="button" onClick={() => stepTimeframe(-1)} className={`px-2.5 py-1 text-xs font-bold ${theme.bgSubtle}`} aria-label={tr('Earlier', 'Antes')}>
                {'<'}
              </button>
              <span className="px-2.5 py-1 text-xs font-black font-mono whitespace-nowrap">{activeRangeLabel}</span>
              <button type="button" onClick={() => stepTimeframe(1)} className={`px-2.5 py-1 text-xs font-bold ${theme.bgSubtle}`} aria-label={tr('Later', 'Despues')}>
                {'>'}
              </button>
            </div>
            <button
              type="button"
              onClick={() => { setAnchorWeek(getWeekStart(getTodayDateKey())); setMonthCursor(getTodayDateKey().slice(0, 7)); }}
              className={`px-2.5 py-1 rounded-lg text-[11px] font-black border ${isViewingLiveCurrentWeek && timeframeMode !== 'month' ? 'bg-[#00468B] text-white border-[#00468B]' : theme.bgSubtle}`}
            >
              {tr('Today', 'Hoy')} {formatShortDate(LIVE_TODAY_DATE_KEY)}
            </button>
          </div>
        )}

        <div className="flex flex-wrap items-center gap-1.5">
          {importCheck && (
            <button
              type="button"
              onClick={onOpenImportCheck}
              className={`px-2.5 py-1 rounded-lg text-[11px] font-black border ${
                importCheck.verdict === 'ok'
                  ? (darkMode ? 'bg-emerald-950/60 text-emerald-300 border-emerald-800' : 'bg-emerald-50 text-emerald-800 border-emerald-200')
                  : (darkMode ? 'bg-amber-950/60 text-amber-300 border-amber-800' : 'bg-amber-50 text-amber-900 border-amber-300')
              }`}
            >
              {importCheck.verdict === 'ok' ? tr('Import check: OK', 'Revision de carga: OK') : tr('Import check: see notes', 'Revision de carga: ver notas')}
            </button>
          )}
          <select
            value={cellDisplayMode}
            onChange={e => setCellDisplayMode(e.target.value)}
            aria-label={tr('What each day shows', 'Que muestra cada dia')}
            className={`text-xs font-bold rounded-lg px-2 py-1 border ${theme.bgInput}`}
          >
            <option value="hits">{tr('Days: positives only', 'Dias: solo positivos')}</option>
            <option value="hits_pending">{tr('Days: positives + room counts', 'Dias: positivos + conteos por area')}</option>
            <option value="all_mss">{tr('Days: every swab row', 'Dias: cada fila de hisopo')}</option>
          </select>
          {logoUnlocked && undatedSummaryHits.length > 0 && (
            <button
              type="button"
              onClick={() => setShowUndatedBar(!showUndatedBar)}
              className={`px-2.5 py-1 rounded-lg text-xs font-bold border ${showUndatedBar ? 'bg-[#00468B] text-white border-[#00468B]' : theme.bgSubtle}`}
            >
              {tr(`Email lines with no date (${undatedSummaryHits.length})`, `Lineas del correo sin fecha (${undatedSummaryHits.length})`)}
            </button>
          )}
        </div>
      </div>

      {/* EMAIL LINES WITH NO DATE (retest / APC / ATP): shown on the Friday of the email's week; move one here */}
      {showUndatedBar && undatedSummaryHits.length > 0 && (
        <div className={`shrink-0 rounded-xl border px-3 py-2 ${darkMode ? 'bg-[#162032] border-amber-500/40 text-slate-100' : 'bg-[#FFF6E0] border-[#FFB81C] text-slate-900'}`}>
          <div className="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
            <span className="font-semibold">
              {tr('Retest, APC and ATP lines in the QA email have no date. They show on the Friday of the email\'s week. Pick another day here.', 'Las lineas de re-prueba, APC y ATP del correo de QA no tienen fecha. Se muestran el viernes de la semana del correo. Elija otro dia aqui.')}
            </span>
            {Object.keys(dateOverrides).length > 0 && (
              <button type="button" onClick={() => setDateOverrides({})} className="text-[11px] font-bold underline text-[#0072CE] dark:text-sky-400">
                {tr('Put all back on Friday', 'Regresar todo al viernes')}
              </button>
            )}
          </div>
          <div className="flex gap-2 overflow-x-auto pb-1">
            {undatedSummaryHits.map(uh => {
              const currentAssigned = dateOverrides[uh.id] || uh.date || LIVE_LATEST_FRIDAY;
              const badge = TEST_BADGE[uh.testType] || TEST_BADGE.APC;
              return (
                <div key={uh.id} className={`shrink-0 rounded-lg border px-2 py-1 flex items-center gap-2 text-xs ${theme.bgCard}`}>
                  <span className="px-1.5 py-0.2 rounded font-black text-[10px]" style={{ backgroundColor: darkMode ? badge.bgDark : badge.bg, color: darkMode ? badge.colorDark : badge.color }}>
                    {badge.short}
                  </span>
                  <div className="min-w-0 max-w-[180px]">
                    <div className="font-bold truncate">{uh.room}: {uh.surface}</div>
                    <div className={`text-[10px] truncate ${theme.textMuted}`}>{uh.description}</div>
                  </div>
                  <input
                    type="date"
                    max={LIVE_TODAY_DATE_KEY}
                    value={currentAssigned}
                    onChange={e => {
                      const v = String(e.target.value || '');
                      if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
                      setDateOverrides(prev => ({ ...prev, [uh.id]: v > LIVE_TODAY_DATE_KEY ? LIVE_TODAY_DATE_KEY : v }));
                    }}
                    className={`text-[11px] font-mono font-bold rounded border px-1.5 py-0.5 ${theme.bgInput}`}
                  />
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* YEAR TO DATE, ONE LINE (lab rows; routine environmental swabs only) */}
      {catData && catData.overall && (
        <div className={`shrink-0 rounded-xl border px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 text-xs ${theme.bgCard}`}>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-0.5 min-w-0">
            <span className="font-black">{tr(em.scopeLabel || '', em.scopeLabelEs || em.scopeLabel || '')}</span>
            <span>
              {catWord} <b className="text-[#E4002B] dark:text-rose-400">{fmtPct(catData.overall.thisYearRate)}</b>
              {catData.overall.totalSwabs > 0 ? ` (${catData.overall.positives}/${catData.overall.totalSwabs})` : ''}
            </span>
            {(catData.overall.stRateTY !== null || catData.overall.inpRateTY !== null) && (
              <span className={theme.textMuted}>
                {tr('Start-up', 'Arranque')} {fmtPct(catData.overall.stRateTY)} | {tr('In-process', 'En proceso')} {fmtPct(catData.overall.inpRateTY)}
                {ytdOtherPrograms ? (
                  <span title={tr('Swabs whose program is neither start-up nor in-process (for example Daily/Weekly)', 'Hisopos cuyo programa no es de arranque ni en proceso (por ejemplo Daily/Weekly)')}>
                    {' | '}{tr('Other programs', 'Otros programas')} {fmtPct(ytdOtherPrograms.rate)}
                  </span>
                ) : null}
              </span>
            )}
            <span className={theme.textMuted}>
              {tr('Creme', 'Crema')} {fmtPct(catData.cremeAndBakery.creme.thisYearRate)} | {tr('Bakery', 'Panaderia')} {fmtPct(catData.cremeAndBakery.bakery.thisYearRate)}
              {ytdOtherAreas ? (
                <span title={tr('Swabs in neither Creme nor Bakery: Drains, Zone 4 / Mobile, 01MIX, SCM', 'Hisopos que no son de Crema ni de Panaderia: Drains, Zone 4 / Mobile, 01MIX, SCM')}>
                  {' | '}{tr('Other areas', 'Otras areas')} {fmtPct(ytdOtherAreas.rate)}
                </span>
              ) : null}
            </span>
            <span className={theme.textMuted}>
              {tr('Same dates last year', 'Mismas fechas el ano pasado')} {fmtPct(catData.overall.lastYearRate)}
              {catData.overall.yoyDeltaPct !== null && catData.overall.yoyDeltaPct !== undefined ? ` (${catData.overall.yoyDeltaPct > 0 ? '+' : ''}${catData.overall.yoyDeltaPct})` : ''}
            </span>
          </div>
          <div className="flex flex-wrap items-center gap-1.5">
            <select
              aria-label={tr('Results shown', 'Resultados mostrados')}
              value={catMode}
              onChange={e => setResultCategoryMode && setResultCategoryMode(e.target.value)}
              className={`text-[11px] font-black rounded-lg px-2 py-0.5 border cursor-pointer ${theme.bgInput}`}
            >
              <option value="pathogen">{tr('Listeria + Salmonella', 'Listeria + Salmonella')}</option>
              <option value="all">{tr('All tests', 'Todas las pruebas')}</option>
              <option value="apc">APC</option>
              <option value="atp">ATP</option>
            </select>
            {typeof onOpenDashboard === 'function' && (
              <button type="button" onClick={onOpenDashboard} className="px-2.5 py-0.5 rounded-lg text-[11px] font-black bg-[#00468B] text-white hover:bg-[#0072CE]">
                {tr('Metrics', 'Metricas')}
              </button>
            )}
            {typeof onOpenGraphs === 'function' && (
              <button type="button" onClick={onOpenGraphs} className={`px-2.5 py-0.5 rounded-lg text-[11px] font-black border ${theme.bgSubtle}`}>
                {tr('Graphs', 'Graficas')}
              </button>
            )}
          </div>
        </div>
      )}

      {timeframeMode === 'exec_overview' ? (
        <div className="flex-1 min-h-0 overflow-y-auto space-y-3 pr-0.5 pb-32">
          {renderExecutiveWeekSection(lastWeekStart, false, lastWeekDays, execWeekStats.lastWeek)}
          {renderExecutiveWeekSection(anchorWeek, true, currentWeekDays, execWeekStats.currentWeek)}
          <div className="h-28 shrink-0" aria-hidden="true" />
        </div>
      ) : timeframeMode === 'archive' ? (
        <div className="flex-1 min-h-0 overflow-y-auto space-y-3 pr-1 pb-32">
          <div className={`rounded-xl border px-4 py-3 flex flex-wrap items-center justify-between gap-3 ${theme.bgCard}`}>
            <div>
              <h2 className={`text-base font-black ${theme.textHeading}`}>
                {tr(`${parsedCsv.totals.totalUnique.toLocaleString()} lab rows loaded`, `${parsedCsv.totals.totalUnique.toLocaleString()} filas de laboratorio cargadas`)}
              </h2>
              <p className={`text-xs ${theme.textMuted}`}>{tr('Rate = Listeria + Salmonella positives of finished routine swabs. Tap a month to open it.', 'Tasa = positivos de Listeria + Salmonella entre hisopos de rutina terminados. Toque un mes para abrirlo.')}</p>
            </div>
            {typeof onOpenDedupChecker === 'function' && (
              <button type="button" onClick={onOpenDedupChecker} className={`px-3 py-1.5 rounded-lg text-xs font-black border ${theme.bgSubtle}`}>
                {tr(`${parsedCsv.totals.totalPending} waiting on the lab`, `${parsedCsv.totals.totalPending} esperando laboratorio`)}
              </button>
            )}
          </div>
          {archiveMonths.length === 0 && (
            <div className={`rounded-xl border p-6 text-center text-sm ${theme.bgCard} ${theme.textMuted}`}>{tr('No lab rows loaded yet.', 'Aun no hay filas de laboratorio.')}</div>
          )}
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {archiveMonths.map(m => {
              const rt = m.routine || newTally();
              return (
                <button
                  key={m.monthKey}
                  type="button"
                  onClick={() => { setMonthCursor(m.monthKey); setTimeframeMode('month'); }}
                  className={`text-left rounded-xl border p-3 ${theme.bgCard} ${rt.positives > 0 ? 'border-l-4 border-l-[#E4002B]' : 'border-l-4 border-l-emerald-500'}`}
                >
                  <div className="flex items-center justify-between mb-1.5">
                    <span className="font-mono font-black text-sm">{m.monthKey}</span>
                    <span className="text-xs font-black">{fmtPct(tallyRate(rt))}</span>
                  </div>
                  <div className={`text-[11px] ${theme.textMuted}`}>
                    {tr(`${rt.positives} positive of ${rt.swabs} routine swabs`, `${rt.positives} positivos de ${rt.swabs} hisopos de rutina`)}
                  </div>
                  <div className={`text-[11px] ${theme.textMuted}`}>
                    {tr(`${m.total} rows | ${m.pending} pending | ${m.positives} positive of any kind`, `${m.total} filas | ${m.pending} pendientes | ${m.positives} positivos de cualquier tipo`)}
                  </div>
                </button>
              );
            })}
          </div>
          <div className="h-28 shrink-0" aria-hidden="true" />
        </div>
      ) : (
        <div className="flex-1 min-h-0 flex flex-col overflow-hidden">
          <div className="hidden md:grid grid-cols-7 gap-2 mb-1.5 shrink-0">
            {dowNames.map(dow => (
              <div key={dow} className={`text-center py-1 rounded-lg border text-[11px] font-black uppercase tracking-widest ${darkMode ? 'bg-[#162032] border-[#26334D] text-slate-200' : 'bg-[#00468B] border-[#00468B] text-white'}`}>
                {dow}
              </div>
            ))}
          </div>
          <div className={`flex-1 min-h-0 overflow-y-auto pb-32 grid grid-cols-1 md:grid-cols-7 gap-2 ${timeframeMode === '1w' ? '' : 'auto-rows-fr'}`}>
            {calendarCells.map(cell => {
              if (cell.isPadding) return <div key={cell.key} className={`hidden md:block min-h-[110px] rounded-xl border opacity-30 ${theme.bgSubtle}`} />;
              const day = cell;
              const maxRoomsShown = timeframeMode === '1w' ? 99 : 3;
              return (
                <div key={day.dateKey} className={`${timeframeMode === '1w' ? 'min-h-[320px]' : 'min-h-[130px]'} rounded-xl border flex flex-col overflow-hidden ${day.isToday ? 'ring-2 ring-[#0072CE] ' : ''}${dayBorder(day)}`}>
                  <div className={`px-2 py-1.5 border-b flex flex-wrap items-center justify-between gap-1 shrink-0 ${darkMode ? 'border-slate-800' : 'border-slate-200'}`}>
                    <div className="flex items-center gap-1.5">
                      <span className="text-xs font-black">{day.monthShort} {day.dayNum}</span>
                      <span className={`text-[9px] font-bold uppercase ${theme.textMuted}`}>{day.dow}</span>
                    </div>
                    {statusChip(day, timeframeMode !== '1w')}
                  </div>
                  <div className="p-1.5 flex-1 space-y-1.5 overflow-y-auto">{renderDayBody(day, maxRoomsShown)}</div>
                </div>
              );
            })}
            <div className="h-28 shrink-0 col-span-full" aria-hidden="true" />
          </div>
        </div>
      )}

      {/* DAY DETAIL */}
      {selectedDayModal && (
        <div className="fixed inset-0 bg-slate-950/75 z-50 flex items-center justify-center p-4" onClick={() => setSelectedDayModal(null)}>
          <div className={`w-full max-w-2xl rounded-2xl border shadow-2xl overflow-hidden ${theme.bgCard}`} onClick={e => e.stopPropagation()}>
            <div className="px-5 py-3 bg-[#00468B] text-white flex items-center justify-between">
              <div>
                <h3 className="text-base font-black">{selectedDayModal.dow} {selectedDayModal.monthShort} {selectedDayModal.dayNum} ({selectedDayModal.dateKey})</h3>
                <p className="text-xs text-sky-200">
                  {tr(`${selectedDayModal.hits.length} positive(s), by room`, `${selectedDayModal.hits.length} positivo(s), por area`)}
                </p>
              </div>
              <button type="button" onClick={() => setSelectedDayModal(null)} className="p-1.5 rounded-lg bg-white/10 hover:bg-white/20" aria-label={tr('Close', 'Cerrar')}>
                <XIcon className="w-4 h-4" />
              </button>
            </div>
            <div className="p-5 max-h-[70vh] overflow-y-auto space-y-4">
              {Object.keys(selectedDayModal.byRoom).map(rKey => {
