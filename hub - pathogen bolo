                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* =================================================================
            MODULE 4: POTENTIAL ERROR LOGS & 10-POINT PROACTIVE SCANNER
            ================================================================= */}
        {devSection === 'errors' && (
          <div className="space-y-5">
            {/* 10-Point Proactive Diagnostic Scanner */}
            <div className={`rounded-2xl border shadow-xs overflow-hidden ${theme.bgCard}`}>
              <div className={`px-5 py-4 border-b flex flex-wrap items-center justify-between gap-3 ${theme.bgSubtle}`}>
                <div>
                  <h3 className="text-base font-black">10-Point Proactive Error & System Health Scanner</h3>
                  <p className={`text-xs ${theme.textMuted}`}>
                    Automatically checks regex compilation, composite Sample ID + Description deduplication, IndexedDB capacity, and Dataverse OData readiness.
                  </p>
                </div>
                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={runProactiveDiagnosticScan}
                    className="px-3.5 py-1.5 rounded-xl bg-[#0072CE] text-white text-xs font-black hover:bg-[#00468B] inline-flex items-center gap-1.5"
                  >
                    <RefreshIcon className="w-3.5 h-3.5" />
                    <span>Re-Run 10-Point Scan</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      logEvent('Simulated Potential Error Test: Sample OData 403 / Regex warning verified in Dev Console.', 'error', {
                        testCode: 'DEV_CONSOLE_SIMULATED_ERROR',
                        microsoftId: msIdentity.microsoftId
                      });
                    }}
                    className="px-3 py-1.5 rounded-xl bg-rose-600 text-white text-xs font-black hover:bg-rose-700"
                  >
                    + Simulate Test Error Log
                  </button>
                </div>
              </div>

              <div className="p-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                {healthScanResults.map(chk => (
                  <div key={chk.id} className={`p-3.5 rounded-xl border flex items-start justify-between gap-3 ${theme.bgSubtle}`}>
                    <div>
                      <div className="text-xs font-black">{chk.name}</div>
                      <p className={`text-xs mt-1 ${theme.textMuted}`}>{chk.detail}</p>
                    </div>
                    <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase shrink-0 ${
                      chk.status === 'PASS'
                        ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-300'
                        : chk.status === 'WARN'
                        ? 'bg-amber-500/20 text-amber-600 dark:text-amber-300'
                        : chk.status === 'ERROR'
                        ? 'bg-rose-500/20 text-rose-600 dark:text-rose-300'
                        : 'bg-sky-500/20 text-sky-600 dark:text-sky-300'
                    }`}>
                      {chk.status}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Real-Time Potential Error & Telemetry Stream */}
            <div className={`rounded-2xl border shadow-xs overflow-hidden ${theme.bgCard}`}>
              <div className={`px-5 py-4 border-b flex flex-wrap items-center justify-between gap-3 ${theme.bgSubtle}`}>
                <div>
                  <h3 className="text-base font-black">Potential Error Logs, Warnings & OData Telemetry ({filteredLogs.length} Events)</h3>
                  <p className={`text-xs ${theme.textMuted}`}>
                    Captures uncaught runtime errors, unhandled promise rejections, parser warnings, and Dataverse sync operations.
                  </p>
                </div>
                <div className="flex flex-wrap items-center gap-2">
                  {['ALL', 'ERROR_WARN', 'ERROR', 'WARN', 'SUCCESS', 'INFO'].map(sev => (
                    <button
                      key={sev}
                      type="button"
                      onClick={() => setLogFilter(sev)}
                      className={`px-2.5 py-1 rounded-lg text-[11px] font-bold ${
                        logFilter === sev
                          ? 'bg-[#00468B] text-white'
                          : `${theme.bgCard} border border-slate-300 dark:border-slate-700`
                      }`}
                    >
                      {sev === 'ERROR_WARN' ? 'Errors & Warnings Only' : sev}
                    </button>
                  ))}
                  <input
                    type="search"
                    value={logSearch}
                    onChange={e => setLogSearch(e.target.value)}
                    placeholder="Search error logs..."
                    className={`w-48 rounded-lg border px-2.5 py-1 text-xs ${theme.bgInput}`}
                  />
                  <button
                    type="button"
                    onClick={() => setLogs([])}
                    className="px-2.5 py-1 rounded-lg border border-slate-300 dark:border-slate-700 text-xs font-bold hover:bg-rose-600 hover:text-white"
                  >
                    Clear
                  </button>
                </div>
              </div>

              <div className="p-4 space-y-2 max-h-[420px] overflow-y-auto font-mono text-xs">
                {filteredLogs.length === 0 ? (
                  <div className={`py-8 text-center ${theme.textMuted}`}>
                    No matching error or telemetry events. Click '+ Simulate Test Error Log' above to verify error trapping.
                  </div>
                ) : (
                  filteredLogs.map((l, idx) => (
                    <div
                      key={l.id || idx}
                      className={`p-3 rounded-xl border ${
                        l.type === 'error'
                          ? 'bg-rose-950/30 border-rose-500/50 text-rose-200'
                          : l.type === 'warn'
                          ? 'bg-amber-950/25 border-amber-500/40 text-amber-200'
                          : theme.bgSubtle
                      }`}
                    >
                      <div className="flex items-center justify-between gap-2 text-[10px] mb-1">
                        <span className="font-bold">{l.time} {l.iso ? `(${l.iso})` : ''}</span>
                        <span className={`px-2 py-0.2 rounded uppercase font-black ${
                          l.type === 'error'
                            ? 'bg-rose-600 text-white'
                            : l.type === 'warn'
                            ? 'bg-amber-500 text-slate-950'
                            : l.type === 'success'
                            ? 'bg-emerald-600 text-white'
                            : 'bg-slate-700 text-slate-200'
                        }`}>
                          {l.type}
                        </span>
                      </div>
                      <div className="font-bold">{l.message}</div>
                      {l.payload && (
                        <pre className="mt-1.5 p-2 rounded bg-slate-950 text-sky-300 text-[10px] overflow-x-auto">
                          {JSON.stringify(l.payload, null, 2)}
                        </pre>
                      )}
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        )}
        <div className="h-28 shrink-0" aria-hidden="true" />
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

// =======================================================================
// VIEW 9: HARBORAGE POINTS & FACILITY CONCERNS MODULE
// (Shown ONLY when the CJ Schwan's Logo is clicked: logoUnlocked === true)
// Allows users to upload potential harborage points/concerns across the facility,
// attach photos, drop a pin on the map, and share "What do you think about it?"
// =======================================================================
function HarborageConcernsView({
  darkMode,
  theme,
  msIdentity,
  isDevAuthorized,
  harborageConcerns,
  onSaveConcerns,
  facilityAreas,
  fullSiteCatalog,
  mapImage,
  onLocateOnMap,
  logEvent
}) {
  const [filterRoom, setFilterRoom] = useState('ALL');
  const [filterStatus, setFilterStatus] = useState('ALL');
  const [searchQuery, setSearchQuery] = useState('');
  const [saving, setSaving] = useState(false);
  const [statusBanner, setStatusBanner] = useState('');
  const [commentInputs, setCommentInputs] = useState({});

  const [draftConcern, setDraftConcern] = useState({
    room: 'WJ',
    siteCode: '0320-STLWJ1-066',
    title: '',
    surfaceCategory: 'Floor / Trench / Drain',
    severity: 'CRITICAL',
    userThought: '',
    proposedAction: '',
    photoDataUrl: '',
    spot: { x: 18.5, y: 15.2 }
  });

  const handlePhotoFileChange = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      if (typeof reader.result === 'string') {
        setDraftConcern(prev => ({ ...prev, photoDataUrl: reader.result }));
      }
    };
    reader.readAsDataURL(file);
  };

  const handleSubmitConcern = async (e) => {
    e.preventDefault();
    if (!draftConcern.title.trim() || !draftConcern.userThought.trim()) return;
    setSaving(true);
    const id = `HARB-2026-${Date.now().toString().slice(-4)}`;
    const photoUrl = draftConcern.photoDataUrl || generateHarborageEvidenceSvgDataUrl(
      draftConcern.room,
      draftConcern.title.trim(),
      BRAND.red
    );
    const newRecord = {
      id,
      room: draftConcern.room,
      siteCode: draftConcern.siteCode.trim() || 'Unlinked',
      title: draftConcern.title.trim(),
      surfaceCategory: draftConcern.surfaceCategory,
      severity: draftConcern.severity,
      status: 'Open Investigation',
      submittedBy: `${msIdentity.userName} (${msIdentity.microsoftId})`,
      submittedAt: new Date().toISOString().slice(0, 10),
      spot: draftConcern.spot || { x: 20, y: 20 },
      userThought: draftConcern.userThought.trim(),
      proposedAction: draftConcern.proposedAction.trim() || 'Evaluate during sanitation teardown and verify with vector swabs.',
      upvotes: 1,
      photoDataUrl: photoUrl,
      comments: []
    };

    const nextList = [newRecord, ...(harborageConcerns || [])];
    await onSaveConcerns(nextList, newRecord);
    setSaving(false);
    setDraftConcern(prev => ({
      ...prev,
      title: '',
      userThought: '',
      proposedAction: '',
      photoDataUrl: ''
    }));
    setStatusBanner(`Submitted Harborage Concern "${newRecord.title}" (${newRecord.id}) and synced to Dataverse.`);
    setTimeout(() => setStatusBanner(''), 5000);
  };

  const handleAddPeerThought = async (concernId) => {
    const text = (commentInputs[concernId] || '').trim();
    if (!text) return;
    const nextList = (harborageConcerns || []).map(c => {
      if (c.id !== concernId) return c;
      const nextComment = {
        id: `c-${Date.now()}`,
        author: `${msIdentity.userName} (${msIdentity.microsoftId})`,
        date: new Date().toISOString().slice(0, 10),
        thought: text
      };
      return {
        ...c,
        comments: [...(c.comments || []), nextComment]
      };
    });
    setCommentInputs(prev => ({ ...prev, [concernId]: '' }));
    await onSaveConcerns(nextList);
  };

  const handleUpvoteConcern = async (concernId) => {
    const nextList = (harborageConcerns || []).map(c =>
      c.id === concernId ? { ...c, upvotes: (c.upvotes || 0) + 1 } : c
    );
    await onSaveConcerns(nextList);
  };

  const handleUpdateConcernStatus = async (concernId, nextStatus) => {
    const nextList = (harborageConcerns || []).map(c =>
      c.id === concernId ? { ...c, status: nextStatus } : c
    );
    await onSaveConcerns(nextList);
  };

  const handleDeleteConcern = async (concernId) => {
    const nextList = (harborageConcerns || []).filter(c => c.id !== concernId);
    await onSaveConcerns(nextList);
  };

  const filteredConcerns = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return (harborageConcerns || []).filter(c => {
      if (filterRoom !== 'ALL' && c.room !== filterRoom) return false;
      if (filterStatus !== 'ALL' && c.status !== filterStatus) return false;
      if (!q) return true;
      const hay = `${c.id} ${c.room} ${c.siteCode} ${c.title} ${c.surfaceCategory} ${c.userThought} ${c.proposedAction} ${c.submittedBy}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [harborageConcerns, filterRoom, filterStatus, searchQuery]);

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-4 sm:p-6 pb-32">
      <div className="max-w-7xl mx-auto space-y-5 pb-28">
        {/* TOP BANNER */}
        <div
          className="rounded-2xl p-5 text-white shadow-lg"
          style={{
            background: 'linear-gradient(135deg, #4C1D95 0%, #00468B 55%, #8B0018 100%)',
            borderBottom: '4px solid #FFB81C'
          }}
        >
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div>
              <div className="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#FFB81C] text-slate-950 text-[10px] font-black uppercase tracking-widest mb-1.5">
                <CameraIcon className="w-3.5 h-3.5" />
                <span>CJ Logo Unlocked Module - Facility Harborage & Concerns</span>
              </div>
              <h2 className="text-xl sm:text-2xl font-black">
                Facility Harborage Points, Photo Evidence & Team Thoughts Hub
              </h2>
              <p className="text-xs text-sky-100 mt-1">
                Upload potential harborage points or sanitation concerns across the facility, pin them on the plant map, and share what you think about the root cause and fix.
              </p>
            </div>
            <div className="flex items-center gap-2 text-xs">
              <div className="px-3 py-2 rounded-xl bg-black/30 border border-white/20 text-center">
                <div className="text-[10px] uppercase text-amber-300 font-bold">Total Logged Concerns</div>
                <div className="text-xl font-black">{(harborageConcerns || []).length}</div>
              </div>
              <div className="px-3 py-2 rounded-xl bg-black/30 border border-white/20 text-center">
                <div className="text-[10px] uppercase text-emerald-300 font-bold">Dataverse Sync</div>
                <div className="text-sm font-black">Active</div>
              </div>
            </div>
          </div>
        </div>

        {statusBanner && (
          <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 px-4 py-2.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 flex items-center justify-between">
            <span>{statusBanner}</span>
            <button type="button" onClick={() => setStatusBanner('')} className="underline">Dismiss</button>
          </div>
        )}

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          {/* LEFT 5 COLUMNS: UPLOAD POTENTIAL HARBORAGE POINT & "WHAT DO YOU THINK ABOUT IT?" FORM */}
          <form
            onSubmit={handleSubmitConcern}
            className={`lg:col-span-5 rounded-2xl border shadow-sm overflow-hidden flex flex-col ${theme.bgCard}`}
          >
            <div className="px-5 py-3.5 bg-[#00468B] text-white border-b-2 border-[#FFB81C]">
              <h3 className="text-sm font-black uppercase tracking-wider">
                Upload Potential Harborage Point / Facility Concern
              </h3>
              <p className="text-[11px] text-sky-200">
                Synced to <span className="font-mono">PATHOGEN_BOLO_HARBORAGE_CONCERNS</span> & <span className="font-mono">craa5__facilityobservations</span>
              </p>
            </div>

            <div className="p-4 space-y-3.5 text-xs">
              <div className="grid grid-cols-2 gap-2.5">
                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Facility Room / Area</label>
                  <select
                    value={draftConcern.room}
                    onChange={e => {
                      const rk = e.target.value;
                      const rmMeta = ROOM_META[rk] || ROOM_META.WJ;
                      const firstSite = fullSiteCatalog.find(s => s.room === rk);
                      setDraftConcern(prev => ({
                        ...prev,
                        room: rk,
                        siteCode: firstSite ? firstSite.siteCode : prev.siteCode,
                        spot: {
                          x: round2(rmMeta.defaultBox[0] + rmMeta.defaultBox[2] / 2),
                          y: round2(rmMeta.defaultBox[1] + rmMeta.defaultBox[3] / 2)
                        }
                      }));
                    }}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    {Object.keys(ROOM_META).map(rk => (
                      <option key={rk} value={rk}>{ROOM_META[rk].label}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Nearest 0320- Swab Site</label>
                  <input
                    type="text"
                    value={draftConcern.siteCode}
                    onChange={e => setDraftConcern(prev => ({ ...prev, siteCode: e.target.value }))}
                    placeholder="e.g. 0320-STLWJ1-066"
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-mono font-bold ${theme.bgInput}`}
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-2.5">
                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Surface / Vector Category</label>
                  <select
                    value={draftConcern.surfaceCategory}
                    onChange={e => setDraftConcern(prev => ({ ...prev, surfaceCategory: e.target.value }))}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    <option value="Floor / Trench / Drain">Floor / Trench / Drain</option>
                    <option value="Slicer / Nozzle / Blade">Slicer / Nozzle / Blade</option>
                    <option value="Conveyor / Belt / Return">Conveyor / Belt / Return</option>
                    <option value="Mixer / Crumb / Melter">Mixer / Crumb / Melter</option>
                    <option value="Platform / Frame / Pillar">Platform / Frame / Pillar</option>
                    <option value="Overhead / Condensate / Piping">Overhead / Condensate / Piping</option>
                  </select>
                </div>

                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Concern Severity</label>
                  <select
                    value={draftConcern.severity}
                    onChange={e => setDraftConcern(prev => ({ ...prev, severity: e.target.value }))}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    <option value="CRITICAL">CRITICAL (Active Harborage Risk)</option>
                    <option value="HIGH">HIGH (Water / Product Trap)</option>
                    <option value="ELEVATED">ELEVATED (Preventive Concern)</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-black uppercase opacity-75 mb-1">
                  Harborage Point / Concern Title *
                </label>
                <input
                  type="text"
                  required
                  value={draftConcern.title}
                  onChange={e => setDraftConcern(prev => ({ ...prev, title: e.target.value }))}
                  placeholder="e.g. Hollow Support Leg Weld Seam by WJ1 Slicer Discharge"
                  className={`w-full rounded-xl border px-3 py-2 font-bold ${theme.bgInput}`}
                />
              </div>

              <div>
                <label className="block text-[10px] font-black uppercase text-[#E4002B] dark:text-amber-300 mb-1">
                  What Do You Think About It? (Your Hypothesis, Observations & Why It Harbors) *
                </label>
                <textarea
                  rows={4}
                  required
                  value={draftConcern.userThought}
                  onChange={e => setDraftConcern(prev => ({ ...prev, userThought: e.target.value }))}
                  placeholder="Share what you think is happening here (e.g., high-pressure washdown forces water into this seam, and mid-shift vibration drips it onto the floor)..."
                  className={`w-full rounded-xl border p-2.5 font-medium leading-relaxed ${theme.bgInput}`}
                />
              </div>

              <div>
                <label className="block text-[10px] font-black uppercase opacity-75 mb-1">
                  Recommended Fix / Sanitation or Maintenance Action
                </label>
                <input
                  type="text"
                  value={draftConcern.proposedAction}
                  onChange={e => setDraftConcern(prev => ({ ...prev, proposedAction: e.target.value }))}
                  placeholder="e.g. Seal weld seam, replace Delrin scraper, or add to deep-clean teardown checklist..."
                  className={`w-full rounded-xl border px-3 py-1.5 ${theme.bgInput}`}
                />
              </div>

              {/* Photo Upload + Interactive Mini-Map Coordinate Pin Picker */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <div className={`p-2.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                  <label className="block text-[10px] font-black uppercase">
                    Upload Photo / Evidence Image
                  </label>
                  <input
                    type="file"
                    accept="image/*"
                    onChange={handlePhotoFileChange}
                    className="w-full text-[10px]"
                  />
                  {draftConcern.photoDataUrl ? (
                    <img
                      src={draftConcern.photoDataUrl}
                      alt="Harborage Preview"
                      className="w-full h-24 object-cover rounded-lg border"
                    />
                  ) : (
                    <div className="text-[10px] opacity-75">
                      Optional: Upload a photo from your phone/PC, or an annotated evidence diagram will be generated automatically.
                    </div>
                  )}
                </div>

                <div className={`p-2.5 rounded-xl border space-y-1.5 ${theme.bgSubtle}`}>
                  <div className="flex items-center justify-between text-[10px] font-black uppercase">
                    <span>Click Mini-Map to Pin</span>
                    <span className="font-mono text-[#0072CE]">({draftConcern.spot.x}%, {draftConcern.spot.y}%)</span>
                  </div>
                  <div
                    onClick={e => {
                      const r = e.currentTarget.getBoundingClientRect();
                      const x = round2(clamp01((e.clientX - r.left) / r.width) * 100);
                      const y = round2(clamp01((e.clientY - r.top) / r.height) * 100);
                      setDraftConcern(prev => ({ ...prev, spot: { x, y } }));
                    }}
                    className="relative w-full h-24 rounded-lg overflow-hidden border cursor-crosshair bg-slate-900"
                  >
                    {mapImage && (
                      <img src={mapImage} alt="Mini Map Picker" className="w-full h-full object-cover opacity-85 pointer-events-none" />
                    )}
                    <div
                      className="absolute -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#E4002B] border-2 border-[#FFB81C] shadow-md pointer-events-none"
                      style={{ left: `${draftConcern.spot.x}%`, top: `${draftConcern.spot.y}%` }}
                    />
                  </div>
                </div>
              </div>

              <button
                type="submit"
                disabled={saving}
                className="w-full py-2.5 rounded-xl bg-[#E4002B] text-white font-black text-xs uppercase tracking-wider hover:bg-red-700 shadow-md cursor-pointer"
              >
                {saving ? 'Uploading Harborage Concern to Dataverse...' : 'Submit Harborage Point & Share Thoughts'}
              </button>
            </div>
          </form>

          {/* RIGHT 7 COLUMNS: FACILITY HARBORAGE CONCERNS FEED & PEER DISCUSSION */}
          <div className="lg:col-span-7 space-y-4">
            {/* Filter Bar */}
            <div className={`rounded-2xl border p-3.5 flex flex-wrap items-center justify-between gap-2 ${theme.bgCard}`}>
              <div className="flex flex-wrap items-center gap-1.5">
                <select
                  value={filterRoom}
                  onChange={e => setFilterRoom(e.target.value)}
                  className={`rounded-xl border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                >
                  <option value="ALL">All Rooms ({(harborageConcerns || []).length})</option>
                  {Object.keys(ROOM_META).map(rk => (
                    <option key={rk} value={rk}>{ROOM_META[rk].label}</option>
                  ))}
                </select>

                <select
                  value={filterStatus}
                  onChange={e => setFilterStatus(e.target.value)}
                  className={`rounded-xl border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                >
                  <option value="ALL">All Statuses</option>
                  <option value="Open Investigation">Open Investigation</option>
                  <option value="Escalated to Maintenance">Escalated to Maintenance</option>
                  <option value="Verified / Resolved">Verified / Resolved</option>
                </select>
              </div>

              <input
                type="search"
                value={searchQuery}
                onChange={e => setSearchQuery(e.target.value)}
                placeholder="Search harborage points, thoughts, 0320- sites..."
                className={`w-64 rounded-xl border px-3 py-1.5 text-xs ${theme.bgInput}`}
              />
            </div>

            {/* Harborage Cards */}
            <div className="space-y-4">
              {filteredConcerns.map(item => {
                const rmMeta = ROOM_META[item.room] || ROOM_META.WJ;
                const sevColor = item.severity === 'CRITICAL' ? BRAND.red : (item.severity === 'HIGH' ? '#EA580C' : '#0072CE');
                return (
                  <div
                    key={item.id}
                    className={`rounded-2xl border shadow-xs overflow-hidden ${theme.bgCard}`}
                    style={{ borderLeft: `5px solid ${sevColor}` }}
                  >
                    <div className="p-4 sm:p-5 space-y-3.5">
                      <div className="flex flex-wrap items-start justify-between gap-2">
                        <div className="space-y-1">
                          <div className="flex flex-wrap items-center gap-1.5">
                            <span
                              className="px-2 py-0.5 rounded text-[10px] font-black uppercase text-white"
                              style={{ backgroundColor: sevColor }}
                            >
                              {item.severity}
                            </span>
                            <span
                              className="px-2 py-0.5 rounded text-[10px] font-black text-white"
                              style={{ backgroundColor: rmMeta.color }}
                            >
                              {rmMeta.short}
                            </span>
                            <span className="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-amber-300">
                              {item.siteCode}
                            </span>
                            <span className={`px-2 py-0.5 rounded text-[10px] font-bold border ${theme.bgSubtle}`}>
                              {item.surfaceCategory}
                            </span>
                          </div>
                          <h4 className="text-base font-black">{item.title}</h4>
                          <div className={`text-[11px] ${theme.textMuted}`}>
                            Logged by <b className={darkMode ? 'text-slate-200' : 'text-slate-800'}>{item.submittedBy}</b> on <span className="font-mono">{item.submittedAt}</span>
                          </div>
                        </div>

                        <div className="flex items-center gap-1.5">
                          <select
                            value={item.status || 'Open Investigation'}
                            onChange={e => handleUpdateConcernStatus(item.id, e.target.value)}
                            className={`rounded-lg border px-2 py-1 text-[11px] font-black ${theme.bgInput}`}
                          >
                            <option value="Open Investigation">Open Investigation</option>
                            <option value="Escalated to Maintenance">Escalated to Maintenance</option>
                            <option value="Verified / Resolved">Verified / Resolved</option>
                          </select>

                          <button
                            type="button"
                            onClick={() => onLocateOnMap({ siteCode: item.siteCode !== 'Unlinked' ? item.siteCode : null, room: item.room, description: item.title })}
                            className="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-[#0072CE] text-white hover:bg-[#00468B]"
                          >
                            <MapPinIcon className="w-3.5 h-3.5" /> Map
                          </button>

                          {isDevAuthorized && (
                            <button
                              type="button"
                              onClick={() => handleDeleteConcern(item.id)}
                              className="p-1.5 rounded-lg text-red-500 hover:bg-red-500/15"
                              title="Remove harborage concern"
                            >
                              <TrashIcon className="w-3.5 h-3.5" />
                            </button>
                          )}
                        </div>
                      </div>

                      {/* Photo + "What Do You Think About It?" Split */}
                      <div className="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-stretch">
                        {item.photoDataUrl && (
                          <div className="md:col-span-5 rounded-xl overflow-hidden border bg-slate-950 flex items-center justify-center">
                            <img
                              src={item.photoDataUrl}
                              alt={item.title}
                              className="w-full h-44 object-cover"
                            />
                          </div>
                        )}
                        <div className={`${item.photoDataUrl ? 'md:col-span-7' : 'md:col-span-12'} flex flex-col justify-between gap-2.5`}>
                          <div className={`p-3.5 rounded-xl border flex-1 ${darkMode ? 'bg-amber-950/25 border-amber-500/40' : 'bg-[#FFF6E0] border-[#FFB81C]'}`}>
                            <div className="text-[10px] font-black uppercase tracking-wider text-[#E4002B] dark:text-amber-300 mb-1">
                              What the Submitter Thinks About This Harborage Point:
                            </div>
                            <p className="text-xs font-semibold leading-relaxed">
                              "{item.userThought}"
                            </p>
                          </div>

                          <div className={`p-2.5 rounded-xl border text-xs ${theme.bgSubtle}`}>
                            <span className="font-black uppercase text-[10px] text-emerald-600 dark:text-emerald-400 block">
                              Proposed Fix / Corrective Action:
                            </span>
                            <span className="font-semibold">{item.proposedAction}</span>
                          </div>
                        </div>
                      </div>

                      {/* Peer Thoughts & Upvotes Footer */}
                      <div className="pt-2 border-t border-slate-200 dark:border-slate-800 space-y-2.5">
                        <div className="flex items-center justify-between">
                          <span className="text-[11px] font-black uppercase tracking-wider opacity-75">
                            Team Thoughts & Floor Observations ({(item.comments || []).length})
                          </span>
                          <button
                            type="button"
                            onClick={() => handleUpvoteConcern(item.id)}
                            className="px-2.5 py-1 rounded-lg text-xs font-black bg-[#00468B]/15 text-[#0072CE] dark:text-sky-300 hover:bg-[#0072CE] hover:text-white transition-colors"
                          >
                            Agree / Escalate Priority ({item.upvotes || 1})
                          </button>
                        </div>

                        {(item.comments || []).length > 0 && (
                          <div className="space-y-1.5">
                            {item.comments.map(cm => (
                              <div key={cm.id} className={`p-2.5 rounded-xl border text-xs ${theme.bgSubtle}`}>
                                <div className="flex items-center justify-between text-[10px] opacity-75 mb-0.5">
                                  <span className="font-black">{cm.author}</span>
                                  <span className="font-mono">{cm.date}</span>
                                </div>
                                <div className="font-medium">"{cm.thought}"</div>
                              </div>
                            ))}
                          </div>
                        )}

                        <div className="flex gap-2">
                          <input
                            type="text"
                            value={commentInputs[item.id] || ''}
                            onChange={e => setCommentInputs(prev => ({ ...prev, [item.id]: e.target.value }))}
                            placeholder="Add what you think about this harborage concern..."
                            className={`flex-1 rounded-xl border px-3 py-1.5 text-xs ${theme.bgInput}`}
                          />
                          <button
                            type="button"
                            onClick={() => handleAddPeerThought(item.id)}
                            className="px-3.5 py-1.5 rounded-xl bg-[#00468B] text-white text-xs font-black hover:bg-[#0072CE]"
                          >
                            Post Thought
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <div className="h-28 shrink-0" aria-hidden="true" />
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

// =======================================================================
// MODAL: 'SELECT FEATURE' USER SETUP (JSON PREFERENCES) & ADMIN PROFILE CONTROL
// Allows any user to choose what they want to see (e.g., "only wants to see X" rooms/tests/widgets)
// and save their preferences in JSON (LocalStorage + Dataverse).
// Also allows the MS-ID Admin to inspect/alter any user's preferences and enforce role profiles.
// =======================================================================
function UserSelectFeaturesModal({
  darkMode,
  theme,
  msIdentity,
  isDevAuthorized,
  activeUserProfile,
  userProfilesRegistry,
  onSaveUserProfiles,
  facilityAreas,
  bypassUserPrefFilter,
  setBypassUserPrefFilter,
  setMsIdentityOverride,
  onClose
}) {
  const usersMap = (userProfilesRegistry && userProfilesRegistry.users) || DEFAULT_USER_PROFILES_REGISTRY.users;
  const rolesMap = (userProfilesRegistry && userProfilesRegistry.roles) || DEFAULT_USER_PROFILES_REGISTRY.roles;

  const [modalTab, setModalTab] = useState('my_features'); // 'my_features' | 'json_editor' | 'admin_users'
  const [targetMsId, setTargetMsId] = useState(msIdentity.microsoftId || '');

  const currentTargetRecord = usersMap[targetMsId] || activeUserProfile.userRecord;
  const [draftPrefs, setDraftPrefs] = useState(() => ({
    ...(currentTargetRecord.viewPreferences || {
      onlyShowRooms: [],
      onlyShowTests: [],
      defaultCalendarTimeframe: '1w',
      defaultCellDisplayMode: 'hits_pending',
      defaultLandingTab: 'calendar',
      darkModePreferred: true,
      visibleWidgets: {
        pressure_points: true,
        kpi_strip: true,
        room_matrix: true,
        active_hits_table: true,
        harborage_feed: true
      }
    })
  }));
  const [draftRoleProfile, setDraftRoleProfile] = useState(currentTargetRecord.assignedRoleProfile || 'qa_lead');
  const [draftLockedByAdmin, setDraftLockedByAdmin] = useState(!!currentTargetRecord.lockedByAdmin);
  const [jsonText, setJsonText] = useState(() => JSON.stringify(draftPrefs, null, 2));
  const [jsonErr, setJsonErr] = useState('');
  const [saveNotice, setSaveNotice] = useState('');

  // Sync draft when targetMsId changes
  useEffect(() => {
    const rec = usersMap[targetMsId] || activeUserProfile.userRecord;
    if (rec && rec.viewPreferences) {
      setDraftPrefs(rec.viewPreferences);
      setDraftRoleProfile(rec.assignedRoleProfile || 'qa_lead');
      setDraftLockedByAdmin(!!rec.lockedByAdmin);
      setJsonText(JSON.stringify(rec.viewPreferences, null, 2));
      setJsonErr('');
    }
  }, [targetMsId, usersMap, activeUserProfile.userRecord]);

  const isLockedForCurrentUser = !isDevAuthorized && activeUserProfile.isLockedByAdmin && targetMsId === msIdentity.microsoftId;

  const toggleRoomPref = (roomKey) => {
    if (isLockedForCurrentUser) return;
    setDraftPrefs(prev => {
      const cur = Array.isArray(prev.onlyShowRooms) ? prev.onlyShowRooms : [];
      const nextRooms = cur.includes(roomKey) ? cur.filter(r => r !== roomKey) : [...cur, roomKey];
      const next = { ...prev, onlyShowRooms: nextRooms };
      setJsonText(JSON.stringify(next, null, 2));
      return next;
    });
  };

  const toggleTestPref = (testKey) => {
    if (isLockedForCurrentUser) return;
    setDraftPrefs(prev => {
      const cur = Array.isArray(prev.onlyShowTests) ? prev.onlyShowTests : [];
      const nextTests = cur.includes(testKey) ? cur.filter(t => t !== testKey) : [...cur, testKey];
      const next = { ...prev, onlyShowTests: nextTests };
      setJsonText(JSON.stringify(next, null, 2));
      return next;
    });
  };

  const toggleWidgetPref = (widgetKey) => {
    if (isLockedForCurrentUser) return;
    setDraftPrefs(prev => {
      const curWidgets = prev.visibleWidgets || {};
      const nextWidgets = { ...curWidgets, [widgetKey]: curWidgets[widgetKey] === false };
      const next = { ...prev, visibleWidgets: nextWidgets };
      setJsonText(JSON.stringify(next, null, 2));
      return next;
    });
  };

  const handleSavePreferences = async () => {
    let finalPrefs = draftPrefs;
    if (modalTab === 'json_editor') {
      try {
        finalPrefs = JSON.parse(jsonText);
        setJsonErr('');
      } catch (e) {
        setJsonErr(`JSON Syntax Error: ${e.message}`);
        return;
      }
    }

    const currentReg = userProfilesRegistry || DEFAULT_USER_PROFILES_REGISTRY;
    const baseUser = (currentReg.users && currentReg.users[targetMsId]) || {
      microsoftId: targetMsId,
      userName: targetMsId === msIdentity.microsoftId ? msIdentity.userName : `User (${targetMsId})`,
      email: targetMsId === msIdentity.microsoftId ? msIdentity.email : `${targetMsId.toLowerCase()}@schwans.com`,
      domainAccount: `SCHWANS\\${targetMsId}`
    };

    const updatedUser = {
      ...baseUser,
      assignedRoleProfile: isDevAuthorized ? draftRoleProfile : (baseUser.assignedRoleProfile || 'qa_lead'),
      lockedByAdmin: isDevAuthorized ? draftLockedByAdmin : !!baseUser.lockedByAdmin,
      updatedAt: new Date().toISOString().slice(0, 10),
      updatedBy: msIdentity.userName,
      viewPreferences: finalPrefs
    };

    const nextReg = {
      ...currentReg,
      users: {
        ...(currentReg.users || {}),
        [targetMsId]: updatedUser
      }
    };

    await onSaveUserProfiles(nextReg, `Saved Select Feature JSON preferences for ${targetMsId}`);
    setBypassUserPrefFilter(false);
    setSaveNotice(`Saved JSON feature preferences for ${updatedUser.userName} (${targetMsId}) to Dataverse & local storage!`);
    setTimeout(() => setSaveNotice(''), 4000);
  };

  return localizeReactTree((
    <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-xs z-50 flex items-center justify-center p-4" onClick={onClose}>
      <div
        className={`w-full max-w-4xl max-h-[90vh] rounded-2xl border shadow-2xl flex flex-col overflow-hidden ${theme.bgCard}`}
        onClick={e => e.stopPropagation()}
      >
        {/* Modal Header */}
        <div className="px-5 py-4 bg-gradient-to-r from-[#00468B] via-[#0072CE] to-[#022C22] text-white flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#FFB81C]">
          <div>
            <div className="flex items-center gap-2">
              <UsersIcon className="w-4 h-4 text-[#FFB81C]" />
              <span className="text-[10px] font-black uppercase tracking-widest text-[#FFB81C]">
                Select Feature User Setup & JSON View Control
              </span>
            </div>
            <h3 className="text-base sm:text-lg font-black">
              Customize What You See ({targetMsId === msIdentity.microsoftId ? `My Profile: ${msIdentity.userName}` : `Editing User: ${targetMsId}`})
            </h3>
          </div>
          <button type="button" onClick={onClose} className="p-1.5 rounded-lg bg-white/10 hover:bg-white/20">
            <XIcon className="w-4 h-4" />
          </button>
        </div>

        {/* Sub-Navigation Bar */}
        <div className={`px-5 py-2.5 border-b flex flex-wrap items-center justify-between gap-2 ${theme.bgSubtle}`}>
          <div className="flex flex-wrap items-center gap-1.5">
            <button
              type="button"
              onClick={() => setModalTab('my_features')}
              className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                modalTab === 'my_features' ? 'bg-[#00468B] text-white' : theme.bgCard
              }`}
            >
              1. Visual Feature & Room Selector
            </button>
            <button
              type="button"
              onClick={() => {
                setJsonText(JSON.stringify(draftPrefs, null, 2));
                setModalTab('json_editor');
              }}
              className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                modalTab === 'json_editor' ? 'bg-[#00468B] text-white' : theme.bgCard
              }`}
            >
              2. Raw JSON Preferences Editor
            </button>
            {isDevAuthorized && (
              <button
                type="button"
                onClick={() => setModalTab('admin_users')}
                className={`px-3 py-1.5 rounded-xl text-xs font-black ${
                  modalTab === 'admin_users' ? 'bg-emerald-600 text-white' : 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300'
                }`}
              >
                3. Admin: All Plant Users & Access Profiles ({Object.keys(usersMap).length})
              </button>
            )}
          </div>

          {/* Admin User Target Selector */}
          {isDevAuthorized && (
            <div className="flex items-center gap-1.5 text-xs">
              <span className="font-bold opacity-75">Target User:</span>
              <select
                value={targetMsId}
                onChange={e => setTargetMsId(e.target.value)}
                className={`rounded-lg border px-2 py-1 text-xs font-mono font-bold ${theme.bgInput}`}
              >
                {Object.values(usersMap).map(u => (
                  <option key={u.microsoftId} value={u.microsoftId}>
                    {u.microsoftId} - {u.userName}
                  </option>
                ))}
              </select>
            </div>
          )}
        </div>

        {/* Body */}
        <div className="p-5 overflow-y-auto space-y-5 flex-1 text-xs">
          {saveNotice && (
            <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 p-3 font-bold text-emerald-700 dark:text-emerald-300">
              {saveNotice}
            </div>
          )}

          {isLockedForCurrentUser && (
            <div className="rounded-xl border border-rose-500/60 bg-rose-500/15 p-3 font-bold text-rose-600 dark:text-rose-300">
              Your view profile ({activeUserProfile.roleProfile.name}) is currently locked and managed by the plant administrator (admin).
            </div>
          )}

          {modalTab === 'my_features' && (
            <div className="space-y-5">
              {/* Quick "Only Want to See X" Presets */}
              <div className={`p-3.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                <div className="text-[10px] font-black uppercase tracking-wider text-[#0072CE] dark:text-sky-300">
                  Quick "Only Want to See X" Setup Presets
                </div>
                <div className="flex flex-wrap gap-1.5">
                  {[
                    { label: 'Show All Plant Rooms (Default)', rooms: [], tests: [] },
                    { label: 'Only WJ1 / Waterjet Slicers', rooms: ['WJ'], tests: [] },
                    { label: 'Only Creme Lines (IBL5 + IBL4 + Creme)', rooms: ['IBL5', 'IBL4', 'Creme'], tests: [] },
                    { label: 'Only Bakery (Dough Rm + Highspeed + Custard)', rooms: ['Dough Room', 'Highspeed', 'Custard', 'Bakery'], tests: [] },
                    { label: 'Only Listeria & Retest Positives', rooms: [], tests: ['LIS', 'RETEST-LIS'] }
                  ].map((preset, idx) => (
                    <button
                      key={idx}
                      type="button"
                      disabled={isLockedForCurrentUser}
                      onClick={() => {
                        const next = { ...draftPrefs, onlyShowRooms: preset.rooms, onlyShowTests: preset.tests };
                        setDraftPrefs(next);
                        setJsonText(JSON.stringify(next, null, 2));
                      }}
                      className={`px-2.5 py-1.5 rounded-lg font-bold border ${theme.bgCard} hover:border-[#0072CE]`}
                    >
                      {preset.label}
                    </button>
                  ))}
                </div>
              </div>

              {/* 1. Select Rooms to Display */}
              <div>
                <div className="flex items-center justify-between mb-2">
                  <label className="font-black uppercase tracking-wider text-[11px]">
                    1. Select Rooms / Areas to See ({draftPrefs.onlyShowRooms && draftPrefs.onlyShowRooms.length > 0 ? `${draftPrefs.onlyShowRooms.length} Selected` : 'All Rooms Shown'})
                  </label>
                  <button
                    type="button"
                    onClick={() => setDraftPrefs(prev => ({ ...prev, onlyShowRooms: [] }))}
                    className="text-[11px] font-bold text-[#0072CE] underline"
                  >
                    Reset to All Rooms
                  </button>
                </div>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {Object.keys(ROOM_META).map(rk => {
                    const checked = Array.isArray(draftPrefs.onlyShowRooms) && draftPrefs.onlyShowRooms.includes(rk);
                    return (
                      <button
                        key={rk}
                        type="button"
                        onClick={() => toggleRoomPref(rk)}
                        className={`p-2.5 rounded-xl border text-left transition-all flex items-center justify-between ${
                          checked
                            ? 'bg-[#00468B] text-white border-[#00468B] shadow-xs'
                            : `${theme.bgSubtle} hover:border-[#0072CE]`
                        }`}
                      >
                        <span className="font-bold truncate">{ROOM_META[rk].label}</span>
                        <span className={`px-1.5 py-0.2 rounded text-[9px] font-black ${checked ? 'bg-[#FFB81C] text-slate-950' : 'bg-slate-500/20'}`}>
                          {checked ? 'ON' : 'ALL'}
                        </span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* 2. Select Pathogen / Swab Test Types */}
              <div>
                <label className="block font-black uppercase tracking-wider text-[11px] mb-2">
                  2. Select Test Types to See ({draftPrefs.onlyShowTests && draftPrefs.onlyShowTests.length > 0 ? draftPrefs.onlyShowTests.join(', ') : 'All Test Types'})
                </label>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {Object.keys(TEST_BADGE).map(tk => {
                    const checked = Array.isArray(draftPrefs.onlyShowTests) && draftPrefs.onlyShowTests.includes(tk);
                    return (
                      <button
                        key={tk}
                        type="button"
                        onClick={() => toggleTestPref(tk)}
                        className={`p-2.5 rounded-xl border text-left font-bold flex items-center justify-between ${
                          checked ? 'bg-[#0072CE] text-white border-[#0072CE]' : theme.bgSubtle
                        }`}
                      >
                        <span>{TEST_BADGE[tk].label}</span>
                        <span className="text-[10px] font-mono">{checked ? 'FILTERED' : 'ALL'}</span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* 3. Default Calendar Timeframe & Dashboard Widgets */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className={`p-3.5 rounded-xl border space-y-2.5 ${theme.bgSubtle}`}>
                  <div className="font-black uppercase text-[11px]">3. Default Calendar & Landing Preferences</div>
                  <div>
                    <label className="block text-[10px] font-bold uppercase opacity-75 mb-1">Default Calendar Timeframe</label>
                    <select
                      value={CALENDAR_VIEW_FROM_PREF[draftPrefs.defaultCalendarTimeframe] === 'exec_overview' || !draftPrefs.defaultCalendarTimeframe ? 'exec_overview' : draftPrefs.defaultCalendarTimeframe}
                      onChange={e => setDraftPrefs(prev => ({ ...prev, defaultCalendarTimeframe: e.target.value }))}
                      className={`w-full rounded-lg border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                    >
                      <option value="exec_overview">{tr('Last week + this week', 'Semana pasada + esta semana')}</option>
                      <option value="one_week">{tr('One week', 'Una semana')}</option>
                      <option value="month">{tr('Month', 'Mes')}</option>
                      <option value="8w">{tr('8 weeks', '8 semanas')}</option>
                      <option value="archive">{tr('All months', 'Todos los meses')}</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-[10px] font-bold uppercase opacity-75 mb-1">Default Calendar Cell Content</label>
                    <select
                      value={draftPrefs.defaultCellDisplayMode || 'hits_pending'}
                      onChange={e => setDraftPrefs(prev => ({ ...prev, defaultCellDisplayMode: e.target.value }))}
                      className={`w-full rounded-lg border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                    >
                      <option value="hits">Show BOLO Hits Only</option>
                      <option value="hits_pending">Show Hits + Blank/Pending Swabs</option>
                      <option value="all_mss">Show All Room Swabs (MSS Full View)</option>
                    </select>
                  </div>
                </div>

                <div className={`p-3.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                  <div className="font-black uppercase text-[11px]">4. Visible Dashboard Modules</div>
                  {[
                    { id: 'pressure_points', label: 'Plant Pressure Points & Suggested Actions' },
                    { id: 'kpi_strip', label: 'Executive KPI Strip & Duplicate Shield' },
                    { id: 'room_matrix', label: 'Room-by-Room Breakdown Matrix' },
                    { id: 'active_hits_table', label: 'Active BOLO Positive & Failure Hits Table' }
                  ].map(w => {
                    const isOn = !draftPrefs.visibleWidgets || draftPrefs.visibleWidgets[w.id] !== false;
                    return (
                      <label key={w.id} className="flex items-center justify-between gap-2 py-1 cursor-pointer">
                        <span className="font-bold">{w.label}</span>
                        <input
                          type="checkbox"
                          checked={isOn}
                          onChange={() => toggleWidgetPref(w.id)}
                        />
                      </label>
                    );
                  })}
                </div>
              </div>

              {/* Admin Role & Lock Controls when MS ID is active */}
              {isDevAuthorized && (
                <div className="p-3.5 rounded-xl border border-emerald-500/40 bg-emerald-500/10 flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <div className="text-[10px] font-black uppercase text-emerald-600 dark:text-emerald-300">
                      Admin Profile & Access Enforcement for {targetMsId}
                    </div>
                    <div className="text-xs font-bold">
                      Assign a Role Profile or lock this user's view so they only see their assigned rooms and tabs whenever they open the app.
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <select
                      value={draftRoleProfile}
                      onChange={e => setDraftRoleProfile(e.target.value)}
                      className={`rounded-lg border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                    >
                      {Object.values(rolesMap).map(r => (
                        <option key={r.id} value={r.id}>Role: {r.name}</option>
                      ))}
                    </select>
                    <label className="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 text-white font-bold cursor-pointer">
                      <input
                        type="checkbox"
                        checked={draftLockedByAdmin}
                        onChange={e => setDraftLockedByAdmin(e.target.checked)}
                      />
                      <span>Lock User View</span>
                    </label>
                  </div>
                </div>
              )}
            </div>
          )}

          {modalTab === 'json_editor' && (
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <span className="font-black uppercase text-[11px]">
                  User View Preferences JSON (<span className="font-mono">{targetMsId}</span>)
                </span>
                {jsonErr && <span className="text-rose-500 font-bold">{jsonErr}</span>}
              </div>
              <textarea
                rows={14}
                value={jsonText}
                onChange={e => {
                  setJsonText(e.target.value);
                  setJsonErr('');
                }}
                className={`w-full rounded-xl border p-3 font-mono text-xs ${theme.bgInput}`}
              />
            </div>
          )}

          {modalTab === 'admin_users' && isDevAuthorized && (
            <div className="space-y-3">
              <div className="font-black uppercase text-[11px]">
                All Saved User Preference Profiles in Dataverse (<span className="font-mono">PATHOGEN_BOLO_USER_PROFILES_JSON</span>)
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                {Object.values(usersMap).map(u => {
                  const rDef = rolesMap[u.assignedRoleProfile] || rolesMap.qa_lead;
                  return (
                    <div key={u.microsoftId} className={`p-3.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                      <div className="flex items-center justify-between">
                        <div>
                          <span className="font-mono font-black text-xs text-[#0072CE] dark:text-sky-300">{u.microsoftId}</span>
                          <span className="mx-1.5">-</span>
                          <span className="font-black text-xs">{u.userName}</span>
                        </div>
                        {u.lockedByAdmin && (
                          <span className="px-2 py-0.5 rounded text-[9px] font-black bg-rose-600 text-white">LOCKED</span>
                        )}
                      </div>
                      <div className="text-[11px]">
                        Role: <b>{rDef.name}</b> - Rooms: <b>{(u.viewPreferences && u.viewPreferences.onlyShowRooms && u.viewPreferences.onlyShowRooms.length > 0) ? u.viewPreferences.onlyShowRooms.join(', ') : 'All Rooms'}</b>
                      </div>
                      <div className="flex gap-2 pt-1">
                        <button
                          type="button"
                          onClick={() => {
                            setTargetMsId(u.microsoftId);
                            setModalTab('my_features');
                          }}
                          className="px-2.5 py-1 rounded bg-[#00468B] text-white font-bold text-[11px]"
                        >
                          Edit User Preferences
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            setMsIdentityOverride({
                              microsoftId: u.microsoftId,
                              systemUserId: '',
                              aadObjectId: '',
                              userName: u.userName,
                              email: u.email,
                              domainAccount: u.domainAccount || `SCHWANS\\${u.microsoftId}`,
                              roles: [rDef.name],
                              source: 'Admin Profile Simulation'
                            });
                            onClose();
                          }}
                          className="px-2.5 py-1 rounded bg-[#FFB81C] text-slate-950 font-black text-[11px]"
                        >
                          Simulate This User
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        {/* Modal Footer */}
        <div className={`px-5 py-3.5 border-t flex flex-wrap items-center justify-between gap-2 ${theme.bgSubtle}`}>
          <div className="text-[11px] font-mono opacity-80">
            Stored in JSON key <span className="font-bold">PATHOGEN_BOLO_USER_PROFILES_JSON</span>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={onClose}
              className={`px-3.5 py-1.5 rounded-xl border text-xs font-bold ${theme.bgCard}`}
            >
              Close
            </button>
            {!isLockedForCurrentUser && (
              <button
                type="button"
                onClick={handleSavePreferences}
                className="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-black hover:bg-emerald-700 shadow-sm cursor-pointer"
              >
                <SaveIcon className="w-3.5 h-3.5" />
                <span>Save JSON Preferences to Dataverse</span>
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

