  return r;
}

// Which positives does an MSS log row close? Same piece (equipment GUID) or, when the hit has no piece, same area,
// on or after the collection date. logRows: [{ key, day, equipmentguid, area }]
function findSwabClosures(ledgerRows, logRows, ctx) {
  const out = {};
  const logs = (logRows || []).slice().sort((a, b) => String(a.day).localeCompare(String(b.day)));
  (ledgerRows || []).forEach(r => {
    if (!r || r.result !== 'Positive' || !r.date) return;
    const links = resolveSwabLinks(r, ctx);
    if (!links.equipmentguid && !links.area) return;
    for (let i = 0; i < logs.length; i += 1) {
      const l = logs[i];
      if (!l.day || l.day < r.date) continue;
      const samePiece = links.equipmentguid && l.equipmentguid && l.equipmentguid === links.equipmentguid;
      const sameArea = !links.equipmentguid && links.area && hubSameName(l.area, links.area);
      if (samePiece || sameArea) {
        out[swabRowKey(r)] = { key: l.key, day: l.day };
        break;
      }
    }
  });
  return out;
}

// ---------- Busy answers (v2.4) ----------
// Dataverse allows each user 6,000 requests in 5 minutes and answers 429 (Too Many Requests, with Retry-After in
// seconds) past that, or 503 when it is busy. Every writer here waits the time asked for and sends again, and all of
// them hold off together (boloPauseUntil), so a bulk save slows down instead of losing rows.
let boloPauseUntil = 0;
function boloSleep(ms) {
  return new Promise(resolve => { window.setTimeout(resolve, Math.max(0, ms)); });
}
// The wait a busy answer asks for (Retry-After), else 2, 4, 8 ... seconds; at least 1 second and never over 5 minutes
function boloRetryWaitMs(retryAfter, tries) {
  const n = parseFloat(retryAfter);
  if (!isNaN(n) && n >= 0) return Math.min(300000, Math.max(1000, n * 1000));
  return Math.min(120000, 2000 * Math.pow(2, Math.max(0, (tries || 1) - 1)));
}
function boloPause(ms) {
  boloPauseUntil = Math.max(boloPauseUntil, Date.now() + ms);
}
async function boloWaitForPause() {
  const w = boloPauseUntil - Date.now();
  if (w > 0) await boloSleep(w);
}
function boloRetryAfterOf(res) {
  try { return (res && res.headers && res.headers.get ? res.headers.get('Retry-After') : '') || ''; } catch (e) { return ''; }
}
function boloIsBusy(status) { return status === 429 || status === 503; }

// Read every page of an OData query (Dataverse returns @odata.nextLink while more rows remain). A busy answer waits
// and asks for the same page again. onPage(rowsSoFar) is called after each page.
async function fetchAllPages(firstUrl, maxRows, onPage) {
  const rows = [];
  let url = firstUrl;
  let waits = 0;
  while (url && rows.length < (maxRows || 200000)) {
    await boloWaitForPause();
    const res = await fetch(url, { headers: { ...ODATA_HEADERS, Prefer: 'odata.maxpagesize=5000' } });
    if (boloIsBusy(res.status) && waits < 8) {
      waits += 1;
      boloPause(boloRetryWaitMs(boloRetryAfterOf(res), waits));
      continue;
    }
    if (!res.ok) throw new Error(await readApiError(res));
    waits = 0;
    const data = await res.json();
    (data.value || []).forEach(v => rows.push(v));
    url = data['@odata.nextLink'] || '';
    if (onPage) onPage(rows.length);
  }
  return rows;
}

// The column a refused write names when Dataverse does not have it ("Could not find a property named 'x'")
function boloMissingColumnOf(text) {
  const t = String(text || '');
  const m = t.match(/property\s+'([^']+)'/i) || t.match(/attribute\s+'([^']+)'/i) || t.match(/named\s+'([^']+)'/i);
  return m && m[1] ? m[1] : '';
}

// PATCH one row; when Dataverse names a column that does not exist, drop it and try again. A busy answer (429 / 503)
// waits the time asked for and sends again (up to 8 waits). Returns { ok, missing: [columns dropped], error }
async function patchRowDroppingMissing(entitySet, rowId, body) {
  const bodyObj = { ...body };
  const missing = [];
  let waits = 0;
  let steps = 0;
  while (steps < 12) {
    await boloWaitForPause();
    let res;
    try {
      res = await fetch(apiUrl(`${entitySet}(${rowId})`), {
        method: 'PATCH',
        headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyObj)
      });
    } catch (e) {
      return { ok: false, missing, error: e.message || 'Network error' };
    }
    if (res.ok) return { ok: true, missing };
    if (boloIsBusy(res.status) && waits < 8) {
      waits += 1;
      boloPause(boloRetryWaitMs(boloRetryAfterOf(res), waits));
      continue;
    }
    let errText = '';
    try { errText = await res.clone().text(); } catch (e) { /* ignore */ }
    const col = boloMissingColumnOf(errText);
    if (col && Object.prototype.hasOwnProperty.call(bodyObj, col)) {
      delete bodyObj[col];
      missing.push(col);
      steps += 1;
      continue;
    }
    return { ok: false, missing, error: await readApiError(res) };
  }
  return { ok: false, missing, error: 'Too many missing columns' };
}

// ---------- Saving many rows (v2.4) ----------
// A bulk save sent one PATCH per row, so 20,000+ swab rows ran into the request limit above and left rows unsaved.
// Rows now go 100 to a $batch request, three requests at a time. Each row is its own write (no change set), so one
// refused row never undoes the others, and Prefer: odata.continue-on-error makes Dataverse answer for every row. A
// busy answer waits and sends again; a column Dataverse does not have is dropped (the caller's missing list) and the
// row sent again. If $batch itself is refused (or never answers on the first try), rows go one PATCH at a time.
const BOLO_BATCH_SIZE = 100;
const BOLO_BATCH_WORKERS = 3;
const BOLO_MAX_TRIES = 8;
let boloBatchMode = ''; // '' = not tried yet, 'batch' = works here, 'single' = one PATCH a row

function boloErrorMessageOf(text, status) {
  const t = String(text || '');
  let msg = '';
  const j = t.indexOf('{');
  if (j !== -1) {
    try {
      const e = JSON.parse(t.slice(j).trim());
      if (e && e.error && e.error.message) msg = String(e.error.message);
    } catch (e) { /* not JSON */ }
  }
  if (!msg) msg = t.replace(/HTTP\/1\.[01][^\n]*/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 200);
  return `${msg ? `${msg} ` : ''}(HTTP ${status})`;
}

function boloBatchRequestBody(boundary, entitySet, jobs) {
  const NL = '\r\n';
  let body = '';
  jobs.forEach(job => {
    body += `--${boundary}${NL}Content-Type: application/http${NL}Content-Transfer-Encoding: binary${NL}${NL}`;
    body += `PATCH ${apiUrl(`${entitySet}(${job.id})`)} HTTP/1.1${NL}Content-Type: application/json; type=entry${NL}${NL}`;
    body += `${JSON.stringify(job.send)}${NL}`;
  });
  return `${body}--${boundary}--${NL}`;
}

// The answers inside a $batch response, in the order the rows were sent: [{ status, text, retryAfter }]
function boloBatchResponseParts(text, contentType) {
  const src = String(text || '');
  let boundary = '';
  const bm = /boundary=("?)([^";\s]+)\1/i.exec(String(contentType || ''));
  if (bm) boundary = bm[2];
  if (!boundary) {
    const lm = /^--(batchresponse_[^\s]+?)\s*$/m.exec(src) || /^--([^\s-][^\s]*?)\s*$/m.exec(src);
    if (lm) boundary = lm[1].replace(/--$/, '');
  }
  if (!boundary) return [];
  const pieces = src.split(`--${boundary}`);
  const parts = [];
  for (let i = 1; i < pieces.length; i += 1) {
    const piece = pieces[i];
    if (piece.slice(0, 2) === '--') break;
    const sm = /HTTP\/1\.[01]\s+(\d{3})/.exec(piece);
    if (!sm) continue;
    const ra = /\nRetry-After:\s*([^\r\n]+)/i.exec(piece);
    parts.push({ status: parseInt(sm[1], 10), text: piece.slice(sm.index), retryAfter: ra ? ra[1].trim() : '' });
  }
  return parts;
}

// One $batch request. Resolves { parts } (the answer for each row, in order) or { whole: 'busy' | 'refused' |
// 'noanswer', status, retryAfter, error } when the request as a whole got no row answers.
async function boloSendBatch(entitySet, jobs) {
  const boundary = `batch_${newGuid()}`;
  let res;
  try {
    res = await fetch(apiUrl('$batch'), {
      method: 'POST',
      headers: { ...ODATA_HEADERS, 'Content-Type': `multipart/mixed; boundary=${boundary}`, Prefer: 'odata.continue-on-error' },
      body: boloBatchRequestBody(boundary, entitySet, jobs)
    });
  } catch (e) {
    return { whole: 'noanswer', status: 0, error: (e && e.message) || 'Network error' };
  }
  let text = '';
  try { text = await res.text(); } catch (e) { /* no body */ }
  if (boloIsBusy(res.status)) return { whole: 'busy', status: res.status, retryAfter: boloRetryAfterOf(res), error: boloErrorMessageOf(text, res.status) };
  let ctype = '';
  try { ctype = (res.headers && res.headers.get ? res.headers.get('Content-Type') : '') || ''; } catch (e) { /* no headers */ }
  const parts = boloBatchResponseParts(text, ctype);
  if (parts.length > 0) return { parts };
  return { whole: res.ok ? 'noanswer' : 'refused', status: res.status, error: boloErrorMessageOf(text, res.status) };
}

// Save rows: jobs = [{ id, body }] (PATCH by row id, which makes the row when it is not there). opts:
//   missing      columns Dataverse does not have ({ col: true }, shared with the caller; one found is added and left
//                out of every later row), onMissing(col)
//   onSaved(job), onFailed(job, error), onProgress({ saved, failed, left })
// Resolves { saved, failed, lastError, mode }.
async function boloSaveRows(entitySet, jobs, opts) {
  const o = opts || {};
  const missing = o.missing || {};
  const queue = (jobs || []).map(j => ({ id: j.id, body: j.body, tries: 0 }));
  const total = queue.length;
  let saved = 0;
  let failed = 0;
  let lastError = '';
  let firstTryMisses = 0;
  const sendOf = (job) => {
    const send = { ...job.body };
    Object.keys(missing).forEach(k => { delete send[k]; });
    return send;
  };
  const progress = () => { if (o.onProgress) o.onProgress({ saved, failed, left: Math.max(0, total - saved - failed) }); };
  const markSaved = (job) => { saved += 1; if (o.onSaved) o.onSaved(job); };
  const markFailed = (job, error) => {
    failed += 1;
    lastError = error || lastError;
    if (o.onFailed) o.onFailed(job, error || '');
  };
  const noteMissing = (col) => {
    if (!col || missing[col]) return;
    missing[col] = true;
    if (o.onMissing) o.onMissing(col);
  };
  const again = (job, error) => {
    job.tries += 1;
    if (job.tries >= BOLO_MAX_TRIES) markFailed(job, error);
    else queue.push(job);
  };
  const sendOne = async (job) => {
    const res = await patchRowDroppingMissing(entitySet, job.id, sendOf(job));
    res.missing.forEach(noteMissing);
    if (res.ok) markSaved(job);
    else markFailed(job, res.error);
  };
  const worker = async () => {
    while (queue.length > 0) {
      await boloWaitForPause();
      if (boloBatchMode === 'single') {
        const job = queue.shift();
        if (job) await sendOne(job);
        progress();
        continue;
      }
      const chunk = queue.splice(0, BOLO_BATCH_SIZE);
      if (chunk.length === 0) continue;
      chunk.forEach(job => { job.send = sendOf(job); });
      const r = await boloSendBatch(entitySet, chunk);
      if (r.parts) {
        boloBatchMode = 'batch';
        let waitMs = 0;
        chunk.forEach((job, i) => {
          const part = r.parts[i];
          if (!part) { again(job, 'Dataverse sent no answer for this row'); return; }
          if (part.status >= 200 && part.status < 300) { markSaved(job); return; }
          if (boloIsBusy(part.status)) {
            waitMs = Math.max(waitMs, boloRetryWaitMs(part.retryAfter, job.tries + 1));
            again(job, boloErrorMessageOf(part.text, part.status));
            return;
          }
          const col = boloMissingColumnOf(part.text);
          if (col && Object.prototype.hasOwnProperty.call(job.send, col)) {
            noteMissing(col);
            queue.push(job);
            return;
          }
          markFailed(job, boloErrorMessageOf(part.text, part.status));
        });
        if (waitMs > 0) boloPause(waitMs);
      } else if (r.whole === 'busy') {
        boloPause(boloRetryWaitMs(r.retryAfter, chunk[0].tries + 1));
        chunk.forEach(job => again(job, r.error));
      } else if (r.status === 401 || r.status === 403) {
        chunk.forEach(job => markFailed(job, r.error));
      } else if (boloBatchMode !== 'batch' && (r.whole === 'refused' || firstTryMisses >= 2)) {
        // $batch is not taken here: one PATCH a row from now on (this page load)
        boloBatchMode = 'single';
        chunk.forEach(job => { queue.unshift(job); });
      } else {
        if (boloBatchMode !== 'batch') firstTryMisses += 1;
        boloPause(boloRetryWaitMs('', chunk[0].tries + 1));
        chunk.forEach(job => again(job, r.error));
      }
      progress();
    }
  };
  const workers = [];
  for (let i = 0; i < BOLO_BATCH_WORKERS; i += 1) workers.push(worker());
  await Promise.all(workers);
  progress();
  return { saved, failed, lastError, mode: boloBatchMode };
}

// ---------- Hub config (data contract section 12) ----------
// Shared settings: one row per craa5_configkey, and BOLO writes only its PATHOGEN_BOLO_ keys. The new _e_ Hub config
// comes first (User-owned, so roles need Organization-level Read and Write; its craa5_configjson holds 1,048,576
// characters; skipped while it has no craa5_configkey column), the old _0_ hubconfig second. On
// the old table the JSON goes in craa5_manifestjson, because its craa5_configjson holds only 100 characters. A row
// with empty JSON means "no settings yet" (the Dataverse monitor may make the row first): the app keeps its defaults.
const BOLO_CONFIG_SPOTS = [
  { table: HUB_CONFIG_TABLES[0], col: 'craa5_configjson', max: 0 },
  { table: HUB_CONFIG_TABLES[1], col: HUB_MANIFEST_COL, max: 0 },
  { table: HUB_CONFIG_TABLES[1], col: 'craa5_configjson', max: 100 }
];
