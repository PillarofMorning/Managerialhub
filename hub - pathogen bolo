                    </div>
                    <div className="font-black">YoY Change: {fmtPct(card.data.yoyDelta)} ({card.data.yoyDelta === null || card.data.yoyDelta === undefined ? 'no LY data' : (isBetter ? 'Better' : 'Higher')})</div>
                  </div>
                </div>
              );
