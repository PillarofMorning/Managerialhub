  // Merge any newly discovered 0320- sites from uploaded CSVs into the catalog
  const fullSiteCatalog = useMemo(() => {
    const byCode = {};
    baseSiteCatalog.forEach(s => { byCode[s.siteCode] = s; });
    parsedCsv.discoveredSites.forEach(ds => {
