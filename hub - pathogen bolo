  // Save one JSON setting to Hub config (new _e_ table first, the old _0_ one second; see boloSaveConfig)
  const upsertHubConfigKey = useCallback(async (configName, payloadObj) => {
    await boloSaveConfig(configName, payloadObj);
    return true;
  }, []);

  // Deterministic GUID generator so repeated syncs of the same BOLO hit or Harborage Concern update in-place via PATCH
  const deterministicObsGuid = useCallback((seedStr) => {
    const raw = String(seedStr || '').trim();
    if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(raw)) {
      return raw.toLowerCase();
    }
    const h = [0x811c9dc5, 0x9e3779b9, 0x85ebca6b, 0xc2b2ae35];
    for (let i = 0; i < raw.length; i += 1) {
      const code = raw.charCodeAt(i);
      for (let j = 0; j < 4; j += 1) {
        h[j] = Math.imul(h[j] ^ ((code + j * 31) & 0xff), 16777619) >>> 0;
      }
    }
    const hex = h.map(v => v.toString(16).padStart(8, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-4${hex.slice(13, 16)}-a${hex.slice(17, 20)}-${hex.slice(20, 32)}`;
  }, []);

  // Upsert a row in craa5__facilityobservations with automatic retry if optional/variant columns are absent
  const upsertFacilityObservationRecord = useCallback(async (obsId, candidatePayloads) => {
    const payloads = Array.isArray(candidatePayloads) ? candidatePayloads : [candidatePayloads];
    let lastRes = null;
    for (let i = 0; i < payloads.length; i += 1) {
      const bodyObj = { ...payloads[i] };
      for (let step = 0; step < 6; step += 1) {
        const res = await fetch(apiUrl(`${DATAVERSE_OBS_TABLE}(${obsId})`), {
          method: 'PATCH',
          headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
          body: JSON.stringify(bodyObj)
        });
        if (res.ok) return res;
        lastRes = res;
        let errText = '';
        try { errText = await res.clone().text(); } catch (e) { /* ignore */ }
        const propMatch = errText.match(/property\s+'([^']+)'/i) || errText.match(/attribute\s+'([^']+)'/i);
        if (propMatch && propMatch[1] && Object.prototype.hasOwnProperty.call(bodyObj, propMatch[1])) {
          delete bodyObj[propMatch[1]];
          continue;
        }
        break;
      }
    }
    if (lastRes) throw new Error(await readApiError(lastRes));
    return null;
  }, []);

  // Push a Swab Hit / BOLO Alert directly to Dataverse craa5__facilityobservations
  const pushHitToDataverseObservation = useCallback(async (hit) => {
    const seed = hit.id || `${hit.sampleId || ''}|${hit.siteCode || ''}|${hit.date || ''}|${hit.description || ''}`;
    const id = deterministicObsGuid(`BOLO_HIT::${seed}`);
    const spot = hit.spot || { x: 20, y: 20, box: [15, 15, 10, 10] };
    const box = spot.box || [Math.max(0, spot.x - 4), Math.max(0, spot.y - 4), 8, 8];
    const roomVal = hit.room || 'Facility';
    const areaVal = hit.siteCode ? `${hit.siteCode} (${hit.surface})` : hit.surface;
    const equipVal = hit.assetTag ? `${hit.surface} (${hit.assetTag})` : hit.surface;
    const descVal = `(PATHOGEN BOLO - ${hit.testType} ${hit.stage}) ${hit.surface} - ${hit.description} (Date: ${formatShortDate(hit.date)})`;
    const livePayload = {
      craa5_mapx: round2(spot.x),
      craa5_mapy: round2(spot.y),
      craa5__boxwidth: round2(box[2] || 8),
      craa5__boxheight: round2(box[3] || 8),
      craa5__room: roomVal,
      craa5__area: areaVal,
      craa5__equipment: equipVal,
      craa5__description: descVal,
      craa5__whotonotify: 'FSQ / Sanitation Leadership',
      craa5__customnote: 'fsq concern',
      craa5__facility: 'MAIN'
    };
    const minimalPayload = {
      craa5__area: areaVal,
      craa5__room: roomVal,
