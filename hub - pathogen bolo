function SiteLinkCells({ site, theme, canEdit, mssAreas, assets, link, zoneArea, onSave }) {
  const [area, setArea] = useState((link && link.area) || '');
  const [equip, setEquip] = useState((link && link.equipmentguid) || '');
  const [state, setState] = useState('');
  useEffect(() => { setArea((link && link.area) || ''); setEquip((link && link.equipmentguid) || ''); }, [link]);
  const effectiveArea = area || zoneArea || '';
  const choices = effectiveArea ? assets.filter(a => hubSameName(a.area, effectiveArea)) : [];
  const dirty = area !== ((link && link.area) || '') || equip !== ((link && link.equipmentguid) || '');
  if (!canEdit) {
    const a = equip ? assets.find(x => x.id === equip) : null;
    return (
      <>
        <td className="py-2 px-3">{effectiveArea || '-'}</td>
        <td className="py-2 px-3">{a ? a.name : '-'}</td>
      </>
    );
  }
  return (
    <>
      <td className="py-2 px-3">
        <select value={area} onChange={e => { setArea(e.target.value); setEquip(''); }} className={`rounded border px-1.5 py-1 text-[11px] max-w-[10rem] ${theme.bgInput}`}>
          <option value="">{zoneArea ? `(zone: ${zoneArea})` : '(none)'}</option>
          {mssAreas.map(a => <option key={a.area} value={a.area}>{a.area}</option>)}
        </select>
      </td>
      <td className="py-2 px-3 whitespace-nowrap">
        <select value={equip} onChange={e => setEquip(e.target.value)} className={`rounded border px-1.5 py-1 text-[11px] max-w-[12rem] ${theme.bgInput}`}>
          <option value="">{effectiveArea ? '(whole area)' : '(pick an area first)'}</option>
          {choices.map(a => <option key={a.id} value={a.id}>{a.name}{a.uid ? ` #${a.uid}` : ''}</option>)}
        </select>
        {dirty && (
          <button
            type="button"
            onClick={async () => {
              setState('...');
              try { await onSave(site.siteCode, { area, equipmentguid: equip }); setState('ok'); } catch (e) { setState('failed'); }
            }}
            className="ml-1 px-2 py-0.5 rounded bg-[#0072CE] text-white text-[10px] font-black"
          >
            Save
          </button>
        )}
        {state === 'ok' && <span className="ml-1 text-emerald-600 font-bold text-[10px]">Saved</span>}
        {state === 'failed' && <span className="ml-1 text-amber-700 font-bold text-[10px]">Not saved</span>}
      </td>
    </>
  );
}

