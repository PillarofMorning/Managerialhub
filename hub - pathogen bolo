                        <span style={{ fontSize: '10px', color: theme.textMuted }}>{LIVE_CURRENT_YEAR - 1}: {fmtG(row.ly)}</span>
                        {diff !== null && (
                          <span style={{ fontSize: '10px', fontWeight: 800, color: diff <= 0 ? '#059669' : '#B45309' }}>
                            ({diff > 0 ? `+${diff}` : diff})
                          </span>
                        )}
                        {row.room && typeof onLocateOnMap === 'function' && (
                          <button
                            onClick={() => onLocateOnMap({ room: row.room })}
                            style={{ background: 'transparent', color: theme.accent, border: `1px solid ${theme.border}`, borderRadius: '5px', padding: '1px 6px', fontSize: '10px', fontWeight: 800, cursor: 'pointer' }}
