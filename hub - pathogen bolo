// hubSaveManifest's io: query / create / update on a Hub config table by its logical name (entity set = name + 's')
const BOLO_HUB_IO = {
  query: async (table, q) => {
    const parts = [];
    if (q && q.select && q.select.length) parts.push(`$select=${q.select.join(',')}`);
    if (q && q.filter) parts.push(`$filter=${encodeURIComponent(q.filter)}`);
    if (q && q.top) parts.push(`$top=${q.top}`);
    try {
      const res = await fetch(apiUrl(`${table}s?${parts.join('&')}`), { headers: ODATA_HEADERS });
      if (!res.ok) return { rows: null, err: await readApiError(res) };
      return { rows: (await res.json()).value || [] };
    } catch (e) {
      return { rows: null, err: e.message || 'Network error' };
    }
  },
  create: (table, body) => {
    const send = { ...body };
    const id = send[`${table}id`];
    delete send[`${table}id`];
    return boloPatchConfigRow(table, id, send);
  },
  update: (table, id, body) => boloPatchConfigRow(table, id, body)
};
async function boloPatchConfigRow(table, id, body) {
  const res = await fetch(apiUrl(`${table}s(${id})`), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (!res.ok) throw new Error(await readApiError(res));
  return true;
}
let boloManifestStarted = false;

// The live connection: loads areas, equipment, site links and stored swab rows, saves changed rows, finds closures.
function useSwabDataverse({ ledgerRows, setHistoricalLedger, regexRules, roomAliases, canWrite, logEvent }) {
  const [swabDv, setSwabDv] = useState({ status: 'probing', set: '', idCol: '', missingCols: [], stored: 0, queued: 0, saving: false, failed: 0, lastError: '', lastSync: '', legacy: 0 });
  const [mssAreas, setMssAreas] = useState([]);
  const [assets, setAssets] = useState([]);
  const [siteLinks, setSiteLinks] = useState({});
  const [zoneAreas, setZoneAreas] = useState({});
  const [zoneAreasSaved, setZoneAreasSaved] = useState(false);
  const [closures, setClosures] = useState({});
  const [refsLoaded, setRefsLoaded] = useState({ areas: false, assets: false, links: false, zones: false });
  const syncedRef = useRef({});
  // Rows saved under the v2.2 key (Sample ID + description, no test): stored row id -> the id of its v2.3 row
  const legacyRef = useRef({});
  // Every active stored row id (for Start over) and stored rows of the v2.0 example table (marked replaced on save)
  const storedIdsRef = useRef({});
  const exampleRef = useRef({});
  const missingRef = useRef({});
  const runningRef = useRef(false);
  // Columns the table really has: compared and sent only these, so a missing column never makes every row look changed
  const hashColsRef = useRef(SWAB_COLUMNS.slice());
  const rerunRef = useRef(false);

  const assetsById = useMemo(() => {
    const m = {};
    assets.forEach(a => { m[a.id] = a; });
    return m;
  }, [assets]);
  const areasByCanon = useMemo(() => {
    const m = {};
    mssAreas.forEach(a => { m[hubCanon(a.area)] = a; });
    return m;
  }, [mssAreas]);
  const linkCtx = useMemo(() => ({ siteLinks, zoneAreas, assetsById, areasByCanon, closures }), [siteLinks, zoneAreas, assetsById, areasByCanon, closures]);

  // 1. Reference lists (areas, equipment, site links, zone aliases)
  useEffect(() => {
    let alive = true;
    const run = async () => {
      try {
        let rows;
        try {
          rows = await fetchAllPages(apiUrl(`${MSS_AREA_SET}?$select=craa5_area,craa5_parentroom`));
        } catch (e) {
          rows = await fetchAllPages(apiUrl(`${MSS_AREA_SET}?$select=craa5_area`));
        }
        const list = rows.map(r => ({ area: String(r.craa5_area || '').trim(), room: String(r.craa5_parentroom || '').trim() })).filter(a => a.area);
        list.sort((a, b) => a.area.localeCompare(b.area));
        if (alive) setMssAreas(list);
        if (alive) setRefsLoaded(p => ({ ...p, areas: true }));
      } catch (e) {
        if (alive) logEvent(`MSS areas could not be read (${e.message}). Swab rows are not saved until they can.`, 'warn');
      }
      try {
        const rows = await fetchAllPages(apiUrl('craa5_aa_assetses?$select=craa5_aa_assetsid,craa5_equipmentidentifier,craa5_areaname,craa5_roomname,craa5_workareacode,craa5_uniqueid'));
        const list = rows.map(r => ({
          id: hubGuid(r.craa5_aa_assetsid),
          name: String(r.craa5_equipmentidentifier || '').trim(),
          area: String(r.craa5_areaname || '').trim(),
          room: String(r.craa5_roomname || '').trim(),
          sapw: String(r.craa5_workareacode || '').trim(),
          uid: r.craa5_uniqueid
        })).filter(a => a.id);
        list.sort((a, b) => (a.area + a.name).localeCompare(b.area + b.name));
        if (alive) setAssets(list);
        if (alive) setRefsLoaded(p => ({ ...p, assets: true }));
      } catch (e) {
        if (alive) logEvent(`Equipment list could not be read (${e.message}).`, 'warn');
      }
      try {
        const rows = await fetchAllPages(apiUrl(`${DATAVERSE_BOLO_SITES_TABLE}`));
        const map = {};
        rows.forEach(r => {
          const code = String(r.craa5_sitecode || r[`${DATAVERSE_BOLO_SITES_LOGICAL}1`] || '').trim().toUpperCase();
          if (!code) return;
          map[code] = {
            recId: r[`${DATAVERSE_BOLO_SITES_LOGICAL}id`],
            area: String(r.craa5_area || '').trim(),
            equipmentguid: hubGuid(r.craa5_equipmentguid || ''),
            sapw: String(r.craa5_sapw || '').trim()
          };
        });
        if (alive) setSiteLinks(map);
        if (alive) setRefsLoaded(p => ({ ...p, links: true }));
      } catch (e) {
        if (alive) setRefsLoaded(p => ({ ...p, links: true }));
        if (alive) logEvent(`Swab site links could not be read (${e.message}).`, 'warn');
      }
      try {
        const cfg = await boloReadConfigs();
        const raw = cfg.values[AREA_ALIAS_CONFIG_KEY];
        if (raw) {
          const parsed = JSON.parse(raw);
          if (alive && parsed && parsed.zones) { setZoneAreas(parsed.zones); setZoneAreasSaved(true); }
        }
      } catch (e) { /* no saved aliases yet */ }
      if (alive) setRefsLoaded(p => ({ ...p, zones: true }));
    };
    run();
    return () => { alive = false; };
  }, [logEvent]);

  // Until zone aliases are saved, a zone maps to an area only when the names are the same (hubSameName)
  const effectiveZoneAreas = useMemo(() => {
    if (zoneAreasSaved) return zoneAreas;
    const out = {};
    Object.keys(ROOM_META).forEach(zk => {
      const meta = ROOM_META[zk];
      const hit = mssAreas.find(a => hubSameName(a.area, zk) || hubSameName(a.area, meta.short) || hubSameName(a.area, meta.label));
      if (hit) out[zk] = hit.area;
    });
    return out;
  }, [zoneAreas, zoneAreasSaved, mssAreas]);
  const ctx = useMemo(() => ({ ...linkCtx, zoneAreas: effectiveZoneAreas }), [linkCtx, effectiveZoneAreas]);

  // 2. Find the table and load every stored swab row into the ledger
  useEffect(() => {
    let alive = true;
    const run = async () => {
      let found = null;
      for (let i = 0; i < SWAB_TABLE_CANDIDATES.length; i += 1) {
        try {
          const res = await fetch(apiUrl(`${SWAB_TABLE_CANDIDATES[i].set}?$top=1`), { headers: ODATA_HEADERS });
          if (res.ok) { found = SWAB_TABLE_CANDIDATES[i]; break; }
        } catch (e) { /* try the next name */ }
      }
      if (!found) {
        if (alive) setSwabDv(p => ({ ...p, status: 'missing' }));
        if (alive) logEvent('"_b_ Swab result" table not found: swab results stay on this computer only.', 'warn');
        return;
      }
      try {
        const recs = await fetchAllPages(apiUrl(`${found.set}?$filter=statecode eq 0`));
        if (recs.length > 0) hashColsRef.current = SWAB_COLUMNS.filter(k => Object.prototype.hasOwnProperty.call(recs[0], k));
        missingRef.current = {};
        SWAB_COLUMNS.forEach(k => { if (hashColsRef.current.indexOf(k) === -1) missingRef.current[k] = true; });
        const rulesCompiled = compileRegexSet(regexRules);
        const loaded = [];
        let replacedRows = 0;
        recs.forEach((rec, i) => {
          if (String(rec.craa5_result || '').toLowerCase() === 'replaced') { replacedRows += 1; return; }
          const rid = hubGuid(rec[found.id]);
          if (rid) storedIdsRef.current[rid] = true;
          if (rid && EXAMPLE_ROW_SIGS[exampleRowSig(rec.craa5_sampleid, rec.craa5_sampledescription)]) { exampleRef.current[rid] = true; return; }
          const row = swabRowFromRecord(rec, rulesCompiled, roomAliases, i);
          if (!row) return;
          const newId = swabRowId(row);
          if (newId !== rid) legacyRef.current[rid] = newId;
          else syncedRef.current[rid] = swabPayloadHash(rec, hashColsRef.current);
          loaded.push(row);
        });
        if (!alive) return;
        setHistoricalLedger(prev => {
          const byKey = {};
          loaded.forEach(r => { byKey[swabRowKey(r)] = r; });
          const withDv = prev.map(r => {
            const d = byKey[swabRowKey(r)];
            return d ? { ...r, dvArea: d.dvArea, dvRoom: d.dvRoom, dvSapw: d.dvSapw, dvEquipmentGuid: d.dvEquipmentGuid, dvClosedKey: d.dvClosedKey, dvClosedOn: d.dvClosedOn, dvSource: d.dvSource } : r;
          });
          return ingestRowsWithDeduplication(withDv, loaded, 'Dataverse _b_ Swab result').ledger;
        });
        setSwabDv(p => ({ ...p, status: 'ready', set: found.set, idCol: found.id, stored: recs.length - replacedRows, missingCols: Object.keys(missingRef.current), lastSync: new Date().toLocaleTimeString(), legacy: Object.keys(legacyRef.current).length }));
        logEvent(`Loaded ${(recs.length - replacedRows).toLocaleString()} swab results from Dataverse (${found.set}).`, 'success');
        if (Object.keys(exampleRef.current).length > 0) {
          logEvent(`${Object.keys(exampleRef.current).length} stored row(s) are the v2.0 example table, not real swabs: left out, and marked replaced on the next save.`, 'warn');
        }
      } catch (e) {
        if (alive) setSwabDv(p => ({ ...p, status: 'error', set: found.set, idCol: found.id, lastError: e.message }));
        if (alive) logEvent(`Swab results could not be read from Dataverse (${e.message}).`, 'error');
      }
    };
    run();
    return () => { alive = false; };
  }, []);

  const refsReady = refsLoaded.areas && refsLoaded.assets && refsLoaded.links && refsLoaded.zones;

  // 3. Save rows that are new or changed (only for people allowed to load data, and only once areas are known)
  const runSync = useCallback(async () => {
    if (swabDv.status !== 'ready' || !canWrite || !refsReady) return;
    if (runningRef.current) { rerunRef.current = true; return; }
    runningRef.current = true;
    try {
      const dirty = [];
      (ledgerRows || []).forEach(r => {
        // A row that held two tests is not saved: its result may belong to the other test
        if (!r || !r.date || r.needsReupload) return;
        const body = buildSwabPayload(r, ctx);
        const id = swabRowId(r);
        if (syncedRef.current[id] !== swabPayloadHash(body, hashColsRef.current)) dirty.push({ id, body });
      });
      setSwabDv(p => ({ ...p, queued: dirty.length, saving: dirty.length > 0, failed: 0 }));
      let failed = 0;
      let lastError = '';
      let done = 0;
      const worker = async () => {
        while (dirty.length > 0) {
          const job = dirty.shift();
          const send = { ...job.body };
          Object.keys(missingRef.current).forEach(k => { delete send[k]; });
          const res = await patchRowDroppingMissing(swabDv.set, job.id, send);
          res.missing.forEach(k => {
            missingRef.current[k] = true;
            hashColsRef.current = hashColsRef.current.filter(c => c !== k);
          });
          if (res.ok) {
            syncedRef.current[job.id] = swabPayloadHash(job.body, hashColsRef.current);
            storedIdsRef.current[job.id] = true;
            done += 1;
          } else {
            failed += 1;
            lastError = res.error;
          }
          if ((done + failed) % 25 === 0) setSwabDv(p => ({ ...p, queued: dirty.length }));
        }
      };
      await Promise.all([worker(), worker(), worker(), worker()]);
      // v2.2 rows whose v2.3 row is now saved: marked replaced (and made inactive when allowed), so readers that ask for
      // craa5_result eq 'positive' never count one swab twice. Nothing is deleted.
      const oldIds = Object.keys(legacyRef.current).filter(oldId => syncedRef.current[legacyRef.current[oldId]]);
      let replaced = 0;
      for (let i = 0; i < oldIds.length; i += 1) {
        const oldId = oldIds[i];
        const res = await patchRowDroppingMissing(swabDv.set, oldId, { craa5_result: 'replaced', craa5_source: `Replaced by ${legacyRef.current[oldId]}` });
        if (!res.ok) continue;
        try {
          await fetch(apiUrl(`${swabDv.set}(${oldId})`), {
            method: 'PATCH',
            headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
            body: JSON.stringify({ statecode: 1, statuscode: 2 })
          });
        } catch (e) { /* the result text already keeps it out of the positive list */ }
        delete legacyRef.current[oldId];
        delete storedIdsRef.current[oldId];
        replaced += 1;
      }
      if (replaced > 0) logEvent(`${replaced} swab row(s) saved under the old key (no test) marked replaced in Dataverse.`, 'info');
      const exampleIds = Object.keys(exampleRef.current);
      let examplesDone = 0;
      for (let i = 0; i < exampleIds.length; i += 1) {
        const res = await patchRowDroppingMissing(swabDv.set, exampleIds[i], { craa5_result: 'replaced', craa5_source: 'Example row from v2.0, not a real swab' });
        if (!res.ok) continue;
        delete exampleRef.current[exampleIds[i]];
        delete storedIdsRef.current[exampleIds[i]];
        examplesDone += 1;
      }
      if (examplesDone > 0) logEvent(`${examplesDone} example row(s) from v2.0 marked replaced in Dataverse.`, 'info');
      setSwabDv(p => ({
        ...p,
        queued: 0,
        saving: false,
        failed,
        lastError: failed > 0 ? lastError : '',
        stored: Object.keys(storedIdsRef.current).length,
        missingCols: Object.keys(missingRef.current),
        lastSync: new Date().toLocaleTimeString(),
        legacy: Object.keys(legacyRef.current).length
      }));
      if (done > 0) logEvent(`Saved ${done.toLocaleString()} swab result(s) to Dataverse.`, 'success');
      if (failed > 0) logEvent(`${failed} swab result(s) not saved (${lastError}). They are retried on the next change or with Retry.`, 'error');
    } finally {
      runningRef.current = false;
      if (rerunRef.current) { rerunRef.current = false; window.setTimeout(() => { runSyncRef.current(); }, 500); }
    }
  }, [swabDv.status, swabDv.set, canWrite, refsReady, ledgerRows, ctx, logEvent]);
  const runSyncRef = useRef(runSync);
  useEffect(() => { runSyncRef.current = runSync; }, [runSync]);
  useEffect(() => {
    const t = window.setTimeout(() => { runSync(); }, 1500);
    return () => window.clearTimeout(t);
  }, [runSync]);

  // 4. Closures: MSS log rows with craa5_pathogen = Yes on or after the earliest open positive
  useEffect(() => {
    if (!refsReady) return undefined;
    let alive = true;
    const open = (ledgerRows || []).filter(r => r && r.result === 'Positive' && r.date && !r.dvClosedKey);
    if (open.length === 0) return undefined;
    const minDay = open.reduce((m, r) => (r.date < m ? r.date : m), open[0].date);
    const run = async () => {
      const base = `${MSS_LOG_SET}?$filter=craa5_pathogen eq 'Yes' and craa5_lastcleaned ge ${minDay}T00:00:00Z&$select=`;
      let recs;
      try {
        recs = await fetchAllPages(apiUrl(base + 'craa5__log_id,craa5_equipmentguid,craa5_area,craa5_lastcleaned,craa5_shiftdate,craa5_cleankind,craa5_completionkey'), 20000);
      } catch (e) {
        try {
          recs = await fetchAllPages(apiUrl(base + 'craa5__log_id,craa5_equipmentguid,craa5_area,craa5_lastcleaned'), 20000);
        } catch (e2) {
          return;
        }
      }
      const logs = recs
        .filter(l => !l.craa5_cleankind || String(l.craa5_cleankind).toLowerCase() === 'corrective')
        .map(l => ({
          key: l.craa5_completionkey || `log|${hubGuid(l.craa5__log_id)}`,
          day: l.craa5_shiftdate || hubDayFromDateOnly(l.craa5_lastcleaned),
          equipmentguid: hubGuid(l.craa5_equipmentguid || ''),
          area: l.craa5_area || ''
        }));
      if (alive) setClosures(findSwabClosures(open, logs, ctx));
    };
    run();
    return () => { alive = false; };
  // Re-check when the number of positives changes or links change, not on every ledger edit
  }, [refsReady, (ledgerRows || []).length, siteLinks, effectiveZoneAreas]);

  const saveSiteLink = useCallback(async (siteCode, link) => {
    const code = String(siteCode || '').toUpperCase();
    const equipmentguid = hubGuid(link.equipmentguid || '');
    const asset = equipmentguid ? assetsById[equipmentguid] : null;
    const next = { area: link.area || '', equipmentguid, sapw: (asset && asset.sapw) || '' };
    const existing = siteLinks[code] || {};
    const recId = existing.recId || hubIdFromKey(`site|${code}`);
    const body = {
      [`${DATAVERSE_BOLO_SITES_LOGICAL}1`]: code,
      craa5_sitecode: code,
      craa5_area: next.area,
      craa5_equipmentguid: next.equipmentguid,
      craa5_sapw: next.sapw
    };
    const res = await patchRowDroppingMissing(DATAVERSE_BOLO_SITES_TABLE, recId, body);
    if (!res.ok) throw new Error(res.error);
    if (res.missing.length > 0) {
      logEvent(`Swab site table is missing column(s): ${res.missing.join(', ')}. Add them (see table prompts) so the link is kept.`, 'warn');
    }
    setSiteLinks(p => ({ ...p, [code]: { ...next, recId } }));
    return res;
  }, [siteLinks, assetsById, logEvent]);

  const saveZoneAreas = useCallback(async (zones, upsertHubConfigKey) => {
    await upsertHubConfigKey(AREA_ALIAS_CONFIG_KEY, { zones, savedAt: new Date().toISOString() });
    setZoneAreas(zones);
    setZoneAreasSaved(true);
  }, []);

  // Import check "Start over": every stored swab row is marked replaced (nothing is deleted), so no reader counts it.
  // The lab files loaded next save their rows again under the same row ids, which brings each real row back with the
  // file's reading; a stored row that no file has (a misread row from an older version) stays out.
  const retireStoredRows = useCallback(async () => {
    if (swabDv.status !== 'ready' || !canWrite) return { ok: false, retired: 0, failed: 0 };
    const queue = Object.keys(storedIdsRef.current);
    const stamp = LIVE_TODAY_DATE_KEY;
    let retired = 0;
    let failed = 0;
    let lastError = '';
    setSwabDv(p => ({ ...p, saving: true, queued: queue.length }));
    const worker = async () => {
      while (queue.length > 0) {
        const id = queue.shift();
        const res = await patchRowDroppingMissing(swabDv.set, id, { craa5_result: 'replaced', craa5_source: `Start over ${stamp}: waiting for the lab file` });
        if (res.ok) {
          retired += 1;
          delete storedIdsRef.current[id];
          delete syncedRef.current[id];
        } else {
          failed += 1;
          lastError = res.error;
        }
        if ((retired + failed) % 25 === 0) setSwabDv(p => ({ ...p, queued: queue.length }));
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
    legacyRef.current = {};
    exampleRef.current = {};
    setSwabDv(p => ({ ...p, saving: false, queued: 0, stored: Object.keys(storedIdsRef.current).length, legacy: 0, failed, lastError: failed > 0 ? lastError : '', lastSync: new Date().toLocaleTimeString() }));
    logEvent(`Start over: ${retired.toLocaleString()} swab row(s) in Dataverse marked replaced${failed > 0 ? `, ${failed} not changed (${lastError})` : ''}. Upload the lab files to save them again.`, failed > 0 ? 'error' : 'warn');
    return { ok: failed === 0, retired, failed };
  }, [swabDv.status, swabDv.set, canWrite, logEvent]);

  // Last MSS log rows for a piece (or an area when the hit has no piece)
  const fetchLogHistory = useCallback(async (equipmentguid, area) => {
    const g = hubGuid(equipmentguid);
    const filter = g
      ? `craa5_equipmentguid eq '${g}'`
      : `craa5_area eq '${String(area || '').replace(/'/g, "''")}'`;
    const res = await fetch(apiUrl(`${MSS_LOG_SET}?$select=craa5__log_id,craa5_lastcleaned,craa5_lastcleanedby,craa5_equipment,craa5_area,craa5_pathogen,craa5_sap&$filter=${filter}&$orderby=craa5_lastcleaned desc&$top=8`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    const data = await res.json();
    return (data.value || []).map(l => ({
      id: l.craa5__log_id,
      day: hubDayFromDateOnly(l.craa5_lastcleaned),
      by: l.craa5_lastcleanedby || '',
      equipment: l.craa5_equipment || '',
      area: l.craa5_area || '',
      pathogen: l.craa5_pathogen || '',
      sap: l.craa5_sap || ''
    }));
  }, []);

  return {
    swabDv,
    mssAreas,
    assets,
    assetsById,
    siteLinks,
    zoneAreas: effectiveZoneAreas,
    zoneAreasSaved,
    closures,
    linkCtx: ctx,
    refsReady,
    retrySync: runSync,
    retireStoredRows,
    saveSiteLink,
    saveZoneAreas,
    fetchLogHistory
  };
}

