  }, [zoneAreas, zoneAreasSaved, mssAreas]);
  const ctx = useMemo(() => ({ ...linkCtx, zoneAreas: effectiveZoneAreas }), [linkCtx, effectiveZoneAreas]);

  // 2. Find the table and load every stored swab row into the ledger. The table is the shared record: every open reads
  // it, and its rows join what this computer already holds (rows match on Sample ID + description + test, so nothing is
  // counted twice). While a re-upload is in progress (reuploadRef) the table rows stay out of the ledger, so the Table
  // check can show which of them the lab files bring back.
  const tableRef = useRef(null);
  const loadingRef = useRef(false);
  const reuploadRef = useRef(null);
  const [reupload, setReupload] = useState(null);
  const loadTable = useCallback(async (why) => {
    if (loadingRef.current) return false;
    loadingRef.current = true;
    try {
      const known = tableRef.current;
      const names = known ? [known] : SWAB_TABLE_CANDIDATES;
      let found = null;
