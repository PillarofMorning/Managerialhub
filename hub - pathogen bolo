              </div>

              {/* Create New Set Area Drawer */}
              {showNewAreaForm && (
                <div className={`p-2.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                  <div className="text-[10px] font-black uppercase text-[#0072CE]">Create New Facility Set Area</div>
                  <div className="grid grid-cols-2 gap-1.5">
                    <input
                      type="text"
                      value={newAreaDraft.label}
                      onChange={e => setNewAreaDraft(prev => ({ ...prev, label: e.target.value }))}
                      placeholder="Area Name (e.g. WJ2 Slicer Bay)"
                      className={`rounded border px-2 py-1 text-xs font-bold ${theme.bgInput}`}
                    />
                    <input
                      type="text"
                      value={newAreaDraft.short}
                      onChange={e => setNewAreaDraft(prev => ({ ...prev, short: e.target.value }))}
                      placeholder="Short Tag (e.g. WJ2-BAY)"
                      className={`rounded border px-2 py-1 text-xs font-mono font-bold ${theme.bgInput}`}
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-1.5">
                    <select
                      value={newAreaDraft.roomKey}
                      onChange={e => setNewAreaDraft(prev => ({ ...prev, roomKey: e.target.value }))}
                      className={`rounded border px-2 py-1 text-xs font-bold ${theme.bgInput}`}
