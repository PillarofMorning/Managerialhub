          if (alive && siteRows.length > 0) {
            logEvent(`Connected to live Swab Catalog table ${DATAVERSE_BOLO_SITES_TABLE} (${siteRows.length} row(s)).`, 'success');
          }
        }
      } catch (e) { /* standalone */ }
    };
    initDataverse();
    return () => { alive = false; };
  }, [logEvent]);

  // Data contract 12.1: save this build's table list (Hub config row manifest|bolo) once per page load. It is written
  // only when it changed, never blocks the app and never shows an error on screen (the event log has the outcome).
  useEffect(() => {
