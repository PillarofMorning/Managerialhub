        <div className="p-4 overflow-y-auto space-y-3 flex-1">
          {list.length === 0 && emails.length === 0 && (
            <div className={`text-sm ${theme.textMuted}`}>{tr('No swab results loaded for this day.', 'No hay resultados de hisopos cargados para este dia.')}</div>
          )}
          {roomKeys.map(rk => {
            const rs = byRoom[rk].slice().sort((a, b) => (rowOrder(a) - rowOrder(b)) || String(a.siteCode || '').localeCompare(String(b.siteCode || '')));
            const p = posOf(rk);
            const l = labOf(rk);
            return (
              <div key={rk} className={`rounded-xl border ${theme.bgSubtle}`} data-day-room={rk}>
                <div className={`px-3 py-1.5 border-b flex flex-wrap items-center justify-between gap-2 text-xs ${theme.border}`}>
                  <span className="font-black">{(ROOM_META[rk] && ROOM_META[rk].label) || rk}</span>
                  <span className={theme.textMuted}>
                    {tr(`${rs.length} swab${rs.length === 1 ? '' : 's'}`, `${rs.length} hisopo${rs.length === 1 ? '' : 's'}`)}
                    {p > 0 ? tr(`, ${p} positive`, `, ${p} positivo(s)`) : ''}
                    {l > 0 ? tr(`, ${l} at the lab`, `, ${l} en el laboratorio`) : ''}
                  </span>
                </div>
                <div className="divide-y divide-slate-500/15">
                  {rs.map(r => {
                    const hitId = hitIdOfRow(r);
                    const st = r.result === 'Positive' && stateByKey ? stateByKey[swabRowKey(r)] : null;
                    return (
                      <div key={r.id || swabRowKey(r)} className="px-3 py-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px]" data-day-row={rowToneOf(r)}>
                        <ResultChip r={r} darkMode={darkMode} />
                        <TestBadge testType={hitTestTypeOf(r)} label={rowTestLabel(r)} darkMode={darkMode} />
                        {st && <OpenStateChip item={st} darkMode={darkMode} />}
                        {repeatHitIds && repeatHitIds[hitId] && <ToneChip tone="act" darkMode={darkMode}>{tr('Repeat', 'Repetido')}</ToneChip>}
                        {newSince && newSince[hitId] && <ToneChip tone="plain" darkMode={darkMode}>{tr('New', 'Nuevo')}</ToneChip>}
                        <span className="font-mono font-bold">{r.siteCode || r.sampleId || '-'}</span>
                        <span className="min-w-0 flex-1 truncate" title={`${r.surface || ''} - ${r.description || ''}`}>{r.surface} - {r.description}</span>
                        {r.siteCode && typeof onOpenSite === 'function' && (
                          <button type="button" className={btn} onClick={() => onOpenSite(r.siteCode)}>{tr('Site', 'Sitio')}</button>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
          {emails.length > 0 && (
            <div className={`rounded-xl border ${theme.bgSubtle}`} data-day-email="1">
              <div className={`px-3 py-1.5 border-b text-xs font-black ${theme.border}`}>
                {tr('In the QA email, no lab row loaded yet', 'En el correo de QA, aun sin fila del laboratorio')}
              </div>
              <div className="divide-y divide-slate-500/15">
                {emails.map(h => (
                  <div key={h.id} className="px-3 py-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px]">
                    <ToneChip tone="unknown" darkMode={darkMode}>{tr('Email only', 'Solo correo')}</ToneChip>
                    <TestBadge testType={h.testType} darkMode={darkMode} />
                    <span className="font-mono font-bold">{h.siteCode || '-'}</span>
                    <span className="min-w-0 flex-1 truncate"><b>{roomShortOf(h.room)}</b>: {h.surface} - {h.description}</span>
                    {h.siteCode && typeof onOpenSite === 'function' && (
                      <button type="button" className={btn} onClick={() => onOpenSite(h.siteCode)}>{tr('Site', 'Sitio')}</button>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

