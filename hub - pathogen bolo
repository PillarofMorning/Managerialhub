  const isUserPrefFilterActive = !!(userPrefRooms || userPrefTests) && (!bypassUserPrefFilter || activeUserProfile.enforceAdminLock);

  const filteredHits = useMemo(() => {
    const q = globalSearch.trim().toLowerCase();
    return allHits.filter(h => {
      if (isUserPrefFilterActive) {
        if (userPrefRooms && userPrefRooms.indexOf(h.room) === -1) return false;
        if (userPrefTests && userPrefTests.indexOf(h.testType) === -1) return false;
      }
      if (selectedRoomFilter !== 'ALL' && h.room !== selectedRoomFilter) return false;
      if (selectedTestFilter !== 'ALL' && h.testType !== selectedTestFilter) return false;
      if (!q) return true;
      const hay = `${h.room} ${h.subArea} ${h.surface} ${h.description} ${h.siteCode} ${h.assetTag} ${h.stage} ${h.testType} ${h.date}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [allHits, isUserPrefFilterActive, userPrefRooms, userPrefTests, selectedRoomFilter, selectedTestFilter, globalSearch]);

  // --- REPEAT-OFFENDER / BOLO STREAK DETECTOR ---
  const repeatStreaks = useMemo(() => {
    const groups = {};
    allHits.forEach(h => {
      // Focus recent window or same-month streaks so multi-year random hits don't merge falsely as a single weekly streak
      const monthBucket = (h.date || '').slice(0, 7);
      const key = `${monthBucket}::${h.siteCode || `${h.room}::${h.surface}::${h.description}`}`;
      if (!groups[key]) {
        groups[key] = {
          key,
          siteCode: h.siteCode,
          room: h.room,
          surface: h.surface,
          description: h.description,
          assetTag: h.assetTag,
          spot: h.spot,
          hits: []
        };
      }
      groups[key].hits.push(h);
    });
    const list = Object.keys(groups).map(k => {
      const g = groups[k];
      g.hits.sort((a, b) => String(a.date).localeCompare(String(b.date)));
      const uniqueDates = [];
      g.hits.forEach(x => { if (uniqueDates.indexOf(x.date) === -1) uniqueDates.push(x.date); });
      return {
        ...g,
        count: g.hits.length,
        uniqueDays: uniqueDates.length,
        dates: uniqueDates,
        firstDate: uniqueDates[0] || '',
        lastDate: uniqueDates[uniqueDates.length - 1] || ''
      };
    });
    return list.filter(g => g.count >= 2).sort((a, b) => b.count - a.count);
  }, [allHits]);

