function buildInitialSiteCatalog(rawCatalog, aliases) {
  const roomCounts = {};
  const roomTotals = {};
  rawCatalog.forEach(item => {
    const r = aliases[item[1]] || 'Zone 4 / Mobile';
    roomTotals[r] = (roomTotals[r] || 0) + 1;
  });
  return rawCatalog.map((item) => {
    const [siteCode, areaCode, surface, description, assetTag] = item;
    let canonicalRoom = aliases[areaCode] || 'Zone 4 / Mobile';
    if (areaCode === 'DRAIN') {
      if (/IBL5|CRUMB MIXER TO INCLINE BELT/i.test(description + ' ' + assetTag)) canonicalRoom = 'IBL5';
      else if (/MIXER 3|DRDRAIN/i.test(description + ' ' + assetTag)) canonicalRoom = 'Dough Room';
      else if (/0411|0413|LIQUIFIER|TOTE DUMP/i.test(description + ' ' + assetTag)) canonicalRoom = 'IBL4';
    }
    const meta = ROOM_META[canonicalRoom] || ROOM_META['Zone 4 / Mobile'];
    const idx = roomCounts[canonicalRoom] || 0;
    roomCounts[canonicalRoom] = idx + 1;
    const total = Math.max(1, roomTotals[canonicalRoom] || 1);
    const cols = Math.max(2, Math.ceil(Math.sqrt(total * (meta.defaultBox[2] / Math.max(1, meta.defaultBox[3])))));
    const rows = Math.max(2, Math.ceil(total / cols));
    const col = idx % cols;
    const row = Math.floor(idx / cols);
    const padX = Math.min(3, meta.defaultBox[2] * 0.12);
    const padY = Math.min(3, meta.defaultBox[3] * 0.18);
    const usableW = Math.max(2, meta.defaultBox[2] - padX * 2);
    const usableH = Math.max(2, meta.defaultBox[3] - padY * 2);
    const defaultX = Math.round((meta.defaultBox[0] + padX + ((col + 0.5) / cols) * usableW) * 100) / 100;
    const defaultY = Math.round((meta.defaultBox[1] + padY + ((row + 0.5) / rows) * usableH) * 100) / 100;
    return {
      siteCode,
      areaCode,
      room: canonicalRoom,
      surface: (surface || '').trim(),
      description: (description || '').trim(),
      assetTag: (assetTag || '').trim(),
      defaultSpot: {
        x: defaultX,
        y: defaultY,
        box: [Math.max(0, defaultX - 1.4), Math.max(0, defaultY - 1.4), 2.8, 2.8],
        snapped: false,
        how: 'auto',
        map: 'MAIN'
      }
    };
  });
}

