                        className={`w-full rounded-xl border p-3 font-mono text-xs ${theme.bgInput}`}
                      />
                      <div className="flex flex-wrap items-center justify-end gap-2 pt-1">
                        <button
                          type="button"
                          onClick={() => {
                            try {
                              const parsed = JSON.parse(rawUserJsonText);
                              handleAdminUpdateUserRecord(selectedUserRecord.microsoftId, u => ({
                                ...u,
                                viewPreferences: parsed
