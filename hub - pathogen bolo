  const stageFraction = (clientX, clientY) => {
    const r = stageRef.current.getBoundingClientRect();
    const w = r.width || 1;
    const h = r.height || 1;
    return [clamp01((clientX - r.left) / w), clamp01((clientY - r.top) / h)];
  };
  const toPicture = (u, v) => {
    const s = stageRef.current;
    const aspect = (s && s.offsetWidth && s.offsetHeight) ? (s.offsetWidth / s.offsetHeight) : 1.6;
    const p = unturnPoint(rotation, u, v, aspect);
    return [clampPct(p[0] * 100), clampPct(p[1] * 100)];
  };

