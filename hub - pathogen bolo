                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr className={`text-[10px] font-black uppercase tracking-wider border-b ${theme.bgSubtle}`}>
