// --- DYNAMIC FACILITY ARCHITECT SET AREAS & MAGNETIC SNAP-TO-SET-AREAS ENGINE ---
function getPtXY(pt) {
  if (!pt) return [0, 0];
  if (Array.isArray(pt)) return [Number(pt[0]) || 0, Number(pt[1]) || 0];
  return [Number(pt.x) || 0, Number(pt.y) || 0];
}

function makeDualPoint(x, y) {
  const rx = Math.round((Number(x) || 0) * 100) / 100;
  const ry = Math.round((Number(y) || 0) * 100) / 100;
  const arr = [rx, ry];
  arr.x = rx;
  arr.y = ry;
  return arr;
}

function boxToPolygonPoints(box) {
  const [x, y, w, h] = Array.isArray(box) && box.length >= 4 ? box : [10, 10, 20, 20];
  return [
    makeDualPoint(x, y),
    makeDualPoint(x + w, y),
    makeDualPoint(x + w, y + h),
    makeDualPoint(x, y + h)
  ];
}

function computePolygonBoundingBox(points) {
  if (!Array.isArray(points) || points.length === 0) return [10, 10, 15, 15];
  let minX = 100;
  let minY = 100;
  let maxX = 0;
  let maxY = 0;
  for (let i = 0; i < points.length; i += 1) {
    const [px, py] = getPtXY(points[i]);
    if (px < minX) minX = px;
    if (py < minY) minY = py;
    if (px > maxX) maxX = px;
    if (py > maxY) maxY = py;
  }
  const w = Math.max(1.5, Math.round((maxX - minX) * 100) / 100);
  const h = Math.max(1.5, Math.round((maxY - minY) * 100) / 100);
  return [Math.round(minX * 100) / 100, Math.round(minY * 100) / 100, w, h];
}

function simplifyFreehandPoints(rawPoints, minStepPct = 0.75) {
  if (!Array.isArray(rawPoints) || rawPoints.length <= 3) {
    return (rawPoints || []).map(p => {
      const [px, py] = getPtXY(p);
      return makeDualPoint(px, py);
    });
  }
  const [fx, fy] = getPtXY(rawPoints[0]);
  const simplified = [makeDualPoint(fx, fy)];
  for (let i = 1; i < rawPoints.length; i += 1) {
    const [prevX, prevY] = getPtXY(simplified[simplified.length - 1]);
    const [curX, curY] = getPtXY(rawPoints[i]);
    const dist = Math.hypot(curX - prevX, curY - prevY);
    if (dist >= minStepPct || i === rawPoints.length - 1) {
      simplified.push(makeDualPoint(curX, curY));
    }
  }
  return simplified;
}

function normalizeFacilityAreaEntry(raw, fallbackId = 'WJ') {
  if (!raw || typeof raw !== 'object') return null;
  const id = String(raw.id || raw.key || raw.roomKey || fallbackId);
  if (id === 'OLD-MIX-BAY' || id === 'OLD-SOUTH-PACK') return null;
  const roomKey = String(raw.roomKey || (ROOM_META[id] ? id : 'WJ'));
  const rm = ROOM_META[roomKey] || ROOM_META.WJ;
  const updatedByTag = String(raw.updatedBy || raw.updatedByMsId || '');
  const isUnconfiguredDefault = updatedByTag === 'SYSTEM_DEFAULT' || updatedByTag === 'UNCONFIGURED';
  const hasDrawnBoundary = Boolean(
    raw.hasDrawnBoundary ||
    (!isUnconfiguredDefault && updatedByTag && (
      (Array.isArray(raw.points) && raw.points.length >= 3) ||
      (Array.isArray(raw.box) && raw.box.length >= 4)
    ))
  );
  const box = hasDrawnBoundary && Array.isArray(raw.box) && raw.box.length >= 4
    ? raw.box.map(n => Math.round((Number(n) || 0) * 100) / 100)
    : null;
  const rawPts = hasDrawnBoundary && Array.isArray(raw.points) && raw.points.length >= 3
    ? raw.points.map(p => {
        const [px, py] = getPtXY(p);
        return makeDualPoint(px, py);
      })
    : (box ? boxToPolygonPoints(box) : []);
  const isLegacy = !!raw.isLegacy;
  const hidden = !!(raw.hidden || raw.isRemoved);
  return {
    ...raw,
    id,
    key: id,
    roomKey,
    label: raw.label || rm.label || id,
    short: raw.short || rm.short || id,
    dept: raw.dept || rm.dept || 'Facility',
    color: raw.color || rm.color || '#0072CE',
    bgLight: raw.bgLight || rm.bgLight || '#E0F2FE',
    bgDark: raw.bgDark || rm.bgDark || '#0C4A6E',
    border: raw.border || rm.border || '#00468B',
    shapeType: raw.shapeType || 'freeform_poly',
    hasDrawnBoundary,
    box,
    points: rawPts,
    isLegacy,
    hidden,
    isRemoved: hidden,
    updatedBy: hasDrawnBoundary ? (updatedByTag || '') : 'UNCONFIGURED',
    updatedByMsId: hasDrawnBoundary ? (raw.updatedByMsId || updatedByTag || '') : 'UNCONFIGURED',
    updatedAt: raw.updatedAt || '2026-10-01'
  };
}

function buildDefaultFacilityAreas() {
  const list = [];
  Object.keys(ROOM_META).forEach(rKey => {
    const m = ROOM_META[rKey];
    const entry = normalizeFacilityAreaEntry({
      id: rKey,
      key: rKey,
      roomKey: rKey,
      label: m.label,
      short: m.short,
      dept: m.dept,
      color: m.color,
      bgLight: m.bgLight,
      bgDark: m.bgDark,
      border: m.border,
      shapeType: 'freeform_poly',
      hasDrawnBoundary: false,
      box: null,
      points: [],
      isLegacy: false,
      hidden: false,
      isRemoved: false,
      zoneDefault: rKey === 'Drains' || rKey === 'Zone 4 / Mobile' ? 'Zone 4' : 'Zone 2 / 3',
      updatedBy: 'UNCONFIGURED',
      updatedByMsId: 'UNCONFIGURED',
      updatedAt: '2026-10-01'
    }, rKey);
    if (entry) list.push(entry);
  });
  return list;
}

function normalizeFacilityAreasList(input) {
  if (Array.isArray(input) && input.length > 0) {
    const cleaned = input.map((item, idx) => normalizeFacilityAreaEntry(item, `AREA-${idx + 1}`)).filter(Boolean);
    if (cleaned.length > 0) return cleaned;
  }
  if (input && typeof input === 'object' && Object.keys(input).length > 0) {
    const cleaned = Object.keys(input).map(k => normalizeFacilityAreaEntry(input[k], k)).filter(Boolean);
    if (cleaned.length > 0) return cleaned;
  }
  return buildDefaultFacilityAreas();
}

function getFacilityAreaByRoom(facilityAreasInput, roomKey) {
  if (!roomKey) return null;
  const list = normalizeFacilityAreasList(facilityAreasInput);
  return list.find(a => (a.id === roomKey || a.key === roomKey || a.roomKey === roomKey) && !a.hidden && !a.isRemoved) || null;
}

// Magnetic Snap-to-Set-Areas Engine: Snaps free-form polygon vertices, lasso endpoints, or box edges to existing Set Area corners & walls!
function snapPointToSetAreas(rawX, rawY, facilityAreasInput, options = {}) {
  const tolerance = typeof options.snapThreshold === 'number'
    ? options.snapThreshold
    : (typeof options.tolerance === 'number' ? options.tolerance : 1.8);
  const gridStep = options.snapToGrid
    ? (typeof options.gridSize === 'number' ? options.gridSize : 0.5)
    : (typeof options.gridStep === 'number' ? options.gridStep : 0);
  const excludeKey = options.excludeAreaId || options.excludeKey || null;
  const includeLegacy = options.includeLegacy !== undefined ? options.includeLegacy : !options.hideLegacy;
  const snapEnabled = options.snapToAreas !== false;

  const areasList = normalizeFacilityAreasList(facilityAreasInput);

  let x = Math.max(0, Math.min(100, Number(rawX) || 0));
  let y = Math.max(0, Math.min(100, Number(rawY) || 0));
  let guideX = null;
  let guideY = null;
  let snappedVertex = null;
  const snapNotes = [];
  const guides = [];

  if (snapEnabled && areasList.length > 0) {
    let bestVertexDist = tolerance * 1.25;

    // 1. Check direct corner/vertex magnetic snap first (only against actually drawn areas)
    for (let i = 0; i < areasList.length; i += 1) {
      const area = areasList[i];
      if (!area || area.hidden || area.isRemoved || !area.hasDrawnBoundary || !area.box) continue;
      if (area.id === excludeKey || area.key === excludeKey) continue;
      if (!includeLegacy && area.isLegacy) continue;
      const pts = Array.isArray(area.points) && area.points.length > 0
        ? area.points
        : boxToPolygonPoints(area.box);

      for (let j = 0; j < pts.length; j += 1) {
        const [vx, vy] = getPtXY(pts[j]);
        const d = Math.hypot(x - vx, y - vy);
        if (d <= bestVertexDist) {
          bestVertexDist = d;
          snappedVertex = { x: vx, y: vy, areaKey: area.id, label: `${area.short || area.id} Corner (${vx}%, ${vy}%)` };
        }
      }
    }

    if (snappedVertex) {
      x = snappedVertex.x;
      y = snappedVertex.y;
      guideX = { x: snappedVertex.x, label: snappedVertex.label };
      guideY = { y: snappedVertex.y, label: snappedVertex.label };
      guides.push({ x1: snappedVertex.x, y1: 0, x2: snappedVertex.x, y2: 100, label: snappedVertex.label });
      guides.push({ x1: 0, y1: snappedVertex.y, x2: 100, y2: snappedVertex.y, label: snappedVertex.label });
      snapNotes.push(`Snapped to ${snappedVertex.label}`);
    } else {
      // 2. Check vertical (X) and horizontal (Y) wall/edge alignments across all active drawn areas
      let bestDx = tolerance;
      let bestDy = tolerance;
      for (let i = 0; i < areasList.length; i += 1) {
        const area = areasList[i];
        if (!area || area.hidden || area.isRemoved || !area.hasDrawnBoundary || !area.box) continue;
        if (area.id === excludeKey || area.key === excludeKey) continue;
        if (!includeLegacy && area.isLegacy) continue;
        const box = area.box;
        const xEdges = [
          { val: box[0], tag: `${area.short || area.id} West Wall` },
          { val: Math.round((box[0] + box[2]) * 100) / 100, tag: `${area.short || area.id} East Wall` }
        ];
        const yEdges = [
          { val: box[1], tag: `${area.short || area.id} North Wall` },
          { val: Math.round((box[1] + box[3]) * 100) / 100, tag: `${area.short || area.id} South Wall` }
        ];
        if (Array.isArray(area.points)) {
          area.points.forEach((pt, idx) => {
            const [px, py] = getPtXY(pt);
            xEdges.push({ val: px, tag: `${area.short || area.id} V${idx + 1}-X` });
            yEdges.push({ val: py, tag: `${area.short || area.id} V${idx + 1}-Y` });
          });
        }
        for (let xi = 0; xi < xEdges.length; xi += 1) {
          const dx = Math.abs(x - xEdges[xi].val);
          if (dx <= bestDx) {
            bestDx = dx;
            x = xEdges[xi].val;
            guideX = { x: xEdges[xi].val, label: xEdges[xi].tag };
          }
        }
        for (let yi = 0; yi < yEdges.length; yi += 1) {
          const dy = Math.abs(y - yEdges[yi].val);
          if (dy <= bestDy) {
            bestDy = dy;
            y = yEdges[yi].val;
            guideY = { y: yEdges[yi].val, label: yEdges[yi].tag };
          }
        }
      }
      if (guideX) {
        snapNotes.push(guideX.label);
        guides.push({ x1: guideX.x, y1: 0, x2: guideX.x, y2: 100, label: guideX.label });
      }
      if (guideY) {
        snapNotes.push(guideY.label);
        guides.push({ x1: 0, y1: guideY.y, x2: 100, y2: guideY.y, label: guideY.label });
      }
    }
  }

  // 3. Optional Grid Snap for any axis not already snapped to a Set Area edge
  if (gridStep > 0) {
    if (!guideX) x = Math.round(x / gridStep) * gridStep;
    if (!guideY) y = Math.round(y / gridStep) * gridStep;
  }

  const isSnapped = !!(snappedVertex || guideX || guideY);
  return {
    x: Math.round(x * 100) / 100,
    y: Math.round(y * 100) / 100,
    snapped: isSnapped,
    snappedToArea: isSnapped,
    snapType: isSnapped ? 'set_area' : (gridStep > 0 ? 'grid' : 'none'),
    snapNote: snapNotes.length > 0 ? `Snapped: ${snapNotes.join(' + ')}` : (gridStep > 0 ? `Grid ${gridStep}%` : 'Free-form'),
    guides,
    guideX,
    guideY,
    vertex: snappedVertex
  };
}

function snapRectToSetAreas(rect, facilityAreasInput, options = {}) {
  const p1 = snapPointToSetAreas(rect[0], rect[1], facilityAreasInput, options);
  const p2 = snapPointToSetAreas(rect[2], rect[3], facilityAreasInput, options);
  const x1 = Math.min(p1.x, p2.x);
  const y1 = Math.min(p1.y, p2.y);
  const x2 = Math.max(p1.x, p2.x);
  const y2 = Math.max(p1.y, p2.y);
  const notes = [];
  if (p1.snapped) notes.push(p1.snapNote);
  if (p2.snapped && p2.snapNote !== p1.snapNote) notes.push(p2.snapNote);
  return {
    rect: [x1, y1, x2, y2],
    box: [x1, y1, Math.max(1.5, Math.round((x2 - x1) * 100) / 100), Math.max(1.5, Math.round((y2 - y1) * 100) / 100)],
    snapped: p1.snapped || p2.snapped,
    snappedToArea: p1.snapped || p2.snapped,
    notes,
    snapNote: notes.length > 0 ? notes.join(' & ') : 'Free-form Box'
  };
}

