function MicrosoftIdGateModal({
  darkMode,
  theme,
  msIdentity,
  isAdminVerified,
  pendingSensitiveTab,
  onVerifySuccess,
  onLockSession,
  onClose
}) {
  const [msInput, setMsInput] = useState(msIdentity && msIdentity.microsoftId ? msIdentity.microsoftId : '');
  const [errorMsg, setErrorMsg] = useState('');

  const handleSignIn = (e) => {
    if (e && e.preventDefault) e.preventDefault();
    const cleaned = String(msInput || '').trim().toUpperCase();
    const ownId = String((msIdentity && msIdentity.microsoftId) || '').trim().toUpperCase();
    const ownEmail = String((msIdentity && msIdentity.email) || '').trim().toUpperCase();
    const typedOwn = !!cleaned && (cleaned === ownId || cleaned === ownEmail);
    if (typedOwn && isDevMicrosoftIdentity(msIdentity)) {
      setErrorMsg('');
      onVerifySuccess();
    } else if (!typedOwn) {
      setErrorMsg('Type your own Microsoft ID (the one you are signed in with).');
    } else {
      setErrorMsg('Access denied. Admin tools need a System Administrator / System Customizer role or the dev_admin profile.');
    }
  };

  return localizeReactTree((
    <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-xs z-50 flex items-center justify-center p-4" onClick={onClose}>
      <div
        className={`w-full max-w-md rounded-2xl border shadow-2xl overflow-hidden flex flex-col ${theme.bgCard}`}
        onClick={e => e.stopPropagation()}
      >
        <div className="px-5 py-3.5 bg-[#00468B] text-white flex items-center justify-between">
          <div className="flex items-center gap-2">
            <LockIcon className="w-4 h-4 text-[#FFB81C]" />
            <div>
              <h3 className="text-sm font-black">Microsoft ID Security Gate</h3>
              <p className="text-[11px] text-sky-200">Restricted to admins (System Administrator / Customizer role or dev_admin profile)</p>
            </div>
          </div>
          <button type="button" onClick={onClose} className="p-1 rounded-lg bg-white/10 hover:bg-white/20">
            <XIcon className="w-4 h-4" />
          </button>
        </div>

        <form onSubmit={handleSignIn} className="p-5 space-y-4 text-xs">
          <div className={`p-3 rounded-xl border ${theme.bgSubtle}`}>
            <div className="font-bold mb-1">Protected Executive & Developer Operations</div>
            <p className={theme.textMuted}>
              Sensitive modules (18k Bulk Ingest, Duplicate & Blank ID Shield, Facility Map Architect Setup, Suggested Action Editor, User Profile Control, and Developer Tab) are locked behind Microsoft ID <b>admin</b>.
            </p>
            {pendingSensitiveTab && (
              <div className="mt-2 text-[11px] font-bold text-[#0072CE] dark:text-sky-300">
                Requested module: <span className="uppercase font-mono">{pendingSensitiveTab}</span>
              </div>
            )}
          </div>

          <div>
            <label className="block text-[11px] font-black uppercase tracking-wider mb-1">
              Microsoft Corporate ID / UPN
            </label>
            <input
              type="text"
              value={msInput}
              onChange={e => setMsInput(e.target.value)}
              placeholder=""
              className={`w-full rounded-xl border px-3 py-2 text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-[#0072CE] ${theme.bgInput}`}
            />
          </div>

          {errorMsg && (
            <div className={`p-2.5 rounded-lg border text-xs font-bold ${darkMode ? 'bg-red-950/60 border-red-800 text-red-200' : 'bg-red-50 border-red-200 text-red-700'}`}>
              {errorMsg}
            </div>
          )}

          <div className="flex items-center justify-between gap-2 pt-1">
            {isAdminVerified ? (
              <button
                type="button"
                onClick={onLockSession}
                className="px-3.5 py-2 rounded-xl text-xs font-black bg-[#E4002B] text-white hover:bg-red-700"
              >
                Lock Sensitive Gate Now
              </button>
            ) : (
              <button
                type="button"
                onClick={() => {
                  setMsInput((msIdentity && msIdentity.microsoftId) || '');
                  setErrorMsg('');
                }}
                className={`px-3 py-2 rounded-xl text-xs font-bold border ${theme.bgSubtle}`}
              >
                Use Corporate SSO (admin)
              </button>
            )}

            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={onClose}
                className={`px-3 py-2 rounded-xl text-xs font-bold border ${theme.bgSubtle}`}
