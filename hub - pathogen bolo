                      {selectedPinDetail.repeat && <ToneChip tone="act" darkMode={darkMode}>{tr('Repeat', 'Repetido')}</ToneChip>}
                      <span className={`px-2 py-0.5 rounded border text-[10px] font-bold ${theme.bgSubtle}`}>
                        {selectedPinDetail.room}
                      </span>
                      {selectedPinDetail.siteCode && (
                        <span className={`px-2 py-0.5 rounded border text-[10px] font-mono font-bold ${theme.bgSubtle}`}>
                          {selectedPinDetail.siteCode}
                        </span>
                      )}
                    </div>
                    <h4 className="font-black text-sm">{selectedPinDetail.surface} - {selectedPinDetail.description}</h4>
                    <p className={`text-xs font-mono mt-0.5 ${theme.textMuted}`}>
                      Asset Tag: {selectedPinDetail.assetTag || 'N/A'} - Map Coords: ({selectedPinDetail.spot.x}%, {selectedPinDetail.spot.y}%)
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => setSelectedPinKey(null)}
                    className="p-1 rounded hover:bg-slate-200 dark:hover:bg-slate-800"
                  >
                    <XIcon className="w-4 h-4" />
                  </button>
                </div>

                {/* Editable Suggested Action inside Map Inspector */}
                {selectedPinSuggestedAction && (
                  <div className={`p-2.5 rounded-xl border text-xs ${theme.bgSubtle}`}>
                    <div className="flex items-center justify-between mb-1">
