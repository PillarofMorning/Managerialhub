  const [polyDraftPoints, setPolyDraftPoints] = useState([]); // Array of [xPct, yPct]
  const [lassoDraftPoints, setLassoDraftPoints] = useState([]); // Array of [xPct, yPct]
  const [cursorSnapPreview, setCursorSnapPreview] = useState(null); // { x, y, snapped, snapNote, guides, snappedAreaId }
  const [newAreaDraft, setNewAreaDraft] = useState({
    id: '',
