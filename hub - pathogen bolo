function mergeYoYBenchmarks(liveSeries, typedSeries) {
  const live = Array.isArray(liveSeries) ? liveSeries : [];
  const typed = Array.isArray(typedSeries) ? typedSeries : [];
  const nowMonth = parseInt(LIVE_TODAY_DATE_KEY.slice(5, 7), 10) - 1;
  let typedCells = 0;
  let ignoredCells = 0;
  let exampleCells = 0;
  const series = live.map(m => {
    const t = typed.find(x => x && x.month === m.month) || null;
    if (!t) return m;
    const out = { ...m };
    const typedFields = [];
    YOY_TYPED_FIELDS.forEach(k => {
      const v = typeof t[k] === 'number' ? t[k] : parseFloat(t[k]);
      if (!(v > 0) || !isFinite(v)) return;
      if (EXAMPLE_YOY_CELL_SIGS[exampleYoYCellSig(m.month, k, v)]) {
        exampleCells += 1;
        return;
      }
      const futureTy = /TY$/.test(k) && m.monthIndex > nowMonth;
      if ((m[k] === null || m[k] === undefined) && !futureTy) {
        out[k] = round2(v);
        typedFields.push(k);
        typedCells += 1;
      } else if (m[k] === null || m[k] === undefined || Math.abs(m[k] - v) > 0.005) {
        ignoredCells += 1;
      }
    });
    if (typedFields.length > 0) out.typedFields = typedFields;
    return out;
  });
  return { series, typedCells, ignoredCells, exampleCells };
}

