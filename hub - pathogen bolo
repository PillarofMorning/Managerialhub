  // Upsert a row in craa5__facilityobservations with automatic retry if optional/variant columns are absent
  const upsertFacilityObservationRecord = useCallback(async (obsId, candidatePayloads) => {
    const payloads = Array.isArray(candidatePayloads) ? candidatePayloads : [candidatePayloads];
    let lastRes = null;
    for (let i = 0; i < payloads.length; i += 1) {
      const bodyObj = { ...payloads[i] };
      for (let step = 0; step < 6; step += 1) {
        const res = await fetch(apiUrl(`${DATAVERSE_OBS_TABLE}(${obsId})`), {
          method: 'PATCH',
          headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
          body: JSON.stringify(bodyObj)
        });
        if (res.ok) return res;
        lastRes = res;
        let errText = '';
        try { errText = await res.clone().text(); } catch (e) { /* ignore */ }
        const propMatch = errText.match(/property\s+'([^']+)'/i) || errText.match(/attribute\s+'([^']+)'/i);
        if (propMatch && propMatch[1] && Object.prototype.hasOwnProperty.call(bodyObj, propMatch[1])) {
          delete bodyObj[propMatch[1]];
          continue;
        }
        break;
      }
    }
    if (lastRes) throw new Error(await readApiError(lastRes));
    return null;
  }, []);

  // Push a positive as a map pin row in craa5__facilityobservations. Contract 1.0.52: Pathogen BOLO creates only its own
