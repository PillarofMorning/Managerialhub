  const [savedBannerMsg, setSavedBannerMsg] = useState('');
  const [showManageActionsModal, setShowManageActionsModal] = useState(false);
  const [newCustomAction, setNewCustomAction] = useState({
    id: '',
    siteCode: '0320-STLWJ1-066',
    room: 'WJ',
    title: '',
    action: '',
    owner: 'Sanitation + QA Lead',
    priority: 'High',
    status: 'Open'
  });

  // Filter states for the Pathogen vs APC & Other Indicators Separation Matrix
  const [sepSideFilter, setSepSideFilter] = useState('ALL'); // 'ALL' | 'Creme Side' | 'Bakery'
  const [sepIndicatorFocus, setSepIndicatorFocus] = useState('ALL'); // 'ALL' | 'PATHOGEN' | 'APC' | 'ATP'

  const visibleWidgets = (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.visibleWidgets) || {
    pressure_points: true,
    kpi_strip: true,
    room_matrix: true,
    active_hits_table: true
  };

  const startEditSuggestedAction = (pp) => {
    setEditingActionId(pp.id);
    setDraftAction({
      action: pp.action || '',
      owner: pp.actionOwner || 'Sanitation + QA Lead',
      priority: pp.actionPriority || (pp.severity === 'CRITICAL' ? 'Critical' : 'High'),
      status: pp.actionStatus || 'Open'
    });
  };

  const handleSaveSuggestedAction = async (pp) => {
    if (!onSaveSuggestedAction) return;
    setSavingActionId(pp.id);
    await onSaveSuggestedAction(pp.id, {
      id: pp.id,
      siteCode: pp.siteCode,
      room: pp.room,
      title: pp.title,
      action: draftAction.action,
      owner: draftAction.owner,
      priority: draftAction.priority,
      status: draftAction.status
    });
    setSavingActionId(null);
    setEditingActionId(null);
    setSavedBannerMsg(`Saved Suggested Action for "${pp.title}" to Dataverse (PATHOGEN_BOLO_SUGGESTED_ACTIONS).`);
    setTimeout(() => setSavedBannerMsg(''), 5000);
  };

  const handleCreateCustomAction = async () => {
    if (!newCustomAction.title.trim() || !newCustomAction.action.trim()) return;
    const customId = newCustomAction.id.trim() || `custom-${newCustomAction.room.toLowerCase().replace(/[^a-z0-9]/g, '')}-${Date.now().toString().slice(-4)}`;
    setSavingActionId(customId);
    await onSaveSuggestedAction(customId, {
      id: customId,
      siteCode: newCustomAction.siteCode.trim() || 'Plant-Wide',
      room: newCustomAction.room,
      title: newCustomAction.title.trim(),
      action: newCustomAction.action.trim(),
      owner: newCustomAction.owner.trim() || 'Sanitation + QA Lead',
      priority: newCustomAction.priority,
      status: newCustomAction.status
    });
    setSavingActionId(null);
    setNewCustomAction({
      id: '',
      siteCode: '0320-STLWJ1-066',
      room: 'WJ',
      title: '',
      action: '',
      owner: 'Sanitation + QA Lead',
      priority: 'High',
      status: 'Open'
    });
    setSavedBannerMsg(`Created & saved custom Suggested Action (${customId}) to Dataverse.`);
    setTimeout(() => setSavedBannerMsg(''), 5000);
  };

  const s = parsedPrompt.summary;
  const emSep = (pressureAnalysis && pressureAnalysis.executiveMetrics && pressureAnalysis.executiveMetrics.separation) || null;
  const lisTotal = (emSep && emSep.pathogen && emSep.pathogen.swabs) || s.totalLis.total || 0;
  const lisPos = (emSep && emSep.pathogen && emSep.pathogen.positives) || s.totalLis.positives || allHits.filter(h => h.testType === 'LIS').length;
  const lisRate = (emSep && emSep.pathogen && emSep.pathogen.rate) || s.totalLis.rate || (lisTotal > 0 ? round2((lisPos / lisTotal) * 100) : 0);


  const retestFail = s.retests.failed || allHits.filter(h => h.testType === 'RETEST-LIS').length;
  const apcTotal = (emSep && emSep.apc && emSep.apc.swabs) || s.apc.total || 0;
  const apcFail = (emSep && emSep.apc && emSep.apc.positives) || s.apc.failures || allHits.filter(h => h.testType === 'APC').length;
  const apcRate = (emSep && emSep.apc && emSep.apc.rate) || s.apc.rate || (apcTotal > 0 ? round2((apcFail / apcTotal) * 100) : 0);


  const atpTotal = (emSep && emSep.atp && emSep.atp.swabs) || s.atp.total || 0;
  const atpFail = (emSep && emSep.atp && emSep.atp.positives) || s.atp.failures || allHits.filter(h => h.testType === 'ATP').length;
  const atpRate = (emSep && emSep.atp && emSep.atp.rate) || s.atp.rate || (atpTotal > 0 ? round2((atpFail / atpTotal) * 100) : 0);


  const maxSurfaceCount = Math.max(1, ...pressureAnalysis.surfaceBuckets.map(b => b.count));

  const roomRows = useMemo(() => {
    const promptHitsOnly = allHits.filter(h => h.isActivePromptHit || h.source === 'Scheduled Email Prompt' || h.source === 'Manual / Quick-Add');
