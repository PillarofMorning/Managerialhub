const turnPoint = (rotation, x, y, aspect = 1) => {
  const deg = ((Number(rotation) || 0) % 360 + 360) % 360;
  if (deg === 0) return [x, y];
  const rad = (deg * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  const dx = (x - 0.5) * aspect;
  const dy = y - 0.5;
  const rx = dx * cos - dy * sin;
  const ry = dx * sin + dy * cos;
  return [0.5 + rx / (aspect || 1), 0.5 + ry];
};
const unturnPoint = (rotation, u, v, aspect = 1) => {
  const deg = ((Number(rotation) || 0) % 360 + 360) % 360;
  if (deg === 0) return [u, v];
  const rad = (-deg * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  const du = (u - 0.5) * aspect;
  const dv = v - 0.5;
  const rx = du * cos - dv * sin;
  const ry = du * sin + dv * cos;
  return [0.5 + rx / (aspect || 1), 0.5 + ry];
};
const clamp01 = (n) => Math.max(0, Math.min(1, n));

