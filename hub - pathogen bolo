  syncBusy,
  syncStatus,
  logEvent
}) {
  const containerRef = useRef(null);
  const stageRef = useRef(null);

  // Map modes:
  // 'heatmap'   -> View BOLO hits, inspect swab zones, edit Suggested Actions
  // 'setup'     -> Link 0320- Swab Sites or Rooms to Map Areas (Smart Snap)
  // 'architect' -> Facility Setup Mode (ONLY available when logged in via MS ID: isDevAuthorized === true)
