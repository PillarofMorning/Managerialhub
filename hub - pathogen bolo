    }
  }[check.verdict] || null;
  if (!verdictInfo) return null;

  const levelCls = (lv) => {
    if (lv === 'bad') return darkMode ? 'border-amber-600 bg-amber-950/40' : 'border-amber-400 bg-amber-50';
    if (lv === 'warn') return darkMode ? 'border-slate-600 bg-[#162032]' : 'border-slate-300 bg-white';
