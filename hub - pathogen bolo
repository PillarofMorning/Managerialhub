                        style={pin.hollow ? { borderColor: pin.color } : { backgroundColor: pin.color }}
                      >
                        {pin.count > 1 ? `${pin.count}x` : (pin.tone === 'act' || pin.tone === 'watch' ? '!' : '1')}
                      </div>

                      {/* Floating Label */}
                      {(showLabels || isSelected) && (
                        <div className="absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 px-2 py-1 rounded bg-slate-900/95 text-white text-[10px] font-bold whitespace-nowrap shadow-lg pointer-events-none border border-slate-700">
                          <span className="text-sky-300 mr-1">{pin.room}:</span>
                          {pin.surface} - {pin.description.slice(0, 28)}{pin.description.length > 28 ? '...' : ''}
