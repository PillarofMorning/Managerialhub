// ---------- Days and map spots ----------
const BOLO_DOW = [['Mon', 'Lun'], ['Tue', 'Mar'], ['Wed', 'Mie'], ['Thu', 'Jue'], ['Fri', 'Vie'], ['Sat', 'Sab'], ['Sun', 'Dom']];
function boloDayLabel(dateKey) {
  const p = String(dateKey || '').split('-').map(Number);
  if (p.length !== 3 || !p[0]) return dateKey || '';
  const d = new Date(p[0], p[1] - 1, p[2], 12, 0, 0);
  const w = BOLO_DOW[(d.getDay() + 6) % 7];
  return `${tr(w[0], w[1])} ${formatShortDate(dateKey)}`;
}
// The calendar and map id of the hit a lab row makes (buildRollupFromLedger)
function hitIdOfRow(r) {
  return `csv-hit-${(r && (r.id || r.idAndDescKey)) || ''}`;
}
// Where a swab site sits on the map: the site's own spot or its room's (site catalog), else the middle of the room's
// drawn area, else nowhere (null). estimated = nobody placed the site or its room and the room has no drawn area,
// so the spot is the blueprint's guess.
function boloSpotFor(siteCode, room, siteByCode, siteMappings, roomMappings, facilityAreas) {
  const fullSite = siteCode ? siteByCode[siteCode] : null;
  const area = getFacilityAreaByRoom(facilityAreas, room);
  const drawn = !!(area && !area.isRemoved && !area.hidden && area.hasDrawnBoundary && Array.isArray(area.box) && area.box.length === 4);
  const placed = !!(siteCode && siteMappings[siteCode]) || !!roomMappings[room];
  let spot = null;
  if (fullSite && fullSite.effectiveSpot) spot = fullSite.effectiveSpot;
  else if (roomMappings[room]) spot = roomMappings[room];
  else if (drawn) spot = { x: area.box[0] + area.box[2] / 2, y: area.box[1] + area.box[3] / 2, box: area.box, snapped: true, how: 'room' };
  return { spot, estimated: !(placed || drawn) };
}
// The tone of one lab row on a day: a positive is act now (an APC / ATP fail is watch), at the lab is not known yet,
// a negative or an APC / ATP number is done
function rowToneOf(r) {
  if (!r) return 'unknown';
  if (r.result === 'Positive') return r.testCode === 'APC' || r.testCode === 'ATP' ? 'watch' : 'act';
  if (r.result === 'Negative') return 'done';
  if (r.result === 'Count') return r.testCode === 'APC' || r.testCode === 'ATP' ? 'done' : 'plain';
  return 'unknown';
}
const BOLO_TONE_RANK = { act: 0, watch: 1, unknown: 2, done: 3, plain: 4 };
function moreUrgentTone(a, b) {
  return (BOLO_TONE_RANK[a] === undefined ? 9 : BOLO_TONE_RANK[a]) <= (BOLO_TONE_RANK[b] === undefined ? 9 : BOLO_TONE_RANK[b]) ? a : b;
}

