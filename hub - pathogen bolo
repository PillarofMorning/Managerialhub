                      <div
                        className="absolute pointer-events-none z-10 transition-all"
                        style={{
                          left: `${box[0]}%`,
                          top: `${box[1]}%`,
                          width: `${box[2]}%`,
                          height: `${box[3]}%`,
                          border: `2px solid ${pin.color}`,
                          backgroundColor: isSelected ? `${pin.color}44` : `${pin.color}22`
                        }}
                      />
