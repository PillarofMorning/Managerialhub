    }

    // Lab rows: CSV, tab-separated copy from Excel, or rows pasted from an email. Columns are found by header name.
    const parsed = parseLabRowsFromText(text, regexRules, roomAliases);
    const baseRows = mode === 'replace' ? [] : (historicalLedger.length > 0 ? historicalLedger : parsedCsv.rows);
    const { ledger: nextLedger, receipt } = ingestRowsWithDeduplication(baseRows, parsed.rows, sourceLabel);
    receipt.skippedLines = parsed.skipped;
    setHistoricalLedger(nextLedger);
    saveLedgerToIdb(nextLedger);
    setImportReceipts(prev => [receipt, ...prev.slice(0, 29)]);
    logEvent(
      `${sourceLabel}: ${receipt.scanned} rows read: ${receipt.addedNew} new, ${receipt.upsertedBlankResult} blank results completed, ${receipt.duplicatesBlocked} duplicates, ${receipt.conflictsUpgraded} with two different results${parsed.skipped ? `, ${parsed.skipped} lines that are not lab rows skipped` : ''}.`,
      'success'
    );
