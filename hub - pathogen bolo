}

// ============================================================================
// [MANAGERS HUB DATAVERSE LINKAGE - START: TAB 3 GRAPHS & TREND STUDIO]
// Purpose: This section (`ExecutiveGraphsAndTrendsView`) and the following
// `DataManipulationLabView` power all YoY, YTD, and Indicator Separation graphs.
// Dataverse Linkage for Managers Hub (`home page.txt`, `dashboard.txt`, `data hub.txt`):
//   - Table: Hub config `craa5__e_hubconfigs` (else the old `craa5__0_hubconfigs`)
//   - Primary Config Key: `PATHOGEN_BOLO_MANAGERS_HUB_GRAPHS`
//   - Benchmark Series Key: `PATHOGEN_BOLO_YOY_BENCHMARKS`
//   - Executive Synopses Key: `PATHOGEN_BOLO_EXEC_SYNOPSES`
//   - Sync Handler Prop: `onSyncManagersHubGraphs()`
// ============================================================================
function ExecutiveGraphsAndTrendsView({
  darkMode,
  theme: appTheme,
  pressureAnalysis,
  monthlyYoYSeries,
  resultCategoryMode,
  setResultCategoryMode,
  executiveSynopses,
  onSaveExecutiveSynopsis,
  onSyncManagersHubGraphs,
  allHits,
  parsedPrompt,
  onOpenDataManip,
  onLocateOnMap
}) {
  const theme = INLINE_THEME[darkMode ? 'dark' : 'light'];
  const nowMonthIdx = parseInt(LIVE_TODAY_DATE_KEY.slice(5, 7), 10) - 1;
  const [metricFocus, setMetricFocus] = useState('overall'); // 'overall' | 'phase_split' | 'side_split' | 'indicator_sep' | 'room_hotspots'
  const [chartType, setChartType] = useState('combo'); // 'combo' | 'grouped_bar' | 'area_trend' | 'ytd_cumulative'
  const [horizonMode, setHorizonMode] = useState('ytd_actual'); // 'ytd_actual' | 'full_12m' | 'h2_focus'
  const [show2024Baseline, setShow2024Baseline] = useState(true);
  const [showRollingAvg, setShowRollingAvg] = useState(true);
  const [showTargetLine, setShowTargetLine] = useState(true);
  const [targetThreshold, setTargetThreshold] = useState(1.2);
  const [selectedMonthIdx, setSelectedMonthIdx] = useState(() => Math.max(0, nowMonthIdx));
  const [managersHubSyncToast, setManagersHubSyncToast] = useState('');

  // Real monthly rates (null = no swabs that month, drawn as a gap; never drawn as 0%)
  const rawMonths = Array.isArray(monthlyYoYSeries) && monthlyYoYSeries.length > 0 ? monthlyYoYSeries : [];

  const filteredMonths = useMemo(() => {
    if (horizonMode === 'ytd_actual') return rawMonths.filter((m) => m.monthIndex <= nowMonthIdx);
    if (horizonMode === 'h2_focus') return rawMonths.slice(6, 12);
    return rawMonths;
  }, [rawMonths, horizonMode, nowMonthIdx]);

  // The series for the chosen view. p = main slice (blue), s = second slice (amber), third = dashed line: the main slice
  // two years back, or a real comparison series. YTD and the 3-month line are pooled from swab counts (positives /
  // swabs), not averages of monthly percentages; typed table cells never enter them.
  const chartDataConfig = useMemo(() => {
    const catKey = resultCategoryMode || 'pathogen';
    const Y0 = LIVE_CURRENT_YEAR;
    const catWord = { pathogen: tr('Pathogen', 'Patogenos'), apc: 'APC', atp: 'ATP', all: tr('All tests', 'Todas las pruebas') }[catKey] || tr('Pathogen', 'Patogenos');
    let cfg = { p: catKey, s: '', third: `${catKey}2Y`, pl: catWord, sl: '', tl: `${catWord} ${Y0 - 2}` };
    if (metricFocus === 'phase_split') cfg = { p: 'inp', s: 'st', third: 'inp2Y', pl: tr('In-process', 'En proceso'), sl: tr('Start-up', 'Arranque'), tl: `${tr('In-process', 'En proceso')} ${Y0 - 2}` };
    else if (metricFocus === 'side_split') cfg = { p: 'creme', s: 'bakery', third: 'creme2Y', pl: tr('Creme side', 'Lado crema'), sl: tr('Bakery', 'Panaderia'), tl: `${tr('Creme side', 'Lado crema')} ${Y0 - 2}` };
    else if (metricFocus === 'indicator_sep') cfg = { p: 'pathogen', s: 'apc', third: 'atpTY', pl: tr('Pathogen', 'Patogenos'), sl: 'APC', tl: `ATP ${Y0}` };
    else if (metricFocus === 'room_hotspots') cfg = { p: 'wj', s: 'ibl5', third: 'doughTY', pl: 'WJ', sl: 'IBL5', tl: `Dough Room ${Y0}` };
    const val = (m, k) => (m && m[k] !== null && m[k] !== undefined && !isNaN(Number(m[k])) ? Number(m[k]) : null);
    const cnt = (m, k) => val(m, k) || 0;

    // Pooled from January, so a view that starts in July still shows the true year-to-date rate
    const cum = {};
    let cP = 0;
    let cS = 0;
    let lP = 0;
    let lS = 0;
    rawMonths.slice().sort((a, b) => a.monthIndex - b.monthIndex).forEach((m) => {
      cP += cnt(m, `${cfg.p}PosTY`);
      cS += cnt(m, `${cfg.p}SwabsTY`);
      lP += cnt(m, `${cfg.p}PosLY`);
      lS += cnt(m, `${cfg.p}SwabsLY`);
      cum[m.monthIndex] = { ty: cS > 0 ? round2((cP / cS) * 100) : null, ly: lS > 0 ? round2((lP / lS) * 100) : null };
    });

    const series = filteredMonths.map((m, idx) => {
      const win = rawMonths.filter((x) => x.monthIndex <= m.monthIndex && x.monthIndex >= m.monthIndex - 2);
      const wp = win.reduce((a, x) => a + cnt(x, `${cfg.p}PosTY`), 0);
      const ws = win.reduce((a, x) => a + cnt(x, `${cfg.p}SwabsTY`), 0);
      const tyPrimary = val(m, `${cfg.p}TY`);
      const lyPrimary = val(m, `${cfg.p}LY`);
      return {
        ...m,
        localIdx: idx,
        tyPrimary,
        lyPrimary,
        base2024: val(m, cfg.third),
        tySecondary: cfg.s ? val(m, `${cfg.s}TY`) : null,
        lySecondary: cfg.s ? val(m, `${cfg.s}LY`) : null,
        primarySwabsTY: cnt(m, `${cfg.p}SwabsTY`),
        primaryPosTY: cnt(m, `${cfg.p}PosTY`),
        typedTY: (m.typedFields || []).indexOf(`${cfg.p}TY`) !== -1,
        typedLY: (m.typedFields || []).indexOf(`${cfg.p}LY`) !== -1,
        ytdCumTY: cum[m.monthIndex] ? cum[m.monthIndex].ty : null,
        ytdCumLY: cum[m.monthIndex] ? cum[m.monthIndex].ly : null,
        rolling3mTY: ws > 0 ? round2((wp / ws) * 100) : null,
        yoyDelta: tyPrimary !== null && lyPrimary !== null ? round2(tyPrimary - lyPrimary) : null
      };
    });

    const allVals = [];
    const push = (v) => { if (v !== null && v !== undefined) allVals.push(v); };
    series.forEach((pt) => {
      push(pt.tyPrimary);
      push(pt.lyPrimary);
      push(pt.ytdCumTY);
      push(pt.ytdCumLY);
      if (show2024Baseline) push(pt.base2024);
      push(pt.tySecondary);
      push(pt.lySecondary);
    });
    if (showTargetLine) allVals.push(targetThreshold);
    const maxVal = Math.max(2.5, ...allVals) * 1.15;

    return {
      series,
      maxVal: Number(maxVal.toFixed(2)),
      primaryLabel: `${cfg.pl} ${Y0}`,
      lyLabel: `${cfg.pl} ${Y0 - 1}`,
      secondaryLabel: cfg.s ? `${cfg.sl} ${Y0}` : '',
      baseLabel: cfg.tl,
      hasAnyTY: series.some((pt) => pt.tyPrimary !== null),
      hasAnyLY: series.some((pt) => pt.lyPrimary !== null)
    };
  }, [rawMonths, filteredMonths, metricFocus, resultCategoryMode, show2024Baseline, showTargetLine, targetThreshold]);

  // Preset views (no numbers in the text: the chart shows them)
  const graphRecommendations = [
    {
      id: 'rec_yoy_overall',
      badge: tr('This year vs last year', 'Este ano vs el pasado'),
      title: tr('Pathogen rate by month, with last year and two years back', 'Porcentaje de patogenos por mes, con el ano pasado y hace dos anos'),
      summary: tr('Bars: this year and last year. Dashed line: two years back. Months with no swabs loaded are left blank.', 'Barras: este ano y el pasado. Linea punteada: hace dos anos. Los meses sin hisopos cargados quedan en blanco.'),
      color: '#3b82f6',
      apply: () => {
        setResultCategoryMode('pathogen');
        setMetricFocus('overall');
        setChartType('combo');
        setHorizonMode('ytd_actual');
        setShow2024Baseline(true);
        setShowRollingAvg(true);
      }
    },
    {
      id: 'rec_phase_crossover',
      badge: tr('Start-up vs in-process', 'Arranque vs en proceso'),
      title: tr('In-process and start-up rates by month', 'Porcentajes en proceso y de arranque por mes'),
      summary: tr('Shows which stage the positives come from each month.', 'Muestra de que etapa vienen los positivos cada mes.'),
      color: '#8b5cf6',
      apply: () => {
        setResultCategoryMode('pathogen');
        setMetricFocus('phase_split');
        setChartType('grouped_bar');
        setHorizonMode('ytd_actual');
        setShowRollingAvg(true);
      }
    },
    {
      id: 'rec_creme_vs_bakery',
      badge: tr('Creme vs bakery', 'Crema vs panaderia'),
      title: tr('Creme side and bakery rates by month', 'Porcentajes del lado crema y de panaderia por mes'),
      summary: tr('Compares the two sides of the plant month by month.', 'Compara los dos lados de la planta mes a mes.'),
      color: '#06b6d4',
      apply: () => {
        setResultCategoryMode('pathogen');
        setMetricFocus('side_split');
        setChartType('area_trend');
        setHorizonMode('full_12m');
        setShow2024Baseline(false);
      }
    },
    {
      id: 'rec_apc_leading',
      badge: tr('Pathogen vs indicators', 'Patogenos vs indicadores'),
      title: tr('Pathogen with APC and ATP by month', 'Patogenos con APC y ATP por mes'),
      summary: tr('Puts the indicator rates next to the pathogen rate to see whether they move together.', 'Pone los indicadores junto a los patogenos para ver si se mueven juntos.'),
      color: '#f59e0b',
      apply: () => {
        setMetricFocus('indicator_sep');
        setChartType('combo');
        setHorizonMode('ytd_actual');
        setShow2024Baseline(true);
      }
    }
  ];

  const activePoint = chartDataConfig.series[Math.min(selectedMonthIdx, Math.max(0, chartDataConfig.series.length - 1))] || chartDataConfig.series[0];

  // SVG Chart Geometry (generous right & top padding so YoY labels never clip off screen)
  const svgW = 860;
  const svgH = 316;
  const padL = 56;
  const padR = 46;
  const padT = 30;
  const padB = 44;
  const plotW = svgW - padL - padR;
  const plotH = svgH - padT - padB;
  const nPts = Math.max(1, chartDataConfig.series.length);
  const colW = plotW / nPts;

  const valToY = (v) => {
    const clamped = Math.max(0, Math.min(chartDataConfig.maxVal, Number(v || 0)));
    return padT + plotH - (clamped / chartDataConfig.maxVal) * plotH;
  };
  const idxToX = (i) => padL + i * colW + colW * 0.5;

  // A month with no value (null) is a gap: lines and areas stop there and start again after it, never drawn at 0% and
  // never drawn across the empty months
  const runsOf = (getter) => {
    const runs = [];
    let cur = [];
    chartDataConfig.series.forEach((pt, i) => {
      const v = getter(pt);
      if (v === null || v === undefined) {
        if (cur.length > 0) runs.push(cur);
        cur = [];
        return;
      }
      cur.push([idxToX(i), valToY(v)]);
    });
    if (cur.length > 0) runs.push(cur);
    return runs;
  };
  const buildLinePath = (getter) => runsOf(getter)
    .map(run => run.map((p, j) => `${j === 0 ? 'M' : 'L'} ${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' '))
    .join(' ');
  const buildAreaPath = (getter) => {
    const baseY = (padT + plotH).toFixed(1);
    return runsOf(getter)
      .map(run => `M ${run[0][0].toFixed(1)} ${baseY} ${run.map(p => `L ${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ')} L ${run[run.length - 1][0].toFixed(1)} ${baseY} Z`)
      .join(' ');
  };
  const fmtG = (v) => (v === null || v === undefined ? '--' : `${Number(v).toFixed(2)}%`);

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-3 sm:p-4 pb-32" style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
