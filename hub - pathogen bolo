// Saved in Hub config PATHOGEN_BOLO_EXEC_SYNOPSES under <results>_<slot> (the keys v2.0-v2.4 used)
function SynopsisNote({ darkMode, theme, slot, catMode, autoText, executiveSynopses, onSave, canEdit }) {
  const fullKey = `${catMode || 'pathogen'}_${slot}`;
