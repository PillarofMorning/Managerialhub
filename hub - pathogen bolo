function SwabDvStatusChip({ swabDv, canWrite, onRetry }) {
  let label = tr('Dataverse: checking swab table...', 'Dataverse: revisando la tabla de hisopos...');
  let cls = 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600';
  if (swabDv.status === 'missing') {
    label = tr('Swab table not created yet: results stay on this computer', 'La tabla de hisopos aun no existe: los resultados se quedan en esta computadora');
    cls = 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-700';
  } else if (swabDv.status === 'error') {
    label = tr(`Swab table read failed: ${swabDv.lastError}`, `No se pudo leer la tabla de hisopos: ${swabDv.lastError}`);
    cls = 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-700';
  } else if (swabDv.status === 'ready') {
    if (swabDv.saving) label = tr(`Saving swab results... ${swabDv.queued.toLocaleString()} left`, `Guardando resultados de hisopos... faltan ${swabDv.queued.toLocaleString()}`);
    else if (swabDv.failed > 0) label = tr(`${swabDv.failed} swab result(s) not saved - Retry`, `${swabDv.failed} resultado(s) de hisopos sin guardar - Reintentar`);
    else label = tr(`Dataverse: ${swabDv.stored.toLocaleString()} swab results saved${canWrite ? '' : ' (view only)'}`, `Dataverse: ${swabDv.stored.toLocaleString()} resultados de hisopos guardados${canWrite ? '' : ' (solo lectura)'}`);
    cls = swabDv.failed > 0
      ? 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-700'
      : 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950/50 dark:text-emerald-200 dark:border-emerald-700';
  }
  const missing = swabDv.missingCols && swabDv.missingCols.length > 0 ? tr(` Missing columns: ${swabDv.missingCols.join(', ')}.`, ` Faltan columnas: ${swabDv.missingCols.join(', ')}.`) : '';
  return localizeReactTree((
    <button
      type="button"
      onClick={() => { if (swabDv.status === 'ready' && onRetry) onRetry(); }}
      title={`${label}.${missing}${swabDv.lastSync ? ` Last check ${swabDv.lastSync}.` : ''}`}
      className={`px-2.5 py-1 rounded-full border text-[11px] font-bold whitespace-nowrap ${cls}`}
    >
      {label}{missing ? ' (!)' : ''}
    </button>
  ), ACTIVE_UI_LANG);
}

function OpenSwabHitsPanel({ theme, darkMode, ledger, linkCtx, closures, assetsById, fetchLogHistory, refsReady, swabDv }) {
  const [showClosed, setShowClosed] = useState(false);
  const [openRow, setOpenRow] = useState('');
  const [history, setHistory] = useState({});

  const rows = useMemo(() => {
    const list = [];
    (ledger || []).forEach(r => {
      if (!r || r.result !== 'Positive' || !r.date) return;
      const key = swabRowKey(r);
      const links = resolveSwabLinks(r, linkCtx);
      const closure = closures[key] || (r.dvClosedKey ? { key: r.dvClosedKey, day: r.dvClosedOn } : null);
      list.push({ r, key, links, closure });
    });
    list.sort((a, b) => String(b.r.date).localeCompare(String(a.r.date)));
    return list;
  }, [ledger, linkCtx, closures]);
  const openCount = rows.filter(x => !x.closure).length;
  const shown = rows.filter(x => showClosed || !x.closure).slice(0, 60);

  const toggleHistory = async (x) => {
    if (openRow === x.key) { setOpenRow(''); return; }
    setOpenRow(x.key);
    if (history[x.key]) return;
    if (!x.links.equipmentguid && !x.links.area) {
      setHistory(h => ({ ...h, [x.key]: { error: 'This swab site is not linked to an MSS area or equipment yet (Swab Catalog tab).' } }));
      return;
    }
    setHistory(h => ({ ...h, [x.key]: { loading: true } }));
    try {
      const list = await fetchLogHistory(x.links.equipmentguid, x.links.area);
      setHistory(h => ({ ...h, [x.key]: { list } }));
    } catch (e) {
      setHistory(h => ({ ...h, [x.key]: { error: e.message } }));
    }
  };

  return localizeReactTree((
    <div className={`rounded-xl border p-4 shadow-xs ${theme.bgCard}`}>
      <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <h3 className={`text-sm font-black ${theme.textHeading}`}>Open Positives and Corrective Cleans</h3>
          <p className={`text-[11px] ${theme.textMuted}`}>
            A positive is closed when the MSS log has a Pathogen = Yes clean on the same equipment (or area) on or after the swab date.
            {!refsReady && ' Loading areas and equipment...'}
            {swabDv.status === 'missing' && ' The swab table is not created yet, so other apps cannot see these hits.'}
          </p>
        </div>
        <div className="flex items-center gap-2">
          <span className={`px-2 py-0.5 rounded-full text-[11px] font-black ${openCount > 0 ? 'bg-[#DC2626] text-white' : 'bg-emerald-600 text-white'}`}>
            {openCount} open
          </span>
          <label className="text-[11px] font-bold flex items-center gap-1">
            <input type="checkbox" checked={showClosed} onChange={e => setShowClosed(e.target.checked)} /> Show closed
          </label>
        </div>
      </div>
      {shown.length === 0 ? (
        <div className={`text-xs ${theme.textMuted}`}>{rows.length === 0 ? 'No positive results loaded.' : 'No open positives.'}</div>
      ) : (
        <div className="overflow-x-auto">
          <table className="w-full text-left text-xs border-collapse">
            <thead className={`uppercase text-[10px] font-extrabold tracking-wider ${theme.bgSubtle}`}>
              <tr>
                <th className="py-2 px-2">Date</th>
                <th className="py-2 px-2">Site</th>
                <th className="py-2 px-2">Test</th>
                <th className="py-2 px-2">MSS Area</th>
                <th className="py-2 px-2">Equipment</th>
                <th className="py-2 px-2">Status</th>
                <th className="py-2 px-2 text-right">MSS Log</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200 dark:divide-slate-800">
              {shown.map(x => {
                const asset = x.links.equipmentguid ? assetsById[x.links.equipmentguid] : null;
                const h = history[x.key];
                return (
                  <React.Fragment key={x.key}>
                    <tr className={darkMode ? 'hover:bg-slate-800/50' : 'hover:bg-slate-50'}>
                      <td className="py-1.5 px-2 font-mono whitespace-nowrap">{formatShortDate(x.r.date)}</td>
                      <td className="py-1.5 px-2">
                        <div className="font-mono font-bold text-[#0072CE] dark:text-sky-300">{x.r.siteCode || '-'}</div>
                        <div className={`text-[10px] ${theme.textMuted}`}>{x.r.surface} - {x.r.description}</div>
                      </td>
                      <td className="py-1.5 px-2 font-bold">{x.r.testCode}{x.r.stage === 'RETEST' ? ' (retest)' : ''}</td>
                      <td className="py-1.5 px-2">{x.links.area || <span className="text-amber-600 font-bold">Not linked</span>}</td>
                      <td className="py-1.5 px-2">{asset ? `${asset.name}${asset.uid ? ` #${asset.uid}` : ''}` : (x.r.assetTag || '-')}</td>
                      <td className="py-1.5 px-2 whitespace-nowrap">
                        {x.closure
                          ? <span className="px-2 py-0.5 rounded-full bg-emerald-600 text-white font-black text-[10px]">Closed {x.closure.day ? formatShortDate(x.closure.day) : ''}</span>
                          : <span className="px-2 py-0.5 rounded-full bg-[#DC2626] text-white font-black text-[10px]">Open - corrective clean needed</span>}
                      </td>
                      <td className="py-1.5 px-2 text-right">
                        <button type="button" onClick={() => toggleHistory(x)} className="px-2 py-0.5 rounded bg-[#0072CE] text-white font-bold text-[10px] hover:bg-[#00468B]">
                          {openRow === x.key ? 'Hide' : 'Last cleans'}
                        </button>
                      </td>
                    </tr>
                    {openRow === x.key && (
                      <tr>
                        <td colSpan={7} className={`py-2 px-3 ${theme.bgSubtle}`}>
                          {!h || h.loading ? 'Loading MSS log...' : h.error ? <span className="text-amber-700 dark:text-amber-300 font-bold">{h.error}</span> : h.list.length === 0 ? 'No MSS log rows for this equipment / area.' : (
                            <div className="flex flex-col gap-0.5 font-mono text-[11px]">
                              {h.list.map(l => (
                                <div key={l.id}>
                                  {l.day} - {l.equipment || l.area} - {l.by || 'no name'}{l.pathogen === 'Yes' ? ' - PATHOGEN CLEAN' : ''}{l.day && l.day < x.r.date ? '' : ' (after swab)'}
                                </div>
                              ))}
                            </div>
                          )}
                        </td>
                      </tr>
                    )}
                  </React.Fragment>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  ), ACTIVE_UI_LANG);
}

// Zone (WJ, IBL5, Okra / 01MIX...) to MSS area aliases, and per-site area + equipment links
