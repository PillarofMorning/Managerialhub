  }, [setFacilityAreas, setRoomMappings, setSiteMappings, logEvent]);

  // Visible facility areas after filtering out current areas, bare map mode, and unconfigured areas
  const visibleFacilityAreas = useMemo(() => {
    if (isBareMapActive || !showRoomBoxes) return [];
    const q = areaFilterText.trim().toLowerCase();
