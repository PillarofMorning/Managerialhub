  const [showNewAreaForm, setShowNewAreaForm] = useState(false);

  // Selection & Setup States
  const [selectedPinKey, setSelectedPinKey] = useState(null);
  const [setupTargetType, setSetupTargetType] = useState('room'); // Default to 'room' so user can immediately outline actual areas on bare map
  const [setupSiteCode, setSetupSiteCode] = useState('0320-STLWJ1-066');
  const [setupRoomKey, setSetupRoomKey] = useState('WJ');
