      if (!area.hasDrawnBoundary || !Array.isArray(area.box) || area.box.length !== 4) return false;
      if (hideLegacyAreas && (area.isLegacy || area.hidden)) return false;
      if (!area.isLegacy) {
        if (currentAreaFilterMode === 'hide_all_current') return false;
        if (currentAreaFilterMode === 'only_target' && area.id !== activeTargetZoneId && area.roomKey !== activeTargetZoneId) {
          return false;
        }
        if (filteredOutCurrentAreaIds[area.id]) return false;
      }
      if (!q) return true;
      const hay = `${area.id} ${area.label} ${area.short} ${area.roomKey || ''}`.toLowerCase();
      return hay.indexOf(q) !== -1;
