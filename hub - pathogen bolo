function exampleEmailLineSig(line) {
  const norm = String(line || '').replace(/\s+/g, ' ').trim().replace(/^\d{1,2}\/\d{1,2}(\/\d{2,4})?\s+/, '# ').toUpperCase();
  return hubIdFromKey(`bolo-example-email|${norm}`).slice(0, 13);
}

// =======================================================================
// v2.3 CLEANUP OF A LEDGER SAVED BY AN EARLIER VERSION (runs once per browser, when the app loads)
// =======================================================================
// - Rows of the example lab table and of the "Simulate next-day email" test that v2.0 started with are removed.
// - Every other row is read again with the v2.3 reader (test from the Test Method, result words, stage, swab kind) and
//   gets the v2.3 key (Sample ID + description + test).
// - A row that held two different tests (Listeria + Salmonella, APC + coliform) keeps its first test and is marked
//   needsReupload: one result cannot be split back into two. Re-uploading the lab file replaces it.
// - A result set by hand in the app (Set Negative / Mark all pending as negative) is marked manualResult and kept out
//   of every rate until the lab's result arrives.
const LEDGER_CLEANUP_REPORT_KEY = 'stillwell.pathogenBolo.ledgerCleanup.v23';
const PASTE_RESTORE_REPORT_KEY = 'stillwell.pathogenBolo.pasteRestore.v23';
const V20_PROMPT_TEXT_KEY = 'stillwell.pathogenBolo.promptText.v4.accurateDates';
const V20_CSV_TEXT_KEY = 'stillwell.pathogenBolo.csvText.v4.accurateDates';
const SIMULATED_SOURCE_LABEL = 'Simulated Lab Completion Email';

function cleanSavedLedgerV23(savedRows, rules, aliases) {
  const rulesCompiled = compileRegexSet(rules);
  const report = { at: new Date().toISOString(), before: (savedRows || []).length, removedExample: 0, mergedTests: 0, manual: 0, reread: 0, unreadable: 0, changedResult: 0 };
  const out = [];
  (savedRows || []).forEach((r, i) => {
    if (!r) return;
    if (r.v === 23 || r.v === LEDGER_ROW_VERSION) { out.push(r); return; }
    if (EXAMPLE_ROW_SIGS[exampleRowSig(r.sampleId, r.sampleDesc)] || r.lastUpdatedSource === SIMULATED_SOURCE_LABEL) {
      report.removedExample += 1;
      return;
    }
    const methods = (Array.isArray(r.testMethods) && r.testMethods.length > 0 ? r.testMethods : [r.testMethod || '']).filter(Boolean);
    const codes = [];
    methods.forEach(m => {
      const c = normalizeTestProgramCode(m, '');
      if (codes.indexOf(c) === -1) codes.push(c);
    });
    const parsed = parseSingleCsvRow([r.date || '', r.sampleId || '', r.sampleDesc || '', methods[0] || '', r.rawResult || ''], i, rulesCompiled, aliases, null);
    if (!parsed) { report.unreadable += 1; return; }
    report.reread += 1;
    const handSet = !!(r.completedViaUpsert && !r.lastUpdatedSource);
    const twoTests = codes.length > 1;
    // A merged two-test row and a row whose results disagreed keep the result they had (the raw text may be the other one)
    const keepSaved = twoTests || r.conflictResolved || handSet;
    const savedResult = r.result === 'Positive' || r.result === 'Negative' || r.result === 'Count' ? r.result : 'Pending';
    const result = keepSaved ? savedResult : parsed.result;
    if (result !== r.result) report.changedResult += 1;
    if (twoTests) report.mergedTests += 1;
    if (handSet) report.manual += 1;
    out.push(keepDvFields(r, {
      ...parsed,
      result,
      resultUnread: keepSaved ? false : parsed.resultUnread,
      isBlankResult: result === 'Pending',
      testMethods: methods,
      mergedTests: twoTests ? codes : undefined,
      needsReupload: twoTests,
      manualResult: handSet,
      resultConflict: !!r.conflictResolved,
      conflictResolved: !!r.conflictResolved,
      completedViaUpsert: !!r.completedViaUpsert,
      lastUpdatedSource: r.lastUpdatedSource || '',
      duplicateHitsCount: r.duplicateHitsCount || 0
    }));
  });
  const rebuilt = ingestRowsWithDeduplication([], out, 'v2.3 cleanup').ledger;
  report.after = rebuilt.length;
  return { rows: rebuilt, report };
}

// v2.4 reads ">" and "est" on APC / ATP (readLabResult). A v2.3 row kept on this computer gets its result read again from
// the lab's text; a result set by hand, a row whose two results disagreed and an old two-test row keep theirs.
function rereadResultsV24(rows) {
  let changed = 0;
  const out = (rows || []).map(r => {
    if (!r || r.v !== 23) return r;
    if (r.manualResult || r.conflictResolved || r.needsReupload) return { ...r, v: LEDGER_ROW_VERSION };
    const read = readLabResult(r.rawResult, r.testCode);
    if (read.result !== r.result) changed += 1;
    return { ...r, result: read.result, resultUnread: read.unread, overLimit: !!read.over, isBlankResult: read.result === 'Pending', v: LEDGER_ROW_VERSION };
  });
  return { rows: out, changed };
}

// v2.1 moved the paste boxes to new storage keys, which hid the text v2.0 had saved. v2.3 brings that text back,
// without the example email (only when it is still the first thing in the box, where v2.0 put it) and without the
// example lab rows.
function stripExampleEmail(text) {
  const lines = String(text || '').split(/\r?\n/);
  let i = 0;
  while (i < lines.length && !lines[i].trim()) i += 1;
  if (i >= lines.length || exampleEmailLineSig(lines[i]) !== EXAMPLE_EMAIL_FIRST_LINE_SIG) return { text: String(text || ''), removed: false };
  let matched = 0;
  let j = i;
  while (j < lines.length && (!lines[j].trim() || EXAMPLE_EMAIL_LINE_SIGS[exampleEmailLineSig(lines[j])])) {
    if (lines[j].trim()) matched += 1;
    j += 1;
  }
  if (matched < 25) return { text: String(text || ''), removed: false };
  return { text: lines.slice(j).join('\n').trim(), removed: true };
}
function stripExampleCsvRows(text) {
  const lines = String(text || '').split(/\r?\n/);
  let removed = 0;
  let kept = 0;
  const out = [];
  lines.forEach(l => {
    if (!l.trim()) return;
    const cols = parseCsvLine(l);
    if (mapLabHeader(cols)) { out.push(l); return; }
    if (cols.length >= 3 && EXAMPLE_ROW_SIGS[exampleRowSig(cols[1], cols[2])]) { removed += 1; return; }
    out.push(l);
    kept += 1;
  });
  return { text: kept > 0 ? out.join('\n') : '', removed, kept };
}
function restoreV20PasteText(kind) {
  const done = readStorage(PASTE_RESTORE_REPORT_KEY, null) || {};
  const curKey = kind === 'email' ? STORAGE_KEYS.promptText : STORAGE_KEYS.csvText;
  const current = String(readStorage(curKey, '') || '');
  if (done[kind]) return current;
  const old = String(readStorage(kind === 'email' ? V20_PROMPT_TEXT_KEY : V20_CSV_TEXT_KEY, '') || '');
  const cleaned = kind === 'email' ? stripExampleEmail(old) : stripExampleCsvRows(old);
  const restored = cleaned.text.trim();
  done[kind] = { at: new Date().toISOString(), restoredChars: restored.length, exampleRemoved: cleaned.removed, keptRows: kind === 'csv' ? cleaned.kept : undefined };
  writeStorage(PASTE_RESTORE_REPORT_KEY, done);
  if (!restored || current.indexOf(restored) !== -1) return current;
  return current.trim() ? `${restored}\n\n${current}` : restored;
}

// --- EMAIL HITS vs LAB ROWS ---
// The lab rows are the record. A hit the weekly email lists is matched to a lab positive of the same test family in the
// same room, within 3 days (dated lines) or in the same week (retest / APC / ATP lines), with most of its words in the
// lab description. A matched email line is not shown again (one positive is counted once); an unmatched one stays,
// marked emailOnly, and the Import check lists it.
function matchEmailHitsToLab(emailHits, labHits) {
  const famOf = (t) => (t === 'APC' ? 'APC' : (t === 'ATP' ? 'ATP' : 'PATH'));
  const dayNum = (k) => Date.UTC(parseInt(k.slice(0, 4), 10), parseInt(k.slice(5, 7), 10) - 1, parseInt(k.slice(8, 10), 10)) / 86400000;
  const words = (txt) => normToken(txt).split(' ').filter(w => w.length > 1);
  const labPos = (labHits || []).map(h => {
    const set = {};
    words(`${h.surface} ${h.description} ${h.rawLine || ''}`).forEach(w => { set[w] = true; });
    return { h, used: false, set };
  });
  const emailOnly = [];
  const matched = [];
  (emailHits || []).forEach(e => {
    const ew = words(`${e.surface} ${e.description}`);
    const hit = labPos.find(l => {
      if (l.used || famOf(l.h.testType) !== famOf(e.testType)) return false;
      if (e.room && l.h.room && e.room !== l.h.room) return false;
      if (!e.date || !l.h.date) return false;
      if (e.dateExplicit ? Math.abs(dayNum(e.date) - dayNum(l.h.date)) > 3 : hubWeekKey(l.h.date) !== (e.reportWeek || hubWeekKey(e.date))) return false;
      if (ew.length === 0) return false;
      return ew.filter(w => l.set[w]).length / ew.length >= 0.6;
    });
    if (hit) {
      hit.used = true;
      matched.push({ email: e, lab: hit.h });
    } else {
      emailOnly.push({ ...e, emailOnly: true });
    }
  });
  return { emailOnly, matched };
}

// One pasted QA email against the lab rows of the week it reports on (routine Listeria swabs). The email and the lab
// file are pulled at different times, so a swab gap of up to 5 swabs (or 5%) still agrees; positives must match.
// status: 'agree' | 'differ' | 'no_email' (no totals line pasted for the week) | 'no_lab' (no finished lab rows)
function compareEmailWeekToLab(emailReport, labBucket) {
  const s = emailReport && emailReport.summary;
  const emLis = s && s.totalLis && s.totalLis.total > 0 ? s.totalLis : null;
  const labLis = labBucket && labBucket.lis && labBucket.lis.swabs > 0 ? labBucket.lis : null;
  if (!emLis) return { status: 'no_email', emLis: null, labLis, posGap: 0, swabGap: 0 };
  if (!labLis) return { status: 'no_lab', emLis, labLis: null, posGap: 0, swabGap: 0 };
  const posGap = emLis.positives - labLis.positives;
  const swabGap = emLis.total - labLis.swabs;
  const agree = posGap === 0 && Math.abs(swabGap) <= Math.max(5, emLis.total * 0.05);
  return { status: agree ? 'agree' : 'differ', emLis, labLis, posGap, swabGap };
}

// =======================================================================
// IMPORT CHECK (top of the Data Manipulation tab; the calendar's "Import check" button opens it)
// =======================================================================
// Can the saved swab rows be trusted, and does each pasted QA email agree with the lab rows of its week?
// verdict: 'reupload' = some rows can only be fixed by loading the lab files again; 'check' = the numbers are usable
// but an item needs a look; 'ok' = nothing found; 'empty' = no lab rows loaded.
// Each item: { id, level: 'bad' | 'warn' | 'info', n, examples (up to 6 lines of real row text) }. The panel words them.
function buildImportCheck(parsedCsv, parsedPrompt, emailLabMatch, opts) {
  const o = opts || {};
  const pc = parsedCsv || {};
  const rows = Array.isArray(pc.rows) ? pc.rows : [];
  const t = pc.totals || {};
  const items = [];
  const rowText = (r) => `${r.date || '(no date)'}  ${r.sampleId || '(no ID)'}  ${String(r.sampleDesc || '').replace(/\s+/g, ' ').slice(0, 90)}`;
  const examplesOf = (pred, fmt) => {
    const out = [];
    for (let i = 0; i < rows.length && out.length < 6; i += 1) {
      if (pred(rows[i])) out.push((fmt || rowText)(rows[i]));
    }
    return out;
  };
  const topValues = (pred, keyOf) => {
    const m = {};
    rows.forEach(r => {
      if (!pred(r)) return;
      const k = keyOf(r);
      m[k] = (m[k] || 0) + 1;
    });
    return Object.keys(m).sort((a, b) => m[b] - m[a]).slice(0, 6).map(k => `${k}  (${m[k]})`);
  };
  const add = (id, level, n, examples, extra) => {
    if (n > 0) items.push({ id, level, n, examples: examples || [], ...(extra || {}) });
  };

  // 1. Rows only a re-upload fixes
  add('reupload_rows', 'bad', t.needsReuploadCount || 0, examplesOf(r => r.needsReupload, r => `${rowText(r)}  [${(r.mergedTests || []).join(' + ')}]`));
  const cleanup = o.cleanupReport || null;
  if (cleanup && cleanup.before > 0) add('older_ledger', 'bad', cleanup.before, [], { report: cleanup });

  // 2. Rows to look at
  add('unread', 'warn', t.unreadCount || 0, topValues(r => r.resultUnread, r => `"${String(r.rawResult || '').trim()}"`));
  add('future', 'warn', t.futureCount || 0, examplesOf(r => r.dateFlag === 'future' || (!!r.date && r.date > LIVE_TODAY_DATE_KEY)));
  add('undated', 'warn', t.undatedCount || 0, examplesOf(r => !r.date, r => `${r.rawDate ? `"${r.rawDate}"  ` : ''}${r.sampleId || '(no ID)'}  ${String(r.sampleDesc || '').replace(/\s+/g, ' ').slice(0, 90)}`));
  add('other_kind', 'warn', (pc.kinds && pc.kinds.other) || 0, examplesOf(r => (r.swabKind || swabKindOf(r)) === 'other'));
  add('unknown_area', 'warn', t.unknownAreaCount || 0, topValues(r => r.areaUnknown, r => r.areaCode || '?'));
  add('guessed_test', 'warn', t.guessedTestCount || 0, examplesOf(r => r.testGuessed));
  add('conflict', 'warn', t.conflictCount || 0, examplesOf(r => r.resultConflict, r => `${rowText(r)}  [${(r.resultHistory || []).join(' / ')} -> ${r.result}]`));
  add('manual', 'warn', t.manualCount || 0, examplesOf(r => r.manualResult, r => `${rowText(r)}  [${r.result}]`));
  const sameId = Array.isArray(pc.sameDaySiteCollisions) ? pc.sameDaySiteCollisions : [];
  add('same_id', 'warn', sameId.length, sameId.slice(0, 6).map(g => `${g.sampleId}  (${g.records.length} rows)`));
  const staleDay = addDays(LIVE_TODAY_DATE_KEY, -10);
  const isStale = (r) => r.result === 'Pending' && !!r.date && r.date < staleDay;
  let staleN = 0;
  rows.forEach(r => { if (isStale(r)) staleN += 1; });
  add('stale_pending', 'warn', staleN, examplesOf(isStale));

  // 3. Each pasted QA email against the lab rows of the same week (Monday to Sunday), plus last week and this week
  const reports = (parsedPrompt && Array.isArray(parsedPrompt.reports)) ? parsedPrompt.reports : [];
  const weekSet = {};
  reports.forEach(rp => { if (rp.weekKey) weekSet[rp.weekKey] = true; });
  weekSet[LIVE_LAST_WEEK_START] = true;
  weekSet[LIVE_CURRENT_WEEK_START] = true;
  const emailOnly = (emailLabMatch && Array.isArray(emailLabMatch.emailOnly)) ? emailLabMatch.emailOnly : [];
  const weeks = Object.keys(weekSet).sort().map(wk => {
    const b = (pc.byWeek && pc.byWeek[wk]) || null;
    const em = (parsedPrompt && parsedPrompt.byWeek && parsedPrompt.byWeek[wk]) || null;
    const eo = emailOnly.filter(h => (h.reportWeek || hubWeekKey(h.date || LIVE_TODAY_DATE_KEY)) === wk);
    const emApc = em && em.summary && em.summary.apc && em.summary.apc.total > 0 ? em.summary.apc : null;
    return {
      weekKey: wk,
      cmp: compareEmailWeekToLab(em, b),
      hasEmail: !!em,
      labRows: b ? b.totalRows : 0,
      labPending: b ? b.pending : 0,
      labApc: b && b.apc && b.apc.swabs > 0 ? b.apc : null,
      emailApc: emApc,
      emailOnly: eo.length,
      emailOnlyExamples: eo.slice(0, 4).map(h => `${h.date || ''}  ${h.room || ''}: ${h.surface || ''} ${h.description || ''}`.trim())
    };
  });
  const differ = weeks.filter(w => w.cmp.status === 'differ');
  add('week_differ', 'warn', differ.length, differ.map(w => w.weekKey));
  let eoLabN = 0;
  let eoLabEx = [];
  weeks.forEach(w => {
    if (w.emailOnly > 0 && w.labRows > 0) {
      eoLabN += w.emailOnly;
      eoLabEx = eoLabEx.concat(w.emailOnlyExamples);
    }
  });
  add('email_only_lab', 'warn', eoLabN, eoLabEx.slice(0, 6));
  add('email_only_nolab', 'info', emailOnly.length - eoLabN, []);

  // 4. Notes that never change a rate
  add('typed_yoy', 'info', o.typedYoYCells || 0, []);
  add('typed_yoy_example', 'info', o.exampleYoYCells || 0, []);
  add('legacy_dv', 'info', o.legacyDvRows || 0, []);
  add('over_limit', 'info', t.overLimitCount || 0, topValues(r => r.overLimit, r => `${r.testCode || ''}: "${String(r.rawResult || '').trim()}"`));
  add('counts', 'info', t.totalCounts || 0, [], { apcAtp: t.countsApcAtp || 0 });
  const restore = o.restoreReport || null;
  const restoredChars = restore ? ((restore.email && restore.email.restoredChars) || 0) + ((restore.csv && restore.csv.restoredChars) || 0) : 0;
  add('restored_paste', 'info', restoredChars > 0 ? 1 : 0, [], { report: restore });

  const years = Object.keys(pc.byYear || {}).sort().map(y => {
    const by = pc.byYear[y];
    return { year: y, rows: by.total, swabs: by.routine.swabs, positives: by.routine.positives, rate: tallyRate(by.routine), pending: by.pending };
  });
  const hasBad = items.some(i => i.level === 'bad');
  const hasWarn = items.some(i => i.level === 'warn');
  return {
    verdict: rows.length === 0 ? 'empty' : (hasBad ? 'reupload' : (hasWarn ? 'check' : 'ok')),
    rowsTotal: rows.length,
    kinds: pc.kinds || {},
    years,
    weeks,
    matchedEmailHits: (emailLabMatch && Array.isArray(emailLabMatch.matched)) ? emailLabMatch.matched.length : 0,
    items
  };
}

// The rate a row counts toward: 'pathogen' (Listeria, Salmonella), 'apc', 'atp', or '' (coliform, yeast/mold, other)
function rateCategoryOf(r) {
  const c = String((r && r.testCode) || '').toUpperCase();
  if (c === 'LIS' || c === 'SAL') return 'pathogen';
  if (c === 'APC') return 'apc';
  if (c === 'ATP') return 'atp';
  return '';
}

// What-if for the Data Manipulation tab, on this year's lab rows (the rows behind the rates: finished routine and
// indicator swabs, not set by hand). cuts = { rooms: { WJ: 30 }, stages: { ST: 20, INP: 10 } } = the share (%) of the
// positives in that slice a fix would have prevented. A positive in two slices stays positive with chance
// (1 - room cut) x (1 - stage cut), so two sliders never remove more than the swab. Swab counts stay the same.
function simulatePositiveCuts(rows, cat, cuts) {
  const c = cuts || {};
  const roomCuts = c.rooms || {};
  const stageCuts = c.stages || {};
  const yr = String(LIVE_CURRENT_YEAR);
  const pctOf = (v) => Math.min(100, Math.max(0, Number(v) || 0)) / 100;
  const blank = () => ({ swabs: 0, positives: 0, sim: 0 });
  const acc = { overall: blank(), stages: { ST: blank(), INP: blank() }, sides: { Creme: blank(), Bakery: blank() }, rooms: {} };
  const addTo = (b, pos, keep) => {
    b.swabs += 1;
    if (pos) { b.positives += 1; b.sim += keep; }
  };
  (rows || []).forEach(r => {
    if (!r || !r.date || r.date.slice(0, 4) !== yr || r.date > LIVE_TODAY_DATE_KEY || r.manualResult) return;
    const call = rateCallOf(r);
    if (!call) return;
    const kind = r.swabKind || swabKindOf(r);
    if (kind !== 'routine' && kind !== 'indicator') return;
    const rc = rateCategoryOf(r);
    if (!rc || (cat !== 'all' && rc !== cat)) return;
    const pos = call === 'fail';
    const stage = r.stage === 'ST' || r.stage === 'INP' ? r.stage : '';
    const keep = (1 - pctOf(roomCuts[r.room])) * (1 - (stage ? pctOf(stageCuts[stage]) : 0));
    addTo(acc.overall, pos, keep);
    if (stage) addTo(acc.stages[stage], pos, keep);
    const dept = (ROOM_META[r.room] && ROOM_META[r.room].dept) || '';
    if (acc.sides[dept]) addTo(acc.sides[dept], pos, keep);
    if (!acc.rooms[r.room]) acc.rooms[r.room] = blank();
    addTo(acc.rooms[r.room], pos, keep);
  });
  const fin = (b) => ({
    swabs: b.swabs,
    positives: b.positives,
    simPositives: Math.round(b.sim * 10) / 10,
    rate: b.swabs > 0 ? round2((b.positives / b.swabs) * 100) : null,
    simRate: b.swabs > 0 ? round2((b.sim / b.swabs) * 100) : null
  });
  const res = { overall: fin(acc.overall), stages: {}, sides: {}, rooms: {} };
  Object.keys(acc.stages).forEach(k => { res.stages[k] = fin(acc.stages[k]); });
  Object.keys(acc.sides).forEach(k => { res.sides[k] = fin(acc.sides[k]); });
  Object.keys(acc.rooms).forEach(k => { res.rooms[k] = fin(acc.rooms[k]); });
  return res;
}

// Typed YoY table cells only fill months the ledger has no finished swabs for (for example last year's months from
// before the first upload). A month with swabs always shows its real rate, so a saved table can never freeze the
// graphs again, and this year's future months are never filled. ignoredCells = typed values that differ from a real
// rate and are no longer used.
const YOY_TYPED_FIELDS = ['pathogenTY', 'pathogenLY', 'apcTY', 'apcLY', 'inpTY', 'stTY', 'cremeTY', 'bakeryTY'];
// Cells of the YoY table v2.0 started with (example numbers, not lab results), as hashes of month + column + value.
// A table saved from v2.0 still holds them; they never fill a month (exampleCells counts them for the Import check).
const EXAMPLE_YOY_CELL_SIGS = {
  '1e84db16-e5be': 1, '69a2bcdb-653f': 1, 'bcdac82e-44c0': 1, '0334bbc7-e8db': 1,
  '3c559eef-ace0': 1, '3f918950-0591': 1, '4c2653d4-8d52': 1, '5a7e1fe9-1ace': 1,
  'e8f53978-4898': 1, '3b90ed47-2769': 1, '79e765ab-5530': 1, 'd8b79c44-1b53': 1,
