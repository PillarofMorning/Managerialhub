// =======================================================================
// MAIN APPLICATION COMPONENT
// =======================================================================
// =======================================================================
// [_b_ SWAB RESULT - DATAVERSE ROWS] (data contract 1.0, sections 2, 3.3 and 13)
// Every loaded swab result is saved as one row of "_b_ Swab result" so the Manager hub, Ganttly and the
// MSS apps read the same hits. Row id = hubIdFromKey('swab|' + sample key), so saving again (or from a
// second computer) updates the same row. Area = exact craa5_aa_mss_area.craa5_area name, equipment =
// craa5_aa_assets GUID, both taken from the swab site links (never guessed from similar spellings).
// A positive is closed by an MSS log row (craa5__log_) with craa5_pathogen = Yes on the same piece or
// area on or after the collection date (craa5_cleankind = corrective when that column exists).
// =======================================================================
const SWAB_TABLE_CANDIDATES = [
  { set: 'craa5__b_swabresults', id: 'craa5__b_swabresultid' },
  { set: 'craa5_b_swabresults', id: 'craa5_b_swabresultid' }
];
const MSS_LOG_SET = 'craa5__log_s';
const MSS_AREA_SET = 'craa5_aa_mss_areas';
const SWAB_COLUMNS = [
  'craa5_name', 'craa5_sampleid', 'craa5_sampledescription', 'craa5_testmethod', 'craa5_rawresult',
  'craa5_collectiondate', 'craa5_result', 'craa5_test', 'craa5_stage', 'craa5_sitecode', 'craa5_swabzone',
  'craa5_area', 'craa5_room', 'craa5_sapw', 'craa5_equipmentguid', 'craa5_assettag', 'craa5_surface',
  'craa5_closedkey', 'craa5_closedon', 'craa5_source'
];
const SITE_LINK_COLUMNS = ['craa5_sitecode', 'craa5_area', 'craa5_equipmentguid', 'craa5_sapw'];
const AREA_ALIAS_CONFIG_KEY = 'PATHOGEN_BOLO_AREA_ALIASES';

// Source text of a result set by hand in the app, so it stays out of the rates after a trip through Dataverse
const SWAB_SOURCE_HAND = 'Pathogen BOLO - set by hand';

// positive / negative / pending (contract section 8, item 7); count = a number from the lab with no pass/fail call;
// replaced = a row saved under the v2.2 key (no test) whose v2.3 row is saved
function swabResultWord(r) {
  if (!r) return 'pending';
  if (r.result === 'Positive') return 'positive';
  if (r.result === 'Negative') return 'negative';
  if (r.result === 'Count') return 'count';
  return 'pending';
}

// The key that identifies one row: Sample ID + Sample Description + test (the app's duplicate rule since v2.3)
function swabRowKey(r) {
  if (!r) return '';
  if (r.idAndDescKey) return r.idAndDescKey;
  return ['NOID', r.date || '', r.siteCode || '', r.testCode || '', normToken(r.sampleDesc || r.description || '')].join('|');
}
function swabRowId(r) { return hubIdFromKey('swab|' + swabRowKey(r)); }

// Area / room / equipment / SAP work area for a row, from (1) the swab site link, (2) the zone-to-area alias,
// (3) what the row already has stored in Dataverse. A blank link never wipes a stored value.
function resolveSwabLinks(r, ctx) {
  const c = ctx || {};
  const link = (r.siteCode && c.siteLinks && c.siteLinks[r.siteCode]) || {};
  const equipmentguid = hubGuid(link.equipmentguid || r.dvEquipmentGuid || '');
  const asset = equipmentguid && c.assetsById ? c.assetsById[equipmentguid] : null;
  const area = link.area || (c.zoneAreas && c.zoneAreas[r.room]) || (asset && asset.area) || r.dvArea || '';
  const areaRow = area && c.areasByCanon ? c.areasByCanon[hubCanon(area)] : null;
  return {
    area,
    room: (areaRow && areaRow.room) || (asset && asset.room) || r.dvRoom || '',
    equipmentguid,
    sapw: link.sapw || (asset && asset.sapw) || r.dvSapw || ''
  };
}

function buildSwabPayload(r, ctx) {
  const links = resolveSwabLinks(r, ctx);
  const closure = (ctx && ctx.closures && ctx.closures[swabRowKey(r)]) || null;
  const methods = Array.isArray(r.testMethods) && r.testMethods.length > 0 ? r.testMethods.join(' / ') : (r.testMethod || '');
  return {
    craa5_name: String(`${r.sampleId || 'NO ID'} ${r.siteCode || ''}`).trim().slice(0, 200),
    craa5_sampleid: String(r.sampleId || '').slice(0, 100),
    craa5_sampledescription: String(r.sampleDesc || '').slice(0, 4000),
    craa5_testmethod: String(methods).slice(0, 200),
    craa5_rawresult: String(r.rawResult || '').slice(0, 100),
    craa5_collectiondate: r.date || '',
    craa5_result: swabResultWord(r),
    craa5_test: r.testCode === 'LIS' && r.stage === 'RETEST' ? 'RETEST-LIS' : String(r.testCode || ''),
    craa5_stage: String(r.stage || ''),
    craa5_sitecode: String(r.siteCode || ''),
    craa5_swabzone: String(r.room || ''),
    craa5_area: links.area,
    craa5_room: links.room,
    craa5_sapw: links.sapw,
    craa5_equipmentguid: links.equipmentguid,
    craa5_assettag: String(r.assetTag || ''),
    craa5_surface: String(r.surface || ''),
    craa5_closedkey: (closure && closure.key) || r.dvClosedKey || '',
    craa5_closedon: (closure && closure.day) || r.dvClosedOn || '',
    craa5_source: r.manualResult ? SWAB_SOURCE_HAND : (r.dvSource && r.dvSource !== SWAB_SOURCE_HAND ? r.dvSource : 'Pathogen BOLO')
  };
}

// Stable text of a payload (or of a stored record) for "has this row changed since it was saved?"
function swabPayloadHash(obj, cols) {
  return (cols || SWAB_COLUMNS).map(k => `${k}=${obj && obj[k] !== undefined && obj[k] !== null ? obj[k] : ''}`).join('\u0001');
}

// A stored row back into a ledger row: the raw lab fields are parsed again with the same rules as an upload,
// so a row read from Dataverse looks exactly like the row that was uploaded.
function swabRowFromRecord(rec, rulesCompiled, aliases, idx) {
  const cols = [
    rec.craa5_collectiondate || '',
    rec.craa5_sampleid || '',
    rec.craa5_sampledescription || '',
    rec.craa5_testmethod || '',
    rec.craa5_rawresult || ''
  ];
  const r = parseSingleCsvRow(cols, idx || 0, rulesCompiled, aliases);
  if (!r) return null;
  if (Array.isArray(r.testMethods) && r.testMethods.length === 1 && r.testMethods[0].indexOf(' / ') !== -1) {
    r.testMethods = r.testMethods[0].split(' / ');
  }
  r.dvArea = rec.craa5_area || '';
  r.dvRoom = rec.craa5_room || '';
  r.dvSapw = rec.craa5_sapw || '';
  r.dvEquipmentGuid = hubGuid(rec.craa5_equipmentguid || '');
  r.dvClosedKey = rec.craa5_closedkey || '';
  r.dvClosedOn = rec.craa5_closedon || '';
  r.dvSource = rec.craa5_source || '';
  r.fromDataverse = true;
  if (r.dvSource === SWAB_SOURCE_HAND) r.manualResult = true;
  // A v2.2 row that held two tests (methods joined with " / ") cannot be split: it waits for the lab file
  if (Array.isArray(r.testMethods) && r.testMethods.length > 1) {
    const codes = [];
    r.testMethods.forEach(m => {
      const c = normalizeTestProgramCode(m, '');
      if (codes.indexOf(c) === -1) codes.push(c);
    });
    if (codes.length > 1) {
      r.needsReupload = true;
      r.mergedTests = codes;
    }
  }
  return r;
}

// Which positives does an MSS log row close? Same piece (equipment GUID) or, when the hit has no piece, same area,
// on or after the collection date. logRows: [{ key, day, equipmentguid, area }]
function findSwabClosures(ledgerRows, logRows, ctx) {
  const out = {};
  const logs = (logRows || []).slice().sort((a, b) => String(a.day).localeCompare(String(b.day)));
  (ledgerRows || []).forEach(r => {
    if (!r || r.result !== 'Positive' || !r.date) return;
    const links = resolveSwabLinks(r, ctx);
    if (!links.equipmentguid && !links.area) return;
    for (let i = 0; i < logs.length; i += 1) {
      const l = logs[i];
      if (!l.day || l.day < r.date) continue;
      const samePiece = links.equipmentguid && l.equipmentguid && l.equipmentguid === links.equipmentguid;
      const sameArea = !links.equipmentguid && links.area && hubSameName(l.area, links.area);
      if (samePiece || sameArea) {
        out[swabRowKey(r)] = { key: l.key, day: l.day };
        break;
      }
    }
  });
  return out;
}

// Read every page of an OData query (Dataverse returns @odata.nextLink while more rows remain)
async function fetchAllPages(firstUrl, maxRows) {
  const rows = [];
  let url = firstUrl;
  while (url && rows.length < (maxRows || 200000)) {
    const res = await fetch(url, { headers: { ...ODATA_HEADERS, Prefer: 'odata.maxpagesize=5000' } });
    if (!res.ok) throw new Error(await readApiError(res));
    const data = await res.json();
    (data.value || []).forEach(v => rows.push(v));
    url = data['@odata.nextLink'] || '';
  }
  return rows;
}

// PATCH one row; when Dataverse names a column that does not exist, drop it and try again.
// Returns { ok, missing: [columns dropped], error }
async function patchRowDroppingMissing(entitySet, rowId, body) {
  const bodyObj = { ...body };
  const missing = [];
  for (let step = 0; step < 12; step += 1) {
    let res;
    try {
      res = await fetch(apiUrl(`${entitySet}(${rowId})`), {
        method: 'PATCH',
        headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyObj)
      });
    } catch (e) {
      return { ok: false, missing, error: e.message || 'Network error' };
    }
    if (res.ok) return { ok: true, missing };
    let errText = '';
    try { errText = await res.clone().text(); } catch (e) { /* ignore */ }
    const m = errText.match(/property\s+'([^']+)'/i) || errText.match(/attribute\s+'([^']+)'/i) || errText.match(/named\s+'([^']+)'/i);
    if (m && m[1] && Object.prototype.hasOwnProperty.call(bodyObj, m[1])) {
      delete bodyObj[m[1]];
      missing.push(m[1]);
      continue;
    }
    return { ok: false, missing, error: await readApiError(res) };
  }
  return { ok: false, missing, error: 'Too many missing columns' };
}

// ---------- Hub config (data contract section 12) ----------
// Shared settings: one row per craa5_configkey, and BOLO writes only its PATHOGEN_BOLO_ keys. The new _e_ Hub config
// comes first (Organization-owned, its craa5_configjson holds 1,048,576 characters), the old _0_ hubconfig second. On
// the old table the JSON goes in craa5_manifestjson, because its craa5_configjson holds only 100 characters. A row
// with empty JSON means "no settings yet" (the Dataverse monitor may make the row first): the app keeps its defaults.
const BOLO_CONFIG_SPOTS = [
  { table: HUB_CONFIG_TABLES[0], col: 'craa5_configjson', max: 0 },
  { table: HUB_CONFIG_TABLES[1], col: HUB_MANIFEST_COL, max: 0 },
  { table: HUB_CONFIG_TABLES[1], col: 'craa5_configjson', max: 100 }
];
const BOLO_CONFIG_PREFIX = 'PATHOGEN_BOLO_';
let boloConfigSpotFound = null;
let boloConfigReading = null;

// Where settings are saved: the first spot Dataverse answers for. A table or column that is not there (or not open
// to this user) moves on to the next; a network failure is thrown, so the save shows as failed and lands nowhere else.
async function boloConfigSpot() {
  if (boloConfigSpotFound) return boloConfigSpotFound;
  let lastError = '';
  for (let i = 0; i < BOLO_CONFIG_SPOTS.length; i += 1) {
    const sp = BOLO_CONFIG_SPOTS[i];
    const res = await fetch(apiUrl(`${sp.table}s?$select=${sp.table}id,craa5_configkey,${sp.col}&$top=1`), { headers: ODATA_HEADERS });
    if (res.ok) {
      boloConfigSpotFound = sp;
      return sp;
    }
    lastError = await readApiError(res);
  }
  throw new Error(`No Hub config table could be read (${lastError})`);
}

// For the event log: where the settings went
function boloConfigWhere() {
  const sp = boloConfigSpotFound;
  return sp ? `${sp.table} ${sp.col}` : 'Hub config';
}

// Every saved BOLO setting as { values: { KEY: json text }, where: { KEY: table }, tables: [read], errors: [] }.
// Both tables are read and, per key, the first non-empty JSON wins, new table first. Key = craa5_configkey, or
// craa5_configname for old rows with a blank key. One read per page load, shared by every reader until a save.
function boloReadConfigs() {
  if (boloConfigReading) return boloConfigReading;
  boloConfigReading = (async () => {
    const out = { values: {}, where: {}, tables: [], errors: [] };
    const filter = `statecode eq 0 and (startswith(craa5_configkey,'${BOLO_CONFIG_PREFIX}') or startswith(craa5_configname,'${BOLO_CONFIG_PREFIX}'))`;
    for (let i = 0; i < HUB_CONFIG_TABLES.length; i += 1) {
      const table = HUB_CONFIG_TABLES[i];
      let rows;
      try {
        rows = await fetchAllPages(apiUrl(`${table}s?$filter=${filter}`), 500);
      } catch (e) {
        out.errors.push(`${table}: ${e.message}`);
        continue;
      }
      out.tables.push(table);
      rows.forEach(row => {
        const key = (String(row.craa5_configkey || '').trim() || String(row.craa5_configname || '').trim()).toUpperCase();
        const raw = hubConfigJsonOf(row).trim();
        if (!key || !raw || Object.prototype.hasOwnProperty.call(out.values, key)) return;
        out.values[key] = raw;
        out.where[key] = table;
      });
    }
    return out;
  })();
  return boloConfigReading;
}

// Save one BOLO setting. The row is found by key (or by name for old rows with a blank key); a new row gets the fixed
// id hubIdFromKey('hubconfig|' + key), so a second computer saving at the same time still makes one row.
async function boloSaveConfig(key, obj) {
  const sp = await boloConfigSpot();
  const json = JSON.stringify(obj === undefined ? null : obj);
  if (sp.max && json.length > sp.max) {
    throw new Error(tr(
      `Hub config can only hold ${sp.max} characters here and this setting needs ${json.length}. Create the "_e_ Hub config" table (data contract table prompts, part 8), then save again.`,
      `Hub config aqui solo guarda ${sp.max} caracteres y este ajuste necesita ${json.length}. Cree la tabla "_e_ Hub config" (indicaciones de tablas del contrato de datos, parte 8) y guarde otra vez.`
    ));
  }
  const set = `${sp.table}s`;
  const idCol = `${sp.table}id`;
  const res = await fetch(apiUrl(`${set}?$select=${idCol},craa5_configkey,craa5_configname&$filter=statecode eq 0 and (craa5_configkey eq '${key}' or craa5_configname eq '${key}')&$top=5`), { headers: ODATA_HEADERS });
  if (!res.ok) throw new Error(await readApiError(res));
  const rows = (await res.json()).value || [];
  const row = rows.filter(r => String(r.craa5_configkey || '').trim().toUpperCase() === key.toUpperCase())[0] || rows[0];
  const id = row ? hubGuid(row[idCol]) : hubIdFromKey(`hubconfig|${key}`);
  const body = { craa5_configkey: key, craa5_configname: key };
  body[sp.col] = json;
  const save = await fetch(apiUrl(`${set}(${id})`), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (!save.ok) throw new Error(await readApiError(save));
  boloConfigReading = null;
  return sp;
}

