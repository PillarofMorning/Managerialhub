  // Swab results as Dataverse rows (_b_ Swab result) + links to MSS areas, equipment and the MSS log
  const canWriteSwabs = isDevAuthorized || !!(activeUserProfile && activeUserProfile.accessControl && activeUserProfile.accessControl.canIngestData);
  const swabLink = useSwabDataverse({ ledgerRows: parsedCsv.rows, setHistoricalLedger, regexRules, roomAliases, canWrite: canWriteSwabs, logEvent });

  // Handler to ingest bulk CSV text or scheduled email table rows with chunked progress + deduplication
  const ingestRawTextIntoLedger = useCallback((rawText, sourceLabel = 'Scheduled Email / Bulk CSV', mode = 'merge') => {
    const text = String(rawText || '').trim();
    if (!text) return null;

    // A weekly QA email ("Total LIS:" / "Daily Swabs" / "Retest -") goes to the email box; anything else is lab rows
    const looksLikeBoloPrompt = /Total\s+LIS:|Daily\s+Swabs|Monthly\s+Pathogens|Daily\/Weekly\s+(?:APC|ATP)/i.test(text);
    if (looksLikeBoloPrompt && mode !== 'csv_only') {
      setPromptText(prev => (mode === 'replace' || !String(prev || '').trim() ? text : `${prev}\n\n${text}`));
      const promptCheck = parseWeeklyEmails(text, regexRules, roomAliases, baseSiteCatalog);
      const weeks = promptCheck.reports.map(r => formatWeekRangeLabel(r.weekKey, true)).join('; ');
      const rec = {
        timestamp: new Date().toLocaleTimeString(),
        sourceLabel: `${sourceLabel} (weekly email${promptCheck.reports.length > 1 ? `s x${promptCheck.reports.length}` : ''})`,
