// =======================================================================
// VIEW 6: SWAB CATALOG & CSV EXPLORER (All 204+ 0320- Sites)
// =======================================================================
function SwabCatalogExplorerView({
  darkMode,
  theme,
  fullSiteCatalog,
  allHits,
  parsedCsv,
  onLocateOnMap,
  swabLink,
  canEditLinks,
  onSaveZones
}) {
  const [query, setQuery] = useState('');
  const [roomFilter, setRoomFilter] = useState('ALL');

  const hitCountBySite = useMemo(() => {
    const map = {};
    allHits.forEach(h => {
      if (h.siteCode) map[h.siteCode] = (map[h.siteCode] || 0) + 1;
    });
    return map;
  }, [allHits]);

  const filteredSites = useMemo(() => {
    const q = query.trim().toLowerCase();
    return fullSiteCatalog.filter(s => {
      if (roomFilter !== 'ALL' && s.room !== roomFilter) return false;
      if (!q) return true;
      const hay = `${s.siteCode} ${s.areaCode} ${s.room} ${s.surface} ${s.description} ${s.assetTag}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [fullSiteCatalog, query, roomFilter]);

  return localizeReactTree((
    <div className="h-full flex flex-col overflow-hidden p-4 sm:p-5 gap-4">
      <div className={`shrink-0 rounded-xl border p-4 flex flex-wrap items-center justify-between gap-3 shadow-xs ${theme.bgCard}`}>
        <div>
          <h2 className={`text-base sm:text-lg font-black ${theme.textHeading}`}>
            Stillwell 0320- Environmental Swab Catalog ({filteredSites.length} of {fullSiteCatalog.length} Sites)
          </h2>
          <p className={`text-xs ${theme.textMuted}`}>
            Complete catalog extracted from the lab results export with Area Code, Surface, Description, Equipment Asset Tag, and Map Coordinates.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <input
            type="search"
            value={query}
            onChange={e => setQuery(e.target.value)}
            placeholder="Search 0320- code, surface, description, OK tag..."
            className={`w-64 rounded-lg border px-3 py-1.5 text-xs ${theme.bgInput}`}
          />
          <select
            value={roomFilter}
            onChange={e => setRoomFilter(e.target.value)}
            className={`rounded-lg border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
          >
            <option value="ALL">All Rooms ({fullSiteCatalog.length})</option>
            {Object.keys(ROOM_META).map(r => (
              <option key={r} value={r}>{ROOM_META[r].label}</option>
            ))}
          </select>
        </div>
      </div>

      {swabLink && (
        <SwabLinkSetupPanel
          theme={theme}
          canEdit={!!canEditLinks}
          mssAreas={swabLink.mssAreas}
          zoneAreas={swabLink.zoneAreas}
          zoneAreasSaved={swabLink.zoneAreasSaved}
          onSaveZones={onSaveZones}
        />
      )}

      <div className={`flex-1 min-h-0 rounded-xl border shadow-xs overflow-auto pb-32 ${theme.bgCard}`}>
        <table className="w-full text-left border-collapse text-xs">
          <thead className={`sticky top-0 z-10 border-b uppercase text-[10px] font-extrabold tracking-wider ${theme.bgSubtle}`}>
            <tr>
              <th className="py-2.5 px-3">0320- Site Code</th>
              <th className="py-2.5 px-3">Canonical Room</th>
              <th className="py-2.5 px-3">CSV Area</th>
              <th className="py-2.5 px-3">Surface</th>
              <th className="py-2.5 px-3">Swab Location Description</th>
              <th className="py-2.5 px-3">Equipment Tag</th>
              {swabLink && <th className="py-2.5 px-3">MSS Area</th>}
              {swabLink && <th className="py-2.5 px-3">MSS Equipment</th>}
              <th className="py-2.5 px-3 text-center">BOLO Hits</th>
              <th className="py-2.5 px-3 text-right">Map Location</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-200 dark:divide-slate-800">
            {filteredSites.map(site => {
              const hits = hitCountBySite[site.siteCode] || 0;
              return (
                <tr key={site.siteCode} className={darkMode ? 'hover:bg-slate-800/50' : 'hover:bg-slate-50'}>
                  <td className="py-2 px-3 font-mono font-bold text-[#0072CE] dark:text-sky-300 whitespace-nowrap">
                    {site.siteCode}
                  </td>
                  <td className="py-2 px-3 font-bold whitespace-nowrap">{site.room}</td>
                  <td className="py-2 px-3 font-mono text-[11px]">{site.areaCode}</td>
                  <td className="py-2 px-3 font-bold">{site.surface}</td>
                  <td className="py-2 px-3">{site.description}</td>
                  <td className="py-2 px-3 font-mono">
                    {site.assetTag ? (
                      <span className="px-2 py-0.5 rounded bg-sky-100 text-sky-900 font-bold text-[11px]">{site.assetTag}</span>
                    ) : '-'}
                  </td>
                  {swabLink && (
                    <SiteLinkCells
                      site={site}
                      theme={theme}
                      canEdit={!!canEditLinks}
                      mssAreas={swabLink.mssAreas}
                      assets={swabLink.assets}
                      link={swabLink.siteLinks[String(site.siteCode || '').toUpperCase()]}
                      zoneArea={swabLink.zoneAreas[site.room] || ''}
                      onSave={swabLink.saveSiteLink}
                    />
                  )}
                  <td className="py-2 px-3 text-center">
                    {hits > 0 ? (
                      <span className="px-2 py-0.5 rounded-full bg-[#E4002B] text-white font-black text-[10px]">
                        {hits} Hit{hits === 1 ? '' : 's'}
                      </span>
                    ) : (
                      <span className={theme.textMuted}>0</span>
                    )}
                  </td>
                  <td className="py-2 px-3 text-right whitespace-nowrap">
                    <button
                      type="button"
                      onClick={() => onLocateOnMap({ siteCode: site.siteCode, room: site.room })}
                      className="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[#0072CE] text-white font-bold hover:bg-[#00468B]"
                    >
                      <MapPinIcon className="w-3 h-3" /> ({site.effectiveSpot.x}%, {site.effectiveSpot.y}%)
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div className="h-28 shrink-0" aria-hidden="true" />
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

