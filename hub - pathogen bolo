  const testsArr = Array.isArray(rawVp.onlyShowTests)
    ? rawVp.onlyShowTests.filter(t => t && t !== 'ALL')
    : (Array.isArray(rawVp.onlySeeTests) ? rawVp.onlySeeTests.filter(t => t && t !== 'ALL') : []);

  const mergedViewPreferences = {
    ...rawVp,
    onlyShowRooms: roomsArr,
    onlySeeRooms: roomsArr.length > 0 ? roomsArr : ['ALL'],
    onlyShowTests: testsArr,
    onlySeeTests: testsArr.length > 0 ? testsArr : ['ALL'],
    visibleWidgets: {
      ...DEFAULT_VISIBLE_WIDGETS,
      ...(profileObj && profileObj.defaultViewPreferences && profileObj.defaultViewPreferences.visibleWidgets ? profileObj.defaultViewPreferences.visibleWidgets : {}),
      ...(existingUser && existingUser.viewPreferences && existingUser.viewPreferences.visibleWidgets ? existingUser.viewPreferences.visibleWidgets : {})
    }
  };

  const isLocked = existingUser ? !!(existingUser.lockedByAdmin || existingUser.enforceAdminLock) : false;
  const userRec = {
    microsoftId: msId,
    userName: (existingUser && existingUser.userName) || (msIdentity && msIdentity.userName) || msId,
    email: (existingUser && existingUser.email) || (msIdentity && msIdentity.email) || `${msId.toLowerCase()}@schwans.com`,
    domainAccount: (existingUser && existingUser.domainAccount) || `SCHWANS\\${msId}`,
    assignedRoleProfile: assignedKey,
