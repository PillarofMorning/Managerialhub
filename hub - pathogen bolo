  }, [isBareMapActive, currentActiveAreas.length, configuredActiveAreas, visibleFacilityAreas]);

  // Aggregate active hits by siteCode or room+surface+description so each site pin shows its total hits, streak badge, and history
  const groupedHitPins = useMemo(() => {
    const groups = {};
    allHits.forEach(h => {
      const key = h.siteCode || `${h.room}::${h.surface}::${h.description}`;
      if (!groups[key]) {
        groups[key] = {
          key,
          siteCode: h.siteCode,
          room: h.room,
          surface: h.surface,
          description: h.description,
          assetTag: h.assetTag,
          spot: h.spot,
          isCustomMapped: h.isCustomMapped,
          hits: []
        };
      }
      groups[key].hits.push(h);
    });
    return Object.keys(groups).map(k => {
      const g = groups[k];
      g.hits.sort((a, b) => String(b.date).localeCompare(String(a.date)));
      const hasLis = g.hits.some(x => x.testType === 'LIS');
      const hasRetest = g.hits.some(x => x.testType === 'RETEST-LIS');
      const hasApc = g.hits.some(x => x.testType === 'APC');
      const primaryType = hasLis ? 'LIS' : (hasRetest ? 'RETEST-LIS' : (hasApc ? 'APC' : 'ATP'));
      return {
        ...g,
        count: g.hits.length,
