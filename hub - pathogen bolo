                  <button
                    key={tab.id}
                    type="button"
                    onClick={() => setArchitectListFilter(tab.id)}
                    className={`px-2 py-0.5 rounded text-[10px] font-bold border ${
                      architectListFilter === tab.id ? 'bg-[#00468B] text-white border-[#00468B]' : theme.bgSubtle
                    }`}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>
            </div>

            {/* Facility Set Areas List with Draw/Redraw, Clear Boundary, and Delete Controls */}
            <div className="flex-1 overflow-y-auto p-2.5 pb-32 space-y-2">
              {architectFilteredAreas.map(area => {
                const isTarget = activeArchitectAreaId === area.id;
                const hasBoundary = !!(area.hasDrawnBoundary && Array.isArray(area.box) && area.box.length === 4);
                const vertexCount = hasBoundary && Array.isArray(area.points) ? area.points.length : 0;
                return (
                  <div
                    key={area.id}
                    className={`p-2.5 rounded-xl border text-xs transition-all ${
                      isTarget
                        ? 'border-[#0072CE] ring-2 ring-[#0072CE]/30 bg-[#0072CE]/10'
                        : `${theme.bgSubtle} hover:border-[#0072CE]`
                    }`}
                  >
                    <div className="flex items-center justify-between gap-1 mb-1">
                      <div className="flex items-center gap-1.5 min-w-0">
                        <span className="w-2.5 h-2.5 rounded-full shrink-0" style={{ backgroundColor: area.color || '#0072CE' }} />
                        <span className="font-black truncate">{area.label}</span>
                      </div>
                      <div className="flex items-center gap-1 shrink-0">
                        <span className={`px-1.5 py-px rounded text-[9px] font-mono font-bold ${
                          hasBoundary ? 'bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : 'bg-slate-500/15 text-slate-500'
                        }`}>
                          {hasBoundary ? `${vertexCount} pts Drawn` : 'Unset (Bare)'}
                        </span>
                      </div>
                    </div>

                    <div className="text-[10px] font-mono opacity-75 mb-2">
                      ID: {area.id} - {hasBoundary ? `Box: [${(area.box || []).join(', ')}]` : 'Click Draw on Map below to set boundary'}
                    </div>

                    <div className="flex flex-wrap items-center gap-1">
                      <button
                        type="button"
                        onClick={() => {
                          setActiveArchitectAreaId(area.id);
                          setPolyDraftPoints([]);
                          setLassoDraftPoints([]);
                          if (hasBoundary && area.box) {
                            centerOnCoords(area.box[0] + area.box[2] / 2, area.box[1] + area.box[3] / 2);
                          }
                        }}
                        className={`px-2 py-1 rounded text-[10px] font-black ${
                          isTarget ? 'bg-[#00468B] text-white ring-2 ring-[#0072CE]/40' : 'bg-[#0072CE] text-white hover:bg-[#00468B]'
                        }`}
                      >
                        {isTarget ? 'Drawing Active' : (hasBoundary ? 'Redraw Area' : 'Draw on Map')}
                      </button>

                      {hasBoundary && (
                        <button
                          type="button"
                          onClick={() => handleClearSingleAreaBoundary(area.id)}
                          className={`px-2 py-1 rounded text-[10px] font-bold border ${theme.bgCard}`}
                          title="Clear this area's box so the map stays bare here"
                        >
                          Clear Box
                        </button>
                      )}

                      <button
                        type="button"
                        onClick={() => handleToggleHiddenArea(area.id)}
                        className={`px-2 py-1 rounded text-[10px] font-bold border ${theme.bgCard}`}
                      >
                        {area.hidden ? 'Unhide' : 'Hide'}
                      </button>

                      <span className="ml-auto">
                        <ConfirmButton
                          label={<span className="inline-flex items-center gap-0.5"><TrashIcon className="w-3 h-3" /> Remove</span>}
                          question={tr('Remove this area for good?', 'Quitar esta area para siempre?')}
                          yesLabel={tr('Yes, remove', 'Si, quitar')}
                          onConfirm={() => handleRemoveFacilityArea(area.id)}
                          className={`inline-flex items-center gap-0.5 px-2 py-1 rounded text-[10px] font-black border ${theme.bgCard} hover:border-[#0072CE]`}
                        />
                      </span>
                    </div>
                  </div>
                );
              })}
              <div className="h-28 shrink-0" aria-hidden="true" />
            </div>
          </div>
        ) : mapMode === 'heatmap' ? (
          /* MODE 1: HEATMAP INSPECTOR SIDEBAR */
          <div className="flex flex-col h-full">
            <div className={`p-3.5 border-b flex items-center justify-between ${theme.bgSubtle}`}>
              <div>
                <h3 className={`text-sm font-black uppercase tracking-wider ${theme.textHeading}`}>Swab Location & Hit Inspector</h3>
                <p className={`text-[11px] ${theme.textMuted}`}>Click any pin on the map or select a site below</p>
              </div>
              <button
                type="button"
                onClick={() => setMapMode('setup')}
                className={`px-2.5 py-1 rounded border text-xs font-black ${theme.bgCard} hover:border-[#0072CE]`}
              >
                Setup Map Zones
              </button>
            </div>

            {selectedPinDetail ? (
              <div className="p-4 border-b border-slate-700/20 space-y-3 overflow-y-auto max-h-[58vh]">
                <div className="flex items-start justify-between gap-2">
                  <div>
                    <div className="flex flex-wrap items-center gap-1.5 mb-1">
                      {selectedPinDetail.count > 0
                        ? <ToneChip tone={selectedPinDetail.tone || 'act'} darkMode={darkMode} solid={selectedPinDetail.tone === 'act' || selectedPinDetail.tone === 'watch'}>{`${selectedPinDetail.count} Hit(s)`}: {toneWord(selectedPinDetail.tone)}</ToneChip>
