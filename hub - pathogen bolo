        return;
      }
      const catSite = fullSiteCatalog.find(s => s.siteCode === focusTarget.siteCode);
      if (catSite) {
        setBareMapMode(false);
        setShowAllCatalogPins(true);
        setSelectedPinKey(catSite.siteCode);
        setZoomLevel(175);
        setTimeout(() => centerOnCoords(catSite.effectiveSpot.x, catSite.effectiveSpot.y), 90);
        return;
      }
    }

    if (focusTarget.description) {
      const descMatch = groupedHitPins.find(p => p.description === focusTarget.description);
      if (descMatch) {
        setBareMapMode(false);
        setShowHitPins(true);
        if (!descMatch.isCustomMapped) setShowEstimatedUnmappedPins(true);
        setSelectedPinKey(descMatch.key);
        setZoomLevel(175);
        setTimeout(() => centerOnCoords(descMatch.spot.x, descMatch.spot.y), 90);
        return;
      }
    }

    if (focusTarget.room && ROOM_META[focusTarget.room]) {
      const areaMatch = effectiveFacilityAreas.find(a => a.roomKey === focusTarget.room || a.id === focusTarget.room);
      const rm = roomMappings[focusTarget.room] || (areaMatch && areaMatch.box ? {
        x: areaMatch.box[0] + areaMatch.box[2] / 2,
