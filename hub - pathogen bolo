// 2. Who Has Accessed the App and When (Access Audit Log + Dataverse Sync)
// 3. Dataverse Recommended Tables App + ChatGPT for Powerverse Prompt Generator
// =======================================================================
function generatePowerversePrompt(tableDef, promptMode, tableExistsState) {
  if (promptMode === 'all_tables_master') {
    const sections = DATAVERSE_RECOMMENDED_TABLES.map((t, idx) => {
      const addCols = t.columns.filter(c => c.status === 'add_to_existing');
      const allCols = t.columns;
      const isExisting = t.defaultState === 'existing_extend' || t.defaultState === 'existing_ready';
      return [
        `### ${idx + 1}. Table: ${t.displayName} (Logical Name: \`${t.logicalName}\`, EntitySet: \`${t.entitySetName}\`)`,
        `- Current Status: ${isExisting ? 'EXISTING TABLE IN DATAVERSE' : 'NEW RECOMMENDED TABLE TO CREATE'}`,
        `- Purpose: ${t.purpose}`,
        `- Primary Name Column: \`${t.primaryNameColumn}\``,
        `- Alternate / Dedup Key: ${t.alternateKey}`,
        isExisting
          ? (addCols.length > 0
              ? `- Columns to ADD to existing table \`${t.logicalName}\`:\n` + addCols.map(c => `  * \`${c.logicalName}\` (${c.displayName}) - Type: **${c.dataType}**${c.maxLength ? ` (MaxLength: ${c.maxLength})` : ''} - Required: ${c.required} - ${c.notes}`).join('\n')
              : `- All required columns already exist in \`${t.logicalName}\`.`)
          : `- Columns to CREATE in new table \`${t.logicalName}\`:\n` + allCols.map(c => `  * \`${c.logicalName}\` (${c.displayName}) - Type: **${c.dataType}**${c.maxLength ? ` (MaxLength: ${c.maxLength})` : ''} - Required: ${c.required} - ${c.notes}`).join('\n')
      ].join('\n');
    }).join('\n\n');

    return [
      'You are an expert Microsoft Power Platform & Dataverse ("Powerverse") Solution Architect.',
      'I am deploying the "Pathogen BOLO & Swab Intelligence Hub" (Stillwell 0320 FSQ EMP Tracker) in Power Apps / Dataverse with publisher prefix `craa5_`.',
      'Please provide:',
      '1. Step-by-step Maker Portal / Power Apps Copilot instructions and PAC CLI / Web API OData JSON definitions to create the new tables and add the missing BOLO columns to my existing tables.',
      '2. Power Fx / Dataverse OData patch & upsert formulas that enforce composite deduplication on `Sample ID + Sample Description` (`craa5_dedupkey`) so blank pending lab results update in-place without inflating swab counts.',
      '',
      sections
    ].join('\n');
  }

  const t = tableDef || DATAVERSE_RECOMMENDED_TABLES[0];
  const treatAsExisting = promptMode === 'existing_columns' || (promptMode === 'auto' && tableExistsState === 'exists');
  const existingCols = t.columns.filter(c => c.status === 'existing');
  const missingCols = t.columns.filter(c => c.status !== 'existing');

  if (treatAsExisting) {
    const colsToCreate = missingCols.length > 0 ? missingCols : t.columns;
    return [
      'You are an expert Microsoft Dataverse & Power Apps ("Powerverse") Architect.',
      `I already have an existing Dataverse table named "${t.displayName}" (Logical Name: \`${t.logicalName}\`, EntitySetName: \`${t.entitySetName}\`, Primary Name Column: \`${t.primaryNameColumn}\`).`,
      '',
      `Purpose in Pathogen BOLO: ${t.purpose}`,
      '',
      existingCols.length > 0
        ? `Columns that ALREADY EXIST on \`${t.logicalName}\` (do not recreate these):\n` +
          existingCols.map(c => `- \`${c.logicalName}\` (${c.displayName}) : ${c.dataType}`).join('\n')
        : `Note: Verify whether the base columns on \`${t.logicalName}\` exist; create any missing columns from the list below.`,
      '',
      `Please give me a Powerverse-friendly step-by-step guide (plus Power Apps Copilot commands and Dataverse Web API / PowerShell metadata JSON) to ADD the following ${colsToCreate.length} columns (with their exact types and lengths) to my existing table \`${t.logicalName}\`:`,
      '',
      colsToCreate.map((c, i) => (
        `${i + 1}. Display Name: "${c.displayName}"\n` +
        `   - Logical / Schema Name: \`${c.logicalName}\`\n` +
        `   - Dataverse Data Type: **${c.dataType}**${c.maxLength ? `\n   - Max Length: ${c.maxLength}` : ''}\n` +
        `   - Required Level: ${c.required}\n` +
        `   - Purpose: ${c.notes}`
      )).join('\n\n'),
      '',
      `Also include the exact Dataverse OData v9.2 PATCH/POST JSON payload example for \`/api/data/v9.2/${t.entitySetName}\` using these columns.`
    ].join('\n');
  }

  // Mode: Create New Table from Scratch with All Columns & Types
  return [
    'You are an expert Microsoft Dataverse & Power Apps ("Powerverse") Architect.',
    `I need to create a new Dataverse table from scratch for my Pathogen BOLO Power App:`,
    `- Display Name: "${t.displayName}" (Plural: "${t.pluralName}")`,
    `- Logical Name: \`${t.logicalName}\``,
    `- EntitySetName (OData plural): \`${t.entitySetName}\``,
    `- Publisher Prefix: \`craa5_\``,
    `- Primary Name Column: \`${t.primaryNameColumn}\``,
    `- Alternate Key / Deduplication Key: ${t.alternateKey}`,
    `- Purpose: ${t.purpose}`,
    '',
    `Please generate:`,
    `1. A Power Apps Copilot / Maker Portal prompt to create this table and all ${t.columns.length} columns below.`,
    `2. A Dataverse Web API \`POST /api/data/v9.2/EntityDefinitions\` JSON payload (or PowerShell / PAC CLI script) that provisions the table and every column with its exact Dataverse type.`,
    `3. An OData v9.2 Upsert (\`PATCH\`) example that prevents duplicate records unless both Sample ID and Sample Description match.`,
    '',
    `### Complete Column Specification for \`${t.logicalName}\` (${t.columns.length} Columns):`,
    t.columns.map((c, i) => (
      `${i + 1}. **${c.displayName}** (\`${c.logicalName}\`)\n` +
      `   - Data Type: **${c.dataType}**${c.maxLength ? ` - MaxLength: ${c.maxLength}` : ''}\n` +
      `   - Required: ${c.required}\n` +
      `   - Details: ${c.notes}`
    )).join('\n\n')
  ].join('\n');
}

function DevConsoleView({
  darkMode,
  theme,
  msIdentity,
  msIdentityOverride,
  setMsIdentityOverride,
  isDevAuthorized,
  logs,
  setLogs,
  logEvent,
  accessLog,
  setAccessLog,
  recordAccessSession,
  onSyncAccessLog,
  onSyncConfig,
  syncBusy,
  syncStatus,
  regexRules,
  fullSiteCatalog,
  siteMappings,
  roomMappings,
  facilityAreas,
  suggestedActionsMap,
  harborageConcerns,
  userProfilesRegistry,
  onSaveUserProfiles,
  parsedCsv,
  allHits,
  repeatStreaks,
  importReceipts,
  onNavigateTab
}) {
  const [devSection, setDevSection] = useState('tables'); // 'tables' | 'profiles' | 'access' | 'errors'
  const [logFilter, setLogFilter] = useState('ALL');
  const [logSearch, setLogSearch] = useState('');
  const [accessSearch, setAccessSearch] = useState('');
  const [healthScanResults, setHealthScanResults] = useState([]);
  const [selectedTableId, setSelectedTableId] = useState('bolo_samples');
  const [promptMode, setPromptMode] = useState('auto'); // 'auto' | 'existing_columns' | 'create_table' | 'all_tables_master'
  const [tableProbeMap, setTableProbeMap] = useState({});
  const [probeBusy, setProbeBusy] = useState(false);
  const [copyFeedback, setCopyFeedback] = useState('');
  const [customMsIdInput, setCustomMsIdInput] = useState('');

  // Admin User Profile & JSON Preferences Editor States
  const [selectedUserMsId, setSelectedUserMsId] = useState('');
  const [rawUserJsonText, setRawUserJsonText] = useState('');
  const [rawUserJsonError, setRawUserJsonError] = useState('');
  const [profileSaveMsg, setProfileSaveMsg] = useState('');
  const [newUserDraft, setNewUserDraft] = useState({
    microsoftId: '',
    userName: '',
    email: '',
    assignedRoleProfile: 'line_lead_creme'
  });

  const usersMap = (userProfilesRegistry && userProfilesRegistry.users) || DEFAULT_USER_PROFILES_REGISTRY.users;
  const rolesMap = (userProfilesRegistry && userProfilesRegistry.roles) || DEFAULT_USER_PROFILES_REGISTRY.roles;
  const selectedUserRecord = usersMap[selectedUserMsId] || Object.values(usersMap)[0];

  useEffect(() => {
    if (selectedUserRecord && selectedUserRecord.viewPreferences) {
      setRawUserJsonText(JSON.stringify(selectedUserRecord.viewPreferences, null, 2));
      setRawUserJsonError('');
    }
  }, [selectedUserMsId, selectedUserRecord]);

  const handleAdminUpdateUserRecord = async (targetMsId, updaterFn) => {
    if (!onSaveUserProfiles) return;
    const currentReg = userProfilesRegistry || DEFAULT_USER_PROFILES_REGISTRY;
    const existingUser = (currentReg.users && currentReg.users[targetMsId]) || {
      microsoftId: targetMsId,
      userName: `User (${targetMsId})`,
      email: `${targetMsId}@schwans.com`,
      domainAccount: `SCHWANS\\${targetMsId}`,
      assignedRoleProfile: 'qa_lead',
      lockedByAdmin: false,
      updatedAt: new Date().toISOString().slice(0, 10),
      updatedBy: msIdentity.microsoftId,
      viewPreferences: {
        onlyShowRooms: [],
        onlyShowTests: [],
        defaultCalendarTimeframe: '1w',
        defaultCellDisplayMode: 'hits_pending',
        defaultLandingTab: 'calendar',
        darkModePreferred: true,
        visibleWidgets: {
          pressure_points: true,
          kpi_strip: true,
          room_matrix: true,
          active_hits_table: true,
          harborage_feed: true
        }
      }
    };
    const updatedUser = {
      ...updaterFn(existingUser),
      updatedAt: new Date().toISOString().slice(0, 10),
      updatedBy: `${msIdentity.userName} (Admin)`
    };
    const nextReg = {
      ...currentReg,
      users: {
        ...(currentReg.users || {}),
        [targetMsId]: updatedUser
      }
    };
    await onSaveUserProfiles(nextReg, `Admin updated profile/JSON preferences for ${targetMsId}`);
    setProfileSaveMsg(`Saved profile & JSON preferences for ${targetMsId} to Dataverse.`);
    setTimeout(() => setProfileSaveMsg(''), 4000);
  };

  const handleCreateNewUserProfile = async () => {
    const cleanId = newUserDraft.microsoftId.trim().toUpperCase();
    if (!cleanId) return;
    const roleObj = rolesMap[newUserDraft.assignedRoleProfile] || rolesMap.line_lead_creme;
    await handleAdminUpdateUserRecord(cleanId, () => ({
      microsoftId: cleanId,
      userName: newUserDraft.userName.trim() || `Plant User (${cleanId})`,
      email: newUserDraft.email.trim() || `${cleanId.toLowerCase()}@schwans.com`,
      domainAccount: `SCHWANS\\${cleanId}`,
      assignedRoleProfile: newUserDraft.assignedRoleProfile,
      lockedByAdmin: !!(roleObj && roleObj.lockViewPreferences),
      viewPreferences: {
        onlyShowRooms: roleObj && Array.isArray(roleObj.defaultRooms) ? [...roleObj.defaultRooms] : [],
        onlyShowTests: roleObj && Array.isArray(roleObj.defaultTests) ? [...roleObj.defaultTests] : [],
        defaultCalendarTimeframe: '1w',
        defaultCellDisplayMode: 'hits_pending',
        defaultLandingTab: 'calendar',
        darkModePreferred: true,
        visibleWidgets: {
          pressure_points: true,
          kpi_strip: true,
          room_matrix: true,
          active_hits_table: true,
          harborage_feed: true
        }
      }
    }));
    setSelectedUserMsId(cleanId);
    setNewUserDraft({ microsoftId: '', userName: '', email: '', assignedRoleProfile: 'line_lead_creme' });
  };

  // Run 10-Point Proactive Error & Health Scanner
  const runProactiveDiagnosticScan = useCallback(() => {
    const checks = [];
    // 1. Regex rules compilation check
    let badRegexCount = 0;
    const regexKeys = Object.keys(regexRules || {});
    regexKeys.forEach(k => {
      try {
        // eslint-disable-next-line no-new
        new RegExp(regexRules[k], 'i');
      } catch (e) {
        badRegexCount += 1;
        logEvent(`Regex syntax error in rule "${k}": ${e.message}`, 'error');
      }
    });
    checks.push({
      id: 'chk-regex',
      name: `1. Regex Reader Rules Compilation (${regexKeys.length} rules)`,
      status: badRegexCount === 0 ? 'PASS' : 'ERROR',
      detail: badRegexCount === 0
        ? `All ${regexKeys.length} modifiable regex rules compiled cleanly with zero syntax errors.`
        : `${badRegexCount} regex rule(s) failed compilation. Check Upload & Regex Studio.`
    });

    // 2. Identical Sample ID + Sample Description Deduplication Engine Check
    checks.push({
      id: 'chk-dedup',
      name: '2. Composite Sample ID + Sample Description Dedup Engine',
      status: 'PASS',
      detail: `Active key format: ID_DESC::<SampleID>::<SampleDescription>::<Test>. ${parsedCsv.totals.totalUnique.toLocaleString()} unique rows verified.`
    });

    // 3. Same Sample ID / Different Sample Description Collision Queue
    const colCount = (parsedCsv.sameDaySiteCollisions || []).length;
    checks.push({
      id: 'chk-collisions',
      name: '3. Same Sample ID with Different Description Queue',
      status: colCount === 0 ? 'PASS' : 'WARN',
      detail: colCount === 0
        ? '0 ambiguous Sample ID collisions detected.'
        : `${colCount} Sample ID(s) have multiple distinct Sample Descriptions and were safely kept separate.`
    });

    // 4. Pending / Blank Lab Results awaiting completion
    const pendingCount = parsedCsv.totals.totalPending || 0;
    checks.push({
      id: 'chk-pending',
      name: '4. Blank / Pending Lab Result Rows in Ledger',
      status: pendingCount > 0 ? 'INFO' : 'PASS',
      detail: `${pendingCount.toLocaleString()} sample row(s) currently have blank/pending results and are shielded from denominator inflation until results arrive.`
    });

    // 5. Swab Site Map Coordinate Coverage
    const customSiteCount = Object.keys(siteMappings || {}).length;
    const customRoomCount = Object.keys(roomMappings || {}).length;
    checks.push({
      id: 'chk-map',
      name: `5. Stillwell 0320- Map Pin Coverage (${fullSiteCatalog.length} sites)`,
      status: 'PASS',
      detail: `${customSiteCount} custom site pins + ${customRoomCount} custom room boxes saved; all ${fullSiteCatalog.length} 0320- sites have valid blueprint coordinates.`
    });

    // 6. Repeat-Offender Streak Escalation Check
    const severeStreaks = repeatStreaks.filter(s => s.count >= 3);
    checks.push({
      id: 'chk-streaks',
      name: '6. Chronic Repeat Streak Escalation Detector',
      status: severeStreaks.length > 0 ? 'WARN' : 'PASS',
      detail: severeStreaks.length > 0
        ? `${severeStreaks.length} site(s) have 3+ repeat hits (Top: ${severeStreaks[0].siteCode || severeStreaks[0].surface} with ${severeStreaks[0].count} hits).`
        : 'No swab sites have 3+ consecutive repeat hits.'
    });

    // 7. IndexedDB 18k Ledger Availability
    const idbOk = typeof window !== 'undefined' && !!window.indexedDB;
    checks.push({
      id: 'chk-idb',
      name: '7. High-Capacity IndexedDB (18k+ Samples Engine)',
      status: idbOk ? 'PASS' : 'WARN',
      detail: idbOk
        ? `IndexedDB (${IDB_NAME}) is available and ready for 18,000+ multi-year swab records.`
        : 'IndexedDB unavailable in this browser context; falling back to in-memory + localStorage.'
    });

    // 8. Microsoft Identity Verification
    checks.push({
      id: 'chk-msid',
      name: '8. Microsoft ID & Security Context Reader',
      status: isDevAuthorized ? 'PASS' : 'WARN',
      detail: `Read Microsoft ID "${msIdentity.microsoftId}" (${msIdentity.userName}) via ${msIdentity.source}.`
    });

    // 9. Access Audit Log Persistence
    checks.push({
      id: 'chk-access',
      name: '9. User Access Audit Log Integrity',
      status: 'PASS',
      detail: `${accessLog.length} user access session(s) recorded and ready for Dataverse Hub config sync.`
    });

    // 10. Runtime Error Buffer Check
    const errCount = logs.filter(l => l.type === 'error').length;
    checks.push({
      id: 'chk-errors',
      name: '10. Global Runtime & Promise Rejection Trap',
      status: errCount === 0 ? 'PASS' : 'WARN',
      detail: errCount === 0
        ? '0 uncaught runtime or OData errors recorded in this session.'
        : `${errCount} error event(s) captured in the error log below.`
    });

    setHealthScanResults(checks);
    logEvent('Completed 10-Point Proactive Diagnostic & Error Scan in Dev Console.', 'success');
  }, [regexRules, parsedCsv, siteMappings, roomMappings, fullSiteCatalog.length, repeatStreaks, isDevAuthorized, msIdentity, accessLog.length, logs, logEvent]);

  useEffect(() => {
    if (healthScanResults.length === 0) {
      runProactiveDiagnosticScan();
    }
  }, [healthScanResults.length, runProactiveDiagnosticScan]);

  // Live probe Dataverse tables to detect which tables already exist vs need creation
  const probeDataverseTables = useCallback(async () => {
    setProbeBusy(true);
    const nextMap = {};
    for (let i = 0; i < DATAVERSE_RECOMMENDED_TABLES.length; i += 1) {
      const t = DATAVERSE_RECOMMENDED_TABLES[i];
      try {
        const res = await fetch(apiUrl(`${t.entitySetName}?$top=1`), { headers: ODATA_HEADERS });
        if (res.ok) {
          nextMap[t.id] = {
            state: 'exists',
            httpStatus: res.status,
            note: `Live OData endpoint /api/data/v9.2/${t.entitySetName} responded HTTP 200 OK.`
          };
        } else if (res.status === 404) {
          nextMap[t.id] = {
            state: 'missing',
            httpStatus: 404,
            note: `Table ${t.logicalName} (${t.entitySetName}) returned HTTP 404 Not Found - create using Powerverse prompt.`
          };
        } else {
          nextMap[t.id] = {
            state: t.defaultState === 'recommended_new' ? 'missing' : 'exists',
            httpStatus: res.status,
            note: `Endpoint returned HTTP ${res.status} (Default blueprint state: ${t.defaultState === 'recommended_new' ? 'New Recommended Table' : 'Existing Shared Table'}).`
          };
        }
      } catch (e) {
        nextMap[t.id] = {
          state: t.defaultState === 'recommended_new' ? 'missing' : 'exists',
          httpStatus: 0,
          note: t.defaultState === 'recommended_new'
            ? 'Standalone mode: Recommended new table to create in Dataverse.'
            : 'Standalone mode: Known existing shared Dataverse table (add BOLO extension columns).'
        };
      }
    }
    setTableProbeMap(nextMap);
    setProbeBusy(false);
    logEvent(`Probed all ${DATAVERSE_RECOMMENDED_TABLES.length} Dataverse table endpoints from Dev Console.`, 'info', nextMap);
  }, [logEvent]);

  useEffect(() => {
    if (Object.keys(tableProbeMap).length === 0) {
      probeDataverseTables();
    }
  }, [tableProbeMap, probeDataverseTables]);

  const selectedTable = useMemo(
    () => DATAVERSE_RECOMMENDED_TABLES.find(t => t.id === selectedTableId) || DATAVERSE_RECOMMENDED_TABLES[0],
    [selectedTableId]
  );

  const selectedTableProbe = tableProbeMap[selectedTable.id] || {
    state: selectedTable.defaultState === 'recommended_new' ? 'missing' : 'exists',
    note: selectedTable.defaultState === 'recommended_new'
      ? 'Recommended new Dataverse table to create.'
      : 'Existing shared Dataverse table (add recommended BOLO columns).'
  };

  const generatedPrompt = useMemo(
    () => generatePowerversePrompt(selectedTable, promptMode, selectedTableProbe.state),
    [selectedTable, promptMode, selectedTableProbe.state]
  );

  const handleCopyPrompt = () => {
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(generatedPrompt);
      }
      setCopyFeedback('Copied Powerverse Prompt to Clipboard!');
      window.setTimeout(() => setCopyFeedback(''), 3000);
      logEvent(`Copied ChatGPT Powerverse prompt for ${selectedTable.logicalName}.`, 'success');
    } catch (e) {
      setCopyFeedback('Select text below and press Ctrl+C');
    }
  };

  const filteredLogs = useMemo(() => {
    const q = logSearch.trim().toLowerCase();
    return logs.slice().reverse().filter(l => {
      if (logFilter === 'ERROR_WARN' && l.type !== 'error' && l.type !== 'warn') return false;
      if (logFilter !== 'ALL' && logFilter !== 'ERROR_WARN' && l.type !== logFilter.toLowerCase()) return false;
      if (!q) return true;
      const hay = `${l.time} ${l.type} ${l.message} ${l.payload ? JSON.stringify(l.payload) : ''}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [logs, logFilter, logSearch]);

  const filteredAccessLog = useMemo(() => {
    const q = accessSearch.trim().toLowerCase();
    return accessLog.filter(a => {
      if (!q) return true;
      const hay = `${a.microsoftId} ${a.userName} ${a.email} ${a.domainAccount} ${a.role} ${a.authSource} ${a.timestampLabel} ${a.actionSummary} ${a.tabVisited}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [accessLog, accessSearch]);

  const uniqueAccessUsers = useMemo(() => {
    const seen = {};
    accessLog.forEach(a => { if (a.microsoftId) seen[a.microsoftId] = true; });
    return Object.keys(seen).length;
  }, [accessLog]);

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-4 sm:p-6 pb-32">
      <div className="max-w-7xl mx-auto space-y-5 pb-28">
        {/* TOP DEV CONSOLE IDENTITY & TELEMETRY BANNER */}
        <div
          className="rounded-2xl p-5 text-white shadow-xl"
          style={{
            background: 'linear-gradient(135deg, #022C22 0%, #065F46 55%, #00468B 100%)',
            borderBottom: '4px solid #FFB81C'
          }}
        >
          <div className="flex flex-wrap items-start justify-between gap-4">
            <div>
              <div className="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#FFB81C] text-slate-950 text-[10px] font-black uppercase tracking-widest mb-1.5">
                <UserCheckIcon className="w-3.5 h-3.5" />
                <span>Microsoft ID Recognized: {msIdentity.microsoftId} - Dev Console Active</span>
              </div>
              <h2 className="text-xl sm:text-2xl font-black tracking-tight">
                Pathogen BOLO Developer Console, User View Profiles & Powerverse Architect
              </h2>
              <p className="text-xs text-emerald-100 mt-1">
                Authenticated as <span className="font-bold text-white">{msIdentity.userName}</span> ({msIdentity.domainAccount} - {msIdentity.email}) via <span className="underline">{msIdentity.source}</span>.
              </p>
            </div>

            {/* Identity Simulator / Role Switcher for Testing */}
            <div className="rounded-xl bg-slate-950/55 border border-emerald-400/30 p-3 text-xs space-y-2 min-w-[280px]">
              <div className="flex items-center justify-between gap-2">
                <span className="font-black text-amber-300 uppercase text-[10px] tracking-wider">Microsoft ID Reader Test Controls</span>
                <span className="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[10px] font-bold">
                  {msIdentity.microsoftId}
                </span>
              </div>
              <div className="flex items-center gap-1.5">
                <input
                  type="text"
                  value={customMsIdInput}
                  onChange={e => setCustomMsIdInput(e.target.value)}
                  placeholder="Test MS ID..."
                  className="flex-1 rounded-lg bg-slate-900 border border-slate-700 px-2.5 py-1 text-xs text-white placeholder-slate-400"
                />
                <button
                  type="button"
                  onClick={() => {
                    const idVal = (customMsIdInput || '').trim().toUpperCase();
                    const knownUser = usersMap[idVal];
                    const nextIdent = {
                      microsoftId: idVal,
                      systemUserId: '',
                      aadObjectId: '',
                      userName: knownUser ? knownUser.userName : (idVal === '' ? '' : `User (${idVal})`),
                      email: knownUser ? knownUser.email : `${idVal}@schwans.com`,
                      domainAccount: `SCHWANS\\${idVal}`,
                      roles: ['FSQ Operator'],
                      source: 'Dev Console Identity Test Override'
                    };
                    setMsIdentityOverride(nextIdent);
                    recordAccessSession(nextIdent, `Tested Microsoft ID switch to ${idVal}`, 'dev');
                    logEvent(`Switched active Microsoft ID to ${idVal}.`, 'info');
                  }}
                  className="px-2.5 py-1 rounded-lg bg-[#FFB81C] text-slate-950 font-black hover:bg-amber-400"
                >
                  Apply ID
                </button>
                {msIdentityOverride && (
                  <button
                    type="button"
                    onClick={() => {
                      setMsIdentityOverride(null);
                      setCustomMsIdInput('');
                      logEvent('Reset Microsoft ID reader to automatic host detection (admin).', 'info');
                    }}
                    className="px-2 py-1 rounded-lg bg-white/15 text-white font-bold hover:bg-white/25"
                  >
                    Auto
                  </button>
                )}
              </div>
            </div>
          </div>

          {/* 4 MODULE SWITCHER TABS */}
          <div className="mt-4 flex flex-wrap items-center gap-2">
            {[
              {
                id: 'tables',
                label: '1. Dataverse Recommended Tables & Powerverse Prompt',
                badge: `${DATAVERSE_RECOMMENDED_TABLES.length} Tables`,
                icon: DatabaseIcon
              },
              {
                id: 'profiles',
                label: '2. User Profiles, JSON Preferences & View Control',
                badge: `${Object.keys(usersMap).length} Users / ${Object.keys(rolesMap).length} Roles`,
                icon: UsersIcon
              },
              {
                id: 'access',
                label: '3. Who Has Accessed the App & When',
                badge: `${accessLog.length} Sessions (${uniqueAccessUsers} Users)`,
                icon: UserCheckIcon
              },
              {
                id: 'errors',
                label: '4. Potential Error Logs & 10-Point Health Scanner',
                badge: `${logs.length} Events`,
                icon: ShieldAlertIcon
              }
            ].map(tab => {
              const Icon = tab.icon;
              const active = devSection === tab.id;
              return (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => setDevSection(tab.id)}
                  className={`inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-black transition-all ${
                    active
                      ? 'bg-[#FFB81C] text-slate-950 shadow-md'
                      : 'bg-white/10 text-white hover:bg-white/20'
                  }`}
                >
                  <Icon className="w-4 h-4" />
                  <span>{tab.label}</span>
                  <span className={`px-2 py-0.5 rounded-full text-[10px] ${active ? 'bg-slate-950 text-[#FFB81C]' : 'bg-black/30 text-emerald-200'}`}>
                    {tab.badge}
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        {/* =================================================================
            MODULE 1: DATAVERSE RECOMMENDED TABLES & CHATGPT POWERVERSE PROMPT
            ================================================================= */}
        {devSection === 'tables' && (
          <div className="space-y-5">
            {/* Top Action Bar */}
            <div className={`rounded-2xl border p-4 flex flex-wrap items-center justify-between gap-3 shadow-xs ${theme.bgCard}`}>
              <div>
                <h3 className={`text-base font-black ${theme.textHeading}`}>
                  Dataverse Recommended Tables & Column Schema Inspector (Powerverse Ready)
                </h3>
                <p className={`text-xs ${theme.textMuted}`}>
                  Select any table below to see whether it already exists in Dataverse, which exact columns and data types need to be created, and copy a ready-to-run ChatGPT / Power Apps Copilot prompt.
                </p>
              </div>
              <div className="flex flex-wrap items-center gap-2">
                <button
                  type="button"
