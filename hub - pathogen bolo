              {/* Search & Filter Old / Active Set Areas */}
              <input
                type="search"
                value={areaFilterText}
                onChange={e => setAreaFilterText(e.target.value)}
                placeholder="Filter facility areas (WJ, IBL5, Dough Room...)"
                className={`w-full rounded-lg border px-2.5 py-1.5 text-xs ${theme.bgInput}`}
              />
              <div className="flex flex-wrap gap-1">
                {[
                  { id: 'active', label: `Active Rooms (${effectiveFacilityAreas.filter(a => !a.isLegacy && !a.hidden).length})` },
                  { id: 'legacy', label: `Hidden / Archived (${legacyAreaCount})` },
                  { id: 'all', label: `All (${effectiveFacilityAreas.length})` }
