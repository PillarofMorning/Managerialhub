                        </div>
                      )}
                    </div>
                  </React.Fragment>
                );
              })}

              {/* 6. THE SWABS OF ONE DAY (pinned from the calendar): colored by result; a dashed ring = a guessed spot */}
              {!isBareMapActive && dayLayer && dayLayer.pins.map(dp => (
                <button
                  key={dp.id}
                  type="button"
                  data-day-pin={dp.tone}
                  data-day-pin-estimated={dp.estimated ? '1' : '0'}
