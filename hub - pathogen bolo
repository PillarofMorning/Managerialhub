            <button type="button" onClick={() => { setDraft(saved && !saved.isAuto ? saved.text : autoText); setEditing(true); }} className="text-[10px] font-black underline">{tr('Edit', 'Editar')}</button>
            {saved && !saved.isAuto && <button type="button" disabled={busy} onClick={() => save(autoText, true)} className="text-[10px] font-black underline">{tr('Use the numbers again', 'Usar los numeros otra vez')}</button>}
          </div>
        )}
      </div>
