                        <td className="py-3 px-4 font-medium">{entry.actionSummary}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* =================================================================
            MODULE 4: POTENTIAL ERROR LOGS & 10-POINT PROACTIVE SCANNER
            ================================================================= */}
        {devSection === 'errors' && (
          <div className="space-y-5">
            {/* 10-Point Proactive Diagnostic Scanner */}
            <div className={`rounded-2xl border shadow-xs overflow-hidden ${theme.bgCard}`}>
              <div className={`px-5 py-4 border-b flex flex-wrap items-center justify-between gap-3 ${theme.bgSubtle}`}>
                <div>
                  <h3 className="text-base font-black">10-Point Proactive Error & System Health Scanner</h3>
                  <p className={`text-xs ${theme.textMuted}`}>
                    Automatically checks regex compilation, composite Sample ID + Description deduplication, IndexedDB capacity, and Dataverse OData readiness.
                  </p>
                </div>
                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={runProactiveDiagnosticScan}
                    className="px-3.5 py-1.5 rounded-xl bg-[#0072CE] text-white text-xs font-black hover:bg-[#00468B] inline-flex items-center gap-1.5"
                  >
                    <RefreshIcon className="w-3.5 h-3.5" />
                    <span>Re-Run 10-Point Scan</span>
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      logEvent('Simulated Potential Error Test: Sample OData 403 / Regex warning verified in Dev Console.', 'error', {
                        testCode: 'DEV_CONSOLE_SIMULATED_ERROR',
                        microsoftId: msIdentity.microsoftId
                      });
                    }}
                    className="px-3 py-1.5 rounded-xl bg-slate-700 text-white text-xs font-black hover:bg-slate-800"
                  >
                    + Simulate Test Error Log
                  </button>
                </div>
              </div>

              <div className="p-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                {healthScanResults.map(chk => (
                  <div key={chk.id} className={`p-3.5 rounded-xl border flex items-start justify-between gap-3 ${theme.bgSubtle}`}>
                    <div>
                      <div className="text-xs font-black">{chk.name}</div>
                      <p className={`text-xs mt-1 ${theme.textMuted}`}>{chk.detail}</p>
                    </div>
                    <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase shrink-0 ${
                      chk.status === 'PASS'
                        ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-300'
                        : chk.status === 'WARN'
                        ? 'bg-amber-500/20 text-amber-600 dark:text-amber-300'
                        : chk.status === 'ERROR'
                        ? 'bg-rose-500/20 text-rose-600 dark:text-rose-300'
                        : 'bg-sky-500/20 text-sky-600 dark:text-sky-300'
                    }`}>
                      {chk.status}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Real-Time Potential Error & Telemetry Stream */}
            <div className={`rounded-2xl border shadow-xs overflow-hidden ${theme.bgCard}`}>
              <div className={`px-5 py-4 border-b flex flex-wrap items-center justify-between gap-3 ${theme.bgSubtle}`}>
                <div>
                  <h3 className="text-base font-black">Potential Error Logs, Warnings & OData Telemetry ({filteredLogs.length} Events)</h3>
                  <p className={`text-xs ${theme.textMuted}`}>
                    Captures uncaught runtime errors, unhandled promise rejections, parser warnings, and Dataverse sync operations.
                  </p>
                </div>
                <div className="flex flex-wrap items-center gap-2">
                  {['ALL', 'ERROR_WARN', 'ERROR', 'WARN', 'SUCCESS', 'INFO'].map(sev => (
                    <button
                      key={sev}
                      type="button"
                      onClick={() => setLogFilter(sev)}
                      className={`px-2.5 py-1 rounded-lg text-[11px] font-bold ${
                        logFilter === sev
                          ? 'bg-[#00468B] text-white'
                          : `${theme.bgCard} border border-slate-300 dark:border-slate-700`
                      }`}
                    >
                      {sev === 'ERROR_WARN' ? 'Errors & Warnings Only' : sev}
                    </button>
                  ))}
                  <input
                    type="search"
                    value={logSearch}
                    onChange={e => setLogSearch(e.target.value)}
                    placeholder="Search error logs..."
                    className={`w-48 rounded-lg border px-2.5 py-1 text-xs ${theme.bgInput}`}
                  />
                  <button
                    type="button"
                    onClick={() => setLogs([])}
                    className="px-2.5 py-1 rounded-lg border border-slate-300 dark:border-slate-700 text-xs font-bold hover:bg-slate-600 hover:text-white"
                  >
                    Clear
                  </button>
                </div>
              </div>

              <div className="p-4 space-y-2 max-h-[420px] overflow-y-auto font-mono text-xs">
                {filteredLogs.length === 0 ? (
                  <div className={`py-8 text-center ${theme.textMuted}`}>
                    No matching error or telemetry events. Click '+ Simulate Test Error Log' above to verify error trapping.
                  </div>
                ) : (
                  filteredLogs.map((l, idx) => (
                    <div
                      key={l.id || idx}
                      className={`p-3 rounded-xl border ${
                        l.type === 'error'
                          ? 'bg-rose-950/30 border-rose-500/50 text-rose-200'
                          : l.type === 'warn'
                          ? 'bg-amber-950/25 border-amber-500/40 text-amber-200'
                          : theme.bgSubtle
                      }`}
                    >
                      <div className="flex items-center justify-between gap-2 text-[10px] mb-1">
                        <span className="font-bold">{l.time} {l.iso ? `(${l.iso})` : ''}</span>
                        <span className={`px-2 py-px rounded uppercase font-black ${
                          l.type === 'error'
                            ? 'bg-rose-600 text-white'
                            : l.type === 'warn'
                            ? 'bg-amber-500 text-slate-950'
                            : l.type === 'success'
                            ? 'bg-emerald-600 text-white'
                            : 'bg-slate-700 text-slate-200'
                        }`}>
                          {l.type}
                        </span>
                      </div>
                      <div className="font-bold">{l.message}</div>
                      {l.payload && (
                        <pre className="mt-1.5 p-2 rounded bg-slate-950 text-sky-300 text-[10px] overflow-x-auto">
                          {JSON.stringify(l.payload, null, 2)}
                        </pre>
                      )}
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        )}
        <div className="h-28 shrink-0" aria-hidden="true" />
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

// =======================================================================
// VIEW 9: HARBORAGE POINTS & FACILITY CONCERNS MODULE
// (Shown ONLY when the CJ Schwan's Logo is clicked: logoUnlocked === true)
// Allows users to upload potential harborage points/concerns across the facility,
// attach photos, drop a pin on the map, and share "What do you think about it?"
// =======================================================================
function HarborageConcernsView({
  darkMode,
  theme,
  msIdentity,
  isDevAuthorized,
  harborageConcerns,
  onSaveConcerns,
  facilityAreas,
  fullSiteCatalog,
  mapImage,
  onLocateOnMap,
  logEvent
}) {
  const [filterRoom, setFilterRoom] = useState('ALL');
  const [filterStatus, setFilterStatus] = useState('ALL');
  const [searchQuery, setSearchQuery] = useState('');
  const [saving, setSaving] = useState(false);
  const [statusBanner, setStatusBanner] = useState('');
  const [commentInputs, setCommentInputs] = useState({});

  const [draftConcern, setDraftConcern] = useState({
    room: 'WJ',
    siteCode: '0320-STLWJ1-066',
    title: '',
    surfaceCategory: 'Floor / Trench / Drain',
    severity: 'CRITICAL',
    userThought: '',
    proposedAction: '',
    photoDataUrl: '',
    spot: { x: 18.5, y: 15.2 }
  });

  const handlePhotoFileChange = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      if (typeof reader.result === 'string') {
        setDraftConcern(prev => ({ ...prev, photoDataUrl: reader.result }));
      }
    };
    reader.readAsDataURL(file);
  };

  const handleSubmitConcern = async (e) => {
    e.preventDefault();
    if (!draftConcern.title.trim() || !draftConcern.userThought.trim()) return;
    setSaving(true);
    const id = `HARB-${new Date().getFullYear()}-${Date.now().toString().slice(-4)}`;
    // No photo added: the concern has no picture (v2.5 no longer draws a made-up diagram in its place)
    const photoUrl = draftConcern.photoDataUrl || '';
    const newRecord = {
      id,
      room: draftConcern.room,
      siteCode: draftConcern.siteCode.trim() || 'Unlinked',
      title: draftConcern.title.trim(),
      surfaceCategory: draftConcern.surfaceCategory,
      severity: draftConcern.severity,
      status: 'Open Investigation',
      submittedBy: `${msIdentity.userName} (${msIdentity.microsoftId})`,
      submittedAt: new Date().toISOString().slice(0, 10),
      spot: draftConcern.spot || { x: 20, y: 20 },
      userThought: draftConcern.userThought.trim(),
      proposedAction: draftConcern.proposedAction.trim() || 'Evaluate during sanitation teardown and verify with vector swabs.',
      upvotes: 1,
      photoDataUrl: photoUrl,
      comments: []
    };

    const nextList = [newRecord, ...(harborageConcerns || [])];
    await onSaveConcerns(nextList, newRecord);
    setSaving(false);
    setDraftConcern(prev => ({
      ...prev,
      title: '',
      userThought: '',
      proposedAction: '',
      photoDataUrl: ''
    }));
    setStatusBanner(`Submitted Harborage Concern "${newRecord.title}" (${newRecord.id}) and synced to Dataverse.`);
    setTimeout(() => setStatusBanner(''), 5000);
  };

  const handleAddPeerThought = async (concernId) => {
    const text = (commentInputs[concernId] || '').trim();
    if (!text) return;
    const nextList = (harborageConcerns || []).map(c => {
      if (c.id !== concernId) return c;
      const nextComment = {
        id: `c-${Date.now()}`,
        author: `${msIdentity.userName} (${msIdentity.microsoftId})`,
        date: new Date().toISOString().slice(0, 10),
        thought: text
      };
      return {
        ...c,
        comments: [...(c.comments || []), nextComment]
      };
    });
    setCommentInputs(prev => ({ ...prev, [concernId]: '' }));
    await onSaveConcerns(nextList);
  };

  const handleUpvoteConcern = async (concernId) => {
    const nextList = (harborageConcerns || []).map(c =>
      c.id === concernId ? { ...c, upvotes: (c.upvotes || 0) + 1 } : c
    );
    await onSaveConcerns(nextList);
  };

  const handleUpdateConcernStatus = async (concernId, nextStatus) => {
    const nextList = (harborageConcerns || []).map(c =>
      c.id === concernId ? { ...c, status: nextStatus } : c
    );
    await onSaveConcerns(nextList);
  };

  const handleDeleteConcern = async (concernId) => {
    const nextList = (harborageConcerns || []).filter(c => c.id !== concernId);
    await onSaveConcerns(nextList);
  };

  const filteredConcerns = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return (harborageConcerns || []).filter(c => {
      if (filterRoom !== 'ALL' && c.room !== filterRoom) return false;
      if (filterStatus !== 'ALL' && c.status !== filterStatus) return false;
      if (!q) return true;
      const hay = `${c.id} ${c.room} ${c.siteCode} ${c.title} ${c.surfaceCategory} ${c.userThought} ${c.proposedAction} ${c.submittedBy}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [harborageConcerns, filterRoom, filterStatus, searchQuery]);

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-4 sm:p-6 pb-32">
      <div className="max-w-7xl mx-auto space-y-5 pb-28">
        {/* TOP BANNER */}
        <div
          className="rounded-2xl p-5 text-white shadow-lg"
          style={{
            background: 'linear-gradient(135deg, #4C1D95 0%, #00468B 55%, #8B0018 100%)',
            borderBottom: '4px solid #FFB81C'
          }}
        >
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div>
              <div className="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#FFB81C] text-slate-950 text-[10px] font-black uppercase tracking-widest mb-1.5">
                <CameraIcon className="w-3.5 h-3.5" />
                <span>CJ Logo Unlocked Module - Facility Harborage & Concerns</span>
              </div>
              <h2 className="text-xl sm:text-2xl font-black">
                Facility Harborage Points, Photo Evidence & Team Thoughts Hub
              </h2>
              <p className="text-xs text-sky-100 mt-1">
                Upload potential harborage points or sanitation concerns across the facility, pin them on the plant map, and share what you think about the root cause and fix.
              </p>
            </div>
            <div className="flex items-center gap-2 text-xs">
              <div className="px-3 py-2 rounded-xl bg-black/30 border border-white/20 text-center">
                <div className="text-[10px] uppercase text-amber-300 font-bold">Total Logged Concerns</div>
                <div className="text-xl font-black">{(harborageConcerns || []).length}</div>
              </div>
              <div className="px-3 py-2 rounded-xl bg-black/30 border border-white/20 text-center">
                <div className="text-[10px] uppercase text-emerald-300 font-bold">Dataverse Sync</div>
                <div className="text-sm font-black">Active</div>
              </div>
            </div>
          </div>
        </div>

        {statusBanner && (
          <div className="rounded-xl border border-emerald-500/60 bg-emerald-500/15 px-4 py-2.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 flex items-center justify-between">
            <span>{statusBanner}</span>
            <button type="button" onClick={() => setStatusBanner('')} className="underline">Dismiss</button>
          </div>
        )}

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          {/* LEFT 5 COLUMNS: UPLOAD POTENTIAL HARBORAGE POINT & "WHAT DO YOU THINK ABOUT IT?" FORM */}
          <form
            onSubmit={handleSubmitConcern}
            className={`lg:col-span-5 rounded-2xl border shadow-sm overflow-hidden flex flex-col ${theme.bgCard}`}
          >
            <div className="px-5 py-3.5 bg-[#00468B] text-white border-b-2 border-[#FFB81C]">
              <h3 className="text-sm font-black uppercase tracking-wider">
                Upload Potential Harborage Point / Facility Concern
              </h3>
              <p className="text-[11px] text-sky-200">
                Synced to <span className="font-mono">PATHOGEN_BOLO_HARBORAGE_CONCERNS</span> & <span className="font-mono">craa5__facilityobservations</span>
              </p>
            </div>

            <div className="p-4 space-y-3.5 text-xs">
              <div className="grid grid-cols-2 gap-2.5">
                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Facility Room / Area</label>
                  <select
                    value={draftConcern.room}
                    onChange={e => {
                      const rk = e.target.value;
                      const rmMeta = ROOM_META[rk] || ROOM_META.WJ;
                      const firstSite = fullSiteCatalog.find(s => s.room === rk);
                      setDraftConcern(prev => ({
                        ...prev,
                        room: rk,
                        siteCode: firstSite ? firstSite.siteCode : prev.siteCode,
                        spot: {
                          x: round2(rmMeta.defaultBox[0] + rmMeta.defaultBox[2] / 2),
                          y: round2(rmMeta.defaultBox[1] + rmMeta.defaultBox[3] / 2)
                        }
                      }));
                    }}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    {Object.keys(ROOM_META).map(rk => (
                      <option key={rk} value={rk}>{ROOM_META[rk].label}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Nearest 0320- Swab Site</label>
                  <input
                    type="text"
                    value={draftConcern.siteCode}
                    onChange={e => setDraftConcern(prev => ({ ...prev, siteCode: e.target.value }))}
                    placeholder="e.g. 0320-STLWJ1-066"
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-mono font-bold ${theme.bgInput}`}
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-2.5">
                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Surface / Vector Category</label>
                  <select
                    value={draftConcern.surfaceCategory}
                    onChange={e => setDraftConcern(prev => ({ ...prev, surfaceCategory: e.target.value }))}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    <option value="Floor / Trench / Drain">Floor / Trench / Drain</option>
                    <option value="Slicer / Nozzle / Blade">Slicer / Nozzle / Blade</option>
                    <option value="Conveyor / Belt / Return">Conveyor / Belt / Return</option>
                    <option value="Mixer / Crumb / Melter">Mixer / Crumb / Melter</option>
                    <option value="Platform / Frame / Pillar">Platform / Frame / Pillar</option>
                    <option value="Overhead / Condensate / Piping">Overhead / Condensate / Piping</option>
                  </select>
                </div>

                <div>
                  <label className="block text-[10px] font-black uppercase opacity-75 mb-1">Concern Severity</label>
                  <select
                    value={draftConcern.severity}
                    onChange={e => setDraftConcern(prev => ({ ...prev, severity: e.target.value }))}
                    className={`w-full rounded-xl border px-2.5 py-1.5 font-bold ${theme.bgInput}`}
                  >
                    <option value="CRITICAL">CRITICAL (Active Harborage Risk)</option>
                    <option value="HIGH">HIGH (Water / Product Trap)</option>
                    <option value="ELEVATED">ELEVATED (Preventive Concern)</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-black uppercase opacity-75 mb-1">
                  Harborage Point / Concern Title *
                </label>
                <input
                  type="text"
                  required
                  value={draftConcern.title}
                  onChange={e => setDraftConcern(prev => ({ ...prev, title: e.target.value }))}
                  placeholder="e.g. Hollow Support Leg Weld Seam by WJ1 Slicer Discharge"
                  className={`w-full rounded-xl border px-3 py-2 font-bold ${theme.bgInput}`}
                />
              </div>

              <div>
                <label className={`block text-[10px] font-black uppercase mb-1 ${theme.textMuted}`}>
                  What Do You Think About It? (Your Hypothesis, Observations & Why It Harbors) *
                </label>
                <textarea
                  rows={4}
                  required
                  value={draftConcern.userThought}
                  onChange={e => setDraftConcern(prev => ({ ...prev, userThought: e.target.value }))}
                  placeholder="Share what you think is happening here (e.g., high-pressure washdown forces water into this seam, and mid-shift vibration drips it onto the floor)..."
                  className={`w-full rounded-xl border p-2.5 font-medium leading-relaxed ${theme.bgInput}`}
                />
              </div>

              <div>
                <label className="block text-[10px] font-black uppercase opacity-75 mb-1">
                  Recommended Fix / Sanitation or Maintenance Action
                </label>
                <input
                  type="text"
                  value={draftConcern.proposedAction}
                  onChange={e => setDraftConcern(prev => ({ ...prev, proposedAction: e.target.value }))}
                  placeholder="e.g. Seal weld seam, replace Delrin scraper, or add to deep-clean teardown checklist..."
                  className={`w-full rounded-xl border px-3 py-1.5 ${theme.bgInput}`}
                />
              </div>

              {/* Photo Upload + Interactive Mini-Map Coordinate Pin Picker */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <div className={`p-2.5 rounded-xl border space-y-2 ${theme.bgSubtle}`}>
                  <label className="block text-[10px] font-black uppercase">
                    Upload Photo / Evidence Image
                  </label>
                  <input
                    type="file"
                    accept="image/*"
                    onChange={handlePhotoFileChange}
                    className="w-full text-[10px]"
                  />
                  {draftConcern.photoDataUrl ? (
                    <img
                      src={draftConcern.photoDataUrl}
                      alt="Harborage Preview"
                      className="w-full h-24 object-cover rounded-lg border"
                    />
                  ) : (
                    <div className="text-[10px] opacity-75">
                      Optional: Upload a photo from your phone/PC, or an annotated evidence diagram will be generated automatically.
                    </div>
                  )}
                </div>

                <div className={`p-2.5 rounded-xl border space-y-1.5 ${theme.bgSubtle}`}>
                  <div className="flex items-center justify-between text-[10px] font-black uppercase">
                    <span>Click Mini-Map to Pin</span>
                    <span className="font-mono text-[#0072CE]">({draftConcern.spot.x}%, {draftConcern.spot.y}%)</span>
                  </div>
                  <div
                    onClick={e => {
                      const r = e.currentTarget.getBoundingClientRect();
                      const x = round2(clamp01((e.clientX - r.left) / r.width) * 100);
                      const y = round2(clamp01((e.clientY - r.top) / r.height) * 100);
                      setDraftConcern(prev => ({ ...prev, spot: { x, y } }));
                    }}
                    className="relative w-full h-24 rounded-lg overflow-hidden border cursor-crosshair bg-slate-900"
                  >
                    {mapImage && (
                      <img src={mapImage} alt="Mini Map Picker" className="w-full h-full object-cover opacity-85 pointer-events-none" />
                    )}
                    <div
                      className="absolute -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#0072CE] border-2 border-white shadow-md pointer-events-none"
                      style={{ left: `${draftConcern.spot.x}%`, top: `${draftConcern.spot.y}%` }}
                    />
                  </div>
                </div>
              </div>

              <button
                type="submit"
                disabled={saving}
                className="w-full py-2.5 rounded-xl bg-[#0072CE] text-white font-black text-xs uppercase tracking-wider hover:bg-[#00468B] shadow-md cursor-pointer"
              >
                {saving ? 'Uploading Harborage Concern to Dataverse...' : 'Submit Harborage Point & Share Thoughts'}
              </button>
            </div>
          </form>

          {/* RIGHT 7 COLUMNS: FACILITY HARBORAGE CONCERNS FEED & PEER DISCUSSION */}
          <div className="lg:col-span-7 space-y-4">
            {/* Filter Bar */}
            <div className={`rounded-2xl border p-3.5 flex flex-wrap items-center justify-between gap-2 ${theme.bgCard}`}>
              <div className="flex flex-wrap items-center gap-1.5">
                <select
                  value={filterRoom}
                  onChange={e => setFilterRoom(e.target.value)}
                  className={`rounded-xl border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                >
                  <option value="ALL">All Rooms ({(harborageConcerns || []).length})</option>
                  {Object.keys(ROOM_META).map(rk => (
                    <option key={rk} value={rk}>{ROOM_META[rk].label}</option>
                  ))}
                </select>

                <select
                  value={filterStatus}
                  onChange={e => setFilterStatus(e.target.value)}
                  className={`rounded-xl border px-2.5 py-1.5 text-xs font-bold ${theme.bgInput}`}
                >
                  <option value="ALL">All Statuses</option>
                  <option value="Open Investigation">Open Investigation</option>
                  <option value="Escalated to Maintenance">Escalated to Maintenance</option>
                  <option value="Verified / Resolved">Verified / Resolved</option>
                </select>
              </div>

              <input
                type="search"
                value={searchQuery}
                onChange={e => setSearchQuery(e.target.value)}
                placeholder="Search harborage points, thoughts, 0320- sites..."
                className={`w-64 rounded-xl border px-3 py-1.5 text-xs ${theme.bgInput}`}
              />
            </div>

            {/* Harborage Cards */}
            <div className="space-y-4">
              {filteredConcerns.map(item => {
                const rmMeta = ROOM_META[item.room] || ROOM_META.WJ;
                const sevColor = item.severity === 'CRITICAL' ? BOLO_TONES.act.hex : (item.severity === 'HIGH' ? BOLO_TONES.watch.hex : BOLO_TONES.plain.hex);
                return (
