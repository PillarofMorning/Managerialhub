// The automatic note for a slot, in the language shown (the saved ones are kept as typed)
function autoSynopsisText(slot, catMode, pressureAnalysis) {
  const em = (pressureAnalysis && pressureAnalysis.executiveMetrics) || {};
  const c = (em.byCategory && em.byCategory[catMode || 'pathogen']) || null;
  if (!c) return '';
  const word = { pathogen: tr('Pathogen', 'Patogenos'), apc: 'APC', atp: 'ATP', all: tr('All tests', 'Todas las pruebas') }[catMode || 'pathogen'];
