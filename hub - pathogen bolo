  }, [isBareMapActive, showRoomBoxes, effectiveFacilityAreas, hideLegacyAreas, currentAreaFilterMode, activeTargetZoneId, filteredOutCurrentAreaIds, areaFilterText]);

  const filteredOutCurrentCount = useMemo(() => {
