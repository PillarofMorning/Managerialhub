        x: round2(Math.round(rawX / 0.5) * 0.5),
        y: round2(Math.round(rawY / 0.5) * 0.5),
        snapped: false,
        snapType: 'grid',
        snapNote: '0.5% Grid',
        guides: []
      };
    }
    return {
      x: round2(rawX),
      y: round2(rawY),
      snapped: false,
      snapType: 'none',
      snapNote: 'Exact freehand coordinate',
      guides: []
    };
  }, [snapToSetAreas, snapRadiusPct, snapToGrid, visibleFacilityAreas, mapMode, activeArchitectAreaId, hideLegacyAreas]);

  // Commit a newly drawn Free-Form Polygon or Free-Form Lasso or Snap Box to the selected Facility Area
  const commitPolygonToFacilityArea = useCallback((points, drawMethodLabel = 'freeform_poly') => {
    if (!Array.isArray(points) || points.length < 3) return;
    const bbox = computePolygonBoundingBox(points);
    const center = [round2(bbox[0] + bbox[2] / 2), round2(bbox[1] + bbox[3] / 2)];
    const targetId = activeArchitectAreaId || 'WJ';

    setFacilityAreas(prev => {
      const list = Array.isArray(prev) && prev.length > 0 ? [...prev] : buildDefaultFacilityAreas();
      const idx = list.findIndex(a => a.id === targetId);
      if (idx !== -1) {
        list[idx] = {
          ...list[idx],
          hasDrawnBoundary: true,
          box: bbox,
          points: points.map(pt => [round2(pt[0]), round2(pt[1])]),
          shapeType: drawMethodLabel,
          isLegacy: false,
          hidden: false,
          updatedAt: new Date().toISOString().slice(0, 10),
          updatedBy: (msIdentity && msIdentity.userName) || 'MS ID Architect'
        };
      } else {
        const rmMeta = ROOM_META[targetId] || ROOM_META.WJ;
        list.push({
          id: targetId,
          roomKey: ROOM_META[targetId] ? targetId : 'WJ',
          label: rmMeta ? rmMeta.label : targetId,
          short: rmMeta ? rmMeta.short : targetId,
          color: rmMeta ? rmMeta.color : '#0072CE',
          border: rmMeta ? rmMeta.border : '#00468B',
          hasDrawnBoundary: true,
          box: bbox,
          points: points.map(pt => [round2(pt[0]), round2(pt[1])]),
          shapeType: drawMethodLabel,
          isLegacy: false,
          hidden: false,
          updatedAt: new Date().toISOString().slice(0, 10),
          updatedBy: (msIdentity && msIdentity.userName) || 'MS ID Architect'
        });
      }
      return list;
    });

    // Unfilter the newly drawn target area and exit bareMapMode so user can see the boundary they just drew
    setBareMapMode(false);
    setShowRoomBoxes(true);
    setFilteredOutCurrentAreaIds(prev => {
      if (!prev[targetId]) return prev;
      const next = { ...prev };
      delete next[targetId];
      return next;
    });
    if (currentAreaFilterMode === 'hide_all_current') {
      setCurrentAreaFilterMode('show_all');
    }

    // Also keep roomMappings synchronized if targetId is a standard room key
    if (ROOM_META[targetId]) {
      setRoomMappings(prev => ({
        ...prev,
        [targetId]: {
          x: center[0],
          y: center[1],
          box: bbox,
          points: points.map(pt => [round2(pt[0]), round2(pt[1])]),
          snapped: snapToSetAreas,
          how: drawMethodLabel,
          map: 'MAIN'
        }
      }));
    }

    setPolyDraftPoints([]);
    setLassoDraftPoints([]);
    logEvent(`Facility Architect (${msIdentity ? msIdentity.microsoftId : 'MS ID'}): Saved ${drawMethodLabel} boundary (${points.length} vertices) for Set Area "${targetId}".`, 'success');
  }, [activeArchitectAreaId, setFacilityAreas, setRoomMappings, snapToSetAreas, msIdentity, logEvent, currentAreaFilterMode]);

  const pickPoint = async (x, y) => {
    // If in MS-ID Facility Architect Mode with Free-Form Polygon tool: add vertex!
    if (mapMode === 'architect' && isDevAuthorized && architectDrawTool === 'freeform_poly') {
      const snappedPt = resolvePointWithSetAreaSnap(x, y);
      setCursorSnapPreview(snappedPt);
      setPolyDraftPoints(prev => {
        // If user clicked within 1.6% of the first vertex and we already have >= 3 vertices, close and commit the polygon!
        if (prev.length >= 3) {
          const first = prev[0];
          const distToStart = Math.hypot(snappedPt.x - first[0], snappedPt.y - first[1]);
          if (distToStart <= 1.8) {
            setTimeout(() => commitPolygonToFacilityArea(prev, snapToSetAreas ? 'freeform_poly_snapped' : 'freeform_poly'), 0);
            return [];
          }
        }
        return [...prev, [snappedPt.x, snappedPt.y]];
      });
      return;
    }

    const seq = clickSeq.current + 1;
    clickSeq.current = seq;
    const setAreaSnap = resolvePointWithSetAreaSnap(x, y);
    let region = null;
    let note = setAreaSnap.snapped ? setAreaSnap.snapNote : '';
    const effX = setAreaSnap.x;
    const effY = setAreaSnap.y;

    if (snapOn && effectiveMapImage) {
      setSnapBusy(true);
      try {
        const grid = await getSnapGrid(effectiveMapImage);
        region = snapAt(grid, effX, effY);
        if (!region && !note) note = 'Open floor (exact click used)';
      } catch (e) {
        note = e.message;
      }
      if (seq === clickSeq.current) setSnapBusy(false);
    }
    if (seq !== clickSeq.current) return;
    const next = region
      ? {
          x: region.inside ? round2(effX) : round2(region.x),
          y: region.inside ? round2(effY) : round2(region.y),
          box: region.box.map(round2),
          snapped: true,
          how: 'click',
          region,
          note: setAreaSnap.snapped ? `${setAreaSnap.snapNote} + Smart Snap` : 'Smart Snap outlined area'
        }
      : {
          x: round2(effX),
          y: round2(effY),
          box: [round2(Math.max(0, effX - 2)), round2(Math.max(0, effY - 2)), 4, 4],
          snapped: setAreaSnap.snapped,
          how: 'click',
          region: null,
          note: note || 'Exact point'
        };
    setPickedSpot(next);
    if (mapMode === 'heatmap') {
      logEvent(`Picked map spot at (${next.x}%, ${next.y}%). Click Save Area Mapping in the banner to assign.`, 'info');
    }
  };

  const pickBox = async (rect) => {
    const seq = clickSeq.current + 1;
    clickSeq.current = seq;

    // Apply Magnetic Snap to Visible Set Areas on the rectangle edges if enabled
    let finalRect = rect;
    let setSnapNotes = [];
    if (snapToSetAreas && visibleFacilityAreas.length > 0) {
      const snappedRectObj = snapRectToSetAreas(rect, visibleFacilityAreas, {
        snapThreshold: snapRadiusPct,
        excludeAreaId: mapMode === 'architect' ? activeArchitectAreaId : null,
        includeLegacy: !hideLegacyAreas
      });
      finalRect = snappedRectObj.rect;
      setSnapNotes = snappedRectObj.notes || [];
    }

    const box = [
      round2(finalRect[0]),
      round2(finalRect[1]),
      round2(finalRect[2] - finalRect[0]),
      round2(finalRect[3] - finalRect[1])
    ];
    const middle = [round2(finalRect[0] + box[2] / 2), round2(finalRect[1] + box[3] / 2)];

    // If in Facility Architect mode, allow immediate saving or commit of the snapped box to the active Set Area
    if (mapMode === 'architect' && isDevAuthorized) {
      const boxPts = boxToPolygonPoints(box);
      commitPolygonToFacilityArea(boxPts, snapToSetAreas ? 'box_snapped_set_areas' : 'box');
      return;
    }

    let region = null;
    let note = setSnapNotes.length > 0 ? `Snapped to ${setSnapNotes.join(' & ')}` : '';
    if (snapOn && effectiveMapImage && setSnapNotes.length === 0) {
      setSnapBusy(true);
      try {
        const grid = await getSnapGrid(effectiveMapImage);
        region = snapBox(grid, finalRect);
        if (!region && !note) note = 'No enclosed lines (drawn box used)';
      } catch (e) {
        note = e.message;
      }
      if (seq === clickSeq.current) setSnapBusy(false);
    }
    if (seq !== clickSeq.current) return;
    const next = region
      ? { x: round2(region.x), y: round2(region.y), box: region.box.map(round2), snapped: true, how: 'box', region, note: note || 'Smart Snap fitted to walls/equipment' }
      : { x: middle[0], y: middle[1], box, snapped: setSnapNotes.length > 0, how: 'box', region: null, note: note || 'Drawn box' };
    setPickedSpot(next);
  };

  // Pointer drag / click / free-form lasso state machine
  const gesture = useRef({ start: null, mode: '' });
  const onPointerDown = (e) => {
    if (e.pointerType === 'mouse' && e.button !== 0 && e.button !== 1) return;
    if (e.target && e.target.closest && e.target.closest('[data-bolo-pin]')) return;
    const c = containerRef.current;
    const frac = stageFraction(e.clientX, e.clientY);
    const picPt = toPicture(frac[0], frac[1]);

    // If in MS-ID Architect Mode with Free-Form Lasso tool and not middle-mouse panning:
    if (mapMode === 'architect' && isDevAuthorized && architectDrawTool === 'freeform_lasso' && e.button !== 1 && dragMode !== 'move') {
      const snappedStart = resolvePointWithSetAreaSnap(picPt[0], picPt[1]);
      setLassoDraftPoints([[snappedStart.x, snappedStart.y]]);
      setCursorSnapPreview(snappedStart);
      gesture.current = {
        mode: 'lasso',
        start: { id: e.pointerId, x: e.clientX, y: e.clientY, frac }
      };
      return;
    }

    gesture.current = {
      mode: 'press',
      start: {
        id: e.pointerId,
        x: e.clientX,
        y: e.clientY,
        left: c ? c.scrollLeft : 0,
        top: c ? c.scrollTop : 0,
        pan: e.button === 1 || dragMode === 'move',
        frac
      }
    };
  };

  const onPointerMove = (e) => {
    const frac = stageFraction(e.clientX, e.clientY);
    const picPt = toPicture(frac[0], frac[1]);

    // Update live magnetic snap preview when in Architect or Setup mode
    if (mapMode === 'architect' || mapMode === 'setup') {
      const snapPreview = resolvePointWithSetAreaSnap(picPt[0], picPt[1]);
      setCursorSnapPreview(snapPreview);
    }

    const g = gesture.current;
    if (!g.start || g.start.id !== e.pointerId) return;

    if (g.mode === 'lasso') {
      const snappedPt = resolvePointWithSetAreaSnap(picPt[0], picPt[1]);
      setLassoDraftPoints(prev => {
        if (prev.length === 0) return [[snappedPt.x, snappedPt.y]];
        const last = prev[prev.length - 1];
        if (Math.hypot(snappedPt.x - last[0], snappedPt.y - last[1]) < 0.45) return prev;
        return [...prev, [snappedPt.x, snappedPt.y]];
      });
      return;
    }

    const dx = e.clientX - g.start.x;
    const dy = e.clientY - g.start.y;
    if (g.mode === 'press') {
      if (Math.hypot(dx, dy) < 6) return;
      if (mapMode === 'architect' && architectDrawTool === 'freeform_poly' && !g.start.pan) {
        // In free-form polygon vertex mode, clicks add vertices; don't switch to box unless panning
        return;
      }
      g.mode = g.start.pan ? 'pan' : 'box';
    }
    if (g.mode === 'pan') {
      const c = containerRef.current;
      if (c) {
        c.scrollLeft = g.start.left - dx;
        c.scrollTop = g.start.top - dy;
      }
    } else if (g.mode === 'box') {
      setDragRect([g.start.frac[0], g.start.frac[1], frac[0], frac[1]]);
    }
  };

  const onPointerUp = (e) => {
    const g = gesture.current;
    if (!g.start || g.start.id !== e.pointerId) return;
    const mode = g.mode;
    const start = g.start;
    gesture.current = { start: null, mode: '' };

    if (mode === 'lasso') {
      if (lassoDraftPoints.length >= 3) {
        const simplified = simplifyFreehandPoints(lassoDraftPoints, 0.75);
        const snappedVertices = simplified.map(pt => {
          const sp = resolvePointWithSetAreaSnap(pt[0], pt[1]);
          return [sp.x, sp.y];
        });
        commitPolygonToFacilityArea(snappedVertices, snapToSetAreas ? 'freeform_lasso_snapped' : 'freeform_lasso');
      }
      setLassoDraftPoints([]);
      return;
    }

    if (mode === 'press') {
      const p = toPicture(start.frac[0], start.frac[1]);
      pickPoint(p[0], p[1]);
    } else if (mode === 'box') {
      setDragRect(null);
      const f = stageFraction(e.clientX, e.clientY);
      const a = toPicture(start.frac[0], start.frac[1]);
      const b = toPicture(f[0], f.length ? f[1] : 0);
      const rect = [Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.max(a[0], b[0]), Math.max(a[1], b[1])];
      if (rect[2] - rect[0] < 0.5 && rect[3] - rect[1] < 0.5) {
        pickPoint((rect[0] + rect[2]) / 2, (rect[1] + rect[3]) / 2);
      } else {
        pickBox(rect);
      }
    }
  };

  // Save picked spot to the currently selected Swab Site or Room Zone
  const handleSavePickedSpot = () => {
    if (!pickedSpot) return;
    const cleanSpot = {
      x: pickedSpot.x,
      y: pickedSpot.y,
      box: pickedSpot.box,
      snapped: pickedSpot.snapped,
      how: pickedSpot.how,
      map: 'MAIN'
    };
    if (setupTargetType === 'site' && setupSiteCode) {
      setSiteMappings(prev => ({ ...prev, [setupSiteCode]: cleanSpot }));
      logEvent(`Mapped Swab Site ${setupSiteCode} to (${cleanSpot.x}%, ${cleanSpot.y}%).`, 'success');
    } else if (setupTargetType === 'room' && setupRoomKey) {
      setRoomMappings(prev => ({ ...prev, [setupRoomKey]: cleanSpot }));
      // Also update facilityAreas box for that room and mark hasDrawnBoundary: true
      setFacilityAreas(prev => (prev || []).map(a => a.id === setupRoomKey ? {
        ...a,
        hasDrawnBoundary: true,
        box: cleanSpot.box,
        points: boxToPolygonPoints(cleanSpot.box),
        isLegacy: false,
        hidden: false
      } : a));
      setBareMapMode(false);
      setShowRoomBoxes(true);
      if (currentAreaFilterMode === 'hide_all_current') {
        setCurrentAreaFilterMode('show_all');
      }
      logEvent(`Mapped Room Area ${setupRoomKey} to (${cleanSpot.x}%, ${cleanSpot.y}%).`, 'success');
    }
    setPickedSpot(null);
  };

  // Create a brand new Set Area in Facility Architect Mode (starts un-drawn on bare map so user can draw exact boundary)
  const handleCreateNewFacilityArea = () => {
    const cleanId = (newAreaDraft.id || newAreaDraft.short || newAreaDraft.label).trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '-');
    if (!cleanId) return;
    const newAreaObj = {
      id: cleanId,
      roomKey: newAreaDraft.roomKey || 'WJ',
      label: newAreaDraft.label.trim() || cleanId,
      short: newAreaDraft.short.trim() || cleanId.slice(0, 10),
      color: newAreaDraft.color || '#0072CE',
      border: newAreaDraft.color || '#00468B',
      hasDrawnBoundary: false,
      box: null,
      points: [],
      shapeType: 'freeform_poly',
      isLegacy: !!newAreaDraft.isLegacy,
      hidden: false,
      createdAt: new Date().toISOString().slice(0, 10),
      updatedBy: (msIdentity && msIdentity.userName) || 'MS ID Architect'
    };
    setFacilityAreas(prev => [...(prev || []), newAreaObj]);
    setActiveArchitectAreaId(cleanId);
    setShowNewAreaForm(false);
    setNewAreaDraft({ id: '', label: '', short: '', roomKey: 'WJ', color: '#0072CE', isLegacy: false });
    logEvent(`Created new Facility Set Area "${newAreaObj.label}" (${cleanId}). Click or trace on the bare map to set its boundary.`, 'success');
  };

  // Toggle an area's Old / Legacy status
  const handleToggleLegacyArea = (areaId) => {
    setFacilityAreas(prev => (prev || []).map(a => a.id === areaId ? { ...a, isLegacy: !a.isLegacy } : a));
    logEvent(`Toggled Old/Legacy flag on Facility Area "${areaId}".`, 'info');
  };

  // Toggle an area's Hidden status
  const handleToggleHiddenArea = (areaId) => {
    setFacilityAreas(prev => (prev || []).map(a => a.id === areaId ? { ...a, hidden: !a.hidden } : a));
  };

  // Clear a single area's drawn boundary back to unmapped
  const handleClearSingleAreaBoundary = (areaId) => {
    setFacilityAreas(prev => (prev || []).map(a => a.id === areaId ? {
      ...a,
      hasDrawnBoundary: false,
      box: null,
      points: []
    } : a));
    setRoomMappings(prev => {
      const next = { ...prev };
      delete next[areaId];
      return next;
    });
    logEvent(`Cleared drawn boundary for area "${areaId}".`, 'info');
  };

  // Permanently remove an old/legacy or unwanted area
  const handleRemoveFacilityArea = (areaId) => {
    setFacilityAreas(prev => (prev || []).filter(a => a.id !== areaId));
    setRoomMappings(prev => {
      const next = { ...prev };
      delete next[areaId];
      return next;
    });
    if (activeArchitectAreaId === areaId) {
      setActiveArchitectAreaId('WJ');
    }
    logEvent(`Removed Facility Area "${areaId}" from active plant layout.`, 'warn');
  };

  // Purge all areas marked as Old / Legacy in one click
  const handlePurgeAllLegacyAreas = () => {
    const removedIds = effectiveFacilityAreas.filter(a => a.isLegacy).map(a => a.id);
    if (removedIds.length === 0) return;
    setFacilityAreas(prev => (prev || []).filter(a => !a.isLegacy));
    logEvent(`Purged ${removedIds.length} Old/Legacy areas (${removedIds.join(', ')}) from the facility layout.`, 'warn');
  };

  // Auto-link swab sites from Dataverse placed assets (craa5_aa_assetses) by matching assetTag or equipment name
  const handleAutoLinkFromAssets = () => {
    if (placedAssets.length === 0) {
      logEvent('No placed Dataverse assets (craa5_aa_assetses) currently loaded to auto-link.', 'warn');
      return;
    }
    let linked = 0;
    const next = { ...siteMappings };
    fullSiteCatalog.forEach(site => {
      if (!site.assetTag) return;
      const tagUpper = site.assetTag.toUpperCase();
      const match = placedAssets.find(a => a.name.toUpperCase().indexOf(tagUpper) !== -1 || a.area.toUpperCase().indexOf(tagUpper) !== -1);
      if (match && match.location) {
        next[site.siteCode] = { ...match.location };
        linked += 1;
      }
    });
    setSiteMappings(next);
    logEvent(`Auto-linked ${linked} swab sites from placed Dataverse equipment assets.`, 'success');
  };

  // Filtered sites for the Setup Sidebar
  const setupSiteList = useMemo(() => {
    const q = setupSearch.trim().toLowerCase();
    const hitCodes = {};
    allHits.forEach(h => { if (h.siteCode) hitCodes[h.siteCode] = (hitCodes[h.siteCode] || 0) + 1; });

    return fullSiteCatalog.filter(s => {
      if (setupFilter === 'hits' && !hitCodes[s.siteCode]) return false;
      if (setupFilter === 'custom' && !siteMappings[s.siteCode]) return false;
      if (setupFilter === 'unmapped' && siteMappings[s.siteCode]) return false;
      if (!q) return true;
      const hay = `${s.siteCode} ${s.room} ${s.areaCode} ${s.surface} ${s.description} ${s.assetTag}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [fullSiteCatalog, allHits, siteMappings, setupSearch, setupFilter]);

  // Filtered Facility Areas for the Architect Sidebar
  const architectFilteredAreas = useMemo(() => {
    const q = areaFilterText.trim().toLowerCase();
    return effectiveFacilityAreas.filter(a => {
      if (architectListFilter === 'active' && (a.isLegacy || a.hidden)) return false;
      if (architectListFilter === 'legacy' && !a.isLegacy && !a.hidden) return false;
      if (!q) return true;
      return `${a.id} ${a.label} ${a.short} ${a.roomKey || ''}`.toLowerCase().indexOf(q) !== -1;
    });
  }, [effectiveFacilityAreas, architectListFilter, areaFilterText]);

  const selectedPinDetail = useMemo(() => {
    if (!selectedPinKey) return null;
    const hitGroup = groupedHitPins.find(p => p.key === selectedPinKey || p.siteCode === selectedPinKey);
    if (hitGroup) return hitGroup;
    const catSite = fullSiteCatalog.find(s => s.siteCode === selectedPinKey);
    if (catSite) {
      return {
        key: catSite.siteCode,
        siteCode: catSite.siteCode,
        room: catSite.room,
        surface: catSite.surface,
        description: catSite.description,
        assetTag: catSite.assetTag,
        spot: catSite.effectiveSpot,
        isCustomMapped: !!catSite.customSpot,
        count: 0,
        primaryType: 'MONITORED',
        color: BRAND.blue,
        hits: []
      };
    }
    return null;
  }, [selectedPinKey, groupedHitPins, fullSiteCatalog]);

  // Find matching Suggested Action for the selected pin in Map Inspector
  const selectedPinSuggestedAction = useMemo(() => {
    if (!selectedPinDetail || !suggestedActionsMap) return null;
    const bySite = Object.values(suggestedActionsMap).find(a => a.siteCode && a.siteCode === selectedPinDetail.siteCode);
    if (bySite) return bySite;
    const byRoom = Object.values(suggestedActionsMap).find(a => a.room === selectedPinDetail.room);
    return byRoom || null;
  }, [selectedPinDetail, suggestedActionsMap]);

  return localizeReactTree((
    <div className={`${popped ? 'fixed inset-0 z-50' : 'h-full'} flex flex-col lg:flex-row overflow-hidden p-3 sm:p-5 gap-4 ${theme.bgApp}`}>
      {/* LEFT / MAIN MAP STAGE */}
      <div className={`flex-1 flex flex-col min-h-0 rounded-xl border shadow-sm overflow-hidden ${theme.bgCard}`}>
        {/* Map Control Bar */}
        <div className="p-2.5 border-b border-slate-700/20 flex flex-wrap items-center justify-between gap-2">
          <div className="flex flex-wrap items-center gap-1.5">
            {/* Mode Switcher */}
            <button
              type="button"
              onClick={() => setMapMode('heatmap')}
              className={`px-2.5 py-1.5 rounded-lg text-xs font-black transition-all ${
                mapMode === 'heatmap'
                  ? 'bg-[#E4002B] text-white shadow-sm'
                  : `${theme.bgSubtle} hover:border-[#E4002B]`
              }`}
            >
              1. BOLO Heatmap ({visibleHitPins.length}/{groupedHitPins.length})
            </button>
            <button
              type="button"
              onClick={() => setMapMode('setup')}
              className={`px-2.5 py-1.5 rounded-lg text-xs font-black transition-all ${
                mapMode === 'setup'
                  ? 'bg-[#00468B] text-white shadow-sm'
                  : `${theme.bgSubtle} hover:border-[#0072CE]`
              }`}
            >
              2. Swab Site & Room Linker
            </button>

            {/* 3. FACILITY SETUP MODE - STRICTLY GATED BEHIND MICROSOFT ID (isDevAuthorized) */}
            {isDevAuthorized ? (
              <button
                type="button"
                onClick={() => setMapMode('architect')}
                className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-black transition-all ${
                  mapMode === 'architect'
                    ? 'bg-emerald-600 text-white shadow-sm ring-2 ring-[#FFB81C]'
                    : 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/40 hover:bg-emerald-600 hover:text-white'
                }`}
                title="Authorized via Microsoft ID: Free-Form Draw, Snap to Set Areas, and Filter/Remove Old Areas"
              >
                <PenToolIcon className="w-3.5 h-3.5" />
                <span>3. Facility Setup (MS ID)</span>
              </button>
            ) : (
              <span
                className="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-bold bg-slate-500/10 text-slate-400 border border-slate-500/20"
                title="Facility Setup (Free-Form Draw & Area Removal) requires authorized Microsoft ID login (admin)"
              >
                <LockIcon className="w-3 h-3" /> Facility Setup (MS ID Only)
              </span>
            )}

            {/* TRUE BARE MAP MODE TOGGLE (Hides 100% of pins, boxes, labels, and overlays so only raw floorplan is shown) */}
            <button
              type="button"
              onClick={() => {
                if (isBareMapActive) {
                  handleShowAllCurrentAreas();
                } else {
                  handleFilterOutAllCurrentAreas();
                }
              }}
              className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black border transition-all cursor-pointer ${
                isBareMapActive
                  ? 'bg-[#FFB81C] text-slate-950 border-[#FFB81C] shadow-sm ring-2 ring-[#00468B]'
                  : `${theme.bgSubtle} hover:border-[#0072CE]`
              }`}
              title="Hides 100% of room boxes, BOLO hit pins, catalog pins, and harborage markers so you see ONLY the bare map while setting up areas"
            >
              {isBareMapActive ? <EyeOffIcon className="w-3.5 h-3.5" /> : <FilterIcon className="w-3.5 h-3.5" />}
              <span>
                {isBareMapActive
                  ? 'Bare Map Active (All Overlays Hidden - Click to Show)'
                  : 'Bare Map Mode (Filter Out All Overlays)'}
              </span>
            </button>

            {/* Reset All Areas to Bare Map Button */}
            <button
              type="button"
              onClick={handleResetAllAreasToBareMap}
              className={`inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-bold border border-red-400/50 text-[#E4002B] dark:text-rose-300 hover:bg-red-600 hover:text-white transition-all`}
              title="Clear all drawn room boundaries and site pins so you can draw actual facility areas from scratch on the bare map"
            >
