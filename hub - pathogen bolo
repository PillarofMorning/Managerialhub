                  className={`absolute -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full shadow-md hover:scale-125 transition-transform ${dp.tone === 'act' || dp.tone === 'watch' ? 'z-[22]' : 'z-[21]'} ${dp.estimated ? 'border-2 border-dashed border-slate-900 dark:border-white' : 'border-2 border-white'}`}
