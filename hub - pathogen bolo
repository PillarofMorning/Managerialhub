  // Current & Legacy Area Filtering States (to cleanly filter out current areas when setting up BOLO zones)
  const [hideLegacyAreas, setHideLegacyAreas] = useState(true);
  const [currentAreaFilterMode, setCurrentAreaFilterMode] = useState('show_all'); // 'show_all' | 'hide_all_current' | 'only_target' | 'custom'
  const [filteredOutCurrentAreaIds, setFilteredOutCurrentAreaIds] = useState({}); // { [areaId]: true }
  const [showCurrentAreaFilterBar, setShowCurrentAreaFilterBar] = useState(true);
