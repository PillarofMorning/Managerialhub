          </div>

          {activePoint && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
              {[
                { label: `${ROOM_META.WJ.label} (${tr('Creme side', 'Lado crema')})`, ty: activePoint.wjTY, ly: activePoint.wjLY, color: ROOM_META.WJ.color, room: 'WJ' },
                { label: `${ROOM_META.IBL5.label} (${tr('Creme side', 'Lado crema')})`, ty: activePoint.ibl5TY, ly: activePoint.ibl5LY, color: ROOM_META.IBL5.color, room: 'IBL5' },
                { label: `${ROOM_META.IBL4.label} (${tr('Creme side', 'Lado crema')})`, ty: activePoint.ibl4TY, ly: activePoint.ibl4LY, color: ROOM_META.IBL4.color, room: 'IBL4' },
                { label: `${ROOM_META['Dough Room'].label} (${tr('Bakery', 'Panaderia')})`, ty: activePoint.doughTY, ly: activePoint.doughLY, color: ROOM_META['Dough Room'].color, room: 'Dough Room' },
                { label: tr('APC fail rate (indicator)', 'Porcentaje de fallas APC (indicador)'), ty: activePoint.apcTY, ly: activePoint.apcLY, color: '#f59e0b', room: null },
                { label: tr('ATP fail rate (indicator)', 'Porcentaje de fallas ATP (indicador)'), ty: activePoint.atpTY, ly: activePoint.atpLY, color: '#06b6d4', room: null }
              ].map((row, ri, list) => {
                const maxBar = Math.max(1, ...list.map((x) => Math.max(x.ty || 0, x.ly || 0)));
                const tyPct = Math.min(100, ((row.ty || 0) / maxBar) * 100);
                const lyPct = Math.min(100, ((row.ly || 0) / maxBar) * 100);
                const diff = row.ty !== null && row.ty !== undefined && row.ly !== null && row.ly !== undefined ? Number((row.ty - row.ly).toFixed(2)) : null;
                return (
                  <div key={row.label} style={{ background: darkMode ? '#0f172a' : '#f8fafc', border: `1px solid ${theme.border}`, borderRadius: '8px', padding: '8px 10px' }}>
