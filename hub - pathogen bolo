                      }}
                      className={`absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer group ${isSelected ? 'z-30' : 'z-20'}`}
                      style={{ left: `${pin.spot.x}%`, top: `${pin.spot.y}%` }}
                    >
                      {/* Pulsing halo only for a repeat site (a positive before at the same site, inside the repeat window) */}
                      {pin.repeat && !pin.hollow && (
                        <span
                          className="absolute -inset-2 rounded-full animate-ping opacity-60 pointer-events-none"
                          style={{ backgroundColor: pin.color }}
                        />
