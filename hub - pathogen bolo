const round2 = (n) => Math.round(n * 100) / 100;
// Percent text for display: '--' when there were no swabs behind the number
const fmtPct = (v) => (v === null || v === undefined || isNaN(Number(v)) ? '--' : `${v}%`);

function parseMapLocation(text) {
  if (text === null || text === undefined || String(text).trim() === '') return null;
  const num = (v) => (typeof v === 'number' && isFinite(v) ? clampPct(v) : null);
  try {
    const o = JSON.parse(text);
    if (o && typeof o === 'object') {
      const x = num(o.x);
      const y = num(o.y);
      if (x === null || y === null) return null;
      const box = Array.isArray(o.b) && o.b.length === 4 && o.b.every(v => typeof v === 'number' && isFinite(v)) ? o.b : null;
      return { x, y, box, snapped: o.s === 1 || o.s === 2, how: o.s === 2 ? 'box' : 'click', map: typeof o.m === 'string' ? o.m.toUpperCase() : 'MAIN' };
    }
  } catch (e) { /* fallback */ }
  const m = String(text).match(/^\s*(\d+(?:\.\d+)?)\s*[;,]\s*(\d+(?:\.\d+)?)\s*$/);
  return m ? { x: clampPct(parseFloat(m[1])), y: clampPct(parseFloat(m[2])), box: null, snapped: false, how: 'click', map: 'MAIN' } : null;
}

// --- SMART SNAP ENGINE (Ported from map submission tool.txt, 100% 7-bit ASCII) ---
const SNAP_MAX_SIDE = 1600;
const SNAP_MAX_SHARE = 0.25;
const SNAP_SOLID_SHARE = 0.02;
const SNAP_MIN_PX = 25;

let snapCache = { src: null, promise: null };

const loadPicture = (src) => new Promise((resolve, reject) => {
  const img = new Image();
  img.crossOrigin = 'anonymous';
  img.onload = () => resolve(img);
  img.onerror = () => reject(new Error('The map image could not be decoded for Smart Snap.'));
  img.src = src;
});

function otsuThreshold(hist, total) {
  let sum = 0;
  for (let i = 0; i < 256; i += 1) sum += i * hist[i];
  let sumB = 0;
  let wB = 0;
  let best = 0;
  let threshold = 128;
  for (let t = 0; t < 256; t += 1) {
    wB += hist[t];
    if (wB === 0) continue;
    const wF = total - wB;
    if (wF === 0) break;
    sumB += t * hist[t];
    const mB = sumB / wB;
    const mF = (sum - sumB) / wF;
    const between = wB * wF * (mB - mF) * (mB - mF);
    if (between > best) { best = between; threshold = t + 1; }
  }
  return threshold;
}

function dilate(src, w, h, r) {
  const tmp = new Uint8Array(w * h);
  const out = new Uint8Array(w * h);
  for (let y = 0; y < h; y += 1) {
    const row = y * w;
    let count = 0;
    for (let x = 0; x < Math.min(r, w); x += 1) count += src[row + x];
    for (let x = 0; x < w; x += 1) {
      if (x + r < w) count += src[row + x + r];
      if (x - r - 1 >= 0) count -= src[row + x - r - 1];
      tmp[row + x] = count > 0 ? 1 : 0;
    }
  }
  for (let x = 0; x < w; x += 1) {
    let count = 0;
    for (let y = 0; y < Math.min(r, h); y += 1) count += tmp[y * w + x];
    for (let y = 0; y < h; y += 1) {
      if (y + r < h) count += tmp[(y + r) * w + x];
      if (y - r - 1 >= 0) count -= tmp[(y - r - 1) * w + x];
      out[y * w + x] = count > 0 ? 1 : 0;
    }
  }
  return out;
}

async function buildSnapGrid(src) {
  const img = await loadPicture(src);
  const nw = img.naturalWidth || img.width;
  const nh = img.naturalHeight || img.height;
  if (!nw || !nh) throw new Error('The map picture has no dimensions.');
  const scale = Math.min(1, SNAP_MAX_SIDE / Math.max(nw, nh));
  const w = Math.max(1, Math.round(nw * scale));
  const h = Math.max(1, Math.round(nh * scale));
  const canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(0, 0, w, h);
  if (scale < 1) {
    const cell = 1 / scale;
    const k = Math.min(8, Math.ceil(cell));
    ctx.imageSmoothingEnabled = false;
    ctx.globalCompositeOperation = 'darken';
    for (let oy = 0; oy < k; oy += 1) {
      for (let ox = 0; ox < k; ox += 1) {
        ctx.drawImage(img, (ox * cell) / k, (oy * cell) / k, w * cell, h * cell, 0, 0, w, h);
      }
    }
    ctx.globalCompositeOperation = 'source-over';
  } else {
    ctx.drawImage(img, 0, 0, w, h);
  }
  let pixels;
  try {
    pixels = ctx.getImageData(0, 0, w, h).data;
  } catch (e) {
    throw new Error('Browser prevented reading map pixels for Smart Snap.');
  }
  const n = w * h;
  const lum = new Uint8Array(n);
  const hist = new Array(256);
  for (let i = 0; i < 256; i += 1) hist[i] = 0;
  for (let i = 0; i < n; i += 1) {
    const l = Math.round(0.299 * pixels[i * 4] + 0.587 * pixels[i * 4 + 1] + 0.114 * pixels[i * 4 + 2]);
    lum[i] = l;
    hist[l] += 1;
  }
  const threshold = Math.max(40, Math.min(200, otsuThreshold(hist, n)));
  const dark = new Uint8Array(n);
  for (let i = 0; i < n; i += 1) dark[i] = lum[i] < threshold ? 1 : 0;
  const gap = Math.max(1, Math.round(Math.max(w, h) / 600));
  const closed = dilate(dark, w, h, gap);
  const labels = new Int32Array(n);
  const sizes = [0];
  const edges = [false];
  const stack = new Int32Array(n);
  let next = 1;
  for (let start = 0; start < n; start += 1) {
    if (closed[start] || labels[start]) continue;
    let top = 0;
    let size = 0;
    let edge = false;
    stack[top++] = start;
    labels[start] = next;
    while (top > 0) {
      const i = stack[--top];
      size += 1;
      const x = i % w;
      const y = (i - x) / w;
      if (x === 0 || y === 0 || x === w - 1 || y === h - 1) edge = true;
      if (x > 0 && !closed[i - 1] && !labels[i - 1]) { labels[i - 1] = next; stack[top++] = i - 1; }
      if (x < w - 1 && !closed[i + 1] && !labels[i + 1]) { labels[i + 1] = next; stack[top++] = i + 1; }
      if (y > 0 && !closed[i - w] && !labels[i - w]) { labels[i - w] = next; stack[top++] = i - w; }
      if (y < h - 1 && !closed[i + w] && !labels[i + w]) { labels[i + w] = next; stack[top++] = i + w; }
    }
    sizes.push(size);
    edges.push(edge);
    next += 1;
  }
  return { w, h, dark, closed, labels, sizes, edges, gap, threshold };
}

function getSnapGrid(src) {
  if (snapCache.src !== src || !snapCache.promise) {
    snapCache = { src, promise: buildSnapGrid(src) };
    snapCache.promise.catch(() => { if (snapCache.src === src) snapCache = { src: null, promise: null }; });
  }
  return snapCache.promise;
}

function floodFill(cells, w, h, seed, want, maxArea) {
  if (seed < 0 || cells[seed] !== want) return null;
  const seen = new Uint8Array(w * h);
  const stack = [seed];
  const pixels = [];
  let edge = false;
  seen[seed] = 1;
  while (stack.length) {
    const i = stack.pop();
    pixels.push(i);
    if (pixels.length > maxArea) return null;
    const x = i % w;
    const y = (i - x) / w;
    if (x === 0 || y === 0 || x === w - 1 || y === h - 1) edge = true;
    if (x > 0 && !seen[i - 1] && cells[i - 1] === want) { seen[i - 1] = 1; stack.push(i - 1); }
    if (x < w - 1 && !seen[i + 1] && cells[i + 1] === want) { seen[i + 1] = 1; stack.push(i + 1); }
    if (y > 0 && !seen[i - w] && cells[i - w] === want) { seen[i - w] = 1; stack.push(i - w); }
    if (y < h - 1 && !seen[i + w] && cells[i + w] === want) { seen[i + w] = 1; stack.push(i + w); }
  }
  return { pixels, edge };
}

function describeRegion(grid, pixels, kind, clickIndex) {
  const { w, h } = grid;
  let minX = w; let minY = h; let maxX = 0; let maxY = 0; let sx = 0; let sy = 0;
  for (let k = 0; k < pixels.length; k += 1) {
    const i = pixels[k];
    const x = i % w;
    const y = (i - x) / w;
    if (x < minX) minX = x;
    if (x > maxX) maxX = x;
    if (y < minY) minY = y;
    if (y > maxY) maxY = y;
    sx += x;
    sy += y;
  }
  const bw = maxX - minX + 1;
  const bh = maxY - minY + 1;
  const mask = new Uint8Array(bw * bh);
  for (let k = 0; k < pixels.length; k += 1) {
    const i = pixels[k];
    const x = i % w;
    const y = (i - x) / w;
    mask[(y - minY) * bw + (x - minX)] = 1;
  }
  let cx = Math.round(sx / pixels.length);
  let cy = Math.round(sy / pixels.length);
  if (!mask[(cy - minY) * bw + (cx - minX)]) {
    let best = clickIndex;
    let bestD = Infinity;
    for (let k = 0; k < pixels.length; k += 1) {
      const i = pixels[k];
      const x = i % w;
      const y = (i - x) / w;
      const d = (x - cx) * (x - cx) + (y - cy) * (y - cy);
      if (d < bestD) { bestD = d; best = i; }
    }
    cx = best % w;
    cy = (best - cx) / w;
  }
  return {
    kind,
    x: ((cx + 0.5) / w) * 100,
    y: ((cy + 0.5) / h) * 100,
    box: [(minX / w) * 100, (minY / h) * 100, (bw / w) * 100, (bh / h) * 100],
    mask: { w: bw, h: bh, data: mask },
    origin: [minX, minY],
    area: pixels.length,
    gridW: w
  };
}

const regionHas = (region, px, py) => {
  const x = px - region.origin[0];
  const y = py - region.origin[1];
  return x >= 0 && y >= 0 && x < region.mask.w && y < region.mask.h && region.mask.data[y * region.mask.w + x] === 1;
};

function snapAt(grid, xPct, yPct) {
  const { w, h, dark, closed, labels, sizes, edges, gap } = grid;
  const n = w * h;
  const px = Math.max(0, Math.min(w - 1, Math.floor((xPct / 100) * w)));
  const py = Math.max(0, Math.min(h - 1, Math.floor((yPct / 100) * h)));
  const click = py * w + px;
  const minArea = Math.max(SNAP_MIN_PX, Math.floor(n * 0.00004));
  const maxArea = Math.floor(n * SNAP_MAX_SHARE);
  const kindOf = (label) => (edges[label] || sizes[label] > maxArea ? 'open' : (sizes[label] < minArea ? 'speck' : 'room'));

  const growRoom = (seed) => {
    const room = floodFill(closed, w, h, seed, 0, maxArea);
    if (!room) return null;
    const inside = new Uint8Array(n);
    room.pixels.forEach(i => { inside[i] = 1; });
    let frontier = room.pixels;
    const all = room.pixels.slice();
    for (let step = 0; step < gap; step += 1) {
      const nextFrontier = [];
      for (let k = 0; k < frontier.length; k += 1) {
        const i = frontier[k];
        const x = i % w;
        const nb = [x > 0 ? i - 1 : -1, x < w - 1 ? i + 1 : -1, i - w, i + w];
        for (let j = 0; j < 4; j += 1) {
          const q = nb[j];
          if (q < 0 || q >= n || inside[q] || dark[q]) continue;
          inside[q] = 1;
          nextFrontier.push(q);
          all.push(q);
        }
      }
      frontier = nextFrontier;
    }
    return describeRegion(grid, all, 'room', seed);
  };

  const roomFrom = (seed) => {
    const region = growRoom(seed);
    if (region) region.inside = regionHas(region, px, py);
    return region;
  };

  if (!closed[click]) {
    const kind = kindOf(labels[click]);
    if (kind === 'room') return roomFrom(click);
    if (kind === 'open') return null;
  } else if (dark[click]) {
    const solid = floodFill(dark, w, h, click, 1, Math.floor(n * SNAP_SOLID_SHARE));
    if (solid && !solid.edge && solid.pixels.length >= Math.max(minArea * 4, Math.floor(n * 0.0003))) {
      const shape = describeRegion(grid, solid.pixels, 'shape', click);
      if (shape.area / (shape.mask.w * shape.mask.h) >= 0.6 && Math.min(shape.mask.w, shape.mask.h) >= gap * 3 + 3) return shape;
    }
  }

  const radius = (gap * 3 + 3) * 4;
  const seen = {};
  for (let r = 1; r <= radius; r += 1) {
    let best = -1;
    let bestD = Infinity;
    for (let dy = -r; dy <= r; dy += 1) {
      for (let dx = -r; dx <= r; dx += 1) {
        if (Math.max(Math.abs(dx), Math.abs(dy)) !== r) continue;
        const x = px + dx;
        const y = py + dy;
        if (x < 0 || y < 0 || x >= w || y >= h) continue;
        const i = y * w + x;
        if (closed[i]) continue;
        const label = labels[i];
        const d = dx * dx + dy * dy;
        if (!seen[label]) seen[label] = kindOf(label);
        if (seen[label] === 'room' && d < bestD) { best = i; bestD = d; }
      }
    }
    if (best >= 0) return roomFrom(best);
  }
  return null;
}

function snapBox(grid, rect) {
  const { w, h, dark, closed, gap } = grid;
  const x0 = Math.max(0, Math.floor((Math.min(rect[0], rect[2]) / 100) * w));
  const x1 = Math.min(w - 1, Math.ceil((Math.max(rect[0], rect[2]) / 100) * w) - 1);
  const y0 = Math.max(0, Math.floor((Math.min(rect[1], rect[3]) / 100) * h));
  const y1 = Math.min(h - 1, Math.ceil((Math.max(rect[1], rect[3]) / 100) * h) - 1);
  const bw = x1 - x0 + 1;
  const bh = y1 - y0 + 1;
  if (bw < 3 || bh < 3) return null;
  const n = bw * bh;
  const at = (k) => { const lx = k % bw; return (y0 + (k - lx) / bw) * w + x0 + lx; };
  const outside = new Uint8Array(n);
  const stack = new Int32Array(n);
  let top = 0;
  const reach = (k) => { if (!outside[k] && !closed[at(k)]) { outside[k] = 1; stack[top++] = k; } };
  const seed = (k) => { if (outside[k] || dark[at(k)]) return; outside[k] = 1; if (!closed[at(k)]) stack[top++] = k; };
  for (let lx = 0; lx < bw; lx += 1) { seed(lx); seed((bh - 1) * bw + lx); }
  for (let ly = 0; ly < bh; ly += 1) { seed(ly * bw); seed(ly * bw + bw - 1); }
  while (top > 0) {
    const k = stack[--top];
    const lx = k % bw;
    if (lx > 0) reach(k - 1);
    if (lx < bw - 1) reach(k + 1);
    if (k >= bw) reach(k - bw);
    if (k + bw < n) reach(k + bw);
  }
  for (let step = 0; step < gap; step += 1) {
    const grow = [];
    for (let k = 0; k < n; k += 1) {
      if (outside[k] || dark[at(k)]) continue;
      const lx = k % bw;
      if ((lx > 0 && outside[k - 1]) || (lx < bw - 1 && outside[k + 1]) || (k >= bw && outside[k - bw]) || (k + bw < n && outside[k + bw])) grow.push(k);
    }
    grow.forEach(k => { outside[k] = 1; });
  }
  const isDark = new Uint8Array(n);
  const light = new Uint8Array(n);
  let darkCount = 0;
  let minX = bw; let minY = bh; let maxX = -1; let maxY = -1;
  for (let k = 0; k < n; k += 1) {
    if (dark[at(k)]) {
      isDark[k] = 1;
      darkCount += 1;
      const lx = k % bw;
      const ly = (k - lx) / bw;
      if (lx < minX) minX = lx;
      if (lx > maxX) maxX = lx;
      if (ly < minY) minY = ly;
      if (ly > maxY) maxY = ly;
    } else if (!outside[k]) {
      light[k] = 1;
    }
  }
  if (darkCount === 0) return null;
  const minArea = Math.max(SNAP_MIN_PX, Math.floor(w * h * 0.00004));
  const enclosed = new Uint8Array(n);
  let enclosedCount = 0;
  for (let start = 0; start < n; start += 1) {
    if (!light[start]) continue;
    const part = [start];
    light[start] = 0;
    for (let j = 0; j < part.length; j += 1) {
      const k = part[j];
      const lx = k % bw;
      if (lx > 0 && light[k - 1]) { light[k - 1] = 0; part.push(k - 1); }
      if (lx < bw - 1 && light[k + 1]) { light[k + 1] = 0; part.push(k + 1); }
      if (k >= bw && light[k - bw]) { light[k - bw] = 0; part.push(k - bw); }
      if (k + bw < n && light[k + bw]) { light[k + bw] = 0; part.push(k + bw); }
    }
    if (part.length >= minArea) {
      part.forEach(k => { enclosed[k] = 1; });
      enclosedCount += part.length;
    }
  }
  if (enclosedCount >= n * 0.1) {
    const near = dilate(enclosed, bw, bh, gap + 2);
    const pixels = [];
    for (let k = 0; k < n; k += 1) if (enclosed[k] || (isDark[k] && near[k])) pixels.push(at(k));
    const region = describeRegion(grid, pixels, 'box', at(Math.floor(bh / 2) * bw + Math.floor(bw / 2)));
    region.inside = false;
    return region;
  }
  const rw = maxX - minX + 1;
  const rh = maxY - minY + 1;
  const mask = new Uint8Array(rw * rh);
  mask.fill(1);
  return {
    kind: 'box',
    x: ((x0 + minX + rw / 2) / w) * 100,
    y: ((y0 + minY + rh / 2) / h) * 100,
    box: [((x0 + minX) / w) * 100, ((y0 + minY) / h) * 100, (rw / w) * 100, (rh / h) * 100],
    mask: { w: rw, h: rh, data: mask },
    origin: [x0 + minX, y0 + minY],
    area: rw * rh,
    gridW: w,
    inside: false
  };
}

const hexRgb = (hex) => [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];

function RegionOverlay({ region, fill, edge }) {
  const ref = useRef(null);
  useEffect(() => {
    const canvas = ref.current;
    if (!canvas || !region || !region.mask) return;
    const { w, h, data } = region.mask;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    const img = ctx.createImageData(w, h);
    const f = hexRgb(fill || '#0072CE');
    const e = hexRgb(edge || '#00468B');
    const t = region.gridW > 1200 ? 2 : 1;
    const inside = (x, y) => x >= 0 && y >= 0 && x < w && y < h && data[y * w + x] === 1;
    for (let y = 0; y < h; y += 1) {
      for (let x = 0; x < w; x += 1) {
        const i = y * w + x;
        if (!data[i]) continue;
        let border = false;
        for (let d = 1; d <= t && !border; d += 1) border = !inside(x - d, y) || !inside(x + d, y) || !inside(x, y - d) || !inside(x, y + d);
        const c = border ? e : f;
        img.data[i * 4] = c[0];
        img.data[i * 4 + 1] = c[1];
        img.data[i * 4 + 2] = c[2];
        img.data[i * 4 + 3] = border ? 255 : 95;
      }
    }
    ctx.putImageData(img, 0, 0);
  }, [region, fill, edge]);
  if (!region || !region.box) return null;
  return (
    <canvas
      ref={ref}
      aria-hidden="true"
      className="absolute pointer-events-none z-[15]"
      style={{ left: `${region.box[0]}%`, top: `${region.box[1]}%`, width: `${region.box[2]}%`, height: `${region.box[3]}%`, imageRendering: 'pixelated' }}
    />
  );
}

// Generates a clean, bare Stillwell Plant Floorplan architectural grid if Dataverse map image is offline,
// with zero pre-painted room boxes or equipment text so the user has an unobstructed bare canvas to draw real areas.
function generateStillwellBlueprintDataUrl() {
  try {
    const canvas = document.createElement('canvas');
    const w = 1600;
    const h = 1000;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, w, h);

    // Minor 2.5% floor grid
    ctx.strokeStyle = '#F1F5F9';
    ctx.lineWidth = 1;
    for (let x = 40; x < w; x += 40) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
    }
    for (let y = 25; y < h; y += 25) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
    }

    // Major 10% architectural coordinate grid
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 1.5;
    ctx.fillStyle = '#94A3B8';
    ctx.font = 'bold 11px "Segoe UI", monospace';
    for (let pct = 10; pct <= 90; pct += 10) {
      const gx = Math.round((pct / 100) * w);
      const gy = Math.round((pct / 100) * h);
      ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke();
      ctx.fillText(`${pct}%`, gx + 4, 20);
      ctx.fillText(`${pct}%`, 8, gy - 4);
    }

    // Clean outer plant perimeter frame
    ctx.strokeStyle = '#334155';
    ctx.lineWidth = 4;
    ctx.strokeRect(32, 32, w - 64, h - 64);

    // Subtle corner compass / scale reference
    ctx.fillStyle = '#64748B';
    ctx.font = 'bold 12px "Segoe UI", sans-serif';
    ctx.fillText('STILWELL FACILITY BARE FLOORPLAN CANVAS (UPLOAD PLANT FLOORPLAN OR DRAW REAL AREAS)', 48, h - 44);

    return canvas.toDataURL('image/png');
  } catch (e) {
    return null;
  }
}

// --- DATE, NORMALIZATION & PARSING HELPERS ---
// A month/day written without a year (email lines like "10/14") that falls after refDay (default today) is last year's.
// A date that carries its year is never moved: a lab date later than today is kept as written and flagged on the row.
function clampSwabDateNotFuture(dateKey, hadExplicitYear = true, refDay = '') {
  if (!dateKey || !/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) return dateKey || '';
  if (hadExplicitYear || dateKey <= (refDay || getTodayDateKey())) return dateKey;
  return `${(parseInt(dateKey.slice(0, 4), 10) || LIVE_CURRENT_YEAR) - 1}${dateKey.slice(4)}`;
}

// y/m/d to YYYY-MM-DD, or '' when it is not a real calendar day (2/30, month 13, year 0026)
function dateKeyOfParts(y, m, d) {
  if (!(y >= 1990 && y <= 2100 && m >= 1 && m <= 12 && d >= 1 && d <= 31)) return '';
  const dt = new Date(Date.UTC(y, m - 1, d));
  if (dt.getUTCMonth() !== m - 1) return '';
  return `${y}-${pad2(m)}-${pad2(d)}`;
}

// A date cell or email date to YYYY-MM-DD. Reads 2026-10-14, 10/14/2026, 10/14/26, 10-14-2026, Excel serial day
// numbers (46309) and, for email lines, 10/14 with no year (refDay's year; a day after refDay is last year's).
function normalizeDateKey(rawDate, defaultYear = LIVE_CURRENT_YEAR, refDay = '') {
  if (rawDate === null || rawDate === undefined) return '';
  const s = String(rawDate).trim();
  if (!s) return '';
  const iso = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (iso) return dateKeyOfParts(parseInt(iso[1], 10), parseInt(iso[2], 10), parseInt(iso[3], 10));
  const m = s.match(/^(\d{1,2})[/-](\d{1,2})(?:[/-](\d{2,4}))?(?![\d/-])/);
  if (m) {
    const month = parseInt(m[1], 10);
    const day = parseInt(m[2], 10);
    if (m[3]) {
      let year = parseInt(m[3], 10);
      if (year < 100) year += 2000;
      return dateKeyOfParts(year, month, day);
    }
    const ref = /^\d{4}-\d{2}-\d{2}$/.test(refDay) ? refDay : '';
    const year = ref ? parseInt(ref.slice(0, 4), 10) : defaultYear;
    return clampSwabDateNotFuture(dateKeyOfParts(year, month, day), false, ref);
  }
  // Excel stores a day as a serial number (25569 = 1970-01-01)
  if (/^\d{5}(\.\d+)?$/.test(s)) {
    const n = Math.floor(parseFloat(s));
    if (n > 32874 && n < 73051) {
      const dt = new Date((n - 25569) * 86400000);
      return dateKeyOfParts(dt.getUTCFullYear(), dt.getUTCMonth() + 1, dt.getUTCDate());
    }
    return '';
  }
  const d = new Date(s);
  if (!isNaN(d.getTime())) return dateKeyOfParts(d.getFullYear(), d.getMonth() + 1, d.getDate());
  return '';
}

const normToken = (s) => String(s || '').toUpperCase().replace(/[^A-Z0-9]+/g, ' ').trim();

// Normalize schedule IDs so "62666-07" and "62666-7" match as the exact same schedule line
function normalizeScheduleCode(raw) {
  if (!raw) return '';
  const m = String(raw).trim().match(/^(\d+)(?:-0*(\d+))?$/);
  if (!m) return String(raw).trim().toUpperCase();
  return m[2] !== undefined ? `${m[1]}-${m[2]}` : m[1];
}

// The test of a row: LIS, SAL, APC, ATP, COLIFORM, YEAST_MOLD, WATER_CHEM. The lab's Test Method decides; the program
// words in the description are read only when the method is blank (a Salmonella test on a "Daily/Weekly Listeria" site
// is SAL). With neither, the row is taken as Listeria and marked testGuessed by the row parser.
function testCodeFromText(t) {
  const s = String(t || '');
  if (/listeria|vidlmo/i.test(s)) return 'LIS';
  if (/salmonella/i.test(s)) return 'SAL';
  if (/aerobic\s*plate\s*count|\bapc\b/i.test(s)) return 'APC';
  if (/\batp\b/i.test(s)) return 'ATP';
  if (/coliform|e\.\s*coli/i.test(s)) return 'COLIFORM';
  if (/yeast|mold/i.test(s)) return 'YEAST_MOLD';
  if (/chlorine|heterotrophic/i.test(s)) return 'WATER_CHEM';
  return '';
}
function normalizeTestProgramCode(testMethod, programText = '') {
  const fromMethod = testCodeFromText(testMethod);
  if (fromMethod) return fromMethod;
  if (String(testMethod || '').trim()) return normToken(testMethod).slice(0, 24) || 'LIS';
  return testCodeFromText(programText) || 'LIS';
}

function matchSiteFromCatalog(roomHint, surfaceHint, descHint, siteCatalog, aliases) {
  const surfNorm = normToken(surfaceHint);
  const descNorm = normToken(descHint);
  const canonicalRoom = aliases[String(roomHint || '').toUpperCase().trim()] || roomHint || '';

  let best = null;
  let bestScore = 0;
  for (let i = 0; i < siteCatalog.length; i += 1) {
    const site = siteCatalog[i];
    const sSurf = normToken(site.surface);
    const sDesc = normToken(site.description);
    let score = 0;
    if (sDesc === descNorm) score += 60;
    else if (sDesc && descNorm && (sDesc.indexOf(descNorm) !== -1 || descNorm.indexOf(sDesc) !== -1)) score += 35;
    if (sSurf === surfNorm) score += 25;
    else if (sSurf && surfNorm && (sSurf.indexOf(surfNorm) !== -1 || surfNorm.indexOf(sSurf) !== -1)) score += 12;
    if (canonicalRoom && (site.room === canonicalRoom || (canonicalRoom === 'WJ' && /^STLWJ/.test(site.areaCode)) || (canonicalRoom === 'IBL5' && /^STLIBL5/.test(site.areaCode)))) {
      score += 15;
    }
    if (String(roomHint).toUpperCase() === 'WJ1' && site.areaCode === 'STLWJ1') score += 10;
    if (String(roomHint).toUpperCase() === 'WJ2' && site.areaCode === 'STLWJ2') score += 10;
    if (score > bestScore) {
      bestScore = score;
      best = site;
    }
  }
  return bestScore >= 45 ? best : null;
}

// --- PARSER 1: WEEKLY QA EMAIL (one email) ---
// refDay: the day the email was sent (its "Sent:" line when pasted with headers), so "10/14" gets the right year.
function parseWeeklyPromptText(text, rules, aliases, siteCatalog, defaultYear = LIVE_CURRENT_YEAR, defaultReportDate = LIVE_LATEST_FRIDAY, refDay = '') {
  const rawLines = String(text || '').split(/\r?\n/);
  const cleanLine = (l) => {
    let out = '';
    for (let i = 0; i < l.length; i += 1) {
      const c = l.charCodeAt(i);
      out += (c < 32 || c > 126) ? ' ' : l[i];
    }
    return out.replace(/\s+/g, ' ').trim();
  };

  const safeRegex = (pattern, flags = 'i') => {
    try { return new RegExp(pattern, flags); } catch (e) { return null; }
  };

  const reTotalLis = safeRegex(rules.promptTotalLis);
  const reRoomHeader = safeRegex(rules.promptRoomHeader);
  const reDatedHit = safeRegex(rules.promptDatedHit);
  const reRetestHeader = safeRegex(rules.promptRetestHeader);
  const reApcAtpHeader = safeRegex(rules.promptApcAtpHeader);
  const reDeptSubHeader = safeRegex(rules.promptDeptSubHeader);
  const reUndatedHit = safeRegex(rules.promptUndatedHit);
  const reEmailIgnore = safeRegex(rules.emailHeaderIgnore || '^(From|Sent|To|Cc|Subject):');

  const summary = {
    totalLis: { total: 0, positives: 0, rate: 0 },
    rooms: {},
    monthlyPathogens: { total: 0, positives: 0, rate: 0 },
    retests: { failed: 0, pathogen: 'Listeria' },
    apc: { total: 0, failures: 0, rate: 0, depts: {} },
    atp: { total: 0, failures: 0, rate: 0, depts: {} }
  };

  const hits = [];
  let section = 'daily';
  let currentRoom = 'WJ';
  let currentDept = '';
  let lastDatedHit = defaultReportDate;

  const resolveRoom = (raw) => {
    const key = String(raw || '').trim().toUpperCase();
    if (aliases[key]) return aliases[key];
    const found = Object.keys(aliases).find(k => k.toUpperCase() === key);
    return found ? aliases[found] : (raw || 'Zone 4 / Mobile').trim();
  };

  rawLines.forEach((raw, idx) => {
    const line = cleanLine(raw);
    if (!line) return;
    if (reEmailIgnore && reEmailIgnore.test(line)) return;

    if (reTotalLis) {
      const m = line.match(reTotalLis);
      if (m) {
        summary.totalLis = {
          total: parseInt(m[1], 10) || 0,
          positives: parseInt(m[2], 10) || 0,
          rate: parseFloat(m[3]) || 0
        };
        return;
      }
    }

    if (/^-?\s*Daily\s+Swabs/i.test(line)) { section = 'daily'; return; }
    if (/^-?\s*Monthly\s+Pathogens/i.test(line)) { section = 'monthly'; return; }
    if (/^Total\s+(\d+)\s+Listeria/i.test(line) && section === 'monthly') {
      const mm = line.match(/Total\s+(\d+).*?:\s*(\d+)\s+positives/i);
      if (mm) summary.monthlyPathogens = { total: parseInt(mm[1], 10) || 0, positives: parseInt(mm[2], 10) || 0, rate: 0 };
      return;
    }

    if (reRetestHeader) {
      const m = line.match(reRetestHeader);
      if (m) {
        section = 'retest';
        summary.retests = { failed: parseInt(m[1], 10) || 0, pathogen: (m[2] || 'Listeria').trim() };
        return;
      }
    }

    if (reApcAtpHeader) {
      const m = line.match(reApcAtpHeader);
      if (m) {
        const kind = m[1].toUpperCase();
        section = kind;
        const target = kind === 'APC' ? summary.apc : summary.atp;
        target.total = parseInt(m[2], 10) || 0;
        target.failures = parseInt(m[3], 10) || 0;
        target.rate = parseFloat(m[4]) || 0;
        return;
      }
    }

    if ((section === 'APC' || section === 'ATP') && reDeptSubHeader) {
      const m = line.match(reDeptSubHeader);
      if (m) {
        currentDept = m[1].replace(/^-\s*/, '').trim();
        const target = section === 'APC' ? summary.apc : summary.atp;
        target.depts[currentDept] = {
          total: parseInt(m[2], 10) || 0,
          failures: parseInt(m[3], 10) || 0
        };
        return;
      }
    }

    if (reRoomHeader) {
      const m = line.match(reRoomHeader);
      if (m) {
        section = 'daily';
        const rawRoom = m[1].replace(/^-\s*/, '').trim();
        currentRoom = resolveRoom(rawRoom);
        summary.rooms[currentRoom] = {
          rawName: rawRoom,
          totalSwabs: parseInt(m[2], 10) || 0,
          salmonellaSwabs: m[3] ? (parseInt(m[3], 10) || 0) : 0,
          positives: parseInt(m[4], 10) || 0,
          rate: parseFloat(m[5]) || 0
        };
        return;
      }
    }

    if (reDatedHit) {
      const m = line.match(reDatedHit);
      if (m) {
        const dateKey = normalizeDateKey(m[1], defaultYear, refDay);
        if (dateKey) lastDatedHit = dateKey;
        const stage = (m[2] || '').trim().toUpperCase();
        const timingStage = stage === 'ST' || stage === 'INP' ? stage : '';
        const surface = (m[3] || '').trim().toUpperCase();
        const description = (m[4] || '').trim().toUpperCase();
        const matchedSite = matchSiteFromCatalog(currentRoom, surface, description, siteCatalog, aliases);
        const siteCode = matchedSite ? matchedSite.siteCode : '';
        hits.push({
          id: `prompt-dated-${dateKey}-${currentRoom}-${stage}-${siteCode || normToken(surface + ' ' + description)}-${idx}`,
          source: 'Scheduled Email Prompt',
          isActivePromptHit: true,
          date: dateKey || defaultReportDate,
          dateExplicit: true,
          room: currentRoom,
          subArea: matchedSite ? matchedSite.areaCode : currentRoom,
          dept: (ROOM_META[currentRoom] && ROOM_META[currentRoom].dept) || 'Creme',
          stage,
          timingStage,
          testType: 'LIS',
          result: 'Positive',
          surface,
          description,
          siteCode,
          assetTag: matchedSite ? matchedSite.assetTag : '',
          rawLine: line
        });
        return;
      }
    }

    if (reUndatedHit && (section === 'retest' || section === 'APC' || section === 'ATP')) {
      const m = line.match(reUndatedHit);
      if (m) {
        const rawPrefix = (m[1] || '').trim();
        const surface = (m[2] || '').trim().toUpperCase();
        const description = (m[3] || '').trim().toUpperCase();
        const room = resolveRoom(rawPrefix);
        const matchedSite = matchSiteFromCatalog(rawPrefix, surface, description, siteCatalog, aliases);
        const testType = section === 'retest' ? 'RETEST-LIS' : section;
        const stage = section === 'retest' ? 'RETEST' : section;
        const combinedDesc = `${rawPrefix} ${surface} ${description}`;
        // The email says nothing about timing for these lines unless the words do: unknown timing stays blank
        const timingStage = /start\s*up|\bst\b|pre[\s-]?op/i.test(combinedDesc)
          ? 'ST'
          : (/in-?process|\binp\b/i.test(combinedDesc) ? 'INP' : '');
        const siteCode = matchedSite ? matchedSite.siteCode : '';
        const effectiveUndatedDate = lastDatedHit || defaultReportDate;
        hits.push({
          id: `prompt-undated-${section}-${room}-${siteCode || normToken(surface + ' ' + description)}`,
          source: 'Scheduled Email Prompt',
          isActivePromptHit: true,
          date: effectiveUndatedDate,
          dateExplicit: false,
          room,
          subArea: matchedSite ? matchedSite.areaCode : rawPrefix,
          dept: currentDept || (ROOM_META[room] && ROOM_META[room].dept) || 'Facility',
          stage,
          timingStage,
          testType,
          result: section === 'retest' ? 'Retest Failed' : `${section} Failure`,
          surface,
          description,
          siteCode,
          assetTag: matchedSite ? matchedSite.assetTag : '',
          rawLine: line
        });
      }
    }
  });

  hits.sort((a, b) => {
    const dCmp = String(a.date || '').localeCompare(String(b.date || ''));
    if (dCmp !== 0) return dCmp;
    const rCmp = String(a.room || '').localeCompare(String(b.room || ''));
    if (rCmp !== 0) return rCmp;
    return String(a.siteCode || a.id || '').localeCompare(String(b.siteCode || b.id || ''));
  });

  return { summary, hits };
}

// The day on an email's "Sent:" line (Outlook: "Sent: Monday, October 20, 2026 8:15 AM" or "Sent: 10/20/2026 8:15 AM")
function emailSentDay(line) {
  const m = String(line || '').match(/^\s*(?:Sent|Date)\s*:\s*(.+)$/i);
  if (!m) return '';
  const body = m[1].replace(/^[A-Za-z]+day,?\s*/, '').trim();
  const num = body.match(/^(\d{1,2}\/\d{1,2}\/\d{2,4})/);
  if (num) return normalizeDateKey(num[1]);
  const words = body.match(/^([A-Za-z]+)\.?\s+(\d{1,2}),?\s+(\d{4})/);
  if (words) {
    const mi = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'].indexOf(words[1].slice(0, 3).toLowerCase());
    if (mi > -1) return dateKeyOfParts(parseInt(words[3], 10), mi + 1, parseInt(words[2], 10));
  }
  return '';
}

// --- PARSER 1b: ONE OR MORE PASTED WEEKLY EMAILS ---
// Each email starts at a "From:" line or at its "Total LIS:" line. Each one is read on its own and given the plant week
// (Monday key) it reports on: the week most of its dated hits fall in, else the week of its Sent day (Monday mail = the
// week before), else the week of the latest Friday. summary/hits keep their old meaning (summary = latest report).
function parseWeeklyEmails(text, rules, aliases, siteCatalog) {
  const lines = String(text || '').split(/\r?\n/);
  let reTotal = null;
  try { reTotal = new RegExp(rules.promptTotalLis, 'i'); } catch (e) { reTotal = null; }
  const blocks = [];
  let cur = { lines: [], hasTotal: false, sent: '' };
  const flush = () => { if (cur.lines.join('').trim()) blocks.push(cur); };
  lines.forEach(line => {
    const isFrom = /^\s*From\s*:/i.test(line);
    const isTotal = !!(reTotal && reTotal.test(line));
    if ((isFrom && cur.lines.join('').trim()) || (isTotal && cur.hasTotal)) {
      flush();
      cur = { lines: [], hasTotal: false, sent: '' };
    }
    if (isTotal) cur.hasTotal = true;
    if (!cur.sent) cur.sent = emailSentDay(line);
    cur.lines.push(line);
  });
  flush();

  const reports = blocks.map((b, bi) => {
    const sentDay = b.sent && b.sent <= LIVE_TODAY_DATE_KEY ? b.sent : '';
    const refDay = sentDay || LIVE_TODAY_DATE_KEY;
    const sentFriday = sentDay ? addDays(hubWeekKey(sentDay), hubWeekKey(sentDay) === sentDay ? -3 : 4) : '';
    const fallbackFriday = sentFriday && sentFriday <= refDay ? sentFriday : (sentDay ? addDays(hubWeekKey(sentDay), -3) : LIVE_LATEST_FRIDAY);
    const parsed = parseWeeklyPromptText(b.lines.join('\n'), rules, aliases, siteCatalog, parseInt(refDay.slice(0, 4), 10) || LIVE_CURRENT_YEAR, fallbackFriday, refDay);
    const votes = {};
    parsed.hits.forEach(h => { if (h.dateExplicit && h.date) votes[hubWeekKey(h.date)] = (votes[hubWeekKey(h.date)] || 0) + 1; });
    const voted = Object.keys(votes).sort((x, y) => (votes[y] - votes[x]) || y.localeCompare(x))[0] || '';
    const weekKey = voted || hubWeekKey(fallbackFriday);
    const weekFrom = voted ? 'hit dates' : (sentDay ? 'sent date' : 'latest Friday');
    const weekFriday = addDays(weekKey, 4) <= LIVE_TODAY_DATE_KEY ? addDays(weekKey, 4) : LIVE_TODAY_DATE_KEY;
    const hits = parsed.hits.map(h => ({ ...h, id: `${h.id}-r${bi}`, reportWeek: weekKey, date: h.dateExplicit ? h.date : weekFriday }));
    return { index: bi, weekKey, weekFrom, sentDay, summary: parsed.summary, hits, hasTotals: !!(parsed.summary.totalLis && parsed.summary.totalLis.total > 0) };
  }).filter(r => r.hasTotals || r.hits.length > 0);

  // A report pasted twice (same week, same totals) is read once
  const seen = {};
  const unique = reports.filter(r => {
    const t = r.summary.totalLis || {};
    const k = `${r.weekKey}|${t.total}|${t.positives}|${r.hits.length}`;
    if (seen[k]) return false;
    seen[k] = true;
    return true;
  });
  unique.sort((a, b) => a.weekKey.localeCompare(b.weekKey));
  const latest = unique.length > 0 ? unique[unique.length - 1] : null;
  const allHits = [];
  unique.forEach(r => { r.hits.forEach(h => allHits.push(h)); });
  const emptySummary = parseWeeklyPromptText('', rules, aliases, siteCatalog).summary;
  return {
    reports: unique,
    byWeek: unique.reduce((m, r) => { m[r.weekKey] = r; return m; }, {}),
    summary: latest ? latest.summary : emptySummary,
    latestWeekKey: latest ? latest.weekKey : '',
    hits: allHits
  };
}

// --- PARSER 2: LAB CSV / EXCEL TABLE / EMAIL ROW PARSER ---
// A line with a tab in it is tab-separated (a copy from Excel or Outlook), otherwise comma-separated. Quotes are honored,
// so a comma inside a quoted description never shifts the columns.
function parseCsvLine(line, delim) {
  const text = String(line || '');
  const sep = delim || (text.indexOf('\t') !== -1 ? '\t' : ',');
  const out = [];
  let cur = '';
  let inQuotes = false;
  for (let i = 0; i < text.length; i += 1) {
    const ch = text[i];
    if (ch === '"') {
      if (inQuotes && text[i + 1] === '"') { cur += '"'; i += 1; }
      else inQuotes = !inQuotes;
    } else if (ch === sep && !inQuotes) {
      out.push(cur.trim());
      cur = '';
    } else {
      cur += ch;
    }
  }
  out.push(cur.trim());
  return out;
}

// Lab columns are found by their header names, so a file with extra or reordered columns still reads right.
// With no header row the lab's own order is used: Collection Date, Sample ID, Sample Description, Test Method, Result.
const LAB_DEFAULT_COLUMNS = { date: 0, sampleId: 1, desc: 2, method: 3, result: 4 };
const LAB_HEADER_PATTERNS = {
  date: /^(collection\s*date|date\s*collected|collected(\s*on|\s*date)?|sample\s*date|sampled(\s*on)?|date)$/i,
  sampleId: /^(sample\s*(id|#|no\.?|number)|lab\s*(id|#|no\.?)|id)$/i,
  desc: /^(sample\s*desc(ription)?|description|sample\s*name|sample\s*point|site(\s*desc(ription)?)?)$/i,
  method: /^(test\s*method|method|test|test\s*name|analysis|analyte)$/i,
  result: /^(result|results|final\s*result|test\s*result|outcome)$/i
};
function mapLabHeader(cols) {
  const map = {};
  (cols || []).forEach((c, i) => {
    const t = String(c || '').replace(/^\uFEFF/, '').replace(/^"+|"+$/g, '').trim();
    Object.keys(LAB_HEADER_PATTERNS).forEach(k => {
      if (map[k] === undefined && LAB_HEADER_PATTERNS[k].test(t)) map[k] = i;
    });
  });
  return map.desc !== undefined && (map.sampleId !== undefined || map.date !== undefined) ? map : null;
}

// Lab result text to Positive / Negative / Count / Pending.
// - "Not detected", "ND", "Negative", "Pass" are Negative (checked first: "not detected" holds the word "detected").
// - "Potential Positive", "Presumptive", "Detected", "Fail" are Positive.
// - A number ("<10", "250 CFU", "TNTC") is a Count: the lab finished, but the row makes no pass/fail call, so it is left
//   out of every rate (APC and ATP limits differ by site).
// - Text the reader does not know stays Pending and is flagged (unread) for the Import check.
function readLabResult(raw) {
  const s = String(raw || '').trim();
  if (!s || /^(pending|in\s*progress|tbd|waiting|hold|on\s*hold|incubating|-+|n\/a|na)$/i.test(s)) return { result: 'Pending', unread: false };
  const t = s.toLowerCase();
  if (/\bnot\s+(detected|found|present|confirmed)\b|\bundetected\b|\bnone\s+detected\b|\bnegative\b|\bneg\b|\bnd\b|\babsent\b|\bpass(ed)?\b|\bacceptable\b|\bwithin\s+(spec|limits?)\b/.test(t)) {
    return { result: 'Negative', unread: false };
  }
  if (/\bpositive\b|\bpos\b|\bpresumptive\b|\bdetected\b|\bpresent\b|\bfail(ed|ure|s)?\b|\bconfirmed\b|\bout\s+of\s+spec\b|\bover\s+limit\b/.test(t)) {
    return { result: 'Positive', unread: false };
  }
  if (/^[<>~]?\s*=?\s*\d[\d,]*(\.\d+)?\s*(cfu|rlu|mpn)?(\s*\/\s*[a-z0-9 ]+)?$/i.test(s) || /^tntc$/i.test(s) || /^est\.?\s*[<>]?\s*\d/i.test(s)) {
    return { result: 'Count', unread: false };
  }
  return { result: 'Pending', unread: true };
}

// What a row counts toward:
// routine = environmental Listeria / Salmonella swab (the plant rate); retest = re-swab after a positive;
// indicator = APC / ATP / coliform / yeast-mold; vector, product, water = their own lists; other = description not recognized.
function swabKindOf(r) {
  if (!r) return 'other';
  const cat = String(r.category || '');
  if (cat === 'Vector Swab') return 'vector';
  if (cat === 'Product / WIP') return 'product';
  if (cat === 'Water Sample') return 'water';
  if (r.stage === 'RETEST') return 'retest';
  const env = cat.indexOf('Environmental') === 0 || cat === 'SCM Swab';
  if (r.testCode === 'LIS' || r.testCode === 'SAL') return env ? 'routine' : 'other';
  if (r.testCode === 'APC' || r.testCode === 'ATP' || r.testCode === 'COLIFORM' || r.testCode === 'YEAST_MOLD') return env ? 'indicator' : 'other';
  return 'other';
}

// One ledger row = Sample ID + Sample Description + test. Listeria and Salmonella on the same sponge, or APC and coliform
// on the same sample, are two rows. A row with no Sample ID yet is matched on day + description + test (noIdRowKey).
function ledgerRowKey(r) {
  if (!r) return '';
  const nId = String(r.normSampleId || r.sampleId || '').trim().toUpperCase();
  const nDesc = String(r.normSampleDesc || r.sampleDesc || '').trim().replace(/\s+/g, ' ').toUpperCase();
  return nId && nDesc ? `ID_DESC::${nId}::${nDesc}::${r.testCode || ''}` : '';
}
function noIdRowKey(r) {
  if (!r) return '';
  const nDesc = String(r.normSampleDesc || r.sampleDesc || '').trim().replace(/\s+/g, ' ').toUpperCase();
  return nDesc && r.date ? `NOID::${r.date}::${nDesc}::${r.testCode || ''}` : '';
}

function parseSingleCsvRow(cols, rowIndex, rulesCompiled, aliases, colMap) {
  if (!cols || cols.length < 2) return null;
  const cm = colMap || LAB_DEFAULT_COLUMNS;
  const cell = (k) => (cm[k] === undefined || cols[cm[k]] === undefined || cols[cm[k]] === null ? '' : String(cols[cm[k]]).trim());
  const rawDate = cell('date');
  const sampleId = cell('sampleId');
  const sampleDesc = cell('desc').replace(/\s+/g, ' ');
  const testMethod = cell('method');
  const rawResult = cell('result');
  if (!sampleDesc && !sampleId) return null;
  const dateKey = normalizeDateKey(rawDate, LIVE_CURRENT_YEAR);
  // A lab row has a collection date or a lab sample number; a sentence pasted along with the table has neither
  if (!dateKey && !/\d/.test(sampleId)) return null;

  let category = 'Unclassified';
  let siteCode = '';
  let areaCode = '';
  let room = 'Zone 4 / Mobile';
  let areaUnknown = false;
  let surface = '';
  let description = sampleDesc;
  let assetTag = '';
  let scheduleId = '';
  let stage = 'LAB';
  let program = '';

  const { reEnv, reShortSched, reVector, reScm, reWater, reProduct } = rulesCompiled;
  const envMatch = reEnv ? sampleDesc.match(reEnv) : null;
  const shortMatch = !envMatch && reShortSched ? sampleDesc.match(reShortSched) : null;
  const vecMatch = !envMatch && !shortMatch && reVector ? sampleDesc.match(reVector) : null;
  const scmMatch = !envMatch && !shortMatch && !vecMatch && reScm ? sampleDesc.match(reScm) : null;
  const waterMatch = !envMatch && !shortMatch && !vecMatch && !scmMatch && reWater ? sampleDesc.match(reWater) : null;
  const prodMatch = !envMatch && !shortMatch && !vecMatch && !scmMatch && !waterMatch && reProduct ? sampleDesc.match(reProduct) : null;

  if (envMatch) {
    category = 'Environmental Swab';
    siteCode = (envMatch[1] || '').toUpperCase();
    areaCode = (envMatch[2] || '').toUpperCase();
    scheduleId = normalizeScheduleCode(envMatch[3] || '');
    surface = (envMatch[4] || '').trim().toUpperCase();
    description = (envMatch[5] || '').trim().toUpperCase();
    assetTag = (envMatch[6] || '').trim().toUpperCase();
    program = (envMatch[7] || '').trim();
    // A re-test is a re-test whatever else the line says; then start-up / pre-op; then in-process. Anything else
    // (Daily/Weekly, Quarterly) has no ST/INP timing and is left out of the ST / INP split.
    if (/re-?test/i.test(sampleDesc)) stage = 'RETEST';
    else if (/start\s*up|\bst\b|pre[\s-]?op/i.test(sampleDesc)) stage = 'ST';
    else if (/in-?process|\binp\b/i.test(sampleDesc)) stage = 'INP';
    areaUnknown = !aliases[areaCode];
    room = aliases[areaCode] || 'Zone 4 / Mobile';
    if (areaCode === 'DRAIN') {
      if (/IBL5|CRUMB MIXER TO INCLINE BELT/i.test(description + ' ' + assetTag)) room = 'IBL5';
      else if (/MIXER 3|DRDRAIN/i.test(description + ' ' + assetTag)) room = 'Dough Room';
      else if (/0411|0413|LIQUIFIER|TOTE DUMP/i.test(description + ' ' + assetTag)) room = 'IBL4';
    }
  } else if (shortMatch) {
    category = 'Environmental Swab (Shorthand Schedule)';
    scheduleId = normalizeScheduleCode(sampleDesc);
    siteCode = '';
    areaCode = 'SCHED';
    surface = 'SCHEDULE SWAB';
    description = `SCHEDULE ITEM ${scheduleId}`;
    room = 'WJ';
  } else if (vecMatch) {
    category = 'Vector Swab';
    siteCode = `VECTOR-${vecMatch[1]}`;
    areaCode = 'VECTOR';
    surface = `VECTOR #${vecMatch[1]}`;
    description = (vecMatch[2] || '').trim().toUpperCase();
    stage = 'VECTOR';
    room = /mixer 3|scale leg|dough/i.test(description) ? 'Dough Room' : 'Drains';
  } else if (scmMatch) {
    category = 'SCM Swab';
    siteCode = `SCM-SWAB-${scmMatch[1]}`;
    areaCode = 'SCM';
    room = 'SCM';
    surface = 'SCM SWAB';
    description = (scmMatch[2] || sampleDesc).trim().toUpperCase();
  } else if (waterMatch) {
    category = 'Water Sample';
    siteCode = `WATER-${waterMatch[1]}`;
    areaCode = 'WATER';
    room = 'Zone 4 / Mobile';
    surface = 'WATER';
    description = (waterMatch[2] || sampleDesc).trim();
  } else if (prodMatch) {
    category = 'Product / WIP';
    siteCode = `SAMPLE-${prodMatch[1]}`;
    areaCode = 'PRODUCT';
    room = /ibl4/i.test(sampleDesc) ? 'IBL4' : (/custard/i.test(sampleDesc) ? 'Custard' : (/okra/i.test(sampleDesc) ? 'Okra / 01MIX' : 'Zone 4 / Mobile'));
    surface = 'PRODUCT';
    description = (prodMatch[2] || sampleDesc).trim();
  }

  const read = readLabResult(rawResult);
  const testCode = normalizeTestProgramCode(testMethod, `${program} ${sampleDesc}`);
  const testGuessed = !testMethod && !testCodeFromText(`${program} ${sampleDesc}`);

  const normSampleId = String(sampleId || '').trim().toUpperCase();
  const normSampleDesc = String(sampleDesc || '').trim().replace(/\s+/g, ' ').toUpperCase();
  const row = {
    id: '',
    date: dateKey || '',
    dateFlag: !dateKey ? 'none' : (dateKey > LIVE_TODAY_DATE_KEY ? 'future' : ''),
    rawDate: dateKey ? '' : String(rawDate || '').slice(0, 40),
    sampleId,
    sampleDesc,
    normSampleId,
    normSampleDesc,
    idAndDescKey: '',
    testMethod,
    testMethods: testMethod ? [testMethod] : [],
    testCode,
    testGuessed,
    result: read.result,
    resultUnread: read.unread,
    rawResult: rawResult || '',
    isBlankResult: read.result === 'Pending',
    isBlankSampleId: !sampleId,
    category,
    siteCode,
    areaCode,
    areaUnknown,
    room,
    surface: surface || 'SWAB',
    description: description || sampleDesc,
    assetTag,
    scheduleId,
    stage,
    program
  };
  row.v = 23;
  row.swabKind = swabKindOf(row);
  row.idAndDescKey = ledgerRowKey(row);
  row.id = row.idAndDescKey || noIdRowKey(row) || `row-${rowIndex}-${dateKey || 'undated'}`;
  return row;
}

// Lab table text (a CSV file, a tab-separated copy from Excel, or rows pasted from an email) to rows. A header line
// anywhere (several files pasted one after another) sets the column map for the lines after it and is never read as a row.
function createLabLineReader(rules, aliases) {
  const rulesCompiled = compileRegexSet(rules);
  let reEmailIgnore = null;
  try { reEmailIgnore = new RegExp(rules.emailHeaderIgnore || '^(From|Sent|To|Cc|Subject):', 'i'); } catch (e) { reEmailIgnore = null; }
  const state = { colMap: null, rows: [], skipped: 0, headers: 0, n: 0 };
  state.push = (rawLine) => {
    const line = String(rawLine || '').trim();
    state.n += 1;
    if (!line) return;
    if (reEmailIgnore && reEmailIgnore.test(line)) return;
    const cols = parseCsvLine(line);
    const header = mapLabHeader(cols);
    if (header) { state.colMap = header; state.headers += 1; return; }
    const r = parseSingleCsvRow(cols, state.n, rulesCompiled, aliases, state.colMap);
    if (r) state.rows.push(r);
    else state.skipped += 1;
  };
  return state;
}
function parseLabRowsFromText(text, rules, aliases) {
  const reader = createLabLineReader(rules, aliases);
  String(text || '').split(/\r?\n/).forEach(l => reader.push(l));
  return { rows: reader.rows, skipped: reader.skipped, headers: reader.headers };
}

function compileRegexSet(rules) {
  const safeRegex = (pattern, flags = 'i') => {
    try { return new RegExp(pattern, flags); } catch (e) { return null; }
  };
  return {
    reEnv: safeRegex(rules.csvEnvSwab),
    reShortSched: safeRegex(rules.csvShorthandSchedule || '^(\\d{4,6})(?:-0*(\\d+))?$'),
    reVector: safeRegex(rules.csvVector),
    reScm: safeRegex(rules.csvScmSwab),
    reWater: safeRegex(rules.csvWaterSample),
    reProduct: safeRegex(rules.csvProductSample)
  };
}

// =======================================================================
// DUPLICATE RULE & BLANK-RESULT COMPLETION
// =======================================================================
// One row per Sample ID + Sample Description + test (ledgerRowKey):
// 1. A row loaded with a blank result (Pending) is completed in place when the same sample comes back with a result.
// 2. The same sample loaded again with the same result is a duplicate and is counted once.
// 3. A finished result is never replaced by a blank one.
// 4. Two different results for one sample (Negative in one file, Potential Positive in another): the positive is kept and
//    the row is marked resultConflict, so the Import check lists it.
// 5. A lab result always replaces a result set by hand in the app (manualResult) and an old row the v2.3 cleanup marked
//    needsReupload (a row that held two tests).
// 6. A row loaded before the lab gave it a Sample ID (same day + description + test) takes the Sample ID when it arrives.
// 7. The lab file is the record: a row read back from Dataverse takes the file's date, reading, stage and test (its area,
//    equipment links and closure stay), and its result then follows rules 1 to 5.
// 8. An old two-test row read back from Dataverse (needsReupload) never changes a row that is already loaded.
// Rows with the same Sample ID and a different description are different samples and stay apart.
const RESULT_RANK = { Pending: 0, Count: 1, Negative: 2, Positive: 3 };
const DV_ROW_FIELDS = ['dvArea', 'dvRoom', 'dvSapw', 'dvEquipmentGuid', 'dvClosedKey', 'dvClosedOn', 'dvSource', 'fromDataverse'];
function keepDvFields(from, to) {
  DV_ROW_FIELDS.forEach(k => { if (from && from[k] !== undefined && to[k] === undefined) to[k] = from[k]; });
  return to;
}
function ingestRowsWithDeduplication(existingRows, incomingRawRows, sourceLabel = 'Import') {
  const ledger = existingRows.slice();
  const byKey = {};
  const byNoId = {};
  const descsById = {};
  const normIdOf = (r) => String(r.normSampleId || r.sampleId || '').trim().toUpperCase();
  const normDescOf = (r) => String(r.normSampleDesc || r.sampleDesc || '').trim().replace(/\s+/g, ' ').toUpperCase();

  const indexRow = (r, idx) => {
    const key = ledgerRowKey(r);
    if (key) byKey[key] = idx;
    else {
      const nk = noIdRowKey(r);
      if (nk) byNoId[nk] = idx;
    }
    const nId = normIdOf(r);
    if (nId) {
      if (!descsById[nId]) descsById[nId] = {};
      descsById[nId][normDescOf(r)] = true;
    }
  };
  ledger.forEach((r, idx) => indexRow(r, idx));

  let addedNew = 0;
  let upsertedBlankResult = 0;
  let upsertedBlankId = 0;
  let duplicatesBlocked = 0;
  let conflictsUpgraded = 0;
  let keptSeparateDiffDesc = 0;
  let replacedHandSet = 0;
  const auditEvents = [];
  const blockedDuplicates = [];
  const note = (type, r, detail) => {
    if (auditEvents.length < 80) {
      auditEvents.push({ type, date: r.date, sampleId: r.sampleId, sampleDesc: r.sampleDesc, siteCode: r.siteCode || r.scheduleId, room: r.room, detail });
    }
  };

  for (let i = 0; i < incomingRawRows.length; i += 1) {
    const inc = incomingRawRows[i];
    if (!inc) continue;
    const nId = normIdOf(inc);
    const nDesc = normDescOf(inc);
    const key = ledgerRowKey(inc);
    let matchIdx = key && byKey[key] !== undefined ? byKey[key] : -1;

    if (matchIdx === -1) {
      const nk = noIdRowKey(inc);
      if (nk && byNoId[nk] !== undefined) {
        const idx = byNoId[nk];
        const cur = ledger[idx];
        if (key) {
          // 6. The lab number arrived for a row that was loaded without one
          delete byNoId[nk];
          const keepCur = RESULT_RANK[cur.result] > RESULT_RANK[inc.result];
          const updated = keepDvFields(cur, {
            ...inc,
            result: keepCur ? cur.result : inc.result,
            rawResult: keepCur ? cur.rawResult : inc.rawResult,
            normSampleId: nId,
            normSampleDesc: nDesc,
            idAndDescKey: key,
            id: key,
            lastUpdatedSource: sourceLabel
          });
          ledger[idx] = updated;
          indexRow(updated, idx);
          upsertedBlankId += 1;
          note('BLANK_ID_FILLED', updated, `Sample ID ${inc.sampleId} added to the row loaded without one (same day, description and test)`);
          continue;
        }
        matchIdx = idx;
      }
    }

    if (matchIdx === -1) {
      if (nId && descsById[nId] && !descsById[nId][nDesc]) {
        keptSeparateDiffDesc += 1;
        note('KEPT_SEPARATE_DIFF_DESC', inc, `Same Sample ID (${inc.sampleId}) with a different description: kept as its own sample`);
      }
      const newRow = { ...inc, normSampleId: nId, normSampleDesc: nDesc, idAndDescKey: key, id: key || noIdRowKey(inc) || inc.id || `row-${ledger.length}` };
      ledger.push(newRow);
      indexRow(newRow, ledger.length - 1);
      addedNew += 1;
      continue;
    }

    const cur0 = ledger[matchIdx];
    if (inc.needsReupload) {
      // 8. An old two-test row never overrides a loaded row
      note('OLD_ROW_IGNORED', cur0, 'Old two-test row from Dataverse ignored: the loaded row is kept');
      continue;
    }
    // 7. A row read back from Dataverse takes the lab file's reading; its result still follows the rules below
    const cur = cur0.fromDataverse && !inc.fromDataverse
      ? keepDvFields(cur0, {
          ...inc,
          result: cur0.result,
          rawResult: cur0.rawResult,
          resultUnread: cur0.resultUnread,
          isBlankResult: cur0.isBlankResult,
          manualResult: !!cur0.manualResult,
          needsReupload: !!cur0.needsReupload,
          testMethods: Array.isArray(cur0.testMethods) ? cur0.testMethods : undefined,
          normSampleId: nId,
          normSampleDesc: nDesc,
          idAndDescKey: key || cur0.idAndDescKey,
          id: cur0.id,
          fromDataverse: false
        })
      : cur0;
    const mergedMethods = Array.isArray(cur.testMethods) ? cur.testMethods.slice() : (cur.testMethod ? [cur.testMethod] : []);
    if (inc.testMethod && mergedMethods.indexOf(inc.testMethod) === -1) mergedMethods.push(inc.testMethod);
    const incDone = inc.result !== 'Pending';

    if ((cur.manualResult && incDone) || cur.needsReupload) {
      // 5. The lab's result replaces a hand-set result, and a re-uploaded row replaces the old two-test row
      const updated = keepDvFields(cur, {
        ...inc,
        normSampleId: nId,
        normSampleDesc: nDesc,
        idAndDescKey: key || cur.idAndDescKey,
        id: cur.id,
        testMethods: inc.testMethod ? [inc.testMethod] : mergedMethods,
        manualResult: false,
        needsReupload: false,
        completedViaUpsert: cur.result === 'Pending' && incDone,
        lastUpdatedSource: sourceLabel
      });
      ledger[matchIdx] = updated;
      indexRow(updated, matchIdx);
      replacedHandSet += 1;
      note('LAB_REPLACED', updated, `Lab result ${updated.result} replaced ${cur.manualResult ? 'a result set by hand' : 'the old row'} (${cur.result})`);
      continue;
    }

    if (cur.result === 'Pending' && incDone) {
      // 1. Blank result completed in place: the swab is still counted once
      const updated = {
        ...cur,
        result: inc.result,
        rawResult: inc.rawResult || inc.result,
        resultUnread: false,
        isBlankResult: false,
        testMethods: mergedMethods,
        completedViaUpsert: true,
        lastUpdatedSource: sourceLabel
      };
      ledger[matchIdx] = updated;
      indexRow(updated, matchIdx);
      upsertedBlankResult += 1;
      note('BLANK_COMPLETED', updated, `Blank result completed in place: ${updated.result}`);
    } else if (cur.result === inc.result || !incDone) {
      // 2 and 3. Duplicate, or a blank re-upload of a finished result
      ledger[matchIdx] = { ...cur, testMethods: mergedMethods, duplicateHitsCount: (cur.duplicateHitsCount || 0) + 1 };
      duplicatesBlocked += 1;
      blockedDuplicates.push({
        date: inc.date,
        sampleId: inc.sampleId,
        sampleDesc: inc.sampleDesc,
        room: cur.room,
        siteCode: cur.siteCode || cur.scheduleId,
        keptResult: cur.result,
        blockedResult: incDone ? inc.result : 'Blank / Pending',
        testMethod: inc.testMethod,
        reason: incDone ? 'Same Sample ID, description and test' : 'Finished result kept (blank re-upload ignored)'
      });
      note(incDone ? 'DUPLICATE_ID_AND_DESC' : 'PROTECTED_COMPLETED', cur, incDone ? 'Duplicate: same Sample ID, description and test' : `Blank re-upload ignored; kept ${cur.result}`);
    } else {
      // 4. Two different results: the higher one is kept (Positive over Negative over a count)
      const keepCur = RESULT_RANK[cur.result] >= RESULT_RANK[inc.result];
      const finalRes = keepCur ? cur.result : inc.result;
      const bothCalls = (cur.result === 'Positive' || cur.result === 'Negative') && (inc.result === 'Positive' || inc.result === 'Negative');
      const updated = {
        ...cur,
        result: finalRes,
        rawResult: keepCur ? cur.rawResult : (inc.rawResult || inc.result),
        resultUnread: false,
        isBlankResult: false,
        testMethods: mergedMethods,
        conflictResolved: true,
        resultConflict: cur.resultConflict || bothCalls,
        resultHistory: (Array.isArray(cur.resultHistory) ? cur.resultHistory : [cur.rawResult || cur.result]).concat([inc.rawResult || inc.result]).slice(-6)
      };
      ledger[matchIdx] = updated;
      indexRow(updated, matchIdx);
      conflictsUpgraded += 1;
      note('CONFLICT_MERGED', updated, `Different results for one sample: ${cur.result} and ${inc.result}; kept ${finalRes}`);
    }
  }

  return {
    ledger,
    receipt: {
      timestamp: new Date().toLocaleTimeString(),
      sourceLabel,
      scanned: incomingRawRows.length,
      addedNew,
      upsertedBlankResult,
      upsertedBlankId,
      duplicatesBlocked,
      conflictsUpgraded,
      keptSeparateDiffDesc,
      replacedHandSet,
      blockedDuplicates: blockedDuplicates.slice(0, 500),
      events: auditEvents
    }
  };
}

function parseLabCsvText(csvText, rules, aliases, siteCatalog) {
  const parsed = parseLabRowsFromText(csvText, rules, aliases);
  if (parsed.rows.length === 0) return buildRollupFromLedger([], null);
  const { ledger: deduplicatedRows, receipt } = ingestRowsWithDeduplication([], parsed.rows, 'Active CSV / Table');
  receipt.skippedLines = parsed.skipped;
  return buildRollupFromLedger(deduplicatedRows, receipt);
}

// The test a hit is filed under on the calendar and in the filters (coliform and yeast/mold sit with APC)
function hitTestTypeOf(r) {
  const c = String((r && r.testCode) || '');
  if (c === 'LIS') return r.stage === 'RETEST' ? 'RETEST-LIS' : 'LIS';
  if (c === 'SAL') return 'SAL';
  if (c === 'ATP') return 'ATP';
  if (c === 'APC' || c === 'COLIFORM' || c === 'YEAST_MOLD') return 'APC';
  return 'LIS';
}

// Swabs / positives / pending for one slice. swabs = finished with a pass/fail call (Positive or Negative); a Count
// (number with no call) is neither, so a rate never mixes them in.
function newTally() { return { swabs: 0, positives: 0, pending: 0 }; }
function addToTally(t, r) {
  if (r.manualResult) return;
  if (r.result === 'Positive') { t.swabs += 1; t.positives += 1; }
  else if (r.result === 'Negative') t.swabs += 1;
  else if (r.result === 'Pending') t.pending += 1;
}
function tallyRate(t) { return t && t.swabs > 0 ? round2((t.positives / t.swabs) * 100) : null; }

// Everything one day, week, month or year holds. routine = the plant rate (environmental Listeria + Salmonella, no
// retests); retest, apc, atp, vector, product are reported on their own.
function newRollupBucket() {
  return {
    totalRows: 0, envSwabs: 0, vectors: 0, water: 0, product: 0,
    positives: 0, negatives: 0, pending: 0, counts: 0,
    byRoom: {}, pendingByRoom: {}, rowsByRoom: {},
    routine: newTally(), lis: newTally(), sal: newTally(), st: newTally(), inp: newTally(), routineByRoom: {},
    retest: newTally(), apc: newTally(), atp: newTally(), indicatorCounts: 0,
    vector: newTally(), productTally: newTally(), other: 0
  };
}
function addRowToBucket(b, r, keepRows) {
  const kind = r.swabKind || swabKindOf(r);
  b.totalRows += 1;
  const cat = String(r.category || '');
  if (cat.indexOf('Environmental') !== -1 || cat === 'SCM Swab') {
    b.envSwabs += 1;
    b.byRoom[r.room] = (b.byRoom[r.room] || 0) + 1;
  } else if (cat === 'Vector Swab') {
    b.vectors += 1;
    b.byRoom[r.room] = (b.byRoom[r.room] || 0) + 1;
  } else if (cat === 'Water Sample') b.water += 1;
  else if (cat === 'Product / WIP') b.product += 1;

  if (r.result === 'Positive') b.positives += 1;
  else if (r.result === 'Negative') b.negatives += 1;
  else if (r.result === 'Count') b.counts += 1;
  else {
    b.pending += 1;
    b.pendingByRoom[r.room] = (b.pendingByRoom[r.room] || 0) + 1;
  }
  if (keepRows) {
    if (!b.rowsByRoom[r.room]) b.rowsByRoom[r.room] = [];
    if (b.rowsByRoom[r.room].length < 40) b.rowsByRoom[r.room].push(r);
  }

  if (kind === 'routine') {
    addToTally(b.routine, r);
    addToTally(r.testCode === 'SAL' ? b.sal : b.lis, r);
    if (r.stage === 'ST') addToTally(b.st, r);
    else if (r.stage === 'INP') addToTally(b.inp, r);
    if (!b.routineByRoom[r.room]) b.routineByRoom[r.room] = newTally();
    addToTally(b.routineByRoom[r.room], r);
  } else if (kind === 'retest') addToTally(b.retest, r);
  else if (kind === 'indicator') {
    if (r.result === 'Count') b.indicatorCounts += 1;
    else if (r.testCode === 'ATP') addToTally(b.atp, r);
    else if (r.testCode === 'APC') addToTally(b.apc, r);
  } else if (kind === 'vector') addToTally(b.vector, r);
  else if (kind === 'product') addToTally(b.productTally, r);
  else if (kind === 'other') b.other += 1;
}

function buildRollupFromLedger(rawRows, dedupReceipt = null) {
  const rows = Array.isArray(rawRows)
    ? rawRows.slice().sort((a, b) => {
        const dCmp = String(a.date || '').localeCompare(String(b.date || ''));
        if (dCmp !== 0) return dCmp;
        const rCmp = String(a.room || '').localeCompare(String(b.room || ''));
        if (rCmp !== 0) return rCmp;
