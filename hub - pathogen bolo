                const isStreak = pin.count >= 2;
                const box = pin.spot && pin.spot.box;
                const pinWord = `${pin.siteCode || pin.room}: ${toneWord(pin.tone)}${pin.repeat ? `, ${tr('repeat', 'repetido')}` : ''} (${pin.count})`;
                return (
                  <React.Fragment key={pin.key}>
                    {/* Highlighted Swab Area Box for Active Hits (Only if explicitly mapped) */}
