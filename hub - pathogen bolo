        const meta = (matchedArea && !matchedArea.isRemoved && !matchedArea.hidden ? matchedArea : ROOM_META[ds.room]) || ROOM_META['Zone 4 / Mobile'];
        const dBox = meta.box || meta.defaultBox || [52, 90, 40, 7];
