        logEvent(denied ? `The swab table could not be read (${probeError}).` : '"_b_ Swab result" table not found: swab results stay on this computer only.', 'warn');
        return false;
      }
      tableRef.current = found;
      setSwabDv(p => ({ ...p, set: found.set, idCol: found.id, loading: true, loaded: 0 }));
      // Only the columns the table has (a $select naming a missing column is refused), and no row marked replaced
      const cols = probeRec ? SWAB_COLUMNS.filter(k => Object.prototype.hasOwnProperty.call(probeRec, k)) : SWAB_COLUMNS.slice();
      const select = probeRec ? `&$select=${[found.id].concat(cols).join(',')}` : '';
      const live = probeRec && cols.indexOf('craa5_result') !== -1 ? " and (craa5_result ne 'replaced' or craa5_result eq null)" : '';
      const recs = await fetchAllPages(apiUrl(`${found.set}?$filter=statecode eq 0${live}${select}`), 0, n => setSwabDv(p => ({ ...p, loaded: n })));
      const colSource = recs[0] || probeRec;
      if (colSource) {
        hashColsRef.current = SWAB_COLUMNS.filter(k => Object.prototype.hasOwnProperty.call(colSource, k));
        missingRef.current = {};
        SWAB_COLUMNS.forEach(k => { if (hashColsRef.current.indexOf(k) === -1) missingRef.current[k] = true; });
      }
      const rulesCompiled = compileRegexSet(regexRules);
      const loaded = [];
      const stored = {};
      const synced = {};
      const legacy = {};
      const example = {};
      const foreign = [];
      const hasSourceCol = hashColsRef.current.indexOf('craa5_source') !== -1;
      recs.forEach((rec, i) => {
        if (String(rec.craa5_result || '').toLowerCase() === 'replaced') return;
        const rid = hubGuid(rec[found.id]);
        if (!rid) return;
        // v2.5: every row this app saves carries a Source (since v2.2). A row with none was not saved by Pathogen BOLO,
        // most likely a sample row the Copilot table maker added: it is left out (never shown as a swab, never marked by
        // a re-upload) and listed in the Table check so it can be deleted in Dataverse.
        const isExample = !!EXAMPLE_ROW_SIGS[exampleRowSig(rec.craa5_sampleid, rec.craa5_sampledescription)];
        if (!isExample && hasSourceCol && !String(rec.craa5_source || '').trim()) {
          foreign.push({ id: rid, sampleId: String(rec.craa5_sampleid || rec.craa5_name || ''), date: String(rec.craa5_collectiondate || '').slice(0, 10) });
          return;
        }
        stored[rid] = String(rec.craa5_collectiondate || '').slice(0, 4) || '?';
        if (isExample) { example[rid] = true; return; }
        const row = swabRowFromRecord(rec, rulesCompiled, roomAliases, i);
        if (!row) return;
        const newId = swabRowId(row);
        if (newId !== rid) legacy[rid] = newId;
        else synced[rid] = swabPayloadHash(rec, hashColsRef.current);
        loaded.push(row);
      });
      storedIdsRef.current = stored;
      syncedRef.current = synced;
      legacyRef.current = legacy;
      exampleRef.current = example;
      const apart = !!reuploadRef.current;
      if (!apart) {
        setHistoricalLedger(prev => {
          const byKey = {};
          loaded.forEach(r => { byKey[swabRowKey(r)] = r; });
          const withDv = prev.map(r => {
            const d = byKey[swabRowKey(r)];
            return d ? { ...r, dvArea: d.dvArea, dvRoom: d.dvRoom, dvSapw: d.dvSapw, dvEquipmentGuid: d.dvEquipmentGuid, dvClosedKey: d.dvClosedKey, dvClosedOn: d.dvClosedOn, dvSource: d.dvSource } : r;
          });
          return ingestRowsWithDeduplication(withDv, loaded, 'Dataverse _b_ Swab result').ledger;
        });
      }
      const at = new Date().toLocaleTimeString();
      setSwabDv(p => ({ ...p, status: 'ready', set: found.set, idCol: found.id, loading: false, loadError: '', stored: Object.keys(stored).length, missingCols: Object.keys(missingRef.current), lastLoad: at, lastSync: at, legacy: Object.keys(legacy).length, foreign: foreign.slice(0, 40), foreignCount: foreign.length }));
      logEvent(`${why === 'reload' ? 'Read the swab table again' : 'Loaded'}: ${loaded.length.toLocaleString()} swab results from Dataverse (${found.set})${apart ? ', kept apart until the re-upload is finished' : ''}.`, 'success');
      if (Object.keys(example).length > 0) {
        logEvent(`${Object.keys(example).length} stored row(s) are the v2.0 example table, not real swabs: left out, and marked replaced on the next save.`, 'warn');
      }
      if (foreign.length > 0) {
        logEvent(`${foreign.length} row(s) in the swab table have no Source, so Pathogen BOLO did not save them (most likely Copilot sample rows): left out. Delete them in Dataverse.`, 'warn');
      }
      return true;
    } catch (e) {
      setSwabDv(p => ({ ...p, status: p.status === 'ready' ? 'ready' : 'error', loading: false, lastError: e.message, loadError: e.message }));
      logEvent(`Swab results could not be read from Dataverse (${e.message}).`, 'error');
      return false;
    } finally {
      loadingRef.current = false;
    }
  }, [regexRules, roomAliases, setHistoricalLedger, logEvent]);
  const loadTableRef = useRef(loadTable);
  useEffect(() => { loadTableRef.current = loadTable; }, [loadTable]);
  useEffect(() => { loadTableRef.current('open'); }, []);

  const refsReady = refsLoaded.areas && refsLoaded.assets && refsLoaded.links && refsLoaded.zones;

  // 3. Save rows that are new or changed (only for people allowed to load data, and only once areas are known).
  // boloSaveRows sends 100 rows a request and waits when Dataverse says it is busy; a row it could not save keeps its
  // reason (failedRef) for the Table check and is tried again by the next save.
  const failedRef = useRef({});
  const runSync = useCallback(async () => {
    if (swabDv.status !== 'ready' || !canWrite || !refsReady || swabDv.loading) return;
    if (runningRef.current) { rerunRef.current = true; return; }
    runningRef.current = true;
    try {
      const dirty = [];
      const seen = {};
      (ledgerRows || []).forEach(r => {
        // A row that held two tests is not saved: its result may belong to the other test
        if (!r || !r.date || r.needsReupload) return;
        const body = buildSwabPayload(r, ctx);
        const id = swabRowId(r);
        if (seen[id]) return;
        seen[id] = true;
        if (syncedRef.current[id] !== swabPayloadHash(body, hashColsRef.current)) dirty.push({ id, body });
      });
      failedRef.current = {};
      setSwabDv(p => ({ ...p, queued: dirty.length, saving: dirty.length > 0, failed: 0, savedNow: 0, toSave: dirty.length }));
      const res = dirty.length === 0 ? { saved: 0, failed: 0, lastError: '' } : await boloSaveRows(swabDv.set, dirty, {
        missing: missingRef.current,
        onMissing: (col) => { hashColsRef.current = hashColsRef.current.filter(c => c !== col); },
        onSaved: (job) => {
          syncedRef.current[job.id] = swabPayloadHash(job.body, hashColsRef.current);
          storedIdsRef.current[job.id] = String(job.body.craa5_collectiondate || '').slice(0, 4) || '?';
        },
        onFailed: (job, error) => { failedRef.current[job.id] = error; },
        onProgress: (pr) => setSwabDv(p => ({ ...p, queued: pr.left, savedNow: pr.saved, failedNow: pr.failed }))
      });
      // v2.2 rows whose v2.3 row is now saved, and stored rows of the v2.0 example table: marked replaced, so readers
      // that ask for craa5_result eq 'positive' never count one swab twice. Nothing is deleted.
      const oldIds = Object.keys(legacyRef.current).filter(oldId => syncedRef.current[legacyRef.current[oldId]]);
      const replacedOld = [];
      if (oldIds.length > 0) {
        await boloSaveRows(swabDv.set, oldIds.map(oldId => ({ id: oldId, body: { craa5_result: 'replaced', craa5_source: `Replaced by ${legacyRef.current[oldId]}` } })), {
          missing: missingRef.current,
          onSaved: (job) => {
            replacedOld.push(job.id);
            delete legacyRef.current[job.id];
            delete storedIdsRef.current[job.id];
          }
        });
        // Made inactive too when allowed; the result text already keeps it out of every reader
        for (let i = 0; i < replacedOld.length; i += 1) {
          await patchRowDroppingMissing(swabDv.set, replacedOld[i], { statecode: 1, statuscode: 2 });
        }
        if (replacedOld.length > 0) logEvent(`${replacedOld.length} swab row(s) saved under the old key (no test) marked replaced in Dataverse.`, 'info');
      }
      const exampleIds = Object.keys(exampleRef.current);
      if (exampleIds.length > 0) {
        let examplesDone = 0;
        await boloSaveRows(swabDv.set, exampleIds.map(id => ({ id, body: { craa5_result: 'replaced', craa5_source: 'Example row from v2.0, not a real swab' } })), {
          missing: missingRef.current,
          onSaved: (job) => {
            examplesDone += 1;
            delete exampleRef.current[job.id];
            delete storedIdsRef.current[job.id];
          }
        });
        if (examplesDone > 0) logEvent(`${examplesDone} example row(s) from v2.0 marked replaced in Dataverse.`, 'info');
      }
      setSwabDv(p => ({
        ...p,
        queued: 0,
        saving: false,
        failed: res.failed,
        lastError: res.failed > 0 ? res.lastError : '',
        stored: Object.keys(storedIdsRef.current).length,
        missingCols: Object.keys(missingRef.current),
        lastSync: new Date().toLocaleTimeString(),
        legacy: Object.keys(legacyRef.current).length
      }));
      if (res.saved > 0) logEvent(`Saved ${res.saved.toLocaleString()} swab result(s) to Dataverse.`, 'success');
      if (res.failed > 0) logEvent(`${res.failed} swab result(s) not saved (${res.lastError}). Save now in the Table check tries them again.`, 'error');
    } finally {
      runningRef.current = false;
      if (rerunRef.current) { rerunRef.current = false; window.setTimeout(() => { runSyncRef.current(); }, 500); }
    }
  }, [swabDv.status, swabDv.set, swabDv.loading, canWrite, refsReady, ledgerRows, ctx, logEvent]);
  const runSyncRef = useRef(runSync);
  useEffect(() => { runSyncRef.current = runSync; }, [runSync]);
  useEffect(() => {
    const t = window.setTimeout(() => { runSync(); }, 1500);
    return () => window.clearTimeout(t);
  }, [runSync]);

  // 4. Closures. Gerald (2026-10-23): every clean in the plant follows the presumptive process (three sanitizers, extra
  // ppm), so every clean is a pathogen clean: any MSS log clean of the same equipment (or area) on or after the swab day
  // closes a positive. Only positives inside the alert window are looked up; older ones are history.
  const alertSince = alertSinceOf(rules);
  useEffect(() => {
    if (!refsReady) return undefined;
    let alive = true;
    const open = (ledgerRows || []).filter(r => r && r.result === 'Positive' && r.date && r.date >= alertSince && !r.dvClosedKey);
    if (open.length === 0) return undefined;
    const minDay = open.reduce((m, r) => (r.date < m ? r.date : m), open[0].date);
    const run = async () => {
      const base = `${MSS_LOG_SET}?$filter=craa5_lastcleaned ge ${minDay}T00:00:00Z&$select=`;
      let recs;
      try {
        recs = await fetchAllPages(apiUrl(base + 'craa5__log_id,craa5_equipmentguid,craa5_area,craa5_lastcleaned,craa5_shiftdate,craa5_completionkey'), 60000);
      } catch (e) {
        try {
          recs = await fetchAllPages(apiUrl(base + 'craa5__log_id,craa5_equipmentguid,craa5_area,craa5_lastcleaned'), 60000);
        } catch (e2) {
          return;
        }
      }
      const logs = recs.map(l => ({
        key: l.craa5_completionkey || `log|${hubGuid(l.craa5__log_id)}`,
        day: l.craa5_shiftdate || hubDayFromDateOnly(l.craa5_lastcleaned),
        equipmentguid: hubGuid(l.craa5_equipmentguid || ''),
        area: l.craa5_area || ''
      }));
      if (alive) setClosures(findSwabClosures(open, logs, ctx));
    };
    run();
    return () => { alive = false; };
  // Re-check when the number of positives changes, links change or the window moves, not on every ledger edit
  }, [refsReady, (ledgerRows || []).length, siteLinks, effectiveZoneAreas, alertSince]);

  const saveSiteLink = useCallback(async (siteCode, link) => {
    const code = String(siteCode || '').toUpperCase();
    const equipmentguid = hubGuid(link.equipmentguid || '');
    const asset = equipmentguid ? assetsById[equipmentguid] : null;
    const next = { area: link.area || '', equipmentguid, sapw: (asset && asset.sapw) || '' };
    const existing = siteLinks[code] || {};
    const recId = existing.recId || hubIdFromKey(`site|${code}`);
    const body = {
      [`${DATAVERSE_BOLO_SITES_LOGICAL}1`]: code,
      craa5_sitecode: code,
      craa5_area: next.area,
      craa5_equipmentguid: next.equipmentguid,
      craa5_sapw: next.sapw
    };
    const res = await patchRowDroppingMissing(DATAVERSE_BOLO_SITES_TABLE, recId, body);
    if (!res.ok) throw new Error(res.error);
    if (res.missing.length > 0) {
      logEvent(`Swab site table is missing column(s): ${res.missing.join(', ')}. Add them (see table prompts) so the link is kept.`, 'warn');
    }
    setSiteLinks(p => ({ ...p, [code]: { ...next, recId } }));
    return res;
  }, [siteLinks, assetsById, logEvent]);

  const saveZoneAreas = useCallback(async (zones, upsertHubConfigKey) => {
    await upsertHubConfigKey(AREA_ALIAS_CONFIG_KEY, { zones, savedAt: new Date().toISOString() });
    setZoneAreas(zones);
    setZoneAreasSaved(true);
  }, []);

  // Table check (top of the Data Manipulation tab): the table against this computer, by year. onlyTable = active table
  // rows this computer does not hold (old-key and example rows are handled by the save and left out); notInTable =
  // rows here the table does not have yet. During a re-upload, fromFiles = rows the files brought back that the table
  // already had when the re-upload started.
  const ledgerIdsRef = useRef({});
  const tableCheck = useMemo(() => {
    const here = {};
    const hereByYear = {};
    let hereN = 0;
    let notInTable = 0;
    (ledgerRows || []).forEach(r => {
      if (!r || !r.date || r.needsReupload) return;
      const id = swabRowId(r);
      if (here[id]) return;
      here[id] = true;
      hereN += 1;
      const y = r.date.slice(0, 4);
      hereByYear[y] = (hereByYear[y] || 0) + 1;
      if (!storedIdsRef.current[id]) notInTable += 1;
    });
    ledgerIdsRef.current = here;
    const tableByYear = {};
    const onlyTable = [];
    let tableN = 0;
    Object.keys(storedIdsRef.current).forEach(id => {
      tableN += 1;
      const y = storedIdsRef.current[id] === true ? '?' : storedIdsRef.current[id];
      tableByYear[y] = (tableByYear[y] || 0) + 1;
      if (!here[id] && !legacyRef.current[id] && !exampleRef.current[id]) onlyTable.push(id);
    });
    const session = reuploadRef.current;
    let fromFiles = 0;
    if (session) Object.keys(here).forEach(id => { if (session.atStart[id]) fromFiles += 1; });
    const reasons = {};
    Object.keys(failedRef.current).forEach(id => {
      const why = failedRef.current[id] || '';
      reasons[why] = (reasons[why] || 0) + 1;
    });
    const failReasons = Object.keys(reasons).sort((a, b) => reasons[b] - reasons[a]).slice(0, 3).map(w => ({ why: w, n: reasons[w] }));
    return { hereN, hereByYear, tableN, tableByYear, onlyTable, notInTable, fromFiles, failReasons };
  }, [ledgerRows, swabDv.stored, swabDv.lastSync, swabDv.lastLoad, swabDv.failed, reupload]);

  // Re-upload (Table check, click to run): 1. clear this computer (the table is not touched), 2. upload every lab file:
  // their rows are saved under the same row ids, 3. the table rows none of the files brought back are listed, and only
  // "Mark replaced" changes them. v2.3 marked every table row replaced before the upload, and its marks raced the
  // upload's save, so fresh rows could end up marked replaced.
  const beginReupload = useCallback(() => {
    const info = { since: new Date().toISOString(), atStart: { ...storedIdsRef.current } };
    reuploadRef.current = info;
    setReupload({ since: info.since, tableAtStart: Object.keys(info.atStart).length, marked: 0, markFailed: 0 });
  }, []);
  const endReupload = useCallback(() => {
    reuploadRef.current = null;
    setReupload(null);
  }, []);
  // Marks table rows replaced (never deleted), so no reader counts them. Only rows this computer does not hold: a row a
  // file brings back while the marks go out is saved again right after.
  const markStaleRows = useCallback(async (ids) => {
    if (swabDv.status !== 'ready' || !canWrite) return { ok: false, marked: 0, failed: 0 };
    const list = (ids || []).filter(id => storedIdsRef.current[id] && !ledgerIdsRef.current[id]);
    if (list.length === 0) return { ok: true, marked: 0, failed: 0 };
    const note = `Re-upload ${LIVE_TODAY_DATE_KEY}: in no lab file`;
    setSwabDv(p => ({ ...p, saving: true, marking: true, queued: list.length, savedNow: 0, toSave: list.length }));
    const res = await boloSaveRows(swabDv.set, list.map(id => ({ id, body: { craa5_result: 'replaced', craa5_source: note } })), {
      missing: missingRef.current,
      onSaved: (job) => {
        delete storedIdsRef.current[job.id];
        delete syncedRef.current[job.id];
      },
      onProgress: (pr) => setSwabDv(p => ({ ...p, queued: pr.left, savedNow: pr.saved, failedNow: pr.failed }))
    });
    const back = list.filter(id => ledgerIdsRef.current[id]);
    back.forEach(id => { delete syncedRef.current[id]; });
    setSwabDv(p => ({ ...p, saving: false, marking: false, queued: 0, stored: Object.keys(storedIdsRef.current).length, lastSync: new Date().toLocaleTimeString() }));
    setReupload(p => (p ? { ...p, marked: (p.marked || 0) + res.saved, markFailed: res.failed } : p));
    logEvent(`Re-upload: ${res.saved.toLocaleString()} swab row(s) that no lab file holds marked replaced in Dataverse${res.failed > 0 ? `, ${res.failed} not changed (${res.lastError})` : ''}.`, res.failed > 0 ? 'error' : 'warn');
    if (back.length > 0) window.setTimeout(() => { runSyncRef.current(); }, 300);
    return { ok: res.failed === 0, marked: res.saved, failed: res.failed };
  }, [swabDv.status, swabDv.set, canWrite, logEvent]);

  // Last MSS log rows for a piece (or an area when the hit has no piece)
  const fetchLogHistory = useCallback(async (equipmentguid, area) => {
    const g = hubGuid(equipmentguid);
    const filter = g
      ? `craa5_equipmentguid eq '${g}'`
      : `craa5_area eq '${String(area || '').replace(/'/g, "''")}'`;
    const res = await fetch(apiUrl(`${MSS_LOG_SET}?$select=craa5__log_id,craa5_lastcleaned,craa5_lastcleanedby,craa5_equipment,craa5_area,craa5_pathogen,craa5_sap&$filter=${filter}&$orderby=craa5_lastcleaned desc&$top=8`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    const data = await res.json();
    return (data.value || []).map(l => ({
      id: l.craa5__log_id,
      day: hubDayFromDateOnly(l.craa5_lastcleaned),
      by: l.craa5_lastcleanedby || '',
      equipment: l.craa5_equipment || '',
      area: l.craa5_area || '',
      pathogen: l.craa5_pathogen || '',
      sap: l.craa5_sap || ''
    }));
  }, []);

  return {
    swabDv,
    mssAreas,
    assets,
    assetsById,
    siteLinks,
    zoneAreas: effectiveZoneAreas,
    zoneAreasSaved,
    closures,
    linkCtx: ctx,
    refsReady,
    retrySync: runSync,
    reloadTable: () => loadTableRef.current('reload'),
    tableCheck,
    reupload,
    beginReupload,
    endReupload,
    markStaleRows,
    saveSiteLink,
    saveZoneAreas,
    fetchLogHistory
  };
}

// =======================================================================
// [_b_ SWAB RESULT - SCREENS] Status chip, open positives (with MSS log history) and swab site links
// =======================================================================
function SwabDvStatusChip({ swabDv, canWrite, onRetry }) {
  let label = tr('Dataverse: checking swab table...', 'Dataverse: revisando la tabla de hisopos...');
  let cls = 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600';
  if (swabDv.status === 'missing') {
    label = tr('Swab table not created yet: results stay on this computer', 'La tabla de hisopos aun no existe: los resultados se quedan en esta computadora');
    cls = 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-700';
  } else if (swabDv.status === 'error') {
    label = tr(`Swab table read failed: ${swabDv.lastError}`, `No se pudo leer la tabla de hisopos: ${swabDv.lastError}`);
    cls = 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-700';
  } else if (swabDv.status === 'ready') {
    if (swabDv.saving) label = tr(`Saving swab results... ${swabDv.queued.toLocaleString()} left`, `Guardando resultados de hisopos... faltan ${swabDv.queued.toLocaleString()}`);
    else if (swabDv.failed > 0) label = tr(`${swabDv.failed} swab result(s) not saved - Retry`, `${swabDv.failed} resultado(s) de hisopos sin guardar - Reintentar`);
    else label = tr(`Dataverse: ${swabDv.stored.toLocaleString()} swab results saved${canWrite ? '' : ' (view only)'}`, `Dataverse: ${swabDv.stored.toLocaleString()} resultados de hisopos guardados${canWrite ? '' : ' (solo lectura)'}`);
    // A failed save is red (act now, contract section 10); saved is green
    cls = swabDv.failed > 0
      ? 'bg-red-50 text-red-800 border-red-300 dark:bg-red-950/60 dark:text-red-200 dark:border-red-800'
      : 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950/50 dark:text-emerald-200 dark:border-emerald-700';
  }
  const missing = swabDv.missingCols && swabDv.missingCols.length > 0 ? tr(` Missing columns: ${swabDv.missingCols.join(', ')}.`, ` Faltan columnas: ${swabDv.missingCols.join(', ')}.`) : '';
  return localizeReactTree((
    <button
      type="button"
      onClick={() => { if (swabDv.status === 'ready' && onRetry) onRetry(); }}
      title={`${label}.${missing}${swabDv.lastSync ? ` Last check ${swabDv.lastSync}.` : ''}`}
      className={`px-2.5 py-1 rounded-full border text-[11px] font-bold whitespace-nowrap ${cls}`}
    >
      {label}{missing ? ' (!)' : ''}
    </button>
  ), ACTIVE_UI_LANG);
}

// The full list of positives of the alert window (2 months unless saved otherwise), from buildOpenPositives: overdue
// first, then open ones by days open, then closed. Each row says its state with a word (Overdue / Open / Closed), the
// owner by stage, what it waits on, and opens its last MSS log cleans. Any MSS log clean of the same equipment (or of
// the same area when the site has no equipment) on or after the swab day closes a positive.
function OpenSwabHitsPanel({ theme, darkMode, open, assetsById, fetchLogHistory, refsReady, swabDv, repeatHitIds, newSince, onOpenSite, onClose }) {
  const [showClosed, setShowClosed] = useState(false);
  const [openRow, setOpenRow] = useState('');
  const [history, setHistory] = useState({});
  if (!open) return null;
  const since = open.since;
  const rows = open.list;
  const shown = rows.filter(x => showClosed || !x.closure).slice(0, 80);

  const toggleHistory = async (x) => {
    if (openRow === x.key) { setOpenRow(''); return; }
    setOpenRow(x.key);
    if (history[x.key]) return;
    if (!x.links.equipmentguid && !x.links.area) {
      setHistory(h => ({ ...h, [x.key]: { error: tr('This swab site is not linked to an MSS area or equipment yet (Sites, Swab catalog).', 'Este sitio de hisopo aun no esta ligado a un area MSS ni a un equipo (Sitios, Catalogo de hisopos).') } }));
      return;
    }
    setHistory(h => ({ ...h, [x.key]: { loading: true } }));
    try {
      const list = await fetchLogHistory(x.links.equipmentguid, x.links.area);
      setHistory(h => ({ ...h, [x.key]: { list } }));
    } catch (e) {
      setHistory(h => ({ ...h, [x.key]: { error: e.message } }));
    }
  };

  return localizeReactTree((
    <div className={`shrink-0 rounded-xl border p-4 shadow-xs ${theme.bgCard}`} data-open-positives="1">
      <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <h3 className={`text-sm font-black ${theme.textHeading}`}>{tr('Open positives and corrective cleans', 'Positivos abiertos y limpiezas correctivas')}</h3>
          <p className={`text-[11px] ${theme.textMuted}`}>
