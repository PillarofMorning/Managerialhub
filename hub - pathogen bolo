function applyWordLevelEsMx(str) {
  if (!str || typeof str !== 'string') return str;
  return str.replace(/\b([A-Za-z]{3,})\b/g, (word) => {
    const lower = word.toLowerCase();
    if (!Object.prototype.hasOwnProperty.call(ES_MX_WORD_MAP, lower)) return word;
    const mapped = ES_MX_WORD_MAP[lower];
    if (!mapped || typeof mapped !== 'string') return word;
    if (word === word.toUpperCase() && word.length > 1) return mapped.toUpperCase();
    if (word[0] === word[0].toUpperCase()) return mapped.charAt(0).toUpperCase() + mapped.slice(1);
    return mapped;
  });
}

function translateToEsMx(inputStr) {
  if (ACTIVE_UI_LANG !== 'es_mx' || typeof inputStr !== 'string') return inputStr;
  const trimmed = inputStr.trim();
  if (!trimmed) return inputStr;
  if (Object.prototype.hasOwnProperty.call(ES_MX_TRANSLATED_VALUES, trimmed) || Object.prototype.hasOwnProperty.call(TR_ES_FINAL, trimmed)) {
