// ---------- Open positives, most urgent first (v2.5) ----------
// Every positive lab row of the alert window with its state: closed (a clean of its equipment, or of its area when the
// site has no equipment, on or after the swab day, from the MSS log or saved on the row) or open. An open one is
// Overdue once it has been open more than closeDays days. waitingOn: 'clean' (the next step is a clean in the MSS log)
// or 'link' (the site has no MSS area or equipment yet, so no clean can close it until it is linked). An APC / ATP
// fail is an indicator: it waits on a clean too, but shows amber (watch) until it is overdue. Order: overdue first, then
// open pathogen positives, then open indicator fails (each by days open), then closed (newest first).
function buildOpenPositives(ledger, closures, linkCtx, rules, todayKey) {
  const R = normalizeBoloRules(rules);
  const today = todayKey || LIVE_TODAY_DATE_KEY;
  const since = alertSinceOf(R, today);
  const list = [];
  let olderOpen = 0;
  (ledger || []).forEach(r => {
    if (!r || r.result !== 'Positive' || !r.date) return;
    const key = swabRowKey(r);
    const closure = (closures && closures[key]) || (r.dvClosedKey ? { key: r.dvClosedKey, day: r.dvClosedOn } : null);
    if (r.date < since) {
      if (!closure) olderOpen += 1;
      return;
    }
    const links = resolveSwabLinks(r, linkCtx);
    const daysOpen = closure ? null : dayDiff(r.date, today);
    const daysToClose = closure && closure.day ? dayDiff(r.date, closure.day) : null;
    const linked = !!(links.equipmentguid || links.area);
    list.push({
      r,
      key,
      links,
      closure,
      daysOpen,
      daysToClose,
      overdue: !closure && typeof daysOpen === 'number' && daysOpen > R.closeDays,
      indicator: r.testCode === 'APC' || r.testCode === 'ATP',
      owner: ownerOfStage(r.stage),
      waitingOn: closure ? '' : (linked ? 'clean' : 'link')
    });
  });
  list.sort((a, b) => {
    if (!a.closure !== !b.closure) return a.closure ? 1 : -1;
    if (a.closure) return String(b.r.date).localeCompare(String(a.r.date));
    if (a.overdue !== b.overdue) return a.overdue ? -1 : 1;
    if (a.indicator !== b.indicator) return a.indicator ? 1 : -1;
    return ((b.daysOpen || 0) - (a.daysOpen || 0)) || String(a.r.siteCode || '').localeCompare(String(b.r.siteCode || ''));
  });
  const open = list.filter(x => !x.closure);
  const closedDays = [];
  list.forEach(x => {
    if (x.closure && typeof x.daysToClose === 'number' && !isNaN(x.daysToClose)) closedDays.push(Math.max(0, x.daysToClose));
  });
  return {
    list,
    open,
    since,
    olderOpen,
    openCount: open.length,
    overdueCount: open.filter(x => x.overdue).length,
    // Red when a pathogen positive is open or anything is overdue; amber when only APC / ATP fails are open
    tone: open.some(x => x.overdue || !x.indicator) ? 'act' : (open.length > 0 ? 'watch' : 'done'),
    // first = the most urgent open one (the order above); oldest = the one open the longest
    first: open.length > 0 ? open[0] : null,
    oldest: open.reduce((m, x) => (!m || (x.daysOpen || 0) > (m.daysOpen || 0) ? x : m), null),
    closedCount: list.length - open.length,
    medianDaysToClose: medianOf(closedDays),
    closeDays: R.closeDays
  };
}
function medianOf(nums) {
  const a = (nums || []).filter(n => typeof n === 'number' && !isNaN(n)).sort((x, y) => x - y);
  if (a.length === 0) return null;
  const mid = Math.floor(a.length / 2);
  return a.length % 2 ? a[mid] : round2((a[mid - 1] + a[mid]) / 2);
