}
function boloSectionLabel(id) {
  if (id === 'calendar') return tr('Calendar', 'Calendario');
  if (id === 'map') return tr('Map', 'Mapa');
  if (id === 'trends') return tr('Trends', 'Tendencias');
  if (id === 'sites') return tr('Sites', 'Sitios');
  if (id === 'harborage') return tr('Harborage and concerns', 'Refugios y hallazgos');
  if (id === 'explorer') return tr('Swab catalog', 'Catalogo de hisopos');
  if (id === 'datamanip') return tr('Checks and tables', 'Revisiones y tablas');
  if (id === 'studio') return tr('Upload lab files', 'Subir archivos del laboratorio');
  if (id === 'dedup') return tr('Duplicates', 'Duplicados');
  if (id === 'dev') return tr('Developer', 'Desarrollador');
  return id;
}
// The view a section opens in: the current one when it holds the section, else the first view that does
function boloViewOfSection(sectionId, currentView) {
  let found = '';
  for (let i = 0; i < BOLO_VIEWS.length; i += 1) {
    if (BOLO_VIEWS[i].sections.indexOf(sectionId) === -1) continue;
    if (BOLO_VIEWS[i].id === currentView) return currentView;
    if (!found) found = BOLO_VIEWS[i].id;
  }
  return found || currentView;
}
