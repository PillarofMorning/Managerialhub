        key: synopsisKey,
        text: String(synopsisText || '').trim(),
        updatedAt: new Date().toISOString(),
        updatedBy: msIdentity ? msIdentity.userName : '',
        updatedByMsId: msIdentity ? msIdentity.microsoftId : '',
        syncedToDataverse: true
      };
