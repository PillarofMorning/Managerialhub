    const n = parseFloat(v);
    return isNaN(n) ? d : Math.min(hi, Math.max(lo, n));
  };
  const D = BOLO_RULES_DEFAULT;
  return {
    targets: {
      pathogen: round2(num(t.pathogen, D.targets.pathogen, 0, 100)),
      apc: round2(num(t.apc, D.targets.apc, 0, 100)),
      atp: round2(num(t.atp, D.targets.atp, 0, 100))
    },
    repeatDays: Math.round(num(src.repeatDays, D.repeatDays, 1, 365)),
