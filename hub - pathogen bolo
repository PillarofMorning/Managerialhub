  return '--';
}
function roomShortOf(rk) {
  return (ROOM_META[rk] && ROOM_META[rk].short) || rk || '';
}
// The test of a lab row as a badge label: LIS ST, SAL INP, LIS retest, APC...
function rowTestLabel(r) {
  if (!r) return '';
  const code = String(r.testCode || '').toUpperCase() || '?';
  if (r.stage === 'RETEST') return `${code} ${tr('retest', 're-prueba')}`;
  if (r.stage === 'ST' || r.stage === 'INP') return `${code} ${r.stage}`;
  return code;
}
// A lab row's result as a chip with a word: positive = act now, negative = done, at the lab = not known yet; a lab
// number (count) is a pass on APC / ATP and in no rate elsewhere
function ResultChip({ r, darkMode }) {
  const res = r ? r.result : '';
  if (res === 'Positive') return <ToneChip tone="act" darkMode={darkMode}>{r.overLimit ? tr(`Positive (${String(r.rawResult || '').trim()})`, `Positivo (${String(r.rawResult || '').trim()})`) : tr('Positive', 'Positivo')}</ToneChip>;
  if (res === 'Negative') return <ToneChip tone="done" darkMode={darkMode}>{tr('Negative', 'Negativo')}</ToneChip>;
  if (res === 'Count') {
    const isInd = r.testCode === 'APC' || r.testCode === 'ATP';
    return <ToneChip tone={isInd ? 'done' : 'plain'} darkMode={darkMode}>{isInd ? tr(`Pass (${String(r.rawResult || '').trim()})`, `Pasa (${String(r.rawResult || '').trim()})`) : tr(`Count ${String(r.rawResult || '').trim()}`, `Conteo ${String(r.rawResult || '').trim()}`)}</ToneChip>;
  }
  return <ToneChip tone="unknown" darkMode={darkMode}>{tr('At the lab', 'En el laboratorio')}</ToneChip>;
}

