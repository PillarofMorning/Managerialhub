// A button that asks on the page before it acts (data contract ground rule 9: Power Apps pages silently block
// window.confirm / alert / prompt, so a button that relied on one did nothing). The first click shows the question
// with "Yes" and "Cancel"; only "Yes" runs onConfirm.
function ConfirmButton({ label, question, yesLabel, onConfirm, disabled, className, yesClassName }) {
  const [asking, setAsking] = useState(false);
  if (!asking) {
    return (
      <button type="button" disabled={disabled} onClick={() => setAsking(true)} className={className}>
        {label}
      </button>
    );
  }
  return (
    <span role="group" className="inline-flex flex-wrap items-center gap-1.5 align-middle">
      {question && <span className="text-[11px] font-bold">{question}</span>}
      <button
        type="button"
        disabled={disabled}
        onClick={() => {
          setAsking(false);
          onConfirm();
        }}
        className={yesClassName || className}
      >
        {yesLabel}
      </button>
      <button
        type="button"
        onClick={() => setAsking(false)}
        className="px-2 py-0.5 rounded-lg text-[11px] font-black border border-slate-300 bg-white text-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600"
      >
        {tr('Cancel', 'Cancelar')}
      </button>
    </span>
  );
}

function ImportCheckPanel({ darkMode, theme, check, canEdit, lastReceipt, onStartFresh, onUploadFiles, onResetTypedYoY, dvStored, dvSaving }) {
  const [open, setOpen] = useState(() => !!check && check.verdict !== 'ok');
  const [showAllWeeks, setShowAllWeeks] = useState(false);
  const [showStartOver, setShowStartOver] = useState(false);
  const [retireDv, setRetireDv] = useState(true);
  const fileRef = useRef(null);
  if (!check) return null;

  const verdictInfo = {
    reupload: {
      chip: tr('Re-upload recommended', 'Se recomienda volver a subir'),
      line: tr('Some saved rows can only be fixed by loading the lab files again. The steps are in Start over.', 'Algunas filas guardadas solo se arreglan cargando otra vez los archivos del laboratorio. Los pasos estan en Empezar de nuevo.'),
      cls: darkMode ? 'bg-amber-950/70 text-amber-200 border-amber-700' : 'bg-amber-100 text-amber-900 border-amber-300'
    },
    check: {
      chip: tr('Usable, a few rows need a look', 'Se puede usar, algunas filas necesitan revision'),
      line: tr('The rates are right for the rows loaded. The items below are rows to look at; none of them needs a full re-upload.', 'Los porcentajes son correctos para las filas cargadas. Abajo hay filas para revisar; ninguna necesita volver a subir todo.'),
      cls: darkMode ? 'bg-amber-950/40 text-amber-200 border-amber-800' : 'bg-amber-50 text-amber-900 border-amber-200'
    },
    ok: {
      chip: tr('No problems found', 'Sin problemas'),
      line: tr('Every loaded row was read, and each QA email agrees with the lab rows of its week.', 'Cada fila cargada se leyo y cada correo de QA coincide con las filas del laboratorio de su semana.'),
      cls: darkMode ? 'bg-emerald-950/60 text-emerald-300 border-emerald-800' : 'bg-emerald-50 text-emerald-800 border-emerald-200'
    },
    empty: {
      chip: tr('No lab rows loaded', 'No hay filas del laboratorio cargadas'),
      line: tr('Upload the lab files (CSV) to see rates. QA emails alone give weekly totals only.', 'Suba los archivos del laboratorio (CSV) para ver porcentajes. Los correos de QA solos dan solo totales por semana.'),
