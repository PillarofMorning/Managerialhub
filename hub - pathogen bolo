  // Chunked Bulk Uploader for 18,000+ row files so the browser stays 60fps responsive
  const handleBulkFilesUpload = useCallback((fileList) => {
    const files = Array.from(fileList || []);
    if (files.length === 0) return;

    setBulkProgress({ processed: 0, total: files.length, label: `Reading ${files.length} file(s)...` });
    const readers = files.map(f => new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = () => resolve({ name: f.name, content: String(reader.result || '') });
      reader.onerror = () => resolve({ name: f.name, content: '' });
      reader.readAsText(f);
    }));

    Promise.all(readers).then((results) => {
      // Each file is read with its own header row (columns found by name). An Excel workbook (.xlsx) is not text:
      // it is skipped with a note to save it as CSV first.
      const jobs = [];
      const skippedFiles = [];
      results.forEach(r => {
        const looksBinary = /\.xlsx?$/i.test(r.name) || /^PK\u0003\u0004/.test(r.content) || r.content.indexOf('\u0000') !== -1;
        if (looksBinary) { skippedFiles.push(r.name); return; }
        jobs.push({ name: r.name, lines: r.content.split(/\r?\n/) });
      });
      if (skippedFiles.length > 0) {
        logEvent(`Not read: ${skippedFiles.join(', ')}. Open it in Excel and save as CSV (comma delimited), then upload the CSV.`, 'warn');
      }
      const totalLines = jobs.reduce((n, j) => n + j.lines.length, 0);
      if (totalLines === 0) {
        setBulkProgress(null);
        return;
      }

      const parsedIncoming = [];
      let skippedLines = 0;
      let headerRows = 0;
      let fileIdx = 0;
      let lineIdx = 0;
      let processed = 0;
      let reader = jobs.length > 0 ? createLabLineReader(regexRules, roomAliases) : null;
      const chunkSize = 2500;

      const processNextChunk = () => {
        let budget = chunkSize;
        while (budget > 0 && fileIdx < jobs.length) {
          const job = jobs[fileIdx];
          if (lineIdx < job.lines.length) {
            reader.push(job.lines[lineIdx]);
            lineIdx += 1;
            processed += 1;
            budget -= 1;
          } else {
            reader.rows.forEach(r => parsedIncoming.push(r));
            skippedLines += reader.skipped;
            headerRows += reader.headers;
            fileIdx += 1;
            lineIdx = 0;
            reader = fileIdx < jobs.length ? createLabLineReader(regexRules, roomAliases) : null;
          }
        }
        setBulkProgress({
          processed,
          total: totalLines,
          label: `Reading ${processed.toLocaleString()} / ${totalLines.toLocaleString()} lines...`
        });

        if (fileIdx < jobs.length) {
          window.setTimeout(processNextChunk, 12);
        } else {
          const label = `Bulk Upload (${jobs.map(f => f.name).join(', ')})`;
          const base0 = ledgerRef.current;
          const { ledger: nextLedger, receipt } = ingestRowsWithDeduplication(base0.length > 0 ? base0 : parsedCsv.rows, parsedIncoming, label);
          receipt.skippedLines = skippedLines;
          receipt.headerRows = headerRows;
          receipt.skippedFiles = skippedFiles;
          setHistoricalLedger(prev => (prev === base0 ? nextLedger : ingestRowsWithDeduplication(prev, parsedIncoming, label).ledger));
          saveLedgerToIdb(nextLedger);
          setImportReceipts(prev => [receipt, ...prev.slice(0, 29)]);
          setBulkProgress(null);
          logEvent(
            `Bulk upload done: ${nextLedger.length.toLocaleString()} rows in the ledger (${receipt.addedNew} new, ${receipt.upsertedBlankResult} blank results filled in, ${receipt.duplicatesBlocked} duplicates, ${skippedLines} lines that are not lab rows skipped).`,
            'success'
          );
        }
      };

      processNextChunk();
    });
  }, [regexRules, roomAliases, parsedCsv.rows, logEvent]);

  // Table check re-upload, step 1: clears the lab rows and the lab paste box on this computer (QA emails stay) and keeps
