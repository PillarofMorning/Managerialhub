            {chartDataConfig.series.map((pt, i) => {
              const delta = pt.yoyDelta;
              const absMax = Math.max(0.8, ...chartDataConfig.series.map((s) => Math.abs(s.yoyDelta || 0)));
              const widthPct = delta === null ? 0 : Math.min(48, (Math.abs(delta) / absMax) * 46);
              const isFav = delta !== null && delta <= 0;
              return (
                <div
                  key={`wf_${pt.month}`}
                  onClick={() => setSelectedMonthIdx(i)}
                  style={{ display: 'grid', gridTemplateColumns: '48px 1fr 78px', alignItems: 'center', gap: '8px', cursor: 'pointer', padding: '3px 6px', borderRadius: '6px', background: activePoint && activePoint.month === pt.month ? (darkMode ? '#1e293b' : '#f1f5f9') : 'transparent' }}
                >
                  <span style={{ fontSize: '11px', fontWeight: 800, color: theme.text }}>{pt.month}</span>
                  <div style={{ position: 'relative', height: '14px', background: darkMode ? '#0f172a' : '#f1f5f9', borderRadius: '999px', overflow: 'hidden' }}>
                    <div style={{ position: 'absolute', left: '50%', top: 0, bottom: 0, width: '1px', background: theme.border }} />
                    <div
                      style={{
                        position: 'absolute',
                        top: '2px',
                        bottom: '2px',
                        left: isFav ? `${50 - widthPct}%` : '50%',
                        width: `${delta === null ? 0 : Math.max(2, widthPct)}%`,
                        background: isFav ? '#10b981' : '#d97706',
                        borderRadius: '999px'
                      }}
                    />
                  </div>
                  <span style={{ fontSize: '11px', fontWeight: 800, textAlign: 'right', color: delta === null ? theme.textMuted : (isFav ? '#059669' : '#B45309') }}>
                    {delta === null ? '--' : (delta > 0 ? `+${delta.toFixed(2)}` : `${delta.toFixed(2)}`)}
