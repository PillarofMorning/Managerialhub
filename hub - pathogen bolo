// --- LIVE CURRENT DATE & WEEK HELPERS (Fetches actual system date for Current Week & Last Week) ---
const pad2 = (n) => (n < 10 ? `0${n}` : String(n));

// Today on the plant clock (America/Chicago), per the data contract
function getTodayDateKey() {
  const plant = hubPlantDay(Date.now());
  if (plant) return plant;
  const now = new Date();
  return `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}`;
}

function addDays(dateKey, delta) {
  if (!dateKey || !/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) {
    const fallback = getTodayDateKey();
    const fp = fallback.split('-').map(Number);
    const fd = new Date(fp[0], fp[1] - 1, fp[2], 12, 0, 0);
    fd.setDate(fd.getDate() + (delta || 0));
    return `${fd.getFullYear()}-${pad2(fd.getMonth() + 1)}-${pad2(fd.getDate())}`;
  }
  const parts = dateKey.split('-').map(Number);
  const d = new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0);
  d.setDate(d.getDate() + delta);
  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
}

// Plant weeks run Monday to Sunday (data contract section 5). A week is named by its Monday (hubWeekKey).
function getWeekStart(dateKey) {
  const validKey = (dateKey && /^\d{4}-\d{2}-\d{2}$/.test(dateKey)) ? dateKey : getTodayDateKey();
  return hubWeekKey(validKey);
}

function formatShortDate(dateKey) {
  if (!dateKey || !/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) return dateKey || 'Undated';
  const parts = dateKey.split('-');
  return `${parseInt(parts[1], 10)}/${parseInt(parts[2], 10)}`;
}

function formatFullDate(dateKey) {
  if (!dateKey || !/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) return dateKey || 'Undated';
  const parts = dateKey.split('-');
  return `${parseInt(parts[1], 10)}/${parseInt(parts[2], 10)}/${parts[0]}`;
}

function formatWeekRangeLabel(weekDateKey, includeYear = false) {
  const startKey = getWeekStart(weekDateKey);
  const endKey = addDays(startKey, 6);
  const sp = startKey.split('-').map(Number);
  const ep = endKey.split('-').map(Number);
  const sd = new Date(sp[0], sp[1] - 1, sp[2], 12, 0, 0);
  const ed = new Date(ep[0], ep[1] - 1, ep[2], 12, 0, 0);
  const sMon = sd.toLocaleDateString('en-US', { month: 'short' });
  const eMon = ed.toLocaleDateString('en-US', { month: 'short' });
  const base = `${sMon} ${sd.getDate()} - ${eMon} ${ed.getDate()}`;
  return includeYear ? `${base}, ${ep[0]}` : base;
}

const LIVE_TODAY_DATE_KEY = getTodayDateKey();
const LIVE_CURRENT_WEEK_START = getWeekStart(LIVE_TODAY_DATE_KEY);
const LIVE_LAST_WEEK_START = addDays(LIVE_CURRENT_WEEK_START, -7);
// The latest Friday that has already happened: the day an email item with no date of its own is shown on
const LIVE_LATEST_FRIDAY = addDays(LIVE_CURRENT_WEEK_START, 4) <= LIVE_TODAY_DATE_KEY
  ? addDays(LIVE_CURRENT_WEEK_START, 4)
  : addDays(LIVE_LAST_WEEK_START, 4);
const LIVE_CURRENT_YEAR = parseInt(LIVE_TODAY_DATE_KEY.slice(0, 4), 10) || 2026;

