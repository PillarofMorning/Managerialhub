  const [busy, setBusy] = useState(false);
  const set = (k, v) => setDraft(prev => ({ ...prev, [k]: v }));
  return (
    <div className="space-y-2 pt-1" data-next-step-editor="1">
      <label className="block">
        <span className="block text-[10px] font-black uppercase opacity-75 mb-0.5">{tr('Next step', 'Siguiente paso')}</span>
        <textarea rows={3} value={draft.action} onChange={e => set('action', e.target.value)} className={`w-full rounded-lg border p-2 text-xs ${theme.bgInput}`} />
      </label>
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-1.5">
        <label className="block">
          <span className="block text-[10px] font-black uppercase opacity-75">{tr('Owner', 'Responsable')}</span>
          <input type="text" value={draft.owner} onChange={e => set('owner', e.target.value)} className={`w-full rounded border px-2 py-1 text-[11px] font-bold ${theme.bgInput}`} />
        </label>
        <label className="block">
          <span className="block text-[10px] font-black uppercase opacity-75">{tr('Status', 'Estado')}</span>
          <select value={draft.status} onChange={e => set('status', e.target.value)} className={`w-full rounded border px-1.5 py-1 text-[11px] font-bold ${theme.bgInput}`}>
            {ACTION_STATUS_LIST.map(s => <option key={s} value={s}>{actionStatusWord(s)}</option>)}
          </select>
        </label>
        <label className="block">
          <span className="block text-[10px] font-black uppercase opacity-75">{tr('Priority', 'Prioridad')}</span>
          <select value={draft.priority} onChange={e => set('priority', e.target.value)} className={`w-full rounded border px-1.5 py-1 text-[11px] font-bold ${theme.bgInput}`}>
            {ACTION_PRIORITY_LIST.map(p => <option key={p} value={p}>{actionPriorityWord(p)}</option>)}
          </select>
        </label>
      </div>
      <div className="flex items-center justify-end gap-1.5">
        <button type="button" onClick={onCancel} className={`px-2.5 py-1 rounded-lg text-[11px] font-bold border ${theme.bgSubtle}`}>{tr('Cancel', 'Cancelar')}</button>
        <button
          type="button"
          disabled={busy || !String(draft.action).trim()}
          onClick={async () => {
            setBusy(true);
            try { await onSave(draft); } finally { setBusy(false); }
          }}
          className="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-[11px] font-black bg-[#00468B] text-white hover:bg-[#0072CE] disabled:opacity-50"
        >
          <SaveIcon className="w-3 h-3" />
          <span>{busy ? tr('Saving...', 'Guardando...') : (saveLabel || tr('Save', 'Guardar'))}</span>
        </button>
      </div>
    </div>
  );
}

// Every saved next step, edited one at a time with its own Save, and a form to add one for a site
function NextStepsManager({ darkMode, theme, suggestedActionsMap, onSaveSuggestedAction, onClose }) {
  const [editingId, setEditingId] = useState('');
  const [note, setNote] = useState(null);
  const [adding, setAdding] = useState(false);
  const [newSite, setNewSite] = useState({ room: 'WJ', siteCode: '', title: '' });
  const list = Object.keys(suggestedActionsMap || {}).map(k => suggestedActionsMap[k]).filter(Boolean)
    .sort((a, b) => String(b.updatedAt || '').localeCompare(String(a.updatedAt || '')));
  const report = (res, what) => setNote(res && res.mode === 'dataverse'
    ? { tone: 'done', text: tr(`Saved: ${what}.`, `Guardado: ${what}.`) }
    : { tone: 'act', text: tr(`Saved on this computer only, not in Dataverse${res && res.note ? ` (${res.note})` : ''}: ${what}.`, `Guardado solo en esta computadora, no en Dataverse${res && res.note ? ` (${res.note})` : ''}: ${what}.`) });
  return localizeReactTree((
    <div className="fixed inset-0 bg-slate-950/70 z-50 flex items-center justify-center p-4" onClick={onClose}>
      <div role="dialog" aria-modal="true" aria-label={tr('Saved next steps', 'Siguientes pasos guardados')} data-next-steps-manager="1" className={`w-full max-w-3xl max-h-[88vh] rounded-2xl border shadow-2xl flex flex-col overflow-hidden ${theme.bgCard}`} onClick={e => e.stopPropagation()}>
        <div className={`px-5 py-3 border-b flex items-center justify-between gap-3 ${theme.border}`}>
          <div>
            <h3 className={`text-base font-black ${theme.textHeading}`}>{tr(`Saved next steps (${list.length})`, `Siguientes pasos guardados (${list.length})`)}</h3>
            <p className={`text-xs ${theme.textMuted}`}>{tr('Saved in Hub config, key PATHOGEN_BOLO_SUGGESTED_ACTIONS. Each one is saved only when you press its Save.', 'Se guardan en Hub config, clave PATHOGEN_BOLO_SUGGESTED_ACTIONS. Cada uno se guarda solo cuando presiona su Guardar.')}</p>
          </div>
          <button type="button" onClick={onClose} aria-label={tr('Close', 'Cerrar')} className="p-1.5 rounded-lg hover:bg-slate-500/10"><XIcon className="w-4 h-4" /></button>
        </div>
        <div className="p-5 overflow-y-auto space-y-3 flex-1">
          {note && (
            <div className="flex items-center gap-2 text-xs font-bold" data-save-note={note.tone}>
              <ToneChip tone={note.tone} darkMode={darkMode} solid>{note.tone === 'done' ? tr('Saved', 'Guardado') : tr('Not saved', 'No guardado')}</ToneChip>
              <span>{note.text}</span>
            </div>
          )}
          {adding ? (
            <div className={`rounded-xl border p-3 space-y-2 ${theme.bgSubtle}`}>
              <div className="text-xs font-black">{tr('A next step for one site', 'Un siguiente paso para un sitio')}</div>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <label className="block">
                  <span className="block text-[10px] font-black uppercase opacity-75">{tr('Room', 'Cuarto')}</span>
                  <select value={newSite.room} onChange={e => setNewSite(p => ({ ...p, room: e.target.value }))} className={`w-full rounded border px-2 py-1 text-xs font-bold ${theme.bgInput}`}>
                    {Object.keys(ROOM_META).map(rk => <option key={rk} value={rk}>{ROOM_META[rk].label}</option>)}
                  </select>
                </label>
                <label className="block">
                  <span className="block text-[10px] font-black uppercase opacity-75">{tr('Site code', 'Codigo de sitio')}</span>
                  <input type="text" value={newSite.siteCode} onChange={e => setNewSite(p => ({ ...p, siteCode: e.target.value }))} placeholder="0320-" className={`w-full rounded border px-2 py-1 text-xs font-mono font-bold ${theme.bgInput}`} />
                </label>
                <label className="block">
                  <span className="block text-[10px] font-black uppercase opacity-75">{tr('Title', 'Titulo')}</span>
                  <input type="text" value={newSite.title} onChange={e => setNewSite(p => ({ ...p, title: e.target.value }))} className={`w-full rounded border px-2 py-1 text-xs font-bold ${theme.bgInput}`} />
                </label>
              </div>
              <NextStepEditor
                theme={theme}
                initial={{ owner: '', status: 'Open', priority: 'High' }}
                onCancel={() => setAdding(false)}
                onSave={async (draft) => {
                  const code = String(newSite.siteCode || '').trim();
                  // A site's next step is saved under the site code itself, so the site's alerts and its Sites page find it
                  const id = code || `custom-${normToken(newSite.room).replace(/ /g, '-')}-${Date.now().toString().slice(-6)}`;
                  const title = String(newSite.title || '').trim() || code || newSite.room;
                  const res = await onSaveSuggestedAction(id, { id, siteCode: code, room: newSite.room, title, action: draft.action, owner: draft.owner, status: draft.status, priority: draft.priority });
                  report(res, title);
                  setAdding(false);
                  setNewSite({ room: 'WJ', siteCode: '', title: '' });
                }}
              />
            </div>
          ) : (
            <button type="button" onClick={() => setAdding(true)} className={`inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-black border ${theme.bgSubtle} hover:border-[#0072CE]`}>
              <PlusIcon className="w-3.5 h-3.5" /> {tr('Add a next step for a site', 'Agregar un siguiente paso para un sitio')}
            </button>
          )}
          {list.length === 0 && <div className={`text-xs ${theme.textMuted}`}>{tr('No next steps saved yet. Each alert shows its default next step until one is saved.', 'Aun no hay siguientes pasos guardados. Cada alerta muestra su siguiente paso de siempre hasta que se guarde uno.')}</div>}
          {list.map(item => (
            <div key={item.id} className={`rounded-xl border p-3 space-y-1.5 ${theme.bgSubtle}`} data-saved-step={item.id}>
              <div className="flex flex-wrap items-center justify-between gap-2">
                <div className="flex flex-wrap items-center gap-1.5 min-w-0">
                  <ToneChip tone={actionStatusTone(item.status)} darkMode={darkMode}>{actionStatusWord(item.status || 'Open')}</ToneChip>
                  {item.room && <span className="text-[11px] font-black">{roomShortOf(item.room)}</span>}
                  {item.siteCode && <span className="text-[11px] font-mono font-bold">{item.siteCode}</span>}
                  <span className="text-xs font-black truncate">{item.title || item.id}</span>
                </div>
                <span className={`text-[10px] font-mono ${theme.textMuted}`}>{tr('Saved', 'Guardado')} {String(item.updatedAt || '').slice(0, 10)}{item.updatedBy ? ` | ${item.updatedBy}` : ''}</span>
              </div>
              {editingId === item.id ? (
                <NextStepEditor
                  theme={theme}
                  initial={item}
                  onCancel={() => setEditingId('')}
                  onSave={async (draft) => {
                    const res = await onSaveSuggestedAction(item.id, { ...item, action: draft.action, owner: draft.owner, status: draft.status, priority: draft.priority });
                    report(res, item.title || item.id);
                    setEditingId('');
                  }}
                />
              ) : (
                <div className="flex flex-wrap items-start justify-between gap-2">
                  <div className="text-xs min-w-0">
                    <div className="font-semibold">{item.action}</div>
                    <div className={`text-[10px] ${theme.textMuted}`}>{tr('Owner', 'Responsable')}: {item.owner || '--'} | {tr('Priority', 'Prioridad')}: {actionPriorityWord(item.priority)}</div>
                  </div>
                  <button type="button" onClick={() => setEditingId(item.id)} className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-black border ${theme.bgCard} hover:border-[#0072CE]`}>
                    <EditIcon className="w-3 h-3" /> {tr('Edit', 'Editar')}
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  ), ACTIVE_UI_LANG);
}

function AlertsPanel({ darkMode, theme, pressureAnalysis, rules, canEdit, suggestedActionsMap, onSaveSuggestedAction, onOpenSite, onLocateOnMap, onFocusInCalendar }) {
  const [editingId, setEditingId] = useState('');
  const [managerOpen, setManagerOpen] = useState(false);
  const [note, setNote] = useState(null);
  const repeatDays = normalizeBoloRules(rules).repeatDays;
  const points = ((pressureAnalysis && pressureAnalysis.points) || []).slice().sort((a, b) => (
    (ALERT_URGENCY_ORDER[alertUrgencyOf(a)] - ALERT_URGENCY_ORDER[alertUrgencyOf(b)]) || (b.score - a.score)
  ));
  const counts = { act: 0, watch: 0 };
  points.forEach(pp => { const u = alertUrgencyOf(pp); if (counts[u] !== undefined) counts[u] += 1; });
  const btn = `inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-bold border ${theme.bgCard} hover:border-[#0072CE]`;
  return localizeReactTree((
    <div className={`rounded-xl border p-4 shadow-xs ${theme.bgCard}`} data-alerts-panel={points.length}>
      <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <h3 className={`text-sm font-black ${theme.textHeading}`}>{tr('Alerts', 'Alertas')}</h3>
          <p className={`text-[11px] ${theme.textMuted}`}>
            {tr(`Since ${formatShortDate(pressureAnalysis.alertSince)} (the alert window), most urgent first. Older positives are history: calendar and charts.`, `Desde el ${formatShortDate(pressureAnalysis.alertSince)} (la ventana de alertas), lo mas urgente primero. Los positivos mas antiguos son historial: calendario y graficas.`)}
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-1.5">
          {counts.act > 0 && <ToneChip tone="act" darkMode={darkMode} solid>{tr(`${counts.act} act now`, `${counts.act} actuar ya`)}</ToneChip>}
          {counts.watch > 0 && <ToneChip tone="watch" darkMode={darkMode} solid>{tr(`${counts.watch} watch`, `${counts.watch} vigilar`)}</ToneChip>}
          {canEdit && (
            <button type="button" onClick={() => setManagerOpen(true)} className={btn}>
              <EditIcon className="w-3.5 h-3.5" /> {tr(`Saved next steps (${Object.keys(suggestedActionsMap || {}).length})`, `Siguientes pasos guardados (${Object.keys(suggestedActionsMap || {}).length})`)}
            </button>
          )}
        </div>
      </div>
      {note && (
        <div className="mb-2 flex items-center gap-2 text-xs font-bold" data-save-note={note.tone}>
          <ToneChip tone={note.tone} darkMode={darkMode} solid>{note.tone === 'done' ? tr('Saved', 'Guardado') : tr('Not saved', 'No guardado')}</ToneChip>
          <span>{note.text}</span>
        </div>
      )}
      {points.length === 0 ? (
        <div className={`text-xs ${theme.textMuted}`} data-no-alerts="1">
          {tr(`No alerts since ${formatShortDate(pressureAnalysis.alertSince)}: no repeat sites, failed retests, room clusters or rates up against last year.`, `No hay alertas desde el ${formatShortDate(pressureAnalysis.alertSince)}: ni sitios repetidos, re-pruebas fallidas, grupos en un cuarto o porcentajes arriba contra el ano pasado.`)}
        </div>
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-3">
          {points.map(pp => {
            const u = alertUrgencyOf(pp);
            const tone = u === 'info' ? 'plain' : u;
            const editing = editingId === pp.id;
            return (
              <div key={pp.id} data-alert={pp.kind || ''} data-urgency={u} className={`rounded-xl border border-l-4 p-3 flex flex-col gap-1.5 ${theme.bgSubtle}`} style={{ borderLeftColor: (BOLO_TONES[tone] || BOLO_TONES.plain).hex }}>
                <div className="flex flex-wrap items-center gap-1.5">
                  <ToneChip tone={tone} darkMode={darkMode} solid>{alertUrgencyWord(u)}</ToneChip>
                  <span className="text-[11px] font-black">{alertKindWord(pp.kind)}</span>
                  {pp.since && <span className={`text-[10px] font-mono ${theme.textMuted}`} data-alert-since={pp.since}>{tr(`since ${formatShortDate(pp.since)}`, `desde el ${formatShortDate(pp.since)}`)}</span>}
                  {pp.hasCustomAction && <ToneChip tone={actionStatusTone(pp.actionStatus)} darkMode={darkMode}>{actionStatusWord(pp.actionStatus)}</ToneChip>}
                </div>
                <div className="text-sm font-black leading-snug">{alertTitleOf(pp)}</div>
                <div className={`text-xs ${theme.textMuted}`}>{alertWhyOf(pp, repeatDays)}</div>
                <div className={`rounded-lg border p-2 text-xs ${theme.bgCard}`}>
                  <div className="flex flex-wrap items-center justify-between gap-1 mb-0.5">
                    <span className="text-[10px] font-black uppercase tracking-wider">{tr('Next step', 'Siguiente paso')}</span>
                    {canEdit && !editing && (
                      <button type="button" onClick={() => setEditingId(pp.id)} className="inline-flex items-center gap-1 text-[10px] font-black underline">
                        <EditIcon className="w-3 h-3" /> {tr('Edit', 'Editar')}
                      </button>
                    )}
                  </div>
                  {editing ? (
                    <NextStepEditor
                      theme={theme}
                      initial={pp.hasCustomAction
                        ? { action: pp.action, owner: pp.actionOwner, status: pp.actionStatus, priority: pp.actionPriority }
                        : { action: alertNextStepOf(pp.kind), owner: '', status: 'Open', priority: u === 'act' ? 'High' : 'Elevated' }}
                      onCancel={() => setEditingId('')}
                      onSave={async (draft) => {
                        const res = await onSaveSuggestedAction(pp.id, { id: pp.id, siteCode: pp.siteCode, room: pp.room, title: pp.title, action: draft.action, owner: draft.owner, status: draft.status, priority: draft.priority });
                        setNote(res && res.mode === 'dataverse'
                          ? { tone: 'done', text: tr(`Next step saved for ${alertTitleOf(pp)}.`, `Siguiente paso guardado para ${alertTitleOf(pp)}.`) }
                          : { tone: 'act', text: tr(`Saved on this computer only, not in Dataverse${res && res.note ? ` (${res.note})` : ''}.`, `Guardado solo en esta computadora, no en Dataverse${res && res.note ? ` (${res.note})` : ''}.`) });
                        setEditingId('');
                      }}
                    />
                  ) : (
                    <>
                      <div className="font-semibold leading-snug">{pp.hasCustomAction ? pp.action : alertNextStepOf(pp.kind)}</div>
                      {pp.hasCustomAction && (
                        <div className={`mt-0.5 text-[10px] ${theme.textMuted}`}>
                          {tr('Owner', 'Responsable')}: {pp.actionOwner || '--'}{pp.actionUpdatedAt ? ` | ${tr('saved', 'guardado')} ${String(pp.actionUpdatedAt).slice(0, 10)}${pp.actionUpdatedBy ? ` ${tr('by', 'por')} ${pp.actionUpdatedBy}` : ''}` : ''}
                        </div>
                      )}
                    </>
                  )}
                </div>
                <div className="flex flex-wrap gap-1.5 pt-0.5">
                  {pp.siteCode && typeof onOpenSite === 'function' && (
                    <button type="button" className={btn} onClick={() => onOpenSite(pp.siteCode)}>{tr('Open the site', 'Abrir el sitio')}</button>
                  )}
                  {(pp.siteCode || pp.room) && (
                    <button type="button" className={btn} onClick={() => onLocateOnMap(pp.kind === 'repeat' || pp.kind === 'retest' ? { siteCode: pp.siteCode, room: pp.room, description: (pp.data && pp.data.description) || '' } : { room: pp.room })}>
                      <MapPinIcon className="w-3 h-3" /> {tr('Show on map', 'Ver en el mapa')}
                    </button>
                  )}
                  {pp.room && (
                    <button type="button" className={btn} onClick={() => onFocusInCalendar({ room: pp.room, date: pp.since, mode: '1w' })}>
                      <CalendarIcon className="w-3 h-3" /> {tr('Calendar', 'Calendario')}
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
      {managerOpen && (
        <NextStepsManager darkMode={darkMode} theme={theme} suggestedActionsMap={suggestedActionsMap} onSaveSuggestedAction={onSaveSuggestedAction} onClose={() => setManagerOpen(false)} />
      )}
    </div>
  ), ACTIVE_UI_LANG);
}

// ---------- Trends: four headline numbers ----------
function TargetChip({ rate, target, darkMode }) {
  if (rate === null || rate === undefined) return <ToneChip tone="unknown" darkMode={darkMode}>{tr('No swabs', 'Sin hisopos')}</ToneChip>;
  if (typeof target !== 'number') return null;
  return rate > target
    ? <ToneChip tone="watch" darkMode={darkMode} title={tr(`Target ${target.toFixed(1)}%`, `Meta ${target.toFixed(1)}%`)}>{tr('Above target', 'Arriba de la meta')}</ToneChip>
    : <ToneChip tone="done" darkMode={darkMode} title={tr(`Target ${target.toFixed(1)}%`, `Meta ${target.toFixed(1)}%`)}>{tr('Within target', 'Dentro de la meta')}</ToneChip>;
}
function LastYearChip({ rate, lyRate, darkMode }) {
  if (rate === null || rate === undefined || lyRate === null || lyRate === undefined) return null;
  const d = round2(rate - lyRate);
  if (d > 0) return <ToneChip tone="watch" darkMode={darkMode}>{tr(`Higher than last year (+${d})`, `Mas alto que el ano pasado (+${d})`)}</ToneChip>;
  return <ToneChip tone="done" darkMode={darkMode}>{tr(`Not higher than last year (${d})`, `No mas alto que el ano pasado (${d})`)}</ToneChip>;
}
function TrendsHeadlineTiles({ darkMode, theme, pressureAnalysis, open, rules }) {
  const R = normalizeBoloRules(rules);
  const em = (pressureAnalysis && pressureAnalysis.executiveMetrics) || {};
  const cat = (k) => ((em.byCategory && em.byCategory[k] && em.byCategory[k].overall) || {});
  const p = cat('pathogen');
  const a = cat('apc');
  const t = cat('atp');
  const tile = `min-w-0 rounded-xl border p-3 flex flex-col gap-1.5 ${theme.bgCard}`;
  const label = `text-[11px] font-black uppercase tracking-wider ${theme.textMuted}`;
  const ofText = (o) => (o.totalSwabs > 0 ? tr(`${o.positives} of ${o.totalSwabs} swabs`, `${o.positives} de ${o.totalSwabs} hisopos`) : tr('no finished swabs', 'sin hisopos terminados'));
  const ind = (name, o, target) => (
    <div className="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5" data-tile-indicator={name}>
      <span className="text-xs font-black w-9">{name}</span>
      <span className="text-lg font-black font-mono">{fmtPct(o.thisYearRate)}</span>
      <span className={`text-[10px] ${theme.textMuted}`}>{ofText(o)}</span>
      <TargetChip rate={o.thisYearRate} target={target} darkMode={darkMode} />
    </div>
  );
  return localizeReactTree((
    <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3" data-headline-tiles="1">
      <div className={tile} data-tile="pathogen">
        <span className={label}>{tr(`Pathogen, ${em.thisYearLabel || LIVE_CURRENT_YEAR} to date`, `Patogenos, ${em.thisYearLabel || LIVE_CURRENT_YEAR} a la fecha`)}</span>
        <div className="flex flex-wrap items-baseline gap-1.5">
          <span className="text-2xl font-black font-mono">{fmtPct(p.thisYearRate)}</span>
          <span className={`text-[11px] ${theme.textMuted}`}>{ofText(p)}</span>
        </div>
        <div className="flex flex-wrap gap-1">
          <TargetChip rate={p.thisYearRate} target={R.targets.pathogen} darkMode={darkMode} />
          <LastYearChip rate={p.thisYearRate} lyRate={p.lastYearRate} darkMode={darkMode} />
        </div>
        <span className={`text-[10px] ${theme.textMuted}`}>{tr(`Target ${R.targets.pathogen.toFixed(1)}%. Same dates last year: ${fmtPct(p.lastYearRate)}.`, `Meta ${R.targets.pathogen.toFixed(1)}%. Mismas fechas el ano pasado: ${fmtPct(p.lastYearRate)}.`)}</span>
      </div>
      <div className={tile} data-tile="indicators">
        <span className={label}>{tr('APC and ATP fail rates', 'Porcentaje de fallas APC y ATP')}</span>
        {ind('APC', a, R.targets.apc)}
        {ind('ATP', t, R.targets.atp)}
        <span className={`text-[10px] ${theme.textMuted}`}>{tr(`Targets ${R.targets.apc.toFixed(1)}% and ${R.targets.atp.toFixed(1)}%. A lab number is a pass.`, `Metas ${R.targets.apc.toFixed(1)}% y ${R.targets.atp.toFixed(1)}%. Un numero del laboratorio es un pase.`)}</span>
      </div>
      <div className={tile} data-tile="open">
        <span className={label}>{tr('Open positives', 'Positivos abiertos')}</span>
        <div className="flex flex-wrap items-baseline gap-1.5">
          <span className="text-2xl font-black font-mono">{open ? open.openCount : 0}</span>
          {open && open.openCount > 0
            ? <ToneChip tone={open.tone} darkMode={darkMode} solid>{open.overdueCount > 0 ? tr(`${open.overdueCount} overdue`, `${open.overdueCount} atrasado(s)`) : tr('Open', 'Abierto')}</ToneChip>
            : <ToneChip tone="done" darkMode={darkMode} solid>{tr('None open', 'Ninguno abierto')}</ToneChip>}
        </div>
        <span className={`text-[10px] ${theme.textMuted}`}>
          {open && open.oldest
