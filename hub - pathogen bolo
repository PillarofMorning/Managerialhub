  // The equipment and MSS area ids go in craa5_equipmentguids / craa5_mssareaguid when known; a column the table does
  // not have yet is dropped from the save (upsertFacilityObservationRecord).
  const pushHitToDataverseObservation = useCallback(async (hit) => {
