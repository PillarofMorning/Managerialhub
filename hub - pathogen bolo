  const [selectFeaturesModalOpen, setSelectFeaturesModalOpen] = useState(false);
  const [bypassUserPrefFilter, setBypassUserPrefFilter] = useState(false);

  // --- DATAVERSE LIVE STATE, ERROR LOGGING & MICROSOFT ID ACCESS TRACKING ---
  const [logs, setLogs] = useState(() => readStorage(STORAGE_KEYS.errorLog, []));
  useEffect(() => { writeStorage(STORAGE_KEYS.errorLog, logs.slice(-120)); }, [logs]);
  const [debugOpen, setDebugOpen] = useState(false);
  const logEvent = useCallback((message, type = 'info', payload = null) => {
    setLogs(prev => [...prev.slice(-119), {
      id: `log-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
      time: new Date().toLocaleTimeString(),
      iso: new Date().toISOString(),
      message: String(message || ''),
      type,
      payload
    }]);
  }, []);

  // Capture any uncaught window errors or unhandled promise rejections into the Dev Console error logs
  useEffect(() => {
    if (typeof window === 'undefined') return undefined;
    const onErr = (ev) => {
      const msg = ev && ev.message ? ev.message : 'Runtime script error';
      const loc = ev && ev.filename ? `${ev.filename}:${ev.lineno || 0}` : 'window.onerror';
      logEvent(`Runtime Error: ${msg} (${loc})`, 'error', { stack: ev && ev.error && ev.error.stack ? ev.error.stack : null });
    };
    const onRej = (ev) => {
      const reason = ev && ev.reason ? (ev.reason.message || String(ev.reason)) : 'Unhandled Promise Rejection';
      logEvent(`Unhandled Promise Rejection: ${reason}`, 'error');
    };
    window.addEventListener('error', onErr);
    window.addEventListener('unhandledrejection', onRej);
    return () => {
      window.removeEventListener('error', onErr);
      window.removeEventListener('unhandledrejection', onRej);
    };
  }, [logEvent]);

  const [msIdentityOverride, setMsIdentityOverride] = useState(() => readStorage(STORAGE_KEYS.msIdentityOverride, null));
  useEffect(() => { writeStorage(STORAGE_KEYS.msIdentityOverride, msIdentityOverride); }, [msIdentityOverride]);

  const [msIdentity, setMsIdentity] = useState(() => readSyncMicrosoftIdentity(msIdentityOverride));
  useEffect(() => {
    setMsIdentity(readSyncMicrosoftIdentity(msIdentityOverride));
  }, [msIdentityOverride]);

  const isDevAuthorized = useMemo(() => {
    setBoloAdminMsIds(userProfilesRegistry);
    return isDevMicrosoftIdentity(msIdentity);
  }, [msIdentity, userProfilesRegistry]);

  // Resolve active user's effective JSON profile & view preferences whenever msIdentity or userProfilesRegistry changes
  const activeUserProfile = useMemo(
    () => resolveUserEffectiveProfile(msIdentity, userProfilesRegistry),
    [msIdentity, userProfilesRegistry]
  );

  const [accessLog, setAccessLog] = useState(() => {
    const saved = readStorage(STORAGE_KEYS.accessLog, null);
    return Array.isArray(saved) && saved.length > 0 ? saved : DEFAULT_ACCESS_LOG_SEED;
  });
  useEffect(() => { writeStorage(STORAGE_KEYS.accessLog, accessLog.slice(0, 150)); }, [accessLog]);

  const recordAccessSession = useCallback((identityObj, actionNote, tabName) => {
    const ident = identityObj || msIdentity;
    if (!ident) return;
    const now = new Date();
    const entry = {
      id: `acc-${now.getTime()}-${Math.floor(Math.random() * 900 + 100)}`,
      timestampIso: now.toISOString(),
      timestampLabel: now.toLocaleString(),
      microsoftId: ident.microsoftId || '',
      userName: ident.userName || '',
      email: ident.email || '',
      domainAccount: ident.domainAccount || (ident.microsoftId || ''),
      role: ident.isDev ? 'System Administrator / Dev Architect' : (activeUserProfile.profileName || 'FSQ Operator (Weekly View)'),
      authSource: ident.source || 'Microsoft Corporate Session',
      tabVisited: tabName || 'calendar',
      actionSummary: actionNote || 'Opened Pathogen BOLO App & verified Microsoft ID'
    };
    setAccessLog(prev => {
      const list = Array.isArray(prev) ? prev : [];
      if (list.length > 0) {
        const latest = list[0];
        const ageMs = now.getTime() - (Date.parse(latest.timestampIso || '') || 0);
        if (latest.microsoftId === entry.microsoftId && ageMs >= 0 && ageMs < 180000 && !actionNote) {
          return list;
        }
      }
      return [entry, ...list.slice(0, 149)];
    });
  }, [msIdentity, activeUserProfile.profileName]);

  const [maps, setMaps] = useState([]);
  const [mapId, setMapId] = useState(null);
  const [liveMapImage, setLiveMapImage] = useState(null);
  const [blueprintImage, setBlueprintImage] = useState(null);
  const [useBlueprintFallback, setUseBlueprintFallback] = useState(false);
  const [placedAssets, setPlacedAssets] = useState([]);
  const [syncBusy, setSyncBusy] = useState(false);
  const [syncStatus, setSyncStatus] = useState('');

  const [mapFocusTarget, setMapFocusTarget] = useState(null);
  const focusSeq = useRef(0);

  // Calendar External Navigation Target (when jumping from Dashboard or Archive to a specific week)
  const [calendarJumpDate, setCalendarJumpDate] = useState(null);

  useEffect(() => {
    const bp = generateStillwellBlueprintDataUrl();
    if (bp) setBlueprintImage(bp);
  }, []);

  // Load 18k historical ledger from IndexedDB on mount if previously saved
  useEffect(() => {
    let alive = true;
    loadLedgerFromIdb().then(loadedRows => {
      const isDemoRow = (r) => {
        const m = /^\d\d-(\d{6})-\d\d$/.exec(String((r && r.sampleId) || ''));
        if (!m) return false;
        const n = parseInt(m[1], 10);
        return n >= 400000 && n <= 521400 && (n - 400000) % 120 === 0 && r.program === 'Daily/Weekly Listeria';
      };
      let savedRows = Array.isArray(loadedRows) ? loadedRows.filter(r => !isDemoRow(r)) : loadedRows;
      if (Array.isArray(loadedRows) && savedRows.length !== loadedRows.length) {
        saveLedgerToIdb(savedRows);
        logEvent(`Removed ${(loadedRows.length - savedRows.length).toLocaleString()} demo rows left by the old 18k generator.`, 'warn');
      }
      // Rows saved before v2.3 are read again with the v2.3 rules (once; the Import check shows what changed)
      if (Array.isArray(savedRows) && savedRows.some(r => r && r.v !== 23)) {
        const cleaned = cleanSavedLedgerV23(
          savedRows,
          { ...DEFAULT_REGEX_RULES, ...(readStorage(STORAGE_KEYS.regexRules, {}) || {}) },
          { ...DEFAULT_ROOM_ALIASES, ...(readStorage(STORAGE_KEYS.roomAliases, {}) || {}) }
        );
        savedRows = cleaned.rows;
        saveLedgerToIdb(savedRows);
        writeStorage(LEDGER_CLEANUP_REPORT_KEY, cleaned.report);
        if (alive) setLedgerCleanupReport(cleaned.report);
        logEvent(`v2.3 check of the saved ledger: ${cleaned.report.removedExample} example rows removed, ${cleaned.report.mergedTests} rows with two tests marked for re-upload, ${cleaned.report.changedResult} results read again.`, 'warn');
      }
      if (alive && Array.isArray(savedRows) && savedRows.length > 0) {
        setHistoricalLedger(savedRows);
        logEvent(`Restored ${savedRows.length.toLocaleString()} historical swab samples from IndexedDB ledger.`, 'success');
      }
    });
    return () => { alive = false; };
  }, [logEvent]);

  // Attempt live Dataverse connection + Microsoft WhoAmI + Access Log + Suggested Actions + Harborage + User Profiles sync on mount
  useEffect(() => {
    let alive = true;
    const initDataverse = async () => {
      const initialIdent = readSyncMicrosoftIdentity(msIdentityOverride);
      recordAccessSession(initialIdent, 'App session initialized (Microsoft ID read)', 'calendar');
      logEvent(`Microsoft ID recognized: ${initialIdent.microsoftId} (${initialIdent.userName}) via ${initialIdent.source}.`, 'info');
      logEvent('Initializing Pathogen BOLO Dataverse connection...', 'info');

      // 1. Live Dataverse WhoAmI + systemusers lookup if hosted in Power Apps / Dataverse
      try {
        const whoRes = await fetch(apiUrl('WhoAmI'), { headers: ODATA_HEADERS });
        if (whoRes.ok) {
          const whoData = await whoRes.json();
          const sysUserId = String(whoData.UserId || '').replace(/[{}]/g, '');
          if (sysUserId) {
            const uRes = await fetch(apiUrl(`systemusers(${sysUserId})?$select=fullname,internalemailaddress,domainname,azureactivedirectoryobjectid,title`), { headers: ODATA_HEADERS });
            if (uRes.ok) {
              const uData = await uRes.json();
              const rawDomain = String(uData.domainname || uData.internalemailaddress || '');
              const extractedMsId = /u\d{6,8}/i.test(rawDomain)
                ? rawDomain.match(/u\d{6,8}/i)[0].toUpperCase()
                : (rawDomain.split('@')[0] || '').toUpperCase();
              const liveRoles = [];
              try {
                const rRes = await fetch(apiUrl(`systemusers(${sysUserId})/systemuserroles_association?$select=name`), { headers: ODATA_HEADERS });
                if (rRes.ok) {
                  const rData = await rRes.json();
                  (rData.value || []).forEach(r => { if (r && r.name) liveRoles.push(r.name); });
                }
              } catch (_e) { /* roles unreadable: no admin rights */ }
              const liveIdentity = {
                microsoftId: extractedMsId,
                systemUserId: sysUserId,
                aadObjectId: String(uData.azureactivedirectoryobjectid || sysUserId),
                userName: uData.fullname || initialIdent.userName,
                email: uData.internalemailaddress || initialIdent.email,
                domainAccount: uData.domainname || initialIdent.domainAccount,
                roles: liveRoles,
                source: 'Dataverse OData WhoAmI + systemusers'
              };
              liveIdentity.isDev = isDevMicrosoftIdentity(liveIdentity);
              if (alive && !msIdentityOverride) {
                setMsIdentity(liveIdentity);
                try { window.localStorage.setItem('stillwell_active_ms_user_v1', JSON.stringify(liveIdentity)); } catch (_e) { /* ignore */ }
                recordAccessSession(liveIdentity, 'Verified live Dataverse WhoAmI session', 'calendar');
                logEvent(`Verified live Dataverse identity: ${liveIdentity.userName} (${liveIdentity.microsoftId}).`, 'success');
              }
            }
          }
        }
      } catch (e) { /* standalone mode */ }

      // 2. Load shared settings (Access Log, Suggested Actions, Harborage Concerns, User Profiles, Facility Areas) from
      // Hub config: the new _e_ table first, the old _0_ one second (boloReadConfigs)
      try {
        const cfg = await boloReadConfigs();
        const keys = Object.keys(cfg.values);
        if (cfg.tables.length > 0) {
          keys.forEach(key => {
            const raw = cfg.values[key];
            try {
              const parsed = JSON.parse(raw);
              if (key === 'PATHOGEN_BOLO_ACCESS_LOG' && parsed && Array.isArray(parsed.entries)) {
                if (alive) {
                  setAccessLog(prev => {
                    const seenIds = {};
                    const merged = [];
                    prev.concat(parsed.entries).forEach(item => {
                      if (item && item.id && !seenIds[item.id]) {
                        seenIds[item.id] = true;
                        merged.push(item);
                      }
                    });
                    merged.sort((a, b) => String(b.timestampIso || '').localeCompare(String(a.timestampIso || '')));
                    return merged.slice(0, 150);
                  });
                }
              } else if (key === 'PATHOGEN_BOLO_SUGGESTED_ACTIONS' && parsed && parsed.actions) {
                if (alive) setSuggestedActionsMap(prev => ({ ...prev, ...parsed.actions }));
              } else if (key === 'PATHOGEN_BOLO_HARBORAGE_CONCERNS' && parsed && Array.isArray(parsed.concerns)) {
                if (alive && parsed.concerns.length > 0) setHarborageConcerns(parsed.concerns);
              } else if (key === 'PATHOGEN_BOLO_USER_PROFILES_JSON' && parsed && parsed.users) {
                if (alive) {
                  setUserProfilesRegistry(prev => {
                    const mergedRoles = {
                      ...DEFAULT_ROLE_PROFILES_MAP,
                      ...(prev.roles || {}),
                      ...(prev.profiles || {}),
                      ...(parsed.roles || {}),
                      ...(parsed.profiles || {})
                    };
                    return {
                      ...prev,
                      ...parsed,
                      roles: mergedRoles,
                      profiles: mergedRoles,
                      users: { ...prev.users, ...(parsed.users || {}) }
                    };
                  });
                }
              } else if (key === 'PATHOGEN_BOLO_CONFIG' && parsed) {
                if (alive) {
                  if (parsed.facilityAreas) setFacilityAreas(normalizeFacilityAreasList(parsed.facilityAreas));
                  if (parsed.suggestedActionsMap) setSuggestedActionsMap(prev => ({ ...prev, ...parsed.suggestedActionsMap }));
                }
              }
            } catch (err) { /* ignore malformed json */ }
          });
          if (keys.length > 0) {
            logEvent(`Loaded ${keys.length} Pathogen BOLO setting(s) from Hub config (${cfg.tables.join(', ')}).`, 'success');
          }
        }
      } catch (e) { /* standalone mode */ }

      try {
        const res = await fetch(apiUrl(`${DATAVERSE_MAPS_TABLE}?$select=craa5___mapsid,craa5_facility&$orderby=createdon asc`), { headers: ODATA_HEADERS });
        if (res.ok) {
          const data = await res.json();
          const list = (data.value || []).map((r, i) => ({
            id: r.craa5___mapsid,
            code: String(r.craa5_facility || '').trim() || (i === 0 ? 'MAIN' : `MAP${i + 1}`),
            label: String(r.craa5_facility || '').trim() || (i === 0 ? 'Main Facility Map' : `Map ${i + 1}`)
          })).filter(m => m.id);
          if (alive && list.length > 0) {
            setMaps(list);
            setMapId(list[0].id);
            logEvent(`Loaded ${list.length} facility map(s) from Dataverse (${DATAVERSE_MAPS_TABLE}).`, 'success');
          }
        }
      } catch (e) {
        logEvent(`Standalone / Blueprint mode active (${e.message}).`, 'info');
