    logEvent(
      `${sourceLabel}: ${receipt.scanned} rows read: ${receipt.addedNew} new, ${receipt.upsertedBlankResult} blank results completed, ${receipt.duplicatesBlocked} duplicates, ${receipt.conflictsUpgraded} with two different results${parsed.skipped ? `, ${parsed.skipped} lines that are not lab rows skipped` : ''}.`,
