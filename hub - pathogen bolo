                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {/* =================================================================
            MODULE 3: WHO HAS ACCESSED THE APP AND WHEN (ACCESS AUDIT LOG)
            ================================================================= */}
        {devSection === 'access' && (
          <div className="space-y-4">
            {/* Access KPI Summary Row */}
            <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
              <div className={`rounded-2xl border p-4 ${theme.bgCard}`}>
                <div className={`text-[11px] font-bold uppercase ${theme.textMuted}`}>Total Logged Access Sessions</div>
                <div className="text-2xl font-black text-[#0072CE] dark:text-sky-300 mt-1">{accessLog.length}</div>
                <div className={`text-[11px] mt-0.5 ${theme.textMuted}`}>Persisted in LocalStorage + HubConfigs</div>
              </div>
              <div className={`rounded-2xl border p-4 ${theme.bgCard}`}>
                <div className={`text-[11px] font-bold uppercase ${theme.textMuted}`}>Unique Microsoft IDs</div>
                <div className="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">{uniqueAccessUsers}</div>
                <div className={`text-[11px] mt-0.5 ${theme.textMuted}`}>Active corporate & plant accounts</div>
              </div>
              <div className={`rounded-2xl border p-4 ${theme.bgCard}`}>
                <div className={`text-[11px] font-bold uppercase ${theme.textMuted}`}>Current Reader Identity</div>
                <div className="text-lg font-black mt-1 truncate">{msIdentity.microsoftId}</div>
                <div className={`text-[11px] mt-0.5 truncate ${theme.textMuted}`}>{msIdentity.userName}</div>
              </div>
              <div className={`rounded-2xl border p-4 ${theme.bgCard}`}>
                <div className={`text-[11px] font-bold uppercase ${theme.textMuted}`}>Latest Access Timestamp</div>
                <div className="text-sm font-black mt-1">{accessLog[0] ? accessLog[0].timestampLabel : 'Just now'}</div>
                <div className={`text-[11px] mt-0.5 truncate ${theme.textMuted}`}>{accessLog[0] ? accessLog[0].authSource : msIdentity.source}</div>
