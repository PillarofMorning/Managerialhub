      if (!area.hasDrawnBoundary || !Array.isArray(area.box) || area.box.length !== 4) return false;
      if (hideLegacyAreas && (area.isLegacy || area.hidden)) return false;
      if (!area.isLegacy) {
        if (currentAreaFilterMode === 'hide_all_current') return false;
        if (currentAreaFilterMode === 'only_target' && area.id !== activeTargetZoneId && area.roomKey !== activeTargetZoneId) {
          return false;
        }
        if (filteredOutCurrentAreaIds[area.id]) return false;
      }
      if (!q) return true;
      const hay = `${area.id} ${area.label} ${area.short} ${area.roomKey || ''}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [isBareMapActive, showRoomBoxes, effectiveFacilityAreas, hideLegacyAreas, currentAreaFilterMode, activeTargetZoneId, filteredOutCurrentAreaIds, areaFilterText]);

  const filteredOutCurrentCount = useMemo(() => {
    if (isBareMapActive) return currentActiveAreas.length;
    return configuredActiveAreas.filter(a => !visibleFacilityAreas.some(v => v.id === a.id)).length;
  }, [isBareMapActive, currentActiveAreas.length, configuredActiveAreas, visibleFacilityAreas]);

  // Aggregate active hits by siteCode or room+surface+description so each site pin shows its total hits, streak badge, and history
  const groupedHitPins = useMemo(() => {
    const groups = {};
    allHits.forEach(h => {
      const key = h.siteCode || `${h.room}::${h.surface}::${h.description}`;
      if (!groups[key]) {
        groups[key] = {
          key,
          siteCode: h.siteCode,
          room: h.room,
          surface: h.surface,
          description: h.description,
          assetTag: h.assetTag,
          spot: h.spot,
          isCustomMapped: h.isCustomMapped,
          hits: []
        };
      }
      groups[key].hits.push(h);
    });
    // A pin takes the most urgent state of its hits: red open positive, amber open APC / ATP fail, gray email only,
    // green closed, hollow before the alert window (history). Repeat sites pulse.
    return Object.keys(groups).map(k => {
      const g = groups[k];
      g.hits.sort((a, b) => String(b.date).localeCompare(String(a.date)));
      const hasLis = g.hits.some(x => x.testType === 'LIS');
      const hasRetest = g.hits.some(x => x.testType === 'RETEST-LIS');
      const hasApc = g.hits.some(x => x.testType === 'APC');
      const primaryType = hasLis ? 'LIS' : (hasRetest ? 'RETEST-LIS' : (hasApc ? 'APC' : 'ATP'));
      const tone = g.hits.reduce((t, h) => moreUrgentTone(t, toneByHit[h.id] || 'act'), 'plain');
      return {
        ...g,
        count: g.hits.length,
        primaryType,
        tone,
        hollow: tone === 'plain',
        repeat: g.hits.some(h => !!repeatIds[h.id]),
        color: BOLO_TONES[tone] ? BOLO_TONES[tone].hex : BOLO_TONES.plain.hex
      };
    }).sort((x, y) => (BOLO_TONE_RANK[x.tone] - BOLO_TONE_RANK[y.tone]) || String((y.hits[0] && y.hits[0].date) || '').localeCompare(String((x.hits[0] && x.hits[0].date) || '')));
  }, [allHits, toneByHit, repeatIds]);

  // Filter hit pins so Bare Map Mode hides 100% of pins, and unmapped estimated pins are hidden unless showEstimatedUnmappedPins is enabled
  const visibleHitPins = useMemo(() => {
    if (isBareMapActive || !showHitPins || dayLayer) return [];
    return groupedHitPins.filter(pin => {
      if (currentAreaFilterMode === 'only_target' && pin.room !== activeTargetZoneId) return false;
      if (filteredOutCurrentAreaIds[pin.room]) return false;
      const roomArea = effectiveFacilityAreas.find(a => a.id === pin.room || a.roomKey === pin.room);
      const isAreaConfigured = !!(roomArea && roomArea.hasDrawnBoundary && Array.isArray(roomArea.box));
      if (!pin.isCustomMapped && !isAreaConfigured && !showEstimatedUnmappedPins) {
        return false;
      }
      return true;
    });
  }, [isBareMapActive, showHitPins, groupedHitPins, currentAreaFilterMode, activeTargetZoneId, filteredOutCurrentAreaIds, effectiveFacilityAreas, showEstimatedUnmappedPins, dayLayer]);

  // A room's state on the map: the most urgent state of its hits, and how many are open
  const roomStateByKey = useMemo(() => {
    const out = {};
    allHits.forEach(h => {
      const t = toneByHit[h.id] || 'act';
      const r = out[h.room] || (out[h.room] = { tone: 'plain', open: 0 });
      r.tone = moreUrgentTone(r.tone, t);
      if (t === 'act' || t === 'watch') r.open += 1;
    });
    return out;
  }, [allHits, toneByHit]);
  const roomStateOf = (area) => roomStateByKey[area.roomKey] || roomStateByKey[area.id] || null;
  const roomToneOf = (area) => { const r = roomStateOf(area); return r ? r.tone : ''; };
  const roomOpenCountOf = (area) => { const r = roomStateOf(area); return r ? r.open : 0; };

  // Center map helper
  const centerOnCoords = useCallback((xPct, yPct) => {
    const c = containerRef.current;
    const s = stageRef.current;
    if (!c || !s) return;
    const aspect = (s.offsetWidth && s.offsetHeight) ? (s.offsetWidth / s.offsetHeight) : 1.6;
    const f = turnPoint(rotation, xPct / 100, yPct / 100, aspect);
    c.scrollTo({
      left: s.offsetLeft + f[0] * s.offsetWidth - c.clientWidth / 2,
      top: s.offsetTop + f[1] * s.offsetHeight - c.clientHeight / 2,
      behavior: 'smooth'
    });
  }, [rotation]);

  // A day pinned from the calendar: show the overlays and center on its most urgent swab
  const lastDayN = useRef(0);
  useEffect(() => {
    if (!dayLayer || !dayLayer.n || dayLayer.n === lastDayN.current) return;
    lastDayN.current = dayLayer.n;
    setMapMode('heatmap');
    setBareMapMode(false);
    setCurrentAreaFilterMode('show_all');
    setFilteredOutCurrentAreaIds({});
    const first = dayLayer.pins.slice().sort((x, y) => BOLO_TONE_RANK[x.tone] - BOLO_TONE_RANK[y.tone])[0];
    if (first) setTimeout(() => centerOnCoords(first.x, first.y), 80);
  }, [dayLayer, centerOnCoords]);

  // Handle focusTarget from Dashboard or 2-Week Calendar
  const lastFocusedN = useRef(0);
  useEffect(() => {
    if (!focusTarget || focusTarget.n === lastFocusedN.current) return;
    lastFocusedN.current = focusTarget.n;

    if (focusTarget.siteCode) {
      setSetupSiteCode(focusTarget.siteCode);
      const pinMatch = groupedHitPins.find(p => p.siteCode === focusTarget.siteCode);
      if (pinMatch) {
        setBareMapMode(false);
        setShowHitPins(true);
        if (!pinMatch.isCustomMapped) setShowEstimatedUnmappedPins(true);
        setSelectedPinKey(pinMatch.key);
        setZoomLevel(175);
