// "New since your last visit" (this computer only): the positive keys seen at the last visit are read once at start;
// the current keys are written back once the swab table has answered, so the next visit compares with today
const BOLO_SEEN_KEY = 'stillwell.pathogenBolo.seenPositives.v1';
function useNewSinceLastVisit(keys, ready) {
  const prevRef = useRef(undefined);
  if (prevRef.current === undefined) {
    const saved = readStorage(BOLO_SEEN_KEY, null);
    prevRef.current = saved && Array.isArray(saved.keys) ? saved.keys : null;
  }
  const joined = useMemo(() => keys.join('|'), [keys]);
  useEffect(() => {
    if (!ready) return;
    writeStorage(BOLO_SEEN_KEY, { keys: keys.slice(0, 4000), at: new Date().toISOString() });
  }, [ready, joined]);
  return useMemo(() => {
    const prev = prevRef.current;
    const out = {};
    if (!prev) return out;
    const seen = {};
    prev.forEach(k => { seen[k] = true; });
    keys.forEach(k => { if (!seen[k]) out[k] = true; });
    return out;
  }, [joined]);
}

// Repeat sites: positives at the same site and in the same test family (Listeria, Salmonella and retests together;
// APC, ATP and other tests each on their own) on two or more different days, each no more than repeatDays after the
// one before. Hits further apart start a new run, so a site positive on Oct 30 and Nov 2 is a repeat and one positive
// in March and again in June is not.
function findRepeatSites(hits, repeatDays) {
  const gap = repeatDays > 0 ? repeatDays : BOLO_RULES_DEFAULT.repeatDays;
  const isPath = (t) => t === 'LIS' || t === 'RETEST-LIS' || t === 'SAL';
  const groups = {};
  const order = [];
  (hits || []).forEach(h => {
    if (!h || !h.date) return;
    const fam = isPath(h.testType) ? 'PATHOGEN' : String(h.testType || '');
    const key = `${fam}::${h.siteCode || `${h.room}::${h.surface}::${h.description}`}`;
    if (!groups[key]) { groups[key] = []; order.push(key); }
    groups[key].push(h);
  });
  const out = [];
  order.forEach(key => {
    const list = groups[key].slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
    let run = [];
    const flush = () => {
      const days = [];
      run.forEach(x => { if (days.indexOf(x.date) === -1) days.push(x.date); });
      if (days.length < 2) return;
      const h0 = run[0];
      out.push({
        key: `${key}::${days[0]}`,
        siteCode: h0.siteCode,
        room: h0.room,
        surface: h0.surface,
        description: h0.description,
        assetTag: h0.assetTag,
        spot: h0.spot,
        testFamily: key.split('::')[0],
        hits: run,
        count: run.length,
        uniqueDays: days.length,
        dates: days,
        firstDate: days[0],
        lastDate: days[days.length - 1]
      });
    };
    list.forEach(h => {
      if (run.length > 0 && dayDiff(run[run.length - 1].date, h.date) > gap) {
        flush();
        run = [];
      }
      run.push(h);
    });
    flush();
  });
  return out.sort((a, b) => (b.count - a.count) || String(b.lastDate).localeCompare(String(a.lastDate)));
}

function computePlantPressurePoints(allHits, repeatStreaks, parsedPrompt, ledgerRollup, suggestedActionsMap = {}, rules = null) {
  const hitsIn = Array.isArray(allHits) ? allHits : [];
  const streaks = Array.isArray(repeatStreaks) ? repeatStreaks : [];
  const ledgerRows = (ledgerRollup && Array.isArray(ledgerRollup.rows)) ? ledgerRollup.rows : [];
  const summaryObj = (parsedPrompt && parsedPrompt.summary) ? parsedPrompt.summary : null;

  const isPathogenType = (t) => t === 'LIS' || t === 'RETEST-LIS' || t === 'SAL';
  const inCategory = (t, cat) => {
    if (cat === 'pathogen') return isPathogenType(t);
    if (cat === 'apc') return t === 'APC';
    if (cat === 'atp') return t === 'ATP';
    return isPathogenType(t) || t === 'APC' || t === 'ATP';
  };
  const rowTest = (r) => {
    const c = String(r.testCode || '').toUpperCase();
    if (c === 'LIS') return r.stage === 'RETEST' ? 'RETEST-LIS' : 'LIS';
    return c;
  };
  const rowStage = (r) => (r.stage === 'ST' || r.stage === 'INP') ? r.stage : '';
  const hitStage = (h) => {
    if (!h) return '';
    if (h.timingStage === 'ST' || h.timingStage === 'INP') return h.timingStage;
    if (h.stage === 'ST' || h.stage === 'INP') return h.stage;
    return '';
  };
  const deptOf = (room) => (ROOM_META[room] && ROOM_META[room].dept) || 'Facility';
  const pct = (p, s) => (s > 0 ? round2((p / s) * 100) : null);
  const diff = (a, b) => (a !== null && a !== undefined && b !== null && b !== undefined ? round2(a - b) : null);
  const fmt = (v) => (v === null || v === undefined ? '--' : `${v}%`);

  // --- Date windows: This Year (Jan 1 to today) vs the same span last year and two years ago ---
  const tyYear = LIVE_CURRENT_YEAR;
  const mmdd = LIVE_TODAY_DATE_KEY.slice(4);
  const spanOf = (yr) => ({ start: `${yr}-01-01`, end: `${yr}${mmdd}` });
  // Rates use finished pass/fail results of routine environmental swabs (Listeria, Salmonella) and of APC / ATP
  // indicator swabs. Retests, vectors, product, water, rows the reader did not recognize and results set by hand are
  // reported on their own and never move a rate.
  const done = ledgerRows.filter(r => {
    if (!r || !r.date || r.manualResult || !rateCallOf(r)) return false;
    const k = r.swabKind || swabKindOf(r);
    return k === 'routine' || k === 'indicator';
  });
  const rowsIn = (span) => done.filter(r => r.date >= span.start && r.date <= span.end);
  const tyRows = rowsIn(spanOf(tyYear));
  const lyRows = rowsIn(spanOf(tyYear - 1));
  const hasEmailTotals = !!(summaryObj && summaryObj.totalLis && summaryObj.totalLis.total > 0);
  const useEmail = tyRows.length === 0 && hasEmailTotals;
  const scopeLabel = useEmail
    ? 'Report week (pasted email totals)'
    : (tyRows.length > 0 ? `${tyYear} to date (${tyRows.length.toLocaleString()} completed swabs)` : 'No swab results loaded');
  const scopeLabelEs = useEmail
    ? 'Semana del reporte (totales del correo pegado)'
    : (tyRows.length > 0 ? `${tyYear} a la fecha (${tyRows.length.toLocaleString()} hisopos terminados)` : 'No hay resultados de hisopos cargados');

  const agg = (list, cat, pred) => {
    let p = 0;
    let s = 0;
    for (let i = 0; i < list.length; i += 1) {
      const r = list[i];
      if (!inCategory(rowTest(r), cat)) continue;
      if (pred && !pred(r)) continue;
      s += 1;
      if (rateCallOf(r) === 'fail') p += 1;
    }
    return { positives: p, swabs: s, rate: pct(p, s) };
  };
  const EMPTY = { positives: 0, swabs: 0, rate: null };

  // Email totals: overall per test, per room (pathogen only), per dept. Stage split is not in the email, so it stays null.
  const emailAgg = (cat, scope) => {
    if (!summaryObj) return EMPTY;
    const lis = summaryObj.totalLis || { total: 0, positives: 0 };
    const apc = summaryObj.apc || { total: 0, failures: 0, depts: {} };
    const atp = summaryObj.atp || { total: 0, failures: 0, depts: {} };
    const rooms = summaryObj.rooms || {};
    const pathFor = (pred) => {
      let p = 0;
      let s = 0;
      Object.keys(rooms).forEach(rk => {
        if (!pred(rk)) return;
        const ro = rooms[rk] || {};
        s += (ro.totalSwabs || 0) + (ro.salmonellaSwabs || 0);
        p += ro.positives || 0;
      });
      return { positives: p, swabs: s, rate: pct(p, s) };
    };
    const indFor = (src, dept) => {
      if (!dept) return { positives: src.failures || 0, swabs: src.total || 0, rate: pct(src.failures || 0, src.total || 0) };
      const d = (src.depts && src.depts[dept]) || null;
      return d ? { positives: d.failures || 0, swabs: d.total || 0, rate: pct(d.failures || 0, d.total || 0) } : EMPTY;
    };
    if (scope && scope.stage) return EMPTY;
    if (scope && scope.room) {
      if (cat === 'pathogen' || cat === 'all') return pathFor(rk => rk === scope.room);
      return EMPTY;
    }
    const dept = scope && scope.dept ? scope.dept : '';
    const path = dept ? pathFor(rk => deptOf(rk) === dept) : { positives: lis.positives || 0, swabs: lis.total || 0, rate: pct(lis.positives || 0, lis.total || 0) };
    if (cat === 'pathogen') return path;
    if (cat === 'apc') return indFor(apc, dept);
    if (cat === 'atp') return indFor(atp, dept);
    const a = indFor(apc, dept);
    const b = indFor(atp, dept);
    const p = path.positives + a.positives + b.positives;
    const s = path.swabs + a.swabs + b.swabs;
    return { positives: p, swabs: s, rate: pct(p, s) };
  };

  const scopePred = (scope) => (r) => {
    if (!scope) return true;
    if (scope.stage && rowStage(r) !== scope.stage) return false;
    if (scope.dept && deptOf(r.room) !== scope.dept) return false;
    if (scope.room && r.room !== scope.room) return false;
    return true;
  };
  const TY = (cat, scope) => (useEmail ? emailAgg(cat, scope) : agg(tyRows, cat, scopePred(scope)));
  const LY = (cat, scope) => agg(lyRows, cat, scopePred(scope));

  // --- Hits in the active report (email week when pasted, else every loaded hit) for counts and pressure points ---
  const sortedAllHits = hitsIn.slice().sort((a, b) => {
    const dCmp = String(a.date || '').localeCompare(String(b.date || ''));
    if (dCmp !== 0) return dCmp;
    const rCmp = String(a.room || '').localeCompare(String(b.room || ''));
    if (rCmp !== 0) return rCmp;
    return String(a.siteCode || a.id || '').localeCompare(String(b.siteCode || b.id || ''));
  });
  // Alerts, the stage split and the surface chart look back over the alert window only (2 months unless saved
  // otherwise); older hits stay in the graphs and the calendar
  const alertSince = alertSinceOf(rules);
  const recentHits = sortedAllHits.filter(h => h.date && h.date >= alertSince);
  const pathogenHitsList = recentHits.filter(h => isPathogenType(h.testType));
  const timedHits = pathogenHitsList.filter(h => hitStage(h) !== '');
  const inpPathogenCount = timedHits.filter(h => hitStage(h) === 'INP').length;
  const stPathogenCount = timedHits.filter(h => hitStage(h) === 'ST').length;
  const inpSharePct = pct(inpPathogenCount, timedHits.length);
  const stSharePct = pct(stPathogenCount, timedHits.length);

  // --- One metric block (TY vs LY, with ST / INP split) ---
  const block = (cat, scope, extra) => {
    const ty = TY(cat, scope);
    const ly = LY(cat, scope);
    const tySt = TY(cat, { ...(scope || {}), stage: 'ST' });
    const tyInp = TY(cat, { ...(scope || {}), stage: 'INP' });
    const lySt = LY(cat, { ...(scope || {}), stage: 'ST' });
    const lyInp = LY(cat, { ...(scope || {}), stage: 'INP' });
    const all = TY('all', scope);
    return {
      overallRate: ty.rate,
      combinedRate: all.rate,
      positives: ty.positives,
      totalSwabs: ty.swabs,
      combinedHits: all.positives,
      combinedSwabs: all.swabs,
      thisYearRate: ty.rate,
      stRateTY: tySt.rate,
      inpRateTY: tyInp.rate,
      lastYearRate: ly.rate,
      lastYearSwabs: ly.swabs,
      stRateLY: lySt.rate,
      inpRateLY: lyInp.rate,
      yoyDeltaPct: diff(ty.rate, ly.rate),
      ...(extra || {})
    };
  };
  const stageBlock = (cat, stage, label) => {
    const ty = TY(cat, { stage });
    const ly = LY(cat, { stage });
    const tySt = TY(cat, { stage: 'ST' });
    const tyInp = TY(cat, { stage: 'INP' });
    const lySt = LY(cat, { stage: 'ST' });
    const lyInp = LY(cat, { stage: 'INP' });
    const both = ty.swabs > 0 ? ty.positives + (stage === 'ST' ? tyInp.positives : tySt.positives) : 0;
    return {
      label,
      overallRate: ty.rate,
      positives: ty.positives,
      totalSwabs: ty.swabs,
      sharePct: pct(ty.positives, both),
      thisYearRate: ty.rate,
      activeWeekRate: ty.rate,
      stRateTY: tySt.rate,
      inpRateTY: tyInp.rate,
      lastYearRate: ly.rate,
      stRateLY: lySt.rate,
      inpRateLY: lyInp.rate,
      yoyDeltaPct: diff(ty.rate, ly.rate)
    };
  };
  const roomRateLine = (cat, rooms) => rooms
    .map(rk => {
      const r = TY(cat, { room: rk });
      return r.swabs > 0 ? `${(ROOM_META[rk] && ROOM_META[rk].short) || rk} ${fmt(r.rate)}` : '';
    })
    .filter(Boolean)
    .join(' - ') || 'No room totals yet';

  const CAT_TEXT = {
    pathogen: { label: 'Pathogen Only (Default: LIS / Retest-LIS / SAL)', short: 'Pathogen Only', badge: 'PATHOGEN ONLY', word: 'Pathogen' },
    apc: { label: 'APC Results Only (Aerobic Plate Count Indicators)', short: 'APC Only', badge: 'APC INDICATORS', word: 'APC' },
    atp: { label: 'ATP Results Only (Rapid Hygiene Indicators)', short: 'ATP Only', badge: 'ATP INDICATORS', word: 'ATP' },
    all: { label: 'All Results Combined (Pathogen + APC + ATP)', short: 'All Results', badge: 'ALL RESULTS', word: 'All results' }
  };
  const synopsisLine = (name, b) => (
    `${name}: ${fmt(b.thisYearRate)} this year (${b.positives}/${b.totalSwabs}) vs ${fmt(b.lastYearRate)} last year`
    + (b.yoyDeltaPct === null ? ' (no last-year swabs loaded).' : ` (${b.yoyDeltaPct > 0 ? '+' : ''}${b.yoyDeltaPct}% YoY).`)
  );

  const byCategory = {};
  ['pathogen', 'apc', 'atp', 'all'].forEach(cat => {
    const t = CAT_TEXT[cat];
    const overall = block(cat, null, { metricTitle: `% Overall (${t.word} Positivity)` });
    overall.synopsis = `${scopeLabel}. ${synopsisLine(t.word, overall)}`;
    const inp = stageBlock(cat, 'INP', '% In-Process (INP)');
    const startup = stageBlock(cat, 'ST', '% Start-Up (ST)');
    const creme = block(cat, { dept: 'Creme' }, { label: '% Creme Side (WJ, IBL5, IBL4)', lineBreakdown: roomRateLine(cat, ['WJ', 'IBL5', 'IBL4']) });
    const bakeryRooms = ['Custard', 'Dough Room', 'Cook Room', 'Highspeed'];
    const bakery = block(cat, { dept: 'Bakery' }, { label: '% Bakery (Custard, Dough, Cook, Highspeed)', lineBreakdown: roomRateLine(cat, bakeryRooms) });
    bakery.dailyLisRate = bakery.overallRate;
    bakery.activeRate = bakery.overallRate;
    byCategory[cat] = {
      categoryKey: cat,
      categoryLabel: t.label,
      shortLabel: t.short,
      shortBadge: t.badge,
      overall,
      inProcessAndStartup: {
        metricTitle: `% Overall: % Start-Up & % In-Process (${t.word})`,
        inp,
        startup,
        synopsis: `${synopsisLine('Start-Up (ST)', startup)} ${synopsisLine('In-Process (INP)', inp)}`
      },
      cremeAndBakery: {
        metricTitle: `% Overall: % Creme Side vs % Bakery (${t.word})`,
        creme,
        bakery,
        synopsis: `${synopsisLine('Creme Side', creme)} ${synopsisLine('Bakery', bakery)}`
      }
    };
  });

  // --- Per-room separation matrix ---
  const roomOrder = ['WJ', 'IBL5', 'IBL4', 'Custard', 'Dough Room', 'Cook Room', 'Highspeed', 'Okra / 01MIX', 'Tote Room', 'Drains', 'Zone 4 / Mobile', 'SCM'];
  const roomSeparationList = roomOrder.map(rk => {
    const rmMeta = ROOM_META[rk] || { label: rk, short: rk, dept: 'Facility', color: '#0072CE' };
    const pTy = TY('pathogen', { room: rk });
    const pLy = LY('pathogen', { room: rk });
    const aTy = TY('apc', { room: rk });
    const aLy = LY('apc', { room: rk });
    const tTy = TY('atp', { room: rk });
    const allTy = TY('all', { room: rk });
    const stTy = TY('pathogen', { room: rk, stage: 'ST' });
    const inpTy = TY('pathogen', { room: rk, stage: 'INP' });
    const stLy = LY('pathogen', { room: rk, stage: 'ST' });
    const inpLy = LY('pathogen', { room: rk, stage: 'INP' });
    const sideLabel = rmMeta.dept === 'Creme' ? 'Creme Side' : (rmMeta.dept === 'Bakery' ? 'Bakery' : 'Facility');
    return {
      room: rk,
      short: rmMeta.short || rk,
      label: rmMeta.label || rk,
      dept: rmMeta.dept || 'Facility',
      side: sideLabel,
      color: rmMeta.color || '#0072CE',
      hasData: allTy.swabs > 0,
      isCleanRoom: allTy.swabs > 0 && allTy.positives === 0,
      isCleanPathogenRoom: pTy.swabs > 0 && pTy.positives === 0,
      pathogenPos: pTy.positives,
      pathogenSwabs: pTy.swabs,
      pathogenRate: pTy.rate,
      lyPathRate: pLy.rate,
      pathogenYoY: diff(pTy.rate, pLy.rate),
      stRate: stTy.rate,
      inpRate: inpTy.rate,
      lyStRate: stLy.rate,
      lyInpRate: inpLy.rate,
      apcFail: aTy.positives,
      apcSwabs: aTy.swabs,
      apcRate: aTy.rate,
      atpFail: tTy.positives,
      atpSwabs: tTy.swabs,
      atpRate: tTy.rate,
      combinedHits: allTy.positives,
      combinedSwabs: allTy.swabs,
      combinedRate: allTy.rate,
      pathogen: { positives: pTy.positives, swabs: pTy.swabs, rate: pTy.rate, lastYearRate: pLy.rate, yoyDelta: diff(pTy.rate, pLy.rate) },
      apc: { positives: aTy.positives, swabs: aTy.swabs, rate: aTy.rate, lastYearRate: aLy.rate, yoyDelta: diff(aTy.rate, aLy.rate) },
      atp: { positives: tTy.positives, swabs: tTy.swabs, rate: tTy.rate },
      all: { positives: allTy.positives, swabs: allTy.swabs, rate: allTy.rate },
      inpPos: inpTy.positives,
      stPos: stTy.positives
    };
  });

  // --- Monthly series (real monthly rates from the ledger; empty months stay null) ---
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const monthRows = (yr, mi) => {
    const key = `${yr}-${pad2(mi + 1)}`;
    return done.filter(r => r.date.slice(0, 7) === key);
  };
  const nowMonth = parseInt(LIVE_TODAY_DATE_KEY.slice(5, 7), 10) - 1;
  // Each slice gets <key>TY / <key>LY / <key>2Y rates and the counts behind them (<key>PosTY, <key>SwabsTY, ...), so
  // pooled numbers (YTD, 3-month, pivots) are built from swabs, never from averaging percentages.
  const st = (x) => rowStage(x) === 'ST';
  const inp = (x) => rowStage(x) === 'INP';
  const dept = (d) => (x) => deptOf(x.room) === d;
  const room = (rk) => (x) => x.room === rk;
  const MONTH_SLICES = {
    pathogen: ['pathogen', null], apc: ['apc', null], atp: ['atp', null], all: ['all', null],
    inp: ['pathogen', inp], st: ['pathogen', st], creme: ['pathogen', dept('Creme')], bakery: ['pathogen', dept('Bakery')],
    wj: ['pathogen', room('WJ')], ibl5: ['pathogen', room('IBL5')], ibl4: ['pathogen', room('IBL4')], dough: ['pathogen', room('Dough Room')]
  };
  const monthlyYoYSeries = MONTHS.map((m, mi) => {
    const lists = { TY: mi <= nowMonth ? monthRows(tyYear, mi) : [], LY: monthRows(tyYear - 1, mi), '2Y': monthRows(tyYear - 2, mi) };
    const out = { monthIndex: mi, month: m };
    Object.keys(MONTH_SLICES).forEach(k => {
      const cat = MONTH_SLICES[k][0];
      const pred = MONTH_SLICES[k][1];
      Object.keys(lists).forEach(suf => {
        const a = agg(lists[suf], cat, pred);
        out[k + suf] = a.rate;
        out[`${k}Pos${suf}`] = a.positives;
        out[`${k}Swabs${suf}`] = a.swabs;
      });
    });
    out.pathogen2024 = out.pathogen2Y;
    out.swabsTY = lists.TY.length;
    out.swabsLY = lists.LY.length;
    return out;
  });

  const sepEntry = (cat, label) => {
    const c = byCategory[cat];
    return {
      label,
      positives: c.overall.positives,
      swabs: c.overall.totalSwabs,
      rate: c.overall.overallRate,
      lyRate: c.overall.lastYearRate,
      yoyDelta: c.overall.yoyDeltaPct,
      inpRate: c.overall.inpRateTY,
      stRate: c.overall.stRateTY,
      lyInpRate: c.overall.inpRateLY,
      lyStRate: c.overall.stRateLY,
      cremeRate: c.cremeAndBakery.creme.overallRate,
      bakeryRate: c.cremeAndBakery.bakery.overallRate
    };
  };
  const separationObj = {
    pathogen: sepEntry('pathogen', 'Pathogen (LIS / Retest / SAL)'),
    apc: sepEntry('apc', 'APC Indicator (Aerobic Plate Count)'),
    atp: sepEntry('atp', 'ATP & Other Rapid Indicators'),
    all: sepEntry('all', 'All Results Combined'),
    roomSeparationList
  };

  // --- Pressure points: generic rules over real hits, ranked by score ---
  const points = [];
  const DEFAULT_ACTION = 'Check the last MSS clean for this equipment, schedule a corrective clean, and retest the site.';

  // 1. Repeat positive sites (findRepeatSites: the same site positive on 2+ days, each within the repeat window of the
  // one before), when the last hit is inside the alert window
  const repeatDays = normalizeBoloRules(rules).repeatDays;
  streaks.filter(st => st.lastDate && st.lastDate >= alertSince).slice(0, 12).forEach(st => {
    const stCount = st.hits ? st.hits.filter(h => hitStage(h) === 'ST').length : 0;
    // A repeat pathogen site is act now; a repeat APC / ATP fail site is watch (v2.5 color rules)
    const urgency = st.testFamily && st.testFamily !== 'PATHOGEN' ? 'watch' : 'act';
    points.push({
      id: `pp-site-${st.siteCode || normToken(`${st.room} ${st.surface} ${st.description}`)}${st.testFamily && st.testFamily !== 'PATHOGEN' ? `-${normToken(st.testFamily)}` : ''}`,
      kind: 'repeat',
      urgency,
      data: { surface: st.surface, description: st.description, family: st.testFamily || 'PATHOGEN', count: st.count, days: st.uniqueDays, dates: st.dates },
      score: Math.min(99, 60 + st.count * 8),
      severity: 'REPEAT POSITIVE SITE',
      color: BOLO_TONES[urgency].hex,
      since: st.firstDate,
      room: st.room,
      siteCode: st.siteCode || '',
      assetTag: st.assetTag || '',
      title: `${st.room}: ${st.surface} - ${st.description}${st.testFamily && st.testFamily !== 'PATHOGEN' ? ` (${st.testFamily})` : ''}`,
      subtitle: `${st.count} positives across ${st.uniqueDays} days (${st.dates.map(formatShortDate).join(', ')})`,
      diagnosis: `${st.count} positive results at ${st.siteCode || st.surface} between ${formatShortDate(st.firstDate)} and ${formatShortDate(st.lastDate)}, each within ${repeatDays} days of the one before${stCount > 0 ? `; ${stCount} of them at Start-Up (ST)` : ''}.`,
      action: DEFAULT_ACTION
    });
  });

  // 2. Rooms with hits on 3+ different sites
  const byRoom = {};
  recentHits.forEach(h => {
    if (!h.room) return;
    if (!byRoom[h.room]) byRoom[h.room] = { hits: [], sites: {} };
    byRoom[h.room].hits.push(h);
    byRoom[h.room].sites[h.siteCode || `${h.surface} ${h.description}`] = true;
  });
  Object.keys(byRoom).forEach(rk => {
    const g = byRoom[rk];
    const siteCount = Object.keys(g.sites).length;
    if (siteCount < 3) return;
    const tests = {};
    g.hits.forEach(h => { tests[h.testType] = (tests[h.testType] || 0) + 1; });
    points.push({
      id: `pp-room-${normToken(rk)}`,
      kind: 'cluster',
      urgency: 'watch',
      data: { hits: g.hits.length, sites: siteCount, first: g.hits[0].date, last: g.hits[g.hits.length - 1].date, tests: Object.keys(tests).map(t => `${tests[t]} ${t}`).join(', ') },
      score: Math.min(95, 55 + siteCount * 6),
      severity: 'MULTI-SITE CLUSTER',
      color: BOLO_TONES.watch.hex,
      since: g.hits[0].date,
      room: rk,
      siteCode: g.hits[0].siteCode || '',
      assetTag: g.hits[0].assetTag || '',
      title: `${rk}: ${g.hits.length} hits on ${siteCount} different sites`,
      subtitle: Object.keys(tests).map(t => `${tests[t]} ${t}`).join(', '),
      diagnosis: `Positives spread across ${siteCount} sites in ${rk} (${formatShortDate(g.hits[0].date)} to ${formatShortDate(g.hits[g.hits.length - 1].date)}).`,
      action: 'Walk the room for a shared source (drains, overspray, traffic paths) and review the room\'s MSS cleans for the same days.'
    });
  });

  // 3. Failed retests
  const retestHits = recentHits.filter(h => h.testType === 'RETEST-LIS' || h.stage === 'RETEST');
  const retestByRoom = {};
  retestHits.forEach(h => {
    const rk = h.room || 'Unknown';
    if (!retestByRoom[rk]) retestByRoom[rk] = [];
    retestByRoom[rk].push(h);
  });
  Object.keys(retestByRoom).forEach(rk => {
    const list = retestByRoom[rk];
    points.push({
      id: `pp-retest-${normToken(rk)}`,
      kind: 'retest',
      urgency: 'act',
      data: { count: list.length, surfaces: list.map(r => `${r.surface} - ${r.description}`) },
      score: Math.min(97, 80 + list.length * 3),
      severity: 'RETEST ESCALATION',
      color: BOLO_TONES.act.hex,
      since: list[0].date,
      room: rk,
      siteCode: list[0].siteCode || '',
      assetTag: list[0].assetTag || '',
      title: `${rk}: ${list.length} failed retest${list.length === 1 ? '' : 's'}`,
      subtitle: list.map(r => `${r.surface} - ${r.description}`).join(' & '),
      diagnosis: 'A retest came back positive after the corrective clean.',
      action: 'Escalate per the EMP plan: vector swabbing around the site and a deep clean before the next retest.'
    });
  });

  // 4. Room pathogen rate at least double its own last-year rate (needs real swabs both years)
  roomSeparationList.forEach(rs => {
    if (rs.pathogenRate === null || rs.lyPathRate === null || rs.pathogenPos < 2) return;
    if (rs.pathogenRate < rs.lyPathRate * 2) return;
    points.push({
      id: `pp-rate-${normToken(rs.room)}`,
      kind: 'rate',
      urgency: 'watch',
      data: { rate: rs.pathogenRate, ly: rs.lyPathRate, pos: rs.pathogenPos, swabs: rs.pathogenSwabs },
      score: Math.min(90, 60 + Math.round(rs.pathogenRate - rs.lyPathRate) * 4),
      severity: 'ELEVATED POSITIVITY %',
      color: BOLO_TONES.watch.hex,
      since: `${tyYear}-01-01`,
      room: rs.room,
      siteCode: '',
      assetTag: '',
      title: `${rs.room} pathogen rate ${fmt(rs.pathogenRate)} vs ${fmt(rs.lyPathRate)} last year`,
      subtitle: `${rs.pathogenPos} positives / ${rs.pathogenSwabs} swabs this year`,
      diagnosis: `${rs.room} is running at more than twice its own last-year rate for the same part of the year.`,
      action: 'Review this room\'s positive sites and recent changes (equipment, staffing, chemicals, schedule).'
    });
  });

  // 5. Stage and surface pattern (only once there are enough timed hits to mean something)
  const floorDrainCount = recentHits.filter(h => /floor|drain/i.test(`${h.surface} ${h.description}`)).length;
  const floorDrainPct = pct(floorDrainCount, recentHits.length);
  if (timedHits.length >= 5) {
    const roomCounts = {};
    timedHits.forEach(h => { roomCounts[h.room] = (roomCounts[h.room] || 0) + 1; });
    const topRoom = Object.keys(roomCounts).sort((a, b) => roomCounts[b] - roomCounts[a])[0] || '';
    points.push({
      id: 'pp-stage-surface',
      kind: 'pattern',
      urgency: 'info',
      data: { inpPct: inpSharePct, floorPct: floorDrainPct, inp: inpPathogenCount, st: stPathogenCount },
      score: 50,
      severity: 'STAGE & SURFACE PATTERN',
      color: BOLO_TONES.plain.hex,
      since: alertSince,
      room: topRoom,
      siteCode: '',
      assetTag: '',
      title: `${fmt(inpSharePct)} of timed pathogen hits In-Process; ${fmt(floorDrainPct)} on floors/drains`,
      subtitle: `${inpPathogenCount} INP vs ${stPathogenCount} Start-Up (ST) hits`,
      diagnosis: 'Share of pathogen positives by production stage and by floor/drain surfaces.',
      action: 'Use this split to decide between pre-op clean checks (ST) and mid-shift controls (INP).'
    });
  }

  points.sort((a, b) => b.score - a.score);
  // A saved next step: under the alert's id, or under the site code (Saved next steps, Add a next step for a site), or
  // an older custom entry that names the same site (the newest one)
  const stepBySite = {};
  Object.keys(suggestedActionsMap || {}).forEach(k => {
    const a = suggestedActionsMap[k];
    if (!a || !a.siteCode) return;
    const prev = stepBySite[a.siteCode];
    if (!prev || String(a.updatedAt || '') > String(prev.updatedAt || '')) stepBySite[a.siteCode] = a;
  });
  const enrichedPoints = points.map((pp, idx) => {
    const customAct = (suggestedActionsMap && (suggestedActionsMap[pp.id] || (pp.siteCode && (pp.kind === 'repeat' || pp.kind === 'retest') && (suggestedActionsMap[pp.siteCode] || stepBySite[pp.siteCode])))) || null;
    if (!customAct) {
      return {
        ...pp,
        hasCustomAction: false,
        rank: idx + 1,
        actionOwner: 'FSQ & Sanitation Team',
        actionStatus: 'Not set',
        actionPriority: pp.score >= 80 ? 'High' : 'Medium',
        actionUpdatedBy: '',
        actionUpdatedAt: null,
        actionSynced: false,
        actionSyncedToDataverse: false
      };
    }
    const synced = customAct.syncedToDataverse !== false;
    return {
      ...pp,
      hasCustomAction: true,
      rank: idx + 1,
      action: customAct.action || customAct.actionText || pp.action,
      actionOwner: customAct.owner || 'FSQ & Sanitation Team',
      actionStatus: customAct.status || 'Active SOP',
      actionPriority: customAct.priority || 'High',
      actionUpdatedBy: customAct.updatedBy || customAct.updatedByMsId || '',
      actionUpdatedAt: customAct.updatedAt || null,
      actionSynced: synced,
      actionSyncedToDataverse: synced
    };
  });

  // Surface category distribution for chart
  // One hue for every surface: the bars count, the words name (v2.5: no red, amber or green on a category chart)
  const surfaceBuckets = [
    { label: 'Floors & Traffic Ways', count: 0, color: '#2a78d6' },
    { label: 'Drains & Trenches', count: 0, color: '#2a78d6' },
    { label: 'Platforms & Beams', count: 0, color: '#2a78d6' },
    { label: 'Slicers, Nozzles & Wipers', count: 0, color: '#2a78d6' },
    { label: 'Conveyors, Belts & Sheeters', count: 0, color: '#2a78d6' },
    { label: 'Utensils, Scales & Other', count: 0, color: '#2a78d6' }
  ];
  recentHits.forEach(h => {
    const s = `${h.surface} ${h.description}`;
    if (/floor/i.test(s)) surfaceBuckets[0].count += 1;
    else if (/drain/i.test(s)) surfaceBuckets[1].count += 1;
    else if (/platform|structure|pillar|beam/i.test(s)) surfaceBuckets[2].count += 1;
    else if (/slicer|nozzle|wiper|filler/i.test(s)) surfaceBuckets[3].count += 1;
    else if (/conveyor|belt|sheeter/i.test(s)) surfaceBuckets[4].count += 1;
    else surfaceBuckets[5].count += 1;
  });

  const executiveMetrics = {
    thisYearLabel: String(tyYear),
    lastYearLabel: String(tyYear - 1),
    scopeLabel,
    scopeLabelEs,
    usesEmailTotals: useEmail,
    overall: byCategory.pathogen.overall,
    inProcessAndStartup: byCategory.pathogen.inProcessAndStartup,
    cremeAndBakery: byCategory.pathogen.cremeAndBakery,
    byCategory,
    separation: separationObj,
    monthlyYoYSeries
  };

  return {
    points: enrichedPoints,
    alertSince,
    alertHits: recentHits.length,
    surfaceBuckets,
    inpCount: inpPathogenCount,
    stCount: stPathogenCount,
    inpPct: inpSharePct,
    stPct: stSharePct,
