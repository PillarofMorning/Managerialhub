// =======================================================================
// TAB 1: BOLO CALENDAR VIEW (LAST WEEK + CURRENT WEEK + MULTI-TIMEFRAME CALENDAR)
// =======================================================================
// Saved "Default calendar timeframe" -> calendar view. '1w' and '2w' were saved by v2.0-v2.2 (previous week / two
// weeks) and now open last week + this week; 'one_week' is a single week.
const CALENDAR_VIEW_FROM_PREF = { exec_overview: 'exec_overview', '1w': 'exec_overview', '2w': 'exec_overview', one_week: '1w', month: 'month', '8w': '8w', archive: 'archive' };
function MssBoloCalendarView({
  darkMode,
  theme,
  logoUnlocked,
  isAdminVerified,
  allHits,
  rawAllHits,
  parsedCsv,
  parsedPrompt,
  importCheck,
  repeatStreaks,
  pressureAnalysis,
  resultCategoryMode,
  setResultCategoryMode,
  executiveSynopses,
  onSaveExecutiveSynopsis,
  dateOverrides,
  setDateOverrides,
  selectedRoomFilter,
  setSelectedRoomFilter,
  selectedTestFilter,
  setSelectedTestFilter,
  calendarJumpDate,
  activeUserProfile,
  userPrefRooms,
  onLocateOnMap,
  onOpenTrends,
  onOpenDay,
  onOpenSite,
  repeatHitIds,
  newSince,
  openStateByHitId,
  hitToneById,
  rules,
  topSlot,
  onOpenQuickEmail,
  onOpenDedupChecker,
  onOpenSelectFeatures,
  onOpenImportCheck
}) {
  const prefCellMode = (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode) || 'hits_pending';
  const prefTimeframe = (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCalendarTimeframe) || '';

  // Views: 'exec_overview' = last week, then this week (default; weeks run Monday to Sunday), '1w' one week,
  // 'month' month grid, '8w' eight weeks, 'archive' every month in the ledger
  const [timeframeMode, setTimeframeMode] = useState(() => CALENDAR_VIEW_FROM_PREF[prefTimeframe] || 'exec_overview');
  const [anchorWeek, setAnchorWeek] = useState(() => getWeekStart(getTodayDateKey()));
  const [monthCursor, setMonthCursor] = useState(() => getTodayDateKey().slice(0, 7));
  const [cellDisplayMode, setCellDisplayMode] = useState(prefCellMode);
  const [expandedCells, setExpandedCells] = useState({});
  const [showUndatedBar, setShowUndatedBar] = useState(false);
  const R = normalizeBoloRules(rules);
  const repeatIds = repeatHitIds || {};
  const newIds = newSince || {};
  const stateByHit = openStateByHitId || {};
  const toneByHit = hitToneById || {};
  // The state of a positive on the calendar (hitToneById from the app): red = open, amber = an open APC / ATP fail,
  // green = closed by a clean, gray = in the QA email only, plain = before the alert window (history)
  const toneOfHit = (h) => toneByHit[h.id] || (h.emailOnly ? 'unknown' : ((h.testType === 'APC' || h.testType === 'ATP') ? 'watch' : 'act'));
  const toneOfHits = (hits) => (hits || []).reduce((t, h) => moreUrgentTone(t, toneOfHit(h)), 'plain');

  const lastWeekStart = useMemo(() => addDays(anchorWeek, -7), [anchorWeek]);
  const isViewingLiveCurrentWeek = anchorWeek === LIVE_CURRENT_WEEK_START;
  const catMode = resultCategoryMode || 'pathogen';
  // The target for the chosen results (Rules: Listeria + Salmonella, APC, ATP); none for "All tests"
  const catTarget = catMode === 'all' ? null : (typeof R.targets[catMode] === 'number' ? R.targets[catMode] : null);
  const isPathogenType = (t) => t === 'LIS' || t === 'RETEST-LIS' || t === 'SAL';

  // Hits shown for the chosen results view ('pathogen' default | 'all' | 'apc' | 'atp')
  const categoryFilteredHits = useMemo(() => {
    if (catMode === 'all') return allHits;
    if (catMode === 'apc') return allHits.filter(h => h.testType === 'APC');
    if (catMode === 'atp') return allHits.filter(h => h.testType === 'ATP');
    return allHits.filter(h => isPathogenType(h.testType));
  }, [allHits, catMode]);

  useEffect(() => {
    if (activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode) {
      setCellDisplayMode(activeUserProfile.viewPreferences.defaultCellDisplayMode);
    }
  }, [activeUserProfile && activeUserProfile.viewPreferences && activeUserProfile.viewPreferences.defaultCellDisplayMode]);

  // Jumps from the dashboard or the archive
  useEffect(() => {
    if (calendarJumpDate && calendarJumpDate.date) {
      setAnchorWeek(getWeekStart(calendarJumpDate.date));
      setMonthCursor(calendarJumpDate.date.slice(0, 7));
      if (calendarJumpDate.mode) setTimeframeMode(calendarJumpDate.mode);
    }
  }, [calendarJumpDate]);

  const dowNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const catWord = catMode === 'apc' ? 'APC' : (catMode === 'atp' ? 'ATP' : (catMode === 'all' ? tr('All tests', 'Todas las pruebas') : tr('Listeria + Salmonella', 'Listeria + Salmonella')));

  // Finished swabs (with a pass/fail call), positives and pending of one day or week for the chosen view.
  // pathogen = routine environmental Listeria + Salmonella (no retests, vectors or product).
  const tallyFor = (b) => {
    if (!b) return newTally();
    if (catMode === 'apc') return b.apc || newTally();
    if (catMode === 'atp') return b.atp || newTally();
    if (catMode === 'all') {
      const r = b.routine || newTally();
      const a = b.apc || newTally();
      const t = b.atp || newTally();
      return { swabs: r.swabs + a.swabs + t.swabs, positives: r.positives + a.positives + t.positives, pending: r.pending + a.pending + t.pending };
    }
    return b.routine || newTally();
  };
  const roomTallyFor = (b, rk) => ((catMode === 'pathogen' || catMode === 'all') && b && b.routineByRoom ? (b.routineByRoom[rk] || null) : null);
  const scopedTally = (b) => (selectedRoomFilter !== 'ALL' ? (roomTallyFor(b, selectedRoomFilter) || newTally()) : tallyFor(b));
  const roomShort = (rk) => (ROOM_META[rk] && ROOM_META[rk].short) || rk;

  // One day: its hits by room, its swab counts, and a status: future / hits / clean (finished swabs, none positive) /
  // pending (swabs waiting on the lab) / none (no swabs loaded)
  const buildDayCellObj = useCallback((dateKey, weekIndex = 1) => {
    const parts = dateKey.split('-').map(Number);
    const d = new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0);
    const isFuture = dateKey > LIVE_TODAY_DATE_KEY;
    const dayHits = isFuture ? [] : categoryFilteredHits.filter(h => h.date === dateKey);
    const byRoomHits = {};
    dayHits.forEach(h => {
      if (!byRoomHits[h.room]) byRoomHits[h.room] = [];
      byRoomHits[h.room].push(h);
    });
    const csvStat = isFuture ? null : (parsedCsv.dailyStats[dateKey] || null);
    const tally = scopedTally(csvStat);

    const roomBlocks = [];
    if (!isFuture) {
      const roomKeys = Object.keys(ROOM_META);
      Object.keys(byRoomHits).forEach(rk => { if (roomKeys.indexOf(rk) === -1) roomKeys.push(rk); });
      roomKeys.forEach(rk => {
        if (selectedRoomFilter !== 'ALL' && rk !== selectedRoomFilter) return;
        if (userPrefRooms && userPrefRooms.length > 0 && userPrefRooms.indexOf(rk) === -1) return;
        const hitsInR = byRoomHits[rk] || [];
        const rt = roomTallyFor(csvStat, rk);
        const swabsInR = rt ? rt.swabs : 0;
        const pendingInR = rt ? rt.pending : 0;
        const rowsInR = (csvStat && csvStat.rowsByRoom && csvStat.rowsByRoom[rk]) || [];
        if (hitsInR.length > 0 || swabsInR > 0 || pendingInR > 0 || (cellDisplayMode === 'all_mss' && rowsInR.length > 0)) {
          roomBlocks.push({ room: rk, hits: hitsInR, swabs: swabsInR, pending: pendingInR, rows: rowsInR });
        }
      });
    }
    roomBlocks.sort((a, b) => (b.hits.length - a.hits.length) || (b.pending - a.pending) || (b.swabs - a.swabs));

    // A day with results back and some still at the lab is 'partial', never shown as clean until every result is in
    let status = 'none';
    if (isFuture) status = 'future';
    else if (dayHits.length > 0) status = 'hits';
    else if (tally.swabs > 0 && tally.pending > 0) status = 'partial';
    else if (tally.swabs > 0) status = 'clean';
    else if (tally.pending > 0) status = 'pending';

    return {
      isPadding: false,
      dateKey,
      isToday: dateKey === LIVE_TODAY_DATE_KEY,
      isFuture,
      status,
      tally,
      isCleanDay: status === 'clean',
      dow: dowNames[(d.getDay() + 6) % 7],
      dayNum: d.getDate(),
      monthShort: d.toLocaleDateString('en-US', { month: 'short' }),
      yearNum: parts[0],
      weekIndex,
      hits: dayHits,
      byRoom: byRoomHits,
      roomBlocks,
      csvStat
    };
  }, [categoryFilteredHits, parsedCsv.dailyStats, selectedRoomFilter, userPrefRooms, cellDisplayMode, catMode]);

  const weekDays = useCallback((start) => {
    const out = [];
    for (let i = 0; i < 7; i += 1) out.push(buildDayCellObj(addDays(start, i), 1));
    return out;
  }, [buildDayCellObj]);
  const currentWeekDays = useMemo(() => weekDays(anchorWeek), [weekDays, anchorWeek]);
  const lastWeekDays = useMemo(() => weekDays(lastWeekStart), [weekDays, lastWeekStart]);

  // One week: lab rows (byWeek), the hits shown, and the QA email that reports on that week (if pasted)
  const summarizeWeek = useCallback((weekKey, daysArr) => {
    const b = (parsedCsv.byWeek && parsedCsv.byWeek[weekKey]) || null;
    const tally = scopedTally(b);
    let totalHits = 0;
    let lisHits = 0;
    let salHits = 0;
    let retestHits = 0;
    let indicatorHits = 0;
    let emailOnlyHits = 0;
    let otherKindHits = 0;
    let cleanDays = 0;
    let futureDays = 0;
    const hitsByRoomMap = {};
    const toneByRoom = {};
    daysArr.forEach(d => {
      if (d.isFuture) { futureDays += 1; return; }
      if (d.status === 'clean') cleanDays += 1;
      d.hits.forEach(h => {
        totalHits += 1;
        hitsByRoomMap[h.room] = (hitsByRoomMap[h.room] || 0) + 1;
        toneByRoom[h.room] = moreUrgentTone(toneByRoom[h.room] || 'plain', toneOfHit(h));
        if (h.emailOnly) emailOnlyHits += 1;
        if (h.kind === 'vector' || h.kind === 'product' || h.kind === 'other') otherKindHits += 1;
        if (h.testType === 'LIS') lisHits += 1;
        else if (h.testType === 'SAL') salHits += 1;
        else if (h.testType === 'RETEST-LIS') retestHits += 1;
        else indicatorHits += 1;
      });
    });
    const roomKeys = Object.keys(ROOM_META);
    Object.keys(hitsByRoomMap).forEach(rk => { if (roomKeys.indexOf(rk) === -1) roomKeys.push(rk); });
    const roomStats = roomKeys.map(rk => {
      const rt = roomTallyFor(b, rk);
      return { room: rk, swabs: rt ? rt.swabs : 0, positives: rt ? rt.positives : 0, pending: rt ? rt.pending : 0, hits: hitsByRoomMap[rk] || 0, tone: toneByRoom[rk] || '' };
    }).filter(x => x.swabs > 0 || x.pending > 0 || x.hits > 0);
    const email = (parsedPrompt && parsedPrompt.byWeek && parsedPrompt.byWeek[weekKey]) || null;
    return { weekKey, b, tally, rate: tallyRate(tally), totalHits, lisHits, salHits, retestHits, indicatorHits, emailOnlyHits, otherKindHits, cleanDays, futureDays, hitsByRoomMap, roomStats, email };
  }, [parsedCsv.byWeek, parsedPrompt, selectedRoomFilter, catMode, toneByHit]);

  const execWeekStats = useMemo(() => ({
    currentWeek: summarizeWeek(anchorWeek, currentWeekDays),
    lastWeek: summarizeWeek(lastWeekStart, lastWeekDays)
  }), [summarizeWeek, anchorWeek, lastWeekStart, currentWeekDays, lastWeekDays]);

  // Day cells for one week, a Monday-first month grid, or eight weeks
  const calendarCells = useMemo(() => {
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      const y = parseInt(yStr, 10) || LIVE_CURRENT_YEAR;
      const m = (parseInt(mStr, 10) || 10) - 1;
      const firstDow = (new Date(y, m, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(y, m + 1, 0).getDate();
      const cells = [];
      for (let p = 0; p < firstDow; p += 1) cells.push({ isPadding: true, key: `pad-start-${p}` });
      for (let day = 1; day <= daysInMonth; day += 1) {
        cells.push(buildDayCellObj(`${y}-${pad2(m + 1)}-${pad2(day)}`, Math.floor((firstDow + day - 1) / 7) + 1));
      }
      return cells;
    }
    const totalDays = timeframeMode === '1w' ? 7 : 56;
    const startKey = timeframeMode === '8w' ? addDays(anchorWeek, -49) : anchorWeek;
    const out = [];
    for (let i = 0; i < totalDays; i += 1) out.push(buildDayCellObj(addDays(startKey, i), Math.floor(i / 7) + 1));
    return out;
  }, [timeframeMode, anchorWeek, monthCursor, buildDayCellObj]);

  // Email lines that carry no date (retest, APC, ATP): they sit on the Friday of the email's week until moved
  const undatedSummaryHits = useMemo(() => rawAllHits.filter(h => !h.dateExplicit && h.emailOnly), [rawAllHits]);

  const stepTimeframe = (dir) => {
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      const d = new Date(parseInt(yStr, 10), parseInt(mStr, 10) - 1 + dir, 1);
      setMonthCursor(`${d.getFullYear()}-${pad2(d.getMonth() + 1)}`);
    } else {
      setAnchorWeek(addDays(anchorWeek, dir * (timeframeMode === '8w' ? 28 : 7)));
    }
  };

  const activeRangeLabel = useMemo(() => {
    if (timeframeMode === 'exec_overview') return `${formatWeekRangeLabel(lastWeekStart)} | ${formatWeekRangeLabel(anchorWeek, true)}`;
    if (timeframeMode === 'month') {
      const [yStr, mStr] = monthCursor.split('-');
      return new Date(parseInt(yStr, 10), parseInt(mStr, 10) - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }
    if (timeframeMode === 'archive') return tr('Every month in the ledger', 'Cada mes cargado');
    const validDays = calendarCells.filter(c => !c.isPadding);
    if (validDays.length === 0) return '';
    const first = validDays[0].dateKey;
    const last = validDays[validDays.length - 1].dateKey;
    return `${formatShortDate(first)} - ${formatShortDate(last)}, ${last.slice(0, 4)}`;
  }, [timeframeMode, monthCursor, calendarCells, lastWeekStart, anchorWeek]);

  // Archive: every month in the ledger, newest first (lab rows only; a positive is counted once)
  const archiveMonths = useMemo(() => Object.keys(parsedCsv.byMonth || {})
    .sort((a, b) => b.localeCompare(a))
    .map(k => parsedCsv.byMonth[k]), [parsedCsv.byMonth]);

  const openDay = (dateKey) => { if (typeof onOpenDay === 'function') onOpenDay(dateKey); };
  const chipBtn = 'rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]';

  // A day's chip: a color and a word (positives and their state, all negative, at the lab); it opens the day's swabs
  const statusChip = (day, compact) => {
    if (day.status === 'future') return null;
    if (day.status === 'hits') {
      const tone = toneOfHits(day.hits);
      const n = day.hits.length;
      const openN = day.hits.filter(h => { const t = toneOfHit(h); return t === 'act' || t === 'watch'; }).length;
      const fails = day.hits.every(h => h.testType === 'APC' || h.testType === 'ATP');
      const many = n > 1;
      const count = compact
        ? (fails ? tr(`${n} fail`, `${n} falla`) : tr(`${n} pos`, `${n} pos`))
        : (fails ? tr(many ? `${n} fails` : '1 fail', many ? `${n} fallas` : '1 falla') : tr(many ? `${n} positives` : '1 positive', many ? `${n} positivos` : '1 positivo'));
      let state = '';
      if (tone === 'act' || tone === 'watch') state = openN < n ? tr(`${openN} open`, `${openN} abierto(s)`) : tr('open', many ? 'abiertos' : 'abierto');
      else if (tone === 'done') state = tr('closed', many ? 'cerrados' : 'cerrado');
      else if (tone === 'unknown') state = tr('email only', 'solo correo');
      const lab = day.tally.pending > 0 ? (compact ? ` +${day.tally.pending}` : tr(` +${day.tally.pending} at lab`, ` +${day.tally.pending} en lab`)) : '';
      return (
        <button type="button" onClick={() => openDay(day.dateKey)} className={chipBtn} data-day-open={day.dateKey} title={tr('See every swab of this day', 'Ver cada hisopo de este dia')}>
          <ToneChip tone={tone} darkMode={darkMode} solid={tone === 'act' || tone === 'watch'}>{count}{state ? `, ${state}` : ''}{lab}</ToneChip>
        </button>
      );
    }
    if (day.status === 'partial') {
      return (
        <button type="button" onClick={() => openDay(day.dateKey)} className={chipBtn} data-day-open={day.dateKey} data-day-partial="1" title={tr(`No positives in the ${day.tally.swabs} results back; ${day.tally.pending} still at the lab`, `Sin positivos en los ${day.tally.swabs} resultados recibidos; ${day.tally.pending} siguen en el laboratorio`)}>
          <ToneChip tone="unknown" darkMode={darkMode}>{compact ? tr(`0/${day.tally.swabs}, ${day.tally.pending} lab`, `0/${day.tally.swabs}, ${day.tally.pending} lab`) : tr(`0 of ${day.tally.swabs}, ${day.tally.pending} at lab`, `0 de ${day.tally.swabs}, ${day.tally.pending} en lab`)}</ToneChip>
        </button>
      );
    }
    if (day.status === 'clean') {
      return (
        <button type="button" onClick={() => openDay(day.dateKey)} className={chipBtn} data-day-open={day.dateKey} title={tr(`All ${day.tally.swabs} finished swabs negative`, `Los ${day.tally.swabs} hisopos terminados negativos`)}>
          <ToneChip tone="done" darkMode={darkMode}>{compact ? tr(`${day.tally.swabs} neg`, `${day.tally.swabs} neg`) : tr(`All ${day.tally.swabs} negative`, `Los ${day.tally.swabs} negativos`)}</ToneChip>
        </button>
      );
    }
    if (day.status === 'pending') {
      return (
        <button type="button" onClick={() => openDay(day.dateKey)} className={chipBtn} data-day-open={day.dateKey}>
          <ToneChip tone="unknown" darkMode={darkMode}>{tr(`${day.tally.pending} at lab`, `${day.tally.pending} en lab`)}</ToneChip>
        </button>
      );
    }
    return <span className={`text-[10px] font-bold whitespace-nowrap ${theme.textMuted}`}>{tr('no swabs', 'sin hisopos')}</span>;
  };
  // The day's date opens its swabs too
  const dayDateButton = (day, children) => (
    <button type="button" onClick={() => openDay(day.dateKey)} disabled={day.isFuture} className="flex items-center gap-1.5 rounded hover:underline disabled:no-underline disabled:cursor-default focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]" data-day-date={day.dateKey}>
      {children}
    </button>
  );

  // One room with hits (or, in "full list" view, any room with rows) inside a day
  const renderCalendarRoomCard = (rb, isCellExpanded, showMssRows) => {
    const rKey = rb.room;
    const rMeta = ROOM_META[rKey] || ROOM_META['Zone 4 / Mobile'];
    const rHits = rb.hits || [];
    const roomTone = toneOfHits(rHits);
    return (
      <div
        key={rKey}
        className="rounded-lg border overflow-hidden"
        style={{ borderColor: darkMode ? (rMeta.borderDark || '#334155') : rMeta.border, backgroundColor: darkMode ? '#24324D' : '#FFFFFF' }}
      >
        <div
          className="px-2 py-1 flex flex-wrap items-center justify-between gap-x-1.5 gap-y-0.5 text-[10px] font-black uppercase tracking-wider"
          style={{ backgroundColor: darkMode ? rMeta.bgDark : rMeta.bgLight, color: darkMode ? (rMeta.textDark || '#F8FAFC') : rMeta.color }}
        >
          <span className="flex items-center gap-1 shrink-0">
            <span className="w-2 h-2 rounded-full shrink-0" style={{ backgroundColor: rMeta.color }} />
            <span className="whitespace-nowrap">{roomShort(rKey)}</span>
          </span>
          <div className="flex flex-wrap items-center justify-end gap-1 font-mono normal-case">
            {rb.swabs > 0 && <span className="text-[9px] opacity-90">{rb.swabs} {tr('swabs', 'hisopos')}</span>}
            {rb.pending > 0 && <ToneChip tone="unknown" darkMode={darkMode} className="!text-[9px] !px-1 !py-0">{rb.pending} {tr('at lab', 'en lab')}</ToneChip>}
            {rHits.length > 0
              ? <ToneChip tone={roomTone} darkMode={darkMode} solid={roomTone === 'act' || roomTone === 'watch'} className="!text-[9px] !px-1 !py-0">{rHits.length} {tr('pos', 'pos')}</ToneChip>
              : (rb.swabs > 0 ? <ToneChip tone="done" darkMode={darkMode} className="!text-[9px] !px-1 !py-0">0 {tr('pos', 'pos')}</ToneChip> : null)}
          </div>
        </div>

        {rHits.length > 0 && (
          <div className={`divide-y p-1.5 space-y-1.5 ${darkMode ? 'divide-slate-800/90' : 'divide-slate-100'}`}>
            {rHits.map(hit => {
              const tBadge = TEST_BADGE[hit.testType] || TEST_BADGE.LIS;
              const badgeText = hit.testType === 'LIS' ? (hit.timingStage ? `LIS ${hit.timingStage}` : 'LIS') : tBadge.short;
              const st = stateByHit[hit.id] || null;
              return (
                <div key={hit.id} className="pt-1 first:pt-0 text-[11px] leading-snug" data-cal-hit={toneOfHit(hit)}>
                  <div className="flex items-center justify-between gap-1 mb-0.5">
                    <div className="flex items-center gap-1 flex-wrap">
                      <TestBadge testType={hit.testType} label={badgeText} darkMode={darkMode} />
                      {st && <OpenStateChip item={st} darkMode={darkMode} />}
                      {!st && toneOfHit(hit) === 'plain' && <ToneChip tone="plain" darkMode={darkMode} title={tr('Before the alert window: history', 'Antes de la ventana de alertas: historial')}>{tr('History', 'Historial')}</ToneChip>}
                      {(hit.kind === 'product' || hit.kind === 'vector') && (
                        <span className={`px-1 py-px rounded text-[8px] font-black uppercase border ${theme.bgSubtle}`}>
                          {hit.kind === 'product' ? tr('product', 'producto') : tr('vector', 'vector')}
                        </span>
                      )}
                      {hit.emailOnly && (
                        <ToneChip tone="unknown" darkMode={darkMode} title={tr('Listed in the QA email; no matching lab row is loaded', 'En el correo de QA; no hay fila de laboratorio que coincida')}>
                          {tr('Email only', 'Solo correo')}
                        </ToneChip>
                      )}
                      {repeatIds[hit.id] && <ToneChip tone="act" darkMode={darkMode} title={tr('Positive before at this site, within the repeat window', 'Positivo antes en este sitio, dentro de la ventana de repetidos')}>{tr('Repeat', 'Repetido')}</ToneChip>}
                      {newIds[hit.id] && <ToneChip tone="plain" darkMode={darkMode} title={tr('New since your last visit (this computer)', 'Nuevo desde su ultima visita (esta computadora)')}>{tr('New', 'Nuevo')}</ToneChip>}
                    </div>
                    <button
                      type="button"
                      onClick={() => onLocateOnMap({ siteCode: hit.siteCode, room: hit.room, hitId: hit.id, description: hit.description })}
                      title={tr('Show this site on the facility map', 'Ver este sitio en el mapa')}
                      className={`inline-flex items-center gap-0.5 px-1.5 py-px rounded text-[9px] font-bold ${
                        darkMode ? 'bg-sky-950 text-sky-300 border border-sky-800 hover:bg-sky-900' : 'bg-[#E6F1FB] text-[#00468B] hover:bg-[#0072CE] hover:text-white'
                      }`}
                    >
                      <MapPinIcon className="w-2.5 h-2.5" /> {tr('Map', 'Mapa')}
                    </button>
                  </div>
                  <div className="font-bold break-words">
                    {hit.surface}: <span className={`font-normal ${darkMode ? 'text-slate-300' : 'text-slate-700'}`}>{hit.description}</span>
                  </div>
                  {hit.siteCode && (
                    <div className={`text-[9px] font-mono mt-0.5 ${theme.textMuted}`}>
                      {typeof onOpenSite === 'function'
                        ? <button type="button" onClick={() => onOpenSite(hit.siteCode)} className="underline font-bold" title={tr('Open the site page', 'Abrir la pagina del sitio')}>{hit.siteCode}</button>
                        : hit.siteCode}
                      {hit.assetTag ? ` - ${hit.assetTag}` : ''}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        {showMssRows && rb.rows && rb.rows.length > 0 && (
          <div className={`border-t px-1.5 py-1 space-y-1 ${darkMode ? 'border-slate-800 bg-slate-900/50' : 'border-slate-200/60 bg-slate-50/50'}`}>
            {rb.rows.slice(0, isCellExpanded ? 25 : 3).map(sr => (
              <div key={sr.id} className="text-[10px] flex items-center justify-between gap-1 truncate">
                <span className="truncate" title={`${sr.siteCode} ${sr.surface}-${sr.description}`}>
                  <b className="font-mono">{sr.siteCode || sr.scheduleId || sr.sampleId}:</b> {sr.surface} - {sr.description}
                </span>
                <ToneChip tone={rowToneOf(sr)} darkMode={darkMode} className="shrink-0 !text-[9px] !px-1 !py-0">
                  {sr.result === 'Pending' ? tr('At lab', 'En lab') : (sr.result === 'Count' ? (sr.rawResult || 'n') : (sr.result === 'Positive' ? tr('Pos', 'Pos') : tr('Neg', 'Neg')))}
                </ToneChip>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  };

  // The body of one day: rooms with positives as cards; rooms with no positive and rooms waiting on the lab as one line each
  const renderDayBody = (day, maxRoomsShown) => {
    if (day.isFuture) return null;
    const isCellExpanded = !!expandedCells[day.dateKey];
    const fullList = cellDisplayMode === 'all_mss';
    const hitBlocks = day.roomBlocks.filter(rb => rb.hits.length > 0);
    const cardBlocks = fullList ? day.roomBlocks : hitBlocks;
    const visible = cardBlocks.slice(0, isCellExpanded ? 99 : maxRoomsShown);
    const hidden = Math.max(0, cardBlocks.length - visible.length);
    const cleanRooms = fullList ? [] : day.roomBlocks.filter(rb => rb.hits.length === 0 && rb.swabs > 0);
    const pendRooms = day.roomBlocks.filter(rb => rb.pending > 0);
    return (
      <>
        {visible.length > 0 && <div className="space-y-1.5">{visible.map(rb => renderCalendarRoomCard(rb, isCellExpanded, fullList))}</div>}
        {cellDisplayMode !== 'hits' && cleanRooms.length > 0 && (
          <div className={`text-[10px] leading-snug ${darkMode ? 'text-emerald-300' : 'text-emerald-800'}`}>
            <b>{tr('No positives:', 'Sin positivos:')}</b> {cleanRooms.map(rb => `${roomShort(rb.room)} ${rb.swabs}`).join(' | ')}
          </div>
        )}
        {cellDisplayMode !== 'hits' && pendRooms.length > 0 && (
          <div className={`text-[10px] leading-snug ${theme.textMuted}`}>
            <b>{tr('Waiting on lab:', 'Esperando laboratorio:')}</b> {pendRooms.map(rb => `${roomShort(rb.room)} ${rb.pending}`).join(' | ')}
          </div>
        )}
        {(hidden > 0 || isCellExpanded) && (
          <button
            type="button"
            onClick={() => setExpandedCells(prev => ({ ...prev, [day.dateKey]: !isCellExpanded }))}
            className={`w-full text-left text-[10px] font-bold hover:underline pt-0.5 ${darkMode ? 'text-sky-300' : 'text-[#0072CE]'}`}
          >
            {isCellExpanded ? tr('Show fewer', 'Mostrar menos') : tr(`+${hidden} more room(s)`, `+${hidden} cuarto(s) mas`)}
          </button>
        )}
      </>
    );
  };

  // A day's border follows its chip: red open positive, amber open APC / ATP fail, green closed or all negative
  const dayBorder = (day) => {
    if (day.isFuture) return darkMode ? 'bg-[#1B2740]/60 border-[#33425F] opacity-70' : 'bg-slate-50/70 border-slate-200/80 opacity-80';
    const tone = day.status === 'hits' ? toneOfHits(day.hits) : (day.status === 'clean' ? 'done' : '');
    const bg = darkMode ? 'bg-[#1B2740]' : 'bg-white';
    if (tone === 'act') return `${bg} ${darkMode ? 'border-red-500/70' : 'border-red-300'}`;
    if (tone === 'watch') return `${bg} ${darkMode ? 'border-amber-500/60' : 'border-amber-300'}`;
    if (tone === 'done') return `${bg} ${darkMode ? 'border-emerald-700/60' : 'border-emerald-300'}`;
    return `${bg} ${darkMode ? 'border-[#33425F]' : 'border-slate-200'}`;
  };

  // One week (Monday to Sunday): a short header with the lab numbers, the QA email's numbers for the same week and
  // the rooms, then seven day columns
  const renderExecutiveWeekSection = (weekKey, isCurrent, daysList, ws) => {
    const t = ws.tally;
    const b = ws.b;
    const em = ws.email;
    const cmp = compareEmailWeekToLab(em, b);
    const emLis = cmp.emLis;
    const labLis = cmp.labLis;
    const showLisCompare = catMode === 'pathogen' && selectedRoomFilter === 'ALL' && (cmp.status === 'agree' || cmp.status === 'differ');
    const extras = [];
    if (b && catMode === 'pathogen' && selectedRoomFilter === 'ALL') {
      if (b.st.swabs > 0) extras.push(tr(`Start-up ${b.st.positives}/${b.st.swabs}`, `Arranque ${b.st.positives}/${b.st.swabs}`));
      if (b.inp.swabs > 0) extras.push(tr(`In-process ${b.inp.positives}/${b.inp.swabs}`, `En proceso ${b.inp.positives}/${b.inp.swabs}`));
      // Routine swabs with no start-up / in-process timing (Daily/Weekly and the like), so the split adds up to the week
      const otherSwabs = b.routine.swabs - b.st.swabs - b.inp.swabs;
      const otherPos = b.routine.positives - b.st.positives - b.inp.positives;
      if ((b.st.swabs > 0 || b.inp.swabs > 0) && otherSwabs > 0 && otherPos >= 0) extras.push(tr(`Other programs ${otherPos}/${otherSwabs}`, `Otros programas ${otherPos}/${otherSwabs}`));
      if (b.retest.swabs > 0 || b.retest.pending > 0) extras.push(tr(`Retests ${b.retest.positives} failed of ${b.retest.swabs}`, `Re-pruebas ${b.retest.positives} fallidas de ${b.retest.swabs}`));
      if (b.vector.positives > 0) extras.push(tr(`Vector ${b.vector.positives} positive`, `Vector ${b.vector.positives} positivo`));
      if (b.productTally.positives > 0) extras.push(tr(`Product ${b.productTally.positives} positive`, `Producto ${b.productTally.positives} positivo`));
      if (b.apc.swabs > 0) extras.push(`APC ${b.apc.positives}/${b.apc.swabs}`);
      if (b.atp.swabs > 0) extras.push(`ATP ${b.atp.positives}/${b.atp.swabs}`);
    }
    const emailBits = [];
    if (em) {
      if (emLis) emailBits.push(tr(`Listeria ${emLis.positives} of ${emLis.total} (${fmtPct(emLis.rate)})`, `Listeria ${emLis.positives} de ${emLis.total} (${fmtPct(emLis.rate)})`));
      if (em.summary.retests && em.summary.retests.failed > 0) emailBits.push(tr(`retests ${em.summary.retests.failed} failed`, `re-pruebas ${em.summary.retests.failed} fallidas`));
      if (em.summary.apc && em.summary.apc.total > 0) emailBits.push(`APC ${em.summary.apc.failures}/${em.summary.apc.total}`);
      if (em.summary.atp && em.summary.atp.total > 0) emailBits.push(`ATP ${em.summary.atp.failures}/${em.summary.atp.total}`);
    }
    return (
      <section className={`rounded-2xl border overflow-hidden ${theme.bgCard}`}>
        <div className={`px-3 sm:px-4 py-2.5 border-b space-y-1 ${
          isCurrent ? (darkMode ? 'bg-[#1E2A42] border-[#4DA3E8]/50' : 'bg-[#F0F6FC] border-sky-200/80') : (darkMode ? 'bg-[#1B2740] border-[#33425F]' : 'bg-slate-50 border-[#E2E8F0]')
        }`}>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span className={`px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider ${isCurrent ? 'bg-[#00468B] text-white' : 'bg-slate-700 text-white'}`}>
              {isCurrent ? tr('This week', 'Esta semana') : tr('Last week', 'Semana pasada')}
            </span>
            <h2 className="text-sm sm:text-base font-black tracking-tight">{formatWeekRangeLabel(weekKey, true)}</h2>
            <span className="text-xs font-bold">
              {catWord}: {t.swabs > 0 ? (
                <>
                  <b>{fmtPct(ws.rate)}</b> ({tr(`${t.positives} of ${t.swabs} lab swabs`, `${t.positives} de ${t.swabs} hisopos de laboratorio`)})
                  {catTarget !== null && <span className="ml-1.5 align-middle"><TargetChip rate={ws.rate} target={catTarget} darkMode={darkMode} /></span>}
                </>
              ) : (
                <span className={theme.textMuted}>{tr('no finished lab swabs', 'sin hisopos terminados')}</span>
              )}
              {t.pending > 0 && <span className={`ml-1.5 ${theme.textMuted}`} data-week-at-lab={t.pending}>{tr(`${t.pending} still at the lab: results still coming in`, `${t.pending} siguen en el laboratorio: aun llegan resultados`)}</span>}
            </span>
            {ws.totalHits > 0 && (
              <button type="button" onClick={() => setSelectedRoomFilter('ALL')} className="text-[11px] font-black underline">
                {tr(`${ws.totalHits} shown below`, `${ws.totalHits} abajo`)}{ws.emailOnlyHits > 0 ? tr(` (${ws.emailOnlyHits} from the email only)`, ` (${ws.emailOnlyHits} solo del correo)`) : ''}
              </button>
            )}
          </div>
          {extras.length > 0 && <div className={`text-[11px] font-semibold ${theme.textMuted}`}>{extras.join(' | ')}</div>}
          {emailBits.length > 0 && (
            <div className="text-[11px] font-semibold flex flex-wrap items-center gap-x-2">
              <span className={theme.textMuted}>{tr('QA email:', 'Correo de QA:')}</span>
              <span>{emailBits.join(' | ')}</span>
              {showLisCompare && cmp.status === 'differ' && (
                <button
                  type="button"
                  onClick={onOpenImportCheck}
                  className={`px-1.5 py-px rounded font-black ${darkMode ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-amber-100 text-amber-900'}`}
                >
                  {tr(
                    `lab rows differ: ${labLis.positives} of ${labLis.swabs} Listeria`,
                    `filas de laboratorio difieren: ${labLis.positives} de ${labLis.swabs} Listeria`
                  )}
                </button>
              )}
              {showLisCompare && cmp.status === 'agree' && (
                <span className={darkMode ? 'text-emerald-300' : 'text-emerald-700'}>{tr('lab rows agree', 'filas de laboratorio coinciden')}</span>
              )}
            </div>
          )}
          {ws.roomStats.length > 0 && (
            <div className="flex flex-wrap items-center gap-1 pt-0.5">
              {ws.roomStats.map(rs => {
                const isSelected = selectedRoomFilter === rs.room;
                const tone = rs.hits > 0 ? (rs.tone || 'act') : (rs.positives > 0 ? 'act' : (rs.swabs > 0 ? 'done' : 'unknown'));
                return (
                  <button
                    key={rs.room}
                    type="button"
                    onClick={() => setSelectedRoomFilter(isSelected ? 'ALL' : rs.room)}
                    title={tr(`${rs.room}: ${rs.positives} positive of ${rs.swabs} finished, ${rs.pending} pending. Tap to show only this room.`, `${rs.room}: ${rs.positives} positivos de ${rs.swabs} terminados, ${rs.pending} pendientes. Toque para ver solo este cuarto.`)}
                    data-room-chip={tone}
                    className={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-black border ${isSelected ? 'ring-2 ring-[#0072CE] ' : ''}${boloToneCls(tone, darkMode)}`}
                  >
                    <span>{roomShort(rs.room)}</span>
                    <span className="font-mono">{rs.swabs > 0 ? `${rs.positives}/${rs.swabs}` : (rs.hits > 0 ? `${rs.hits}` : tr('pend', 'pend'))}</span>
                  </button>
                );
              })}
            </div>
          )}
        </div>

        <div className="p-2 grid grid-cols-1 md:grid-cols-7 gap-2">
          {daysList.map(day => (
            <div key={day.dateKey} className={`min-h-[150px] rounded-xl border flex flex-col overflow-hidden ${day.isToday ? 'ring-2 ring-[#0072CE] ' : ''}${dayBorder(day)}`}>
              <div className={`px-2 py-1.5 border-b flex items-center justify-between gap-1 shrink-0 ${darkMode ? 'border-slate-800' : 'border-slate-200'}`}>
                <div className="flex items-center gap-1.5">
                  {dayDateButton(day, (
                    <>
                      <span className="text-[10px] font-black uppercase">{day.dow}</span>
                      <span className="text-xs font-black">{day.monthShort} {day.dayNum}</span>
                    </>
                  ))}
                  {day.isToday && <span className="px-1 py-px rounded text-[9px] font-black uppercase bg-[#0072CE] text-white">{tr('Today', 'Hoy')}</span>}
                </div>
                {statusChip(day, true)}
              </div>
              <div className="p-1.5 flex-1 space-y-1.5 overflow-y-auto">{renderDayBody(day, 4)}</div>
            </div>
          ))}
        </div>
      </section>
    );
  };

  const em = (pressureAnalysis && pressureAnalysis.executiveMetrics) || {};
  const byCat = em.byCategory || {};
  const catData = byCat[catMode] || byCat.pathogen || null;
  // What a year-to-date split leaves out, so each line adds up to the plant rate: swabs whose program has no start-up /
  // in-process timing, and swabs in rooms that are neither Creme nor Bakery. null when there are none.
  const remainderOf = (whole, parts) => {
    if (!whole || !(whole.totalSwabs > 0)) return null;
    let p = whole.positives;
    let s = whole.totalSwabs;
    parts.forEach(x => {
      p -= (x && x.positives) || 0;
      s -= (x && x.totalSwabs) || 0;
    });
    return s > 0 && p >= 0 && p <= s ? { positives: p, swabs: s, rate: round2((p / s) * 100) } : null;
  };
  const ytdOtherPrograms = catData && catData.inProcessAndStartup ? remainderOf(catData.overall, [catData.inProcessAndStartup.startup, catData.inProcessAndStartup.inp]) : null;
  const ytdOtherAreas = catData && catData.cremeAndBakery ? remainderOf(catData.overall, [catData.cremeAndBakery.creme, catData.cremeAndBakery.bakery]) : null;

  return localizeReactTree((
    <div className="h-full w-full flex flex-col overflow-hidden p-2 sm:p-3 gap-2">
      {topSlot ? <div className="shrink-0 max-h-[45vh] overflow-y-auto space-y-2" data-week-top="1">{topSlot}</div> : null}
      {/* VIEW, WEEK STEPPER AND DISPLAY */}
      <div className={`shrink-0 rounded-xl border px-3 py-2 flex flex-wrap items-center justify-between gap-2 ${theme.bgCard}`}>
        <div className="flex flex-wrap items-center gap-1">
          {[
            { id: 'exec_overview', label: tr('Last week + this week', 'Semana pasada + esta semana') },
            { id: '1w', label: tr('One week', 'Una semana') },
            { id: 'month', label: tr('Month', 'Mes') },
            { id: '8w', label: tr('8 weeks', '8 semanas') },
            { id: 'archive', label: tr('All months', 'Todos los meses') }
          ].map(tf => (
            <button
              key={tf.id}
              type="button"
              onClick={() => setTimeframeMode(tf.id)}
              className={`px-2.5 py-1 rounded-lg text-xs font-bold border ${timeframeMode === tf.id ? 'bg-[#00468B] text-white border-[#00468B]' : `${theme.bgSubtle} hover:border-[#0072CE]`}`}
            >
              {tf.label}
            </button>
          ))}
        </div>

        {timeframeMode !== 'archive' && (
          <div className="flex flex-wrap items-center gap-1.5">
            <div className={`inline-flex items-center rounded-lg border overflow-hidden ${theme.border}`}>
              <button type="button" onClick={() => stepTimeframe(-1)} className={`px-2.5 py-1 text-xs font-bold ${theme.bgSubtle}`} aria-label={tr('Earlier', 'Antes')}>
                {'<'}
              </button>
              <span className="px-2.5 py-1 text-xs font-black font-mono whitespace-nowrap">{activeRangeLabel}</span>
              <button type="button" onClick={() => stepTimeframe(1)} className={`px-2.5 py-1 text-xs font-bold ${theme.bgSubtle}`} aria-label={tr('Later', 'Despues')}>
                {'>'}
              </button>
            </div>
            <button
              type="button"
              onClick={() => { setAnchorWeek(getWeekStart(getTodayDateKey())); setMonthCursor(getTodayDateKey().slice(0, 7)); }}
              className={`px-2.5 py-1 rounded-lg text-[11px] font-black border ${isViewingLiveCurrentWeek && timeframeMode !== 'month' ? 'bg-[#00468B] text-white border-[#00468B]' : theme.bgSubtle}`}
            >
              {tr('Today', 'Hoy')} {formatShortDate(LIVE_TODAY_DATE_KEY)}
            </button>
          </div>
        )}

        <div className="flex flex-wrap items-center gap-1.5">
          {importCheck && (
            <button
              type="button"
              onClick={onOpenImportCheck}
              className={`px-2.5 py-1 rounded-lg text-[11px] font-black border ${
                importCheck.verdict === 'ok'
                  ? (darkMode ? 'bg-emerald-950/60 text-emerald-300 border-emerald-800' : 'bg-emerald-50 text-emerald-800 border-emerald-200')
                  : (darkMode ? 'bg-amber-950/60 text-amber-300 border-amber-800' : 'bg-amber-50 text-amber-900 border-amber-300')
              }`}
            >
              {importCheck.verdict === 'ok' ? tr('Import check: OK', 'Revision de carga: OK') : tr('Import check: see notes', 'Revision de carga: ver notas')}
            </button>
          )}
          <select
            value={cellDisplayMode}
            onChange={e => setCellDisplayMode(e.target.value)}
            aria-label={tr('What each day shows', 'Que muestra cada dia')}
            className={`text-xs font-bold rounded-lg px-2 py-1 border ${theme.bgInput}`}
          >
            <option value="hits">{tr('Days: positives only', 'Dias: solo positivos')}</option>
            <option value="hits_pending">{tr('Days: positives + room counts', 'Dias: positivos + conteos por cuarto')}</option>
            <option value="all_mss">{tr('Days: every swab row', 'Dias: cada fila de hisopo')}</option>
          </select>
          {logoUnlocked && undatedSummaryHits.length > 0 && (
            <button
              type="button"
              onClick={() => setShowUndatedBar(!showUndatedBar)}
              className={`px-2.5 py-1 rounded-lg text-xs font-bold border ${showUndatedBar ? 'bg-[#00468B] text-white border-[#00468B]' : theme.bgSubtle}`}
            >
              {tr(`Email lines with no date (${undatedSummaryHits.length})`, `Lineas del correo sin fecha (${undatedSummaryHits.length})`)}
            </button>
          )}
        </div>
      </div>

      {/* EMAIL LINES WITH NO DATE (retest / APC / ATP): shown on the Friday of the email's week; move one here */}
      {showUndatedBar && undatedSummaryHits.length > 0 && (
        <div className={`shrink-0 rounded-xl border px-3 py-2 ${boloToneCls('watch', darkMode)}`}>
          <div className="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
            <span className="font-semibold">
              {tr('Retest, APC and ATP lines in the QA email have no date. They show on the Friday of the email\'s week. Pick another day here.', 'Las lineas de re-prueba, APC y ATP del correo de QA no tienen fecha. Se muestran el viernes de la semana del correo. Elija otro dia aqui.')}
            </span>
            {Object.keys(dateOverrides).length > 0 && (
              <button type="button" onClick={() => setDateOverrides({})} className="text-[11px] font-bold underline text-[#0072CE] dark:text-sky-400">
                {tr('Put all back on Friday', 'Regresar todo al viernes')}
              </button>
            )}
          </div>
          <div className="flex gap-2 overflow-x-auto pb-1">
            {undatedSummaryHits.map(uh => {
              const currentAssigned = dateOverrides[uh.id] || uh.date || LIVE_LATEST_FRIDAY;
              return (
                <div key={uh.id} className={`shrink-0 rounded-lg border px-2 py-1 flex items-center gap-2 text-xs ${theme.bgCard}`}>
                  <TestBadge testType={uh.testType} darkMode={darkMode} />
                  <div className="min-w-0 max-w-[180px]">
                    <div className="font-bold truncate">{uh.room}: {uh.surface}</div>
                    <div className={`text-[10px] truncate ${theme.textMuted}`}>{uh.description}</div>
                  </div>
                  <input
                    type="date"
                    max={LIVE_TODAY_DATE_KEY}
                    value={currentAssigned}
                    onChange={e => {
                      const v = String(e.target.value || '');
                      if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
                      setDateOverrides(prev => ({ ...prev, [uh.id]: v > LIVE_TODAY_DATE_KEY ? LIVE_TODAY_DATE_KEY : v }));
                    }}
                    className={`text-[11px] font-mono font-bold rounded border px-1.5 py-0.5 ${theme.bgInput}`}
                  />
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* YEAR TO DATE, ONE LINE (lab rows; routine environmental swabs only) */}
      {catData && catData.overall && (
        <div className={`shrink-0 rounded-xl border px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 text-xs ${theme.bgCard}`}>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-0.5 min-w-0">
            <span className="font-black">{tr(em.scopeLabel || '', em.scopeLabelEs || em.scopeLabel || '')}</span>
            <span className="inline-flex flex-wrap items-center gap-1">
              {catWord} <b>{fmtPct(catData.overall.thisYearRate)}</b>
              {catData.overall.totalSwabs > 0 ? ` (${catData.overall.positives}/${catData.overall.totalSwabs})` : ''}
              {catTarget !== null && <TargetChip rate={catData.overall.thisYearRate} target={catTarget} darkMode={darkMode} />}
            </span>
            {(catData.overall.stRateTY !== null || catData.overall.inpRateTY !== null) && (
              <span className={theme.textMuted}>
                {tr('Start-up', 'Arranque')} {fmtPct(catData.overall.stRateTY)} | {tr('In-process', 'En proceso')} {fmtPct(catData.overall.inpRateTY)}
                {ytdOtherPrograms ? (
                  <span title={tr('Swabs whose program is neither start-up nor in-process (for example Daily/Weekly)', 'Hisopos cuyo programa no es de arranque ni en proceso (por ejemplo Daily/Weekly)')}>
                    {' | '}{tr('Other programs', 'Otros programas')} {fmtPct(ytdOtherPrograms.rate)}
                  </span>
                ) : null}
              </span>
            )}
            <span className={theme.textMuted}>
              {tr('Creme', 'Crema')} {fmtPct(catData.cremeAndBakery.creme.thisYearRate)} | {tr('Bakery', 'Panaderia')} {fmtPct(catData.cremeAndBakery.bakery.thisYearRate)}
              {ytdOtherAreas ? (
                <span title={tr('Swabs in neither Creme nor Bakery: Drains, Zone 4 / Mobile, 01MIX, SCM', 'Hisopos que no son de Crema ni de Panaderia: Drains, Zone 4 / Mobile, 01MIX, SCM')}>
                  {' | '}{tr('Other areas', 'Otras areas')} {fmtPct(ytdOtherAreas.rate)}
                </span>
              ) : null}
            </span>
            <span className="inline-flex flex-wrap items-center gap-1">
              <span className={theme.textMuted}>{tr('Same dates last year', 'Mismas fechas el ano pasado')} {fmtPct(catData.overall.lastYearRate)}</span>
              <LastYearChip rate={catData.overall.thisYearRate} lyRate={catData.overall.lastYearRate} darkMode={darkMode} />
            </span>
          </div>
          <div className="flex flex-wrap items-center gap-1.5">
            <select
              aria-label={tr('Results shown', 'Resultados mostrados')}
              value={catMode}
              onChange={e => setResultCategoryMode && setResultCategoryMode(e.target.value)}
              className={`text-[11px] font-black rounded-lg px-2 py-0.5 border cursor-pointer ${theme.bgInput}`}
            >
              <option value="pathogen">{tr('Listeria + Salmonella', 'Listeria + Salmonella')}</option>
              <option value="all">{tr('All tests', 'Todas las pruebas')}</option>
              <option value="apc">APC</option>
              <option value="atp">ATP</option>
            </select>
            {typeof onOpenTrends === 'function' && (
              <button type="button" onClick={onOpenTrends} data-open-trends="1" className="px-2.5 py-0.5 rounded-lg text-[11px] font-black bg-[#0072CE] text-white hover:bg-[#00468B]">
                {tr('Trends', 'Tendencias')}
              </button>
            )}
          </div>
        </div>
      )}

      {timeframeMode === 'exec_overview' ? (
        <div className="flex-1 min-h-0 overflow-y-auto space-y-3 pr-0.5 pb-32">
          {renderExecutiveWeekSection(lastWeekStart, false, lastWeekDays, execWeekStats.lastWeek)}
          {renderExecutiveWeekSection(anchorWeek, true, currentWeekDays, execWeekStats.currentWeek)}
          <div className="h-28 shrink-0" aria-hidden="true" />
        </div>
      ) : timeframeMode === 'archive' ? (
        <div className="flex-1 min-h-0 overflow-y-auto space-y-3 pr-1 pb-32">
          <div className={`rounded-xl border px-4 py-3 flex flex-wrap items-center justify-between gap-3 ${theme.bgCard}`}>
            <div>
              <h2 className={`text-base font-black ${theme.textHeading}`}>
                {tr(`${parsedCsv.totals.totalUnique.toLocaleString()} lab rows loaded`, `${parsedCsv.totals.totalUnique.toLocaleString()} filas de laboratorio cargadas`)}
              </h2>
              <p className={`text-xs ${theme.textMuted}`}>{tr('Rate = Listeria + Salmonella positives of finished routine swabs. Tap a month to open it.', 'Tasa = positivos de Listeria + Salmonella entre hisopos de rutina terminados. Toque un mes para abrirlo.')}</p>
            </div>
            {typeof onOpenDedupChecker === 'function' && (
              <button type="button" onClick={onOpenDedupChecker} className={`px-3 py-1.5 rounded-lg text-xs font-black border ${theme.bgSubtle}`}>
                {tr(`${parsedCsv.totals.totalPending} waiting on the lab`, `${parsedCsv.totals.totalPending} esperando laboratorio`)}
              </button>
            )}
          </div>
          {archiveMonths.length === 0 && (
            <div className={`rounded-xl border p-6 text-center text-sm ${theme.bgCard} ${theme.textMuted}`}>{tr('No lab rows loaded yet.', 'Aun no hay filas de laboratorio.')}</div>
          )}
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {archiveMonths.map(m => {
              const rt = m.routine || newTally();
              const mRate = tallyRate(rt);
              const mTone = mRate === null ? 'unknown' : (mRate > R.targets.pathogen ? 'watch' : 'done');
              return (
                <button
                  key={m.monthKey}
                  type="button"
                  onClick={() => { setMonthCursor(m.monthKey); setTimeframeMode('month'); }}
                  data-archive-month={mTone}
                  className={`text-left rounded-xl border border-l-4 p-3 ${theme.bgCard}`}
                  style={{ borderLeftColor: BOLO_TONES[mTone].hex }}
                >
                  <div className="flex items-center justify-between gap-2 mb-1.5">
                    <span className="font-mono font-black text-sm">{m.monthKey}</span>
                    <span className="inline-flex items-center gap-1 text-xs font-black">{fmtPct(mRate)} <TargetChip rate={mRate} target={R.targets.pathogen} darkMode={darkMode} /></span>
                  </div>
                  <div className={`text-[11px] ${theme.textMuted}`}>
                    {tr(`${rt.positives} positive of ${rt.swabs} routine swabs`, `${rt.positives} positivos de ${rt.swabs} hisopos de rutina`)}
                  </div>
                  <div className={`text-[11px] ${theme.textMuted}`}>
                    {tr(`${m.total} rows | ${m.pending} pending | ${m.positives} positive of any kind`, `${m.total} filas | ${m.pending} pendientes | ${m.positives} positivos de cualquier tipo`)}
                  </div>
                </button>
              );
            })}
          </div>
          <div className="h-28 shrink-0" aria-hidden="true" />
        </div>
      ) : (
        <div className="flex-1 min-h-0 flex flex-col overflow-hidden">
          <div className="hidden md:grid grid-cols-7 gap-2 mb-1.5 shrink-0">
            {dowNames.map(dow => (
              <div key={dow} className={`text-center py-1 rounded-lg border text-[11px] font-black uppercase tracking-widest ${darkMode ? 'bg-[#1E2A42] border-[#33425F] text-slate-200' : 'bg-slate-100 border-slate-200 text-slate-700'}`}>
                {dow}
              </div>
            ))}
          </div>
          <div className={`flex-1 min-h-0 overflow-y-auto pb-32 grid grid-cols-1 md:grid-cols-7 gap-2 ${timeframeMode === '1w' ? '' : 'auto-rows-fr'}`}>
            {calendarCells.map(cell => {
              if (cell.isPadding) return <div key={cell.key} className={`hidden md:block min-h-[110px] rounded-xl border opacity-30 ${theme.bgSubtle}`} />;
              const day = cell;
              const maxRoomsShown = timeframeMode === '1w' ? 99 : 3;
              return (
                <div key={day.dateKey} className={`${timeframeMode === '1w' ? 'min-h-[320px]' : 'min-h-[130px]'} rounded-xl border flex flex-col overflow-hidden ${day.isToday ? 'ring-2 ring-[#0072CE] ' : ''}${dayBorder(day)}`}>
                  <div className={`px-2 py-1.5 border-b flex flex-wrap items-center justify-between gap-1 shrink-0 ${darkMode ? 'border-slate-800' : 'border-slate-200'}`}>
                    {dayDateButton(day, (
                      <>
                        <span className="text-xs font-black">{day.monthShort} {day.dayNum}</span>
                        <span className={`text-[9px] font-bold uppercase ${theme.textMuted}`}>{day.dow}</span>
                      </>
                    ))}
                    {statusChip(day, timeframeMode !== '1w')}
                  </div>
                  <div className="p-1.5 flex-1 space-y-1.5 overflow-y-auto">{renderDayBody(day, maxRoomsShown)}</div>
                </div>
              );
            })}
            <div className="h-28 shrink-0 col-span-full" aria-hidden="true" />
          </div>
        </div>
      )}

    </div>
  ), ACTIVE_UI_LANG);
}

// ============================================================================
// TRENDS CHARTS (v2.5): one chart per card
// Dataverse linkage for the manager hub is unchanged: Hub config (craa5__e_hubconfigs, else craa5__0_hubconfigs),
// keys PATHOGEN_BOLO_MANAGERS_HUB_GRAPHS (snapshot, Send the numbers on Trends), PATHOGEN_BOLO_YOY_BENCHMARKS (typed
// YoY cells, Data view) and PATHOGEN_BOLO_EXEC_SYNOPSES (the notes under each chart).
// ============================================================================
// Colors checked with the dataviz palette check (light on #FFFFFF, dark on #24324D): this year blue, a second series
// magenta (both pass every check, all pairs), last year gray (de-emphasized on purpose; it passes the separation and
// contrast checks against the blue), the target a dashed amber line. Text never wears a series color: a legend names
// every series, a line's last value is written at its end, the readout under the chart gives the hovered month and
// Table shows every number.
const BOLO_CHART_COLORS = {
  light: { s1: '#2a78d6', s2: '#c2449a', ly: '#8B95A5', target: '#d97706', grid: 'rgba(100,116,139,0.20)', axis: '#94A3B8', text: '#1E293B', muted: '#64748B', surface: '#FFFFFF', hover: 'rgba(0,114,206,0.07)' },
  dark: { s1: '#3987e5', s2: '#cf56a8', ly: '#94A3B8', target: '#d97706', grid: 'rgba(148,163,184,0.18)', axis: '#64748B', text: '#E2E8F0', muted: '#94A3B8', surface: '#24324D', hover: 'rgba(77,163,232,0.12)' }
};
function boloCatWord(cat) {
  if (cat === 'apc') return 'APC';
  if (cat === 'atp') return 'ATP';
  if (cat === 'all') return tr('All tests', 'Todas las pruebas');
  return tr('Listeria + Salmonella', 'Listeria + Salmonella');
}
// A round axis top: the smallest step from the list that reaches the value in 5 ticks or fewer
function boloAxisOf(v) {
  const steps = [0.1, 0.2, 0.25, 0.5, 1, 2, 2.5, 5, 10, 20, 25, 50];
  const top = Math.max(0.1, v);
  for (let i = 0; i < steps.length; i++) {
    const k = Math.ceil(top / steps[i] - 1e-9);
    if (k <= 5) return { max: k * steps[i], step: steps[i], ticks: k };
  }
  return { max: 100, step: 25, ticks: 4 };
}
// A bar with only its top corners rounded (the data end); the base sits on the axis
function boloBarPath(x, y, w, h, r) {
  if (!(h > 0) || !(w > 0)) return '';
  const rr = Math.max(0, Math.min(r, w / 2, h));
  return `M ${x.toFixed(1)} ${(y + h).toFixed(1)} L ${x.toFixed(1)} ${(y + rr).toFixed(1)} Q ${x.toFixed(1)} ${y.toFixed(1)} ${(x + rr).toFixed(1)} ${y.toFixed(1)} L ${(x + w - rr).toFixed(1)} ${y.toFixed(1)} Q ${(x + w).toFixed(1)} ${y.toFixed(1)} ${(x + w).toFixed(1)} ${(y + rr).toFixed(1)} L ${(x + w).toFixed(1)} ${(y + h).toFixed(1)} Z`;
}
function boloPct(v) {
  return v === null || v === undefined || isNaN(v) ? '--' : `${Number(v).toFixed(2)}%`;
}
const BOLO_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function boloMonthWord(m) {
  const i = BOLO_MONTHS.indexOf(m);
  const es = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
  return i === -1 ? m : tr(m, es[i]);
}

// One SVG chart: 'bars' (grouped per month, in series order) or 'lines' (gaps where a month has no swabs, never 0%)
// Drawn at the width of its box (one unit = one pixel), so the text stays 10px on a wide screen instead of growing
// with the card; below minWidth the box scrolls sideways.
function useBoxWidth(fallback) {
  const ref = useRef(null);
  const [w, setW] = useState(fallback);
  useEffect(() => {
    const el = ref.current;
    if (!el) return undefined;
    const read = () => {
      const cw = Math.round(el.clientWidth || 0);
      if (cw > 0) setW(prev => (Math.abs(prev - cw) > 1 ? cw : prev));
    };
    read();
    let ro = null;
    if (typeof window !== 'undefined' && typeof window.ResizeObserver === 'function') {
      ro = new window.ResizeObserver(read);
      ro.observe(el);
    } else if (typeof window !== 'undefined') {
      window.addEventListener('resize', read);
    }
    return () => {
      if (ro) ro.disconnect();
      else if (typeof window !== 'undefined') window.removeEventListener('resize', read);
    };
  }, []);
  return [ref, w];
}
function BoloChartSvg({ months, series, kind, target, C, height, minWidth, activeIdx, onActive, ariaLabel }) {
  const [boxRef, boxW] = useBoxWidth(640);
  const W = Math.max(minWidth || 520, boxW);
  const H = height || 240;
  const padL = 44;
  const padR = kind === 'lines' ? 64 : 16;
  const padT = 14;
  const padB = 24;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;
  const n = Math.max(1, months.length);
  const colW = plotW / n;
  const vals = [];
  series.forEach(s => months.forEach(m => { const v = s.get(m); if (v !== null && v !== undefined) vals.push(v); }));
  if (typeof target === 'number') vals.push(target);
  const ax = boloAxisOf((vals.length ? Math.max.apply(null, vals) : 1) * 1.08);
  const dec = ax.step >= 1 ? 0 : (ax.step === 0.25 ? 2 : 1);
  const y = (v) => padT + plotH - (Math.max(0, Math.min(ax.max, v)) / ax.max) * plotH;
  const xMid = (i) => padL + i * colW + colW / 2;
  const base = padT + plotH;
  const ticks = [];
  for (let t = 0; t <= ax.ticks; t++) ticks.push(t * ax.step);

  // Line runs: a month with no value ends a run (a gap), so empty months are never drawn as 0%
  const runsOf = (s) => {
    const out = [];
    let cur = [];
    months.forEach((m, i) => {
      const v = s.get(m);
      if (v === null || v === undefined) { if (cur.length) out.push(cur); cur = []; return; }
      cur.push({ x: xMid(i), y: y(v), v, i, typed: s.typed ? s.typed(m) : false });
    });
    if (cur.length) out.push(cur);
    return out;
  };
  // End labels for lines, pushed apart so two never overlap
  const ends = [];
  if (kind === 'lines') {
    series.forEach(s => {
      const runs = runsOf(s);
      const last = runs.length ? runs[runs.length - 1][runs[runs.length - 1].length - 1] : null;
      if (last) ends.push({ s, x: last.x, y: last.y, ly: last.y, v: last.v });
    });
    ends.sort((a, b) => a.ly - b.ly);
    for (let i = 1; i < ends.length; i++) if (ends[i].ly - ends[i - 1].ly < 12) ends[i].ly = ends[i - 1].ly + 12;
  }
  const groupW = Math.min(40, colW * 0.72);
  const k = Math.max(1, series.length);
  const barW = Math.max(3, (groupW - 2 * (k - 1)) / k);

  return (
    <div ref={boxRef} className="w-full">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={ariaLabel} style={{ display: 'block' }} onMouseLeave={() => onActive && onActive(null)}>
      {ticks.map(t => (
        <g key={`t${t}`}>
          <line x1={padL} x2={W - padR} y1={y(t)} y2={y(t)} stroke={t === 0 ? C.axis : C.grid} strokeWidth="1" />
          <text x={padL - 6} y={y(t) + 3.5} textAnchor="end" fontSize="10" fill={C.muted}>{`${t.toFixed(dec)}%`}</text>
        </g>
      ))}
      {typeof activeIdx === 'number' && activeIdx >= 0 && activeIdx < n && (
        <rect x={padL + activeIdx * colW} y={padT} width={colW} height={plotH} fill={C.hover} />
      )}
      {typeof target === 'number' && (
        <g data-chart-target={target}>
          <line x1={padL} x2={W - padR} y1={y(target)} y2={y(target)} stroke={C.target} strokeWidth="2" strokeDasharray="6 4" />
          <text x={padL + 4} y={Math.max(padT + 9, y(target) - 4)} fontSize="10" fontWeight="700" fill={C.muted}>{tr(`Target ${target.toFixed(1)}%`, `Meta ${target.toFixed(1)}%`)}</text>
        </g>
      )}
      {kind === 'bars' && months.map((m, i) => (
        <g key={`b${m}`}>
          {series.map((s, si) => {
            const v = s.get(m);
            if (v === null || v === undefined) return null;
            const x0 = xMid(i) - groupW / 2 + si * (barW + 2);
            const top = y(v);
            return <path key={s.id} d={boloBarPath(x0, top, barW, Math.max(1.5, base - top), 4)} fill={s.color} opacity={s.typed && s.typed(m) ? 0.45 : 1} data-bar={s.id} />;
          })}
        </g>
      ))}
      {kind === 'lines' && series.map(s => (
        <g key={`l${s.id}`}>
          {runsOf(s).map((run, ri) => (
            <path key={ri} d={run.map((p, j) => `${j === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ')} fill="none" stroke={s.color} strokeWidth="2" strokeLinejoin="round" strokeLinecap="round" />
          ))}
          {runsOf(s).map(run => run.map(p => (
            <circle key={`${s.id}-${p.i}`} cx={p.x} cy={p.y} r={activeIdx === p.i ? 5 : 4} fill={s.color} stroke={C.surface} strokeWidth="2" data-point={s.id} />
          )))}
        </g>
      ))}
      {ends.map(e => (
        <text key={`e${e.s.id}`} x={e.x + 8} y={e.ly + 3.5} fontSize="10" fontWeight="800" fill={C.text}>{`${e.v.toFixed(2)}%`}</text>
      ))}
      {months.map((m, i) => (
        <text key={`x${m}`} x={xMid(i)} y={H - 7} textAnchor="middle" fontSize="10" fontWeight={activeIdx === i ? '800' : '600'} fill={activeIdx === i ? C.text : C.muted}>{boloMonthWord(m)}</text>
      ))}
      {months.map((m, i) => (
        <rect
          key={`h${m}`}
          x={padL + i * colW}
          y={padT}
          width={colW}
          height={plotH + padB}
          fill="transparent"
          tabIndex={0}
          aria-label={boloMonthWord(m)}
          onMouseEnter={() => onActive && onActive(i)}
          onFocus={() => onActive && onActive(i)}
          onClick={() => onActive && onActive(i)}
          style={{ cursor: 'pointer', outline: 'none' }}
        />
      ))}
    </svg>
    </div>
  );
}

// One Trends card. lens: 'overall' (the results shown by month, this year against last year, with the target),
// 'phase_split' (start-up against in-process), 'side_split' (Creme against Bakery), 'indicator_sep' (Listeria +
// Salmonella, APC and ATP side by side, each with its own target). Months run January to this month.
function BoloTrendChart({ darkMode, theme, lens, title, monthlyYoYSeries, resultCategoryMode, rules, footer }) {
  const [activeIdx, setActiveIdx] = useState(null);
  const [showTable, setShowTable] = useState(false);
  const C = BOLO_CHART_COLORS[darkMode ? 'dark' : 'light'];
  const R = normalizeBoloRules(rules);
  const Y0 = LIVE_CURRENT_YEAR;
  const nowIdx = parseInt(LIVE_TODAY_DATE_KEY.slice(5, 7), 10) - 1;
  const months = (Array.isArray(monthlyYoYSeries) ? monthlyYoYSeries : []).filter(m => m.monthIndex <= nowIdx).slice().sort((a, b) => a.monthIndex - b.monthIndex);
  const byName = {};
  months.forEach(m => { byName[m.month] = m; });
  const names = months.map(m => m.month);
  const val = (m, f) => {
    const row = byName[m];
    const v = row ? row[f] : null;
    return v === null || v === undefined || isNaN(Number(v)) ? null : Number(v);
  };
  const typed = (f) => (m) => !!(byName[m] && (byName[m].typedFields || []).indexOf(f) !== -1);
  const cat = lens === 'overall' ? (resultCategoryMode || 'pathogen') : 'pathogen';
  const pooled = (key, suf) => {
    let p = 0;
    let s = 0;
    months.forEach(m => { p += Number(m[`${key}Pos${suf}`]) || 0; s += Number(m[`${key}Swabs${suf}`]) || 0; });
    return s > 0 ? round2((p / s) * 100) : null;
  };
  const tyLy = (key) => [
    { id: `${key}LY`, label: tr(`${Y0 - 1} (last year)`, `${Y0 - 1} (ano pasado)`), color: C.ly, get: (m) => val(m, `${key}LY`), typed: typed(`${key}LY`) },
    { id: `${key}TY`, label: `${Y0}`, color: C.s1, get: (m) => val(m, `${key}TY`), typed: typed(`${key}TY`) }
  ];
  const targetOf = (c) => (c === 'all' ? null : R.targets[c]);

  // The charts this card draws
  let charts;
  if (lens === 'phase_split') {
    charts = [{ id: 'phase', kind: 'lines', series: [
      { id: 'inpTY', label: tr('In-process', 'En proceso'), color: C.s1, get: (m) => val(m, 'inpTY') },
      { id: 'stTY', label: tr('Start-up', 'Arranque'), color: C.s2, get: (m) => val(m, 'stTY') }
    ] }];
  } else if (lens === 'side_split') {
    charts = [{ id: 'side', kind: 'lines', series: [
      { id: 'cremeTY', label: tr('Creme side', 'Lado crema'), color: C.s1, get: (m) => val(m, 'cremeTY') },
      { id: 'bakeryTY', label: tr('Bakery', 'Panaderia'), color: C.s2, get: (m) => val(m, 'bakeryTY') }
    ] }];
  } else if (lens === 'indicator_sep') {
    charts = ['pathogen', 'apc', 'atp'].map(c => ({ id: c, kind: 'bars', title: boloCatWord(c), series: tyLy(c), target: targetOf(c), cat: c, small: true }));
  } else {
    charts = [{ id: 'overall', kind: 'bars', series: tyLy(cat), target: targetOf(cat), cat }];
  }
  const hasData = charts.some(ch => ch.series.some(s => names.some(m => s.get(m) !== null)));
  const anyTyped = charts.some(ch => ch.series.some(s => s.typed && names.some(m => s.typed(m))));
  const active = typeof activeIdx === 'number' && names[activeIdx] ? names[activeIdx] : (names.length ? names[names.length - 1] : null);
  const btn = `px-2 py-0.5 rounded-md text-[11px] font-black border ${theme.bgSubtle} hover:border-[#0072CE]`;

  const legendOf = (series) => (
    <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-bold" data-chart-legend="1">
      {series.map(s => (
        <span key={s.id} className="inline-flex items-center gap-1.5">
          <span className="inline-block w-3 h-3 rounded-sm" style={{ backgroundColor: s.color }} />
          <span>{s.label}</span>
        </span>
      ))}
    </div>
  );
  const readoutOf = (ch) => {
    if (!active) return null;
    const ty = ch.kind === 'bars' ? ch.series[1].get(active) : null;
    const ly = ch.kind === 'bars' ? ch.series[0].get(active) : null;
    return (
      <div className={`mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] ${theme.textMuted}`} data-chart-readout={active}>
        <span className="font-black" style={{ color: C.text }}>{boloMonthWord(active)}</span>
        {ch.series.slice().reverse().map(s => (
          <span key={s.id}><span className="font-bold">{s.label}:</span> <b style={{ color: C.text }}>{boloPct(s.get(active))}</b>{s.typed && s.typed(active) ? '*' : ''}</span>
        ))}
        {ch.kind === 'bars' && typeof ch.target === 'number' && ty !== null && <TargetChip rate={ty} target={ch.target} darkMode={darkMode} />}
        {ch.kind === 'bars' && <LastYearChip rate={ty} lyRate={ly} darkMode={darkMode} />}
      </div>
    );
  };
  const ytdOf = (ch) => {
    if (ch.kind !== 'bars') return null;
    const ty = pooled(ch.cat, 'TY');
    const ly = pooled(ch.cat, 'LY');
    return (
      <div className="flex flex-wrap items-center gap-1.5 text-[11px]">
        <span className="font-bold">{tr('Year to date', 'Ano a la fecha')} <b>{boloPct(ty)}</b></span>
        <span className={theme.textMuted}>{tr(`same months last year ${boloPct(ly)}`, `mismos meses el ano pasado ${boloPct(ly)}`)}</span>
        {typeof ch.target === 'number' && ty !== null && <TargetChip rate={ty} target={ch.target} darkMode={darkMode} />}
      </div>
    );
  };

  return localizeReactTree((
    <section className={`rounded-xl border p-3 sm:p-4 ${theme.bgCard}`} data-chart-card={lens}>
      <div className="flex flex-wrap items-start justify-between gap-2 mb-2">
        <div className="min-w-0">
          <h3 className={`text-sm font-black ${theme.textHeading}`}>{title}</h3>
          {lens === 'overall' && <div className={`text-[11px] ${theme.textMuted}`}>{boloCatWord(cat)}{cat === 'all' ? tr(' (no target for all tests together)', ' (sin meta para todas las pruebas juntas)') : ''}</div>}
        </div>
        <div className="flex flex-wrap items-center gap-2">
          {charts.length === 1 && ytdOf(charts[0])}
          {hasData && <button type="button" className={btn} onClick={() => setShowTable(v => !v)} aria-pressed={showTable} data-chart-toggle={showTable ? 'chart' : 'table'}>{showTable ? tr('Chart', 'Grafica') : tr('Table', 'Tabla')}</button>}
        </div>
      </div>
      {!hasData ? (
        <div className={`text-xs py-6 text-center ${theme.textMuted}`}>{tr('No swab results for these months yet.', 'Aun no hay resultados de hisopos para estos meses.')}</div>
      ) : showTable ? (
        <div className="overflow-x-auto">
          <table className="w-full text-xs border-collapse" data-chart-table={lens}>
            <thead>
              <tr className={theme.bgSubtle}>
                <th className="text-left py-1 px-2">{tr('Month', 'Mes')}</th>
                {charts.map(ch => ch.series.map(s => <th key={`${ch.id}-${s.id}`} className="text-right py-1 px-2">{charts.length > 1 ? `${ch.title} ` : ''}{s.label}</th>))}
              </tr>
            </thead>
            <tbody>
              {names.map(m => (
                <tr key={m} className="border-t border-slate-500/15">
                  <td className="py-1 px-2 font-bold">{boloMonthWord(m)}</td>
                  {charts.map(ch => ch.series.map(s => <td key={`${ch.id}-${s.id}`} className="py-1 px-2 text-right font-mono">{boloPct(s.get(m))}{s.typed && s.typed(m) ? '*' : ''}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div className={charts.length > 1 ? 'grid grid-cols-1 xl:grid-cols-3 gap-3' : ''}>
          {charts.map(ch => (
            <div key={ch.id} className="min-w-0" data-chart={ch.id}>
              {charts.length > 1 && (
                <div className="flex flex-wrap items-center justify-between gap-1 mb-1">
                  <span className="text-xs font-black">{ch.title}</span>
                  {ytdOf(ch)}
                </div>
              )}
              {legendOf(ch.series)}
              <div className="overflow-x-auto mt-1">
                <BoloChartSvg
                  months={names}
                  series={ch.series}
                  kind={ch.kind}
                  target={ch.target}
                  C={C}
                  height={ch.small ? 200 : 240}
                  minWidth={ch.small ? 300 : 520}
                  activeIdx={activeIdx}
                  onActive={setActiveIdx}
                  ariaLabel={`${title}${charts.length > 1 ? `: ${ch.title}` : ''}`}
                />
              </div>
              {readoutOf(ch)}
            </div>
          ))}
        </div>
      )}
      {anyTyped && <div className={`mt-1 text-[10px] ${theme.textMuted}`}>{tr('* typed in the YoY table (Data), not counted from swab rows; drawn faint.', '* escrito en la tabla YoY (Datos), no contado de filas de hisopos; se dibuja tenue.')}</div>}
      {footer ? <div className="mt-2">{footer}</div> : null}
    </section>
  ), ACTIVE_UI_LANG);
}

// ============================================================================
// [MANAGERS HUB DATAVERSE LINKAGE - TAB 4: DATA MANIPULATION LAB & BENCHMARKS]
// Edits in Mode 3 (`PATHOGEN_BOLO_YOY_BENCHMARKS`) persist directly to Dataverse
// (Hub config) and drive both Tab 3 Graphs and Managers Hub exports.
// ============================================================================
// =======================================================================
// TABLE CHECK (top of the Data Manipulation tab): does the shared swab table hold every row, and the re-upload steps
// =======================================================================
// The "_b_ Swab result" table is the record every computer and app reads; this computer's copy is only a cache. The
// panel counts both by year, saves what is missing (Save now), reads the table again, and runs a re-upload one click
// at a time: 1. clear this computer, 2. upload every lab file, 3. decide about the table rows no file brought back.
function TableCheckPanel({ darkMode, theme, canEdit, canWrite, swabDv, check, reupload, bulkProgress, onSaveNow, onReload, onStartReupload, onFinishReupload, onMarkStale, onUploadFiles }) {
  const [showYears, setShowYears] = useState(false);
  const [showSteps, setShowSteps] = useState(false);
  const [marking, setMarking] = useState(false);
  const [markDone, setMarkDone] = useState(null);
  const fileRef = useRef(null);
  if (!swabDv) return null;
  const c = check || { hereN: 0, tableN: 0, onlyTable: [], notInTable: 0, fromFiles: 0, hereByYear: {}, tableByYear: {}, failReasons: [] };
  const fmt = (n) => Number(n || 0).toLocaleString();
  const ready = swabDv.status === 'ready' && !swabDv.loading;
  const busy = !!swabDv.saving || !!swabDv.loading || !!bulkProgress || marking;
  const canRun = canEdit && canWrite && ready;

  let tone = 'ok';
  let line = '';
  if (swabDv.status === 'missing') {
    tone = 'warn';
    line = tr('The "_b_ Swab result" table is not in Dataverse yet, so swab results stay on this computer only (table prompts, Pathogen BOLO).', 'La tabla "_b_ Swab result" aun no existe en Dataverse, asi que los resultados se quedan solo en esta computadora (prompts de tablas, Pathogen BOLO).');
  } else if (swabDv.status === 'error') {
    tone = 'warn';
    line = tr(`The swab table could not be read: ${swabDv.lastError || ''}`, `No se pudo leer la tabla de hisopos: ${swabDv.lastError || ''}`);
  } else if (swabDv.status !== 'ready' || swabDv.loading) {
    tone = 'wait';
    line = tr(`Reading the swab table: ${fmt(swabDv.loaded)} rows so far.`, `Leyendo la tabla de hisopos: ${fmt(swabDv.loaded)} filas hasta ahora.`);
  } else if (swabDv.saving) {
    tone = 'wait';
    line = swabDv.marking
      ? tr(`Marking table rows replaced: ${fmt(swabDv.savedNow)} of ${fmt(swabDv.toSave)}. Keep this page open.`, `Marcando filas de la tabla como reemplazadas: ${fmt(swabDv.savedNow)} de ${fmt(swabDv.toSave)}. Mantenga esta pagina abierta.`)
      : tr(`Saving to the swab table: ${fmt(swabDv.savedNow)} of ${fmt(swabDv.toSave)} rows saved. Keep this page open until it finishes.`, `Guardando en la tabla de hisopos: ${fmt(swabDv.savedNow)} de ${fmt(swabDv.toSave)} filas guardadas. Mantenga esta pagina abierta hasta que termine.`);
  } else if (swabDv.failed > 0) {
    tone = 'bad';
    line = tr(`${fmt(swabDv.failed)} rows were not saved to the swab table. Save now tries them again.`, `${fmt(swabDv.failed)} filas no se guardaron en la tabla de hisopos. Guardar ahora las intenta otra vez.`);
  } else if (reupload) {
    tone = 'wait';
    line = tr('Re-upload in progress: the steps are below.', 'Volver a subir en curso: los pasos estan abajo.');
  } else if (c.notInTable > 0) {
    tone = 'warn';
    line = canWrite
      ? tr(`${fmt(c.notInTable)} rows on this computer are not in the swab table yet. Save now sends them.`, `${fmt(c.notInTable)} filas de esta computadora aun no estan en la tabla de hisopos. Guardar ahora las envia.`)
      : tr(`${fmt(c.notInTable)} rows on this computer are not in the swab table (only people who load lab data can save them).`, `${fmt(c.notInTable)} filas de esta computadora no estan en la tabla de hisopos (solo quien carga datos del laboratorio puede guardarlas).`);
  } else if (c.onlyTable.length > 0) {
    tone = 'warn';
    line = tr(`${fmt(c.onlyTable.length)} rows in the swab table are not on this computer. Read the table again to load them.`, `${fmt(c.onlyTable.length)} filas de la tabla de hisopos no estan en esta computadora. Lea la tabla otra vez para cargarlas.`);
  } else if (c.tableN === 0) {
    tone = 'wait';
    line = tr('The swab table is empty and no lab rows are loaded. Upload the lab files to start.', 'La tabla de hisopos esta vacia y no hay filas del laboratorio cargadas. Suba los archivos del laboratorio para empezar.');
  } else {
    line = tr(`The swab table and this computer hold the same ${fmt(c.tableN)} rows. Opening the page loads them from the table, so there is nothing to re-upload.`, `La tabla de hisopos y esta computadora tienen las mismas ${fmt(c.tableN)} filas. Al abrir la pagina se cargan de la tabla, asi que no hay nada que volver a subir.`);
  }
  const toneCls = {
    ok: darkMode ? 'bg-emerald-950/60 text-emerald-300 border-emerald-800' : 'bg-emerald-50 text-emerald-800 border-emerald-200',
    warn: darkMode ? 'bg-amber-950/40 text-amber-200 border-amber-800' : 'bg-amber-50 text-amber-900 border-amber-200',
    bad: darkMode ? 'bg-red-950/50 text-red-200 border-red-800' : 'bg-red-50 text-red-800 border-red-200',
    wait: darkMode ? 'bg-slate-800 text-slate-200 border-slate-600' : 'bg-slate-100 text-slate-700 border-slate-300'
  }[tone];
  const chip = {
    ok: tr('Table complete', 'Tabla completa'),
    warn: tr('Needs a look', 'Necesita revision'),
    bad: tr('Not saved', 'Sin guardar'),
    wait: tr('Working', 'Trabajando')
  }[tone];
  const years = {};
  Object.keys(c.tableByYear || {}).forEach(y => { years[y] = true; });
  Object.keys(c.hereByYear || {}).forEach(y => { years[y] = true; });
  const yearList = Object.keys(years).sort().reverse();
  const stepsOpen = showSteps || !!reupload || !!markDone;
  const btn = `px-2.5 py-1 rounded-lg text-xs font-black border ${theme.bgSubtle} disabled:opacity-50`;
  const btnMain = 'px-2.5 py-1 rounded-lg text-xs font-black bg-[#00468B] text-white disabled:opacity-50';
  const markAndFinish = async () => {
    setMarking(true);
    setMarkDone(null);
    try {
      const res = await onMarkStale(c.onlyTable);
      setMarkDone(res);
      if (res && res.ok) onFinishReupload(false);
    } finally {
      setMarking(false);
    }
  };
  const uploadInput = (
    <input
      ref={fileRef}
      type="file"
      multiple
      accept=".csv,.tsv,.txt"
      className="hidden"
      onChange={e => {
        onUploadFiles(e.target.files);
        e.target.value = '';
      }}
    />
  );

  return (
    <section className={`rounded-2xl border shadow-xs ${theme.bgCard}`} data-table-check="1">
      <div className="px-4 py-3 flex flex-wrap items-center justify-between gap-2">
        <div className="flex flex-wrap items-center gap-2 min-w-0">
          <h2 className={`text-base font-black ${theme.textHeading}`}>{tr('Table check', 'Revision de la tabla')}</h2>
          <span className={`px-2 py-0.5 rounded-full text-[11px] font-black border ${toneCls}`}>{chip}</span>
          <span className={`text-xs ${theme.textMuted}`}>
            {tr(`Swab table: ${fmt(c.tableN)} rows | This computer: ${fmt(c.hereN)} rows`, `Tabla de hisopos: ${fmt(c.tableN)} filas | Esta computadora: ${fmt(c.hereN)} filas`)}
          </span>
        </div>
        <div className="flex flex-wrap items-center gap-1.5">
          {canWrite && (
            <button type="button" className={btn} disabled={!ready || busy} onClick={() => onSaveNow()} data-table-save="1">
              {tr('Save now', 'Guardar ahora')}
            </button>
          )}
          <button type="button" className={btn} disabled={busy || !!reupload || swabDv.status === 'missing'} onClick={() => onReload()} data-table-reload="1">
            {tr('Read the table again', 'Leer la tabla otra vez')}
          </button>
          <button type="button" className={btn} onClick={() => setShowYears(v => !v)} aria-expanded={showYears}>
            {showYears ? tr('Hide years', 'Ocultar anos') : tr('By year', 'Por ano')}
          </button>
        </div>
      </div>
      <p className="px-4 -mt-1 pb-3 text-sm font-semibold" data-table-line="1">{line}</p>
      {swabDv.foreignCount > 0 && (
        <div className="px-4 -mt-1 pb-3 flex flex-wrap items-start gap-2 text-xs" data-table-foreign={swabDv.foreignCount}>
          <ToneChip tone="watch" darkMode={darkMode}>{tr('Needs a look', 'Necesita revision')}</ToneChip>
          <span className="min-w-0 flex-1">
            {tr(
              `${fmt(swabDv.foreignCount)} row(s) in the swab table have no Source, so this app did not save them: most likely the sample rows Copilot adds when it makes a table. They are left out of every number and every screen. Delete them in Dataverse (Tables, _b_ Swab result, rows with Source empty).`,
              `${fmt(swabDv.foreignCount)} fila(s) de la tabla de hisopos no tienen Source, asi que esta app no las guardo: lo mas seguro es que sean las filas de ejemplo que Copilot agrega al crear una tabla. Se dejan fuera de cada numero y cada pantalla. Borrelas en Dataverse (Tablas, _b_ Swab result, filas con Source vacio).`
            )}
            {(swabDv.foreign || []).length > 0 && (
              <span className={`block mt-0.5 font-mono text-[11px] ${theme.textMuted}`} data-no-translate="1">
                {(swabDv.foreign || []).slice(0, 12).map(f => `${f.sampleId || f.id.slice(0, 8)}${f.date ? ` (${f.date})` : ''}`).join(', ')}
              </span>
            )}
          </span>
        </div>
      )}
      {c.failReasons.length > 0 && !swabDv.saving && (
        <ul className="px-4 pb-3 -mt-1 space-y-0.5" data-no-translate="1">
          {c.failReasons.map((f, i) => (
            <li key={i} className="text-[11px] font-mono break-all">{`${fmt(f.n)} x ${f.why}`}</li>
          ))}
        </ul>
      )}
      {showYears && yearList.length > 0 && (
        <div className="px-4 pb-3">
          <table className="text-xs">
            <thead>
              <tr className={theme.textMuted}>
                <th className="text-left pr-6 font-black">{tr('Year', 'Ano')}</th>
                <th className="text-right pr-6 font-black">{tr('Swab table', 'Tabla de hisopos')}</th>
                <th className="text-right font-black">{tr('This computer', 'Esta computadora')}</th>
              </tr>
            </thead>
            <tbody>
              {yearList.map(y => (
                <tr key={y}>
                  <td className="pr-6 font-bold">{y === '?' ? tr('No date', 'Sin fecha') : y}</td>
                  <td className="text-right pr-6 font-mono">{fmt((c.tableByYear || {})[y])}</td>
                  <td className="text-right font-mono">{fmt((c.hereByYear || {})[y])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {canEdit && (
        <div className="px-4 pb-4">
          <div className={`rounded-xl border px-3 py-2.5 ${theme.bgSubtle}`}>
            <div className="flex flex-wrap items-center justify-between gap-2">
              <button type="button" onClick={() => setShowSteps(v => !v)} className="text-sm font-black" aria-expanded={stepsOpen}>
                {tr('Re-upload every lab file', 'Volver a subir cada archivo del laboratorio')}
              </button>
              {!reupload && (
                <span className="flex flex-wrap items-center gap-1.5">
                  <button type="button" className={btn} disabled={!!bulkProgress} onClick={() => { if (fileRef.current) fileRef.current.click(); }} data-table-upload="1">
                    {tr('Upload lab files (adds to what is loaded)', 'Subir archivos del laboratorio (se suman a lo cargado)')}
                  </button>
                </span>
              )}
            </div>
            {uploadInput}
            {stepsOpen && (
              <div className="mt-2 space-y-2 text-xs">
                <p className={theme.textMuted}>
                  {tr('Only needed when the Import check asks for it, or the numbers look wrong. Save each lab export as CSV first (Excel: File, Save As, CSV). The swab table is changed only at step 3, and only by your click.', 'Solo hace falta cuando la Revision de carga lo pide o los numeros se ven mal. Primero guarde cada exportacion del laboratorio como CSV (Excel: Archivo, Guardar como, CSV). La tabla de hisopos solo cambia en el paso 3 y solo con su clic.')}
                </p>
                <ol className="list-decimal pl-5 space-y-2">
                  <li>
                    {reupload ? (
                      <span className="font-bold">{tr(`Done: this computer's lab rows are cleared. The swab table still holds its ${fmt(reupload.tableAtStart)} rows.`, `Listo: se borraron las filas del laboratorio de esta computadora. La tabla de hisopos sigue con sus ${fmt(reupload.tableAtStart)} filas.`)}</span>
                    ) : (
                      <span>
                        {tr('Clear the lab rows on this computer (the QA emails stay):', 'Borrar las filas del laboratorio de esta computadora (los correos de QA se quedan):')}{' '}
                        <ConfirmButton
                          label={tr('Start re-upload', 'Empezar a volver a subir')}
                          question={tr(`Clear the ${fmt(c.hereN)} lab rows on this computer and upload every lab file again? The swab table is not changed now.`, `Borrar las ${fmt(c.hereN)} filas del laboratorio de esta computadora y subir otra vez cada archivo? La tabla de hisopos no cambia ahora.`)}
                          yesLabel={tr('Yes, start', 'Si, empezar')}
                          disabled={!canRun || busy}
                          onConfirm={onStartReupload}
                          className="ml-1 px-2 py-0.5 rounded-lg text-[11px] font-black border border-amber-400 bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-700 disabled:opacity-50"
                        />
                        {!ready && <span className={`ml-2 ${theme.textMuted}`}>{tr('(waits for the swab table to load)', '(espera a que cargue la tabla de hisopos)')}</span>}
                      </span>
                    )}
                  </li>
                  <li>
                    {tr('Upload every lab file (pick several at once):', 'Suba cada archivo del laboratorio (puede elegir varios a la vez):')}{' '}
                    <button type="button" className={btnMain} disabled={!reupload || !!bulkProgress} onClick={() => { if (fileRef.current) fileRef.current.click(); }} data-reupload-upload="1">
                      {tr('Upload lab files', 'Subir archivos del laboratorio')}
                    </button>
                    {bulkProgress && <div className={`mt-1 font-bold ${theme.textMuted}`}>{bulkProgress.label}</div>}
                    {reupload && c.hereN > 0 && !bulkProgress && (
                      <div className="mt-1" data-reupload-files="1">
                        {tr(`Your files hold ${fmt(c.hereN)} rows: ${fmt(c.fromFiles)} were already in the swab table, ${fmt(Math.max(0, c.hereN - c.fromFiles))} are new.`, `Sus archivos tienen ${fmt(c.hereN)} filas: ${fmt(c.fromFiles)} ya estaban en la tabla de hisopos y ${fmt(Math.max(0, c.hereN - c.fromFiles))} son nuevas.`)}
                        {swabDv.saving && !swabDv.marking ? ` ${tr(`Saving: ${fmt(swabDv.savedNow)} of ${fmt(swabDv.toSave)}.`, `Guardando: ${fmt(swabDv.savedNow)} de ${fmt(swabDv.toSave)}.`)}` : ''}
                      </div>
                    )}
                  </li>
                  <li>
                    {!reupload || c.hereN === 0 || busy ? (
                      <span className={theme.textMuted}>{tr('When the files are in and saved: decide about the swab table rows none of your files holds.', 'Cuando los archivos esten cargados y guardados: decida que hacer con las filas de la tabla de hisopos que ningun archivo tiene.')}</span>
                    ) : c.onlyTable.length === 0 ? (
                      <span>
                        <span className="font-bold">{tr('Every swab table row is in your files.', 'Cada fila de la tabla de hisopos esta en sus archivos.')}</span>{' '}
                        <button type="button" className={btnMain} onClick={() => onFinishReupload(false)} data-reupload-finish="1">{tr('Finish', 'Terminar')}</button>
                      </span>
                    ) : (
                      <span className="block space-y-1.5" data-reupload-stale="1">
                        <span className="block font-bold">
                          {tr(`${fmt(c.onlyTable.length)} swab table rows are in none of your files: rows an older version misread, or lab files you have not uploaded again.`, `${fmt(c.onlyTable.length)} filas de la tabla de hisopos no estan en ninguno de sus archivos: filas que una version anterior leyo mal, o archivos del laboratorio que no ha vuelto a subir.`)}
                        </span>
                        <span className="flex flex-wrap items-center gap-1.5">
                          <ConfirmButton
                            label={tr(`Mark these ${fmt(c.onlyTable.length)} rows replaced`, `Marcar estas ${fmt(c.onlyTable.length)} filas como reemplazadas`)}
                            question={tr(`Mark ${fmt(c.onlyTable.length)} swab table rows replaced? Nothing is deleted; no app counts them after this. A later upload of a file that holds one brings it back.`, `Marcar ${fmt(c.onlyTable.length)} filas de la tabla de hisopos como reemplazadas? No se borra nada; ninguna app las cuenta despues. Si despues sube un archivo que tenga una, esa fila regresa.`)}
                            yesLabel={tr('Yes, mark them', 'Si, marcarlas')}
                            disabled={!canRun || busy}
                            onConfirm={markAndFinish}
                            className="px-2 py-0.5 rounded-lg text-[11px] font-black border border-amber-400 bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-700 disabled:opacity-50"
                          />
                          <button type="button" className={btn} disabled={busy} onClick={() => onFinishReupload(true)} data-reupload-keep="1">
                            {tr('Keep them (load them back)', 'Conservarlas (cargarlas otra vez)')}
                          </button>
                        </span>
                      </span>
                    )}
                    {markDone && !markDone.ok && (
                      <div className="mt-1 font-bold text-red-700 dark:text-red-300">
                        {tr(`${fmt(markDone.failed)} rows were not marked. Try the button again.`, `${fmt(markDone.failed)} filas no se marcaron. Intente el boton otra vez.`)}
                      </div>
                    )}
                  </li>
                </ol>
                {reupload && (
                  <div>
                    <button type="button" className={btn} disabled={busy} onClick={() => onFinishReupload(true)} data-reupload-cancel="1">
                      {tr('Cancel the re-upload (load the swab table back)', 'Cancelar (cargar otra vez la tabla de hisopos)')}
                    </button>
                  </div>
                )}
                {markDone && markDone.ok && !reupload && (
                  <div className="font-bold" data-reupload-done="1">
                    {tr(`Re-upload finished: ${fmt(markDone.marked)} rows no file holds were marked replaced. The swab table now matches your files.`, `Volver a subir terminado: ${fmt(markDone.marked)} filas que ningun archivo tiene se marcaron como reemplazadas. La tabla de hisopos ahora coincide con sus archivos.`)}
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      )}
    </section>
  );
}

// =======================================================================
// TARGETS AND ALERT RULES (Data Manipulation tab): the numbers from Gerald's answers, editable, saved in Hub config
// =======================================================================
function RulesPanel({ darkMode, theme, canEdit, rules, saved, onSave }) {
  const cur = normalizeBoloRules(rules);
  const curKey = JSON.stringify(cur);
  const toDraft = (x) => ({ pathogen: String(x.targets.pathogen), apc: String(x.targets.apc), atp: String(x.targets.atp), repeatDays: String(x.repeatDays), alertMonths: String(x.alertMonths), closeDays: String(x.closeDays) });
  const [draft, setDraft] = useState(() => toDraft(cur));
  const [msg, setMsg] = useState(null);
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(toDraft(normalizeBoloRules(rules))); }, [curKey]);
  const fields = [
    { k: 'pathogen', label: tr('Pathogen target (%)', 'Meta de patogenos (%)'), help: tr('Listeria and Salmonella routine swabs', 'Hisopos de rutina de Listeria y Salmonella'), step: '0.1' },
    { k: 'apc', label: tr('APC target (%)', 'Meta de APC (%)'), help: tr('APC swabs that fail', 'Hisopos de APC que fallan'), step: '0.1' },
    { k: 'atp', label: tr('ATP target (%)', 'Meta de ATP (%)'), help: tr('ATP swabs that fail', 'Hisopos de ATP que fallan'), step: '0.1' },
    { k: 'repeatDays', label: tr('Repeat window (days)', 'Ventana de repeticion (dias)'), help: tr('Two hits at one site this close together is a repeat', 'Dos positivos en un sitio con esta cercania es una repeticion'), step: '1' },
    { k: 'alertMonths', label: tr('Alert window (months)', 'Ventana de alertas (meses)'), help: tr('Alerts and open positives look back this far', 'Las alertas y los positivos abiertos miran hasta aqui'), step: '1' },
    { k: 'closeDays', label: tr('Overdue after (days)', 'Atrasado despues de (dias)'), help: tr('A positive with no clean this many days after the swab shows as Overdue', 'Un positivo sin limpieza estos dias despues del hisopo se muestra como Atrasado'), step: '1' }
  ];
  const notNumber = fields.filter(f => isNaN(parseFloat(draft[f.k])));
  const next = normalizeBoloRules({ targets: { pathogen: draft.pathogen, apc: draft.apc, atp: draft.atp }, repeatDays: draft.repeatDays, alertMonths: draft.alertMonths, closeDays: draft.closeDays });
  const changed = notNumber.length === 0 && JSON.stringify(next) !== curKey;
  const save = async () => {
    setSaving(true);
    setMsg(null);
    try {
      await onSave(next);
      setMsg({ ok: true, text: tr('Saved. Every computer that opens the app uses these numbers.', 'Guardado. Cada computadora que abre la app usa estos numeros.') });
    } catch (e) {
      setMsg({ ok: false, text: tr(`Not saved: ${e.message}`, `No se guardo: ${e.message}`) });
    } finally {
      setSaving(false);
    }
  };
  const input = `w-full mt-1 px-2 py-1 rounded-lg border font-mono text-sm ${darkMode ? 'bg-slate-900 border-slate-700 text-slate-100' : 'bg-white border-slate-300 text-slate-900'}`;
  return (
    <section className={`rounded-2xl border shadow-xs ${theme.bgCard}`} data-rules="1">
      <div className="px-4 pt-3 pb-2">
        <h2 className={`text-base font-black ${theme.textHeading}`}>{tr('Targets and alert rules', 'Metas y reglas de alertas')}</h2>
        <p className={`text-xs ${theme.textMuted}`} data-rules-saved={saved && saved.at ? '1' : ''}>
          {saved && saved.at
            ? tr(`Saved ${String(saved.at).slice(0, 10)}${saved.by ? ` by ${saved.by}` : ''}. The graphs, the headline cards, the alerts and the open positives use these numbers.`, `Guardado el ${String(saved.at).slice(0, 10)}${saved.by ? ` por ${saved.by}` : ''}. Las graficas, las tarjetas principales, las alertas y los positivos abiertos usan estos numeros.`)
            : tr('Not saved yet: these are the numbers from your answers (2.0% pathogen, 5% APC and ATP, two hits within 3 weeks, alerts over 2 months), plus Overdue after 7 days (a default: change it if the plant uses another limit). Save them to share them with every computer.', 'Aun no se guardan: son los numeros de sus respuestas (2.0% patogenos, 5% APC y ATP, dos positivos en 3 semanas, alertas de 2 meses), mas Atrasado despues de 7 dias (un valor por defecto: cambielo si la planta usa otro limite). Guardelos para compartirlos con cada computadora.')}
        </p>
      </div>
      <div className="px-4 pb-3 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
        {fields.map(f => (
          <label key={f.k} className="block font-bold">
            {f.label}
            <input
              type="number"
              inputMode="decimal"
              step={f.step}
              min="0"
              className={input}
              value={draft[f.k]}
              disabled={!canEdit || saving}
              onChange={e => { const v = e.target.value; setDraft(d => ({ ...d, [f.k]: v })); setMsg(null); }}
              data-rule={f.k}
            />
            <span className={`block mt-0.5 font-normal text-[11px] ${theme.textMuted}`}>{f.help}</span>
          </label>
        ))}
      </div>
      {canEdit && (
        <div className="px-4 pb-4 flex flex-wrap items-center gap-2 text-xs">
          <button type="button" onClick={save} disabled={!changed || saving} className="px-3 py-1.5 rounded-lg font-black bg-[#00468B] text-white disabled:opacity-50" data-rules-save="1">
            {saving ? tr('Saving...', 'Guardando...') : tr('Save targets and rules', 'Guardar metas y reglas')}
          </button>
          {notNumber.length > 0 && <span className="font-bold text-amber-700 dark:text-amber-300">{tr('Each box needs a number.', 'Cada casilla necesita un numero.')}</span>}
          {msg && (
            <span className={`font-bold ${msg.ok ? 'text-emerald-700 dark:text-emerald-300' : 'text-red-700 dark:text-red-300'}`} data-rules-msg={msg.ok ? 'ok' : 'bad'}>{msg.text}</span>
          )}
        </div>
      )}
    </section>
  );
}

// =======================================================================
// IMPORT CHECK PANEL (top of the Data Manipulation tab)
// =======================================================================
// Words for each Import check item: what was found, why it matters, and what fixes it
function importCheckText(item) {
  const n = item.n;
  const r = item.report || {};
  // Singular wording when the count is 1
  const one = (single, plural) => (n === 1 ? single : plural);
  switch (item.id) {
    case 'reupload_rows':
      return {
        title: one(tr('1 saved row holds two tests in one row', '1 fila guardada tiene dos pruebas en una sola fila'), tr(`${n} saved rows hold two tests in one row`, `${n} filas guardadas tienen dos pruebas en una sola fila`)),
