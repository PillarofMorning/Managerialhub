    .slice().reverse(), [allHits, openPositives.since]);
  // New since the last visit (this computer): every hit of the alert window, compared once the swab table answered
  const newSinceKeys = useMemo(() => allHits.filter(h => h.date && h.date >= openPositives.since).map(h => h.id), [allHits, openPositives.since]);
  const newSince = useNewSinceLastVisit(newSinceKeys, swabLink.swabDv.status !== 'probing' && !swabLink.swabDv.loading);
  // The state of each hit for its map pin: open (red; an APC / ATP fail amber unless overdue), email only (gray),
  // closed (green), before the alert window (hollow: history)
  const hitToneById = useMemo(() => {
    const m = {};
    allHits.forEach(h => {
