function exampleRowSig(sampleId, sampleDesc) {
  return hubIdFromKey(`bolo-example|${String(sampleId || '').trim().toUpperCase()}|${String(sampleDesc || '').trim().replace(/\s+/g, ' ').toUpperCase()}`).slice(0, 13);
