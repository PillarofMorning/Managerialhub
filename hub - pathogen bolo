// ---------- Sites: one page per swab site ----------
// The list puts the sites that need someone first: an open positive (overdue first), then repeat sites, then email
// lines with no lab row yet, then the sites with the most positives. A site page holds every result (newest first,
// retests included), the MSS area and equipment it is linked to, its last cleans in the MSS log, its harborage notes
// and its saved next step.
const SITE_LIST_LIMIT = 150;
function siteStepOf(suggestedActionsMap, code) {
  const m = suggestedActionsMap || {};
  if (!code) return null;
  if (m[code]) return m[code];
  if (m[`pp-site-${code}`]) return m[`pp-site-${code}`];
  const pre = `pp-site-${code}-`;
  const k = Object.keys(m).filter(x => x.indexOf(pre) === 0)[0];
  return k ? m[k] : null;
}
function SitesView({
  darkMode, theme, fullSiteCatalog, ledgerRows, allHits, open, repeatStreaks, newSince, swabLink, harborageConcerns,
  suggestedActionsMap, focusSite, onFocusSite, onLocateOnMap, onOpenSection
}) {
  const [query, setQuery] = useState('');
  const [filter, setFilter] = useState('attention');
  const since = open ? open.since : alertSinceOf(null);

  const bySite = useMemo(() => {
    const m = {};
    (ledgerRows || []).forEach(r => {
      if (!r || !r.siteCode) return;
      const g = m[r.siteCode] || (m[r.siteCode] = { rows: [], swabs: 0, positives: 0, pending: 0, last: '' });
      g.rows.push(r);
      g.swabs += 1;
      if (r.result === 'Positive') g.positives += 1;
      else if (r.result === 'Pending') g.pending += 1;
      if (r.date && r.date > g.last) g.last = r.date;
    });
    return m;
  }, [ledgerRows]);
  const openBySite = useMemo(() => {
    const m = {};
    ((open && open.open) || []).forEach(x => {
      const code = x.r.siteCode;
      if (!code) return;
      const g = m[code] || (m[code] = { n: 0, overdue: 0, act: 0, oldest: x });
      g.n += 1;
      if (x.overdue) g.overdue += 1;
      if (openItemTone(x) === 'act') g.act += 1;
      if ((x.daysOpen || 0) > (g.oldest.daysOpen || 0)) g.oldest = x;
    });
    return m;
  }, [open]);
  const repeatBySite = useMemo(() => {
    const m = {};
    (repeatStreaks || []).forEach(s => {
      if (s.siteCode && s.lastDate && s.lastDate >= since && !m[s.siteCode]) m[s.siteCode] = s;
    });
    return m;
  }, [repeatStreaks, since]);
  const emailBySite = useMemo(() => {
    const m = {};
    (allHits || []).forEach(h => {
      if (!h.emailOnly || !h.siteCode) return;
      (m[h.siteCode] || (m[h.siteCode] = [])).push(h);
    });
    return m;
  }, [allHits]);
  const newBySite = useMemo(() => {
    const m = {};
    (allHits || []).forEach(h => { if (h.siteCode && newSince && newSince[h.id]) m[h.siteCode] = true; });
    return m;
  }, [allHits, newSince]);

  const entries = useMemo(() => {
    const byCode = {};
    (fullSiteCatalog || []).forEach(s => { if (s && s.siteCode) byCode[s.siteCode] = s; });
    Object.keys(bySite).forEach(code => {
      if (byCode[code]) return;
      const r = bySite[code].rows[0];
      byCode[code] = { siteCode: code, room: r.room, surface: r.surface, description: r.description, assetTag: r.assetTag };
    });
    Object.keys(emailBySite).forEach(code => {
      if (byCode[code]) return;
      const h = emailBySite[code][0];
      byCode[code] = { siteCode: code, room: h.room, surface: h.surface, description: h.description, assetTag: h.assetTag };
    });
    return Object.keys(byCode).map(code => {
      const g = bySite[code] || null;
      const o = openBySite[code] || null;
      const rep = repeatBySite[code] || null;
      const email = emailBySite[code] || null;
      // Most urgent first, as on This week: overdue, an open pathogen positive (red), only APC / ATP fails open (amber),
      // a repeat site, an email line with no lab row; then the rest
      let rank = 9;
      if (o && o.overdue > 0) rank = 0;
      else if (o && o.act > 0) rank = 1;
      else if (o) rank = 2;
      else if (rep) rank = 3;
      else if (email && email.some(h => h.date && h.date >= since)) rank = 4;
      else if (g && g.positives > 0) rank = 5;
      else if (g) rank = 6;
      return { s: byCode[code], g, o, rep, email, isNew: !!newBySite[code], rank };
    });
  }, [fullSiteCatalog, bySite, openBySite, repeatBySite, emailBySite, newBySite, since]);

  const focused = focusSite ? (entries.filter(e => e.s.siteCode === focusSite)[0] || null) : null;
  if (focusSite) {
    return (
      <SitePage
        darkMode={darkMode}
        theme={theme}
        code={focusSite}
        entry={focused}
        open={open}
        newSince={newSince}
        swabLink={swabLink}
        harborageConcerns={harborageConcerns}
        suggestedActionsMap={suggestedActionsMap}
        onBack={() => onFocusSite('')}
        onLocateOnMap={onLocateOnMap}
        onOpenSection={onOpenSection}
      />
    );
  }

  const q = query.trim().toLowerCase();
  const shownAll = entries.filter(e => {
    if (filter === 'attention' && e.rank > 4) return false;
    if (filter === 'results' && !e.g && !e.email) return false;
    if (!q) return true;
    const s = e.s;
    return `${s.siteCode} ${s.room} ${(ROOM_META[s.room] && ROOM_META[s.room].label) || ''} ${s.surface} ${s.description} ${s.assetTag || ''}`.toLowerCase().indexOf(q) !== -1;
  }).sort((a, b) => (a.rank - b.rank)
    || (((b.o && b.o.oldest.daysOpen) || 0) - ((a.o && a.o.oldest.daysOpen) || 0))
    || (((b.g && b.g.positives) || 0) - ((a.g && a.g.positives) || 0))
    || String((b.g && b.g.last) || '').localeCompare(String((a.g && a.g.last) || ''))
    || String(a.s.siteCode).localeCompare(String(b.s.siteCode)));
  const shown = shownAll.slice(0, SITE_LIST_LIMIT);
  const attentionCount = entries.filter(e => e.rank <= 4).length;
  const filters = [
    ['attention', tr(`Need someone (${attentionCount})`, `Necesitan a alguien (${attentionCount})`)],
    ['results', tr('With results', 'Con resultados')],
    ['all', tr(`All sites (${entries.length})`, `Todos los sitios (${entries.length})`)]
  ];
  return localizeReactTree((
    <div className="h-full overflow-y-auto p-3 sm:p-4 pb-32 space-y-3" data-view-body="sites">
      <div className={`rounded-xl border p-3 flex flex-wrap items-center justify-between gap-2 ${theme.bgCard}`}>
        <div className="min-w-0">
          <h2 className={`text-sm sm:text-base font-black ${theme.textHeading}`}>{tr('Swab sites', 'Sitios de hisopo')}</h2>
          <p className={`text-[11px] ${theme.textMuted}`}>{tr(`Open positives first (overdue first), then repeat sites and email lines with no lab row, since ${formatShortDate(since)}. Press a site to see every result.`, `Primero los positivos abiertos (los atrasados primero), luego los sitios repetidos y las lineas del correo sin fila del laboratorio, desde el ${formatShortDate(since)}. Presione un sitio para ver cada resultado.`)}</p>
        </div>
        <div className="flex flex-wrap items-center gap-1.5">
          <input
            type="search"
            value={query}
            onChange={e => setQuery(e.target.value)}
            placeholder={tr('Site code, surface, room...', 'Codigo de sitio, superficie, cuarto...')}
            aria-label={tr('Search sites', 'Buscar sitios')}
            className={`w-56 rounded-lg border px-2.5 py-1 text-xs ${theme.bgInput}`}
          />
          <div className="inline-flex rounded-lg border overflow-hidden text-[11px] font-black" role="group" aria-label={tr('Which sites', 'Que sitios')}>
            {filters.map(f => (
              <button key={f[0]} type="button" onClick={() => setFilter(f[0])} aria-pressed={filter === f[0]} data-site-filter={f[0]} className={`px-2.5 py-1 ${filter === f[0] ? 'bg-[#0072CE] text-white' : theme.bgSubtle}`}>{f[1]}</button>
            ))}
          </div>
        </div>
      </div>
      {shown.length === 0 ? (
        <div className={`rounded-xl border p-4 text-xs ${theme.bgCard} ${theme.textMuted}`} data-sites-empty="1">
          {filter === 'attention' && !q
            ? tr(`No site needs anyone since ${formatShortDate(since)}: no open positives, repeat sites or email lines waiting on a lab row.`, `Ningun sitio necesita a alguien desde el ${formatShortDate(since)}: ni positivos abiertos, sitios repetidos o lineas del correo esperando fila del laboratorio.`)
            : tr('No site matches.', 'Ningun sitio coincide.')}
        </div>
      ) : (
        <div className={`rounded-xl border divide-y divide-slate-500/15 ${theme.bgCard}`}>
          {shown.map(e => {
            const s = e.s;
            const g = e.g;
            return (
              <button key={s.siteCode} type="button" onClick={() => onFocusSite(s.siteCode)} data-site-row={s.siteCode} className="w-full text-left px-3 py-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs hover:bg-slate-500/5">
                <span className="flex flex-wrap items-center gap-1 w-full sm:w-52 shrink-0">
                  {e.o
                    ? <OpenStateChip item={e.o.oldest} darkMode={darkMode} solid />
                    : (g && g.positives > 0
                        ? <ToneChip tone="plain" darkMode={darkMode}>{tr('No open positive', 'Sin positivo abierto')}</ToneChip>
                        : (g ? <ToneChip tone="done" darkMode={darkMode}>{tr('No positives', 'Sin positivos')}</ToneChip> : <ToneChip tone="unknown" darkMode={darkMode}>{tr('No results loaded', 'Sin resultados cargados')}</ToneChip>))}
                  {e.o && e.o.n > 1 && <ToneChip tone="act" darkMode={darkMode}>{tr(`${e.o.n} open`, `${e.o.n} abiertos`)}</ToneChip>}
                  {e.rep && <ToneChip tone={e.rep.testFamily === 'PATHOGEN' ? 'act' : 'watch'} darkMode={darkMode}>{tr('Repeat', 'Repetido')}</ToneChip>}
                  {e.email && e.rank === 4 && <ToneChip tone="unknown" darkMode={darkMode}>{tr('Email only', 'Solo correo')}</ToneChip>}
                  {e.isNew && <ToneChip tone="plain" darkMode={darkMode}>{tr('New', 'Nuevo')}</ToneChip>}
                </span>
                <span className="font-mono font-black">{s.siteCode}</span>
                <span className="font-black">{roomShortOf(s.room)}</span>
                <span className="min-w-0 flex-1 truncate">{s.surface} - {s.description}</span>
                <span className={`text-[11px] ${theme.textMuted}`}>
                  {g ? tr(`${g.positives} positive of ${g.swabs}, last ${formatShortDate(g.last)}`, `${g.positives} positivo(s) de ${g.swabs}, ultimo ${formatShortDate(g.last)}`) : tr('no lab rows', 'sin filas del laboratorio')}
                </span>
              </button>
            );
          })}
        </div>
      )}
      {shownAll.length > shown.length && (
        <div className={`text-[11px] ${theme.textMuted}`}>{tr(`Showing ${shown.length} of ${shownAll.length}. Search to narrow the list.`, `Se muestran ${shown.length} de ${shownAll.length}. Busque para reducir la lista.`)}</div>
      )}
      <div className="h-24 shrink-0" aria-hidden="true" />
    </div>
  ), ACTIVE_UI_LANG);
}

function SitePage({ darkMode, theme, code, entry, open, newSince, swabLink, harborageConcerns, suggestedActionsMap, onBack, onLocateOnMap, onOpenSection }) {
  const [cleans, setCleans] = useState(null);
  const s = (entry && entry.s) || { siteCode: code, room: '', surface: '', description: '' };
  const g = entry ? entry.g : null;
  const rows = useMemo(() => (g ? g.rows.slice().sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')) || String(a.testCode || '').localeCompare(String(b.testCode || ''))) : []), [g]);
  const stateByKey = useMemo(() => {
    const m = {};
    ((open && open.list) || []).forEach(x => { m[x.key] = x; });
    return m;
  }, [open]);
  const since = open ? open.since : alertSinceOf(null);
  const links = resolveSwabLinks({ siteCode: s.siteCode, room: s.room }, swabLink ? swabLink.linkCtx : null);
  const asset = links.equipmentguid && swabLink && swabLink.assetsById ? swabLink.assetsById[links.equipmentguid] : null;
  const linked = !!(links.equipmentguid || links.area);
  const step = siteStepOf(suggestedActionsMap, s.siteCode);
  const concerns = (harborageConcerns || []).filter(c => c && c.siteCode && c.siteCode === s.siteCode);
  const roomConcerns = (harborageConcerns || []).filter(c => c && c.room && c.room === s.room && c.siteCode !== s.siteCode);
  const emails = (entry && entry.email) || [];
  const loadCleans = async () => {
    if (!linked || !swabLink || typeof swabLink.fetchLogHistory !== 'function') {
      setCleans({ error: tr('This site is not linked to an MSS area or equipment yet, so its cleans cannot be found. Link it in Swab catalog.', 'Este sitio aun no esta ligado a un area MSS ni a un equipo, asi que no se encuentran sus limpiezas. Liguelo en Catalogo de hisopos.') });
      return;
    }
    setCleans({ loading: true });
    try {
      const list = await swabLink.fetchLogHistory(links.equipmentguid, links.area);
      setCleans({ list: list || [] });
    } catch (e) {
      setCleans({ error: e && e.message ? e.message : String(e) });
    }
  };
  const btn = `inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-black border ${theme.bgSubtle} hover:border-[#0072CE]`;
  const head = `text-[11px] font-black uppercase tracking-wider ${theme.textMuted}`;
  return localizeReactTree((
    <div className="h-full overflow-y-auto p-3 sm:p-4 pb-32 space-y-3" data-site-page={s.siteCode}>
      <div className={`rounded-xl border p-3 space-y-2 ${theme.bgCard}`}>
        <div className="flex flex-wrap items-center justify-between gap-2">
          <button type="button" onClick={onBack} className="text-[11px] font-black underline" data-site-back="1">{tr('< All sites', '< Todos los sitios')}</button>
          <div className="flex flex-wrap items-center gap-1.5">
            <button type="button" className={btn} onClick={() => onLocateOnMap({ siteCode: s.siteCode, room: s.room, description: s.description })}>
