function DuplicateAndBlankCheckerView({
  darkMode,
  theme,
  parsedCsv,
  dedupConfig,
  setDedupConfig,
  importReceipts,
  onIngestRawText,
  onUpdateLedgerRows,
  onLocateOnMap,
  logEvent
}) {
  const [subTab, setSubTab] = useState('pending'); // 'pending' | 'duplicates' | 'audit'
  const [searchQ, setSearchQ] = useState('');
  const [roomFilter, setRoomFilter] = useState('ALL');

  const pendingSamples = useMemo(() => {
    const q = searchQ.trim().toLowerCase();
    return parsedCsv.rows.filter(r => {
      if (r.result !== 'Pending' && !r.isBlankSampleId) return false;
      if (roomFilter !== 'ALL' && r.room !== roomFilter) return false;
      if (!q) return true;
      const hay = `${r.date} ${r.sampleId} ${r.sampleDesc} ${r.siteCode} ${r.room} ${r.surface} ${r.description}`.toLowerCase();
      return hay.indexOf(q) !== -1;
    });
  }, [parsedCsv.rows, searchQ, roomFilter]);

  const allBlockedDuplicates = useMemo(() => {
    const list = [];
    if (Array.isArray(parsedCsv.blockedDuplicates)) {
      parsedCsv.blockedDuplicates.forEach(d => list.push({ ...d, source: 'Active CSV / Table' }));
    }
    importReceipts.forEach(rec => {
      if (Array.isArray(rec.blockedDuplicates)) {
        rec.blockedDuplicates.forEach(d => list.push({ ...d, source: rec.sourceLabel || 'Email / Import' }));
      }
    });
    return list;
  }, [parsedCsv.blockedDuplicates, importReceipts]);

  const initialBlockedCount = (parsedCsv.dedupReceipt && parsedCsv.dedupReceipt.duplicatesBlocked) || 0;
  const totalBlockedDuplicates = initialBlockedCount + importReceipts.reduce((acc, r) => acc + (r.duplicatesBlocked || 0), 0);
  const totalUpsertedPending = importReceipts.reduce((acc, r) => acc + (r.upsertedBlankResult || 0), 0);

  const handleResolvePendingSample = (targetId, newStatus) => {
    const nextRows = parsedCsv.rows.map(r => {
      if (r.id !== targetId) return r;
      // Set by hand: shown on the calendar, kept out of every rate, replaced by the lab result when it is uploaded
      return {
        ...r,
        result: newStatus,
        rawResult: newStatus,
        isBlankResult: false,
        resultUnread: false,
        manualResult: true,
        lastUpdatedSource: 'Set by hand'
      };
    });
    onUpdateLedgerRows(nextRows);
    logEvent(`Set sample ${targetId} to ${newStatus} by hand (kept out of the rates until the lab result is uploaded).`, 'success');
  };

  // Same Sample ID, different descriptions, judged to be one swab: one row per test is kept, the one with a finished
  // result (positive over negative over a count over pending), so no result is lost
  const handleMergeCollisionGroup = (collision) => {
    const best = {};
    collision.records.forEach(r => {
      const t = r.testCode || '';
      if (!best[t] || RESULT_RANK[r.result] > RESULT_RANK[best[t].result]) best[t] = r;
    });
    const keepIds = {};
    Object.keys(best).forEach(t => { keepIds[best[t].id] = true; });
    const dropIds = {};
    collision.records.forEach(r => { if (!keepIds[r.id]) dropIds[r.id] = true; });
    const nextRows = parsedCsv.rows.filter(r => !dropIds[r.id]);
    onUpdateLedgerRows(nextRows);
    logEvent(`Merged Sample ID ${collision.sampleId}: kept ${Object.keys(keepIds).length} row(s), one per test, removed ${Object.keys(dropIds).length}.`, 'success');
  };

  return localizeReactTree((
    <div className="h-full overflow-y-auto p-4 sm:p-5 pb-32 space-y-5">
      {/* HEADER & STRICT SAMPLE ID + SAMPLE DESCRIPTION EXPLANATION */}
      <div className={`rounded-2xl border p-4 shadow-xs ${theme.bgCard}`} style={{ borderLeft: '5px solid #16A34A' }}>
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div className="flex items-center gap-2">
              <ShieldCheckIcon className="w-5 h-5 text-emerald-600" />
              <h2 className={`text-base sm:text-lg font-black ${theme.textHeading}`}>
                Duplicate (Sample ID + Description + Test) & Blank-Result Checker
              </h2>
            </div>
            <p className={`text-xs mt-0.5 ${theme.textMuted}`}>
              <span className="font-black text-emerald-600 dark:text-emerald-400">Duplicate rule:</span> <span className="font-mono font-bold">Sample ID</span>, <span className="font-mono font-bold">Sample Description</span> and test must all match for a row to be a duplicate or to fill in a pending result. Listeria and Salmonella on the same sponge are two rows. The same Sample ID with a different description stays a separate sample.
            </p>
          </div>


        </div>

        {/* 5 KPI CARDS */}
        <div className="grid grid-cols-2 sm:grid-cols-5 gap-3 mt-4">
          <div className={`p-3 rounded-xl border ${theme.bgSubtle}`}>
            <div className="text-[10px] font-extrabold uppercase opacity-75">Unique Ledger Samples</div>
            <div className="text-2xl font-black font-mono mt-0.5">{parsedCsv.totals.totalUnique.toLocaleString()}</div>
            <div className={`text-[10px] ${theme.textMuted}`}>Unique Sample ID + Description + Test</div>
          </div>
          <div className={`p-3 rounded-xl border ${theme.bgSubtle}`}>
            <div className="text-[10px] font-extrabold uppercase text-emerald-600">Completed Results</div>
            <div className="text-2xl font-black font-mono text-emerald-600 mt-0.5">{parsedCsv.totals.totalCompleted.toLocaleString()}</div>
            <div className={`text-[10px] ${theme.textMuted}`}>{parsedCsv.totals.totalNegatives} Neg / {parsedCsv.totals.totalPositives} Pos</div>
          </div>
          <div className={`p-3 rounded-xl border ${theme.bgSubtle}`}>
            <div className="text-[10px] font-extrabold uppercase text-amber-500">Blank / Pending Result</div>
            <div className="text-2xl font-black font-mono text-amber-500 mt-0.5">{parsedCsv.totals.totalPending.toLocaleString()}</div>
            <div className={`text-[10px] ${theme.textMuted}`}>Awaiting lab result</div>
          </div>
          <div className={`p-3 rounded-xl border ${theme.bgSubtle}`}>
            <div className="text-[10px] font-extrabold uppercase text-[#0072CE]">Blank Results Upserted</div>
            <div className="text-2xl font-black font-mono text-[#0072CE] mt-0.5">{totalUpsertedPending.toLocaleString()}</div>
