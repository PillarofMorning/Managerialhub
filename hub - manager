                                <span className="text-xs font-bold text-slate-600">Most often first</span>
                            </div>
                            <div className="overflow-x-auto">
                                <table className="min-w-full text-sm">
                                    <caption className="sr-only">Leads and supervisors this employee worked under, with the number of shifts and hours</caption>
                                    <thead className="bg-slate-50"><tr>
                                        <th scope="col" className={th}>Team (lead)</th>
                                        <th scope="col" className={th}>Supervisor</th>
                                        <th scope="col" className={`${th} text-right`}>Shifts together</th>
                                        <th scope="col" className={`${th} text-right`}>Hours</th>
                                        <th scope="col" className={th}>Share of their time</th>
                                    </tr></thead>
                                    <tbody className="divide-y divide-slate-100">
                                        {p.teams.map((t, i) => (
                                            <tr key={`${t.label}-${i}`} className={i === 0 ? 'bg-[#E6F1FB]/50' : 'hover:bg-slate-50'}>
                                                <td className="px-4 py-2.5 font-bold text-slate-800">{t.label}{i === 0 && <span className="ml-2 text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#0072CE] text-white">Most often</span>}</td>
                                                <td className="px-4 py-2.5 text-slate-600">{t.held ? 'Held by the supervisor' : (t.supName || '-')}</td>
                                                <td className="px-4 py-2.5 text-right font-black text-[#0072CE] tabular-nums">{t.times}</td>
                                                <td className="px-4 py-2.5 text-right font-bold text-slate-700 tabular-nums">{hrs(t.hours)}</td>
                                                <td className="px-4 py-2.5">{shareBar(t.share)}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section aria-labelledby="emp-away-h" className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5">
