const pluralize = (n, one, many) => `${n} ${n === 1 ? one : (many || one + 's')}`;
// All the numbers for one person from their assignment rows (see the note above). Every figure is worked out from the rows
// alone, so the same rows always give the same answer:
//  - an assignment lasts from its start until its end time. Shift Start only stamps an end time when someone is MOVED, so the last
//    row of a shift has none: it runs until the next row in the same shift, or to the end of that shift (6 PM for days, 6 AM for
//    nights). Never more than 16 hours; a newer row for the same person takes over from its start;
//  - a row replaced within 5 minutes was a slip and is ignored;
//  - a "time assigned" is one shift in one area (two rows for the same area on the same shift count once);
//  - days and hours worked leave out the days and rows where the person was PTO / Sick / NCNS (late and left early are counted separately);
//  - the strongest area is where they spent the most time, as long as that is at least 3 shifts.
// opts: { first, last } the days asked for (a night row that belongs to a shift outside them is left out), { selfNames } the person's own names.
function buildEmployeeProfile(rows, nowMs, opts) {
    opts = opts || {};
    const notes = { rows: rows.length, hubRows: 0, noEnd: 0, capped: 0, open: 0, toShiftEnd: 0, slips: 0 };
    const items = [];
    rows.forEach(r => {
        const guid = cleanGuid(r.craa5__aaemp_guid);
        const equip = String(r.craa5_equip || r.craa5_equipment || '').trim();
        if (equip && !guid) { notes.hubRows++; return; }
        const savedAt = msOf(r.craa5_datetimeofassignment) || msOf(r.createdon);
        const start = msOf(r.craa5_starttime) || savedAt;
        if (!start) return;
        const end = msOf(r.craa5_endtime);
        const areaRaw = String(r.craa5_area || '').trim();
        const key = normText(areaRaw);
        const crew = crewOfValue(r['craa5_shift@OData.Community.Display.V1.FormattedValue']) || crewOfValue(r.craa5_shift);
        items.push({
            id: r.craa5_taskassignmentid || '', start, end: end > start ? end : 0, savedAt: savedAt || start,
            active: r.statecode === 0 || r.statecode === '0',
            crew, night: empIsNight(crew, start),
            area: areaRaw || '(no area)', absence: OUT_AREA_NAMES.indexOf(key) > -1 ? key : '',
