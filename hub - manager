    // ------------------------------------------------------------------------
    // PROD WEEKLY TAB: a Ganttly-style timeline. A lane per production line, runs as bars, the gaps between them shown
    // as sanitation / allergen cleans.
    // ------------------------------------------------------------------------
    const renderProdWeeklyTab = () => {
        const w = weekly, win = w.win, total = win.to - win.from;
        const LABEL_W = 176;
        const pxPerDay = weekSpan === 1 ? 900 : weekSpan === 3 ? 360 : weekSpan === 7 ? 168 : 120;
        const trackMin = Math.max(720, pxPerDay * weekSpan);
        const loadingRuns = rangeBusy > 0;
        const nowMs = currentTime;
        const showNow = nowMs >= win.from && nowMs <= win.to;
        const at = (ms) => ((ms - win.from) / total) * 100;
        const clock = (ms) => fmtTime(new Date(ms));
        const stamp = (ms) => `${fmtDay(new Date(ms))} ${clock(ms)}`;
        const dayName = (ms) => new Date(ms).toLocaleDateString([], { weekday: 'short' });
        const whenText = (s, e) => (new Date(s).toDateString() === new Date(e).toDateString()) ? `${clock(s)} to ${clock(e)}` : `${dayName(s)} ${clock(s)} to ${dayName(e)} ${clock(e)}`;
        const hourOf = (dayMs, h) => { const d = new Date(dayMs); return new Date(d.getFullYear(), d.getMonth(), d.getDate(), h).getTime(); };
        const focusKey = w.products.some(p => p.key === weekFocus) ? weekFocus : '';
        const labelCls = "text-[10px] font-black text-slate-500 uppercase tracking-widest";
        const colorOf = (r) => isMaintenanceRun(r) ? MAINTENANCE_COLOR : weekColorBy === 'type' ? (isAllergenRun(r) ? BRAND.yellow : BRAND.blue) : (w.colors[productKeyOf(r)] || BRAND.blue);
        const names = (ls) => { const t = ls.slice(0, 6).map(l => `${l.area} line ${l.line}`).join(', '); return ls.length > 6 ? `${t} and ${ls.length - 6} more` : t; };
        const move = (dir) => { const base = parseYMD(selectedDate) ? selectedDate : getLocalYMD(new Date()); setSelectedDate(addDaysYMD(base, dir * weekSpan)); };
        const rangeLabel = weekSpan === 1 ? fmtDay(new Date(win.days[0])) : `${fmtDay(new Date(win.days[0]))} to ${fmtDay(new Date(win.days[weekSpan - 1]))}`;
        const navBtn = "p-2 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]";
        const hatch = (rgb, a) => `repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(${rgb},${a}) 5px, rgba(${rgb},${a}) 10px)`;

        const gapBlock = (b, i) => {
            const dur = fmtHoursShort(b.full);
            let label = `Sanitation ${dur}`, cls = 'bg-[#E6F1FB] border-[#B3D4F2] text-[#00468B]', bg = hatch('0,114,206', 0.08);
            if (b.idle) { label = 'No run scheduled'; cls = 'border-dashed border-slate-300 text-slate-600 bg-transparent'; bg = 'none'; }
            else if (b.short) { label = `Allergen clean ${dur} (${ALLERGEN_SHORT_GAP_H}h or less)`; cls = 'bg-[#FDE8EC] border-[#E4002B] text-[#B80022]'; bg = hatch('228,0,43', 0.1); }
            else if (b.allergen) { label = `Allergen clean ${dur}`; cls = 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800'; bg = hatch('255,184,28', 0.28); }
            const left = at(b.start), width = at(b.end) - left;
            const wide = (width / 100) * trackMin > (b.idle ? 110 : 64);
            return (
                <div key={`g${i}`} role="img" aria-label={`${label}, ${stamp(b.start)} to ${stamp(b.end)}`} title={`${label}\n${stamp(b.start)} to ${stamp(b.end)}`}
                    className={`absolute top-2 bottom-2 rounded-sm border flex items-center px-1.5 overflow-hidden text-[10px] font-bold ${cls}`}
                    style={{ left: `${left}%`, width: `${width}%`, backgroundImage: bg }}>
                    {wide && <span className="truncate">{label}</span>}
                </div>
            );
        };

        const runBlock = (b, i, lane) => {
            const r = b.run, s = startMs(r), e = endMs(r);
            const left = at(b.start), width = at(b.end) - left;
            const wPx = (width / 100) * trackMin;
            const bg = colorOf(r), fg = bg === BRAND.yellow ? '#1F2937' : '#FFFFFF';
            const maint = isMaintenanceRun(r), allergen = isAllergenRun(r), crumb = hasCrumbClean(r);
            const dim = focusKey && productKeyOf(r) !== focusKey;
            const code = r.craa5_productcode === undefined || r.craa5_productcode === null || r.craa5_productcode === '' ? '' : ` (${r.craa5_productcode})`;
            const detail = `${maint ? 'Maintenance' : runName(r)}${maint ? '' : code}\n${lane.area}, line ${lane.line}\n${stamp(s)} to ${stamp(e)} (${fmtSpan(e - s)})${allergen ? `\nAllergen run${renderSafe(r.craa5_typeofallergen) ? `: ${renderSafe(r.craa5_typeofallergen)}` : ''}` : ''}${crumb ? '\nCrumb clean' : ''}${b.overlap ? '\nDouble-booked: overlaps another run on this line' : ''}`;
            return (
                <button key={`r${i}-${runIdOf(r) || s}`} data-run={runIdOf(r) || ''} type="button" onClick={() => openEditDialog(r)}
                    title={`${detail}\n\nClick to adjust`}
                    aria-label={`${detail.replace(/\n/g, ', ')}. Click to adjust.`}
                    className={`absolute z-10 text-left px-1.5 py-1 flex flex-col justify-center overflow-hidden shadow-sm hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-[#0072CE] transition ${b.cutLeft ? 'rounded-l-none' : 'rounded-l-md'} ${b.cutRight ? 'rounded-r-none' : 'rounded-r-md'}`}
                    style={{ left: `${left}%`, width: `${width}%`, minWidth: 3, top: b.overlap ? '50%' : 6, bottom: 6, background: bg, color: fg, opacity: dim ? 0.22 : 1,
                        boxShadow: (allergen && weekColorBy === 'product' && !maint) ? `inset 0 -4px 0 ${BRAND.yellow}` : undefined,
                        outline: b.overlap ? `2px solid ${BRAND.red}` : undefined, outlineOffset: b.overlap ? -2 : undefined }}>
                    {wPx > 34 && (
                        <span className="flex items-center gap-1 min-w-0">
                            <span className="truncate text-[11px] font-extrabold leading-tight">{b.cutLeft ? '‹ ' : ''}{maint ? (wPx > 110 ? 'MAINTENANCE' : 'MAINT.') : runName(r)}{b.cutRight ? ' ›' : ''}</span>
                            {allergen && !maint && wPx > 70 && <span className="flex-shrink-0 text-[9px] font-black leading-none px-1 py-0.5 rounded bg-[#FFB81C] text-slate-900">A</span>}
                            {crumb && wPx > 90 && <span className="flex-shrink-0 text-[9px] font-black leading-none px-1 py-0.5 rounded bg-white text-slate-800">CC</span>}
                        </span>
                    )}
                    {wPx > 120 && <span className="truncate text-[10px] leading-tight">{whenText(s, e)} · {fmtSpan(e - s)}</span>}
                </button>
            );
        };

        const laneRow = (lane) => (
            <div key={lane.key} data-lane={lane.key} data-group={lane.support ? 'support' : 'production'} className="relative z-[1] flex border-b border-slate-200 hover:bg-[#E6F1FB]/20" style={{ minHeight: 62 }}>
                <div className="sticky left-0 z-20 bg-white border-r-2 border-slate-300 px-3 py-2 flex flex-col justify-center flex-shrink-0" style={{ width: LABEL_W }}>
                    <span className="font-black text-sm text-slate-800 truncate" title={lane.area}>{lane.area}</span>
                    <span className="text-[11px] font-bold text-slate-500">Line {lane.line}{lane.runCount ? ` · ${pluralize(lane.runCount, 'run')} · ${fmtHoursShort(lane.runMs)}` : ''}</span>
                    <span className="flex items-center gap-2 mt-0.5">
                        {!lane.runCount && !loadingRuns && <span className="text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded bg-[#FDE8EC] text-[#B80022] border border-[#E4002B]/30">No run</span>}
                    </span>
                </div>
                <div className="relative flex-1" style={{ minWidth: trackMin }} data-track={lane.key}>
                    {lane.blocks.map((b, i) => b.type === 'gap' ? gapBlock(b, i) : runBlock(b, i, lane))}
                </div>
            </div>
        );
        // A heading row between the groups. The Support one folds the support lines away.
        const laneBand = (label, count, foldable) => (
            <div key={`band-${label}`} data-band={label.toLowerCase()} className="relative z-[1] flex border-b border-slate-300 bg-slate-100/90" style={{ minHeight: 30 }}>
                <div className="sticky left-0 z-20 bg-slate-100 border-r-2 border-slate-300 px-3 py-1.5 flex items-center flex-shrink-0" style={{ width: LABEL_W }}>
                    {foldable
