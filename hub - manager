                            {crumb && wPx > 90 && <span className="flex-shrink-0 text-[9px] font-black leading-none px-1 py-0.5 rounded bg-white text-slate-800">CC</span>}
                        </span>
                    )}
                    {wPx > 120 && <span className="truncate text-[10px] opacity-90 leading-tight">{whenText(s, e)} · {fmtSpan(e - s)}</span>}
                </button>
            );
        };

        return (
            <div className="animate-in fade-in duration-300 flex flex-col gap-3">
                <div>
                    <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Production Weekly</h2>
