                                        <input id={`lp-alias-${r.k}`} type="text" value={r.aliases} maxLength={100} disabled={lpBusy || lpSkipAliases} aria-describedby={`lp-for-${r.k}`} autoComplete="off" spellCheck={false}
                                            onChange={e => lpEdit(r.k, 'aliases', e.target.value)} className={input} />
                                        <span id={`lp-for-${r.k}`} className="sr-only">for {label}</span>
                                    </div>
                                    <p className={`lg:col-span-2 text-xs ${note.n ? 'text-slate-600' : 'text-slate-500 italic'}`} data-lp-note={note.n ? 'match' : 'none'}>{note.text}</p>
                                    {prob && <p id={`lp-prob-${r.k}`} role="alert" className="lg:col-span-2 text-sm font-bold text-[#B80022]">{prob}</p>}
                                </div>
                            </div>
                            <div className="flex flex-wrap items-center gap-2 pl-11 lg:pl-0 lg:mt-[22px]">
                                <button type="button" data-lp-act="up" disabled={i === 0 || lpBusy} aria-label={`Move ${label} up`} onClick={() => lpMove(i, -1)} className={small}><span aria-hidden="true">{'↑'} </span>Up</button>
                                <button type="button" data-lp-act="down" disabled={i === n - 1 || lpBusy} aria-label={`Move ${label} down`} onClick={() => lpMove(i, 1)} className={small}><span aria-hidden="true">{'↓'} </span>Down</button>
                                <button type="button" data-lp-act="remove" disabled={lpBusy} aria-label={`Remove ${label}`} onClick={() => lpRemove(i)} className={`${small} text-[#B80022] hover:bg-[#FDE8EC]`}>Remove</button>
                            </div>
                        </li>
                        );
                    })}
                </ol>
                <p className="sr-only" role="status" aria-live="polite" data-lp-live>{lpLive}</p>
