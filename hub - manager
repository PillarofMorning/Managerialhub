                            <div className="px-5 py-3 border-b border-slate-100 flex flex-wrap items-end gap-x-8 gap-y-3">
                                <div>
                                    <span className={labelCls}>Rank by</span>
                                    <div className="flex flex-wrap gap-1.5" role="group" aria-label="Rank by">
                                        <Chip on={areaSort === 'hours'} onClick={() => setAreaSort('hours')}>Most hours</Chip>
                                        <Chip on={areaSort === 'shifts'} onClick={() => setAreaSort('shifts')}>Most shifts</Chip>
                                        <Chip on={areaSort === 'recent'} onClick={() => setAreaSort('recent')}>Been there most recently</Chip>
                                    </div>
                                </div>
                                {crewKeys.length > 0 && (
                                    <div>
                                        <span className={labelCls}>Crew</span>
                                        <div className="flex flex-wrap gap-1.5" role="group" aria-label="Crew">
                                            <Chip on={!view.crewOn} onClick={() => { setAreaCrew(''); setAreaShown(EMP_AREA_SHOWN); }}>Every crew</Chip>
                                            {crewKeys.map(c => <Chip key={c} on={view.crewOn === c} onClick={() => { setAreaCrew(c); setAreaShown(EMP_AREA_SHOWN); }}>Crew {c} ({view.crews[c]})</Chip>)}
                                        </div>
                                    </div>
                                )}
                                {view.leftCount > 0 && (
                                    <label className="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 cursor-pointer pb-1.5">
                                        <input type="checkbox" checked={areaShowLeft} onChange={e => { setAreaShowLeft(e.target.checked); setAreaShown(EMP_AREA_SHOWN); }} className="h-4 w-4 rounded border-slate-300 accent-[#0072CE]" />
                                        Include {pluralize(view.leftCount, 'person who has', 'people who have')} left the company
                                    </label>
                                )}
                            </div>
                            {checking && <div role="status" className="px-5 py-2 text-xs font-bold text-[#00468B] bg-[#E6F1FB]/60 border-b border-slate-100">Checking who is still with the company ({statusNow.done} of {statusNow.total})...</div>}
                            {statusNow && !statusNow.loading && statusNow.failed && <div role="alert" className="px-5 py-2 text-xs font-bold text-[#B80022] bg-[#FDE8EC] border-b border-slate-100">The employee list could not be checked, so people who have left may still be shown and crews are missing.</div>}
                            <div className="overflow-x-auto">
                                <table className="min-w-full text-sm">
                                    <caption className="sr-only">People ranked by their experience in {areaTitle}: hours, shifts, first and last time there, and the team they usually work under</caption>
                                    <thead className="bg-slate-50"><tr>
                                        <th scope="col" className={th}>#</th>
                                        <th scope="col" className={th}>Person</th>
                                        <th scope="col" className={th}>Hours there</th>
                                        <th scope="col" className={`${th} text-right hidden md:table-cell`}>Shifts there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>First there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>Last there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>Usually under</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}><span className="sr-only">Their own numbers</span></th>
                                    </tr></thead>
                                    <tbody className="divide-y divide-slate-100">
                                        {list.slice(0, areaShown).map((x, i) => (
                                            <tr key={x.key} className={i === 0 && areaSort === 'hours' ? 'bg-[#FFF6E0]/60' : 'hover:bg-slate-50'}>
                                                <td className="px-4 py-2.5 font-black text-slate-500 tabular-nums">{i + 1}</td>
                                                <td className="px-4 py-2.5">
                                                    <div className="font-bold text-slate-800">{x.label}{i === 0 && areaSort === 'hours' && <span className="ml-2 text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFB81C] text-slate-900">Most experienced</span>}</div>
                                                    <div className="flex flex-wrap items-center gap-1.5 mt-0.5 empty:hidden">
                                                        {x.st && x.st.role && <span className={`${badge} bg-[#FFF6E0] text-slate-700 border-[#FFB81C]`}>{x.st.role}</span>}
                                                        {x.st && x.st.crew && <span className={`${badge} bg-[#E6F1FB] text-[#00468B] border-[#B3D4F2]`}>Crew {x.st.crew}</span>}
                                                        {x.st && x.st.left && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Left the company</span>}
                                                        {x.st && !x.st.known && !x.st.left && statusNow && !statusNow.loading && !statusNow.failed && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Not in the employee list</span>}
                                                        {x.dupName && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Another employee has this name</span>}
                                                    </div>
                                                    <div className="md:hidden mt-1 text-xs text-slate-600">{x.team ? `Usually under ${x.team}. ` : ''}There {dayText(x.firstDay)} to {dayText(x.lastDay)}.</div>
                                                    <div className="md:hidden mt-1">{theirNumbers(x)}</div>
                                                </td>
                                                <td className="px-4 py-2.5">
                                                    <div className="flex items-center gap-2 sm:min-w-[150px]">
                                                        <div className="hidden sm:block flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div className="h-2 rounded-full bg-[#0072CE]" style={{ width: `${Math.max(2, Math.round((x.ms / maxMs) * 100))}%` }} /></div>
                                                        <span className="text-sm font-bold text-slate-700 w-16 text-right tabular-nums">{hrs(x.hours)}</span>
                                                    </div>
                                                    <div className="md:hidden text-right text-xs font-bold text-[#0072CE] tabular-nums">{pluralize(x.shifts, 'shift', 'shifts')}</div>
                                                </td>
                                                <td className="px-4 py-2.5 text-right font-black text-[#0072CE] tabular-nums hidden md:table-cell">{x.shifts}</td>
                                                <td className="px-4 py-2.5 text-slate-600 whitespace-nowrap hidden md:table-cell">{dayText(x.firstDay)}</td>
                                                <td className="px-4 py-2.5 text-slate-600 whitespace-nowrap hidden md:table-cell">{dayText(x.lastDay)}</td>
                                                <td className="px-4 py-2.5 text-slate-600 hidden md:table-cell">{x.team || '-'}</td>
                                                <td className="px-4 py-2.5 text-right whitespace-nowrap hidden md:table-cell">{theirNumbers(x)}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                            {list.length > areaShown && (
                                <div className="p-3 border-t border-slate-200 flex justify-center bg-slate-50/80">
                                    <button type="button" onClick={() => setAreaShown(c => c + 25)} className="text-sm font-semibold text-[#0072CE] hover:text-[#00468B] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] px-6 py-2 rounded-full shadow-sm transition-colors">
                                        Show more ({list.length - areaShown} left)
                                    </button>
                                </div>
                            )}
                        </section>

                        {(n.noEnd > 0 || n.capped > 0 || n.slips > 0 || areaRanking.totalPeople > EMP_AREA_PEOPLE_MAX) && (
                            <div className="px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm space-y-1">
                                {n.noEnd > 0 && <p>{pluralize(n.noEnd, 'assignment')} had no end time and nothing to show when {n.noEnd === 1 ? 'it' : 'they'} ended, so {n.noEnd === 1 ? 'it adds' : 'they add'} no hours.</p>}
                                {n.capped > 0 && <p>{pluralize(n.capped, 'assignment')} ran longer than {EMP_MAX_ROW_MS / 3600000} hours and {n.capped === 1 ? 'is' : 'are'} counted as {EMP_MAX_ROW_MS / 3600000} hours.</p>}
                                {n.slips > 0 && <p>{pluralize(n.slips, 'move')} lasting under {EMP_SLIP_MS / 60000} minutes {n.slips === 1 ? 'was' : 'were'} ignored.</p>}
                                {areaRanking.totalPeople > EMP_AREA_PEOPLE_MAX && <p>Only the {EMP_AREA_PEOPLE_MAX} people with the most hours were checked against the employee list for crew and for who has left.</p>}
                            </div>
                        )}

                        <details className="bg-white rounded-xl border border-slate-200 shadow-sm px-5 py-3 text-sm text-slate-600">
                            <summary className="cursor-pointer text-sm font-black text-[#00468B] uppercase tracking-widest">How this ranking is worked out</summary>
                            <ul className="mt-3 space-y-1.5 list-disc pl-5">
                                <li>Every time Shift Start puts someone in a room or area it saves a row. Only the rows for the room or area typed are read, a few days at a time.</li>
                                <li><b>Hours there</b> run from the start of an assignment to its end time. Shift Start stamps an end time when someone is moved, so an assignment with no end time ran to the end of that shift (6 PM for days, 6 AM for nights). Never more than {EMP_MAX_ROW_MS / 3600000} hours for one assignment, and a move that is undone within {EMP_SLIP_MS / 60000} minutes is ignored.</li>
                                <li><b>Shifts there</b> counts each shift once, even when the person was moved in and out. A night shift (6 PM to 6 AM) counts for the day it began.</li>
                                <li>The default order is <b>most hours</b>: time spent in the room or area, not how well the work went. Switch to most shifts, or to who was there most recently, to see someone who has been away from it for a while.</li>
                                <li>The employee list is asked about the people found, a few names at a time. A blank Shift there means the person has left the company, so they are hidden unless you include them. A crew can be picked once the list has been checked.</li>
                                <li>"Their numbers" opens that person in the employee query for the same days.</li>
                            </ul>
                        </details>
                    </>
                )}
            </div>
        );
    };

    const renderEmployeeTab = () => {
        const p = empProfile;
        const inputCls = "w-full border border-slate-300 rounded-lg py-2 px-3 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE] bg-white";
        const labelCls = "block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5";
        const cardHead = "bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-baseline justify-between gap-2";
        const th = "px-4 py-2.5 text-left text-[10px] font-black text-slate-500 uppercase tracking-wider whitespace-nowrap";
        const list = empSuggest.key === empQuery ? empSuggest.rows : [];
        const searching = empSearchable && (empSuggest.loading || empSuggest.key !== empQuery);
        const showList = empOpen && empSearchable && !(empPick && empQuery === empPick.label);
        const reading = !!empPick && empData.key === empKey && empData.loading;
        const words = empPick ? empPick.label.split(/\s+/).filter(Boolean) : [];
        const initials = words.length ? (words[0].charAt(0) + (words.length > 1 ? words[words.length - 1].charAt(0) : '')).toUpperCase() : '?';
        const hrs = (h) => { const r = Math.round(h * 10) / 10; return `${r % 1 === 0 ? r.toFixed(0) : r.toFixed(1)} h`; };
        const pct = (x) => `${Math.round(x * 100)}%`;
        const pickFromList = (r) => pickEmployee(r);
        const onKey = (e) => {
            const n = list.length;
            if (e.key === 'ArrowDown') { e.preventDefault(); setEmpOpen(true); if (n) setEmpActive(i => (i + 1) % n); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) setEmpActive(i => (i <= 0 ? n - 1 : i - 1)); }
            else if (e.key === 'Enter') {
                const r = showList && !searching ? (empActive >= 0 ? list[empActive] : (n === 1 ? list[0] : null)) : null;
                if (r) { e.preventDefault(); pickFromList(r); }
            }
            else if (e.key === 'Escape') { setEmpOpen(false); setEmpActive(-1); }
        };
        const n = p ? p.notes : null;
        const shareBar = (share) => (
            <div className="flex items-center gap-2 min-w-[120px]">
                <div className="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div className="h-2 rounded-full bg-[#0072CE]" style={{ width: `${Math.max(2, Math.round(share * 100))}%` }} /></div>
                <span className="text-xs font-bold text-slate-500 w-9 text-right">{pct(share)}</span>
            </div>
        );

        const header = (
            <div>
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Employee Query</h2>
                <p className="text-sm text-slate-500">{empMode === 'area'
                    ? 'Type a room or area to see who has spent the most time there, and when and under whom. Built from the assignments saved by Shift Start.'
                    : 'Type a name to see where that person was assigned, for how long, and whose team they were on. Built from the assignments saved by Shift Start.'}</p>
                <div className="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Look up by">
                    <Chip on={empMode === 'person'} onClick={() => setEmpMode('person')}>By employee</Chip>
                    <Chip on={empMode === 'area'} onClick={() => setEmpMode('area')}>By room or area</Chip>
                </div>
            </div>
        );
        if (empMode === 'area') return renderAreaQuery({ inputCls, labelCls, cardHead, th, hrs, pct, header });

        return (
            <div className="animate-in fade-in duration-300 flex flex-col gap-4">
                {header}

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5">
                    <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] items-start">
                        <div className="relative">
                            <label htmlFor="emp-search" className={labelCls}>Employee</label>
                            <div className="relative">
                                <SearchIcon className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                                <input
                                    id="emp-search" ref={empInputRef} type="text" autoComplete="off" spellCheck={false}
                                    role="combobox" aria-expanded={showList} aria-controls="emp-suggest" aria-autocomplete="list"
                                    aria-activedescendant={showList && empActive >= 0 ? `emp-opt-${empActive}` : undefined}
                                    placeholder="Type a first or last name, for example Kevin or Heldermon"
                                    value={empText}
                                    onChange={e => {
                                        const v = e.target.value;
                                        setEmpText(v); setEmpOpen(true); setEmpActive(-1);
                                        if (empPick && v.trim() !== empPick.label) { setEmpPick(null); setEmpData({ key: '', rows: [], loading: false, error: '', capped: 0, done: 0, total: 0, otherId: 0, at: 0 }); }   // typing over the name: the old person's numbers go away
                                    }}
                                    onFocus={() => setEmpOpen(true)}
                                    onBlur={() => setEmpOpen(false)}
                                    onKeyDown={onKey}
                                    className={`${inputCls} pl-9 pr-10 placeholder:text-slate-500`}
                                />
                                {empText && (
                                    <button type="button" aria-label="Clear the name" onClick={clearEmployee} className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                                        <XIcon className="w-4 h-4" />
                                    </button>
                                )}
                            </div>
                            {showList && (
                                <ul id="emp-suggest" role="listbox" aria-label="Matching employees" className="absolute z-30 left-0 right-0 mt-1 max-h-80 overflow-auto bg-white border border-slate-200 rounded-xl shadow-lg py-1">
                                    {searching && <li role="presentation" className="px-4 py-3 text-sm text-slate-500">Searching...</li>}
                                    {!searching && empSuggest.failed && <li role="presentation" className="px-4 py-3 text-sm font-bold text-[#E4002B]">The employee list could not be searched. Try again.</li>}
                                    {!searching && !empSuggest.failed && list.length === 0 && <li role="presentation" className="px-4 py-3 text-sm text-slate-500">No employee has "{empQuery}" in their name.</li>}
                                    {!searching && list.map((r, i) => {
                                        const info = readEmployeeShiftInfo(r);
                                        const blankShift = r.craa5_shift === null || r.craa5_shift === '' || r.craa5_Shift === null || r.craa5_Shift === '';
                                        const role = EMP_ROLE_NAMES[r.craa5_role];
                                        return (
                                            <li key={r.craa5__aa_employeeid || r.craa5_aa_employeeid || i} id={`emp-opt-${i}`} role="option" aria-selected={i === empActive}
                                                onMouseDown={e => { e.preventDefault(); pickFromList(r); }} onMouseEnter={() => setEmpActive(i)}
                                                className={`px-4 py-2.5 cursor-pointer flex items-center justify-between gap-3 ${i === empActive ? 'bg-[#E6F1FB]' : 'hover:bg-slate-50'}`}>
                                                <span className="text-sm font-bold text-slate-800 truncate">{formatFullName(r.craa5_name)}</span>
                                                <span className="flex items-center gap-1.5 flex-shrink-0">
                                                    {role && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFF6E0] text-slate-700 border border-[#FFB81C]">{role}</span>}
                                                    {info.crew && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">Crew {info.crew}</span>}
                                                    {info.blank && blankShift && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Left the company</span>}
                                                </span>
                                            </li>
                                        );
                                    })}
                                    {!searching && list.length >= EMP_SUGGEST_MAX && <li role="presentation" className="px-4 py-2 text-xs font-bold text-slate-500 border-t border-slate-100">Showing the first {EMP_SUGGEST_MAX}. Type more of the name to narrow it down.</li>}
                                </ul>
                            )}
                            <div className="sr-only" role="status" aria-live="polite">{showList && !searching ? `${list.length} matching ${list.length === 1 ? 'employee' : 'employees'}` : ''}</div>
                        </div>
                        <div>
                            <span className={labelCls}>Days to look at</span>
                            <div className="flex flex-wrap gap-1.5" role="group" aria-label="Days to look at">
                                {EMP_RANGES.map(r => <Chip key={r.k} on={empRange.k === r.k} onClick={() => setEmpRange({ k: r.k, from: empRange.from, to: empRange.to })}>{r.label}</Chip>)}
                                <Chip on={empRange.k === 'custom'} onClick={() => setEmpRange({ k: 'custom', from: empRange.from || empWin.first || '', to: empRange.to || empWin.last || '' })}>Pick dates</Chip>
                            </div>
                        </div>
                    </div>
                    {empRange.k === 'custom' && (
                        <div className="mt-4 flex flex-wrap items-end gap-3">
                            <div>
                                <label htmlFor="emp-from" className={labelCls}>From</label>
                                <input id="emp-from" type="date" value={empRange.from} onChange={e => setEmpRange(r => ({ ...r, from: e.target.value }))} className={inputCls} />
                            </div>
                            <div>
                                <label htmlFor="emp-to" className={labelCls}>To (included)</label>
                                <input id="emp-to" type="date" value={empRange.to} onChange={e => setEmpRange(r => ({ ...r, to: e.target.value }))} className={inputCls} />
                            </div>
                            {empWin.error && <p role="alert" className="text-sm font-bold text-[#E4002B] pb-2">{empWin.error}</p>}
                        </div>
                    )}
                    {!apiReady && <p className="mt-3 text-sm font-bold text-[#00468B] bg-[#FFF6E0] border border-[#FFB81C] rounded-lg px-3 py-2">Preview mode: there is no Dataverse connection here, so people cannot be searched.</p>}
                </div>

                {!empPick && (
                    <div className="bg-white rounded-xl border border-dashed border-slate-300 px-6 py-10 text-center">
                        <SearchIcon className="w-8 h-8 text-[#0072CE] mx-auto mb-3" />
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">Search for an employee</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">You will see how many times they were assigned to each area and for how long, how many days and hours they worked, the area they are strongest in, and the team they were on most often.</p>
                    </div>
                )}

                {empPick && (
                    <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 flex flex-wrap items-center gap-4">
                        <div aria-hidden="true" className="h-12 w-12 rounded-full bg-[#CFE3F7] text-[#00468B] flex items-center justify-center font-black text-base flex-shrink-0">{initials}</div>
                        <div className="min-w-0 flex-1">
                            <h3 className="text-lg font-black text-[#00468B] leading-tight truncate">{empPick.label}</h3>
                            <div className="flex flex-wrap items-center gap-1.5 mt-1">
                                {empPick.role && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFF6E0] text-slate-700 border border-[#FFB81C]">{empPick.role}</span>}
                                {empPick.crew && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">Crew {empPick.crew}</span>}
                                {empPick.left && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Left the company</span>}
                                {!empWin.error && <span className="text-xs font-bold text-slate-500">{empWin.first} to {empWin.last} ({pluralize(empWin.days, 'day')})</span>}
                            </div>
                        </div>
                        {p && p.hasRows && (
                            <button type="button" onClick={copyEmpTable} className="px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 rounded-md transition-colors flex items-center gap-2 shadow-sm" title="Copy these numbers to paste into Excel">
                                <FileSpreadsheetIcon className="w-4 h-4" /> Copy for Excel
                            </button>
                        )}
                    </div>
                )}

                {empPick && empWin.error && empRange.k !== 'custom' && <div role="alert" className="px-4 py-3 rounded-xl bg-[#FDE8EC] border border-[#E4002B]/40 text-[#B80022] text-sm font-bold">{empWin.error}</div>}

                {reading && (
                    <div className="px-4 py-3 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2] text-[#00468B] text-sm font-bold" role="status">
                        Reading {empPick.label}'s assignments{empData.total > 1 ? ` (part ${Math.min(empData.done + 1, empData.total)} of ${empData.total})` : ''}...
                        <div className="mt-2 h-1.5 rounded-full bg-white overflow-hidden"><div className="h-1.5 bg-[#0072CE] transition-all" style={{ width: `${Math.round(((empData.done || 0) / Math.max(1, empData.total)) * 100)}%` }} /></div>
                    </div>
                )}
                {empPick && empData.key === empKey && empData.error && <div role="alert" className="px-4 py-3 rounded-xl bg-[#FDE8EC] border border-[#E4002B]/40 text-[#B80022] text-sm font-bold">{empData.error}</div>}
                {empPick && empData.key === empKey && empData.capped > 0 && <div role="alert" className="px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm">{empData.capped === 1 ? 'One stretch of this range holds' : `${empData.capped} stretches of this range hold`} more than {RANGE_LIMIT.toLocaleString()} rows, so the oldest rows there are missing. Pick fewer days for exact numbers.</div>}

                {p && !p.hasRows && !reading && !empData.error && (
                    <div className="bg-white rounded-xl border border-slate-200 px-6 py-8 text-center">
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">No assignments found</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">{empPick.label} has no Shift Start assignments between {empWin.first} and {empWin.last}. Try more days, or check that this is the right person if two employees share a name.</p>
                    </div>
                )}

