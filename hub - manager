                                        const v = e.target.value;
                                        setEmpText(v); setEmpOpen(true); setEmpActive(-1);
                                        if (empPick && v.trim() !== empPick.label) { setEmpPick(null); setEmpData({ key: '', rows: [], loading: false, error: '', capped: 0, done: 0, total: 0, otherId: 0, at: 0 }); }   // typing over the name: the old person's numbers go away
