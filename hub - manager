    if (state === 'denied') return 'your security role cannot use the time-loss log table (' + MH_TL_TABLE + '). Ask an admin for Create, Read and Write on it.';
    if (state === 'column') return 'the time-loss log table is missing a column' + (cols && cols.length ? ' (' + cols.join(', ') + ')' : '') + '. Open the Dataverse check (click the logo).';
