                    className={`absolute z-10 text-left px-1.5 py-1 flex flex-col justify-center overflow-hidden shadow-sm hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-[#0072CE] transition ${b.cutLeft ? 'rounded-l-none' : 'rounded-l-md'} ${b.cutRight ? 'rounded-r-none' : 'rounded-r-md'}`}
                    style={{ left: `${left}%`, width: `${width}%`, minWidth: 3, top: b.overlap ? '50%' : 6, bottom: 6, background: bg, color: fg, opacity: dim ? 0.22 : 1,
