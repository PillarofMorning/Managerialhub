function markClashes(items, lineRuns, overrides) {
    return items.map(it => {
        const clash = lineRuns.find(r => startMs(r) < it.end.getTime() && endMs(r) > it.start.getTime()) || null;
        const ov = overrides[it.date];
        return { ...it, clash, on: ov === false ? false : (clash ? ov === (runIdOf(clash) || 'x') : true) };
