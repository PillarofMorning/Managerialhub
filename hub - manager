                                {cellTasks?.length > 0 && <span className="bg-[#CFE3F7] text-[#00468B] text-[10px] font-bold px-2 py-0.5 rounded-full">{cellTasks.length} tasks</span>}
                            </div>
                            <div className="flex flex-col gap-1.5 overflow-y-auto max-h-[100px] no-scrollbar">
                                {Object.entries(supAreas).map(([sup, data]) => (
                                    <button 
                                        type="button"
                                        key={sup} 
                                        onClick={(e) => {
                                            e.stopPropagation();
