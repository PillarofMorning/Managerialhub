                    schList = [
                        { craa5__aa_prd_schdid: '1', craa5_area: 'Breading', craa5_line: 1, craa5_productcode: 1001, craa5_product: 'Heavy Run', craa5_datestarttime: `${selectedDate}T06:00:00Z`, craa5_dateendtime: `${selectedDate}T14:00:00Z`, craa5_allergen: true },
                        { craa5__aa_prd_schdid: '2', craa5_area: 'Breading', craa5_line: 1, craa5_productcode: 1002, craa5_product: 'Maintenance', craa5_datestarttime: `${selectedDate}T18:00:00Z`, craa5_dateendtime: `${selectedDate}T22:00:00Z`, craa5_allergen: false }
                    ];
                    allTasks = [
                        { craa5_taskassignmentid: 't1', craa5_id: 'Doe, John', craa5_area: 'Breading', craa5_lead: 'Smith Team', craa5_team: 'Smith', craa5_percentagecomplete: 50, createdon: new Date(Date.now() - 4*3600000).toISOString(), craa5_shift: 'A' },
                        { craa5_taskassignmentid: 't2', craa5_id: 'Doe, John', craa5_area: 'Trash', craa5_lead: 'Smith Team', craa5_team: 'Smith', craa5_percentagecomplete: 100, createdon: new Date(Date.now() - 2*3600000).toISOString(), craa5_shift: 'A' },
                        { craa5_taskassignmentid: 't3', craa5_id: 'Roe, Jane', craa5_area: 'Fryer Line 1', craa5_lead: 'Jones Team', craa5_team: 'Jones', craa5_percentagecomplete: 100, createdon: new Date(Date.now() - 6*3600000).toISOString(), craa5_shift: 'A' }
