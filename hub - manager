    const byTimes = (x, y) => y.times - x.times || y.ms - x.ms || String(x.name || x.label).localeCompare(String(y.name || y.label));   // teams: the most shifts first
    const areaList = Object.keys(areas).map(k => { const a = areas[k]; return { name: a.name, times: count(a.days), hours: a.ms / 3600000, ms: a.ms, share: totalMs ? a.ms / totalMs : 0, rows: a.rows, last: a.last, lastDay: a.lastDay }; }).sort(byTime);
