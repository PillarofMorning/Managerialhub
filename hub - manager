                            <div className="flex flex-wrap gap-2">
                                {[['Sick', p.attendance.sick, false], ['PTO', p.attendance.pto, false], ['Late', p.attendance.late, false], ['Left early', p.attendance.leftEarly, false], ['No call, no show', p.attendance.ncns, true]].map(x => (
                                    <span key={x[0]} className={`px-3 py-1.5 rounded-lg border text-xs font-bold ${x[1] ? (x[2] ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B80022]' : 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800') : 'bg-slate-50 border-slate-200 text-slate-500'}`}>
                                        {x[0]}: <b>{x[1]}</b>
                                    </span>
                                ))}
                            </div>
                        </section>

