function formatFullName(name) {
    const parsedName = renderSafe(name);
    if (!parsedName) return "";
    const parts = parsedName.split(",");
    if (parts?.length > 1) {
        const lastName = parts[0].trim();
        const firstNames = parts.slice(1).join(",").trim();
        return `${firstNames} ${lastName}`;
    }
    return parsedName.trim();
}

function getEmployeeEmail(e) {
    if (!e) return "";
    return e.craa5_email || e.craa5_Email || e.email || e.emailaddress1 || e.internalemailaddress || "";
}

function renderSafe(val) {
    if (val === null || val === undefined) return "";
    if (typeof val === 'object') return String(val.Label || val.Value || val.name || JSON.stringify(val));
    return String(val);
}

function getAreaLine(sch) {
    const area = renderSafe(sch.craa5_area || sch.craa5_Area);
    const line = sch.craa5_line || sch.craa5_Line || 1;
    return `${area} - Line ${line}`;
}

function determineCurrentShift() {
    const now = new Date();
    const day = now.getDay(); 
    const hour = now.getHours();
    if (hour >= 6 && hour < 18) {
        if (day === 0 || day === 1 || day === 2) return "A";
        if (day === 4 || day === 5 || day === 6) return "C";
        if (day === 3) return hour < 12 ? "A" : "C"; 
    } else {
        if (hour >= 18) {
            if (day === 0 || day === 1 || day === 2 || day === 3) return "B"; 
            if (day === 4 || day === 5 || day === 6) return "D";              
        } else {
            if (day === 1 || day === 2 || day === 3) return "B";              
            if (day === 4 || day === 5 || day === 6 || day === 0) return "D"; 
        }
    }
    return "A";
}

function normalizeShift(val) {
    if (val === null || val === undefined) return "";
    let str = typeof val === 'object' ? String(val.Label || val.Value || "") : String(val);
    const upper = str.toUpperCase();
    if (upper.includes("256000000") || upper.includes("A")) return "A";
    if (upper.includes("256000001") || upper.includes("B")) return "B";
    if (upper.includes("256000002") || upper.includes("C")) return "C";
    if (upper.includes("256000003") || upper.includes("D")) return "D";
    return "Unknown Shift";
}

function getLocalYMD(dateObj) {
    const y = dateObj.getFullYear();
    const m = String(dateObj.getMonth() + 1).padStart(2, '0');
    const d = String(dateObj.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
}

function getTaskDate(task) {
    const raw = task.craa5_datetimeofassignment || task.createdon;
    if (!raw) return "";
    return getLocalYMD(new Date(raw));
}

function parseDurationStr(str) {
    if (!str) return 0;
    let ms = 0;
    const hMatch = str.match(/(\d+)\s*h/i);
    const mMatch = str.match(/(\d+)\s*m/i);
    if (hMatch) ms += parseInt(hMatch[1], 10) * 3600000;
    if (mMatch) ms += parseInt(mMatch[1], 10) * 60000;
    return ms;
}

function formatMsToDuration(ms) {
    if (ms <= 0) return "0m";
    const diffMins = Math.floor(ms / 60000);
    const hrs = Math.floor(diffMins / 60);
    const mins = diffMins % 60;
    return hrs > 0 ? `${hrs}h ${mins}m` : `${mins}m`;
}

// Computes the actual physical start and end times for a given shift across multiple days
function generateShiftBlocks(shift, windowStartMs, windowEndMs) {
    const blocks = [];
    const startDay = new Date(windowStartMs);
    startDay.setHours(0,0,0,0);
    let currentDayMs = startDay.getTime();
    
    while (currentDayMs <= windowEndMs) {
        let s, e;
        if (shift === 'A' || shift === 'C') {
            s = currentDayMs + 6 * 3600000;
            e = currentDayMs + 18 * 3600000;
        } else {
            s = currentDayMs + 18 * 3600000;
            e = currentDayMs + 30 * 3600000; 
        }
        
        const cS = Math.max(s, windowStartMs);
        const cE = Math.min(e, windowEndMs);
        
        if (cE > cS) {
            blocks.push({ start: cS, end: cE });
        }
        currentDayMs += 86400000; 
    }
    return blocks;
}

function safeGetXrm() {
    if (typeof window === 'undefined') return null;
    if (window.Xrm) return window.Xrm;
    try { if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm; } catch (e) {}
    try { if (window.top && window.top !== window && window.top.Xrm) return window.top.Xrm; } catch (e) {}
    return null;
}

const API_TIMEOUT_MS = 20000;
const QUERY_LIMIT = 1000;       // small reference tables (areas, supervisors, delegated tasks)
const RANGE_LIMIT = 2000;       // one on-screen date window of tasks or runs
const isoZ = (ms) => new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z');
const withTimeout = (promise, ms, label) => new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error(`${label} timed out`)), ms);
    promise.then(v => { clearTimeout(t); resolve(v); }, e => { clearTimeout(t); reject(e); });
});

// Reads active rows (newest first). Returns an array, or null when EVERY attempt failed, so a failed read is never
// mistaken for "no data". Tries Xrm.WebApi first (model-driven), then the generative-page dataApi. A slow call falls
// back for that call only. `entityNames` may list alternative table names to try in order.
async function queryRecords(entityNames, dataApi, { orderby, filter = "statecode eq 0", top = QUERY_LIMIT, select } = {}) {
    const web = safeGetXrm()?.WebApi;
    const names = Array.isArray(entityNames) ? entityNames : [entityNames];
    let emptyResult = null;   // a table that exists but is empty: keep looking, return [] if nothing better turns up
    const cols = Array.isArray(select) && select.length ? select : null;   // only these columns (a column the table lacks fails the read, so callers retry without)
    const odata = [`$filter=${filter}`, cols ? `$select=${cols.join(',')}` : '', orderby ? `$orderby=${orderby}` : '', `$top=${top}`].filter(Boolean).join('&');
    for (const en of names) {
        if (web?.retrieveMultipleRecords) {
            try {
                const res = await withTimeout(web.retrieveMultipleRecords(en, `?${odata}`), API_TIMEOUT_MS, `Xrm.WebApi ${en}`);
                if (Array.isArray(res?.entities)) { if (res.entities.length || names.length === 1) return res.entities; emptyResult = res.entities; continue; }
            } catch (e) { console.warn(`[Manager] ${en} via Xrm.WebApi:`, e?.message || e); }
        }
        if (dataApi?.queryTable) {
            try {
                const opts = { pageSize: Math.min(top, 500), filter };
                if (orderby) opts.orderBy = orderby;
                if (cols) opts.select = cols;
                let page = await withTimeout(dataApi.queryTable(en, opts), API_TIMEOUT_MS, `dataApi ${en}`);
                if (!Array.isArray(page?.rows)) throw new Error("no rows");
                const rows = [...page.rows];
                while (page?.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < top) {
                    page = await withTimeout(page.loadMoreRows(), API_TIMEOUT_MS, `dataApi ${en}`);
                    rows.push(...(Array.isArray(page?.rows) ? page.rows : []));
                }
                if (rows.length || names.length === 1) return rows.slice(0, top);
                emptyResult = rows;
            } catch (e) { console.warn(`[Manager] ${en} via dataApi:`, e?.message || e); }
        }
    }
    return emptyResult;
}

const idOf = (res) => { const id = typeof res === 'string' ? res : res?.id; return id ? String(id).replace(/[{}]/g, '') : null; };

// Writes go through Xrm.WebApi when present, else the generative-page dataApi (createRow / updateRow / deleteRow).
// Returns null when no write API exists, so callers can say so instead of pretending a save happened.
function getWriteApi(dataApi) {
    const web = safeGetXrm()?.WebApi;
    if (web?.createRecord && web?.updateRecord && web?.deleteRecord) {
        return {
            create: async (t, d) => idOf(await web.createRecord(t, d)),
            update: (t, id, d) => web.updateRecord(t, id, d),
            remove: (t, id) => web.deleteRecord(t, id),
        };
    }
    if (dataApi?.createRow && dataApi?.updateRow) {
        return {
            create: async (t, d) => idOf(await dataApi.createRow(t, d)),
            update: (t, id, d) => dataApi.updateRow(t, id, d),
            remove: (t, id) => dataApi.deleteRow ? dataApi.deleteRow(t, id) : Promise.reject(new Error("Delete isn't available in this environment")),
        };
    }
    return null;
}

