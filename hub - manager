    // ========================================================================
    // LAZY, WINDOWED LOADING. Thousands of rows live in these tables, so only the date range a view needs is fetched
    // (filtered in Dataverse, capped at RANGE_LIMIT), merged by id, and remembered so a window isn't fetched twice.
    // A window that hits the cap is NOT remembered as loaded, so narrower views inside it still fetch their own rows.
    // ========================================================================
    prodSchedulesRef.current = prodSchedules;
    const hourKey = Math.floor(currentTime / 3600000);
    const needsCalMonth = activeTab === 'calendar', needsProdMonth = activeTab === 'prod_calendar', needsWeekly = activeTab === 'weekly';
    const productionAreaNames = useMemo(() => areas.filter(isProductionArea).map(a => renderSafe(a.craa5_area || a.craa5_name)).filter(Boolean).sort().join('|'), [areas]);
    useEffect(() => {
        if (!apiReady) return;   // preview mode keeps its sample data
        let alive = true;
        const [sy, sm, sd] = selectedDate.split('-').map(Number);
        const midnight = (y, m, d) => new Date(y, m, d).getTime();           // local calendar arithmetic (25-hour DST days)
        const selStart = midnight(sy, sm - 1, sd), selNext = midnight(sy, sm - 1, sd + 1);
        const now = new Date();
        const todayStart = midnight(now.getFullYear(), now.getMonth(), now.getDate()), todayNext = midnight(now.getFullYear(), now.getMonth(), now.getDate() + 1);
        const isToday = selStart === todayStart;
        // A month, cut into weeks so each week is fetched (and capped) on its own: a busy month can't push its early days out.
        const monthWeeks = (m, name) => {
            const first = midnight(m.getFullYear(), m.getMonth(), 0), last = midnight(m.getFullYear(), m.getMonth() + 1, 2), out = [];
            for (let i = 0, f = first; f < last; i++) { const t = Math.min(midnight(new Date(f).getFullYear(), new Date(f).getMonth(), new Date(f).getDate() + 7), last); out.push({ name: `${name}${i}`, r: [f, t] }); f = t; }
            return out;
        };

        // Personnel Gantt window (see shiftWindowData). A task's end is the next task's start,
        // so it is padded a day either side.
        const winEnd = isToday ? midnight(now.getFullYear(), now.getMonth(), now.getDate() + 2) : midnight(sy, sm - 1, sd + 2);
        const winStart = (isToday ? hourKey * 3600000 : selNext) - shiftLookbackHours * 3600000 - 24 * 3600000;
        // Runs: a week either side of the target date for the other tabs. The weekly view reads the days on screen plus a week
        // either side (the neighbours show what ran before and what runs next), in 7-day pieces so each is capped on its own.
        const wk = weekWindow(selectedDate, weekSpan);
        const prodFrom = needsWeekly ? addDaysLocal(new Date(wk.from), -7).getTime() : midnight(sy, sm - 1, sd - 7);
        const prodTo = needsWeekly ? addDaysLocal(new Date(wk.to), 7).getTime() : midnight(sy, sm - 1, sd + 1 + 7);
        const need = {
            task: [
                ...(isToday ? [] : [{ name: 'today', r: [todayStart, todayNext], live: true }]),      // live current-shift assignments
                { name: 'shifts', r: [winStart, winEnd], live: isToday },                              // Personnel Gantt (+ today when viewing today)
                ...(isToday ? [] : [{ name: 'day', r: [selStart, selNext] }]),                          // Overview for the selected day
                ...(needsCalMonth ? monthWeeks(calendarMonth, 'month') : []),
            ],
            prod: [
                ...(needsWeekly ? weekChunks(prodFrom, prodTo, 'runs').map(c => ({ ...c, live: true })) : [{ name: 'runs', r: [prodFrom, prodTo], live: true }]),   // Overview, weekly view (+ neighbours for gaps)
                ...(needsProdMonth ? monthWeeks(prodCalendarMonth, 'pmonth') : []),
                // The weekly view's allergen-gap logic needs each line's last run before the window: a few newest runs per production area.
                ...(needsWeekly ? productionAreaNames.split('|').filter(Boolean).map(a => ({ name: `before:${a}`, before: prodFrom, area: a })) : []),
            ],
        };
        const spec = {
            task: {
                table: TABLE_TASK, label: 'Task assignments', id: 'craa5_taskassignmentid', set: setAllAssignments, orderby: 'createdon desc', top: RANGE_LIMIT,
                filter: (f, t) => `statecode eq 0 and ((craa5_datetimeofassignment ge ${isoZ(f)} and craa5_datetimeofassignment lt ${isoZ(t)}) or (craa5_datetimeofassignment eq null and createdon ge ${isoZ(f)} and createdon lt ${isoZ(t)}))`,
                inWindow: (r, f, t) => { const ms = new Date(r.craa5_datetimeofassignment || r.createdon).getTime(); return ms >= f && ms < t; },
            },
            prod: {
                table: TABLE_PROD, label: 'Production runs', id: 'craa5__aa_prd_schdid', set: setProdSchedules, orderby: 'craa5_datestarttime desc', top: RANGE_LIMIT,
                filter: (f, t) => `statecode eq 0 and craa5_datestarttime lt ${isoZ(t)} and craa5_dateendtime gt ${isoZ(f)}`,
                inWindow: (r, f, t) => startMs(r) < t && new Date(r.craa5_dateendtime || r.craa5_endtime).getTime() > f,
                beforeFilter: (f, area) => `statecode eq 0 and craa5_dateendtime le ${isoZ(f)} and craa5_area eq '${String(area).replace(/'/g, "''")}'`,
            },
        };
        const covered = (list, f, t) => list.some(([a, b]) => a <= f && b >= t);
        const remember = (kind, f, t) => {
            const list = [...loadedRef.current[kind], [f, t]].sort((x, y) => x[0] - y[0]), out = [];
            list.forEach(iv => { const last = out[out.length - 1]; if (last && iv[0] <= last[1]) last[1] = Math.max(last[1], iv[1]); else out.push([...iv]); });
            loadedRef.current[kind] = out;
        };
        const flag = (key, msg) => setRangeIssues(p => msg ? (p[key] === msg ? p : { ...p, [key]: msg }) : (key in p ? (({ [key]: _, ...rest }) => rest)(p) : p));
        // Drop warnings for windows this view no longer needs.
        const liveKeys = new Set(['task', 'prod'].flatMap(k => need[k].flatMap(n => [`${k}:${n.name}`, `${k}:${n.name}:cap`])));
        setRangeIssues(p => { const keep = Object.fromEntries(Object.entries(p).filter(([k]) => liveKeys.has(k))); return Object.keys(keep).length === Object.keys(p).length ? p : keep; });

        const run = async (kind) => {
            const sp = spec[kind];
            for (const n of need[kind]) {
                const key = `${kind}:${n.name}`;
                const doneKey = `${kind}:${n.name}:${n.before}`;
                if (n.before !== undefined ? loadedRef.current.keys.has(doneKey) : (!n.live && covered(loadedRef.current[kind], n.r[0], n.r[1]))) { flag(key, null); flag(key + ':cap', null); continue; }
                if (!alive) return;   // a newer effect run took over; its own pass fetches what it needs
                setRangeBusy(c => c + 1);
                try {
                    const cap = n.before !== undefined ? 6 : sp.top;
                    const rows = await queryRecords(sp.table, dataApiRef.current, n.before !== undefined
                        ? { filter: sp.beforeFilter(n.before, n.area), orderby: 'craa5_dateendtime desc', top: cap }
                        : { filter: sp.filter(n.r[0], n.r[1]), orderby: sp.orderby, top: cap });
                    if (rows === null) { flag(key, `${sp.label} (${n.name}) could not be loaded`); continue; }
                    flag(key, null);
                    const truncated = n.before === undefined && rows.length >= cap;
                    flag(key + ':cap', truncated ? `${sp.label}: only the newest ${cap} rows are shown for part of this period` : null);
                    if (n.before !== undefined) loadedRef.current.keys.add(doneKey);
                    else if (!n.live && !truncated) remember(kind, n.r[0], n.r[1]);
                    const fresh = new Set(rows.map(x => x[sp.id]));
                    const recent = (id) => Date.now() - (touchedRef.current.get(id) || 0) < 60000;   // edited here a moment ago: don't let a slower read overwrite it
                    sp.set(prev => {
                        const m = new Map(prev.map(x => [x[sp.id], x]));
                        // A complete window also drops rows that were deleted or moved elsewhere.
                        if (n.before === undefined && !truncated) prev.forEach(x => { if (!fresh.has(x[sp.id]) && sp.inWindow(x, n.r[0], n.r[1]) && !recent(x[sp.id])) m.delete(x[sp.id]); });
                        rows.forEach(x => { if (!recent(x[sp.id])) m.set(x[sp.id], x); });
                        const next = Array.from(m.values());   // no spread of Map/Set: the app host compiles for ES5 without iterable support
                        return kind === 'prod' ? next.sort(byStartAsc) : next;
                    });
                } catch (e) {
                    console.error(`[Manager] ${sp.label} window failed`, e);
                    flag(key, `${sp.label} (${n.name}) could not be loaded`);
                } finally { setRangeBusy(c => Math.max(0, c - 1)); }
            }
        };
        // Debounced: dragging the zoom slider or typing a lookback makes one round of requests, not one per change.
        const timer = setTimeout(() => { Promise.all([run('task'), run('prod')]); }, 250);
        return () => { alive = false; clearTimeout(timer); };
    }, [apiReady, selectedDate, shiftLookbackHours, needsCalMonth, needsProdMonth, needsWeekly, productionAreaNames, calendarMonth, prodCalendarMonth, weekSpan, hourKey, liveTick, reloadTick]);

    const dailyAssignments = useMemo(() => {
        return allAssignments?.filter(t => getTaskDate(t) === selectedDate) || [];
    }, [allAssignments, selectedDate]);

    const liveCurrentShiftAssignments = useMemo(() => {
        return allAssignments?.filter(t => 
            getTaskDate(t) === getLocalYMD(new Date()) && 
            normalizeShift(t["craa5_shift@OData.Community.Display.V1.FormattedValue"] || t.craa5_shift || t.craa5_Shift) === currentShift
        ) || [];
    }, [allAssignments, currentShift]);

    const { activePlaybookByLead, completedTasks, unassignedTasks } = useMemo(() => {
        const leadsMap = {};
        const completed = [];
        const unassigned = [];
        const seenEmployees = new Set();

        const sortedLive = [...liveCurrentShiftAssignments].sort((a, b) => {
            const timeA = new Date(a.craa5_datetimeofassignment || a.createdon).getTime();
            const timeB = new Date(b.craa5_datetimeofassignment || b.createdon).getTime();
            return timeB - timeA;
        });

        sortedLive.forEach(task => {
            const empName = formatFullName(task.craa5_id);
            const isComplete = task.craa5_percentagecomplete === 100 || (renderSafe(task.craa5__currentstatus)).toLowerCase().includes("complete");

            if (!empName) {
                if (isComplete) completed.push(task); else unassigned.push(task);
                return;
            }

            const dedupeKey = empName;
            if (!seenEmployees.has(dedupeKey)) {
                seenEmployees.add(dedupeKey);
                if (isComplete) {
                    completed.push(task);
                } else {
                    const leadName = (renderSafe(task.craa5_lead) || renderSafe(task.craa5_team) || "Unassigned Lead").trim();
                    if (!leadsMap[leadName]) leadsMap[leadName] = [];
                    leadsMap[leadName].push(task);
                }
            } else if (isComplete && !completed.some(c => c.craa5_taskassignmentid === task.craa5_taskassignmentid)) {
                completed.push(task);
            }
        });

        Object.keys(leadsMap).forEach(lead => {
            leadsMap[lead].sort((a, b) => {
                const areaA = renderSafe(a.craa5_area) || "";
                const areaB = renderSafe(b.craa5_area) || "";
                if (areaA !== areaB) return areaA.localeCompare(areaB);
                return formatFullName(a.craa5_id).localeCompare(formatFullName(b.craa5_id));
            });
        });

        return { activePlaybookByLead: leadsMap, completedTasks: completed, unassignedTasks: unassigned };
    }, [liveCurrentShiftAssignments]);

    const activeProductionLines = useMemo(() => {
        const prodFromTable = areas?.filter(isProductionArea) || [];

        const todaySchedules = prodSchedules?.filter(t => {
            const sd = new Date(t.craa5_datestarttime || t.craa5_Datestarttime || t.craa5_starttime); 
            const ed = new Date(t.craa5_dateendtime || t.craa5_Dateendtime || t.craa5_endtime);
