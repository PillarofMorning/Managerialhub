                                <div>
                                    <p className={labelCls}>Gave the most</p>
                                    {summary.topGivers.length ? (
                                        <ol data-mh-kudos-top="givers" className="space-y-1 text-sm">
                                            {summary.topGivers.map(function (p, i) { return <li key={p.key} className="flex gap-2"><span className="w-4 text-right font-black text-slate-400">{i + 1}</span><span className="min-w-0"><b className="text-slate-800">{p.label}</b> <span className="text-slate-500">{countText(p)}</span></span></li>; })}
                                        </ol>
                                    ) : <p className="text-sm text-slate-500">Nothing given in these two weeks.</p>}
                                </div>
                            </div>
                        </div>
                    </section>

                    <section aria-label="Choose what to list" data-mh-kudos-filters="" className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 flex flex-col gap-4">
                        <div className="flex flex-wrap gap-x-8 gap-y-4">
                            <div>
                                <span id="mh-kudos-days-l" className={labelCls}>Days</span>
                                <div className="flex flex-wrap gap-1.5" role="group" aria-labelledby="mh-kudos-days-l" data-mh-kudos-range="">
                                    {MH_KUDOS_RANGES.map(function (r) { return <Chip key={r.k} on={view.range === r.k} onClick={function () { change({ range: r.k }); }}>{r.label}</Chip>; })}
                                </div>
                                <p className="text-xs text-slate-500 mt-1.5">{rangeText}</p>
                            </div>
                            <div>
                                <span id="mh-kudos-type-l" className={labelCls}>Type</span>
                                <div className="flex flex-wrap gap-1.5" role="group" aria-labelledby="mh-kudos-type-l" data-mh-kudos-type="">
                                    {MH_KUDOS_TYPES.map(function (t) { return <Chip key={t.k} on={view.type === t.k} onClick={function () { change({ type: t.k }); }}>{t.label}</Chip>; })}
                                </div>
                            </div>
                            {view.type !== 'highfive' && (
                                <div>
                                    <span id="mh-kudos-sev-l" className={labelCls}>Severity</span>
                                    <div className="flex flex-wrap gap-1.5" role="group" aria-labelledby="mh-kudos-sev-l" data-mh-kudos-severity="">
                                        <Chip on={!view.severity} onClick={function () { change({ severity: '' }); }}>Any</Chip>
                                        {sevChoices.map(function (s) { return <Chip key={s.id} on={view.severity === s.id} onClick={function () { change({ severity: s.id }); }}>{s.label}</Chip>; })}
                                    </div>
                                </div>
                            )}
                        </div>
                        <div className="grid gap-3 sm:grid-cols-3">
                            <div>
                                <label htmlFor="mh-kudos-person" className={labelCls}>Person</label>
                                <input id="mh-kudos-person" type="search" autoComplete="off" spellCheck={false} value={view.person} placeholder="Type part of a name" onChange={function (e) { change({ person: e.target.value }); }} className={fieldCls + ' placeholder:text-slate-500'} />
                            </div>
                            <div>
                                <label htmlFor="mh-kudos-giver" className={labelCls}>Given by</label>
                                <select id="mh-kudos-giver" value={giverOk ? view.givenBy : ''} onChange={function (e) { change({ givenBy: e.target.value }); }} className={fieldCls}>
                                    <option value="">Anyone</option>
                                    {givers.map(function (g) { return <option key={g.key} value={g.key}>{g.label} ({g.count})</option>; })}
                                </select>
                            </div>
                            <div>
                                <label htmlFor="mh-kudos-area" className={labelCls}>Area</label>
                                <select id="mh-kudos-area" value={areaOk ? view.area : ''} onChange={function (e) { change({ area: e.target.value }); }} className={fieldCls}>
                                    <option value="">Any area</option>
                                    {areas.map(function (a) { return <option key={a.key} value={a.key}>{a.label} ({a.count})</option>; })}
                                </select>
                            </div>
                        </div>
                        {changed && (
                            <div>
                                <button type="button" data-mh-kudos-act="clear" onClick={function () { MH_KUDOS_VIEW = null; setView(MH_KUDOS_DEFAULT_VIEW); setShown(MH_KUDOS_PAGE); }} className="min-h-[44px] sm:min-h-0 text-sm font-semibold text-[#0072CE] hover:text-[#00468B] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] px-4 py-1.5 rounded-full transition-colors">
                                    Clear the choices
                                </button>
                            </div>
                        )}
                    </section>

                    <section aria-labelledby="mh-kudos-list-h" data-mh-kudos-list="" className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div className={cardHead}>
                            <h3 id="mh-kudos-list-h" className="text-sm font-black text-[#00468B] uppercase tracking-widest">Entries</h3>
                            <span data-mh-kudos-count={list.length} className="text-xs font-bold text-slate-600">{pluralize(list.length, 'entry', 'entries')}: {pluralize(hfShown, 'high five')}, {list.length - hfShown} coaching or other</span>
                        </div>
                        <p className="sr-only" role="status" aria-live="polite">{pluralize(list.length, 'entry', 'entries')} match</p>
                        {list.length === 0 ? (
                            <div data-mh-kudos-state="none-match" className="px-6 py-8 text-center">
                                <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">Nothing matches these choices</p>
                                <p className="text-sm text-slate-500 mt-2">Try more days, or clear the choices.</p>
                            </div>
                        ) : groups.map(function (g) {
                            return (
                                <div key={g.day} data-mh-kudos-day={g.day}>
                                    <h4 className="px-5 py-2 bg-slate-50 border-b border-slate-100 text-xs font-black text-slate-600 uppercase tracking-widest flex justify-between gap-3">
                                        <span>{g.label}</span><span className="text-slate-500">{dayCounts[g.day] || g.items.length}</span>
                                    </h4>
                                    <ul className="divide-y divide-slate-100 border-b border-slate-100">
                                        {g.items.map(function (e) {
                                            var foot = [e.givenLabel ? 'Given by ' + e.givenLabel : 'Given by: not saved', e.area ? 'Area: ' + e.area : ''].filter(Boolean).join(' - ');
                                            return (
                                                <li key={e.key} data-mh-kudos-entry={e.kind} className="px-5 py-3 flex flex-col sm:flex-row gap-1 sm:gap-4">
                                                    <div className="sm:w-20 flex-shrink-0 text-xs font-bold text-slate-500 tabular-nums sm:pt-0.5">{e.at ? fmtTime(new Date(e.at)) : 'No time'}</div>
                                                    <div className="min-w-0 flex-1">
                                                        <div className="flex flex-wrap items-center gap-1.5">
                                                            <span className="text-sm font-black text-slate-800 break-words">{e.personLabel || 'Name not saved'}</span>
                                                            <MhKudosBadge entry={e} />
                                                            {e.tagLabel && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full border bg-white text-slate-600 border-slate-300">{e.tagLabel}</span>}
                                                        </div>
                                                        {e.text ? <p className="mt-1 text-sm text-slate-700 whitespace-pre-wrap break-words">{e.text}</p> : <p className="mt-1 text-sm italic text-slate-400">No note was written.</p>}
                                                        <p className="mt-1 text-xs text-slate-500 break-words">{foot}</p>
                                                    </div>
                                                </li>
                                            );
                                        })}
                                    </ul>
                                </div>
                            );
                        })}
                        {list.length > shown && (
                            <div className="p-3 flex justify-center bg-slate-50/80">
                                <button type="button" data-mh-kudos-act="more" onClick={function () { setShown(function (c) { return c + MH_KUDOS_PAGE; }); }} className="min-h-[44px] sm:min-h-0 text-sm font-semibold text-[#0072CE] hover:text-[#00468B] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] px-6 py-2 rounded-full shadow-sm transition-colors">
                                    Show more ({list.length - shown} left)
                                </button>
                            </div>
                        )}
                        {parsed.full > 0 && <p className="px-5 py-3 text-xs text-slate-500 border-t border-slate-100">{pluralize(parsed.full, 'person has', 'people have')} {MH_KUDOS_KEEP} entries, the most Ganttly keeps, so their oldest entries are gone.</p>}
                    </section>
                </>
            )}

            <details className="bg-white rounded-xl border border-slate-200 shadow-sm px-5 py-3 text-sm text-slate-600">
                <summary className="cursor-pointer py-3 sm:py-0 text-sm font-black text-[#00468B] uppercase tracking-widest">Where these come from</summary>
                <ul className="mt-3 space-y-1.5 list-disc pl-5">
                    <li>High fives and coaching are given in Ganttly. Ganttly saves them on each person's row in the Employees table, as a list in the Remarks column (craa5_remarks).</li>
                    <li>Each person keeps only their newest {MH_KUDOS_KEEP} entries. When a new one is added, the oldest one is dropped, so older history cannot be shown here.</li>
                    <li>The text is part of the employee row, which other apps also read. Treat coaching notes as readable by anyone who can read the employee list.</li>
                    <li>This tab only reads: nothing here changes an entry. People who are switched off (inactive) in the Employees table are left out.</li>
                    <li>Days run from midnight, by the time each entry was saved. Weeks start on Sunday, like the rest of the hub. The summary at the top always shows this week and last week, whatever is chosen below it.</li>
                    <li>An entry with no severity counts as Positive for a high five and Verbal Coaching for an incident, the way Ganttly saves them.</li>
                    {parsed && <li>Read at {fmtTime(new Date(load.at))}: {pluralize(parsed.people, 'person', 'people')} with entries. Reload data or Read again reads them again.</li>}
                </ul>
            </details>
        </div>
    );
}
// ==== END MH FEATURE KUDOS ====
