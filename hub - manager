                                onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); lpAddName(lpAdd.text); } }} className={input} />
                            <button type="button" disabled={lpBusy} onClick={() => lpAddName(lpAdd.text)} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B] flex-shrink-0`}>Add</button>
                        </div>
                    </div>
                </div>
                <p id="lp-add-msg" role="status" aria-live="polite" className={`mt-2 text-sm min-h-[1.25rem] ${lpAdd.ok ? 'text-slate-600' : 'font-bold text-[#B80022]'}`} data-lp-add-msg>{lpAdd.msg}</p>
                <div className="mt-2 flex flex-wrap items-center gap-2">
                    {!lpResetAsk
                        ? <button type="button" data-lp-reset-btn disabled={lpBusy} onClick={() => setLpResetAsk(true)} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Put back the built-in order</button>
