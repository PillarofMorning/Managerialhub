            prod: [
                // Overview, and the weekly view. The weekly view reads a week either side of the days on screen, which already holds
                // every run that could sit within 48 hours before the view (anything older shows as "no run scheduled" either way).
                ...(needsWeekly ? weekChunks(prodFrom, prodTo, 'runs').map(c => ({ ...c, live: true })) : [{ name: 'runs', r: [prodFrom, prodTo], live: true }]),
                ...(needsProdMonth ? monthWeeks(prodCalendarMonth, 'pmonth') : []),
            ],
        };
        const spec = {
            task: {
                table: TABLE_TASK, label: 'Task assignments', id: 'craa5_taskassignmentid', set: setAllAssignments, orderby: 'createdon desc', top: RANGE_LIMIT,
                filter: (f, t) => `statecode eq 0 and ((craa5_datetimeofassignment ge ${isoZ(f)} and craa5_datetimeofassignment lt ${isoZ(t)}) or (craa5_datetimeofassignment eq null and createdon ge ${isoZ(f)} and createdon lt ${isoZ(t)}))`,
                inWindow: (r, f, t) => { const ms = new Date(r.craa5_datetimeofassignment || r.createdon).getTime(); return ms >= f && ms < t; },
            },
            prod: {
                table: TABLE_PROD, label: 'Production runs', id: 'craa5__aa_prd_schdid', set: setProdSchedules, orderby: 'craa5_datestarttime desc', top: RANGE_LIMIT,
                filter: (f, t) => `statecode eq 0 and craa5_datestarttime lt ${isoZ(t)} and craa5_dateendtime gt ${isoZ(f)}`,
                inWindow: (r, f, t) => startMs(r) < t && new Date(r.craa5_dateendtime || r.craa5_endtime).getTime() > f,
            },
        };
        const covered = (list, f, t) => list.some(([a, b]) => a <= f && b >= t);
        const remember = (kind, f, t) => {
            const list = [...loadedRef.current[kind], [f, t]].sort((x, y) => x[0] - y[0]), out = [];
            list.forEach(iv => { const last = out[out.length - 1]; if (last && iv[0] <= last[1]) last[1] = Math.max(last[1], iv[1]); else out.push([...iv]); });
            loadedRef.current[kind] = out;
        };
        const flag = (key, msg) => setRangeIssues(p => msg ? (p[key] === msg ? p : { ...p, [key]: msg }) : (key in p ? (({ [key]: _, ...rest }) => rest)(p) : p));
        // Drop warnings for windows this view no longer needs.
        const liveKeys = new Set(['task', 'prod'].flatMap(k => need[k].flatMap(n => [`${k}:${n.name}`, `${k}:${n.name}:cap`])));
        setRangeIssues(p => { const keep = Object.fromEntries(Object.entries(p).filter(([k]) => liveKeys.has(k))); return Object.keys(keep).length === Object.keys(p).length ? p : keep; });

        const run = async (kind) => {
            const sp = spec[kind];
            for (const n of need[kind]) {
                const key = `${kind}:${n.name}`;
                if (!n.live && covered(loadedRef.current[kind], n.r[0], n.r[1])) { flag(key, null); flag(key + ':cap', null); continue; }
                if (!alive) return;   // a newer effect run took over; its own pass fetches what it needs
                setRangeBusy(c => c + 1);
                try {
                    const cap = sp.top;
                    const rows = await queryRecords(sp.table, dataApiRef.current, { filter: sp.filter(n.r[0], n.r[1]), orderby: sp.orderby, top: cap });
                    if (!alive) return;   // a newer pass took over while this read ran: its answer may be older than the newer pass's, so it is dropped
                    if (rows === null) { flag(key, `${sp.label} (${n.name}) could not be loaded`); continue; }
                    flag(key, null);
                    const truncated = rows.length >= cap;
                    flag(key + ':cap', truncated ? `${sp.label}: only the newest ${cap} rows are shown for part of this period` : null);
                    if (!n.live && !truncated) remember(kind, n.r[0], n.r[1]);
                    const fresh = new Set(rows.map(x => x[sp.id]));
                    const recent = (id) => Date.now() - (touchedRef.current.get(id) || 0) < 60000;   // edited here a moment ago: don't let a slower read overwrite it
                    sp.set(prev => {
                        const m = new Map(prev.map(x => [x[sp.id], x]));
                        // A complete window also drops rows that were deleted or moved elsewhere.
                        if (!truncated) prev.forEach(x => { if (!fresh.has(x[sp.id]) && sp.inWindow(x, n.r[0], n.r[1]) && !recent(x[sp.id])) m.delete(x[sp.id]); });
                        rows.forEach(x => { if (!recent(x[sp.id])) m.set(x[sp.id], x); });
                        const next = Array.from(m.values());   // no spread of Map/Set: the app host compiles for ES5 without iterable support
                        return kind === 'prod' ? next.sort(byStartAsc) : next;
                    });
                } catch (e) {
                    console.error(`[Manager] ${sp.label} window failed`, e);
                    if (alive) flag(key, `${sp.label} (${n.name}) could not be loaded`);
                } finally { setRangeBusy(c => Math.max(0, c - 1)); }
            }
        };
        // Debounced: dragging the zoom slider or typing a lookback makes one round of requests, not one per change.
        const timer = setTimeout(() => { Promise.all([run('task'), run('prod')]); }, 250);
        return () => { alive = false; clearTimeout(timer); };
    }, [apiReady, effDate, shiftLookbackHours, needsCalMonth, needsProdMonth, needsWeekly, needsTasks, calendarMonth, prodCalendarMonth, weekSpan, hourKey, liveTick, reloadTick]);

    const dailyAssignments = useMemo(() => {
        return allAssignments?.filter(t => getTaskDate(t) === selectedDate) || [];
    }, [allAssignments, selectedDate]);

    // The shift on the clock: from the work schedule when a row covers now, otherwise the clock rotation (and Team Deployment says so).
    const shiftNow = useMemo(() => {
        const cur = findCurrentShift(workSlots.slots, new Date(currentTime));
        if (cur.crew) return { crew: cur.crew, startMs: cur.startMs, endMs: cur.endMs, source: 'workshift' };
        return { crew: determineCurrentShift(), startMs: 0, endMs: 0, source: 'clock' };
    }, [workSlots, currentTime]);
    const currentShift = shiftNow.crew;

    // Team Deployment: the board Shift Start saved for this shift (see buildDeployment for the rules).
    const deployment = useMemo(() => buildDeployment(allAssignments, shiftNow, currentTime), [allAssignments, shiftNow, currentTime]);
    const deployCols = useMemo(() => columnsSeen(allAssignments.filter(t => taskTimeMs(t) >= deployment.from), DEPLOY_COLUMNS), [allAssignments, deployment.from]);

    // The "Training" tags on Team Deployment: one lazy read of the employees marked In training, made only while the Overview shows people on the board.
    // It is not one of the blocking page-load reads and never reaches the Data check banner (Team Deployment's "How this is read" says how it went).
    // state: '' = not asked yet, 'loading', 'ok' or 'failed'. The answer, a failed one too, is kept for TRAINING_FRESH_MS and dropped by Reload data.
    const [trainTags, setTrainTags] = useState({ state: '', map: Object.create(null), n: 0, capped: false });   // map: employee id (cleanGuid) -> training area text
    const trainRef = useRef({ at: 0, tick: -1, busy: false, seq: 0 });
    const depHasPeople = deployment.onFloor > 0, trainMinute = Math.floor(currentTime / 60000);
    useEffect(() => {
        if (activeTab !== 'overview' || !apiReady || !depHasPeople) return;
        const ref = trainRef.current;
        if (ref.tick === reloadTick && (ref.busy || (ref.at > 0 && Date.now() - ref.at < TRAINING_FRESH_MS))) return;   // asked already, and still fresh
        const seq = ++ref.seq;
        ref.tick = reloadTick; ref.busy = true; ref.at = 0;
        setTrainTags(prev => prev.state === '' ? { ...prev, state: 'loading' } : prev);
        (async () => {
            let rows = null;
            try {
                // The columns are always named: the employee table also holds a secret PIN column, so a failed read is never repeated without the list.
                rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, { filter: TRAINING_FILTER, select: TRAINING_FIELDS, top: TRAINING_TOP });
            } catch (err) { console.error('[Manager] Training tags failed', err); rows = null; }
            if (seq !== ref.seq) return;   // Reload data started a newer read, which has the say
            ref.busy = false; ref.at = Date.now();
            if (!Array.isArray(rows)) { setTrainTags({ state: 'failed', map: Object.create(null), n: 0, capped: false }); return; }
            const map = Object.create(null);
            let n = 0;
            rows.forEach(r => {
                const g = cleanGuid(r && r.craa5__aa_employeeid);
                if (!g) return;
                map[g] = String(renderSafe(r.craa5_trainingarea) || '').trim();
                n++;
            });
            setTrainTags({ state: 'ok', map, n, capped: rows.length >= TRAINING_TOP });
        })();
    }, [activeTab, apiReady, depHasPeople, reloadTick, trainMinute]);

    // Production lines, one card per area + line, each with what it is doing right now (or at noon of the Target Date when another day is picked).
    const lineBoard = useMemo(() => {
        const todayIso = getLocalYMD(new Date(currentTime));
        const isToday = !parseYMD(selectedDate) || selectedDate === todayIso;
        const day = parseYMD(selectedDate);
        const refMs = isToday ? currentTime : (withTime(day, '12:00') || new Date(currentTime)).getTime();
        const isSupport = makeSupportTest(areas);
        // The list order (Line order tab) is applied before the lines are split into production and support, so inside each group the lines follow it.
        const lines = sortLanesByPriority(collectLanes(prodSchedules, areas).map(l => {
            const markedAt = isToday ? manualDown[l.key] : 0;   // a mark older than a day is ignored even on a page left open
            const st = lineStatusAt(l.runs, refMs, markedAt && currentTime - markedAt < MANUAL_DOWN_MS ? markedAt : 0);
            return { ...l, st, support: isSupport(l.area) };
        }), lpEntries);
        const counts = { running: 0, sanitation: 0, idle: 0 };
        lines.forEach(l => { counts[l.st.state]++; });
        return { refMs, isToday, lines, production: lines.filter(l => !l.support), support: lines.filter(l => l.support), counts };
    }, [areas, prodSchedules, selectedDate, currentTime, manualDown, lpEntries]);

    // The card moves to another group when its state changes, so React builds it again and the keyboard focus would fall to the page top.
    // After the screen is redrawn, put the focus back on the card's button, or on the filter buttons when a filter hides the card now.
    const focusLineRef = useRef(null);
    useEffect(() => {
        const want = focusLineRef.current; if (!want) return;
        focusLineRef.current = null;
        const card = Array.from(want.panel.querySelectorAll('[data-line]')).filter(el => el.getAttribute('data-line') === want.key)[0];
        const target = (card && card.querySelector('button')) || want.panel.querySelector('[data-lines-filter] button');
        if (target && target.focus) target.focus();
    });
    const markLineDown = (key, down, button) => {
        const next = { ...manualDown };
        if (down) next[key] = Date.now(); else delete next[key];
        setManualDown(next);
        setManualKept(writeManualDown(next));
        const panel = button && button.closest ? button.closest('[data-panel="lines"]') : null;
        if (panel) focusLineRef.current = { key, panel };
    };

    const kpis = useMemo(() => {
        const uniqueEmpsAssigned = new Set();
        const activeLeads = new Set();
        let completedAreas = 0;
        let totalAreas = 0;
        
        dailyAssignments?.forEach(task => {
            if (task.craa5_id) uniqueEmpsAssigned.add(renderSafe(task.craa5_id));
            if (task.craa5_lead) activeLeads.add(renderSafe(task.craa5_lead));
            if (task.craa5_area) {
                totalAreas++;
                if (task.craa5_percentagecomplete === 100) completedAreas++;
            }
        });

        const activeSups = new Set(dailyAssignments?.map(a => renderSafe(a.craa5_team)).filter(Boolean));
        const openManagerTasks = todoTasks?.filter(t => t.craa5_complete !== true && t.craa5_complete !== 1)?.length || 0;
        const activeProdAreas = new Set();
        
        prodSchedules?.forEach(sch => {
            const sd = new Date(sch.craa5_datestarttime || sch.craa5_Datestarttime || sch.craa5_starttime);
            const ed = new Date(sch.craa5_dateendtime || sch.craa5_Dateendtime || sch.craa5_endtime);
            const target = new Date(selectedDate);
            if (sd.toDateString() === target.toDateString() || ed.toDateString() === target.toDateString() || (sd <= target && ed >= target)) {
                activeProdAreas.add(renderSafe(sch.craa5_area || sch.craa5_Area));
            }
        });

        return {
            staffUtilized: uniqueEmpsAssigned.size,
            leadsActive: activeLeads.size,
            supsActive: activeSups.size,
            completionRate: totalAreas === 0 ? 0 : Math.round((completedAreas / totalAreas) * 100),
            openManagerTasks,
            activeProdAreas: Array.from(activeProdAreas)
        };
    }, [dailyAssignments, todoTasks, prodSchedules, selectedDate]);

    // ========================================================================
    // UNIFIED SHIFTS ENGINE (Table & Gantt sharing same data logic)
    // ========================================================================
    const shiftWindowData = useMemo(() => {
        const isToday = selectedDate === getLocalYMD(new Date());
        const [y, m, d] = selectedDate.split('-');
        
        const windowEndMs = isToday ? currentTime : new Date(y, m - 1, d, 23, 59, 59).getTime();
        const windowStartMs = windowEndMs - (shiftLookbackHours * 3600000);

        const empMap = {};
        
        allAssignments?.forEach(task => {
            const empName = formatFullName(task.craa5_id);
            if (!empName) return;
            if (!empMap[empName]) empMap[empName] = { name: empName, tasks: [] };
            empMap[empName].tasks.push(task);
        });

        const allActiveBlocks = [];
        const uniqueShifts = new Set();

        Object.values(empMap).forEach(emp => {
            emp.tasks.sort((a,b) => new Date(a.craa5_datetimeofassignment || a.createdon).getTime() - new Date(b.craa5_datetimeofassignment || b.createdon).getTime());

            for (let i = 0; i < emp.tasks.length; i++) {
                const task = emp.tasks[i];
                const shift = normalizeShift(task["craa5_shift@OData.Community.Display.V1.FormattedValue"] || task.craa5_shift || task.craa5_Shift);
                
                const startMs = new Date(task.craa5_datetimeofassignment || task.createdon).getTime();
                const nextTask = emp.tasks[i + 1];
                const endMs = nextTask ? new Date(nextTask.craa5_datetimeofassignment || nextTask.createdon).getTime() : currentTime;

                if (endMs <= windowStartMs || startMs >= windowEndMs) continue;

                const clampStart = Math.max(startMs, windowStartMs);
                const clampEnd = Math.min(endMs, windowEndMs);

                const shiftBlocks = generateShiftBlocks(shift, windowStartMs, windowEndMs);
                
                shiftBlocks.forEach(sb => {
                    const iStart = Math.max(clampStart, sb.start);
                    const iEnd = Math.min(clampEnd, sb.end);
                    
                    if (iEnd > iStart) {
                        if (shift !== "Unknown Shift") uniqueShifts.add(shift);
                        allActiveBlocks.push({
                            empName: emp.name,
                            shift: shift,
                            area: renderSafe(task.craa5_area) || "Unassigned",
                            equip: renderSafe(task.craa5_equipment || task.craa5_equip),
                            team: renderSafe(task.craa5_team),
                            lead: renderSafe(task.craa5_lead),
                            start: iStart,
                            end: iEnd,
                            durationMs: iEnd - iStart,
                            pct: task.craa5_percentagecomplete || 0,
                            status: renderSafe(task.craa5__currentstatus),
                            originalStart: startMs,
                            taskId: task.craa5_taskassignmentid || Math.random().toString()
                        });
                    }
                });
            }
        });

        const ganttDataByShift = {};
        Array.from(uniqueShifts).forEach(s => ganttDataByShift[s] = {});

        allActiveBlocks.forEach(b => {
            if (!ganttDataByShift[b.shift]) return;
            if (!ganttDataByShift[b.shift][b.empName]) {
                ganttDataByShift[b.shift][b.empName] = { 
                    empName: b.empName, 
                    shift: b.shift,
                    shiftBlocks: generateShiftBlocks(b.shift, windowStartMs, windowEndMs),
                    blocks: [] 
                };
            }
            ganttDataByShift[b.shift][b.empName].blocks.push(b);
        });

        Object.keys(ganttDataByShift).forEach(shift => {
            Object.values(ganttDataByShift[shift]).forEach(emp => {
                const merged = [];
                if (emp.blocks.length > 0) {
                    emp.blocks.sort((a,b) => a.start - b.start);
                    let curr = { ...emp.blocks[0] };
                    for (let i = 1; i < emp.blocks.length; i++) {
                        const nxt = emp.blocks[i];
                        if (nxt.area === curr.area && nxt.status === curr.status) { 
                            curr.end = Math.max(curr.end, nxt.end);
                            curr.durationMs += nxt.durationMs;
                        } else {
                            merged.push(curr);
                            curr = { ...nxt };
                        }
                    }
                    merged.push(curr);
                }
                emp.blocks = merged;
            });
            ganttDataByShift[shift] = Object.values(ganttDataByShift[shift]).sort((a,b) => a.empName.localeCompare(b.empName));
        });

        return {
            windowStartMs,
            windowEndMs,
            uniqueShifts: Array.from(uniqueShifts).sort(),
            ganttDataByShift
        };
    }, [allAssignments, selectedDate, currentTime, shiftLookbackHours]);

    // Active Data memo for the Personnel Gantt Popout
    const activeGanttModalDataRaw = useMemo(() => {
        if (!isGanttModalOpen) return [];
        if (ganttShiftFilter) {
            return shiftWindowData.ganttDataByShift[ganttShiftFilter] || [];
        }
        const combined = [];
        Object.values(shiftWindowData.ganttDataByShift).forEach(arr => combined.push(...arr));
        combined.sort((a, b) => {
            if (a.shift !== b.shift) return a.shift.localeCompare(b.shift);
            return a.empName.localeCompare(b.empName);
        });
        return combined;
    }, [isGanttModalOpen, ganttShiftFilter, shiftWindowData]);

    // ========================================================================
    // EXCEL / IMAGE COPY
    // ========================================================================
    const handleCopyGanttImage = async () => {
        if (!ganttRef.current || typeof window.html2canvas === 'undefined') {
            notify("Image capture library is still loading. Please try again in a moment.", "error");
            return;
        }
        setIsCopyingGantt(true);
        try {
            const canvas = await window.html2canvas(ganttRef.current, { 
                scale: 2, 
                backgroundColor: "#ffffff", 
                logging: false
            });
            
            canvas.toBlob(async (blob) => {
                try {
                    const item = new ClipboardItem({ "image/png": blob });
                    await navigator.clipboard.write([item]);
                    notify("Gantt chart copied to clipboard as an image.", "success");
                } catch (err) {
                    console.warn("Clipboard API blocked, falling back to download.", err);
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Personnel_Gantt_${ganttShiftFilter ? 'Shift_'+ganttShiftFilter : 'All'}_${getLocalYMD(new Date())}.png`;
                    a.click();
                    URL.revokeObjectURL(url);
                }
            }, 'image/png');
        } catch (err) {
            console.error("Failed to generate image", err);
            notify("Failed to copy image: " + err.message, "error");
        } finally {
            setIsCopyingGantt(false);
        }
    };

    const handleCopyForExcel = () => {
        if (!isGanttModalOpen) return;
        
        const targetData = ganttAreaFilter 
            ? activeGanttModalDataRaw.filter(emp => {
                if (ganttAreaFilter === "Idle (No Tasks)") return emp.blocks.length === 0;
                return emp.blocks.some(b => b.area === ganttAreaFilter);
            })
            : activeGanttModalDataRaw;
        
        if (targetData.length === 0) {
            notify("No data available for this shift or filter.", "error");
            return;
        }

        let tsv = "Employee\tShift\tArea\tStatus\tStart Time\tEnd Time\tDuration (Hrs)\n";
        
        targetData.forEach(emp => {
            if (emp.blocks.length === 0) {
                tsv += `${emp.empName}\t${emp.shift}\tNo Active Tasks\t\t\t\t0.00\n`;
            } else {
                emp.blocks.forEach(block => {
                    const sTime = new Date(block.start).toLocaleString();
                    const eTime = new Date(block.end).toLocaleString();
                    const durHrs = (block.durationMs / 3600000).toFixed(2);
                    tsv += `${emp.empName}\t${emp.shift}\t${block.area}\t${block.status}\t${sTime}\t${eTime}\t${durHrs}\n`;
                });
            }
        });

        navigator.clipboard.writeText(tsv).then(() => {
            notify("Data copied. Press Ctrl+V to paste it into Excel.", "success");
        }).catch(err => {
            console.error("Clipboard copy failed", err);
            notify("Failed to copy text. Your browser may be blocking clipboard access.", "error");
        });
    };

    // ========================================================================
    // TABS RENDERING
    // ========================================================================
    const changeMonth = (offset) => setCalendarMonth(new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + offset, 1));
    const getCalendarDays = () => {
        const year = calendarMonth.getFullYear();
        const month = calendarMonth.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push(null);
        for (let i = 1; i <= daysInMonth; i++) days.push(i);
        return days;
    };

    const changeProdMonth = (offset) => setProdCalendarMonth(new Date(prodCalendarMonth.getFullYear(), prodCalendarMonth.getMonth() + offset, 1));
    const getProdCalendarDays = () => {
        const year = prodCalendarMonth.getFullYear();
        const month = prodCalendarMonth.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push(null);
        for (let i = 1; i <= daysInMonth; i++) days.push(i);
        return days;
    };

    // ------------------------------------------------------------------------
    // WEEKLY VIEW: a lane for every production area and line (and any other line that has a run on screen), with
    // its runs and the gaps between them for the days shown. Production lines come first, support lines below them.
    // ------------------------------------------------------------------------
    const weekly = useMemo(() => {
        const win = weekWindow(effDate, weekSpan);
        const isSupport = makeSupportTest(areas);
        const found = collectLanes(prodSchedules, areas);   // every production area gets a lane even when nothing is scheduled
        found.forEach(l => { Object.assign(l, buildLaneBlocks(l.runs, win.from, win.to)); l.support = isSupport(l.area); });
        const all = sortLanesByPriority(found, lpEntries);   // the Line order tab's list first, then the rest by name; production and support are split below, each keeping this order
        const areaRank = Object.create(null), areaSupport = Object.create(null);   // an area sits where its first listed line sits; it is a support area when all its lanes are
        all.forEach(l => { const r = linePriorityRank(lpEntries, l.area, l.line); if (!(l.area in areaRank) || r < areaRank[l.area]) areaRank[l.area] = r; areaSupport[l.area] = (l.area in areaSupport ? areaSupport[l.area] : true) && !!l.support; });
        const areaNames = Object.keys(areaRank).sort((a, b) => areaRank[a] - areaRank[b] || (areaSupport[a] ? 1 : 0) - (areaSupport[b] ? 1 : 0) || (a.toLowerCase() < b.toLowerCase() ? -1 : a.toLowerCase() > b.toLowerCase() ? 1 : a < b ? -1 : a > b ? 1 : 0));
        const areaSel = areaNames.indexOf(weekArea) > -1 ? weekArea : '';   // an area that left the list (its last run was deleted) falls back to all areas
        // Colors come from every product on screen, so they do not change when one area is picked; the key and the counts below
        // follow the area picked.
        const keysOf = (ls) => { const out = {}; ls.forEach(l => l.blocks.forEach(b => { if (b.type === 'run' && !isMaintenanceRun(b.run)) out[productKeyOf(b.run)] = runName(b.run); })); return out; };
        const colors = assignProductColors(Object.keys(keysOf(all)));
        const scoped = all.filter(l => !areaSel || l.area === areaSel);
        const shownKeys = keysOf(scoped);
        const products = Object.keys(shownKeys).map(k => ({ key: k, name: shownKeys[k], color: colors[k] })).sort((a, b) => a.name.localeCompare(b.name));
        const lanes = scoped.filter(l => !weekHideIdle || l.runCount > 0);
        return {
            win, lanes, prodLanes: lanes.filter(l => !l.support), supportLanes: lanes.filter(l => l.support), colors, products, areaSel, areaNames,
            noRun: scoped.filter(l => l.runCount === 0),
            shortClean: scoped.reduce((n, l) => n + l.shortAllergen, 0),
            doubleBooked: scoped.reduce((n, l) => n + l.overlaps, 0),
            totalRuns: scoped.reduce((n, l) => n + l.runCount, 0),
        };
    }, [prodSchedules, areas, effDate, weekSpan, weekArea, weekHideIdle, lpEntries]);

    // ------------------------------------------------------------------------
    // EMPLOYEE QUERY: name suggestions, then ONE person's assignment rows for the chosen days (in pieces of 60 days).
    // Nothing is read until a name is typed, and only that person's rows are asked for.
    // ------------------------------------------------------------------------
    const empQuery = empText.trim();
    const empFilterText = empSearchFilter(empQuery);   // '' when only punctuation was typed
    const empSearchable = empQuery.length >= 2 && !!empFilterText;
    const todayYmd = getLocalYMD(new Date(currentTime));
    const empWin = useMemo(() => empWindowOf(empRange, todayYmd), [empRange.k, empRange.from, empRange.to, todayYmd]);
    const empKey = empPick && empWin.key ? `${empPick.id}|${empWin.key}|${reloadTick}` : '';
    empDataRef.current = empData;

    useEffect(() => {
        if (activeTab !== 'employee' || !apiReady) return;
        if (!empSearchable) { setEmpSuggest(p => (p.rows.length || p.loading || p.failed) ? { key: '', rows: [], loading: false, failed: false } : p); return; }
        if (empPick && empQuery === empPick.label) return;   // the box shows the person already picked
        let alive = true;
        const timer = setTimeout(async () => {
            setEmpSuggest(p => ({ ...p, key: empQuery, loading: true, failed: false }));
            const q = { filter: empFilterText, orderby: 'craa5_name asc', top: EMP_SUGGEST_MAX };
            let rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, { ...q, select: EMP_PICK_FIELDS });
            if (rows === null) rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, q);   // a column in the list may not exist
            if (!alive) return;
            setEmpSuggest({ key: empQuery, rows: rows || [], loading: false, failed: rows === null });
            setEmpActive(-1);
        }, 250);
        return () => { alive = false; clearTimeout(timer); };
    }, [activeTab, apiReady, empQuery, empPick && empPick.label, reloadTick]);

    useEffect(() => {
        if (activeTab !== 'employee' || !apiReady || !empPick || !empKey) return;
        const cur = empDataRef.current;
        if (cur.key === empKey && !cur.loading && !cur.error && Date.now() - cur.at < 300000) return;   // read a moment ago: don't read it again
        let alive = true;
        const chunks = empChunks(empWin.from, empWin.to);
        const nameKeys = empNameVariants(empPick.name).map(normText);
        setEmpData({ key: empKey, rows: [], loading: true, error: '', capped: 0, done: 0, total: chunks.length, otherId: 0, at: 0 });
        // One piece of the range. Works down EMP_ACCESS_STEPS until a read succeeds, then keeps using that way. Each run keeps its
        // own place on the ladder (the way that worked last time is remembered once it has worked), so a cancelled run can never
        // push a newer one down it, and a pick that cannot be read at all gives up after one walk down.
        const memo = empAccessRef.current && empAccessRef.current.ok ? empAccessRef.current : null;
        let cursor = memo ? memo.i : 0, worked = !!memo, dead = false;
        const readPiece = async (f, t) => {
            while (!dead) {
                if (!alive) return null;
