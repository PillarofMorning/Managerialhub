                                    <span key={x[0]} className={`px-3 py-1.5 rounded-lg border text-xs font-bold ${x[1] ? (x[2] ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B80022]' : 'bg-[#FFF6E0] border-[#FFB81C] text-slate-800') : 'bg-slate-50 border-slate-200 text-slate-500'}`}>
