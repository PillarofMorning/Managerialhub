function assignProductColors(keys) {
    const taken = {}, out = {};
    keys.slice().sort().forEach(k => {
        let i = hashStr(k) % PRODUCT_COLORS.length, tries = 0;
        while (taken[i] && tries < PRODUCT_COLORS.length) { i = (i + 1) % PRODUCT_COLORS.length; tries++; }
        taken[i] = true; out[k] = PRODUCT_COLORS[i];
