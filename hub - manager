// ============================================================================
// WEEKLY VIEW HELPERS: the production runs as a Ganttly-style timeline (a lane per line, runs as bars)
// ============================================================================
const WEEK_SPANS = [{ days: 1, label: 'Day' }, { days: 3, label: '3 days' }, { days: 7, label: 'Week' }, { days: 14, label: '2 weeks' }];
// White text stays readable (contrast 4.5 or better) on every one of these. Company yellow is kept for allergen marks.
const PRODUCT_COLORS = ['#0072CE', '#00796B', '#6741D9', '#C2410C', '#2B8A3E', '#C2255C', '#1864AB', '#B45309', '#5F3DC4', '#0B7285', '#862E9C', '#495057'];
const MAINTENANCE_COLOR = '#1F2937';
const ALLERGEN_SHORT_GAP_H = 8;   // an allergen clean shorter than this is flagged red (Gerald's rule from the old Gantt)
const IDLE_GAP_H = 48;            // a gap longer than this is "no run scheduled", not a sanitation window
const isMaintenanceRun = (r) => /maintenance/i.test(renderSafe(r.craa5_product || r.craa5_Product));
const isAllergenRun = (r) => r.craa5_allergen === true || r.craa5_allergen === 1;
