const EMP_PICK_FIELDS = ['craa5__aa_employeeid', 'craa5_name', 'craa5_shift', 'craa5_role', 'statecode'];
// How the assignment reads are tried, in order, until one works: the employee id as text, then without the column list
// (a column the table does not have fails the whole read), then the id as a bare guid, then by name only.
const EMP_ACCESS_STEPS = [{ guid: 'quoted', select: true }, { guid: 'quoted', select: false }, { guid: 'bare', select: false }, { guid: 'none', select: false }];
const EMP_ROLE_NAMES = { 256000001: 'Lead', 256000002: 'Supervisor', 256000003: 'Manager' };
const EMP_TASK_FIELDS = ['craa5_taskassignmentid', 'craa5_id', 'craa5__aaemp_guid', 'craa5_area', 'craa5_lead', 'craa5_team', 'craa5_shift', 'craa5_equip', 'craa5_equipment', 'craa5_datetimeofassignment', 'craa5_starttime', 'craa5_endtime', 'createdon', 'statecode'];
const normText = (s) => String(s === undefined || s === null ? '' : s).toLowerCase().replace(/\s+/g, ' ').trim();
const msOf = (v) => { const t = v ? Date.parse(v) : NaN; return isNaN(t) ? 0 : t; };
const cleanGuid = (v) => String(v || '').replace(/[{}]/g, '').toLowerCase().trim();
const shiftDayKey = (ms) => getLocalYMD(new Date(ms - EMP_DAY_CUT_MS));
// "Kevin Heldermon" finds "Heldermon, Kevin R": every word typed has to appear somewhere in the name.
function empSearchFilter(text) {
    const words = String(text || '').replace(/[,&#%+]/g, ' ').split(/\s+/).filter(Boolean).slice(0, 4);
    return words.map(w => `contains(craa5_name,'${odataStr(w)}')`).join(' and ');
}
function empNameVariants(rawName) {
    const out = [];
    [String(rawName || '').trim(), formatFullName(rawName)].forEach(n => { if (n && out.indexOf(n) === -1) out.push(n); });
    return out;
}
// The days a query covers. A shift day starts at 05:00 (see EMP_DAY_CUT_MS), so the window runs from 05:00 on the first day to
// 05:00 the morning after the last day: a night shift is never cut in half at the edge.
function empWindowOf(range, todayYmd) {
    let first, last;
    if (range.k === 'custom') {
        first = parseYMD(range.from); last = parseYMD(range.to);
        if (!first || !last) return { error: 'Choose both dates.' };
        if (last.getTime() < first.getTime()) return { error: 'The "to" date must be on or after the "from" date.' };
    } else {
        const preset = EMP_RANGES.filter(r => r.k === range.k)[0] || EMP_RANGES[1];
        const t = parseYMD(todayYmd) || new Date();
        last = new Date(t.getFullYear(), t.getMonth(), t.getDate());
        first = addDaysLocal(last, -(preset.days - 1));
    }
    const days = Math.round((last.getTime() - first.getTime()) / 86400000) + 1;
    if (days > EMP_MAX_DAYS) return { error: `Pick a range of ${EMP_MAX_DAYS} days or fewer.` };
    const from = new Date(first.getFullYear(), first.getMonth(), first.getDate(), 5).getTime();
    const to = new Date(last.getFullYear(), last.getMonth(), last.getDate() + 1, 5).getTime();
    return { from, to, days, first: getLocalYMD(first), last: getLocalYMD(last), key: `${from}-${to}` };
