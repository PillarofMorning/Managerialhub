    readRows.forEach((r, i) => { byId[runIdOf(r) || `read${i}`] = r; });
    screenRows.forEach((r, i) => {
        const id = runIdOf(r) || `screen${i}`;
        if (!mine(r)) { return; }
        const inWindow = win && startMs(r) < win.to && endMs(r) > win.from;
        if (byId[id] && !recentlyTouched(id)) return;                 // the fresh read wins
        if (!byId[id] && trusted && inWindow && !recentlyTouched(id)) return;   // not there any more
