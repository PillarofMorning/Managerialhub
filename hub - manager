                                <p className="text-slate-800"><strong>Table:</strong> <code className="font-mono text-[#00468B] break-all">{lpSent.table}</code> · {lpSent.done} of {lpSent.total} lines saved</p>
                                <ul className="mt-2 space-y-1">
                                    {lpSent.rows.map((s, i) => (
                                        <li key={i} className="text-slate-800 break-words" data-sent-step={s.status}>
                                            <span className="font-bold">{s.status === 'sent' ? '✓' : s.status === 'failed' ? '✕' : '–'}</span> {stepText(s)} <span className="text-slate-600">({s.status === 'sent' ? 'sent' : s.status === 'failed' ? 'failed' : 'not sent'})</span>{s.note ? <span className="text-slate-600"> {s.note}</span> : null}{s.error ? <span className="text-[#B80022]"> Dataverse said: {s.error}</span> : null}
                                        </li>
                                    ))}
                                </ul>
                            </>
                        )}
                        {readBad && <p className="mt-2 text-slate-800" data-lp-read-detail><strong>Last answer when reading the table:</strong> <span className="break-words">{lpReadErr || (lpInfo && lpInfo.why)}</span></p>}
                    </div>
                )}
            </section>

            <div role="region" aria-label="Save the line order" data-lp-bar className="sticky bottom-0 z-10 mt-auto -mx-4 md:-mx-6 -mb-4 md:-mb-6 bg-white border-t-2 border-[#FFB81C] shadow-[0_-4px_12px_rgba(0,0,0,0.08)] px-4 md:px-6 py-3 max-h-[max(9rem,calc(35vh_-_66px))] sm:max-h-[40vh] overflow-y-auto">
                <div className="max-w-[1700px] mx-auto flex flex-wrap items-center gap-x-4 gap-y-2">
                    <div className="min-w-0 flex-1 basis-64">
                        <p id="lp-bar-summary" className="text-sm font-extrabold text-[#00468B]" data-lp-bar-summary>{summaryText}</p>
                        <p role="status" aria-live="polite" aria-atomic="true" tabIndex={-1} data-lp-bar-status className={`text-sm max-h-20 sm:max-h-24 overflow-y-auto outline-none ${statusTone}`}>{lpStatus.text}</p>
                    </div>
                    {lpConflict ? (
                        <div role="group" aria-label="The order in Dataverse is not the same as when you started editing" data-lp-conflict className="flex flex-wrap items-center gap-2">
                            <button type="button" disabled={lpBusy} onClick={lpUseTheirs} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Use the order in Dataverse (drops my changes)</button>
                            <button type="button" disabled={lpBusy} onClick={() => lpSave(true)} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B]`}>Keep my order and replace it</button>
                        </div>
                    ) : (
                        <div className="flex flex-wrap items-center gap-2">
                            {retryNow
                                ? <button type="button" data-lp-retry onClick={() => lpSave(false)} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B]`}>Retry</button>
                                : <button type="button" disabled={!canSave} aria-describedby="lp-bar-summary" onClick={() => lpSave(false)} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B]`}>Save to Dataverse</button>}
                            <button type="button" disabled={!lpDirty || lpBusy} onClick={lpDiscard} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Discard changes</button>
                            {lpStatus.show && !lpBusy && <button type="button" onClick={lpShowCard} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Show Columns this needs</button>}
                            {lpInfo && !lpSourceDv && (tableGone || noApi || !canWrite) && <button type="button" disabled={lpBusy || n === 0} onClick={lpUseLocal} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Use this order on this computer for now</button>}
                        </div>
                    )}
                </div>
            </div>
        </div>
        );
    };

    const renderOverviewTab = () => {
        const lb = lineBoard, sh = shiftNow, dep = deployment, dn = dep.notes;
        const tt = trainTags, trainOk = tt.state === 'ok';
        const trainingOf = (p) => (trainOk && p.guid && tt.map[p.guid] !== undefined) ? { area: tt.map[p.guid] } : null;   // a person flagged In training, with the area (may be blank)
        let trainingNow = 0;
        if (trainOk) dep.cards.forEach(c => c.people.forEach(p => { if (trainingOf(p)) trainingNow++; }));
        const prodCounts = { running: 0, sanitation: 0, idle: 0 };
        lb.production.forEach(l => { prodCounts[l.st.state]++; });
        const supCounts = { running: 0, sanitation: 0, idle: 0 };
        lb.support.forEach(l => { supCounts[l.st.state]++; });
        const supSummary = LINE_STATES.filter(s => supCounts[s.k] > 0).map(s => `${supCounts[s.k]} ${s.label.toLowerCase()}`).join(', ');
        const atText = (ms) => { const d = new Date(ms); return new Date(lb.refMs).toDateString() === d.toDateString() ? fmtTime(d) : `${d.toLocaleDateString([], { weekday: 'short' })} ${fmtTime(d)}`; };
        const refText = lb.isToday ? `As of ${fmtTime(new Date(lb.refMs))} today.` : `As of 12:00 PM on ${fmtDay(new Date(lb.refMs))} (Target Date).`;

        const lineCard = (l) => {
            const st = l.st, k = st.state;
            const frame = k === 'running' ? (st.maint ? 'bg-slate-100 border-slate-400' : 'bg-[#E6F1FB]/50 border-[#B3D4F2]') : k === 'sanitation' ? (st.short ? 'bg-[#FDE8EC] border-[#E4002B]' : 'bg-[#FFF6E0] border-[#FFB81C]') : 'bg-slate-50 border-slate-200';
            const badge = k === 'running' ? (st.maint ? ['Maintenance', 'bg-slate-700 text-white'] : ['Running', 'bg-green-100 text-green-800'])
                : k === 'sanitation' ? [st.manual ? 'Down for sanitation (by hand)' : st.short ? `Allergen clean, ${ALLERGEN_SHORT_GAP_H}h or less` : st.allergen ? 'Down: allergen clean' : 'Down for sanitation', st.short ? 'bg-[#E4002B] text-white' : 'bg-[#FFB81C] text-slate-900']
                : ['Idle', 'bg-slate-200 text-slate-600'];
            const nextText = st.next ? `Next: ${runName(st.next)} at ${atText(st.backAt)}` : '';
            let head = 'No run scheduled', sub = st.next ? nextText : 'Nothing scheduled in the next week';
            if (k === 'running') { head = st.maint ? 'Maintenance' : runName(st.current); sub = `Until ${atText(st.until)}`; }
            else if (k === 'sanitation' && st.manual) { head = 'Cleaning'; sub = `Marked down by hand at ${fmtTime(new Date(st.manualAt))}${st.next ? `. ${nextText}` : ''}`; }
            else if (k === 'sanitation') { head = st.allergen ? 'Allergen clean' : 'Sanitation'; sub = `Since ${atText(st.since)}. ${nextText}`; }
            return (
                <div key={l.key} data-line={l.key} data-state={k} className={`min-w-0 p-4 rounded-lg border flex flex-col gap-1.5 ${frame}`}>
                    <p className="text-sm font-semibold text-slate-600 truncate" title={`${l.area}, line ${l.line}`}>{l.area} · Line {l.line}</p>
                    <p className={`text-lg font-bold truncate ${k === 'idle' ? 'text-slate-500' : 'text-[#00468B]'}`} title={head}>{head}</p>
                    <p className="text-xs text-slate-600">{sub}</p>
                    <div className="flex flex-wrap items-center gap-2 mt-1">
                        <span className={`inline-block px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${badge[1]}`}>{badge[0]}</span>
                        {lb.isToday && st.manual && <button type="button" onClick={(ev) => markLineDown(l.key, false, ev.currentTarget)} aria-label={`Back to schedule: ${l.area}, line ${l.line}`} className="text-[11px] font-extrabold text-[#0072CE] underline min-h-[44px] sm:min-h-0 inline-flex items-center">Back to schedule</button>}
                        {lb.isToday && !st.manual && k !== 'sanitation' && <button type="button" onClick={(ev) => markLineDown(l.key, true, ev.currentTarget)} aria-label={`Mark down for sanitation: ${l.area}, line ${l.line}`} className="text-[11px] font-extrabold text-[#0072CE] underline min-h-[44px] sm:min-h-0 inline-flex items-center">Mark down for sanitation</button>}
                    </div>
                </div>
            );
        };
        const grid = (list) => <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">{list.map(lineCard)}</div>;
        const group = (list, s) => (!lineFilter || lineFilter === s.k) && (
            <section key={s.k} aria-label={s.label} data-group={s.k} className="mb-4 last:mb-0">
                <h3 className="text-xs font-black text-slate-600 uppercase tracking-widest mb-2">{s.label} <span className="text-slate-600">({list.length})</span></h3>
                {list.length ? grid(list) : <p className="text-sm text-slate-500 italic">{s.k === 'sanitation' ? 'No line is down for sanitation.' : s.k === 'running' ? 'No line is running.' : 'No line is idle.'}</p>}
            </section>
        );
        // Support lines: running first, then down for sanitation, then idle; inside each state they keep the list order (lb.support is already in it).
        const supportShown = LINE_STATES.reduce((acc, s) => acc.concat(lb.support.filter(l => l.st.state === s.k && (!lineFilter || lineFilter === s.k))), []);

        return (
        <div className="animate-in fade-in duration-300 space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {[
                    { title: `Staff Utilized (${selectedDate})`, value: kpis.staffUtilized, sub: "Unique employees assigned", icon: "👥", color: "text-green-600" },
                    { title: `Active Supervisors`, value: kpis.supsActive, sub: `Out of ${supervisors?.length || 0} total`, icon: "👨‍💼", color: "text-[#0072CE]" },
                    { title: `Active Leads`, value: kpis.leadsActive, sub: "Leads managing teams", icon: "🎯", color: "text-slate-600" },
                    { title: "Scheduled Areas", value: kpis.activeProdAreas?.length || 0, sub: "Active product runs today", icon: "📦", color: "text-[#0072CE]" }
                ].map((k, i) => (
                    <div key={i} className="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
                        <div className="flex justify-between items-start mb-2">
                            <p className="text-sm font-medium text-slate-500">{k.title}</p>
                            <span className="text-xl">{k.icon}</span>
                        </div>
                        <div>
                            <h3 className={`text-3xl font-bold ${k.color}`}>{k.value}</h3>
                            <p className="text-xs text-slate-400 mt-1">{k.sub}</p>
                        </div>
                    </div>
                ))}
            </div>

            <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6" data-panel="lines">
                <div className="flex flex-wrap items-start justify-between gap-3 mb-4">
                    <div>
                        <h2 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Active Production Lines</h2>
                        <p className="text-xs text-slate-500 mt-0.5">{refText} Running lines first, then lines down for sanitation, then idle lines. Support lines are at the bottom. Inside each group the lines follow the order in the Line order tab.</p>
                    </div>
                    <div className="flex flex-wrap gap-1.5" role="group" aria-label="Show lines" data-lines-filter="1">
                        <Chip on={!lineFilter} onClick={() => setLineFilter('')}>All lines {lb.production.length}</Chip>
                        {LINE_STATES.map(s => <Chip key={s.k} on={lineFilter === s.k} onClick={() => setLineFilter(f => f === s.k ? '' : s.k)}>{s.label} {prodCounts[s.k]}</Chip>)}
                    </div>
                </div>
                {lb.production.length === 0 && lb.support.length === 0 ? (
                    <p className="text-sm text-slate-500 italic">No production lines mapped or scheduled for this period.</p>
                ) : lb.production.length === 0 ? (
                    <p className="text-sm text-slate-500 italic">No production lines are mapped or scheduled.</p>
                ) : LINE_STATES.map(s => group(lb.production.filter(l => l.st.state === s.k), s))}
                {lb.isToday && <p className="text-[11px] text-slate-500 mt-3" data-note="manual-down">{manualKept ? 'A line marked down by hand is remembered on this computer for a day.' : 'This browser would not store the mark, so a line marked down by hand stays down only until this page is closed.'} It is not saved to Dataverse, so Shift Start does not see it.</p>}
                {lb.support.length > 0 && (
                    <div className="mt-5 border-t border-slate-200 pt-3" data-panel="support-lines">
                        <button type="button" aria-expanded={supportOpen} onClick={() => setSupportOpen(o => !o)} className="min-h-[44px] sm:min-h-0 flex flex-wrap items-center gap-2 text-xs font-black uppercase tracking-widest text-slate-600 hover:text-[#0072CE]">
                            <span aria-hidden="true">{supportOpen ? '▾' : '▸'}</span> Support · {pluralize(lb.support.length, 'line')}
                            <span className="normal-case tracking-normal font-bold text-slate-500">({supSummary})</span>
                        </button>
                        {supportOpen && <div className="mt-3">{supportShown.length ? grid(supportShown) : <p className="text-sm text-slate-500 italic">No support line matches this button.</p>}</div>}
                    </div>
                )}
            </div>

            <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" data-panel="deployment">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] p-5 flex flex-wrap justify-between items-center gap-3">
                    <div>
                        <h2 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Team Deployment Playbook</h2>
                        <p className="text-sm font-bold text-slate-500">Shift {currentShift} • {sh.startMs ? `since ${fmtTime(new Date(sh.startMs))}` : 'following the clock (no work-schedule row covers now)'} • Floor Status</p>
                    </div>
                    <span className="px-3 py-1 bg-green-50 text-green-700 rounded-full text-xs font-black border border-green-200 tracking-wider">LIVE</span>
                </div>
                <div className="px-6 pt-4 text-sm font-bold text-slate-600" role="status">
                    {dep.onFloor} on the floor · {pluralize(dep.cards.length, 'lead')} · {pluralize(dep.supervisors.length, 'supervisor')}{dep.out.length ? ` · ${dep.out.length} out or late` : ''}{trainingNow > 0 ? <span data-training-count={trainingNow}>{` · ${trainingNow} in training`}</span> : null}
                </div>
                <details className="px-6 pt-2 text-xs text-slate-600" data-panel="deployment-details">
                    <summary className="cursor-pointer font-extrabold text-[#0072CE] py-3.5 sm:py-0">How this is read</summary>
                    <ul className="list-disc pl-5 mt-2 space-y-1">
                        <li>{sh.source === 'workshift' ? `Shift ${sh.crew} from the work schedule (craa5_workshift), ${fmtTime(new Date(sh.startMs))} to ${fmtTime(new Date(sh.endMs))}.`
                            : workSlots.failed ? `The work schedule (craa5_workshift) could not be read, so the clock rotation decides: shift ${sh.crew}.`
                            : workSlots.rows === 0 ? `craa5_workshift has no rows, so the clock rotation decides: shift ${sh.crew}.`
                            : workSlots.slots.length === 0 ? `The ${workSlots.rows} craa5_workshift rows could not be read as shifts (see the columns below), so the clock rotation decides: shift ${sh.crew}.`
                            : `None of the ${workSlots.slots.length} work-schedule slots covers right now, so the clock rotation decides: shift ${sh.crew}.`}</li>
                        <li>Everything Shift Start saved since {fmtDay(new Date(dn.since))} {fmtTime(new Date(dn.since))}{sh.startMs ? ' (an hour before the shift, when supervisors set up)' : ' (the last 16 hours)'}: {dn.inWindow} of {dn.read} loaded rows used.
                            {dn.earlierCrew > 0 ? ` ${dn.earlierCrew} left out: saved in that hour by the crew going home.` : ''}{dn.nextCrew > 0 ? ` ${dn.nextCrew} left out: saved in the last hour by the crew coming on, for their own shift.` : ''}{dn.noId > 0 ? ` ${dn.noId} left out: no employee id (equipment progress rows).` : ''}{dn.noRoom > 0 ? ` ${dn.noRoom} ${dn.noRoom === 1 ? 'person' : 'people'} left out: no room or no lead on the row, so Shift Start cannot place them either.` : ''}</li>
                        <li>Each person is on the board once, where their newest row puts them. A finished row takes them off ({dn.finishedRows} finished {dn.finishedRows === 1 ? 'row' : 'rows'}). People saved as PTO, Sick, Late or Left Early are listed apart.</li>
                        <li>Columns needed. craa5_workshift ({WORKSHIFT_COLUMNS.join(', ')}): {workSlots.rows ? (workSlots.missing.length ? <b className="text-[#B80022]">missing {workSlots.missing.join(', ')}</b> : 'all found') : 'no rows to check'}. craa5_taskassignment ({DEPLOY_COLUMNS.join(', ')}): {dn.inWindow ? (deployCols.missing.length ? <b className="text-[#B80022]">missing {deployCols.missing.join(', ')}</b> : 'all found') : 'no rows to check'}.</li>
                        {(tt.state === 'ok' || tt.state === 'failed') && <li className="text-slate-500" data-testid="td-training-read" data-state={tt.state}>{trainOk ? `Training tags: read for ${tt.capped ? 'at least ' : ''}${pluralize(tt.n, 'person', 'people')}.` : 'Training tags: could not be read.'}</li>}
                    </ul>
                </details>
                <div className="p-6 bg-slate-50/50 overflow-x-auto" tabIndex={0} role="region" aria-label="Team deployment by lead">
                    {dep.cards.length === 0 && dep.out.length === 0 ? (
                        <p className="text-center text-slate-500 py-8">{dn.inWindow === 0
                            ? `Shift Start has not saved a board for shift ${currentShift} since ${fmtTime(new Date(dn.since))}${dn.read ? ` (${dn.read} older rows are loaded and not part of this shift)` : ''}.`
                            : 'Everything Shift Start saved for this shift is already finished.'}</p>
                    ) : (
                        <div className="flex gap-6 pb-4 items-start">
                            {dep.cards.map(card => (
                                <div key={card.key} data-lead={card.lead} className="min-w-[300px] flex-shrink-0 flex flex-col gap-3">
                                    <div className="bg-[#0072CE] text-white px-4 py-2.5 rounded-lg flex justify-between items-center gap-2 shadow-sm">
                                        <span className="min-w-0">
                                            <span className="block font-bold text-sm truncate">{card.lead}</span>
                                            {card.teams.length > 0 && <span className="block text-[11px] text-white/80 truncate">Supervisor {card.teams.join(', ')}</span>}
                                        </span>
                                        <span className="bg-[#00468B] px-2 py-0.5 rounded text-xs font-semibold flex-shrink-0">{card.people.length} Staff</span>
                                    </div>
                                    <div className="flex flex-col gap-2">
                                        {card.people.map(p => {
                                            const diffMs = currentTime - p.startMs;
                                            const durationStr = diffMs > 0 ? formatMsToDuration(diffMs) : "Just Started";
                                            const training = trainingOf(p);
                                            return (
                                                <div key={p.id} data-person={p.guid || undefined} data-training={training ? '1' : undefined} onDoubleClick={mhAllowed ? (e) => { if (!mhOnControl(e)) mhOpenProfile(mhTargetFromCard(p)); } : undefined} title={mhAllowed ? 'Double-click to open the profile' : undefined} className="bg-white p-3 rounded-lg border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                                                    <div className="flex justify-between items-baseline mb-1">
                                                        <span className="flex items-center gap-1.5 min-w-0">
                                                            <span className="font-bold text-sm text-slate-900 truncate pr-2">{p.name}</span>
                                                            {training && <span data-testid="td-training-chip" title={training.area ? `Training on: ${training.area}` : undefined} className="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-[#0072CE] text-white flex-shrink-0">Training</span>}
                                                        </span>
                                                        <span className="text-xs font-semibold text-[#0072CE] flex-shrink-0">{durationStr}</span>
                                                    </div>
                                                    <div className="flex justify-between items-center gap-2">
                                                        <span className="text-xs text-slate-500 truncate">{p.area || 'Unassigned'}{p.status ? ` • ${p.status}` : ''}</span>
                                                        <div className="w-12 bg-slate-100 rounded-full h-1.5 flex-shrink-0 overflow-hidden">
                                                            <div className="bg-[#0072CE] h-1.5 rounded-full" style={{ width: `${Math.max(0, Math.min(100, p.pct))}%` }}></div>
                                                        </div>
                                                    </div>
                                                    {mhAllowed && <MhCardProfileButton person={p} onOpen={mhOpenProfile} />}
                                                </div>
                                            );
                                        })}
                                        {card.emptyAreas.map(a => (
                                            <div key={`e-${a}`} className="bg-white/60 p-3 rounded-lg border border-dashed border-slate-300 text-xs text-slate-500"><b className="text-slate-700">{a}</b> • nobody assigned yet</div>
                                        ))}
                                    </div>
                                </div>
                            ))}
                            {dep.out.length > 0 && (
                                <div data-lead="out" className="min-w-[300px] flex-shrink-0 flex flex-col gap-3">
                                    <div className="bg-slate-600 text-white px-4 py-2.5 rounded-lg flex justify-between items-center shadow-sm">
                                        <span className="font-bold text-sm">Out and late</span>
                                        <span className="bg-slate-800 px-2 py-0.5 rounded text-xs font-semibold">{dep.out.length}</span>
                                    </div>
                                    <div className="flex flex-col gap-2">
                                        {dep.out.map(p => (
                                            <div key={p.id} onDoubleClick={mhAllowed ? (e) => { if (!mhOnControl(e)) mhOpenProfile(mhTargetFromCard(p)); } : undefined} title={mhAllowed ? 'Double-click to open the profile' : undefined} className={'bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex justify-between items-baseline gap-2' + (mhAllowed ? ' flex-wrap' : '')}>
                                                <span className="font-bold text-sm text-slate-900 truncate">{p.name}</span>
                                                <span className="text-xs font-semibold text-slate-600 flex-shrink-0">{p.area}</span>
                                                {mhAllowed && <span className="basis-full"><MhCardProfileButton person={p} onOpen={mhOpenProfile} /></span>}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    )}
                </div>
            </div>
        </div>
        );
    };

    // ------------------------------------------------------------------------
    // EMPLOYEE QUERY TAB
    // ------------------------------------------------------------------------
    const EMP_ABSENCE_LABELS = { 'pto': 'PTO', 'sick': 'Sick', 'late': 'Late', 'left early': 'Left early', 'ncns': 'No call, no show' };

    const copyEmpTable = () => {
        const p = empProfile;
        if (!p || !empPick) return;
        const num = (n, d) => (Math.round(n * Math.pow(10, d)) / Math.pow(10, d)).toFixed(d);
        const rows = [
            ['Employee', empPick.label],
            ['Days looked at', `${empWin.first} to ${empWin.last}`],
            ['Days worked', p.daysWorked],
            ['Hours worked', num(p.hours, 1)],
            ['Strongest area', p.strongest ? p.strongest.name : ''],
            ['Most often on team', p.topTeam ? p.topTeam.label : ''],
            [],
            ['Area', 'Times assigned', 'Hours', 'Share of their time', 'Last assigned']
        ];
        p.areas.forEach(a => rows.push([a.name, a.times, num(a.hours, 1), `${Math.round(a.share * 100)}%`, a.lastDay]));
        rows.push([], ['Team', 'Supervisor', 'Shifts together', 'Hours', 'Share of their time']);
        p.teams.forEach(t => rows.push([t.label, t.supName, t.times, num(t.hours, 1), `${Math.round(t.share * 100)}%`]));
        const tsv = rows.map(r => r.join('\t')).join('\n');
        try {
            navigator.clipboard.writeText(tsv).then(
                () => notify('Copied. Press Ctrl+V to paste it into Excel.', 'success'),
                () => notify('Could not copy. Your browser may be blocking clipboard access.', 'error'));
        } catch (err) { notify('Could not copy. Your browser may be blocking clipboard access.', 'error'); }
    };

    const areaTitle = areaPick ? (areaPick.mode === 'contains' ? `Every area with "${areaPick.text}" in its name` : areaPick.text) : '';
    const copyAreaTable = () => {
        if (!areaView || !areaPick) return;
        const num = (n, d) => (Math.round(n * Math.pow(10, d)) / Math.pow(10, d)).toFixed(d);
        const rankedBy = areaSort === 'shifts' ? 'Most shifts' : areaSort === 'recent' ? 'Been there most recently' : 'Most hours';
        const rows = [
            ['Room or area', areaTitle],
            ['Days looked at', `${areaWin.first} to ${areaWin.last}`],
            ['Ranked by', rankedBy],
            ['Crew', areaView && areaView.crewOn ? `Crew ${areaView.crewOn}` : 'Every crew'],
            [],
            ['Rank', 'Person', 'Crew', 'Hours there', 'Shifts there', 'First there', 'Last there', 'Usually under']
        ];
        areaView.list.forEach((x, i) => rows.push([i + 1, x.label, x.st && x.st.crew ? x.st.crew : '', num(x.hours, 1), x.shifts, x.firstDay, x.lastDay, x.team]));
        const tsv = rows.map(r => r.join('\t')).join('\n');
        try {
            navigator.clipboard.writeText(tsv).then(
                () => notify('Copied. Press Ctrl+V to paste it into Excel.', 'success'),
                () => notify('Could not copy. Your browser may be blocking clipboard access.', 'error'));
        } catch (err) { notify('Could not copy. Your browser may be blocking clipboard access.', 'error'); }
    };

    const renderAreaQuery = ({ inputCls, labelCls, cardHead, th, hrs, pct, header }) => {
        const view = areaView;
        const searching = areaSearchable && !!areaSuggestKey && (areaSuggest.loading || areaSuggest.key !== areaSuggestKey);
        const names = areaSuggest.key === areaSuggestKey ? areaSuggest.names : [];
        const items = names.length >= 2 ? [{ contains: true, count: names.length }].concat(names) : names;
        const hasOptions = !searching && items.length > 0 && !areaSuggest.failed;
        const showList = areaOpen && areaSearchable && !areaWin.error && !(areaPick && areaQuery === areaPick.label);   // bad dates are explained under the date boxes
        const reading = !!areaPick && areaData.key === areaKey && areaData.loading;
        const statusNow = areaStatus.key === areaStatusKey ? areaStatus : null;
        const checking = !!view && !!statusNow && statusNow.loading;
        // The ranking waits for the first batch of the employee-list check (the people at the top, who matter most), so a person who has left
        // is never crowned for a moment and then dropped. A failed check ends the wait too.
        const waitingStatus = !!view && !!areaRanking && areaRanking.people.length > 0 && !(statusNow && (!statusNow.loading || statusNow.done >= 1));
        const onKey = (e) => {
            const n = items.length;
            if (e.key === 'ArrowDown') { e.preventDefault(); setAreaOpen(true); if (n) setAreaActive(i => (i + 1) % n); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) setAreaActive(i => (i <= 0 ? n - 1 : i - 1)); }
            else if (e.key === 'Enter') {
                const it = showList && !searching ? (areaActive >= 0 ? items[areaActive] : (n === 1 ? items[0] : null)) : null;
                if (it) { e.preventDefault(); pickArea(it); }
            }
            else if (e.key === 'Escape') { setAreaOpen(false); setAreaActive(-1); }
        };
        const list = view ? view.list : [];
        const maxMs = Math.max.apply(null, list.map(x => x.ms).concat([1]));
        const topHours = sortAreaPeople(list, 'hours')[0] || null, topShifts = sortAreaPeople(list, 'shifts')[0] || null, topRecent = sortAreaPeople(list, 'recent')[0] || null;
        const dayText = (ymd) => { const d = parseYMD(ymd); return d ? fmtDayYear(d) : '-'; };
        const theirNumbers = (x) => <button type="button" onClick={() => openPersonFromArea(x)} aria-label={`Their numbers: ${x.label}`} className="inline-flex items-center min-h-[24px] text-xs font-extrabold text-[#0072CE] hover:text-[#00468B] hover:underline">Their numbers</button>;
        const totalMs = list.reduce((n, x) => n + x.ms, 0);
        const n = areaRanking ? areaRanking.notes : null;
        const crewKeys = view ? ['A', 'B', 'C', 'D'].filter(c => view.crews[c]) : [];
        const badge = "text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full border";
        const tiles = topHours ? [
            { label: 'Most experienced here', value: topHours.label, sub: `${hrs(topHours.hours)} over ${pluralize(topHours.shifts, 'shift')}` },
            { label: 'Most shifts here', value: topShifts.label, sub: `${pluralize(topShifts.shifts, 'shift')}, ${hrs(topShifts.hours)}` },
            { label: 'Been there most recently', value: topRecent.label, sub: `last there ${dayText(topRecent.lastDay)}` },
            { label: 'People who worked here', value: list.length, big: true, sub: `${hrs(totalMs / 3600000)} in all${view.crewOn ? `, Crew ${view.crewOn} only` : ''}` },
        ] : [];

        return (
            <div className="animate-in fade-in duration-300 flex flex-col gap-4">
                {header}

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5">
                    <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] items-start">
                        <div className="relative">
                            <label htmlFor="area-search" className={labelCls}>Room or area</label>
                            <div className="relative">
                                <SearchIcon className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                                <input
                                    id="area-search" ref={areaInputRef} type="text" autoComplete="off" spellCheck={false}
                                    role="combobox" aria-expanded={showList} aria-controls="area-suggest" aria-autocomplete="list"
                                    aria-activedescendant={showList && areaActive >= 0 ? `area-opt-${areaActive}` : undefined}
                                    placeholder="Type a room or area, for example Breading or Fryer"
                                    value={areaText}
                                    onChange={e => {
                                        const v = e.target.value;
                                        setAreaText(v); setAreaOpen(true); setAreaActive(-1);
                                        if (areaPick && v.trim() !== areaPick.label) { setAreaPick(null); setAreaData(emptyAreaData); setAreaStatus(emptyAreaStatus); setAreaCrew(''); }   // typing over the area: the old numbers go away
                                    }}
                                    onFocus={() => setAreaOpen(true)}
                                    onBlur={() => setAreaOpen(false)}
                                    onKeyDown={onKey}
                                    className={`${inputCls} pl-9 pr-10 placeholder:text-slate-500`}
                                />
                                {areaText && (
                                    <button type="button" aria-label="Clear the room or area" onClick={clearArea} className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                                        <XIcon className="w-4 h-4" />
                                    </button>
                                )}
                            </div>
                            {showList && (hasOptions ? (
                                <ul id="area-suggest" role="listbox" aria-label="Matching rooms and areas" className="absolute z-30 left-0 right-0 mt-1 max-h-80 overflow-auto bg-white border border-slate-200 rounded-xl shadow-lg py-1">
                                    {items.map((it, i) => (
                                        <li key={it.contains ? '*contains*' : it.name} id={`area-opt-${i}`} role="option" aria-selected={i === areaActive}
                                            onMouseDown={e => { e.preventDefault(); pickArea(it); }} onMouseEnter={() => setAreaActive(i)}
                                            className={`px-4 py-2.5 cursor-pointer flex items-center justify-between gap-3 ${i === areaActive ? 'bg-[#E6F1FB]' : 'hover:bg-slate-50'}`}>
                                            {it.contains
                                                ? <span className="text-sm font-bold text-[#00468B]">All {it.count} areas with "{areaQuery}" in their name</span>
                                                : <span className="text-sm font-bold text-slate-800 truncate">{it.name}</span>}
                                        </li>
                                    ))}
                                    {areaSuggest.capped && <li role="presentation" className="px-4 py-2 text-xs font-bold text-slate-500 border-t border-slate-100">Only the newest assignments were looked at. Type more of the name to narrow it down.</li>}
                                </ul>
                            ) : (
                                <div id="area-suggest" className="absolute z-30 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg px-4 py-3 text-sm">
                                    {searching && <p className="text-slate-500">Searching...</p>}
                                    {!searching && areaSuggest.failed && <p className="font-bold text-[#E4002B]">The assignments could not be searched. Try again.</p>}
                                    {!searching && !areaSuggest.failed && <p className="text-slate-500">No room or area with "{areaQuery}" in its name has assignments between {areaWin.first} and {areaWin.last}.</p>}
                                </div>
                            ))}
                            <div className="sr-only" role="status" aria-live="polite">{showList && !searching ? `${items.length} matching ${items.length === 1 ? 'choice' : 'choices'}` : ''}</div>
                        </div>
                        <div>
                            <span className={labelCls}>Days to look at</span>
                            <div className="flex flex-wrap gap-1.5" role="group" aria-label="Days to look at">
                                {EMP_RANGES.map(r => <Chip key={r.k} on={areaRange.k === r.k} onClick={() => setAreaRange({ k: r.k, from: areaRange.from, to: areaRange.to })}>{r.label}</Chip>)}
                                <Chip on={areaRange.k === 'custom'} onClick={() => setAreaRange({ k: 'custom', from: areaRange.from || areaWin.first || '', to: areaRange.to || areaWin.last || '' })}>Pick dates</Chip>
                            </div>
                        </div>
                    </div>
                    {areaRange.k === 'custom' && (
                        <div className="mt-4 flex flex-wrap items-end gap-3">
                            <div>
                                <label htmlFor="area-from" className={labelCls}>From</label>
                                <input id="area-from" type="date" value={areaRange.from} onChange={e => setAreaRange(r => ({ ...r, from: e.target.value }))} className={inputCls} />
                            </div>
                            <div>
                                <label htmlFor="area-to" className={labelCls}>To (included)</label>
                                <input id="area-to" type="date" value={areaRange.to} onChange={e => setAreaRange(r => ({ ...r, to: e.target.value }))} className={inputCls} />
                            </div>
                            {areaWin.error && <p role="alert" className="text-sm font-bold text-[#E4002B] pb-2">{areaWin.error}</p>}
                        </div>
                    )}
                    {!apiReady && <p className="mt-3 text-sm font-bold text-[#00468B] bg-[#FFF6E0] border border-[#FFB81C] rounded-lg px-3 py-2">Preview mode: there is no Dataverse connection here, so rooms and areas cannot be searched.</p>}
                </div>

                {!areaPick && (
                    <div className="bg-white rounded-xl border border-dashed border-slate-300 px-6 py-10 text-center">
                        <SearchIcon className="w-8 h-8 text-[#0072CE] mx-auto mb-3" />
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">Search for a room or area</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">You will see who has spent the most time there, how many shifts, when each person was last there and whose team they usually work under. People who have left the company are hidden.</p>
                    </div>
                )}

                {areaPick && (
                    <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 flex flex-wrap items-center gap-4">
                        <div aria-hidden="true" className="h-12 w-12 rounded-full bg-[#CFE3F7] text-[#00468B] flex items-center justify-center flex-shrink-0"><SearchIcon className="w-5 h-5" /></div>
                        <div className="min-w-0 flex-1">
                            <h3 className="text-lg font-black text-[#00468B] leading-tight break-words">{areaTitle}</h3>
                            <div className="flex flex-wrap items-center gap-1.5 mt-1">
                                {!areaWin.error && <span className="text-xs font-bold text-slate-600">{areaWin.first} to {areaWin.last} ({pluralize(areaWin.days, 'day')})</span>}
                            </div>
                        </div>
                        {view && list.length > 0 && !waitingStatus && (
                            <button type="button" onClick={copyAreaTable} disabled={checking} className="px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 rounded-md transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" title={checking ? 'Wait for the check of who is still with the company to finish' : 'Copy this ranking to paste into Excel'}>
                                <FileSpreadsheetIcon className="w-4 h-4" /> Copy for Excel
                            </button>
                        )}
                    </div>
                )}

                {reading && (
                    <div className="px-4 py-3 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2] text-[#00468B] text-sm font-bold" role="status">
                        Reading the assignments in {areaTitle}{areaData.total > 1 ? ` (part ${Math.min(areaData.done + 1, areaData.total)} of ${areaData.total})` : ''}...
                        <div className="mt-2 h-1.5 rounded-full bg-white overflow-hidden"><div className="h-1.5 bg-[#0072CE] transition-all" style={{ width: `${Math.round(((areaData.done || 0) / Math.max(1, areaData.total)) * 100)}%` }} /></div>
                    </div>
                )}
                {areaPick && areaData.key === areaKey && areaData.error && <div role="alert" className="px-4 py-3 rounded-xl bg-[#FDE8EC] border border-[#E4002B]/40 text-[#B80022] text-sm font-bold">{areaData.error}</div>}
                {areaPick && areaData.key === areaKey && areaData.capped > 0 && <div role="alert" className="px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm">{areaData.capped === 1 ? 'One stretch of this range holds' : `${areaData.capped} stretches of this range hold`} more than {RANGE_LIMIT.toLocaleString()} rows, so the oldest rows there are missing. Pick fewer days for exact numbers.</div>}

                {view && areaRanking.people.length === 0 && !reading && !areaData.error && (
                    <div className="bg-white rounded-xl border border-slate-200 px-6 py-8 text-center">
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">No assignments found</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">Nobody has a Shift Start assignment in {areaTitle} between {areaWin.first} and {areaWin.last}. Try more days, or check the spelling of the room or area.</p>
                    </div>
                )}

                {waitingStatus && (
                    <div className="px-4 py-3 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2] text-[#00468B] text-sm font-bold" role="status">
                        Checking who is still with the company{statusNow && statusNow.total > 1 ? ` (${statusNow.done} of ${statusNow.total})` : ''}...
                    </div>
                )}

                {view && areaRanking.people.length > 0 && !waitingStatus && (
                    <>
                        <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
                            {tiles.map(k => (
                                <div key={k.label} className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex flex-col justify-between min-w-0">
                                    <p className="text-[10px] font-black text-slate-500 uppercase tracking-widest">{k.label}</p>
                                    <p className={`${k.big ? 'text-3xl' : 'text-lg'} font-black text-[#0072CE] leading-tight mt-1 break-words`}>{k.value}</p>
                                    <p className="text-xs text-slate-500 mt-1">{k.sub}</p>
                                </div>
                            ))}
                            {tiles.length === 0 && (
                                <div className="col-span-2 lg:col-span-4 bg-white rounded-xl border border-slate-200 px-6 py-6 text-center text-sm text-slate-600">Nobody matches the choices below. Try another crew, or include the people who have left.</div>
                            )}
                        </div>

                        <section aria-labelledby="area-rank-h" className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div className={cardHead}>
                                <h3 id="area-rank-h" className="text-sm font-black text-[#00468B] uppercase tracking-widest">Who has the most experience here</h3>
                                <span className="text-xs font-bold text-slate-600">{pluralize(list.length, 'person', 'people')}</span>
                            </div>
                            <div className="px-5 py-3 border-b border-slate-100 flex flex-wrap items-end gap-x-8 gap-y-3">
                                <div>
                                    <span className={labelCls}>Rank by</span>
                                    <div className="flex flex-wrap gap-1.5" role="group" aria-label="Rank by">
                                        <Chip on={areaSort === 'hours'} onClick={() => setAreaSort('hours')}>Most hours</Chip>
                                        <Chip on={areaSort === 'shifts'} onClick={() => setAreaSort('shifts')}>Most shifts</Chip>
                                        <Chip on={areaSort === 'recent'} onClick={() => setAreaSort('recent')}>Been there most recently</Chip>
                                    </div>
                                </div>
                                {crewKeys.length > 0 && (
                                    <div>
                                        <span className={labelCls}>Crew</span>
                                        <div className="flex flex-wrap gap-1.5" role="group" aria-label="Crew">
                                            <Chip on={!view.crewOn} onClick={() => { setAreaCrew(''); setAreaShown(EMP_AREA_SHOWN); }}>Every crew</Chip>
                                            {crewKeys.map(c => <Chip key={c} on={view.crewOn === c} onClick={() => { setAreaCrew(c); setAreaShown(EMP_AREA_SHOWN); }}>Crew {c} ({view.crews[c]})</Chip>)}
                                        </div>
                                    </div>
                                )}
                                {view.leftCount > 0 && (
                                    <label className="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 cursor-pointer pb-1.5">
                                        <input type="checkbox" checked={areaShowLeft} onChange={e => { setAreaShowLeft(e.target.checked); setAreaShown(EMP_AREA_SHOWN); }} className="h-4 w-4 rounded border-slate-300 accent-[#0072CE]" />
                                        Include {pluralize(view.leftCount, 'person who has', 'people who have')} left the company
                                    </label>
                                )}
                            </div>
                            {checking && <div role="status" className="px-5 py-2 text-xs font-bold text-[#00468B] bg-[#E6F1FB]/60 border-b border-slate-100">Checking who is still with the company ({statusNow.done} of {statusNow.total})...</div>}
                            {statusNow && !statusNow.loading && statusNow.failed && <div role="alert" className="px-5 py-2 text-xs font-bold text-[#B80022] bg-[#FDE8EC] border-b border-slate-100">The employee list could not be checked, so people who have left may still be shown and crews are missing.</div>}
                            <div className="overflow-x-auto">
                                <table className="min-w-full text-sm">
                                    <caption className="sr-only">People ranked by their experience in {areaTitle}: hours, shifts, first and last time there, and the team they usually work under</caption>
                                    <thead className="bg-slate-50"><tr>
                                        <th scope="col" className={th}>#</th>
                                        <th scope="col" className={th}>Person</th>
                                        <th scope="col" className={th}>Hours there</th>
                                        <th scope="col" className={`${th} text-right hidden md:table-cell`}>Shifts there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>First there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>Last there</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}>Usually under</th>
                                        <th scope="col" className={`${th} hidden md:table-cell`}><span className="sr-only">Their own numbers</span></th>
                                    </tr></thead>
                                    <tbody className="divide-y divide-slate-100">
                                        {list.slice(0, areaShown).map((x, i) => (
                                            <tr key={x.key} className={i === 0 && areaSort === 'hours' ? 'bg-[#FFF6E0]/60' : 'hover:bg-slate-50'}>
                                                <td className="px-4 py-2.5 font-black text-slate-500 tabular-nums">{i + 1}</td>
                                                <td className="px-4 py-2.5">
                                                    <div className="font-bold text-slate-800">{x.label}{i === 0 && areaSort === 'hours' && <span className="ml-2 text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFB81C] text-slate-900">Most experienced</span>}</div>
                                                    <div className="flex flex-wrap items-center gap-1.5 mt-0.5 empty:hidden">
                                                        {x.st && x.st.role && <span className={`${badge} bg-[#FFF6E0] text-slate-700 border-[#FFB81C]`}>{x.st.role}</span>}
                                                        {x.st && x.st.crew && <span className={`${badge} bg-[#E6F1FB] text-[#00468B] border-[#B3D4F2]`}>Crew {x.st.crew}</span>}
                                                        {x.st && x.st.left && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Left the company</span>}
                                                        {x.st && !x.st.known && !x.st.left && statusNow && !statusNow.loading && !statusNow.failed && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Not in the employee list</span>}
                                                        {x.dupName && <span className={`${badge} bg-slate-100 text-slate-600 border-slate-200`}>Another employee has this name</span>}
                                                    </div>
                                                    <div className="md:hidden mt-1 text-xs text-slate-600">{x.team ? `Usually under ${x.team}. ` : ''}There {dayText(x.firstDay)} to {dayText(x.lastDay)}.</div>
                                                    <div className="md:hidden mt-1">{theirNumbers(x)}</div>
                                                </td>
                                                <td className="px-4 py-2.5">
                                                    <div className="flex items-center gap-2 sm:min-w-[150px]">
                                                        <div className="hidden sm:block flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div className="h-2 rounded-full bg-[#0072CE]" style={{ width: `${Math.max(2, Math.round((x.ms / maxMs) * 100))}%` }} /></div>
                                                        <span className="text-sm font-bold text-slate-700 w-16 text-right tabular-nums">{hrs(x.hours)}</span>
                                                    </div>
                                                    <div className="md:hidden text-right text-xs font-bold text-[#0072CE] tabular-nums">{pluralize(x.shifts, 'shift', 'shifts')}</div>
                                                </td>
                                                <td className="px-4 py-2.5 text-right font-black text-[#0072CE] tabular-nums hidden md:table-cell">{x.shifts}</td>
                                                <td className="px-4 py-2.5 text-slate-600 whitespace-nowrap hidden md:table-cell">{dayText(x.firstDay)}</td>
                                                <td className="px-4 py-2.5 text-slate-600 whitespace-nowrap hidden md:table-cell">{dayText(x.lastDay)}</td>
                                                <td className="px-4 py-2.5 text-slate-600 hidden md:table-cell">{x.team || '-'}</td>
                                                <td className="px-4 py-2.5 text-right whitespace-nowrap hidden md:table-cell">{theirNumbers(x)}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                            {list.length > areaShown && (
                                <div className="p-3 border-t border-slate-200 flex justify-center bg-slate-50/80">
                                    <button type="button" onClick={() => setAreaShown(c => c + 25)} className="text-sm font-semibold text-[#0072CE] hover:text-[#00468B] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] px-6 py-2 rounded-full shadow-sm transition-colors">
                                        Show more ({list.length - areaShown} left)
                                    </button>
                                </div>
                            )}
                        </section>

                        {(n.noEnd > 0 || n.capped > 0 || n.slips > 0 || areaRanking.totalPeople > EMP_AREA_PEOPLE_MAX) && (
                            <div className="px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm space-y-1">
                                {n.noEnd > 0 && <p>{pluralize(n.noEnd, 'assignment')} had no end time and nothing to show when {n.noEnd === 1 ? 'it' : 'they'} ended, so {n.noEnd === 1 ? 'it adds' : 'they add'} no hours.</p>}
                                {n.capped > 0 && <p>{pluralize(n.capped, 'assignment')} ran longer than {EMP_MAX_ROW_MS / 3600000} hours and {n.capped === 1 ? 'is' : 'are'} counted as {EMP_MAX_ROW_MS / 3600000} hours.</p>}
                                {n.slips > 0 && <p>{pluralize(n.slips, 'move')} lasting under {EMP_SLIP_MS / 60000} minutes {n.slips === 1 ? 'was' : 'were'} ignored.</p>}
                                {areaRanking.totalPeople > EMP_AREA_PEOPLE_MAX && <p>Only the {EMP_AREA_PEOPLE_MAX} people with the most hours were checked against the employee list for crew and for who has left.</p>}
                            </div>
                        )}

                        <details className="bg-white rounded-xl border border-slate-200 shadow-sm px-5 py-3 text-sm text-slate-600">
                            <summary className="cursor-pointer text-sm font-black text-[#00468B] uppercase tracking-widest">How this ranking is worked out</summary>
                            <ul className="mt-3 space-y-1.5 list-disc pl-5">
                                <li>Every time Shift Start puts someone in a room or area it saves a row. Only the rows for the room or area typed are read, a few days at a time.</li>
                                <li><b>Hours there</b> run from the start of an assignment to its end time. Shift Start stamps an end time when someone is moved, so an assignment with no end time ran to the end of that shift (6 PM for days, 6 AM for nights). Never more than {EMP_MAX_ROW_MS / 3600000} hours for one assignment, and a move that is undone within {EMP_SLIP_MS / 60000} minutes is ignored.</li>
                                <li><b>Shifts there</b> counts each shift once, even when the person was moved in and out. A night shift (6 PM to 6 AM) counts for the day it began.</li>
                                <li>The default order is <b>most hours</b>: time spent in the room or area, not how well the work went. Switch to most shifts, or to who was there most recently, to see someone who has been away from it for a while.</li>
                                <li>The employee list is asked about the people found, a few names at a time. A blank Shift there means the person has left the company, so they are hidden unless you include them. A crew can be picked once the list has been checked.</li>
                                <li>"Their numbers" opens that person in the employee query for the same days.</li>
                            </ul>
                        </details>
                    </>
                )}
            </div>
        );
    };

    const renderEmployeeTab = () => {
        const p = empProfile;
        const inputCls = "w-full border border-slate-300 rounded-lg py-2 px-3 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE] bg-white";
        const labelCls = "block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5";
        const cardHead = "bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-baseline justify-between gap-2";
        const th = "px-4 py-2.5 text-left text-[10px] font-black text-slate-500 uppercase tracking-wider whitespace-nowrap";
        const list = empSuggest.key === empQuery ? empSuggest.rows : [];
        const searching = empSearchable && (empSuggest.loading || empSuggest.key !== empQuery);
        const showList = empOpen && empSearchable && !(empPick && empQuery === empPick.label);
        const reading = !!empPick && empData.key === empKey && empData.loading;
        const words = empPick ? empPick.label.split(/\s+/).filter(Boolean) : [];
        const initials = words.length ? (words[0].charAt(0) + (words.length > 1 ? words[words.length - 1].charAt(0) : '')).toUpperCase() : '?';
        const hrs = (h) => { const r = Math.round(h * 10) / 10; return `${r % 1 === 0 ? r.toFixed(0) : r.toFixed(1)} h`; };
        const pct = (x) => `${Math.round(x * 100)}%`;
        const pickFromList = (r) => pickEmployee(r);
        const onKey = (e) => {
            const n = list.length;
            if (e.key === 'ArrowDown') { e.preventDefault(); setEmpOpen(true); if (n) setEmpActive(i => (i + 1) % n); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) setEmpActive(i => (i <= 0 ? n - 1 : i - 1)); }
            else if (e.key === 'Enter') {
                const r = showList && !searching ? (empActive >= 0 ? list[empActive] : (n === 1 ? list[0] : null)) : null;
                if (r) { e.preventDefault(); pickFromList(r); }
            }
            else if (e.key === 'Escape') { setEmpOpen(false); setEmpActive(-1); }
        };
        const n = p ? p.notes : null;
        const shareBar = (share) => (
            <div className="flex items-center gap-2 min-w-[120px]">
                <div className="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div className="h-2 rounded-full bg-[#0072CE]" style={{ width: `${Math.max(2, Math.round(share * 100))}%` }} /></div>
                <span className="text-xs font-bold text-slate-500 w-9 text-right">{pct(share)}</span>
            </div>
        );

        const header = (
            <div>
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Employee Query</h2>
                <p className="text-sm text-slate-500">{empMode === 'area'
                    ? 'Type a room or area to see who has spent the most time there, and when and under whom. Built from the assignments saved by Shift Start.'
                    : 'Type a name to see where that person was assigned, for how long, and whose team they were on. Built from the assignments saved by Shift Start.'}</p>
                <div className="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Look up by">
                    <Chip on={empMode === 'person'} onClick={() => setEmpMode('person')}>By employee</Chip>
                    <Chip on={empMode === 'area'} onClick={() => setEmpMode('area')}>By room or area</Chip>
                </div>
            </div>
        );
        if (empMode === 'area') return renderAreaQuery({ inputCls, labelCls, cardHead, th, hrs, pct, header });

        return (
            <div className="animate-in fade-in duration-300 flex flex-col gap-4">
                {header}

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5">
                    <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] items-start">
                        <div className="relative">
                            <label htmlFor="emp-search" className={labelCls}>Employee</label>
                            <div className="relative">
                                <SearchIcon className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                                <input
                                    id="emp-search" ref={empInputRef} type="text" autoComplete="off" spellCheck={false}
                                    role="combobox" aria-expanded={showList} aria-controls="emp-suggest" aria-autocomplete="list"
                                    aria-activedescendant={showList && empActive >= 0 ? `emp-opt-${empActive}` : undefined}
                                    placeholder="Type a first or last name, for example Kevin or Heldermon"
                                    value={empText}
                                    onChange={e => {
                                        const v = e.target.value;
                                        setEmpText(v); setEmpOpen(true); setEmpActive(-1);
                                        if (empPick && v.trim() !== empPick.label) { setEmpPick(null); setEmpData({ key: '', rows: [], loading: false, error: '', capped: 0, done: 0, total: 0, otherId: 0, at: 0 }); }   // typing over the name: the old person's numbers go away
                                    }}
                                    onFocus={() => setEmpOpen(true)}
                                    onBlur={() => setEmpOpen(false)}
                                    onKeyDown={onKey}
                                    className={`${inputCls} pl-9 pr-10 placeholder:text-slate-500`}
                                />
                                {empText && (
                                    <button type="button" aria-label="Clear the name" onClick={clearEmployee} className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                                        <XIcon className="w-4 h-4" />
                                    </button>
                                )}
                            </div>
                            {showList && (
                                <ul id="emp-suggest" role="listbox" aria-label="Matching employees" className="absolute z-30 left-0 right-0 mt-1 max-h-80 overflow-auto bg-white border border-slate-200 rounded-xl shadow-lg py-1">
                                    {searching && <li role="presentation" className="px-4 py-3 text-sm text-slate-500">Searching...</li>}
                                    {!searching && empSuggest.failed && <li role="presentation" className="px-4 py-3 text-sm font-bold text-[#E4002B]">The employee list could not be searched. Try again.</li>}
                                    {!searching && !empSuggest.failed && list.length === 0 && <li role="presentation" className="px-4 py-3 text-sm text-slate-500">No employee has "{empQuery}" in their name.</li>}
                                    {!searching && list.map((r, i) => {
                                        const info = readEmployeeShiftInfo(r);
                                        const blankShift = r.craa5_shift === null || r.craa5_shift === '' || r.craa5_Shift === null || r.craa5_Shift === '';
                                        const role = EMP_ROLE_NAMES[r.craa5_role];
                                        return (
                                            <li key={r.craa5__aa_employeeid || r.craa5_aa_employeeid || i} id={`emp-opt-${i}`} role="option" aria-selected={i === empActive}
                                                onMouseDown={e => { e.preventDefault(); pickFromList(r); }} onMouseEnter={() => setEmpActive(i)}
                                                className={`px-4 py-2.5 cursor-pointer flex items-center justify-between gap-3 ${i === empActive ? 'bg-[#E6F1FB]' : 'hover:bg-slate-50'}`}>
                                                <span className="text-sm font-bold text-slate-800 truncate">{formatFullName(r.craa5_name)}</span>
                                                <span className="flex items-center gap-1.5 flex-shrink-0">
                                                    {role && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFF6E0] text-slate-700 border border-[#FFB81C]">{role}</span>}
                                                    {info.crew && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">Crew {info.crew}</span>}
                                                    {info.blank && blankShift && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Left the company</span>}
                                                </span>
                                            </li>
                                        );
                                    })}
                                    {!searching && list.length >= EMP_SUGGEST_MAX && <li role="presentation" className="px-4 py-2 text-xs font-bold text-slate-500 border-t border-slate-100">Showing the first {EMP_SUGGEST_MAX}. Type more of the name to narrow it down.</li>}
                                </ul>
                            )}
                            <div className="sr-only" role="status" aria-live="polite">{showList && !searching ? `${list.length} matching ${list.length === 1 ? 'employee' : 'employees'}` : ''}</div>
                        </div>
                        <div>
                            <span className={labelCls}>Days to look at</span>
