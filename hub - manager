    if (cursor < to) pushGap(cursor, to, last, next ? startMs(next) : null);
    return { blocks, runCount, runMs, idleMs: Math.max(0, (to - from) - runMs), overlaps, shortAllergen: blocks.filter(b => b.type === 'gap' && b.short).length };
