    return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">
            <div role="dialog" aria-modal="true" aria-labelledby="mh-profile-title" tabIndex={-1} onKeyDown={trapTabKey} data-mh-dialog="profile" className="outline-none bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[92vh] overflow-hidden flex flex-col">
