            const back = ganttReturnRef.current; ganttReturnRef.current = null;
            if (back && back.focus && back !== document.body && document.body.contains(back)) back.focus();
        };
    }, [isGanttModalOpen]);

    // The run being adjusted, checked: { problem, s, e, lineN, clash } (s / e are the new start and end).
    const checkEditedRun = (d) => {
        const sDay = parseYMD(d.startDate), eDay = parseYMD(d.endDate);
        const s = sDay && withTime(sDay, d.startTime), e = eDay && withTime(eDay, d.endTime);
        const code = String(d.productCode === undefined || d.productCode === null ? '' : d.productCode).trim();
        const lineN = Math.max(1, parseInt(d.line, 10) || 1);
        let problem = null;
        if (!s || !e) problem = 'Choose the start and end date and time.';
        else if (e.getTime() <= s.getTime()) problem = 'The end has to be after the start.';
        else if (!String(d.area || '').trim()) problem = 'Choose an area.';
        else if (!String(d.product || '').trim()) problem = 'Enter the product.';
        else if (code !== '' && !/^\d{1,9}$/.test(code)) problem = 'Product code must be a whole number (digits only).';
        const pool = editLook && editRuns.key === editLook.key ? prodSchedules.concat(editRuns.rows) : prodSchedules;
        const clash = problem ? null : (pool.find(r => runIdOf(r) !== d.id && renderSafe(r.craa5_area || r.craa5_Area) === d.area && lineOf(r) === lineN && startMs(r) < e.getTime() && endMs(r) > s.getTime()) || null);
        return { problem, s, e, lineN, code, clash };
    };

    const handleUpdateSchedule = async () => {
        if (!editSchData || editSaving) return;
        const chk = checkEditedRun(editSchData);
        if (chk.problem) { notify(chk.problem, "error"); return; }
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't save: no Dataverse write connection in this environment. Nothing was changed.", "error"); return; }
        setEditSaving(true);
        try {
            const sTime = chk.s.toISOString();
            const eTime = chk.e.toISOString();
            const id = editSchData.id;
            const d = editSchData;
            // The times are written only when they were changed: saving an untouched time must not rewrite it (the dialog shows
            // minutes, the stored time may have seconds, and the repeated hour when clocks go back can't be told apart).
            const startSame = !!d.orig && d.startDate === d.orig.startDate && d.startTime === d.orig.startTime;
            const endSame = !!d.orig && d.endDate === d.orig.endDate && d.endTime === d.orig.endTime;
            const logicalPayload = {
                craa5_area: d.area,
                craa5_line: chk.lineN,
                craa5_productcode: chk.code === '' ? null : Number(chk.code),
                craa5_product: d.product.trim(),
                craa5_allergen: !!d.allergen,
                craa5_crumbclean: !!d.crumbClean,
                craa5_typeofallergen: d.allergen ? (d.typeOfAllergen || "") : ""
            };
            if (!startSame) logicalPayload.craa5_datestarttime = sTime;
            if (!endSame) logicalPayload.craa5_dateendtime = eTime;

            await writeApi.update(TABLE_PROD, id, logicalPayload);
            touched(id);
            setEditRuns(p => ({ ...p, rows: p.rows.map(r => runIdOf(r) === id ? { ...r, ...logicalPayload } : r) }));

            setProdSchedules(prev => prev.map(s => {
                const sId = s.craa5__aa_prd_schdid || s.craa5_aa_prd_schdid;
                if (sId === id) {
                    const merged = { ...s, ...logicalPayload, craa5_Area: logicalPayload.craa5_area, craa5_Product: logicalPayload.craa5_product };
                    if (!startSame) { merged.craa5_Datestarttime = sTime; merged.craa5_starttime = sTime; }
                    if (!endSame) { merged.craa5_Dateendtime = eTime; merged.craa5_endtime = eTime; }
                    return merged;
                }
                return s;
            }).sort(byStartAsc));
            setEditSchOpen(false);
