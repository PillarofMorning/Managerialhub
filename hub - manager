        const t = bump(teams, held ? 'sup:' + supKey : 'lead:' + leadKey, { lead: held ? '' : it.lead, held, sups: {}, days: {}, ms: 0, rows: 0, last: 0 });
        if (!held) t.lead = it.lead;
