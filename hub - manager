const MH_RATING_LABELS = [
    'Needs a lot of support',          // -5
    'Needs much more support',         // -4
    'Needs more support',              // -3
    'Needs some support',              // -2
    'Nearly meets expectations',       // -1
    'Meets expectations',              //  0
