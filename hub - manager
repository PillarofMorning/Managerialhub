                {!empPick && (
                    <div className="bg-white rounded-xl border border-dashed border-slate-300 px-6 py-10 text-center">
                        <SearchIcon className="w-8 h-8 text-[#0072CE] mx-auto mb-3" />
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">Search for an employee</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">You will see how many times they were assigned to each area and for how long, how many days and hours they worked, the area they are strongest in, and the team they were on most often.</p>
                    </div>
                )}

                {empPick && (
                    <div onDoubleClick={mhAllowed ? (e) => { if (!mhOnControl(e)) mhOpenProfile(mhTargetFromPick(empPick)); } : undefined} className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 flex flex-wrap items-center gap-4">
                        <div aria-hidden="true" className="h-12 w-12 rounded-full bg-[#CFE3F7] text-[#00468B] flex items-center justify-center font-black text-base flex-shrink-0">{initials}</div>
                        <div className="min-w-0 flex-1">
                            <h3 className="text-lg font-black text-[#00468B] leading-tight truncate">{empPick.label}</h3>
                            <div className="flex flex-wrap items-center gap-1.5 mt-1">
                                {empPick.role && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFF6E0] text-slate-700 border border-[#FFB81C]">{empPick.role}</span>}
                                {empPick.crew && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">Crew {empPick.crew}</span>}
                                {empPick.left && <span className="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Left the company</span>}
                                {!empWin.error && <span className="text-xs font-bold text-slate-500">{empWin.first} to {empWin.last} ({pluralize(empWin.days, 'day')})</span>}
                            </div>
                        </div>
                        {p && p.hasRows && (
                            <button type="button" onClick={copyEmpTable} className="px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 rounded-md transition-colors flex items-center gap-2 shadow-sm" title="Copy these numbers to paste into Excel">
                                <FileSpreadsheetIcon className="w-4 h-4" /> Copy for Excel
                            </button>
                        )}
                        {mhAllowed && (
                            <button type="button" data-mh-profile-open onClick={() => mhOpenProfile(mhTargetFromPick(empPick))} className="px-3 py-2 min-h-[44px] sm:min-h-0 text-sm font-medium text-[#00468B] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] rounded-md transition-colors flex items-center gap-2 shadow-sm" title="Notes, pros and cons, snapshots and the rating (or double-click the card)">
                                <MhPersonIcon className="w-4 h-4" /> Profile
                            </button>
                        )}
                    </div>
                )}
                {empPick && mhAllowed && <MhEmployeeNotes key={empPick.id} dataApi={dataApi} access={mhAccess} notify={notify} guid={cleanGuid(empPick.guid)} name={empPick.name} profile={p} range={empWin.error ? null : { first: empWin.first, last: empWin.last, days: empWin.days }} />}

                {empPick && empWin.error && empRange.k !== 'custom' && <div role="alert" className="px-4 py-3 rounded-xl bg-[#FDE8EC] border border-[#E4002B]/40 text-[#B80022] text-sm font-bold">{empWin.error}</div>}

                {reading && (
                    <div className="px-4 py-3 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2] text-[#00468B] text-sm font-bold" role="status">
                        Reading {empPick.label}'s assignments{empData.total > 1 ? ` (part ${Math.min(empData.done + 1, empData.total)} of ${empData.total})` : ''}...
                        <div className="mt-2 h-1.5 rounded-full bg-white overflow-hidden"><div className="h-1.5 bg-[#0072CE] transition-all" style={{ width: `${Math.round(((empData.done || 0) / Math.max(1, empData.total)) * 100)}%` }} /></div>
                    </div>
                )}
                {empPick && empData.key === empKey && empData.error && <div role="alert" className="px-4 py-3 rounded-xl bg-[#FDE8EC] border border-[#E4002B]/40 text-[#B80022] text-sm font-bold">{empData.error}</div>}
                {empPick && empData.key === empKey && empData.capped > 0 && <div role="alert" className="px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm">{empData.capped === 1 ? 'One stretch of this range holds' : `${empData.capped} stretches of this range hold`} more than {RANGE_LIMIT.toLocaleString()} rows, so the oldest rows there are missing. Pick fewer days for exact numbers.</div>}

                {p && !p.hasRows && !reading && !empData.error && (
                    <div className="bg-white rounded-xl border border-slate-200 px-6 py-8 text-center">
                        <p className="text-sm font-black text-[#00468B] uppercase tracking-widest">No assignments found</p>
                        <p className="text-sm text-slate-500 mt-2 max-w-xl mx-auto">{empPick.label} has no Shift Start assignments between {empWin.first} and {empWin.last}. Try more days, or check that this is the right person if two employees share a name.</p>
                    </div>
                )}

                {p && p.hasRows && (
                    <>
                        <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
                            {[
                                { label: 'Days worked', value: p.daysWorked, sub: `of ${pluralize(empWin.days, 'day')} looked at` },
                                { label: 'Hours worked', value: hrs(p.hours), sub: p.daysWorked ? `about ${hrs(p.hours / p.daysWorked)} a day` : 'no hours measured' },
                                { label: 'Strongest area (recommended)', value: p.strongest ? p.strongest.name : 'Not enough history', small: true,
                                    sub: p.strongest ? `${hrs(p.strongest.hours)} over ${pluralize(p.strongest.times, 'shift')} (${pct(p.strongest.share)} of their time)` : `needs at least ${EMP_MIN_SHIFTS_FOR_STRONGEST} shifts in one area` },
                                { label: 'Most often on team', value: p.topTeam ? p.topTeam.label : 'No team named', small: true,
                                    sub: p.topTeam ? `${pluralize(p.topTeam.times, 'shift')}, ${hrs(p.topTeam.hours)}${p.topTeam.supName && !p.topTeam.held ? `, under ${p.topTeam.supName}` : ''}` : '' },
                            ].map(k => (
                                <div key={k.label} className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex flex-col justify-between min-w-0">
                                    <p className="text-[10px] font-black text-slate-500 uppercase tracking-widest">{k.label}</p>
                                    <p className={`${k.small ? 'text-lg' : 'text-3xl'} font-black text-[#0072CE] leading-tight mt-1 break-words`}>{k.value}</p>
                                    <p className="text-xs text-slate-500 mt-1">{k.sub}</p>
                                </div>
                            ))}
                        </div>

                        <section aria-labelledby="emp-areas-h" className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div className={cardHead}>
                                <h3 id="emp-areas-h" className="text-sm font-black text-[#00468B] uppercase tracking-widest">Where they were assigned</h3>
                                <span className="text-xs font-bold text-slate-600">{pluralize(p.timesAssigned, 'time')} in {pluralize(p.areas.length, 'area')}</span>
                            </div>
                            <div className="overflow-x-auto">
                                <table className="min-w-full text-sm">
                                    <caption className="sr-only">Areas this employee was assigned to, with the number of times, the hours and the share of their time</caption>
                                    <thead className="bg-slate-50"><tr>
                                        <th scope="col" className={th}>Area</th>
                                        <th scope="col" className={`${th} text-right`}>Times assigned</th>
                                        <th scope="col" className={`${th} text-right`}>Hours</th>
                                        <th scope="col" className={th}>Share of their time</th>
                                        <th scope="col" className={th}>Last assigned</th>
                                    </tr></thead>
                                    <tbody className="divide-y divide-slate-100">
                                        {p.areas.map(a => (
                                            <tr key={a.name} className={p.strongest && p.strongest.name === a.name ? 'bg-[#FFF6E0]/60' : 'hover:bg-slate-50'}>
                                                <td className="px-4 py-2.5 font-bold text-slate-800">{a.name}{p.strongest && p.strongest.name === a.name && <span className="ml-2 text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFB81C] text-slate-900">Strongest</span>}</td>
                                                <td className="px-4 py-2.5 text-right font-black text-[#0072CE] tabular-nums">{a.times}</td>
                                                <td className="px-4 py-2.5 text-right font-bold text-slate-700 tabular-nums">{hrs(a.hours)}</td>
                                                <td className="px-4 py-2.5">{shareBar(a.share)}</td>
                                                <td className="px-4 py-2.5 text-slate-500 whitespace-nowrap">{fmtDay(parseYMD(a.lastDay) || new Date(a.last))}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                    <tfoot className="bg-slate-50"><tr>
                                        <th scope="row" className="px-4 py-2.5 text-left text-xs font-black text-slate-600 uppercase tracking-wider">All areas</th>
                                        <td className="px-4 py-2.5 text-right font-black text-slate-700 tabular-nums">{p.timesAssigned}</td>
                                        <td className="px-4 py-2.5 text-right font-black text-slate-700 tabular-nums">{hrs(p.hours)}</td>
                                        <td colSpan={2}></td>
                                    </tr></tfoot>
                                </table>
                            </div>
                        </section>

                        <section aria-labelledby="emp-teams-h" className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
