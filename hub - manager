    // ------------------------------------------------------------------------
    // The runs on one area + line for a time window, read on demand (the Adjust run dialog's overlap warning uses it).
    // ------------------------------------------------------------------------
    const readLineRuns = (lk, area, line) => queryRecords(TABLE_PROD, dataApiRef.current, {
        filter: `statecode eq 0 and craa5_area eq '${odataStr(area)}' and craa5_line eq ${line} and craa5_datestarttime lt ${isoZ(lk.to)} and craa5_dateendtime gt ${isoZ(lk.from)}`,
