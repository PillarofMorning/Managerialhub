    cards.forEach(c => c.people.sort((a, b) => a.area.localeCompare(b.area) || a.name.localeCompare(b.name)));
    out.sort((a, b) => a.status.localeCompare(b.status) || a.area.localeCompare(b.area) || a.name.localeCompare(b.name));
    const onFloor = cards.reduce((n, c) => n + c.people.length, 0);
    const sups = []; cards.forEach(c => c.teams.forEach(t => { if (sups.indexOf(t) < 0) sups.push(t); }));
    return { from, notes, cards, out, onFloor, supervisors: sups.sort() };
}

