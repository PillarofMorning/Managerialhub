    }

    const TABS = [
        { id: 'overview', label: 'Overview & KPIs', icon: LayoutDashboardIcon },
        { id: 'employee', label: 'Employee Query', icon: SearchIcon },
        { id: 'calendar', label: 'Shift Cal', icon: CalendarIcon },
        { id: 'lineorder', label: 'Line order', icon: ListOrderedIcon },
        { id: 'tasks', label: 'Delegation', icon: TargetIcon },
        MH_FORM_TAB,   // v6.7: the forms library, open to everyone (see MH FORMS)
    ];
    // v6.5: High fives and Call-outs for allowed users only, the Dataverse check once the logo has unlocked it (concat, no spread).
    const visibleTabs = TABS.concat(mhAllowed ? [MH_TABS.kudos, MH_TABS.callouts] : [], mhUnlock.unlocked ? [MH_TABS.dvcheck] : []);

    // ------------------------------------------------------------------------
    // LINE ORDER TAB: the list the pages follow, edited here and saved to Dataverse. The bar at the bottom stays in view.
    // ------------------------------------------------------------------------
    const renderLineOrderTab = () => {
        const n = lpDraft.length, probs = Object.keys(lpProblems).length, sum = lpPlan.sum;
        const tones = { ok: 'bg-green-100 text-green-800 border-green-300', idle: 'bg-slate-100 text-slate-700 border-slate-300', warn: 'bg-[#FFF6E0] text-[#7A4B00] border-[#FFB81C]', bad: 'bg-[#FDE8EC] text-[#B80022] border-[#E4002B]/40' };
        const tableGone = lpTableMissing(lpInfo), noApi = lpNoApi(lpInfo), canWrite = !!getWriteApi(dataApi);
        // The last read failed for a reason other than "no such table": the person must see the real reason, and Save stays off until the table can be read.
        const readBad = lpReadErr || (lpInfo && !lpInfo.found && !tableGone ? String(lpInfo.why || 'The table could not be read.') : '');
        const failKind = lpInfo && !lpInfo.found && lpInfo.why ? linePriorityClassify(lpInfo.why) : '';
        const problemOf = (why) => lpReadProblem({ found: false, why });
        let chip = { tone: 'idle', text: 'Reading the table…', retry: false }, chipKind = 'reading';
        if (lpInfo) {
            if (lpReadErr) { chip = { tone: 'bad', text: `Could not read the table just now: ${problemOf(lpReadErr)}. The list below is from the last time it was read.`, retry: true }; chipKind = 'unreadable'; }
            else if (lpSourceDv) { chip = { tone: 'ok', text: `Saved in Dataverse, ${pluralize(lpInfo.entries.length, 'line')}`, retry: false }; chipKind = 'dataverse'; }
            else if (lpLocalOn) { chip = { tone: 'warn', text: `This computer’s own order, kept here. ${lpInfo.found ? 'The Dataverse table is empty.' : noApi ? 'This page is not connected to Dataverse.' : 'The table is not set up yet.'} The other apps use the built-in order.`, retry: false }; chipKind = 'local'; }
            else if (noApi) { chip = { tone: 'idle', text: 'This page is not connected to Dataverse, so the order cannot be read or saved here. The built-in order is used.', retry: false }; chipKind = 'default'; }
            else if (lpInfo.found) { chip = { tone: 'idle', text: 'Built-in order, the table is empty', retry: false }; chipKind = 'empty'; }
            else if (tableGone) { chip = { tone: 'idle', text: 'Built-in order, the table is not set up yet', retry: false }; chipKind = 'default'; }
            else { chip = { tone: 'bad', text: `Could not read the table: ${problemOf(lpInfo.why)}. The built-in order is used.`, retry: true }; chipKind = 'unreadable'; }
        }
        const typedMissed = !!lpPicks.table && !!lpInfo && lpInfo.found && !!lpInfo.table && linePriorityCanon(lpPicks.table) !== linePriorityCanon(lpInfo.table);
        const suggestions = lpSuggestions(lpLanes, lpDraftEntries);
        const seenPick = suggestions.some(sg => sg.name === lpSeen) ? lpSeen : '';
        const sorted = sortLanesByPriority(lpLanes, lpDraftEntries);
        const prodPrev = sorted.filter(l => !l.support), supPrev = sorted.filter(l => l.support);
        const needsCard = lpCardTick > 0 || tableGone || failKind === 'column' || failKind === 'denied';   // the table or a column the order needs is not there (or a save said so)
        const fixNote = tableGone ? 'The Line Priority table is not set up yet.' : failKind === 'column' ? 'A column the order needs was not found.' : failKind === 'denied' ? 'You may not have permission to read the table.' : 'The table or one of its columns needs attention.';
        const cardSummary = lpInfo && lpInfo.found && !lpReadErr ? (lpInfo.missing.length ? `Working, ${lpInfo.missing.length} optional missing` : 'All found') : undefined;
        const canSave = !!lpInfo && !lpBusy && !lpConflict && n > 0 && probs === 0 && !lpColsMsg && !readBad && (lpSourceDv ? sum.writes > 0 : true);
        const summaryText = lpColsMsg ? lpColsMsg
            : probs ? 'Fix the lines marked in red before saving.'
            : n === 0 ? 'The list is empty.'
            : !lpInfo ? 'Reading the table…'
            : lpSourceDv ? sum.text
            : noApi ? 'This page has no connection to Dataverse, so the order cannot be saved here.'
            : readBad ? 'The table could not be read, so this is the built-in order. Saving is off until it can be read.'
            : `${lpDirty ? 'You have unsaved edits. ' : ''}Nothing is saved in Dataverse yet: saving writes all ${pluralize(n, 'line')}.`;
        const statusTone = lpStatus.kind === 'error' ? 'text-[#B80022]' : lpStatus.kind === 'warn' ? 'text-[#7A4B00]' : lpStatus.kind === 'ok' ? 'text-green-800' : 'text-slate-700';
        const retryNow = lpStatus.kind === 'error' && !!lpStatus.retry && !lpBusy;   // after a failed save the main button is Retry (the same action, said plainly)
        const btn = 'min-h-[44px] px-4 py-2 rounded-lg text-sm font-extrabold border focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 disabled:opacity-50 disabled:cursor-not-allowed';
        const small = 'min-h-[44px] min-w-[44px] px-3 rounded-lg text-sm font-bold border border-slate-300 bg-white text-[#00468B] hover:bg-[#E6F1FB] focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 disabled:opacity-40 disabled:cursor-not-allowed';
        const input = 'w-full min-h-[44px] border border-slate-300 rounded-lg px-3 text-base sm:text-sm bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE] disabled:bg-slate-100 disabled:text-slate-500';
        const fieldText = (f) => Object.keys(f || {}).map(k => `${k} = ${JSON.stringify(f[k])}`).join(', ');
        const stepText = (s) => `${LP_STEP_WORDS[s.op] || s.op} “${s.name}”${s.id ? ` (id ${s.id})` : ''}${Object.keys(s.fields || {}).length ? `: ${fieldText(s.fields)}` : ''}`;
        const listed = (l) => linePriorityRank(lpDraftEntries, l.area, l.line) !== LINE_PRIORITY_NONE;
        const prevItem = (l, i) => (
            <li key={`${l.area}|${l.line}`} className="flex items-baseline gap-2 min-w-0 text-sm">
                <span className="w-6 flex-shrink-0 text-right font-black text-[#00468B]">{i + 1}</span>
                <span className="min-w-0 truncate font-semibold text-slate-800" title={`${l.area}, line ${l.line}`}>{l.area} · Line {l.line}</span>
                {!listed(l) && <span className="flex-shrink-0 text-[11px] text-slate-500">not on the list</span>}
            </li>
        );
        return (
        <div ref={lpRootRef} data-tab="lineorder" className="animate-in fade-in duration-300 flex-1 flex flex-col gap-5">
            <section aria-labelledby="lp-title">
                <h2 id="lp-title" className="text-sm font-black text-[#00468B] uppercase tracking-widest">Line order</h2>
                <p className="text-sm text-slate-700 mt-1 max-w-3xl">These are the production lines in the order the pages list them. Inside each group on the Overview (running, down for sanitation, idle), the lines at the top come first. A line that is not on the list still shows, after the ones that are. Move a line with Up and Down, then press Save to Dataverse so the other apps use the same order.</p>
                <div className="mt-3 flex flex-wrap items-center gap-2" data-lp-chip={chipKind}>
                    <p role="status" className={`inline-flex items-center px-3 py-1.5 rounded-full border text-xs font-bold ${tones[chip.tone]}`}>{chip.text}</p>
                    {chip.retry && <button type="button" onClick={() => lpReload()} disabled={lpReading} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>{lpReading ? 'Reading…' : 'Retry'}</button>}
                    {lpLocalOn && <button type="button" onClick={lpStopLocal} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>Stop using this computer&rsquo;s order</button>}
                </div>
                {typedMissed && <p data-lp-typed-note className="mt-2 text-sm text-[#7A4B00] bg-[#FFF6E0] border border-[#FFB81C] rounded-lg px-3 py-2 max-w-3xl">The table name you typed ({lpPicks.table}) was not found, so {lpInfo.table} is used.</p>}
                {needsCard && !noApi && (
                    <p data-lp-fixnote className="mt-2 text-sm text-slate-800 max-w-3xl flex flex-wrap items-center gap-x-2">{fixNote}
                        <button type="button" onClick={lpShowCard} className="min-h-[44px] inline-flex items-center text-sm font-extrabold text-[#0072CE] underline rounded focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40">Go to Columns this needs</button></p>
                )}
            </section>

            <section aria-labelledby="lp-list-title" className="max-w-5xl">
                <h3 id="lp-list-title" className="text-xs font-black text-slate-600 uppercase tracking-widest mb-2">The list ({pluralize(n, 'line')})</h3>
                <p className="mb-2 text-xs text-slate-600">Other spellings are the other names the schedule may use for the same line, for example WJ for Waterjet.</p>
                {lpSkipAliases && <p className="mb-2 text-xs text-[#7A4B00] bg-[#FFF6E0] border border-[#FFB81C] rounded-lg px-3 py-2">The table has no Other spellings column, so other spellings cannot be kept there. The boxes below are read-only until the column is added (see Columns this needs).</p>}
                {n === 0 && <p className="text-sm text-slate-600 italic py-2">The list is empty. Add a line below, or put back the built-in order.</p>}
                <ol className="space-y-2" aria-label="Lines in order">
                    {lpDraft.map((r, i) => {
                        const label = lpTrim(r.name) || `position ${i + 1}`, note = lpMatchNote(r, lpLanes), prob = lpProblems[r.k];
                        return (
                        <li key={r.k} data-lp-row={r.k} className={`rounded-lg border bg-white p-3 flex flex-col gap-2 lg:flex-row lg:items-start lg:gap-3 ${prob ? 'border-[#E4002B]' : 'border-slate-200'}`}>
                            <div className="flex gap-3 flex-1 min-w-0">
                                <span className="w-8 flex-shrink-0 min-h-[44px] flex items-center justify-center text-base font-black text-[#00468B]" aria-hidden="true">{i + 1}</span>
                                <div className="flex-1 min-w-0 grid grid-cols-1 lg:grid-cols-2 gap-x-3 gap-y-2">
