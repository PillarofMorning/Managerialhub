    var list = useMhNotesList(props.dataApi, subject, open && allowed);
    var notes = list[0], setNotes = list[1], reload = list[2], me = list[3];
    var busy = useMhNotesBusy();
    var sayPair = useMhNotesSay(), say = sayPair[0], setSay = sayPair[1];
    var save = useMhNoteSaver(props.dataApi, props.access, subject, setNotes, me, notifyRef, busy, setSay);
