                                                    <tr key={`${it.id}-${i}`} className="hover:bg-slate-50">
                                                        <td className="px-4 py-2 whitespace-nowrap text-slate-700">{fmtDay(parseYMD(it.day) || new Date(it.start))}</td>
                                                        <td className="px-4 py-2 whitespace-nowrap text-slate-500">{fmtTime(new Date(it.start))}{it.stop > it.start ? ` to ${fmtTime(new Date(it.stop))}` : ''}{it.open ? ' (still open)' : ''}{it.toShiftEnd ? ' (to end of shift)' : ''}{it.noEnd ? ' (no end time)' : ''}{it.slip ? ' (slip, ignored)' : ''}</td>
                                                        <td className="px-4 py-2 font-bold text-slate-800">{it.absence ? <span className="px-2 py-0.5 rounded-full bg-[#FFF6E0] border border-[#FFB81C] text-xs">{EMP_ABSENCE_LABELS[it.absence]}</span> : it.area}</td>
                                                        <td className="px-4 py-2 text-slate-600">{formatFullName(it.lead) || (it.sup ? `${formatFullName(it.sup)} (supervisor)` : '-')}</td>
                                                        <td className="px-4 py-2 text-right font-bold text-slate-700 tabular-nums">{it.absence || it.slip ? '-' : fmtSpan(it.ms)}</td>
