    const kpis = useMemo(() => {
        const uniqueEmpsAssigned = new Set();
        const activeLeads = new Set();
        let completedAreas = 0;
        let totalAreas = 0;
        
        dailyAssignments?.forEach(task => {
            if (task.craa5_id) uniqueEmpsAssigned.add(renderSafe(task.craa5_id));
            if (task.craa5_lead) activeLeads.add(renderSafe(task.craa5_lead));
            if (task.craa5_area) {
                totalAreas++;
                if (task.craa5_percentagecomplete === 100) completedAreas++;
            }
        });

        const activeSups = new Set(dailyAssignments?.map(a => renderSafe(a.craa5_team)).filter(Boolean));
        const openManagerTasks = todoTasks?.filter(t => t.craa5_complete !== true && t.craa5_complete !== 1)?.length || 0;
        const activeProdAreas = new Set();
        
        prodSchedules?.forEach(sch => {
            const sd = new Date(sch.craa5_datestarttime || sch.craa5_Datestarttime || sch.craa5_starttime);
            const ed = new Date(sch.craa5_dateendtime || sch.craa5_Dateendtime || sch.craa5_endtime);
            const target = new Date(selectedDate);
            if (sd.toDateString() === target.toDateString() || ed.toDateString() === target.toDateString() || (sd <= target && ed >= target)) {
                activeProdAreas.add(renderSafe(sch.craa5_area || sch.craa5_Area));
            }
        });

        return {
            staffUtilized: uniqueEmpsAssigned.size,
            leadsActive: activeLeads.size,
            supsActive: activeSups.size,
            completionRate: totalAreas === 0 ? 0 : Math.round((completedAreas / totalAreas) * 100),
            openManagerTasks,
            activeProdAreas: Array.from(activeProdAreas)
        };
    }, [dailyAssignments, todoTasks, prodSchedules, selectedDate]);

    // ========================================================================
    // UNIFIED SHIFTS ENGINE (Table & Gantt sharing same data logic)
    // ========================================================================
    const shiftWindowData = useMemo(() => {
        const isToday = selectedDate === getLocalYMD(new Date());
        const [y, m, d] = selectedDate.split('-');
        
        const windowEndMs = isToday ? currentTime : new Date(y, m - 1, d, 23, 59, 59).getTime();
        const windowStartMs = windowEndMs - (shiftLookbackHours * 3600000);

        const empMap = {};
        
        allAssignments?.forEach(task => {
            const empName = formatFullName(task.craa5_id);
            if (!empName) return;
            if (!empMap[empName]) empMap[empName] = { name: empName, tasks: [] };
            empMap[empName].tasks.push(task);
        });

        const allActiveBlocks = [];
        const uniqueShifts = new Set();

        Object.values(empMap).forEach(emp => {
            emp.tasks.sort((a,b) => new Date(a.craa5_datetimeofassignment || a.createdon).getTime() - new Date(b.craa5_datetimeofassignment || b.createdon).getTime());

            for (let i = 0; i < emp.tasks.length; i++) {
                const task = emp.tasks[i];
                const shift = normalizeShift(task["craa5_shift@OData.Community.Display.V1.FormattedValue"] || task.craa5_shift || task.craa5_Shift);
                
                const startMs = new Date(task.craa5_datetimeofassignment || task.createdon).getTime();
                const nextTask = emp.tasks[i + 1];
                const endMs = nextTask ? new Date(nextTask.craa5_datetimeofassignment || nextTask.createdon).getTime() : currentTime;

                if (endMs <= windowStartMs || startMs >= windowEndMs) continue;

                const clampStart = Math.max(startMs, windowStartMs);
                const clampEnd = Math.min(endMs, windowEndMs);

                const shiftBlocks = generateShiftBlocks(shift, windowStartMs, windowEndMs);
                
                shiftBlocks.forEach(sb => {
                    const iStart = Math.max(clampStart, sb.start);
                    const iEnd = Math.min(clampEnd, sb.end);
                    
                    if (iEnd > iStart) {
                        if (shift !== "Unknown Shift") uniqueShifts.add(shift);
                        allActiveBlocks.push({
                            empName: emp.name,
                            shift: shift,
                            area: renderSafe(task.craa5_area) || "Unassigned",
                            equip: renderSafe(task.craa5_equipment || task.craa5_equip),
                            team: renderSafe(task.craa5_team),
                            lead: renderSafe(task.craa5_lead),
                            start: iStart,
                            end: iEnd,
                            durationMs: iEnd - iStart,
                            pct: task.craa5_percentagecomplete || 0,
                            status: renderSafe(task.craa5__currentstatus),
                            originalStart: startMs,
                            taskId: task.craa5_taskassignmentid || Math.random().toString()
                        });
                    }
                });
            }
        });

        const ganttDataByShift = {};
        Array.from(uniqueShifts).forEach(s => ganttDataByShift[s] = {});

        allActiveBlocks.forEach(b => {
            if (!ganttDataByShift[b.shift]) return;
            if (!ganttDataByShift[b.shift][b.empName]) {
                ganttDataByShift[b.shift][b.empName] = { 
                    empName: b.empName, 
                    shift: b.shift,
                    shiftBlocks: generateShiftBlocks(b.shift, windowStartMs, windowEndMs),
                    blocks: [] 
                };
            }
            ganttDataByShift[b.shift][b.empName].blocks.push(b);
        });

        Object.keys(ganttDataByShift).forEach(shift => {
            Object.values(ganttDataByShift[shift]).forEach(emp => {
                const merged = [];
                if (emp.blocks.length > 0) {
                    emp.blocks.sort((a,b) => a.start - b.start);
                    let curr = { ...emp.blocks[0] };
                    for (let i = 1; i < emp.blocks.length; i++) {
                        const nxt = emp.blocks[i];
                        if (nxt.area === curr.area && nxt.status === curr.status) { 
                            curr.end = Math.max(curr.end, nxt.end);
                            curr.durationMs += nxt.durationMs;
                        } else {
                            merged.push(curr);
                            curr = { ...nxt };
                        }
                    }
                    merged.push(curr);
                }
                emp.blocks = merged;
            });
            ganttDataByShift[shift] = Object.values(ganttDataByShift[shift]).sort((a,b) => a.empName.localeCompare(b.empName));
        });

        return {
            windowStartMs,
            windowEndMs,
            uniqueShifts: Array.from(uniqueShifts).sort(),
            ganttDataByShift
        };
    }, [allAssignments, selectedDate, currentTime, shiftLookbackHours]);

    // Active Data memo for the Personnel Gantt Popout
    const activeGanttModalDataRaw = useMemo(() => {
        if (!isGanttModalOpen) return [];
        if (ganttShiftFilter) {
            return shiftWindowData.ganttDataByShift[ganttShiftFilter] || [];
        }
        const combined = [];
        Object.values(shiftWindowData.ganttDataByShift).forEach(arr => combined.push(...arr));
        combined.sort((a, b) => {
            if (a.shift !== b.shift) return a.shift.localeCompare(b.shift);
            return a.empName.localeCompare(b.empName);
        });
        return combined;
    }, [isGanttModalOpen, ganttShiftFilter, shiftWindowData]);

    // ========================================================================
    // EXCEL / IMAGE COPY
    // ========================================================================
    const handleCopyGanttImage = async () => {
        if (!ganttRef.current || typeof window.html2canvas === 'undefined') {
            notify("Image capture library is still loading. Please try again in a moment.", "error");
            return;
        }
        setIsCopyingGantt(true);
        try {
            const canvas = await window.html2canvas(ganttRef.current, { 
                scale: 2, 
                backgroundColor: "#ffffff", 
                logging: false
            });
            
            canvas.toBlob(async (blob) => {
                try {
                    const item = new ClipboardItem({ "image/png": blob });
                    await navigator.clipboard.write([item]);
                    notify("Gantt chart copied to clipboard as an image.", "success");
                } catch (err) {
                    console.warn("Clipboard API blocked, falling back to download.", err);
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Personnel_Gantt_${ganttShiftFilter ? 'Shift_'+ganttShiftFilter : 'All'}_${getLocalYMD(new Date())}.png`;
                    a.click();
                    URL.revokeObjectURL(url);
                }
            }, 'image/png');
        } catch (err) {
            console.error("Failed to generate image", err);
            notify("Failed to copy image: " + err.message, "error");
        } finally {
            setIsCopyingGantt(false);
        }
    };

    const handleCopyForExcel = () => {
        if (!isGanttModalOpen) return;
        
        const targetData = ganttAreaFilter 
            ? activeGanttModalDataRaw.filter(emp => {
                if (ganttAreaFilter === "Idle (No Tasks)") return emp.blocks.length === 0;
                return emp.blocks.some(b => b.area === ganttAreaFilter);
            })
            : activeGanttModalDataRaw;
        
        if (targetData.length === 0) {
            notify("No data available for this shift or filter.", "error");
            return;
        }

        let tsv = "Employee\tShift\tArea\tStatus\tStart Time\tEnd Time\tDuration (Hrs)\n";
        
        targetData.forEach(emp => {
            if (emp.blocks.length === 0) {
                tsv += `${emp.empName}\t${emp.shift}\tNo Active Tasks\t\t\t\t0.00\n`;
            } else {
                emp.blocks.forEach(block => {
                    const sTime = new Date(block.start).toLocaleString();
                    const eTime = new Date(block.end).toLocaleString();
                    const durHrs = (block.durationMs / 3600000).toFixed(2);
                    tsv += `${emp.empName}\t${emp.shift}\t${block.area}\t${block.status}\t${sTime}\t${eTime}\t${durHrs}\n`;
                });
            }
        });

        navigator.clipboard.writeText(tsv).then(() => {
            notify("Data copied. Press Ctrl+V to paste it into Excel.", "success");
        }).catch(err => {
            console.error("Clipboard copy failed", err);
            notify("Failed to copy text. Your browser may be blocking clipboard access.", "error");
        });
    };

    // ========================================================================
    // TABS RENDERING
    // ========================================================================
    const changeMonth = (offset) => setCalendarMonth(new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + offset, 1));
    const getCalendarDays = () => {
        const year = calendarMonth.getFullYear();
        const month = calendarMonth.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push(null);
        for (let i = 1; i <= daysInMonth; i++) days.push(i);
        return days;
    };

    const changeProdMonth = (offset) => setProdCalendarMonth(new Date(prodCalendarMonth.getFullYear(), prodCalendarMonth.getMonth() + offset, 1));
    const getProdCalendarDays = () => {
        const year = prodCalendarMonth.getFullYear();
        const month = prodCalendarMonth.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push(null);
        for (let i = 1; i <= daysInMonth; i++) days.push(i);
        return days;
    };

    // ------------------------------------------------------------------------
    // WEEKLY VIEW: a lane for every production area and line (and any other line that has a run on screen), with
    // its runs and the gaps between them for the days shown.
    // ------------------------------------------------------------------------
    const weekly = useMemo(() => {
        const win = weekWindow(selectedDate, weekSpan);
        const laneMap = {};
        const laneFor = (area, line) => {
            const key = `${area} - Line ${line}`;
            return laneMap[key] || (laneMap[key] = { key, area, line, runs: [] });
        };
        (prodSchedules || []).forEach(r => {
            const name = renderSafe(r.craa5_area || r.craa5_Area).trim() || '(no area)';
            laneFor(name, lineOf(r)).runs.push(r);
        });
        // Every production area gets a lane even when nothing is scheduled. The areas table has no line list, so an area
        // with no line number gets line 1 only when no line of that area has a run on screen.
        (areas || []).forEach(a => {
            if (!isProductionArea(a)) return;
            const name = renderSafe(a.craa5_area || a.craa5_Area || a.craa5_name).trim();
            if (!name) return;
            const explicit = parseInt(a.craa5_line || a.craa5_Line, 10);
            if (explicit) laneFor(name, explicit);
            else if (!Object.keys(laneMap).some(k => laneMap[k].area === name)) laneFor(name, 1);
        });
        const all = Object.keys(laneMap).map(k => laneMap[k]).sort((a, b) => a.area.localeCompare(b.area) || a.line - b.line);
        all.forEach(l => Object.assign(l, buildLaneBlocks(l.runs, win.from, win.to)));
        const visibleKeys = {};
        all.forEach(l => l.blocks.forEach(b => { if (b.type === 'run' && !isMaintenanceRun(b.run)) visibleKeys[productKeyOf(b.run)] = runName(b.run); }));
        const colors = assignProductColors(Object.keys(visibleKeys));
        const products = Object.keys(visibleKeys).map(k => ({ key: k, name: visibleKeys[k], color: colors[k] })).sort((a, b) => a.name.localeCompare(b.name));
        const lanes = all.filter(l => (!weekArea || l.area === weekArea) && (!weekHideIdle || l.runCount > 0));
        return {
            win, lanes, colors, products,
            areaNames: Array.from(new Set(all.map(l => l.area))).sort(),
            noRun: all.filter(l => l.runCount === 0),
            shortClean: all.reduce((n, l) => n + l.shortAllergen, 0),
            doubleBooked: all.reduce((n, l) => n + l.overlaps, 0),
            totalRuns: all.reduce((n, l) => n + l.runCount, 0),
        };
    }, [prodSchedules, areas, selectedDate, weekSpan, weekArea, weekHideIdle]);

    // ------------------------------------------------------------------------
    // EMPLOYEE QUERY: name suggestions, then ONE person's assignment rows for the chosen days (in pieces of 60 days).
    // Nothing is read until a name is typed, and only that person's rows are asked for.
    // ------------------------------------------------------------------------
    const empQuery = empText.trim();
    const todayYmd = getLocalYMD(new Date(currentTime));
    const empWin = useMemo(() => empWindowOf(empRange, todayYmd), [empRange.k, empRange.from, empRange.to, todayYmd]);
    const empKey = empPick && empWin.key ? `${empPick.id}|${empWin.key}|${reloadTick}` : '';
    empDataRef.current = empData;

    useEffect(() => {
        if (activeTab !== 'employee' || !apiReady) return;
        if (empQuery.length < 2) { setEmpSuggest(p => (p.rows.length || p.loading || p.failed) ? { key: '', rows: [], loading: false, failed: false } : p); return; }
        if (empPick && empQuery === empPick.label) return;   // the box shows the person already picked
        let alive = true;
        const timer = setTimeout(async () => {
            setEmpSuggest(p => ({ ...p, key: empQuery, loading: true, failed: false }));
            const q = { filter: empSearchFilter(empQuery), orderby: 'craa5_name asc', top: 15 };
            let rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, { ...q, select: EMP_PICK_FIELDS });
            if (rows === null) rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, q);   // a column in the list may not exist
            if (!alive) return;
            setEmpSuggest({ key: empQuery, rows: rows || [], loading: false, failed: rows === null });
            setEmpActive(-1);
        }, 250);
        return () => { alive = false; clearTimeout(timer); };
    }, [activeTab, apiReady, empQuery, empPick && empPick.label, reloadTick]);

    useEffect(() => {
        if (activeTab !== 'employee' || !apiReady || !empPick || !empKey) return;
        const cur = empDataRef.current;
        if (cur.key === empKey && !cur.loading && !cur.error && Date.now() - cur.at < 300000) return;   // read a moment ago: don't read it again
        let alive = true;
        const chunks = empChunks(empWin.from, empWin.to);
        const nameKeys = empNameVariants(empPick.name).map(normText);
        setEmpData({ key: empKey, rows: [], loading: true, error: '', capped: 0, done: 0, total: chunks.length, otherId: 0, at: 0 });
        // One piece of the range. Works down EMP_ACCESS_STEPS until a read succeeds, then keeps using that way.
        const readPiece = async (f, t) => {
            for (let guard = 0; guard < EMP_ACCESS_STEPS.length; guard++) {
                const acc = empAccessRef.current && typeof empAccessRef.current === 'object' ? empAccessRef.current : { i: 0, ok: false };
                empAccessRef.current = acc;
                const step = EMP_ACCESS_STEPS[acc.i];
                const rows = await queryRecords(TABLE_TASK, dataApiRef.current, {
                    filter: empAssignmentFilter(empPick, step, f, t), orderby: 'createdon desc', top: RANGE_LIMIT, select: step.select ? EMP_TASK_FIELDS : undefined });
                if (rows !== null) { acc.ok = true; return rows; }
                if (acc.ok) return null;                                       // it worked before: this one is a real failure, not the wrong way of asking
                if (acc.i >= EMP_ACCESS_STEPS.length - 1) { empAccessRef.current = { i: 0, ok: false }; return null; }
                acc.i++;
            }
            return null;
        };
        (async () => {
            try {
                const seen = {};
                let kept = [], capped = 0, failed = 0, otherId = 0;
                for (let i = 0; i < chunks.length; i++) {
                    if (!alive) return;
                    const rows = await readPiece(chunks[i][0], chunks[i][1]);
                    if (!alive) return;
                    if (rows === null) failed++;
                    else {
                        if (rows.length >= RANGE_LIMIT) capped++;
                        const add = [];
                        rows.forEach(r => {
                            const id = r.craa5_taskassignmentid;
                            if (id && seen[id]) return;
                            const g = cleanGuid(r.craa5__aaemp_guid);
                            if (g ? g !== empPick.guid : nameKeys.indexOf(normText(r.craa5_id)) === -1) { if (g) otherId++; return; }   // another person's row (same name, different employee id)
                            if (id) seen[id] = true;
                            add.push(r);
                        });
                        kept = kept.concat(add);
                    }
                    const snapshot = kept, doneNow = i + 1, cappedNow = capped, otherNow = otherId;
                    setEmpData(prev => prev.key === empKey ? { ...prev, rows: snapshot, done: doneNow, capped: cappedNow, otherId: otherNow } : prev);
                }
                if (!alive) return;
                const error = failed ? (failed === chunks.length ? 'The assignments could not be loaded.' : `Part of this range could not be loaded (${failed} of ${chunks.length} pieces), so the numbers below are incomplete.`) : '';
                setEmpData(prev => prev.key === empKey ? { ...prev, loading: false, error, at: Date.now() } : prev);
            } catch (err) {
                console.error('[Manager] Employee query failed', err);
                if (alive) setEmpData(prev => prev.key === empKey ? { ...prev, loading: false, error: `The assignments could not be loaded: ${err?.message || err}`, at: Date.now() } : prev);
            }
        })();
        return () => { alive = false; };
    }, [activeTab, apiReady, empKey]);

    const empProfile = useMemo(
        () => (empKey && empData.key === empKey && empData.total > 0) ? buildEmployeeProfile(empData.rows, currentTime) : null,
        [empData.rows, empData.key, empData.total, empKey, currentTime]);

    const pickEmployee = (r) => {
        const id = String(r.craa5__aa_employeeid || r.craa5_aa_employeeid || '').replace(/[{}]/g, '');
        const name = renderSafe(r.craa5_name).trim();
        if (!name) return;
        const info = readEmployeeShiftInfo(r);
        const blankShift = r.craa5_shift === null || r.craa5_shift === '' || r.craa5_Shift === null || r.craa5_Shift === '';
        const label = formatFullName(name) || name;
        setEmpPick({ id: id || name, guid: cleanGuid(id), name, label, crew: info.crew, left: info.blank && blankShift, role: EMP_ROLE_NAMES[r.craa5_role] || '' });
        setEmpText(label); setEmpOpen(false); setEmpActive(-1); setEmpListShown(25); setEmpListOpen(false);
    };
    const clearEmployee = () => {
        setEmpPick(null); setEmpText(''); setEmpOpen(false); setEmpActive(-1);
        setEmpData({ key: '', rows: [], loading: false, error: '', capped: 0, done: 0, total: 0, otherId: 0, at: 0 });
        if (empInputRef.current) empInputRef.current.focus();
    };

    const handleCreateTask = async () => {
        if (!taskPayload.title || !taskPayload.supervisorEmail) { notify("Provide a task title and supervisor.", "error"); return; }
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't save: no Dataverse write connection in this environment.", "error"); return; }
        setIsSubmittingTask(true);

        try {
            const logicalPayload = {
                craa5_task: taskPayload.title,
                craa5_taskdescription: taskPayload.description,
                craa5_assignedto: taskPayload.supervisorEmail,
                craa5_dateassigned: new Date().toISOString(),
                craa5_complete: false
            };
            if (taskPayload.expectationDate) logicalPayload.craa5_expectationfortimeframe = taskPayload.expectationDate;

            const newId = await writeApi.create(TABLE_TODO, logicalPayload);
            if (!newId) throw new Error("Dataverse didn't return a record id");

            setTodoTasks(prev => [{ craa5__supervisor_todoid: newId, createdon: new Date().toISOString(), ...logicalPayload }, ...prev]);
            notify("Task assigned.", "success");
            setIsTaskDialogOpen(false);
            setTaskPayload({ title: "", description: "", supervisorEmail: "", expectationDate: "" });
        } catch (err) {
            console.error("Task Delegation Error:", err); notify(`Failed to assign task: ${err?.message || err}`, "error");
        } finally { setIsSubmittingTask(false); }
    };

    // ------------------------------------------------------------------------
    // SCHEDULE INPUT: the runs the form would create, checked against what is already on that line.
    // Only the chosen area + line and the dates being scheduled are read from Dataverse (never the whole table).
    // ------------------------------------------------------------------------
    const setSch = (patch) => { setSchPayload(p => ({ ...p, ...patch })); setSchSubmitStatus(null); setLastSave(null); };
    const recentlyTouched = (id) => Date.now() - (touchedRef.current.get(id) || 0) < 120000;
    const lineNum = Math.max(1, parseInt(schPayload.line, 10) || 1);
    const plan = useMemo(() => buildOccurrences(schPayload),
        [schPayload.startDate, schPayload.startTime, schPayload.runLength, schPayload.repeat, schPayload.repeatDays, schPayload.everyWeeks, schPayload.until]);

    // The window to look at: the whole week of the start date (for the "already scheduled" strip) up to the last new run.
    const lookup = useMemo(() => {
        const first = parseYMD(schPayload.startDate);
        if (!schPayload.area || !first) return null;
        const weekStart = addDaysLocal(first, -first.getDay());
        let to = addDaysLocal(weekStart, 7);
        if (plan.items.length) { const lastEnd = plan.items[plan.items.length - 1].end; if (lastEnd.getTime() > to.getTime()) to = lastEnd; }
        return { from: weekStart.getTime(), to: to.getTime(), key: `${schPayload.area}|${lineNum}|${weekStart.getTime()}|${to.getTime()}` };
    }, [schPayload.area, lineNum, schPayload.startDate, plan]);
    const [schRuns, setSchRuns] = useState({ key: '', rows: [], ok: true, capped: false, loading: false });
    const readLineRuns = (lk, area, line) => queryRecords(TABLE_PROD, dataApiRef.current, {
        filter: `statecode eq 0 and craa5_area eq '${odataStr(area)}' and craa5_line eq ${line} and craa5_datestarttime lt ${isoZ(lk.to)} and craa5_dateendtime gt ${isoZ(lk.from)}`,
        orderby: 'craa5_datestarttime asc', top: RANGE_LIMIT });
    useEffect(() => {
        if (activeTab !== 'prod_form' || !apiReady || !lookup) return;
        let alive = true;
        const timer = setTimeout(async () => {
            setSchRuns(p => p.key === lookup.key ? p : { key: lookup.key, rows: [], ok: true, capped: false, loading: true });
            const rows = await readLineRuns(lookup, schPayload.area, lineNum);
            if (!alive) return;
            setSchRuns({ key: lookup.key, rows: rows || [], ok: rows !== null, capped: !!rows && rows.length >= RANGE_LIMIT, loading: false });
        }, 300);
        return () => { alive = false; clearTimeout(timer); };
    }, [activeTab, apiReady, lookup && lookup.key, reloadTick, formTick]);
    const checking = apiReady && !!lookup && (schRuns.key !== lookup.key || schRuns.loading);

    // Runs already on this area + line (see mergeLineRuns), and each planned run checked against them.
    const lookupFresh = !!lookup && schRuns.key === lookup.key && schRuns.ok && !schRuns.loading && !schRuns.capped;
    const lineRuns = useMemo(() => mergeLineRuns(schRuns.rows, prodSchedules, schPayload.area, lineNum, lookup, lookupFresh, recentlyTouched),
        [schRuns.rows, prodSchedules, schPayload.area, lineNum, lookupFresh, lookup && lookup.key]);
    const planRows = useMemo(() => markClashes(plan.items, lineRuns, schPayload.overrides), [plan, lineRuns, schPayload.overrides]);
    const toCreate = planRows.filter(r => r.on);
    const schProblem = !schPayload.area ? 'Choose an area.'
        : !schPayload.product.trim() ? 'Enter the product, or pick a recent one.'
        : schPayload.productCode !== '' && !/^\d{1,9}$/.test(String(schPayload.productCode)) ? 'Product code must be a whole number (digits only).'
        : plan.error ? plan.error
        : plan.tooMany ? `That is more than ${MAX_REPEAT_RUNS} runs in one go. Pick an earlier "until" date.`
        : null;
    const canSaveSch = !isSubmittingSch && !schProblem && !checking && toCreate.length > 0;

    // Newest products and lines used on the chosen area, as one-tap shortcuts (one small read per area).
    const [recent, setRecent] = useState({ key: '', items: [], lines: [] });
    const recentKeyRef = useRef('');
    useEffect(() => {
        if (activeTab !== 'prod_form' || !apiReady || !schPayload.area) return;
        const area = schPayload.area, key = `${area}|${reloadTick}`;
        if (recentKeyRef.current === key) return;
        recentKeyRef.current = key;
        (async () => {
            const rows = await queryRecords(TABLE_PROD, dataApiRef.current, { filter: `statecode eq 0 and craa5_area eq '${odataStr(area)}' and craa5_datestarttime le ${isoZ(Date.now())}`, orderby: 'craa5_datestarttime desc', top: 40 });
            if (recentKeyRef.current !== key) return;   // another area was chosen meanwhile
            if (rows === null) { recentKeyRef.current = ''; return; }   // failed: try again next time
            const seen = {}, items = [], lineSet = {};
            rows.forEach(r => {
                const name = renderSafe(r.craa5_product || r.craa5_Product);
                const code = r.craa5_productcode === undefined || r.craa5_productcode === null ? '' : String(r.craa5_productcode);
                lineSet[lineOf(r)] = true;
                if (!name || seen[`${code}|${name}`] || items.length >= 8) return;
                seen[`${code}|${name}`] = true;
                items.push({ ...applyRecall(r), code, name });
            });
            setRecent({ key, items, lines: Object.keys(lineSet).map(Number).sort((a, b) => a - b) });
        })();
    }, [activeTab, apiReady, schPayload.area, reloadTick]);

    const applyRecall = (match) => ({
        product: renderSafe(match.craa5_product || match.craa5_Product),
        allergen: match.craa5_allergen === true || match.craa5_allergen === 1,
        typeOfAllergen: renderSafe(match.craa5_typeofallergen) || "",
        crumbClean: match.craa5_crumbclean === true || match.craa5_crumbclean === 1 || match.craa5_CrumbClean === true,
    });
    // Auto-recall: reuse the product, allergen and crumb-clean settings from the newest run with this code. Asks
    // Dataverse for just that one row (debounced, so typing a code makes one request, not one per digit); falls back to
    // the runs on screen if the lookup fails. No history is loaded.
    const recallTimer = useRef(null);
    const handleProductCodeChange = (e) => {
        const code = e.target.value;
        setSchPayload(p => ({ ...p, productCode: code, flagsEdited: false }));
        clearTimeout(recallTimer.current);
        if (!/^\d+$/.test(code)) return;
        recallTimer.current = setTimeout(async () => {
            const rows = await queryRecords(TABLE_PROD, dataApiRef.current, { filter: `statecode eq 0 and craa5_productcode eq ${code}`, orderby: 'craa5_datestarttime desc', top: 1 });
            const match = rows?.[0] || (rows === null ? [...prodSchedulesRef.current].reverse().find(s => (s.craa5_productcode || s.craa5_productCode || "").toString() === code) : null);
            if (match) setSchPayload(p => {
                if (p.productCode !== code) return p;   // the box changed meanwhile
                const r = applyRecall(match), next = { ...p };
                if (!p.product.trim() || p.autoFilled) { next.product = r.product; next.autoFilled = true; }   // never replace a description typed by hand
                if (!p.flagsEdited) { next.allergen = r.allergen; next.typeOfAllergen = r.typeOfAllergen; next.crumbClean = r.crumbClean; }
                return next;
            });
        }, 350);
    };

    const handleCreateProductionSchedule = async () => {
        if (isSubmittingSch || savingRef.current) return;
        if (schProblem) { setSchSubmitStatus({ type: 'error', message: schProblem }); return; }
        if (!toCreate.length) { setSchSubmitStatus({ type: 'error', message: 'Nothing to schedule: every day is unticked or already has a run.' }); return; }
        setSchSubmitStatus(null);
        setLastSave(null);
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { 
            setSchSubmitStatus({ type: 'error', message: 'No Dataverse write connection in this environment (preview mode). Nothing was saved.' });
            return; 
        }
        savingRef.current = true;
        setIsSubmittingSch(true);
        setSaveProgress({ done: 0, total: toCreate.length });

        try {
            const p = schPayload;
            // Last look at the line just before writing: someone else may have scheduled it since the list was checked.
            if (apiReady && lookup) {
                const fresh = await readLineRuns(lookup, p.area, lineNum);
                if (fresh !== null) {
                    setSchRuns({ key: lookup.key, rows: fresh, ok: true, capped: fresh.length >= RANGE_LIMIT, loading: false });
                    const seen = {}; toCreate.forEach(r => { seen[r.date] = true; });
                    const now = markClashes(plan.items, mergeLineRuns(fresh, prodSchedulesRef.current, p.area, lineNum, lookup, fresh.length < RANGE_LIMIT, recentlyTouched), p.overrides);
                    const clashing = now.filter(r => seen[r.date] && !r.on);
                    if (clashing.length) {
                        setSchSubmitStatus({ type: 'error', message: `The schedule changed while you were working: ${clashing.length} day${clashing.length === 1 ? '' : 's'} now clash${clashing.length === 1 ? 'es' : ''} with another run. Nothing was saved. The list is updated: check it and save again.` });
                        return;
                    }
                }
            }
            const runs = toCreate.map(r => ({
                craa5_area: p.area,
                craa5_line: lineNum,
                craa5_productcode: p.productCode === '' ? null : Number(p.productCode),
                craa5_product: p.product.trim(),
                craa5_datestarttime: r.start.toISOString(),
                craa5_dateendtime: r.end.toISOString(),
                craa5_allergen: p.allergen,
                craa5_crumbclean: p.crumbClean,
                craa5_typeofallergen: p.allergen ? p.typeOfAllergen : ""
            }));
            // One at a time: each saved run shows on screen straight away, and a failure stops cleanly with a count
            // instead of leaving unseen rows behind a "failed" message.
            const saved = [], savedDates = [];
            let failure = null;
            for (let i = 0; i < runs.length; i++) {
                try {
                    const newId = await writeApi.create(TABLE_PROD, runs[i]);
                    if (!newId) throw new Error("Dataverse didn't return a record id");
                    const row = { craa5__aa_prd_schdid: newId, ...runs[i] };
                    saved.push(row); savedDates.push(toCreate[i].date);
                    touched(newId);
                    setProdSchedules(prev => [...prev, row].sort(byStartAsc));
                    setSaveProgress({ done: i + 1, total: runs.length });
                } catch (err) { failure = err; break; }
            }
            setFormTick(t => t + 1);   // re-read the line so the saved runs come from Dataverse itself
            // Days that are now saved must not be saved again by a retry, whatever was ticked for them.
            setSchPayload(prev => { const o = { ...prev.overrides }; savedDates.forEach(d => { delete o[d]; }); return { ...prev, overrides: o }; });
            if (failure) {
                console.error(failure);
                setSchSubmitStatus({ type: 'error', message: `Saved ${saved.length} of ${runs.length} runs, then failed: ${failure.message || failure}. The saved runs are on the schedule (they now show as clashes and will not be saved twice).` });
                if (saved.length) setLastSave({ ids: saved.map(r => r.craa5__aa_prd_schdid), confirm: false, busy: false });
                return;
            }
            const skipped = planRows.length - toCreate.length;
            const span = toCreate.length > 1 ? `${fmtDay(toCreate[0].start)} to ${fmtDay(toCreate[toCreate.length - 1].start)}` : fmtDay(toCreate[0].start);
            setSchSubmitStatus({ type: 'success', message: `Scheduled ${saved.length} run${saved.length === 1 ? '' : 's'} on ${p.area}, line ${lineNum}: ${span}.${skipped ? ` ${skipped} day${skipped === 1 ? ' was' : 's were'} skipped.` : ''}` });
            setLastSave({ ids: saved.map(r => r.craa5__aa_prd_schdid), confirm: false, busy: false });
            // Ready for the next product on the same area, line and dates.
            setSchPayload(prev => ({ ...prev, productCode: "", product: "", allergen: false, typeOfAllergen: "", crumbClean: false, overrides: {}, autoFilled: false, flagsEdited: false }));
        } catch (e) {
            console.error(e); 
            setSchSubmitStatus({ type: 'error', message: e.message || 'Failed to save to Dataverse.' });
        } finally { savingRef.current = false; setIsSubmittingSch(false); setSaveProgress(null); }
    };

    // Takes back the runs the latest save created (two taps: the first asks "are you sure").
    const handleUndoLastSave = async () => {
        if (!lastSave || lastSave.busy) return;
        if (!lastSave.confirm) { setLastSave({ ...lastSave, confirm: true }); return; }
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't undo: no Dataverse write connection in this environment.", "error"); return; }
        const batch = lastSave;
        setLastSave({ ...batch, busy: true });
        const gone = {}; let failure = null;
        for (let i = 0; i < batch.ids.length; i++) {
            try { await writeApi.remove(TABLE_PROD, batch.ids[i]); touched(batch.ids[i]); gone[batch.ids[i]] = true; }
            catch (err) { failure = err; break; }
        }
        const removed = Object.keys(gone).length;
        setProdSchedules(prev => prev.filter(r => !gone[runIdOf(r)]));
        setSchRuns(p => ({ ...p, rows: p.rows.filter(r => !gone[runIdOf(r)]) }));
        setFormTick(t => t + 1);
        if (failure) {
            console.error(failure);
            setLastSave({ ids: batch.ids.filter(id => !gone[id]), confirm: false, busy: false });
            setSchSubmitStatus({ type: 'error', message: `Removed ${removed} of ${batch.ids.length} runs, then failed: ${failure.message || failure}. The rest are still scheduled.` });
        } else {
            setLastSave(null);
            setSchSubmitStatus({ type: 'success', message: `Removed the ${removed} run${removed === 1 ? '' : 's'} from the last save.` });
        }
    };

    // The run being adjusted, checked: { problem, s, e, lineN, clash } (s / e are the new start and end).
    const checkEditedRun = (d) => {
        const sDay = parseYMD(d.startDate), eDay = parseYMD(d.endDate);
        const s = sDay && withTime(sDay, d.startTime), e = eDay && withTime(eDay, d.endTime);
        const code = String(d.productCode === undefined || d.productCode === null ? '' : d.productCode).trim();
        const lineN = Math.max(1, parseInt(d.line, 10) || 1);
        let problem = null;
        if (!s || !e) problem = 'Choose the start and end date and time.';
        else if (e.getTime() <= s.getTime()) problem = 'The end has to be after the start.';
        else if (!String(d.area || '').trim()) problem = 'Choose an area.';
        else if (!String(d.product || '').trim()) problem = 'Enter the product.';
        else if (code !== '' && !/^\d{1,9}$/.test(code)) problem = 'Product code must be a whole number (digits only).';
        const clash = problem ? null : (prodSchedules.find(r => runIdOf(r) !== d.id && renderSafe(r.craa5_area || r.craa5_Area) === d.area && lineOf(r) === lineN && startMs(r) < e.getTime() && endMs(r) > s.getTime()) || null);
        return { problem, s, e, lineN, code, clash };
    };

    const handleUpdateSchedule = async () => {
        if (!editSchData || editSaving) return;
        const chk = checkEditedRun(editSchData);
        if (chk.problem) { notify(chk.problem, "error"); return; }
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't save: no Dataverse write connection in this environment. Nothing was changed.", "error"); return; }
        setEditSaving(true);
        try {
            const sTime = chk.s.toISOString();
            const eTime = chk.e.toISOString();
            const id = editSchData.id;
            const d = editSchData;
            const logicalPayload = {
                craa5_area: d.area,
                craa5_line: chk.lineN,
                craa5_productcode: chk.code === '' ? null : Number(chk.code),
                craa5_product: d.product.trim(),
                craa5_datestarttime: sTime,
                craa5_dateendtime: eTime,
                craa5_allergen: !!d.allergen,
                craa5_crumbclean: !!d.crumbClean,
                craa5_typeofallergen: d.allergen ? (d.typeOfAllergen || "") : ""
            };

            await writeApi.update(TABLE_PROD, id, logicalPayload);
            touched(id);
            setSchRuns(p => ({ ...p, rows: p.rows.map(r => runIdOf(r) === id ? { ...r, ...logicalPayload } : r) }));

            setProdSchedules(prev => prev.map(s => {
                const sId = s.craa5__aa_prd_schdid || s.craa5_aa_prd_schdid;
                if (sId === id) {
                    return {
                        ...s, ...logicalPayload,
                        craa5_Area: logicalPayload.craa5_area,
                        craa5_Datestarttime: sTime, craa5_starttime: sTime,
                        craa5_Dateendtime: eTime, craa5_endtime: eTime,
                        craa5_Product: logicalPayload.craa5_product
                    };
                }
                return s;
            }).sort(byStartAsc));
            setEditSchOpen(false);
            setIsConfirmingDelete(false);
            setFormTick(t => t + 1);
        } catch(e) { console.error(e); notify("Failed to update schedule: " + (e?.message || e), "error"); }
        finally { setEditSaving(false); }
    };

    const handleDragDropSchedule = async (schId, targetDateObj) => {
        const sch = prodSchedules.find(s => (s.craa5__aa_prd_schdid || s.craa5_aa_prd_schdid) === schId);
        if (!sch) return;
        const oldStart = new Date(sch.craa5_datestarttime || sch.craa5_Datestarttime || sch.craa5_starttime);
        const oldEnd = new Date(sch.craa5_dateendtime || sch.craa5_Dateendtime || sch.craa5_endtime);
        const oldStartMidnight = new Date(oldStart.getFullYear(), oldStart.getMonth(), oldStart.getDate());
        const targetMidnight = new Date(targetDateObj.getFullYear(), targetDateObj.getMonth(), targetDateObj.getDate());
        const diffTimeMs = targetMidnight.getTime() - oldStartMidnight.getTime();
        const newStart = new Date(oldStart.getTime() + diffTimeMs);
        const newEnd = new Date(oldEnd.getTime() + diffTimeMs);
        const sTime = newStart.toISOString();
        const eTime = newEnd.toISOString();
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't move: no Dataverse write connection in this environment. Nothing was changed.", "error"); return; }
        try {
            await writeApi.update(TABLE_PROD, schId, { craa5_datestarttime: sTime, craa5_dateendtime: eTime });
            touched(schId);
            setProdSchedules(prev => prev.map(s => {
                const sId = s.craa5__aa_prd_schdid || s.craa5_aa_prd_schdid;
                if (sId === schId) {
                    return { 
                        ...s, craa5_datestarttime: sTime, craa5_Datestarttime: sTime, craa5_starttime: sTime,
                        craa5_dateendtime: eTime, craa5_Dateendtime: eTime, craa5_endtime: eTime
                    };
                }
                return s;
            }));
        } catch(e) { console.error("Drag Drop Update Error", e); notify("Failed to move schedule: " + (e?.message || e), "error"); }
    };

    const handleDeleteSchedule = async () => {
        if (!editSchData) return;
        const writeApi = getWriteApi(dataApiRef.current);
        if (!writeApi) { notify("Can't delete: no Dataverse write connection in this environment. Nothing was changed.", "error"); return; }
