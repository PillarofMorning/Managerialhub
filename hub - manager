                                        title="Open this shift's 24h Personnel Gantt"
                                    >
                                        <strong className="text-[#00468B] block truncate">{sup}</strong>
                                        <span className="text-slate-600 truncate block leading-tight">{Array.from(data.areas).join(', ')}</span>
