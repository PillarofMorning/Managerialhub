// ==== MH FEATURE KUDOS (v6.5) ====
// The High fives tab (id 'kudos', allowed users only): high fives and coaching from craa5__aa_employee.craa5_remarks (written by Ganttly).
// props: { dataApi, access (see useMhAccess), notify(message, type), reloadTick (goes up on Reload data) }.
// Ganttly keeps, on each employee row, a JSON list (newest first, at most 50) of { id, datetime (ISO), dateFormatted, type: 'highfive' or
// 'incident', givenBy, tag, text, severity: 'positive' | 'coaching' | 'documented' | 'critical', supervisor, area, employeeName }, and the
// last entry's label in craa5_remarkcategory. This tab only reads them. The parse is loose: a row that cannot be read is counted, not hidden.
const MH_KUDOS_COLUMNS = ['craa5_name', 'craa5_remarks', 'craa5_remarkcategory'];   // plus the table's id column; never the whole row (it holds the PIN)
const MH_KUDOS_FILTER = 'statecode eq 0 and craa5_remarks ne null';
const MH_KUDOS_WIDE_FILTER = 'statecode eq 0';      // only when a host refuses "ne null" on a long text column: the empty rows are skipped here
const MH_KUDOS_TOP = 5000;          // employee rows read at most (swQuery pages past 5000 through nextLink)
const MH_KUDOS_KEEP = 50;           // Ganttly keeps only each person's newest 50 entries
const MH_KUDOS_FRESH_MS = 5 * 60000;   // a read is reused this long when the tab is opened again (Reload data and Read again read at once)
const MH_KUDOS_PAGE = 100;          // entries shown at first, and per Show more
const MH_KUDOS_TOP_N = 5;           // people and givers in the summary
const MH_KUDOS_SEVERITIES = [       // Ganttly's own labels
    { id: 'positive', label: 'Positive', tone: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
    { id: 'coaching', label: 'Verbal Coaching', tone: 'bg-[#FFF6E0] text-[#7A4B00] border-[#FFB81C]' },
    { id: 'documented', label: 'Documented Concern', tone: 'bg-orange-50 text-orange-900 border-orange-300' },
    { id: 'critical', label: 'Safety / Policy Violation', tone: 'bg-[#FDE8EC] text-[#B80022] border-[#E4002B]/40' }
];
const MH_KUDOS_OTHER_TONE = 'bg-slate-50 text-slate-700 border-slate-200';
const MH_KUDOS_TAGS = {             // Ganttly's tag ids: a high five names the strength, an incident the same id read the other way
    highfive: { 'leadership': 'Leadership', 'detail oriented': 'Detail Oriented', 'hustle': 'Hustle', 'friendly': 'Friendly', 'respectful': 'Respectful', 'self-starter': 'Self-Starter' },
    incident: { 'leadership': 'Leadership Lapse / Guidance Needed', 'detail oriented': 'Detail / Quality / Missed Standard', 'hustle': 'Pace / Urgency / Sluggishness', 'friendly': 'Interpersonal Conflict / Attitude', 'respectful': 'Disrespect / Policy Violation', 'self-starter': 'Lack of Initiative / Constant Direction' }
};
const MH_KUDOS_RANGES = [{ k: 'today', label: 'Today' }, { k: 'week', label: 'This week' }, { k: '7', label: 'Last 7 days' }, { k: '30', label: 'Last 30 days' }, { k: 'all', label: 'All' }];
const MH_KUDOS_TYPES = [{ k: 'both', label: 'Both' }, { k: 'highfive', label: 'High fives' }, { k: 'incident', label: 'Coaching and incidents' }];
const MH_KUDOS_DEFAULT_VIEW = { range: '7', type: 'both', severity: '', person: '', givenBy: '', area: '' };
const MH_KUDOS_EARLIEST = Date.UTC(2000, 0, 1);   // a date before this is a broken value, not a real entry

// ---- reading and parsing (plain functions, unit-tested) ----
function mhKudosOneLine(v) { return v === undefined || v === null || typeof v === 'object' ? '' : String(v).replace(/\s+/g, ' ').trim(); }
function mhKudosLongText(v) { return v === undefined || v === null || typeof v === 'object' ? '' : String(v).replace(/\r\n?/g, '\n').trim(); }
function mhKudosKey(v) { return normText(String(v === undefined || v === null ? '' : v).replace(/,/g, ' ')); }
function mhKudosSeverityOf(id) { for (var i = 0; i < MH_KUDOS_SEVERITIES.length; i++) if (MH_KUDOS_SEVERITIES[i].id === id) return MH_KUDOS_SEVERITIES[i]; return null; }
// 'highfive', 'incident' or 'other' (a type this page does not know, with no severity to tell by).
function mhKudosKind(item) {
    var t = normText(item.type).replace(/[\s_-]+/g, '');
    if (t === 'highfive' || t === 'kudos') return 'highfive';
    if (t === 'incident' || t === 'coaching' || t === 'concern') return 'incident';
    var s = normText(item.severity);
    if (s === 'positive') return 'highfive';
    return s ? 'incident' : 'other';
}
// The severity id. With none saved, Ganttly's own default: positive for a high five, coaching for an incident.
function mhKudosSeverity(item, kind) {
    var s = normText(item.severity);
    if (!s) return kind === 'highfive' ? 'positive' : kind === 'incident' ? 'coaching' : 'other';
    for (var i = 0; i < MH_KUDOS_SEVERITIES.length; i++) {
        var sv = MH_KUDOS_SEVERITIES[i];
        if (s === sv.id || s === normText(sv.label) || (sv.id === 'documented' && s === 'documented concern')) return sv.id;
    }
    return 'other';
}
// When it was saved, in ms (0 when no date can be read). datetime is Ganttly's; the others are older or hand-made shapes.
function mhKudosWhen(item) {
    var c = [item.datetime, item.timestamp, item.at, item.date, item.dateFormatted];
    for (var i = 0; i < c.length; i++) {
        var v = c[i], t = typeof v === 'number' ? v : (typeof v === 'string' && v.trim() ? Date.parse(v.trim()) : NaN);
        if (!isNaN(t) && t >= MH_KUDOS_EARLIEST) return t;
    }
    return 0;
}
// The saved value as a list of items, or { why } (a few words) when it cannot be read. A list saved twice as text is unwrapped once more.
function mhKudosList(raw) {
    var v = raw;
    for (var pass = 0; pass < 2 && typeof v === 'string'; pass++) {
        var s = v.trim();
        if (!s) return { items: [] };
        try { v = JSON.parse(s); } catch (e) { return { why: 'not readable, maybe cut short or typed by hand' }; }
    }
    if (Array.isArray(v)) return { items: v };
    if (v && typeof v === 'object') {
        if (Array.isArray(v.logs)) return { items: v.logs };         // Ganttly's in-browser record shape
        if (Array.isArray(v.entries)) return { items: v.entries };
        if (v.type || v.text || v.datetime) return { items: [v] };   // one entry saved on its own
    }
    return { why: 'not a list of entries' };
}
// One list item as an entry, or null when nothing in it can be shown.
function mhKudosEntry(item, person, n) {
    var kind = mhKudosKind(item), severity = mhKudosSeverity(item, kind);
    var text = mhKudosLongText(item.text) || mhKudosLongText(item.note) || mhKudosLongText(item.description);
    var tag = mhKudosOneLine(item.tag) || mhKudosOneLine(item.reverseTag);
    var at = mhKudosWhen(item);
    if (!text && !tag && !at && kind === 'other') return null;
    var given = mhKudosOneLine(item.givenBy) || mhKudosOneLine(item.supervisor);
    var givenLabel = formatFullName(given);
    var area = mhKudosOneLine(item.area), alsoName = mhKudosOneLine(item.employeeName);
    var tags = MH_KUDOS_TAGS[kind] || MH_KUDOS_TAGS.highfive;
    var label = person.label || formatFullName(alsoName);
    var d = at ? new Date(at) : null;
    var id = mhKudosOneLine(item.id);
    return {
        key: (person.id || mhKudosKey(person.name)) + '|' + (id || ('n' + n)),
        id: id, dupKey: id || (at + '_' + kind + '_' + normText(tag) + '_' + normText(text).slice(0, 60)),
        personId: person.id, person: person.name || alsoName, personLabel: label, personKey: person.id || mhKudosKey(label),
        kind: kind, severity: severity, tag: tag, tagLabel: tag ? (tags[normText(tag)] || tag) : '',
        text: text, givenBy: given, givenLabel: givenLabel, givenKey: mhKudosKey(givenLabel),
        area: area, areaKey: mhKudosKey(area), at: at, day: d ? getLocalYMD(d) : '',
        search: mhKudosKey([person.name, label, alsoName].join(' '))
    };
}
// Employee rows -> { entries (newest first, undated last), rows, people, unreadable: [{ id, name, why, category }], skipped, full }.
// skipped = list items with nothing to show; full = people at Ganttly's 50-entry limit (their oldest entries are gone).
function mhKudosParseRows(rows, idCol) {
    var out = { entries: [], rows: 0, people: 0, unreadable: [], skipped: 0, full: 0 };
    (rows || []).forEach(function (row) {
        if (!row || typeof row !== 'object') return;
        out.rows++;
        var raw = row.craa5_remarks !== undefined ? row.craa5_remarks : row.craa5_Remarks;
        if (raw === undefined || raw === null || (typeof raw === 'string' && !raw.trim())) return;
        var name = mhKudosOneLine(row.craa5_name);
        var person = { id: cleanGuid(row[idCol || 'craa5__aa_employeeid'] || row.craa5__aa_employeeid || row.craa5_aa_employeeid), name: name, label: formatFullName(name) };
        var category = mhKudosOneLine(row.craa5_remarkcategory);
        var list = mhKudosList(raw);
        if (list.why) { out.unreadable.push({ id: person.id, name: person.label || 'A row with no name', why: list.why, category: category }); return; }
        var seen = {}, mine = 0, bad = 0;
        list.items.forEach(function (item, n) {
            var e = item && typeof item === 'object' && !Array.isArray(item) ? mhKudosEntry(item, person, n) : null;
            if (!e) { bad++; return; }
            if (seen[e.dupKey]) return;   // the same entry twice (Ganttly merges this way too)
            seen[e.dupKey] = true; mine++;
            out.entries.push(e);
        });
        if (!mine && bad) out.unreadable.push({ id: person.id, name: person.label || 'A row with no name', why: 'no entry in it could be read', category: category });
        else out.skipped += bad;
        if (mine) out.people++;
        if (list.items.length >= MH_KUDOS_KEEP) out.full++;
    });
    out.entries.sort(function (a, b) {
        if (a.at !== b.at) return !a.at ? 1 : !b.at ? -1 : b.at - a.at;
        return a.personLabel < b.personLabel ? -1 : a.personLabel > b.personLabel ? 1 : 0;
    });
    return out;
}
// Reads every active employee row with entries: explicit columns, never a read without $select (the row holds the PIN).
// -> Promise of { rows, table, idCol, capped, noCategory, wide } or { rows: null, kind: swClassify kind or 'noapi', err, table }.
function mhKudosRead(dataApi, top) {
    var n = top || MH_KUDOS_TOP;
    if (!swWebApi() && !(dataApi && dataApi.queryTable)) return Promise.resolve({ rows: null, kind: 'noapi', err: 'No data API on this page.' });
    var firstMissing = null;
    var fromTable = function (i) {
        if (i >= MH_ACCESS_TABLES.length) return Promise.resolve(firstMissing);
        var table = MH_ACCESS_TABLES[i], idCol = table + 'id';
        var attempt = function (cols, filter, notes) {
            return swQuery(dataApi, table, { select: [idCol].concat(cols), filter: filter, orderBy: 'modifiedon desc', top: n }).then(function (res) {
                if (res && res.rows) return { rows: res.rows, table: table, idCol: idCol, capped: res.rows.length >= n, noCategory: !!notes.noCategory, wide: !!notes.wide };
                var err = res && res.err ? res.err : 'No answer from Dataverse.', kind = swClassify(err);
                // The label column is optional: without it the entries still read.
                if (kind === 'column' && cols.indexOf('craa5_remarkcategory') >= 0 && swNamedColumns(err, ['craa5_remarkcategory']).length) {
                    return attempt(cols.filter(function (c) { return c !== 'craa5_remarkcategory'; }), filter, Object.assign({}, notes, { noCategory: true }));
                }
                if (kind === 'other' && !notes.wide) return attempt(cols, MH_KUDOS_WIDE_FILTER, Object.assign({}, notes, { wide: true, firstErr: err }));
                return { rows: null, kind: kind, err: notes.firstErr && kind === 'other' ? notes.firstErr : err, table: table };
            });
        };
        return attempt(MH_KUDOS_COLUMNS, MH_KUDOS_FILTER, {}).then(function (r) {
            if (r.rows || r.kind !== 'table') return r;
            if (!firstMissing) firstMissing = r;
            return fromTable(i + 1);
        });
    };
    return fromTable(0).catch(function (e) { return { rows: null, kind: swClassify(e), err: swErrText(e) }; });
}

// ---- dates, filters and the summary ----
function mhKudosDayStart(ms, addDays) { var d = new Date(ms); return new Date(d.getFullYear(), d.getMonth(), d.getDate() + (addDays || 0)).getTime(); }
function mhKudosWeekStart(ms) { var d = new Date(ms); return new Date(d.getFullYear(), d.getMonth(), d.getDate() - d.getDay()).getTime(); }   // Sunday, like the hub's weeks
// The first ms a range includes, or null for All (which also keeps the entries with no date).
function mhKudosRangeFrom(k, nowMs) {
    if (k === 'today') return mhKudosDayStart(nowMs);
