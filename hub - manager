        return () => { alive = false; clearTimeout(timer); };
    }, [activeTab, apiReady, empKey]);

    const empProfile = useMemo(
        () => (empKey && empData.key === empKey && empData.total > 0) ? buildEmployeeProfile(empData.rows, currentTime, { first: empWin.first, last: empWin.last, selfNames: empPick ? empNameVariants(empPick.name) : [] }) : null,
        [empData.rows, empData.key, empData.total, empKey, currentTime, empWin.first, empWin.last, empPick && empPick.name]);

    // ------------------------------------------------------------------------
    // ROOM / AREA QUERY: area name suggestions, then ONE area's assignment rows for the chosen days (in pieces of 14 days, at most 3 at
    // once), then the employee list is asked about the people found (a few names per request) to tell who has left. Nothing is read
    // until an area is typed, and only that area's rows are asked for.
    // ------------------------------------------------------------------------
    const areaQuery = areaText.trim();
    const areaSearchable = areaQuery.length >= 2 && empWords(areaQuery).length > 0;
    const areaWin = useMemo(() => empWindowOf(areaRange, todayYmd), [areaRange.k, areaRange.from, areaRange.to, todayYmd]);
    const areaSuggestKey = areaWin.key ? `${areaQuery}|${areaWin.key}|${reloadTick}` : '';
    const areaKey = areaPick && areaWin.key ? `${areaPick.mode}|${normText(areaPick.text)}|${areaWin.key}|${reloadTick}` : '';
    areaDataRef.current = areaData;
    areaStatusRef.current = areaStatus;

    useEffect(() => {
        if (activeTab !== 'employee' || empMode !== 'area' || !apiReady) return;
