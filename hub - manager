                    {subject.state !== 'ready' ? <MhNotesStateBox state={subject.state === 'idle' ? 'looking' : subject.state} why={subject.why} onRetry={subject.retry} /> : null}
                    {subject.state === 'ready' && !ok ? <MhNotesStateBox state={notes.state === 'idle' ? 'loading' : notes.state} err={notes.err} cols={notes.cols} onRetry={reload} /> : null}
                    {subject.state === 'ready' && ok ? (
