async function mhTlImport(dataApi, records, onProgress) {
    var out = { saved: 0, already: 0, failed: 0, errors: [], entries: [], state: 'ok', byId: {} };   // byId: each record's id -> 'saved', 'already' or 'failed'
    var list = Array.isArray(records) ? records : [];
    for (var i = 0; i < list.length; i++) {
