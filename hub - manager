    kept.sort((a, b) => (taskTimeMs(a) - taskTimeMs(b)) || ((isTaskDone(b) ? 1 : 0) - (isTaskDone(a) ? 1 : 0)));   // oldest first; on a tie the finished row first so the open one wins
