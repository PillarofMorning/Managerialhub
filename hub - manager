//  - an assignment lasts from its start until its end time, the next row for that person, or 16 hours, whichever is first;
//  - a "time assigned" is one shift in one area (two rows for the same area on the same shift count once);
//  - days and hours worked leave out the days and rows where the person was PTO / Sick / NCNS (late and left early are counted separately);
//  - the strongest area is where they spent the most time, as long as that is at least 3 shifts.
function buildEmployeeProfile(rows, nowMs) {
    const notes = { rows: rows.length, hubRows: 0, noEnd: 0, capped: 0, open: 0 };
    const items = [];
    rows.forEach(r => {
        const guid = cleanGuid(r.craa5__aaemp_guid);
        const equip = String(r.craa5_equip || r.craa5_equipment || '').trim();
        if (equip && !guid) { notes.hubRows++; return; }
        const savedAt = msOf(r.craa5_datetimeofassignment) || msOf(r.createdon);
        const start = msOf(r.craa5_starttime) || savedAt;
        if (!start) return;
        const end = msOf(r.craa5_endtime);
        const areaRaw = String(r.craa5_area || '').trim();
        const key = normText(areaRaw);
        items.push({
            id: r.craa5_taskassignmentid || '', start, end: end > start ? end : 0, savedAt: savedAt || start,
            active: r.statecode === 0 || r.statecode === '0',
            area: areaRaw || '(no area)', absence: OUT_AREA_NAMES.indexOf(key) > -1 ? key : '',
            lead: String(r.craa5_lead || '').trim(), sup: String(r.craa5_team || '').trim()
        });
    });
    items.sort((a, b) => a.start - b.start || a.savedAt - b.savedAt);
    items.forEach((it, i) => {
        const next = items[i + 1];
        let stop = it.end;
        if (!stop) {
            if (it.active && nowMs - it.start <= EMP_MAX_ROW_MS) { stop = Math.max(it.start, nowMs); notes.open++; it.open = true; }
            else if (next && next.start - it.start <= EMP_MAX_ROW_MS) stop = next.start;   // closed without an end time: it ends where the next row starts
            else { stop = it.start; notes.noEnd++; it.noEnd = true; }                        // nothing to say when it ended: no hours
        }
        if (stop - it.start > EMP_MAX_ROW_MS) { stop = it.start + EMP_MAX_ROW_MS; notes.capped++; }
