        const area = String(renderSafe(x.r.craa5_area) || '').trim();
        if (!area || !String(renderSafe(x.r.craa5_lead) || '').trim()) return;   // Shift Start always saves a room with its lead
        const card = cardFor(x.r); addTeam(card, x.r); card.emptyAreas.push(area);
