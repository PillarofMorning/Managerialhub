        const t = bump(teams, held ? 'sup:' + supKey : own ? 'own:' + supKey : 'lead:' + leadKey, { lead: held || own ? '' : it.lead, held, own, sups: {}, days: {}, ms: 0, rows: 0, last: 0 });
        if (!held && !own) t.lead = it.lead;
        t.days[it.day] = true; t.ms += it.ms; t.rows++; t.last = Math.max(t.last, it.start);
        if (supKey) { const s = bump(t.sups, supKey, { name: it.sup, n: 0 }); s.n++; }
