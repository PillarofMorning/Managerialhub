    const renderTasksTab = () => (
        <div className="animate-in fade-in duration-300 flex flex-col h-[calc(100vh-140px)]">
            <div className="flex justify-between items-center mb-6">
                <div>
                    <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Supervisor Task Delegation</h2>
                    <p className="text-sm text-slate-500">Assign tasks directly to supervisors for execution.</p>
                </div>
                <button 
                    onClick={() => setIsTaskDialogOpen(true)}
                    className="bg-[#0072CE] hover:bg-[#00468B] text-white px-4 py-2 rounded-md text-sm font-medium transition shadow-sm flex items-center gap-2"
                >
                    <span>+</span> Delegate New Task
                </button>
            </div>
            <div className="bg-white rounded-xl shadow-sm border border-slate-200 flex-1 overflow-hidden flex flex-col">
                {todoTasks?.length === 0 ? (
                    <div className="flex-1 flex items-center justify-center text-slate-500 italic">No delegations have been recorded yet.</div>
                ) : (
                    <div className="overflow-auto flex-1">
                        <table className="min-w-full divide-y divide-slate-200">
                            <thead className="bg-slate-50 sticky top-0">
                                <tr>
                                    <th className="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Task</th>
                                    <th className="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Assigned Supervisor</th>
                                    <th className="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Due Date</th>
                                    <th className="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                                </tr>
                            </thead>
                            <tbody className="bg-white divide-y divide-slate-200">
                                {todoTasks.map(item => {
                                    const isDone = item.craa5_complete === true || item.craa5_complete === 1 || String(item.craa5_complete).toLowerCase() === "true";
                                    const dateStr = renderSafe(item["craa5_expectationfortimeframe@OData.Community.Display.V1.FormattedValue"] || item.craa5_expectationfortimeframe || item.craa5_Expectationfortimeframe);
                                    return (
                                        <tr key={item.craa5__supervisor_todoid || item.craa5_supervisor_todoid || Math.random()} className="hover:bg-slate-50">
