    }, onWait);
    if (!res.ok) {
        var text = swErrText(res.err), st = mhTlWriteState(text);
        if (st === 'gone' || res.kind === 'unsure') st = 'error';
        return { ok: false, state: st, entry: null, err: text, cols: swNamedColumns(text, [MH_TL_ID].concat(MH_TL_NEEDED, MH_TL_OPTIONAL)), dropped: dropped, recovered: false, tries: res.tries };
    }
    var back = await mhTlReadBack(dataApi, gotId);
    if (!back.found) return { ok: false, state: 'unconfirmed', entry: null, err: back.err || 'It was not found when it was read back.', cols: [], dropped: dropped, recovered: recovered, tries: res.tries };
    return { ok: true, state: 'saved', entry: back.entry, err: '', cols: [], dropped: dropped, recovered: recovered, tries: res.tries, markers: back.markers };
}
// Updates the text columns of one row (Edit, Close) and reads it back. An optional column the table does not have is left out of the
// patch. Resolves { ok, state: one of 'saved', 'gone', 'unconfirmed', 'noapi', 'missing', 'denied', 'column' and 'error'; entry, err, dropped }.
async function mhTlUpdate(dataApi, id, patch, onWait) {
    var g = cleanGuid(id);
    if (!MH_TL_GUID_RE.test(g)) return { ok: false, state: 'error', entry: null, err: 'No entry to change.', dropped: [] };
    if (!patch || !Object.keys(patch).length) return { ok: false, state: 'error', entry: null, err: 'Nothing to change.', dropped: [] };
    var api0 = getWriteApi(dataApi);
    if (!api0) return { ok: false, state: 'noapi', entry: null, err: 'There is no Dataverse write connection on this page.', dropped: [] };
    var api = lpGuardApi(api0), body = Object.assign({}, patch), dropped = [];
    var res = await lpTryWrite(async function () {
        await mhTnEnsure(dataApi, 'loss');
        for (var k = 0; k <= MH_TL_OPTIONAL.length; k++) {
            try { await api.update(MH_TL_TABLE, g, body); return true; }
            catch (e) {
                var named = swClassify(e) === 'column' ? swNamedColumns(e, MH_TL_OPTIONAL).filter(function (c) { return body[c] !== undefined; }) : [];
                if (!named.length) throw e;
                named.forEach(function (c) { delete body[c]; dropped.push(c); });
                if (!Object.keys(body).length) throw e;
            }
        }
        throw new Error('The save kept failing.');
    }, onWait);
    if (!res.ok) {
        var text = swErrText(res.err), st = mhTlWriteState(text);
        if (st === 'gone') return { ok: false, state: 'gone', entry: null, err: 'This entry is not in the table any more.', dropped: dropped };
        return { ok: false, state: res.kind === 'unsure' ? 'error' : st, entry: null, err: text, dropped: dropped };
    }
    var back = await mhTlReadBack(dataApi, g);
    if (!back.found) return { ok: true, state: 'unconfirmed', entry: null, err: back.err || 'It could not be read back.', dropped: dropped };
    return { ok: true, state: 'saved', entry: back.entry, err: '', dropped: dropped };
}
