                            <option value="">All areas</option>
                            {w.areaNames.map(a => <option key={a} value={a}>{a}</option>)}
                        </select>
                    </div>
                    <div className="flex gap-1.5" role="group" aria-label="Color the bars">
                        <Chip on={weekColorBy === 'product'} onClick={() => setWeekColorBy('product')}>By product</Chip>
                        <Chip on={weekColorBy === 'type'} onClick={() => setWeekColorBy('type')}>By type</Chip>
                    </div>
                    <label className="flex items-center gap-2 text-xs font-bold text-slate-600 cursor-pointer">
                        <input type="checkbox" checked={weekHideIdle} onChange={e => setWeekHideIdle(e.target.checked)} className="accent-[#0072CE] w-4 h-4" /> Hide lines with no run
                    </label>
                </div>

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-3 flex flex-col gap-2.5">
                    <div className="flex flex-wrap items-center gap-1.5">
                        <span className={`${labelCls} mr-1`}>{weekColorBy === 'product' ? 'Products (click one to find it)' : 'Run types'}</span>
                        {weekColorBy === 'product' ? (
                            w.products.length === 0 ? <span className="text-xs text-slate-500 italic">No products in this period.</span> :
                            w.products.map(p => (
                                <button key={p.key} type="button" aria-pressed={focusKey === p.key} onClick={() => setWeekFocus(f => f === p.key ? '' : p.key)}
                                    className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-bold transition-colors ${focusKey === p.key ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50'}`}>
                                    <span aria-hidden="true" className="w-3 h-3 rounded-sm flex-shrink-0" style={{ background: p.color }} />{p.name}
                                </button>
                            ))
                        ) : (
                            [['Regular run', BRAND.blue], ['Allergen run', BRAND.yellow]].map(x => (
                                <span key={x[0]} className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-slate-300 bg-white text-xs font-bold text-slate-700"><span aria-hidden="true" className="w-3 h-3 rounded-sm" style={{ background: x[1] }} />{x[0]}</span>
                            ))
                        )}
                        <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-slate-300 bg-white text-xs font-bold text-slate-700"><span aria-hidden="true" className="w-3 h-3 rounded-sm" style={{ background: MAINTENANCE_COLOR }} />Maintenance</span>
                        {focusKey && <button type="button" onClick={() => setWeekFocus('')} className="text-xs font-extrabold text-[#0072CE] underline ml-1">Show all</button>}
                    </div>
                    <div className="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11px] font-bold text-slate-500">
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-5 h-3 rounded-sm border border-[#B3D4F2] bg-[#E6F1FB]" style={{ backgroundImage: hatch('0,114,206', 0.12) }} />Sanitation</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-5 h-3 rounded-sm border border-[#FFB81C] bg-[#FFF6E0]" style={{ backgroundImage: hatch('255,184,28', 0.4) }} />Allergen clean</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-5 h-3 rounded-sm border border-[#E4002B] bg-[#FDE8EC]" style={{ backgroundImage: hatch('228,0,43', 0.15) }} />Allergen clean {ALLERGEN_SHORT_GAP_H}h or less</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-5 h-3 rounded-sm border border-dashed border-slate-300" />No run scheduled (over {IDLE_GAP_H}h)</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="text-[9px] font-black leading-none px-1 py-0.5 rounded bg-[#FFB81C] text-slate-900">A</span>Allergen run</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="text-[9px] font-black leading-none px-1 py-0.5 rounded bg-slate-700 text-white">CC</span>Crumb clean</span>
                        <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-3 h-3 rounded-sm" style={{ background: 'rgba(0,70,139,0.08)' }} />Night (6 PM to 6 AM)</span>
                        {showNow && <span className="inline-flex items-center gap-1.5"><span aria-hidden="true" className="w-0.5 h-3 bg-[#E4002B]" />Red line = now</span>}
                    </div>
                </div>

                {!loadingRuns && (w.noRun.length > 0 || w.shortClean > 0 || w.doubleBooked > 0) && (
                    <div className="flex flex-col gap-2" role="status">
                        {w.noRun.length > 0 && <div className="px-4 py-2.5 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm"><b>No run in this period:</b> {names(w.noRun)}.</div>}
                        {w.shortClean > 0 && <div className="px-4 py-2.5 rounded-xl border border-[#E4002B]/40 bg-[#FDE8EC] text-[#B80022] text-sm font-bold">{pluralize(w.shortClean, 'allergen clean')} of {ALLERGEN_SHORT_GAP_H} hours or less.</div>}
                        {w.doubleBooked > 0 && <div className="px-4 py-2.5 rounded-xl border border-[#E4002B]/40 bg-[#FDE8EC] text-[#B80022] text-sm font-bold">{pluralize(w.doubleBooked, 'run')} double-booked on a line (outlined in red).</div>}
                    </div>
                )}

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-auto" style={{ maxHeight: 'calc(100vh - 380px)', minHeight: 280 }}>
                    <div className="sticky top-0 z-30 flex bg-white border-b-2 border-slate-300" style={{ minWidth: LABEL_W + trackMin }}>
                        <div className="sticky left-0 z-40 bg-white border-r-2 border-slate-300 flex items-end px-3 pb-2 flex-shrink-0" style={{ width: LABEL_W }}>
                            <span className={labelCls}>Line</span>
                        </div>
                        <div className="relative flex-1 h-12" style={{ minWidth: trackMin }}>
                            {win.days.slice(0, weekSpan).map((d, i) => {
                                const next = win.days[i + 1], isToday = nowMs >= d && nowMs < next;
                                return (
                                    <div key={d} data-wk-day={d} className={`absolute top-0 bottom-0 border-l border-slate-300 ${isToday ? 'bg-[#FFF6E0]' : ''}`} style={{ left: `${at(d)}%`, width: `${at(next) - at(d)}%` }}>
                                        <div className={`px-2 pt-1 text-xs font-black truncate ${isToday ? 'text-[#00468B]' : 'text-slate-700'}`}>{new Date(d).toLocaleDateString([], { weekday: 'short', month: 'numeric', day: 'numeric' })}</div>
                                        {pxPerDay >= 150 && [6, 18].map(h => (
                                            <span key={h} aria-hidden="true" className="absolute bottom-0.5 text-[9px] font-bold text-slate-600 -translate-x-1/2" style={{ left: `${((hourOf(d, h) - d) / (next - d)) * 100}%` }}>{h === 6 ? '6 AM' : '6 PM'}</span>
                                        ))}
                                    </div>
                                );
                            })}
                            {showNow && <span aria-hidden="true" className="absolute bottom-0 w-2.5 h-2.5 -translate-x-1/2 rounded-full bg-[#E4002B] z-10" style={{ left: `${at(nowMs)}%` }} />}
                        </div>
                    </div>

                    <div className="relative" style={{ minWidth: LABEL_W + trackMin }}>
                        <div aria-hidden="true" className="absolute inset-y-0 right-0 pointer-events-none z-0" style={{ left: LABEL_W }}>
                            {win.days.slice(0, weekSpan).map((d, i) => {
                                const next = win.days[i + 1];
                                const strips = [[d, hourOf(d, 6)], [hourOf(d, 18), next]];
                                return (
                                    <React.Fragment key={d}>
                                        {strips.map((s, k) => <div key={k} className="absolute top-0 bottom-0" style={{ left: `${at(s[0])}%`, width: `${((s[1] - s[0]) / total) * 100}%`, background: 'rgba(0,70,139,0.045)' }} />)}
                                        <div className="absolute top-0 bottom-0 border-l border-slate-300" style={{ left: `${at(d)}%` }} />
                                    </React.Fragment>
                                );
                            })}
                        </div>

                        {w.lanes.length === 0 && (
                            <div className="px-6 py-12 text-center text-sm text-slate-500">{loadingRuns ? 'Loading lines...' : 'No lines to show. Mark areas that run product, or add runs in the production schedule app.'}</div>
                        )}
                        {w.supportLanes.length > 0 && w.prodLanes.length > 0 && laneBand('Production', w.prodLanes.length)}
                        {w.prodLanes.map(laneRow)}
                        {w.supportLanes.length > 0 && laneBand('Support', w.supportLanes.length, w.prodLanes.length > 0)}
                        {(weekSupportOpen || w.prodLanes.length === 0) && w.supportLanes.map(laneRow)}   {/* with only support lanes in view (a support area is picked) there is nothing to fold them under */}
                        {showNow && (
                            <div aria-hidden="true" className="absolute inset-y-0 right-0 pointer-events-none z-[5]" style={{ left: LABEL_W }}>
                                <div className="absolute top-0 bottom-0 w-0.5 bg-[#E4002B]" style={{ left: `${at(nowMs)}%` }} />
                            </div>
                        )}
                    </div>
                </div>
            </div>
        );
    };

    const renderProdMonthlyTab = () => (
        <div className="animate-in fade-in duration-300 flex flex-col h-[calc(100vh-140px)]">
            <div className="flex justify-between items-center mb-6">
                <div>
                    <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Production Run Monthly Calendar</h2>
                    <p className="text-sm text-slate-500">Double-click a block to adjust its timeframe. Drag and Drop to reschedule.</p>
                </div>
                <div className="flex items-center gap-4 bg-white p-1 rounded-lg border border-slate-200 shadow-sm">
                    <button onClick={() => changeProdMonth(-1)} className="px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-md">{"< Prev"}</button>
                    <span className="font-bold text-slate-800 text-sm min-w-[120px] text-center">{prodCalendarMonth.toLocaleString('default', { month: 'long', year: 'numeric' })}</span>
                    <button onClick={() => changeProdMonth(1)} className="px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-md">{"Next >"}</button>
                </div>
            </div>
            <div className="flex-1 bg-slate-200 border border-slate-200 rounded-xl overflow-hidden grid grid-cols-7 gap-px">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => (
                    <div key={d} className="bg-slate-50 py-3 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">{d}</div>
                ))}
                {getProdCalendarDays().map((dayNum, i) => {
                    if (!dayNum) return <div key={`empty-${i}`} className="bg-slate-50/50" />;
                    const tDateObj = new Date(prodCalendarMonth.getFullYear(), prodCalendarMonth.getMonth(), dayNum);
                    const tDate = getLocalYMD(tDateObj);
                    
                    const daySchedules = prodSchedules?.filter(t => {
                        const sd = new Date(t.craa5_datestarttime || t.craa5_Datestarttime || t.craa5_starttime); 
                        const tar = new Date(tDate);
                        // Restrict rendering to ONLY the day the run starts
                        return sd.toDateString() === tar.toDateString();
                    }) || [];

                    return (
                        <div 
                            key={dayNum} 
                            className="bg-white py-2 flex flex-col min-h-[120px] max-h-[180px] overflow-y-auto no-scrollbar"
                            onDragOver={(e) => { e.preventDefault(); e.currentTarget.classList.add('bg-[#E6F1FB]/50'); }}
                            onDragLeave={(e) => { e.currentTarget.classList.remove('bg-[#E6F1FB]/50'); }}
                            onDrop={(e) => {
                                e.preventDefault();
                                e.currentTarget.classList.remove('bg-[#E6F1FB]/50');
                                const schId = e.dataTransfer.getData("text/plain");
                                if (schId) handleDragDropSchedule(schId, tDateObj);
                            }}
                        >
                            <span className="text-sm font-bold text-slate-700 px-2 mb-1">{dayNum}</span>
                            <div className="flex flex-col gap-1 px-1">
                                {daySchedules.map(sch => {
                                    const sd = new Date(sch.craa5_datestarttime || sch.craa5_Datestarttime || sch.craa5_starttime); 
                                    const ed = new Date(sch.craa5_dateendtime || sch.craa5_Dateendtime || sch.craa5_endtime);
                                    
                                    const isMultiDay = sd.toDateString() !== ed.toDateString();
                                    const hasAllergen = sch.craa5_allergen === true || sch.craa5_allergen === 1;
                                    const hasCrumb = sch.craa5_crumbclean === true || sch.craa5_crumbclean === 1 || sch.craa5_CrumbClean === true;
                                    
                                    const rawId = sch.craa5__aa_prd_schdid || sch.craa5_aa_prd_schdid || "NEW";
                                    const shortUid = rawId.toString().slice(-4).toUpperCase();
                                    
                                    return (
                                        <div 
                                            key={rawId} 
                                            draggable
                                            onDragStart={(e) => { e.dataTransfer.setData("text/plain", rawId); }}
                                            onDoubleClick={(e) => {
                                                e.stopPropagation();
                                                openEditDialog(sch);
                                            }} 
                                            className={`relative group bg-[#E6F1FB] py-1.5 cursor-move hover:bg-[#CFE3F7] hover:shadow-sm transition-all rounded-md border-l-[3px] ${hasAllergen ? 'border-[#FFB81C]' : 'border-[#0072CE]'}`}
                                            style={{ paddingLeft: '6px', paddingRight: '16px', marginBottom: '2px' }}
                                            title={`Double Click to Edit\nUID: ${shortUid} | ${renderSafe(sch.craa5_product || sch.craa5_Product)} (${sd.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})} - ${ed.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})})`}
                                        >
                                            {isMultiDay && <div className="absolute right-1 top-1/2 -translate-y-1/2 text-[#80B8E8] text-[10px]">►</div>}
                                            
                                            <div className="flex justify-between items-start gap-1">
                                                <strong className="block text-[10px] text-[#00468B] uppercase leading-none mb-0.5 truncate">{getAreaLine(sch)}</strong>
                                                <span className="text-[8px] font-mono text-slate-400 bg-white/50 px-1 rounded flex-shrink-0">#{shortUid}</span>
                                            </div>
                                            <span className="text-[11px] text-slate-600 truncate block leading-tight">{renderSafe(sch.craa5_product || sch.craa5_Product)} {hasAllergen ? "⚠️" : ""} {hasCrumb ? "🧹" : ""}</span>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    );


    return (
        <div className="flex flex-col h-screen bg-[#F7F9FC] text-slate-800 overflow-hidden" style={{ fontFamily: BRAND_FONT }}>
            <header className="bg-white border-b-4 border-[#FFB81C] flex-shrink-0 z-20">
                <div className="max-w-[1900px] mx-auto px-4 sm:px-7 h-[72px] flex items-center justify-between gap-4">
                    <div className="min-w-0">
                        <h1 className="text-lg font-black text-[#00468B] leading-tight tracking-tight truncate">Production Manager</h1>
                        <p className="text-[11px] font-bold text-slate-500 truncate">{selectedDate} · Shift {currentShift}</p>
                    </div>
                    <BrandLogo onClick={mhAllowed ? mhLogoClick : undefined} pressed={mhAllowed ? mhUnlock.unlocked : undefined} />
                </div>
            </header>

            <nav className="bg-white border-b border-slate-200 flex-shrink-0 z-10">
                <div className="max-w-[1900px] mx-auto px-3 sm:px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <div className="brand-tabs flex gap-1.5 overflow-x-auto md:flex-wrap md:overflow-visible flex-1 min-w-[280px]">
                        {visibleTabs.map(tab => {
                            const Icon = tab.icon;
                            const isActive = activeTab === tab.id;
                            return (
                                <button
                                    key={tab.id}
                                    onClick={() => setActiveTab(tab.id)}
                                    aria-current={isActive ? 'page' : undefined}
                                    aria-label={tab.id === 'lineorder' && lpDirty ? 'Line order, unsaved changes' : undefined}
                                    className={`px-4 py-2 min-h-[44px] sm:min-h-0 text-[11px] font-extrabold uppercase tracking-[0.08em] rounded-xl flex items-center gap-2 whitespace-nowrap flex-shrink-0 transition-colors ${
                                        isActive ? 'bg-[#0072CE] text-white shadow-[0_6px_14px_rgba(0,114,206,0.25)]' : 'text-slate-500 hover:bg-[#E6F1FB] hover:text-[#0072CE]'
                                    }`}
                                >
                                    <Icon className="w-4 h-4" />
                                    <span>{tab.label}</span>
                                    {tab.id === 'lineorder' && lpDirty && <span aria-hidden="true" title="Unsaved changes" data-lp-dot className={`w-2 h-2 rounded-full ${isActive ? 'bg-[#FFB81C]' : 'bg-[#E4002B]'}`} />}
                                </button>
                            );
                        })}
                    </div>
                    <div className="flex items-center gap-2 flex-shrink-0">
                        <label htmlFor="target-date" className="hidden sm:block text-[10px] font-black text-slate-500 uppercase tracking-widest">Target Date</label>
                        <input
                            id="target-date" aria-label="Target date"
                            type="date"
                            value={selectedDate}
                            onChange={(e) => { if (e.target.value) setSelectedDate(e.target.value); }}
                            className="border border-slate-300 rounded-lg py-1.5 px-2 min-h-[44px] sm:min-h-0 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]"
                        />
                        <button onClick={() => { loadedRef.current = { task: [], prod: [], keys: new Set() }; setAllAssignments([]); setProdSchedules([]); setRangeIssues({}); empAccessRef.current = { i: 0, ok: false }; areaAccessRef.current = { i: 0, ok: false }; setReloadTick(t => t + 1); }} disabled={isLoading} className="text-[11px] font-extrabold uppercase tracking-wider text-[#0072CE] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] rounded-lg px-3 py-2 min-h-[44px] sm:min-h-0 disabled:opacity-50 whitespace-nowrap">{rangeBusy > 0 ? 'Loading…' : 'Reload data'}</button>
                    </div>
                </div>
            </nav>

            <main className="flex-1 overflow-y-auto relative">
                {notice && (
                    <div role="status" className={`fixed top-4 right-4 z-[100] max-w-sm px-4 py-3 rounded-xl shadow-lg border text-sm font-bold ${notice.type === 'error' ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B80022]' : notice.type === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-[#E6F1FB] border-[#B3D4F2] text-[#00468B]'}`}>
                        {notice.message}
                    </div>
                )}
                {rangeBusy > 0 && <div className="mx-4 md:mx-8 mt-4 px-4 py-2 rounded-xl bg-[#E6F1FB] border border-[#B3D4F2] text-[#00468B] text-sm font-bold">Loading data for this period…</div>}
                {(loadIssues.length > 0 || Object.keys(rangeIssues).length > 0) && (
                    <div className="mx-4 md:mx-8 mt-4 px-4 py-3 rounded-xl border border-[#FFB81C] bg-[#FFF6E0] text-slate-800 text-sm">
                        <span className="font-black uppercase tracking-wider text-[11px] text-[#00468B]">Data check: </span>{[...loadIssues, ...Object.values(rangeIssues)].join(' · ')}
                    </div>
                )}
                <div className={`p-4 md:p-6 max-w-[1700px] mx-auto${activeTab === 'lineorder' ? ' min-h-full flex flex-col' : ''}`}>
                    {activeTab === 'overview' && renderOverviewTab()}
                    {activeTab === 'employee' && (!MH_LOCK_EMPLOYEE_QUERY || mhAllowed ? renderEmployeeTab() : <LockGate state={mhAccess} title="Employee Query is for supervisors and managers" />)}
                    {activeTab === 'calendar' && renderCalendarTab()}
                    {activeTab === 'tasks' && renderTasksTab()}
                    {activeTab === 'weekly' && renderProdWeeklyTab()}
                    {activeTab === 'prod_calendar' && renderProdMonthlyTab()}
                    {activeTab === 'lineorder' && renderLineOrderTab()}
                    {activeTab === 'kudos' && <LockGate state={mhAccess}><MhHighFivesTab dataApi={dataApi} access={mhAccess} notify={notify} reloadTick={reloadTick} /></LockGate>}
                    {activeTab === 'callouts' && <LockGate state={mhAccess}><MhCalloutsTab access={mhAccess} notify={notify} /></LockGate>}
                    {activeTab === 'dvcheck' && mhUnlock.unlocked && <MhCheckerTab dataApi={dataApi} access={mhAccess} notify={notify} onLock={mhUnlock.lock} />}
                </div>
            </main>

            {/* POPOUT GANTT CHART MODAL */}
            {isGanttModalOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 md:p-8">
                    <div role="dialog" aria-modal="true" aria-label="Personnel Gantt" tabIndex={-1} onKeyDown={trapTabKey} className="outline-none bg-slate-50 rounded-2xl shadow-2xl w-full h-full max-w-[1800px] overflow-hidden flex flex-col animate-in zoom-in-95 duration-200">
                        <div className="bg-white border-b border-slate-200 px-6 py-4 flex flex-col gap-4 shadow-sm z-20">
                            <div className="flex flex-wrap justify-between items-center gap-3">
                                <div>
                                    <h3 className="text-base font-black text-[#00468B] uppercase tracking-widest flex items-center gap-2">
                                        <AlignLeftIcon className="w-5 h-5" /> 
                                        {ganttShiftFilter ? `Shift ${ganttShiftFilter}` : 'All Shifts'} - Personnel Activity ({shiftLookbackHours}h Timeframe)
                                    </h3>
                                    <p className="text-xs text-slate-500 mt-1 flex flex-wrap items-center gap-1.5">
                                        <label htmlFor="gantt-hours">Showing the</label>
                                        <input id="gantt-hours" type="number" min="1" max="72" value={ganttHoursDraft !== null ? ganttHoursDraft : shiftLookbackHours}
                                            onChange={e => { const t = e.target.value; setGanttHoursDraft(t); const n = parseInt(t, 10); if (n >= 1 && n <= 72) setShiftLookbackHours(n); }}
                                            onBlur={() => setGanttHoursDraft(null)}
                                            className="w-14 text-center border border-slate-300 rounded py-0.5 text-xs font-bold bg-slate-50" />
                                        <span>hours ending {new Date(shiftWindowData.windowEndMs).toLocaleString([], {weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'})}.</span>
                                    </p>
                                </div>
                                <div className="flex flex-wrap items-center gap-3">
                                    <button 
                                        onClick={handleCopyForExcel}
                                        className="px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 rounded-md transition-colors flex items-center gap-2 shadow-sm"
                                        title="Copy data to paste into Excel"
                                    >
                                        <FileSpreadsheetIcon className="w-4 h-4" /> Copy for Excel
                                    </button>
                                    <button 
                                        onClick={handleCopyGanttImage}
                                        disabled={isCopyingGantt}
                                        className="px-3 py-2 text-sm font-medium text-white bg-[#0072CE] hover:bg-[#00468B] rounded-md transition-colors flex items-center gap-2 shadow-sm disabled:opacity-50"
                                    >
                                        {isCopyingGantt ? <RotateCcwIcon className="w-4 h-4 animate-spin"/> : <CameraIcon className="w-4 h-4"/>}
                                        {isCopyingGantt ? "Copying..." : "Copy as Image"}
                                    </button>
                                    <div className="w-px h-8 bg-slate-300 mx-1"></div>
                                    <button id="gantt-close" type="button" aria-label="Close the Personnel Gantt" onClick={() => setIsGanttModalOpen(false)} className="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-full transition-colors">
                                        <XIcon className="w-6 h-6" />
                                    </button>
                                </div>
                            </div>

                            {(() => {
                                const areaHeadcounts = {};
                                const uniqueAreas = new Set();
                                
                                activeGanttModalDataRaw.forEach(emp => {
                                    if (emp.blocks.length === 0) {
                                        uniqueAreas.add("Idle (No Tasks)");
                                        areaHeadcounts["Idle (No Tasks)"] = (areaHeadcounts["Idle (No Tasks)"] || 0) + 1;
                                    } else {
                                        const empAreas = new Set(emp.blocks.map(b => b.area));
                                        empAreas.forEach(area => {
                                            uniqueAreas.add(area);
                                            areaHeadcounts[area] = (areaHeadcounts[area] || 0) + 1;
                                        });
                                    }
                                });
                                const sortedAreas = Array.from(uniqueAreas).sort();

                                return (
                                    <div className="flex flex-wrap items-center gap-x-4 gap-y-2 bg-slate-50/80 p-2.5 rounded-lg border border-slate-200">
                                        <div className="flex items-center gap-2 shrink-0">
                                            <span className="text-sm font-semibold text-slate-700">Filter Shift:</span>
                                            <select 
                                                value={ganttShiftFilter} aria-label="Filter by shift"
                                                onChange={e => setGanttShiftFilter(e.target.value)}
                                                className="border border-slate-300 rounded px-2 py-1 text-sm focus:ring-[#0072CE] focus:border-[#0072CE] outline-none cursor-pointer"
                                            >
                                                <option value="">All Shifts</option>
                                                {shiftWindowData.uniqueShifts.map(s => <option key={s} value={s}>Shift {s}</option>)}
                                            </select>
                                        </div>
                                        <div className="hidden sm:block h-6 w-px bg-slate-300 mx-1 shrink-0"></div>
                                        <div className="flex items-center gap-2 shrink-0">
                                            <span className="text-sm font-semibold text-slate-700">Filter Area:</span>
                                            <select 
                                                value={ganttAreaFilter} aria-label="Filter by area"
                                                onChange={e => setGanttAreaFilter(e.target.value)}
                                                className="border border-slate-300 rounded px-2 py-1 text-sm focus:ring-[#0072CE] focus:border-[#0072CE] outline-none cursor-pointer"
                                            >
                                                <option value="">All Areas</option>
                                                {sortedAreas.map(a => <option key={a} value={a}>{a}</option>)}
                                            </select>
                                        </div>
                                        <div className="hidden sm:block h-6 w-px bg-slate-300 mx-1 shrink-0"></div>
                                        <div role="region" tabIndex={0} aria-label="Headcount by area" className="flex items-center gap-2 flex-wrap flex-1 min-w-[220px] overflow-y-auto max-h-[60px] no-scrollbar focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] rounded">
                                            <span className="px-2.5 py-1 bg-[#CFE3F7] text-[#00468B] text-xs font-bold rounded-full shadow-sm whitespace-nowrap">
                                                Overall Headcount: {activeGanttModalDataRaw.length}
                                            </span>
                                            {sortedAreas.map(area => (
                                                <span 
                                                    key={area} 
                                                    className={`px-2.5 py-1 text-xs font-semibold rounded-full border shadow-sm transition-colors whitespace-nowrap
                                                        ${ganttAreaFilter === area ? 'bg-[#0072CE] text-white border-[#00468B]' : 'bg-white text-slate-700 border-slate-200'}
                                                        ${area === 'Idle (No Tasks)' && ganttAreaFilter !== area ? 'text-orange-700 bg-orange-50 border-orange-200' : ''}
                                                    `}
                                                >
                                                    {area}: {areaHeadcounts[area]}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                );
                            })()}
                        </div>

                        <div role="region" tabIndex={0} aria-label="Personnel timeline" className="flex-1 overflow-auto p-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0072CE]" ref={ganttRef}>
                            {(() => {
                                const shiftData = ganttAreaFilter 
                                    ? activeGanttModalDataRaw.filter(emp => {
                                        if (ganttAreaFilter === "Idle (No Tasks)") return emp.blocks.length === 0;
                                        return emp.blocks.some(b => b.area === ganttAreaFilter);
                                    })
                                    : activeGanttModalDataRaw;

                                if (shiftData.length === 0) return <div className="flex h-full items-center justify-center text-slate-500 italic">No personnel match the current filter.</div>;

                                const totalMs = shiftWindowData.windowEndMs - shiftWindowData.windowStartMs;

                                return (
                                    <div className="min-w-[1000px] flex flex-col bg-white rounded-lg border border-slate-200 shadow-sm">
                                        <div className="flex pl-[250px] border-b border-slate-200 bg-slate-100 sticky top-0 z-30">
                                            {Array.from({length: shiftLookbackHours <= 24 ? 6 : 12}, (_, i) => {
                                                const fraction = i / (shiftLookbackHours <= 24 ? 6 : 12);
                                                const labelTime = new Date(shiftWindowData.windowStartMs + (totalMs * fraction));
                                                return (
                                                    <div key={i} className="flex-1 text-left border-l border-slate-300 p-3">
                                                        <span className="text-[11px] text-slate-600 font-bold uppercase tracking-wider">
                                                            {labelTime.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}
                                                        </span>
                                                        <span className="text-[9px] text-slate-600 block -mt-1">
                                                            {labelTime.toLocaleDateString([],{month:'short', day:'numeric'})}
                                                        </span>
                                                    </div>
                                                )
                                            })}
                                        </div>
                                        <div className="flex flex-col relative pb-4">
                                            <div className="absolute inset-0 left-[250px] flex pointer-events-none opacity-30 z-0">
                                                {Array.from({length: shiftLookbackHours <= 24 ? 12 : 24}).map((_, i) => (
                                                    <div key={i} className="flex-1 border-l border-dashed border-slate-400"></div>
                                                ))}
                                            </div>
                                            {shiftData.map(emp => (
                                                <div key={emp.empName} className="flex items-stretch min-h-[56px] border-b border-dashed border-slate-200 z-10 hover:bg-[#E6F1FB]/20">
                                                    <div className="w-[250px] px-4 py-3 flex-shrink-0 border-r-2 border-slate-200 flex items-center bg-white z-20">
                                                        <div className="flex-shrink-0 h-8 w-8 rounded-full bg-[#CFE3F7] flex items-center justify-center text-[#00468B] font-bold text-xs mr-3">
                                                            {emp.empName ? emp.empName.substring(0,2).toUpperCase() : '?'}
                                                        </div>
                                                        <div className="flex flex-col overflow-hidden">
                                                            <span className="font-semibold text-sm text-slate-800 truncate" title={emp.empName}>{emp.empName}</span>
                                                            {!ganttShiftFilter && <span className="text-[10px] text-slate-500 font-medium">Shift {emp.shift}</span>}
                                                        </div>
                                                    </div>
                                                    <div className="flex-1 relative">
                                                        {emp.shiftBlocks?.map((block, idx) => {
                                                            const leftPct = ((block.start - shiftWindowData.windowStartMs) / totalMs) * 100;
                                                            const widthPct = ((block.end - block.start) / totalMs) * 100;
                                                            return (
                                                                <div 
                                                                    key={`shift-${idx}`} 
                                                                    className="absolute top-2 bottom-2 bg-[#FDE8EC] border border-red-100 opacity-60 rounded-md" 
                                                                    style={{ left: `${leftPct}%`, width: `${widthPct}%`, backgroundImage: 'repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(255,0,0,0.05) 5px, rgba(255,0,0,0.05) 10px)' }} 
                                                                    title="Unutilized Scheduled Shift Time"
                                                                />
                                                            )
                                                        })}
                                                        {emp.blocks.map(block => {
                                                            const leftPct = ((block.start - shiftWindowData.windowStartMs) / totalMs) * 100;
                                                            const widthPct = ((block.end - block.start) / totalMs) * 100;
                                                            const isFilteredArea = ganttAreaFilter === "" || block.area === ganttAreaFilter;
                                                            return (
                                                                <div 
                                                                    key={block.taskId}
                                                                    className={`absolute top-2 bottom-2 rounded-md text-[11px] font-bold px-3 py-1 flex flex-col justify-center overflow-hidden shadow-sm hover:brightness-95 transition-all z-10
                                                                        ${isFilteredArea ? 'text-[#00468B] bg-[#CFE3F7] border border-[#3D95DB]' : 'text-slate-500 bg-slate-100 border border-slate-300 opacity-60'}
                                                                    `}
                                                                    style={{ left: `${leftPct}%`, width: `${widthPct}%` }}
                                                                    title={`Area: ${block.area}\nStatus: ${block.status}`}
                                                                >
                                                                    <span className="truncate leading-tight">{block.area}</span>
                                                                    {block.status && widthPct > 5 && <span className={`text-[9px] font-normal truncate leading-tight opacity-80 ${isFilteredArea ? 'text-[#00468B]' : 'text-slate-500'}`}>{block.status}</span>}
                                                                </div>
                                                            );
                                                        })}
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                );
                            })()}
                        </div>
                    </div>
                </div>
            )}

            {/* Adjust Production Run Dialog */}
            {editSchOpen && editSchData && (() => {
                const d = editSchData, chk = checkEditedRun(d);
                const set = (patch) => setEditSchData(p => ({ ...p, ...patch }));
                const cls = "w-full border border-slate-300 rounded-lg py-2 px-3 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE] bg-white";
                const lab = "block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1";
                const areaNames = lpSortAreas(Array.from(new Set((areas || []).filter(runsProduct).map(a => renderSafe(a.craa5_area || a.craa5_name)).filter(Boolean).concat(d.area ? [d.area] : []))), lpEntries);   // the Line order list first, then by name
                return (
                    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                        <div role="dialog" aria-modal="true" aria-labelledby="edit-run-title" tabIndex={-1} onKeyDown={trapTabKey} className="outline-none bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[92vh] overflow-hidden flex flex-col animate-in zoom-in-95 duration-200">
                            <div className="bg-[#00468B] border-b-4 border-[#FFB81C] px-6 py-4 flex justify-between items-center flex-shrink-0">
                                <h3 id="edit-run-title" className="text-lg font-bold text-white">Adjust Production Run</h3>
                            </div>
                            <div className="p-6 space-y-4 overflow-y-auto">
                                <div className="grid grid-cols-3 gap-3">
                                    <div className="col-span-2">
                                        <label htmlFor="er-area" className={lab}>Area</label>
                                        <select id="er-area" value={d.area} onChange={e => set({ area: e.target.value })} className={cls}>
                                            {!d.area && <option value="">Choose an area...</option>}
                                            {areaNames.map(a => <option key={a} value={a}>{a}</option>)}
                                        </select>
                                    </div>
                                    <div>
                                        <label htmlFor="er-line" className={lab}>Line #</label>
                                        <input id="er-line" type="number" min="1" value={d.line} onChange={e => set({ line: e.target.value })} className={cls} />
                                    </div>
                                </div>
                                <div className="grid grid-cols-3 gap-3">
                                    <div>
                                        <label htmlFor="er-code" className={lab}>Product code</label>
                                        <input id="er-code" type="text" inputMode="numeric" value={d.productCode} onChange={e => set({ productCode: e.target.value })} className={cls} />
                                    </div>
                                    <div className="col-span-2">
                                        <label htmlFor="er-product" className={lab}>Product</label>
                                        <input id="er-product" type="text" value={d.product} onChange={e => set({ product: e.target.value })} className={cls} />
                                    </div>
                                </div>
                                <div className="grid grid-cols-2 gap-3">
                                    <div>
                                        <label htmlFor="er-sd" className={lab}>Start date</label>
                                        <input id="er-sd" type="date" value={d.startDate} onChange={e => set({ startDate: e.target.value })} className={cls} />
                                    </div>
                                    <div>
                                        <label htmlFor="er-st" className={lab}>Start time</label>
                                        <input id="er-st" type="time" value={d.startTime} onChange={e => set({ startTime: e.target.value })} className={cls} />
                                    </div>
                                    <div>
                                        <label htmlFor="er-ed" className={lab}>End date</label>
                                        <input id="er-ed" type="date" value={d.endDate} onChange={e => set({ endDate: e.target.value })} className={cls} />
                                    </div>
                                    <div>
                                        <label htmlFor="er-et" className={lab}>End time</label>
                                        <input id="er-et" type="time" value={d.endTime} onChange={e => set({ endTime: e.target.value })} className={cls} />
                                    </div>
                                </div>
                                <div className="flex flex-wrap items-center gap-x-6 gap-y-2">
                                    <label className="flex items-center gap-2 text-sm font-bold text-slate-700 cursor-pointer">
                                        <input type="checkbox" checked={!!d.allergen} onChange={e => set({ allergen: e.target.checked })} className="accent-[#0072CE] w-4 h-4" /> Allergen run
                                    </label>
                                    <label className="flex items-center gap-2 text-sm font-bold text-slate-700 cursor-pointer">
                                        <input type="checkbox" checked={!!d.crumbClean} onChange={e => set({ crumbClean: e.target.checked })} className="accent-[#0072CE] w-4 h-4" /> Crumb clean
                                    </label>
                                </div>
                                {d.allergen && (
                                    <div>
                                        <label htmlFor="er-allergen" className={lab}>Type of allergen</label>
                                        <input id="er-allergen" type="text" value={d.typeOfAllergen} onChange={e => set({ typeOfAllergen: e.target.value })} placeholder="For example peanut" className={cls} />
                                    </div>
                                )}
                                {chk.problem && <p role="alert" className="text-sm font-bold text-[#E4002B]">{chk.problem}</p>}
                                {!chk.problem && chk.clash && (
                                    <p role="status" className="text-sm px-3 py-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] text-slate-800">
                                        <b>Heads up:</b> this overlaps {runName(chk.clash)} on the same line ({fmtDay(new Date(startMs(chk.clash)))} {fmtTime(new Date(startMs(chk.clash)))} to {fmtDay(new Date(endMs(chk.clash)))} {fmtTime(new Date(endMs(chk.clash)))}). You can still save.
                                    </p>
                                )}
                            </div>
                            <div className="bg-slate-50 px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-t border-slate-200 flex-shrink-0">
                                {!isConfirmingDelete ? (
                                    <button onClick={() => setIsConfirmingDelete(true)} className="px-4 py-2 text-sm font-medium text-white bg-[#E4002B] rounded-md hover:bg-[#B80022] shadow-sm transition-colors">Delete</button>
                                ) : (
                                    <div className="flex items-center gap-2 bg-[#FDE8EC] p-1.5 rounded-lg border border-red-100 animate-in fade-in slide-in-from-left-2">
                                        <span className="text-xs font-bold text-red-700 px-2">Are you sure?</span>
                                        <button onClick={handleDeleteSchedule} className="px-3 py-1.5 text-xs font-bold text-white bg-[#E4002B] rounded hover:bg-[#B80022] shadow-sm transition-colors">Yes, Delete</button>
                                        <button onClick={() => setIsConfirmingDelete(false)} className="px-3 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded hover:bg-slate-50 transition-colors">Cancel</button>
                                    </div>
                                )}

                                <div className="flex gap-3">
                                    <button onClick={() => { setEditSchOpen(false); setIsConfirmingDelete(false); }} className="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-md hover:bg-slate-50 shadow-sm transition-colors">Cancel</button>
                                    <button onClick={handleUpdateSchedule} disabled={editSaving || !!chk.problem} className="px-4 py-2 text-sm font-medium text-white bg-[#0072CE] rounded-md hover:bg-[#00468B] disabled:opacity-50 disabled:cursor-not-allowed shadow-sm transition-colors">{editSaving ? 'Saving...' : 'Save Update'}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })()}

            {/* Task Delegation Dialog */}
            {isTaskDialogOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                    <div className="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden animate-in zoom-in-95 duration-200">
                        <div className="bg-[#00468B] border-b-4 border-[#FFB81C] px-6 py-4 flex justify-between items-center">
                            <h3 className="text-lg font-bold text-white flex items-center gap-2"><TargetIcon className="w-5 h-5"/> Delegate Task to Supervisor</h3>
                        </div>
                        <div className="p-6 space-y-5">
                            <div className="space-y-1">
                                <label className="text-sm font-semibold text-slate-700">Assign To (Supervisor)</label>
                                <select 
                                    value={taskPayload.supervisorEmail} 
                                    onChange={(e) => setTaskPayload(p => ({ ...p, supervisorEmail: e.target.value }))} 
                                    className="w-full border border-slate-300 rounded py-2 px-3 focus:ring-[#0072CE]"
                                >
                                    <option value="">Select a supervisor...</option>
                                    {supervisors?.map(sup => {
                                        const email = getEmployeeEmail(sup);
                                        return <option key={sup.craa5__aa_employeeid} value={email} disabled={!email}>{formatFullName(sup.craa5_name)} {email ? `(${email})` : '(No Email)'}</option>;
                                    })}
                                </select>
                            </div>
                            <div className="space-y-1">
                                <label className="text-sm font-semibold text-slate-700">Task Title</label>
                                <input 
                                    type="text" placeholder="e.g. Audit Line 4 Safety Protocol" 
                                    value={taskPayload.title} onChange={(e) => setTaskPayload(p => ({ ...p, title: e.target.value }))} 
                                    className="w-full border border-slate-300 rounded py-2 px-3 focus:ring-[#0072CE]" 
                                />
                            </div>
                            <div className="space-y-1">
                                <label className="text-sm font-semibold text-slate-700">Task Description</label>
                                <textarea 
                                    placeholder="Provide specific instructions..." rows={4}
                                    value={taskPayload.description} onChange={(e) => setTaskPayload(p => ({ ...p, description: e.target.value }))} 
                                    className="w-full border border-slate-300 rounded py-2 px-3 focus:ring-[#0072CE] resize-none" 
                                />
                            </div>
                            <div className="space-y-1">
                                <label className="text-sm font-semibold text-slate-700">Expectation Date</label>
                                <input 
                                    type="date" 
                                    value={taskPayload.expectationDate} onChange={(e) => setTaskPayload(p => ({ ...p, expectationDate: e.target.value }))} 
                                    className="w-full border border-slate-300 rounded py-2 px-3 focus:ring-[#0072CE]" 
                                />
                            </div>
                        </div>
                        <div className="bg-slate-50 px-6 py-4 flex justify-end gap-3 border-t border-slate-200">
                            <button onClick={() => setIsTaskDialogOpen(false)} className="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-md hover:bg-slate-50">Cancel</button>
                            <button onClick={handleCreateTask} disabled={isSubmittingTask || !taskPayload.title || !taskPayload.supervisorEmail} className="px-4 py-2 text-sm font-medium text-white bg-[#0072CE] rounded-md hover:bg-[#00468B] disabled:opacity-50 flex items-center gap-2">
                                {isSubmittingTask ? <RotateCcwIcon className="w-4 h-4 animate-spin" /> : "Assign & Notify"}
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* v6.5: the profile dialog (MH FEATURE NOTES), for allowed users only. Employee Query's numbers go with it when they are this person's,
                and only once all of them are in (a snapshot must not freeze a half-read or partly failed summary). */}
            {mhAllowed && mhProfile && (
                <MhProfileDialog key={mhProfile.guid || mhProfile.name} dataApi={dataApi} access={mhAccess} notify={notify} target={mhProfile}
                    profile={mhSamePerson(mhProfile, empPick) && !empData.loading && !empData.error ? empProfile : null}
                    summaryLoading={mhSamePerson(mhProfile, empPick) && !!empData.loading}
                    range={mhSamePerson(mhProfile, empPick) && !empWin.error ? { first: empWin.first, last: empWin.last, days: empWin.days } : null}
                    onClose={() => setMhProfile(null)} />
            )}
        </div>
    );
}

// ==== MH FEATURE CALLOUTS (v6.5) ====
// The Call-outs tab (id 'callouts', allowed users only): paste Teams messages, nothing is saved.
// props: { access (see useMhAccess; access.userName is the signed-in person, '' while unknown), notify(message, type) }.
// A supervisor copies the Teams chat where people call in (sick, late, PTO, leaving early, no call no show) and pastes it here.
// The tab lists the messages and sums them up: the word said most and a count for each reason, at the top.
// Privacy: nothing is saved. No Dataverse calls and no browser storage: the text lives in this tab's state and is gone when another
// tab is opened. Common medical words (fever, doctor, covid..., and words like colitis or vasectomy) are left out of the word counts,
// and only how many were left out is shown; a rare word may still get through. People's
// names are kept out of the word counts too: authors, "Seen by" names, words that look like names ("Morning Echo", "Echo, ...")
// and the signed-in person's own name (from access).
// Status posts made by other apps (Shift Start "Shift Progress Update", Ganttly "Copy for Teams") are full of SICK, PTO and LATE
// but are not call-outs: they are skipped and counted (see MH_CALL_STATUS_RULES).
// The Teams copy format varies, so mhCallParsePaste reads several shapes and reports what it left out:
//   desktop          "Test, Alpha" then "6:45 AM" (or "Yesterday 9:15 PM", "10/16 6:02 AM", "Friday 5:58 AM", a date alone), then the message
//   bracket          "[6:45 AM] Test, Alpha" or "[10/17/2026 6:45 AM] Alpha Test", the message on the same line or the next ones
//   name-time        "Alpha Test 6:45 AM" then the message
//   name-comma-time  "Test, Alpha, 6:45 AM" then the message
//   name-colon       "Alpha Test: running late" (no time)
//   time-only        "6:45 AM" then the message, no names
//   plain            no headers at all: every line is one message, author ""
// A time line on its own after a message starts a new message from the same author (Teams groups messages under one name),
