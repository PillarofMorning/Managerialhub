                        <button type="button" onClick={() => setSelectedDate(getLocalYMD(new Date()))} className="px-3 py-2 rounded-lg border border-[#B3D4F2] bg-white text-[#0072CE] text-xs font-extrabold uppercase tracking-wider hover:bg-[#E6F1FB]">Today</button>
                        <button type="button" onClick={() => move(1)} aria-label={weekSpan === 7 ? 'Next week' : weekSpan === 14 ? 'Next two weeks' : `Next ${weekSpan === 1 ? 'day' : weekSpan + ' days'}`} className={navBtn}><ChevronRightIcon className="w-4 h-4" /></button>
                    </div>
                    <div className="text-sm font-black text-[#00468B]" aria-live="polite">{rangeLabel}</div>
                    <div className="flex gap-1.5" role="group" aria-label="Days shown">
                        {WEEK_SPANS.map(s => <Chip key={s.days} on={weekSpan === s.days} onClick={() => setWeekSpan(s.days)}>{s.label}</Chip>)}
                    </div>
                    <div className="flex items-center gap-2">
                        <label htmlFor="wk-area" className={labelCls}>Area</label>
                        <select id="wk-area" value={weekArea} onChange={e => setWeekArea(e.target.value)} className="border border-slate-300 rounded-lg py-1.5 px-2 text-sm font-bold bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40">
                            <option value="">All areas</option>
                            {w.areaNames.map(a => <option key={a} value={a}>{a}</option>)}
                        </select>
                    </div>
                    <div className="flex gap-1.5" role="group" aria-label="Color the bars">
                        <Chip on={weekColorBy === 'product'} onClick={() => setWeekColorBy('product')}>By product</Chip>
                        <Chip on={weekColorBy === 'type'} onClick={() => setWeekColorBy('type')}>By type</Chip>
                    </div>
                    <label className="flex items-center gap-2 text-xs font-bold text-slate-600 cursor-pointer">
                        <input type="checkbox" checked={weekHideIdle} onChange={e => setWeekHideIdle(e.target.checked)} className="accent-[#0072CE] w-4 h-4" /> Hide lines with no run
