            </div>
            <div className="flex-1 bg-slate-200 border border-slate-200 rounded-xl overflow-hidden grid grid-cols-7 gap-px">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => (
                    <div key={d} className="bg-slate-50 py-3 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">{d}</div>
                ))}
                {getCalendarDays().map((dayNum, i) => {
                    if (!dayNum) return <div key={`empty-${i}`} className="bg-slate-50/50" />;
                    const targetDateStr = getLocalYMD(new Date(calendarMonth.getFullYear(), calendarMonth.getMonth(), dayNum));
                    const isToday = targetDateStr === getLocalYMD(new Date());
                    const isSelected = targetDateStr === selectedDate;
                    const cellTasks = allAssignments?.filter(t => getTaskDate(t) === targetDateStr) || [];
                    
                    const supAreas = {};
                    cellTasks.forEach(t => {
                        const sup = (renderSafe(t.craa5_team) || "Unassigned").trim();
                        const area = renderSafe(t.craa5_area);
                        const shift = normalizeShift(t["craa5_shift@OData.Community.Display.V1.FormattedValue"] || t.craa5_shift || t.craa5_Shift);
                        
                        if (!supAreas[sup]) supAreas[sup] = { areas: new Set(), shift: shift !== "Unknown Shift" ? shift : 'A' };
                        if (area) supAreas[sup].areas.add(area);
                    });

                    const openDay = () => { setSelectedDate(targetDateStr); setActiveTab('overview'); };
                    const dayLabel = fmtDay(new Date(calendarMonth.getFullYear(), calendarMonth.getMonth(), dayNum));
                    return (
                        <div 
                            key={`day-${dayNum}`} 
                            onClick={openDay}
                            className={`bg-white p-2 min-h-[120px] cursor-pointer hover:bg-[#E6F1FB]/50 transition-colors flex flex-col gap-2 ${isToday ? 'ring-2 ring-inset ring-[#0072CE]' : ''} ${isSelected ? 'bg-[#E6F1FB]/30' : ''}`}
                        >
                            <div className="flex justify-between items-center">
