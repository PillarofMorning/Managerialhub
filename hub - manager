                    if (!alive) return;
                    if (rows === null) failed++;
                    else {
                        if (rows.length >= RANGE_LIMIT) capped++;
                        const add = [];
                        rows.forEach(r => {
                            const id = r.craa5_taskassignmentid;
                            if (id && seen[id]) return;
                            const g = cleanGuid(r.craa5__aaemp_guid);
                            const byGuid = !!g && !!empPick.guid;   // an employee record with no id can only be matched by name
                            if (byGuid ? g !== empPick.guid : nameKeys.indexOf(normText(r.craa5_id)) === -1) { if (byGuid) otherId++; return; }   // another person's row (same name, different employee id)
                            if (id) seen[id] = true;
                            add.push(r);
                        });
                        kept = kept.concat(add);
                    }
                    const snapshot = kept, doneNow = i + 1, cappedNow = capped, otherNow = otherId;
                    setEmpData(prev => prev.key === empKey ? { ...prev, rows: snapshot, done: doneNow, capped: cappedNow, otherId: otherNow } : prev);
                }
                if (!alive) return;
