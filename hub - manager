        const fieldText = (f) => Object.keys(f || {}).map(k => `${k} = ${JSON.stringify(f[k])}`).join(', ');
        const stepText = (s) => `${LP_STEP_WORDS[s.op] || s.op} “${s.name}”${s.id ? ` (id ${s.id})` : ''}${Object.keys(s.fields || {}).length ? `: ${fieldText(s.fields)}` : ''}`;
        const listed = (l) => linePriorityRank(lpDraftEntries, l.area, l.line) !== LINE_PRIORITY_NONE;
