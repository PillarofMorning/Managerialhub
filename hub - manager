        if (it.absence) { bump(away, it.absence, {})[it.day] = true; return; }
        totalMs += it.ms;
        days[it.day] = true;
        const a = bump(areas, normText(it.area), { name: it.area, days: {}, ms: 0, rows: 0, last: 0, lastDay: '' });
        a.name = it.area;   // rows run oldest to newest, so the newest spelling is the one shown
        a.days[it.day] = true; a.ms += it.ms; a.rows++; a.last = Math.max(a.last, it.start); if (it.day > a.lastDay) a.lastDay = it.day;
        const supKey = normText(it.sup), leadKey = normText(it.lead);
        const held = !leadKey || leadKey === supKey;       // a room the supervisor holds has no lead of its own
        const own = !held && isSelf(it.lead);              // the person IS the lead: this is their own team
        const t = bump(teams, held ? 'sup:' + supKey : own ? 'own:' + supKey : 'lead:' + leadKey, { lead: held || own ? '' : it.lead, held, own, sups: {}, days: {}, ms: 0, rows: 0, last: 0 });
        if (!held && !own) t.lead = it.lead;
        t.days[it.day] = true; t.ms += it.ms; t.rows++; t.last = Math.max(t.last, it.start);
        if (supKey) { const s = bump(t.sups, supKey, { name: it.sup, n: 0 }); s.n++; }
        if (supKey) { const s2 = bump(sups, supKey, { name: it.sup, days: {}, ms: 0 }); s2.days[it.day] = true; s2.ms += it.ms; }
    });
    const count = (o) => Object.keys(o).length;
    const byTime = (x, y) => y.ms - x.ms || y.times - x.times || String(x.name || x.label).localeCompare(String(y.name || y.label));     // areas: the most hours first
    const byTimes = (x, y) => y.times - x.times || y.ms - x.ms || String(x.name || x.label).localeCompare(String(y.name || y.label));   // teams: the most shifts first
    const areaList = Object.keys(areas).map(k => { const a = areas[k]; return { name: a.name, times: count(a.days), hours: a.ms / 3600000, ms: a.ms, share: totalMs ? a.ms / totalMs : 0, rows: a.rows, last: a.last, lastDay: a.lastDay }; }).sort(byTime);
    const topSupOf = (t) => { const ks = Object.keys(t.sups).map(k => t.sups[k]).sort((x, y) => y.n - x.n || x.name.localeCompare(y.name)); return ks.length ? ks[0].name : ''; };
    const teamList = Object.keys(teams).map(k => {
        const t = teams[k], supName = topSupOf(t);
        const leadName = (t.held || t.own) ? '' : formatFullName(t.lead);
        const label = t.held ? (supName ? `${formatFullName(supName)} (supervisor)` : 'No lead or supervisor named') : t.own ? 'Leads their own team' : leadName;
        return { label, name: label, lead: leadName, held: t.held, own: t.own, supName: supName ? formatFullName(supName) : '', times: count(t.days), hours: t.ms / 3600000, ms: t.ms, share: totalMs ? t.ms / totalMs : 0, rows: t.rows, last: t.last };
    }).sort(byTimes);
    const supList = Object.keys(sups).map(k => { const s = sups[k]; return { name: formatFullName(s.name), times: count(s.days), ms: s.ms, hours: s.ms / 3600000 }; }).sort(byTimes);
    const strongest = areaList.filter(a => a.times >= EMP_MIN_SHIFTS_FOR_STRONGEST && a.ms > 0)[0] || null;
    const attendance = { sick: count(away.sick || {}), pto: count(away.pto || {}), late: count(away.late || {}), leftEarly: count(away['left early'] || {}), ncns: count(away.ncns || {}) };
    const dayKeys = Object.keys(days).sort();
    return {
        hasRows: listed.length > 0,
        daysWorked: dayKeys.length, hours: totalMs / 3600000, totalMs,
        timesAssigned: areaList.reduce((n, a) => n + a.times, 0),
        areas: areaList, teams: teamList, sups: supList,
        topTeam: teamList[0] || null, topSup: supList[0] || null, strongest,
        attendance, firstDay: dayKeys[0] || '', lastDay: dayKeys[dayKeys.length - 1] || '',
        assignments: listed.slice().sort((a, b) => b.start - a.start),
        notes
    };
}

// ----------------------------------------------------------------------------
// THE ROOM / AREA QUERY: who has spent the most time in one room or area. The same assignment rows as the employee query, but all the
// people of one area (and only that area) are read, in small pieces of days, never the whole table.
// ----------------------------------------------------------------------------
// Every word typed has to appear in the area name.
function empAreaTextFilter(text) {
    return empWords(text).map(w => `contains(craa5_area,'${odataStr(w)}')`).join(' and ');
}
// One room / area and one piece of the range. A picked name lists every spelling seen (a trailing space is a different text);
// "contains" takes every area with the typed words in its name.
function empAreaFilter(pick, f, t) {
    const who = pick.mode === 'contains'
        ? empAreaTextFilter(pick.text)
        : (pick.variants && pick.variants.length ? pick.variants : [pick.text]).map(v => `craa5_area eq '${odataStr(v)}'`).join(' or ');
    return `(${who}) and ${empWhenClause(f, t)}`;
}
// The distinct area names found in a sample of rows (busiest first). PTO, Sick and the other absence words are not areas, and the
// progress rows the equipment screens write (an equipment name and no employee) are not assignments.
function empAreaNames(rows) {
    const by = {};
    rows.forEach(r => {
        const raw = String(r.craa5_area || ''), name = raw.trim(), key = normText(name);
        if (!key || OUT_AREA_NAMES.indexOf(key) > -1) return;
        if (String(r.craa5_equip || r.craa5_equipment || '').trim() && !cleanGuid(r.craa5__aaemp_guid)) return;
        const e = by[key] || (by[key] = { n: 0, spell: {}, raws: {} });
        e.n++; e.spell[name] = (e.spell[name] || 0) + 1; e.raws[raw.toLowerCase()] = true;
    });
    return Object.keys(by).map(k => {
        const e = by[k], names = Object.keys(e.spell).sort((a, b) => e.spell[b] - e.spell[a] || a.localeCompare(b));
        return { name: names[0], n: e.n, variants: Object.keys(e.raws).slice(0, 6) };
    }).sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
}
// One person per employee id (rows saved with a name but no id join the one person of that name who has an id). Each person's hours,
// shifts and days come from buildEmployeeProfile, so they follow exactly the same rules as the employee query. Hours are worked out
// from the rows of this area alone: Shift Start stamps an end time on the row of someone who is MOVED, so the rows still
// have their end; a row with no end ran to the end of that shift.
// opts: { first, last } the days asked for.
function buildAreaRanking(rows, nowMs, opts) {
    opts = opts || {};
    const notes = { rows: rows.length, hubRows: 0, away: 0, nobody: 0, noEnd: 0, capped: 0, toShiftEnd: 0, slips: 0 };
    const groups = {}, order = [];
    rows.forEach(r => {
        const guid = cleanGuid(r.craa5__aaemp_guid), nm = String(r.craa5_id || '').trim();
        if (String(r.craa5_equip || r.craa5_equipment || '').trim() && !guid) { notes.hubRows++; return; }
        if (OUT_AREA_NAMES.indexOf(normText(r.craa5_area)) > -1) { notes.away++; return; }
        const key = guid ? 'g:' + guid : nm ? 'n:' + normText(nm) : '';
        if (!key) { notes.nobody++; return; }
        let g = groups[key];
        if (!g) { g = groups[key] = { key, guid, rows: [], spell: {}, merged: false }; order.push(key); }
        g.rows.push(r);
        if (nm) g.spell[nm] = (g.spell[nm] || 0) + 1;
    });
    order.forEach(k => {
        const g = groups[k];
        if (g.guid) return;
        const mine = [];   // "Amy Able" and "Able, Amy" are the same person
        Object.keys(g.spell).forEach(nm => empNameVariants(nm).forEach(v => { const nk = normText(v); if (nk && mine.indexOf(nk) === -1) mine.push(nk); }));
        const hits = [];
        order.forEach(k2 => { const h = groups[k2]; if (h.guid && hits.indexOf(h) === -1 && Object.keys(h.spell).some(nm => empNameVariants(nm).some(v => mine.indexOf(normText(v)) > -1))) hits.push(h); });
        if (hits.length !== 1) return;
        hits[0].rows = hits[0].rows.concat(g.rows);
        Object.keys(g.spell).forEach(nm => { hits[0].spell[nm] = (hits[0].spell[nm] || 0) + g.spell[nm]; });
        g.merged = true;
    });
    const people = [];
    order.forEach(k => {
        const g = groups[k];
        if (g.merged) return;
        const names = Object.keys(g.spell).sort((a, b) => g.spell[b] - g.spell[a] || a.localeCompare(b));
        const selfNames = []; names.forEach(nm => empNameVariants(nm).forEach(v => { if (selfNames.indexOf(v) === -1) selfNames.push(v); }));
        const p = buildEmployeeProfile(g.rows, nowMs, { first: opts.first, last: opts.last, selfNames, slipByEnd: true });
        notes.noEnd += p.notes.noEnd; notes.capped += p.notes.capped; notes.toShiftEnd += p.notes.toShiftEnd; notes.slips += p.notes.slips;
        if (!p.daysWorked) return;
        const name = names[0] || '';
        people.push({
            key: k, guid: g.guid, name, label: formatFullName(name) || name || '(no name on the row)', dupName: false,
            ms: p.totalMs, hours: p.hours, shifts: p.daysWorked, firstDay: p.firstDay, lastDay: p.lastDay,
            team: p.topTeam ? p.topTeam.label : '', teamSup: p.topTeam && !p.topTeam.held ? p.topTeam.supName : ''
        });
    });
    const seen = {};
    people.forEach(x => { const nk = normText(x.label); (seen[nk] = seen[nk] || []).push(x); });
    Object.keys(seen).forEach(nk => { if (seen[nk].length > 1) seen[nk].forEach(x => { x.dupName = true; }); });
    return { people: sortAreaPeople(people, 'hours'), totalPeople: people.length, totalMs: people.reduce((n, x) => n + x.ms, 0), notes };
}
// 'hours' (the default: who has spent the most time there), 'shifts' (most separate shifts), 'recent' (been there most recently).
function sortAreaPeople(list, mode) {
    const byName = (a, b) => a.label.localeCompare(b.label) || String(a.key).localeCompare(String(b.key));
    const cmp = mode === 'shifts' ? (a, b) => b.shifts - a.shifts || b.ms - a.ms || b.lastDay.localeCompare(a.lastDay) || byName(a, b)
        : mode === 'recent' ? (a, b) => b.lastDay.localeCompare(a.lastDay) || b.ms - a.ms || b.shifts - a.shifts || byName(a, b)
        : (a, b) => b.ms - a.ms || b.shifts - a.shifts || b.lastDay.localeCompare(a.lastDay) || byName(a, b);
    return list.slice().sort(cmp);
}
// A blank Shift on the employee record means the person has left (a column that was not read is not blank).
function empHasLeft(r) {
    const info = readEmployeeShiftInfo(r);
    return info.blank && (r.craa5_shift === null || r.craa5_shift === '' || r.craa5_Shift === null || r.craa5_Shift === '');
}
// The employee-list lookup for a few people at a time (this asks for those people only). A person whose rows carry an employee id is
// asked for by that id, so a renamed or re-spelled employee is still found; byId false asks for everyone by name instead (a way of
// asking that works even when the id column does not take a plain id).
function empStatusFilter(people, byId) {
    const names = [], ids = [];
    people.forEach(x => {
        if (byId && x.guid) { if (ids.indexOf(x.guid) === -1) ids.push(x.guid); return; }
        empNameVariants(x.name).forEach(n => { if (n && names.indexOf(n) === -1) names.push(n); });
    });
    return ids.map(g => `craa5__aa_employeeid eq ${g}`).concat(names.map(n => `craa5_name eq '${odataStr(n)}'`)).join(' or ');
}
// { personKey: { known, crew, role, left } } from the employee rows found.
function empStatusOf(people, empRows, idOnly) {
    const byGuid = {}, byName = {};
    (empRows || []).forEach(r => {
        const id = cleanGuid(r.craa5__aa_employeeid || r.craa5_aa_employeeid);
        if (id) byGuid[id] = r;
        const nk = normText(r.craa5_name);
        if (nk) (byName[nk] = byName[nk] || []).push(r);
    });
    const out = {};
    people.forEach(x => {
        let rec = x.guid ? byGuid[x.guid] : null;
        if (!rec && !(idOnly && x.guid)) {   // by name; a record with another employee's id is somebody else with the same name
            const vs = empNameVariants(x.name).map(normText);
            const mine = (r) => !x.guid || !cleanGuid(r.craa5__aa_employeeid || r.craa5_aa_employeeid) || cleanGuid(r.craa5__aa_employeeid || r.craa5_aa_employeeid) === x.guid;
            for (let i = 0; i < vs.length && !rec; i++) { const l = (byName[vs[i]] || []).filter(mine); if (l.length) rec = l.filter(r => readEmployeeShiftInfo(r).crew)[0] || l[0]; }
        }
        if (!rec) { out[x.key] = { known: false, crew: '', role: '', left: false }; return; }
        out[x.key] = { known: true, crew: readEmployeeShiftInfo(rec).crew, role: EMP_ROLE_NAMES[rec.craa5_role] || '', left: empHasLeft(rec) };
    });
    return out;
}

// Keeps Tab inside a dialog: from the last control it goes to the first, and Shift+Tab the other way.
function trapTabKey(e) {
    if (e.key !== 'Tab') return;
    const els = Array.prototype.slice.call(e.currentTarget.querySelectorAll('button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    if (!els.length) return;
    const first = els[0], last = els[els.length - 1];
    const active = document.activeElement;   // the panel itself holds focus after a click on its title
    if (e.shiftKey && (active === first || active === e.currentTarget)) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
}

