// starts on the Sunday on or before the target date, like the month calendars; one or three days start on the date itself.
function weekWindow(ymd, span) {
    const now = new Date();
    const d0 = parseYMD(ymd) || new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const start = span >= 7 ? addDaysLocal(d0, -d0.getDay()) : d0;
