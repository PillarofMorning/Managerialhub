            var sp = mhCallSplitNameBody(k.rest, known);
            startMsg(sp.name || (sp.body ? '' : lastAuthor), k.time, 1, L[x].t, 'bracket', false);
            if (sp.body) cur.parts.push(sp.body);
            continue;
        }
        if (k.kind === 'time') { startMsg(k.unknownAuthor ? '' : lastAuthor, k.time, 1, L[x].t, 'time', true); continue; }
        if (cur) cur.parts.push(L[x].t); else orphan.push(L[x].t);
    }
    if (cur) msgs.push(cur);

    var out = [];
    if (!anyHeader) {
        // plain lines: one message per line, "Name: text" lines keep their name
        var colon = 0;
        for (var y = 0; y < orphan.length; y++) {
            var mc = MH_CALL_NAME_COLON_RE.exec(orphan[y]);
            var nc = mc ? mhCallNameInfo(mc[1], true) : null;
            if (mc && nc && nc.ok && nc.tokens >= 2) { out.push({ author: nc.name, timeText: '', text: mhCallSquash(mc[2]) }); colon++; addName(nc.name); }
            else out.push({ author: '', timeText: '', text: orphan[y] });
        }
        res.format = out.length ? (colon ? 'name-colon' : 'plain') : 'empty';
    } else {
        if (orphan.length) out.push({ author: '', timeText: '', text: orphan.join(' ') }); // tail of a message cut off at the top
        var prevOut = out.length ? out[out.length - 1] : null;
        for (var z = 0; z < msgs.length; z++) {
            var mm = msgs[z];
            var body = mhCallSquash(mm.parts.join(' '));
            if (!body && mm.post) {
                // the message was only a status post: its name and time lines go with it
                mm.post.lines += mm.headerLines;
                res.statusLines += mm.headerLines;
                if (mm.author) addName(mm.author);
                prevOut = null;
                continue;
            }
            if (!body) {
                // a time on its own line with nothing under it is the end of the message before ("I can be there by" / "7:30 AM")
                if (mm.bare && prevOut) { prevOut.text = mhCallSquash(prevOut.text + ' ' + mm.headerText); continue; }
                noteSkipped(mm.headerText, 'unread', mm.headerLines);
                if (mm.author) addName(mm.author);
                prevOut = null;
                continue;
            }
            used[mm.kind] = (used[mm.kind] || 0) + 1;
            prevOut = { author: mm.author, timeText: mm.timeText, text: body };
            out.push(prevOut);
            if (mm.author) addName(mm.author);
        }
        var named = [];
        var names = ['desktop', 'bracket', 'name-time', 'name-comma-time'];
        for (var w = 0; w < names.length; w++) if (used[names[w]]) named.push(names[w]);
        if (named.length > 1) res.format = 'mixed';
        else if (named.length === 1) res.format = named[0];
        else if (used['time']) res.format = 'time-only';
        else res.format = out.length ? 'plain' : 'empty';
    }
    res.messages = out;
    res.skippedLines = res.noiseLines + res.unreadLines + res.statusLines;
    return res;
}

// ---- reasons ----
// mhCallReason returns a key of MH_CALL_REASONS. Order matters. The status words people type (NCNS, PTO) win, then leaving early, then
// clear "I will be late" phrases, then causes (sick...), then other days off, then the
// generic call-out phrases, then traffic and a bare "late".
//   "calling out sick" is sick, "not feeling well, leaving early" is left early,
//   "doctor appointment, be there at 10" is late, "PTO this morning, be in at 12" is pto,
//   "sorry for the late notice, I won't be in" is absent, "not sick, just late" is late.
var MH_CALL_REASON_STRIP = [
    /\b(not|no longer|isnt|arent|wasnt|never) (sick|ill)\b/g,
    /\blate (notice|message|msg|reply|response|text|heads up|headsup|warning|post|request)\b/g,
    /\b(this is|this was|thats|that is) (so |a bit |kinda |really )?late\b/g,
    /\bback from (my |the )?(pto|vacation|holiday|leave)\b/g
];
// "ill" counts as sick only where it reads as being ill ("I am ill", "ill today", "feeling ill", "ill.")
// so "Ill be there at 7" (I'll typed without the apostrophe) is not sick.
var MH_CALL_ILL_SICK_RE = /\b(am|im|i m|feel|feeling|feels|felt|been|is|was|fell|got|getting|get|really|very|so|too|super|pretty|quite|kinda|bit|little|still|now|also|seriously|terribly|extremely|violently) ill\b|\bill (today|tonight|this|with|and|again|since|all|still|too|at|in|right|now|af|but|so)\b|\bill \.|\bill $/;
var MH_CALL_REASON_RULES = [
    { reason: 'ncns', re: /\bncns\b|\bno call( and)? no show\b|\bnocall noshow\b|\bno call\b/ },
    { reason: 'pto', re: /\bpto\b|\bpersonal day\b/ },
    { reason: 'left early', re: /\b(leave|leaving|left|go|going|gone|went|head|heading|headed|clock|clocking|clocked)( out| home| off)? early\b|\bgo home early\b/ },
    { reason: 'late', re: /\b(running|be|been|being|im|am|is|was|will|gonna|little|bit|tad|minutes|minute|mins|min|hour|hours|hr|hrs) late\b|\brunning behind\b|\bbe (there|in) (at|by|around|about)\b(?! all\b)|\bfew (minutes|mins|min)\b|\bon my way\b|\bomw\b|\b(make it|be there|be in|get there|get in) on time\b|\bmake it (in )?(by|around)\b/ },
    { reason: 'sick', ill: true, re: /\b(sick|sickness|unwell|fever|feverish|flu|covid|doctor|doctors|hospital|hospitalized|migraine|vomit|vomiting|vomited|puking|puked|diarrhea|nausea|nauseous|strep|dentist|surgery|clinic|injured|injury)\b|\bnot feeling\b|\bdont feel (well|good|great|ok|okay|right)\b|\bfeel(s)? (sick|unwell|nauseous|feverish)\b|\bfeeling (sick|unwell|nauseous|feverish|bad|awful|terrible|horrible|rough|crappy|lousy)\b|\b(throwing|threw|throw) up\b|\burgent care\b|\bemergency room\b|\b(the|in|at|to) er\b|\bfood poisoning\b|\bstomach (bug|flu|ache|virus|pain)\b|\b(dr|drs) (appt|appointment|visit|office)\b/ },
    { reason: 'pto', re: /\bvacation\b|\bholiday\b|\bdays? off\b|\btime off\b/ },
    { reason: 'absent', re: /\bcall(ing|ed|s)? (out|off|in)\b|\b(wont|will not|cant|cannot|can not|not going to|not gonna|unable to|not able to|wouldnt|couldnt) (be in|be at work|be coming|be there|come in|come to work|make it|be able to|work|be at)\b|\bnot coming\b|\bnot be in\b|\b(stay|staying) home\b|\bbe out\b|\bout today\b|\bemergency\b|\babsent\b/ },
    { reason: 'late', re: /\btraffic\b|\blate\b/ }
];

function mhCallReason(text) {
    var s = mhCallToAscii(text).toLowerCase().replace(/`/g, "'");
    s = s.replace(/\bi ?' ?ll\b/g, 'i will').replace(/'/g, '');
    var t = ' ' + s.replace(/[^a-z0-9:]+/g, ' ').trim() + ' ';
    if (!t.trim()) return 'other';
    var tp = ' ' + s.replace(/[.,!?;]+/g, ' . ').replace(/[^a-z0-9:.]+/g, ' ').replace(/\s+/g, ' ').trim() + ' ';
    for (var j = 0; j < MH_CALL_REASON_STRIP.length; j++) { t = t.replace(MH_CALL_REASON_STRIP[j], ' '); tp = tp.replace(MH_CALL_REASON_STRIP[j], ' '); }
    for (var i = 0; i < MH_CALL_REASON_RULES.length; i++) {
        var rule = MH_CALL_REASON_RULES[i];
        if (rule.re.test(t) || (rule.ill && MH_CALL_ILL_SICK_RE.test(tp))) return rule.reason;
    }
    return 'other';
}

// ---- words ----
function mhCallIsMedicalWord(w) {
    var k = mhCallWordKey(w);
    if (!k || k.length < 2) return false;
    if (mhCallHas(MH_CALL_MEDICAL_DICT, k)) return true;
    if (k.length > 3 && k.charAt(k.length - 1) === 's' && mhCallHas(MH_CALL_MEDICAL_DICT, k.slice(0, -1))) return true;
    if (k.length > 4 && k.slice(-2) === 'es' && mhCallHas(MH_CALL_MEDICAL_DICT, k.slice(0, -2))) return true;
    if (k.length > 4 && k.slice(-3) === 'ies' && mhCallHas(MH_CALL_MEDICAL_DICT, k.slice(0, -3) + 'y')) return true;
    for (var i = 0; i < MH_CALL_MEDICAL_PREFIXES.length; i++) if (k.indexOf(MH_CALL_MEDICAL_PREFIXES[i]) === 0) return true;
    if (/^ach(e|es|ed|ing|y)$/.test(k)) return true;
    if (k.length > 5 && /aches?$/.test(k) && !/stache/.test(k)) return true; // headache, stomachache, backache
    if (k.length > 5 && /(itis|osis|ectom(y|ies)|otom(y|ies)|oscop(y|ies)|emia|algia|pathy|plast(y|ies))$/.test(k)) return true;   // conditions and operations
    return false;
}

// Words of a message with what is needed to spot names: capital letter, start of a sentence, comma after.
function mhCallWordTokens(text) {
    var s = mhCallToAscii(text).replace(/`/g, "'").replace(/\b([xX])\s?-\s?(rays?)\b/g, '$1$2');
    var re = /([A-Za-z0-9]+(?:'[A-Za-z0-9]+)*)|([.!?;]+|:(?!\d)|\s-\s|\n)|(,)/g;
    var out = [];
    var boundary = true;
    var m ;
    while ((m = re.exec(s)) !== null) {
        if (m[1]) {
            var raw = m[1];
            var la = raw.toLowerCase();
            out.push({
                raw: raw, la: la, key: la.replace(/'s$/, '').replace(/'/g, ''),
                cap: /^[A-Z]/.test(raw), allCaps: raw.length > 1 && /[A-Z]/.test(raw) && raw === raw.toUpperCase(),
                start: boundary, commaAfter: false
            });
            boundary = false;
        } else if (m[2]) boundary = true;
        else if (m[3] && out.length) out[out.length - 1].commaAfter = true;
    }
    return out;
}

var MH_CALL_GREETINGS = mhCallDict(['hi', 'hey', 'hello', 'morning', 'gm', 'thanks', 'thank', 'thx', 'ty', 'dear', 'yo',
    'afternoon', 'evening', 'hiya', 'howdy', 'cheers', 'bye']);

function mhCallIsVocab(key) {
    return mhCallHas(MH_CALL_STOP_DICT, key) || mhCallHas(MH_CALL_COMMON_DICT, key) || mhCallHas(MH_CALL_NOISE_EXACT, key) ||
        mhCallHas(MH_CALL_GREETINGS, key) || mhCallIsMedicalWord(key);
}

function mhCallAddNameWords(dict, name) {
    var n = mhCallCleanAuthor(name === undefined || name === null ? '' : String(name));
    if (!n || n.indexOf(MH_CALL_UNREADABLE) === 0) return;
    var parts = n.toLowerCase().replace(/'s\b/g, '').replace(/['`]/g, '').split(/[^a-z]+/);
    for (var i = 0; i < parts.length; i++) if (parts[i].length >= 2) dict[parts[i]] = true;
}

// Words in a message that look like a person's name.
function mhCallFindNameWords(toks, names) {
    var mid = 0, midCap = 0;
    for (var a = 0; a < toks.length; a++) {
        var ta = toks[a];
        if (!ta.start && /^[A-Za-z]{2,}$/.test(ta.raw) && !ta.allCaps) { mid++; if (ta.cap) midCap++; }
    }
    var titleCaseWriter = mid >= 3 && midCap * 10 >= mid * 6; // "Running Late Due To Traffic": capitals say nothing
    for (var i = 0; i < toks.length; i++) {
        var t = toks[i];
        if (!/^[a-z]{2,}$/.test(t.key) || mhCallIsVocab(t.key) || mhCallHas(MH_CALL_STOP_FULL, t.la)) continue;
        var prev = i > 0 ? toks[i - 1] : null;
        var prev2 = i > 1 ? toks[i - 2] : null;
        if (prev && (mhCallHas(MH_CALL_GREETINGS, prev.key) || (prev.key === 'you' && prev2 && prev2.key === 'thank'))) { names[t.key] = true; continue; }
        if (titleCaseWriter || !t.cap || t.allCaps) continue;
        if (!t.start || t.commaAfter) { names[t.key] = true; continue; } // "... Delta is covering", "Echo, running late"
        var next = i + 1 < toks.length ? toks[i + 1] : null;
        if (next && !next.start && next.cap && !next.allCaps && /^[a-z]{2,}$/.test(next.key) && !mhCallIsVocab(next.key)) names[t.key] = true; // "Delta Sample is..."
    }
}

// Word counts plus how many medical words were left out.
// opts: maskMedical (default true), excludeAuthors (default true), stopWords (replaces MH_CALL_STOP_WORDS),
//       hideNames (default true: also leave out names found in the text and opts.extraNames).
function mhCallWordStats(messages, opts) {
    var o = opts || {};
    var mask = o.maskMedical !== false;
    var exAuth = o.excludeAuthors !== false;
    var hideNames = o.hideNames !== false;
    var custom = Array.isArray(o.stopWords);
    var stopKeys = custom ? mhCallDict(o.stopWords, mhCallWordKey) : MH_CALL_STOP_DICT;
    var stopFull = custom ? mhCallDict(o.stopWords, mhCallLowerApos) : MH_CALL_STOP_FULL;
    var list = Array.isArray(messages) ? messages : [];
    var nameWords = {};
    if (exAuth) list.forEach(function (m) { mhCallAddNameWords(nameWords, m && m.author); });
    var tokLists = list.map(function (m) { return mhCallWordTokens(m && m.text); });
    if (hideNames) {
        var extra = Array.isArray(o.extraNames) ? o.extraNames : [];
        extra.forEach(function (n) { mhCallAddNameWords(nameWords, n); });
        tokLists.forEach(function (toks) { mhCallFindNameWords(toks, nameWords); });
    }
    var counts = {};
    var order = [];
    var hidden = 0;
    tokLists.forEach(function (toks) {
        toks.forEach(function (t) {
            var w = t.key;
            if (!w || !/^[a-z]+$/.test(w)) return;                                   // numbers and times
            if (t.la.indexOf("'") >= 0 && mhCallHas(stopFull, t.la)) return;          // I'll, won't, can't
            if (mask && mhCallIsMedicalWord(w)) { hidden++; return; }
            if (w.length < 3) return;
            if (mhCallHas(stopKeys, w)) return;
            if (mhCallHas(nameWords, w)) return;
            if (!mhCallHas(counts, w)) { counts[w] = 0; order.push(w); }
            counts[w]++;
        });
    });
    var words = order.map(function (w) { return { word: w, count: counts[w] }; });
    words.sort(function (a, b) { return b.count - a.count || (a.word < b.word ? -1 : a.word > b.word ? 1 : 0); });
    return { words: words, hiddenMedical: hidden };
}

function mhCallWordCounts(messages, opts) {
    return mhCallWordStats(messages, opts).words;
}

// opts: the same as mhCallWordStats (extraNames: names to keep out of the words, such as the signed-in user).
function mhCallSummarize(messages, opts) {
    var list = Array.isArray(messages) ? messages : [];
    var byReason = {}, byReasonPeople = {}, seenPerson = {};
    MH_CALL_REASONS.forEach(function (r) { byReason[r] = 0; byReasonPeople[r] = 0; });
    list.forEach(function (m) {
        var r = mhCallReason(m && m.text), key = mhCallAuthorKey(m && m.author);
        byReason[r] = (byReason[r] || 0) + 1;
        // people per reason: a follow-up by the same person is not a second person; a message with no author counts on its own
        if (key) { if (mhCallHas(seenPerson, r + '|' + key)) return; seenPerson[r + '|' + key] = true; }
        byReasonPeople[r] = (byReasonPeople[r] || 0) + 1;
    });
    var cw = mhCallWordStats(list, opts);
    var top = cw.words.slice(0, 10);
    var index = {};
    var people = [];
    list.forEach(function (m) {
        var key = mhCallAuthorKey(m && m.author);
        if (!mhCallHas(index, key)) { index[key] = people.length; people.push({ author: key ? mhCallCleanAuthor(m.author) : '', count: 0 }); }
        people[index[key]].count++;
    });
    people.sort(function (a, b) { return b.count - a.count || (a.author < b.author ? -1 : a.author > b.author ? 1 : 0); });
    return { total: list.length, byReason: byReason, byReasonPeople: byReasonPeople, topWord: top.length ? top[0] : null, topWords: top, byAuthor: people, hiddenMedical: cw.hiddenMedical };
}
// ---- the tab ----
// The signed-in person's names (the Microsoft sign-in and their own employee row), kept out of the word counts.
function mhCallOwnNames(access) {
    var a = access || {};
    var out = [];
    function add(v) { var t = typeof v === 'string' ? v.trim() : ''; if (t && out.indexOf(t) < 0) out.push(t); }
    if (a.user) add(a.user.fullName);
    add(a.userName);
    if (a.decision && a.decision.employee) add(a.decision.employee.craa5_name);
    return out;
}

// "23 lines from status posts were skipped (1 Shift Start post, 2 Ganttly posts): ..." or '' when none were.
function mhCallStatusSentence(parsed) {
    var n = parsed && parsed.statusLines ? parsed.statusLines : 0;
    if (!n) return '';
    var by = parsed.statusByApp || {};
    var bits = [];
    Object.keys(by).forEach(function (app) { if (by[app]) bits.push(pluralize(by[app], (app || 'other') + ' post')); });
    return pluralize(n, 'line') + ' from status posts ' + (n === 1 ? 'was' : 'were') + ' skipped' + (bits.length ? ' (' + bits.join(', ') + ')' : '') + ': they are updates from other apps, not call-outs.';
}

function mhCallThousands(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

const MhCallShieldIcon = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className} aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg>);

function MhCallReasonPill(props) {
    var st = MH_CALL_REASON_STYLE[props.reason] || MH_CALL_REASON_STYLE.other;
    return <span className={'inline-block px-2 py-0.5 rounded-full border text-[11px] font-extrabold whitespace-nowrap ' + st.pill}>{MH_CALL_REASON_LABELS[props.reason] || props.reason}</span>;
}

// props: { access, notify } from ScheduleApp. props.sample is read at once (tests only; the hub never passes it).
function MhCalloutsTab(props) {
    const sample = props && typeof props.sample === 'string' ? props.sample : '';
    const notify = props && typeof props.notify === 'function' ? props.notify : null;
    const own = mhCallOwnNames(props && props.access);
    const ownKey = own.join('\n');
    const ownAuthors = own.map(mhCallAuthorKey);   // "Alpha Test" and "Test, Alpha" are the same key
    const [text, setText] = useState(sample);
    const [read, setRead] = useState({ text: sample, seq: 0 });   // what was last read (seq goes up on each Read)
    const [filter, setFilter] = useState('');                     // a reason key: only those messages are listed
    const boxRef = useRef(null);
    const summaryRef = useRef(null);
    const cut = read.text.length > MH_CALL_MAX_CHARS;
    const parsed = useMemo(function () { return mhCallParsePaste(read.text.length > MH_CALL_MAX_CHARS ? read.text.slice(0, MH_CALL_MAX_CHARS) : read.text); }, [read.text]);
    const summary = useMemo(function () {
        return mhCallSummarize(parsed.messages, { extraNames: parsed.names.concat(ownKey ? ownKey.split('\n') : []) });
    }, [parsed, ownKey]);
    const rows = useMemo(function () {
        return parsed.messages.map(function (m, i) { return { key: i, author: m.author, timeText: m.timeText, text: m.text, reason: mhCallReason(m.text) }; });
    }, [parsed]);
    // After Read messages the summary takes the focus, so it scrolls into view (and a screen reader reads it out).
    useEffect(function () {
        if (read.seq && summaryRef.current) { try { summaryRef.current.focus(); } catch (e) { /* nothing to do */ } }
    }, [read.seq]);

    const onRead = useCallback(function () {
        if (text.length > MH_CALL_MAX_CHARS && notify) notify('Only the first ' + mhCallThousands(MH_CALL_MAX_CHARS) + ' characters were read. Paste fewer messages at a time.', 'error');
        setRead(function (r) { return { text: text, seq: r.seq + 1 }; });
        setFilter('');
    }, [text, notify]);
    const onClear = useCallback(function () {
        setText(''); setRead({ text: '', seq: 0 }); setFilter('');
        if (boxRef.current) { try { boxRef.current.focus(); } catch (e) { /* nothing to do */ } }
    }, []);

    const hasRead = read.text.trim() !== '';
    const stale = hasRead && text !== read.text;
    const shown = filter ? rows.filter(function (r) { return r.reason === filter; }) : rows;
    const people = summary.byAuthor.filter(function (a) { return a.author; }).length;
    const maxCount = summary.topWords.length ? summary.topWords[0].count : 1;
    const unreadSamples = parsed.skippedSamples.filter(function (s) { return s.kind === 'unread'; });
    const noiseSamples = parsed.skippedSamples.filter(function (s) { return s.kind === 'noise'; });
    const statusSentence = mhCallStatusSentence(parsed);
    const btn = 'px-4 py-2 min-h-[44px] sm:min-h-0 rounded-lg text-sm font-extrabold transition-colors disabled:opacity-50 disabled:cursor-not-allowed';

    return (
        <div data-mh-callouts="tab" className="animate-in fade-in duration-300 flex flex-col gap-4">
            <div>
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Call-outs</h2>
                <p className="text-sm text-slate-500">Paste the Teams messages where people call in sick, late or out. You see who called out and why, and the word said most. Nothing is saved.</p>
            </div>

            {/* SUMMARY: the most repeated word and the count for each reason, on top */}
            {hasRead && (
                <section ref={summaryRef} tabIndex={-1} aria-label="Call-out summary" data-mh-callouts-summary="" className="outline-none bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5">
                    {parsed.messages.length === 0 ? (
                        <p className="text-sm font-bold text-slate-700 text-center py-3">No call-out messages were found in what was pasted.</p>
                    ) : (
                        <div className="grid grid-cols-1 lg:grid-cols-12 gap-4">
                            <div data-mh-callouts-top="" className="lg:col-span-4 rounded-xl p-4 text-white bg-[#0072CE] flex flex-col justify-between">
                                <p className="text-[10px] font-black uppercase tracking-widest opacity-90">Most repeated word</p>
                                {summary.topWord ? (
                                    <div>
                                        <p className="text-4xl sm:text-5xl font-black leading-tight break-words mt-2">{summary.topWord.word}</p>
                                        <p className="text-sm mt-1 opacity-95">said {pluralize(summary.topWord.count, 'time')}</p>
                                    </div>
                                ) : (
                                    <p className="text-lg font-bold mt-2">No words to count.</p>
                                )}
                                <p className="text-xs mt-3 opacity-90">{pluralize(summary.total, 'message')} from {pluralize(people, 'person', 'people')}</p>
                            </div>
                            <div className="lg:col-span-8 flex flex-col gap-3">
                                <div className="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-7 gap-2" role="group" aria-label="People for each reason (press one to list only those messages)">
                                    {MH_CALL_REASONS.map(function (r) {
                                        var st = MH_CALL_REASON_STYLE[r] || MH_CALL_REASON_STYLE.other;
                                        var label = MH_CALL_REASON_LABELS[r] || r;
                                        var n = summary.byReason[r] || 0;
                                        var pc = summary.byReasonPeople ? (summary.byReasonPeople[r] || 0) : n;   // the big number is people, not messages
                                        var active = filter === r;
                                        return (
