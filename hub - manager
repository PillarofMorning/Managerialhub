                    setNotes(function (s) { return Object.assign({}, s, { rows: s.rows.filter(function (x) { return x.id !== note.id; }) }); });
                    mhNotesChanged(subject.guid, me);
                }
            });
        });
    };
    return { confirmId: confirmId, ask: function (id) { if (!busy.busy) setConfirmId(id); }, cancel: function () { setConfirmId(''); }, confirm: confirm };
}
// The save flow both screens use: saving the same text again after a failed or unconfirmed try reuses the same id, so it is never saved twice.
// save(section, kind, fields, onSaved) -> false when nothing was started.
function useMhNoteSaver(dataApi, access, subject, setNotes, me, notifyRef, busy, setSay) {
    var pendingRef = useRef({});
    return function (section, kind, fields, onSaved) {
        if (busy.busy) { setSay(section, 'info', 'Wait for the save that is running.'); return false; }
        if (subject.state !== 'ready') { setSay(section, 'error', 'Cannot tell who this is, so nothing was saved.'); return false; }
        var what = mhNoteKindWord(kind);
        var f0 = fields || {};
        var sig = kind + '|' + JSON.stringify({ text: f0.text, rating: f0.rating, range: f0.snapshot ? f0.snapshot.range : null });   // not the hours: they tick
        var prev = pendingRef.current[section];
        var rec = prev && prev.sig === sig ? prev.rec : mhNoteBuildRecord(Object.assign({}, fields, { kind: kind, guid: subject.guid, by: mhNotesAuthor(access), nonce: mhNotesNonce() }));
        if (rec.error) { setSay(section, 'error', rec.error); return false; }
        pendingRef.current[section] = { sig: sig, rec: rec };
        return busy.run('save:' + section, function () {
            setSay(section, 'info', 'Saving the ' + what + '...');
            return mhNoteCreate(dataApi, rec, function (next) { if (busy.mounted.current) setSay(section, 'info', 'Saving the ' + what + '... (try ' + next + ')'); }).then(function (r) {
                var msg = mhNoteSaveMessage(r, what);
                if (r.ok) pendingRef.current[section] = null;
                // the line under the box says it; the page toast only when this screen closed before the answer came back
                if (!busy.mounted.current) { notifyRef.current(msg, r.ok ? 'success' : 'error'); return; }
                setSay(section, r.ok ? 'success' : 'error', msg);
                if (r.ok) {
                    setNotes(function (s) { return Object.assign({}, s, { rows: mhNotesUpsert(s.rows, r.note) }); });
                    mhNotesChanged(subject.guid, me);
                    if (onSaved) onSaved(r.note);
                }
            });
        });
    };
}
// The per-section "Saving... / Saved / Could not save" lines. Returns [say ({ section: { kind, text } }), setSay(section, kind, text)].
function useMhNotesSay() {
    var [say, setSayState] = useState({});
    var setSay = useCallback(function (section, kind, text) {
        setSayState(function (s) { var o = Object.assign({}, s); o[section] = { kind: kind, text: text }; return o; });
    }, []);
    return [say, setSay];
}
function MhNotesSayLine(props) {
    var s = props.say || null;
    return <p role="status" aria-live="polite" data-mh-say={props.section} className={s ? mhSayCls(s.kind) : 'sr-only'}>{s ? s.text : ''}</p>;
}

// ============================================================================
