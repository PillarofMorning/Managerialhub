function MhProfileDialog(props) {
    var t = props.target || {};
    var allowed = !!(props.access && props.access.decision && props.access.decision.allowed);
    const closeRef = useRef(null);
    const onCloseRef = useRef(props.onClose); onCloseRef.current = props.onClose;
    // Escape closes it (not from a box with typed text in it); it takes the focus when it opens and gives it back (the Personnel Gantt's way).
    useEffect(() => {
        const back = document.activeElement;
        const timer = setTimeout(() => { if (closeRef.current) closeRef.current.focus(); }, 0);
        const onKey = (e) => {
            if (e.key !== 'Escape' || !onCloseRef.current) return;
            const el = e.target;
            if (el && el.tagName === 'TEXTAREA' && String(el.value || '').trim()) return;   // typed text stays: Close still closes
            onCloseRef.current();
        };
        document.addEventListener('keydown', onKey);
        return () => {
            clearTimeout(timer); document.removeEventListener('keydown', onKey);
            if (back && back.focus && back !== document.body && document.body.contains(back)) back.focus();
