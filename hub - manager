    if (comma && (sizes[0] > 3 || sizes[1] > 4)) return body;
    if (!comma && tokens.length > 5) return body;
    var real = 0, weak = 0, upper = 0, lower = 0;
    for (var i = 0; i < tokens.length; i++) {
        var tok = tokens[i];
        var low = tok.toLowerCase().replace(/[.'\-]/g, '');
        var isUp = /^[A-Z]/.test(tok);
        if (/^[A-Za-z]\.?$/.test(tok)) {
            // "I" and "a" are words, not initials, at the start of a line or when typed in lowercase
            if ((low === 'i' || low === 'a') && ((!comma && i === 0) || !isUp)) { real++; weak++; if (isUp) upper++; else lower++; }
            continue;
        }
        if (mhCallHas(MH_CALL_NAME_PARTICLES, low)) continue;
        real++;
        if (isUp) upper++; else lower++;
        if (mhCallIsWeakWord(low) || mhCallIsWeakWord(mhCallWordKey(tok))) weak++;
    }
    if (real < 1) return body;
    var strong = real - weak;
    var title = lower === 0;
    var allLower = upper === 0;
    if (!title && !allLower) return body; // sentence case ("Flat tire", "Bus broke down") is message text
    var ok = false;
    if (comma) ok = (title && strong >= 1) || (allLower && weak === 0);
    else ok = (title && real >= 2 && strong >= 1 && weak <= strong) || (allLower && real >= 2 && weak === 0);
    if (ok) return { verdict: 'name', name: t, tokens: tokens.length };
    if (strong * 2 > real) return { verdict: 'unclear', name: t, tokens: tokens.length };
    return body;
}

// strict (default): the strict test only. strict === false: the relaxed test used for header lines.
function mhCallLooksLikeName(s, strict) {
    return strict === false ? mhCallHeaderVerdict(s).verdict === 'name' : mhCallNameInfo(s, true).ok;
}

// "Test, Alpha" and "Alpha Test" are the same person.
function mhCallAuthorKey(name) {
    var t = mhCallCleanAuthor(name || '').toLowerCase();
    var ci = t.indexOf(',');
    if (ci > 0) t = t.slice(ci + 1) + ' ' + t.slice(0, ci);
    return mhCallSquash(t.replace(/[^a-z0-9' \-]/g, ' '));
}

function mhCallIsInitial(tok) { return /^[A-Za-z]\.?$/.test(tok || ''); }

// "Test, Alpha" then the message. An initial after the first name needs a period ("Alpha J.")
// unless it is the last word; "I" and "A" are never taken as initials without a period.
var MH_CALL_LAST_FIRST_RE = /^([A-Za-z][A-Za-z'\-]*(?: [A-Za-z][A-Za-z'\-]*)?, ?[A-Za-z][A-Za-z'\-]*(?: (?:[B-HJ-Zb-hj-z]\.?|[A-Za-z]\.)(?= |$))?)(?: (.*))?$/;

// Splits "Test, Alpha running late" or "Alpha Test: running late" into a name and the message.
function mhCallSplitNameBody(rest, known) {
    var r = mhCallSquash(rest);
    if (!r) return { name: '', body: '' };
    var low = r.toLowerCase();
    for (var i = 0; i < known.length; i++) {
        var k = known[i];
        if (k && low.indexOf(k) === 0 && (r.length === k.length || /[\s:,\-]/.test(r.charAt(k.length)))) {
            return { name: mhCallCleanAuthor(r.slice(0, k.length)), body: mhCallSquash(r.slice(k.length).replace(/^[\s:,\-]+/, '')) };
        }
    }
    var ci = r.indexOf(':');
    if (ci > 0) {
        var hc = mhCallHeaderVerdict(r.slice(0, ci));
        if (hc.verdict === 'name') return { name: hc.name, body: mhCallSquash(r.slice(ci + 1)) };
    }
    var whole = mhCallHeaderVerdict(r);
    if (whole.verdict === 'name') return { name: whole.name, body: '' };
    var m = MH_CALL_LAST_FIRST_RE.exec(r);
    if (m && m[2]) {
        var hl = mhCallHeaderVerdict(m[1]);
        if (hl.verdict === 'name') return { name: hl.name, body: mhCallSquash(m[2]) };
    }
    var toks = r.split(' ');
    for (var n = 3; n >= 2; n--) {
        if (toks.length <= n) continue;
        if (n === 3 && !mhCallIsInitial(toks[1])) continue;
        var cand = toks.slice(0, n).join(' ');
        if (mhCallNameInfo(cand, true).ok) return { name: mhCallCleanAuthor(cand), body: toks.slice(n).join(' ') };
    }
    return { name: '', body: r };
}

// Names that appear in Teams labels ("Seen by ...", "Begin Reference, ... by Name") so they can be kept out of the word summary.
function mhCallNamesFromNoise(line, add) {
    var m = /^(?:seen|read|liked|reacted)(?: to)? by (.+)$/i.exec(line);
    if (m) {
        var parts = m[1].replace(/\s+and \d+ others?\b.*$/i, '').split(/,|\band\b/i);
        for (var i = 0; i < parts.length; i++) {
            var p = mhCallSquash(parts[i]);
            if (p && p.length <= 40 && !/[0-9]/.test(p)) add(p);
        }
        return;
    }
    if (/^begin reference\b/i.test(line)) {
        var at = line.toLowerCase().lastIndexOf(' by ');
        if (at >= 0) {
            var hv = mhCallHeaderVerdict(line.slice(at + 4).replace(MH_CALL_TRAILING_STAMP_RE, ''));
            if (hv.verdict === 'name') add(hv.name);
        }
    }
}

// ---- status posts made by other apps: full of SICK, PTO and LATE, but not call-outs ----
// Shift Start's update ("hub - shift start", the copy button; its own chat skips these lines with CHAT_SKIP_LINE):
//   Shift Progress Update / Headcount: 12 / Off-Shift Employees Assigned: 1 / Attendance: SICK (2), PTO (1) /
//   --- Time & Attendance --- / (pin) Sick (2): AB [1h 5m] / --- Production Areas --- / (pin) Line 3 (4) - ... / Personnel: AB [45m]
// Ganttly's "Copy for Teams" overview ("supp - ganttly", the startup board): "Ganttly overview - Fri 10/17 6:45 AM ..." (the
//   newer Ganttly says "Ganttly startup board"), "LATE: Line 3 will miss ...", "3 of 4 lines on track - 1 late",
//   "- Line 3: LATE - startup 7:00 AM - ... - 40% done", "- Support (5 areas): 60% done", "This shift:", "Progress from Start/Done ...".
// kind start: the first line of a post. line: only ever part of a post, so it is skipped even on its own (it then opens a post).
// body: part of a post once one is open. A post ends at the next message header or at the first line that is none of these,
// so a call-out typed under a pasted update is still read.
var MH_CALL_GANTTLY_WORDS = '(?:READY|ON TRACK|AT RISK|LATE|DONE LATE|RUNNING|NO STARTUP|NOTHING PLANNED)';
var MH_CALL_STATUS_RULES = [
    { kind: 'start', app: 'Shift Start', re: /^shift progress update\b/i },
    { kind: 'start', app: 'Ganttly', re: /^ganttly (?:overview|startup board)\b/i },
    { kind: 'line', app: 'Shift Start', re: /^headcount\s*:/i },
    { kind: 'line', app: 'Shift Start', re: /^off-?shift employees/i },
    { kind: 'line', app: 'Shift Start', re: /^attendance\s*:/i },
    { kind: 'line', app: 'Shift Start', re: /^-{2,}.*-{2,}$/ },
    { kind: 'line', app: 'Shift Start', re: /^(?:production areas|supporting tasks|time & attendance|everyday tasks)$/i },
    { kind: 'line', app: 'Shift Start', re: /^personnel\s*:/i },
    { kind: 'line', app: 'Ganttly', re: /^progress from start\/done\b/i },
    { kind: 'line', app: 'Ganttly', re: new RegExp('^(?:[-*!] )?[^:]{1,60}: ' + MH_CALL_GANTTLY_WORDS + '\\b.*\\b\\d{1,3}% done\\b') },
    { kind: 'body', app: 'Ganttly', re: new RegExp('^' + MH_CALL_GANTTLY_WORDS + '(?: TIMES)?(?: \\(unconfirmed\\))?:') },
    { kind: 'body', app: 'Ganttly', re: /^\d+ of \d+ lines? on track\b/i },
    { kind: 'body', app: 'Ganttly', re: /^\d+ (?:at risk|late|finished late|still running|without a startup time)\b/i },
    { kind: 'body', app: 'Ganttly', re: /^this shift:?$/i },
    { kind: 'body', app: 'Ganttly', re: new RegExp('^(?:[-*!] )?[^:]{1,60}: ' + MH_CALL_GANTTLY_WORDS + '\\b') },
    { kind: 'body', app: 'Ganttly', re: /^(?:[-*!] )?support \(\d+ areas?\)/i },
    { kind: 'body', app: '', re: /^[-*!] / },
    { kind: 'body', app: 'Shift Start', re: /^.{1,80} \(\d+\)(?:$|[\s:\-])/ }
];
var MH_CALL_BULLETS = [8226, 8227, 8259, 9679, 9702, 9642, 9643, 183];

// The first visible mark of a raw line: Shift Start starts its area lines with a pin emoji, a Teams list item copies as a bullet.
function mhCallLeadMark(raw) {
    var s = String(raw || '');
    for (var i = 0; i < s.length; i++) {
        var c = s.charCodeAt(i);
        if (c <= 32 || c === 160 || (c >= 8192 && c <= 8207) || c === 65279) continue;
        if (c === 55357 && s.charCodeAt(i + 1) === 56525) return 'pin';
        return MH_CALL_BULLETS.indexOf(c) >= 0 ? 'bullet' : '';
    }
    return '';
}

// The status rule a cleaned line matches ({ kind, app }), or null.
function mhCallStatusOf(t, raw) {
    var lead = mhCallLeadMark(raw);
    if (lead === 'pin' && /\(\d+\)/.test(t)) return { kind: 'line', app: 'Shift Start' };
    for (var i = 0; i < MH_CALL_STATUS_RULES.length; i++) if (MH_CALL_STATUS_RULES[i].re.test(t)) return MH_CALL_STATUS_RULES[i];
    return lead === 'bullet' ? { kind: 'body', app: '' } : null;
}

var MH_CALL_FORMAT_LABELS = {
    'desktop': 'Teams copy - name line, then time line',
    'bracket': 'Time in square brackets, then name',
    'name-time': 'Name and time on one line',
    'name-comma-time': 'Name, a comma, then time',
    'name-colon': 'Name, a colon, then the message',
    'time-only': 'Times only, no names',
    'plain': 'Plain lines, no names or times',
    'mixed': 'A mix of formats',
    'empty': 'Nothing to read'
};

// mhCallParsePaste: tolerant reader for text copied out of a Teams chat.
// Returns { messages: [{author, timeText, text}], skippedLines, format } plus
//   noiseLines     Teams labels removed on purpose (Like, Reply, Edited, date dividers, emoji-only lines)
//   unreadLines    lines that may hold a lost message (a name and time with nothing under it,
//                  text in another alphabet)
//   skippedSamples [{text, count, kind: 'noise' | 'unread'}], first 20 distinct left-out lines
//   statusLines    lines of status posts from other apps, skipped (with the header of a message that was only a post)
//   statusPosts    [{app: 'Shift Start' | 'Ganttly', text (its first line), lines}], the first 20 posts
//   statusByApp    how many posts each app made ({ 'Shift Start': 1, 'Ganttly': 2 })
//   names          every display name seen in the paste (authors, "Seen by" lists, unclear name lines)
// skippedLines = noiseLines + unreadLines + statusLines.
function mhCallParsePaste(text) {
    var res = { messages: [], skippedLines: 0, format: 'empty', noiseLines: 0, unreadLines: 0, statusLines: 0, skippedSamples: [], statusPosts: [], statusByApp: {}, names: [] };
    if (text === undefined || text === null) return res;
    var rawLines = String(text).split(/\r\n|\r|\n/);
    var sampleIndex = {};
    function noteSkipped(t, kind, n) {
        if (kind === 'noise') res.noiseLines += n; else res.unreadLines += n;
        var label = t ? (t.length > 80 ? t.slice(0, 77) + '...' : t) : '(only emoji or symbols)';
        var key = kind + ':' + label;
        if (mhCallHas(sampleIndex, key)) { res.skippedSamples[sampleIndex[key]].count++; return; }
        if (res.skippedSamples.length >= 20) return;
        sampleIndex[key] = res.skippedSamples.length;
        res.skippedSamples.push({ text: label, count: 1, kind: kind });
    }
    var nameSeen = {};
    function addName(n) {
        var c = mhCallCleanAuthor(n);
        if (!c || !/[A-Za-z]/.test(c) || c.indexOf(MH_CALL_UNREADABLE) === 0) return;
        var k = c.toLowerCase();
        if (mhCallHas(nameSeen, k)) return;
        nameSeen[k] = true;
        res.names.push(c);
    }
    var placeholders = {};
    var placeholderCount = 0;
    function placeholderFor(raw) {
        var k = 'r' + String(raw || '').replace(/\s+/g, '');
        if (!mhCallHas(placeholders, k)) { placeholderCount++; placeholders[k] = MH_CALL_UNREADABLE + (placeholderCount > 1 ? ' ' + placeholderCount : ''); }
        return placeholders[k];
    }

    // 1. clean every line, drop blanks and Teams labels; keep date-only lines for now
    var L = [];
    for (var i = 0; i < rawLines.length; i++) {
        var rawLine = rawLines[i];
        var pieces = mhCallToAscii(rawLine).split('\n'); // Unicode line separators become extra lines
        for (var pi = 0; pi < pieces.length; pi++) {
            var c = mhCallCleanLine(pieces[pi]);
            if (!c) {
                if (pieces.length === 1 && mhCallHasVisible(rawLine)) {
                    if (mhCallHasForeign(rawLine)) L.push({ t: '', foreign: true, raw: rawLine });
                    else noteSkipped(mhCallSquash(pieces[pi]), 'noise', 1);
                }
                continue;
            }
            var nk = mhCallNoiseKind(c, rawLine);
            if (nk === 'noise') { noteSkipped(c, 'noise', 1); mhCallNamesFromNoise(c, addName); continue; }
            var st = nk === 'date' ? null : mhCallStatusOf(c, rawLine);
            L.push({ t: c, date: nk === 'date', numeric: nk === 'date' && /^[0-9\/.\-, ]+$/.test(c), st: st ? st.kind : '', app: st ? st.app : '' });
        }
    }

    // 2. what kind of line is each one
    var kinds = [];
    var known = [];
    function addKnown(n) { var k = mhCallCleanAuthor(n).toLowerCase(); if (k && known.indexOf(k) < 0) known.push(k); }
    for (var j = 0; j < L.length; j++) {
        var ln = L[j];
        if (ln.foreign) { kinds.push({ kind: 'foreign' }); continue; }
        if (ln.date) { kinds.push({ kind: 'date' }); continue; }
        if (ln.st === 'start' || ln.st === 'line') { kinds.push({ kind: 'status' }); continue; }   // never a header or a name line
        var T = ln.t;
        var m;
        if ((m = MH_CALL_BRACKET_RE.exec(T))) { kinds.push({ kind: 'bracket', time: mhCallSquash(m[1]), rest: m[2] || '' }); continue; }
        if ((m = MH_CALL_TIME_LINE_RE.exec(T))) { kinds.push({ kind: 'time', time: mhCallSquash(m[1]) }); continue; }
        if ((m = MH_CALL_NAME_TIME_RE.exec(T))) {
            var hv = mhCallHeaderVerdict(m[1]);
            var commaSep = m[2].indexOf(',') >= 0;
            // one-word names ("ETA 7:15", "Bus 7:40") are only taken with a comma before the time
            if (hv.verdict === 'name' && (hv.tokens >= 2 || commaSep)) {
                kinds.push({ kind: commaSep ? 'name-comma-time' : 'name-time', name: hv.name, time: mhCallSquash(m[3]) }); addKnown(hv.name); continue;
            }
        }
        if ((m = MH_CALL_NAME_TIME_REST_RE.exec(T))) {
            var nr = mhCallNameInfo(m[1], true);
            if (nr.ok && nr.tokens >= 2) { kinds.push({ kind: m[2].indexOf(',') >= 0 ? 'name-comma-time' : 'name-time', name: nr.name, time: mhCallSquash(m[3]), rest: m[4] }); addKnown(nr.name); continue; }
        }
        kinds.push({ kind: 'text' });
    }

    // 3. desktop shape: a name line directly followed by a time line
    for (var q = 0; q + 1 < L.length; q++) {
        var kq = kinds[q], kn = kinds[q + 1];
        if (kn.kind !== 'time' || (kq.kind !== 'text' && kq.kind !== 'foreign')) continue;
        if (kq.kind === 'foreign') { kinds[q] = { kind: 'desktop', name: placeholderFor(L[q].raw), time: kn.time }; kinds[q + 1] = { kind: 'used' }; continue; }
        var hd = mhCallHeaderVerdict(L[q].t);
        if (hd.verdict === 'name') { kinds[q] = { kind: 'desktop', name: hd.name, time: kn.time }; kinds[q + 1] = { kind: 'used' }; addKnown(hd.name); }
        else if (hd.verdict === 'unclear') { kn.unknownAuthor = true; addName(L[q].t); }
    }
    // ... or a name line followed by a date line ("Yesterday") and then the message
    for (var dq = 1; dq + 1 < L.length; dq++) {
        if (kinds[dq].kind !== 'date' || kinds[dq + 1].kind !== 'text') continue;
        var kp = kinds[dq - 1];
        if (kp.kind === 'foreign') { kinds[dq - 1] = { kind: 'desktop', name: placeholderFor(L[dq - 1].raw), time: L[dq].t }; kinds[dq] = { kind: 'used' }; continue; }
        if (kp.kind !== 'text') continue;
        var hdd = mhCallHeaderVerdict(L[dq - 1].t);
        if (hdd.verdict === 'name') { kinds[dq - 1] = { kind: 'desktop', name: hdd.name, time: L[dq].t }; kinds[dq] = { kind: 'used' }; addKnown(hdd.name); }
    }
    // other date-only lines: a number date inside a message ("out until" / "10/18") is message text,
    // anything else ("Today", "Friday", a date before a header) is a Teams date divider
    var HEADERISH = { 'desktop': 1, 'bracket': 1, 'name-time': 1, 'name-comma-time': 1, 'time': 1, 'date': 1 };
    for (var r = 0; r < L.length; r++) {
        if (kinds[r].kind !== 'date') continue;
        var nextK = r + 1 < L.length ? kinds[r + 1].kind : 'end';
        kinds[r] = { kind: L[r].numeric && r > 0 && !mhCallHas(HEADERISH, nextK) ? 'text' : 'datenoise' };
    }
    for (var b = 0; b < kinds.length; b++) {
        if (kinds[b].kind !== 'bracket') continue;
        var rr = mhCallSquash(kinds[b].rest);
        var bci = rr.indexOf(':');
        var hb = bci > 0 ? mhCallHeaderVerdict(rr.slice(0, bci)) : null;
        if (hb && hb.verdict === 'name') addKnown(hb.name);
        else if (rr) { var hw = mhCallHeaderVerdict(rr); if (hw.verdict === 'name') addKnown(hw.name); }
    }
    known.sort(function (x, y) { return y.length - x.length; });

    // 4. build the messages
    var msgs = [];
    var used = {};
    var cur = null;
    var lastAuthor = '';
    var orphan = [];
    var anyHeader = false;
    var post = null;   // the status post being skipped
    function startMsg(author, timeText, headerLines, headerText, kind, bare) {
        if (cur) msgs.push(cur);
        cur = { author: author, timeText: timeText, parts: [], headerLines: headerLines, headerText: headerText, kind: kind, bare: bare, post: null };
        lastAuthor = author;
        anyHeader = true;
        post = null;   // a new message header ends a status post
    }
    function openPost(line) {
        var p = { app: line.app, text: line.t.length > 80 ? line.t.slice(0, 77) + '...' : line.t, lines: 0 };
        if (res.statusPosts.length < 20) res.statusPosts.push(p);
        res.statusByApp[line.app] = (res.statusByApp[line.app] || 0) + 1;
        if (cur && !cur.post) cur.post = p;
        return p;
    }
    for (var x = 0; x < L.length; x++) {
        var k = kinds[x];
        if (k.kind === 'used') continue;
        if (k.kind === 'status' || (post && k.kind === 'text' && L[x].st === 'body')) {
            if (L[x].st === 'start' || !post) post = openPost(L[x]);
            post.lines++;
            res.statusLines++;
            continue;
        }
        if (post && k.kind === 'text') post = null;   // not part of the post: a message again
        if (k.kind === 'datenoise') { noteSkipped(L[x].t, 'noise', 1); continue; }
        if (k.kind === 'foreign') { noteSkipped('(text in another alphabet)', 'unread', 1); continue; }
        if (k.kind === 'desktop') { startMsg(k.name, k.time, 2, k.name + ' - ' + k.time, 'desktop', false); continue; }
        if (k.kind === 'name-time' || k.kind === 'name-comma-time') {
            startMsg(k.name, k.time, 1, L[x].t, k.kind, false);
            if (k.rest) cur.parts.push(mhCallSquash(k.rest));
            continue;
        }
        if (k.kind === 'bracket') {
            var sp = mhCallSplitNameBody(k.rest, known);
            startMsg(sp.name || (sp.body ? '' : lastAuthor), k.time, 1, L[x].t, 'bracket', false);
            if (sp.body) cur.parts.push(sp.body);
            continue;
        }
        if (k.kind === 'time') { startMsg(k.unknownAuthor ? '' : lastAuthor, k.time, 1, L[x].t, 'time', true); continue; }
        if (cur) cur.parts.push(L[x].t); else orphan.push(L[x].t);
    }
    if (cur) msgs.push(cur);

    var out = [];
    if (!anyHeader) {
        // plain lines: one message per line, "Name: text" lines keep their name
        var colon = 0;
        for (var y = 0; y < orphan.length; y++) {
            var mc = MH_CALL_NAME_COLON_RE.exec(orphan[y]);
            var nc = mc ? mhCallNameInfo(mc[1], true) : null;
            if (mc && nc && nc.ok && nc.tokens >= 2) { out.push({ author: nc.name, timeText: '', text: mhCallSquash(mc[2]) }); colon++; addName(nc.name); }
            else out.push({ author: '', timeText: '', text: orphan[y] });
        }
        res.format = out.length ? (colon ? 'name-colon' : 'plain') : 'empty';
    } else {
        if (orphan.length) out.push({ author: '', timeText: '', text: orphan.join(' ') }); // tail of a message cut off at the top
        var prevOut = out.length ? out[out.length - 1] : null;
        for (var z = 0; z < msgs.length; z++) {
            var mm = msgs[z];
            var body = mhCallSquash(mm.parts.join(' '));
            if (!body && mm.post) {
                // the message was only a status post: its name and time lines go with it
                mm.post.lines += mm.headerLines;
                res.statusLines += mm.headerLines;
                if (mm.author) addName(mm.author);
                prevOut = null;
                continue;
            }
            if (!body) {
                // a time on its own line with nothing under it is the end of the message before ("I can be there by" / "7:30 AM")
                if (mm.bare && prevOut) { prevOut.text = mhCallSquash(prevOut.text + ' ' + mm.headerText); continue; }
                noteSkipped(mm.headerText, 'unread', mm.headerLines);
                if (mm.author) addName(mm.author);
                prevOut = null;
                continue;
            }
            used[mm.kind] = (used[mm.kind] || 0) + 1;
            prevOut = { author: mm.author, timeText: mm.timeText, text: body };
            out.push(prevOut);
            if (mm.author) addName(mm.author);
        }
        var named = [];
        var names = ['desktop', 'bracket', 'name-time', 'name-comma-time'];
        for (var w = 0; w < names.length; w++) if (used[names[w]]) named.push(names[w]);
        if (named.length > 1) res.format = 'mixed';
        else if (named.length === 1) res.format = named[0];
        else if (used['time']) res.format = 'time-only';
        else res.format = out.length ? 'plain' : 'empty';
    }
    res.messages = out;
    res.skippedLines = res.noiseLines + res.unreadLines + res.statusLines;
    return res;
}

// ---- reasons ----
// mhCallReason returns a key of MH_CALL_REASONS. Order matters. The status words people type (NCNS, PTO) win, then leaving early, then
// clear "I will be late" phrases, then causes (sick...), then other days off, then the
// generic call-out phrases, then traffic and a bare "late".
//   "calling out sick" is sick, "not feeling well, leaving early" is left early,
//   "doctor appointment, be there at 10" is late, "PTO this morning, be in at 12" is pto,
//   "sorry for the late notice, I won't be in" is absent, "not sick, just late" is late.
var MH_CALL_REASON_STRIP = [
    /\b(not|no longer|isnt|arent|wasnt|never) (sick|ill)\b/g,
