}
function readEmployeeShiftInfo(e) {
    const FMT = '@OData.Community.Display.V1.FormattedValue';
    const cands = [e.craa5_shift, e.craa5_Shift, e['craa5_shift' + FMT], e['craa5_Shift' + FMT], e.craa5_shiftcode, e.craa5_crew];
