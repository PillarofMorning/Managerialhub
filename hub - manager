// Keeps Tab inside a dialog: from the last control it goes to the first, and Shift+Tab the other way.
function trapTabKey(e) {
    if (e.key !== 'Tab') return;
    const els = Array.prototype.slice.call(e.currentTarget.querySelectorAll('button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    if (!els.length) return;
    const first = els[0], last = els[els.length - 1];
    const active = document.activeElement;   // the panel itself holds focus after a click on its title
    if (e.shiftKey && (active === first || active === e.currentTarget)) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
}

const Chip = ({ on, onClick, children, title }) => (
    <button type="button" onClick={onClick} title={title} aria-pressed={!!on} className={`px-3 py-1.5 min-h-[44px] sm:min-h-0 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap ${on ? 'bg-[#0072CE] text-white border-[#0072CE] shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]'}`}>{children}</button>
);

// ==== MH TABLE NAMES (v6.8) ====   (moved ahead of MH FEATURE NOTES in v6.9)
// Gerald made the three v6.7 tables under a prefix of his own, the way the chemical tables use "_c_": craa5__m_formtemplate (display name
// "_m_Form template"), craa5__m_timelosslog and craa5__m_quicktask. The forms library, the time-loss log, the quick tasks and (v6.9) the manager notes (craa5_employeenote,
// craa5__m_employeenote) therefore know two names each: the "_m_" one first and the plain v6.7 one (craa5_formtemplate ...) second for the first three, and for the manager notes the plain
// one first (the real table is craa5_employeenote, data contract 1.0.51) and the "_m_" one second. mhTnEnsure(dataApi, key) looks for the first one that
// is there with one tiny read (a table that is missing moves on to the next name; a refusal that names a privilege or a column means the
// table is there; a sign-in refusal says nothing about any table), once per page and feature, and the setters (mhFormUse, mhQtUse, mhTlUse, mhNotesUse, each in its
// own block) point every name the feature derives from it (table, entity set = logical name + "s", id column = logical name + "id", the full
// selects) at that table. A table that is found nowhere keeps the "_m_" names, so the messages and the Dataverse check say what to create; it is
// looked for again at the next read, and a read that finds the chosen table missing forgets the choice. An answer that cannot tell (no answer, a
// busy server, no sign-in) is not remembered: the feature uses the table found after it or else the name that could not be told, and for a few
// seconds the same names are used everywhere, so reads that run together never use two tables. A read of such a guess that finds the table missing
// says it could not tell which table holds the data, not that the table is not created. Every read and write of the four features asks
// mhTnEnsure first; a filter or select that holds the id column is given as a function, so it is built after that ask.
// Host rule: ES5 without iterables.
var MH_TN = {
    form: { names: ['craa5__m_formtemplate', 'craa5_formtemplate'], chosen: '', pending: null, hold: 0, applied: '' },
    quick: { names: ['craa5__m_quicktask', 'craa5_quicktask'], chosen: '', pending: null, hold: 0, applied: '' },
    loss: { names: ['craa5__m_timelosslog', 'craa5_timelosslog'], chosen: '', pending: null, hold: 0, applied: '' },
    notes: { names: ['craa5_employeenote', 'craa5__m_employeenote'], chosen: '', pending: null, hold: 0, applied: '' }
};
var MH_TN_HOLD_MS = 4000;
// The one tiny read: it asks for the row with the all-zero id, which no table has, so it reads no data from anybody.
var MH_TN_NO_ROW = '00000000-0000-0000-0000-000000000000';
// Resolves { ok, err }. With Xrm.WebApi that is the one that answers (its refusal is the answer, not swQuery's dataApi fallback, which can swap it for
// another text); without Xrm the page's dataApi answers. An answer that is not a list of rows is no answer.
function mhTnAsk(dataApi, logical) {
    var web = swWebApi(), idCol = logical + 'id';
    if (web && web.retrieveMultipleRecords) {
        return swTimeout(function () { return web.retrieveMultipleRecords(logical, '?$select=' + idCol + '&$filter=' + idCol + ' eq ' + MH_TN_NO_ROW + '&$top=1'); }, 'Xrm.WebApi ' + logical).then(function (res) {
            return Array.isArray(res && res.entities) ? { ok: true, err: '' } : { ok: false, err: 'The answer for ' + logical + ' held no list of rows.' };
        }, function (e) { return { ok: false, err: swErrText(e) }; });
    }
    if (!dataApi || typeof dataApi.queryTable !== 'function') return Promise.resolve({ ok: false, err: 'No data API on this page.' });
    return swTimeout(function () { return dataApi.queryTable(logical, { select: [idCol], filter: idCol + ' eq ' + MH_TN_NO_ROW, pageSize: 1, top: 1 }); }, 'dataApi ' + logical).then(function (page) {
        return Array.isArray(page && page.rows) ? { ok: true, err: '' } : { ok: false, err: 'The answer for ' + logical + ' held no list of rows.' };
    }, function (e) { return { ok: false, err: swErrText(e) }; });
}
// 'found', 'missing' (the table is not there) or 'unknown' (no usable answer). Only a refusal that names a privilege, or a column, says the table is
// there; a sign-in refusal (401, 403 with no privilege named) fails whatever table is asked for, so it says nothing.
function mhTnProbe(dataApi, logical) {
    return mhTnAsk(dataApi, logical).then(function (res) {
        if (res.ok) return 'found';
        var m = String(res.err || '');
        if (/resource not found for the segment|not found in the metadatacache/i.test(m)) return 'missing';   // before swClassify: its column list holds 0x80060888, the code of this answer
        var k = swClassify(m);
        if (k === 'table' || k === 'gone') return 'missing';
        if (k === 'column') return 'found';   // the table is there; the real read says what is wrong with it
        if (k === 'denied') return /prv(read|create|write|append|delete)|privilege|SecLib::AccessCheckEx|0x80040220|0x80040277|-2147187962|principal user/i.test(m) ? 'found' : 'unknown';
        return 'unknown';
    });
}
function mhTnUse(key, logical) {
    if (key === 'form') mhFormUse(logical); else if (key === 'quick') mhQtUse(logical); else if (key === 'loss') mhTlUse(logical); else if (key === 'notes') mhNotesUse(logical);   // the setters live in each feature block
}
// Resolves the logical name of the table the feature uses from now on (never rejects). Every name is asked about, in order, until one is found: a name
// that could not be told does not stop the later ones. The table found is remembered only when no earlier name was left unsure; otherwise it is used
// for a few seconds and asked about again.
function mhTnEnsure(dataApi, key) {
    var f = MH_TN[key];
    if (!f) return Promise.resolve('');
    if (f.chosen) return Promise.resolve(f.chosen);
    if (f.pending) return f.pending;
    if (f.hold && Date.now() < f.hold) return Promise.resolve(f.applied || f.names[0]);
    var i = 0, found = '', unsure = '';
    var next = function () {
        if (found || i >= f.names.length) return Promise.resolve();
        var name = f.names[i++];
        return mhTnProbe(dataApi, name).then(function (state) {
            if (state === 'found') found = name; else if (state === 'unknown' && !unsure) unsure = name;
            return next();
        });
    };
    var done = function () {
        f.pending = null;
        var use = found || unsure || f.names[0];
        f.chosen = found && !unsure ? found : '';
        f.hold = unsure ? Date.now() + MH_TN_HOLD_MS : 0;
        f.applied = use;
        mhTnUse(key, use);
        return use;
    };
    f.pending = next().then(done, done);
    return f.pending;
}
// True while the table in use was a guess (a name could not be told); a read that finds it missing then says so instead of "not created yet".
function mhTnGuess(key) {
    var f = MH_TN[key];
    return !!(f && !f.chosen && f.hold && Date.now() < f.hold);
}
var MH_TN_GUESS_TEXT = 'Could not tell which table holds this data (the check for it got no answer). Try again in a moment.';
// A read that finds the table missing forgets what was chosen, so the next read looks again.
function mhTnForget(key) {
    var f = MH_TN[key];
    if (f) { f.chosen = ''; f.hold = 0; }
}
// A body built before the table was found carries the id key of the other name: the id moves to the key of the table in use.
function mhTnFixBody(body, key, idKey) {
    MH_TN[key].names.forEach(function (n) { var k = n + 'id'; if (k !== idKey && body[k] !== undefined) { body[idKey] = body[k]; delete body[k]; } });
    return body;
}
// Forgets what was found (tests, and a way to look again).
function mhTnReset() {
    Object.keys(MH_TN).forEach(function (k) { MH_TN[k].chosen = ''; MH_TN[k].pending = null; MH_TN[k].hold = 0; MH_TN[k].applied = ''; mhTnUse(k, MH_TN[k].names[0]); });
}
// ==== END MH TABLE NAMES ====
// ==== MH FEATURE NOTES (v6.5) ====
// Manager notes (under the picked person in Employee Query) and the profile dialog (double-click or Profile). Both are only rendered for
// allowed users. MhEmployeeNotes is keyed by the person, so it starts fresh for each one.
// MhEmployeeNotes props: { dataApi, access, notify, guid (employee row id, lowercase, no braces), name (as stored, usually "Last, First"),
//   profile (buildEmployeeProfile of the days picked, or null while it is read), range ({ first, last, days } or null) }
// MhProfileDialog props: { dataApi, access, notify, target ({ guid ('' when not known), name, label, source: 'employee' | 'deployment' }),
//   profile (Employee Query's numbers when they are this person's, else null), range ({ first, last, days } or null), onClose() }
// ----------------------------------------------------------------------------
// Where the notes live: the new table craa5_employeenote (People-page style, like craa5_peopleplan), one row per note:
//   craa5_name (a short title such as "Snapshot 17 Oct", never the person's name), craa5_employeeguid (the employee row id, lowercase,
