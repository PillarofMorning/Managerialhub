                            <div>
                                <label htmlFor="emp-from" className={labelCls}>From</label>
                                <input id="emp-from" type="date" value={empRange.from} onChange={e => setEmpRange(r => ({ ...r, from: e.target.value }))} className={inputCls} />
                            </div>
                            <div>
                                <label htmlFor="emp-to" className={labelCls}>To (included)</label>
                                <input id="emp-to" type="date" value={empRange.to} onChange={e => setEmpRange(r => ({ ...r, to: e.target.value }))} className={inputCls} />
                            </div>
                            {empWin.error && <p role="alert" className="text-sm font-bold text-[#E4002B] pb-2">{empWin.error}</p>}
                        </div>
