            if (out.errors.length < 5) out.errors.push(mhTlProblemText(r.state, r.err, r.cols));
            if (r.state === 'noapi' || r.state === 'missing' || r.state === 'denied' || r.state === 'column') { out.state = r.state; out.failed += list.length - i - 1; for (var j = i + 1; j < list.length; j++) out.byId[list[j].id] = 'failed'; break; }
