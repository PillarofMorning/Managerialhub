    }, []);
    var [covered, setCovered] = useState('');   // '' = shown; 'idle' or 'hidden' = covered for privacy (the drafts are kept)
    var [drafts, setDrafts] = useState({ Pro: '', Con: '', snap: '' });
    var [rating, setRating] = useState(0);
    var [noRating, setNoRating] = useState(true);   // a rating nobody chose is never saved: moving the slider turns it on
    var notifyRef = useRef(props.notify);
    notifyRef.current = typeof props.notify === 'function' ? props.notify : function () {};
    var live = allowed && !covered;
    var subject = useMhNoteSubject(props.dataApi, t.guid, t.name, live);
    var list = useMhNotesList(props.dataApi, subject, live);
    var notes = list[0], setNotes = list[1], reload = list[2], me = list[3];
    var busy = useMhNotesBusy();
    var sayPair = useMhNotesSay(), say = sayPair[0], setSay = sayPair[1];
    var save = useMhNoteSaver(props.dataApi, props.access, subject, setNotes, me, notifyRef, busy, setSay);
    var remover = useMhNoteRemover(props.dataApi, subject, setNotes, me, notifyRef, busy);
    useMhPrivacyFold(live, function (why) { setCovered(why || 'idle'); });

    var setDraft = function (k) { return function (v) { setDrafts(function (d) { var o = Object.assign({}, d); o[k] = v; return o; }); }; };
    var addProCon = function (kind) {
        var v = String(drafts[kind] || '').replace(/\s+$/, '');
        if (!v.trim()) { setSay(kind, 'error', 'Type the ' + mhNoteKindWord(kind) + ' first.'); return; }
        save(kind, kind, { text: v }, function () { setDraft(kind)(''); });
    };
    var snapSummary = mhSnapshotOf(props.profile, props.range);
    var snapLines = mhSnapshotLines(snapSummary);
    var addSnapshot = function () {
