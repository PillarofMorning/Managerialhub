}
// The Dataverse filter for one person and one piece of the range: their employee id and/or name, saved in the window
// (by assignment time, or by creation time when that is blank). Closed rows (after a shift is closed) are included on purpose.
function empAssignmentFilter(pick, step, f, t) {
    const who = [];
    if (step.guid === 'quoted' && pick.guid) who.push(`craa5__aaemp_guid eq '${odataStr(pick.guid)}'`);
    if (step.guid === 'bare' && pick.guid) who.push(`craa5__aaemp_guid eq ${pick.guid}`);
    empNameVariants(pick.name).forEach(n => who.push(`craa5_id eq '${odataStr(n)}'`));
    const when = `((craa5_datetimeofassignment ge ${isoZ(f)} and craa5_datetimeofassignment lt ${isoZ(t)}) or (craa5_datetimeofassignment eq null and createdon ge ${isoZ(f)} and createdon lt ${isoZ(t)}))`;
    return `(${who.join(' or ')}) and ${when}`;
