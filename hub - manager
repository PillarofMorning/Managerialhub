    };
    var ok = notes.state === 'ok' || (notes.state === 'loading' && notes.rows.length > 0);
    var snaps = mhNotesOfKinds(notes.rows, ['Snapshot']);
    var label = t.label || formatFullName(t.name) || 'this person';
