                                {suggestions.map(sg => <option key={sg.name} value={sg.name}>{sg.name}{sg.support ? ' (support)' : ''}</option>)}
                            </select>
                            <button type="button" data-lp-add-seen disabled={lpBusy || !seenPick} onClick={() => { if (lpAddName(seenPick)) { setLpSeen(''); lpFocus.current = { sel: '#lp-seen', altSel: '[data-lp-add-text]' }; } }} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B] flex-shrink-0`}>Add chosen line</button>
                        </div>
                    </div>
