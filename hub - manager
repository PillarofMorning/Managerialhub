    var shown = mhNotesOfKinds(notes.rows, ['Comment', 'Note']);
    var others = mhNotesOfKinds(notes.rows, ['Pro', 'Con', 'Snapshot']).length;
    var toggle = function () { if (open) fold(''); else { setFoldWhy(''); setOpen(true); } };
    var add = function () {
        var t = text.replace(/\s+$/, '');
        if (!t.trim()) { setSay('add', 'error', 'Type the ' + (kind === 'Note' ? 'note' : 'comment') + ' first.'); return; }
        save('add', kind, { text: t }, function () { setText(''); setTab('write'); });
    };
    var saving = busy.busy === 'save:add';
    var ok = notes.state === 'ok' || (notes.state === 'loading' && notes.rows.length > 0);
    return (
        <section data-mh-notes={open ? 'open' : 'folded'} aria-labelledby="mh-notes-title" className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div className={'bg-[#E6F1FB] px-5 py-3 flex flex-wrap items-center gap-2' + (open ? ' border-b border-[#CFE3F7]' : '')}>
                <MhLockIcon className="w-5 h-5 text-[#0072CE] flex-shrink-0" />
                <h3 id="mh-notes-title" className="text-sm font-black text-[#00468B] uppercase tracking-widest">Manager notes</h3>
