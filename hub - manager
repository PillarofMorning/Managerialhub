    items.forEach(it => {
        if (it.absence) { bump(away, it.absence, {})[it.day] = true; return; }
        totalMs += it.ms;
        days[it.day] = true;
        const a = bump(areas, normText(it.area), { name: it.area, days: {}, ms: 0, rows: 0, last: 0 });
        a.name = it.area;   // rows run oldest to newest, so the newest spelling is the one shown
        a.days[it.day] = true; a.ms += it.ms; a.rows++; a.last = Math.max(a.last, it.start);
        const supKey = normText(it.sup), leadKey = normText(it.lead);
