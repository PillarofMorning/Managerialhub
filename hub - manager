// A long date range cut into 7-day pieces, so each piece is read (and capped) on its own.
function weekChunks(from, to, name) {
    const out = [];
    for (let i = 0, f = from; f < to; i++) {
        const t = Math.min(addDaysLocal(new Date(f), 7).getTime(), to);
        out.push({ name: `${name}${i}`, r: [f, t] });
        f = t;
    }
