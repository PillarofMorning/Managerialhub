                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-3 flex flex-wrap items-center gap-x-4 gap-y-3">
                    <div className="flex items-center gap-1.5" role="group" aria-label="Move the view">
                        <button type="button" onClick={() => move(-1)} aria-label={weekSpan === 7 ? 'Previous week' : weekSpan === 14 ? 'Previous two weeks' : `Previous ${weekSpan === 1 ? 'day' : weekSpan + ' days'}`} className={navBtn}><ChevronLeftIcon className="w-4 h-4" /></button>
                        <button type="button" onClick={() => setSelectedDate(getLocalYMD(new Date()))} className="px-3 py-2 rounded-lg border border-[#B3D4F2] bg-white text-[#0072CE] text-xs font-extrabold uppercase tracking-wider hover:bg-[#E6F1FB]">Today</button>
                        <button type="button" onClick={() => move(1)} aria-label={weekSpan === 7 ? 'Next week' : weekSpan === 14 ? 'Next two weeks' : `Next ${weekSpan === 1 ? 'day' : weekSpan + ' days'}`} className={navBtn}><ChevronRightIcon className="w-4 h-4" /></button>
                    </div>
                    <div className="text-sm font-black text-[#00468B]" aria-live="polite">{rangeLabel}</div>
                    <div className="flex gap-1.5" role="group" aria-label="Days shown">
                        {WEEK_SPANS.map(s => <Chip key={s.days} on={weekSpan === s.days} onClick={() => setWeekSpan(s.days)}>{s.label}</Chip>)}
