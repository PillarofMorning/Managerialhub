                            <span className="text-sm font-bold text-slate-800">Replace the list with the built-in order?</span>
                            <button type="button" autoFocus onClick={lpPutBack} className={`${btn} bg-[#0072CE] text-white border-[#0072CE] hover:bg-[#00468B]`}>Yes, put it back</button>
                            <button type="button" onClick={() => { setLpResetAsk(false); lpFocus.current = { sel: '[data-lp-reset-btn]' }; }} className={`${btn} bg-white text-[#00468B] border-slate-300 hover:bg-slate-50`}>No, keep my list</button>
