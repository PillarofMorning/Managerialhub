    // night); only when there is nothing to go by does the time of day decide.
    items.forEach((it, i) => {
        if (it.crew || !i) return;
        const prev = items[i - 1], prevEnd = empShiftEnd(prev.start, prev.night);
        if (prevEnd && it.start < prevEnd) it.night = prev.night;
    });
    items.forEach((it, i) => {
        const next = items[i + 1];
        const sEnd = empShiftEnd(it.start, it.night);
        const limit = sEnd ? Math.min(sEnd, it.start + EMP_MAX_ROW_MS) : it.start + EMP_MAX_ROW_MS;   // how far a row with no end time may run
        let stop = it.end, overCap = false;
        if (!stop) {
            if (it.active && nowMs >= it.start && nowMs < limit) { stop = nowMs; it.open = true; }
            else if (next && next.start <= limit) stop = next.start;          // the next move in the same shift ends it
            else if (sEnd) { stop = limit; it.toShiftEnd = true; }            // the last row of a shift: it ran to the end of that shift
            else { stop = it.start; it.noEnd = true; }                        // nothing to say when it ended: no hours
        }
        if (stop - it.start > EMP_MAX_ROW_MS) { stop = it.start + EMP_MAX_ROW_MS; overCap = true; }
