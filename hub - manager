                        if (!f) { rows = []; break; }
                        const q = { filter: f, top: batches[i].length * 4 };
                        if (st.select) q.select = EMP_PICK_FIELDS;
                        rows = await queryRecords(TABLE_EMPLOYEE, dataApiRef.current, q);
                        if (!alive) return;
                        if (rows !== null) { worked = true; break; }
                        if (worked) break;   // it worked before: this batch failed on its own
                        step++;
                    }
                    if (rows === null) failed++;
                    else { const part = empStatusOf(batches[i], rows, usedById); Object.keys(part).forEach(k => { map[k] = part[k]; }); }
                    const snapshot = Object.assign({}, map), doneNow = i + 1;
                    setAreaStatus(prev => prev.key === areaStatusKey ? { ...prev, map: snapshot, done: doneNow } : prev);
                    if (rows === null && !worked) break;   // nothing works: the employee list cannot be read
                }
                if (!alive) return;
                setAreaStatus(prev => prev.key === areaStatusKey ? { ...prev, loading: false, failed: failed > 0 } : prev);
            } catch (err) {
                console.error('[Manager] Employee list check failed', err);
                if (alive) setAreaStatus(prev => prev.key === areaStatusKey ? { ...prev, loading: false, failed: true } : prev);
            }
        })();
        return () => { alive = false; };
    }, [areaStatusKey, apiReady]);

    // The ranking as shown: people who have left are hidden unless asked for, a crew can be picked, and the order follows "Rank by".
    const areaView = useMemo(() => {
        if (!areaRanking) return null;
        const statusMap = areaStatus.key === areaStatusKey ? areaStatus.map : {};
        const all = areaRanking.people.map(x => ({ ...x, st: statusMap[x.key] || null }));
        const leftCount = all.filter(x => x.st && x.st.left).length;
        const crews = {};
        all.forEach(x => { if (x.st && x.st.crew && (areaShowLeft || !x.st.left)) crews[x.st.crew] = (crews[x.st.crew] || 0) + 1; });
        let list = areaShowLeft ? all : all.filter(x => !(x.st && x.st.left));
        const crewOn = areaCrew && crews[areaCrew] ? areaCrew : '';   // a crew nobody is in (after a new read) is not applied
        if (crewOn) list = list.filter(x => x.st && x.st.crew === crewOn);
        list = sortAreaPeople(list, areaSort);
        return { list, leftCount, crews, all, crewOn };
    }, [areaRanking, areaStatus.key, areaStatus.map, areaStatusKey, areaSort, areaCrew, areaShowLeft]);

    const pickArea = (item) => {
        const q = areaQuery;
