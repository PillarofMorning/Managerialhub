// Resolves { ok, state: one of 'saved', 'unconfirmed', 'noapi', 'missing', 'denied', 'column' and 'error'; entry, err, cols, dropped, recovered, tries, markers }.
async function mhTlCreate(dataApi, rec, onWait) {
    if (!rec || !rec.body || !rec.id) return { ok: false, state: 'error', entry: null, err: (rec && rec.error) || 'Nothing to save.', cols: [], dropped: [], recovered: false, tries: 0 };
    var api0 = getWriteApi(dataApi);
    if (!api0) return { ok: false, state: 'noapi', entry: null, err: 'There is no Dataverse write connection on this page.', cols: [], dropped: [], recovered: false, tries: 0 };
    var api = lpGuardApi(api0), body = Object.assign({}, rec.body), dropped = [], recovered = false, gotId = rec.id;
    var res = await lpTryWrite(async function (attempt) {
        await mhTnEnsure(dataApi, 'loss');
        mhTnFixBody(body, 'loss', MH_TL_ID);   // every try asks which table is in use, so a retry after the names changed re-keys the id
        if (attempt > 0) {
            var look = await mhTlReadBack(dataApi, rec.id);
            if (look.found) { recovered = true; return true; }
        }
        for (var k = 0; k <= MH_TL_OPTIONAL.length; k++) {
            try {
                var id = await api.create(MH_TL_TABLE, body);
                if (id && cleanGuid(id) !== rec.id && MH_TL_GUID_RE.test(cleanGuid(id))) gotId = cleanGuid(id);   // a host that picks its own id
                return true;
            } catch (e) {
                var kind = swClassify(e);
                if (kind === 'duplicate') { recovered = true; return true; }
                var named = kind === 'column' ? swNamedColumns(e, MH_TL_OPTIONAL).filter(function (c) { return body[c] !== undefined; }) : [];
                if (!named.length) throw e;
