    const byTime = (x, y) => y.ms - x.ms || y.times - x.times || String(x.name || x.label).localeCompare(String(y.name || y.label));     // areas: the most hours first
    const byTimes = (x, y) => y.times - x.times || y.ms - x.ms || String(x.name || x.label).localeCompare(String(y.name || y.label));   // teams: the most shifts first
    const areaList = Object.keys(areas).map(k => { const a = areas[k]; return { name: a.name, times: count(a.days), hours: a.ms / 3600000, ms: a.ms, share: totalMs ? a.ms / totalMs : 0, rows: a.rows, last: a.last }; }).sort(byTime);
    const topSupOf = (t) => { const ks = Object.keys(t.sups).map(k => t.sups[k]).sort((x, y) => y.n - x.n || x.name.localeCompare(y.name)); return ks.length ? ks[0].name : ''; };
    const teamList = Object.keys(teams).map(k => {
        const t = teams[k], supName = topSupOf(t);
        const leadName = t.held ? '' : formatFullName(t.lead);
        const label = t.held ? (supName ? `${formatFullName(supName)} (supervisor)` : 'No lead or supervisor named') : leadName;
        return { label, name: label, lead: leadName, held: t.held, supName: supName ? formatFullName(supName) : '', times: count(t.days), hours: t.ms / 3600000, ms: t.ms, share: totalMs ? t.ms / totalMs : 0, rows: t.rows, last: t.last };
    }).sort(byTimes);
    const supList = Object.keys(sups).map(k => { const s = sups[k]; return { name: formatFullName(s.name), times: count(s.days), ms: s.ms, hours: s.ms / 3600000 }; }).sort(byTimes);
    const strongest = areaList.filter(a => a.times >= EMP_MIN_SHIFTS_FOR_STRONGEST)[0] || null;
    const attendance = { sick: count(away.sick || {}), pto: count(away.pto || {}), late: count(away.late || {}), leftEarly: count(away['left early'] || {}), ncns: count(away.ncns || {}) };
    const dayKeys = Object.keys(days).sort();
    return {
        hasRows: items.length > 0,
        daysWorked: dayKeys.length, hours: totalMs / 3600000, totalMs,
        timesAssigned: areaList.reduce((n, a) => n + a.times, 0),
        areas: areaList, teams: teamList, sups: supList,
        topTeam: teamList[0] || null, topSup: supList[0] || null, strongest,
        attendance, firstDay: dayKeys[0] || '', lastDay: dayKeys[dayKeys.length - 1] || '',
        assignments: items.slice().sort((a, b) => b.start - a.start),
        notes
    };
}

