// Every run the form will create: { items: [{ date, start, end }], error, tooMany }. Times are built in local time
// (so 06:00 stays 06:00 across daylight-saving changes). A run keeps its real length in hours, except whole days
// (24 h, 48 h...), which end at the same clock time N days later so "24 h every day" runs back to back all year.
function buildOccurrences(p) {
    const startDay = parseYMD(p.startDate);
    const first = startDay && withTime(startDay, p.startTime);
    if (!startDay || !first || isNaN(first.getTime())) return { items: [], error: 'Choose a start date and a start time.', tooMany: false };
    const hours = parseFloat(p.runLength);
    if (!(hours >= 0.25) || hours > 168) return { items: [], error: 'Run length must be between 0.25 and 168 hours.', tooMany: false };
    const durMs = Math.round(hours * 3600000);
    const wholeDays = hours % 24 === 0 ? hours / 24 : 0;
    const days = [];
    let tooMany = false;
    if (p.repeat === 'once') {
        days.push(startDay);
    } else {
        const last = parseYMD(untilYMD(p.startDate, p.until));
        if (!last || last.getTime() < startDay.getTime()) return { items: [], error: 'The "until" date must be on or after the start date.', tooMany: false };
        if (Math.round((last.getTime() - startDay.getTime()) / 86400000) > 1100) return { items: [], error: 'Pick an "until" date within about 3 years of the start date.', tooMany: false };
        const firstSunday = addDaysLocal(startDay, -startDay.getDay()).getTime();
        const every = Math.max(1, parseInt(p.everyWeeks, 10) || 1);
        const picked = p.repeatDays || [];
        for (let d = startDay; d.getTime() <= last.getTime(); d = addDaysLocal(d, 1)) {
            const dow = d.getDay();
            let on = true;
            if (p.repeat === 'weekdays') on = dow >= 1 && dow <= 5;
            else if (p.repeat === 'custom') on = picked.indexOf(dow) >= 0 && Math.round((addDaysLocal(d, -dow).getTime() - firstSunday) / 604800000) % every === 0;
