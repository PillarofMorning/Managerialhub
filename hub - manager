// A long range read in pieces (newest piece first), so each piece is filtered, capped and shown on its own.
function empChunks(from, to) {
    const out = [];
    for (let f = to; f > from;) {
        const s = Math.max(from, addDaysLocal(new Date(f), -EMP_CHUNK_DAYS).getTime());
        out.push([s, f]);
