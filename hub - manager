    for (let k = 1; k < items.length; k++) {
        if (items[k].start.getTime() < items[k - 1].end.getTime()) {
            return { items: [], error: `Runs would overlap: the ${fmtDay(items[k - 1].start)} run lasts until ${fmtDay(items[k - 1].end)} ${fmtTime(items[k - 1].end)}, but the next one starts ${fmtDay(items[k].start)} ${fmtTime(items[k].start)}. Shorten the run or repeat less often.`, tooMany: false };
