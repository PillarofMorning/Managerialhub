        const list = empSuggest.key === empQuery ? empSuggest.rows : [];
        const searching = empSearchable && (empSuggest.loading || empSuggest.key !== empQuery);
        const showList = empOpen && empSearchable && !(empPick && empQuery === empPick.label);
        const reading = !!empPick && empData.key === empKey && empData.loading;
        const words = empPick ? empPick.label.split(/\s+/).filter(Boolean) : [];
        const initials = words.length ? (words[0].charAt(0) + (words.length > 1 ? words[words.length - 1].charAt(0) : '')).toUpperCase() : '?';
        const hrs = (h) => { const r = Math.round(h * 10) / 10; return `${r % 1 === 0 ? r.toFixed(0) : r.toFixed(1)} h`; };
        const pct = (x) => `${Math.round(x * 100)}%`;
        const pickFromList = (r) => pickEmployee(r);
        const onKey = (e) => {
            const n = list.length;
            if (e.key === 'ArrowDown') { e.preventDefault(); setEmpOpen(true); if (n) setEmpActive(i => (i + 1) % n); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) setEmpActive(i => (i <= 0 ? n - 1 : i - 1)); }
            else if (e.key === 'Enter') {
                const r = showList && !searching ? (empActive >= 0 ? list[empActive] : (n === 1 ? list[0] : null)) : null;
                if (r) { e.preventDefault(); pickFromList(r); }
            }
            else if (e.key === 'Escape') { setEmpOpen(false); setEmpActive(-1); }
        };
        const n = p ? p.notes : null;
        const shareBar = (share) => (
            <div className="flex items-center gap-2 min-w-[120px]">
                <div className="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div className="h-2 rounded-full bg-[#0072CE]" style={{ width: `${Math.max(2, Math.round(share * 100))}%` }} /></div>
                <span className="text-xs font-bold text-slate-500 w-9 text-right">{pct(share)}</span>
            </div>
        );

        const header = (
            <div>
                <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Employee Query</h2>
