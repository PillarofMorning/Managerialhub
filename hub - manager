// Last day of a repeat: "1 week" means 7 days counting the start day; "end of month" is the start date's month.
const untilYMD = (startYmd, until) => {
    if (until.k === 'weeks') return addDaysYMD(startYmd, until.n * 7 - 1);
    if (until.k === 'eom') { const d = parseYMD(startYmd); return d ? getLocalYMD(new Date(d.getFullYear(), d.getMonth() + 1, 0)) : ''; }
    return until.v || '';
};
