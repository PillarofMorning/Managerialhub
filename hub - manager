}
// What is drawn on one line between `from` and `to`: each run (cut to the window) and the gaps between runs. A gap is a
// sanitation window; after an allergen run it is an allergen clean, flagged when under 8 hours. A gap longer than 48 hours
// is shown as "no run scheduled". `lineRuns` is every known run of this area and line, so the gaps at the edges of the
// window know what ran before and what runs next.
function buildLaneBlocks(lineRuns, from, to) {
    const runs = lineRuns.slice().sort(byStartAsc);
    const blocks = [];
    let last = null;
    runs.forEach(r => { if (endMs(r) <= from && (!last || endMs(r) >= endMs(last))) last = r; });
    const next = runs.find(r => startMs(r) >= to) || null;
    const pushGap = (gs, ge, afterRun, beforeStart) => {
        const trueGap = afterRun && beforeStart !== null ? Math.max(0, beforeStart - endMs(afterRun)) : Infinity;
        const idle = trueGap > IDLE_GAP_H * 3600000;
        const allergen = !!afterRun && isAllergenRun(afterRun) && !idle;
        blocks.push({ type: 'gap', start: gs, end: ge, idle, allergen, short: allergen && trueGap <= ALLERGEN_SHORT_GAP_H * 3600000 });
    };
