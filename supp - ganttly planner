                                                    </div>
                                                )}
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
            )}

            {/* CREW TAB — the people: Shift Start's teams, crew rotation and headcount, printed schedules */}
            {activeTab === 'crew' && (function() {
                const win = shiftWindows.find(function(w) { return w.key === activeBoardKey; }) || null;
                const crewLanes = win ? laneRoster.filter(function(l) { return l.crew === win.crew; }) : [];
                const style = getCrewStyle(win ? win.crew : '');
                const winLen = win ? win.end - win.start : 0;
                const leadsN = crewLanes.filter(function(l) { return l.isLead; }).length;
                const peopleN = crewLanes.length - leadsN;
                const blocksFor = function(lane) {
                    const w = scheduleData.workers[lane];
                    if (!w || !win) return [];
                    return w.schedule
                        .filter(function(s) { return s.end > win.start && s.start < win.end; })
                        .map(function(s) { return scheduleData.taskById[s.taskId]; })
                        .filter(Boolean);
