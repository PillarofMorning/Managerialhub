                                    const dd = deptOf(x.dept);
                                    return (
                                        <div key={x.id} data-dept-step-row={i} className={`rounded-lg border p-2 ${x.on ? 'border-slate-200' : 'border-slate-200 bg-slate-50 opacity-70'}`} style={{ borderLeft: `4px solid ${dd.color}` }}>
                                            <div className="flex flex-wrap items-center gap-2">
                                                <input type="checkbox" checked={x.on} onChange={function(e) { patchDeptStep(i, { on: e.target.checked }); }} title="Use this step" className="w-4 h-4 accent-[#0072CE]" />
                                                <select value={x.dept} onChange={function(e) { patchDeptStep(i, { dept: e.target.value }); }} className={inp} title="Which department does it">
