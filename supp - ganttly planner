    // a shift filter is on). Started / done blocks can be dragged too (corrects where the work happened).
    // ============================================================================
    const visibleLaneLo = ganttWindow ? (laneRoster.find(function(l) { return l.crew === ganttWindow.crew; }) || { lane: 0 }).lane : 0;
    const visibleLaneCount = ganttWindow ? laneRoster.filter(function(l) { return l.crew === ganttWindow.crew; }).length : laneRoster.length;

    useEffect(function() {
        const handlePointerMove = function(e) {
