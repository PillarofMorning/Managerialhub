                                            return (
                                                <div key={l.lane} className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden break-inside-avoid" style={gc ? { borderLeft: `6px solid ${gc}` } : undefined}>
                                                    <div className="px-4 py-3 border-b border-slate-100 flex items-center gap-3">
