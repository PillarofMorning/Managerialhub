                                                    <div className="flex items-center gap-2 h-[32px] md:h-[38px] px-2 bg-rose-50 rounded border border-rose-100 col-span-2">
                                                        <input type="checkbox" checked={roomAllergen[room] || false} onChange={function(e) { handleRoomAllergenChange(room, e.target.checked); }} className="w-4 h-4 md:w-5 md:h-5 accent-rose-600 cursor-pointer" />
