                                    <button data-dash-collapse onClick={function() { setAllDashboardRooms(true); }} className="px-2 py-1.5 text-xs font-extrabold rounded-[10px] border border-slate-300 text-slate-700 hover:bg-slate-50 shadow-sm bg-white">Fold all rooms</button>
