                                            {shiftWindows.map(function(w) {
                                                return <option key={w.key} value={w.key}>{w.crew} crew · {formatClockTime(ganttStartDate, ganttStartHour, w.shiftStart)}{currentWindow && currentWindow.key === w.key ? '  (now)' : ''}</option>;
