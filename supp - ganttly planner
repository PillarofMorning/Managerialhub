                                    <span className="flex items-center gap-2">Production restarts:
                                        <input data-restart-input type="datetime-local" value={roomRestarts[room] || (hi && hi.restart !== null && hi.restart !== undefined ? msToLocalInput(hi.restart) : '')} onChange={function(e) { const v = e.target.value; setRoomRestarts(function(prev) { const n = Object.assign({}, prev); if (v) n[room] = v; else delete n[room]; return n; }); }} className="w-40 text-center font-bold text-xs outline-none border-b border-slate-300 bg-transparent no-pan" />
                                        <span className={`text-[10px] ${(hi && hi.restartSrc === 'none') || (hi && hi.restartSrc !== 'typed' && roomRestarts[room]) ? 'text-amber-700' : 'text-slate-400'}`}>{hi && hi.restartSrc === 'typed' ? 'typed in' : roomRestarts[room] ? 'ignored: it has to be after the stop and within 4 days of the end of the plan' : hi && hi.restartSrc === 'schedule' ? 'from the production schedule' : 'not known: type it to place the steps that count back from it'}</span>
                                        {roomRestarts[room] && <button data-restart-clear onClick={function() { setRoomRestarts(function(prev) { const n = Object.assign({}, prev); delete n[room]; return n; }); }} className="text-[10px] font-bold text-[#0072CE] hover:text-[#00468B] underline" title="Remove the typed restart and follow the production schedule again">use the schedule</button>}
                                    </span>
                                </div>
                            )}
                            <div className="space-y-2">
                                {m.steps.length === 0 && <div className="text-[11px] font-bold text-slate-400">No steps: this room shows no department lanes.</div>}
