                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Total Mins</label>
                                    <input type="number" min="15" step="15" value={newTaskMins} onChange={function(e) { setNewTaskMins(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Heads</label>
                                    <input type="number" min="1" value={newTaskHeads} onChange={function(e) { setNewTaskHeads(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                                <div className="w-20">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Priority</label>
                                    <input type="number" min="1" value={newTaskPriority} onChange={function(e) { setNewTaskPriority(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none text-center" />
                                </div>
                            </div>
                            <Button className="w-full mt-4" onClick={handleAddCustomTask}>Create Task</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* WHY IS THIS STRETCH BLANK? (PBED hover box; a click keeps it open) */}
            {!IS_CURRENT && idleTip && (
                <div ref={idleTipRef} data-idle-tip={idleTip.pinned ? 'pinned' : 'hover'} className={'fixed z-[120] w-[340px] max-w-[calc(100vw-16px)] bg-white border border-[#FFB81C] rounded-xl shadow-2xl p-3 text-slate-700 ' + (idleTip.pinned ? '' : 'pointer-events-none')} style={(function() {
                    const vw = typeof window !== 'undefined' ? window.innerWidth : 1200;
                    const bx = idleTipBox(idleTip.x, idleTip.y, Math.min(340, vw - 16));
                    const st = { left: bx.left + 'px', maxHeight: bx.maxHeight + 'px', overflowY: 'auto' };
                    if (bx.top !== null) st.top = bx.top + 'px'; else st.bottom = bx.bottom + 'px';
                    return st;
                })()} onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                    <div className="flex items-start justify-between gap-2 mb-1.5">
                        <div data-idle-tip-head className="text-[11px] font-black text-[#8A5A00] leading-snug">{idleTip.head}</div>
                        {idleTip.pinned && <button data-idle-tip-close onClick={function() { setIdleTip(null); }} className="text-slate-400 hover:text-slate-800 text-xs font-black px-1">✕</button>}
