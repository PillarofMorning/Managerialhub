        return { lane: l.lane, crew: l.crew, name: l.name, isLead: l.isLead, isPlaceholder: l.isPlaceholder, availMins: availMins, bookedMins: bookedMins, doneMins: doneMins, tasks: tasks, done: done, late: late };
    });

    // Per-crew utilization inside the plan window.
    // Leads are shown on the Gantt but are not cleaners, so they stay out of crew load and payroll.
    const crewStats = [];
    workerStats.filter(function(ws) { return !ws.isLead; }).forEach(function(ws) {
        let cs = crewStats.find(function(c) { return c.crew === ws.crew; });
        if (!cs) {
            cs = { crew: ws.crew, heads: 0, availMins: 0, bookedMins: 0, doneMins: 0, shifts: shiftWindows.filter(function(w) { return w.crew === ws.crew; }) };
            crewStats.push(cs);
        }
        cs.heads += 1;
        cs.availMins += ws.availMins;
        cs.bookedMins += ws.bookedMins;
        cs.doneMins += ws.doneMins;
    });
    const payrollMins = crewStats.reduce(function(acc, c) { return acc + c.availMins; }, 0);
    const bookedMinsTotal = crewStats.reduce(function(acc, c) { return acc + c.bookedMins; }, 0);
    const money = function(mins) { return '$' + ((mins / 60) * hourlyRate).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); };

    // Rooms with planned equipment, plus rooms only kept for the started / checked-off parts of equipment taken out of cleaning.
    const ganttRooms = {};
    scheduleData.groups.forEach(function(g) { ganttRooms[g.name] = true; });
    const shownRooms = activeRooms.filter(function(r) { return plannedRooms.indexOf(r) > -1 || !!ganttRooms[r]; });

    // Per-room rollup.
    const roomStats = shownRooms.map(function(room) {
        const g = scheduleData.groups.find(function(x) { return x.name === room; });
        const blocks = g ? g.tasks : [];
        let start = Infinity, end = 0, mp = 0, wt = 0, wd = 0, late = 0;
        blocks.forEach(function(t) {
            start = Math.min(start, t.startMin);
            end = Math.max(end, t.startMin + t.finalDuration);
            mp += t.finalDuration * t.appliedHeads;
            wt += t.rawWorkloadMins;
            if (t.isComplete) wd += t.rawWorkloadMins;
            if (isLate(t)) late++;
        });
        const overflow = scheduleData.unscheduled.filter(function(t) { return t.originalArea === room; });
        overflow.forEach(function(t) { wt += t.rawWorkloadMins; });
        const parentsHere = scheduleData.parents.filter(function(p) { return p.area === room && !p.removed; });
        return {
            room: room, start: start === Infinity ? 0 : start, end: end, manpowerMins: mp,
            pct: wt > 0 ? Math.round((wd / wt) * 100) : 0, late: late, overflow: overflow.length,
            equipCount: parentsHere.length,
            equipDone: parentsHere.filter(function(p) { return (p.blocks.length > 0 || (IS_CURRENT && p.lastDoneMs > 0)) && p.unscheduledWork === 0 && p.blocks.every(function(b) { return b.isComplete; }); }).length
        };
    });
    // PBED: how many shifts run a board saved in Shift Start (they keep their crews, so no room is asked to be finished first there).
    const savedBoardShifts = IS_CURRENT ? 0 : shiftWindows.filter(function(w) { const b = windowBoards[w.key]; return !!b && !!b[0] && !b[0].fromAuto && !!windowPlans[w.key] && Object.keys(windowPlans[w.key].lineWorkers || {}).length > 0; }).length;
    // PBED: the production rooms each shift finishes (all its work placed, the last of it ending inside the shift); `carried` = it was started in an earlier shift.
    // `first` = the rooms the plan asked that shift to finish before anything else (see the focus rooms in the engine); `notDone` = the ones it could not.
    const focusOfWindow = function(w) {
        const list = IS_CURRENT || !planFresh ? [] : (scheduleData.focus || []);
        for (let i = 0; i < list.length; i++) if (list[i].start === w.start && list[i].crews.indexOf(w.crew) > -1) return list[i];
        return null;
    };
    const shiftRooms = IS_CURRENT ? [] : shiftWindows.map(function(w) {
        const fl = focusOfWindow(w), first = fl ? fl.rooms : [];
        const areasOf = function(f) { return f.areas || [f.name]; };   // a Clean Together group is one focus room of several areas
        const isFirst = function(room) { return first.some(function(f) { return areasOf(f).indexOf(room) > -1; }); };
        const done = roomStats.filter(function(r) { return !isSupportRoom(r.room) && r.end > 0 && r.overflow === 0 && r.end > w.start + 0.01 && r.end <= w.end + 0.01; })
            .sort(function(a, b) { return a.end - b.end || a.room.localeCompare(b.room); })
            .map(function(r) { return { room: r.room, carried: r.start < w.start - 0.01, first: isFirst(r.room) }; });
        const notDone = first.filter(function(f) { return (f.left > 1 || f.finish > w.end + 0.01) && areasOf(f).every(function(a) { return done.every(function(d) { return d.room !== a; }); }); });
        // a focus room that did finish but that the list above cannot hold (a support room, or a Clean Together group), starred too
        const extra = first.filter(function(f) { return notDone.indexOf(f) === -1 && areasOf(f).every(function(a) { return done.every(function(d) { return d.room !== a; }); }); })
            .map(function(f) { return { room: f.name, carried: !!f.carried, first: true }; });
        return { w: w, done: done.concat(extra), first: first, notDone: notDone };
    });
    // The Metrics table: production rooms, then a Support band that folds the support rooms away (open when there is nothing above it).
    const roomStatRows = (function() {
        const prod = roomStats.filter(function(r) { return !isSupportRoom(r.room); }), sup = roomStats.filter(function(r) { return isSupportRoom(r.room); });
        if (!sup.length || !prod.length) return prod.concat(sup);
        const open = isSupportOpen('metrics');
        return prod.concat([{ band: true, n: sup.length, open: open }]).concat(open ? sup : []);
    })();

    // ---- PBED's Generic view: each room's equipment laid end to end by priority, from when the room is handed over ----
    // Nothing else is considered (no shifts, breaks, crews, Max Workers, roles or time blocks): it shows the work, not the plan. The pieces are
    // exactly the ones the engine planned (hidden rooms, removed pieces and pieces not in the plan are already out), each as long as its
    // work divided by the people it needs. Order inside a room: priority (1 first), then the bigger job, then the equipment list's order.
    const genericView = !IS_CURRENT && activeTab === 'gantt' && ganttView === 'generic';
    const gen = (function() {
        const out = { rooms: [], maxEnd: 0 };
        if (!genericView) return out;
        const assetOf = {};
        assets.forEach(function(a, i) { assetOf[a.id] = { a: a, idx: i }; });
        const byRoom = {};
        scheduleData.parents.forEach(function(p) {
            if (p.removed || !assetOf[p.id]) return;
            const ref = assetOf[p.id], area = String(p.area), heads = Math.max(1, Number(p.heads) || 1), work = Number(p.totalWork) || 0;
            const done = p.blocks.length > 0 && p.unscheduledWork === 0 && p.blocks.every(function(b) { return b.isComplete; });
            (byRoom[area] = byRoom[area] || []).push({
                id: p.id, parentId: p.id, originalArea: area, name: p.name, priority: Number(ref.a.priority) || 2, idx: ref.idx, work: work, heads: heads, dur: work / heads,
                fn: fnLabelOf(ref.a), done: done, started: !done && p.blocks.some(function(b) { return b.isInProgress; })
            });
        });
        Object.keys(byRoom).forEach(function(area) {
            const hm = handoffMs[area];
            const start = hm !== undefined && hm !== null ? Math.max(0, Math.round((hm - globalStartMs) / 60000)) : 0;
            let cur = start, work = 0, doneN = 0, peak = 1;
            const steps = byRoom[area].sort(function(a, b) { return a.priority - b.priority || b.work - a.work || a.idx - b.idx; });
            steps.forEach(function(st, i) {
                st.n = i + 1; st.startMin = cur; cur += st.dur; st.endMin = cur;
                work += st.work; if (st.done) doneN++; if (st.heads > peak) peak = st.heads;
            });
            out.rooms.push({ name: area, support: isSupportRoom(area), priority: roomPriority[area] || 2, start: start, end: cur, steps: steps, work: work, doneN: doneN, peak: peak });
            if (cur > out.maxEnd) out.maxEnd = cur;
        });
        return out;
    })();
    // How far the department lanes reach (rooms that have work in the plan only), so the axis is long enough to show the restart steps.
    const deptEnd = (function() {
        if (IS_CURRENT || activeTab !== 'gantt' || ganttView === 'people') return 0;
        const inChart = {};
        if (genericView) gen.rooms.forEach(function(r) { inChart[r.name] = true; }); else scheduleData.groups.forEach(function(g) { inChart[g.name] = true; });
        let m = 0;
        Object.keys(deptPlan.byRoom).forEach(function(a) { if (inChart[a]) deptPlan.byRoom[a].steps.forEach(function(st) { if (deptShow[st.dept] && st.end > m) m = st.end; }); });
        return m;
    })();
    const dynamicTotalHours = Math.max(Math.ceil(planHorizonMins / 60), Math.ceil(globalMaxEnd / 60), Math.ceil(gen.maxEnd / 60), Math.ceil(deptEnd / 60)) + 2;
    const GANTT_TOTAL_WIDTH_PX = dynamicTotalHours * zoomLevel + (stack ? stack.gapCount * INTERRUPT_PX : 0);
    const hourStep = zoomLevel < 25 ? 4 : IS_CURRENT && zoomLevel >= 70 ? 1 : 2;
    const TIME_MARKERS = Array.from({ length: Math.ceil(dynamicTotalHours / hourStep) + 1 }, function(_, i) { return i * hourStep; });

    const activeEditorTask = selectedTaskEditor ? scheduleData.taskById[selectedTaskEditor] || null : null;

    // Grey "off shift" bands per lane (time outside that worker's crew windows).
    const ganttTotalMins = dynamicTotalHours * 60;
    const laneOffShift = laneRoster.map(function(l) {
        const gaps = [];
        let cursor = 0;
        l.windows.forEach(function(w) {
            if (w.start > cursor) gaps.push({ start: cursor, end: w.start });
            cursor = Math.max(cursor, w.end);
        });
        if (cursor < ganttTotalMins) gaps.push({ start: cursor, end: ganttTotalMins });
        return gaps;
    });
    // ---- Support duty (PBED, see SUPPORT DUTY): what the free stretches of support roles and extra heads are called ----
    // The room a role works in: an equipment area named for it (Janitorial, Chemical, Admin, a Trash room), else an MSS area, else none (the
    // block then belongs to a room named after the role, like "Trash").
    const dutyRoomOf = function(role) {
        const words = role === 'trash' ? ['trash', 'garbage', 'waste', 'refuse'] : [role];
        const names = [];
        assets.forEach(function(a) { const k = String(a.area); if (names.indexOf(k) === -1) names.push(k); });
        lineIndex.forEach(function(l) { if (names.indexOf(l.name) === -1) names.push(l.name); });
        return names.filter(function(n) { return wordsOf(n).some(function(x) { return words.indexOf(x) > -1; }); })[0] || '';
    };
    const dutyPlan = (function() {
        const none = { on: false, blocks: [], byLane: {}, bars: {}, extras: {}, slots: {}, mins: 0, rooms: {} };
        if (!dutyActive || IS_CURRENT || !planFresh || !scheduleData.workers) return none;
        const roomName = {};
        DUTY_ROLES.forEach(function(r) { roomName[r.id] = dutyRoomOf(r.id) || r.label; });
        const roomIdOf = function(label) { const l = lineForArea(lineIndex, label); return l ? l.id : 't:' + normS(label); };
        const res = planSupportDuty({
            workers: laneRoster.map(function(l) { const w = scheduleData.workers[l.lane]; return { lane: l.lane, crew: l.crew, kind: l.kind, isLead: l.isLead, windows: l.windows, gaps: w && w.idleGaps ? w.idleGaps : [] }; }),
            shifts: shiftWindows.map(function(w) { return { key: w.key, crew: w.crew, start: w.start, end: w.end }; }),
            heads: dutyHeads,
            pref: function(lane, role) { const e = expMap.exp[laneRoster[lane].empId]; return e ? (e[roomIdOf(roomName[role])] || 0) : 0; }
        });
        const out = { on: true, blocks: [], byLane: {}, bars: {}, extras: res.extras, slots: res.slots, mins: 0, rooms: roomName };
        res.blocks.forEach(function(b) {
            const r = dutyRoleOf(b.role);
            const blk = Object.assign({}, b, { label: r.label, color: r.color, room: roomName[b.role] });
            out.blocks.push(blk);
            (out.byLane[b.lane] = out.byLane[b.lane] || []).push(blk);
            out.mins += b.end - b.start;
        });
        // What is drawn: a person's duty in one shift is one bar, carried over a break or pause (no task of theirs stands between), so a
        // support role reads as a continuous lane with the equipment on top. The minutes counted are the real free stretches only.
        Object.keys(out.byLane).forEach(function(k) {
            const wk = scheduleData.workers[Number(k)];
            const busy = wk ? wk.schedule : [];
            const merged = [];
            out.byLane[k].slice().sort(function(a, b) { return a.start - b.start; }).forEach(function(b) {
                const prev = merged[merged.length - 1];
                if (prev && prev.role === b.role && prev.shiftKey === b.shiftKey && !busy.some(function(x) { return x.start < b.start - 0.01 && x.end > prev.end + 0.01; })) { prev.end = Math.max(prev.end, b.end); prev.mins += b.end - b.start; }
                else merged.push(Object.assign({}, b, { mins: b.end - b.start }));   // mins = the real free time inside the bar (a break stays out of it)
            });
            out.bars[k] = merged;
        });
        return out;
    })();
    // Blank space on shift per lane (what the waterfall couldn't fill), outlined in yellow on the Gantt. Support duty is not blank space.
    const laneIdle = laneRoster.map(function(l) {
        const w = scheduleData.workers[l.lane];
        let raw = w && w.idleGaps ? w.idleGaps : [];
        if (dutyPlan.on && dutyPlan.byLane[l.lane]) raw = gapsMinus(raw, dutyPlan.byLane[l.lane]);
        // An area role (Ganttly): the volume is not known ahead, so time without a task is the area's, never blank space.
        const gaps = IS_CURRENT && isAreaRoleKind(l.kind) && !l.isLead ? [] : raw.filter(function(g) { return g.end - g.start >= IDLE_SHOW_MINS; });
        return { gaps: gaps, mins: gaps.reduce(function(a, g) { return a + (g.end - g.start); }, 0) };
    });
    // One support-duty bar (PBED), cut to [lo, hi): `top` / `height` place it on its line. Hover says what it is and why.
    const renderDutyBar = function(b, l, seat, row, bi) {
        const s = Math.max(b.start, seat.start), e = Math.min(b.end, seat.end);
        if (e - s < 1) return null;
        const leftPx = xOf(s);
        if (leftPx >= GANTT_TOTAL_WIDTH_PX) return null;
        const widthPx = Math.min(xEnd(e) - leftPx, GANTT_TOTAL_WIDTH_PX - leftPx);
        if (widthPx < 2) return null;
        return dutyBarEl(b, l, 'duty-' + l.lane + '-' + seat.start + '-' + bi, leftPx, widthPx, row * LANE_HEIGHT_PX + 3, LANE_HEIGHT_PX - 6, s, e);
    };
    const dutyBarEl = function(b, l, key, leftPx, widthPx, top, height, s, e) {
