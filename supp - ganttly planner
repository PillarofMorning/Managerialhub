            {/* DASHBOARD (EQUIPMENT) TAB */}
            {activeTab === 'equipment' && (
                <div className="flex-1 overflow-y-auto bg-[#F7F9FC] p-6 touch-pan flex justify-center">
                    <div className="w-full max-w-6xl bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden flex flex-col h-fit">
                        <div className="bg-slate-50 border-b border-gray-200 px-6 py-5 shadow-sm z-10 flex justify-between items-center">
