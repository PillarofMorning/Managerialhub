                            </div>
                            <div className="mt-2"><Button variant="outline" size="sm" onClick={addDeptStep} className="text-[#00468B] border-[#B3D4F2] hover:bg-[#E6F1FB] px-2 py-1 text-[11px]">+ Add a step</Button></div>
                            {m.drafts && Object.keys(m.drafts).length > 0 && <div data-dept-drafts className="mt-3 text-[11px] font-bold text-amber-700">Not saved yet: {Object.keys(m.drafts).map(function(k) { return k === '*' ? 'every room' : k; }).join(', ')}. Pick {Object.keys(m.drafts).length === 1 ? 'that room' : 'those rooms'} again and press Save steps to keep the changes; closing this window drops them.</div>}
                            {m.err && <div data-dept-error className="mt-3 text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 rounded p-2">{m.err}</div>}
                            <div className="flex gap-2 mt-4">
                                <Button className="flex-1" onClick={saveDept}>Save steps</Button>
                                {(m.own || deptSteps[room]) && <Button variant="outline" onClick={resetDept} title={room === '*' ? 'Go back to the standard steps' : 'Follow the steps set for every room again'}>{room === '*' ? 'Back to the standard steps' : 'Use the shared steps'}</Button>}
                            </div>
                        </div>
                    </div>
                );
            })()}

            {/* TIME BLOCK MODAL (PBED) */}
            {blockModal && (
                <div data-block-modal className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setBlockModal(null); }}>
                    <div className="bg-white p-5 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200 max-h-full overflow-y-auto" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-3 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">{blockModal.id ? 'Change time block' : 'Add a time block'}</h3>
                            <Button variant="outline" size="sm" onClick={function() { setBlockModal(null); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-[11px] font-bold text-slate-500 mb-3">Time put aside for the room (or the whole plant): nothing is cleaned there while the block runs, and the Gantt shows it.</div>
                        <div className="space-y-3">
                            <div className="flex flex-wrap gap-2">
                                {BLOCK_KINDS.map(function(k) {
                                    const on = blockModal.kind === k.id;
                                    return <button key={k.id} data-block-kind={k.id} onClick={function() { patchBlock({ kind: k.id }); }} className="flex-1 rounded-lg border-2 px-2 py-1.5 text-xs font-black no-pan" style={on ? { backgroundColor: k.color, borderColor: k.color, color: textOnHex(k.color) } : { borderColor: k.color, color: '#334155' }}>{k.label}</button>;
                                })}
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Name (optional)</label>
                                <input type="text" data-block-label value={blockModal.label} onChange={function(e) { patchBlock({ label: e.target.value }); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder={'e.g. ' + (blockModal.kind === 'inspection' ? 'Pre-op inspection' : blockModal.kind === 'maintenance' ? 'Belt change' : 'New guard install')} />
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Where</label>
                                <select data-block-room value={blockModal.room} onChange={function(e) { patchBlock({ room: e.target.value }); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none bg-white">
                                    <option value="">Whole plant (nobody cleans)</option>
                                    {allUniqueRooms.filter(function(r) { return !isSupportRoom(r); }).map(function(r) { return <option key={r} value={r}>{r}</option>; })}
                                    {allUniqueRooms.some(isSupportRoom) && <optgroup label="Support">{allUniqueRooms.filter(isSupportRoom).map(function(r) { return <option key={r} value={r}>{r}</option>; })}</optgroup>}
                                </select>
                            </div>
                            <div className="grid grid-cols-2 gap-3">
                                <div className="min-w-0">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Date</label>
                                    <input type="date" data-block-date value={blockModal.date} onChange={function(e) { patchBlock({ date: e.target.value }); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="min-w-0">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Starts</label>
                                    <input type="time" data-block-time value={blockModal.time} onChange={function(e) { patchBlock({ time: e.target.value }); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Length (minutes)</label>
                                <div className="flex flex-wrap gap-2 items-center">
                                    <input type="number" data-block-duration min="5" step="5" value={blockModal.duration} onChange={function(e) { patchBlock({ duration: e.target.value }); }} className="w-24 border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                    {[30, 60, 120, 240].map(function(m) { return <button key={m} onClick={function() { patchBlock({ duration: m }); }} className="text-[11px] font-black rounded border border-slate-300 px-2 py-1 text-slate-600 hover:bg-slate-50 no-pan">{fmtMins(m)}</button>; })}
                                </div>
                            </div>
                            <div className="flex gap-3 items-center flex-wrap">
                                <label className="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer"><input type="checkbox" data-block-repeat checked={blockModal.repeat === 'daily'} onChange={function(e) { patchBlock({ repeat: e.target.checked ? 'daily' : 'none' }); }} className="w-4 h-4 accent-[#0072CE]" /> Same time every day of the plan</label>
                                <span className="ml-auto flex items-center gap-1.5 text-[11px] font-bold text-slate-500">Color
                                    <input type="color" data-block-color value={hexOr(blockModal.color) || blockKindOf(blockModal.kind).color} onChange={function(e) { patchBlock({ color: e.target.value }); }} className="w-7 h-7 p-0 border border-slate-300 rounded cursor-pointer no-pan bg-white" />
                                    {hexOr(blockModal.color) && <button onClick={function() { patchBlock({ color: '' }); }} title="Back to the standard color" className="text-[11px] font-black text-slate-400 hover:text-rose-600">×</button>}
                                </span>
                            </div>
                            {blockModal.err && <div data-block-error className="text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 rounded p-2">{blockModal.err}</div>}
                            <div className="flex gap-2 pt-1">
                                <Button className="flex-1" onClick={saveBlock}>{blockModal.id ? 'Save changes' : 'Add time block'}</Button>
                                {blockModal.id && <Button variant="danger" onClick={function() { deleteBlock(blockModal.id); }}>Remove</Button>}
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* DOWN LINE MODAL (Ganttly) */}
            {downModal && (
                <div data-down-modal className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setDownModal(null); }}>
                    <div className="bg-white p-5 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200 max-h-full overflow-y-auto" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-3 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">{downModal.id ? 'Change down line' : 'Add a down line'}</h3>
                            <Button variant="outline" size="sm" onClick={function() { setDownModal(null); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-[11px] font-bold text-slate-500 mb-3">A production line that stopped. Its rooms are free to clean from then on, and are closed again when the line restarts. It counts from 24 hours before it stops until 12 hours after it restarts, then it is forgotten (the rooms go back to normal).</div>
                        <div className="space-y-3">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Line</label>
                                <select data-down-line value={downModal.typed ? '__typed' : downModal.lineId} onChange={function(e) { pickDownLine(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none bg-white">
                                    <option value="">Pick a line…</option>
                                    {lineIndex.some(function(l) { return l.prod; }) ? (
                                        <React.Fragment>
                                            <optgroup label="Production lines">{lineIndex.filter(function(l) { return l.prod; }).sort(byNameNum).map(function(l) { return <option key={l.id} value={l.id}>{l.name}</option>; })}</optgroup>
                                            <optgroup label="Other areas">{lineIndex.filter(function(l) { return !l.prod; }).sort(byNameNum).map(function(l) { return <option key={l.id} value={l.id}>{l.name}</option>; })}</optgroup>
                                        </React.Fragment>
                                    ) : lineIndex.slice().sort(byNameNum).map(function(l) { return <option key={l.id} value={l.id}>{l.name}</option>; })}
                                    <option value="__typed">A line that isn't in the list (type its name)…</option>
                                </select>
                                {downModal.typed && <input type="text" data-down-typed value={downModal.line} onChange={function(e) { typeDownLine(e.target.value); }} className="w-full mt-2 border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="Name of the line, e.g. Packaging 2" />}
                            </div>
                            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div className="min-w-0">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Went down</label>
                                    <input type="datetime-local" data-down-start value={downModal.startStr} onChange={function(e) { patchDown({ startStr: e.target.value }); }} className="w-full min-w-0 border border-slate-300 rounded p-2 text-xs font-bold outline-none" />
                                </div>
                                <div className="min-w-0">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Restarts</label>
                                    <input type="datetime-local" data-down-end disabled={!downModal.hasEnd} value={downModal.endStr} onChange={function(e) { patchDown({ endStr: e.target.value }); }} className="w-full min-w-0 border border-slate-300 rounded p-2 text-xs font-bold outline-none disabled:bg-slate-100 disabled:text-slate-400" />
                                </div>
                            </div>
                            <label className="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer"><input type="checkbox" data-down-open checked={!downModal.hasEnd} onChange={function(e) { patchDown({ hasEnd: !e.target.checked, endStr: e.target.checked ? '' : (downModal.endStr || msToLocalInput(localInputMs(downModal.startStr) + 4 * 3600000)) }); }} className="w-4 h-4 accent-[#0072CE]" /> Not known yet (down until it is changed here)</label>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Rooms that are free to clean</label>
                                <div data-down-rooms className="flex flex-wrap gap-1.5 mb-1.5">
                                    {downModal.rooms.length === 0 && <span className="text-[11px] font-bold text-amber-700">{downModal.line ? 'No room is named like this line. Add the rooms below.' : 'Pick the line first.'}</span>}
                                    {downModal.rooms.map(function(r) {
                                        return <span key={r} data-down-room={r} className="flex items-center gap-1 text-[11px] font-bold rounded-full bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2] px-2 py-0.5">{r}<button onClick={function() { toggleDownRoom(r, false); }} title="Take this room off" className="text-[12px] leading-none font-black text-slate-400 hover:text-rose-600 no-pan">×</button></span>;
                                    })}
                                </div>
                                <select data-down-add-room value="" onChange={function(e) { if (e.target.value) toggleDownRoom(e.target.value, true); }} className="w-full border border-slate-300 rounded p-1.5 text-xs font-bold outline-none bg-white">
                                    <option value="">+ Add another room…</option>
                                    {allUniqueRooms.filter(function(r) { return downModal.rooms.indexOf(r) === -1; }).map(function(r) { return <option key={r} value={r}>{r}{isSupportRoom(r) ? ' (support)' : ''}</option>; })}
                                </select>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Note (optional)</label>
                                <input type="text" data-down-note value={downModal.note} onChange={function(e) { patchDown({ note: e.target.value }); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Motor swap, back up at shift change" />
                            </div>
                            {downModal.err && <div data-down-error className="text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 rounded p-2">{downModal.err}</div>}
                            <div className="flex gap-2 pt-1">
                                <Button className="flex-1" onClick={saveDown}>{downModal.id ? 'Save changes' : 'Add down line'}</Button>
                                {downModal.id && <Button variant="danger" onClick={function() { deleteDown(downModal.id); }}>Remove</Button>}
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* ROOM DOWNTIME MODAL */}
            {isRoomDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsRoomDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">{dtTarget === 'GLOBAL' ? 'Add Global Downtime' : 'Add Room Downtime'}</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsRoomDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-[#0072CE] mb-4 bg-[#E6F1FB] p-2 rounded">Target: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Chemical Refill" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime(dtTarget === 'GLOBAL' ? 'global' : 'room'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* EQUIP DOWNTIME MODAL */}
            {isEquipDtModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsEquipDtModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Equipment Downtime</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsEquipDtModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="text-xs font-bold text-[#0072CE] mb-4 bg-[#E6F1FB] p-2 rounded">Target Equipment ID: {dtTarget}</div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Event Label</label>
                                <input type="text" value={newDtLabel} onChange={function(e) { setNewDtLabel(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Blade Swap" />
                            </div>
                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Date</label>
                                    <input type="date" value={newDtDate} onChange={function(e) { setNewDtDate(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Time</label>
                                    <input type="time" value={newDtTime} onChange={function(e) { setNewDtTime(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Duration (Mins)</label>
                                <input type="number" min="15" step="15" value={newDtDuration} onChange={function(e) { setNewDtDuration(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" />
                            </div>
                            <Button className="w-full mt-4" onClick={function() { addDowntime('equipment'); }}>Add Interruption</Button>
                        </div>
                    </div>
                </div>
            )}

            {/* POPUP EDITOR FOR TASKS */}
            {selectedTaskEditor && activeEditorTask && (function() {
                const t = activeEditorTask;
                const parentAsset = assets.find(function(a) { return a.id === t.parentId; });
                const onShiftLanes = laneRoster.filter(function(o) { return scheduleData.workers[o.lane] && scheduleData.workers[o.lane].windowAt(Math.max(0, t.startMin)) && scheduleData.workers[o.lane].canDo(t.kind, scheduleData.isNightAt(Math.max(0, t.startMin))); });
                const close = function() { setSelectedTaskEditor(null); };
                return (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 animate-in fade-in duration-200 touch-none" onPointerDown={close}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>

                        <div className="flex justify-between items-start border-b border-slate-100 pb-4 mb-4">
                            <div>
                                <h3 className="text-lg font-black text-slate-800 leading-tight">{t.name}</h3>
                                <p className="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1 flex items-center"><MapPin className="w-3 h-3 mr-1"/> {t.originalArea}</p>
                                <div className="flex items-center gap-2 mt-2">
                                    {statusChip(t)}
                                    <span className="text-[11px] text-slate-600 font-bold">{timeRange(t)}</span>
                                </div>
                            </div>
                            <Button variant="outline" size="sm" onClick={close} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>

                        <div className="space-y-4">
                            <div className="grid grid-cols-3 gap-2">
                                <Button variant="outline" disabled={t.isInProgress || t.isComplete} onClick={function() { setBlockStatus(t, 'started'); }}><Play className="w-4 h-4 mr-1" /> Start</Button>
                                <Button variant="success" disabled={t.isComplete} onClick={function() { setBlockStatus(t, 'done'); close(); }}><Check className="w-4 h-4 mr-1" /> Done</Button>
                                <Button variant="outline" disabled={!t.isFrozen} onClick={function() { setBlockStatus(t, null); }} title={parentAsset && parentAsset.removed ? "Undo check-off. This equipment is taken out of cleaning on the Dashboard, so the block is dropped and nothing is re-planned (Put back on the Dashboard to plan it again)." : "Undo check-off and let the planner re-plan this work"}>Undo</Button>
                            </div>

                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Assigned Workers</label>
                                <div className="space-y-1.5">
                                    {t.assignedLanes.map(function(l) {
                                        const lr = laneRoster[l];
                                        if (!lr) return null;
                                        return (
                                            <div key={l} className="flex items-center gap-2">
                                                <span className={`text-[10px] font-black rounded px-1.5 py-0.5 ${getCrewStyle(lr.crew).badge}`}>{lr.crew}</span>
                                                <select value={l} onChange={function(e) { reassignWorker(t, l, Number(e.target.value)); }} className="flex-1 border border-slate-300 rounded-lg p-1.5 text-sm font-bold outline-none cursor-pointer">
                                                    {onShiftLanes.concat(onShiftLanes.some(function(o) { return o.lane === l; }) ? [] : [lr]).map(function(o) {
                                                        const ws = workerStats[o.lane];
                                                        return <option key={o.lane} value={o.lane} disabled={o.lane !== l && t.assignedLanes.indexOf(o.lane) > -1}>{o.name} ({o.crew}) — {ws ? (ws.bookedMins / 60).toFixed(1) : 0}h assigned</option>;
                                                    })}
                                                </select>
                                            </div>
                                        );
                                    })}
                                </div>
                                {t.isSplitPart1 && <p className="text-[11px] font-bold text-amber-700 mt-2">{t.handedOver ? 'The rest is handed over to a later shift.' : 'The rest continues later in this shift.'}</p>}
                                {t.isSplitPart2 && !t.isFrozen && <p className="text-[11px] font-bold text-amber-700 mt-2">Continues work from an earlier part{t.handoverAdded ? ` (+${handoverMins}m/head handover)` : ''}.</p>}
                                {t.hasConflict && <p className="text-[11px] font-bold text-amber-700 mt-2">A worker on this block is double-booked — reassign or move one of the overlapping tasks.</p>}
                                {t.roleMismatch && <p className="text-[11px] font-bold text-rose-700 mt-2">A worker on this block is not allowed this kind of task ({(WORK_KINDS.find(function(k) { return k.id === t.kind; }) || {}).label}) — reassign to the right role.</p>}
                                {t.isOffShift && <p className="text-[11px] font-bold text-rose-700 mt-2">This block sits outside an assigned worker's shift.</p>}
                            </div>

                            <div className="flex gap-4">
                                <div className="flex-1">
                                    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Clock className="w-3 h-3 mr-1"/> Start</label>
                                    <input type="datetime-local" value={getDatetimeLocalString(t.startMin, ganttStartDate, ganttStartHour)} onChange={function(e) {
                                        const ms = new Date(e.target.value).getTime();
                                        if (!isNaN(ms)) moveBlock(t, Math.round((ms - globalStartMs) / 60000), t.assignedLanes);
                                    }} className="w-full text-center border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none" />
                                </div>
                                {parentAsset && (
                                    <div className="w-24">
                                        <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5 flex items-center"><Users className="w-3 h-3 mr-1"/> Heads</label>
                                        <input type="number" min="1" value={parentAsset.heads} onChange={function(e) { handleTaskHeadsChange(parentAsset.id, e.target.value); }} className="w-full text-center border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none" />
                                    </div>
                                )}
                            </div>

                            {overrides[t.id] && !t.isFrozen && (
                                <Button className="w-full bg-slate-100 text-slate-700 hover:bg-slate-200 shadow-none border border-slate-300" variant="outline" onClick={function() { clearOverride(t.id); close(); }}>
                                    <RefreshCw className="w-4 h-4 mr-2" /> Undo Move & Auto-Schedule
                                </Button>
                            )}
                        </div>
                    </div>
                </div>
                );
            })()}
        </div>
    );
}
