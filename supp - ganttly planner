                                                {x.on && x.anchor === 'after' && !m.steps.slice(0, i).some(function(y) { return y.on && y.dept === x.dept; }) && <span data-dept-orphan className="text-[10px] text-amber-700">no earlier {x.dept} step, so this one is not drawn</span>}
