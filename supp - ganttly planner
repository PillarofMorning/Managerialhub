                let newMin = stack ? stack.minOf(stack.xOf(dragState.initialMin) + deltaX) : dragState.initialMin + (deltaX / zoomLevel) * 60;
                newMin = Math.max(0, Math.round(newMin / 15) * 15);
                let newLane = dragState.initialLane + Math.round(deltaY / LANE_HEIGHT_PX);
                newLane = Math.max(visibleLaneLo, Math.min(newLane, visibleLaneLo + visibleLaneCount - dragState.appliedHeads));
                let newLanes = null;
                if (stack) {
                    // one line: the row moves, and the lane is whoever sits on that row of the shift at the new time
                    const row = Math.max(0, Math.min(dragState.initialRow + Math.round(deltaY / LANE_HEIGHT_PX), stack.rows - 1));
                    newLanes = stack.lanesNear(row, newMin, dragState.appliedHeads);
                    if (!newLanes) return;
                    newLane = newLanes[0];
                } else if (focusRows) {
                    // Focus Mode on one shift: the rows are only the people shown, so the row picks the lane
                    const n = Math.max(1, dragState.appliedHeads), row = Math.max(0, Math.min(dragState.initialRow + Math.round(deltaY / LANE_HEIGHT_PX), focusRows.length - n));
                    newLanes = focusRows.slice(row, row + n);
                    if (newLanes.length) newLane = newLanes[0]; else newLanes = null;
                }

                // A pointer move that lands on the same 15-minute step and lane changes nothing: no re-render.
                setDragState(function(prev) {
                    if (prev && prev.currentMin === newMin && prev.currentLane === newLane && JSON.stringify(prev.currentLanes || null) === JSON.stringify(newLanes || null)) return prev;
                    return Object.assign({}, prev, { currentMin: newMin, currentLane: newLane, currentLanes: newLanes });
                });
            }
        };

        const handlePointerUp = function() {
            if (dragState) {
                if (draggedRef.current) {
                    const task = scheduleData.taskById[dragState.taskId];
                    if (task) moveBlock(task, dragState.currentMin, dragState.currentLanes || Array.from({ length: dragState.appliedHeads }, function(_, i) { return dragState.currentLane + i; }));
                }
