                                                <span className="flex items-center gap-1"><input type="number" min="0" max="50" value={x.heads} onChange={function(e) { patchDeptStep(i, { heads: e.target.value }); }} className={inp + ' w-12 text-center'} title="People the step needs (0 = none to count)" /> people</span>
                                            </div>
                                        </div>
