// ============================================================================
// 🚨 ARCHITECTURE NOTE: Shift-Aware Workers
// Each Gantt lane is one real person (or a placeholder seat) belonging to a crew (A/B/C/D).
// `windows` are the on-shift spans (mins from plan start) for that crew inside the planning
// window. A worker can only be booked inside a window, so the engine naturally hands work
// from one crew to the next at shift change.
class Worker {
    constructor(id, crew, name, windows) {
        this.id = id;
        this.crew = crew || '';
        this.name = name || ('Worker ' + (id + 1));
        this.windows = windows || [{ start: 0, end: Infinity }];
        this.schedule = []; 
        this.kind = 'general';
    }
    canDo(taskKindId, night) { return workerCanDo(this.kind, taskKindId, night); }
    windowAt(t) {
        return this.windows.find(function(w) { return t >= w.start && t < w.end; }) || null;
    }
    isOnShift(start, end) {
        return this.windows.some(function(w) { return start >= w.start && end <= w.end + 0.01; });
    }
    isFree(start, end) {
        return !this.schedule.some(slot => Math.max(start, slot.start) < Math.min(end, slot.end));
    }
    assign(start, end, taskId, areaName) {
        this.schedule.push({ start: start, end: end, taskId: taskId, area: areaName });
    }
}

class Equipment {
    constructor(data, isAllergenActive, isPbActive) {
        this.id = data.id;
        this.name = data.name;
        this.area = data.area;
        this.baseMins = data.minutesRequired;
        this.allergenMins = data.allergenMins;
        this.pbMins = data.pbMins;
        
        this.isAllergenActive = isAllergenActive;
        this.isPbActive = isPbActive;
        this.isTransitActive = false; 
        this.isInspectionActive = false; 

        this.heads = data.heads;
        this.kind = data.kind || taskKind(data);
        this.priority = data.priority;
        this.colorClass = data.colorClass;
        this.isComplete = data.isComplete || false;
        
        this.startMin = 0;
        this.assignedLanes = [];
        this.isPinned = false;
        this.segments = []; 
        
        // 🚨 ARCHITECTURE NOTE: Split Tracking
        // These flags prevent double-charging of prep/transit time when a task is dynamically 
        // split by the Greedy Splitting algorithm over a hard downtime wall.
        this.isSplitPart1 = false;
        this.isSplitPart2 = false;

        // Shift handover splits: a part's workload is fixed once it has been carved off.
        this.parentId = data.id;
        this.baseName = data.name;
        this.splitIndex = 1;
        this.workOverrideMins = null;
        this.earliestStart = 0;

        // Live-tracking state (see SECTION 5): planned | started | done
        this.status = 'planned';
        this.isFrozen = false;
        this.isInProgress = false;
        this.hasConflict = false;
        this.isOffShift = false;
        this.crew = '';
    }

    get rawWorkloadMins() {
        if (this.workOverrideMins !== null) return this.workOverrideMins;
        let mins = this.baseMins;
        if (this.isPbActive && this.pbMins > 0) mins = this.pbMins;
        else if (this.isAllergenActive && this.allergenMins > 0) mins = this.allergenMins;
        
        let total = mins;
        if (this.isInspectionActive) total += (mins * 0.10);
        if (this.isTransitActive) total += (10 * this.heads); 
        
        return total;
    }

    // 🚨 ARCHITECTURE NOTE: Break Absorption Logic
    // We intentionally do NOT slice tasks into multiple pieces when they hit a normal 20m/40m break.
    // Instead, the engine stretches the duration of the block, essentially "absorbing" the break time 
    // into the total span. The visual renderer then layers grey stripes *behind* the extended block.
    calculateSegments(interrupts, appliedHeads, startOverride = null) {
        const startToUse = startOverride !== null ? startOverride : this.startMin;
        const baseDuration = this.rawWorkloadMins / appliedHeads;
        if (!interrupts || interrupts.length === 0) {
            return [{ startMin: startToUse, duration: baseDuration }];
        }

        let current = startToUse;
        let remaining = baseDuration;

        while(remaining > 0) {
            const activeBreak = interrupts.find(function(b) { return current >= b.start && current < b.end; });
            if (activeBreak) {
                current = activeBreak.end;
                continue;
            }

            const nextBreak = interrupts.find(function(b) { return b.start > current && b.start < current + remaining; });
            if (nextBreak) {
                const segDur = nextBreak.start - current;
                remaining -= segDur;
                current = nextBreak.end;
            } else {
                current += remaining;
                remaining = 0;
            }
        }
        
        return [{ startMin: startToUse, duration: (current - startToUse) }];
    }

    getDuration(interrupts, appliedHeads, startOverride = null) {
        const segs = this.calculateSegments(interrupts, appliedHeads, startOverride);
        this.segments = segs;
        if (segs.length === 0) return 0;
        const lastSeg = segs[segs.length - 1];
        return (lastSeg.startMin + lastSeg.duration) - (startOverride !== null ? startOverride : this.startMin);
    }

    calculateDuration(proposedStartMin, interrupts, appliedHeads) {
        const segs = this.calculateSegments(interrupts, appliedHeads, proposedStartMin);
        if (segs.length === 0) return 0;
        const lastSeg = segs[segs.length - 1];
        return (lastSeg.startMin + lastSeg.duration) - proposedStartMin;
    }
}

