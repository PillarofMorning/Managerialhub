    // The idle box belongs to the stretch it was opened on: another view, another tab or a new plan closes it (the stretch it points at is gone).
    useEffect(function() { setIdleTip(null); }, [ganttView, activeTab, scheduleData]);

    if (isLoading) {
        return (
            <div className="min-h-screen bg-[#F7F9FC] flex flex-col items-center justify-center touch-pan" style={{ fontFamily: BRAND_FONT }}>
                <Loader2 className="w-12 h-12 text-[#0072CE] animate-spin mb-4" />
                <h2 className="text-xl font-bold text-[#00468B]">Loading Object-Oriented Intelligence Matrix...</h2>
            </div>
