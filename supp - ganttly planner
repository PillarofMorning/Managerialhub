                                                            <th className="p-3 w-20 text-center">Heads</th>
                                                            <th className="p-3 w-20 text-center">Priority</th>
                                                            <th className="p-3 w-40 text-center">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody className="divide-y divide-slate-100 text-sm">
                                                        {roomTasks.map(function(task) {
                                                            const di = doneInfo(task);
                                                            return (
                                                                <tr key={task.id} className="hover:bg-slate-50">
                                                                    <td className="p-3 font-bold text-slate-800">{!IS_CURRENT && <span className="mr-2 align-middle" onClick={function(e) { e.stopPropagation(); }}>{colorPick('eq:' + task.id, pieceHexShown(task), !!hexOr(equipColors[task.id]), function(h) { setColorIn(setEquipColors, task.id, h); }, function() { setColorIn(setEquipColors, task.id, ''); }, 'Color for ' + task.name + ' (blank = its function or room color)')}</span>}{task.name}{odChip(task)}{di && (
                                                                        <span data-done-chip={task.id} className="inline-block mt-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold border" style={{ background: '#E6F1FB', color: di.planned ? '#00468B' : '#0072CE', borderColor: '#B3D4F2' }}>✓ Cleaned {formatDayClock(di.doneMs)}{di.dueMs ? (di.planned ? ' · next clean planned (due ' + formatDayClock(di.dueMs) + ')' : ' · due again ' + formatDayClock(di.dueMs)) : ''}</span>
                                                                    )}</td>
                                                                    <td className="p-3">
                                                                        <input type="number" min="0" value={task.minutesRequired} onChange={function(e) { handleBaseMinsChange(task.id, e.target.value); }} className={`w-full text-center border rounded p-1 outline-none no-pan font-bold ${!roomAllergen[room] ? 'border-[#8FC0EC] bg-[#E6F1FB] text-[#00468B]' : 'border-slate-200'}`} />
                                                                    </td>
                                                                    <td className="p-3">
                                                                        <input type="number" min="0" value={task.allergenMins} onChange={function(e) { handleAllergenMinsChange(task.id, e.target.value); }} className={`w-full text-center border rounded p-1 outline-none no-pan font-bold ${roomAllergen[room] ? 'border-rose-400 bg-rose-100 text-rose-800' : 'border-rose-200 text-rose-700 bg-rose-50'}`} />
                                                                    </td>
                                                                    <td className="p-3">
                                                                        <input type="number" min="1" value={task.heads} onChange={function(e) { handleTaskHeadsChange(task.id, e.target.value); }} className="w-full text-center border border-slate-200 rounded p-1 outline-none no-pan font-bold" />
                                                                    </td>
                                                                    <td className="p-3">
                                                                        <input type="number" min="1" max="50" value={task.priority} onChange={function(e) { handlePriorityChange(task.id, e.target.value); }} className="w-full text-center border border-slate-200 rounded p-1 outline-none no-pan font-bold" />
                                                                    </td>
                                                                    <td className="p-3 text-center whitespace-nowrap">
                                                                        <Button variant="outline" size="sm" onClick={function() { openEquipDowntime(task.id); }} className="text-[10px] px-2 py-1">Add Downtime</Button>
                                                                        <button data-remove-equip={task.id} onClick={function() { setRemovedFromCleaning(task.id, true); }} title="Take this equipment out of the cleaning plan (it can be put back below)" className="ml-1.5 text-[10px] font-bold px-2 py-1 rounded border border-rose-200 text-[#E4002B] bg-white hover:bg-rose-50">Remove</button>
                                                                    </td>
                                                                </tr>
                                                            );
                                                        })}
                                                        {roomTasks.length === 0 && <tr><td colSpan="6" className="p-4 text-center text-sm font-bold text-slate-400">Everything in this room is taken out of cleaning.</td></tr>}
                                                    </tbody>
                                                    <tfoot className="bg-slate-100 border-t border-slate-200">
                                                        <tr>
                                                            <td className="p-3 text-right font-black text-slate-600 uppercase text-[10px] tracking-widest">Totals:</td>
                                                            <td className="p-3 text-center font-black text-slate-800">{totalBase} m</td>
                                                            <td className="p-3 text-center font-black text-slate-800">{totalAllergen} m</td>
                                                            <td className="p-3 text-center font-black text-slate-800">{totalHeads}</td>
