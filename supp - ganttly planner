                const clk = function(ms) { return formatClockTime(ganttStartDate, ganttStartHour, Math.round((ms - globalStartMs) / 60000)); };
                const rooms = areaSig.split('\u0001').filter(Boolean).sort(function(a, b) { return a.localeCompare(b, undefined, { numeric: true }); });
