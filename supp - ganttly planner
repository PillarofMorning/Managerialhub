            } catch (e) { try { window.prompt('Copy this summary:', text); } catch (e2) {} }
        };
        try {
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') navigator.clipboard.writeText(text).then(done, fallback);
