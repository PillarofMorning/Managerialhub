                                                    <button disabled={i === 0} onClick={function() { moveDeptStep(i, -1); }} title="Move up" className="w-6 h-6 rounded text-[10px] font-black text-[#0072CE] hover:bg-[#E6F1FB] disabled:opacity-25">▲</button>
