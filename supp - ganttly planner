// 🚨 ARCHITECTURE NOTE: Absolute Time vs. Relative Offsets
// Originally, the app saved room handovers as relative offsets (e.g., "+180 mins").
// We abandoned this because dragging the Global Start Date would ruin the timeline.
// All functions here now strictly utilize absolute Datetimes converted dynamically 
// into minutes-from-viewport-start to build the array coordinates.
// ============================================================================
function getLocalYMD(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}

// Accepts choice values (256000000..3), ints 1-4, and labels like "A", "A Shift", "Shift C", "D - Nights".
function normalizeShift(val) {
    if (val === undefined || val === null || val === "") return "";
    const s = String(typeof val === 'object' ? (val.Label || val.Value || val.name || '') : val).toUpperCase().trim();
    if (s.indexOf("256000000") > -1 || s === "1") return "A";
    if (s.indexOf("256000001") > -1 || s === "2") return "B";
    if (s.indexOf("256000002") > -1 || s === "3") return "C";
    if (s.indexOf("256000003") > -1 || s === "4") return "D";
    const m = s.match(/(?:^|[^A-Z])([ABCD])(?=$|[^A-Z])/);
    return m ? m[1] : "";
}

// Employee shift can live under several column spellings / formatted values depending on the API used.
function readEmployeeShift(e) {
    const FMT = '@OData.Community.Display.V1.FormattedValue';
    const candidates = [e.craa5_shift, e.craa5_Shift, e['craa5_shift' + FMT], e['craa5_Shift' + FMT], e.craa5_shiftcode, e.craa5_crew];
    Object.keys(e).forEach(function(k) { if (/shift|crew/i.test(k) && candidates.indexOf(e[k]) === -1) candidates.push(e[k]); });
    for (let i = 0; i < candidates.length; i++) {
        const c = normalizeShift(candidates[i]);
        if (c) return { crew: c, raw: candidates[i] };
    }
    const firstRaw = candidates.find(function(c) { return c !== undefined && c !== null && c !== ''; });
    return { crew: '', raw: firstRaw === undefined ? '(blank)' : firstRaw };
}

// Job role from the _aa_Role lookup (craa5_RoleID). Lookups come back as _craa5_roleid_value + a formatted name,
// or as an object / plain text depending on the API, so try each shape.
function readEmployeeJobRole(e) {
    const FMT = '@OData.Community.Display.V1.FormattedValue';
    const direct = e['_craa5_roleid_value' + FMT] || e['_craa5_RoleID_value' + FMT];
    if (direct) return String(direct).trim();
    const key = Object.keys(e).find(function(k) { return /roleid/i.test(k) && k.indexOf(FMT) > -1; });
    if (key && e[key]) return String(e[key]).trim();
    const obj = e.craa5_roleid || e.craa5_RoleID;
    if (obj && typeof obj === 'object') return String(obj.name || obj.Name || obj.craa5_name || obj.primaryName || '').trim();
    if (typeof obj === 'string' && !/^[0-9a-f-]{36}$/i.test(obj)) return obj.trim();
    return '';
}

function jobRoleKey(role) { return String(role || '').trim().toLowerCase().replace(/\s+/g, ' '); }

