                                        </select>
                                        <span className="text-sm font-bold text-slate-600">{peopleN} people{leadsN ? ' · ' + leadsN + ' lead' + (leadsN === 1 ? '' : 's') : ''}</span>
                                        <Button variant="primary" size="sm" onClick={function() { if (LAZY_ENGINE) { setLiveTime(new Date()); setPrinting(true); } else window.print(); }} className="ml-auto"><Printer className="w-3.5 h-3.5 mr-1" /> Print</Button>
                                    </div>
                                ) : (
                                    <span className="text-sm font-bold text-slate-400">{IS_CURRENT ? 'No shifts fall inside the window.' : 'No shifts fall inside the plan window. Check the Setup tab.'}</span>
                                )}
                            </div>

                            {LAZY_ENGINE && !printing && (
                                <div className="print-only" data-print-hint>
                                    <div className="text-sm font-bold text-slate-600">The crew schedules print from the Print button at the top of the Crew tab (they are only built when it is pressed).</div>
                                </div>
                            )}
                            {win && (printing || !LAZY_ENGINE) && (
                                <div className="print-only">
                                    <div className="mb-3">
                                        <div className="text-lg font-black text-[#00468B]">{win.crew} crew · {formatClockTime(ganttStartDate, ganttStartHour, win.shiftStart)} · {win.dayLabel} {formatHourLabel(win.startHour)}</div>
                                        <div className="text-xs font-bold text-slate-500">{peopleN} people{leadsN ? ' · ' + leadsN + ' lead' + (leadsN === 1 ? '' : 's') : ''}</div>
                                    </div>
                                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                        {crewLanes.map(function(l) {
                                            const blocks = blocksFor(l.lane).sort(function(a, b) { return a.startMin - b.startMin; });
                                            let booked = 0;
                                            blocks.forEach(function(t) { booked += Math.min(win.end, t.startMin + t.finalDuration) - Math.max(win.start, t.startMin); });
                                            const pct = winLen > 0 ? Math.round((booked / winLen) * 100) : 0;
                                            const doneCount = blocks.filter(function(t) { return t.isComplete; }).length;
                                            const dutyHere = dutyPlan.on ? (dutyPlan.bars[l.lane] || []).filter(function(b) { return b.start < win.end && b.end > win.start; }) : [];   // PBED support duty
                                            const gc = l.groupIdx >= 0 ? TEAM_COLORS[l.groupIdx % TEAM_COLORS.length] : null;
                                            if (l.isLead && blocks.length === 0) {
                                                return (
                                                    <div key={l.lane} className="lg:col-span-2 self-start rounded-xl shadow-sm border border-slate-200 overflow-hidden break-inside-avoid bg-white" style={{ borderLeft: `6px solid ${gc || '#475569'}` }}>
                                                        <div className="px-4 py-3 flex items-center gap-3">
                                                            <span className={`w-7 h-7 rounded-md flex items-center justify-center font-black text-xs ${style.badge}`}>{l.crew}</span>
                                                            <div className="flex-1 min-w-0">
                                                                <div className="font-black text-slate-800 truncate">{l.name}{roleTag(l)}</div>
