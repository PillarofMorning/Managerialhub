    }

    // ============================================================================
    // SECTION 7: METRICS (one-stop shop: progress, ETA, manpower, cost)
    // ============================================================================
    const allBlocks = [];
    scheduleData.groups.forEach(function(g) { g.tasks.forEach(function(t) { allBlocks.push(t); }); });
    const metricsWorkers = scheduleData.workers;

    // Late = should have started by now but hasn't, or started and ran past its planned end.
    const isLate = function(t) {
        if (t.isComplete || nowMin < 0) return false;
        if (t.isInProgress) return (t.overrunFrom !== undefined && t.overrunFrom !== null ? t.overrunFrom : t.startMin + t.finalDuration) < nowMin;
        return t.startMin < nowMin - 5;
    };

    let globalMaxEnd = 0;
    let totalManpowerMins = 0, doneManpowerMins = 0, activeManpowerMins = 0;
    let workTotal = 0, workDone = 0;
    let countDone = 0, countStarted = 0, countPlanned = 0, countLate = 0, countConflict = 0;
    allBlocks.forEach(function(t) {
        const end = t.startMin + t.finalDuration;
        if (end > globalMaxEnd) globalMaxEnd = end;
        const mp = t.finalDuration * t.appliedHeads;
        totalManpowerMins += mp;
        workTotal += t.rawWorkloadMins;
        if (t.isComplete) { countDone++; doneManpowerMins += mp; workDone += t.rawWorkloadMins; }
        else if (t.isInProgress) { countStarted++; activeManpowerMins += mp; }
        else countPlanned++;
        if (isLate(t)) countLate++;
        if (t.hasConflict) countConflict++;
    });
    const unscheduledWorkMins = scheduleData.unscheduled.reduce(function(acc, t) { return acc + t.rawWorkloadMins; }, 0);
    workTotal += unscheduledWorkMins;
    const progressPct = workTotal > 0 ? Math.round((workDone / workTotal) * 100) : 0;
    const neededManpowerMins = totalManpowerMins + unscheduledWorkMins;
    const remainingManpowerMins = neededManpowerMins - doneManpowerMins;
    const handoverCount = allBlocks.filter(function(t) { return t.isSplitPart2 && !t.isFrozen && t.handoverAdded; }).length;
    const etaSlackMins = planHorizonMins - globalMaxEnd;

    // Deep Metrics Calculation (overheads counted once per piece of equipment)
    let deepTransit = 0, deepInspect = 0, deepBreak = 0, deepDown = 0;
    scheduleData.parents.forEach(function(p) { deepTransit += p.transitMins; if (!p.removed) deepInspect += p.inspectMins; });

    // Breaks / downtime that land inside a worker's booked time (absorbed into their blocks).
    metricsWorkers.forEach(function(w) {
        w.schedule.forEach(function(slot) {
            // Overlapping stretches (a plant block over a break) are counted once, as downtime.
            const down = unionMins(allInterrupts.filter(function(b) { return b.isCustom; }), slot.start, slot.end);
            deepDown += down;
            deepBreak += unionMins(allInterrupts, slot.start, slot.end) - down;
        });
    });

    // Per-worker workload.
    const workerStats = laneRoster.map(function(l) {
        const w = metricsWorkers[l.lane];
        let availMins = 0, bookedMins = 0, doneMins = 0, tasks = 0, done = 0, late = 0;
        l.windows.forEach(function(win) { availMins += (win.end - win.start); });
        (w ? w.schedule : []).forEach(function(s) {
            const t = scheduleData.taskById[s.taskId];
            bookedMins += (s.end - s.start);
            tasks++;
            if (t && t.isComplete) { done++; doneMins += (s.end - s.start); }
            if (t && isLate(t)) late++;
