        const col = x.status === 'LATE' || x.spare === -Infinity || (known0(x.spare) && x.spare < 0) ? '#B00020' : x.status === 'AT_RISK' ? '#8A5A00' : x.status === 'READY' ? '#00468B' : '#0072CE';
        return (
            <div className="text-right leading-tight">
                <div className="text-[15px] font-black tabular-nums" style={{ color: t ? col : '#94A3B8' }}>{t || '—'}</div>
                <div className="text-[10px] font-bold text-slate-500 whitespace-nowrap">{x.status === 'RUNNING' ? (x.R !== null ? 'startup ' + board.clock(x.R) : '') : x.G !== null ? 'ready by ' + board.clock(x.G) : ''}</div>
            </div>
        );
    };
    const roomSubLine = function(x) {
        const bits = [x.stateText];
        if (x.lines.length) bits.push(x.lines.slice(0, 2).map(function(l) { return l.replace(' · ', ' '); }).join(', ') + (x.lines.length > 2 ? ' +' + (x.lines.length - 2) : ''));
        if (x.status === 'NO_STARTUP' && x.noStartupWhy) bits.push(x.noStartupWhy);
        if (x.plannedWhileRunning) bits.push('planned while the line runs');
        return bits.join(' · ');
    };
    const renderStartupTab = function() {
        const b = board;
        const tv = tvMode;
        const pl = b.plant, ef = b.effort, w = b.w;
        const vst = STARTUP_STYLE[pl.verdict] || STARTUP_STYLE.NONE;
        const heroLook = b.planOnly && pl.verdict !== 'NONE' ? { background: '#fff', color: '#0F172A', border: '3px solid ' + vst.dot } : { background: vst.hero.background, color: vst.hero.color, border: '3px solid ' + vst.hero.background };
        const label = 'text-[11px] font-extrabold uppercase tracking-[0.08em] text-slate-500';
        const tileNum = (tv ? 'text-[40px]' : 'text-[30px]') + ' font-black text-[#00468B] tabular-nums leading-none';
        const card = 'bg-white rounded-xl shadow-sm border border-slate-200';
        const rows = b.rows;
        const rowH = tv && tvRowsH > 0 && rows.length ? Math.max(56, Math.min(88, Math.floor((tvRowsH - (b.support.n ? 44 : 0)) / rows.length))) : 56;
        const nx = pl.next;
        const attn = attnExpanded ? b.attention : b.attention.slice(0, 3);
        const tone = { red: '#E4002B', yellow: '#FFB81C', grey: '#94A3B8' };
        const icons = {
            star: <Star className="w-4 h-4 flex-shrink-0" style={{ color: '#FFB81C', fill: '#FFB81C' }} />,
            check: <CheckCircle className="w-4 h-4 flex-shrink-0 text-[#0072CE]" />,
            alert: <AlertCircle className="w-4 h-4 flex-shrink-0 text-[#E4002B]" />,
            arrow: <ArrowRight className="w-4 h-4 flex-shrink-0 text-slate-400" />
        };
        const gridCols = 'lg:grid-cols-[104px_minmax(130px,180px)_minmax(160px,1fr)_96px_72px_minmax(96px,132px)]';
        return (
            <div data-startup-board className="flex-1 min-h-0 flex flex-col bg-[#F7F9FC] p-3 lg:p-4 gap-3 overflow-y-auto xl:overflow-hidden custom-scrollbar">
                {/* Verdict band: the answer first, then the next startup, cleaning done and the effort this shift. */}
                <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-[1.15fr_1fr_1fr_1fr] gap-3 flex-shrink-0">
                    <div data-hero={pl.verdict} className="rounded-xl shadow-sm px-4 py-3 flex flex-col justify-center min-h-[104px] relative" style={heroLook}>
                        {b.planOnly && pl.verdict !== 'NONE' && <span className="absolute top-2 right-2 px-1.5 py-0.5 rounded bg-slate-800 text-white text-[9px] font-black tracking-[0.12em]" title="No Start / Done check-offs on this computer this shift: this is the plan, not the floor">UNCONFIRMED</span>}
                        <div className={(tv ? 'text-[56px]' : 'text-[40px]') + ' font-black leading-none tracking-tight'} style={b.planOnly && pl.verdict !== 'NONE' ? { color: vst.dot === '#FFB81C' ? '#8A5A00' : vst.dot } : null}>{vst.word}</div>
                        <div className={(tv ? 'text-[19px]' : 'text-[15px]') + ' font-bold mt-1 leading-snug'}>{pl.headline}</div>
                        {pl.countLine && <div className={(tv ? 'text-[14px]' : 'text-[12px]') + ' font-semibold opacity-90 mt-0.5'}>{pl.countLine}</div>}
                        {pl.verdict === 'NONE' && <div className="text-[11px] font-semibold mt-1 opacity-90">{pl.prodDoneBy !== null && w ? "This shift's production work projected done " + b.clock(pl.prodDoneBy) + ' · shift ends ' + b.clock(w.shiftEnd) + '. ' : ''}Add a down line or link rooms to the production schedule.</div>}
                    </div>
                    <div data-tile="next" className={card + ' px-4 py-3 flex flex-col justify-center min-h-[104px]'}>
                        <div className={label}>Next startup</div>
                        {nx ? (<React.Fragment>
                            <div className="flex items-baseline gap-2 mt-1"><span className={tileNum}>{b.clock(nx.R)}</span><span className="text-[12px] font-bold text-slate-500">in {fmtMins(nx.R - nowMin)}</span></div>
                            <div className="flex items-center gap-2 mt-1.5 min-w-0">{boardChip(nx.status)}<button onClick={function() { openBoardRoom(nx.room); }} className="text-[13px] font-bold text-slate-800 truncate hover:underline no-pan">{nx.room}</button></div>
                            {nx.G !== null && nx.status !== 'RUNNING' && <div className="text-[11px] font-semibold text-slate-500 mt-0.5 truncate">ready by {b.clock(nx.G)} ({nx.gateLabel}){b.spareText(nx) ? ' · ' + b.spareText(nx) : ''}</div>}
                            {nx.status === 'RUNNING' && <div className="text-[11px] font-semibold text-slate-500 mt-0.5 truncate">line running until {b.clock(nx.S)}</div>}
                        </React.Fragment>) : (<React.Fragment>
                            <div className={tileNum + ' mt-1 text-slate-300'}>—</div>
                            <div className="text-[11px] font-semibold text-slate-500 mt-1">No startup time known ahead</div>
                        </React.Fragment>)}
                    </div>
                    <div data-tile="cleaning" className={card + ' px-4 py-3 flex flex-col justify-center min-h-[104px]'}>
                        <div className={label}>Cleaning done{pl.scope ? '' : ' · production'}</div>
                        <div className="flex items-baseline gap-2 mt-1"><span className={tileNum}>{pl.cleaning.pct}%</span><span className="text-[12px] font-bold text-slate-500">{pl.cleaning.piecesDone} of {pl.cleaning.pieces} pieces</span></div>
                        <div className="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden mt-2"><div className="h-full rounded-full" style={{ width: pl.cleaning.pct + '%', background: '#0072CE' }} /></div>
                        <div className="text-[11px] font-semibold text-slate-500 mt-1.5 truncate">{(Math.round(pl.cleaning.leftHrs * 10) / 10)} std hrs left{pl.cleaning.wontFitHrs > 0 ? <span className="text-[#B00020] font-bold"> · {(Math.round(pl.cleaning.wontFitHrs * 10) / 10)} h won't fit</span> : ''}</div>
                    </div>
                    <div data-tile="effort" className={card + ' px-4 py-3 flex flex-col justify-center min-h-[104px]'}>
                        <div className={label + ' flex items-center gap-1.5'}>Effort this shift{w && <span className={'px-1.5 py-0.5 rounded text-[10px] font-black ' + getCrewStyle(w.crew).badge}>{w.crew}</span>}</div>
                        {!w ? <div className="text-[12px] font-semibold text-slate-500 mt-2">No crew on now{b.nextWin ? '' : ''}</div>
                        : b.planOnly ? (<React.Fragment>
                            <div className={tileNum + ' mt-1 text-slate-300'}>—</div>
                            <div className="text-[11px] font-semibold text-slate-500 mt-1">No Start / Done on this computer yet this shift</div>
                        </React.Fragment>) : (<React.Fragment>
                            <div className="flex items-baseline gap-2 mt-1"><span className={tileNum}>{Math.round(ef.stdHrs * 10) / 10}</span><span className="text-[12px] font-bold text-slate-500">std hrs done</span></div>
                            <div className="text-[11px] font-semibold text-slate-600 mt-1 truncate">{ef.cleans} clean{ef.cleans === 1 ? '' : 's'}{ef.underWay ? ' · ' + ef.underWay + ' under way' : ''} · {ef.assigned} of {ef.onNow} on equipment now (plan)</div>
                            <div className="text-[11px] font-semibold text-slate-500 truncate" title="Pace = standard minutes of the timed cleans ÷ the minutes people spent on them (Start to Done × people). Only cleans with both Start and Done pressed are timed.">{ef.pace !== null ? 'Pace ' + ef.pace + '% of standard (' + ef.timed + ' timed)' : 'Pace not measured: Start pressed on ' + ef.timed + ' of ' + ef.doneCount + ' cleans'}</div>
                        </React.Fragment>)}
                    </div>
                </div>

                {/* Body: the runway per line (left), what needs attention and this shift's credit (right). */}
                <div className="flex-shrink-0 xl:flex-shrink xl:flex-1 xl:min-h-0 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_360px] gap-3">
                    <div className={card + ' flex flex-col xl:min-h-0 overflow-hidden'}>
                        <div className="px-4 pt-3 pb-2 flex items-baseline justify-between gap-3 flex-shrink-0">
                            <div className={label}>Ready for startup <span className="normal-case tracking-normal font-bold text-slate-400">· worst first{tv ? '' : ' · click a line to open it'}</span></div>
                            <div className="hidden md:flex items-center gap-3 text-[10px] font-bold text-slate-500">
                                <span className="inline-flex items-center gap-1"><span className="w-3 h-2.5 rounded-sm bg-slate-400 opacity-70 complete-stripes" />done</span>
                                <span className="inline-flex items-center gap-1"><span className="w-3 h-2.5 rounded-sm bg-[#0072CE]" />to do</span>
                                <span className="inline-flex items-center gap-1"><span className="w-3 h-2.5 rounded-sm" style={{ background: HATCH_RED }} />past plan</span>
                                <span className="inline-flex items-center gap-1"><span className="w-[3px] h-3 rounded-full bg-[#FFB81C]" />ready by</span>
                                <span className="inline-flex items-center gap-1"><Flag className="w-3 h-3 text-[#00468B]" />startup</span>
                            </div>
                        </div>
                        {/* Axis: the shifts in view, on the same scale as the runways. */}
                        <div className={'hidden lg:grid ' + gridCols + ' gap-3 px-4 pb-1.5 flex-shrink-0 items-end'}>
                            <div /><div />
                            <div className="relative h-8">
                                {shiftWindows.map(function(sw) {
                                    const l = Math.max(0, Math.min(1, sw.start / b.H)) * 100;
                                    if (l >= 98) return null;
                                    return <div key={'ax' + sw.key} className="absolute bottom-0 flex items-center gap-1 whitespace-nowrap" style={{ left: l + '%' }}><span className={'px-1 rounded text-[9px] font-black ' + getCrewStyle(sw.crew).badge}>{sw.crew}</span><span className="text-[9px] font-bold text-slate-400">{b.clock(sw.start)}</span></div>;
                                })}
                                {nowMin > 0 && nowMin < b.H && <div className="absolute top-0 -translate-x-1/2 px-1 rounded bg-red-500 text-white text-[9px] font-black" style={{ left: (nowMin / b.H * 100) + '%' }}>now {b.clock(nowMin)}</div>}
                            </div>
                            <div className="text-right text-[10px] font-extrabold uppercase tracking-[0.08em] text-slate-400">Spare</div>
                            <div className="text-right text-[10px] font-extrabold uppercase tracking-[0.08em] text-slate-400">Done</div>
                            <div className="text-[10px] font-extrabold uppercase tracking-[0.08em] text-slate-400 truncate">On it now · lead</div>
                        </div>
                        <div ref={tvRowsRef} className="xl:flex-1 xl:min-h-0 xl:overflow-y-auto custom-scrollbar border-t border-slate-100">
                            {rows.length === 0 && <div className="px-4 py-6 text-[13px] font-semibold text-slate-500">No production rooms have work in this view.</div>}
                            {rows.map(function(x) {
                                const click = function() { openBoardRoom(x.room); };
                                const lead = x.lead ? x.lead : '';
                                return (
                                    <div key={x.room} data-board-row={x.room} data-board-status={x.status} onClick={click} className={'border-b border-slate-100 px-4 ' + (tv ? '' : 'cursor-pointer hover:bg-[#F3F8FD]')} style={{ minHeight: rowH }}>
                                        {/* Desktop: one line per room. */}
                                        <div className={'hidden lg:grid ' + gridCols + ' gap-3 items-center'} style={{ height: rowH }}>
                                            <div>{boardChip(x.status, tv)}</div>
                                            <div className="min-w-0">
                                                <div className={'flex items-center gap-1.5 font-bold text-slate-800 truncate ' + (tv ? 'text-[18px]' : 'text-[14px]')}><span className="w-2.5 h-2.5 rounded-full flex-shrink-0" style={{ background: roomHexShown(x.room) }} /><span className="truncate">{x.room}</span></div>
                                                <div className="text-[11px] font-semibold text-slate-500 truncate" title={roomSubLine(x)}>{roomSubLine(x)}</div>
                                            </div>
                                            <div className="min-w-0 pt-2">{renderRunway(x, { tall: tv })}</div>
                                            {spareCell(x)}
                                            <div className="text-right leading-tight"><div className={'font-black tabular-nums text-slate-700 ' + (tv ? 'text-[18px]' : 'text-[14px]')}>{x.pct}%</div><div className="text-[10px] font-bold text-slate-500 whitespace-nowrap">{x.piecesDone}/{x.pieces} pcs</div></div>
                                            <div className="min-w-0 leading-tight">
                                                <div className="text-[12px] font-bold text-slate-700 truncate">{x.status === 'RUNNING' || x.status === 'READY' ? '—' : x.assignedNow.length + ' on it now'}</div>
                                                <div className="text-[10px] font-semibold text-slate-500 truncate" title={lead}>{lead ? 'lead ' + lead : ''}</div>
                                            </div>
                                        </div>
                                        {/* Phone and narrow screens: a card per room. */}
                                        <div className="lg:hidden py-2.5">
                                            <div className="flex items-center gap-2 min-w-0">
                                                {boardChip(x.status)}
                                                <span className="w-2 h-2 rounded-full flex-shrink-0" style={{ background: roomHexShown(x.room) }} />
                                                <span className="text-[14px] font-bold text-slate-800 truncate flex-1 min-w-0">{x.room}</span>
                                                <span className="text-[14px] font-black tabular-nums flex-shrink-0" style={{ color: x.status === 'LATE' || (known0(x.spare) && x.spare < 0) ? '#B00020' : x.status === 'AT_RISK' ? '#8A5A00' : '#0072CE' }}>{board.spareText(x) || ''}</span>
                                            </div>
                                            <div className="mt-2">{renderRunway(x)}</div>
                                            <div className="mt-1 text-[11px] font-semibold text-slate-500 truncate">{x.pct}% · {x.piecesDone}/{x.pieces} pcs{x.G !== null && x.status !== 'RUNNING' ? ' · ready by ' + board.clock(x.G) : ''}{x.lead ? ' · lead ' + x.lead : ''}</div>
                                            <div className="text-[11px] font-semibold text-slate-400 truncate">{roomSubLine(x)}</div>
                                        </div>
                                    </div>
                                );
                            })}
                            {b.support.n > 0 && (
                                <div data-board-support className="px-4 py-2.5 border-b border-slate-100">
                                    <button onClick={function() { setStartupSupportOpen(!startupSupportOpen); }} className="w-full flex items-center gap-2 text-left no-pan">
                                        {startupSupportOpen ? <ChevronDown className="w-4 h-4 text-slate-400" /> : <ChevronRight className="w-4 h-4 text-slate-400" />}
                                        <span className="text-[12px] font-extrabold uppercase tracking-[0.08em] text-slate-500">Support</span>
                                        <span className="text-[12px] font-semibold text-slate-500 truncate">{b.support.n} area{b.support.n === 1 ? '' : 's'} · {b.support.pct}% done{b.support.onDuty ? ' · ' + b.support.onDuty + ' on duty' : ''} · no startup</span>
                                    </button>
                                    {startupSupportOpen && <div className="mt-2 pl-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1">
                                        {b.support.rooms.map(function(s) { return <div key={s.room} className="flex items-center gap-2 text-[12px] font-semibold text-slate-600"><span className="w-2 h-2 rounded-full" style={{ background: roomHexShown(s.room) }} /><span className="truncate flex-1">{s.room}</span><span className="tabular-nums">{s.pct}%</span><span className="text-slate-400 tabular-nums">{s.piecesDone}/{s.pieces}</span></div>; })}
                                    </div>}
                                </div>
                            )}
                        </div>
                    </div>

                    <div className="flex flex-col gap-3 xl:min-h-0 xl:overflow-y-auto custom-scrollbar">
                        <div data-attention className={card + ' px-4 py-3 flex-shrink-0'}>
                            <div className={label + ' flex items-center justify-between'}><span>Needs attention</span>{b.attention.length > 0 && <span className="text-slate-400">{b.attention.length}</span>}</div>
                            {b.attention.length === 0 && <div className="mt-2 flex items-center gap-2 text-[13px] font-semibold text-slate-600"><CheckCircle className="w-4 h-4 text-[#0072CE]" />Nothing needs attention right now.</div>}
                            <div className="mt-2 flex flex-col gap-2">
                                {attn.map(function(a) {
                                    return (
                                        <div key={a.key} data-attn={a.tone} className="pl-3 py-1 border-l-[3px]" style={{ borderColor: tone[a.tone] }}>
                                            <div className={'font-bold text-slate-800 leading-snug ' + (tv ? 'text-[15px]' : 'text-[13px]')}>{a.title}</div>
                                            {a.sub && <div className="text-[11px] font-semibold text-slate-500 leading-snug mt-0.5">{a.sub}</div>}
                                            {a.chips && a.chips.length > 0 && <div className="flex flex-wrap gap-1 mt-1">{a.chips.map(function(c) { return <span key={c} className="px-1.5 py-0.5 rounded bg-slate-100 text-[10px] font-bold text-slate-600">{c}</span>; })}</div>}
                                            {!tv && (a.room || a.setStartup) && <div className="flex gap-3 mt-1">
                                                {a.setStartup && <button onClick={function() { openDownModal(a.setStartup); }} className="text-[11px] font-black text-[#0072CE] hover:underline no-pan">Set startup</button>}
                                                {a.room && <button onClick={function() { openBoardRoom(a.room); }} className="text-[11px] font-black text-[#0072CE] hover:underline no-pan">Open on Gantt →</button>}
                                            </div>}
                                        </div>
                                    );
                                })}
                            </div>
                            {b.attention.length > 3 && <button onClick={function() { setAttnExpanded(!attnExpanded); }} className="mt-2 text-[11px] font-black text-[#0072CE] hover:underline no-pan">{attnExpanded ? 'Show fewer' : '+' + (b.attention.length - 3) + ' more'}</button>}
                        </div>
                        <div data-this-shift className={card + ' px-4 py-3 flex-shrink-0'}>
                            <div className={label + ' flex items-center gap-1.5'}>This shift{w && <React.Fragment> · <span className={'px-1.5 py-0.5 rounded text-[10px] font-black ' + getCrewStyle(w.crew).badge}>{w.crew}</span> <span className="normal-case tracking-normal">{b.clock(w.shiftStart)} – {b.clock(w.shiftEnd)}</span></React.Fragment>}</div>
                            {!w && <div className="mt-2 text-[13px] font-semibold text-slate-600">No crew on now{b.nextWin ? ' · next ' + b.nextWin.crew + ' ' + b.clock(b.nextWin.start) : ''}</div>}
                            {w && b.thisShift.length === 0 && <div className="mt-2 text-[13px] font-semibold text-slate-500">Nothing to report yet.</div>}
                            <div className="mt-2 flex flex-col gap-1.5">
                                {b.thisShift.map(function(s, i) {
                                    return <div key={'ts' + i} data-shift-line={s.icon} className={'flex items-start gap-2 font-semibold text-slate-700 leading-snug ' + (tv ? 'text-[15px]' : 'text-[12.5px]')}>{icons[s.icon]}<span>{s.text}</span></div>;
                                })}
                            </div>
                            <div className="mt-2 text-[10px] font-semibold text-slate-400">Credit and follow-ups are by room, crew and lead; no one person is named.</div>
                        </div>
                    </div>
                </div>

                {/* Where the numbers come from, and how the board judges. */}
                <div className="flex-shrink-0 relative flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10.5px] font-semibold text-slate-500 leading-tight">
                    <span>Progress: Start / Done pressed on this computer</span><span className="text-slate-300">·</span>
                    <span>Startups: down lines + production schedule{b.provenance.schedReadAt ? ' (read ' + b.clockMs(b.provenance.schedReadAt) + ')' : ''}</span><span className="text-slate-300">·</span>
                    <span>Ready-by: startup − {READY_BY_SHORT_MINS / 60} h (preflight); startup − {READY_BY_LONG_MINS / 60} h (FSQ inspect) when the line is down {LONG_CHANGEOVER_MINS / 60} h or more</span>
                    {!b.provenance.liveReforecast && <React.Fragment><span className="text-slate-300">·</span><span className="text-[#8A5A00]">Live Reforecast is off on this computer: finish times assume unstarted work began on plan</span></React.Fragment>}
                    <span className="text-slate-300">·</span>
                    <button data-how-judged onClick={function() { setJudgedOpen(!judgedOpen); }} className="font-black text-[#0072CE] hover:underline no-pan">How this is judged</button>
                    {judgedOpen && (
                        <div className="absolute bottom-6 right-0 z-30 w-[min(440px,calc(100vw-24px))] bg-white rounded-xl shadow-xl border border-slate-200 p-4 text-[12px] font-medium text-slate-700 leading-relaxed">
                            <div className="flex items-center justify-between mb-2"><span className={label}>How this is judged</span><button onClick={function() { setJudgedOpen(false); }} className="text-slate-400 hover:text-slate-700 font-black no-pan">✕</button></div>
                            <ul className="list-disc pl-4 space-y-1">
                                <li><b>Startup</b>: the end of a down line when one is entered, else the next run on the production schedule after the line stops.</li>
                                <li><b>Ready by</b>: {READY_BY_SHORT_MINS} min before startup (preflight). When the line is down {LONG_CHANGEOVER_MINS / 60} h or more: {READY_BY_LONG_MINS / 60} h before (FSQ inspect). Never before the line stops.</li>
                                <li><b>Ready</b> = every piece in the room done by the ready-by time. <b>On track</b> = the plan finishes with {AT_RISK_MINS} min or more to spare. <b>At risk</b> = less than {AT_RISK_MINS} min to spare, or less than {OVERRUN_RISK_MINS / 60} h while a clean runs past its plan. <b>Late</b> = the plan finishes after the ready-by time, or work does not fit before it.</li>
                                <li>A clean started and not checked off at its planned end keeps its people busy up to now and shows red as past plan.</li>
                                <li>Done without Start counts as done, not timed. Pace only shows once {PACE_MIN_TIMED} cleans have both Start and Done.</li>
                                <li>Progress comes from Start / Done pressed in Ganttly on this computer; with none this shift for {UNCONFIRMED_AFTER_MINS} min the verdict says unconfirmed.</li>
                                <li>An unknown startup is never counted as on track or late. A support area has no startup.</li>
                                <li>Credit and follow-ups are by room, crew and lead; no one person is named.</li>
                            </ul>
                        </div>
                    )}
                </div>
            </div>
        );
    };
    // ---- Ganttly's Gantt / Focus toolbar: the shift picker, a Key pop-over (colours and marks), Supervisor tools (everything that
    // changes the plan) and Fit 12 h. On Focus with a room picked, that room's startup runway sits under it. ----
    const renderGanttlyToolbar = function() {
        const pop = 'absolute left-0 top-full mt-1.5 z-[70] bg-white rounded-xl shadow-2xl border border-slate-200 p-3 text-slate-700';
