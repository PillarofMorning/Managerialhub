                                                                <div className={`absolute inset-0 rounded-md overflow-hidden flex shadow-sm border ${(task.isPinned || task.isFrozen) && !isDraggingMe ? 'border-[2px] border-slate-900/70' : 'border-black/20'}`}>
                                                                    {isSimpleBlock && <div className={`absolute inset-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} style={bgOf(taskHex(task))} />}
                                                                    {isSimpleBlock && task.isSplitPart1 && <div className="absolute top-0 bottom-0 right-0 w-1.5 bg-white/70" title={task.handedOver ? 'Handed over to a later shift' : 'Continues later this shift'} />}
                                                                    {isSimpleBlock && task.isSplitPart2 && !task.isFrozen && <div className="absolute top-0 bottom-0 left-0 w-1.5 bg-white/70" title={task.handoverAdded ? 'Continued from an earlier shift' : 'Continues an earlier part'} />}
                                                                    {!isSimpleBlock && transitOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${transitOverlap.leftPct}%`, width: `${transitOverlap.widthPct}%` }} title="Transit/Prep (10m)" />}
                                                                    {!isSimpleBlock && baseOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} ${task.isComplete ? 'complete-stripes' : ''}`} style={bgOf(taskHex(task), { left: `${baseOverlap.leftPct}%`, width: `${baseOverlap.widthPct}%` })} />}
                                                                    {!isSimpleBlock && allergenOverlap && <div className={`absolute top-0 bottom-0 ${getRoomColor(task.originalArea)} opacity-40 ${task.isComplete ? 'complete-stripes' : ''}`} style={bgOf(taskHex(task), { left: `${allergenOverlap.leftPct}%`, width: `${allergenOverlap.widthPct}%` })} title="Allergen Extra Time" />}
                                                                    {!isSimpleBlock && inspectOverlap && <div className="absolute top-0 bottom-0 bg-slate-900" style={{ left: `${inspectOverlap.leftPct}%`, width: `${inspectOverlap.widthPct}%` }} title="Inspection" />}
                                                                    {IS_CURRENT && !isDraggingMe && task.overrunFrom !== undefined && task.overrunFrom !== null && task.overrunFrom < nowMin && activeDuration > 0 && (function() {
                                                                        // Ganttly: the part of a clean past its planned end (still on it) is red-hatched, with how far over.
                                                                        const lp = Math.max(0, Math.min(100, (task.overrunFrom - rMin) / activeDuration * 100));
                                                                        const overPx = widthPx * (100 - lp) / 100;
                                                                        return <div data-overrun={Math.round(nowMin - task.overrunFrom)} className="absolute top-0 bottom-0 right-0 flex items-end justify-end overflow-hidden" style={{ left: lp + '%', background: HATCH_RED, borderLeft: '2px solid #E4002B' }}>{overPx > 84 && <span className="m-0.5 px-1 rounded bg-white/90 text-[9px] font-black text-[#B00020] whitespace-nowrap">+{fmtMins(nowMin - task.overrunFrom)} over plan</span>}</div>;
                                                                    })()}
                                                                    {IS_CURRENT && task.isComplete && !(taskStatus[task.id] && taskStatus[task.id].startedAt) && <div data-nostart className="absolute top-0 bottom-0 left-0" style={{ borderLeft: '3px dashed rgba(15,23,42,0.75)' }} />}
                                                                </div>

                                                                <div className="relative z-30 pl-2 pr-1 pointer-events-none flex items-center gap-1 w-full h-full">
                                                                    {widthPx > 20 && (isPrimaryLane ? (
                                                                        <span className="text-white font-bold text-[11px] truncate leading-tight drop-shadow-md flex-1 flex items-center gap-1" style={labelInkOf(taskHex(task), !isSimpleBlock && !!(transitOverlap || inspectOverlap))}>
                                                                            {task.isComplete && <Check className="w-3 h-3 flex-shrink-0" />}
                                                                            {task.isInProgress && <Play className="w-3 h-3 flex-shrink-0" />}
                                                                            {(task.isAllergenActive || task.isPbActive) && <Biohazard className="w-3 h-3 text-rose-200 flex-shrink-0" />}
                                                                            <span className="truncate">{task.name}</span>
                                                                        </span>
                                                                    ) : (
                                                                        <span className="text-white/80 font-black text-[10px] flex-1 truncate drop-shadow-sm" style={inkOf(taskHex(task))}>+ {task.name}</span>
                                                                    ))}
                                                                    {isPrimaryLane && widthPx > 60 && !isDraggingMe && (
                                                                        <button
                                                                            onPointerDown={function(e) { e.stopPropagation(); }}
                                                                            onPointerUp={function(e) { e.stopPropagation(); }}
                                                                            onClick={function(e) { e.stopPropagation(); setBlockStatus(task, task.isComplete ? null : 'done'); }}
                                                                            title={task.isComplete ? 'Undo check-off' : 'Mark done'}
                                                                            className={`pointer-events-auto w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 border ${task.isComplete ? 'bg-white text-emerald-600 border-white' : 'bg-white/20 text-white border-white/60 hover:bg-white hover:text-emerald-600'}`}
                                                                        >
                                                                            <Check className="w-3 h-3" />
                                                                        </button>
                                                                    )}
                                                                </div>
                                                            </div>
                                                        );
                                                    });
                                                });
                                            })}

                                            {/* One line: where a new shift starts the timeline is interrupted by a copy of the names column, then carries on */}
                                            {stack && stack.groups.map(function(g, gi) {
                                                if (gi === 0) return null;
                                                return (
                                                    <div key={`ir-${gi}`} data-interruption={gi} data-interruption-start={Math.round(g.start)} className="absolute z-[25] bg-slate-50 border-x-2 border-slate-400 shadow-md flex flex-col no-pan" style={{ left: `${g.px}px`, width: `${INTERRUPT_PX}px`, top: 0, height: `${stack.rows * LANE_HEIGHT_PX}px` }}>
                                                        {renderStackNames(gi, true)}
                                                    </div>
                                                );
                                            })}
                                        </div>
                                        </React.Fragment>)}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            )}

            {/* CUSTOM TASK MODAL */}
            {isCustomTaskModalOpen && (
                <div className="fixed inset-0 bg-slate-900/40 z-[100] flex items-center justify-center backdrop-blur-sm p-4 touch-none" onPointerDown={function() { setIsCustomTaskModalOpen(false); }}>
                    <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-200" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
                        <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                            <h3 className="text-lg font-black text-slate-800">Add Custom Task</h3>
                            <Button variant="outline" size="sm" onClick={function() { setIsCustomTaskModalOpen(false); }} className="px-2 py-1 shadow-none text-slate-400 hover:text-slate-800">✕</Button>
                        </div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Task Name</label>
                                <input type="text" value={newTaskName} onChange={function(e) { setNewTaskName(e.target.value); }} className="w-full border border-slate-300 rounded p-2 text-sm font-bold outline-none" placeholder="e.g. Special Deep Clean" />
                            </div>
                            <div>
                                <label className="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1.5">Area</label>
