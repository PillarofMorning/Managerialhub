                        <div className="bg-white p-5 rounded-2xl shadow-2xl w-full max-w-4xl border border-slate-200 max-h-full overflow-y-auto touch-pan-y" onPointerDown={function(e) { if (e && typeof e.stopPropagation === 'function') e.stopPropagation(); }}>
