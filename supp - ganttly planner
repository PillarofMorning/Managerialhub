                                <p className="text-center text-slate-400 w-full py-10 font-bold">Nothing in the active rooms is marked yes for the type of clean picked {IS_CURRENT ? 'in PBED' : 'on the Setup tab'}.</p>
                            ) : sectioned(dashboardRooms, 'dash', function(room) {
                                // Ganttly (current): a finished clean and when it is due again (its cadence after the check-off), or that
                                // the next clean is already planned in the window. Nothing while a clean is still under way.
                                const doneInfo = function(a) {
                                    const p = IS_CURRENT ? scheduleData.parentById[a.id] : null;
                                    if (!p || !p.lastDoneMs || p.unscheduledWork > 0) return null;
                                    if (p.dueAgainMin === null && p.blocks.some(function(b) { return !b.isComplete; })) return null;
                                    return { doneMs: p.lastDoneMs, dueMs: p.dueMs && p.dueMs !== Infinity ? p.dueMs : null, planned: p.dueAgainMin !== null };
                                };
                                // PBED, overdue modes: why this piece is in the plan.
                                const odChip = function(a) {
                                    if (IS_CURRENT || !Array.isArray(a.flags)) return null;
                                    const mode = roomMode(a.area);
                                    const st = odStatus[a.id];
                                    if (mode === 'type' || !st) return null;
                                    if (st.state === 'overdue') return <span data-od-chip="overdue" className="block text-[10px] font-bold text-rose-700">{st.never ? 'Overdue · no ' + (st.any && st.needRank > 1 ? (st.needRank === 2 ? 'weekly-level ' : 'monthly-level ') : '') + 'clean logged in the last ' + (odTierOf(odFreqsOf(a.flags).reduce(function(m, f) { return Math.max(m, f.days); }, 0)) + 1) + ' days' : 'Overdue ' + st.worst + ' day' + (st.worst === 1 ? '' : 's')} · {st.letters.join(' + ')}</span>;
                                    if (mode === 'overdueweekly' && isWeeklyEq(a)) return <span data-od-chip="weekly" className="block text-[10px] font-bold text-amber-700">Weekly</span>;
                                    return null;
                                };
                                const typed = assets.filter(function(a) { return a.area === room && inCleanType(a); });
                                const roomTasks = typed.filter(function(a) { return !a.removed; });
                                const removedTasks = typed.filter(function(a) { return a.removed; });
                                if (typed.length === 0) return null;
                                
                                const totalBase = roomTasks.reduce(function(acc, t) { return acc + t.minutesRequired; }, 0);
                                const totalAllergen = roomTasks.reduce(function(acc, t) { return acc + t.allergenMins; }, 0);
                                const totalHeads = roomTasks.reduce(function(acc, t) { return acc + t.heads; }, 0);
                                const manpowerHours = roomAllergen[room] ? (totalAllergen / 60) : (totalBase / 60);

                                return (
                                    <div key={room} data-dash-room={room} className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
