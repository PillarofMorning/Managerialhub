  weekday: { textAlign: 'center', fontWeight: 700, padding: '4px', backgroundColor: '#E6F1FC', borderRadius: '4px' },
  entryText: { fontSize: '11px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' },
});

const primaryStyle = { backgroundColor: BRAND.blue, color: '#FFFFFF', border: `1px solid ${BRAND.blue}` };
const ctaStyle = { backgroundColor: BRAND.yellow, color: BRAND.ink, border: `1px solid ${BRAND.yellow}`, fontWeight: 700 };
const dangerStyle = { backgroundColor: BRAND.red, color: '#FFFFFF', border: `1px solid ${BRAND.red}` };

// --- LOGO ---
const BrandLogo = () => {
  if (LOGO_URL) return <img src={LOGO_URL} alt="Company logo" style={{ height: 44, display: 'block' }} />;
  return (
    <svg role="img" aria-label="Company logo" width="192" height="48" viewBox="0 0 192 48" style={{ display: 'block' }}>
      <ellipse cx="17" cy="11" rx="8" ry="9.5" fill={BRAND.logoBlue} transform="rotate(-25 17 11)" />
      <ellipse cx="36" cy="22" rx="8.5" ry="8.5" fill="#F89721" />
      <ellipse cx="21" cy="35" rx="8" ry="9.5" fill={BRAND.red} transform="rotate(15 21 35)" />
      <text x="52" y="31" fontFamily="Segoe UI, Arial, sans-serif" fontWeight="900" fontSize="22" fill={BRAND.ink}>CJ</text>
      <text x="86" y="31" fontFamily="Segoe UI, Arial, sans-serif" fontWeight="500" fontSize="19" fill={BRAND.ink} letterSpacing="0.5">SCHWAN’S</text>
    </svg>
  );
};

// --- ENTRY ROW: one SAP order, one or more equipment ---
const EntryRow = forwardRef(function EntryRow({ ctx, index, initialDate, initialInitials, onRemove, onEnter, canRemove }, ref) {
  const styles = useStyles();
  const { api, assets, assetById, assetsByName, codeIndex, rooms, areas, dataRef, maxDate, minDate } = ctx;

  const [code, setCode] = useState('');
  const [showSuggest, setShowSuggest] = useState(false);
  const [hi, setHi] = useState(0);
  const [dateStr, setDateStr] = useState(initialDate || maxDate);
  const [initials, setInitials] = useState(initialInitials || '');
  const [totalHours, setTotalHours] = useState('');
  const [photo, setPhoto] = useState(null);
  const [photoName, setPhotoName] = useState('');
  const [excluded, setExcluded] = useState({});
  const [pickedAsset, setPickedAsset] = useState({});
  const [hoursOverride, setHoursOverride] = useState({});
  const [editMode, setEditMode] = useState(false);
  const [edits, setEdits] = useState({});            // lineKey -> { name, room, area }
  const [dupes, setDupes] = useState(new Set());
  const [extras, setExtras] = useState([]);
  const [addOpen, setAddOpen] = useState(false);
  const [addMode, setAddMode] = useState('search');
  const [addFreq, setAddFreq] = useState('craa5_sapw');
  const [assetSearch, setAssetSearch] = useState('');
  const [newRoom, setNewRoom] = useState('');
  const [newArea, setNewArea] = useState('');
  const [newName, setNewName] = useState('');
  const [note, setNote] = useState('');
  const seq = useRef(0);

  const normalizedCode = normCode(code);
  const matches = normalizedCode ? codeIndex.get(normalizedCode) || [] : [];

  const suggestions = useMemo(() => {
    if (normalizedCode.length < 2) return [];
    const starts = [];
    const contains = [];
    for (const [c, list] of codeIndex) {
      if (!c.includes(normalizedCode)) continue;
      const names = [...new Set(list.map(x => x.row.equipment).filter(Boolean))];
      const item = { code: c, count: new Set(list.map(x => x.row.id)).size, names: names.slice(0, 2).join(', ') };
      (c.startsWith(normalizedCode) ? starts : contains).push(item);
      if (starts.length >= 10) break;
    }
    return [...starts, ...contains].slice(0, 10);
  }, [normalizedCode, codeIndex]);

  const clearOrderState = () => {
    setExcluded({}); setPickedAsset({}); setHoursOverride({}); setExtras([]); setEdits({});
    setAddOpen(false); setEditMode(false); setNote('');
  };
  const selectCode = (c) => { setCode(c); setShowSuggest(false); clearOrderState(); };

  // Lines: one per equipment on the order
  const lines = useMemo(() => {
    const seen = new Set();
    const out = [];
    matches.forEach(({ row, col }) => {
      const key = row.id;
      let asset = row.assetId ? assetById.get(row.assetId) : null;
      let how = asset ? 'linked' : '';
      if (!asset && pickedAsset[key]) { asset = assetById.get(pickedAsset[key]); how = 'picked'; }
      if (!asset) {
        const cands = (assetsByName.get(normName(row.equipment)) || [])
          .filter(a => !row.room || normName(a.room) === normName(row.room));
        if (cands.length === 1) { asset = cands[0]; how = 'matched by name'; }
      }
      if (asset) {
        if (seen.has(asset.id)) return;
        seen.add(asset.id);
      }
      out.push({ key, msId: row.id, col, how, asset, name: asset ? asset.name : row.equipment, room: asset ? asset.room : row.room, area: asset ? asset.area : row.area });
    });
    extras.forEach(x => {
      if (!x.asset.isNew && seen.has(x.asset.id)) return;
      if (!x.asset.isNew) seen.add(x.asset.id);
      out.push({ key: x.key, msId: null, col: x.col, how: x.asset.isNew ? 'new equipment' : 'added', asset: x.asset, name: x.asset.name, room: x.asset.room, area: x.asset.area, extra: true });
    });
    // Apply "edit pre-filled details" overrides
    return out.map(l => (edits[l.key] ? { ...l, name: edits[l.key].name, room: edits[l.key].room, area: edits[l.key].area } : l));
  }, [matches, assetById, assetsByName, pickedAsset, extras, edits]);

  const included = lines.filter(l => !excluded[l.key] && l.asset);
  const evenHours = useMemo(() => {
    const free = included.filter(l => hoursOverride[l.key] === undefined);
    const fixed = included.reduce((s, l) => s + (hoursOverride[l.key] || 0), 0);
    const split = splitHours((parseFloat(totalHours) || 0) - fixed, free.length);
    const map = {};
    free.forEach((l, i) => { map[l.key] = split[i] || 0; });
    return map;
  }, [included, hoursOverride, totalHours]);
  const lineHours = (l) => (hoursOverride[l.key] !== undefined ? hoursOverride[l.key] : evenHours[l.key] || 0);
  const hoursSum = Math.round(included.reduce((s, l) => s + lineHours(l), 0) * 100) / 100;

  // Skip equipment already logged for the same order and date
  useEffect(() => {
    setDupes(new Set());
    if (!matches.length || !dateStr) return undefined;
    let cancelled = false;
    api.query(LOG_TABLE, {
      select: ['craa5_equipmentguid'],
      filter: `craa5_sap eq '${escOData(normalizedCode)}' and craa5_lastcleaned ge ${dateStr}T00:00:00Z and craa5_lastcleaned lt ${nextDay(dateStr)}T00:00:00Z`,
    }).then(rows => { if (!cancelled) setDupes(new Set(rows.map(r => r.craa5_equipmentguid))); }).catch(() => {});
    return () => { cancelled = true; };
  }, [api, normalizedCode, dateStr, matches.length]);

  const isUnknown = normalizedCode.length >= 3 && matches.length === 0;
  const showAdd = normalizedCode.length >= 3;
  const assetChoices = useMemo(() => {
    const q = normName(assetSearch);
    if (q.length < 2) return [];
    const taken = new Set(lines.map(l => l.asset && l.asset.id));
    return assets.filter(a => !taken.has(a.id) && normName(`${a.room}${a.area}${a.name}`).includes(q)).slice(0, 20);
  }, [assets, assetSearch, lines]);

  const addExtra = (asset) => {
    seq.current += 1;
    setExtras(p => [...p, { key: `x-${seq.current}`, asset, col: addFreq }]);
    setAssetSearch(''); setNewName('');
  };
  const addNew = () => {
    if (!newRoom.trim() || !newArea.trim() || !newName.trim()) { setNote('Enter room, area and equipment name for the new equipment.'); return; }
    setNote('');
    seq.current += 1;
    addExtra({ id: `new:${seq.current}`, isNew: true, name: newName.trim(), room: newRoom.trim(), area: newArea.trim() });
  };

  const startEdit = (on) => {
    setEditMode(on);
    if (!on) { setEdits({}); return; }
    const e = {};
    lines.forEach(l => { if (l.asset && !l.asset.isNew) e[l.key] = { name: l.name, room: l.room, area: l.area }; });
    setEdits(e);
  };

  const onPhoto = async (file) => {
    if (!file) { setPhoto(null); setPhotoName(''); return; }
    setPhotoName(file.name);
    setPhoto(await compressImage(file));
  };

  const validate = () => {
    if (!normalizedCode) return 'Enter a SAP order.';
    if (!dateStr || dateStr > maxDate || dateStr < minDate) return 'Date must be within the last year and not in the future.';
    if (!INITIALS_RE.test(normalizeInitials(initials))) return 'Initials: letters only, up to 4 per person, separate people with "/" (e.g. EL/LH).';
    const total = parseFloat(totalHours);
    if (!(total > 0) || total > 200) return 'Enter the hours it took (greater than 0).';
    if (lines.length === 0) return 'This SAP order is not in the list. Add the equipment it covers.';
    if (lines.some(l => !excluded[l.key] && !l.asset)) return 'Pick the equipment for the highlighted line(s), or remove them.';
    if (lines.some(l => !excluded[l.key] && (!safeString(l.name) || !safeString(l.room) || !safeString(l.area)))) return 'Every equipment line needs a name, room and area.';
    if (included.length === 0) return 'Nothing to log: no equipment selected.';
    if (included.every(l => dupes.has(l.asset.id))) return 'Every selected equipment already has this order logged for that date.';
    if (Math.abs(hoursSum - total) > 0.01) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    return '';
  };

  // Write the SAP order onto an equipment's SAP row (update its frequency column, or create the row)
  const storeCode = async (asset, col, notes) => {
    const data = dataRef.current;
    const row = data.msRows.find(r => r.assetId === asset.id)
      || data.msRows.find(r => !r.assetId && normName(r.equipment) === normName(asset.name) && (!r.room || normName(r.room) === normName(asset.room)));
    const existing = row && (row.codes.find(c => c.col === col) || {}).code;
    if (row && existing === normalizedCode) return;
    if (row && existing && !window.confirm(`${asset.name} already has ${existing} as its ${freqLabel(col)} code. Replace it with ${normalizedCode}?`)) {
      notes.push(`${asset.name}: kept ${existing}; ${normalizedCode} was not stored on it.`);
      return;
    }
    if (row) {
      await api.update(MS_TABLE, row.id, { [col]: normalizedCode, ...(row.assetId ? {} : { 'craa5_asset@odata.bind': `/${ASSET_SET}(${asset.id})` }) });
      ctx.upsertMs({ ...row, assetId: asset.id, codes: [...row.codes.filter(c => c.col !== col), { col, code: normalizedCode }] });
      return;
    }
    const payload = { craa5_title: normalizedCode, [col]: normalizedCode, craa5_equipment: asset.name, craa5_textroom: asset.room, craa5_textarea: asset.area };
    let id;
    let linked = true;
    try { id = await api.create(MS_TABLE, { ...payload, 'craa5_asset@odata.bind': `/${ASSET_SET}(${asset.id})` }); }
    catch (_) { id = await api.create(MS_TABLE, payload); linked = false; }
    if (!linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
    ctx.upsertMs({ id, equipment: asset.name, room: asset.room, area: asset.area, assetId: linked ? asset.id : null, codes: [{ col, code: normalizedCode }] });
  };

  const commit = async () => {
    const notes = [];
    const ini = normalizeInitials(initials);
    // 1. Equipment edits made through "Edit pre-filled details"
    for (const l of lines) {
      if (excluded[l.key] || !l.asset || l.asset.isNew || !edits[l.key]) continue;
      const a = l.asset;
      if (a.name !== l.name || a.room !== l.room || a.area !== l.area) {
        try {
          await api.update(ASSET_TABLE, a.id, { craa5_equipmentidentifier: l.name, craa5_roomname: l.room, craa5_areaname: l.area });
          ctx.patchAsset({ ...a, name: l.name, room: l.room, area: l.area });
        } catch (e) { return { saved: 0, notes, error: `Could not update ${a.name}: ${errText(e)}` }; }
      }
    }
    // 2. Create new equipment, then store the SAP order on every added equipment
    const resolved = {};
    for (const l of included.filter(x => x.extra)) {
      let asset = { ...l.asset, name: l.name, room: l.room, area: l.area };
      if (l.asset.isNew) {
        const dupKey = `${normName(asset.name)}|${normName(asset.room)}|${normName(asset.area)}`;
        const reuse = dataRef.current.assets.find(a => `${normName(a.name)}|${normName(a.room)}|${normName(a.area)}` === dupKey);
        if (reuse) asset = reuse;
        else {
          try {
            const id = await api.create(ASSET_TABLE, { craa5_equipmentidentifier: asset.name, craa5_roomname: asset.room, craa5_areaname: asset.area });
            asset = { id, name: asset.name, room: asset.room, area: asset.area };
            ctx.addAsset(asset);
          } catch (e) { return { saved: 0, notes, error: `Could not create ${asset.name}: ${errText(e)}` }; }
        }
      }
      resolved[l.key] = asset;
      try { await storeCode(asset, l.col, notes); } catch (e) { notes.push(`${asset.name}: could not store the SAP order (${errText(e)}).`); }
    }
    // 3. Existing SAP rows matched by name or picked by hand get their asset link written back
    const toLog = included.filter(l => !dupes.has((resolved[l.key] || l.asset).id))
      .map(l => ({ asset: resolved[l.key] || l.asset, name: l.name, room: l.room, area: l.area, hours: lineHours(l), msId: l.msId, how: l.how }));
    const skipped = included.length - toLog.length;
    if (skipped) notes.push(`${skipped} equipment skipped: already logged for this order and date.`);
    for (const l of toLog) {
      if (l.msId && (l.how === 'matched by name' || l.how === 'picked')) {
        try {
          await api.update(MS_TABLE, l.msId, { 'craa5_asset@odata.bind': `/${ASSET_SET}(${l.asset.id})` });
          const row = dataRef.current.msRows.find(r => r.id === l.msId);
          if (row) ctx.upsertMs({ ...row, assetId: l.asset.id });
        } catch (_) { notes.push(`Could not store the equipment link for ${l.asset.name} on the SAP row.`); }
      }
    }
    // 4. One log row per equipment
    const results = await pool(toLog, 6, (l) => api.create(LOG_TABLE, {
      craa5_equipmentguid: l.asset.id,
      craa5_equipment: l.name,
      craa5_room: l.room,
      craa5_area: l.area,
      craa5_sap: normalizedCode,
      craa5_lastcleaned: toLogDate(dateStr),
      craa5_lastcleanedby: ini,
      craa5_hoursworked: l.hours,
    }));
    const failed = results.filter(r => !r.ok);
    const savedIds = results.filter(r => r.ok).map(r => r.value);
    if (photo && savedIds.length) {
      const pr = await pool(savedIds, 4, (id) => api.update(LOG_TABLE, id, { craa5_pictureorfileofpaperwork: photo }));
      if (pr.some(r => !r.ok)) notes.push('Entries saved, but the paperwork photo could not be attached.');
    }
    if (failed.length) {
      return { saved: savedIds.length, notes, error: `${savedIds.length} of ${results.length} saved. Failed: ${errText(failed[0].error)}. Submit again; saved equipment is skipped as already logged.` };
    }
    return { saved: savedIds.length, notes, code: normalizedCode, date: dateStr };
  };

  useImperativeHandle(ref, () => ({ validate, commit, getShared: () => ({ date: dateStr, initials: normalizeInitials(initials) }) }));

  // Summary values for the read-only Room / Area / Equipment fields
  const live = lines.filter(l => !excluded[l.key]);
  const summarize = (k) => { const v = [...new Set(live.map(l => l[k]).filter(Boolean))]; return v.length === 0 ? '' : v.length === 1 ? v[0] : `Multiple (${v.length})`; };

  return (
    <div className={styles.rowCard}>
      <div className={styles.rowFields}>
        <div className={styles.field}>
          <Text className={styles.label}>SAP Order (Req)</Text>
          <Input
            data-row={index}
            data-col="sap"
            aria-label="SAP order"
            autoComplete="off"
            placeholder="Start typing the SAP order…"
            value={code}
            style={{ minWidth: '210px' }}
            onChange={(e, d) => { setCode(d.value); setShowSuggest(true); setHi(0); clearOrderState(); }}
            onFocus={() => setShowSuggest(true)}
            onBlur={() => setTimeout(() => setShowSuggest(false), 150)}
            onKeyDown={(e) => {
              const open = showSuggest && suggestions.length > 0 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode);
              if (open && e.key === 'ArrowDown') { e.preventDefault(); setHi(h => Math.min(h + 1, suggestions.length - 1)); }
              else if (open && e.key === 'ArrowUp') { e.preventDefault(); setHi(h => Math.max(h - 1, 0)); }
              else if (open && e.key === 'Enter') { e.preventDefault(); selectCode(suggestions[Math.min(hi, suggestions.length - 1)].code); }
              else if (e.key === 'Escape') setShowSuggest(false);
              else if (e.key === 'Enter') { e.preventDefault(); onEnter(index); }
            }}
          />
          {showSuggest && suggestions.length > 0 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode) && (
            <div className={styles.suggest} role="listbox">
              {suggestions.map((s, i) => (
                <button key={s.code} type="button" role="option" aria-selected={i === hi} className={styles.suggestItem}
                  style={i === hi ? { backgroundColor: '#E6F1FC' } : undefined}
                  onMouseDown={(e) => e.preventDefault()} onClick={() => selectCode(s.code)}>
                  <span><strong>{s.code}</strong>{s.names && <span className={styles.hint}> · {s.names}{s.count > 2 ? '…' : ''}</span>}</span>
                  <span className={styles.hint}>{s.count} equipment</span>
                </button>
              ))}
            </div>
          )}
          {matches.length > 0 && lines.length > 0 && (
            <Checkbox label={<Text size={200}>Edit pre-filled details</Text>} checked={editMode} onChange={(e, d) => startEdit(!!d.checked)} />
          )}
        </div>

        <div className={styles.field}>
          <Text className={styles.label}>Room</Text>
          <Input aria-label="Room" value={summarize('room')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Area</Text>
          <Input aria-label="Area" value={summarize('area')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Equipment</Text>
          <Input aria-label="Equipment" value={live.length > 1 ? `${live.length} equipment` : summarize('name')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Date (Req)</Text>
          <Input aria-label="Date completed" type="date" value={dateStr} min={minDate} max={maxDate} onChange={(e, d) => setDateStr(d.value)} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Total Hours (Req)</Text>
          <Input aria-label="Total hours" type="number" placeholder="Ex: 2.5" value={totalHours} onChange={(e, d) => setTotalHours(d.value)} style={{ width: '100px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Initials (Req)</Text>
          <Input aria-label="Initials" placeholder="Ex: EL/LH" value={initials} onChange={(e, d) => setInitials(d.value)} style={{ minWidth: '90px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Paperwork Picture</Text>
          <input type="file" accept="image/*" aria-label="Paperwork picture" onChange={(e) => onPhoto(e.target.files && e.target.files[0])} style={{ minWidth: '150px', padding: '4px' }} />
          {photoName && <span className={styles.hint}>{photoName}</span>}
        </div>
        <Button appearance="subtle" style={{ alignSelf: 'flex-start', marginTop: '16px' }} disabled={!canRemove} onClick={onRemove}>Remove</Button>
      </div>

      {isUnknown && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          {normalizedCode} is not in the cached SAP orders. Add the equipment it covers below and it will be saved against that equipment.
        </Text>
      )}

      {lines.length > 0 && (
        <table className={styles.linesTable}>
          <thead><tr>
            <th className={styles.th}></th><th className={styles.th}>Equipment</th><th className={styles.th}>Room</th><th className={styles.th}>Area</th>
            <th className={styles.th}>Frequency</th><th className={styles.th}>Hours</th><th className={styles.th}>Status</th>
          </tr></thead>
          <tbody>
            {lines.map(l => {
              const off = !!excluded[l.key];
              const dupe = l.asset && dupes.has(l.asset.id);
              const editing = editMode && edits[l.key];
              return (
                <tr key={l.key} style={off ? { color: '#94A3B8' } : !l.asset ? { backgroundColor: '#FFF6E6' } : undefined}>
                  <td className={styles.td}><input type="checkbox" aria-label={`Include ${l.name}`} checked={!off} onChange={(e) => setExcluded(p => ({ ...p, [l.key]: !e.target.checked }))} /></td>
                  <td className={styles.td}>
                    {editing ? (
                      <Input size="small" value={edits[l.key].name} onChange={(e, d) => setEdits(p => ({ ...p, [l.key]: { ...p[l.key], name: d.value } }))} />
                    ) : <strong>{l.name || '(unnamed)'}</strong>}
                    {l.extra && <Button size="small" appearance="subtle" style={{ marginLeft: 6 }} onClick={() => setExtras(p => p.filter(x => x.key !== l.key))}>Remove</Button>}
                    {!l.asset && (
                      <div style={{ marginTop: 4 }}>
                        <Select aria-label={`Pick equipment for ${l.name}`} value="" onChange={(e, d) => setPickedAsset(p => ({ ...p, [l.key]: d.value }))}>
                          <option value="">Pick equipment…</option>
                          {assets.filter(a => !l.room || normName(a.room) === normName(l.room)).slice(0, 300).map(a => (
                            <option key={a.id} value={a.id}>{a.room} / {a.area} / {a.name}</option>
                          ))}
                        </Select>
                      </div>
                    )}
                  </td>
                  <td className={styles.td}>{editing ? <Input size="small" list="mss-rooms" value={edits[l.key].room} onChange={(e, d) => setEdits(p => ({ ...p, [l.key]: { ...p[l.key], room: d.value } }))} /> : l.room}</td>
                  <td className={styles.td}>{editing ? <Input size="small" list="mss-areas" value={edits[l.key].area} onChange={(e, d) => setEdits(p => ({ ...p, [l.key]: { ...p[l.key], area: d.value } }))} /> : l.area}</td>
                  <td className={styles.td}>{l.col ? freqLabel(l.col) : ''}</td>
                  <td className={styles.td}>
                    {l.asset && !off ? (
                      <Input size="small" aria-label={`Hours for ${l.name}`} type="number" style={{ width: 90 }} value={String(lineHours(l))}
                        onChange={(e, d) => setHoursOverride(p => ({ ...p, [l.key]: parseFloat(d.value) || 0 }))} />
                    ) : '–'}
                  </td>
                  <td className={styles.td}>
                    {dupe ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>already logged</span>
