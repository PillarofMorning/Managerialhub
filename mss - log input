const SCAN_MODES = {
  all_issues: { label: 'All issues at once (missing ID, deleted ID, room/area changed, or multi-piece)', kind: 'all issues', pageSize: 250, pages: 6 },
  missing: { label: 'Entries with no equipment ID', kind: 'missing id', pageSize: 250, pages: 4 },
  unknown: { label: 'Entries whose ID no longer exists in current assets', kind: 'unknown id', pageSize: 250, pages: 6 },
  place: { label: 'Entries whose Room, Area, or Equipment name changed from current asset', kind: 'renamed / moved', pageSize: 250, pages: 6 },
  several: { label: 'Entries that list several pieces of equipment (broken-down assets)', kind: 'several pieces', pageSize: 250, pages: 6 },
  relink: { label: 'Any entries - bulk relink, sync renamed room/area/name, or split history to child pieces', kind: 'relink / sync', pageSize: 250, pages: 6 },
};
// Text that lists several things: a comma, semicolon, plus, ampersand or slash, or the word and / plus (the list is checked again on screen)
const LISTS_SEVERAL = `(${[',', ';', '+', '&', '/', ' and ', ' And ', ' AND ', ' plus ', ' Plus ', ' PLUS '].map(x => `contains(craa5_equipment,'${x}')`).join(' or ')})`;
const scanFilter = (mode, scope, serverSearch = '') => {
  const parts = [];
  if (mode === 'missing') parts.push(BLANK_GUID);
  else if (mode === 'several') parts.push(LISTS_SEVERAL);
  else if (mode === 'unknown' || mode === 'place') parts.push(`craa5_equipmentguid ne null and craa5_equipmentguid ne ''`);
  if (scope === 'year') parts.push(`craa5_lastcleaned ge ${daysAgo(366)}T00:00:00Z`);
  else if (scope === '90d') parts.push(`craa5_lastcleaned ge ${daysAgo(90)}T00:00:00Z`);
  const q = safeString(serverSearch).trim();
  if (q) {
    parts.push(`(${ciContains('craa5_equipment', q)} or ${ciContains('craa5_room', q)} or ${ciContains('craa5_area', q)} or ${ciContains('craa5_sap', q)})`);
  }
  return parts.length ? parts.join(' and ') : undefined;
};

// What a break-up did, for the message under the buttons
