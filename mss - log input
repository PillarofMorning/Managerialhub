// Xrm.WebApi appends the options string to the URL as is, so text typed into a filter (& # + %) must be percent-encoded inside its quotes.
const encodeFilterText = (filter) => filter.replace(/'(?:[^']|'')*'/g, (lit) => `'${encodeURIComponent(lit.slice(1, -1))}'`);

const makeApi = (dataApi) => {
  if (typeof Xrm !== 'undefined' && Xrm.WebApi) {
    return {
      mode: 'dataverse',
      async query(table, { select, filter, top = 100, orderBy } = {}) {
        const parts = [];
        if (select) parts.push(`$select=${select.join(',')}`);
        if (filter) parts.push(`$filter=${encodeFilterText(filter)}`);
        if (orderBy) parts.push(`$orderby=${orderBy}`);
        parts.push(`$top=${top}`);
        const res = await Xrm.WebApi.retrieveMultipleRecords(table, `?${parts.join('&')}`);
        return res.entities || [];
      },
      async create(table, payload) { return (await Xrm.WebApi.createRecord(table, payload)).id; },
      async update(table, id, payload) { await Xrm.WebApi.updateRecord(table, id, payload); },
      async remove(table, id) { await Xrm.WebApi.deleteRecord(table, id); },
    };
  }
  if (dataApi) {
    return {
      mode: 'dataverse',
      async query(table, { select, filter, top = 100, orderBy } = {}) {
        const res = await dataApi.queryTable(table, { select, filter, orderBy, pageSize: top });
        return ((res && res.rows) || []).slice(0, top);
      },
      async create(table, payload) {
        const res = await dataApi.createRow(table, payload);
        return (res && (res.id || res[`${table}id`])) || res;
      },
      async update(table, id, payload) { await dataApi.updateRow(table, id, payload); },
      async remove(table, id) { await dataApi.deleteRow(table, id); },
    };
  }
  return makeMock();
};

// --- STORE: targeted, cached lookups (never loads a whole table) ---
const makeStore = (api) => {
  const assets = new Map();   // asset id -> { id, name, room, area }
  const gone = new Set();     // ids confirmed missing from craa5_aa_assets
  const cache = { orderSearch: new Map(), orders: new Map(), assetSearch: new Map(), names: new Map(), field: new Map() };
  let lookup = null;          // does craa5_aa_ms_assets have the craa5_asset lookup? null until first probed

  const toAsset = (r) => ({ id: cleanGuid(r.craa5_aa_assetsid), name: safeString(r.craa5_equipmentidentifier), room: safeString(r.craa5_roomname), area: safeString(r.craa5_areaname) });
  const keep = (rows) => rows.map(r => { const a = toAsset(r); assets.set(a.id, a); gone.delete(a.id); return a; });
  const queryAssets = async (filter, top) => keep(await api.query(ASSET_TABLE, { select: ASSET_SELECT, filter, top, orderBy: 'craa5_equipmentidentifier' }));

  // Look up specific assets by id (only the ones not already cached), in small chunks.
  const resolve = async (ids) => {
    const need = [...new Set(ids.map(cleanGuid))].filter(id => isGuid(id) && !assets.has(id) && !gone.has(id));
    const rs = await pool(chunked(need, LIMITS.idChunk), 4, async (c) => {
      const found = await queryAssets(c.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), c.length);
      const got = new Set(found.map(a => a.id));
      c.forEach(id => { if (!got.has(id)) gone.add(id); });
    });
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
  };

  const msSelect = (withLookup) => ['craa5_aa_ms_assetsid', 'craa5_equipment', 'craa5_textroom', 'craa5_textarea', ...CODE_COLS, ...(withLookup ? ['_craa5_asset_value'] : [])];
  const toMs = (r) => ({
    id: r.craa5_aa_ms_assetsid, equipment: safeString(r.craa5_equipment), room: safeString(r.craa5_textroom), area: safeString(r.craa5_textarea),
    assetId: cleanGuid(r._craa5_asset_value) || null,
    codes: CODE_COLS.map(col => ({ col, code: normCode(r[col]) })).filter(c => c.code),
  });
  // SAP rows. The craa5_asset lookup may not exist yet: the first query probes it and falls back without it.
  const queryMs = async (filter, top) => {
    const f = (withLookup) => (typeof filter === 'function' ? filter(withLookup) : filter);
    if (lookup !== false) {
      try { const rows = await api.query(MS_TABLE, { select: msSelect(true), filter: f(true), top }); lookup = true; return rows.map(toMs); }
      catch (e) { if (lookup === true) throw e; }
    }
    const rows = await api.query(MS_TABLE, { select: msSelect(false), filter: f(false), top });
    lookup = false;
    return rows.map(toMs);
  };
  const codeFilter = (op, v) => CODE_COLS.map(c => (op === 'eq' ? `${c} eq '${v}'` : `contains(${c},'${v}')`)).join(' or ');

  // Equipment rows for a list of names (used when an SAP row has no asset lookup)
  const assetsByNames = async (names) => {
    const out = new Map();
    const rs = await pool(chunked(names, LIMITS.nameChunk), 3, (c) => queryAssets(c.map(n => `craa5_equipmentidentifier eq '${escOData(n)}'`).join(' or '), 200));
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
    rs.forEach(r => r.value.forEach(a => { const k = normName(a.name); if (!out.has(k)) out.set(k, []); out.get(k).push(a); }));
    return out;
  };

  const store = {
    lookupState: () => lookup,
    getAsset: (id) => assets.get(cleanGuid(id)),
    hasAsset: (id) => assets.has(cleanGuid(id)),
    isGone: (id) => !isGuid(id) || gone.has(cleanGuid(id)),
    resolveAssets: resolve,
    dropOrders() { cache.orderSearch.clear(); cache.orders.clear(); },

    // SAP order typeahead. Server search, small limit; a shorter cached search that was not truncated answers longer ones locally.
    async searchOrders(q) {
      const key = normCode(q);
      if (key.length < 2) return { items: [], truncated: false };
      let entry = cache.orderSearch.get(key);
      if (!entry) {
        for (const [k, e] of cache.orderSearch) {
          if (!e.truncated && key.includes(k)) { entry = { rows: e.rows.filter(r => r.codes.some(c => c.code.includes(key))), truncated: false }; break; }
        }
        if (!entry) {
          const rows = await queryMs(codeFilter('contains', escOData(key)), LIMITS.orderSuggest);
          entry = { rows, truncated: rows.length >= LIMITS.orderSuggest };
        }
        cache.orderSearch.set(key, entry);
      }
      const by = new Map();
      entry.rows.forEach(r => r.codes.forEach(c => {
        if (!c.code.includes(key)) return;
        if (!by.has(c.code)) by.set(c.code, { code: c.code, ids: new Set(), names: new Set() });
        const x = by.get(c.code);
        x.ids.add(r.id);
        if (r.equipment) x.names.add(r.equipment);
      }));
      const items = [...by.values()]
        .sort((a, b) => (b.code.startsWith(key) ? 1 : 0) - (a.code.startsWith(key) ? 1 : 0) || a.code.localeCompare(b.code))
        .slice(0, 10)
        .map(x => ({ code: x.code, count: x.ids.size, names: [...x.names].slice(0, 2).join(', ') }));
      return { items, truncated: entry.truncated };
    },

    // One SAP order: its SAP rows, with each row's equipment resolved (lookup first, then exact name).
    loadOrder(code) {
      const c = normCode(code);
      if (!cache.orders.has(c)) {
        cache.orders.set(c, (async () => {
          const rows = await queryMs(codeFilter('eq', escOData(c)), LIMITS.orderRows);
          await resolve(rows.map(r => r.assetId).filter(Boolean));
          const loose = rows.filter(r => !(r.assetId && assets.has(r.assetId)));
          const byName = loose.length ? await assetsByNames([...new Set(loose.map(r => r.equipment).filter(Boolean))]) : new Map();
          const entries = rows.map(r => {
            const col = (r.codes.find(x => x.code === c) || {}).col;
            let asset = null, how = '';
            if (r.assetId && assets.has(r.assetId)) { asset = assets.get(r.assetId); how = 'linked'; }
            else {
              const hits = (byName.get(normName(r.equipment)) || []).filter(a => !r.room || normName(a.room) === normName(r.room));
              if (hits.length === 1) { asset = hits[0]; how = 'matched by name'; }
            }
            return { key: r.id, msId: r.id, col, how, asset, equipment: r.equipment, room: r.room, area: r.area };
          });
          return { code: c, entries, capped: rows.length >= LIMITS.orderRows };
        })().catch((e) => { cache.orders.delete(c); throw e; }));
      }
      return cache.orders.get(c);
    },

    // Free-text equipment search: every word must appear in the name, room or area.
    async searchAssets(text) {
      const tokens = safeString(text).toLowerCase().split(/[^a-z0-9]+/).filter(Boolean).slice(0, 4);
      if (!tokens.length || tokens.join('').length < 2) return [];
      const key = tokens.join(' ');
      if (!cache.assetSearch.has(key)) {
        const filter = tokens.map(t => `(contains(craa5_equipmentidentifier,'${t}') or contains(craa5_roomname,'${t}') or contains(craa5_areaname,'${t}'))`).join(' and ');
        const found = await queryAssets(filter, LIMITS.assetSearch);
        const score = (a) => tokens.filter(t => a.name.toLowerCase().includes(t)).length;
        cache.assetSearch.set(key, found.sort((a, b) => score(b) - score(a) || a.name.localeCompare(b.name)));
      }
      return cache.assetSearch.get(key);
    },

    // Candidate equipment for a name from an old log entry: a few server searches on its main words, never the whole table.
    async assetsLikeName(words, room) {
      const ws = [...words].filter(w => w.length >= 2).sort((a, b) => b.length - a.length).slice(0, 2);
      if (!ws.length) return [];
      const key = `${ws.join(',')}|${normName(room)}`;
      if (!cache.names.has(key)) {
        const nameClause = (list) => `(${list.map(w => `contains(craa5_equipmentidentifier,'${escOData(w)}')`).join(' or ')})`;
        const roomClause = room ? ` and contains(craa5_roomname,'${escOData(room)}')` : '';
        let found = await queryAssets(nameClause(ws) + roomClause, LIMITS.assetNames);
        if (!found.length) found = await queryAssets(nameClause(ws.map(w => w.slice(0, 3))) + roomClause, LIMITS.assetNames);
        if (!found.length && room) found = await queryAssets(nameClause(ws), LIMITS.assetNames);
        cache.names.set(key, found);
      }
      return cache.names.get(key);
    },

    async findAssetExact(name, room, area) {
      const rows = await queryAssets(`craa5_equipmentidentifier eq '${escOData(name)}' and craa5_roomname eq '${escOData(room)}' and craa5_areaname eq '${escOData(area)}'`, 5);
      return rows[0] || null;
    },
    async createAsset(a) {
      const id = cleanGuid(await api.create(ASSET_TABLE, { craa5_equipmentidentifier: a.name, craa5_roomname: a.room, craa5_areaname: a.area }));
      const asset = { id, name: a.name, room: a.room, area: a.area };
      assets.set(id, asset); gone.delete(id);
      return asset;
    },
    async updateAsset(a, name, room, area) {
      await api.update(ASSET_TABLE, a.id, { craa5_equipmentidentifier: name, craa5_roomname: room, craa5_areaname: area });
      const asset = { id: a.id, name, room, area };
      assets.set(a.id, asset);
      return asset;
    },

    // Distinct values for room/area suggestions while typing a new piece of equipment
    async suggestField(col, text, room) {
      const t = safeString(text);
      if (t.length < 2) return [];
      const key = `${col}|${t.toLowerCase()}|${normName(room)}`;
      if (!cache.field.has(key)) {
        const parts = [`contains(${col},'${escOData(t)}')`];
        if (room) parts.push(`craa5_roomname eq '${escOData(room)}'`);
        const rows = await api.query(ASSET_TABLE, { select: [col], filter: parts.join(' and '), top: 40, orderBy: col });
        cache.field.set(key, [...new Set(rows.map(r => safeString(r[col])).filter(Boolean))].slice(0, 15));
      }
      return cache.field.get(key);
    },

    // The SAP row that belongs to one equipment (by lookup, else by exact name + room)
    async findMsForAsset(asset) {
      const byName = `(craa5_equipment eq '${escOData(asset.name)}' and craa5_textroom eq '${escOData(asset.room)}')`;
      const rows = await queryMs((withLookup) => (withLookup ? `_craa5_asset_value eq ${asset.id} or ${byName}` : byName), 10);
      return rows.find(r => r.assetId === asset.id)
        || rows.find(r => !r.assetId && normName(r.equipment) === normName(asset.name) && (!r.room || normName(r.room) === normName(asset.room)))
        || null;
    },
    // Create (id null) or update an SAP row, linking it to its asset when the lookup exists. Returns { id, linked, tried }.
    async writeMs(id, payload, asset) {
      const run = (p) => (id ? api.update(MS_TABLE, id, p).then(() => id) : api.create(MS_TABLE, p));
      if (asset && lookup !== false) {
        try { return { id: await run({ ...payload, 'craa5_asset@odata.bind': `/${ASSET_SET}(${asset.id})` }), linked: true, tried: true }; }
        catch (_) { /* retry without the lookup below */ }
        return { id: await run(payload), linked: false, tried: true };
      }
      return { id: await run(payload), linked: false, tried: false };
    },
  };
  return store;
};

const compressImage = (file) => new Promise((resolve) => {
  const reader = new FileReader();
  reader.onload = (e) => {
    const img = new Image();
    img.onload = () => {
      const scale = Math.min(1, 1000 / Math.max(img.width, img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * scale);
      c.height = Math.round(img.height * scale);
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      resolve(c.toDataURL('image/jpeg', 0.7).split(',')[1]);
    };
    img.onerror = () => resolve(null);
    img.src = e.target.result;
  };
  reader.onerror = () => resolve(null);
  reader.readAsDataURL(file);
});

