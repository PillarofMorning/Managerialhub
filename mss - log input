    const fixed = rows.reduce((s, r) => s + (typed(r.key) || 0), 0);
    const totalWhole = Math.max(0, Math.ceil(parseFloat(totalHours) || 0));
    const share = splitHours(Math.max(0, totalWhole - fixed), free.length);
    const map = {};
