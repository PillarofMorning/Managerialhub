// --- APP ---
export default function GeneratedComponent(props) {
  const dataApi = props && props.dataApi;
  const styles = useStyles();
  // The data source is chosen once; the latest dataApi object is always used through the ref
  const dataApiRef = useRef(dataApi);
  dataApiRef.current = dataApi || dataApiRef.current;
  const hasDataApi = !!dataApi;
  const api = useMemo(() => makeApi(dataApiRef, props), [hasDataApi]); // eslint-disable-line react-hooks/exhaustive-deps
  const store = useMemo(() => makeStore(api), [api]);
  // Today moves on at midnight, so a form left open overnight still accepts the current date
  const [maxDate, setMaxDate] = useState(() => toDateInput(new Date()));
  useEffect(() => {
    const t = setInterval(() => { const d = toDateInput(new Date()); setMaxDate(p => (p === d ? p : d)); }, 60000);
    return () => clearInterval(t);
  }, []);
  const minDate = useMemo(() => yearBefore(maxDate), [maxDate]);
  // dataVer goes up when the Fix tab or Skip Codes tab changes data, so open orders on the Add tab work out their state again
  const [dataVer, setDataVer] = useState(0);
  const dataChanged = useCallback(() => { store.dropOrders(); setDataVer(v => v + 1); }, [store]);

  // Eagerly warm up Asset Catalog + SAP Orders + Skip Codes on mount so equipment searches and SAP order lookups work immediately
  const [catInfo, setCatInfo] = useState(() => store.catalogStatus());
  const [reloadingAssets, setReloadingAssets] = useState(false);
  const [assetBrowserOpen, setAssetBrowserOpen] = useState(false);
  const [assetBrowserFilter, setAssetBrowserFilter] = useState('');
  const [assetBrowserRoom, setAssetBrowserRoom] = useState('');

  const refreshCatalogInfo = useCallback(async (force = false) => {
    setReloadingAssets(true);
    try {
      await store.ensureAssetCatalog(force);
      if (force) store.dropOrders();
      setCatInfo(store.catalogStatus());
      setDataVer(v => v + 1);
    } catch (_) {
      setCatInfo(store.catalogStatus());
    } finally {
      setReloadingAssets(false);
    }
  }, [store]);

  useEffect(() => {
    refreshCatalogInfo(false);
    store.syncSkipCodesFromDataverse().then(() => setDataVer(v => v + 1)).catch(() => {});
  }, [store, refreshCatalogInfo]);

  // Theme (Light / Dark) & Language (English / Espanol MX) state
  const [isDark, setIsDark] = useState(() => {
    try { return window.localStorage.getItem(THEME_DARK_KEY) === '1'; } catch (_) { return false; }
  });
  const setDarkMode = useCallback((val) => {
    setIsDark(val);
    try { window.localStorage.setItem(THEME_DARK_KEY, val ? '1' : '0'); } catch (_) {}
  }, []);

  const [lang, setLang] = useState(() => {
    try {
      const saved = window.localStorage.getItem(LANG_STORAGE_KEY);
      const initial = saved === 'es' ? 'es' : 'en';
      _ACTIVE_LANG = initial;
      return initial;
    } catch (_) { return 'en'; }
  });
  const changeLang = useCallback((nextLang) => {
    _ACTIVE_LANG = nextLang;
    setLang(nextLang);
    try { window.localStorage.setItem(LANG_STORAGE_KEY, nextLang); } catch (_) {}
  }, []);

  // User Identity, View Module Config & Access Audit Logging
  const [currentUser, setCurrentUser] = useState({
    userId: 'local-session',
    microsoftId: 'U1010051',
    userName: 'Plant Admin',
    email: '',
    domainName: 'U1010051',
    source: 'Detecting...',
  });
  const [msIdModalOpen, setMsIdModalOpen] = useState(false);
  const [msIdDraftId, setMsIdDraftId] = useState('');
  const [msIdDraftName, setMsIdDraftName] = useState('');
  const [msIdDraftEmail, setMsIdDraftEmail] = useState('');

  const [viewConfig, setViewConfig] = useState(() => loadViewModuleConfig());
  const [previewTargetKey, setPreviewTargetKey] = useState('');
  const [syncingViewConfig, setSyncingViewConfig] = useState(false);
  const [viewSyncStatus, setViewSyncStatus] = useState('');
  const [accessLogs, setAccessLogs] = useState(() => loadAccessAuditLogs());
  const [syncingAccessLogs, setSyncingAccessLogs] = useState(false);
  const [accessSyncStatus, setAccessSyncStatus] = useState('');
  const currentSessionIdRef = useRef(`sess-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`);

  const [activeTab, setActiveTab] = useState('add');
  const [logoUnlocked, setLogoUnlocked] = useState(false);
  const [fixVisited, setFixVisited] = useState(false);
  const [fixCount, setFixCount] = useState(null);
  const [recent, setRecent] = useState({ status: 'loading', list: [], error: '' });

  const effectiveView = useMemo(
    () => resolveEffectiveUserView(currentUser, viewConfig, previewTargetKey, logoUnlocked),
    [currentUser, viewConfig, previewTargetKey, logoUnlocked]
  );

  // Sync View Module config & Access Audit Log from Dataverse hubconfig on startup if available
  useEffect(() => {
    let live = true;
    const initIdentityAndAudit = async () => {
      const detected = await detectActiveUserIdentity(api, props);
      if (!live) return;
      setCurrentUser(detected);

      // Pull shared View Module config from Dataverse craa5__0_hubconfig using live schema columns first
      let latestViewCfg = loadViewModuleConfig();
      if (api.mode === 'dataverse' || api.mode === 'live') {
        try {
          const cfgRows = await cfgFindRows(api, HUB_CONFIG_VIEW_KEY);
          const cfgRow = cfgRows && cfgRows[0];
          const rawJson = cfgRow && hubConfigJsonOf(cfgRow);
          if (rawJson) {
            const parsed = JSON.parse(rawJson);
            if (parsed && typeof parsed === 'object') {
              latestViewCfg = { ...DEFAULT_VIEW_MODULE_CONFIG, ...parsed };
              saveViewModuleConfigLocal(latestViewCfg);
              if (live) setViewConfig(latestViewCfg);
            }
          }
        } catch (_) { /* optional table */ }
      }

      const eff = resolveEffectiveUserView(detected, latestViewCfg, '', false);
      const nowIso = new Date().toISOString();
      const sessionEntry = {
        id: currentSessionIdRef.current,
        accessedAt: nowIso,
        lastActiveAt: nowIso,
        microsoftId: detected.microsoftId,
        userName: detected.userName,
        email: detected.email,
        domainName: detected.domainName,
        source: detected.source,
        viewPreset: eff.presetLabel,
        tabsVisited: ['add'],
        actionsCount: 1,
        apiMode: api.mode,
      };

      const existingLogs = loadAccessAuditLogs();
      const updatedLogs = saveAccessAuditLogsLocal([sessionEntry, ...existingLogs.filter(x => x.id !== sessionEntry.id)]);
      if (live) setAccessLogs(updatedLogs);

      // Sync access log to live Dataverse craa5__0_hubconfig (MSS_LOG_ACCESS_LOG) and craa5_shiftlog
      if (api.mode === 'dataverse' || api.mode === 'live') {
        try {
          const accRows = await cfgFindRows(api, HUB_CONFIG_ACCESS_KEY);
          const accRow = accRows && accRows[0];
          let mergedAcc = updatedLogs;
          if (accRow && hubConfigJsonOf(accRow)) {
            try {
              const remoteAcc = JSON.parse(hubConfigJsonOf(accRow));
              if (Array.isArray(remoteAcc)) {
                const byId = new Map();
                [...updatedLogs, ...remoteAcc.map(normalizeAccessAuditEntry).filter(Boolean)].forEach(item => {
                  if (item && item.id) byId.set(item.id, item);
                });
                mergedAcc = Array.from(byId.values()).sort((a, b) => (b.accessedAt || '').localeCompare(a.accessedAt || '')).slice(0, 250);
                saveAccessAuditLogsLocal(mergedAcc);
                if (live) setAccessLogs(mergedAcc);
              }
            } catch (_) {}
          }
          const accJson = JSON.stringify(mergedAcc);
          const updatedByStr = `${detected.userName} (${detected.microsoftId})`;
          if (accRow && accRow.craa5__0_hubconfigid) {
            await api.update(HUB_CONFIG_TABLE, accRow.craa5__0_hubconfigid, {
              craa5_configkey: HUB_CONFIG_ACCESS_KEY,
              craa5_configname: HUB_CONFIG_ACCESS_KEY,
              [HUB_MANIFEST_COL]: accJson,
              craa5_updatedby: updatedByStr,
            });
          } else {
            await api.create(HUB_CONFIG_TABLE, {
              craa5_configkey: HUB_CONFIG_ACCESS_KEY,
              craa5_configname: HUB_CONFIG_ACCESS_KEY,
              craa5_category: 'AccessAudit',
              craa5_scope: 'MSS_LOG_INPUT',
              [HUB_MANIFEST_COL]: accJson,
              craa5_updatedby: updatedByStr,
            });
          }
        } catch (_) { /* ignore hubconfig error */ }
      }
    };
    initIdentityAndAudit();
    return () => { live = false; };
  }, [api]); // eslint-disable-line react-hooks/exhaustive-deps

  // Update current session's tabsVisited & lastActiveAt whenever activeTab changes
  useEffect(() => {
    setAccessLogs(prev => {
      const idx = prev.findIndex(x => x.id === currentSessionIdRef.current);
      if (idx === -1) return prev;
      const cur = prev[idx];
      const tabsVisited = Array.isArray(cur.tabsVisited) ? cur.tabsVisited.slice() : [];
      if (!tabsVisited.includes(activeTab)) tabsVisited.push(activeTab);
      const updated = {
        ...cur,
        lastActiveAt: new Date().toISOString(),
        viewPreset: effectiveView.presetLabel,
        tabsVisited,
        actionsCount: (cur.actionsCount || 1) + 1,
      };
      const next = prev.slice();
      next[idx] = updated;
      return saveAccessAuditLogsLocal(next);
    });
  }, [activeTab, effectiveView.presetLabel]);

  const handleUpdateViewConfig = useCallback((nextCfg) => {
    setViewConfig(nextCfg);
    saveViewModuleConfigLocal(nextCfg);
  }, []);

  const handleSyncViewConfigToDataverse = useCallback(async () => {
    setSyncingViewConfig(true);
    setViewSyncStatus('');
    try {
      if (api.mode !== 'dataverse' && api.mode !== 'live') {
        setViewSyncStatus('Saved View Module configuration in browser storage (connect to Dataverse to sync across devices).');
        return;
      }
      const payload = JSON.stringify(viewConfig);
      const updatedBy = `${currentUser.userName} (${currentUser.microsoftId})`;
      const existing = await cfgFindRows(api, HUB_CONFIG_VIEW_KEY);
      if (existing && existing[0] && existing[0].craa5__0_hubconfigid) {
        await api.update(HUB_CONFIG_TABLE, existing[0].craa5__0_hubconfigid, {
          craa5_configkey: HUB_CONFIG_VIEW_KEY,
          craa5_configname: HUB_CONFIG_VIEW_KEY,
          [HUB_MANIFEST_COL]: payload,
          craa5_scope: 'MSS_LOG_INPUT',
          craa5_updatedby: updatedBy,
        });
      } else {
        await api.create(HUB_CONFIG_TABLE, {
          craa5_configkey: HUB_CONFIG_VIEW_KEY,
          craa5_configname: HUB_CONFIG_VIEW_KEY,
          craa5_category: 'ViewModule',
          craa5_scope: 'MSS_LOG_INPUT',
          [HUB_MANIFEST_COL]: payload,
          craa5_updatedby: updatedBy,
        });
      }
      setViewSyncStatus(`Synced View Module configuration to Dataverse table ${HUB_CONFIG_TABLE} (${HUB_CONFIG_VIEW_KEY}).`);
    } catch (e) {
      setViewSyncStatus(`Saved locally. Dataverse table ${HUB_CONFIG_TABLE} note: ${errText(e)}`);
    } finally {
      setSyncingViewConfig(false);
    }
  }, [api, viewConfig, currentUser]);

  const handleSyncAccessLogsToDataverse = useCallback(async () => {
    setSyncingAccessLogs(true);
    setAccessSyncStatus('');
    try {
      if (api.mode !== 'dataverse' && api.mode !== 'live') {
        setAccessSyncStatus('Access Audit Logs are saved locally in preview mode.');
        return;
      }
      const existing = await cfgFindRows(api, HUB_CONFIG_ACCESS_KEY);
      const existingRow = existing && existing[0];
      let merged = loadAccessAuditLogs();
      const remoteJson = existingRow && hubConfigJsonOf(existingRow);
      if (remoteJson) {
        try {
          const remoteLogs = JSON.parse(remoteJson);
          if (Array.isArray(remoteLogs)) {
            const byId = new Map();
            [...merged, ...remoteLogs.map(normalizeAccessAuditEntry).filter(Boolean)].forEach(item => {
              if (item && item.id) byId.set(item.id, item);
            });
            merged = Array.from(byId.values()).sort((a, b) => (b.accessedAt || '').localeCompare(a.accessedAt || '')).slice(0, 250);
            saveAccessAuditLogsLocal(merged);
            setAccessLogs(merged);
          }
        } catch (_) { /* ignore */ }
      }
      const payload = JSON.stringify(merged);
      const updatedBy = `${currentUser.userName} (${currentUser.microsoftId})`;
      if (existingRow && existingRow.craa5__0_hubconfigid) {
        await api.update(HUB_CONFIG_TABLE, existingRow.craa5__0_hubconfigid, {
          craa5_configkey: HUB_CONFIG_ACCESS_KEY,
          craa5_configname: HUB_CONFIG_ACCESS_KEY,
          [HUB_MANIFEST_COL]: payload,
          craa5_scope: 'MSS_LOG_INPUT',
