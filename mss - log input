// --- EQUIPMENT PICKER: intelligent in-memory + server search as you type, with optional room/area/equipment context ---
const AssetPicker = ({ store, onPick, onPickMany = null, inUse, context = null, initialQuery = '', ariaLabel = 'Search equipment', actionLabel = 'Add', placeholder = 'Start typing a name, room, area, or asset ID...', disabled = false, autoFocus = false, idTails = false }) => {
  const styles = useStyles();
  const [q, setQ] = useState(initialQuery);
  const [res, setRes] = useState([]);
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState('');
  const ctxKey = context ? `${safeString(context.equipment)}|${safeString(context.room)}|${safeString(context.area)}` : '';

  useEffect(() => {
    const trimmed = q.trim();
    if (trimmed.length < 2 && !ctxKey) { setRes([]); setErr(''); setBusy(false); return undefined; }
    let live = true;
    setBusy(true);
    const t = setTimeout(async () => {
      try { const r = await store.searchAssets(trimmed, context); if (live) { setRes(r); setErr(''); } }
      catch (e) { if (live) setErr(errText(e)); }
      finally { if (live) setBusy(false); }
    }, trimmed.length < 2 ? 30 : 120);
    return () => { live = false; clearTimeout(t); };
  }, [q, ctxKey, store]); // eslint-disable-line react-hooks/exhaustive-deps

  // Equipment that cannot be used now (it is on another line, or already a piece) stays in the list with the reason, so it is never
  // mistaken for equipment the search could not find; usable equipment comes first
  const why = (a) => (inUse ? inUse(a) : '');
  const usable = res.filter(a => !why(a));
  const shown = usable.concat(res.filter(a => !!why(a)));
  // Records that look the same (same name, room and area) show the end of their ID, so the right one can be picked
  const looks = (a) => normName(`${a.name}|${placeText(a)}`);
  const twins = new Map();
  if (idTails) res.forEach(a => twins.set(looks(a), (twins.get(looks(a)) || 0) + 1));
  const topName = usable[0] ? usable[0].name : '';
  const sameNameUsable = topName ? usable.filter(a => sameText(a.name, topName) || canonName(a.name) === canonName(topName)) : [];
  return (
    <div>
      <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
        <div className={styles.field} style={{ maxWidth: 420, flex: '1 1 260px' }}>
          <Input aria-label={ariaLabel} autoComplete="off" autoFocus={autoFocus} placeholder={placeholder} value={q} onChange={(e, d) => setQ(d.value)} />
        </div>
        {onPickMany && sameNameUsable.length > 1 && (
          <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={disabled}
            onClick={() => onPickMany(sameNameUsable, `all ${sameNameUsable.length} assets named "${topName}"`)}>
            {actionLabel} all {sameNameUsable.length} named "{topName}"
          </Button>
        )}
        {onPickMany && usable.length > 1 && usable.length !== sameNameUsable.length && (
          <Button size="small" appearance="secondary" disabled={disabled}
            onClick={() => onPickMany(usable, `all ${usable.length} matching search results`)}>
            {actionLabel} all {usable.length} matches
          </Button>
        )}
      </div>
      <div aria-live="polite">
        {busy && <Text className={styles.hint} block style={{ marginTop: 6 }}>Searching...</Text>}
        {err && <Text className={styles.errorText} block role="alert">Search failed: {err}</Text>}
        {!busy && !err && q.trim().length >= 2 && shown.length === 0 && <Text className={styles.hint} block style={{ marginTop: 6 }}>No matching equipment.</Text>}
      </div>
      {shown.length > 0 && (
        <div>
          {q.trim().length < 2 && ctxKey && <Text className={styles.hint} block style={{ marginTop: 4 }}>Suggested equipment from {placeText(context) || 'matching location'}:</Text>}
          <div className={styles.pickList}>
            <table className={styles.linesTable} style={{ marginTop: 0 }}>
              <tbody>
                {shown.map(a => (
                  <tr key={a.id}>
                    <td className={styles.td}>
                      <strong>{a.name}</strong>
                      {a.uniqueId && <span className={styles.hint}> - Asset ID: {a.uniqueId}</span>}
                      {twins.get(looks(a)) > 1 && <span className={styles.hint}> - ID ...{shortId(a.id)}</span>}
                      {why(a) && <span className={styles.hint}> - {why(a)}</span>}
                    </td>
                    <td className={styles.td}>{a.room}</td>
                    <td className={styles.td}>{a.area}</td>
                    <td className={styles.td} style={{ textAlign: 'right' }}>
                      <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={disabled || !!why(a)} aria-label={`${actionLabel} ${a.name} (${placeText(a)})${twins.get(looks(a)) > 1 ? ` ID ...${shortId(a.id)}` : ''}`} onClick={() => onPick(a)}>{actionLabel}</Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {res.length >= LIMITS.assetSearch && <Text className={styles.hint} block style={{ marginTop: 4 }}>Showing the first {LIMITS.assetSearch}. Type more to narrow it down.</Text>}
        </div>
      )}
    </div>
  );
};

// "Map to" / Potential Equipment intelligent picker: shows ranked candidates with confidence/reason, or type to search all equipment
const NO_MATCH = '__none';
const INFO = '__info-';
const EquipmentChoice = ({ store, label, options, value, disabled, onChoose, uses = null, rankedMap = null, inUse = null, context = null, allowNoMatch = true }) => {
  const [text, setText] = useState(null); // what is being typed; null shows the chosen equipment
  const [found, setFound] = useState({ q: '', rows: [], err: '' }); // search results, kept with the text they are for
  const q = text === null ? '' : text.trim();
  const ctxKey = context ? `${safeString(context.equipment)}|${safeString(context.room)}|${safeString(context.area)}` : '';
  useEffect(() => {
    if (q.length < 2) return undefined;
    let live = true;
    const t = setTimeout(async () => {
      try { const r = await store.searchAssets(q, context); if (live) setFound({ q, rows: r, err: '' }); }
      catch (e) { if (live) setFound({ q, rows: [], err: errText(e) }); }
    }, 90);
    return () => { live = false; clearTimeout(t); };
  }, [q, ctxKey, store]); // eslint-disable-line react-hooks/exhaustive-deps
  // Results for older text are never shown
  const fresh = q.length >= 2 && found.q === q;
  const res = fresh ? found.rows : [];
  const err = fresh ? found.err : '';
  const busy = q.length >= 2 && !fresh;
  const words = tokenize(q);
  const hit = (a) => words.every(w => `${a.name} ${a.room} ${a.area}`.toLowerCase().includes(w));
  const list = q.length >= 2 ? uniqueById(options.filter(hit).concat(res)) : options;
  const chosen = value ? (options.find(a => a.id === value) || store.getAsset(value)) : null;
  // Identical records (same name, room and area) are told apart by the end of their ID and how many log entries use them
  const base = (a) => `${a.name} - ${placeText(a) || 'no room/area'}`;
  const twins = new Set();
  const seen = new Map();
  uniqueById(list.concat(chosen ? [chosen] : [])).forEach(a => { const k = normName(base(a)); if (seen.has(k)) { twins.add(k); } else seen.set(k, a.id); });
  const labelOf = (a, withRank = false) => {
    const n = uses && uses.get(a.id);
    const rk = withRank && rankedMap && rankedMap.get(a.id);
    const usedWhy = withRank && inUse ? inUse(a) : '';
    const extra = [
      twins.has(normName(base(a))) && `ID ...${shortId(a.id)}`,
      n && `${plural(n, 'log entry', 'log entries')}`,
      rk && `${TIER_LABEL[tierOf(rk.score)] || 'match'} - ${reasonText(rk)}`,
      usedWhy,
    ].filter(Boolean);
    return extra.length ? `${base(a)} (${extra.join(', ')})` : base(a);
  };
  const pick = (id) => {
    setText(null);
    if (id === (value || NO_MATCH)) return; // the current choice picked again: nothing changes
    if (id === NO_MATCH) { onChoose(null); return; }
    const a = list.find(x => x.id === id) || options.find(x => x.id === id);
    if (a && !(inUse && inUse(a))) onChoose(a);
  };
  const info = (key, msg) => <Option key={key} value={`${INFO}${key}`} text={msg} disabled>{msg}</Option>;
  return (
    <Combobox freeform disableAutoFocus aria-label={label} placeholder="No match - type to search all equipment" disabled={disabled}
      style={{ minWidth: '250px', width: '100%' }}
      value={text === null ? (chosen ? labelOf(chosen, false) : '') : text}
      selectedOptions={[value || NO_MATCH]}
      input={{ onFocus: (e) => { try { e.target.select(); } catch (_) { /* nothing to select */ } } }}
      onChange={(e) => setText(e.target.value)}
      onOptionSelect={(e, d) => { if (e && e.type === 'keydown' && e.key === 'Tab') return; if (d.optionValue && d.optionValue.indexOf(INFO) !== 0) pick(d.optionValue); }}
      onOpenChange={(e, d) => { if (!d.open && !(e && e.type === 'click')) setText(null); }}>
      {allowNoMatch && <Option value={NO_MATCH} text="No match">No match</Option>}
      {list.map(a => {
        const blocked = !!(inUse && inUse(a) && (!chosen || chosen.id !== a.id));
        const txt = labelOf(a, true);
        return <Option key={a.id} value={a.id} text={txt} disabled={blocked}>{txt}</Option>;
      })}
      {busy && info('busy', 'Searching all equipment...')}
      {!busy && err && info('err', `Search failed: ${err}`)}
      {!busy && !err && q.length >= 2 && !list.length && info('none', 'No matching equipment')}
      {!busy && !err && q.length >= 2 && res.length >= LIMITS.assetSearch && info('more', `Showing the first ${LIMITS.assetSearch}. Type more to narrow it down.`)}
      {q.length < 2 && info('hint', 'Type a name, room or area to search all equipment')}
    </Combobox>
  );
};

// Room / area suggestions while typing (server search, cached)
const useSuggest = (store, col, text, ctxRoom) => {
  const [opts, setOpts] = useState([]);
  useEffect(() => {
    const t = safeString(text);
    if (t.length < 2) { setOpts([]); return undefined; }
    let live = true;
    const h = setTimeout(() => { store.suggestField(col, t, ctxRoom).then(v => { if (live) setOpts(v); }).catch(() => {}); }, 250);
    return () => { live = false; clearTimeout(h); };
  }, [store, col, text, ctxRoom]);
  return opts;
};

// Status chip of an order line: [text, style key]
const lineStatus = (l, dupe, skipCode = '') => {
  if (skipCode) return [`skipped (${skipCode})`, 'warn'];
  if (dupe) return ['already logged', 'warn'];
  if (l.splitting) return ['add pieces', 'warn'];
  if (l.parent) return [`piece ${l.piece} of ${l.pieceCount}`, 'info'];
  if (!l.asset) return ['needs equipment', 'warn'];
  if (l.how === 'linked') return ['linked', 'ok'];
  if (l.how === 'all with name') return ['attached by name', 'ok'];
  if (l.how === 'best fit') return [`best fit - ${TIER_LABEL[l.tier] || ''}${l.ambiguous ? ' - check' : ''}`, l.tier === 'high' && !l.ambiguous ? 'ok' : 'warn'];
  if (['changed', 'chosen', 'new asset', 'new equipment', 'added'].includes(l.how)) return [l.how, 'info'];
  return [l.how || 'ready', 'ok'];
};

// --- WHAT WAS READ OFF THE PAPERWORK SHEET: the admin picks what belongs in the form ---
const SHEET_FIELD = { code: 'SAP order', date: 'date', hours: 'total hours', initials: 'initials' };
