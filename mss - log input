};

// Equipment records in one room/area (or across rooms when crossPlace is enabled) that are the same or similar equipment
const clusterAssets = (list, similar, crossPlace = false) => {
  const byBucket = new Map();
  list.forEach(a => {
    const k = crossPlace ? '__all__' : `${placeKey(a.room)}|${placeKey(a.area)}`;
    if (!byBucket.has(k)) byBucket.set(k, []);
    byBucket.get(k).push(a);
  });
  const out = [];
  byBucket.forEach((items, bucketKey) => {
    const prof = items.map(a => nameProfile(a.name));
    const parent = items.map((_, i) => i);
    const root = (i) => (parent[i] === i ? i : (parent[i] = root(parent[i])));
    for (let i = 0; i < items.length; i++) {
      for (let j = i + 1; j < items.length; j++) {
        if ((prof[i].full && prof[i].full === prof[j].full) || (similar && nameSimilarity(prof[i], prof[j]) >= 0.78)) parent[root(i)] = root(j);
      }
    }
    const sets = new Map();
    items.forEach((a, i) => { const r = root(i); if (!sets.has(r)) sets.set(r, []); sets.get(r).push(a); });
    sets.forEach(members => {
      if (members.length < 2) return;
      out.push({
        key: `${bucketKey}|${members.map(m => m.id).sort().join(',')}`,
        room: members[0].room, area: members[0].area,
        identical: new Set(members.map(m => canonName(m.name))).size === 1 && new Set(members.map(m => `${placeKey(m.room)}|${placeKey(m.area)}`)).size === 1,
        members: members.map(m => ({ ...m })),
      });
    });
  });
  return out.sort((a, b) => a.room.localeCompare(b.room) || a.area.localeCompare(b.area) || a.members[0].name.localeCompare(b.members[0].name));
};

const UnifyIds = ({ ctx }) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [room, setRoom] = useState('');
  const [area, setArea] = useState('');
  const [similar, setSimilar] = useState(true);
  const [crossPlace, setCrossPlace] = useState(false);
  const [moveLinks, setMoveLinks] = useState(true);
  const [fillBlank, setFillBlank] = useState(true); // entries of these names here with no ID (or a gone one) get the kept ID too
  const [syncText, setSyncText] = useState(true);   // sync moved log entries' room/area/equipment text to the kept record
  const [busy, setBusy] = useState('');
  const [progress, setProgress] = useState('');
  const [error, setError] = useState('');
  const [found, setFound] = useState(null);   // { room, area, similar, capped, checked, clusters }
  const [keep, setKeep] = useState({});       // clusterKey -> asset id kept
  const [apply, setApply] = useState({});     // clusterKey -> bool
  const [skip, setSkip] = useState({});       // "clusterKey|assetId" -> record left where it is
  const [result, setResult] = useState(null);
  const runId = useRef(0);
  // In a similar-names group, records whose name is not close to the kept one are left out until ticked
  const skipFor = (c, keepId) => {
    const kept = c.members.find(m => m.id === keepId);
    const out = {};
    if (!kept || c.identical) return out;
    const kp = nameProfile(kept.name);
    c.members.forEach(m => { if (m.id !== keepId && nameSimilarity(nameProfile(m.name), kp) < 0.78) out[`${c.key}|${m.id}`] = true; });
    return out;
  };
  const isSkipped = (c, m) => !!skip[`${c.key}|${m.id}`];
  const roomOpts = useSuggest(store, 'craa5_roomname', room);
  const areaOpts = useSuggest(store, 'craa5_areaname', area, room.trim());

  const find = async () => {
    const r = room.trim(), a = area.trim();
    const my = ++runId.current;
    const live = () => my === runId.current;
    setBusy('find'); setError(''); setResult(null); setFound(null);
    try {
      setProgress(r ? `Loading current assets in ${r}${a ? ` / ${a}` : ''}...` : 'Loading all current assets across all rooms...');
      const { list, capped } = await store.assetsInPlace(r, a);
      const clusters = clusterAssets(list, similar, crossPlace);
      const members = clusters.flatMap(c => c.members);
      if (members.length) {
        setProgress(`Counting log entries for ${plural(members.length, 'equipment record', 'equipment records')}...`);
        const ids = members.map(m => m.id);
        const [uses, added, links] = await Promise.all([pool(members, 6, (m) => store.logUse(m.id)), store.assetsAdded(ids), store.msLinkedTo(ids)]);
        members.forEach((m, i) => {
          m.count = uses[i].ok ? uses[i].value : null;
          m.added = added.get(m.id) || '';
          m.links = links.filter(x => x.assetId === m.id);
        });
      }
      if (!live()) return;
      // Newest first: the record whose newest entry was saved last, then the record added last. The first one is kept.
      const when = (v) => { const t = Date.parse(safeString(v)); return Number.isNaN(t) ? 0 : t; };
      clusters.forEach(c => c.members.sort((x, y) => when(y.count && y.count.newest) - when(x.count && x.count.newest) || when(y.added) - when(x.added)
        || ((y.count && y.count.n) || 0) - ((x.count && x.count.n) || 0)));
      const k = {};
      const ap = {};
      let sk = {};
      clusters.forEach(c => {
        k[c.key] = c.members[0].id;
        // A record whose entries could not be counted may be the newest: that group waits for the admin to tick it
        ap[c.key] = c.identical && c.members.every(m => m.count);
        sk = { ...sk, ...skipFor(c, c.members[0].id) };
      });
      setKeep(k); setApply(ap); setSkip(sk);
      setFound({ room: r || 'All rooms', area: a, similar, capped, checked: list.length, clusters });
    } catch (e) { if (live()) setError(errText(e)); }
    finally { if (live()) { setBusy(''); setProgress(''); } }
  };

  const todo = found ? found.clusters.filter(c => apply[c.key] && keep[c.key] && c.members.some(m => m.id !== keep[c.key] && !isSkipped(c, m))) : [];
  const movers = (c) => c.members.filter(m => m.id !== keep[c.key] && !isSkipped(c, m));
  // When the record's newest entry was saved (or, where that cannot be read, cleaned)
  const newestText = (m) => (!m.count || !m.count.newest ? '' : m.count.saved ? `newest entry saved ${stampText(m.count.newest)}` : `newest entry cleaned ${dayKey(m.count.newest)}`);
  const toMove = todo.reduce((s, c) => s + movers(c).reduce((t, m) => t + ((m.count && m.count.n) || 0), 0), 0);
  const toMoveMore = todo.some(c => movers(c).some(m => !m.count || m.count.more));

  const unify = async () => {
    if (!todo.length) return;
    setBusy('apply'); setResult(null); setError('');
    let moved = 0, relinked = 0, filled = 0, left = 0, leftMore = false, onSkipped = 0, unplaced = 0, unchecked = 0, failed = 0, firstError = '', remaining = false;
    const doneKeys = new Set();
    const fail = (e) => { failed += 1; if (!firstError) firstError = typeof e === 'string' ? e : errText(e); };
    for (const c of todo) {
      const kept = c.members.find(m => m.id === keep[c.key]);
      const moverIds = movers(c).map(m => m.id);
      const skippedIds = c.members.filter(m => m.id !== kept.id && isSkipped(c, m)).map(m => m.id);
      const failedIds = new Set(); // entries that could not be moved: not tried again below
      let ok = true;
      for (const m of movers(c)) {
        setProgress(`Moving entries from ${m.name} (${shortId(m.id)}) to ${kept.name} (${shortId(kept.id)})...`);
        try {
          const r = await repointEntries(api, guidEq('craa5_equipmentguid', m.id), null, kept, !syncText, syncText);
          moved += r.fixed;
          r.failedIds.forEach(id => { failedIds.add(id); fail(r.error); });
          if (r.failed) ok = false;
          if (r.more) { ok = false; remaining = true; }
        } catch (e) { ok = false; fail(e); }
        if (moveLinks) {
          // Links already moved by an earlier click are not written (or counted) again
          for (const row of (m.links || []).filter(x => !x.moved)) {
            try { const w = await store.writeMs(row.id, {}, kept); if (w.linked) { relinked += 1; row.moved = true; } else { ok = false; fail(w.error || 'SAP row link not stored'); } }
            catch (e) { ok = false; fail(e); }
          }
        }
      }
      // Old entries of these names in this room and area with no ID, or an ID that no longer exists, get the kept ID too.
      if (fillBlank) {
        if (!kept.room && !kept.area && !syncText) unplaced += 1;
        else {
          const names = [];
          [kept].concat(movers(c)).forEach(m => { if (canonName(m.name) && !names.some(x => canonName(x) === canonName(m.name))) names.push(m.name); });
          const places = { rooms: c.members.map(m => m.room), areas: c.members.map(m => m.area) };
          for (const name of names) {
            setProgress(`Giving ${kept.name} (${shortId(kept.id)}) to entries of ${name} with no ID...`);
            try {
              const r = await store.familyToFix({ equipment: name, room: c.room, area: c.area }, kept.id, moverIds, places);
              r.keptIds.forEach(id => { if (id === cleanGuid(kept.id)) return; if (skippedIds.indexOf(id) >= 0) onSkipped += 1; else left += 1; });
              leftMore = leftMore || r.keptMore;
              const rows = r.rows.filter(row => !failedIds.has(row.craa5__log_id));
              const patch = {
                craa5_equipmentguid: kept.id,
                ...(syncText && kept.room ? { craa5_room: kept.room } : {}),
                ...(syncText && kept.area ? { craa5_area: kept.area } : {}),
                ...(syncText && kept.name ? { craa5_equipment: kept.name } : {}),
              };
              const res = await pool(rows, 8, (row) => api.update(LOG_TABLE, row.craa5__log_id, patch));
              let wrote = 0;
              res.forEach((x, i) => {
                if (!x.ok) { ok = false; fail(x.error); return; }
                wrote += 1;
                if (moverIds.indexOf(cleanGuid(rows[i].craa5_equipmentguid)) >= 0) moved += 1; else filled += 1;
              });
              if (r.capped) { if (wrote) { ok = false; remaining = true; } else unchecked += 1; }
            } catch (e) { ok = false; fail(e); }
          }
        }
      }
      if (ok) doneKeys.add(c.key);
    }
    ctx.dataChanged();
    setFound(f => ({ ...f, clusters: f.clusters.filter(c => !doneKeys.has(c.key)) }));
    setResult({ moved, relinked, filled, left, leftMore, onSkipped, unplaced, unchecked, failed, error: firstError, groups: doneKeys.size, remaining });
    setProgress(''); setBusy('');
  };

  return (
    <div>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        Finds duplicate or renamed equipment records across the current assets pull (leave Room blank to scan <strong>all rooms at once</strong>, or tick "Match across rooms/areas" to unify equipment that moved to a new room/area) and moves every log entry and SAP order link onto the record you keep.
      </Text>
      <div className={styles.filterBar}>
        <Input aria-label="Room to check" placeholder="Room (blank = all rooms)" list="unify-rooms" value={room} disabled={!!busy} onChange={(e, d) => setRoom(d.value)} onKeyDown={(e) => { if (e.key === 'Enter') find(); }} />
        <Input aria-label="Area to check" placeholder="Area (optional)" list="unify-areas" value={area} disabled={!!busy} onChange={(e, d) => setArea(d.value)} onKeyDown={(e) => { if (e.key === 'Enter') find(); }} />
        <Checkbox label="Also unify similar names" checked={similar} disabled={!!busy} onChange={(e, d) => setSimilar(!!d.checked)} />
        <Checkbox label="Match across rooms / areas (relocated assets)" checked={crossPlace} disabled={!!busy} onChange={(e, d) => setCrossPlace(!!d.checked)} />
        <Button appearance="primary" className={styles.btnPrimary} disabled={!!busy} onClick={find}>{busy === 'find' ? 'Looking...' : room.trim() ? 'Find duplicates in room' : 'Find duplicates (All Rooms)'}</Button>
      </div>
