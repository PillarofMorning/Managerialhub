      )}
    </div>
  );
};

// --- ENTRY ROW: one SAP order, one or more equipment ---
const EntryRow = forwardRef(function EntryRow({ ctx, index, initialDate, initialInitials, onRemove, onEnter, canRemove, saving }, ref) {
  const styles = useStyles();
  const { api, store, maxDate, minDate, dataVer } = ctx;

