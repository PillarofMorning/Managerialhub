  const latest = useRef({});                         // the form values now, for a reading that finishes later
  const retroSeq = useRef({});
  const listRef = useRef(null);

  const normalizedCode = isAutoSap(code) ? formatAutoSap(code) : normCode(code);
  const isAutoOrder = isAutoSap(normalizedCode);
  const ready = !!order && order.status === 'ready' && order.code === normalizedCode;
  const matches = useMemo(() => (ready ? order.entries : []), [ready, order]);
  const listId = `sap-list-${index}`;
  const activeSkipCodes = useMemo(() => store.getActiveSkipCodes(), [store, dataVer]);

  // Order suggestions: debounced server search, only while the box is open
  useEffect(() => {
