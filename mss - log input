    const q = safeString(searchInput);
    setSearchQuery(q);
    if (q) {
      const low = q.toLowerCase();
      const matchIdx = MANUAL_SCREEN_GUIDES.findIndex(s =>
        s.title.toLowerCase().includes(low) ||
        s.subtitle.toLowerCase().includes(low) ||
        s.callouts.some(c => c.title.toLowerCase().includes(low) || c.desc.toLowerCase().includes(low))
      );
