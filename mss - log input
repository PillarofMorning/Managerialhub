        </div>

        <div className={styles.field}>
          <Text className={styles.label}>Room</Text>
          <Input aria-label="Room" className={styles.readOnly} value={summarize('room')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Area</Text>
          <Input aria-label="Area" className={styles.readOnly} value={summarize('area')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Equipment</Text>
          <Input aria-label="Equipment" className={styles.readOnly} value={live.length > 1 ? `${live.length} equipment` : summarize('name')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '140px' }} />
