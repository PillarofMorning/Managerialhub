const buildPowerversePrompt = (bp, mode, probeResult) => {
  const missingCols = probeResult && Array.isArray(probeResult.missingColumns) && probeResult.missingColumns.length
    ? probeResult.missingColumns
    : bp.columns.filter(c => c.tier !== 'Current Core');
  const coreCols = bp.columns.filter(c => c.tier === 'Current Core');
  const extCols = bp.columns.filter(c => c.tier === 'Current Extended');
  const futureCols = bp.columns.filter(c => c.tier === 'Future Feature');

  const effectiveMode = mode === 'auto'
    ? (probeResult && probeResult.tableExists ? 'existing' : 'new')
    : mode;

  if (effectiveMode === 'existing') {
    const colsToHighlight = bp.columns.filter(c => ! c.logicalName.endsWith('id') || c.logicalName === 'craa5_equipmentguid' || c.logicalName === 'craa5_uniqueid' || c.logicalName === 'craa5_olduid' || c.logicalName === 'craa5_microsoftid');
    return [
      `You are a Microsoft Dataverse / Power Apps ("Powerverse") Architect helping me update an EXISTING Dataverse table used by our "MSS Log Input" React Code Component.`,
      ``,
      `=== TARGET EXISTING TABLE ===`,
      `- Display Name: ${bp.displayName}`,
      `- Logical Name: ${bp.table}`,
      `- Entity Set Name (OData Plural): ${bp.entitySet}`,
      `- Primary Key Column: ${bp.primaryId}`,
      `- Primary Name Column: ${bp.primaryName}`,
      `- Table Purpose: ${bp.role}`,
      ``,
      `=== IMPORTANT CONSTRAINTS ===`,
      `1. The table "${bp.table}" ALREADY EXISTS in my Dataverse environment. Do NOT instruct me to recreate the table from scratch.`,
      `2. Publisher prefix is "craa5_". Every column logical name MUST match the exact lowercase logicalName listed below so our React OData queries ($select, $filter, create, update) work without code changes.`,
      `3. Give me a step-by-step checklist in Power Apps Maker Portal (Tables - ${bp.displayName} - Columns - New column) AND a PowerShell / PAC CLI / XrmToolBox snippet to add any missing Current Extended or Future Feature columns.`,
      ``,
      `=== CURRENTLY DETECTED MISSING / RECOMMENDED COLUMNS TO ADD (${missingCols.length}) ===`,
      ...missingCols.map(c => `- ${c.logicalName} - Display: "${c.displayName}" - Type: ${c.type} - Tier: (${c.tier}) - Required: ${c.required ? 'Yes' : 'Optional'} - Purpose: ${c.notes}`),
      ``,
      `=== FULL COLUMN SPECIFICATION FOR ${bp.table} (CURRENT + FUTURE FEATURES) ===`,
      `-- Current Core Columns (${coreCols.length}) --`,
      ...coreCols.map(c => `  * ${c.logicalName} (${c.type}) - ${c.displayName}: ${c.notes}`),
      `-- Current Extended Columns (${extCols.length}) --`,
      ...extCols.map(c => `  * ${c.logicalName} (${c.type}) - ${c.displayName}: ${c.notes}`),
      `-- Future Feature Columns (${futureCols.length}) --`,
      ...futureCols.map(c => `  * ${c.logicalName} (${c.type}) - ${c.displayName}: ${c.notes}`),
      ``,
      `Please output:`,
      `1. Exact Power Apps Maker Portal column creation table (Display Name, Schema Name, Data Type, Max Length, Required) for all ${colsToHighlight.length} non-PK columns.`,
      `2. Which columns to index/enable for Quick Find Search and OData $filter performance.`,
      `3. Security Role table privilege recommendations for Standard Operators vs Sanitation Leads vs Admins.`,
    ].join('\n');
  }

  return [
    `You are a Microsoft Dataverse / Power Apps ("Powerverse") Architect helping me create a NEW Dataverse table from scratch for our "MSS Log Input" React Code Component.`,
    ``,
    `=== NEW TABLE SPECIFICATION ===`,
    `- Display Name: ${bp.displayName}`,
    `- Logical Name: ${bp.table}`,
    `- Entity Set Name (OData Plural): ${bp.entitySet}`,
    `- Primary Key Column: ${bp.primaryId}`,
    `- Primary Name Column: ${bp.primaryName}`,
    `- Publisher Prefix: craa5_`,
    `- Ownership: User or Team (Standard Table)`,
    `- Purpose: ${bp.role}`,
    ``,
    `=== COLUMNS TO CREATE (CURRENT + FUTURE FEATURES) ===`,
    ...bp.columns.map(c => `- ${c.logicalName} - Display: "${c.displayName}" - Type: ${c.type} - Tier: (${c.tier}) - Required: ${c.required ? 'Yes' : 'Optional'} - Notes: ${c.notes}`),
    ``,
    `Please provide:`,
    `1. Step-by-step instructions to create "${bp.displayName}" (${bp.table}) in Power Apps Maker Portal with exact Logical/Schema names.`,
    `2. A ready-to-import Dataverse Web API / PowerShell metadata creation script that provisions the table and all Current Core, Current Extended, and Future Feature columns.`,
    `3. Recommended alternate keys, indexes, and Security Role permissions so our Power Apps Code Component can query and write via Xrm.WebApi / OData v9.2.`,
  ].join('\n');
};

const buildMasterAllTablesPowerversePrompt = (probeMap) => {
  const lines = [
    `You are a Microsoft Dataverse / Power Apps ("Powerverse") Principal Architect. I need a complete Dataverse verification and column-provisioning guide for our "MSS Log Input" Sanitation & Master Schedule application.`,
    `All tables use publisher prefix "craa5_". Our React app connects via Xrm.WebApi and OData v9.2 (/api/data/v9.2/).`,
    ``,
    `Below are all ${MSS_DATAVERSE_TABLE_BLUEPRINTS.length} Dataverse tables used by current features and planned future features, along with their live probe status:`,
    ``,
  ];
  MSS_DATAVERSE_TABLE_BLUEPRINTS.forEach((bp, idx) => {
    const pr = probeMap && probeMap[bp.key];
    const statusText = pr ? (pr.tableExists ? `EXISTING TABLE (${pr.missingColumns.length} columns missing)` : 'NEW TABLE NEEDED') : 'UNPROBED';
    lines.push(`### ${idx + 1}. ${bp.displayName} - Logical: ${bp.table} (EntitySet: ${bp.entitySet}) - Status: ${statusText}`);
    lines.push(`Role: ${bp.role}`);
    bp.columns.forEach(c => {
      const colState = pr && pr.columnStatus && pr.columnStatus[c.logicalName] ? `(${pr.columnStatus[c.logicalName]})` : '';
      lines.push(`  - ${c.logicalName} (${c.type}) (${c.tier}) ${colState}: ${c.displayName} - ${c.notes}`);
    });
    lines.push('');
  });
  lines.push(
    `Please generate:`,
    `1. A prioritized migration checklist separating (A) Existing Tables that only need missing Current Extended / Future Feature columns added vs. (B) Brand-New Optional Tables (${SKIP_TABLE}, ${HUB_CONFIG_TABLE}, ${ACCESS_LOG_TABLE}) to create from scratch.`,
    `2. Exact Data Types, Max Lengths, and Schema Names so zero OData 400 "Could not find a property named..." errors occur.`,
    `3. Recommended Dataverse indexes on craa5_lastcleaned, craa5_sap, craa5_equipmentguid, and craa5_configkey.`
  );
  return lines.join('\n');
};

