};

// --- ENTRY ROW: one SAP order, one or more equipment ---
const EntryRow = forwardRef(function EntryRow({ ctx, index, initialDate, initialInitials, onRemove, onEnter, canRemove, saving }, ref) {
  const styles = useStyles();
  const { api, store, maxDate, minDate, dataVer } = ctx;

  const [code, setCode] = useState('');
  const [showSuggest, setShowSuggest] = useState(false);
  const [hi, setHi] = useState(0);
  const [sugg, setSugg] = useState({ items: [], truncated: false, busy: false, error: '' });
  const [order, setOrder] = useState(null);          // { status, code, entries, capped, error }
  const [dateStr, setDateStr] = useState(initialDate || maxDate);
  const [initials, setInitials] = useState(initialInitials || '');
  const [totalHours, setTotalHours] = useState('');
  const [photo, setPhoto] = useState(null);
  const [photoName, setPhotoName] = useState('');
  const [photoNote, setPhotoNote] = useState(''); // why the last picture could not be used (gone as soon as another is picked)
