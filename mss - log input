  const skippedLines = included.filter(l => isSkippedLine(l));
  // Hours is a whole number (Edm.Int32): automatic distribution always rounds UP (Math.ceil) to a whole number
  const evenHours = useMemo(() => {
    const typed = (k) => (hoursOverride[k] !== undefined ? Math.max(0, Math.ceil(parseFloat(hoursOverride[k]) || 0)) : null);
