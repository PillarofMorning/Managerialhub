                  <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                    <Button size="small" appearance="secondary" disabled={reloadingAssets} onClick={() => refreshCatalogInfo(true)}>
                      {reloadingAssets ? 'Reloading Assets...' : 'Reload Assets & SAP Orders'}
                    </Button>
                    <Button size="small" appearance="primary" className={styles.btnPrimary} onClick={() => setAssetBrowserOpen(p => !p)}>
                      {assetBrowserOpen ? 'Hide Asset Catalog Browser' : `Browse All Assets (${allCatalogList.length})`}
                    </Button>
                  </div>
                </div>

                {assetBrowserOpen && (
                  <div style={{ padding: 12, borderRadius: 8, background: '#FFFFFF', border: '1px solid #CBD5E1' }}>
                    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 8 }}>
                      <Input
                        aria-label="Filter asset catalog"
                        placeholder="Search catalog by Equipment Name, SAP Order #, Room, Area, or Frequency..."
                        value={assetBrowserFilter}
                        onChange={(e, d) => setAssetBrowserFilter(d.value)}
                        style={{ minWidth: 260, flex: '1 1 260px' }}
                      />
                      <Select
                        aria-label="Filter catalog by room"
                        value={assetBrowserRoom}
                        onChange={(e, d) => setAssetBrowserRoom(d.value)}
                        style={{ width: 190 }}
                      >
                        <option value="">All Rooms ({catalogRooms.length})</option>
                        {catalogRooms.map(r => <option key={r} value={r}>{r}</option>)}
                      </Select>
                      {(assetBrowserFilter || assetBrowserRoom) && (
                        <Button size="small" appearance="subtle" onClick={() => { setAssetBrowserFilter(''); setAssetBrowserRoom(''); }}>
                          Clear Filter
                        </Button>
                      )}
                    </div>
                    <div style={{ maxHeight: 220, overflowY: 'auto' }}>
                      <table className={styles.linesTable} style={{ marginTop: 0 }}>
                        <thead>
                          <tr>
                            <th className={styles.th}>Equipment Name</th>
                            <th className={styles.th}>Room</th>
                            <th className={styles.th}>Area / Line</th>
                            <th className={styles.th}>Frequency</th>
                            <th className={styles.th}>Linked SAP Order(s)</th>
                            <th className={styles.th}>Photo Req</th>
                          </tr>
                        </thead>
                        <tbody>
                          {filteredCatalogList.map(a => (
                            <tr key={a.id}>
                              <td className={styles.td}><strong>{a.name}</strong></td>
                              <td className={styles.td}>{a.room || '-'}</td>
                              <td className={styles.td}>{a.area || '-'}</td>
                              <td className={styles.td}>{a.frequency || '-'}</td>
                              <td className={styles.td}><code>{a.sap || '-'}</code></td>
                              <td className={styles.td}>
                                {a.requiresPic ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>Photo Required</span> : <span className={styles.hint}>Standard</span>}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </div>
            )}

            <div ref={containerRef} style={{ display: 'flex', flexDirection: 'column', gap: 14, width: '100%' }}>
              {rows.map((r, i) => (
                <EntryRow key={r.key} ref={(el) => { if (el) refs.current[r.key] = el; else delete refs.current[r.key]; }}
                  ctx={ctx} index={i} initialDate={r.date} initialInitials={r.initials} canRemove={rows.length > 1} saving={saving}
                  onEnter={handleEnter} onRemove={() => setRows(prev => prev.filter(x => x.key !== r.key))} />
              ))}
            </div>
            <div className={styles.submitBar}>
              {(errorMessage || successMessage || warnMessage) && (
                <div className={styles.submitMessages}>
                  {errorMessage && <Text className={styles.errorText} block role="alert">{errorMessage}</Text>}
                  {successMessage && <Text className={styles.okText} block role="status">{successMessage}</Text>}
                  {warnMessage && <Text className={styles.warnText} block role="status">{warnMessage}</Text>}
                </div>
              )}
              <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
                <Input aria-label="Rows to add" type="number" min={1} max={20} value={addRowCount} onChange={(e, d) => setAddRowCount(d.value)} style={{ width: 70 }} />
                <Button disabled={saving} onClick={() => addRows(rowsToAdd)}>Add More Rows</Button>
                <Button appearance="primary" size="large" disabled={saving} onClick={submitAll} className={styles.btnCta} style={{ minWidth: 240, marginLeft: 'auto' }}>
                  {saving ? 'Saving...' : 'Submit All Records'}
                </Button>
              </div>
            </div>
          </div>

          {/* The other tabs load when opened */}
          {activeTab === 'table' && <div className={styles.contentArea}><LogTableTab ctx={ctx} /></div>}
          {activeTab === 'skipcodes' && <div className={styles.contentArea}><SkipCodesTab ctx={ctx} /></div>}
          {activeTab === 'dashboard' && <div className={styles.contentArea}><DashboardTab ctx={ctx} /></div>}
          {activeTab === 'calendar' && <div className={styles.contentArea}><CalendarTab ctx={ctx} /></div>}
          {activeTab === 'check' && <div className={styles.contentArea}><CheckTab ctx={ctx} /></div>}
          {fixVisited && <div className={styles.contentArea} style={show('fix')}><FixIdsTab ctx={ctx} onCount={setFixCount} /></div>}
          {activeTab === 'manual' && <div className={styles.contentArea}><HowToManualTab onNavigateTab={setActiveTab} /></div>}
          {activeTab === 'viewmodule' && (
            <div className={styles.contentArea}>
              <ViewModuleTab
                user={currentUser}
                viewConfig={viewConfig}
                effectiveView={effectiveView}
                logoUnlocked={logoUnlocked}
                previewTargetKey={previewTargetKey}
                setPreviewTargetKey={setPreviewTargetKey}
                onUpdateViewConfig={handleUpdateViewConfig}
                onSyncViewConfigToDataverse={handleSyncViewConfigToDataverse}
                syncingViewConfig={syncingViewConfig}
                viewSyncStatus={viewSyncStatus}
              />
            </div>
          )}
          {activeTab === 'devconsole' && (
            <div className={styles.contentArea}>
              <DevConsoleTab
                ctx={ctx}
                user={currentUser}
                onOverrideUser={handleOverrideUser}
                accessLogs={accessLogs}
                onRefreshAccessLogs={() => setAccessLogs(loadAccessAuditLogs())}
                onSyncAccessLogsToDataverse={handleSyncAccessLogsToDataverse}
                syncingAccessLogs={syncingAccessLogs}
                accessSyncStatus={accessSyncStatus}
                catInfo={catInfo}
                onReloadAssets={() => refreshCatalogInfo(true)}
                reloadingAssets={reloadingAssets}
                viewConfig={viewConfig}
              />
            </div>
          )}
        </div>
      </div>
    </FluentProvider>
  );
}