// --- EQUIPMENT NAME SIMILARITY (digit aware: "Mixer 1" = "Mixer 01", "Mixer 1" != "Mixer 2") ---
const tokenize = (s) => safeString(s).toLowerCase()
  .replace(/([a-z])(\d)/g, '$1 $2').replace(/(\d)([a-z])/g, '$1 $2')
  .split(/[^a-z0-9]+/).filter(Boolean);
// Canonical name: words and numbers kept apart, leading zeros dropped ("Mixer-01" -> "mixer 1")
const canonName = (s) => tokenize(s).map(x => (/^\d+$/.test(x) ? String(parseInt(x, 10)) : x)).join(' ');
const bigrams = (s) => {
  const t = ` ${s} `;
  const m = new Map();
  for (let i = 0; i < t.length - 1; i++) { const g = t.slice(i, i + 2); m.set(g, (m.get(g) || 0) + 1); }
  return m;
};
const dice = (a, b) => {
  if (!a.size || !b.size) return 0;
  let inter = 0, ta = 0, tb = 0;
  a.forEach(v => { ta += v; });
  b.forEach(v => { tb += v; });
  a.forEach((v, g) => { if (b.has(g)) inter += Math.min(v, b.get(g)); });
  return (2 * inter) / (ta + tb);
};
const nameProfile = (name) => {
  const t = tokenize(name);
  const nums = t.filter(x => /^\d+$/.test(x)).map(x => String(parseInt(x, 10)));
  const words = t.filter(x => !/^\d+$/.test(x));
  const key = words.join('');
  const stem = words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).join('');
  return { words, numList: nums, nums: nums.join(','), hasNums: nums.length > 0, key, stem, full: canonName(name), grams: bigrams(key) };
};
// 1 = the same name. Any other name scores at most 0.94, so only an identical name can reach High.
const nameSimilarity = (p, q) => {
  if (p.full && p.full === q.full) return 1;
  if (!p.key || !q.key) return 0;
  let n;
  if (!p.hasNums && !q.hasNums) n = 1;
  else if (p.nums === q.nums) n = 1;
  else if (!p.hasNums || !q.hasNums) n = 0.75;
  else n = 0.4;
  let w = p.key === q.key ? 0.94 : p.stem === q.stem ? 0.93 : dice(p.grams, q.grams);
  // every word of one name appears in the other ("Floors" / "Floors drains")
  const [a, b] = p.words.length <= q.words.length ? [p.words, q.words] : [q.words, p.words];
  if (a.length && a.some(x => x.length >= 3) && a.every(x => b.includes(x))) w = Math.max(w, 0.82);
  return Math.min(0.94, w * n);
};
const tierOf = (score) => (score >= 0.95 ? 'high' : score >= 0.8 ? 'medium' : score >= 0.6 ? 'low' : 'none');
const TIER_LABEL = { high: 'High', medium: 'Medium', low: 'Low', none: 'No match', manual: 'Manual', linked: 'Linked' };
const downTier = (t) => (t === 'high' ? 'medium' : t === 'medium' ? 'low' : t);

// Rooms and areas compare with numbers kept apart, so "Line 1-2" is not "Line 12"
const placeKey = (s) => canonName(s);
const samePlace = (a, b) => placeKey(a) === placeKey(b);
// Room and area of a candidate agree with what the entry or SAP row says (a blank on either side is not a disagreement).
const placeOk = (want, asset) =>
  (!placeKey(want.room) || !placeKey(asset.room) || samePlace(want.room, asset.room))
  && (!placeKey(want.area) || !placeKey(asset.area) || samePlace(want.area, asset.area));
// Name similarity with room and area agreement: a different room or area keeps a candidate out of any automatic pick.
const scoreAsset = (want, asset, p = nameProfile(want.equipment)) => {
  let s = nameSimilarity(p, nameProfile(asset.name));
  const wr = placeKey(want.room), wa = placeKey(want.area), ar = placeKey(asset.room), aa = placeKey(asset.area);
  if (wr && ar && wr !== ar) s *= 0.5;
  else if (wr && !ar) s *= 0.9;
  if (wa && aa && wa !== aa) s *= 0.55;
  else if (wa && !aa) s *= 0.9;
  return s;
};
