const splitHours = (total, n) => {
  if (!n || !(total > 0)) return [];
  const cents = Math.round(total * 100);
  const each = Math.floor(cents / n);
  const out = Array(n).fill(each / 100);
  out[n - 1] = (cents - each * (n - 1)) / 100;
  return out;
};
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

// Run fn over items with a small concurrency limit; never rejects, returns [{ok, value|error}].
const pool = async (items, limit, fn) => {
  const out = new Array(items.length);
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      try { out[i] = { ok: true, value: await fn(items[i], i) }; } catch (e) { out[i] = { ok: false, error: e }; }
    }
  };
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
  return out;
};
const chunked = (list, size) => {
  const out = [];
  for (let i = 0; i < list.length; i += size) out.push(list.slice(i, i + size));
  return out;
};
const uniqueById = (list) => Array.from(new Map(list.map(a => [a.id, a])).values());
