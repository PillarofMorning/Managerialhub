// --- FIX MISSING IDS ---
const SCAN_MODES = {
  missing: { label: 'Entries with no equipment ID', kind: 'missing id', pageSize: 100, pages: 1 },
  unknown: { label: 'Entries whose ID no longer exists (slower)', kind: 'unknown id', pageSize: 200, pages: 5 },
  place: { label: 'Entries whose ID is equipment in another room or area (slower)', kind: 'other room/area', pageSize: 200, pages: 5 },
  several: { label: 'Entries that list several pieces of equipment, whatever their ID (slower)', kind: 'several pieces', pageSize: 100, pages: 5 },
};
// Text that lists several things: a comma, semicolon, plus, ampersand or slash, or the word and / plus (the list is checked again on screen)
const LISTS_SEVERAL = `(${[',', ';', '+', '&', '/', ' and ', ' And ', ' AND ', ' plus ', ' Plus ', ' PLUS '].map(x => `contains(craa5_equipment,'${x}')`).join(' or ')})`;
const scanFilter = (mode, scope) => {
  const parts = [mode === 'missing' ? BLANK_GUID : mode === 'several' ? LISTS_SEVERAL : `craa5_equipmentguid ne null and craa5_equipmentguid ne ''`];
  if (scope === 'year') parts.push(`craa5_lastcleaned ge ${daysAgo(366)}T00:00:00Z`);
  return parts.join(' and ');
};

// "Map to" picker: the suggested equipment, or type to search all equipment (a server search, a few results at a time)
const EquipmentChoice = ({ store, label, options, value, disabled, onChoose, uses }) => {
  const [text, setText] = useState(null); // what is being typed; null shows the chosen equipment
  const [found, setFound] = useState({ q: '', rows: [], err: '' }); // search results, kept with the text they are for
  const q = text === null ? '' : text.trim();
  useEffect(() => {
    if (q.length < 2) return undefined;
    let live = true;
    const t = setTimeout(async () => {
      try { const r = await store.searchAssets(q); if (live) setFound({ q, rows: r, err: '' }); }
      catch (e) { if (live) setFound({ q, rows: [], err: errText(e) }); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [q, store]);
  // Results for older text are never shown
  const fresh = q.length >= 2 && found.q === q;
  const res = fresh ? found.rows : [];
  const err = fresh ? found.err : '';
  const busy = q.length >= 2 && !fresh;
  const words = tokenize(q);
  const hit = (a) => words.every(w => `${a.name} ${a.room} ${a.area}`.toLowerCase().includes(w));
  const list = q.length >= 2 ? uniqueById(options.filter(hit).concat(res)) : options;
  const chosen = value ? (options.find(a => a.id === value) || store.getAsset(value)) : null;
  // Identical records (same name, room and area) are told apart by the end of their ID and how many log entries use them
  const base = (a) => `${a.name} · ${placeText(a) || 'no room/area'}`;
  const twins = new Set();
  const seen = new Map();
  uniqueById(list.concat(chosen ? [chosen] : [])).forEach(a => { const k = normName(base(a)); if (seen.has(k)) { twins.add(k); } else seen.set(k, a.id); });
  const labelOf = (a) => {
    const n = uses && uses.get(a.id);
    const extra = [twins.has(normName(base(a))) && `ID …${shortId(a.id)}`, n && `${plural(n, 'log entry', 'log entries')}`].filter(Boolean);
    return extra.length ? `${base(a)} (${extra.join(', ')})` : base(a);
  };
  const pick = (id) => {
    setText(null);
    if (id === (value || NO_MATCH)) return; // the current choice picked again: nothing changes
    if (id === NO_MATCH) { onChoose(null); return; }
    const a = list.find(x => x.id === id) || options.find(x => x.id === id);
    if (a) onChoose(a);
  };
  const info = (key, msg) => <Option key={key} value={`${INFO}${key}`} text={msg} disabled>{msg}</Option>;
  return (
    <Combobox freeform disableAutoFocus aria-label={label} placeholder="No match · type to search all equipment" disabled={disabled}
      style={{ minWidth: '260px', width: '100%' }}
      value={text === null ? (chosen ? labelOf(chosen) : '') : text}
      selectedOptions={[value || NO_MATCH]}
      input={{ onFocus: (e) => { try { e.target.select(); } catch (_) { /* nothing to select */ } } }}
      onChange={(e) => setText(e.target.value)}
      onOptionSelect={(e, d) => { if (e && e.type === 'keydown' && e.key === 'Tab') return; if (d.optionValue && d.optionValue.indexOf(INFO) !== 0) pick(d.optionValue); }}
      onOpenChange={(e, d) => { if (!d.open && !(e && e.type === 'click')) setText(null); }}>
      <Option value={NO_MATCH} text="No match">No match</Option>
      {list.map(a => <Option key={a.id} value={a.id} text={labelOf(a)}>{labelOf(a)}</Option>)}
      {busy && info('busy', 'Searching all equipment…')}
      {!busy && err && info('err', `Search failed: ${err}`)}
      {!busy && !err && q.length >= 2 && !list.length && info('none', 'No matching equipment')}
      {!busy && !err && q.length >= 2 && res.length >= LIMITS.assetSearch && info('more', `Showing the first ${LIMITS.assetSearch}. Type more to narrow it down.`)}
      {q.length < 2 && info('hint', 'Type a name, room or area to search all equipment')}
    </Combobox>
  );
};
const NO_MATCH = '__none';
const INFO = '__info-';

// What a break-up did, for the message under the buttons
const splitSummary = (s) => [
  s.rows > 0 && `Broke up ${plural(s.rows, 'entry', 'entries')} and saved ${plural(s.created, 'new entry', 'new entries')} for the other pieces${s.extra ? `, including ${plural(s.extra, 'more entry', 'more entries')} found in the log with the same name, room and area` : ''}.`,
  s.rows === 0 && s.failedRows === 0 && 'Nothing was broken up.',
  s.failedRows > 0 && `${plural(s.failedRows, 'entry', 'entries')} could not be broken up${s.error ? ` (${s.error})` : ''}. Anything saved for ${s.failedRows === 1 ? 'it' : 'them'} stays. Apply again to finish ${s.failedRows === 1 ? 'it' : 'them'} (scan again if ${s.failedRows === 1 ? 'it is' : 'they are'} not in the list).`,
].filter(Boolean).join(' ');
const splitNotes = (s) => [
  s.pieceSkips > 0 && `${plural(s.pieceSkips, 'piece was', 'pieces were')} not saved again because ${s.pieceSkips === 1 ? 'it was' : 'they were'} already logged for that order and date.`,
  s.leftAlone > 0 && `${plural(s.leftAlone, 'entry was', 'entries were')} left as ${s.leftAlone === 1 ? 'it is' : 'they are'} because every piece was already logged for that order and date.`,
  s.gone > 0 && `${plural(s.gone, 'entry was', 'entries were')} not found (removed since the scan).`,
  s.undated > 0 && `${plural(s.undated, 'entry has', 'entries have')} no date, so ${s.undated === 1 ? 'it was' : 'they were'} not broken up: there is no date to check the pieces against.`,
].filter(Boolean).join(' ');

// Break-up of one entry: the pieces so far, each with a remove button, and a search to add more.
// The Add tab passes taken (equipment other lines of the order use, which cannot be pieces too) and onDone (a Done button).
const PiecesEditor = ({ store, g, list, disabled, onChange, missing = [], taken = null, onDone = null, whyUsed = null }) => {
  const styles = useStyles();
  const label = g.equipment || 'blank entry';
  // Names in the entry's text that had no equipment: kept in view until the pieces are as many as the text lists
  const lacking = missing.length > 0 && list.length < textParts(g.equipment).length ? missing : [];
  const acted = useRef(false); // set once the admin adds or removes a piece here, so the search box takes the focus again (not when rows first appear)
  const change = (next) => { acted.current = true; onChange(next); };
  useEffect(() => { acted.current = false; }); // the flag is used by the render the action caused, then cleared
  const sig = (a) => normName(`${a.name}|${placeText(a)}`);
  const count = new Map();
  list.forEach(a => count.set(sig(a), (count.get(sig(a)) || 0) + 1));
  return (
    <div>
      <Text className={styles.hint} block>Break up into:</Text>
      {lacking.length > 0 && <Text className={styles.hint} block>No equipment found for {lacking.map(x => `“${x}”`).join(', ')}: search below to add {lacking.length === 1 ? 'it' : 'them'}.</Text>}
      {list.length === 0 && <Text className={styles.hint} block>Search below and add at least two pieces.</Text>}
      {list.map(a => (
        <div key={a.id} style={{ display: 'flex', alignItems: 'center', gap: '6px', marginBottom: '2px' }}>
          <span><strong>{a.name}</strong> · {placeText(a) || 'no room/area'}{count.get(sig(a)) > 1 ? ` · ID …${shortId(a.id)}` : ''}{!placeOk(g, a) && <span className={mergeClasses(styles.tag, styles.tagWarn)} style={{ marginLeft: 6 }}>other room/area</span>}</span>
          <Button size="small" appearance="subtle" disabled={disabled} aria-label={`Remove ${a.name} from the pieces of ${label}`} onClick={() => change(list.filter(x => x.id !== a.id))}>✕</Button>
        </div>
      ))}
      <div style={{ marginTop: '4px' }}>
        <AssetPicker key={list.length} autoFocus={acted.current} idTails store={store} inUse={(a) => (list.some(x => x.id === a.id) ? 'already one of the pieces' : taken && taken.has(a.id) ? (whyUsed && whyUsed(a)) || 'on another line of this order' : '')} ariaLabel={`Search equipment to add as a piece of ${label}`} placeholder="Search to add a piece…" disabled={disabled} onPick={(a) => change(list.concat([a]))} />
      </div>
      <Button size="small" appearance="transparent" disabled={disabled} aria-label={`One piece only: ${label}`} onClick={() => onChange(null)}>One piece only</Button>
      {onDone && list.length >= 2 && <Button size="small" appearance="secondary" disabled={disabled} aria-label={`Done with the pieces of ${label}`} onClick={onDone}>Done</Button>}
    </div>
  );
};

const RepairIds = ({ ctx, onCount }) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [mode, setMode] = useState('missing');
  const [scope, setScope] = useState('all');
  const [scan, setScan] = useState({ started: false, done: false, scanned: 0 });
  const [groups, setGroups] = useState([]);
  const [busy, setBusy] = useState('');          // '', 'scan', 'apply'
  const [progress, setProgress] = useState('');
  const [scanError, setScanError] = useState('');
  const [choice, setChoice] = useState({});      // groupKey -> assetId | ''
  const [apply, setApply] = useState({});        // groupKey -> bool
  const [extraOpts, setExtraOpts] = useState({});// groupKey -> assets picked through search
  const [pieces, setPieces] = useState({});      // groupKey -> the equipment the entry is broken up into (a key here means break up is on)
  const [showAll, setShowAll] = useState(false);
  const [sameName, setSameName] = useState(true); // applying also fixes every other entry with the same name, room and area
  const [pending, setPending] = useState(null);   // same-name entries found by Apply, waiting for the admin's answer
  const [result, setResult] = useState(null);
  const nextRef = useRef(null);                  // continues the scan from where the last page stopped
  const pendingRef = useRef(null);               // a page that was read but not checked yet (its lookup failed)
  const scannedRef = useRef(0);
  const scanId = useRef(0);                      // a newer scan (or a reset) makes older results stale

  const resetScan = useCallback(() => {
    scanId.current += 1; nextRef.current = null; pendingRef.current = null; scannedRef.current = 0;
    setScan({ started: false, done: false, scanned: 0 });
    setGroups([]); setChoice({}); setApply({}); setExtraOpts({}); setPieces({}); setResult(null); setScanError(''); setPending(null);
  }, []);
  useEffect(() => { resetScan(); }, [mode, scope, resetScan]);

  const totalRows = groups.reduce((s, g) => s + g.ids.length, 0);
  useEffect(() => { onCount(scan.started ? { rows: totalRows, more: !scan.done } : null); }, [scan, totalRows, onCount]);

  const scanBatch = async (reset) => {
    if (reset) resetScan();
    const my = scanId.current;
    const live = () => my === scanId.current;
    const m = SCAN_MODES[mode];
    setBusy('scan'); setScanError(''); setResult(null);
    try {
      let scanned = reset ? 0 : scannedRef.current;
      let done = false;
      let failure = null;
      const bad = [];
      // The scan position only moves past a page once it has been read and checked; what was found before an error is kept
      for (let p = 0; p < m.pages && bad.length < 100 && !done; p++) {
        setProgress(`Scanning entries ${scanned + 1}–${scanned + m.pageSize}…`);
        let pg = pendingRef.current;
        try {
          if (!pg) {
            if (nextRef.current) pg = await nextRef.current();
            else if (scanned === 0) pg = await api.page(LOG_TABLE, { select: FIX_SELECT, filter: scanFilter(mode, scope), top: m.pageSize });
            else { done = true; break; }
            if (!live()) return;
            pendingRef.current = pg;
          }
          if (mode !== 'missing') { await store.resolveAssets(pg.rows.map(r => r.craa5_equipmentguid)); if (!live()) return; }
        } catch (e) { failure = e; break; }
        pendingRef.current = null;
        nextRef.current = pg.next;
        scanned += pg.rows.length;
        scannedRef.current = scanned;
        if (!pg.next) done = true;
        if (mode === 'missing') bad.push(...pg.rows);
        else if (mode === 'unknown') bad.push(...pg.rows.filter(r => !store.hasAsset(r.craa5_equipmentguid)));
        // Entries whose text lists several things, unless their ID already points at equipment with that very name
        else if (mode === 'several') bad.push(...pg.rows.filter(r => { const a = store.getAsset(r.craa5_equipmentguid); return textParts(r.craa5_equipment).length > 0 && !(a && sameText(a.name, r.craa5_equipment)); }));
        else bad.push(...pg.rows.filter(r => { const a = store.getAsset(r.craa5_equipmentguid); return a && placeDiffers(r, a); }));
      }

      // Group identical entries, then look up candidates once per new group
      const prior = reset ? new Map() : new Map(groups.map(g => [g.key, g]));
      const fresh = new Map();
      bad.forEach(r => {
        const l = { id: r.craa5__log_id, equipment: safeString(r.craa5_equipment), guid: cleanGuid(r.craa5_equipmentguid), sap: normCode(r.craa5_sap), room: safeString(r.craa5_room), area: safeString(r.craa5_area) };
        const key = [canonName(l.equipment), placeKey(l.room), placeKey(l.area), l.sap, l.guid].join('|');
        const into = prior.get(key) || fresh.get(key);
        if (into) { if (!into.ids.includes(l.id)) into.ids = [...into.ids, l.id]; return; }
        const current = mode === 'place' || mode === 'several' ? store.getAsset(l.guid) : null;
        fresh.set(key, { key, equipment: l.equipment, room: l.room, area: l.area, sap: l.sap, kind: m.kind, mode, current, exclude: mode === 'place' && current ? current.id : null, ids: [l.id] });
      });
      const todo = Array.from(fresh.values());
      let n = 0;
      const ranks = await pool(todo, 3, async (g) => {
        const r = await rankCandidates(store, g);
        n += 1; if (live()) setProgress(`Finding closest equipment… ${n} of ${todo.length} groups`);
        return r;
      });
      if (!live()) return;
      const added = todo.map((g, i) => ({ ...g, ...(ranks[i].ok ? ranks[i].value : { ranked: [], tier: 'none', ambiguous: false, conflict: false, check: null, lookupError: errText(ranks[i].error) }) }));
      // Equipment an entry may now be spread over (the things its text lists, or equipment named after it): only a hint
      const uses = new Map(); // equipment id -> its log count, looked up once per scan (not kept: the Unify tab reads fresh counts)
      const hints = await pool(added, 3, (g) => suggestPieces(store, g, uses));
      if (!live()) return;
      added.forEach((g, i) => { g.suggest = hints[i].ok ? hints[i].value : null; });
      // A name (same room and area) already in the list keeps the equipment chosen there (or the pieces it is broken up into), if its rows agree
      const famPick = new Map(); // family -> 'P:' + the equipment chosen, 'S:' + the pieces, or null when its rows disagree
      const famPieces = new Map();
      Array.from(prior.values()).forEach(g => {
        if (!canonName(g.equipment)) return;
        const list = pieces[g.key];
        if (!list && !choice[g.key]) return;
        const k = familyKey(g);
        const sig = list ? `S:${list.map(a => a.id).sort().join(',')}` : `P:${choice[g.key]}`;
        famPick.set(k, famPick.has(k) && famPick.get(k) !== sig ? null : sig);
        if (list) famPieces.set(k, list);
      });
      const known = (id) => { let a = store.getAsset(id); prior.forEach(g => { if (!a) a = g.ranked.concat((extraOpts[g.key] || []).map(o => ({ asset: o }))).map(r => r.asset).find(o => o.id === id) || null; }); return a; };
      const inherited = new Map();
      const inheritedPieces = new Map();
      added.forEach(g => {
        const sig = canonName(g.equipment) ? famPick.get(familyKey(g)) : null;
        if (!sig) return;
        if (sig.indexOf('S:') === 0) { inheritedPieces.set(g.key, famPieces.get(familyKey(g))); return; }
        const a = known(sig.slice(2));
        if (a) inherited.set(g.key, a);
      });
      const own = (g) => (g.ranked.length && g.tier !== 'none' ? g.ranked[0].asset.id : '');
      setChoice(prev => { const x = { ...prev }; added.forEach(g => { const a = inherited.get(g.key); x[g.key] = a ? a.id : own(g); }); return x; });
      // High confidence is ticked (not when it differs from the choice made for the name); entries whose ID points elsewhere are always left for the admin to tick
      setApply(prev => { const x = { ...prev }; added.forEach(g => { const a = inherited.get(g.key); x[g.key] = g.tier === 'high' && mode !== 'place' && !(mode === 'several' && g.current) && !g.suggest && !inheritedPieces.has(g.key) && (!a || a.id === own(g)); }); return x; });
      setExtraOpts(prev => { const x = { ...prev }; added.forEach(g => { const a = inherited.get(g.key); if (a && !g.ranked.some(r => r.asset.id === a.id)) x[g.key] = [a]; }); return x; });
      // A fresh group never starts with pieces left over from an earlier row that had the same key
      setPieces(prev => { const x = { ...prev }; added.forEach(g => { delete x[g.key]; }); inheritedPieces.forEach((list, key) => { x[key] = list; }); return x; });
      setGroups(() => {
        const merged = Array.from(prior.values()).concat(added);
        const order = { high: 0, medium: 1, low: 2, none: 3 };
        return merged.sort((a, b) => order[a.tier] - order[b.tier] || b.ids.length - a.ids.length);
      });
      setScan({ started: true, done, scanned });
      if (failure) setScanError(`${errText(failure)}. Scan the next batch to try that page again.`);
    } catch (e) { if (live()) setScanError(errText(e)); }
    finally { if (live()) { setBusy(''); setProgress(''); } }
  };

  // Only groups on screen can be applied
  const visible = groups.filter(g => showAll || g.tier !== 'none' || choice[g.key] || g.lookupError || g.suggest || pieces[g.key]);
  const hidden = groups.length - visible.length;
  const shown = visible.slice(0, LIMITS.fixGroupsShown);
  // A row can be applied once it has equipment chosen, or (broken up) at least two pieces
  const isReady = (g) => (pieces[g.key] ? pieces[g.key].length >= 2 : !!choice[g.key]);
  const selected = shown.filter(g => apply[g.key] && isReady(g));
  const selectedRows = selected.reduce((s, g) => s + g.ids.length, 0);
  const highGroups = shown.filter(g => !pieces[g.key] && !g.suggest && g.tier === 'high' && choice[g.key] && g.ranked.length && g.ranked[0].asset.id === choice[g.key]);
  // Medium matches on screen whose suggestion is still the one chosen, not flagged ambiguous or disagreeing,
  // and (as for every bulk pick) with room and area filled in and the same on the entry and the equipment
  const mediumGroups = shown.filter(g => !pieces[g.key] && !g.suggest && g.tier === 'medium' && !g.ambiguous && !g.conflict && choice[g.key] && g.ranked.length && g.ranked[0].asset.id === choice[g.key] && sameRoomAndArea(g, g.ranked[0].asset));
  const tickAll = (list) => setApply(p => { const x = { ...p }; list.forEach(g => { x[g.key] = true; }); return x; });

  const applySelected = async () => {
    const todo = selected.filter(g => pieces[g.key] || store.getAsset(choice[g.key]));
    if (!todo.length) return;
    setBusy('apply'); setResult(null);
    // Entries pointing at other equipment keep their own text; blank entries get the equipment's details filled in
    const fill = (g, a) => (g.mode === 'place' ? {} : { ...(g.room ? {} : { craa5_room: a.room }), ...(g.area ? {} : { craa5_area: a.area }), ...(g.equipment ? {} : { craa5_equipment: a.name }) });
    // A job is { id, payload } (given one piece of equipment) or { id, pieces } (broken up into several)
    const jobFor = (g, id) => {
      if (pieces[g.key]) return { id, pieces: pieces[g.key] };
      const a = store.getAsset(choice[g.key]);
      return { id, payload: { craa5_equipmentguid: a.id, ...fill(g, a) } };
    };
    const jobs = new Map(); // log id -> job
    todo.forEach(g => g.ids.forEach(id => jobs.set(id, jobFor(g, id))));
    const listed = jobs.size;
    const out = { extra: 0, moreIds: [], kept: 0, keptMore: false, mixed: 0, unplaced: 0, held: 0, capped: false, failedNames: [], declined: false };
    let more = [];
    if (sameName) {
      // The same name in the same room and area is the same equipment: every such entry gets the equipment chosen (or is broken
      // up the same way), unless the ticked rows for that name chose differently (then only those rows are written)
      const sigOf = (g) => (pieces[g.key] ? `S:${pieces[g.key].map(a => a.id).sort().join(',')}` : `P:${choice[g.key]}`);
      const fams = new Map();
      todo.forEach(g => {
        if (!canonName(g.equipment)) return;
        const k = familyKey(g);
        const wrong = (g.mode === 'place' || g.mode === 'several') && g.current ? [g.current.id] : [];
        const f = fams.get(k);
        if (!f) { fams.set(k, { key: k, g, sig: sigOf(g), split: !!pieces[g.key], assets: pieces[g.key] || [store.getAsset(choice[g.key])], wrong, mixed: false }); return; }
        if (f.sig !== sigOf(g)) f.mixed = true;
        f.wrong = f.wrong.concat(wrong);
      });
      const agreed = Array.from(fams.values()).filter(f => !f.mixed);
      out.mixed = fams.size - agreed.length;
      // Only a name with room and area filled in, and equipment in that same room and area, is spread to the rest of the log
      const list = agreed.filter(f => f.assets.every(a => sameRoomAndArea(f.g, a)));
      out.unplaced = agreed.length - list.length;
      list.forEach(f => {
        const rows = groups.filter(x => canonName(x.equipment) && familyKey(x) === f.key);
        // Every spelling of the room and area in the list, so the log read finds them all
        f.places = { rooms: rows.map(r => r.room), areas: rows.map(r => r.area) };
        // Rows of this name in the list that were given other equipment (or No match) keep the admin's decision
        f.held = new Set();
        rows.forEach(r => { if (sigOf(r) !== f.sig) r.ids.forEach(id => f.held.add(id)); });
      });
      let n = 0;
      setProgress(`Looking through the log for other entries with the same names… 0 of ${list.length}`);
      const found = await pool(list, 3, async (f) => {
        // Entries already on the equipment chosen are left alone (broken up: on any of its pieces, unless that one is the wrong ID being repaired)
        const keep = f.assets.map(a => a.id).filter(id => !f.split || f.wrong.indexOf(id) < 0);
        const r = await store.familyToFix(f.g, keep, f.wrong, f.places);
        n += 1; setProgress(`Looking through the log for other entries with the same names… ${n} of ${list.length}`);
        return r;
      });
      found.forEach((r, i) => {
        const f = list[i];
        if (!r.ok) { out.failedNames.push(f.g.equipment); return; }
        out.kept += r.value.kept;
        out.keptMore = out.keptMore || r.value.keptMore;
        out.capped = out.capped || r.value.capped;
        r.value.rows.forEach(row => {
          const id = row.craa5__log_id;
          if (jobs.has(id)) return;
          if (f.held.has(id)) { out.held += 1; return; }
          more.push(jobFor(f.g, id));
        });
      });
      // At most familyWriteMax writes (an entry broken up into pieces is one write for each piece)
      more = uniqueById(more);
      let budget = LIMITS.familyWriteMax;
      const within = [];
      for (let i = 0; i < more.length; i++) {
        const cost = more[i].pieces ? more[i].pieces.length : 1;
        if (cost > budget) { out.capped = true; break; }
        budget -= cost; within.push(more[i]);
      }
      more = within;
    }
    // Entries to break up: find out which pieces still need an entry before asking
    let plan = null;
    const splitJobs = Array.from(jobs.values()).concat(more).filter(j => j.pieces);
    if (splitJobs.length) {
      setProgress('Checking which pieces are already logged…');
      try { plan = await planSplits(api, splitJobs); }
      catch (e) {
        setResult({ ok: 0, failed: 0, error: '', ...out, extra: 0, split: null, planError: errText(e) });
        setProgress(''); setBusy('');
        return;
      }
    }
    // More entries than were ticked, or entries to break up: ask first (on the page, so it works where pop-up dialogs are blocked)
    if (more.length || plan) {
      const inList = new Set();
      groups.forEach(g => g.ids.forEach(id => inList.add(id)));
      setPending({ jobs, more, listed, inList: more.filter(j => inList.has(j.id)).length, out, plan });
      setProgress(''); setBusy('confirm');
      return;
    }
    await writeJobs(Array.from(jobs.values()), out);
  };

  const answerPending = async (withMore) => {
    const pd = pending;
    setPending(null);
    if (!pd || withMore === null) { setBusy(''); return; }
    const jobs = new Map();
    pd.jobs.forEach((j, id) => jobs.set(id, j));
    const out = { ...pd.out };
    if (withMore) pd.more.forEach(j => { if (!jobs.has(j.id)) { jobs.set(j.id, j); out.moreIds.push(j.id); } });
    else if (pd.more.length) out.declined = true;
    // Entries to break up are read again now: pieces saved or entries removed while the question was open are not missed
    let items = [];
    const splitJobs = Array.from(jobs.values()).filter(j => j.pieces);
    if (pd.plan && splitJobs.length) {
      setBusy('apply'); setProgress('Checking which pieces are already logged…');
      try { items = (await planSplits(api, splitJobs)).items; }
      catch (e) {
        setResult({ ok: 0, failed: 0, error: '', ...out, extra: 0, split: null, planError: errText(e) });
        setProgress(''); setBusy('');
        return;
      }
    }
    await writeJobs(Array.from(jobs.values()).filter(j => !j.pieces), out, items);
  };

  // all: entries given one piece of equipment { id, payload }; splitItems: entries broken up into pieces (from the plan)
  const writeJobs = async (all, out, splitItems = []) => {
    setBusy('apply');
    let done = 0;
    if (all.length) setProgress(`Updating entries… 0 of ${all.length}`);
    const res = await pool(all, 8, async (j) => {
      await api.update(LOG_TABLE, j.id, j.payload);
      done += 1; if (done % 25 === 0 || done === all.length) setProgress(`Updating entries… ${done} of ${all.length}`);
    });
    const fixed = new Set(all.filter((j, i) => res[i].ok).map(j => j.id));
    const firstError = res.find(r => !r.ok);
    let split = null;
    if (splitItems.length) {
      setProgress(`Breaking up entries… 0 of ${splitItems.length}`);
      split = await runSplits(api, splitItems, (k) => setProgress(`Breaking up entries… ${k} of ${splitItems.length}`));
      split.extra = out.moreIds.filter(id => split.fixedIds.indexOf(id) >= 0).length;
    }
    const finished = new Set(Array.from(fixed).concat(split ? split.fixedIds : []));
    // Remove fixed entries from every row of the list (same-name rows included); nothing is rescanned
    setGroups(prev => prev.map(g => ({ ...g, ids: g.ids.filter(id => !finished.has(id)) })).filter(g => g.ids.length));
    setResult({ ok: fixed.size, failed: all.length - fixed.size, error: firstError ? errText(firstError.error) : '', ...out, extra: out.moreIds.filter(id => fixed.has(id)).length, split });
    setProgress('');
    ctx.dataChanged();
    setBusy('');
  };

  // A choice for one row is the choice for every row of the same equipment (same name, room and area) in the list
  const chooseFor = (g, a) => {
    if (!a) { setChoice(p => ({ ...p, [g.key]: '' })); setApply(p => ({ ...p, [g.key]: false })); return; }
    const fam = canonName(g.equipment) ? familyKey(g) : null;
    const rows = fam ? groups.filter(x => x.key === g.key || (canonName(x.equipment) && familyKey(x) === fam)) : [g];
    const custom = !g.ranked.some(r => r.asset.id === a.id);
    // Rows whose own suggestions do not include it get it as an option
    setExtraOpts(p => { const x = { ...p }; rows.forEach(r => { if (!r.ranked.some(c => c.asset.id === a.id)) x[r.key] = (x[r.key] || []).filter(o => o.id !== a.id).concat([a]); }); return x; });
    setChoice(p => { const x = { ...p }; rows.forEach(r => { x[r.key] = a.id; }); return x; });
    // The row picked: a match picked by hand is ticked; a suggestion keeps the tick unless it is in another room or area.
    // The other rows of the name keep their tick, except entries whose ID points elsewhere and equipment in another room or area
    setApply(p => {
      const x = { ...p };
      rows.forEach(r => {
        if (r.key === g.key) { if (custom) x[r.key] = true; else if (!placeOk(r, a)) x[r.key] = false; }
        else if (r.mode === 'place' || !sameRoomAndArea(r, a)) x[r.key] = false;
      });
      return x;
    });
  };

  // Breaking up is a choice for the whole name, like one piece of equipment: every row of the same name, room and area follows.
  // list: the pieces so far (a list of fewer than two is still being chosen), or null for one piece of equipment again.
  const breakUp = (g, list) => {
    const fam = canonName(g.equipment) ? familyKey(g) : null;
    const rows = fam ? groups.filter(x => x.key === g.key || (canonName(x.equipment) && familyKey(x) === fam)) : [g];
    setPieces(p => { const x = { ...p }; rows.forEach(r => { if (list) x[r.key] = list; else delete x[r.key]; }); return x; });
    // The row acted on is ticked once it has two pieces. The other rows of the name keep their tick, except entries whose ID points elsewhere
    setApply(p => {
      const x = { ...p };
      rows.forEach(r => {
        if (r.key === g.key) x[r.key] = !!list && list.length >= 2;
        else if (r.mode === 'place' || (list && !list.every(a => sameRoomAndArea(r, a)))) x[r.key] = false;
      });
      return x;
    });
  };

  const failedLookups = groups.filter(g => g.lookupError).length;
  // What breaking up would do: for the ticked entries, and for all of them with the other entries of the same names
  const planned = pending && pending.plan ? { ticked: splitStats(pending.plan.items.filter(it => pending.jobs.has(it.id))), all: splitStats(pending.plan.items), others: pending.listed - Array.from(pending.jobs.values()).filter(j => j.pieces).length } : null;
  // Nothing would be written (every piece is already logged, the entries are gone or have no date, and no other entry is ticked)
  const idle = !!planned && planned.all.rows === 0 && planned.others === 0 && pending.more.every(j => j.pieces);

  return (
    <div>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        Log entries need the equipment’s ID (craa5_equipmentguid) so the calendar can match them. This scans the log page by page, groups identical entries, and suggests the closest equipment using the SAP order first, then the equipment name in the same room and area (equipment numbers must agree). Each suggestion is double-checked against the log: other entries with the same name in the same room and area that already have an ID. Type in Map to to search all equipment for a match of your own. Only the equipment it needs is looked up. An entry that covers several pieces of equipment, because the equipment has since been broken up, can be broken up as well: choose Break up under Map to and pick the pieces. The entry keeps the first piece and every other piece gets a new entry with the same date, SAP order and initials (the hours are shared out in whole hours). Nothing is saved until you apply.
      </Text>
      <div className={styles.filterBar}>
        <Select aria-label="Entries to look for" value={mode} disabled={!!busy} onChange={(e, d) => setMode(d.value)}>
          {Object.entries(SCAN_MODES).map(([k, v]) => <option key={k} value={k}>{v.label}</option>)}
        </Select>
        <Select aria-label="Scan scope" value={scope} disabled={!!busy} onChange={(e, d) => setScope(d.value)}>
          <option value="all">All dates</option>
          <option value="year">Last 12 months</option>
        </Select>
        {!scan.started
          ? <Button appearance="primary" className={styles.btnPrimary} onClick={() => scanBatch(true)} disabled={!!busy}>{busy === 'scan' ? 'Scanning…' : 'Start scan'}</Button>
          : <>
            <Button onClick={() => scanBatch(false)} disabled={!!busy || scan.done}>{busy === 'scan' ? 'Scanning…' : scan.done ? 'End of log reached' : 'Scan next batch'}</Button>
            <Button onClick={() => scanBatch(true)} disabled={!!busy}>Start over</Button>
          </>}
        <Button disabled={!!busy || !highGroups.length} onClick={() => tickAll(highGroups)}>Tick all high confidence</Button>
        <Button disabled={!!busy || !mediumGroups.length} onClick={() => tickAll(mediumGroups)}>{`Tick all medium shown${mediumGroups.length ? ` (${mediumGroups.length})` : ''}`}</Button>
        <Button appearance="primary" className={styles.btnCta} disabled={!!busy || !selected.length || ctx.saving} onClick={applySelected}>
          {busy === 'apply' ? 'Applying…' : `Apply ${selected.length} selected (${selectedRows} entries)`}
        </Button>
        <Checkbox label="Show no-match groups" checked={showAll} onChange={(e, d) => setShowAll(!!d.checked)} />
        <Checkbox label="Also fix every entry with the same name, room and area" checked={sameName} disabled={!!busy} onChange={(e, d) => setSameName(!!d.checked)} />
      </div>
      {pending && (
        <div role="alertdialog" aria-label={pending.plan ? 'Break up these entries?' : 'Update the other entries with the same names?'} style={{ border: `2px solid ${BRAND.yellow}`, backgroundColor: '#FFF6E5', borderRadius: '6px', padding: '10px 12px', marginBottom: '10px' }}>
          {planned && (
            <div style={{ marginBottom: pending.more.length > 0 && !idle ? 8 : 0 }}>
              <Text block weight="semibold">{planned.ticked.rows > 0 ? `Break up ${plural(planned.ticked.rows, 'entry', 'entries')} into pieces?` : idle ? 'Nothing can be broken up here.' : 'Nothing to break up in the ticked rows.'}</Text>
              {planned.ticked.rows > 0 && <Text className={styles.hint} block>The first piece stays on the existing entry and {plural(planned.ticked.creates, 'new entry', 'new entries')} {planned.ticked.creates === 1 ? 'is' : 'are'} saved for the other pieces, each with the entry’s date, SAP order and initials. The hours are shared out in whole hours.</Text>}
              {planned.others > 0 && <Text className={styles.hint} block>The other {plural(planned.others, 'ticked entry', 'ticked entries')} {planned.others === 1 ? 'is' : 'are'} updated with the equipment chosen for {planned.others === 1 ? 'it' : 'them'}.</Text>}
              {planned.ticked.pieceSkips > 0 && <Text className={styles.hint} block>{plural(planned.ticked.pieceSkips, 'piece already has', 'pieces already have')} an entry for that order and date and {planned.ticked.pieceSkips === 1 ? 'is' : 'are'} not saved again.{planned.ticked.skippedHours > 0 ? ` The hours for ${planned.ticked.pieceSkips === 1 ? 'that piece' : 'those pieces'} (${planned.ticked.skippedHours} h) are not saved either.` : ''}</Text>}
              {planned.ticked.leftAlone > 0 && <Text className={styles.hint} block>{plural(planned.ticked.leftAlone, 'entry stays', 'entries stay')} as {planned.ticked.leftAlone === 1 ? 'it is' : 'they are'}, because every piece is already logged for that order and date.</Text>}
              {planned.ticked.gone > 0 && <Text className={styles.hint} block>{plural(planned.ticked.gone, 'entry was', 'entries were')} not found (removed since the scan).</Text>}
              {planned.ticked.undated > 0 && <Text className={styles.hint} block>{plural(planned.ticked.undated, 'entry has', 'entries have')} no date and will not be broken up: there is no date to check the pieces against.</Text>}
              {pending.plan.capped.length > 0 && <Text className={styles.hint} block>{plural(pending.plan.capped.length, 'piece has', 'pieces have')} more entries than could be checked for earlier dates, so a piece could be saved twice.</Text>}
            </div>
          )}
          {pending.more.length > 0 && !idle && (
            <Text block weight="semibold">The log has {plural(pending.more.length, 'more entry', 'more entries')} with the same name, room and area as the ticked rows{pending.inList ? ` (${pending.inList} of them further down this list)` : ''}. {pending.plan ? 'Include' : 'Update'} {pending.more.length === 1 ? 'it' : 'them'} {pending.plan ? 'too' : 'to the same equipment too'}?{planned ? ` Together that is ${plural(planned.all.rows, 'entry', 'entries')} broken up and ${plural(planned.all.creates, 'new entry', 'new entries')} saved.` : ''}</Text>
          )}
          {pending.out.held > 0 && <Text className={styles.hint} block>{plural(pending.out.held, 'entry', 'entries')} with those names {pending.out.held === 1 ? 'has' : 'have'} a row in this list with other equipment (or No match) chosen and will be left out.</Text>}
          {pending.out.kept > 0 && <Text className={styles.hint} block>{pending.out.keptMore ? 'At least ' : ''}{plural(pending.out.kept, 'entry', 'entries')} with those names already {pending.out.kept === 1 ? 'points' : 'point'} at other existing equipment and will be left as {pending.out.kept === 1 ? 'it is' : 'they are'}.</Text>}
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginTop: '8px' }}>
            {idle ? (
              <Button appearance="primary" className={styles.btnCta} onClick={() => answerPending(null)}>Close</Button>
            ) : (
              <>
                {pending.more.length > 0 ? (
                  <>
                    <Button appearance="primary" className={styles.btnCta} onClick={() => answerPending(true)}>{`Update all ${pending.listed + pending.more.length}`}</Button>
                    <Button onClick={() => answerPending(false)}>{`Only the ${pending.listed} ticked`}</Button>
                  </>
                ) : (
                  <Button appearance="primary" className={styles.btnCta} onClick={() => answerPending(true)}>{`Apply ${pending.listed}`}</Button>
                )}
                <Button appearance="subtle" onClick={() => answerPending(null)}>Cancel</Button>
              </>
            )}
          </div>
        </div>
      )}
      <div aria-live="polite">
        {progress && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{progress}</Text>}
        {scanError && <Text className={styles.errorText} block role="alert">Scan failed: {scanError}</Text>}
        {failedLookups > 0 && <Text className={styles.errorText} block role="alert">Equipment lookup failed for {plural(failedLookups, 'group', 'groups')} (marked “Lookup failed”). Scan again to retry.</Text>}
        {result && result.planError && <Text className={styles.errorText} block role="alert">Nothing was saved: could not check which pieces are already logged ({result.planError}).</Text>}
        {result && !result.planError && (result.ok > 0 || result.failed > 0 || !result.split) && <Text className={result.failed ? styles.errorText : styles.okText} block>{plural(result.ok, 'entry', 'entries')} updated{result.extra ? `, including ${plural(result.extra, 'more entry', 'more entries')} found in the log with the same name, room and area` : ''}{result.failed ? `; ${result.failed} failed (${result.error})` : ''}.</Text>}
        {result && result.split && <Text className={result.split.failedRows ? styles.errorText : styles.okText} block>{splitSummary(result.split)}</Text>}
        {result && result.split && splitNotes(result.split) && <Text className={styles.warnText} block>{splitNotes(result.split)}</Text>}
        {result && !result.planError && (result.kept > 0 || result.mixed > 0 || result.unplaced > 0 || result.held > 0 || (result.capped && !result.declined) || result.failedNames.length > 0 || result.declined) && (
          <Text className={styles.warnText} block>
            {[
              result.declined && 'Only the ticked entries were included.',
              result.mixed > 0 && `For ${plural(result.mixed, 'name', 'names')} the ticked rows chose different equipment, so only those rows were updated.`,
              result.unplaced > 0 && `For ${plural(result.unplaced, 'name', 'names')} the room or area is blank, or the equipment chosen is in another room or area, so only the ticked rows were updated.`,
              result.held > 0 && `${plural(result.held, 'entry', 'entries')} with those names ${result.held === 1 ? 'was' : 'were'} left because ${result.held === 1 ? 'its' : 'their'} row in the list has other equipment (or No match) chosen.`,
              result.kept > 0 && `${result.keptMore ? 'At least ' : ''}${plural(result.kept, 'entry', 'entries')} with those names already ${result.kept === 1 ? 'points' : 'point'} at other existing equipment and ${result.kept === 1 ? 'was' : 'were'} left as ${result.kept === 1 ? 'it is' : 'they are'}.`,
              result.capped && !result.declined && 'Some names have more entries than one apply reads: scan again and apply to fix the rest.',
              result.failedNames.length > 0 && `Could not look through the log for ${result.failedNames.slice(0, 3).map(x => `“${x}”`).join(', ')}${result.failedNames.length > 3 ? ` and ${result.failedNames.length - 3} more` : ''}, so only the ticked rows for ${result.failedNames.length === 1 ? 'it' : 'them'} were updated.`,
            ].filter(Boolean).join(' ')}
          </Text>
        )}
      </div>
      {scan.started && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{scan.scanned} entries checked. {mode === 'several' ? `${totalRows} list several pieces` : `${totalRows} need an ID`}, in {plural(groups.length, 'distinct equipment group', 'distinct equipment groups')}.{scan.done ? ' The whole log has been checked.' : ' More entries remain: scan the next batch.'}</Text>}
      {scan.started && scan.done && groups.length === 0 && <Text className={styles.okText} block>{mode === 'several' ? 'No entry lists several pieces of equipment.' : 'Every checked entry has a valid equipment ID.'}</Text>}
      {hidden > 0 && (
        <Text className={styles.hint} block style={{ marginBottom: 8 }}>
          {plural(hidden, 'group has', 'groups have')} no suggested match. <Button size="small" appearance="transparent" onClick={() => setShowAll(true)}>Show them to map by hand</Button>
        </Text>
      )}
      {shown.length > 0 && (
        <div style={{ overflowX: 'auto' }}>
          <table className={styles.linesTable}>
            <thead><tr>
              <th className={styles.th}>Apply</th><th className={styles.th}>Logged as</th><th className={styles.th}>Room / Area</th><th className={styles.th}>SAP order</th>
              <th className={styles.th}>Entries</th><th className={styles.th}>Issue</th><th className={styles.th}>Map to</th><th className={styles.th}>Confidence</th>
            </tr></thead>
            <tbody>
              {shown.map(g => {
                const options = uniqueById([...g.ranked.map(r => r.asset), ...(extraOpts[g.key] || [])]);
                const top = g.ranked.find(r => r.asset.id === choice[g.key]);
                // The badge follows the candidate chosen, not only the group's best one
                const ORDER = { high: 0, medium: 1, low: 2, none: 3 };
                const own = top && top !== g.ranked[0] ? tierOf(top.score) : g.tier;
                const tier = ORDER[own] < ORDER[g.tier] ? g.tier : own;
                const check = pieces[g.key] ? null : logCheck(g, choice[g.key], options.find(a => a.id === choice[g.key]) || store.getAsset(choice[g.key]));
                return (
                  <tr key={g.key}>
                    <td className={styles.td}><input type="checkbox" aria-label={`Apply ${g.equipment || 'blank entry'}`} checked={!!apply[g.key] && isReady(g)} disabled={!isReady(g) || !!busy} onChange={(e) => setApply(p => ({ ...p, [g.key]: e.target.checked }))} /></td>
                    <td className={styles.td}><strong>{g.equipment || '(blank)'}</strong></td>
                    <td className={styles.td}>{placeText(g)}</td>
                    <td className={styles.td}>{g.sap}</td>
                    <td className={styles.td}>{g.ids.length}</td>
                    <td className={styles.td}>
                      <span className={mergeClasses(styles.tag, g.kind === 'missing id' ? styles.tagWarn : g.kind === 'several pieces' ? styles.tagInfo : styles.tagBad)}>{g.kind}</span>
                      {g.current && <div className={styles.hint}>ID is {g.current.name} · {placeText(g.current)}</div>}
                    </td>
                    <td className={styles.td} style={{ minWidth: 280 }}>
                      {pieces[g.key] ? (
                        <PiecesEditor store={store} g={g} list={pieces[g.key]} missing={g.suggest ? g.suggest.missing : []} disabled={!!busy} onChange={(list) => breakUp(g, list)} />
                      ) : (
                        <>
                          <EquipmentChoice store={store} label={`Equipment for ${g.equipment || 'blank entry'}`} options={options} value={choice[g.key] || ''} disabled={!!busy} onChoose={(a) => chooseFor(g, a)}
                            uses={g.check && g.check.uses ? new Map(g.check.uses.map(x => [x.asset.id, x.count])) : null} />
                          {g.suggest && (
                            <div className={styles.hint} style={{ marginTop: 4 }}>
                              {g.suggest.how === 'text' ? 'This entry lists several things. Found: ' : 'Equipment here that starts with this name: '}<strong>{g.suggest.assets.map(a => a.name).join(', ')}</strong>.
                              {g.suggest.missing.length > 0 && ` No equipment found for ${g.suggest.missing.map(x => `“${x}”`).join(', ')}: choose Break up like this, then search to add ${g.suggest.missing.length === 1 ? 'it' : 'them'}.`}{' '}
                              <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={!!busy} aria-label={`Break up like this: ${g.equipment || 'blank entry'}`} onClick={() => breakUp(g, g.suggest.assets)}>Break up like this</Button>
                            </div>
                          )}
                          <div style={{ marginTop: 2 }}>
                            <Button size="small" appearance="transparent" disabled={!!busy} aria-label={`Break up into several pieces: ${g.equipment || 'blank entry'}`} onClick={() => breakUp(g, [])}>Break up into several pieces…</Button>
                          </div>
                        </>
                      )}
                    </td>
                    <td className={styles.td}>
                      {pieces[g.key] ? (
                        <>
                          <span className={mergeClasses(styles.tag, pieces[g.key].length >= 2 ? styles.tagInfo : styles.tagWarn)}>{pieces[g.key].length >= 2 ? `Break up · ${plural(pieces[g.key].length, 'piece', 'pieces')}` : 'Add at least two pieces'}</span>
                          {pieces[g.key].length >= 2 && <div className={styles.hint} style={{ marginTop: 4 }}>Each entry becomes {pieces[g.key].length} entries, one for each piece.</div>}
                        </>
                      ) : top ? (
                        <span className={mergeClasses(styles.tag, tier === 'high' ? styles.tagOk : tier === 'none' ? styles.tagBad : styles.tagWarn)}>
                          {TIER_LABEL[tier]} · {top.reason}{g.ambiguous ? ' · ambiguous' : ''}{g.conflict ? ` · ${g.conflictText || 'sources disagree'}` : ''}
                        </span>
                      ) : choice[g.key] ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>manual</span>
                        : <span className={mergeClasses(styles.tag, styles.tagBad)} title={g.lookupError || ''}>{g.lookupError ? 'Lookup failed' : 'No match'}</span>}
                      {check && <div className={styles.hint} style={{ marginTop: 4, color: check.kind === 'ok' ? '#0A7A3B' : check.kind === 'warn' ? BRAND.redText : undefined }}>{check.kind === 'ok' ? '✓ ' : check.kind === 'warn' ? '⚠ ' : ''}{check.text}</div>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {visible.length > shown.length && <Text className={styles.hint} block style={{ marginTop: 6 }}>Showing the first {shown.length} of {visible.length} groups. Apply these to see the rest.</Text>}
        </div>
      )}
    </div>
  );
};

// Equipment records in one room that are the same equipment: same area and the same name (or, with similar on, a similar name)
const clusterAssets = (list, similar) => {
  const byArea = new Map();
  list.forEach(a => { const k = placeKey(a.area); if (!byArea.has(k)) byArea.set(k, []); byArea.get(k).push(a); });
  const out = [];
  byArea.forEach((items, areaKey) => {
    const prof = items.map(a => nameProfile(a.name));
    const parent = items.map((_, i) => i);
    const root = (i) => (parent[i] === i ? i : (parent[i] = root(parent[i])));
    for (let i = 0; i < items.length; i++) {
      for (let j = i + 1; j < items.length; j++) {
        if ((prof[i].full && prof[i].full === prof[j].full) || (similar && nameSimilarity(prof[i], prof[j]) >= 0.8)) parent[root(i)] = root(j);
      }
    }
    const sets = new Map();
    items.forEach((a, i) => { const r = root(i); if (!sets.has(r)) sets.set(r, []); sets.get(r).push(a); });
    sets.forEach(members => {
      if (members.length < 2) return;
      out.push({
        key: `${areaKey}|${members.map(m => m.id).sort().join(',')}`,
        room: members[0].room, area: members[0].area,
        identical: new Set(members.map(m => canonName(m.name))).size === 1 && new Set(members.map(m => safeString(m.area).trim().toLowerCase())).size === 1,
        members: members.map(m => ({ ...m })),
      });
    });
  });
  return out.sort((a, b) => a.area.localeCompare(b.area) || a.members[0].name.localeCompare(b.members[0].name));
};

const UnifyIds = ({ ctx }) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [room, setRoom] = useState('');
  const [area, setArea] = useState('');
  const [similar, setSimilar] = useState(false);
  const [moveLinks, setMoveLinks] = useState(true);
  const [fillBlank, setFillBlank] = useState(true); // entries of these names here with no ID (or a gone one) get the kept ID too
  const [busy, setBusy] = useState('');
  const [progress, setProgress] = useState('');
  const [error, setError] = useState('');
  const [found, setFound] = useState(null);   // { room, area, similar, capped, checked, clusters }
  const [keep, setKeep] = useState({});       // clusterKey -> asset id kept
  const [apply, setApply] = useState({});     // clusterKey -> bool
  const [skip, setSkip] = useState({});       // "clusterKey|assetId" -> record left where it is
  const [result, setResult] = useState(null);
  const runId = useRef(0);
  // In a similar-names group, records whose name is not close to the kept one are left out until ticked
  const skipFor = (c, keepId) => {
    const kept = c.members.find(m => m.id === keepId);
    const out = {};
    if (!kept || c.identical) return out;
    const kp = nameProfile(kept.name);
    c.members.forEach(m => { if (m.id !== keepId && nameSimilarity(nameProfile(m.name), kp) < 0.8) out[`${c.key}|${m.id}`] = true; });
    return out;
  };
  const isSkipped = (c, m) => !!skip[`${c.key}|${m.id}`];
  const roomOpts = useSuggest(store, 'craa5_roomname', room);
  const areaOpts = useSuggest(store, 'craa5_areaname', area, room.trim());

  const find = async () => {
    const r = room.trim(), a = area.trim();
    if (!r) { setError('Enter a room to look in.'); return; }
    const my = ++runId.current;
    const live = () => my === runId.current;
    setBusy('find'); setError(''); setResult(null); setFound(null);
    try {
      setProgress(`Loading the equipment in ${r}${a ? ` / ${a}` : ''}…`);
      const { list, capped } = await store.assetsInPlace(r, a);
      const clusters = clusterAssets(list, similar);
      const members = clusters.flatMap(c => c.members);
      if (members.length) {
        setProgress(`Counting log entries for ${plural(members.length, 'equipment record', 'equipment records')}…`);
        const ids = members.map(m => m.id);
        const [uses, added, links] = await Promise.all([pool(members, 4, (m) => store.logUse(m.id)), store.assetsAdded(ids), store.msLinkedTo(ids)]);
        members.forEach((m, i) => {
          m.count = uses[i].ok ? uses[i].value : null;
          m.added = added.get(m.id) || '';
          m.links = links.filter(x => x.assetId === m.id);
        });
      }
      if (!live()) return;
      // Newest first: the record whose newest entry was saved last, then the record added last. The first one is kept.
      const when = (v) => { const t = Date.parse(safeString(v)); return Number.isNaN(t) ? 0 : t; };
      clusters.forEach(c => c.members.sort((x, y) => when(y.count && y.count.newest) - when(x.count && x.count.newest) || when(y.added) - when(x.added)
        || ((y.count && y.count.n) || 0) - ((x.count && x.count.n) || 0)));
      const k = {};
      const ap = {};
      let sk = {};
      clusters.forEach(c => {
        k[c.key] = c.members[0].id;
        // A record whose entries could not be counted may be the newest: that group waits for the admin to tick it
        ap[c.key] = c.identical && c.members.every(m => m.count);
        sk = { ...sk, ...skipFor(c, c.members[0].id) };
      });
      setKeep(k); setApply(ap); setSkip(sk);
      setFound({ room: r, area: a, similar, capped, checked: list.length, clusters });
    } catch (e) { if (live()) setError(errText(e)); }
    finally { if (live()) { setBusy(''); setProgress(''); } }
  };

  const todo = found ? found.clusters.filter(c => apply[c.key] && keep[c.key] && c.members.some(m => m.id !== keep[c.key] && !isSkipped(c, m))) : [];
  const movers = (c) => c.members.filter(m => m.id !== keep[c.key] && !isSkipped(c, m));
  // When the record's newest entry was saved (or, where that cannot be read, cleaned)
  const newestText = (m) => (!m.count || !m.count.newest ? '' : m.count.saved ? `newest entry saved ${stampText(m.count.newest)}` : `newest entry cleaned ${dayKey(m.count.newest)}`);
  const toMove = todo.reduce((s, c) => s + movers(c).reduce((t, m) => t + ((m.count && m.count.n) || 0), 0), 0);
  const toMoveMore = todo.some(c => movers(c).some(m => !m.count || m.count.more));

  const unify = async () => {
    if (!todo.length) return;
    setBusy('apply'); setResult(null); setError('');
    let moved = 0, relinked = 0, filled = 0, left = 0, leftMore = false, onSkipped = 0, unplaced = 0, unchecked = 0, failed = 0, firstError = '', remaining = false;
    const doneKeys = new Set();
    const fail = (e) => { failed += 1; if (!firstError) firstError = typeof e === 'string' ? e : errText(e); };
    for (const c of todo) {
      const kept = c.members.find(m => m.id === keep[c.key]);
      const moverIds = movers(c).map(m => m.id);
      const skippedIds = c.members.filter(m => m.id !== kept.id && isSkipped(c, m)).map(m => m.id);
      const failedIds = new Set(); // entries that could not be moved: not tried again below
      let ok = true;
      for (const m of movers(c)) {
        setProgress(`Moving entries from ${m.name} (${shortId(m.id)}) to ${kept.name} (${shortId(kept.id)})…`);
        try {
          const r = await repointEntries(api, guidEq('craa5_equipmentguid', m.id), null, kept, true);
          moved += r.fixed;
          r.failedIds.forEach(id => { failedIds.add(id); fail(r.error); });
          if (r.failed) ok = false;
          if (r.more) { ok = false; remaining = true; }
        } catch (e) { ok = false; fail(e); }
        if (moveLinks) {
          // Links already moved by an earlier click are not written (or counted) again
          for (const row of (m.links || []).filter(x => !x.moved)) {
            try { const w = await store.writeMs(row.id, {}, kept); if (w.linked) { relinked += 1; row.moved = true; } else { ok = false; fail(w.error || 'SAP row link not stored'); } }
            catch (e) { ok = false; fail(e); }
          }
        }
      }
      // Old entries of these names in this room and area with no ID, or an ID that no longer exists, get the kept ID too.
      // Only with room and area filled in on the kept record, as everywhere else that names are matched.
      if (fillBlank) {
        if (!sameRoomAndArea(c, kept)) unplaced += 1;
        else {
          const names = [];
          [kept].concat(movers(c)).forEach(m => { if (canonName(m.name) && !names.some(x => canonName(x) === canonName(m.name))) names.push(m.name); });
          const places = { rooms: c.members.map(m => m.room), areas: c.members.map(m => m.area) };
          for (const name of names) {
            setProgress(`Giving ${kept.name} (${shortId(kept.id)}) to entries of ${name} with no ID…`);
            try {
              const r = await store.familyToFix({ equipment: name, room: c.room, area: c.area }, kept.id, moverIds, places);
              // What the entries left alone point at: the kept record in another spelling (nothing to say), a record left out, or other equipment
              r.keptIds.forEach(id => { if (id === cleanGuid(kept.id)) return; if (skippedIds.indexOf(id) >= 0) onSkipped += 1; else left += 1; });
              leftMore = leftMore || r.keptMore;
              const rows = r.rows.filter(row => !failedIds.has(row.craa5__log_id));
              const res = await pool(rows, 6, (row) => api.update(LOG_TABLE, row.craa5__log_id, { craa5_equipmentguid: kept.id }));
              let wrote = 0;
              res.forEach((x, i) => {
                if (!x.ok) { ok = false; fail(x.error); return; }
                wrote += 1;
                // An entry still on a record being moved was moved, not filled
                if (moverIds.indexOf(cleanGuid(rows[i].craa5_equipmentguid)) >= 0) moved += 1; else filled += 1;
              });
              // Another click only helps when this one changed something; otherwise the rest are left for Repair IDs
              if (r.capped) { if (wrote) { ok = false; remaining = true; } else unchecked += 1; }
            } catch (e) { ok = false; fail(e); }
          }
        }
      }
      if (ok) doneKeys.add(c.key);
    }
    ctx.dataChanged();
    setFound(f => ({ ...f, clusters: f.clusters.filter(c => !doneKeys.has(c.key)) }));
    setResult({ moved, relinked, filled, left, leftMore, onSkipped, unplaced, unchecked, failed, error: firstError, groups: doneKeys.size, remaining });
    setProgress(''); setBusy('');
  };

  return (
    <div>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        Finds equipment records that are the same equipment in the same room and area (for example two “Floors” records in Bakery / Breading) and moves every log entry onto the one you keep, so the calendar shows them together. Each group lists its records newest first, by when their newest log entry was saved, and keeps the first one unless you pick another. With the box below ticked, old entries of those names in that room and area with no ID, or an ID that no longer exists, get the kept ID too. By default only identical names are grouped; tick “Also unify similar names” to group names like “Floor” and “Floors” too. Equipment records are not deleted. Nothing is saved until you unify.
      </Text>
      <div className={styles.filterBar}>
        <Input aria-label="Room to check" placeholder="Room (required)" list="unify-rooms" value={room} disabled={!!busy} onChange={(e, d) => setRoom(d.value)} onKeyDown={(e) => { if (e.key === 'Enter') find(); }} />
        <Input aria-label="Area to check" placeholder="Area (optional)" list="unify-areas" value={area} disabled={!!busy} onChange={(e, d) => setArea(d.value)} onKeyDown={(e) => { if (e.key === 'Enter') find(); }} />
        <Checkbox label="Also unify similar names" checked={similar} disabled={!!busy} onChange={(e, d) => setSimilar(!!d.checked)} />
        <Button appearance="primary" className={styles.btnPrimary} disabled={!!busy} onClick={find}>{busy === 'find' ? 'Looking…' : 'Find duplicates'}</Button>
      </div>
      <datalist id="unify-rooms">{roomOpts.map(r => <option key={r} value={r} />)}</datalist>
      <datalist id="unify-areas">{areaOpts.map(r => <option key={r} value={r} />)}</datalist>
      <div aria-live="polite">
        {progress && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{progress}</Text>}
        {error && <Text className={styles.errorText} block role="alert">{error}</Text>}
        {result && (
          <Text className={result.failed ? styles.errorText : styles.okText} block>
            Moved {plural(result.moved, 'entry', 'entries')}{result.relinked ? ` and ${plural(result.relinked, 'SAP row link', 'SAP row links')}` : ''}{result.filled ? `, and gave the kept ID to ${plural(result.filled, 'entry', 'entries')} with no ID (or an ID that no longer exists)` : ''}{result.failed ? `; ${result.failed} failed (${result.error})` : ''}.
            {result.remaining ? ' More entries remain: click Unify again to move the rest.' : ''}
          </Text>
        )}
        {result && (result.unplaced > 0 || result.unchecked > 0 || result.left > 0 || result.onSkipped > 0) && (
          <Text className={styles.warnText} block>
            {[
              result.unplaced > 0 && `For ${plural(result.unplaced, 'group', 'groups')} the room or area is blank, so entries with no ID were left for Repair IDs.`,
              result.unchecked > 0 && `For ${plural(result.unchecked, 'name', 'names')} the room and area have too many entries with similar names to check them all; use Repair IDs for the rest.`,
              result.onSkipped > 0 && `${plural(result.onSkipped, 'entry', 'entries')} with these names stay on the records you left unticked.`,
              result.left > 0 && `${result.leftMore ? 'At least ' : ''}${plural(result.left, 'entry', 'entries')} with these names ${result.left === 1 ? 'points' : 'point'} at other equipment that is not in the group and ${result.left === 1 ? 'was' : 'were'} left as ${result.left === 1 ? 'it is' : 'they are'}.`,
            ].filter(Boolean).join(' ')}
          </Text>
        )}
      </div>
      {found && (
        <>
          <Text className={styles.hint} block style={{ marginBottom: 8 }}>
            {plural(found.checked, 'equipment record', 'equipment records')} checked in {found.room}{found.area ? ` / ${found.area}` : ''}. {found.clusters.length ? `${plural(found.clusters.length, 'group', 'groups')} of duplicates found.` : 'No duplicates found.'}
            {found.capped ? ` Only the first ${LIMITS.unifyAssets} records were checked; pick an area to check the rest.` : ''}
          </Text>
          {found.clusters.length > 0 && (
            <>
              <div className={styles.actionBar}>
                <Checkbox label="Also point SAP orders at the kept record" checked={moveLinks} disabled={!!busy} onChange={(e, d) => setMoveLinks(!!d.checked)} />
                <Checkbox label="Also give the kept ID to entries of these names here with no ID or an ID that no longer exists" checked={fillBlank} disabled={!!busy} onChange={(e, d) => setFillBlank(!!d.checked)} />
                <Button disabled={!!busy || found.clusters.every(c => apply[c.key])} onClick={() => setApply(p => { const x = { ...p }; found.clusters.forEach(c => { x[c.key] = true; }); return x; })}>Tick all groups</Button>
                <Button appearance="primary" className={styles.btnCta} disabled={!!busy || !todo.length || ctx.saving} onClick={unify}>
                  {busy === 'apply' ? 'Unifying…' : `Unify ${plural(todo.length, 'group', 'groups')} (${toMove}${toMoveMore ? '+' : ''} ${toMove === 1 && !toMoveMore ? 'entry' : 'entries'} to move${fillBlank ? ', plus entries with no or unknown ID' : ''})`}
                </Button>
              </div>
              <div style={{ overflowX: 'auto' }}>
                <table className={styles.linesTable}>
                  <thead><tr>
                    <th className={styles.th}>Unify</th><th className={styles.th}>Area</th><th className={styles.th}>Equipment records</th><th className={styles.th}>Keep</th>
                  </tr></thead>
                  <tbody>
                    {found.clusters.map(c => (
                      <tr key={c.key}>
                        <td className={styles.td}><input type="checkbox" aria-label={`Unify ${c.members[0].name} in ${placeText(c)}`} checked={!!apply[c.key]} disabled={!!busy} onChange={(e) => setApply(p => ({ ...p, [c.key]: e.target.checked }))} /></td>
                        <td className={styles.td}>{c.area || '(no area)'}{!c.identical && <div><span className={mergeClasses(styles.tag, styles.tagWarn)}>similar names</span></div>}
                          {!c.members.every(m => m.count) && <div><span className={mergeClasses(styles.tag, styles.tagBad)} title="Find again to count them">some records not counted</span></div>}</td>
                        <td className={styles.td}>
                          {c.members.map(m => (
                            <div key={m.id} style={{ padding: '2px 0' }}>
                              {m.id !== keep[c.key] && (
                                <input type="checkbox" style={{ marginRight: 6 }} aria-label={`Move ${m.name} …${shortId(m.id)}`} checked={!isSkipped(c, m)} disabled={!!busy}
                                  onChange={(e) => setSkip(p => ({ ...p, [`${c.key}|${m.id}`]: !e.target.checked }))} />
                              )}
                              <strong>{m.name}</strong> <span className={styles.hint}>{m.area !== c.area ? `· ${m.area || '(no area)'} ` : ''}· ID …{shortId(m.id)} · {m.count ? `${m.count.n}${m.count.more ? '+' : ''} ${m.count.n === 1 && !m.count.more ? 'entry' : 'entries'}` : 'entries not counted'}{newestText(m) ? ` · ${newestText(m)}` : ''}{stampText(m.added) ? ` · record added ${stampText(m.added).slice(0, 10)}` : ''}{m.links.length ? ` · ${plural(m.links.length, 'SAP row', 'SAP rows')}` : ''}</span>
                              {m === c.members[0] && newestText(m) && c.members.every(x => x.count) && <span className={mergeClasses(styles.tag, styles.tagOk)} style={{ marginLeft: 6 }}>newest</span>}
                            </div>
                          ))}
                        </td>
                        <td className={styles.td} style={{ minWidth: 240 }}>
                          <Select aria-label={`Record to keep for ${c.members[0].name}`} value={keep[c.key] || ''} disabled={!!busy} onChange={(e, d) => { setKeep(p => ({ ...p, [c.key]: d.value })); setSkip(p => { const x = {}; Object.keys(p).forEach(k => { if (!k.startsWith(`${c.key}|`)) x[k] = p[k]; }); return { ...x, ...skipFor(c, d.value) }; }); }}>
                            {c.members.map(m => <option key={m.id} value={m.id}>{m.name} · …{shortId(m.id)} · {!m.count ? 'entries not counted' : !m.count.n ? 'no entries' : newestText(m) || plural(m.count.n, 'entry', 'entries')}</option>)}
                          </Select>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </>
      )}
    </div>
  );
};

