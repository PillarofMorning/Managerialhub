    if (photo && savedIds.length) {
      const isPdf = photoMime === 'application/pdf';
      const fileName = `paperwork-${normalizedCode}-${dateStr}.${isPdf ? 'pdf' : 'jpg'}`.replace(/[^A-Za-z0-9._-]/g, '_');
      const what = isPdf ? 'paperwork PDF' : 'paperwork picture';
      const pr = await pool(savedIds, 3, (id) => api.uploadFile(LOG_TABLE, id, PAPERWORK_COL, photo, fileName, isPdf ? 'application/pdf' : 'image/jpeg'));
      const bad = pr.filter(r => !r.ok);
      if (bad.length) notes.push(`Entries saved, but the ${what} was not attached to ${bad.length === pr.length ? (pr.length === 1 ? 'it' : 'them') : plural(bad.length, 'of them', 'of them')} (${errText(bad[0].error)}). To add it, delete the entries whose Paperwork shows "none" in the Log Table and submit them again.`);
      else info.push(`${isPdf ? 'Paperwork PDF' : 'Paperwork picture'} attached to ${plural(pr.length, 'entry', 'entries')}.`);
    }
    store.dropOrders();
    if (failedNames.length) {
      const first = results.find(r => !r.ok);
      return { saved: savedIds.length, notes, info, error: `${savedIds.length} of ${results.length} saved. Not saved: ${failedNames.join(', ')} (${errText(first.error)}). Submit again; saved equipment is skipped as already logged.` };
    }
    return { saved: savedIds.length, notes, info };
  };

  // freeze: a sheet still being read must not change this row once Submit has started on any row
  const freeze = () => { readSeq.current += 1; setSheet(s => (s.status === 'reading' || s.status === 'loading' ? { ...s, status: 'stopped' } : s)); };
  useImperativeHandle(ref, () => ({ validate, commit, freeze, getShared: () => ({ date: dateStr, initials: normalizeInitials(initials) }) }));

  // Summary values for the read-only Room / Area / Equipment fields
  const live = lines.filter(l => !excluded[l.key]);
  const summarize = (k) => { const v = Array.from(new Set(live.map(l => l[k]).filter(Boolean))); return v.length === 0 ? '' : v.length === 1 ? v[0] : `Multiple (${v.length})`; };
  const roomList = `mss-rooms-${index}`;
  const areaList = `mss-areas-${index}`;
  const addShown = addOpen === null ? isUnknown : addOpen;
  const needCount = live.filter(l => !l.asset).length;
  const dupeCount = live.filter(l => isDupe(l)).length;
  const listedAgain = matches.filter(e => !lines.some(l => (l.parent || l.key) === e.key)).length;   // SAP rows that are the same equipment as another row
  const fromSheet = (kind, now) => (stamp[kind] !== undefined && stamp[kind] === now ? <span className={mergeClasses(styles.tag, styles.tagInfo)} style={{ marginLeft: 6 }}>from the sheet</span> : null);
  const tagClass = (k) => mergeClasses(styles.tag, k === 'ok' ? styles.tagOk : k === 'warn' ? styles.tagWarn : k === 'bad' ? styles.tagBad : k === 'info' ? styles.tagInfo : undefined);

  const renderPanel = (l) => {
    const view = panel[l.key] || 'list';
    const cands = candidatesFor(l);
    const mr = moreRank[l.key];
    const rt = retro[l.key];
    const nf = newFor[l.key] || { name: l.ms.equipment, room: l.ms.room, area: l.ms.area };
    const setNf = (k, v) => setNewFor(p => ({ ...p, [l.key]: { ...nf, [k]: v } }));
    const where = placeText(l.ms);
    // Equipment that shares a name and place with another option is told apart by its ID
    const sig = (a) => `${canonName(a.name)}|${normName(a.room)}|${normName(a.area)}`;
    const sigCount = new Map();
    uniqueById([l.asset, l.auto, ...cands.map(c => c.asset)].filter(a => a && !a.isNew)).forEach(a => sigCount.set(sig(a), (sigCount.get(sig(a)) || 0) + 1));
    const idNote = (a) => (a && !a.isNew && sigCount.get(sig(a)) > 1 ? ` · ID …${shortId(a.id)}` : '');
    return (
      <div className={styles.changePanel}>
        <Text weight="semibold" block>Equipment for “{l.ms.equipment || '(unnamed)'}”{where ? ` in ${where}` : ''}</Text>
        {l.asset
          ? <Text className={styles.hint} block>Using {l.asset.name} · {placeText(l.asset)}{idNote(l.asset)}{l.asset.isNew ? ' (new asset, created on submit)' : ''}{chosen[l.key] && l.auto ? `. Was ${l.auto.name} · ${placeText(l.auto)}${idNote(l.auto)}.` : ''}</Text>
          : cands.length > 0 && cands.every(c => !!usedBy(c.asset.id, l.key))
            ? <Text className={styles.hint} block>The equipment that fits this line is already on other lines of this order (listed below). Search all equipment, or create a new asset.</Text>
            : <Text className={styles.hint} block>No equipment in this room and area matches well enough to pick automatically. Choose one below, search, or create a new asset.</Text>}
        {view === 'list' && (
          <div style={{ marginTop: 6 }}>
            {cands.length > 0 ? (
              <div style={{ overflowX: 'auto' }}>
                <table className={styles.linesTable} style={{ marginTop: 0 }}>
                  <tbody>
                    {cands.map(c => (
                      <tr key={c.asset.id}>
                        <td className={styles.td}><strong>{c.asset.name}</strong>{idNote(c.asset) && <span className={styles.hint}>{idNote(c.asset)}</span>}{usedBy(c.asset.id, l.key) && <span className={styles.hint}> · {usedBy(c.asset.id, l.key)}</span>}</td>
                        <td className={styles.td}>{c.asset.room}</td>
                        <td className={styles.td}>{c.asset.area}</td>
                        <td className={styles.td}><span className={tagClass(c.score >= 0.95 ? 'ok' : c.score >= 0.6 ? 'warn' : 'bad')}>{TIER_LABEL[tierOf(c.score)]} · {reasonText(c)}</span></td>
                        <td className={styles.td} style={{ textAlign: 'right' }}>
                          <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving || !!usedBy(c.asset.id, l.key)} aria-label={`Use ${c.asset.name} (${placeText(c.asset)})${idNote(c.asset)}`} onClick={() => choose(l, c.asset)}>Use</Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : <Text className={styles.hint} block>{mr && mr.busy ? 'Looking for similar equipment…' : mr ? 'No other close matches.' : 'No other close matches yet.'}</Text>}
            {!mr && <Button size="small" style={{ marginTop: 6 }} onClick={() => rankMore(l)}>Look for similar names</Button>}
            {mr && mr.error && <Text className={styles.errorText} block role="alert">Could not look for similar equipment: {mr.error}</Text>}
          </div>
        )}
        {view === 'search' && (
          <div style={{ marginTop: 6 }}>
            <AssetPicker store={store} idTails initialQuery={l.ms.equipment} ariaLabel={`Search equipment for ${l.ms.equipment}`} actionLabel="Use" inUse={(a) => usedBy(a.id, l.key)} disabled={saving}
              onPick={(a) => { choose(l, a); setView(l, 'list'); }} />
          </div>
        )}
        {view === 'new' && (
          <div className={styles.rowFields} style={{ alignItems: 'flex-end', marginTop: 6 }}>
            <div className={styles.field}><Text className={styles.label}>Equipment name</Text><Input aria-label="New asset name" value={nf.name} onChange={(e, d) => setNf('name', d.value)} /></div>
            <div className={styles.field}><Text className={styles.label}>Room</Text><Input aria-label="New asset room" list={roomList} value={nf.room} onChange={(e, d) => { setNf('room', d.value); setTyping(t => ({ ...t, room: d.value })); }} /></div>
            <div className={styles.field}><Text className={styles.label}>Area</Text><Input aria-label="New asset area" list={areaList} value={nf.area} onChange={(e, d) => { setNf('area', d.value); setTyping(t => ({ ...t, area: d.value, roomCtx: safeString(nf.room) })); }} /></div>
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} onClick={() => useNewAsset(l)}>Use new asset</Button>
          </div>
        )}
        <div className={styles.actionBar} style={{ marginTop: 8, marginBottom: 0 }}>
          {view !== 'list' && <Button size="small" onClick={() => setView(l, 'list')}>Best fits</Button>}
          {view !== 'search' && <Button size="small" onClick={() => setView(l, 'search')}>Search all equipment</Button>}
          {view !== 'new' && <Button size="small" onClick={() => setView(l, 'new')}>Create new asset</Button>}
          <Button size="small" disabled={saving} aria-label={`Break up into pieces: ${l.ms.equipment || 'this line'}`} data-break-up={l.key} onClick={() => startBreakUp(l)}>Break up into pieces</Button>
          {chosen[l.key] && <Button size="small" disabled={saving} onClick={() => undoChoice(l)}>Undo change</Button>}
          {l.asset && <Button size="small" appearance="subtle" onClick={() => closePanel(l)}>Done</Button>}
        </div>
        {rt && (
          <div aria-live="polite" style={{ marginTop: 6 }}>
            {rt.status === 'scanning' && <Text className={styles.hint} block>Checking earlier entries of {normalizedCode}…</Text>}
            {rt.status === 'error' && <Text className={styles.errorText} block>Could not check earlier entries: {rt.error}</Text>}
            {rt.status === 'ready' && rt.count > 0 && (
              <Checkbox checked={!!rt.apply} disabled={saving} onChange={(e, d) => setRetro(p => ({ ...p, [l.key]: { ...p[l.key], apply: !!d.checked } }))}
                label={`On submit, also move ${rt.count}${rt.more ? '+' : ''} earlier ${rt.count === 1 && !rt.more ? 'entry' : 'entries'} for this line${rt.from && !rt.stillUsed ? ` (saved to ${rt.from.name} · ${placeText(rt.from)}, or with no equipment ID)` : ' (saved with no equipment ID)'} to ${l.asset ? l.asset.name : 'the chosen equipment'}.`} />
            )}
            {rt.status === 'ready' && rt.skipped > 0 && (
              <Text className={styles.hint} block>
                {plural(rt.skipped, 'earlier entry stays', 'earlier entries stay')} where {rt.skipped === 1 ? 'it is' : 'they are'}: {l.asset ? l.asset.name : 'the chosen equipment'} already has an entry for that order on the same day.
                {rt.count > 0 ? ' This order looks logged piece by piece, so the box above is not ticked: tick it only if those entries really belong to this equipment.' : ''}
              </Text>
            )}
            {rt.status === 'ready' && !rt.count && <Text className={styles.hint} block>No earlier entries need correcting.</Text>}
          </div>
        )}
      </div>
    );
  };

  // The pieces of a SAP row being broken up: a hint, the pieces so far, and a search to add more
  const renderSplit = (key) => {
    const e = matches.find(x => x.key === key);
    if (!e) return null;
    const ms = { equipment: e.equipment, room: e.room, area: e.area };
    const list = pieces[key] || [];
    const taken = takenFor(key);
    const hint = hints[key];
    const found = hint && hint.status === 'ready' ? hint.found : null;
    const unused = found ? found.assets.filter(a => !list.some(x => x.id === a.id)) : [];   // suggested, not among the pieces yet
    const onOther = unused.filter(a => taken.has(a.id));                                      // ...and used by another line
    const where = placeText(ms);
    const seen = wrapRef.current ? wrapRef.current.clientWidth : 0;                          // the box stays at the left edge, so it must fit the visible width
    const boxW = seen ? Math.max(260, Math.min(640, seen - 24)) : 640;
    return (
      <div className={styles.changePanel} style={{ position: 'sticky', left: 0, width: boxW, boxSizing: 'border-box' }} data-split={key} tabIndex={-1} role="group" aria-label={`Pieces of ${ms.equipment || 'this line'}`}>
        <Text weight="semibold" block>Break up “{ms.equipment || '(unnamed)'}”{where ? ` in ${where}` : ''} into pieces</Text>
        <Text className={styles.hint} block>Each piece gets its own entry with the same date, SAP order and initials, saved to that equipment. The hours of this line are shared out among its pieces. Nothing is saved until you submit.</Text>
        <div aria-live="polite">
          {hint && hint.status === 'busy' && <Text className={styles.hint} block>Looking for the pieces…</Text>}
          {hint && hint.status === 'error' && list.length < 2 && <Text className={styles.errorText} block role="alert">Could not look for the pieces: {hint.error}. Search below to add them.</Text>}
          {hint && hint.status === 'ready' && !found && list.length === 0 && <Text className={styles.hint} block>No pieces were found for this line. Search below to add them.</Text>}
          {unused.length > 0 && (
            <div className={styles.hint} style={{ marginTop: 4 }}>
              {found.how === 'text' ? 'This line lists several things. Found: ' : 'Equipment here that starts with this name: '}<strong>{found.assets.map(a => a.name).join(', ')}</strong>.
              {onOther.length > 0 && ` ${onOther.map(a => a.name).join(', ')} ${onOther.length === 1 ? 'is' : 'are'} already on another line of this order.`}
              {' '}
              {unused.length > onOther.length && <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} aria-label={`Use these pieces for ${ms.equipment || 'this line'}`} onClick={() => addFound(key, found)}>Use these pieces</Button>}
            </div>
          )}
        </div>
        <div style={{ marginTop: 6 }}>
          <PiecesEditor store={store} g={ms} list={list} missing={found ? found.missing : []} taken={taken} whyUsed={(a) => usedBy(a.id, null)} disabled={saving}
            onChange={(next) => setPiecesFor(key, next)} onDone={() => { focusTo.current = `[data-edit-pieces="${key}"]`; closeSplit(key); }} />
        </div>
      </div>
    );
  };

  return (
    <div className={styles.rowCard}>
      <div className={styles.rowFields}>
        <div className={styles.field}>
          <Text className={styles.label}>SAP Order (Req){fromSheet('code', normalizedCode)}</Text>
          <Input
            data-row={index}
            data-col="sap"
            aria-label="SAP order"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded={listOpen}
            aria-controls={listOpen ? listId : undefined}
            aria-activedescendant={listOpen ? `${listId}-opt-${hiIndex}` : undefined}
            autoComplete="off"
            placeholder="Start typing the SAP order…"
            value={code}
            disabled={saving}
            style={{ minWidth: '210px' }}
            onChange={(e, d) => { setCode(d.value); setShowSuggest(true); setHi(0); clearOrderState(); }}
            onFocus={() => setShowSuggest(true)}
            onBlur={() => setTimeout(() => setShowSuggest(false), 150)}
            onKeyDown={(e) => {
              if (e.key === 'ArrowDown' && !showSuggest) { e.preventDefault(); setShowSuggest(true); }
              else if (listOpen && e.key === 'ArrowDown') { e.preventDefault(); setHi(h => Math.min(h + 1, suggestions.length - 1)); }
              else if (listOpen && e.key === 'ArrowUp') { e.preventDefault(); setHi(h => Math.max(h - 1, 0)); }
              else if (e.key === 'Enter' && suggestOpen && sugg.busy) e.preventDefault(); // wait for the search to finish
              else if (listOpen && e.key === 'Enter') { e.preventDefault(); selectCode(suggestions[hiIndex].code); }
              else if (e.key === 'Escape') setShowSuggest(false);
              else if (e.key === 'Enter') { e.preventDefault(); setShowSuggest(false); onEnter(index); }
            }}
          />
          {suggestOpen && (
            <div className={styles.suggest}>
              {suggestions.length > 0 && (
                <div className={styles.suggestList} role="listbox" id={listId} aria-label="Matching SAP orders" ref={listRef}>
                  {suggestions.map((s, i) => (
                    <button key={s.code} id={`${listId}-opt-${i}`} type="button" role="option" tabIndex={-1} aria-selected={i === hiIndex} className={styles.suggestItem}
                      style={i === hiIndex ? { backgroundColor: '#E6F1FC' } : undefined}
                      onMouseDown={(e) => e.preventDefault()} onClick={() => selectCode(s.code)}>
                      <span><strong>{s.code}</strong>{s.names && <span className={styles.hint}> · {s.names}{s.count > 2 ? '…' : ''}</span>}</span>
                      <span className={styles.hint}>{s.count}{sugg.truncated ? '+' : ''} equipment</span>
                    </button>
                  ))}
                </div>
              )}
              <div aria-live="polite">
                {sugg.busy && <div className={styles.suggestNote}>Searching…</div>}
                {sugg.error && <div className={styles.suggestNote} style={{ color: BRAND.redText }}>Search failed: {sugg.error}</div>}
                {!sugg.busy && !sugg.error && suggestions.length === 0 && <div className={styles.suggestNote}>No SAP orders match “{normalizedCode}”.</div>}
                {!sugg.busy && sugg.truncated && <div className={styles.suggestNote}>Many matches. Keep typing to narrow the list.</div>}
              </div>
            </div>
          )}
          {matches.length > 0 && lines.length > 0 && (
            <Checkbox label={<Text size={200}>Edit pre-filled details</Text>} checked={editMode} disabled={saving} onChange={(e, d) => startEdit(!!d.checked)} />
          )}
        </div>

        <div className={styles.field}>
          <Text className={styles.label}>Room</Text>
          <Input aria-label="Room" className={styles.readOnly} value={summarize('room')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Area</Text>
          <Input aria-label="Area" className={styles.readOnly} value={summarize('area')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Equipment</Text>
          <Input aria-label="Equipment" className={styles.readOnly} value={live.length > 1 ? `${live.length} equipment` : summarize('name')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Date (Req){fromSheet('date', dateStr)}</Text>
          <Input aria-label="Date completed" type="date" value={dateStr} min={minDate} max={maxDate} disabled={saving} onChange={(e, d) => { dateTouched.current = true; setDateStr(d.value); }} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Total Hours (Req){fromSheet('hours', parseFloat(totalHours))}</Text>
          <Input aria-label="Total hours" type="number" min="0" step="0.25" placeholder="Ex: 2.5" value={totalHours} disabled={saving} onChange={(e, d) => setTotalHours(d.value)} style={{ width: '100px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Initials (Req){fromSheet('initials', normalizeInitials(initials))}</Text>
          <Input aria-label="Initials" placeholder="Ex: EL/LH" value={initials} disabled={saving} onChange={(e, d) => setInitials(d.value)}
            onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); onEnter(index); } }} style={{ minWidth: '90px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Paperwork Picture or PDF</Text>
          <input type="file" multiple accept="image/*,.heic,.heif,.pdf,application/pdf" aria-label="Paperwork picture" disabled={saving}
            onChange={(e) => { const fs = Array.from(e.target.files || []); e.target.value = ''; setPaper(fs); }} style={{ minWidth: '150px', padding: '4px' }} />
          {photoName && <span className={styles.hint}>{paperFiles.length > 1 ? `${paperFiles.length} files${photoPages ? `, ${plural(photoPages, 'page', 'pages')}` : ''}` : photoName}{photoBusy ? (paperFiles.length === 1 && !isPdfFile(paperFiles[0]) ? ' (converting to a JPG…)' : ' (preparing the pages…)') : ''}</span>}
          {paperFiles.length > 1 && (
            <div className={styles.filePills}>
              {paperFiles.map((f, i) => (
                <span key={`${f.name}|${i}`} className={styles.filePill} title={f.name}>
                  <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{i + 1}. {f.name}</span>
                  <Button size="small" appearance="subtle" aria-label={`Remove ${f.name}`} disabled={saving} onClick={() => removePaper(i)} style={{ minWidth: 0, padding: '0 4px' }}>×</Button>
                </span>
              ))}
            </div>
          )}
          {photoNote && <Text className={styles.warnText} block role="status" style={{ marginTop: 2 }}>{photoNote}</Text>}
          {paperFiles.length > 0 && (
            <div className={styles.sheetRow} style={{ marginTop: 2 }}>
              <label className={styles.hint} style={{ cursor: saving ? 'default' : 'pointer' }}>Add more pages: <input type="file" multiple accept="image/*,.heic,.heif,.pdf,application/pdf" aria-label="Add more paperwork pages" disabled={saving || photoBusy}
                onChange={(e) => { const fs = Array.from(e.target.files || []); e.target.value = ''; if (fs.length) addPaper(fs); }} style={{ maxWidth: '170px' }} /></label>
              {photo && <Button size="small" appearance="subtle" onClick={() => setPreviewOpen(true)}>Preview</Button>}
              {photo && sheet.status === 'idle' && <Button size="small" appearance="subtle" disabled={saving || photoBusy} onClick={() => startReading(paperFiles)}>Read the sheet</Button>}
              <Checkbox label={<Text size={200}>Read the sheet when it is added</Text>} checked={sheetAuto} disabled={saving} onChange={(e, d) => changeSheetAuto(!!d.checked)} />
            </div>
          )}
        </div>
        <Button appearance="subtle" style={{ alignSelf: 'flex-start', marginTop: '16px' }} aria-label={`Remove row ${index + 1}`} disabled={!canRemove || saving} onClick={onRemove}>Remove</Button>
      </div>

      {paperFiles.length > 0 && sheet.status !== 'idle' && !sheetHidden && (
        <SheetPanel sheet={sheet} disabled={saving}
          values={{ code: normalizedCode, date: dateStr, hours: parseFloat(totalHours), initials: normalizeInitials(initials) }}
          onPick={pickFromSheet} onStop={stopReading} onRead={() => startReading(paperFiles)} onHide={() => setSheetHidden(true)} />
      )}
      {previewOpen && previewLocal && (
        <PaperworkViewer api={api} entry={previewEntry} local={previewLocal} onClose={() => setPreviewOpen(false)} />
      )}
      {order && order.status === 'loading' && order.code === normalizedCode && (
        <Text className={styles.hint} block style={{ marginTop: 8 }}>Loading {normalizedCode} and finding its equipment…</Text>
      )}
      {order && order.status === 'error' && order.code === normalizedCode && (
        <Text className={styles.errorText} block role="alert">Could not load {normalizedCode}: {order.error}</Text>
      )}
      {isUnknown && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          {normalizedCode} is not in the SAP orders. Add the equipment it covers below and it will be saved against that equipment.
        </Text>
      )}
      {ready && order.capped && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          This order lists more than {LIMITS.orderRows} equipment. Only the first {LIMITS.orderRows} are shown.
        </Text>
      )}

      {lines.length > 0 && (
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginTop: '10px', flexWrap: 'wrap' }}>
          <Button size="small" appearance="secondary" aria-expanded={linesOpen} onClick={() => setLinesOpen(o => !o)}>
            {linesOpen ? `Hide equipment list (${lines.length})` : `Show equipment list (${lines.length})`}
          </Button>
          <Text className={styles.hint}>
            {live.length} included{needCount ? ` · ${needCount} need equipment` : ''}{dupeCount ? ` · ${dupeCount} already logged` : ''}{listedAgain ? ` · ${plural(listedAgain, 'more SAP row is', 'more SAP rows are')} the same equipment as another line` : ''}
          </Text>
        </div>
      )}
      {lines.length > 0 && linesOpen && (
        <div className={styles.linesScroll} ref={wrapRef}>
          <table className={styles.linesTable} style={{ marginTop: 0 }}>
            <thead><tr>
              {['Include', 'Equipment', 'Room', 'Area', 'Frequency', 'Hours', 'Status'].map((h, i) => (
                <th key={h} className={mergeClasses(styles.th, styles.stickyTh)}>{i === 0 ? <span style={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)', whiteSpace: 'nowrap' }}>{h}</span> : h}</th>
              ))}
            </tr></thead>
            <tbody>
              {lines.reduce((rows, l, li) => {
                const off = !!excluded[l.key];
                const dupe = isDupe(l);
                const editing = editMode && edits[l.key] && l.asset && !l.asset.isNew && edits[l.key].id === l.asset.id;
                const split = !!(l.parent || l.splitting);                // a line of a SAP row that is broken up
                const open = !split && !off && !l.extra && !!l.ms && (!!panel[l.key] || !l.asset);
                // The pieces editor sits under the last piece of the SAP row (or under the line itself while it has fewer than two)
                const lastPiece = !!l.parent && !(lines[li + 1] && lines[li + 1].parent === l.parent);
