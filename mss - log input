// --- HELPERS ---
const safeString = (v) => (v === null || v === undefined ? '' : String(v).trim());
const normCode = (s) => safeString(s).toUpperCase().replace(/\s+/g, '');
const normName = (s) => safeString(s).toLowerCase().replace(/[^a-z0-9]/g, '');
const sameText = (a, b) => normName(a) === normName(b);
const escOData = (s) => String(s).replace(/'/g, "''");
const errText = (e) => (e && (e.message || (e.raw && e.raw.message) || (e.error && e.error.message))) || 'Unknown error';
const GUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const cleanGuid = (s) => safeString(s).replace(/[{}]/g, '').toLowerCase();
const isGuid = (s) => GUID_RE.test(cleanGuid(s));
const shortId = (id) => cleanGuid(id).slice(-6);

// Text filters ask for the usual casings, so "floors" finds "Floors" even where the data source compares text case-sensitively.
const caseVariants = (s) => {
  const t = safeString(s);
  const lower = t.toLowerCase();
  const title = lower.replace(/(^|[^a-z0-9])([a-z])/g, (m, p, c) => p + c.toUpperCase());
  return Array.from(new Set([t, lower, t.toUpperCase(), lower.charAt(0).toUpperCase() + lower.slice(1), title]));
};
const ciEq = (col, s) => `(${caseVariants(s).map(v => `${col} eq '${escOData(v)}'`).join(' or ')})`;
const ciContains = (col, s) => `(${caseVariants(s).map(v => `contains(${col},'${escOData(v)}')`).join(' or ')})`;
const ciStarts = (col, s) => `(${caseVariants(s).map(v => `startswith(${col},'${escOData(v)}')`).join(' or ')})`;
// craa5_equipmentguid is a text column: match the id written in lower or upper case
const guidEq = (col, id) => `(${Array.from(new Set([cleanGuid(id), cleanGuid(id).toUpperCase()])).map(v => `${col} eq '${v}'`).join(' or ')})`;
const BLANK_GUID = `(craa5_equipmentguid eq null or craa5_equipmentguid eq '')`;
const guidNe = (col, id) => Array.from(new Set([cleanGuid(id), cleanGuid(id).toUpperCase()])).map(v => `${col} ne '${v}'`).join(' and ');

const toDateInput = (d) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
};
// Log dates are date-only values stored as midnight UTC. Read them as that calendar day, never shifted by time zone.
const dayKey = (v) => {
  const s = safeString(v);
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
  const d = new Date(s);
  return Number.isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
};
const toLogDate = (dateStr) => `${dateStr}T00:00:00Z`;
const nextDay = (dateStr) => {
  const d = new Date(`${dateStr}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + 1);
  return d.toISOString().slice(0, 10);
};
const daysAgo = (n) => toDateInput(new Date(Date.now() - n * 86400000));
const yearBefore = (dateStr) => { const d = new Date(`${dateStr}T12:00:00`); d.setFullYear(d.getFullYear() - 1); return toDateInput(d); };

const normalizeInitials = (s) =>
  safeString(s).toUpperCase().replace(/[\s,&+]+/g, '/').replace(/\/+/g, '/').replace(/^\/|\/$/g, '');
const INITIALS_RE = /^[A-Z]{1,4}(\/[A-Z]{1,4})*$/;
// Submit problems that are about the equipment lines (the list is opened so they can be seen)
const LINE_PROBLEM = /highlighted line|equipment line|Two lines|needs hours|Line hours add up/;

// Hours shared out in whole hours (Gerald, Oct 9): every share is a whole number, and the decimals carry from one share to the next;
// once they make a whole hour, the share they reach gets it (8 over 3 shares: 2, 3, 3; 3 over 7 shares: 0, 0, 1, 0, 1, 0, 1). The
// decimals a total has itself (8.5) cannot be carried anywhere, so the last share keeps them and the shares always add up to the total.
const splitHours = (total, n) => {
  if (!n || !(total > 0)) return [];
  const cents = Math.round(total * 100);
  const whole = Math.floor(cents / 100);
  const out = [];
  let given = 0;
  for (let i = 1; i <= n; i++) {
    const upto = Math.floor((whole * i) / n);
    out.push(upto - given);
    given = upto;
  }
  out[n - 1] = (out[n - 1] * 100 + (cents - whole * 100)) / 100;
  return out;
};
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

// Run fn over items with a small concurrency limit; never rejects, returns [{ok, value|error}].
const pool = async (items, limit, fn) => {
  const out = new Array(items.length);
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      try { out[i] = { ok: true, value: await fn(items[i], i) }; } catch (e) { out[i] = { ok: false, error: e }; }
    }
  };
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
  return out;
};
const chunked = (list, size) => {
  const out = [];
  for (let i = 0; i < list.length; i += size) out.push(list.slice(i, i + size));
  return out;
};
const uniqueById = (list) => Array.from(new Map(list.map(a => [a.id, a])).values());
