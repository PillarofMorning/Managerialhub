  const wordIndex = new Map();      // word stem -> Set<assetId>
  const canonIndex = new Map();     // canonical name -> asset[]
  const roomIndex = new Map();      // roomKey -> asset[]
  const uniqueIdIndex = new Map();  // maintenance asset id (normCode) -> asset[]
  const assetSapIndex = new Map();  // sapCode (normCode) -> [{ asset, col }]

  // One shared promise per key, so repeat and simultaneous requests cost one query; a failure is forgotten so it can be retried.
  const once = (map, key, fn) => {
    if (!map.has(key)) map.set(key, fn().catch((e) => { map.delete(key); throw e; }));
    return map.get(key);
  };

  const allFreqCols = FREQUENCIES.map(f => f.col);

  const enrichAsset = (raw) => {
    const id = cleanGuid(raw.id || raw.craa5_aa_assetsid || raw.craa5_0_assetsid);
    const name = safeString(
      raw.name !== undefined ? raw.name
        : raw.craa5_equipmentidentifier !== undefined ? raw.craa5_equipmentidentifier
        : raw.craa5_equipment !== undefined ? raw.craa5_equipment
        : raw.craa5_name !== undefined ? raw.craa5_name
        : raw.craa5_title
    );
    const room = safeString(
      raw.room !== undefined ? raw.room
        : raw.craa5_roomname !== undefined ? raw.craa5_roomname
        : raw.craa5_textroom !== undefined ? raw.craa5_textroom
        : raw.craa5_room !== undefined ? raw.craa5_room
        : raw.craa5_department
    );
    const area = safeString(
      raw.area !== undefined ? raw.area
        : raw.craa5_areaname !== undefined ? raw.craa5_areaname
        : raw.craa5_textarea !== undefined ? raw.craa5_textarea
        : raw.craa5_area !== undefined ? raw.craa5_area
        : raw.craa5_subcategory
    );
    const uniqueId = safeString(
      raw.uniqueId !== undefined ? raw.uniqueId
        : raw.craa5_uniqueid !== undefined ? raw.craa5_uniqueid
        : raw.craa5_olduid !== undefined ? raw.craa5_olduid
        : raw.craa5_assetid
    );
    const sapCodes = Array.isArray(raw.sapCodes)
      ? raw.sapCodes
      : allFreqCols.map(col => ({ col, code: normCode(raw[col]) })).filter(x => x.code);
    const _profile = nameProfile(name);
    const _canon = _profile.full;
    const _roomKey = placeKey(room);
    const _areaKey = placeKey(area);
    return { id, name, room, area, uniqueId, sapCodes, _profile, _canon, _roomKey, _areaKey };
  };

  const indexAsset = (a) => {
    if (!a || !a.id) return a;
    const prev = assets.get(a.id);
    if (prev && Array.isArray(prev.sapCodes) && prev.sapCodes.length) {
      const mergedCodes = Array.isArray(a.sapCodes) ? a.sapCodes.slice() : [];
      prev.sapCodes.forEach(sc => {
        if (sc && sc.code && !mergedCodes.some(x => x.code === sc.code && x.col === sc.col)) {
          mergedCodes.push(sc);
        }
      });
      a.sapCodes = mergedCodes;
    }
    assets.set(a.id, a);
    gone.delete(a.id);
    if (a._canon) {
      if (!canonIndex.has(a._canon)) canonIndex.set(a._canon, []);
      const list = canonIndex.get(a._canon);
      const idx = list.findIndex(x => x.id === a.id);
      if (idx >= 0) list[idx] = a; else list.push(a);
    }
    if (a._roomKey) {
      if (!roomIndex.has(a._roomKey)) roomIndex.set(a._roomKey, []);
      const rlist = roomIndex.get(a._roomKey);
      const ridx = rlist.findIndex(x => x.id === a.id);
      if (ridx >= 0) rlist[ridx] = a; else rlist.push(a);
    }
    if (a.uniqueId) {
      const uk = normCode(a.uniqueId);
      if (uk) {
        if (!uniqueIdIndex.has(uk)) uniqueIdIndex.set(uk, []);
        const ulist = uniqueIdIndex.get(uk);
        const uidx = ulist.findIndex(x => x.id === a.id);
        if (uidx >= 0) ulist[uidx] = a; else ulist.push(a);
      }
    }
    if (Array.isArray(a.sapCodes)) {
      a.sapCodes.forEach(sc => {
        if (!sc || !sc.code) return;
        if (!assetSapIndex.has(sc.code)) assetSapIndex.set(sc.code, []);
        const slist = assetSapIndex.get(sc.code);
        const sidx = slist.findIndex(x => x.asset.id === a.id && x.col === sc.col);
        if (sidx >= 0) slist[sidx] = { asset: a, col: sc.col };
        else slist.push({ asset: a, col: sc.col });
      });
    }
    const stems = a._profile ? a._profile.words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).concat(a._profile.numList) : [];
    stems.forEach(w => {
      if (!w) return;
      if (!wordIndex.has(w)) wordIndex.set(w, new Set());
      wordIndex.get(w).add(a.id);
    });
    return a;
  };

  // Merge MS_TABLE (craa5_aa_ms_assets) SAP codes onto indexed assets so every asset knows its SAP orders even if stored only on MS_TABLE
  const mergeMsRowsIntoCatalog = (msRows) => {
    if (!Array.isArray(msRows) || !msRows.length) return;
    msCatalogCount = msRows.length;
    msRows.forEach(ms => {
      if (!ms) return;
      let target = ms.assetId ? assets.get(cleanGuid(ms.assetId)) : null;
      if (!target && ms.olduid) {
        const byUid = uniqueIdIndex.get(normCode(ms.olduid)) || [];
        if (byUid.length === 1) target = byUid[0];
        else if (byUid.length > 1) {
          target = byUid.find(a => samePlace(a.room, ms.room) && samePlace(a.area, ms.area)) || byUid[0];
        }
      }
      if (!target && ms.equipment) {
        const cName = canonName(ms.equipment);
        const byName = canonIndex.get(cName) || [];
        if (byName.length === 1) target = byName[0];
        else if (byName.length > 1) {
          target = byName.find(a => samePlace(a.room, ms.room) && samePlace(a.area, ms.area))
            || byName.find(a => samePlace(a.room, ms.room))
            || null;
        }
      }
      if (target && Array.isArray(ms.codes) && ms.codes.length) {
        const nextCodes = Array.isArray(target.sapCodes) ? target.sapCodes.slice() : [];
        let changed = false;
        ms.codes.forEach(c => {
          if (!c || !c.code || c.col === 'craa5_olduid') return;
          if (!nextCodes.some(x => x.code === c.code && x.col === c.col)) {
            nextCodes.push({ col: c.col, code: c.code });
            changed = true;
          }
        });
        if (changed) {
          target.sapCodes = nextCodes;
          indexAsset(target);
        }
      }
    });
  };

  const rebuildIndexes = (list, complete) => {
    assets.clear();
    wordIndex.clear();
    canonIndex.clear();
    roomIndex.clear();
    uniqueIdIndex.clear();
    assetSapIndex.clear();
    gone.clear();
    list.forEach(raw => indexAsset(enrichAsset(raw)));
    catalogReady = true;
    catalogComplete = !!complete;
    catalogLoadedAt = Date.now();
  };

  const saveCatalogSession = () => {
    try {
      const compact = Array.from(assets.values()).map(a => ({
        id: a.id, name: a.name, room: a.room, area: a.area,
        ...(a.uniqueId ? { uniqueId: a.uniqueId } : {}),
        ...(a.sapCodes && a.sapCodes.length ? { sapCodes: a.sapCodes } : {}),
      }));
      sessionStorage.setItem(CATALOG_STORAGE_KEY, JSON.stringify({ ts: Date.now(), complete: catalogComplete, msCount: msCatalogCount, items: compact, assets: compact }));
    } catch (_) {}
  };

  const tryWarmFromSession = () => {
    if (catalogReady) return true;
    try {
      const raw = sessionStorage.getItem(CATALOG_STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        const list = parsed && (parsed.items || parsed.assets);
        if (parsed && parsed.complete === true && Array.isArray(list) && list.length > 0 && (Date.now() - (parsed.ts || 0) < CATALOG_TTL_MS)) {
          msCatalogCount = Number(parsed.msCount) || 0;
          rebuildIndexes(list, parsed.complete);
          return true;
        }
      }
    } catch (_) {}
    return false;
  };

  const getAssetSelectForMode = (m) => (
    m === 'full' ? ASSET_FULL_SAP_SELECT
      : m === 'ext' ? ASSET_EXT_SELECT
      : m === 'base' ? ASSET_SELECT
      : undefined
  );

  const pageAssetsWithFallback = async (top) => {
    const modes = assetSelectMode === 'unscoped' ? ['unscoped']
      : assetSelectMode === 'base' ? ['base', 'unscoped']
      : assetSelectMode === 'ext' ? ['ext', 'base', 'unscoped']
      : ['full', 'ext', 'base', 'unscoped'];
    let lastErr = null;
    for (const m of modes) {
      const sel = getAssetSelectForMode(m);
      try {
        const pg = await api.page(ASSET_TABLE, { select: sel, top });
        assetSelectMode = m;
        return pg;
      } catch (e) {
        lastErr = e;
        if (!MISSING_COLUMN.test(errText(e)) && m === 'unscoped') throw e;
      }
    }
    throw lastErr;
  };

  const ensureAssetCatalog = (force = false) => {
    if (!force && tryWarmFromSession()) return Promise.resolve(Array.from(assets.values()));
    if (catalogPromise && !force) return catalogPromise;
    catalogPromise = (async () => {
      try {
        catalogLastError = '';
        const all = [];
        let pg = await pageAssetsWithFallback(LIMITS.catalogPage || 500);
        let complete = true;
        const maxPages = LIMITS.catalogMaxPages || 50;
        for (let pageNum = 1; ; pageNum++) {
          (pg.rows || []).forEach(r => all.push(r));
          if (!pg.next) break;
          if (pageNum >= maxPages) { complete = false; break; }
          try {
            pg = await pg.next();
          } catch (pageErr) {
            // Keep all assets fetched on prior pages rather than discarding the entire catalog
            complete = false;
            catalogLastError = errText(pageErr);
            break;
          }
        }
        rebuildIndexes(all, complete);
        // Also cross-load MS_TABLE SAP rows in a resilient try/catch so SAP codes on MS_TABLE are indexed onto the catalog assets
        try {
          const msRows = await queryMs(undefined, 2500);
          mergeMsRowsIntoCatalog(msRows);
        } catch (_) { /* optional cross-index */ }
        saveCatalogSession();
        store.invalidateAssets();
        return Array.from(assets.values());
      } catch (e) {
        catalogLastError = errText(e);
        throw e;
      } finally {
        catalogPromise = null;
      }
    })();
    return catalogPromise;
  };

  const warmCatalogInBackground = () => {
    if (!tryWarmFromSession() && !catalogPromise) {
      setTimeout(() => { ensureAssetCatalog().catch(() => {}); }, 80);
    }
  };

  const toAsset = (r) => enrichAsset(r);
  const keep = (rows) => rows.map(r => indexAsset(toAsset(r)));
  const queryAssets = async (filter, top) => {
    const modes = assetSelectMode === 'unscoped' ? ['unscoped']
      : assetSelectMode === 'base' ? ['base', 'unscoped']
      : assetSelectMode === 'ext' ? ['ext', 'base', 'unscoped']
      : ['full', 'ext', 'base', 'unscoped'];
    let lastErr = null;
    for (const m of modes) {
      const sel = getAssetSelectForMode(m);
      try {
        const rows = await api.query(ASSET_TABLE, {
          select: sel,
          filter,
          top,
          orderBy: m === 'unscoped' ? undefined : 'craa5_equipmentidentifier',
        });
        assetSelectMode = m;
        return keep(rows);
      } catch (e) {
        lastErr = e;
        if (!MISSING_COLUMN.test(errText(e)) && m === 'unscoped') throw e;
      }
    }
    throw lastErr;
  };

  // Look up specific assets by id (only the ones not already cached), in small chunks.
  // When the full current assets pull is in memory, IDs not in the catalog are immediately known to be missing.
  const resolve = async (ids) => {
    const cleanIds = Array.from(new Set((ids || []).map(cleanGuid))).filter(isGuid);
    if (!cleanIds.length) return;
    tryWarmFromSession();
    if (!catalogReady && cleanIds.length >= 25) {
      try { await ensureAssetCatalog(); } catch (_) {}
    } else if (!catalogReady) {
      warmCatalogInBackground();
    }
    if (catalogReady && catalogComplete) {
      cleanIds.forEach(id => { if (!assets.has(id)) gone.add(id); });
      return;
    }
    const need = cleanIds.filter(id => !assets.has(id) && !gone.has(id));
    if (!need.length) return;
    const rs = await pool(chunked(need, LIMITS.idChunk), 3, async (c) => {
      const found = await queryAssets(c.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), c.length);
      const got = new Set(found.map(a => a.id));
      c.forEach(id => { if (!got.has(id)) gone.add(id); });
    });
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
  };

  const activeMsCodeCols = () => (msExtColsOk ? [...CODE_COLS, ...OPTIONAL_MS_SAP_COLS] : CODE_COLS);
  const msSelect = (withLookup, withExtCols = false) => [
    'craa5_aa_ms_assetsid', 'craa5_equipment', 'craa5_textroom', 'craa5_textarea',
    ...CODE_COLS,
    ...(withExtCols ? OPTIONAL_MS_SAP_COLS : []),
    ...(withLookup ? ['_craa5_asset_value'] : []),
  ];
  const toMs = (r) => {
    const olduid = safeString(r.craa5_olduid || r.craa5_uniqueid);
    let assetId = cleanGuid(r._craa5_asset_value || r.craa5_asset) || null;
    // If no direct GUID lookup is set, resolve via maintenance 'assets id' (craa5_olduid -> craa5_uniqueid) when matched in catalog
    if (!assetId && olduid) {
      const uk = normCode(olduid);
      const byUid = uniqueIdIndex.get(uk) || [];
      if (byUid.length === 1) assetId = byUid[0].id;
      else if (byUid.length > 1) {
        const samePlaceMatch = byUid.find(a => samePlace(a.room, r.craa5_textroom) && samePlace(a.area, r.craa5_textarea));
        if (samePlaceMatch) assetId = samePlaceMatch.id;
      }
    }
    const colsToRead = [...CODE_COLS, ...OPTIONAL_MS_SAP_COLS];
    return {
      id: r.craa5_aa_ms_assetsid,
      equipment: safeString(r.craa5_equipment || r.craa5_equipmentidentifier || r.craa5_name),
      room: safeString(r.craa5_textroom || r.craa5_roomname || r.craa5_room),
      area: safeString(r.craa5_textarea || r.craa5_areaname || r.craa5_area),
      olduid,
      title: safeString(r.craa5_title),
      assetId,
      codes: colsToRead.map(col => ({ col, code: normCode(r[col]) })).filter(c => c.code),
    };
  };
  // SAP rows. Probes optional lookup (_craa5_asset_value) and optional extended frequency columns (craa5_sapmidweek, craa5_sapbiweekly), with unscoped fallback.
  const queryMs = async (filter, top) => {
    const f = (withLookup, withExt) => (typeof filter === 'function' ? filter(withLookup, withExt) : filter);
    const tryExt = msExtColsOk !== false;
    if (lookup !== false) {
      if (tryExt) {
        try {
          const rows = await api.query(MS_TABLE, { select: msSelect(true, true), filter: f(true, true), top, orderBy: 'craa5_title' });
          lookup = true; msExtColsOk = true;
          return rows.map(toMs);
        } catch (e) {
          if (!MISSING_COLUMN.test(errText(e)) && !MISSING_LOOKUP.test(errText(e))) throw e;
        }
      }
      try {
        const rows = await api.query(MS_TABLE, { select: msSelect(true, false), filter: f(true, false), top, orderBy: 'craa5_title' });
        lookup = true; if (msExtColsOk === null) msExtColsOk = false;
        return rows.map(toMs);
      } catch (e) {
        if (lookup === true && !MISSING_COLUMN.test(errText(e)) && !MISSING_LOOKUP.test(errText(e))) throw e;
      }
    }
    if (tryExt) {
      try {
        const rows = await api.query(MS_TABLE, { select: msSelect(false, true), filter: f(false, true), top, orderBy: 'craa5_title' });
        lookup = false; msExtColsOk = true;
        return rows.map(toMs);
      } catch (e) {
        if (!MISSING_COLUMN.test(errText(e))) throw e;
        msExtColsOk = false;
      }
    }
    try {
      const rows = await api.query(MS_TABLE, { select: msSelect(false, false), filter: f(false, false), top, orderBy: 'craa5_title' });
      lookup = false;
      return rows.map(toMs);
    } catch (e) {
      if (!MISSING_COLUMN.test(errText(e))) throw e;
      const rows = await api.query(MS_TABLE, { select: undefined, filter: f(false, false), top });
      lookup = false;
      return rows.map(toMs);
    }
  };
  const codeFilter = (op, code, withExt = false) => {
    const cols = withExt ? [...CODE_COLS, ...OPTIONAL_MS_SAP_COLS] : CODE_COLS;
    return cols.map(c => (op === 'eq' ? ciEq(c, code) : ciContains(c, code))).join(' or ');
  };
  // Queries assets in MS_TABLE by SAP columns OR by equipment name / maintenance asset ID so searching pulls SAP orders from the asset SAP columns
  const searchMsFilter = (raw, key, withExt = false) => {
    const byCode = codeFilter('contains', key, withExt);
    const cleanRaw = safeString(raw).trim();
    if (cleanRaw.length >= 2) {
      return `(${byCode} or ${ciContains('craa5_equipment', cleanRaw)})`;
    }
    return byCode;
  };

  // Equipment with exactly these names (in these rooms when the SAP row names one), using in-memory catalog when ready
  const assetsByNames = async (wants) => {
    tryWarmFromSession();
    warmCatalogInBackground();
    if (catalogReady) {
      const out = new Map();
      wants.filter(w => w.equipment).forEach(w => {
        const k = canonName(w.equipment);
        if (!k) return;
        const matches = canonIndex.get(k) || [];
        if (matches.length) out.set(k, matches.slice());
      });
      return out;
    }
    const uniq = Array.from(new Map(wants.filter(w => w.equipment).map(w => [`${normName(w.equipment)}|${normName(w.room)}`, w])).values());
    const rs = await pool(chunked(uniq, LIMITS.nameChunk), 3, (c) => queryAssets(c.map(w => (normName(w.room)
      ? `(${ciEq('craa5_equipmentidentifier', w.equipment)} and ${ciEq('craa5_roomname', w.room)})`
      : ciEq('craa5_equipmentidentifier', w.equipment))).join(' or '), 100));
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
    const out = new Map(); // canonical name -> assets
    rs.forEach(r => r.value.forEach(a => { const k = canonName(a.name); if (!out.has(k)) out.set(k, []); if (!out.get(k).some(x => x.id === a.id)) out.get(k).push(a); }));
    return out;
  };

  // Earlier log entries of one SAP order that carry a known equipment ID (the newest few hundred)
  const prevForOrder = (code) => once(cache.prev, code, async () => {
    const rows = await api.query(LOG_TABLE, {
      select: ['craa5__log_id', 'craa5_equipmentguid', 'craa5_equipment', 'craa5_room', 'craa5_area'],
      filter: `${ciEq('craa5_sap', code)} and craa5_equipmentguid ne null and craa5_equipmentguid ne ''`,
      orderBy: 'craa5_lastcleaned desc', top: LIMITS.prevEntries,
    });
    await resolve(rows.map(r => r.craa5_equipmentguid));
    return rows.map(r => ({ guid: cleanGuid(r.craa5_equipmentguid), equipment: safeString(r.craa5_equipment), room: safeString(r.craa5_room), area: safeString(r.craa5_area) }))
      .filter(r => assets.has(r.guid) || r.equipment);
  });

  // The SAP work area code of a piece (craa5_aa_assets.craa5_workareacode), for the log's craa5_sapw and craa5_uid (contract 6.3).
  // Read on its own so a table without the column never breaks the equipment lists; '' when unknown.
  const workAreaOf = (guid) => {
    const g = cleanGuid(guid);
    if (workAreaOff || !isGuid(g)) return Promise.resolve('');
    return once(cache.workArea, g, async () => {
      try {
        const rows = await api.query(ASSET_TABLE, { select: ['craa5_aa_assetsid', 'craa5_workareacode'], filter: `craa5_aa_assetsid eq ${g}`, top: 1 });
        return safeString(rows[0] && rows[0].craa5_workareacode).toUpperCase();
      } catch (e) {
        if (mlwIsMissingCol(errText(e)) || mlwIsDenied(e)) workAreaOff = true;
        return '';
      }
    });
  };

  const store = {
    lookupState: () => lookup,
    getAsset: (id) => assets.get(cleanGuid(id)),
    hasAsset: (id) => assets.has(cleanGuid(id)),
    isGone: (id) => !isGuid(id) || gone.has(cleanGuid(id)),
    resolveAssets: resolve,
    ensureAssetCatalog,
    catalogStatus: () => ({
      ready: catalogReady,
      loaded: catalogReady,
      complete: catalogComplete,
      count: assets.size,
      msCount: msCatalogCount,
      roomCount: roomIndex.size,
      loadedAt: catalogLoadedAt,
      error: catalogLastError,
    }),
    allAssets: () => {
      tryWarmFromSession();
      warmCatalogInBackground();
      return Array.from(assets.values());
    },
    allCatalogAssets: () => {
      tryWarmFromSession();
      warmCatalogInBackground();
      return Array.from(assets.values());
    },
    // Returns all assets in craa5_aa_assets that share the given equipment name (optionally filtered by room when specified)
    assetsWithSameName(name, room = '') {
      tryWarmFromSession();
      warmCatalogInBackground();
      const k = canonName(name);
      if (!k) return [];
      const all = canonIndex.get(k) || [];
      if (normName(room)) {
        const inRoom = all.filter(a => samePlace(a.room, room));
        if (inRoom.length) return inRoom;
      }
      return all.slice();
    },
    assetsByName(name, room = '') {
      return store.assetsWithSameName(name, room);
    },
    allUniqueEquipmentNames() {
      tryWarmFromSession();
      warmCatalogInBackground();
      const byCanon = new Map();
      assets.forEach(a => {
        if (!a.name || !a._canon) return;
        if (!byCanon.has(a._canon)) byCanon.set(a._canon, { name: a.name, canon: a._canon, count: 0, rooms: new Set() });
        const entry = byCanon.get(a._canon);
        entry.count += 1;
        if (a.room) entry.rooms.add(a.room);
      });
      return Array.from(byCanon.values())
        .map(x => ({ name: x.name, canon: x.canon, count: x.count, rooms: Array.from(x.rooms).slice(0, 3).join(', ') }))
        .sort((a, b) => a.name.localeCompare(b.name));
    },
    allRoomsAndAreas() {
      tryWarmFromSession();
      warmCatalogInBackground();
      const rooms = new Map();
      const areasByRoom = new Map();
      assets.forEach(a => {
        if (a.room) {
          const rk = a._roomKey || placeKey(a.room);
          if (!rooms.has(rk)) rooms.set(rk, a.room);
          if (!areasByRoom.has(rk)) areasByRoom.set(rk, new Map());
          if (a.area) {
            const ak = a._areaKey || placeKey(a.area);
            if (!areasByRoom.get(rk).has(ak)) areasByRoom.get(rk).set(ak, a.area);
          }
        }
      });
      return {
        rooms: Array.from(rooms.values()).sort((a, b) => a.localeCompare(b)),
        areasForRoom: (room) => {
          const rk = placeKey(room);
          const m = areasByRoom.get(rk);
          return m ? Array.from(m.values()).sort((a, b) => a.localeCompare(b)) : [];
        },
      };
    },
    dropOrders() { ['orderSearch', 'orderPending', 'orderRows', 'orders', 'prev', 'evidence'].forEach(k => cache[k].clear()); },
    invalidateAssets() { ['assetSearch', 'names', 'field'].forEach(k => cache[k].clear()); },

    // --- SKIP / NOT-DONE CODES MANAGEMENT (Synced via Dataverse craa5__0_hubconfig key 'MSS_SKIP_CODES') ---
    getSkipCodes() {
      return skipCodes.slice().sort((a, b) => (Number(a.sortOrder) || 100) - (Number(b.sortOrder) || 100) || safeString(a.code).localeCompare(safeString(b.code)));
    },
    getActiveSkipCodes() {
      return store.getSkipCodes().filter(c => c.active !== false);
    },
    skipTableState() {
      return skipTableState === 'connected';
    },
    skipTableStatus() {
