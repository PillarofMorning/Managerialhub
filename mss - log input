  const orderTip = (o) => (o.kind === 'exact' ? 'This SAP order is in the list' : o.kind === 'close' ? `Read as ${o.from}. This order in the list is one character different: check the paperwork before using it` : 'Not in the SAP list. Check the number against the paperwork');
  const status = sheet.status === 'loading' ? 'Getting the reader ready (about 7 MB the first time, kept after that)...'
    : sheet.status === 'reading' ? `Reading ${sheet.file || 'the paperwork'}${sheet.pageTotal > 1 ? `, page ${sheet.page} of ${sheet.pageTotal}` : ''}...`
    : sheet.status === 'stopped' ? 'Stopped.'
    : sheet.status === 'done' ? `Read ${plural(sheet.pages || 0, 'page', 'pages')}${sheet.cut ? ` (only the first ${SHEET_READ_PAGES} pages are read; all of them are attached)` : ''}.`
    : '';
  const ambiguous = !!view && view.dates.some(d => d.amb);
  return (
    <div className={styles.sheetBox} role="region" aria-label="Details read from the paperwork">
      <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
        <Text size={200} weight="semibold">Read from the paperwork</Text>
        <Text className={styles.hint} role="status" aria-live="polite">{status}</Text>
        {busy ? <Button size="small" appearance="subtle" onClick={onStop}>Stop</Button> : <Button size="small" appearance="subtle" disabled={disabled} onClick={onRead}>Read again</Button>}
        <Button size="small" appearance="subtle" onClick={onHide}>Hide</Button>
      </div>
      {(sheet.status === 'unavailable' || sheet.status === 'error') && (
        <Text className={styles.warnText} block role="status" style={{ marginTop: 2 }}>
