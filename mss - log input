const extractMicrosoftShortId = (...candidates) => {
  for (const c of candidates) {
    const s = safeString(c);
    if (!s) continue;
    const uMatch = s.match(/\b([Uu]\d{6,8})\b/);
    if (uMatch) return uMatch[1].toUpperCase();
  }
  for (const c of candidates) {
    const s = safeString(c);
    if (!s) continue;
    if (s.includes('\\')) {
      const afterSlash = safeString(s.split('\\').pop());
      if (afterSlash) return afterSlash.toUpperCase();
    }
    if (s.includes('@')) {
      const beforeAt = safeString(s.split('@')[0]);
      if (beforeAt) return beforeAt.toUpperCase();
    }
  }
  return '';
};

const detectActiveUserIdentity = async (api, hostProps = null) => {
  let override = null;
  try {
    const rawShared = window.localStorage && window.localStorage.getItem(SHARED_MS_USER_KEY);
    if (rawShared) override = JSON.parse(rawShared);
  } catch (_) { /* ignore */ }
  if (!override) {
    try {
      const rawOv = window.localStorage && window.localStorage.getItem(USER_OVERRIDE_STORAGE_KEY);
      if (rawOv) override = JSON.parse(rawOv);
    } catch (_) { /* ignore */ }
  }

  let userId = '';
  let userName = '';
  let email = '';
  let domainName = '';
  let microsoftId = '';
  let source = 'Browser Session';

  try {
    const pUs = hostProps && hostProps.context && hostProps.context.userSettings ? hostProps.context.userSettings : null;
    if (pUs) {
      userId = cleanGuid(pUs.userId || '');
      userName = safeString(pUs.userName || '');
      source = 'props.context.userSettings';
    }
  } catch (_) { /* ignore */ }

  try {
    const xrm = getXrm() || (typeof window !== 'undefined' && window.Xrm);
    const gc = xrm && xrm.Utility && typeof xrm.Utility.getGlobalContext === 'function' ? xrm.Utility.getGlobalContext() : null;
    const us = gc && gc.userSettings ? gc.userSettings : null;
    if (us) {
      userId = cleanGuid(us.userId || '') || userId;
      userName = safeString(us.userName || '') || userName;
      source = 'Xrm.Utility.getGlobalContext';
    }
    if (gc && typeof gc.getCurrentAppProperties === 'function') {
      try { await gc.getCurrentAppProperties(); } catch (_) { /* ignore */ }
    }
  } catch (_) { /* ignore */ }

  const baseUrl = getDataverseBaseUrl();
  if (!userId && baseUrl && typeof fetch === 'function') {
    try {
      const whoRes = await fetch(`${baseUrl}/api/data/v9.2/WhoAmI()`, {
        method: 'GET',
        credentials: 'same-origin',
        headers: { Accept: 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' },
      });
      if (whoRes.ok) {
        const whoJson = await whoRes.json();
        if (whoJson && whoJson.UserId) {
          userId = cleanGuid(whoJson.UserId);
          source = 'Dataverse WhoAmI';
        }
      }
    } catch (_) { /* ignore */ }
  }

  if (userId && api && (api.mode === 'dataverse' || api.mode === 'live')) {
    try {
      const sysRows = await api.query('systemuser', {
        select: ['systemuserid', 'fullname', 'internalemailaddress', 'domainname', 'azureactivedirectoryobjectid'],
        filter: `systemuserid eq ${userId}`,
        top: 1,
      });
      if (sysRows && sysRows[0]) {
        const u = sysRows[0];
        userName = safeString(u.fullname) || userName;
        email = safeString(u.internalemailaddress) || email;
        domainName = safeString(u.domainname) || domainName;
        source = 'Dataverse systemusers';
      }
    } catch (_) { /* ignore */ }
  }

  try {
    const winPath = typeof window !== 'undefined' && window.location ? decodeURIComponent(window.location.href || '') : '';
    microsoftId = extractMicrosoftShortId(domainName, email, userName, winPath);
  } catch (_) { /* ignore */ }

  if (api && (api.mode === 'dataverse' || api.mode === 'live') && (microsoftId || userName)) {
    try {
      const empRows = await api.query(EMP_TABLE, {
        select: ['craa5__aa_employeeid', 'craa5_employeename', 'craa5_role', 'craa5_shift'],
        top: 200,
      });
      if (Array.isArray(empRows) && empRows.length > 0) {
        const targetKey = safeString(microsoftId || userName).toUpperCase();
        const foundEmp = empRows.find(r => {
          const en = safeString(r.craa5_employeename).toUpperCase();
          return en && (en === targetKey || en.includes(targetKey));
        });
        if (foundEmp && safeString(foundEmp.craa5_employeename) && (!userName || userName === microsoftId)) {
          userName = safeString(foundEmp.craa5_employeename);
        }
      }
    } catch (_) { /* ignore */ }
  }

  if (override && (safeString(override.microsoftId) || safeString(override.userName) || safeString(override.email))) {
    microsoftId = safeString(override.microsoftId || microsoftId || 'U1010051').toUpperCase();
    userName = safeString(override.userName || userName || microsoftId);
    email = safeString(override.email || email);
    domainName = safeString(override.domainName || domainName || microsoftId);
    source = 'Manual Identity Profile';
  }

  if (!microsoftId) {
    microsoftId = 'FLOOR-USER';
  }
  if (!userName) {
    userName = microsoftId === 'U1010051' ? 'Plant Admin' : `MSS Operator`;
  }

  const resolvedIdentity = {
    userId: userId || 'local-session',
    microsoftId,
    userName,
    email: email || (microsoftId === 'U1010051' ? 'U1010051@schwans.com' : ''),
    domainName: domainName || microsoftId,
    source,
  };
  try {
    if (window.localStorage) window.localStorage.setItem(SHARED_MS_USER_KEY, JSON.stringify(resolvedIdentity));
  } catch (_) { /* ignore */ }
  return resolvedIdentity;
};

const resolveEffectiveUserView = (user, viewConfig, previewTargetKey, logoUnlocked) => {
  const cfg = viewConfig || DEFAULT_VIEW_MODULE_CONFIG;
  const lookupKeys = [];
  if (safeString(previewTargetKey)) {
    lookupKeys.push(safeString(previewTargetKey).toUpperCase());
  } else if (user) {
    [user.microsoftId, user.domainName, user.email, user.userName, user.userId].forEach(v => {
      const clean = safeString(v).toUpperCase();
      if (clean && !lookupKeys.includes(clean)) lookupKeys.push(clean);
    });
  }

  const matchedAssignment = (cfg.userAssignments || []).find(a => {
    const mk = safeString(a.matchKey).toUpperCase();
    if (!mk) return false;
    return lookupKeys.some(k => k === mk || k.includes(mk) || mk.includes(k));
  });

  const userPrefKey = lookupKeys[0] || 'DEFAULT';
  const selfPref = cfg.selfPreferencesByUser && cfg.selfPreferencesByUser[userPrefKey];

  // If admin assigned & locked this user's view, enforce the assignment (unless logoUnlocked and not previewing another user)
  if (matchedAssignment && matchedAssignment.lockedByAdmin && (!logoUnlocked || safeString(previewTargetKey))) {
    const basePreset = VIEW_ROLE_PRESETS[matchedAssignment.preset] || VIEW_ROLE_PRESETS.operator;
    return {
      presetId: basePreset.id,
      presetLabel: basePreset.label,
      sourceLabel: `Assigned & Locked by Admin (${matchedAssignment.matchKey})`,
      lockedByAdmin: true,
      matchedAssignment,
      tabs: Array.isArray(matchedAssignment.tabs) && matchedAssignment.tabs.length ? matchedAssignment.tabs : basePreset.tabs,
      features: { ...basePreset.features, ...(matchedAssignment.features || {}) },
    };
  }

  // If user has saved their own view preference (and is not locked out), use their preference
  if (selfPref && !safeString(previewTargetKey)) {
    const basePreset = VIEW_ROLE_PRESETS[selfPref.preset] || VIEW_ROLE_PRESETS.lead;
    return {
      presetId: basePreset.id,
      presetLabel: basePreset.label,
      sourceLabel: 'My Custom View Preference',
      lockedByAdmin: false,
      matchedAssignment: matchedAssignment || null,
      tabs: Array.isArray(selfPref.tabs) && selfPref.tabs.length ? selfPref.tabs : basePreset.tabs,
      features: { ...basePreset.features, ...(selfPref.features || {}) },
    };
  }

  // If admin assigned a default unlocked view for this user, use it
  if (matchedAssignment) {
    const basePreset = VIEW_ROLE_PRESETS[matchedAssignment.preset] || VIEW_ROLE_PRESETS.lead;
    return {
      presetId: basePreset.id,
      presetLabel: basePreset.label,
      sourceLabel: `Assigned by Admin (${matchedAssignment.matchKey})`,
      lockedByAdmin: !!matchedAssignment.lockedByAdmin,
      matchedAssignment,
      tabs: Array.isArray(matchedAssignment.tabs) && matchedAssignment.tabs.length ? matchedAssignment.tabs : basePreset.tabs,
      features: { ...basePreset.features, ...(matchedAssignment.features || {}) },
    };
  }

  const plantPreset = VIEW_ROLE_PRESETS[cfg.plantDefaultPreset] || VIEW_ROLE_PRESETS.lead;
  return {
    presetId: plantPreset.id,
    presetLabel: plantPreset.label,
    sourceLabel: `Plant Default (${plantPreset.label})`,
    lockedByAdmin: false,
    matchedAssignment: null,
    tabs: plantPreset.tabs.slice(),
    features: { ...plantPreset.features },
  };
};

const normalizeAccessAuditEntry = (e) => {
  if (!e || typeof e !== 'object') return null;
  const accessedAt = e.accessedAt || (e.ts ? new Date(e.ts).toISOString() : new Date().toISOString());
  return {
    ...e,
    id: e.id || `acc-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
    accessedAt,
    lastActiveAt: e.lastActiveAt || accessedAt,
    microsoftId: safeString(e.microsoftId || e.userId || 'FLOOR-USER'),
    userName: safeString(e.userName || e.microsoftId || 'MSS User'),
    email: safeString(e.email || ''),
    domainName: safeString(e.domainName || e.microsoftId || ''),
    source: safeString(e.source || e.app || 'App Session'),
    viewPreset: e.viewPreset || e.presetId || 'full',
    tabsVisited: Array.isArray(e.tabsVisited) ? e.tabsVisited : (e.tab ? [e.tab] : []),
    actionsCount: Number(e.actionsCount) || 1,
    apiMode: e.apiMode || 'dataverse',
  };
};

const loadAccessAuditLogs = () => {
  try {
    const raw = window.localStorage && window.localStorage.getItem(ACCESS_LOG_STORAGE_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed.map(normalizeAccessAuditEntry).filter(Boolean) : [];
  } catch (_) {
    return [];
  }
};

const saveAccessAuditLogsLocal = (logs) => {
  try {
    const trimmed = (Array.isArray(logs) ? logs : []).map(normalizeAccessAuditEntry).filter(Boolean).slice(0, 250);
    if (window.localStorage) window.localStorage.setItem(ACCESS_LOG_STORAGE_KEY, JSON.stringify(trimmed));
    return trimmed;
  } catch (_) {
    return Array.isArray(logs) ? logs : [];
  }
};

