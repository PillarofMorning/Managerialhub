  const [photoName, setPhotoName] = useState('');
  const [photoBusy, setPhotoBusy] = useState(false);
  const [excluded, setExcluded] = useState({});
  const [chosen, setChosen] = useState({});          // lineKey -> equipment picked instead of the automatic one
  const [hoursOverride, setHoursOverride] = useState({}); // lineKey -> hours as typed
  const [editMode, setEditMode] = useState(false);
  const [edits, setEdits] = useState({});            // lineKey -> { id, name, room, area } for the equipment with that id
  const [dupes, setDupes] = useState(new Set());
  const [extras, setExtras] = useState([]);
  const [addOpen, setAddOpen] = useState(null); // null: open only for an order that is not in the SAP list
  const [linesOpen, setLinesOpen] = useState(true);
  const [addMode, setAddMode] = useState('search');
  const [addFreq, setAddFreq] = useState('craa5_sapw');
  const [newRoom, setNewRoom] = useState('');
  const [newArea, setNewArea] = useState('');
  const [newName, setNewName] = useState('');
  const [typing, setTyping] = useState({ room: '', area: '', roomCtx: '' });
  const [note, setNote] = useState('');
  const [panel, setPanel] = useState({});            // lineKey -> 'list' | 'search' | 'new' while its Change panel is open
  const [moreRank, setMoreRank] = useState({});      // lineKey -> { busy, ranked, error } (similar names looked up on demand)
  const [newFor, setNewFor] = useState({});          // lineKey -> { name, room, area } typed for "Create new asset"
  const [retro, setRetro] = useState({});            // lineKey -> { status, count, more, from, stillUsed, filter, apply, error }
  const [pieces, setPieces] = useState({});          // lineKey -> the equipment its SAP row is broken up into (a key here means break up is on)
  const [hints, setHints] = useState({});            // lineKey -> { status, found, error } pieces looked for when break up was started
  const [splitOpen, setSplitOpen] = useState({});    // lineKey -> true while its pieces are being edited
  const seq = useRef(0);
  const orderGen = useRef(0);
  const piecesRef = useRef(pieces);                  // read by lookups that finish later, to see whether the line was broken up meanwhile
  piecesRef.current = pieces;
  const wrapRef = useRef(null);                      // the lines box, to move the focus into a pieces editor that was just opened
  const focusTo = useRef('');                        // selector (inside the lines box) of the control that takes the focus after the next render
  const photoSeq = useRef(0);
  const retroSeq = useRef({});
  const listRef = useRef(null);

  const normalizedCode = normCode(code);
  const ready = !!order && order.status === 'ready' && order.code === normalizedCode;
  const matches = useMemo(() => (ready ? order.entries : []), [ready, order]);
  const listId = `sap-list-${index}`;

  // Order suggestions: debounced server search, only while the box is open
  useEffect(() => {
    if (!showSuggest || normalizedCode.length < 2) { setSugg(s => (s.items.length || s.busy || s.error ? { items: [], truncated: false, busy: false, error: '' } : s)); return undefined; }
    let live = true;
    setSugg(s => ({ ...s, busy: true }));
    const t = setTimeout(async () => {
      try { const r = await store.searchOrders(normalizedCode); if (live) setSugg({ items: r.items, truncated: r.truncated, busy: false, error: '' }); }
      catch (e) { if (live) setSugg({ items: [], truncated: false, busy: false, error: errText(e) }); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, showSuggest, store]);

  // Load the typed/selected order (exact, not case sensitive) once typing pauses
  useEffect(() => {
    if (normalizedCode.length < 3) { setOrder(null); return undefined; }
    let live = true;
    // Reloading the same order (after a Fix tab change) keeps its lines on screen until the new ones arrive
    setOrder(o => (o && o.status === 'ready' && o.code === normalizedCode ? { ...o, refreshing: true } : { status: 'loading', code: normalizedCode, entries: [] }));
    const t = setTimeout(async () => {
      try { const r = await store.loadOrder(normalizedCode); if (live) setOrder({ status: 'ready', ...r }); }
      catch (e) { if (live) setOrder({ status: 'error', code: normalizedCode, entries: [], error: errText(e) }); }
    }, 350);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, store, dataVer]); // dataVer: IDs were repaired or unified on the Fix tab, so best fits are worked out again

  // Only suggestions that fit what is typed now are shown or picked (results for an earlier prefix are dropped)
  const suggestions = useMemo(() => sugg.items.filter(x => x.code.includes(normalizedCode)), [sugg.items, normalizedCode]);
  const suggestOpen = showSuggest && normalizedCode.length >= 2 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode && !sugg.busy);
  const listOpen = suggestOpen && suggestions.length > 0;
  const hiIndex = Math.min(hi, Math.max(0, suggestions.length - 1));

  useEffect(() => {
    const el = listRef.current && listRef.current.querySelector('[aria-selected="true"]');
    if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
  }, [hi, suggestions.length]);

  // Include ticks, typed hours and edits made on the pieces of a row go with the pieces: a piece added again starts fresh
  const dropPieceState = (isPiece) => {
    const drop = (p) => { const x = {}; Object.keys(p).forEach((k) => { if (!isPiece(k)) x[k] = p[k]; }); return x; };
    setExcluded(drop); setHoursOverride(drop); setEdits(drop);
  };
  // Manual picks and earlier-entry scans; orderGen makes any lookup still running for them stale
  const resetPicks = () => {
    orderGen.current += 1;
    setChosen({}); setPanel({}); setMoreRank({}); setRetro({}); setPieces({}); setHints({}); setSplitOpen({});
    dropPieceState(k => k.indexOf('~') >= 0);
    retroSeq.current = {};
  };
  const clearOrderState = () => {
    resetPicks();
    setExcluded({}); setHoursOverride({}); setExtras([]); setEdits({});
    setAddOpen(null); setLinesOpen(true); setEditMode(false); setNote(''); setNewFor({});
  };
  const selectCode = (c) => { setCode(c); setShowSuggest(false); clearOrderState(); };
  // IDs changed on the Fix tab: picks made by hand may point at equipment that was just unified away, so they are dropped
  const seenVer = useRef(dataVer);
  useEffect(() => {
    if (seenVer.current === dataVer) return;
    seenVer.current = dataVer;
    if (Object.keys(chosen).length || Object.keys(retro).length || Object.keys(pieces).length) {
      resetPicks();
      setNote('Equipment IDs were changed on the Fix tab, so the equipment for this order was worked out again. Check the lines and use Change or Break up again if needed.');
    } else if (Object.keys(hints).length) {
      orderGen.current += 1; // pieces looked for earlier were worked out from the old IDs (and a lookup still running is stale)
      setHints({});
    }
  }, [dataVer]); // eslint-disable-line react-hooks/exhaustive-deps

  // Lines: one per equipment on the order
  const lines = useMemo(() => {
    const seen = new Set();
    const out = [];
    matches.forEach((e) => {
      const list = pieces[e.key];
      if (list) {
        // Broken up: the SAP row stands for several pieces of equipment, one line each. Until there are two it is a single line
        // that still has to be filled in.
        const ms = { equipment: e.equipment, room: e.room, area: e.area };
        const keep = list.filter(a => !seen.has(a.id));
        keep.forEach(a => seen.add(a.id));
        if (keep.length < 2) {
          out.push({ key: e.key, msId: e.msId, col: e.col, how: 'pieces', tier: 'manual', ambiguous: false, reason: '', asset: null, auto: null, linked: null, ranked: [], partial: false, ms, name: e.equipment, room: e.room, area: e.area, splitting: true });
          return;
        }
        keep.forEach((a, i) => {
          out.push({ key: `${e.key}~${a.id}`, parent: e.key, piece: i + 1, pieceCount: keep.length, msId: e.msId, col: e.col, how: 'piece', tier: 'manual', ambiguous: false, reason: '', asset: a, auto: null, linked: null, ranked: [], partial: false, ms, name: a.name, room: a.room, area: a.area });
        });
        return;
      }
      const pick = chosen[e.key];
      if (!pick && e.how === 'same as another line') return;
      const asset = pick || e.asset;
      if (asset && !asset.isNew) {
        if (seen.has(asset.id) && !pick) return; // the same equipment listed twice on the order
        seen.add(asset.id);
      }
      out.push({
        key: e.key, msId: e.msId, col: e.col, how: pick ? (pick.isNew ? 'new asset' : e.asset ? 'changed' : 'chosen') : e.how,
        tier: pick ? 'manual' : e.tier, ambiguous: !pick && !!e.ambiguous, reason: pick ? '' : e.reason,
        asset, auto: e.asset || null, linked: e.linked || null, ranked: e.ranked || [], partial: !!e.partial,
        ms: { equipment: e.equipment, room: e.room, area: e.area },
        name: asset ? asset.name : e.equipment, room: asset ? asset.room : e.room, area: asset ? asset.area : e.area,
      });
    });
    extras.forEach(x => {
      if (!x.asset.isNew && seen.has(x.asset.id)) return;
      if (!x.asset.isNew) seen.add(x.asset.id);
      out.push({ key: x.key, msId: null, col: x.col, how: x.asset.isNew ? 'new equipment' : 'added', asset: x.asset, ranked: [], ms: null, name: x.asset.name, room: x.asset.room, area: x.asset.area, extra: true });
    });
    // Apply "edit pre-filled details" overrides, only to the equipment they were made for
    return out.map(l => { const ed = edits[l.key]; return ed && l.asset && !l.asset.isNew && ed.id === l.asset.id ? { ...l, name: ed.name, room: ed.room, area: ed.area } : l; });
  }, [matches, chosen, extras, edits, pieces]);

  // The equipment a line gives up while its SAP row is broken up (its automatic match or its Change pick) stays reserved for that row,
  // so no other line, extra or pieces list can take it before the row goes back to one piece of equipment
  const reservedIds = useMemo(() => {
    const m = {};
    matches.forEach((e) => {
      if (!pieces[e.key]) return;
      const a = chosen[e.key] || e.asset;
      if (a && !a.isNew && a.id) m[e.key] = a.id;
    });
    return m;
  }, [matches, pieces, chosen]);
  // Equipment already on a line, among the pieces of a row being broken up, or reserved for such a row
  const takenIds = useMemo(() => {
    const ids = lines.map(l => l.asset && !l.asset.isNew && l.asset.id).filter(Boolean);
    matches.forEach((e) => {
      (pieces[e.key] || []).forEach((a) => { ids.push(a.id); });
      if (reservedIds[e.key]) ids.push(reservedIds[e.key]);
    });
    return new Set(ids);
  }, [lines, matches, pieces, reservedIds]);
  const takenRef = useRef(takenIds);
  takenRef.current = takenIds;
  // What the pieces of one row cannot use: all of the above except the equipment that row itself gave up
  const takenFor = (key) => {
    const mine = reservedIds[key];
    if (!mine) return takenIds;
    // Two SAP rows can be linked to the same equipment: then it is free for neither while the other holds it too
    const heldElsewhere = lines.some(l => (l.parent || l.key) !== key && l.asset && l.asset.id === mine)
      || matches.some(e => e.key !== key && (reservedIds[e.key] === mine || (pieces[e.key] || []).some(a => a.id === mine)));
    if (heldElsewhere) return takenIds;
    const x = new Set(Array.from(takenIds));
    x.delete(mine);
    return x;
  };
  // The SAP row broken up into pieces that holds this equipment, as { name, inPieces } (inPieces: among its pieces, else reserved
  // for it), or null
  const brokenUpOwner = (id) => {
    let found = null;
    matches.forEach((e) => {
      const name = e.equipment || 'another line';
      if ((pieces[e.key] || []).some(a => a.id === id)) found = { name, inPieces: true };
      else if (reservedIds[e.key] === id && !found) found = { name, inPieces: false };
    });
    return found;
  };
  const included = lines.filter(l => !excluded[l.key] && l.asset);
  // The order's hours are shared evenly by SAP row: a row broken up shares its part among its pieces, so breaking one up never
  // changes the hours of the other rows. Hours typed by hand come off the part they were typed for: a line's (or a broken-up row's,
  // if typed before it was broken up) off the order total, a piece's off the part of its own row.
  const evenHours = useMemo(() => {
    const typed = (k) => (hoursOverride[k] !== undefined ? parseFloat(hoursOverride[k]) || 0 : null);
    const rows = [];  // one per SAP row (or added equipment) with lines on it: { key, lines }; a row still being broken up keeps its part
    const at = {};
    lines.forEach((l) => {
      if (excluded[l.key] || !(l.asset || l.splitting)) return;
      const k = l.parent || l.key;
      if (at[k] === undefined) { at[k] = rows.length; rows.push({ key: k, lines: [] }); }
      if (l.asset) rows[at[k]].lines.push(l);
    });
    const free = rows.filter(r => typed(r.key) === null);
    const fixed = rows.reduce((s, r) => s + (typed(r.key) || 0), 0);
    const share = splitHours((parseFloat(totalHours) || 0) - fixed, free.length);
    const map = {};
    rows.forEach((r) => {
      if (!r.lines.length) return;
      const part = typed(r.key) !== null ? typed(r.key) : share[free.indexOf(r)] || 0;
      if (!r.lines[0].parent) { if (typed(r.key) === null) map[r.key] = part; return; }
      const open = r.lines.filter(l => typed(l.key) === null);
      const each = splitHours(part - r.lines.reduce((s, l) => s + (typed(l.key) || 0), 0), open.length);
      open.forEach((l, j) => { map[l.key] = each[j] || 0; });
    });
    return map;
  }, [lines, excluded, hoursOverride, totalHours]);
  const lineHours = (l) => (hoursOverride[l.key] !== undefined ? parseFloat(hoursOverride[l.key]) || 0 : evenHours[l.key] || 0);
  const hoursSum = Math.round(included.reduce((s, l) => s + lineHours(l), 0) * 100) / 100;
  const isDupe = (l) => !!(l.asset && !l.asset.isNew && dupes.has(l.asset.id));
  const dupeShare = Math.round(included.filter(isDupe).reduce((s, l) => s + lineHours(l), 0) * 100) / 100;

  // Skip equipment already logged for the same order and date (one small filtered query, once the order has lines)
  const hasLines = lines.length > 0;
  useEffect(() => {
    setDupes(new Set());
    if (!ready || !dateStr || !hasLines) return undefined;
    let cancelled = false;
    fetchDupes(api, normalizedCode, dateStr).then(s => { if (!cancelled) setDupes(s); }).catch(() => {});
    return () => { cancelled = true; };
  }, [api, normalizedCode, dateStr, ready, hasLines]);

  // While the typeahead is still offering orders, don't claim the typed text is unknown or open the add panel
  const settling = matches.length === 0 && suggestOpen && (sugg.busy || suggestions.length > 0);
  const isUnknown = ready && matches.length === 0 && !settling;
  const roomOpts = useSuggest(store, 'craa5_roomname', typing.room);
  const areaOpts = useSuggest(store, 'craa5_areaname', typing.area, typing.roomCtx);

  const addExtra = (asset) => {
    if (!asset.isNew && takenIds.has(asset.id)) { setNote(`${asset.name} is already on this order.`); return; }
    seq.current += 1;
    setExtras(p => [...p, { key: `x-${seq.current}`, asset, col: addFreq }]);
    setNewName('');
  };
  const addNew = async () => {
    const name = newName.trim(), room = newRoom.trim(), area = newArea.trim();
    if (!room || !area || !name) { setNote('Enter room, area and equipment name for the new equipment.'); return; }
    if (lines.some(l => l.asset && l.asset.isNew && sameText(l.name, name) && sameText(l.room, room) && sameText(l.area, area))) { setNote(`${name} is already being added to this order.`); return; }
    setNote('');
    const g0 = orderGen.current;
    try {
      const existing = await store.findAssetExact(name, room, area);
      if (orderGen.current !== g0) return; // the order was changed while this looked
      if (existing) {
        if (takenRef.current.has(existing.id)) { setNote(`${existing.name} is already on this order.`); return; }
        addExtra(existing);
        setNote(`${existing.name} already exists in ${placeText(existing)}; added the existing equipment instead of creating a duplicate.`);
        return;
      }
    } catch (e) { if (orderGen.current === g0) setNote(`Could not check for an existing match: ${errText(e)}`); return; }
    seq.current += 1;
    addExtra({ id: `new:${seq.current}`, isNew: true, name, room, area });
  };

  // --- Change equipment on a line ---
  const candidatesFor = (l) => {
    const more = (moreRank[l.key] && moreRank[l.key].ranked) || [];
    const all = [...l.ranked, ...more];
    return Array.from(new Map(all.map(c => [c.asset.id, c])).values())
      .filter(c => !takenIds.has(c.asset.id))
      .sort((a, b) => b.score - a.score || (b.support || 0) - (a.support || 0));
  };
  // Find the earlier entries a change would correct (counted now, moved on submit)
  const scanRetro = async (l, to) => {
    const from = l.auto && !l.auto.isNew ? l.auto : null;
    const n = (retroSeq.current[l.key] || 0) + 1;
    retroSeq.current[l.key] = n;
    if (from && to && !to.isNew && from.id === to.id) { setRetro(p => { const x = { ...p }; delete x[l.key]; return x; }); return; }
    // Only a line that still has its automatic equipment keeps the old ID's entries; a changed line brings its own
    const stillUsed = !!from && lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === from.id);
    const filter = retroFilter(normalizedCode, from, l.ms, stillUsed);
    if (!filter) { setRetro(p => ({ ...p, [l.key]: { status: 'ready', count: 0, from, stillUsed, filter: null, apply: false } })); return; }
    setRetro(p => ({ ...p, [l.key]: { status: 'scanning', count: 0, from, stillUsed, filter, apply: p[l.key] ? p[l.key].apply : true } }));
    try {
      const rows = await api.query(LOG_TABLE, { select: RETRO_SELECT, filter, top: LIMITS.countCap + 1 });
      const some = rows.slice(0, LIMITS.countCap);
      // Entries the new equipment already has for the same order and day are not moved (see coveredByTarget)
      const cov = await coveredByTarget(api, some, to);
      if (retroSeq.current[l.key] !== n) return;
      if (cov.unchecked) { setRetro(p => ({ ...p, [l.key]: { ...p[l.key], status: 'error', error: `${to.name} has too many entries to check the earlier ones against`, apply: false } })); return; }
      const movable = some.filter(r => !isCovered(cov, r));
      const skipped = some.length - movable.length;
      // Entries the new equipment already covers show this order was logged piece by piece: the rest are not ticked for the admin
      setRetro(p => ({ ...p, [l.key]: { ...p[l.key], status: 'ready', count: movable.length, more: rows.length > LIMITS.countCap, skipped, ...(skipped > 0 ? { apply: false } : {}) } }));
    } catch (e) {
      if (retroSeq.current[l.key] === n) setRetro(p => ({ ...p, [l.key]: { ...p[l.key], status: 'error', error: errText(e), apply: false } }));
    }
  };
  // Another line taking or freeing a changed line's old equipment changes which earlier entries that line may move
  useEffect(() => {
    lines.forEach(l => {
      const r = retro[l.key];
      if (!r || !r.from || !chosen[l.key] || l.splitting) return;
      const used = lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === r.from.id);
      if (used !== !!r.stillUsed) scanRetro(l, l.asset);
    });
  }, [lines]); // eslint-disable-line react-hooks/exhaustive-deps
  // "Edit pre-filled details" follows the equipment a line now uses, so an edit never lands on another record
  const reseedEdit = (l, asset) => setEdits(p => {
    const x = { ...p };
    if (editMode && asset && !asset.isNew) x[l.key] = { id: asset.id, name: asset.name, room: asset.room, area: asset.area };
    else delete x[l.key];
    return x;
  });
  const choose = (l, asset) => {
    // Claimed at once, so a lookup finishing right after this one cannot pick the same equipment for another line
    if (asset && !asset.isNew) takenRef.current = new Set(Array.from(takenRef.current).concat([asset.id]));
    setChosen(p => ({ ...p, [l.key]: asset }));
    reseedEdit(l, asset);
    setNote('');
    scanRetro(l, asset);
  };
  const undoChoice = (l) => {
    if (l.auto && !l.auto.isNew && takenIds.has(l.auto.id) && !(l.asset && l.asset.id === l.auto.id)) {
      const owner = brokenUpOwner(l.auto.id);
      const what = `${l.auto.name} (${placeText(l.auto)})`;
      setNote(!owner
        ? `${what} is now used by another line of this order. Change that line first, or pick other equipment here.`
        : owner.inPieces
          ? `${what} is now one of the pieces of “${owner.name}”. Take it out of those pieces first, or pick other equipment here.`
          : `${what} is kept for “${owner.name}”, which is broken up into pieces. Pick other equipment here.`);
      return;
    }
    setChosen(p => { const x = { ...p }; delete x[l.key]; return x; });
    reseedEdit(l, l.auto);
    setRetro(p => { const x = { ...p }; delete x[l.key]; return x; });
    retroSeq.current[l.key] = (retroSeq.current[l.key] || 0) + 1;
  };
  const setView = (l, v) => setPanel(p => ({ ...p, [l.key]: v }));
  const closePanel = (l) => setPanel(p => { const x = { ...p }; delete x[l.key]; return x; });
  const rankMore = async (l) => {
    setMoreRank(p => ({ ...p, [l.key]: { busy: true, ranked: [] } }));
    try {
      const ranked = await store.rankLine(normalizedCode, l.ms, matches.length === 1);
      setMoreRank(p => ({ ...p, [l.key]: { busy: false, ranked } }));
      return ranked;
    } catch (e) { setMoreRank(p => ({ ...p, [l.key]: { busy: false, ranked: [], error: errText(e) } })); return []; }
  };
  // "Change" moves the line to the next best fit straight away (looking up similar names when none is known yet);
  // the panel lists the rest, a search and "Create new asset"
  const openChange = (l) => {
    setView(l, 'list');
    const ok = (c) => c.score >= 0.6 && placeOk(l.ms, c.asset) && !takenRef.current.has(c.asset.id) && !(l.asset && c.asset.id === l.asset.id);
    const next = chosen[l.key] ? null : candidatesFor(l).find(ok);
    if (next) choose(l, next.asset);
    if (moreRank[l.key] || (next && !l.partial)) return;
    const n0 = retroSeq.current[l.key] || 0;
    const g0 = orderGen.current;
    rankMore(l).then(r => {
      // the admin picked something, changed order or broke the line up meanwhile
      if (next || chosen[l.key] || orderGen.current !== g0 || (retroSeq.current[l.key] || 0) !== n0 || piecesRef.current[l.key]) return;
      const n = r.find(ok);
      if (n) choose(l, n.asset);
    });
  };
  const useNewAsset = async (l) => {
    const f = newFor[l.key] || { name: l.ms.equipment, room: l.ms.room, area: l.ms.area };
    const name = safeString(f.name), room = safeString(f.room), area = safeString(f.area);
    if (!name || !room || !area) { setNote('Enter a name, room and area for the new asset.'); return; }
    const sameNew = (a) => !!a && a.isNew && sameText(a.name, name) && sameText(a.room, room) && sameText(a.area, area);
    // (a new asset picked for a row that is broken up now is not on a line, but it comes back with "One piece only")
    if (lines.some(x => x.key !== l.key && sameNew(x.asset)) || matches.some(e => e.key !== l.key && pieces[e.key] && sameNew(chosen[e.key]))) {
      setNote(`${name} (${room} / ${area}) is already being created for another line.`);
      return;
    }
    const g0 = orderGen.current;
    try {
      const existing = await store.findAssetExact(name, room, area);
      if (orderGen.current !== g0 || piecesRef.current[l.key]) return; // the order changed, or the line was broken up, while this looked
      if (existing) {
        if (takenRef.current.has(existing.id) && !(l.asset && l.asset.id === existing.id)) { setNote(`${existing.name} (${placeText(existing)}) is already on this order.`); return; }
        choose(l, existing);
        setNote(`${existing.name} already exists in ${placeText(existing)}; using it instead of creating a duplicate.`);
        setView(l, 'list');
        return;
      }
    } catch (e) { setNote(`Could not check for an existing asset: ${errText(e)}`); return; }
    seq.current += 1;
    choose(l, { id: `new:${seq.current}`, isNew: true, name, room, area });
    setView(l, 'list');
  };

  // --- Break a line up into pieces: one entry per piece of equipment, each saved with its own equipment ID ---
  // Looks for the pieces the SAP row's text lists, or equipment named after it (a hint only: nothing is added until the admin says so)
  const lookForPieces = async (e) => {
    const g0 = orderGen.current;
    setHints(p => ({ ...p, [e.key]: { status: 'busy' } }));
    try {
      // Equipment that already has the row's own name is the match, so no pieces are suggested then
      const known = [e.linked, chosen[e.key]].filter(Boolean).map(a => ({ asset: a }));
      // A new map of log use every time: the log can change on the Unify tab, and a failed lookup must not be remembered
      const found = await suggestPieces(store, { equipment: e.equipment, room: e.room, area: e.area, ranked: (e.ranked || []).concat(known) }, new Map());
      if (orderGen.current === g0) setHints(p => ({ ...p, [e.key]: { status: 'ready', found } }));
    } catch (err) {
      if (orderGen.current === g0) setHints(p => ({ ...p, [e.key]: { status: 'error', error: errText(err) } }));
    }
  };
  const startBreakUp = (l) => {
    const e = matches.find(x => x.key === (l.parent || l.key));
    if (!e) return;
    setPieces(p => (p[e.key] ? p : { ...p, [e.key]: [] }));
    setSplitOpen(p => ({ ...p, [e.key]: true }));
    closePanel(l);
    setNote('');
    focusTo.current = `[data-split="${e.key}"]`;
    // Looked for again when the last lookup failed or found nothing (a brief outage looks like "no pieces")
    const h = hints[e.key];
    if (!h || h.status === 'error' || (h.status === 'ready' && !h.found)) lookForPieces(e);
  };
  const editPieces = (l) => { focusTo.current = `[data-split="${l.parent}"]`; setSplitOpen(p => ({ ...p, [l.parent]: true })); };
  const closeSplit = (key) => setSplitOpen(p => { const x = { ...p }; delete x[key]; return x; });
  // "Edit pre-filled details" is on: the pieces of a row get their boxes too (a rename typed for the row's own equipment goes with it)
  const pieceEdits = (key, list, prev) => {
    const x = { ...prev };
    list.forEach((a) => {
      const k = `${key}~${a.id}`;
      if (a.isNew || x[k]) return;
      x[k] = prev[key] && prev[key].id === a.id ? prev[key] : { id: a.id, name: a.name, room: a.room, area: a.area };
    });
    return x;
  };
  // list: the pieces so far (fewer than two is still being chosen), or null for one piece of equipment again
  const setPiecesFor = (key, list) => {
    if (!list) {
      setPieces(p => { const x = { ...p }; delete x[key]; return x; });
      closeSplit(key);
      dropPieceState(k => k.indexOf(`${key}~`) === 0);
      focusTo.current = `[data-break-up="${key}"]`;
      // "Edit pre-filled details" is on: the line that comes back gets its boxes (edit mode may have been switched on while it was broken up)
      const e = matches.find(m => m.key === key);
      const back = e && (chosen[key] || e.asset);
      if (editMode && back && !back.isNew) setEdits(p => (p[key] && p[key].id === back.id ? p : { ...p, [key]: { id: back.id, name: back.name, room: back.room, area: back.area } }));
      return;
    }
    const gone = (pieces[key] || []).filter(a => !list.some(x => x.id === a.id)).map(a => `${key}~${a.id}`);
    if (gone.length) dropPieceState(k => gone.indexOf(k) >= 0);
    if (editMode) setEdits(p => pieceEdits(key, list, p));
    setPieces(p => ({ ...p, [key]: list }));
  };
  // The suggested pieces that are not in the list yet and not on another line of the order
  const addFound = (key, found) => {
    const list = pieces[key] || [];
    const taken = takenFor(key);
    focusTo.current = `[data-split="${key}"]`;
    setPiecesFor(key, list.concat(found.assets.filter(a => !list.some(x => x.id === a.id) && !taken.has(a.id))));
  };
  // A pieces editor that was just opened (or fed from the hint) takes the focus, so the keyboard carries on inside it (its box, not a
  // field: a touch screen keyboard should not pop up over the hint). When the editor closes, the focus goes back to the line's button.
  // A box taller than the lines box is scrolled into view by its top (below the sticky column header), so its title and hint stay in sight.
  useEffect(() => {
    const sel = focusTo.current;
    if (!sel) return;
    focusTo.current = '';
    const el = wrapRef.current && wrapRef.current.querySelector(sel);
    if (!el) return;
    try { el.focus({ preventScroll: true }); } catch (_) { el.focus(); }
    if (el.scrollIntoView) el.scrollIntoView({ block: el.offsetHeight > wrapRef.current.clientHeight - 44 ? 'start' : 'nearest' });
  });

  const startEdit = (on) => {
    setEditMode(on);
    if (!on) { setEdits({}); return; }
    const e = {};
    lines.forEach(l => { if (l.asset && !l.asset.isNew) e[l.key] = { id: l.asset.id, name: l.name, room: l.room, area: l.area }; });
    setEdits(e);
  };

  // A picture is compressed once; one that cannot be read is reported, not dropped silently
  const onPhoto = async (file) => {
    const n = ++photoSeq.current;
    setPhoto(null);
    if (!file) { setPhotoName(''); setPhotoBusy(false); return; }
    setPhotoName(file.name);
    setPhotoBusy(true);
    const data = await compressImage(file);
    if (n !== photoSeq.current) return;
    setPhotoBusy(false);
    setPhoto(data);
    if (!data) { setPhotoName(''); setNote(`Could not read ${file.name} (use a JPG or PNG picture); it will not be attached.`); }
  };

  const validate = () => {
    const err = check();
    if (err && LINE_PROBLEM.test(err)) setLinesOpen(true);
    if (err && /Add the equipment it covers/.test(err)) setAddOpen(true);
    return err;
  };
  const check = () => {
    const today = toDateInput(new Date());
    if (!normalizedCode) return 'Enter a SAP order.';
    if (order && (order.status === 'loading' || order.refreshing)) return 'Still loading this SAP order. Try again in a moment.';
    if (order && order.status === 'error') return `Could not load this SAP order: ${order.error}`;
    if (!dateStr || dateStr > today || dateStr < yearBefore(today)) return 'Date must be within the last year and not in the future.';
    if (!INITIALS_RE.test(normalizeInitials(initials))) return 'Initials: letters only, up to 4 per person, separate people with "/" (e.g. EL/LH).';
    const total = parseFloat(totalHours);
    if (!(total > 0) || total > 200) return 'Enter the hours it took (greater than 0).';
    if (lines.length === 0) return 'This SAP order is not in the list. Add the equipment it covers.';
    if (lines.some(l => !excluded[l.key] && l.splitting)) return 'Add at least two pieces for the highlighted line, or choose One piece only.';
    if (lines.some(l => !excluded[l.key] && !l.asset)) return 'Choose the equipment for the highlighted line(s), or untick them.';
    if (lines.some(l => !excluded[l.key] && (!safeString(l.name) || !safeString(l.room) || !safeString(l.area)))) return 'Every equipment line needs a name, room and area. Tick Edit pre-filled details to fill in what is missing, or untick the line.';
    if (included.length === 0) return 'Nothing to log: no equipment selected.';
    const sigs = included.map(l => (l.asset.isNew ? `new|${normName(l.name)}|${normName(l.room)}|${normName(l.area)}` : l.asset.id));
    if (sigs.some((x, i) => sigs.indexOf(x) !== i)) return 'Two lines use the same equipment. Change one of them.';
    if (included.every(isDupe)) return 'Every selected equipment already has this order logged for that date.';
    if (included.some(l => !isDupe(l) && !(lineHours(l) > 0))) return 'Every selected equipment needs hours greater than 0.';
    if (Math.abs(hoursSum - total) > 0.01) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    if (lines.some(l => !l.splitting && retro[l.key] && retro[l.key].status === 'scanning')) return 'Still checking earlier entries for a changed line. Try again in a moment.';
    if (photoBusy) return 'Still preparing the paperwork picture. Try again in a moment.';
    return '';
  };

  // Write the SAP order onto an equipment's SAP row (update its frequency column, or create the row)
  const storeCode = async (asset, col, notes) => {
    const row = await store.findMsForAsset(asset);
    const existing = row && (row.codes.find(c => c.col === col) || {}).code;
    if (row && existing === normalizedCode) return;
    if (row && existing && !window.confirm(`${asset.name} already has ${existing} as its ${freqLabel(col)} code. Replace it with ${normalizedCode}?`)) {
      notes.push(`${asset.name}: kept ${existing}; ${normalizedCode} was not stored on it.`);
      return;
    }
    if (row) {
      const r = await store.writeMs(row.id, { [col]: normalizedCode }, row.assetId ? null : asset);
      if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
      return;
    }
    const r = await store.writeMs(null, { craa5_title: normalizedCode, [col]: normalizedCode, craa5_equipment: asset.name, craa5_textroom: asset.room, craa5_textarea: asset.area }, asset);
    if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
  };

  // seen: "order|date|asset" already saved by earlier rows of this submit, and "log|id" for entries this submit created or
  // moved, so two rows never log the same thing twice and no entry is moved twice
  const commit = async (seen) => {
    const notes = [];
    const info = [];
    const ini = normalizeInitials(initials);
    // 0. Earlier entries to move for changed lines: read before anything is written, and each entry claimed by one line only
    const retroRows = {};
    const claimed = new Set();
    for (const l of included) {
      const r = retro[l.key];
      if (!r || !r.apply || !r.count) continue;
      const stillUsed = !!r.from && lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === r.from.id);
      const filter = retroFilter(normalizedCode, r.from, l.ms, stillUsed);
      if (!filter) continue;
      try {
        const got = await api.query(LOG_TABLE, { select: RETRO_SELECT, filter, top: LIMITS.countCap + 1 });
        const some = got.slice(0, LIMITS.countCap);
        // Not onto equipment that already has the same order on the same day (the pieces of an order broken up earlier)
        const cov = await coveredByTarget(api, some, l.asset);
        if (cov.unchecked) { notes.push(`${l.name}: earlier entries were not moved because ${l.asset.name} has too many entries to check them against.`); continue; }
        const rows = some.filter(x => !isCovered(cov, x));
        if (rows.length < some.length) notes.push(`${l.name}: ${plural(some.length - rows.length, 'earlier entry stays', 'earlier entries stay')} where ${some.length - rows.length === 1 ? 'it is' : 'they are'} because ${l.asset.name} already has an entry for that order on the same day.`);
        retroRows[l.key] = rows.filter(x => !claimed.has(x.craa5__log_id) && !seen.has(`log|${cleanGuid(x.craa5__log_id)}`));
        retroRows[l.key].forEach(x => claimed.add(x.craa5__log_id));
        if (got.length > LIMITS.countCap) notes.push(`${l.name}: more than ${LIMITS.countCap} earlier entries; the first ${LIMITS.countCap} are moved.`);
      } catch (e) { notes.push(`${l.name}: earlier entries could not be checked (${errText(e)}).`); }
    }
    lines.forEach(l => {
      const r = retro[l.key];
      if (excluded[l.key] && !l.splitting && r && r.apply && r.count) notes.push(`${l.name}: ${plural(r.count, 'earlier entry was', 'earlier entries were')} not moved because the line is unticked.`);
    });
    // 1. Equipment edits made through "Edit pre-filled details" (only for the equipment each edit was made for)
    const edited = {};
    for (const l of lines) {
      if (excluded[l.key] || !l.asset || l.asset.isNew || !edits[l.key] || edits[l.key].id !== l.asset.id) continue;
      const a = l.asset;
      if (a.name !== l.name || a.room !== l.room || a.area !== l.area) {
        try { edited[l.key] = await store.updateAsset(a, l.name, l.room, l.area); }
        catch (e) { return { saved: 0, notes, info, error: `Could not update ${a.name}: ${errText(e)}` }; }
      }
    }
    // 2. New assets: created unless an identical one exists by now
    const resolved = {};
    for (const l of included) {
      if (!l.asset.isNew) continue;
      try { resolved[l.key] = (await store.findAssetExact(l.name, l.room, l.area)) || (await store.createAsset({ name: l.name, room: l.room, area: l.area })); }
      catch (e) { return { saved: 0, notes, info, error: `Could not create ${l.name}: ${errText(e)}` }; }
    }
    const assetOf = (l) => resolved[l.key] || edited[l.key] || l.asset;
    // Added equipment gets the SAP order stored on its SAP row
    for (const l of included.filter(x => x.extra)) {
      try { await storeCode(assetOf(l), l.col, notes); } catch (e) { notes.push(`${assetOf(l).name}: could not store the SAP order (${errText(e)}).`); }
    }
    // 3. SAP rows remember their equipment once it is certain: changed or created by hand, or a High best fit
    if (store.lookupState() !== false) {
      for (const l of included) {
        if (!l.msId) continue;
        const sure = ['changed', 'chosen', 'new asset'].includes(l.how) || (l.how === 'best fit' && l.tier === 'high' && !l.ambiguous);
        if (!sure || (l.linked && l.linked.id === assetOf(l).id)) continue;
        try {
          const r = await store.writeMs(l.msId, {}, assetOf(l));
          if (!r.linked) notes.push(`${assetOf(l).name}: the SAP row's equipment link (craa5_asset) could not be stored${r.error ? ` (${r.error})` : ''}.`);
        } catch (e) { notes.push(`${assetOf(l).name}: the SAP row's equipment link could not be stored (${errText(e)}).`); }
      }
    }
    // 4. Changed lines: move the earlier entries read in step 0 onto the chosen equipment
    for (const l of included) {
      const r = retro[l.key];
      const todo = retroRows[l.key];
      if (!r || !todo) continue;
      const target = assetOf(l);
      if (todo.length) {
        const res = await repointRows(api, todo, r.from, target);
        res.movedIds.forEach(id => seen.add(`log|${cleanGuid(id)}`));
        if (res.fixed) info.push(`Moved ${plural(res.fixed, 'earlier entry', 'earlier entries')} to ${target.name} (${placeText(target)}).`);
        if (res.failed) notes.push(`${target.name}: ${plural(res.failed, 'earlier entry', 'earlier entries')} could not be moved (${res.error}).`);
      }
      setRetro(p => ({ ...p, [l.key]: { ...p[l.key], count: 0, apply: false } }));
    }
    // 5. Skip equipment already logged for this order and date (checked again now, and against earlier rows of this submit)
    let already = dupes;
    try { already = await fetchDupes(api, normalizedCode, dateStr); } catch (_) { /* keep the check made when the order loaded */ }
    const seenKey = (id) => `${normalizedCode}|${dateStr}|${id}`;
    const toLog = included
      .filter(l => !already.has(assetOf(l).id) && !seen.has(seenKey(assetOf(l).id)))
      .map(l => { const a = assetOf(l); const fromAsset = !!resolved[l.key]; return { asset: a, name: fromAsset ? a.name : l.name, room: fromAsset ? a.room : l.room, area: fromAsset ? a.area : l.area, hours: lineHours(l) }; });
    const skipped = included.length - toLog.length;
    if (skipped) notes.push(`${plural(skipped, 'equipment', 'equipment')} skipped: already logged for this order and date.`);
    // 6. One log row per equipment
    const results = await pool(toLog, 6, (l) => api.create(LOG_TABLE, {
      craa5_equipmentguid: l.asset.id,
      craa5_equipment: l.name,
      craa5_room: l.room,
      craa5_area: l.area,
      craa5_sap: normalizedCode,
      craa5_lastcleaned: toLogDate(dateStr),
      craa5_lastcleanedby: ini,
      craa5_hoursworked: l.hours,
    }));
    const savedIds = [];
    const failedNames = [];
    results.forEach((r, i) => {
      if (r.ok) { savedIds.push(r.value); seen.add(seenKey(toLog[i].asset.id)); seen.add(`log|${cleanGuid(r.value)}`); }
      else failedNames.push(toLog[i].name);
    });
    if (savedIds.length) setDupes(prev => new Set(Array.from(prev).concat(results.map((r, i) => (r.ok ? toLog[i].asset.id : null)).filter(Boolean))));
    // The paperwork picture is compressed once and uploaded to each saved entry's file column
    if (photo && savedIds.length) {
      const fileName = `paperwork-${normalizedCode}-${dateStr}.jpg`.replace(/[^A-Za-z0-9._-]/g, '_');
      const pr = await pool(savedIds, 3, (id) => api.uploadFile(LOG_TABLE, id, PAPERWORK_COL, photo, fileName, 'image/jpeg'));
      const bad = pr.filter(r => !r.ok);
      if (bad.length) notes.push(`Entries saved, but the paperwork picture was not attached to ${bad.length === pr.length ? (pr.length === 1 ? 'it' : 'them') : plural(bad.length, 'of them', 'of them')} (${errText(bad[0].error)}). To add it, delete the entries whose Paperwork shows "none" in the Log Table and submit them again.`);
      else info.push(`Paperwork picture attached to ${plural(pr.length, 'entry', 'entries')}.`);
    }
    store.dropOrders();
    if (failedNames.length) {
      const first = results.find(r => !r.ok);
      return { saved: savedIds.length, notes, info, error: `${savedIds.length} of ${results.length} saved. Not saved: ${failedNames.join(', ')} (${errText(first.error)}). Submit again; saved equipment is skipped as already logged.` };
    }
    return { saved: savedIds.length, notes, info };
  };

  useImperativeHandle(ref, () => ({ validate, commit, getShared: () => ({ date: dateStr, initials: normalizeInitials(initials) }) }));

  // Summary values for the read-only Room / Area / Equipment fields
  const live = lines.filter(l => !excluded[l.key]);
  const summarize = (k) => { const v = Array.from(new Set(live.map(l => l[k]).filter(Boolean))); return v.length === 0 ? '' : v.length === 1 ? v[0] : `Multiple (${v.length})`; };
  const roomList = `mss-rooms-${index}`;
  const areaList = `mss-areas-${index}`;
  const addShown = addOpen === null ? isUnknown : addOpen;
  const needCount = live.filter(l => !l.asset).length;
  const dupeCount = live.filter(l => isDupe(l)).length;
  const tagClass = (k) => mergeClasses(styles.tag, k === 'ok' ? styles.tagOk : k === 'warn' ? styles.tagWarn : k === 'bad' ? styles.tagBad : k === 'info' ? styles.tagInfo : undefined);

  const renderPanel = (l) => {
    const view = panel[l.key] || 'list';
    const cands = candidatesFor(l);
    const mr = moreRank[l.key];
    const rt = retro[l.key];
    const nf = newFor[l.key] || { name: l.ms.equipment, room: l.ms.room, area: l.ms.area };
    const setNf = (k, v) => setNewFor(p => ({ ...p, [l.key]: { ...nf, [k]: v } }));
    const where = placeText(l.ms);
    // Equipment that shares a name and place with another option is told apart by its ID
    const sig = (a) => `${canonName(a.name)}|${normName(a.room)}|${normName(a.area)}`;
    const sigCount = new Map();
    uniqueById([l.asset, l.auto, ...cands.map(c => c.asset)].filter(a => a && !a.isNew)).forEach(a => sigCount.set(sig(a), (sigCount.get(sig(a)) || 0) + 1));
    const idNote = (a) => (a && !a.isNew && sigCount.get(sig(a)) > 1 ? ` · ID …${shortId(a.id)}` : '');
    return (
      <div className={styles.changePanel}>
        <Text weight="semibold" block>Equipment for “{l.ms.equipment || '(unnamed)'}”{where ? ` in ${where}` : ''}</Text>
        {l.asset
          ? <Text className={styles.hint} block>Using {l.asset.name} · {placeText(l.asset)}{idNote(l.asset)}{l.asset.isNew ? ' (new asset, created on submit)' : ''}{chosen[l.key] && l.auto ? `. Was ${l.auto.name} · ${placeText(l.auto)}${idNote(l.auto)}.` : ''}</Text>
          : <Text className={styles.hint} block>No equipment in this room and area matches well enough to pick automatically. Choose one below, search, or create a new asset.</Text>}
        {view === 'list' && (
          <div style={{ marginTop: 6 }}>
            {cands.length > 0 ? (
              <div style={{ overflowX: 'auto' }}>
                <table className={styles.linesTable} style={{ marginTop: 0 }}>
                  <tbody>
                    {cands.map(c => (
                      <tr key={c.asset.id}>
                        <td className={styles.td}><strong>{c.asset.name}</strong>{idNote(c.asset) && <span className={styles.hint}>{idNote(c.asset)}</span>}</td>
                        <td className={styles.td}>{c.asset.room}</td>
                        <td className={styles.td}>{c.asset.area}</td>
                        <td className={styles.td}><span className={tagClass(c.score >= 0.95 ? 'ok' : c.score >= 0.6 ? 'warn' : 'bad')}>{TIER_LABEL[tierOf(c.score)]} · {reasonText(c)}</span></td>
                        <td className={styles.td} style={{ textAlign: 'right' }}>
                          <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} aria-label={`Use ${c.asset.name} (${placeText(c.asset)})`} onClick={() => choose(l, c.asset)}>Use</Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : <Text className={styles.hint} block>{mr && mr.busy ? 'Looking for similar equipment…' : mr ? 'No other close matches.' : 'No other close matches yet.'}</Text>}
            {!mr && <Button size="small" style={{ marginTop: 6 }} onClick={() => rankMore(l)}>Look for similar names</Button>}
            {mr && mr.error && <Text className={styles.errorText} block role="alert">Could not look for similar equipment: {mr.error}</Text>}
          </div>
        )}
        {view === 'search' && (
          <div style={{ marginTop: 6 }}>
            <AssetPicker store={store} initialQuery={l.ms.equipment} ariaLabel={`Search equipment for ${l.ms.equipment}`} actionLabel="Use" exclude={takenIds} disabled={saving}
              onPick={(a) => { choose(l, a); setView(l, 'list'); }} />
          </div>
        )}
        {view === 'new' && (
          <div className={styles.rowFields} style={{ alignItems: 'flex-end', marginTop: 6 }}>
            <div className={styles.field}><Text className={styles.label}>Equipment name</Text><Input aria-label="New asset name" value={nf.name} onChange={(e, d) => setNf('name', d.value)} /></div>
            <div className={styles.field}><Text className={styles.label}>Room</Text><Input aria-label="New asset room" list={roomList} value={nf.room} onChange={(e, d) => { setNf('room', d.value); setTyping(t => ({ ...t, room: d.value })); }} /></div>
            <div className={styles.field}><Text className={styles.label}>Area</Text><Input aria-label="New asset area" list={areaList} value={nf.area} onChange={(e, d) => { setNf('area', d.value); setTyping(t => ({ ...t, area: d.value, roomCtx: safeString(nf.room) })); }} /></div>
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} onClick={() => useNewAsset(l)}>Use new asset</Button>
          </div>
        )}
        <div className={styles.actionBar} style={{ marginTop: 8, marginBottom: 0 }}>
          {view !== 'list' && <Button size="small" onClick={() => setView(l, 'list')}>Best fits</Button>}
          {view !== 'search' && <Button size="small" onClick={() => setView(l, 'search')}>Search all equipment</Button>}
          {view !== 'new' && <Button size="small" onClick={() => setView(l, 'new')}>Create new asset</Button>}
          <Button size="small" disabled={saving} aria-label={`Break up into pieces: ${l.ms.equipment || 'this line'}`} data-break-up={l.key} onClick={() => startBreakUp(l)}>Break up into pieces</Button>
          {chosen[l.key] && <Button size="small" disabled={saving} onClick={() => undoChoice(l)}>Undo change</Button>}
          {l.asset && <Button size="small" appearance="subtle" onClick={() => closePanel(l)}>Done</Button>}
        </div>
        {rt && (
          <div aria-live="polite" style={{ marginTop: 6 }}>
            {rt.status === 'scanning' && <Text className={styles.hint} block>Checking earlier entries of {normalizedCode}…</Text>}
            {rt.status === 'error' && <Text className={styles.errorText} block>Could not check earlier entries: {rt.error}</Text>}
            {rt.status === 'ready' && rt.count > 0 && (
              <Checkbox checked={!!rt.apply} disabled={saving} onChange={(e, d) => setRetro(p => ({ ...p, [l.key]: { ...p[l.key], apply: !!d.checked } }))}
                label={`On submit, also move ${rt.count}${rt.more ? '+' : ''} earlier ${rt.count === 1 && !rt.more ? 'entry' : 'entries'} for this line${rt.from ? ` (saved to ${rt.from.name} · ${placeText(rt.from)}, or with no equipment ID)` : ' (saved with no equipment ID)'} to ${l.asset ? l.asset.name : 'the chosen equipment'}.`} />
            )}
            {rt.status === 'ready' && rt.skipped > 0 && (
              <Text className={styles.hint} block>
                {plural(rt.skipped, 'earlier entry stays', 'earlier entries stay')} where {rt.skipped === 1 ? 'it is' : 'they are'}: {l.asset ? l.asset.name : 'the chosen equipment'} already has an entry for that order on the same day.
                {rt.count > 0 ? ' This order looks logged piece by piece, so the box above is not ticked: tick it only if those entries really belong to this equipment.' : ''}
              </Text>
            )}
            {rt.status === 'ready' && !rt.count && <Text className={styles.hint} block>No earlier entries need correcting.</Text>}
          </div>
        )}
      </div>
    );
  };

  // The pieces of a SAP row being broken up: a hint, the pieces so far, and a search to add more
  const renderSplit = (key) => {
    const e = matches.find(x => x.key === key);
    if (!e) return null;
    const ms = { equipment: e.equipment, room: e.room, area: e.area };
    const list = pieces[key] || [];
    const taken = takenFor(key);
    const hint = hints[key];
    const found = hint && hint.status === 'ready' ? hint.found : null;
    const unused = found ? found.assets.filter(a => !list.some(x => x.id === a.id)) : [];   // suggested, not among the pieces yet
    const onOther = unused.filter(a => taken.has(a.id));                                      // ...and used by another line
    const where = placeText(ms);
    const seen = wrapRef.current ? wrapRef.current.clientWidth : 0;                          // the box stays at the left edge, so it must fit the visible width
    const boxW = seen ? Math.max(260, Math.min(640, seen - 24)) : 640;
    return (
      <div className={styles.changePanel} style={{ position: 'sticky', left: 0, width: boxW, boxSizing: 'border-box' }} data-split={key} tabIndex={-1} role="group" aria-label={`Pieces of ${ms.equipment || 'this line'}`}>
        <Text weight="semibold" block>Break up “{ms.equipment || '(unnamed)'}”{where ? ` in ${where}` : ''} into pieces</Text>
        <Text className={styles.hint} block>Each piece gets its own entry with the same date, SAP order and initials, saved to that equipment. The hours of this line are shared out among its pieces. Nothing is saved until you submit.</Text>
        <div aria-live="polite">
          {hint && hint.status === 'busy' && <Text className={styles.hint} block>Looking for the pieces…</Text>}
          {hint && hint.status === 'error' && list.length < 2 && <Text className={styles.errorText} block role="alert">Could not look for the pieces: {hint.error}. Search below to add them.</Text>}
          {hint && hint.status === 'ready' && !found && list.length === 0 && <Text className={styles.hint} block>No pieces were found for this line. Search below to add them.</Text>}
          {unused.length > 0 && (
            <div className={styles.hint} style={{ marginTop: 4 }}>
              {found.how === 'text' ? 'This line lists several things. Found: ' : 'Equipment here that starts with this name: '}<strong>{found.assets.map(a => a.name).join(', ')}</strong>.
              {onOther.length > 0 && ` ${onOther.map(a => a.name).join(', ')} ${onOther.length === 1 ? 'is' : 'are'} already on another line of this order.`}
              {' '}
              {unused.length > onOther.length && <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} aria-label={`Use these pieces for ${ms.equipment || 'this line'}`} onClick={() => addFound(key, found)}>Use these pieces</Button>}
            </div>
          )}
        </div>
        <div style={{ marginTop: 6 }}>
          <PiecesEditor store={store} g={ms} list={list} missing={found ? found.missing : []} taken={taken} disabled={saving}
            onChange={(next) => setPiecesFor(key, next)} onDone={() => { focusTo.current = `[data-edit-pieces="${key}"]`; closeSplit(key); }} />
        </div>
      </div>
    );
  };

  return (
    <div className={styles.rowCard}>
      <div className={styles.rowFields}>
        <div className={styles.field}>
          <Text className={styles.label}>SAP Order (Req)</Text>
          <Input
            data-row={index}
            data-col="sap"
            aria-label="SAP order"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded={listOpen}
            aria-controls={listOpen ? listId : undefined}
            aria-activedescendant={listOpen ? `${listId}-opt-${hiIndex}` : undefined}
            autoComplete="off"
            placeholder="Start typing the SAP order…"
            value={code}
            disabled={saving}
            style={{ minWidth: '210px' }}
            onChange={(e, d) => { setCode(d.value); setShowSuggest(true); setHi(0); clearOrderState(); }}
            onFocus={() => setShowSuggest(true)}
            onBlur={() => setTimeout(() => setShowSuggest(false), 150)}
            onKeyDown={(e) => {
              if (e.key === 'ArrowDown' && !showSuggest) { e.preventDefault(); setShowSuggest(true); }
              else if (listOpen && e.key === 'ArrowDown') { e.preventDefault(); setHi(h => Math.min(h + 1, suggestions.length - 1)); }
              else if (listOpen && e.key === 'ArrowUp') { e.preventDefault(); setHi(h => Math.max(h - 1, 0)); }
              else if (e.key === 'Enter' && suggestOpen && sugg.busy) e.preventDefault(); // wait for the search to finish
              else if (listOpen && e.key === 'Enter') { e.preventDefault(); selectCode(suggestions[hiIndex].code); }
              else if (e.key === 'Escape') setShowSuggest(false);
              else if (e.key === 'Enter') { e.preventDefault(); setShowSuggest(false); onEnter(index); }
            }}
          />
          {suggestOpen && (
            <div className={styles.suggest}>
              {suggestions.length > 0 && (
                <div className={styles.suggestList} role="listbox" id={listId} aria-label="Matching SAP orders" ref={listRef}>
                  {suggestions.map((s, i) => (
                    <button key={s.code} id={`${listId}-opt-${i}`} type="button" role="option" tabIndex={-1} aria-selected={i === hiIndex} className={styles.suggestItem}
                      style={i === hiIndex ? { backgroundColor: '#E6F1FC' } : undefined}
                      onMouseDown={(e) => e.preventDefault()} onClick={() => selectCode(s.code)}>
                      <span><strong>{s.code}</strong>{s.names && <span className={styles.hint}> · {s.names}{s.count > 2 ? '…' : ''}</span>}</span>
                      <span className={styles.hint}>{s.count}{sugg.truncated ? '+' : ''} equipment</span>
                    </button>
                  ))}
                </div>
              )}
              <div aria-live="polite">
                {sugg.busy && <div className={styles.suggestNote}>Searching…</div>}
                {sugg.error && <div className={styles.suggestNote} style={{ color: BRAND.redText }}>Search failed: {sugg.error}</div>}
                {!sugg.busy && !sugg.error && suggestions.length === 0 && <div className={styles.suggestNote}>No SAP orders match “{normalizedCode}”.</div>}
                {!sugg.busy && sugg.truncated && <div className={styles.suggestNote}>Many matches. Keep typing to narrow the list.</div>}
              </div>
            </div>
          )}
          {matches.length > 0 && lines.length > 0 && (
            <Checkbox label={<Text size={200}>Edit pre-filled details</Text>} checked={editMode} disabled={saving} onChange={(e, d) => startEdit(!!d.checked)} />
