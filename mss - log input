      }
      const returned = !pick && e.how === 'same as another line';
      out.push({
        key: e.key, msId: e.msId, col: e.col, how: pick ? (pick.isNew ? 'new asset' : e.asset ? 'changed' : 'chosen') : returned ? 'best fit' : e.how,
        tier: pick ? 'manual' : returned ? 'medium' : e.tier, ambiguous: returned || (!pick && !!e.ambiguous), reason: pick ? '' : e.reason, returned,
        asset, auto: e.asset || null, linked: e.linked || null, ranked: e.ranked || [], partial: !!e.partial,
