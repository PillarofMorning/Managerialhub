            {found.capped ? ` Only the first ${LIMITS.unifyAssets} records were checked; pick a room/area to check the rest.` : ''}
          </Text>
          {found.clusters.length > 0 && (
            <>
              <div className={styles.actionBar}>
                <Checkbox label="Also point SAP orders at the kept record" checked={moveLinks} disabled={!!busy} onChange={(e, d) => setMoveLinks(!!d.checked)} />
                <Checkbox label="Also give the kept ID to entries of these names here with no ID or a deleted ID" checked={fillBlank} disabled={!!busy} onChange={(e, d) => setFillBlank(!!d.checked)} />
                <Checkbox label="Sync moved entries' Room, Area & Equipment text to kept record" checked={syncText} disabled={!!busy} onChange={(e, d) => setSyncText(!!d.checked)} />
