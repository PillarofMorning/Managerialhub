        window.localStorage.setItem(SKIP_HISTORY_STORAGE_KEY, JSON.stringify(next));
      } catch (_) {}
      if (api.mode === 'dataverse' || api.mode === 'live') {
        (async () => {
          try {
            const rows = await cfgFindRows(api, HUB_CONFIG_SKIPPED_LOG_KEY);
            let merged = next;
            if (rows && rows[0] && hubConfigJsonOf(rows[0])) {
              try {
                const remote = JSON.parse(hubConfigJsonOf(rows[0]));
                if (Array.isArray(remote)) merged = next.concat(remote).slice(0, 300);
              } catch (_) {}
