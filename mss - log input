    const q = safeString(questionText || botInput);
    if (!q) return;
    const low = q.toLowerCase();
    let best = null;
    let bestScore = 0;
    MANUAL_BOT_QA.forEach(item => {
      const score = item.keywords.reduce((acc, kw) => (low.includes(kw) ? acc + 2 : acc), 0);
      if (score > bestScore) {
        bestScore = score;
        best = item;
      }
    });
    const refMatches = MANUAL_REFERENCE_ITEMS.filter(r =>
      r.name.toLowerCase().includes(low) || r.desc.toLowerCase().includes(low) || r.topic.toLowerCase().includes(low)
    );
    let replyTitle = 'Step-by-Step Answer';
    let replyText = '';
    let targetScreen = slideIdx;
    if (best) {
      replyTitle = best.title;
      replyText = best.answer;
      targetScreen = best.screenIdx;
