import React, { useState, useMemo, useEffect, useRef, useCallback } from 'react';

/*
  =============================================================================
  === MSS LOG INPUT (SAP ORDER FORM) ===
  Admins type a SAP order code. The form looks it up in craa5_aa_ms_assets
  (the SAP-code store, one row per equipment with one column per frequency),
  resolves each row to its craa5_aa_assets record, and shows the equipment to
  be logged. The admin enters who completed it (initials for now) and the hours;
  one craa5__log_ row is written per equipment, which `mss - calendar` reads.

  Log payload (craa5__log_), no new Dataverse columns:
    craa5_equipmentguid     = craa5_aa_assetsid  (the key the calendar matches on)
    craa5_equipment         = equipment name     (display copy only)
    craa5_room / craa5_area = copied from the asset (display copy only)
    craa5_sap               = the SAP code that was entered
    craa5_lastcleaned       = completion date, midnight UTC
    craa5_lastcleanedby     = initials, upper-case, "/" separated
    craa5_hoursworked       = number (total hours split across the equipment)

  Unknown SAP code: the admin picks existing equipment or registers new
  equipment (craa5_aa_assets), then the code is stored on craa5_aa_ms_assets so
  the next order autocompletes.
  =============================================================================
*/

// --- SCHEMA CONSTANTS ---
const LOG_TABLE = 'craa5__log_';
const ASSET_TABLE = 'craa5_aa_assets';
const ASSET_SET = 'craa5_aa_assetses';
const MS_TABLE = 'craa5_aa_ms_assets';

const FREQUENCIES = [
  { col: 'craa5_sapdaily', label: 'Daily' },
  { col: 'craa5_sapw', label: 'Weekly' },
  { col: 'craa5_sapmonthly', label: 'Monthly' },
  { col: 'craa5_saptwomonth', label: '2-Month' },
  { col: 'craa5_sapquarterly', label: 'Quarterly' },
  { col: 'craa5_sapsixmonth', label: '6-Month' },
  { col: 'craa5_sapannual', label: 'Annual' },
  { col: 'craa5_sapshift', label: 'Shift' },
];
const CODE_COLS = [...FREQUENCIES.map(f => f.col), 'craa5_title', 'craa5_olduid'];
const freqLabel = (col) => (FREQUENCIES.find(f => f.col === col) || {}).label || 'ID';

// --- HELPERS ---
const safeString = (v) => (v === null || v === undefined ? '' : String(v).trim());
const normCode = (s) => safeString(s).toUpperCase().replace(/\s+/g, '');
const normName = (s) => safeString(s).toLowerCase().replace(/[^a-z0-9]/g, '');
const escOData = (s) => String(s).replace(/'/g, "''");

const toDateInput = (d) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
};
// Date-only value stored as midnight UTC, the same shape as the existing log rows.
const toLogDate = (dateStr) => `${dateStr}T00:00:00Z`;
const nextDay = (dateStr) => {
  const d = new Date(`${dateStr}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + 1);
  return d.toISOString().slice(0, 10);
};

const normalizeInitials = (s) =>
  safeString(s).toUpperCase().replace(/[\s,&+]+/g, '/').replace(/\/+/g, '/').replace(/^\/|\/$/g, '');
const INITIALS_RE = /^[A-Z]{1,4}(\/[A-Z]{1,4})*$/;

const splitHours = (total, n) => {
  if (!n || !(total > 0)) return [];
  const each = Math.floor((total / n) * 100) / 100;
  const out = Array(n).fill(each);
  out[n - 1] = Math.round((total - each * (n - 1)) * 100) / 100;
  return out;
};

const errText = (e) => (e && (e.message || e.raw?.message || e.error?.message)) || 'Unknown error';

// --- DATA ACCESS (Xrm.WebApi, Power Apps dataApi, or an in-memory preview) ---
const makeMock = () => {
  const today = toDateInput(new Date());
  const db = {
    [ASSET_TABLE]: [
      { craa5_aa_assetsid: 'a-1', craa5_equipmentidentifier: 'Mixer 01', craa5_roomname: 'Kitchen', craa5_areaname: 'South' },
      { craa5_aa_assetsid: 'a-2', craa5_equipmentidentifier: 'Oven 05', craa5_roomname: 'Kitchen', craa5_areaname: 'South' },
      { craa5_aa_assetsid: 'a-3', craa5_equipmentidentifier: 'Slicer 12', craa5_roomname: 'Deli', craa5_areaname: 'Front' },
      { craa5_aa_assetsid: 'a-4', craa5_equipmentidentifier: 'Pallets', craa5_roomname: 'Creme', craa5_areaname: 'IBL4' },
      { craa5_aa_assetsid: 'a-5', craa5_equipmentidentifier: 'Racking', craa5_roomname: 'Creme', craa5_areaname: 'IBL4' },
    ],
    [MS_TABLE]: [
      { craa5_aa_ms_assetsid: 'm-1', craa5_title: 'SSANKSMIX', craa5_sapdaily: 'SSANKSMIX', craa5_sapw: 'SSANKSMIXW', craa5_equipment: 'Mixer 01', craa5_textroom: 'Kitchen', craa5_textarea: 'South', _craa5_asset_value: 'a-1' },
      { craa5_aa_ms_assetsid: 'm-2', craa5_title: 'SSANIBL4PSW', craa5_sapw: 'SSANIBL4PSW', craa5_equipment: 'Pallets', craa5_textroom: 'Creme', craa5_textarea: 'IBL4', _craa5_asset_value: 'a-4' },
      { craa5_aa_ms_assetsid: 'm-3', craa5_title: 'SSANIBL4PSW', craa5_sapw: 'SSANIBL4PSW', craa5_equipment: 'Racking', craa5_textroom: 'Creme', craa5_textarea: 'IBL4', _craa5_asset_value: null },
      { craa5_aa_ms_assetsid: 'm-4', craa5_title: 'SSANTEMPRW', craa5_sapw: 'SSANTEMPRW', craa5_equipment: 'Floors', craa5_textroom: 'Temp', craa5_textarea: 'Hall', _craa5_asset_value: null },
    ],
    [LOG_TABLE]: [
      { craa5__log_id: 'l-0', craa5_equipmentguid: 'a-1', craa5_equipment: 'Mixer 01', craa5_sap: 'SSANKSMIX', craa5_lastcleaned: `${today}T00:00:00Z`, craa5_lastcleanedby: 'ES', craa5_hoursworked: 1 },
    ],
  };
  let n = 100;
  return {
    mode: 'preview',
    async query(table, { filter } = {}) {
      let rows = db[table] || [];
      if (table === LOG_TABLE && filter && /craa5_sap eq '([^']*)'/.test(filter)) {
        const sap = filter.match(/craa5_sap eq '([^']*)'/)[1];
        const d = filter.match(/ge (\d{4}-\d{2}-\d{2})/)[1];
        rows = rows.filter(r => r.craa5_sap === sap && String(r.craa5_lastcleaned).startsWith(d));
      }
      return rows.map(r => ({ ...r }));
    },
    async create(table, payload) {
      const idKey = table === LOG_TABLE ? 'craa5__log_id' : table === ASSET_TABLE ? 'craa5_aa_assetsid' : 'craa5_aa_ms_assetsid';
      const id = `new-${n++}`;
      const row = { ...payload, [idKey]: id };
      const bind = payload['craa5_asset@odata.bind'];
      if (bind) row._craa5_asset_value = bind.match(/\(([^)]+)\)/)[1];
      db[table].push(row);
      return id;
    },
    async update(table, id, payload) {
      const row = (db[table] || []).find(r => Object.values(r).includes(id));
      if (row) Object.assign(row, payload);
    },
  };
};

const makeApi = (dataApi) => {
  if (typeof Xrm !== 'undefined' && Xrm.WebApi) {
    return {
      mode: 'dataverse',
      async query(table, { select, filter, top } = {}) {
        const parts = [];
        if (select) parts.push(`$select=${select.join(',')}`);
        if (filter) parts.push(`$filter=${filter}`);
        if (top) parts.push(`$top=${top}`);
        let res = await Xrm.WebApi.retrieveMultipleRecords(table, parts.length ? `?${parts.join('&')}` : '');
        let all = res.entities || [];
        while (res.nextLink && !top) {
          res = await Xrm.WebApi.retrieveMultipleRecords(table, `?${res.nextLink.split('?')[1]}`);
          all = all.concat(res.entities || []);
        }
        return all;
      },
      async create(table, payload) { return (await Xrm.WebApi.createRecord(table, payload)).id; },
      async update(table, id, payload) { await Xrm.WebApi.updateRecord(table, id, payload); },
    };
  }
  if (dataApi) {
    return {
      mode: 'dataverse',
      async query(table, { select, filter, top } = {}) {
        const res = await dataApi.queryTable(table, { select, filter, pageSize: top || 5000 });
        return res?.rows ?? [];
      },
      async create(table, payload) {
        const res = await dataApi.createRow(table, payload);
        return res?.id ?? res?.[`${table}id`] ?? res;
      },
      async update(table, id, payload) { await dataApi.updateRow(table, id, payload); },
    };
  }
  return makeMock();
};

const compressImage = (file) => new Promise((resolve) => {
  const reader = new FileReader();
  reader.onload = (e) => {
    const img = new Image();
    img.onload = () => {
      const scale = Math.min(1, 1000 / Math.max(img.width, img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * scale);
      c.height = Math.round(img.height * scale);
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      resolve(c.toDataURL('image/jpeg', 0.7).split(',')[1]);
    };
    img.onerror = () => resolve(null);
    img.src = e.target.result;
  };
  reader.onerror = () => resolve(null);
  reader.readAsDataURL(file);
});

// --- COMPONENT ---
export default function App({ dataApi } = {}) {
  const api = useMemo(() => makeApi(dataApi), [dataApi]);
  const maxDate = useMemo(() => toDateInput(new Date()), []);
  const minDate = useMemo(() => { const d = new Date(); d.setFullYear(d.getFullYear() - 1); return toDateInput(d); }, []);

  const [assets, setAssets] = useState([]);
  const [msRows, setMsRows] = useState([]);
  const [recent, setRecent] = useState([]);
  const [loading, setLoading] = useState(false);
  const [loadError, setLoadError] = useState('');

  const [code, setCode] = useState('');
  const [showSuggest, setShowSuggest] = useState(false);
  const [dateStr, setDateStr] = useState(maxDate);
  const [initials, setInitials] = useState('');
  const [totalHours, setTotalHours] = useState('');
  const [photo, setPhoto] = useState(null);
  const [photoName, setPhotoName] = useState('');

  const [excluded, setExcluded] = useState({});       // lineKey -> true
  const [pickedAsset, setPickedAsset] = useState({});  // lineKey -> assetId (manual match)
  const [hoursOverride, setHoursOverride] = useState({}); // lineKey -> number
  const [dupes, setDupes] = useState(new Set());       // assetIds already logged for code+date

  // Registration of an unknown code
  const [regMode, setRegMode] = useState('existing');  // existing | new
  const [regFreq, setRegFreq] = useState('craa5_sapw');
  const [regAssetId, setRegAssetId] = useState('');
  const [regRoom, setRegRoom] = useState('');
  const [regArea, setRegArea] = useState('');
  const [regName, setRegName] = useState('');
  const [assetSearch, setAssetSearch] = useState('');

  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState(null); // { kind: 'ok' | 'warn' | 'error', text }
  const codeRef = useRef(null);

  // --- LOAD ---
  const loadAll = useCallback(async () => {
    setLoading(true);
    setLoadError('');
    try {
      const [a, m, l] = await Promise.all([
        api.query(ASSET_TABLE, { select: ['craa5_aa_assetsid', 'craa5_equipmentidentifier', 'craa5_roomname', 'craa5_areaname'] }),
        api.query(MS_TABLE),
        api.query(LOG_TABLE, { select: ['craa5__log_id', 'craa5_equipment', 'craa5_sap', 'craa5_lastcleaned', 'craa5_lastcleanedby', 'craa5_hoursworked'], top: 15 }),
      ]);
      setAssets(a.map(r => ({
        id: r.craa5_aa_assetsid,
        name: safeString(r.craa5_equipmentidentifier),
        room: safeString(r.craa5_roomname),
        area: safeString(r.craa5_areaname),
      })));
      setMsRows(m.map(r => ({
        id: r.craa5_aa_ms_assetsid,
        equipment: safeString(r.craa5_equipment),
        room: safeString(r.craa5_textroom),
        area: safeString(r.craa5_textarea),
        assetId: r._craa5_asset_value || null,
        codes: CODE_COLS.map(col => ({ col, code: normCode(r[col]) })).filter(c => c.code),
      })));
      setRecent(l);
    } catch (e) {
      setLoadError(errText(e));
    } finally {
      setLoading(false);
    }
  }, [api]);

  useEffect(() => { loadAll(); }, [loadAll]);

  // --- INDEXES ---
  const assetById = useMemo(() => new Map(assets.map(a => [a.id, a])), [assets]);
  const assetsByName = useMemo(() => {
    const m = new Map();
    assets.forEach(a => { const k = normName(a.name); if (!m.has(k)) m.set(k, []); m.get(k).push(a); });
    return m;
  }, [assets]);
  const codeIndex = useMemo(() => {
    const m = new Map();
    msRows.forEach(r => r.codes.forEach(c => {
      if (!m.has(c.code)) m.set(c.code, []);
      m.get(c.code).push({ row: r, col: c.col });
    }));
    return m;
  }, [msRows]);

  const rooms = useMemo(() => [...new Set(assets.map(a => a.room).filter(Boolean))].sort(), [assets]);
  const areas = useMemo(() => [...new Set(assets.map(a => a.area).filter(Boolean))].sort(), [assets]);

  const normalizedCode = normCode(code);
  const matches = normalizedCode ? codeIndex.get(normalizedCode) || [] : [];

  const suggestions = useMemo(() => {
    if (normalizedCode.length < 2) return [];
    const out = [];
    for (const [c, list] of codeIndex) {
      if (c.includes(normalizedCode)) out.push({ code: c, count: new Set(list.map(x => x.row.id)).size });
      if (out.length >= 8) break;
    }
    return out;
  }, [normalizedCode, codeIndex]);

  // --- LINES: one per equipment on the order ---
  const lines = useMemo(() => {
    const seen = new Set();
    const out = [];
    matches.forEach(({ row, col }) => {
      const key = row.id;
      let asset = row.assetId ? assetById.get(row.assetId) : null;
      let how = asset ? 'linked' : '';
      if (!asset && pickedAsset[key]) { asset = assetById.get(pickedAsset[key]); how = 'picked'; }
      if (!asset) {
        const cands = (assetsByName.get(normName(row.equipment)) || [])
          .filter(a => !row.room || normName(a.room) === normName(row.room));
        if (cands.length === 1) { asset = cands[0]; how = 'matched by name'; }
      }
      if (asset) {
        if (seen.has(asset.id)) return;
        seen.add(asset.id);
      }
      out.push({
        key, msId: row.id, col, how,
        asset,
        name: asset ? asset.name : row.equipment,
        room: asset ? asset.room : row.room,
        area: asset ? asset.area : row.area,
      });
    });
    return out;
  }, [matches, assetById, assetsByName, pickedAsset]);

  const included = lines.filter(l => !excluded[l.key] && l.asset);
  const evenHours = useMemo(() => {
    const free = included.filter(l => hoursOverride[l.key] === undefined);
    const fixed = included.reduce((s, l) => s + (hoursOverride[l.key] ?? 0), 0);
    const split = splitHours((parseFloat(totalHours) || 0) - fixed, free.length);
    const map = {};
    free.forEach((l, i) => { map[l.key] = split[i] ?? 0; });
    return map;
  }, [included, hoursOverride, totalHours]);
  const lineHours = (l) => hoursOverride[l.key] ?? evenHours[l.key] ?? 0;
  const hoursSum = Math.round(included.reduce((s, l) => s + lineHours(l), 0) * 100) / 100;

  // Duplicate check: same code + date + asset already in the log
  useEffect(() => {
    setDupes(new Set());
    if (!matches.length || !dateStr) return;
    let cancelled = false;
    api.query(LOG_TABLE, {
      select: ['craa5_equipmentguid'],
      filter: `craa5_sap eq '${escOData(normalizedCode)}' and craa5_lastcleaned ge ${dateStr}T00:00:00Z and craa5_lastcleaned lt ${nextDay(dateStr)}T00:00:00Z`,
    }).then(rows => { if (!cancelled) setDupes(new Set(rows.map(r => r.craa5_equipmentguid))); })
      .catch(() => {});
    return () => { cancelled = true; };
  }, [api, normalizedCode, dateStr, matches.length]);

  const isUnknown = normalizedCode.length >= 3 && matches.length === 0;
  const assetChoices = useMemo(() => {
    const q = normName(assetSearch);
    return assets
      .filter(a => !q || normName(`${a.room}${a.area}${a.name}`).includes(q))
      .slice(0, 50);
  }, [assets, assetSearch]);

  const resetOrder = () => {
    setCode(''); setTotalHours(''); setPhoto(null); setPhotoName('');
    setExcluded({}); setPickedAsset({}); setHoursOverride({});
    setRegAssetId(''); setRegName(''); setAssetSearch('');
    setTimeout(() => codeRef.current && codeRef.current.focus(), 0);
  };

  const onPhoto = async (file) => {
    if (!file) { setPhoto(null); setPhotoName(''); return; }
    setPhotoName(file.name);
    setPhoto(await compressImage(file));
  };

  // --- VALIDATION ---
  const validate = () => {
    if (!normalizedCode) return 'Enter a SAP order.';
    if (!dateStr || dateStr > maxDate || dateStr < minDate) return 'Date must be within the last year and not in the future.';
    const ini = normalizeInitials(initials);
    if (!INITIALS_RE.test(ini)) return 'Initials: letters only, up to 4 per person, separate people with "/" (e.g. EL/LH).';
    const total = parseFloat(totalHours);
    if (!(total > 0) || total > 200) return 'Enter the hours it took (greater than 0).';
    if (isUnknown) {
      if (regMode === 'existing' && !regAssetId) return 'Pick the equipment this SAP order belongs to.';
      if (regMode === 'new' && (!regRoom.trim() || !regArea.trim() || !regName.trim())) return 'Enter room, area and equipment name for the new equipment.';
      return '';
    }
    if (lines.some(l => !excluded[l.key] && !l.asset)) return 'Pick the equipment for the highlighted line(s), or remove them.';
    if (included.length === 0) return 'Nothing to log: no equipment selected.';
    if (included.every(l => dupes.has(l.asset.id))) return 'Every selected equipment already has this order logged for that date.';
    if (Math.abs(hoursSum - total) > 0.01) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    return '';
  };

  // --- SAVE ---
  const linkMsRow = async (msPayload, assetId) => {
    try {
      await api.create(MS_TABLE, { ...msPayload, 'craa5_asset@odata.bind': `/${ASSET_SET}(${assetId})` });
      return true;
    } catch (_) {
      await api.create(MS_TABLE, msPayload);
      return 'unlinked';
    }
  };

  const submit = async () => {
    const problem = validate();
    if (problem) { setMessage({ kind: 'error', text: problem }); return; }
    setSaving(true);
    setMessage(null);
    const notes = [];
    try {
      const ini = normalizeInitials(initials);
      const total = parseFloat(totalHours);
      let toLog;

      if (isUnknown) {
        // Register the code so the next order autocompletes, creating the equipment if it is new.
        let asset;
        if (regMode === 'new') {
          const id = await api.create(ASSET_TABLE, {
            craa5_equipmentidentifier: regName.trim(),
            craa5_roomname: regRoom.trim(),
            craa5_areaname: regArea.trim(),
          });
          asset = { id, name: regName.trim(), room: regRoom.trim(), area: regArea.trim() };
        } else {
          asset = assetById.get(regAssetId);
        }
        const linked = await linkMsRow({
          craa5_title: normalizedCode,
          [regFreq]: normalizedCode,
          craa5_equipment: asset.name,
          craa5_textroom: asset.room,
          craa5_textarea: asset.area,
        }, asset.id);
        if (linked === 'unlinked') notes.push('The SAP code was saved without its equipment lookup (craa5_asset); link it in Dataverse.');
        toLog = [{ asset, hours: total }];
      } else {
        toLog = included
          .filter(l => !dupes.has(l.asset.id))
          .map(l => ({ asset: l.asset, hours: lineHours(l), msId: l.msId, how: l.how, col: l.col }));
        const skipped = included.length - toLog.length;
        if (skipped) notes.push(`${skipped} equipment skipped: already logged for this order and date.`);
        // Write the asset link back to SAP code rows that were only matched by name or picked by hand.
        for (const l of toLog) {
          if (l.how === 'matched by name' || l.how === 'picked') {
            try { await api.update(MS_TABLE, l.msId, { 'craa5_asset@odata.bind': `/${ASSET_SET}(${l.asset.id})` }); }
            catch (_) { notes.push(`Could not store the equipment link for ${l.asset.name} on the SAP code row.`); }
          }
        }
      }

      const results = await Promise.allSettled(toLog.map(l => api.create(LOG_TABLE, {
        craa5_equipmentguid: l.asset.id,
        craa5_equipment: l.asset.name,
        craa5_room: l.asset.room,
        craa5_area: l.asset.area,
        craa5_sap: normalizedCode,
        craa5_lastcleaned: toLogDate(dateStr),
        craa5_lastcleanedby: ini,
        craa5_hoursworked: l.hours,
      })));
      const failed = results.filter(r => r.status === 'rejected');
      const savedIds = results.map(r => (r.status === 'fulfilled' ? r.value : null));

      if (photo && savedIds.some(Boolean)) {
        try {
          await Promise.all(savedIds.filter(Boolean).map(id => api.update(LOG_TABLE, id, { craa5_pictureorfileofpaperwork: photo })));
        } catch (_) {
          notes.push('Entries saved, but the paperwork photo could not be attached.');
        }
      }

      if (failed.length) {
        setMessage({ kind: 'error', text: `${results.length - failed.length} of ${results.length} saved. Failed: ${errText(failed[0].reason)}. Review the order and submit again; saved equipment is skipped as already logged.` });
      } else {
        setMessage({ kind: notes.length ? 'warn' : 'ok', text: `Logged ${results.length} equipment for ${normalizedCode} on ${dateStr}.${notes.length ? ' ' + notes.join(' ') : ''}` });
        resetOrder();
      }
      await loadAll();
    } catch (e) {
      setMessage({ kind: 'error', text: `Save failed: ${errText(e)}` });
    } finally {
      setSaving(false);
    }
  };

  // --- RENDER ---
  const ini = normalizeInitials(initials);
  const toLogCount = included.filter(l => !dupes.has(l.asset.id)).length;
  return (
    <div className="mli">
      <style>{`
        .mli { font-family: "Segoe UI", system-ui, sans-serif; color: #0f172a; background: #f1f5f9; min-height: 100vh; box-sizing: border-box; padding: 16px; }
        .mli * { box-sizing: border-box; }
        .mli-wrap { max-width: 980px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
        .mli-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .mli-head h1 { margin: 0; font-size: 20px; font-weight: 800; }
        .mli-sub { font-size: 12px; color: #64748b; }
        .mli-card { background: #fff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 16px; box-shadow: 0 2px 6px rgba(0,0,0,.05); }
        .mli-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 12px; align-items: end; }
        .mli-field { display: flex; flex-direction: column; gap: 4px; position: relative; min-width: 0; }
        .mli-field label { font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .4px; }
        .mli input[type=text], .mli input[type=date], .mli input[type=number], .mli select { font: inherit; font-size: 14px; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; width: 100%; min-width: 0; }
        .mli input:focus, .mli select:focus { outline: 2px solid #2563eb; outline-offset: -1px; border-color: #2563eb; }
        .mli-code { font-size: 16px !important; font-weight: 700; letter-spacing: .5px; }
        .mli-suggest { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; margin-top: 2px; box-shadow: 0 8px 16px rgba(0,0,0,.12); max-height: 260px; overflow: auto; }
        .mli-suggest button { display: flex; justify-content: space-between; width: 100%; padding: 8px 10px; border: 0; background: none; font: inherit; font-size: 13px; cursor: pointer; text-align: left; }
        .mli-suggest button:hover, .mli-suggest button:focus { background: #eff6ff; }
        .mli-suggest small { color: #64748b; }
        .mli table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .mli th { text-align: left; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; padding: 6px 8px; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
        .mli td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
        .mli tr.mli-warn td { background: #fffbeb; }
        .mli tr.mli-off td { color: #94a3b8; }
        .mli td input[type=number] { width: 80px; padding: 4px 6px; }
        .mli-tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 10px; background: #e2e8f0; color: #475569; white-space: nowrap; }
        .mli-tag.ok { background: #d1fae5; color: #065f46; }
        .mli-tag.warn { background: #fef3c7; color: #92400e; }
        .mli-btn { font: inherit; font-size: 14px; font-weight: 700; padding: 10px 20px; border-radius: 6px; border: 1px solid #2563eb; background: #2563eb; color: #fff; cursor: pointer; }
        .mli-btn:disabled { background: #94a3b8; border-color: #94a3b8; cursor: not-allowed; }
        .mli-btn.ghost { background: #fff; color: #2563eb; padding: 6px 12px; font-size: 12px; }
        .mli-msg { padding: 10px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; }
        .mli-msg.ok { background: #d1fae5; color: #065f46; }
        .mli-msg.warn { background: #fef3c7; color: #92400e; }
        .mli-msg.error { background: #fee2e2; color: #991b1b; }
        .mli-section { margin-top: 16px; }
        .mli-section h2 { margin: 0 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; color: #475569; }
        .mli-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
        .mli-row > .mli-field { flex: 1 1 160px; }
        .mli-foot { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
        .mli-hint { font-size: 12px; color: #64748b; }
        @media (max-width: 720px) { .mli-grid { grid-template-columns: 1fr 1fr; } .mli-grid > .mli-field:first-child { grid-column: 1 / -1; } }
      `}</style>

      <div className="mli-wrap">
        <div className="mli-head">
          <h1>MSS Log Input</h1>
          <div className="mli-sub">
            {loading ? 'Loading…' : `${assets.length} equipment · ${codeIndex.size} SAP codes`}
            {api.mode === 'preview' && ' · preview data (no Dataverse connection)'}
            {' '}<button className="mli-btn ghost" onClick={loadAll} disabled={loading}>Reload</button>
          </div>
        </div>

        {loadError && <div className="mli-msg error">Could not load Dataverse data: {loadError}</div>}

        <div className="mli-card">
          <div className="mli-grid">
            <div className="mli-field">
              <label htmlFor="mli-code">SAP order</label>
              <input id="mli-code" ref={codeRef} type="text" className="mli-code" autoComplete="off" autoFocus
                placeholder="Type or paste the SAP order"
                value={code}
                onChange={e => { setCode(e.target.value); setShowSuggest(true); setExcluded({}); setPickedAsset({}); setHoursOverride({}); }}
                onFocus={() => setShowSuggest(true)}
                onBlur={() => setTimeout(() => setShowSuggest(false), 150)} />
              {showSuggest && suggestions.length > 0 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode) && (
                <div className="mli-suggest">
                  {suggestions.map(s => (
                    <button key={s.code} type="button" onMouseDown={e => e.preventDefault()} onClick={() => { setCode(s.code); setShowSuggest(false); }}>
                      <span>{s.code}</span><small>{s.count} equipment</small>
                    </button>
                  ))}
                </div>
              )}
            </div>
            <div className="mli-field">
              <label htmlFor="mli-date">Date completed</label>
              <input id="mli-date" type="date" value={dateStr} min={minDate} max={maxDate} onChange={e => setDateStr(e.target.value)} />
            </div>
            <div className="mli-field">
              <label htmlFor="mli-ini">Completed by (initials)</label>
              <input id="mli-ini" type="text" placeholder="EL/LH" value={initials} onChange={e => setInitials(e.target.value)} />
            </div>
            <div className="mli-field">
              <label htmlFor="mli-hours">Total hours</label>
              <input id="mli-hours" type="number" min="0" step="0.25" placeholder="2.5" value={totalHours} onChange={e => setTotalHours(e.target.value)} />
            </div>
          </div>

          {/* KNOWN ORDER: equipment lines */}
          {matches.length > 0 && (
            <div className="mli-section">
              <h2>Equipment on this order ({lines.length})</h2>
              <table>
                <thead><tr><th></th><th>Equipment</th><th>Room</th><th>Area</th><th>Frequency</th><th>Hours</th><th>Status</th></tr></thead>
                <tbody>
                  {lines.map(l => {
                    const off = !!excluded[l.key];
                    const dupe = l.asset && dupes.has(l.asset.id);
                    return (
                      <tr key={l.key} className={off ? 'mli-off' : !l.asset ? 'mli-warn' : ''}>
                        <td><input type="checkbox" aria-label={`Include ${l.name}`} checked={!off} onChange={e => setExcluded(p => ({ ...p, [l.key]: !e.target.checked }))} /></td>
                        <td>
                          <strong>{l.name || '(unnamed)'}</strong>
                          {!l.asset && (
                            <div style={{ marginTop: 4 }}>
                              <select aria-label={`Pick equipment for ${l.name}`} value="" onChange={e => setPickedAsset(p => ({ ...p, [l.key]: e.target.value }))}>
                                <option value="">Pick equipment…</option>
                                {assets.filter(a => !l.room || normName(a.room) === normName(l.room)).slice(0, 300).map(a => (
                                  <option key={a.id} value={a.id}>{a.room} / {a.area} / {a.name}</option>
                                ))}
                              </select>
                            </div>
                          )}
                        </td>
                        <td>{l.room}</td>
                        <td>{l.area}</td>
                        <td>{freqLabel(l.col)}</td>
                        <td>
                          {l.asset && !off ? (
                            <input type="number" min="0" step="0.25" value={lineHours(l)}
                              onChange={e => setHoursOverride(p => ({ ...p, [l.key]: parseFloat(e.target.value) || 0 }))} />
                          ) : '–'}
                        </td>
                        <td>
                          {dupe ? <span className="mli-tag warn">already logged</span>
                            : !l.asset ? <span className="mli-tag warn">needs equipment</span>
                            : <span className="mli-tag ok">{l.how || 'ready'}</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <div className="mli-hint" style={{ marginTop: 6 }}>
                Total hours are split evenly across the selected equipment; edit a line to override it. Lines sum to {hoursSum}.
              </div>
            </div>
          )}

          {/* UNKNOWN ORDER: register it */}
          {isUnknown && (
            <div className="mli-section">
              <h2>New SAP order: {normalizedCode}</h2>
              <div className="mli-hint" style={{ marginBottom: 8 }}>This order is not in the SAP code list yet. Link it to equipment now so it autocompletes next time.</div>
              <div className="mli-row" style={{ marginBottom: 12 }}>
                <label><input type="radio" name="regmode" checked={regMode === 'existing'} onChange={() => setRegMode('existing')} /> Existing equipment</label>
                <label><input type="radio" name="regmode" checked={regMode === 'new'} onChange={() => setRegMode('new')} /> New equipment</label>
                <div className="mli-field">
                  <label htmlFor="mli-freq">Frequency of this code</label>
                  <select id="mli-freq" value={regFreq} onChange={e => setRegFreq(e.target.value)}>
                    {FREQUENCIES.map(f => <option key={f.col} value={f.col}>{f.label}</option>)}
                  </select>
                </div>
              </div>
              {regMode === 'existing' ? (
                <div className="mli-row">
                  <div className="mli-field">
                    <label htmlFor="mli-asearch">Search equipment</label>
                    <input id="mli-asearch" type="text" placeholder="Room, area or name" value={assetSearch} onChange={e => setAssetSearch(e.target.value)} />
                  </div>
                  <div className="mli-field" style={{ flexBasis: 320 }}>
                    <label htmlFor="mli-apick">Equipment</label>
                    <select id="mli-apick" value={regAssetId} onChange={e => setRegAssetId(e.target.value)}>
                      <option value="">Select…</option>
                      {assetChoices.map(a => <option key={a.id} value={a.id}>{a.room} / {a.area} / {a.name}</option>)}
                    </select>
                  </div>
                </div>
              ) : (
                <div className="mli-row">
                  <div className="mli-field"><label htmlFor="mli-room">Room</label>
                    <input id="mli-room" type="text" list="mli-rooms" value={regRoom} onChange={e => setRegRoom(e.target.value)} />
                    <datalist id="mli-rooms">{rooms.map(r => <option key={r} value={r} />)}</datalist></div>
                  <div className="mli-field"><label htmlFor="mli-area">Area</label>
                    <input id="mli-area" type="text" list="mli-areas" value={regArea} onChange={e => setRegArea(e.target.value)} />
                    <datalist id="mli-areas">{areas.map(r => <option key={r} value={r} />)}</datalist></div>
                  <div className="mli-field"><label htmlFor="mli-name">Equipment name</label>
                    <input id="mli-name" type="text" value={regName} onChange={e => setRegName(e.target.value)} /></div>
                </div>
              )}
            </div>
          )}

          <div className="mli-foot">
            <div className="mli-field" style={{ flex: '0 1 280px' }}>
              <label htmlFor="mli-photo">Paperwork photo (optional)</label>
              <input id="mli-photo" type="file" accept="image/*" onChange={e => onPhoto(e.target.files && e.target.files[0])} />
              {photoName && <span className="mli-hint">{photoName}</span>}
            </div>
            <button className="mli-btn" onClick={submit} disabled={saving || loading || !normalizedCode}>
              {saving ? 'Saving…' : `Log ${isUnknown ? 'order' : `${toLogCount} equipment`}${ini ? ` as ${ini}` : ''}`}
            </button>
          </div>
          {message && <div className={`mli-msg ${message.kind}`} role="status" style={{ marginTop: 12 }}>{message.text}</div>}
        </div>

        <div className="mli-card">
          <h2 style={{ margin: '0 0 8px', fontSize: 13, textTransform: 'uppercase', letterSpacing: .5, color: '#475569' }}>Recently logged</h2>
          {recent.length === 0 ? <div className="mli-hint">No entries yet.</div> : (
            <table>
              <thead><tr><th>Date</th><th>SAP order</th><th>Equipment</th><th>By</th><th>Hours</th></tr></thead>
              <tbody>
                {recent.map(r => (
                  <tr key={r.craa5__log_id}>
                    <td>{safeString(r.craa5_lastcleaned).slice(0, 10)}</td>
                    <td>{safeString(r.craa5_sap)}</td>
                    <td>{safeString(r.craa5_equipment)}</td>
                    <td>{safeString(r.craa5_lastcleanedby)}</td>
                    <td>{r.craa5_hoursworked ?? ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  );
}
