                        )}
                      </td>
                      <td className={styles.td}>{editing ? <Input size="small" aria-label={`Room for ${l.name}`} list={roomList} value={edits[l.key].room} disabled={saving} onChange={(e, d) => { setEdits(p => ({ ...p, [l.key]: { ...p[l.key], room: d.value } })); setTyping(t => ({ ...t, room: d.value })); }} /> : l.room}</td>
                      <td className={styles.td}>{editing ? <Input size="small" aria-label={`Area for ${l.name}`} list={areaList} value={edits[l.key].area} disabled={saving} onChange={(e, d) => { setEdits(p => ({ ...p, [l.key]: { ...p[l.key], area: d.value } })); setTyping(t => ({ ...t, area: d.value, roomCtx: edits[l.key].room })); }} /> : l.area}</td>
                      <td className={styles.td}>{l.col ? freqLabel(l.col) : ''}</td>
                      <td className={styles.td}>
                        {l.asset && !off ? (
                          <Input size="small" aria-label={`Hours for ${l.name}`} type="number" min="0" step="0.25" style={{ width: 90 }} disabled={saving}
                            value={hoursOverride[l.key] !== undefined ? hoursOverride[l.key] : String(evenHours[l.key] || 0)}
                            onChange={(e, d) => setHoursOverride(p => ({ ...p, [l.key]: d.value }))} />
                        ) : '–'}
                      </td>
                      <td className={styles.td}>
                        <span className={tagClass(statusKind)} title={l.reason || undefined}>{statusText}</span>
                        {!off && !l.splitting && rt && rt.apply && rt.count > 0 && <div className={styles.hint}>+ moves {rt.count}{rt.more ? '+' : ''} earlier</div>}
                      </td>
                    </tr>
                    {open && <tr><td className={styles.td} colSpan={7}>{renderPanel(l)}</td></tr>}
                  </React.Fragment>
                );
                // The pieces editor is a row of its own, so adding or removing the last piece does not start it over
                if (splitShown) rows.push(<tr key={`split-${l.parent || l.key}`}><td className={styles.td} colSpan={7}>{renderSplit(l.parent || l.key)}</td></tr>);
                return rows;
              }, [])}
            </tbody>
