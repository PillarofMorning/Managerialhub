      </div>
      {scan.started && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{scan.scanned} entries checked. {totalRows} entries matched in {plural(groups.length, 'distinct equipment group', 'distinct equipment groups')} ({visible.length} shown after filters).{scan.done ? ' The whole log has been checked.' : ` More entries remain: click "Scan next ${batchTarget}" to load more.`}</Text>}
