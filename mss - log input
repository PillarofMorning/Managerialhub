    }
  };
  const addManyExtras = (assetList, labelDesc = '') => {
    const avail = (assetList || []).filter(a => a && (a.isNew || !takenRef.current.has(a.id)));
    if (!avail.length) {
      setNote('All matching assets are already on this order.');
      return;
    }
    const nextExtras = avail.map(asset => {
      seq.current += 1;
      if (!asset.isNew) takenRef.current = new Set(Array.from(takenRef.current).concat([asset.id]));
      return { key: `x-${seq.current}`, asset, col: isAutoOrder ? null : addFreq, byName: true };
    });
    setExtras(p => [...p, ...nextExtras]);
    setNote(`Attached ${avail.length} asset${avail.length === 1 ? '' : 's'}${labelDesc ? ` (${labelDesc})` : ''} to ${normalizedCode}.`);
  };
  const addBatchPlace = async () => {
    const r = batchRoom.trim();
    const a = batchArea.trim();
    if (!r) { setNote('Choose a Room first to load its equipment.'); return; }
    try {
      const res = await store.assetsInPlace(r, a);
      const avail = res.list.filter(x => !takenRef.current.has(x.id));
      if (!avail.length) {
        setNote(`All equipment in ${r}${a ? ` / ${a}` : ''} is already on this order (or none found).`);
        return;
      }
      const nextExtras = avail.map(asset => {
        seq.current += 1;
        return { key: `x-${seq.current}`, asset, col: isAutoOrder ? null : addFreq };
      });
      setExtras(p => [...p, ...nextExtras]);
      setNote(`Autopopulated ${avail.length} equipment from ${r}${a ? ` / ${a}` : ''}. Untick any that were not part of this completion.`);
    } catch (e) {
      setNote(`Could not load equipment for ${r}: ${errText(e)}`);
    }
  };
  const addNew = async () => {
    const name = newName.trim(), room = newRoom.trim(), area = newArea.trim();
    if (!room || !area || !name) { setNote('Enter room, area and equipment name for the new equipment.'); return; }
    if (lines.some(l => l.asset && l.asset.isNew && sameText(l.name, name) && sameText(l.room, room) && sameText(l.area, area))) { setNote(`${name} is already being added to this order.`); return; }
    setNote('');
    const g0 = orderGen.current;
    try {
      const found = await store.findAssetsExact(name, room, area);
      if (orderGen.current !== g0) return;
      const existing = found.find(a => !takenRef.current.has(a.id)) || found[0];
      if (existing) {
        if (takenRef.current.has(existing.id)) { setNote(`${existing.name} (${placeText(existing)}) already exists and is on a line of this order.`); return; }
        addExtra(existing, true);
        setNote(`${existing.name} already exists in ${placeText(existing)}; added the existing equipment instead of creating a duplicate.`);
        return;
      }
    } catch (e) { if (orderGen.current === g0) setNote(`Could not check for an existing match: ${errText(e)}`); return; }
    seq.current += 1;
    addExtra({ id: `new:${seq.current}`, isNew: true, name, room, area }, false);
  };

  // --- Change equipment on a line ---
  const candidatesFor = (l) => {
    const more = (moreRank[l.key] && moreRank[l.key].ranked) || [];
    const all = [...l.ranked, ...more];
    // Equipment on another line stays listed (the panel says so and does not offer it), so it never looks like the search missed it
    const ranked = Array.from(new Map(all.map(c => [c.asset.id, c])).values())
      .filter(c => !(l.asset && c.asset.id === l.asset.id))
      .sort((a, b) => b.score - a.score || (b.support || 0) - (a.support || 0));
    return ranked.filter(c => !takenIds.has(c.asset.id)).concat(ranked.filter(c => takenIds.has(c.asset.id)));
  };
  // Find the earlier entries a change would correct (counted now, moved on submit)
  const scanRetro = async (l, to) => {
    const from = l.auto && !l.auto.isNew ? l.auto : null;
    const n = (retroSeq.current[l.key] || 0) + 1;
    retroSeq.current[l.key] = n;
    if (from && to && !to.isNew && from.id === to.id) { setRetro(p => { const x = { ...p }; delete x[l.key]; return x; }); return; }
    // Only a line that still has its automatic equipment keeps the old ID's entries; a changed line brings its own
    const stillUsed = !!from && lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === from.id);
    const filter = retroFilter(normalizedCode, from, l.ms, stillUsed);
    if (!filter) { setRetro(p => ({ ...p, [l.key]: { status: 'ready', count: 0, from, stillUsed, filter: null, apply: false } })); return; }
    setRetro(p => ({ ...p, [l.key]: { status: 'scanning', count: 0, from, stillUsed, filter, apply: p[l.key] ? p[l.key].apply : true } }));
    try {
      const rows = await api.query(LOG_TABLE, { select: RETRO_SELECT, filter, top: LIMITS.countCap + 1 });
      const some = rows.slice(0, LIMITS.countCap);
      // Entries the new equipment already has for the same order and day are not moved (see coveredByTarget)
      const cov = await coveredByTarget(api, some, to);
