  const [viewing, setViewing] = useState(null);
  const [sortBy, setSortBy] = useState('applied'); // 'applied': newest saved first; 'clean': newest date of clean first
  const [sorted, setSorted] = useState('applied'); // the order on screen: 'applied', 'clean', or 'fallback' (applied asked, not possible this time)
  const view = useRef({ size: LIMITS.logPage, sort: 'applied' }); // what the table shows now, for reloads after a save or delete
  const applied = useRef({ term: '', start: '', end: '' });
  const reqId = useRef(0);
  // Columns read when Dataverse allows them; one is dropped for the session once Dataverse says it cannot be read
  const optCols = useRef({ [PAPERWORK_NAME]: true, [CREATED_ON]: true, [CREATED_BY]: true });

  const buildFilter = (a) => {
    const f = ['statecode eq 0'];
    const term = a.term.trim();
    if (term) f.push(`(${ciContains('craa5_sap', term)} or ${ciContains('craa5_equipment', term)} or ${ciStarts('craa5_lastcleanedby', term)})`);
    if (a.start) f.push(`craa5_lastcleaned ge ${a.start}T00:00:00Z`);
    if (a.end) f.push(`craa5_lastcleaned lt ${nextDay(a.end)}T00:00:00Z`);
    return f.join(' and ');
  };

  // Only the newest request may update the table
  const load = useCallback(async (size, order) => {
    const id = ++reqId.current;
    setLoading(true);
    try {
      const filter = buildFilter(applied.current);
      // Last applied = when the entry was saved; the order is the date of clean when that cannot be read
      const ask = (cols) => api.query(LOG_TABLE, {
        select: LOG_SELECT.concat(cols), filter, top: size,
        orderBy: order === 'applied' && cols.indexOf(CREATED_ON) >= 0 ? `${CREATED_ON} desc` : 'craa5_lastcleaned desc',
      });
      let cols = Object.keys(optCols.current).filter(c => optCols.current[c]);
      let res;
      let guess = null; // the column left out on the last try when the error named none
      // Without an extra column the log still loads (the last try throws its own error if the problem is elsewhere).
      // A column named in a missing-column error is dropped for the session; otherwise one column at a time is left out,
      // the file name first, and only dropped for good if leaving it out is what made a missing-column error go away.
      for (;;) {
        try { res = await ask(cols); break; }
        catch (e) {
          if (!cols.length) throw e;
          const msg = errText(e);
          const missing = MISSING_COLUMN.test(msg);
          const named = missing ? cols.filter(c => msg.toLowerCase().indexOf(c.replace(/^_|_value$/g, '').toLowerCase()) >= 0) : [];
          if (named.length) { named.forEach(c => { optCols.current[c] = false; }); cols = cols.filter(c => named.indexOf(c) < 0); guess = null; continue; }
          const out = [PAPERWORK_NAME, CREATED_BY, CREATED_ON].filter(c => cols.indexOf(c) >= 0)[0] || cols[0];
          cols = cols.filter(c => c !== out);
          guess = { col: out, missing };
        }
      }
      if (guess && guess.missing) optCols.current[guess.col] = false;
      if (id !== reqId.current) return;
      const has = (c) => cols.indexOf(c) >= 0;
      const list = res.map(r => ({ ...mapLog(r), pictureKnown: has(PAPERWORK_NAME) }));
      setEntries(list); setLoaded(true);
      setSorted(order !== 'applied' ? 'clean' : has(CREATED_ON) ? 'applied' : optCols.current[CREATED_ON] ? 'fallback' : 'clean');
      // Check this page's equipment ids (only the distinct ids on screen)
      store.resolveAssets(list.map(e => e.guid)).then(() => setIdTick(t => t + 1)).catch(() => {});
      // Names of the people who saved the entries, where the rows came without them
      const noName = list.filter(e => e.appliedById && !e.appliedBy).map(e => e.appliedById);
      if (noName.length) store.userNames(noName).then(() => setIdTick(t => t + 1)).catch(() => {});
    } catch (e) { if (id === reqId.current) setMessage({ kind: 'error', text: `Could not load the log: ${errText(e)}` }); }
    finally { if (id === reqId.current) setLoading(false); }
  }, [api, store]);

  useEffect(() => { load(LIMITS.logPage, 'applied'); }, [load]);
  const show = (size, sort) => { view.current = { size, sort }; setPageSize(size); load(size, sort); };

  const applyFilters = () => { applied.current = { term: searchTerm, start: startDate, end: endDate }; setSelected(new Set()); setMessage(null); show(LIMITS.logPage, sortBy); };
  const clearFilters = () => { setSearchTerm(''); setStartDate(''); setEndDate(''); applied.current = { term: '', start: '', end: '' }; setSelected(new Set()); setMessage(null); show(LIMITS.logPage, sortBy); };
  const loadMore = () => show(Math.min(pageSize + LIMITS.logPage, LIMITS.logMax), sortBy);
  const changeSort = (v) => { setSortBy(v); setSelected(new Set()); setMessage(null); show(LIMITS.logPage, v); };
  const handleEdit = (id, field, value) => setEdits(p => ({ ...p, [id]: { ...p[id], [field]: value } }));

  const saveBatchEdits = async () => {
    const jobs = [];
    const today = toDateInput(new Date());
    for (const [id, c] of Object.entries(edits)) {
      const payload = {};
      if (c.sap !== undefined) payload.craa5_sap = isAutoSap(c.sap) ? formatAutoSap(c.sap) : normCode(c.sap);
      if (c.date !== undefined) {
        if (!c.date || c.date > today) { setMessage({ kind: 'error', text: 'Dates cannot be blank or in the future.' }); return; }
        payload.craa5_lastcleaned = toLogDate(c.date);
      }
      if (c.hours !== undefined) {
        const h = parseFloat(c.hours);
        if (!(h >= 0) || h > 200) { setMessage({ kind: 'error', text: 'Hours must be 0 or more.' }); return; }
        payload.craa5_hoursworked = Math.round(h);
      }
      if (c.by !== undefined) {
        const ini = normalizeInitials(c.by);
        if (!INITIALS_RE.test(ini)) { setMessage({ kind: 'error', text: `Initials or names "${c.by}" are not valid (e.g. EL/LH or John Smith).` }); return; }
        payload.craa5_lastcleanedby = ini;
      }
      if (Object.keys(payload).length) jobs.push({ id, payload });
    }
    const res = await pool(jobs, 8, (j) => api.update(LOG_TABLE, j.id, j.payload));
    const failed = res.filter(r => !r.ok);
    if (failed.length) setMessage({ kind: 'error', text: `${failed.length} of ${jobs.length} updates failed: ${errText(failed[0].error)}` });
    else { setMessage({ kind: 'ok', text: `Updated ${plural(jobs.length, 'entry', 'entries')}.` }); setEdits({}); setIsEdit(false); }
    await load(view.current.size, view.current.sort);
  };

  const batchDelete = async () => {
    if (!selected.size) return;
    if (!window.confirm(`Are you sure you want to permanently delete ${plural(selected.size, 'record', 'records')} from Dataverse?`)) return;
    const res = await pool(Array.from(selected), 8, (id) => api.remove(LOG_TABLE, id));
    const failed = res.filter(r => !r.ok);
    setMessage(failed.length ? { kind: 'error', text: `${failed.length} deletes failed: ${errText(failed[0].error)}` } : { kind: 'ok', text: `Deleted ${plural(res.length, 'entry', 'entries')}.` });
    setSelected(new Set());
    await load(view.current.size, view.current.sort);
  };

  const idStatus = (e) => (!e.guid ? 'missing' : store.hasAsset(e.guid) ? 'ok' : store.isGone(e.guid) ? 'unknown' : 'checking');
  const fill = { width: '100%', minWidth: 0 };

  const cols = [
    createTableColumn({ columnId: 'select',
      renderHeaderCell: () => (<input type="checkbox" aria-label="Select all" checked={entries.length > 0 && selected.size === entries.length}
        onChange={(e) => setSelected(e.target.checked ? new Set(entries.map(x => x.id)) : new Set())} />),
      renderCell: (item) => (<input type="checkbox" aria-label={`Select ${item.equipment || item.sap} ${item.date}`} checked={selected.has(item.id)}
        onChange={(e) => { const n = new Set(selected); if (e.target.checked) n.add(item.id); else n.delete(item.id); setSelected(n); }} />) }),
    createTableColumn({ columnId: 'sap', renderHeaderCell: () => 'SAP Order / Auto',
      renderCell: (item) => isEdit ? <Input aria-label={`SAP order for ${item.equipment}`} style={fill} value={edits[item.id]?.sap ?? item.sap} onChange={(e, d) => handleEdit(item.id, 'sap', d.value)} /> : <Text>{item.sap}</Text> }),
    createTableColumn({ columnId: 'equipment', renderHeaderCell: () => 'Equipment', renderCell: (item) => <Text>{item.equipment || '...'}</Text> }),
    createTableColumn({ columnId: 'room', renderHeaderCell: () => 'Room', renderCell: (item) => <Text>{item.room || '...'}</Text> }),
    createTableColumn({ columnId: 'area', renderHeaderCell: () => 'Area', renderCell: (item) => <Text>{item.area || '...'}</Text> }),
    createTableColumn({ columnId: 'date', renderHeaderCell: () => 'Date of Clean',
      renderCell: (item) => isEdit ? <Input aria-label={`Date for ${item.equipment}`} type="date" max={maxDate} style={fill} value={edits[item.id]?.date ?? item.date} onChange={(e, d) => handleEdit(item.id, 'date', d.value)} /> : <Text>{item.date}</Text> }),
    createTableColumn({ columnId: 'hours', renderHeaderCell: () => 'Hours Worked',
      renderCell: (item) => isEdit ? <Input aria-label={`Hours for ${item.equipment}`} type="number" min="0" step="1" style={fill} value={edits[item.id]?.hours ?? String(item.hours ?? '')} onChange={(e, d) => handleEdit(item.id, 'hours', d.value)} /> : <Text>{item.hours ?? ''}</Text> }),
    createTableColumn({ columnId: 'by', renderHeaderCell: () => 'Initials / Names',
      renderCell: (item) => isEdit ? <Input aria-label={`Initials or names for ${item.equipment}`} style={fill} value={edits[item.id]?.by ?? item.by} onChange={(e, d) => handleEdit(item.id, 'by', d.value)} /> : <Text>{item.by}</Text> }),
    createTableColumn({ columnId: 'applied', renderHeaderCell: () => 'Last Applied', renderCell: (item) => <Text>{stampText(item.applied)}</Text> }),
    createTableColumn({ columnId: 'appliedBy', renderHeaderCell: () => 'Applied By', renderCell: (item) => <Text>{item.appliedBy || store.userName(item.appliedById)}</Text> }),
    createTableColumn({ columnId: 'picture', renderHeaderCell: () => 'Paperwork',
      renderCell: (item) => (item.picture || !item.pictureKnown
        ? <Button size="small" appearance="subtle" aria-label={`View paperwork picture for ${item.equipment || item.sap} ${item.date}`} onClick={() => setViewing(item)}>{item.picture ? 'View Photo' : 'Check Photo'}</Button>
        : <Text className={styles.hint}>none</Text>) }),
    createTableColumn({ columnId: 'id', renderHeaderCell: () => 'Equipment ID',
      renderCell: (item) => { const s = idStatus(item); return <span className={mergeClasses(styles.tag, s === 'ok' ? styles.tagOk : s === 'unknown' ? styles.tagBad : s === 'missing' ? styles.tagWarn : undefined)}>{s === 'ok' ? 'linked' : s}</span>; } }),
  ];

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Log Table</Text>
      <div className={styles.filterBar}>
        <Input aria-label="Search" placeholder="Search order, equipment or initials..." value={searchTerm} onChange={(e, d) => setSearchTerm(d.value)} onKeyDown={(e) => { if (e.key === 'Enter' && !loading) applyFilters(); }} style={{ minWidth: '200px' }} />
        <Input type="date" aria-label="Start date" value={startDate} onChange={(e, d) => setStartDate(d.value)} />
        <Input type="date" aria-label="End date" value={endDate} onChange={(e, d) => setEndDate(d.value)} />
        <Select aria-label="Sort the log by" value={sortBy} disabled={loading} onChange={(e, d) => changeSort(d.value)}>
          <option value="applied">Last applied first</option>
          <option value="clean">Newest date of clean first</option>
        </Select>
        <Button appearance="primary" className={styles.btnPrimary} disabled={loading} onClick={applyFilters}>Apply Filters</Button>
        <Button disabled={loading} onClick={clearFilters}>Clear Filters</Button>
      </div>
      <div className={styles.actionBar}>
        {(!ctx.viewFeatures || ctx.viewFeatures.allowBatchEdit !== false) && (
          <>
            {!isEdit ? <Button onClick={() => setIsEdit(true)}>Batch Edit Mode</Button> : (
              <>
                <Button appearance="primary" className={styles.btnPrimary} onClick={saveBatchEdits}>Save Changes</Button>
                <Button onClick={() => { setIsEdit(false); setEdits({}); }}>Cancel Edits</Button>
              </>
            )}
            <Button appearance="primary" className={styles.btnDanger} disabled={!selected.size} onClick={batchDelete}>Delete Selected ({selected.size})</Button>
          </>
        )}
        {(!ctx.viewFeatures || ctx.viewFeatures.allowCsvExport !== false) && (
          <Button
            appearance="secondary"
            disabled={!entries.length}
            onClick={() => {
              const headers = ['Date of Clean', 'SAP Order', 'Equipment', 'Room', 'Area', 'Hours Worked', 'Initials / Names', 'Last Applied', 'Equipment GUID'];
              const csvRows = [headers.join(',')];
              entries.forEach(item => {
                const row = [item.date, item.sap, item.equipment, item.room, item.area, item.hours ?? '', item.by, stampText(item.applied), item.guid || '']
                  .map(v => `"${safeString(v).replace(/"/g, '""')}"`);
                csvRows.push(row.join(','));
              });
              try {
                const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `mss_log_table_${toDateInput(new Date())}.csv`;
                a.click();
                URL.revokeObjectURL(url);
              } catch (_) { /* ignore */ }
            }}
          >
            Export CSV ({entries.length})
          </Button>
        )}
        <Text className={styles.hint} aria-live="polite">{loading ? 'Loading...' : `Showing the ${entries.length} ${sorted === 'applied' ? 'most recently applied' : 'most recently cleaned'} matching entries${sorted === 'fallback' ? ' (they could not be sorted by when they were applied this time, so they are sorted by date of clean; load again to retry)' : sortBy === 'applied' && sorted === 'clean' ? ' (the time entries were applied cannot be read here, so they are sorted by date of clean)' : ''}. Double-click an entry to see its paperwork picture.`}</Text>
      </div>
      {message && <Text className={message.kind === 'ok' ? styles.okText : styles.errorText} block role={message.kind === 'ok' ? 'status' : 'alert'}>{message.text}</Text>}
      <div style={{ maxHeight: '60vh', overflow: 'auto', border: `1px solid ${BRAND.line}`, borderRadius: '4px' }}>
        <div style={{ minWidth: isEdit ? 1640 : 1380 }}>
          <DataGrid items={entries} columns={cols} getRowId={(item) => item.id} focusMode="none">
            <DataGridHeader><DataGridRow>{({ renderHeaderCell }) => <DataGridHeaderCell>{renderHeaderCell()}</DataGridHeaderCell>}</DataGridRow></DataGridHeader>
            <DataGridBody>{({ item }) => (
              <DataGridRow key={item.id} style={{ cursor: isEdit ? undefined : 'zoom-in' }} title={isEdit ? undefined : 'Double-click to see the paperwork picture'}
                onDoubleClick={(e) => { if (!isEdit && !(e.target && e.target.closest && e.target.closest('input,button,select,textarea,a'))) setViewing(item); }}>
                {({ renderCell }) => <DataGridCell>{renderCell(item)}</DataGridCell>}
              </DataGridRow>
            )}</DataGridBody>
          </DataGrid>
          {loaded && !loading && entries.length === 0 && <Text className={styles.hint} block style={{ padding: 12 }}>No log entries match these filters.</Text>}
        </div>
      </div>
      {viewing && <PaperworkViewer api={api} entry={viewing} onClose={() => setViewing(null)} />}
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
        <Button onClick={loadMore} disabled={loading || entries.length < pageSize || pageSize >= LIMITS.logMax}>Load More Entries</Button>
        {pageSize >= LIMITS.logMax && entries.length >= pageSize && <Text className={styles.hint}>That is the most the table shows at once. Use the filters to narrow it down.</Text>}
      </div>
    </div>
  );
};

// --- CHECK (the log rows of every app for the last days, held to the MSS LOG WRITE rule; nothing changes until an admin applies a fix) ---
const CHECK_DAYS = ['1', '3', '7', '14', '30'];
const CHECK_MAX = 2000;
const CHECK_SELECT = ['craa5__log_id', 'craa5_equipment', 'craa5_equipmentguid', 'craa5_sap', 'craa5_room', 'craa5_area', 'craa5_lastcleaned', 'craa5_lastcleanedby', 'craa5_hoursworked', 'craa5_daily', 'craa5_weekly', 'craa5_monthly', 'craa5_pathogen', 'craa5_uid', 'craa5_bundle', 'craa5_idofssop'];
const CHECK_OPT = ['craa5_cleankind', 'craa5_shiftdate', 'craa5_completionkey', 'craa5_laborminutes', 'craa5_markedby', 'craa5_source', CREATED_ON];
const CHECK_CODES = ['no_equipment', 'bad_equipment', 'future_day', 'duplicate', 'crew_name', 'no_names', 'no_kind', 'no_pathogen', 'no_day'];
// Which app saved a row: the source column, else a guess (an "auto-" SAP text came from Ganttly or Shift Start)
const checkSourceOf = (r) => safeString(r.craa5_source) || (isAutoSap(r.craa5_sap) ? 'Ganttly / Shift Start' : 'Log input');
// Every row with its problems. A repeat = a second "auto-" row of the same equipment, day and clean kind as another row (the SAP
// row, or the first saved, is the one kept). Old Log input rows are never called repeats: the same order was allowed twice then.
const checkRows = (list) => {
  const out = list.map(r => ({
    id: cleanGuid(r.craa5__log_id), raw: r, date: safeString(r.craa5_shiftdate) || dayKey(r.craa5_lastcleaned), equipment: safeString(r.craa5_equipment),
    place: [safeString(r.craa5_room), safeString(r.craa5_area)].filter(Boolean).join(' / '), by: safeString(r.craa5_lastcleanedby),
    sap: safeString(r.craa5_sap), kind: mlwRowKind(r), source: checkSourceOf(r), skip: mlwIsSkip(r),
    minutes: r.craa5_laborminutes !== undefined && r.craa5_laborminutes !== null ? Number(r.craa5_laborminutes) : null,
    hours: r.craa5_hoursworked, pathogen: safeString(r.craa5_pathogen), at: safeString(r[CREATED_ON]), problems: mlwCheckRow(r),
  }));
  const groups = new Map();
  out.forEach(x => {
    const g = hubIsGuid(x.raw.craa5_equipmentguid) ? hubGuid(x.raw.craa5_equipmentguid) : "";
    if (x.skip || !g || !x.date) return;
    const k = `${g}|${x.date}|${x.kind}`;
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k).push(x);
  });
  groups.forEach((g) => {
    if (g.length < 2) return;
    const sorted = g.slice().sort((a, b) => (isAutoSap(a.sap) === isAutoSap(b.sap) ? (a.at < b.at ? -1 : a.at > b.at ? 1 : 0) : isAutoSap(a.sap) ? 1 : -1));
    sorted.slice(1).forEach(x => { if (isAutoSap(x.sap)) x.problems = x.problems.concat(['duplicate']); });
  });
  return out;
};
const dayBefore = (dateStr) => { const d = new Date(`${dateStr}T00:00:00Z`); d.setUTCDate(d.getUTCDate() - 1); return d.toISOString().slice(0, 10); };

const CheckTab = ({ ctx }) => {
  const styles = useStyles();
  const { api, lang } = ctx;
  const [days, setDays] = useState('7');
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [loaded, setLoaded] = useState(false);
  const [capped, setCapped] = useState(false);
  const [message, setMessage] = useState(null);
  const [only, setOnly] = useState('');   // '' = every row with a problem, 'all' = every row, or one problem code
  const [names, setNames] = useState({});  // Cleaned by being typed, by row id
  const [busy, setBusy] = useState(false);
  const [queued, setQueued] = useState(mlwQueueCount());
  const optCols = useRef(CHECK_OPT.slice());
  const reqId = useRef(0);
  const say = (code) => mlwSay(code, lang);

  const load = useCallback(async (d) => {
    const id = ++reqId.current;
    setLoading(true);
    try {
      const filter = `statecode eq 0 and craa5_lastcleaned ge ${daysAgo(Number(d) - 1)}T00:00:00Z`;
      let cols = optCols.current.slice();
      let pg;
      // The new columns may not exist yet: a column the error names is left out for the session (all of them when none is named)
      for (;;) {
        try { pg = await api.page(LOG_TABLE, { select: CHECK_SELECT.concat(cols), filter, top: 250 }); break; }
        catch (e) {
          const msg = errText(e);
          if (!cols.length || !(MISSING_COLUMN.test(msg) || /invalid property|does not exist/i.test(msg))) throw e;
          const named = cols.filter(c => msg.toLowerCase().indexOf(c) >= 0);
          cols = named.length ? cols.filter(c => named.indexOf(c) < 0) : [];
          optCols.current = cols;
        }
      }
      const all = pg.rows.slice();
      while (pg.next && all.length < CHECK_MAX) { pg = await pg.next(); pg.rows.forEach(r => all.push(r)); }
      if (id !== reqId.current) return;
      setCapped(!!pg.next || all.length > CHECK_MAX);
      setRows(checkRows(all.slice(0, CHECK_MAX)));
      setLoaded(true);
    } catch (e) {
      if (id === reqId.current) setMessage({ kind: 'error', text: tr(`Could not read the log: ${errText(e)}`, `No se pudo leer el registro: ${errText(e)}`) });
    } finally { if (id === reqId.current) setLoading(false); }
  }, [api]);
  useEffect(() => { load(days); }, [load]); // eslint-disable-line react-hooks/exhaustive-deps

  const withProblem = rows.filter(r => r.problems.length);
  const counts = {};
  withProblem.forEach(r => r.problems.forEach(p => { counts[p] = (counts[p] || 0) + 1; }));
  const shown = (only === 'all' ? rows : only ? rows.filter(r => r.problems.indexOf(only) >= 0) : withProblem)
    .slice().sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.equipment.localeCompare(b.equipment)));

  // Apply one change to many rows, then read the log again
  const applyAll = async (list, make, doneEn, doneEs) => {
    if (!list.length) return;
    setBusy(true); setMessage(null);
    const res = await pool(list, 6, (r) => make(r));
    const bad = res.filter(x => !x.ok);
    setMessage(bad.length
      ? { kind: 'error', text: tr(`${bad.length} of ${list.length} could not be changed: ${errText(bad[0].error)}`, `${bad.length} de ${list.length} no se pudieron cambiar: ${errText(bad[0].error)}`) }
      : { kind: 'ok', text: tr(`${doneEn} (${list.length}).`, `${doneEs} (${list.length}).`) });
    setBusy(false);
    ctx.dataChanged && ctx.dataChanged();
    await load(days);
  };
  const fixPathogen = () => applyAll(rows.filter(r => r.problems.indexOf('no_pathogen') >= 0), (r) => api.update(LOG_TABLE, r.id, { craa5_pathogen: 'No' }),
    'Pathogen set to No', 'Patogeno puesto en No');
  const kindFromSap = (r) => (r.sap ? logKindOf(r.sap, null, true) : '');
  const fixKinds = () => applyAll(rows.filter(r => r.problems.indexOf('no_kind') >= 0 && kindFromSap(r)), (r) => {
    const k = kindFromSap(r);
    const body = mlwFlags(k);
    if (optCols.current.indexOf('craa5_cleankind') >= 0) body.craa5_cleankind = k;
    return api.update(LOG_TABLE, r.id, body);
  }, 'Clean kind filled in from the SAP order', 'Tipo de limpieza tomado de la orden SAP');
  const removeRepeats = () => {
    const list = rows.filter(r => r.problems.indexOf('duplicate') >= 0);
    if (!list.length) return;
    if (!window.confirm(tr(`Turn off ${list.length} repeated automatic entries? The first entry of each clean is kept. The repeats are deactivated, not deleted.`, `Desactivar ${list.length} registros automaticos repetidos? Se conserva el primer registro de cada limpieza. Los repetidos se desactivan, no se borran.`))) return;
    applyAll(list, (r) => api.update(LOG_TABLE, r.id, { statecode: 1, statuscode: 2 }), 'Repeated entries turned off', 'Registros repetidos desactivados');
  };
  const moveBack = (r) => applyAll([r], (x) => api.update(LOG_TABLE, x.id, { craa5_lastcleaned: toLogDate(dayBefore(x.date)) }), 'Moved to the day before', 'Movido al dia anterior');
  const saveName = (r) => {
    const v = mlwNames(names[r.id] || '');
    if (!v.length || v.some(n => /^(crew|equipo|team|n\/?a|tbd)$/i.test(n))) { setMessage({ kind: 'error', text: say('crew_name') }); return; }
    applyAll([r], (x) => api.update(LOG_TABLE, x.id, { craa5_lastcleanedby: v.join(' / ').slice(0, 100) }), 'Cleaned by saved', 'Limpiado por guardado')
      .then(() => setNames(p => { const n = { ...p }; delete n[r.id]; return n; }));
  };
  const retryQueue = async () => {
    setBusy(true);
    const res = await mlwRetryQueue(mlwApi(findXrm(), null) || api);
    setQueued(res.left); setBusy(false);
    setMessage({ kind: res.left ? 'error' : 'ok', text: tr(`Saved ${res.saved}, already there ${res.already}, still waiting ${res.left}.`, `Guardados ${res.saved}, ya estaban ${res.already}, en espera ${res.left}.`) });
    await load(days);
  };

  const cell = { padding: '6px 8px', borderBottom: `1px solid ${BRAND.line}`, verticalAlign: 'top', textAlign: 'left' };
  const fixable = { no_pathogen: counts.no_pathogen || 0, no_kind: rows.filter(r => r.problems.indexOf('no_kind') >= 0 && kindFromSap(r)).length, duplicate: counts.duplicate || 0 };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>{tr('Check the log', 'Revisar el registro')}</Text>
      <Text className={styles.hint} block>
        {tr('Every app saves cleans to the same MSS log. This page holds each entry to one rule: an equipment ID, the shift day, the names of who cleaned it, the kind of clean and a pathogen Yes or No. Nothing changes until you apply a fix.',
          'Todas las apps guardan las limpiezas en el mismo registro MSS. Esta pagina revisa cada registro con una sola regla: ID de equipo, dia del turno, nombres de quien limpio, tipo de limpieza y patogeno Si o No. Nada cambia hasta que aplique una correccion.')}
      </Text>
      <div className={styles.filterBar}>
        <Text>{tr('Days to check', 'Dias a revisar')}</Text>
        <Select aria-label={tr('Days to check', 'Dias a revisar')} value={days} disabled={loading} onChange={(e, d) => { setDays(d.value); load(d.value); }}>
          {CHECK_DAYS.map(d => <option key={d} value={d}>{d === '1' ? tr('Today', 'Hoy') : tr(`Last ${d} days`, `Ultimos ${d} dias`)}</option>)}
        </Select>
        <Select aria-label={tr('Show', 'Mostrar')} value={only} onChange={(e, d) => setOnly(d.value)}>
          <option value="">{tr(`Entries with a problem (${withProblem.length})`, `Registros con problema (${withProblem.length})`)}</option>
          {CHECK_CODES.filter(c => counts[c]).map(c => <option key={c} value={c}>{`${say(c)} (${counts[c]})`}</option>)}
          <option value="all">{tr(`Every entry (${rows.length})`, `Todos los registros (${rows.length})`)}</option>
        </Select>
        <Button disabled={loading || busy} onClick={() => load(days)}>{tr('Read again', 'Leer de nuevo')}</Button>
      </div>
      <div className={styles.actionBar}>
        <Button disabled={busy || !fixable.no_pathogen} onClick={fixPathogen}>{tr(`Set empty pathogen to No (${fixable.no_pathogen})`, `Poner patogeno vacio en No (${fixable.no_pathogen})`)}</Button>
        <Button disabled={busy || !fixable.no_kind} onClick={fixKinds}>{tr(`Fill in the clean kind from the SAP order (${fixable.no_kind})`, `Tomar el tipo de limpieza de la orden SAP (${fixable.no_kind})`)}</Button>
        <Button className={styles.btnDanger} appearance="primary" disabled={busy || !fixable.duplicate} onClick={removeRepeats}>{tr(`Turn off repeated automatic entries (${fixable.duplicate})`, `Desactivar registros automaticos repetidos (${fixable.duplicate})`)}</Button>
        {queued > 0 && <Button disabled={busy} onClick={retryQueue}>{tr(`Save the ${queued} waiting on this device`, `Guardar los ${queued} en espera en este equipo`)}</Button>}
        <Text className={styles.hint} aria-live="polite">{loading ? tr('Reading the log...', 'Leyendo el registro...') : loaded ? tr(`${rows.length} entries read, ${withProblem.length} with a problem.`, `${rows.length} registros leidos, ${withProblem.length} con problema.`) : ''}</Text>
      </div>
      {capped && <Text className={styles.warnText} block>{tr(`Only the first ${CHECK_MAX} entries were read. Pick fewer days to see the rest.`, `Solo se leyeron los primeros ${CHECK_MAX} registros. Elija menos dias para ver el resto.`)}</Text>}
      {(counts.no_equipment || counts.bad_equipment) ? <Text className={styles.hint} block>{tr('Entries with no equipment ID are fixed on the Fix Missing IDs tab.', 'Los registros sin ID de equipo se corrigen en la pestana Corregir IDs Faltantes.')}</Text> : null}
      {message && <Text className={message.kind === 'ok' ? styles.okText : styles.errorText} block role={message.kind === 'ok' ? 'status' : 'alert'}>{message.text}</Text>}
      <div style={{ maxHeight: '60vh', overflow: 'auto', border: `1px solid ${BRAND.line}`, borderRadius: '4px' }}>
        <table style={{ borderCollapse: 'collapse', width: '100%', minWidth: 1100, fontSize: 13 }}>
          <thead>
            <tr>
              {[tr('Date', 'Fecha'), tr('Equipment', 'Equipo'), tr('Room / Area', 'Cuarto / Area'), tr('Kind', 'Tipo'), tr('Cleaned by', 'Limpiado por'), tr('Labor', 'Mano de obra'), tr('Pathogen', 'Patogeno'), tr('Saved by app', 'Guardado por app'), tr('Problem', 'Problema')].map(h => <th key={h} style={{ ...cell, fontWeight: 600 }}>{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {shown.map(r => (
              <tr key={r.id}>
                <td style={cell}>{r.date || '...'}
                  {r.problems.indexOf('future_day') >= 0 && <div><Button size="small" disabled={busy} onClick={() => moveBack(r)}>{tr('Move to the day before', 'Mover al dia anterior')}</Button></div>}
                </td>
                <td style={cell}>{r.equipment || '...'}</td>
                <td style={cell}>{r.place}</td>
                <td style={cell}>{r.skip ? tr('Skipped', 'Omitido') : (mlwKindLabel(r.kind, lang) || '...')}{r.sap ? <div className={styles.hint}>{r.sap}</div> : null}</td>
                <td style={cell}>{(r.problems.indexOf('crew_name') >= 0 || r.problems.indexOf('no_names') >= 0) ? (
                  <div style={{ display: 'flex', gap: 4, flexWrap: 'wrap' }}>
                    <Input size="small" aria-label={tr(`Who cleaned ${r.equipment}`, `Quien limpio ${r.equipment}`)} placeholder={r.by || tr('Names, / between', 'Nombres, / entre ellos')} value={names[r.id] || ''} onChange={(e, d) => setNames(p => ({ ...p, [r.id]: d.value }))} />
                    <Button size="small" disabled={busy || !safeString(names[r.id])} onClick={() => saveName(r)}>{tr('Save', 'Guardar')}</Button>
                  </div>) : r.by}</td>
                <td style={cell}>{r.minutes !== null && !Number.isNaN(r.minutes) ? tr(`${r.minutes} min`, `${r.minutes} min`) : r.hours !== undefined && r.hours !== null ? tr(`${r.hours} h`, `${r.hours} h`) : ''}</td>
                <td style={cell}>{r.pathogen === 'Yes' ? tr('Yes', 'Si') : r.pathogen === 'No' ? 'No' : ''}</td>
                <td style={cell}>{r.source}</td>
                <td style={cell}>{r.problems.length ? r.problems.map(p => <div key={p}><span className={mergeClasses(styles.tag, p === 'no_pathogen' || p === 'no_kind' ? styles.tagWarn : styles.tagBad)}>{say(p)}</span></div>) : <span className={mergeClasses(styles.tag, styles.tagOk)}>{tr('OK', 'Bien')}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {loaded && !loading && shown.length === 0 && <Text className={styles.hint} block style={{ padding: 12 }}>{only === 'all' ? tr('No entries in these days.', 'No hay registros en estos dias.') : tr('No problems found in these days.', 'No se encontraron problemas en estos dias.')}</Text>}
      </div>
    </div>
  );
};

// --- DASHBOARD (one period, the newest entries up to a limit) ---
const DashboardTab = ({ ctx }) => {
  const styles = useStyles();
  const { api } = ctx;
  const [days, setDays] = useState('7');
  const [data, setData] = useState({ rows: [], capped: false });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    let live = true;
    setLoading(true); setError('');
    api.query(LOG_TABLE, {
      select: ['craa5__log_id', 'craa5_sap', 'craa5_lastcleanedby', 'craa5_hoursworked', 'craa5_equipmentguid'],
      filter: `statecode eq 0 and craa5_lastcleaned ge ${daysAgo(Number(days))}T00:00:00Z`, orderBy: 'craa5_lastcleaned desc', top: LIMITS.dashboard + 1,
    })
      .then(rows => { if (live) setData({ rows: rows.slice(0, LIMITS.dashboard), capped: rows.length > LIMITS.dashboard }); })
      .catch(e => { if (live) setError(errText(e)); })
      .finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, days]);

  const metrics = useMemo(() => {
    let total = 0;
    const orders = new Set();
    const byInitials = {};
    data.rows.forEach(r => {
      const h = Number(r.craa5_hoursworked) || 0;
      total += h;
      const sap = normCode(r.craa5_sap);
      if (sap) orders.add(sap);
      const k = safeString(r.craa5_lastcleanedby).toUpperCase() || 'Unknown';
      byInitials[k] = (byInitials[k] || 0) + h;
    });
    return { total: total.toFixed(1), orders: orders.size, count: data.rows.length, noId: data.rows.filter(r => !safeString(r.craa5_equipmentguid)).length, byInitials: Object.entries(byInitials).sort((a, b) => b[1] - a[1]) };
  }, [data]);

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Dashboard Metrics</Text>
      <div className={styles.actionBar}>
        <Select aria-label="Period" value={days} onChange={(e, d) => setDays(d.value)}>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="90">Last 90 days</option>
        </Select>
        <Text className={styles.hint} aria-live="polite">{loading ? 'Loading...' : data.capped ? `Based on the newest ${data.rows.length} entries of the period; older entries are not counted. Choose a shorter period for exact totals.` : `Based on ${data.rows.length} entries.`}</Text>
      </div>
      {error && <Text className={styles.errorText} block role="alert">Could not load the dashboard: {error}</Text>}
      <div className={styles.dashboardGrid}>
        {[['Total Hours Logged', metrics.total, BRAND.blue], ['Unique SAP Orders', metrics.orders, BRAND.yellow], ['Log Entries', metrics.count, BRAND.logoBlue], ['Entries With No Equipment ID', metrics.noId, BRAND.red]].map(([label, value, color]) => (
          <div key={label} className={styles.metricCard} style={{ borderTop: `4px solid ${color}` }}>
            <Text className={styles.metricLabel}>{label}</Text>
            <Text className={styles.metricValue}>{loading || error ? '-' : value}</Text>
          </div>
        ))}
      </div>
      <div className={styles.listCard}>
        <Text size={500} weight="semibold" block style={{ marginBottom: 12 }}>Hours Logged by Person (Initials)</Text>
        <div style={{ maxHeight: 400, overflowY: 'auto', paddingRight: 8 }}>
          {!loading && metrics.byInitials.length ? metrics.byInitials.map(([ini, h]) => (
            <div key={ini} className={styles.listItem}><Text weight="semibold">{ini}</Text><Text>{h.toFixed(1)} Hours</Text></div>
          )) : <Text>{loading ? 'Loading...' : error ? 'Not available.' : 'No entries in this period.'}</Text>}
        </div>
      </div>
    </div>
  );
};

// --- CALENDAR (one month at a time) ---
const CalendarTab = ({ ctx }) => {
  const styles = useStyles();
  const { api, maxDate } = ctx;
  const [month, setMonth] = useState(() => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1); });
  const [entries, setEntries] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [open, setOpen] = useState(null);
  const y = month.getFullYear(), m = month.getMonth();

  useEffect(() => {
    let live = true;
    const from = `${y}-${String(m + 1).padStart(2, '0')}-01`;
    const to = toDateInput(new Date(y, m + 1, 1));
    setLoading(true); setError(''); setOpen(null);
    api.query(LOG_TABLE, { select: ['craa5__log_id', 'craa5_sap', 'craa5_equipment', 'craa5_lastcleaned', 'craa5_lastcleanedby'], filter: `statecode eq 0 and craa5_lastcleaned ge ${from}T00:00:00Z and craa5_lastcleaned lt ${to}T00:00:00Z`, orderBy: 'craa5_lastcleaned asc', top: LIMITS.calendar })
      .then(rows => { if (live) setEntries(rows.map(mapLog)); })
      .catch(e => { if (live) setError(errText(e)); })
      .finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, y, m]);

  const startDay = new Date(y, m, 1).getDay();
  const days = new Date(y, m + 1, 0).getDate();
  const cells = [...Array.from({ length: startDay }, () => null), ...Array.from({ length: days }, (_, i) => `${y}-${String(m + 1).padStart(2, '0')}-${String(i + 1).padStart(2, '0')}`)];
  const byDay = {};
  entries.forEach(e => { if (e.date) (byDay[e.date] = byDay[e.date] || []).push(e); });

  return (
    <div>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Calendar View</Text>
      <div className={styles.calHeader}>
        <Button onClick={() => setMonth(new Date(y, m - 1, 1))}>Previous</Button>
        <Text weight="semibold" aria-live="polite">{month.toLocaleString('default', { month: 'long', year: 'numeric' })}{loading ? ' - loading...' : ''}</Text>
        <Button onClick={() => setMonth(new Date(y, m + 1, 1))}>Next</Button>
      </div>
      {error && <Text className={styles.errorText} block role="alert">Could not load this month: {error}</Text>}
      {entries.length >= LIMITS.calendar && <Text className={styles.warnText} block style={{ marginBottom: 8 }}>This month has more than {LIMITS.calendar} entries; only the earliest {LIMITS.calendar} are shown, so later days look emptier than they are. Use the Log Table filters for the rest.</Text>}
      <div className={styles.calGrid}>
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => <div key={d} className={styles.weekday}>{d}</div>)}
        {cells.map((k, i) => {
          const list = (k && byDay[k]) || [];
          const expanded = open === k;
          return (
            <div key={k || `e${i}`} className={mergeClasses(styles.dayCell, k === maxDate && styles.dayCellToday)}>
              {k && <div style={{ fontWeight: 700, marginBottom: 4 }}>{Number(k.slice(8))}</div>}
              {(expanded ? list : list.slice(0, 3)).map(e => <div key={e.id} className={styles.entryText} title={`${e.equipment} - ${e.by}`}>{e.equipment || e.sap} - {e.by}</div>)}
              {list.length > 3 && <button type="button" onClick={() => setOpen(expanded ? null : k)} style={{ border: 'none', background: 'none', color: BRAND.blue, cursor: 'pointer', fontSize: 11, textAlign: 'left', padding: 0 }}>{expanded ? 'Show less' : `+${list.length - 3} more`}</button>}
            </div>
          );
        })}
      </div>
    </div>
  );
};

// --- SKIP CODES & SUGGESTED DATAVERSE TABLE TAB ---
const SKIP_CATEGORIES = ['Production', 'Maintenance', 'Safety', 'Access', 'Scheduling', 'Other'];
const SkipCodesTab = ({ ctx }) => {
  const styles = useStyles();
  const { store, dataVer, dataChanged } = ctx;
  const [codes, setCodes] = useState(() => store.getSkipCodes());
  const [history, setHistory] = useState(() => store.getSkippedHistory());
  const [dvStatus, setDvStatus] = useState(() => store.skipTableState());
  const [editCodeOrig, setEditCodeOrig] = useState('');
  const [codeVal, setCodeVal] = useState('');
  const [labelVal, setLabelVal] = useState('');
  const [catVal, setCatVal] = useState('Production');
  const [reqNoteVal, setReqNoteVal] = useState(false);
  const [activeVal, setActiveVal] = useState(true);
  const [busy, setBusy] = useState(false);
  const [msg, setMsg] = useState(null);
  const [copiedSchema, setCopiedSchema] = useState(false);

  const refreshLocal = useCallback(() => {
    setCodes(store.getSkipCodes());
    setHistory(store.getSkippedHistory());
    setDvStatus(store.skipTableState());
  }, [store]);

  useEffect(() => { refreshLocal(); }, [refreshLocal, dataVer]);

  const startEdit = (item) => {
    setEditCodeOrig(item.code);
    setCodeVal(item.code);
    setLabelVal(item.label);
    setCatVal(item.category || 'Other');
    setReqNoteVal(!!item.requiresNote);
    setActiveVal(item.active !== false);
    setMsg(null);
  };

  const clearForm = () => {
    setEditCodeOrig('');
    setCodeVal('');
    setLabelVal('');
    setCatVal('Production');
    setReqNoteVal(false);
    setActiveVal(true);
  };

  const handleSave = async () => {
    const cleanCode = safeString(codeVal).toUpperCase().replace(/[^A-Z0-9_-]/g, '');
    const cleanLabel = safeString(labelVal);
    if (!cleanCode || !cleanLabel) {
      setMsg({ kind: 'err', text: 'Enter both a short Code (e.g. NIP, MNT, LOTO) and a Reason / Label.' });
      return;
    }
    setBusy(true);
    setMsg(null);
    try {
      const existing = codes.find(c => c.code === (editCodeOrig || cleanCode));
      if (editCodeOrig && editCodeOrig !== cleanCode) {
        await store.deleteSkipCode(editCodeOrig);
      }
      await store.saveSkipCode({
        id: existing ? existing.id : null,
        code: cleanCode,
        label: cleanLabel,
        category: catVal,
        requiresNote: reqNoteVal,
        active: activeVal,
        sortOrder: existing ? existing.sortOrder : (codes.length + 1) * 10,
      });
      refreshLocal();
      dataChanged();
      clearForm();
      setMsg({ kind: 'ok', text: `Saved skip code "${cleanCode} - ${cleanLabel}"${store.skipTableState() === true ? ' (saved to app & Dataverse table)' : ' (saved in app storage)'}.` });
    } catch (e) {
      setMsg({ kind: 'err', text: `Could not save skip code: ${errText(e)}` });
    } finally {
      setBusy(false);
    }
  };

  const handleToggleActive = async (item) => {
    setBusy(true);
    try {
      await store.saveSkipCode({ ...item, active: item.active === false });
      refreshLocal();
      dataChanged();
    } catch (e) {
      setMsg({ kind: 'err', text: `Could not update ${item.code}: ${errText(e)}` });
    } finally {
      setBusy(false);
    }
  };

  const handleDelete = async (item) => {
    if (!window.confirm(`Delete skip code "${item.code} - ${item.label}"?`)) return;
    setBusy(true);
    setMsg(null);
    try {
      await store.deleteSkipCode(item.code);
      refreshLocal();
      dataChanged();
      if (editCodeOrig === item.code) clearForm();
      setMsg({ kind: 'ok', text: `Deleted skip code "${item.code}".` });
    } catch (e) {
      setMsg({ kind: 'err', text: `Could not delete ${item.code}: ${errText(e)}` });
    } finally {
      setBusy(false);
    }
  };

  const handleResetDefaults = async () => {
    if (!window.confirm('Reset the skip code list to the default plant codes? Any custom codes stored only in browser storage will be replaced.')) return;
    store.resetSkipCodes();
    refreshLocal();
    dataChanged();
    clearForm();
    setMsg({ kind: 'ok', text: 'Reset skip codes to default list.' });
  };

  const handleSyncDataverse = async () => {
    setBusy(true);
    setMsg(null);
    try {
      await store.syncSkipCodesFromDataverse(true);
      refreshLocal();
      dataChanged();
      const st = store.skipTableState();
      if (st === true) setMsg({ kind: 'ok', text: `Connected and synced skip codes with Dataverse table ${SKIP_TABLE} (${SKIP_SET}).` });
      else setMsg({ kind: 'warn', text: `Dataverse table ${SKIP_TABLE} (${SKIP_SET}) was not found yet. Using in-app storage until the table is created (see blueprint below).` });
    } catch (e) {
      setMsg({ kind: 'err', text: `Could not probe Dataverse table: ${errText(e)}` });
    } finally {
      setBusy(false);
    }
  };

  const handleSeedToDataverse = async () => {
    setBusy(true);
    setMsg(null);
    try {
      const res = await store.seedSkipCodesToDataverse();
      refreshLocal();
      dataChanged();
      if (!res.ok) setMsg({ kind: 'warn', text: res.error });
      else setMsg({ kind: 'ok', text: `Seeded ${res.pushed} skip code(s) into Dataverse table ${SKIP_TABLE}.` });
    } catch (e) {
      setMsg({ kind: 'err', text: `Could not seed Dataverse table: ${errText(e)}` });
    } finally {
      setBusy(false);
    }
  };

  const copyBlueprint = () => {
    const text = JSON.stringify(SUGGESTED_SKIP_TABLE_SCHEMA, null, 2);
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
        setCopiedSchema(true);
        setTimeout(() => setCopiedSchema(false), 2500);
      }
    } catch (_) { /* ignore clipboard errors */ }
  };

  const tagClass = (k) => mergeClasses(styles.tag, k === 'ok' ? styles.tagOk : k === 'warn' ? styles.tagWarn : k === 'bad' ? styles.tagBad : styles.tagInfo);

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 18 }}>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 10 }}>
        <div>
          <Text size={600} weight="semibold" block className={styles.sectionTitle} style={{ marginBottom: 4 }}>
            Equipment Skip / Not-Done Codes & Suggested Dataverse Table
          </Text>
          <Text className={styles.hint} block>
            Modify the codes used to skip equipment or mark why a piece on a SAP order was not completed. Codes are stored immediately in the app and automatically sync with Dataverse when <strong>{SKIP_TABLE}</strong> exists.
          </Text>
        </div>
        <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
          <span className={tagClass(dvStatus === true ? 'ok' : 'info')}>
            {dvStatus === true ? `Dataverse Table Active (${SKIP_TABLE})` : `In-App Storage Active (Table ${SKIP_TABLE} Optional)`}
          </span>
          <Button size="small" appearance="secondary" disabled={busy} onClick={handleSyncDataverse}>
            {busy ? 'Checking...' : 'Check / Sync Dataverse Table'}
          </Button>
          {dvStatus === true && (
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={busy} onClick={handleSeedToDataverse}>
              Push All Local Codes to Dataverse
            </Button>
          )}
          <Button size="small" appearance="subtle" disabled={busy} onClick={handleResetDefaults}>
            Reset Defaults
          </Button>
        </div>
      </div>

      {msg && (
        <Text className={msg.kind === 'ok' ? styles.okText : msg.kind === 'warn' ? styles.warnText : styles.errorText} block role="status">
          {msg.text}
        </Text>
      )}

      {/* Add / Edit Skip Code Card */}
      <div className={styles.rowCard}>
        <Text weight="semibold" block style={{ marginBottom: 8 }}>
          {editCodeOrig ? `Edit Skip Code: ${editCodeOrig}` : 'Add New Skip / Not-Done Code'}
        </Text>
        <div className={styles.rowFields} style={{ alignItems: 'flex-end' }}>
          <div className={styles.field} style={{ width: 130 }}>
            <Text className={styles.label}>Code (Short ID)</Text>
            <Input aria-label="Skip code short ID" placeholder="Ex: NIP, MNT" value={codeVal} disabled={busy}
