    for (const l of skippedLines) {
      const sk = skipByLine[l.key];
      const def = activeSkipCodes.find(c => c.code === (sk && sk.code));
      if (def && def.requiresNote && !safeString(sk && sk.note)) {
        return `${l.name}: skip code "${def.code} - ${def.label}" requires a brief note explaining why it was skipped.`;
      }
    }
    const rawHours = parseFloat(totalHours);
    if (includedActive.length > 0) {
      if (!(rawHours >= 0) || rawHours > 200) return 'Enter the hours it took (0 or more).';
      const total = Math.max(0, Math.ceil(rawHours || 0));
      if (includedActive.some(l => hoursOverride[l.key] !== undefined && !(parseFloat(hoursOverride[l.key]) >= 0))) return 'Every selected equipment needs hours (0 or more).';
      // Automatic distribution rounds UP each line/piece to a whole number (Math.ceil), so hoursSum may exceed total by up to includedActive.length
      const maxRoundedUp = total + includedActive.length;
      const anyManualOverride = includedActive.some(l => hoursOverride[l.key] !== undefined);
      if (hoursSum < total) return `Line hours add up to ${hoursSum} (whole numbers) which is less than the order total of ${total}.`;
      if (anyManualOverride && hoursSum > Math.max(total, maxRoundedUp)) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    } else if (String(totalHours).trim() !== '' && (!(rawHours >= 0) || rawHours > 200)) {
      return 'Total hours must be 0 or more.';
    }
    if (lines.some(l => !l.splitting && retro[l.key] && retro[l.key].status === 'scanning')) return 'Still checking earlier entries for a changed line. Try again in a moment.';
    if (photoBusy) return 'Still preparing the paperwork picture. Try again in a moment.';
    return '';
  };

  // Write the SAP order onto an equipment's SAP row (update its frequency column, or create the row).
  // Skips writing to MS_TABLE for 'auto- xxx' completions or when col is 'none' (odd frequency / log-only).
  const storeCode = async (asset, col, notes) => {
    const targetCol = (col && col !== 'none') ? col : addFreq;
    if (!targetCol || targetCol === 'none' || isAutoSap(normalizedCode)) return false;
    const row = await store.findMsForAsset(asset);
    const existing = row && (row.codes.find(c => c.col === targetCol) || {}).code;
    if (row && existing === normalizedCode) {
      if (!row.assetId && asset && asset.id && !asset.isNew && store.lookupState() !== false) {
        try { await store.writeMs(row.id, {}, asset); } catch (_) { /* ignore link error */ }
      }
      return false;
    }
    if (row && existing && !window.confirm(`${asset.name} (${placeText(asset)}) already has ${existing} as its ${freqLabel(targetCol)} code. Replace it with ${normalizedCode}?`)) {
      notes.push(`${asset.name}: kept ${existing}; ${normalizedCode} was not stored on it.`);
      return false;
    }
    if (row) {
      const r = await store.writeMs(row.id, { [targetCol]: normalizedCode }, row.assetId ? null : asset);
      if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
      return true;
    }
    const r = await store.writeMs(null, { craa5_title: normalizedCode, [targetCol]: normalizedCode, craa5_equipment: asset.name, craa5_textroom: asset.room, craa5_textarea: asset.area }, asset);
    if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
    return true;
  };

  // Immediately save/attach all current equipment lines to the SAP order in craa5_aa_ms_assets (without waiting for log submission)
  const saveAssetsToOrderNow = async () => {
    if (!normalizedCode || isAutoOrder || savingOrderAssets || saving) return;
    const toSave = lines.filter(l => !excluded[l.key] && l.asset);
    if (!toSave.length) {
      setNote('Add or select at least one equipment line to save to this SAP order.');
      return;
    }
    setSavingOrderAssets(true);
    setNote('');
    const notes = [];
    let attachedCount = 0;
    try {
      for (const l of toSave) {
        let targetAsset = l.asset;
        if (targetAsset.isNew) {
          targetAsset = (await store.findAssetExact(l.name, l.room, l.area)) || (await store.createAsset({ name: l.name, room: l.room, area: l.area }));
        }
        const wrote = await storeCode(targetAsset, (l.col && l.col !== 'none') ? l.col : addFreq, notes);
        if (wrote) attachedCount += 1;
      }
      store.dropOrders();
      const reloaded = await store.loadOrder(normalizedCode);
      setOrder({ status: 'ready', ...reloaded });
      setExtras([]);
      setNote(`Saved ${toSave.length} asset${toSave.length === 1 ? '' : 's'} to SAP order ${normalizedCode} (${freqLabel(addFreq)})${attachedCount ? ` - ${attachedCount} updated/created in MSS SAP table` : ' - all already linked'}.${notes.length ? ` ${notes.join(' ')}` : ''}`);
    } catch (e) {
      setNote(`Could not save assets to ${normalizedCode}: ${errText(e)}`);
    } finally {
      setSavingOrderAssets(false);
    }
  };

  // seen: "log|id" for entries this submit created or moved, so no entry is moved twice
  const commit = async (seen) => {
    const notes = [];
    const info = [];
    readSeq.current += 1;
    setSheet(s => (s.status === 'reading' || s.status === 'loading' ? { ...s, status: 'stopped' } : s));
    const ini = normalizeInitials(initials);
    // 0. Earlier entries to move for changed lines
    const retroRows = {};
    const claimed = new Set();
    for (const l of included) {
      const r = retro[l.key];
      if (!r || !r.apply || !r.count) continue;
      const stillUsed = !!r.from && lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === r.from.id);
      const filter = retroFilter(normalizedCode, r.from, l.ms, stillUsed);
      if (!filter) continue;
      try {
        const got = await api.query(LOG_TABLE, { select: RETRO_SELECT, filter, top: LIMITS.countCap + 1 });
        const some = got.slice(0, LIMITS.countCap);
        retroRows[l.key] = some.filter(x => !claimed.has(x.craa5__log_id) && !seen.has(`log|${cleanGuid(x.craa5__log_id)}`));
        retroRows[l.key].forEach(x => claimed.add(x.craa5__log_id));
        if (got.length > LIMITS.countCap) notes.push(`${l.name}: more than ${LIMITS.countCap} earlier entries; the first ${LIMITS.countCap} are moved.`);
      } catch (e) { notes.push(`${l.name}: earlier entries could not be checked (${errText(e)}).`); }
    }
    lines.forEach(l => {
      const r = retro[l.key];
      if (excluded[l.key] && !l.splitting && r && r.apply && r.count) notes.push(`${l.name}: ${plural(r.count, 'earlier entry was', 'earlier entries were')} not moved because the line is unticked.`);
    });
    // 1. Equipment edits made through "Edit pre-filled details"
    const edited = {};
    for (const l of lines) {
      if (excluded[l.key] || !l.asset || l.asset.isNew || !edits[l.key] || edits[l.key].id !== l.asset.id) continue;
      const a = l.asset;
      if (a.name !== l.name || a.room !== l.room || a.area !== l.area) {
        try { edited[l.key] = await store.updateAsset(a, l.name, l.room, l.area); }
        catch (e) { return { saved: 0, notes, info, error: `Could not update ${a.name}: ${errText(e)}` }; }
      }
    }
    // 2. New assets: created unless an identical one exists by now
    const resolved = {};
    for (const l of included) {
      if (!l.asset.isNew) continue;
      try { resolved[l.key] = (await store.findAssetExact(l.name, l.room, l.area)) || (await store.createAsset({ name: l.name, room: l.room, area: l.area })); }
      catch (e) { return { saved: 0, notes, info, error: `Could not create ${l.name}: ${errText(e)}` }; }
    }
    const assetOf = (l) => resolved[l.key] || edited[l.key] || l.asset;
    // 2b. Attach SAP order to all added equipment, all name-matched sibling assets, and any unlinked/broken-up lines
    let attachedToOrder = 0;
    for (const l of included.filter(x => x.extra || x.autoAttachedByName || !x.msId || x.parent)) {
      try {
        const wrote = await storeCode(assetOf(l), (l.col && l.col !== 'none') ? l.col : addFreq, notes);
        if (wrote) attachedToOrder += 1;
      } catch (e) { notes.push(`${assetOf(l).name}: could not store the SAP order (${errText(e)}).`); }
    }
    if (attachedToOrder > 0) {
      info.push(`Attached SAP order ${normalizedCode} to ${plural(attachedToOrder, 'asset record', 'asset records')}.`);
    }
    // 3. SAP rows remember their equipment once it is certain
    if (store.lookupState() !== false && !isAutoOrder) {
      for (const l of included) {
        if (!l.msId) continue;
        const sure = ['changed', 'chosen', 'new asset'].includes(l.how) || (l.how === 'best fit' && l.tier === 'high' && !l.ambiguous);
        if (!sure || (l.linked && l.linked.id === assetOf(l).id)) continue;
        try {
          const r = await store.writeMs(l.msId, {}, assetOf(l));
          if (!r.linked) notes.push(`${assetOf(l).name}: the SAP row's equipment link (craa5_asset) could not be stored${r.error ? ` (${r.error})` : ''}.`);
        } catch (e) { notes.push(`${assetOf(l).name}: the SAP row's equipment link could not be stored (${errText(e)}).`); }
      }
      for (const e of matches) {
        const pick = chosen[e.key];
        if (!e.msId || !pick || !pick.isNew || lines.some(x => (x.parent || x.key) === e.key)) continue;
        const holder = included.find(x => x.asset && x.asset.id === pick.id);
        if (!holder) continue;
        try {
          const r = await store.writeMs(e.msId, {}, assetOf(holder));
          if (!r.linked) notes.push(`${assetOf(holder).name}: the equipment link of another SAP row for it could not be stored${r.error ? ` (${r.error})` : ''}.`);
        } catch (err) { notes.push(`${assetOf(holder).name}: the equipment link of another SAP row for it could not be stored (${errText(err)}).`); }
      }
    }
    // 4. Changed lines: move the earlier entries read in step 0 onto the chosen equipment
    for (const l of included) {
      const r = retro[l.key];
      const todo = retroRows[l.key];
      if (!r || !todo) continue;
      const target = assetOf(l);
      if (todo.length) {
        const res = await repointRows(api, todo, r.from, target);
        res.movedIds.forEach(id => seen.add(`log|${cleanGuid(id)}`));
        if (res.fixed) info.push(`Moved ${plural(res.fixed, 'earlier entry', 'earlier entries')} to ${target.name} (${placeText(target)}).`);
        if (res.failed) notes.push(`${target.name}: ${plural(res.failed, 'earlier entry', 'earlier entries')} could not be moved (${res.error}).`);
      }
      setRetro(p => ({ ...p, [l.key]: { ...p[l.key], count: 0, apply: false } }));
    }
    // 4b. Record any equipment lines marked with a Skip / Not-Done code
    const seenKey = (id) => `${normalizedCode}|${dateStr}|${id}`;
    let savedSkips = 0;
    if (skippedLines.length > 0) {
      const skipRecords = skippedLines.map(l => {
        const a = assetOf(l);
        const sk = skipByLine[l.key] || {};
        const def = activeSkipCodes.find(c => c.code === sk.code);
        return {
          sap: normalizedCode,
          date: dateStr,
          by: ini,
          equipmentId: a ? a.id : '',
          equipment: l.name,
          room: l.room,
          area: l.area,
          col: l.col,
          skipCode: sk.code,
          skipLabel: def ? def.label : sk.code,
          skipReason: safeString(sk.note) || (def ? def.label : sk.code),
          note: safeString(sk.note),
        };
      });
      store.recordSkippedEntries(skipRecords);
      const skipResults = await pool(skipRecords, 6, (sr) => store.createLog({
        craa5_equipmentguid: sr.equipmentId,
        craa5_equipment: sr.equipment,
        craa5_room: sr.room,
        craa5_area: sr.area,
        craa5_sap: normalizedCode,
        craa5_lastcleaned: toLogDate(dateStr),
        craa5_lastcleanedby: ini,
        craa5_hoursworked: 0,
      }, normalizedCode, sr.col, { skipCode: sr.skipCode, skipReason: sr.skipReason }, { minutes: 0, pathogen: false }));
      skipResults.forEach((r, idx) => {
        if (r.ok) {
          savedSkips += 1;
          if (skipRecords[idx].equipmentId) seen.add(seenKey(skipRecords[idx].equipmentId));
          seen.add(`log|${cleanGuid(r.value)}`);
        }
      });
      info.push(`Recorded ${plural(skipRecords.length, 'skipped equipment item', 'skipped equipment items')} (${skipRecords.map(r => `${r.equipment}: ${r.skipCode}`).join(', ')}).`);
    }
    // 5. Log each included non-skipped equipment (multiple entries on the same day are allowed; hours rounded UP to whole number)
    const toLog = [];
    const at = {};
    let merged = 0;
    includedActive.forEach((l) => {
      const a = assetOf(l);
      if (at[a.id] !== undefined) { toLog[at[a.id]].hours = Math.ceil(toLog[at[a.id]].hours + lineHours(l)); toLog[at[a.id]].minutes += Math.round((lineHours(l) || 0) * 60); merged += 1; return; }
      at[a.id] = toLog.length;
      const fromAsset = !!resolved[l.key];
      toLog.push({ asset: a, col: l.col, name: fromAsset ? a.name : l.name, room: fromAsset ? a.room : l.room, area: fromAsset ? a.area : l.area, hours: Math.max(0, Math.ceil(lineHours(l) || 0)), minutes: Math.round((lineHours(l) || 0) * 60) });
    });
    if (merged) notes.push(`${plural(merged, 'line named', 'lines named')} equipment that another line has too, so ${merged === 1 ? 'it was' : 'they were'} saved with that entry and the hours added.`);
    if (toLog.length === 0 && skippedLines.length > 0) {
      store.dropOrders();
      return { saved: savedSkips, notes, info };
    }
    // 6. One log row per equipment, including clean-kind boolean flags (craa5_daily, craa5_weekly, craa5_monthly)
    const results = await pool(toLog, 6, (l) => store.createLog({
      craa5_equipmentguid: l.asset.id,
      craa5_equipment: l.name,
      craa5_room: l.room,
      craa5_area: l.area,
      craa5_sap: normalizedCode,
      craa5_lastcleaned: toLogDate(dateStr),
      craa5_lastcleanedby: ini,
      craa5_hoursworked: Math.max(0, Math.ceil(l.hours || 0)),
    }, normalizedCode, l.col, null, { minutes: l.minutes, pathogen }));
    const already = store.takeMerged();
    if (already) info.push(tr(`${plural(already, 'piece was', 'pieces were')} already in the log for this date and clean (saved by Ganttly or an earlier entry); the SAP order was added to ${already === 1 ? 'that entry' : 'those entries'} instead of a second one.`,
      `${already} pieza(s) ya estaban en el registro para esta fecha y limpieza (guardadas por Ganttly o un registro anterior); la orden SAP se agrego a ese registro en lugar de uno nuevo.`));
    const savedIds = [];
    const failedNames = [];
    results.forEach((r, i) => {
      if (r.ok) { savedIds.push(r.value); seen.add(seenKey(toLog[i].asset.id)); seen.add(`log|${cleanGuid(r.value)}`); }
      else failedNames.push(toLog[i].name);
    });
    if (savedIds.length) setDupes(prev => new Set(Array.from(prev).concat(results.map((r, i) => (r.ok ? toLog[i].asset.id : null)).filter(Boolean))));
    if (photo && savedIds.length) {
      const isPdf = photoMime === 'application/pdf';
      const fileName = `paperwork-${normalizedCode}-${dateStr}.${isPdf ? 'pdf' : 'jpg'}`.replace(/[^A-Za-z0-9._-]/g, '_');
      const what = isPdf ? 'paperwork PDF' : 'paperwork picture';
      const pr = await pool(savedIds, 3, (id) => api.uploadFile(LOG_TABLE, id, PAPERWORK_COL, photo, fileName, isPdf ? 'application/pdf' : 'image/jpeg'));
      const bad = pr.filter(r => !r.ok);
      if (bad.length) notes.push(`Entries saved, but the ${what} was not attached to ${bad.length === pr.length ? (pr.length === 1 ? 'it' : 'them') : plural(bad.length, 'of them', 'of them')} (${errText(bad[0].error)}). To add it, delete the entries whose Paperwork shows "none" in the Log Table and submit them again.`);
      else info.push(`${isPdf ? 'Paperwork PDF' : 'Paperwork picture'} attached to ${plural(pr.length, 'entry', 'entries')}.`);
    }
    store.dropOrders();
    if (failedNames.length) {
      const first = results.find(r => !r.ok);
      return { saved: savedIds.length + savedSkips, notes, info, error: `${savedIds.length} of ${results.length} saved. Not saved: ${failedNames.join(', ')} (${errText(first.error)}). Submit again; saved equipment is skipped as already logged.` };
    }
    return { saved: savedIds.length + savedSkips, notes, info };
  };

  const freeze = () => { readSeq.current += 1; setSheet(s => (s.status === 'reading' || s.status === 'loading' ? { ...s, status: 'stopped' } : s)); };
  useImperativeHandle(ref, () => ({ validate, commit, freeze, getShared: () => ({ date: dateStr, initials: normalizeInitials(initials) }) }));

  const live = lines.filter(l => !excluded[l.key]);
  const summarize = (k) => { const v = Array.from(new Set(live.map(l => l[k]).filter(Boolean))); return v.length === 0 ? '' : v.length === 1 ? v[0] : `Multiple (${v.length})`; };
  const roomList = `mss-rooms-${index}`;
  const areaList = `mss-areas-${index}`;
  const addShown = addOpen === null ? isUnknown : addOpen;
  const needCount = live.filter(l => !l.asset).length;
  const dupeCount = live.filter(l => isDupe(l)).length;
  const skipCount = skippedLines.length;
  const unlinkedOrAddedCount = live.filter(l => l.asset && (l.extra || l.autoAttachedByName || !l.msId)).length;
  const listedAgain = matches.filter(e => !lines.some(l => (l.parent || l.key) === e.key)).length;
  const fromSheet = (kind, now) => (stamp[kind] !== undefined && stamp[kind] === now ? <span className={mergeClasses(styles.tag, styles.tagInfo)} style={{ marginLeft: 6 }}>from the sheet</span> : null);
  const tagClass = (k) => mergeClasses(styles.tag, k === 'ok' ? styles.tagOk : k === 'warn' ? styles.tagWarn : k === 'bad' ? styles.tagBad : k === 'info' ? styles.tagInfo : undefined);

  const renderPanel = (l) => {
    const view = panel[l.key] || 'list';
    const cands = candidatesFor(l);
    const mr = moreRank[l.key];
    const rt = retro[l.key];
    const nf = newFor[l.key] || { name: l.ms.equipment, room: l.ms.room, area: l.ms.area };
    const setNf = (k, v) => setNewFor(p => ({ ...p, [l.key]: { ...nf, [k]: v } }));
    const where = placeText(l.ms);
    const sig = (a) => `${canonName(a.name)}|${normName(a.room)}|${normName(a.area)}`;
    const sigCount = new Map();
    uniqueById([l.asset, l.auto, ...cands.map(c => c.asset)].filter(a => a && !a.isNew)).forEach(a => sigCount.set(sig(a), (sigCount.get(sig(a)) || 0) + 1));
    const idNote = (a) => (a && !a.isNew && sigCount.get(sig(a)) > 1 ? ` - ID ...${shortId(a.id)}` : '');
    return (
      <div className={styles.changePanel}>
        <Text weight="semibold" block>Equipment for "{l.ms.equipment || '(unnamed)'}"{where ? ` in ${where}` : ''}</Text>
        {l.asset
          ? <Text className={styles.hint} block>Using {l.asset.name} - {placeText(l.asset)}{idNote(l.asset)}{l.asset.isNew ? ' (new asset, created on submit)' : ''}{chosen[l.key] && l.auto ? `. Was ${l.auto.name} - ${placeText(l.auto)}${idNote(l.auto)}.` : ''}</Text>
          : cands.length > 0 && cands.every(c => !!usedBy(c.asset.id, l.key))
            ? <Text className={styles.hint} block>The equipment that fits this line is already on other lines of this order (listed below). Search all equipment, or create a new asset.</Text>
            : <Text className={styles.hint} block>No equipment in this room and area matches well enough to pick automatically. Choose one below, search, or create a new asset.</Text>}
        {l.suggestedPieces && l.suggestedPieces.assets.length >= 2 && (
          <div style={{ marginTop: 6, padding: '6px 10px', backgroundColor: '#FFF6E6', border: `1px solid ${BRAND.yellow}`, borderRadius: 6, display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8, flexWrap: 'wrap' }}>
            <Text size={200}>
              <strong>Broken down into {l.suggestedPieces.assets.length} pieces in current assets:</strong> {l.suggestedPieces.assets.map(a => a.name).join(', ')}
            </Text>
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving}
              onClick={() => { closePanel(l); setPiecesFor(l.key, l.suggestedPieces.assets); }}>
              Use {l.suggestedPieces.assets.length} pieces
            </Button>
          </div>
        )}
        {view === 'list' && (
          <div style={{ marginTop: 6 }}>
            {cands.length > 0 ? (
              <div style={{ overflowX: 'auto' }}>
                <table className={styles.linesTable} style={{ marginTop: 0 }}>
                  <tbody>
                    {cands.map(c => (
                      <tr key={c.asset.id}>
                        <td className={styles.td}><strong>{c.asset.name}</strong>{idNote(c.asset) && <span className={styles.hint}>{idNote(c.asset)}</span>}{usedBy(c.asset.id, l.key) && <span className={styles.hint}> - {usedBy(c.asset.id, l.key)}</span>}</td>
                        <td className={styles.td}>{c.asset.room}</td>
                        <td className={styles.td}>{c.asset.area}</td>
                        <td className={styles.td}><span className={tagClass(c.score >= 0.95 ? 'ok' : c.score >= 0.6 ? 'warn' : 'bad')}>{TIER_LABEL[tierOf(c.score)]} - {reasonText(c)}</span></td>
                        <td className={styles.td} style={{ textAlign: 'right' }}>
                          <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving || !!usedBy(c.asset.id, l.key)} aria-label={`Use ${c.asset.name} (${placeText(c.asset)})${idNote(c.asset)}`} onClick={() => choose(l, c.asset)}>Use</Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : <Text className={styles.hint} block>{mr && mr.busy ? 'Looking for similar equipment...' : mr ? 'No other close matches.' : 'No other close matches yet.'}</Text>}
            {!mr && <Button size="small" style={{ marginTop: 6 }} onClick={() => rankMore(l)}>Look for similar names</Button>}
            {mr && mr.error && <Text className={styles.errorText} block role="alert">Could not look for similar equipment: {mr.error}</Text>}
          </div>
        )}
        {view === 'search' && (
          <div style={{ marginTop: 6 }}>
            <AssetPicker store={store} idTails context={l.ms} initialQuery={l.ms.equipment} ariaLabel={`Search equipment for ${l.ms.equipment}`} actionLabel="Use" inUse={(a) => usedBy(a.id, l.key)} disabled={saving}
              onPick={(a) => { choose(l, a); setView(l, 'list'); }} />
          </div>
        )}
        {view === 'new' && (
          <div className={styles.rowFields} style={{ alignItems: 'flex-end', marginTop: 6 }}>
            <div className={styles.field}><Text className={styles.label}>Equipment name</Text><Input aria-label="New asset name" value={nf.name} onChange={(e, d) => setNf('name', d.value)} /></div>
            <div className={styles.field}><Text className={styles.label}>Room</Text><Input aria-label="New asset room" list={roomList} value={nf.room} onChange={(e, d) => { setNf('room', d.value); setTyping(t => ({ ...t, room: d.value })); }} /></div>
            <div className={styles.field}><Text className={styles.label}>Area</Text><Input aria-label="New asset area" list={areaList} value={nf.area} onChange={(e, d) => { setNf('area', d.value); setTyping(t => ({ ...t, area: d.value, roomCtx: safeString(nf.room) })); }} /></div>
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} onClick={() => useNewAsset(l)}>Use new asset</Button>
          </div>
        )}
        <div className={styles.actionBar} style={{ marginTop: 8, marginBottom: 0 }}>
          {view !== 'list' && <Button size="small" onClick={() => setView(l, 'list')}>Best fits</Button>}
          {view !== 'search' && <Button size="small" onClick={() => setView(l, 'search')}>Search all equipment</Button>}
          {view !== 'new' && <Button size="small" onClick={() => setView(l, 'new')}>Create new asset</Button>}
          <Button size="small" disabled={saving} aria-label={`Break up into pieces: ${l.ms.equipment || 'this line'}`} data-break-up={l.key} onClick={() => startBreakUp(l)}>Break up into pieces</Button>
          {chosen[l.key] && <Button size="small" disabled={saving} onClick={() => undoChoice(l)}>Undo change</Button>}
          <Button size="small" appearance="subtle" onClick={() => closePanel(l)}>Done</Button>
        </div>
        {rt && (
          <div aria-live="polite" style={{ marginTop: 6 }}>
            {rt.status === 'scanning' && <Text className={styles.hint} block>Checking earlier entries of {normalizedCode}...</Text>}
            {rt.status === 'error' && <Text className={styles.errorText} block>Could not check earlier entries: {rt.error}</Text>}
            {rt.status === 'ready' && rt.count > 0 && (
              <Checkbox checked={!!rt.apply} disabled={saving} onChange={(e, d) => setRetro(p => ({ ...p, [l.key]: { ...p[l.key], apply: !!d.checked } }))}
                label={`On submit, also move ${rt.count}${rt.more ? '+' : ''} earlier ${rt.count === 1 && !rt.more ? 'entry' : 'entries'} for this line${rt.from && !rt.stillUsed ? ` (saved to ${rt.from.name} - ${placeText(rt.from)}, or with no equipment ID)` : ' (saved with no equipment ID)'} to ${l.asset ? l.asset.name : 'the chosen equipment'}.`} />
            )}
            {rt.status === 'ready' && rt.skipped > 0 && (
              <Text className={styles.hint} block>
                {plural(rt.skipped, 'earlier entry stays', 'earlier entries stay')} where {rt.skipped === 1 ? 'it is' : 'they are'}: {l.asset ? l.asset.name : 'the chosen equipment'} already has an entry for that order on the same day.
                {rt.count > 0 ? ' This order looks logged piece by piece, so the box above is not ticked: tick it only if those entries really belong to this equipment.' : ''}
              </Text>
            )}
            {rt.status === 'ready' && !rt.count && <Text className={styles.hint} block>No earlier entries need correcting.</Text>}
          </div>
        )}
      </div>
    );
  };

  // The pieces of a SAP row being broken up: a hint, the pieces so far, and a search to add more
  const renderSplit = (key) => {
    const e = matches.find(x => x.key === key);
    if (!e) return null;
    const ms = { equipment: e.equipment, room: e.room, area: e.area };
    const list = pieces[key] || [];
    const taken = takenFor(key);
    const hint = hints[key];
    const found = (hint && hint.status === 'ready' ? hint.found : null) || e.suggestedPieces || null;
    const unused = found ? found.assets.filter(a => !list.some(x => x.id === a.id)) : [];
    const onOther = unused.filter(a => taken.has(a.id));
    const where = placeText(ms);
    const seen = wrapRef.current ? wrapRef.current.clientWidth : 0;
    const boxW = seen ? Math.max(260, Math.min(640, seen - 24)) : 640;
    return (
      <div className={styles.changePanel} style={{ position: 'sticky', left: 0, width: boxW, boxSizing: 'border-box' }} data-split={key} tabIndex={-1} role="group" aria-label={`Pieces of ${ms.equipment || 'this line'}`}>
        <Text weight="semibold" block>Break up "{ms.equipment || '(unnamed)'}"{where ? ` in ${where}` : ''} into pieces</Text>
        <Text className={styles.hint} block>Each piece gets its own entry with the same date, SAP order and initials, saved to that equipment. The hours of this line are shared out among its pieces. Nothing is saved until you submit.</Text>
        <div aria-live="polite">
          {hint && hint.status === 'busy' && <Text className={styles.hint} block>Looking for the pieces...</Text>}
          {hint && hint.status === 'error' && list.length < 2 && <Text className={styles.errorText} block role="alert">Could not look for the pieces: {hint.error}. Search below to add them.</Text>}
          {hint && hint.status === 'ready' && !found && list.length === 0 && <Text className={styles.hint} block>No pieces were found for this line. Search below to add them.</Text>}
          {unused.length > 0 && (
            <div className={styles.hint} style={{ marginTop: 4 }}>
              {found.how === 'text' ? 'This line lists several things. Found: ' : 'Broken-down child equipment found here: '}<strong>{found.assets.map(a => a.name).join(', ')}</strong>.
              {onOther.length > 0 && ` ${onOther.map(a => a.name).join(', ')} ${onOther.length === 1 ? 'is' : 'are'} already on another line of this order.`}
              {' '}
              {unused.length > onOther.length && <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving} aria-label={`Use these pieces for ${ms.equipment || 'this line'}`} onClick={() => addFound(key, found)}>Use these pieces</Button>}
            </div>
          )}
        </div>
        <div style={{ marginTop: 6 }}>
          <PiecesEditor store={store} g={ms} list={list} missing={found ? found.missing : []} taken={taken} whyUsed={(a) => usedBy(a.id, null)} disabled={saving}
            onChange={(next) => setPiecesFor(key, next)} onDone={() => { focusTo.current = `[data-edit-pieces="${key}"]`; closeSplit(key); }} />
        </div>
      </div>
    );
  };

  return (
    <div className={styles.rowCard}>
      <div className={styles.rowFields}>
        <div className={styles.field}>
          <Text className={styles.label}>SAP Order (Req){fromSheet('code', normalizedCode)}</Text>
          <Input
            data-row={index}
            data-col="sap"
            aria-label="SAP order"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded={listOpen}
            aria-controls={listOpen ? listId : undefined}
            aria-activedescendant={listOpen ? `${listId}-opt-${hiIndex}` : undefined}
            autoComplete="off"
            placeholder="SAP code, asset name/ID, or auto-..."
            value={code}
            disabled={saving}
            style={{ minWidth: '210px' }}
            onChange={(e, d) => { setCode(d.value); setShowSuggest(true); setHi(0); clearOrderState(); }}
            onFocus={() => setShowSuggest(true)}
            onBlur={() => setTimeout(() => setShowSuggest(false), 150)}
            onKeyDown={(e) => {
              if (e.key === 'ArrowDown' && !showSuggest) { e.preventDefault(); setShowSuggest(true); }
              else if (listOpen && e.key === 'ArrowDown') { e.preventDefault(); setHi(h => Math.min(h + 1, suggestions.length - 1)); }
              else if (listOpen && e.key === 'ArrowUp') { e.preventDefault(); setHi(h => Math.max(h - 1, 0)); }
              else if (e.key === 'Enter' && suggestOpen && sugg.busy) e.preventDefault();
              else if (listOpen && e.key === 'Enter') { e.preventDefault(); selectCode(suggestions[hiIndex].code); }
              else if (e.key === 'Escape') setShowSuggest(false);
              else if (e.key === 'Enter') { e.preventDefault(); setShowSuggest(false); onEnter(index); }
            }}
          />
          {suggestOpen && (
            <div className={styles.suggest}>
              {suggestions.length > 0 && (
                <div className={styles.suggestList} role="listbox" id={listId} aria-label="Matching SAP orders" ref={listRef}>
                  {suggestions.map((s, i) => (
                    <button key={s.code} id={`${listId}-opt-${i}`} type="button" role="option" tabIndex={-1} aria-selected={i === hiIndex} className={styles.suggestItem}
                      style={i === hiIndex ? { backgroundColor: '#E6F1FC' } : undefined}
                      onMouseDown={(e) => e.preventDefault()} onClick={() => selectCode(s.code)}>
                      <span><strong>{s.code}</strong>{s.names && <span className={styles.hint}> - {s.names}{s.count > 2 ? '...' : ''}</span>}</span>
                      <span className={styles.hint}>{s.isAuto ? 'auto freq' : `${s.count}${sugg.truncated ? '+' : ''} equipment`}</span>
                    </button>
                  ))}
                </div>
              )}
              <div aria-live="polite">
                {sugg.busy && <div className={styles.suggestNote}>Searching assets and SAP columns...</div>}
                {sugg.error && <div className={styles.suggestNote} style={{ color: BRAND.redText }}>Search failed: {sugg.error}</div>}
                {!sugg.busy && !sugg.error && suggestions.length === 0 && <div className={styles.suggestNote}>No SAP orders match "{normalizedCode}".</div>}
                {!sugg.busy && sugg.truncated && <div className={styles.suggestNote}>Many matches. Keep typing to narrow the list.</div>}
              </div>
            </div>
          )}
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginTop: 4, flexWrap: 'wrap' }}>
            <Select size="small" aria-label="Quick auto-xxx frequency" value={isAutoOrder ? normalizedCode : ''} disabled={saving}
              style={{ minWidth: 165 }}
              onChange={(e, d) => { if (d.value) { selectCode(d.value); setAddMode('room'); setAddOpen(true); } }}>
              <option value="">Quick auto-freq...</option>
              {AUTO_SAP_OPTIONS.map(o => <option key={o.code} value={o.code}>{o.code} ({o.label})</option>)}
            </Select>
            {matches.length > 0 && lines.length > 0 && (
              <Checkbox label={<Text size={200}>Edit pre-filled details</Text>} checked={editMode} disabled={saving} onChange={(e, d) => startEdit(!!d.checked)} />
            )}
          </div>
        </div>

        <div className={styles.field}>
          <Text className={styles.label}>Room</Text>
          <Input aria-label="Room" className={styles.readOnly} value={summarize('room')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Area</Text>
          <Input aria-label="Area" className={styles.readOnly} value={summarize('area')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Equipment</Text>
          <Input aria-label="Equipment" className={styles.readOnly} value={live.length > 1 ? `${live.length} equipment` : summarize('name')} readOnly tabIndex={-1} placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Date (Req){fromSheet('date', dateStr)}</Text>
          <Input aria-label="Date completed" type="date" value={dateStr} min={minDate} max={maxDate} disabled={saving} onChange={(e, d) => { dateTouched.current = true; setDateStr(d.value); }} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Total Hours (Whole #){fromSheet('hours', parseFloat(totalHours))}</Text>
          <Input aria-label="Total hours" type="number" min="0" step="1" placeholder="Ex: 2" value={totalHours} disabled={saving} onChange={(e, d) => setTotalHours(d.value)} style={{ width: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Initials / Names (Req){fromSheet('initials', normalizeInitials(initials))}</Text>
          <Input aria-label="Initials or worker names" placeholder="Ex: EL/LH or John Smith" value={initials} disabled={saving} onChange={(e, d) => setInitials(d.value)}
            onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); onEnter(index); } }} style={{ minWidth: '130px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Paperwork Picture or PDF</Text>
          <input type="file" multiple accept="image/*,.heic,.heif,.pdf,application/pdf" aria-label="Paperwork picture" disabled={saving}
            onChange={(e) => { const fs = Array.from(e.target.files || []); e.target.value = ''; setPaper(fs); }} style={{ minWidth: '150px', padding: '4px' }} />
          {photoName && <span className={styles.hint}>{paperFiles.length > 1 ? `${paperFiles.length} files${photoPages ? `, ${plural(photoPages, 'page', 'pages')}` : ''}` : photoName}{photoBusy ? (paperFiles.length === 1 && !isPdfFile(paperFiles[0]) ? ' (converting to a JPG...)' : ' (preparing the pages...)') : ''}</span>}
          {paperFiles.length > 1 && (
            <div className={styles.filePills}>
              {paperFiles.map((f, i) => (
                <span key={`${f.name}|${i}`} className={styles.filePill} title={f.name}>
                  <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{i + 1}. {f.name}</span>
                  <Button size="small" appearance="subtle" aria-label={`Remove ${f.name}`} disabled={saving} onClick={() => removePaper(i)} style={{ minWidth: 0, padding: '0 4px' }}>x</Button>
                </span>
              ))}
            </div>
          )}
          {photoNote && <Text className={styles.warnText} block role="status" style={{ marginTop: 2 }}>{photoNote}</Text>}
          {paperFiles.length > 0 && (
            <div className={styles.sheetRow} style={{ marginTop: 2 }}>
              <label className={styles.hint} style={{ cursor: saving ? 'default' : 'pointer' }}>Add more pages: <input type="file" multiple accept="image/*,.heic,.heif,.pdf,application/pdf" aria-label="Add more paperwork pages" disabled={saving || photoBusy}
                onChange={(e) => { const fs = Array.from(e.target.files || []); e.target.value = ''; if (fs.length) addPaper(fs); }} style={{ maxWidth: '170px' }} /></label>
              {photo && <Button size="small" appearance="subtle" onClick={() => setPreviewOpen(true)}>Preview</Button>}
              {photo && sheet.status === 'idle' && <Button size="small" appearance="subtle" disabled={saving || photoBusy} onClick={() => startReading(paperFiles)}>Read the sheet</Button>}
              <Checkbox label={<Text size={200}>Read the sheet when it is added</Text>} checked={sheetAuto} disabled={saving} onChange={(e, d) => changeSheetAuto(!!d.checked)} />
            </div>
          )}
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Pathogen</Text>
          <Checkbox label={<Text size={200}>Pathogen follow-up (closes a positive swab)</Text>} checked={pathogen} disabled={saving} onChange={(e, d) => setPathogen(!!d.checked)} />
        </div>
        <Button appearance="subtle" style={{ alignSelf: 'flex-start', marginTop: '16px' }} aria-label={`Remove row ${index + 1}`} disabled={!canRemove || saving} onClick={onRemove}>Remove</Button>
      </div>

      {paperFiles.length > 0 && sheet.status !== 'idle' && !sheetHidden && (
        <SheetPanel sheet={sheet} disabled={saving}
          values={{ code: normalizedCode, date: dateStr, hours: parseFloat(totalHours), initials: normalizeInitials(initials) }}
          onPick={pickFromSheet} onStop={stopReading} onRead={() => startReading(paperFiles)} onHide={() => setSheetHidden(true)} />
      )}
      {previewOpen && previewLocal && (
        <PaperworkViewer api={api} entry={previewEntry} local={previewLocal} onClose={() => setPreviewOpen(false)} />
      )}
      {order && order.status === 'loading' && order.code === normalizedCode && (
        <Text className={styles.hint} block style={{ marginTop: 8 }}>Loading {normalizedCode} and querying assets & SAP columns...</Text>
      )}
      {order && order.status === 'error' && order.code === normalizedCode && (
        <Text className={styles.errorText} block role="alert">Could not load {normalizedCode}: {order.error}</Text>
      )}
      {ready && order.matchedVia === 'stem' && (
        <Text size={200} weight="semibold" block style={{ color: '#0B4F94', marginTop: '8px' }}>
          Autopopulated equipment from base order {order.stemCode} (matched stem for {normalizedCode}).
        </Text>
      )}
      {ready && order.matchedVia === 'history' && (
        <Text size={200} weight="semibold" block style={{ color: '#0A6A33', marginTop: '8px' }}>
          Autopopulated equipment from earlier log completions of {normalizedCode}.
        </Text>
      )}
      {ready && order.nameAttachedCount > 0 && (
        <Text size={200} weight="semibold" block style={{ color: '#0A6A33', marginTop: '8px' }}>
          Auto-attached {order.nameAttachedCount} additional asset{order.nameAttachedCount === 1 ? '' : 's'} with matching equipment name ({(order.attachedNames || []).join(', ')}). All assets with this name will have {normalizedCode} saved to their SAP order record.
        </Text>
      )}
      {isUnknown && (
        <Text size={200} weight="semibold" block style={{ color: isAutoOrder ? '#0B4F94' : '#8A5300', marginTop: '8px' }}>
          {isAutoOrder
            ? `Logging ${normalizedCode} completion - load all equipment in a Room / Area or search specific equipment below.`
            : `${normalizedCode} does not have a saved list of assets yet. Add the assets it covers below (by search, Equipment Name, Room/Area, or new) and save them to ${normalizedCode}.`}
        </Text>
      )}
      {ready && order.capped && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          This order lists more than {LIMITS.orderRows} equipment. Only the first {LIMITS.orderRows} are shown.
        </Text>
      )}

      {lines.length > 0 && (
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginTop: '10px', flexWrap: 'wrap' }}>
          <Button size="small" appearance="secondary" aria-expanded={linesOpen} onClick={() => setLinesOpen(o => !o)}>
            {linesOpen ? `Hide equipment list (${lines.length})` : `Show equipment list (${lines.length})`}
          </Button>
          <Text className={styles.hint}>
            {live.length} included{skipCount ? ` (${skipCount} skipped)` : ''}{needCount ? ` - ${needCount} need equipment` : ''}{dupeCount ? ` - ${dupeCount} already logged` : ''}{listedAgain ? ` - ${plural(listedAgain, 'more SAP row is', 'more SAP rows are')} the same equipment as another line` : ''}
          </Text>
          {!isAutoOrder && unlinkedOrAddedCount > 0 && (
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving || savingOrderAssets} onClick={saveAssetsToOrderNow}>
              {savingOrderAssets ? 'Saving to SAP Order...' : `Save ${unlinkedOrAddedCount} Attached Asset${unlinkedOrAddedCount === 1 ? '' : 's'} to SAP Order (${normalizedCode}) Now`}
            </Button>
          )}
          {lines.some(l => !l.parent && !l.splitting && l.suggestedPieces && l.suggestedPieces.assets.length >= 2) && (
            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving}
              onClick={() => {
                lines.forEach(l => {
                  if (!l.parent && !l.splitting && l.suggestedPieces && l.suggestedPieces.assets.length >= 2) {
                    setPiecesFor(l.key, l.suggestedPieces.assets);
                  }
                });
              }}>
              Break up all lines with suggested child pieces
            </Button>
          )}
        </div>
      )}
      {lines.length > 0 && linesOpen && (
        <div className={styles.linesScroll} ref={wrapRef}>
          <table className={styles.linesTable} style={{ marginTop: 0 }}>
            <thead><tr>
              {['Include', 'Equipment (Current Assets Pull)', 'Room', 'Area', 'Frequency', 'Hours (Whole #)', 'Skip / Not Done Reason', 'Closest Match & Status'].map((h, i) => (
                <th key={h} className={mergeClasses(styles.th, styles.stickyTh)}>{i === 0 ? <span style={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)', whiteSpace: 'nowrap' }}>{h}</span> : h}</th>
              ))}
            </tr></thead>
            <tbody>
              {lines.reduce((rows, l, li) => {
                const off = !!excluded[l.key];
                const dupe = isDupe(l);
                const sk = skipByLine[l.key] || null;
                const skipCode = sk && sk.code ? sk.code : '';
                const skipDef = skipCode ? activeSkipCodes.find(c => c.code === skipCode) : null;
                const editing = editMode && edits[l.key] && l.asset && !l.asset.isNew && edits[l.key].id === l.asset.id;
                const split = !!(l.parent || l.splitting);
                const open = !split && !off && !l.extra && !!l.ms && !!panel[l.key];
                const lastPiece = !!l.parent && !(lines[li + 1] && lines[li + 1].parent === l.parent);
                const splitShown = l.splitting ? !off : lastPiece && !!splitOpen[l.parent];
                const rt = retro[l.key];
                const differs = l.ms && l.asset && !(l.piece > 1) && !(sameText(l.ms.equipment, l.asset.name) && samePlace(l.ms.room, l.asset.room) && samePlace(l.ms.area, l.asset.area));
                const [statusText, statusKind] = lineStatus(l, dupe, skipCode);
                const canInlinePick = !editing && !split && !l.extra && !!l.ms && !(l.asset && l.asset.isNew);
                const lineCands = canInlinePick ? candidatesFor(l) : [];
                const lineOptions = canInlinePick ? uniqueById([l.asset, l.auto, ...lineCands.map(c => c.asset)].filter(a => a && !a.isNew)) : [];
                const lineRankMap = canInlinePick ? new Map((l.ranked || []).concat((moreRank[l.key] && moreRank[l.key].ranked) || []).map(c => [c.asset.id, c])) : null;
                rows.push(
                  <React.Fragment key={l.key}>
                    <tr style={off ? { color: '#94A3B8' } : skipCode ? { backgroundColor: '#FFFDF5' } : !l.asset ? { backgroundColor: '#FFF6E6' } : l.parent ? { backgroundColor: '#F3F8FE' } : undefined}>
                      <td className={styles.td}><input type="checkbox" aria-label={`Include ${l.name}`} checked={!off} disabled={saving} onChange={(e) => setExcluded(p => ({ ...p, [l.key]: !e.target.checked }))} /></td>
                      <td className={styles.td} style={{ minWidth: 270 }}>
                        {editing ? (
                          <Input size="small" aria-label={`Name for ${l.name}`} value={edits[l.key].name} disabled={saving} onChange={(e, d) => setEdits(p => ({ ...p, [l.key]: { ...p[l.key], name: d.value } }))} />
                        ) : canInlinePick ? (
                          <EquipmentChoice
                            store={store}
                            label={`Equipment for ${l.ms.equipment || l.name || 'order line'}`}
                            options={lineOptions}
                            value={l.asset && !l.asset.isNew ? l.asset.id : ''}
                            disabled={saving || off}
                            rankedMap={lineRankMap}
                            inUse={(a) => usedBy(a.id, l.key)}
                            context={l.ms}
                            allowNoMatch={!l.asset}
                            onChoose={(a) => { if (a) choose(l, a); else undoChoice(l); }}
                          />
                        ) : (
                          <strong>{l.name || '(unnamed)'}{l.asset && l.asset.isNew ? ' (new asset)' : ''}</strong>
                        )}
                        {l.asset && l.asset.uniqueId && <span className={styles.hint} style={{ marginLeft: 6 }}>Asset ID: {l.asset.uniqueId}</span>}
                        {(differs || (!l.asset && l.ms && l.ms.equipment)) && (
                          <div className={styles.hint} style={{ marginTop: 2 }}>SAP row: <strong>{l.ms.equipment}</strong>{placeText(l.ms) ? ` - ${placeText(l.ms)}` : ''}</div>
                        )}
                        {!split && !l.extra && !off && l.suggestedPieces && l.suggestedPieces.assets.length >= 2 && (
                          <div className={styles.hint} style={{ marginTop: 4 }}>
                            {l.suggestedPieces.how === 'text' ? 'Lists several pieces. Found: ' : 'Broken down into smaller pieces in current assets: '}
                            <strong>{l.suggestedPieces.assets.map(a => a.name).join(', ')}</strong>.{' '}
                            <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={saving}
                              onClick={() => setPiecesFor(l.key, l.suggestedPieces.assets)}>
                              Break up like this ({l.suggestedPieces.assets.length} pieces)
                            </Button>
                          </div>
                        )}
                        {l.extra && <Button size="small" appearance="subtle" style={{ marginLeft: 6 }} aria-label={`Remove ${l.name} from this order`} disabled={saving} onClick={() => setExtras(p => p.filter(x => x.key !== l.key))}>Remove</Button>}
                        {!l.extra && !split && l.ms && !off && (
                          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginTop: 2 }}>
                            <Button size="small" appearance="transparent" aria-label={`Break up ${l.ms.equipment} into pieces`} data-break-up={l.key} disabled={saving} onClick={() => startBreakUp(l)}>Break up into pieces...</Button>
                            <Button size="small" appearance="transparent" disabled={saving} onClick={() => setView(l, 'new')}>Create new asset</Button>
                            {!panel[l.key] && <Button size="small" appearance="transparent" aria-label={`More equipment options for ${l.ms.equipment}`} disabled={saving} onClick={() => openChange(l)}>More options</Button>}
                            {chosen[l.key] && <Button size="small" appearance="transparent" disabled={saving} onClick={() => undoChoice(l)}>Undo change</Button>}
                          </div>
                        )}
                        {l.piece === 1 && !splitOpen[l.parent] && (
                          <Button size="small" appearance="subtle" style={{ marginLeft: 6 }} aria-label={`Edit pieces: ${l.ms.equipment}`} data-edit-pieces={l.parent} disabled={saving} onClick={() => editPieces(l)}>Edit pieces</Button>
