    },

    // Save one entry. A clean goes through the shared MSS LOG WRITE rule: one row per piece, kind and date with a fixed id; when
    // that clean is already in the log (Ganttly saved it), the SAP order (and, on the caller's side, the paperwork) is added to that
    // row instead of a second row. A skip is saved as before (it is not a clean): its code goes into craa5_lastcleanedby
    // ("SKIPPED (CODE) - USER"), craa5_idofssop and craa5_bundle, since craa5_skipcode / craa5_skipnote do not exist on the log.
    // extra: { minutes, pathogen }. Returns the row id.
    async createLog(payload, sapCode, freqCol, skipMeta = null, extra = null) {
      const p = { ...payload };
      delete p.craa5_skipcode;
      delete p.craa5_skipnote;
      const code = sapCode !== undefined ? sapCode : p.craa5_sap;
      if (!skipMeta) {
        const workArea = await workAreaOf(p.craa5_equipmentguid);
        const built = mlwBuildRow({
          equipmentGuid: p.craa5_equipmentguid, equipment: p.craa5_equipment, room: p.craa5_room, area: p.craa5_area, workArea,
          kind: logKindOf(code, freqCol), sap: isAutoSap(code) ? '' : code, shiftDate: dayKey(p.craa5_lastcleaned),
          cleanedBy: p.craa5_lastcleanedby, markedBy: MLW_MARKED_BY,
          minutes: extra && extra.minutes !== undefined ? extra.minutes : Math.round((Number(p.craa5_hoursworked) || 0) * 60),
          pathogen: !!(extra && extra.pathogen), source: 'Log input',
        });
        if (!built.ok) throw new Error(built.problems.map(c => mlwSay(c)).join(' '));
        const found = await mlwFind(api, built).catch(e => { if (mlwIsDenied(e)) return null; throw e; });
        if (found && Number(found.statecode || 0) === 0) {
          const id = cleanGuid(found[MLW_ID]);
          const add = {};
          if (!isAutoSap(code) && safeString(code)) add.craa5_sap = built.row.craa5_sap;
          if (built.row.craa5_pathogen === 'Yes') add.craa5_pathogen = 'Yes';
          if (Object.keys(add).length) await api.update(LOG_TABLE, id, add);
          mergedCount += 1;
          return id;
        }
        const row = { ...built.row, craa5_hoursworked: Math.max(0, Math.ceil(Number(p.craa5_hoursworked) || 0)) };
        for (let i = 0; i < 16; i++) {
          const body = mlwStrip(row);
          try {
            if (found) { await api.update(LOG_TABLE, cleanGuid(found[MLW_ID]), { ...body, statecode: 0, statuscode: 1 }); return cleanGuid(found[MLW_ID]); }
            return await api.create(LOG_TABLE, { ...body, [MLW_ID]: built.id });
          } catch (e) {
            if (!found && mlwIsDuplicate(errText(e))) { mergedCount += 1; return built.id; }
            if (!mlwDropFor(e, Object.keys(body))) throw e;
          }
        }
        throw new Error('MSS log: too many missing columns');
      }
      const skipCodeVal = safeString(skipMeta.skipCode !== undefined ? skipMeta.skipCode : (skipMeta.code || 'SKIP')) || 'SKIP';
      const skipNoteVal = safeString(skipMeta.skipReason !== undefined ? skipMeta.skipReason : (skipMeta.note || skipMeta.reason || ''));
      const rawWho = safeString(p.craa5_lastcleanedby || 'Operator');
      const cleanedWho = /^SKIPPED\s*\(/i.test(rawWho) ? rawWho : `SKIPPED (${skipCodeVal}) - ${rawWho}`;
      const skipMarker = `SKIP:${skipCodeVal}${skipNoteVal ? ':' + skipNoteVal : ''}`;
      const row = {
        ...p, craa5_hoursworked: 0, craa5_lastcleanedby: cleanedWho.slice(0, 100), craa5_idofssop: skipMarker.slice(0, 100), craa5_bundle: skipMarker.slice(0, 100),
        craa5_daily: false, craa5_weekly: false, craa5_monthly: false, craa5_pathogen: 'No',
        craa5_shiftdate: dayKey(p.craa5_lastcleaned), craa5_markedby: MLW_MARKED_BY, craa5_source: 'Log input',
      };
      for (let i = 0; i < 16; i++) {
        const body = mlwStrip(row);
        try { return await api.create(LOG_TABLE, body); }
        catch (e) { if (!mlwDropFor(e, Object.keys(body))) throw e; }
      }
      throw new Error('MSS log: too many missing columns');
    },
    takeMerged() { const n = mergedCount; mergedCount = 0; return n; },

    // SAP order typeahead. Queries the assets (craa5_aa_ms_assets and craa5_aa_assets) and pulls the SAP order from all frequency SAP columns.
    async searchOrders(q) {
      const raw = safeString(q).trim();
      const key = normCode(raw);
      if (key.length < 2) return { items: [], truncated: false };
      const lower = raw.toLowerCase();
      const autoMatches = AUTO_SAP_OPTIONS.filter(o =>
        o.code.toLowerCase().includes(lower) || o.label.toLowerCase().includes(lower) || o.key.toLowerCase().includes(lower)
      ).map(o => ({ code: o.code, count: 0, names: `${o.label} (app / manual completion - pick equipment or load by room/area)`, isAuto: true }));

      if (lower.startsWith('auto')) {
        return { items: autoMatches.slice(0, 10), truncated: false };
      }

      tryWarmFromSession();
      warmCatalogInBackground();

      let entry = cache.orderSearch.get(key);
      if (!entry) {
        const wider = Array.from(cache.orderSearch.entries()).find(([k, e]) => !e.truncated && key.includes(k));
        if (wider) {
          entry = {
            rows: wider[1].rows.filter(r =>
              r.codes.some(c => c.code.includes(key)) ||
              safeString(r.equipment).toLowerCase().includes(lower) ||
              safeString(r.olduid).toLowerCase().includes(lower)
            ),
            truncated: false,
          };
        }
        if (!entry) {
          entry = await once(cache.orderPending, key, async () => {
            const rows = await queryMs((_, withExt) => searchMsFilter(raw, key, withExt), LIMITS.orderSuggest);
            return { rows, truncated: rows.length >= LIMITS.orderSuggest };
          });
        }
        cache.orderSearch.set(key, entry);
      }
      const by = new Map();
      const addCodeHit = (codeVal, col, rowOrAssetId, equipName) => {
        if (!codeVal || codeVal === normCode(equipName)) return;
        if (!by.has(codeVal)) by.set(codeVal, { code: codeVal, ids: new Set(), names: new Set(), freqs: new Set(), directCodeMatch: false });
        const x = by.get(codeVal);
        if (codeVal.includes(key)) x.directCodeMatch = true;
        if (rowOrAssetId) x.ids.add(rowOrAssetId);
        if (equipName) x.names.add(equipName);
        if (col && col !== 'craa5_title' && col !== 'craa5_olduid') x.freqs.add(freqLabel(col));
      };

      entry.rows.forEach(r => {
        const assetMatch = safeString(r.equipment).toLowerCase().includes(lower) || safeString(r.olduid).toLowerCase().includes(lower);
        r.codes.forEach(c => {
          if (c.col === 'craa5_olduid' && !c.code.includes(key)) return;
          if (c.code.includes(key) || (assetMatch && c.col !== 'craa5_olduid')) {
            addCodeHit(c.code, c.col, r.id, r.equipment);
          }
        });
      });

      // Also pull SAP orders from the in-memory craa5_aa_assets catalog SAP columns (if any SAP columns exist on craa5_aa_assets)
      if (catalogReady) {
        assets.forEach(a => {
          if (!a.sapCodes || !a.sapCodes.length) return;
          const assetMatchesQuery = a.name.toLowerCase().includes(lower) || (a.uniqueId && a.uniqueId.toLowerCase().includes(lower));
          a.sapCodes.forEach(sc => {
            if (sc.code.includes(key) || assetMatchesQuery) {
              addCodeHit(sc.code, sc.col, a.id, a.name);
            }
          });
        });
      }

      // Expand counts to include all assets in craa5_aa_assets that share the matched equipment name!
      by.forEach(x => {
        if (catalogReady && x.names.size > 0) {
          x.names.forEach(nm => {
            const sameNameAssets = canonIndex.get(canonName(nm)) || [];
            sameNameAssets.forEach(a => x.ids.add(a.id));
          });
        }
      });

      const sapItems = Array.from(by.values())
        .sort((a, b) =>
          (b.code.startsWith(key) ? 1 : 0) - (a.code.startsWith(key) ? 1 : 0) ||
          (b.directCodeMatch ? 1 : 0) - (a.directCodeMatch ? 1 : 0) ||
          a.code.localeCompare(b.code)
        )
        .slice(0, 12)
        .map(x => {
          const freqStr = x.freqs.size ? `${Array.from(x.freqs).slice(0, 2).join('/')} - ` : '';
          const nameStr = Array.from(x.names).slice(0, 2).join(', ');
          return { code: x.code, count: x.ids.size, names: `${freqStr}${nameStr}`.replace(/ - $/, '') };
        });
      return { items: autoMatches.concat(sapItems).slice(0, 14), truncated: entry.truncated };
    },

    // Every SAP code that contains this text (from one small capped query, cached): used to check what was read off a paperwork sheet
    sheetCodes(text) {
      const key = normCode(text).replace(/[^A-Z0-9_\-]/g, '');
      if (key.length < 3 || key.length > 40) return Promise.resolve([]);
      return once(cache.orderPending, `sheet|${key}`, async () => {
        const rows = await queryMs((_, withExt) => codeFilter('contains', key, withExt), LIMITS.orderSuggest);
        const codes = [];
        rows.forEach(r => r.codes.forEach(c => { if (c.code.includes(key) && codes.indexOf(c.code) < 0) codes.push(c.code); }));
        return codes;
      });
    },

    // One SAP order's rows, querying both craa5_aa_ms_assets and craa5_aa_assets SAP columns, with fallback to base SAP stem or log history
    loadOrderRows(code) {
      const c = normCode(code);
      if (isAutoSap(c)) {
        return Promise.resolve({ code: formatAutoSap(c), capped: false, rows: [], isAuto: true });
      }
      return once(cache.orderRows, c, async () => {
        tryWarmFromSession();
        let rows = (await queryMs((_, withExt) => codeFilter('eq', c, withExt), LIMITS.orderRows + 1)).filter(r => r.codes.some(x => x.code === c));
        let matchedVia = 'exact';
        let stemCode = '';

        // Also merge any assets from craa5_aa_assets whose own SAP columns contain this exact SAP order code
        if (catalogReady && assetSapIndex.has(c)) {
          const directAssetHits = assetSapIndex.get(c) || [];
          const existingAssetIds = new Set(rows.map(r => r.assetId).filter(Boolean));
          directAssetHits.forEach((hit, idx) => {
            if (existingAssetIds.has(hit.asset.id)) return;
            if (rows.some(r => !r.assetId && sameText(r.equipment, hit.asset.name) && (!r.room || samePlace(r.room, hit.asset.room)))) return;
            rows.push({
              id: `asset_sap_${idx}_${hit.asset.id}`,
              equipment: hit.asset.name,
              room: hit.asset.room,
              area: hit.asset.area,
              assetId: hit.asset.id,
              codes: [{ col: hit.col, code: c }],
              fromAssetSapCol: true,
            });
          });
        }

        // Fallback 1: if no exact SAP code match in MS_TABLE, try base stem (e.g. odd frequency suffix or dash/underscore variation)
        if (!rows.length) {
          const stem = sapBaseStem(c);
          if (stem && stem.length >= 4 && stem !== c) {
            const stemRows = await queryMs((_, withExt) => codeFilter('contains', stem, withExt), LIMITS.orderRows + 1);
            const filtered = stemRows.filter(r => r.codes.some(x => sapBaseStem(x.code) === stem || x.code.startsWith(stem)));
            if (filtered.length) {
              rows = filtered;
              matchedVia = 'stem';
              stemCode = (filtered[0].codes.find(x => sapBaseStem(x.code) === stem || x.code.startsWith(stem)) || {}).code || stem;
            }
          }
        }
        // Fallback 2: if still no MS_TABLE rows, check earlier log entries for this SAP order to autopopulate its equipment!
        if (!rows.length) {
          const prev = await prevForOrder(c).catch(() => []);
          if (prev.length) {
            const byEq = new Map();
            prev.forEach((p, idx) => {
              const k = p.guid || `${canonName(p.equipment)}|${placeKey(p.room)}|${placeKey(p.area)}`;
              if (!byEq.has(k)) {
                byEq.set(k, {
                  id: `hist_${idx}_${k}`,
                  equipment: p.equipment || (assets.get(p.guid) ? assets.get(p.guid).name : ''),
                  room: p.room || (assets.get(p.guid) ? assets.get(p.guid).room : ''),
                  area: p.area || (assets.get(p.guid) ? assets.get(p.guid).area : ''),
                  assetId: p.guid && assets.has(p.guid) ? p.guid : null,
                  codes: [{ col: null, code: c }],
                  fromHistory: true,
                });
              }
            });
            rows = Array.from(byEq.values());
            matchedVia = 'history';
          }
        }
        const list = rows.slice(0, LIMITS.orderRows);
        await resolve(list.map(r => r.assetId).filter(Boolean));
        return {
          code: c,
          matchedVia,
          stemCode,
          capped: rows.length > LIMITS.orderRows,
          rows: list.map(r => {
            const exactCol = (r.codes.find(x => x.code === c && x.col !== 'craa5_title' && x.col !== 'craa5_olduid') || r.codes.find(x => x.code === c) || r.codes[0] || {}).col || null;
            const linkedAsset = r.assetId ? assets.get(r.assetId) || null : null;
            return { ...r, col: exactCol, asset: linkedAsset };
          }),
        };
      });
    },

    // One SAP order for the entry form: linked equipment, best fit for every row, AND automatic attachment to ALL assets with the matching equipment name!
    loadOrder(code) {
      const c = isAutoSap(code) ? formatAutoSap(code) : normCode(code);
      return once(cache.orders, c, async () => {
        tryWarmFromSession();
        await ensureAssetCatalog().catch(() => null);
        const base = await store.loadOrderRows(c);
        const defaultCol = inferFreqColFromCode(c, (base.rows.find(r => r.col && r.col !== 'craa5_title' && r.col !== 'craa5_olduid') || {}).col);
        const entries = base.rows.map(r => ({
          key: r.id,
          msId: r.fromHistory || r.fromAssetSapCol ? null : r.id,
          col: r.col && r.col !== 'craa5_title' && r.col !== 'craa5_olduid' ? r.col : defaultCol,
          equipment: r.equipment,
          room: r.room,
          area: r.area,
          linked: r.asset,
          asset: r.asset,
          how: r.asset ? (r.fromHistory ? 'earlier entries' : 'linked') : '',
          tier: r.asset ? 'linked' : 'none',
          ranked: [],
          partial: false,
          reason: r.fromHistory ? 'autopopulated from earlier log entries' : (base.matchedVia === 'stem' ? `matched from base order ${base.stemCode}` : ''),
          suggestedPieces: null,
        }));
        let autoAttachedCount = 0;
        const attachedNameSet = new Set();
        if (entries.length) {
          const [prev, exact] = await Promise.all([prevForOrder(c).catch(() => []), assetsByNames(entries)]);
          const single = entries.length === 1;
          const rs = await pool(entries, catalogReady ? 16 : 4, async (e, i) => {
            e.partial = !catalogReady && i >= LIMITS.fuzzyLines;
            e.ranked = await rankForLine(store, e, { prev, exact, single, fuzzy: !e.partial, force: catalogReady });
            // Check if this order line lists multiple pieces or was broken down into smaller child assets in current assets pull
            const sp = await suggestPieces(store, { equipment: e.equipment, room: e.room, area: e.area, ranked: e.ranked }, 'fast').catch(() => null);
            if (sp && sp.assets && sp.assets.length >= 2) e.suggestedPieces = sp;
          });
          const bad = rs.find(r => !r.ok);
          if (bad) throw bad.error;
          assignBestFits(entries);

          // Requirement 1: Whenever a SAP order with a unique equipment name is entered, attach the SAP order to ALL assets with the correct name!
          if (catalogReady) {
            const heldAssetIds = new Set(entries.map(e => e.asset && e.asset.id).filter(Boolean));
            const expandedEntries = [];
            const processedNameKeys = new Set();
            entries.forEach(e => {
              const targetName = (e.asset && e.asset.name) || e.equipment;
              const cName = canonName(targetName);
              if (!cName) return;
              const allSameName = canonIndex.get(cName) || [];
              if (allSameName.length <= 1) return;
              const hasRoom = !!normName(e.room);
              const inSameRoom = hasRoom ? allSameName.filter(a => samePlace(a.room, e.room)) : allSameName;
              const poolToAttach = (single || !hasRoom || inSameRoom.length <= 1) ? allSameName : inSameRoom;
              const groupKey = `${cName}|${poolToAttach === allSameName ? '*' : placeKey(e.room)}`;
              if (processedNameKeys.has(groupKey)) return;
              processedNameKeys.add(groupKey);

              poolToAttach.forEach(a => {
                if (heldAssetIds.has(a.id)) return;
                heldAssetIds.add(a.id);
                autoAttachedCount += 1;
                attachedNameSet.add(a.name);
                expandedEntries.push({
                  key: `autoname_${e.key}_${a.id}`,
                  msId: null,
                  col: e.col || defaultCol,
                  equipment: a.name,
                  room: a.room,
                  area: a.area,
                  linked: null,
                  asset: a,
                  how: 'all with name',
                  tier: 'high',
                  ranked: [{ asset: a, score: 1, reason: 'same equipment name', support: 5 }],
                  partial: false,
                  reason: `attached all assets named "${a.name}"`,
                  suggestedPieces: null,
                  autoAttachedByName: true,
                });
              });
            });
            if (expandedEntries.length) {
              entries.push(...expandedEntries);
            }
          }
        }
        return {
          code: c,
          entries,
          defaultCol,
          autoAttachedCount,
          nameAttachedCount: autoAttachedCount,
          attachedNames: Array.from(attachedNameSet),
          capped: base.capped,
          matchedVia: base.matchedVia,
          stemCode: base.stemCode,
          isAuto: !!base.isAuto,
        };
      });
    },
    // Candidates for one SAP row on demand (rows past the first few dozen of a big order, or "Look for similar names")
    async rankLine(code, line, single) {
      tryWarmFromSession();
      await ensureAssetCatalog().catch(() => null);
      const prev = await prevForOrder(normCode(code)).catch(() => []);
      const exact = await assetsByNames([line]);
      return rankForLine(store, line, { prev, exact, single, fuzzy: true, force: true });
    },

    // Free-text equipment search: searches the in-memory current assets pull when ready (including synonyms, abbreviations & room/area boost)
    async searchAssets(text, context = null) {
      const raw = safeString(text).trim();
      const tokens = tokenize(raw).slice(0, 6);
      tryWarmFromSession();
      if (!catalogReady) await ensureAssetCatalog().catch(() => null);
      if (catalogReady) {
        const ctxRoom = context && safeString(context.room).trim();
        const ctxArea = context && safeString(context.area).trim();
        const ctxEquip = context && safeString(context.equipment).trim();
        // When query is short/blank but context is provided, return intelligent matches for the context room/area/equipment
        if (!tokens.length || tokens.join('').length < 2) {
          if (!ctxRoom && !ctxArea && !ctxEquip) return [];
          const want = { equipment: ctxEquip, room: ctxRoom, area: ctxArea };
          const cProf = nameProfile(ctxEquip);
          const list = [];
          assets.forEach(a => {
            const sameR = ctxRoom && samePlace(ctxRoom, a.room);
            const sameA = ctxArea && samePlace(ctxArea, a.area);
            const sim = cProf.full ? nameSimilarity(cProf, a._profile) : 0;
            const sc = cProf.full ? scoreAsset(want, a, cProf) : (sameR && sameA ? 0.9 : sameR ? 0.7 : 0);
            if (sc >= 0.32 || sim >= 0.35 || sameR) {
              list.push({ a, s: sc + (sameR ? 0.3 : 0) + (sameA ? 0.2 : 0) + sim * 0.5 });
            }
          });
          return list
            .sort((x, y) => y.s - x.s || x.a.room.localeCompare(y.a.room) || x.a.name.localeCompare(y.a.name))
            .slice(0, LIMITS.assetSearch)
            .map(x => x.a);
        }
        const rawLower = raw.toLowerCase();
        const qProf = nameProfile(raw);
        const want = { equipment: raw, room: ctxRoom || '', area: ctxArea || '' };
        const results = [];
        assets.forEach(a => {
          const hay = `${a.name} ${a.room} ${a.area} ${a.uniqueId || ''} ${a._canon}`.toLowerCase();
          const matchedTokens = tokens.filter(t => hay.includes(t));
          const sim = qProf.full ? nameSimilarity(qProf, a._profile) : 0;
          if (!matchedTokens.length && !hay.includes(rawLower) && sim < 0.42) return;
          const allMatch = matchedTokens.length === tokens.length || hay.includes(rawLower);
          if (!allMatch && matchedTokens.length < Math.max(1, tokens.length - 1) && sim < 0.55) return;
          const nameHits = tokens.filter(t => a.name.toLowerCase().includes(t) || a._canon.includes(t)).length;
          const assetScore = qProf.full ? scoreAsset(want, a, qProf) : 0;
          const placeBoost = (ctxRoom && samePlace(ctxRoom, a.room) ? 3 : 0) + (ctxArea && samePlace(ctxArea, a.area) ? 2 : 0);
          const s = (allMatch ? 10 : 4) + nameHits * 2.5 + sim * 6 + assetScore * 4 + placeBoost;
          results.push({ a, s });
        });
        return results
          .sort((x, y) => y.s - x.s || x.a.name.localeCompare(y.a.name))
          .slice(0, LIMITS.assetSearch)
          .map(x => x.a);
      }
      if (!tokens.length || tokens.join('').length < 2) return [];
      return once(cache.assetSearch, tokens.join(' '), async () => {
        const filter = tokens.map(t => `(${ciContains('craa5_equipmentidentifier', t)} or ${ciContains('craa5_roomname', t)} or ${ciContains('craa5_areaname', t)})`).join(' and ');
        const found = await queryAssets(filter, LIMITS.assetSearch);
        const score = (a) => tokens.filter(t => a.name.toLowerCase().includes(t)).length;
        return found.sort((a, b) => score(b) - score(a) || a.name.localeCompare(b.name));
      });
    },

    // Candidate equipment for a name: uses the full current assets pull when loaded so renamed/abbreviated/relocated assets are found immediately
    async assetsLikeName(p, room, area) {
      if (!p || (!p.words.length && !p.numList.length)) return [];
      tryWarmFromSession();
      warmCatalogInBackground();
      if (catalogReady) {
        const ws = p.words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).filter(w => w.length >= 2);
        const candidateIds = new Set();
        ws.forEach(w => {
          const set = wordIndex.get(w);
          if (set) set.forEach(id => candidateIds.add(id));
          // Also check prefix/substring matches on wordIndex keys for partial/drastic renames
          if (w.length >= 3) {
            wordIndex.forEach((ids, kw) => {
              if (kw !== w && kw.length >= 3 && (kw.startsWith(w) || w.startsWith(kw))) {
                ids.forEach(id => candidateIds.add(id));
              }
            });
          }
        });
        p.numList.forEach(n => {
          const set = wordIndex.get(n);
          if (set) set.forEach(id => candidateIds.add(id));
        });
        // Also include all assets in the same room (or swapped room/area) so drastically renamed equipment in the same location is evaluated
        const rk = placeKey(room);
        const ak = placeKey(area);
        if (rk && roomIndex.has(rk)) roomIndex.get(rk).forEach(a => candidateIds.add(a.id));
        if (ak && roomIndex.has(ak)) roomIndex.get(ak).forEach(a => candidateIds.add(a.id));

        const want = { equipment: p.full, room: room || '', area: area || '' };
        const scored = [];
        candidateIds.forEach(id => {
          const a = assets.get(id);
          if (!a) return;
          const sim = nameSimilarity(p, a._profile);
          const s = scoreAsset(want, a, p);
          if (s >= 0.22 || sim >= 0.35 || (rk && a._roomKey === rk && sim >= 0.25)) {
            scored.push({ a, s: Math.max(s, sim * 0.78) });
          }
        });
        scored.sort((x, y) => y.s - x.s || x.a.name.localeCompare(y.a.name));
        return scored.slice(0, 60).map(x => x.a);
      }

      // Server fallback when catalog is still warming up
      const ws = p.words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).filter(w => w.length >= 2).sort((a, b) => b.length - a.length).slice(0, 2);
      if (!ws.length) return [];
      const num = p.numList.slice(0, 1);
      return once(cache.names, `${ws.join(',')}|${num.join(',')}|${normName(room)}`, async () => {
        const named = (list, all) => `(${list.map(w => ciContains('craa5_equipmentidentifier', w)).join(all ? ' and ' : ' or ')})`;
        const inRoom = normName(room) ? ` and ${ciEq('craa5_roomname', room)}` : '';
        const good = (list) => list.some(a => nameSimilarity(p, nameProfile(a.name)) >= 0.8);
        let found = await queryAssets(named([...ws, ...num], true) + inRoom, LIMITS.assetNames);
        if (!good(found)) found = uniqueById([...found, ...await queryAssets(named(ws, false) + inRoom, LIMITS.assetNames)]);
        if (!good(found) && inRoom) found = uniqueById([...found, ...await queryAssets(named([...ws, ...num], true), LIMITS.assetNames)]);
        return found;
      });
    },

    // Fix tab double-check: the newest few hundred entries of a group's equipment (same name, room and area) that already
    // carry an equipment ID, counted by the equipment they point at
    logEvidence(g) {
      if (!canonName(g.equipment)) return Promise.resolve({ by: [], unknown: 0, checked: 0, capped: false });
      return once(cache.evidence, familyKey(g), async () => {
        const ask = (filter) => api.query(LOG_TABLE, { select: EVIDENCE_SELECT, filter: `${filter} and ${LINKED}`, orderBy: 'craa5_lastcleaned desc', top: LIMITS.evidence });
        const loose = await ask(familyFilter(g));
        const place = `${placeFilter('craa5_room', g.room)} and ${placeFilter('craa5_area', g.area)}`;
        const exact = loose.length >= LIMITS.evidence ? await ask(`${ciEq('craa5_equipment', g.equipment)} and ${place}`) : [];
        const rows = exact.concat(loose);
        const mine = uniqueRows(rows).filter(r => inFamily(g, r));
        await resolve(mine.map(r => r.craa5_equipmentguid));
        const by = new Map();
        let unknown = 0;
        mine.forEach(r => {
          const a = assets.get(cleanGuid(r.craa5_equipmentguid));
          if (!a) { unknown += 1; return; }
          if (!by.has(a.id)) by.set(a.id, { asset: a, count: 0 });
          by.get(a.id).count += 1;
        });
        return { by: Array.from(by.values()).sort((a, b) => b.count - a.count), unknown, checked: mine.length, capped: exact.length >= LIMITS.evidence || loose.length >= LIMITS.evidence };
      });
    },
    // Every entry of a group's equipment (same name, room and area) that needs this equipment: no ID, an ID that no longer
    // exists, or one of the wrong IDs given. Entries already on other existing equipment are only counted. Read page by page.
    // assetId may be a list (an entry broken up into pieces): entries already on any of them are left alone.
    async familyToFix(g, assetId, wrongIds, places, includeRelinkAll = false) {
      if (!canonName(g.equipment)) return { rows: [], kept: 0, keptMore: false, capped: false };
      const keep = [].concat(assetId).map(cleanGuid).filter(Boolean);
      const readAll = async (filter, maxPages) => {
        const out = [];
        let pg = await api.page(LOG_TABLE, { select: FIX_SELECT, filter, top: LIMITS.familyPage });
        for (let pages = 1; ; pages++) {
          pg.rows.forEach(r => { if (inFamily(g, r)) out.push(r); });
          if (!pg.next) return { rows: out, capped: false };
          if (pages >= maxPages) return { rows: out, capped: true };
          pg = await pg.next();
        }
      };
      const base = familyFilter(g, places);
      const [blank, linked] = await Promise.all([
        readAll(`${base} and ${BLANK_GUID}`, LIMITS.familyPages),
        readAll(`${base} and ${LINKED}${keep.map(id => ` and ${guidNe('craa5_equipmentguid', id)}`).join('')}`, LIMITS.familyLinkedPages),
      ]);
      await resolve(linked.rows.map(r => r.craa5_equipmentguid));
      const wrong = (wrongIds || []).map(cleanGuid);
      const fix = linked.rows.filter(r => {
        const id = cleanGuid(r.craa5_equipmentguid);
        return keep.indexOf(id) < 0 && (includeRelinkAll || wrong.includes(id) || store.isGone(id));
      });
      const fixIds = new Set(fix.map(r => r.craa5__log_id));
      const keptIds = linked.rows.filter(r => !fixIds.has(r.craa5__log_id)).map(r => cleanGuid(r.craa5_equipmentguid));
      return { rows: blank.rows.concat(fix), kept: keptIds.length, keptIds, keptMore: linked.capped, capped: blank.capped || linked.capped };
    },

    // Every record with exactly this name, room and area (identical twins included; a handful at most)
    async findAssetsExact(name, room, area) {
      tryWarmFromSession();
      warmCatalogInBackground();
      if (catalogReady) {
        const list = canonIndex.get(canonName(name)) || [];
        return list.filter(a => sameText(a.name, name) && sameText(a.room, room) && sameText(a.area, area));
      }
      const rows = await queryAssets(`${ciEq('craa5_equipmentidentifier', name)} and ${ciEq('craa5_roomname', room)} and ${ciEq('craa5_areaname', area)}`, 10);
      return rows.filter(a => sameText(a.name, name) && sameText(a.room, room) && sameText(a.area, area));
    },
    async findAssetExact(name, room, area) {
      return (await store.findAssetsExact(name, room, area))[0] || null;
    },
    async createAsset(a) {
      const id = await api.create(ASSET_TABLE, { craa5_equipmentidentifier: a.name, craa5_roomname: a.room, craa5_areaname: a.area });
      const asset = indexAsset(enrichAsset({ id, name: a.name, room: a.room, area: a.area }));
      saveCatalogSession();
      store.invalidateAssets();
      return asset;
    },
    // Writes only the fields that changed
    async updateAsset(a, name, room, area) {
      const payload = {};
      if (name !== a.name) payload.craa5_equipmentidentifier = name;
      if (room !== a.room) payload.craa5_roomname = room;
      if (area !== a.area) payload.craa5_areaname = area;
      if (Object.keys(payload).length) await api.update(ASSET_TABLE, a.id, payload);
      const asset = indexAsset(enrichAsset({ id: a.id, name, room, area, uniqueId: a.uniqueId, sapCodes: a.sapCodes }));
      saveCatalogSession();
      store.invalidateAssets();
      return asset;
    },

    // Distinct values for room/area suggestions while typing
    async suggestField(col, text, room) {
      const t = safeString(text);
      if (t.length < 1) return [];
      tryWarmFromSession();
      warmCatalogInBackground();
      if (catalogReady) {
        const lower = t.toLowerCase();
        const rk = placeKey(room);
        const seen = new Map();
        assets.forEach(a => {
          if (rk && col !== 'craa5_roomname' && a._roomKey !== rk) return;
          const val = col === 'craa5_roomname' ? a.room : col === 'craa5_areaname' ? a.area : a.name;
          if (val && val.toLowerCase().includes(lower) && !seen.has(val.toLowerCase())) {
            seen.set(val.toLowerCase(), val);
          }
        });
        return Array.from(seen.values())
          .sort((a, b) => (b.toLowerCase().startsWith(lower) ? 1 : 0) - (a.toLowerCase().startsWith(lower) ? 1 : 0) || a.localeCompare(b))
          .slice(0, 15);
      }
      if (t.length < 2) return [];
      return once(cache.field, `${col}|${t.toLowerCase()}|${normName(room)}`, async () => {
        const parts = [ciContains(col, t)];
        if (normName(room)) parts.push(ciEq('craa5_roomname', room));
        const seen = new Map();
        for (let round = 0; round < 10 && seen.size < 15; round++) {
          const not = Array.from(seen.values()).map(v => `${col} ne '${escOData(v)}'`);
          const rows = await api.query(ASSET_TABLE, { select: [col], filter: parts.concat(not).join(' and '), top: 40, orderBy: col });
          const before = seen.size;
          rows.forEach(r => { const v = safeString(r[col]); if (v && !seen.has(v.toLowerCase())) seen.set(v.toLowerCase(), v); });
          if (rows.length < 40 || seen.size === before) break;
        }
        return Array.from(seen.values()).slice(0, 15);
      });
    },

    // Equipment records in one room (and area), or across ALL rooms when room is blank, for finding duplicates or batch loading
    async assetsInPlace(room, area) {
      tryWarmFromSession();
      if (!catalogReady && !normName(room)) {
        try { await ensureAssetCatalog(); } catch (_) {}
      } else {
        warmCatalogInBackground();
      }
      if (catalogReady) {
        const hasRoom = !!normName(room);
        const hasArea = !!normName(area);
        const list = Array.from(assets.values()).filter(a =>
          (!hasRoom || samePlace(a.room, room)) && (!hasArea || samePlace(a.area, area))
        ).sort((a, b) => a.room.localeCompare(b.room) || a.area.localeCompare(b.area) || a.name.localeCompare(b.name));
        return { list, capped: false };
      }
      const f = [];
      if (normName(room)) f.push(ciEq('craa5_roomname', room));
      if (normName(area)) f.push(ciEq('craa5_areaname', area));
      const rows = await queryAssets(f.join(' and '), LIMITS.unifyAssets + 1);
      const list = rows.filter(a => (!normName(room) || sameText(a.room, room)) && (!normName(area) || sameText(a.area, area)));
      return { list: list.slice(0, LIMITS.unifyAssets), capped: rows.length > LIMITS.unifyAssets };
    },
    // How many log entries carry this equipment id (counted up to a cap) and when the newest of them was saved
    // (or, where the save time cannot be read, its date of clean)
    async logUse(id) {
      const ask = (saved) => api.query(LOG_TABLE, {
        select: saved ? ['craa5__log_id', CREATED_ON, 'craa5_lastcleaned'] : ['craa5__log_id', 'craa5_lastcleaned'],
        filter: guidEq('craa5_equipmentguid', id), orderBy: saved ? `${CREATED_ON} desc` : 'craa5_lastcleaned desc', top: LIMITS.countCap + 1,
      });
      let rows = null;
      if (createdOk !== false) {
        try { rows = await ask(true); createdOk = true; }
        catch (e) {
          if (createdOk === true) throw e;
          rows = await ask(false); // throws its own error if the problem is elsewhere
          if (MISSING_COLUMN.test(errText(e))) createdOk = false;
        }
      }
      if (!rows) rows = await ask(false);
      const top = rows[0];
      return { n: Math.min(rows.length, LIMITS.countCap), more: rows.length > LIMITS.countCap, newest: top ? safeString(top[CREATED_ON]) || safeString(top.craa5_lastcleaned) : '', saved: !!(top && top[CREATED_ON]) };
    },
    // When each equipment record was added (id -> createdon); missing where it cannot be read
    async assetsAdded(ids) {
      const added = new Map();
      await pool(chunked(Array.from(new Set(ids.map(cleanGuid))).filter(isGuid), LIMITS.idChunk), 2, async (c) => {
        const rows = await api.query(ASSET_TABLE, { select: ['craa5_aa_assetsid', CREATED_ON], filter: c.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), top: c.length });
        rows.forEach(r => added.set(cleanGuid(r.craa5_aa_assetsid), safeString(r[CREATED_ON])));
      });
      return added;
    },
    // Names of the people who saved entries, for rows that came without one: looked up once per person, a few at a time
    async userNames(ids) {
      const need = Array.from(new Set(ids.map(cleanGuid))).filter(id => isGuid(id) && !users.has(id));
      if (!need.length || usersOff) return;
      await pool(chunked(need, LIMITS.idChunk), 2, async (c) => {
        try {
          const rows = await api.query(USER_TABLE, { select: ['systemuserid', 'fullname'], filter: c.map(id => `systemuserid eq ${id}`).join(' or '), top: c.length });
          rows.forEach(r => users.set(cleanGuid(r.systemuserid), safeString(r.fullname)));
          c.forEach(id => { if (!users.has(id)) users.set(id, ''); });
        } catch (e) {
          if (MISSING_COLUMN.test(errText(e)) || /privilege|permission|denied|forbidden|403|not found|does not exist/i.test(errText(e))) usersOff = true;
        }
      });
    },
    userName(id) { return users.get(cleanGuid(id)) || ''; },
    // SAP rows whose craa5_asset lookup points at any of these ids
    async msLinkedTo(ids) {
      if (!ids.length || lookup === false) return [];
      const out = [];
      for (const c of chunked(ids.map(cleanGuid), LIMITS.idChunk)) {
        try {
          const rows = await api.query(MS_TABLE, { select: msSelect(true, msExtColsOk === true), filter: c.map(id => `_craa5_asset_value eq ${id}`).join(' or '), top: 100 });
          lookup = true;
          out.push(...rows.map(toMs));
        } catch (e) {
          if (lookup !== true && MISSING_LOOKUP.test(errText(e))) { lookup = false; return []; }
          throw e;
        }
      }
      return out;
    },

    // The SAP row that belongs to one equipment (by lookup, maintenance asset ID craa5_olduid, else by exact name + room, area when the row has one)
    async findMsForAsset(asset) {
      const byName = asset.room
        ? `(${ciEq('craa5_equipment', asset.name)} and ${ciEq('craa5_textroom', asset.room)})`
        : ciEq('craa5_equipment', asset.name);
      const byUid = asset.uniqueId ? ` or ${ciEq('craa5_olduid', asset.uniqueId)}` : '';
      const rows = await queryMs((withLookup) => (withLookup ? `_craa5_asset_value eq ${asset.id} or ${byName}${byUid}` : `${byName}${byUid}`), 15);
      return rows.find(r => r.assetId === asset.id)
        || (asset.uniqueId && rows.find(r => normCode(r.olduid) === normCode(asset.uniqueId)))
        || rows.find(r => !r.assetId && sameText(r.equipment, asset.name) && (!r.room || sameText(r.room, asset.room)) && (!r.area || sameText(r.area, asset.area)))
        || null;
    },
    // Create (id null) or update an SAP row, linking it to its asset when the lookup exists.
    // Automatically falls back to fallbackCol (e.g. craa5_sapw) if an optional frequency column (craa5_sapmidweek / craa5_sapbiweekly) does not exist in MS_TABLE.
    async writeMs(id, payload, asset) {
      const normalizePayloadCols = (p, useFallback) => {
        const out = { ...p };
        if (asset && asset.uniqueId && !id && !out.craa5_olduid) {
          out.craa5_olduid = asset.uniqueId;
        }
        if (useFallback) {
          FREQUENCIES.forEach(f => {
            if (f.fallbackCol && out[f.col] !== undefined) {
              const val = out[f.col];
              delete out[f.col];
              out[f.fallbackCol] = val;
            }
          });
        }
        return out;
      };
      const runWithFallback = async (basePayload) => {
        const p1 = normalizePayloadCols(basePayload, msExtColsOk === false);
        try {
          return await (id ? api.update(MS_TABLE, id, p1).then(() => id) : api.create(MS_TABLE, p1));
        } catch (e) {
          if (msExtColsOk !== false && MISSING_COLUMN.test(errText(e))) {
            msExtColsOk = false;
            const p2 = normalizePayloadCols(basePayload, true);
            return await (id ? api.update(MS_TABLE, id, p2).then(() => id) : api.create(MS_TABLE, p2));
          }
          throw e;
        }
      };
      const empty = !Object.keys(payload).length;
      if (asset && lookup !== false && !bindFailed) {
        try { return { id: await runWithFallback({ ...payload, 'craa5_asset@odata.bind': `/${ASSET_SET}(${asset.id})` }), linked: true, tried: true }; }
        catch (e) {
          if (!MISSING_COLUMN.test(errText(e)) || MISSING_LOOKUP.test(errText(e))) bindFailed = true;
          if (empty) return { id, linked: false, tried: true, error: errText(e) };
        }
        return { id: await runWithFallback(payload), linked: false, tried: true };
      }
      if (empty) return { id, linked: false, tried: false };
      return { id: await runWithFallback(payload), linked: false, tried: false };
    },
  };
  return store;
};

// --- BEST FIT: ranking equipment for one SAP row ---
// Sources: linked SAP row asset, equipment that earlier log entries of the order were saved to, the same name, similar/relocated names, and equipment in the same room/area.
const rankForLine = async (store, line, ctx) => {
  const p = nameProfile(line.equipment);
  const cand = new Map();
  const bump = (asset, score, reason, support = 0) => {
    if (!asset) return;
    const c = cand.get(asset.id);
    if (!c) { cand.set(asset.id, { asset, score, reason, support }); return; }
    c.support += support;
    if (score > c.score) { c.score = score; c.reason = reason; }
  };
  if (line.linked) {
    const pReason = placeChangeReason(line, line.linked);
    const renamed = line.equipment && !sameText(line.equipment, line.linked.name);
    const note = [pReason, renamed && `name -> ${line.linked.name}`].filter(Boolean).join(', ');
    bump(line.linked, 1.0, note ? `linked (${note})` : 'linked on SAP row', 10);
  }
  // Earlier entries of this order whose text names this equipment (any entry, when the order has one equipment)
  (ctx.prev || []).forEach(e => {
    const a = store.getAsset(e.guid);
    if (!a) return;
    const named = ctx.single || !p.full || nameSimilarity(p, nameProfile(e.equipment)) >= 0.72 || nameSimilarity(p, a._profile || nameProfile(a.name)) >= 0.72;
    if (!named) return;
    const s = scoreAsset(line, a, p);
    const pReason = placeChangeReason(line, a);
    bump(a, placeOk(line, a) ? Math.max(s, 0.88) : Math.max(s, 0.76), s >= 0.999 ? 'same name' : pReason ? `earlier entries (${pReason})` : 'earlier entries', 1);
  });
  if (p.full) {
    ((ctx.exact && ctx.exact.get(p.full)) || []).forEach(a => {
      const pReason = placeChangeReason(line, a);
      bump(a, scoreAsset(line, a, p), placeOk(line, a) ? 'same name' : pReason ? `same name (${pReason})` : 'same name, other room/area');
    });
    const best = Math.max(0, ...Array.from(cand.values()).filter(c => placeOk(line, c.asset)).map(c => c.score));
    if (ctx.force || (ctx.fuzzy && best < 0.95)) {
      (await store.assetsLikeName(p, line.room, line.area)).forEach(a => {
        const s = scoreAsset(line, a, p);
        if (s >= 0.25) {
          const pReason = placeChangeReason(line, a);
          bump(a, s, !placeOk(line, a) ? (pReason || 'other room/area') : s >= 0.999 ? 'same name' : 'similar name');
        }
      });
    }
  }
  if (normName(line.room) && cand.size < 12) {
    try {
      const inPlace = await store.assetsInPlace(line.room, line.area);
      inPlace.list.slice(0, 20).forEach(a => {
        if (!cand.has(a.id)) bump(a, samePlace(line.area, a.area) ? 0.36 : 0.30, 'same room & area');
      });
    } catch (_) {}
  }
  return Array.from(cand.values()).sort((a, b) => b.score - a.score || b.support - a.support).slice(0, 12);
};

// Give each unlinked SAP row its best fit, most certain rows first, never the same equipment twice.
// Also supports picking high-confidence matches whose room/area was renamed or swapped.
const assignBestFits = (entries) => {
  const taken = new Set(entries.filter(e => e.linked).map(e => e.linked.id));
  entries.filter(e => !e.linked && e.ranked.length)
    .sort((a, b) => b.ranked[0].score - a.ranked[0].score || b.ranked[0].support - a.ranked[0].support)
    .forEach(e => {
      const top = e.ranked[0];
      const tie = e.ranked.some((c, j) => j > 0 && top.score - c.score < 0.02);
      if (top.score >= 0.99 && taken.has(top.asset.id) && !tie && normName(e.room) && normName(e.area)) { e.asset = top.asset; e.how = 'same as another line'; return; }
      let i = e.ranked.findIndex(c => !taken.has(c.asset.id) && c.score >= 0.6 && placeOk(e, c.asset));
      let relocated = false;
      if (i < 0) {
        // Fallback: allow a strong equipment match whose Room/Area was renamed or swapped
        i = e.ranked.findIndex(c => !taken.has(c.asset.id) && c.score >= 0.68);
        if (i >= 0) relocated = true;
      }
      if (i < 0) {
        const same = e.ranked.find(c => c.score >= 0.99 && taken.has(c.asset.id) && placeOk(e, c.asset));
        if (same && normName(e.room) && normName(e.area)) { e.asset = same.asset; e.how = 'same as another line'; }
        return;
      }
      const pick = e.ranked[i];
      taken.add(pick.asset.id);
      const rival = (tie && pick !== top) || e.ranked.some((c, j) => j !== i && !taken.has(c.asset.id) && c.score >= 0.6 && pick.score - c.score < 0.02 && c.support === pick.support);
      let tier = tierOf(pick.score);
      if (rival || (relocated && tier === 'high')) tier = downTier(tier);
      Object.assign(e, { asset: pick.asset, how: 'best fit', tier, ambiguous: rival, reason: reasonText(pick) });
    });
};

// Fix tab: ranks the closest equipment from the current assets pull for one group of identical old log entries.
// Accounts for renamed/swapped rooms & areas, abbreviated/renamed equipment, base SAP stems, and log history.
const rankCandidates = async (store, g, fast = false) => {
  await store.ensureAssetCatalog().catch(() => null);
  const p = nameProfile(g.equipment);
  const want = { equipment: g.equipment, room: g.room, area: g.area };
  const cand = new Map(); // assetId -> { asset, score, reason }
  const bump = (asset, score, reason) => {
    if (!asset || (g.exclude && asset.id === g.exclude)) return;
    const c = cand.get(asset.id);
    if (!c || score > c.score) cand.set(asset.id, { asset, score, reason });
  };
  let settled = false;
  // 1. SAP order (including base SAP stem fallback and earlier log history) - skipped in fast bulk scan unless equipment name is blank
  if ((!fast || !p.full) && g.sap && !isAutoSap(g.sap)) {
    const ord = await store.loadOrderRows(g.sap);
    const list = uniqueById(ord.rows.filter(r => r.asset).map(r => r.asset));
    const whole = !ord.capped && ord.rows.length > 0 && ord.rows.every(r => r.asset);
    if (list.length === 1 && whole) {
      const a = list[0];
      const sim = p.full ? nameSimilarity(p, a._profile || nameProfile(a.name)) : 1;
      const pReason = placeChangeReason(want, a);
      if (sim >= 0.5 && placeOk(want, a)) { bump(a, 0.97, 'SAP order'); settled = sim >= 0.8; }
      else if (sim >= 0.5) bump(a, 0.86, `SAP order (${pReason || 'room/area changed'})`);
      else bump(a, placeOk(want, a) ? 0.82 : 0.74, `SAP order (renamed -> ${a.name})`);
    } else {
      list.forEach(a => {
        const s = p.full ? scoreAsset(want, a, p) : 0;
        const pReason = placeChangeReason(want, a);
        if (s >= 0.999) bump(a, 0.99, 'SAP order + same name');
        else if (s >= 0.55) bump(a, Math.min(0.95, s + 0.06), pReason ? `SAP order + similar name (${pReason})` : 'SAP order + similar name');
        else if (placeOk(want, a) && list.filter(x => placeOk(want, x)).length === 1) {
          bump(a, 0.76, `SAP order (only linked asset in ${placeText(a)})`);
        }
      });
    }
  }
  // 2. Current assets pull search (handles synonyms, number ranges, and renamed/swapped rooms & areas)
  if (p.full && !settled) {
    (await store.assetsLikeName(p, g.room, g.area)).forEach(a => {
      const s = scoreAsset(want, a, p);
      if (s >= 0.38) {
        const pReason = placeChangeReason(want, a);
        const label = !placeOk(want, a)
          ? `${s >= 0.82 ? 'same/similar name' : 'closest name'} (${pReason || 'other room/area'})`
          : s < 0.999
            ? 'similar name'
            : normName(g.room) || normName(g.area) ? 'same name, room, area' : 'same name';
        bump(a, s, label);
      }
    });
  }
  // 3. Double-check against the log: entries with this name that already carry an equipment ID (skipped in fast bulk mode)
  let check = null;
  const logCount = new Map(); // asset id -> entries of this name that use it
  const placed = !!(placeKey(g.room) && placeKey(g.area));
  const inPlace = (a) => placed && samePlace(g.room, a.room) && samePlace(g.area, a.area);
  if (!fast && canonName(g.equipment)) {
    try {
      const ev = await store.logEvidence(g);
      const uses = ev.by.filter(x => placeOk(want, x.asset) && x.asset.id !== g.exclude);
      const relocatedUses = ev.by.filter(x => !placeOk(want, x.asset) && x.asset.id !== g.exclude);
      const elsewhere = relocatedUses.reduce((s, x) => s + x.count, 0);
      const total = uses.reduce((s, x) => s + x.count, 0);
      uses.forEach(x => {
        const share = x.count / total;
        const q = x.asset._profile || nameProfile(x.asset.name);
        const numClash = p.hasNums && q.hasNums && p.nums !== q.nums;
        const prior = cand.get(x.asset.id);
        const confirms = !numClash && (nameSimilarity(p, q) >= 0.75 || !!(prior && prior.score >= 0.6));
        let s = share === 1 ? (inPlace(x.asset) ? (x.count >= 2 ? 1 : 0.96) : 0.9) : share >= 0.8 ? 0.9 : 0.6 + 0.3 * share;
        if (x.count < 2 && !prior) s = Math.min(s, 0.94);
        if (!confirms) s = Math.min(s, numClash ? 0.6 : 0.85);
        if (elsewhere >= x.count) s = Math.min(s, 0.9);
        bump(x.asset, s, LOG_REASON);
        logCount.set(x.asset.id, x.count);
      });
      // Also surface relocated/renamed assets that historical entries of this family already point to!
      relocatedUses.forEach(x => {
        const q = x.asset._profile || nameProfile(x.asset.name);
        const sim = nameSimilarity(p, q);
        const pReason = placeChangeReason(want, x.asset);
        const s = sim >= 0.75 ? 0.84 : 0.72;
        bump(x.asset, s, `${LOG_REASON} (${pReason || 'asset relocated'})`);
        logCount.set(x.asset.id, x.count);
      });
      check = { uses, total, elsewhere, unknown: ev.unknown, capped: ev.capped };
    } catch (e) { check = { error: errText(e) }; }
  }
  // Equal scores: the equipment more entries of this name already use comes first
  const ranked = Array.from(cand.values()).sort((a, b) => b.score - a.score || (logCount.get(b.asset.id) || 0) - (logCount.get(a.asset.id) || 0)).slice(0, 8);
  let tier = ranked.length ? tierOf(ranked[0].score) : 'none';
  // Two equally good candidates (two "Floors" in the same place, or the same name in two rooms) are never High
  const ambiguous = ranked.length > 1 && ranked[0].score - ranked[1].score < 0.02;
  if (ambiguous && tier !== 'none') tier = downTier(tier);
  const src = (r) => (r.reason.startsWith('SAP') ? 'SAP order' : r.reason.startsWith(LOG_REASON) ? 'log' : 'name');
  const conflict = ranked.length > 1 && ranked[1].score >= 0.95 && src(ranked[0]) !== src(ranked[1]);
  const rival = check && check.uses && ranked.length
    ? check.uses.find(x => x.asset.id !== ranked[0].asset.id && inPlace(x.asset) && x.count >= 2 && x.count * 2 > check.total && (logCount.get(ranked[0].asset.id) || 0) < x.count)
    : null;
  if ((conflict || rival) && tier === 'high') tier = 'medium';
  const conflictText = conflict ? `${src(ranked[0])} and ${src(ranked[1])} disagree` : rival ? 'the log disagrees' : '';
  return { ranked, tier, ambiguous, conflict: conflict || !!rival, conflictText, check };
};
const LOG_REASON = 'earlier entries with this name';
// What the log double-check says about the equipment chosen for a group
const logCheck = (g, chosenId, asset) => {
  const c = g.check;
  if (!c) return null;
  if (c.error) return { kind: 'warn', text: `Log check failed: ${c.error}` };
  const placed = !!(placeKey(g.room) || placeKey(g.area));
  const here = placed ? 'here' : 'and no room or area';
  const notes = [
    c.elsewhere > 0 && `${plural(c.elsewhere, 'entry', 'entries')} with this name ${here} ${c.elsewhere === 1 ? 'points' : 'point'} at equipment in another room or area`,
    c.unknown > 0 && (c.unknown === 1 ? '1 entry has an ID that no longer exists' : `${c.unknown} entries have IDs that no longer exist`),
    c.capped && 'only the newest entries were checked',
  ].filter(Boolean);
  const tail = notes.length ? ` (${notes.join('; ')})` : '';
  if (!c.total) return { kind: c.elsewhere > 0 ? 'warn' : 'none', text: `Log check: no other entry with this name ${here} is linked to equipment ${placed ? 'in this room and area ' : ''}yet${tail}.` };
  const mine = chosenId ? c.uses.find(x => x.asset.id === chosenId) : null;
  const top = c.uses[0];
  if (mine && mine.count === c.total) {
    const fits = !asset || nameSimilarity(nameProfile(g.equipment), nameProfile(asset.name)) >= 0.8;
    const text = c.total === 1 ? `Log check: the one other entry with this name ${here} that has an ID uses this equipment` : `Log check: all ${c.total} entries with this name ${here} that have an ID use this equipment`;
    return { kind: fits && !c.elsewhere ? 'ok' : 'warn', text: `${text}${fits ? '' : ', but its name is different, so check it'}${tail}.` };
  }
  if (mine) return { kind: 'warn', text: `Log check: ${mine.count} of ${c.total} entries with this name ${here} use this equipment; the rest use ${plural(c.uses.length - 1, 'other one', 'others')}${tail}.` };
  return { kind: 'warn', text: `Log check: ${plural(top.count, 'entry', 'entries')} with this name ${here} ${top.count === 1 ? 'uses' : 'use'} ${top.asset.name} (${placeText(top.asset) || 'no room/area'})${chosenId ? ', not this one' : ''}${tail}.` };
};

// Entry's room/area text disagrees with the room/area of the equipment its ID points at
const placeDiffers = (r, a) => {
  const lr = placeKey(r.craa5_room), la = placeKey(r.craa5_area), ar = placeKey(a.room), aa = placeKey(a.area);
  return !!((lr && ar && lr !== ar) || (la && aa && la !== aa));
};

// --- MOVING LOG ENTRIES ONTO OTHER EQUIPMENT ---
const retroFilter = (code, from, ms, fromStillUsed) => {
  const sap = ciEq('craa5_sap', code);
  const parts = [];
  if (from && !fromStillUsed) parts.push(`(${sap} and ${guidEq('craa5_equipmentguid', from.id)})`);
  if (normName(ms.equipment)) {
    const place = [];
    if (normName(ms.room)) place.push(`(craa5_room eq null or craa5_room eq '' or ${ciEq('craa5_room', ms.room)})`);
    if (normName(ms.area)) place.push(`(craa5_area eq null or craa5_area eq '' or ${ciEq('craa5_area', ms.area)})`);
    parts.push(`(${[sap, BLANK_GUID, ciEq('craa5_equipment', ms.equipment)].concat(place).join(' and ')})`);
  }
  if (from && normName(ms.equipment) && normName(ms.room) && normName(ms.area) && !(samePlace(from.room, ms.room) && samePlace(from.area, ms.area))) {
    parts.push(`(${guidEq('craa5_equipmentguid', from.id)} and ${ciEq('craa5_equipment', ms.equipment)} and ${ciEq('craa5_room', ms.room)} and ${ciEq('craa5_area', ms.area)})`);
  }
  return parts.length ? parts.join(' or ') : null;
};
// What to write on a moved entry: the new ID; when syncText is true, also syncs craa5_equipment, craa5_room, and craa5_area to target!
const repointPayload = (r, from, target, guidOnly, syncText = false) => {
  const p = { craa5_equipmentguid: target.id };
  if (guidOnly) return p;
  if (syncText) {
    if (target.name) p.craa5_equipment = target.name;
    if (target.room) p.craa5_room = target.room;
    if (target.area) p.craa5_area = target.area;
    return p;
  }
  const copiedFromOld = from && cleanGuid(r.craa5_equipmentguid) === from.id
    && sameText(r.craa5_equipment, from.name) && samePlace(r.craa5_room, from.room) && samePlace(r.craa5_area, from.area);
  if (copiedFromOld) return { ...p, craa5_equipment: target.name, craa5_room: target.room, craa5_area: target.area };
  if (!safeString(r.craa5_equipment)) p.craa5_equipment = target.name;
  if (!safeString(r.craa5_room)) p.craa5_room = target.room;
  if (!safeString(r.craa5_area)) p.craa5_area = target.area;
  return p;
};
// Point every log entry matching filter at target, a page at a time (moved entries drop out of the filter).
const repointEntries = async (api, filter, from, target, guidOnly = false, syncText = false) => {
  let fixed = 0;
  let error = '';
  let more = true;
  const failedIds = new Set();
  for (let round = 0; round < LIMITS.retroRounds; round++) {
    const rows = await api.query(LOG_TABLE, { select: FIX_SELECT, filter, top: LIMITS.retroPage });
    const todo = rows.filter(r => !failedIds.has(r.craa5__log_id));
    if (!todo.length) { more = false; break; }
    const res = await pool(todo, 6, (r) => api.update(LOG_TABLE, r.craa5__log_id, repointPayload(r, from, target, guidOnly, syncText)));
    res.forEach((x, i) => { if (x.ok) fixed += 1; else { failedIds.add(todo[i].craa5__log_id); if (!error) error = errText(x.error); } });
    if (rows.length < LIMITS.retroPage) { more = false; break; }
  }
  return { fixed, failed: failedIds.size, failedIds: Array.from(failedIds), error, more };
};
// Move a fixed list of entries (read before anything was written) onto target.
const repointRows = async (api, rows, from, target, syncText = false) => {
  const res = await pool(rows, 6, (r) => api.update(LOG_TABLE, r.craa5__log_id, repointPayload(r, from, target, false, syncText)));
  const movedIds = [];
  let error = '';
  res.forEach((x, i) => { if (x.ok) movedIds.push(rows[i].craa5__log_id); else if (!error) error = errText(x.error); });
  return { fixed: movedIds.length, failed: rows.length - movedIds.length, error, movedIds };
};

// --- BREAKING AN ENTRY UP INTO PIECES ---
// An old entry can cover several things ("Floor Cleaning, shadow board + tools", "Mixers 1-3", or "Spiral Freezer" broken down
// into "Spiral Freezer North" + "Spiral Freezer South") that are separate equipment records now.
const LISTING = /\s*(?:[,;+&\/]|\band\b|\bplus\b)\s*/i;
const RANGE_IN_TEXT_RE = /^(.*?\b)(\d{1,2})\s*(?:-|to|thru|through)\s*(\d{1,2})\b(.*)$/i;

// The things a text lists ("Mixers 1, 2 & 3" or "Mixers 1-3" -> Mixers 1, Mixers 2, Mixers 3); [] unless it lists two or more
const textParts = (text) => {
  const raw = safeString(text).trim();
  const rm = raw.match(RANGE_IN_TEXT_RE);
  if (rm) {
    const prefix = rm[1].trim();
    const a = parseInt(rm[2], 10), b = parseInt(rm[3], 10);
    const suffix = rm[4].trim();
    if (b > a && b - a <= 12 && (prefix || suffix)) {
      const rangeList = [];
      for (let n = a; n <= b; n++) rangeList.push([prefix, String(n), suffix].filter(Boolean).join(' '));
      return rangeList;
    }
  }
  const out = [];
  raw.split(LISTING).map(x => x.trim()).filter(x => /[a-z0-9]/i.test(x)).forEach(x => {
    if (/^\d+$/.test(x)) {
      const words = out.length ? tokenize(out[out.length - 1]).filter(w => !/^\d+$/.test(w)) : [];
      if (words.length) out.push(`${words.join(' ')} ${x}`);
      return;
    }
    if (/[a-z0-9]{2}/i.test(x)) out.push(x);
  });
  const seen = new Set();
  const list = out.filter(x => { const k = canonName(x); if (!k || seen.has(k)) return false; seen.add(k); return true; });
  return list.length >= 2 ? list : [];
};
// Equipment records with the same name, room and area (twins, which the Unify tab merges) are one piece: the one more log
// entries already use, else the first. In fast mode, picks deterministically in 0ms without per-twin network queries.
const oneOfTwins = async (store, list, uses = new Map()) => {
  const fast = uses === 'fast' || !uses;
  const key = (a) => [canonName(a.name), placeKey(a.room), placeKey(a.area)].join('|');
  const sets = new Map();
  list.forEach(a => { const k = key(a); if (!sets.has(k)) sets.set(k, []); sets.get(k).push(a); });
  const keys = Array.from(sets.keys());
  if (fast) {
    return keys.map(k => sets.get(k).slice().sort((x, y) => (x.id < y.id ? -1 : 1))[0]);
  }
  const useOf = (id) => { if (!uses.has(id)) uses.set(id, store.logUse(id)); return uses.get(id); };
  const picked = await pool(keys, 3, async (k) => {
    const twins = sets.get(k).slice().sort((x, y) => (x.id < y.id ? -1 : 1));
    if (twins.length === 1) return twins[0];
    const counts = await pool(twins, 3, (a) => useOf(a.id));
    let best = 0;
    twins.forEach((a, i) => { if (counts[i].ok && (!counts[best].ok || counts[i].value.n > counts[best].value.n)) best = i; });
    return twins[best];
  });
  return picked.map((r, i) => (r.ok ? r.value : sets.get(keys[i])[0]));
};
// Equipment an old entry may now be broken down into:
// 1. Explicit list or number range ("Floor Cleaning, shadow board + tools", "Mixers 1-3")
// 2. Child assets in the same room/area (or same room) that contain all core words of the parent plus a piece modifier
//    (e.g. "Smock Racking" -> "Smock Racking Left" + "Smock Racking Right", or "Conveyor" -> "Infeed Conveyor" + "Discharge Conveyor")
const suggestPieces = async (store, g, uses) => {
  if (!canonName(g.equipment)) return null;
  await store.ensureAssetCatalog().catch(() => null);
  const hasRoom = !!placeKey(g.room);
  const hasArea = !!placeKey(g.area);
  const sameRoomAndArea = (a) => (!hasRoom || samePlace(g.room, a.room)) && (!hasArea || samePlace(g.area, a.area));
  const sameRoomOnly = (a) => !hasRoom || samePlace(g.room, a.room) || (hasArea && samePlace(g.room, a.area));

  const parts = textParts(g.equipment);
  if (parts.length) {
    const rs = await pool(parts, 3, async (part) => {
      const q = nameProfile(part);
      const want = { equipment: part, room: g.room, area: g.area };
      const candidates = await store.assetsLikeName(q, g.room, g.area);
      let scored = candidates.filter(sameRoomAndArea)
        .map(a => ({ a, s: scoreAsset(want, a, q) })).filter(c => c.s >= 0.75)
        .sort((x, y) => y.s - x.s || (x.a.id < y.a.id ? -1 : 1));
      if (!scored.length) {
        scored = candidates.filter(sameRoomOnly)
          .map(a => ({ a, s: scoreAsset({ equipment: part, room: g.room, area: '' }, a, q) })).filter(c => c.s >= 0.75)
          .sort((x, y) => y.s - x.s || (x.a.id < y.a.id ? -1 : 1));
      }
      if (!scored.length) return null;
      const tied = scored.filter(c => c.s >= scored[0].s - 1e-9).map(c => c.a);
      if (tied.some(a => canonName(a.name) !== canonName(tied[0].name))) return null;
      return (await oneOfTwins(store, tied, uses))[0];
    });
    const assets = uniqueById(rs.filter(r => r.ok && r.value).map(r => r.value));
    return assets.length >= 2 ? { how: 'text', assets, missing: parts.filter((x, i) => !(rs[i].ok && rs[i].value)) } : null;
  }

  const p = nameProfile(g.equipment);
  const stems = (words) => words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w));
  const mine = stems(p.words);
  if (!mine.length) return null;
  const found = await store.assetsLikeName(p, g.room, g.area);

  const matchKid = (a) => {
    const q = a._profile || nameProfile(a.name);
    const theirs = stems(q.words);
    // All core words of parent appear in child (in any order, so "Conveyor" matches "Infeed Conveyor" and "Conveyor Left")
    const allWordsPresent = mine.every(w => theirs.includes(w));
    if (!allWordsPresent) return false;
    const numsOk = !p.numList.length || p.numList.every(n => q.numList.includes(n));
    if (!numsOk) return false;
    return theirs.length + q.numList.length > mine.length + p.numList.length;
  };

  let kids = found.filter(sameRoomAndArea).filter(matchKid);
  if (kids.length < 2 && hasRoom) {
    kids = found.filter(sameRoomOnly).filter(matchKid);
  }
  kids.sort((x, y) => x.name.localeCompare(y.name));
  const names = new Set(kids.map(a => canonName(a.name)));
  if (names.size < 2 || names.size > LIMITS.splitPieces) return null;
  return { how: 'name', assets: await oneOfTwins(store, kids, uses), missing: [] };
};
// A blank room or area on the piece is filled in from the entry, unless the piece is somewhere else than the entry says
const pieceFields = (a, row) => {
  const same = !!row && placeOk({ room: row.craa5_room, area: row.craa5_area }, a);
  return { craa5_equipmentguid: a.id, craa5_equipment: a.name, craa5_room: a.room || (same ? safeString(row.craa5_room) : ''), craa5_area: a.area || (same ? safeString(row.craa5_area) : '') };
};
// Hours of the old entry for one piece: its whole-hour share rounded UP (craa5_hoursworked is Edm.Int32 in Dataverse), or null when none
const hoursFor = (row, count, index) => {
  const raw = row.craa5_hoursworked;
  if (raw === null || raw === undefined || raw === '') return null;
  const total = Number(raw);
  if (!Number.isFinite(total) || total < 0) return null;
  if (!(total > 0) || count < 2) return Math.ceil(total);
  return splitHours(total, count)[index];
};
// A new entry for another piece: what the old entry says (date, SAP order, initials), with the piece in place of the equipment
const entryForPiece = (row, a, hours) => {
  const e = pieceFields(a, row);
  if (safeString(row.craa5_sap)) e.craa5_sap = row.craa5_sap;
  if (safeString(row.craa5_lastcleaned)) e.craa5_lastcleaned = row.craa5_lastcleaned;
  if (safeString(row.craa5_lastcleanedby)) e.craa5_lastcleanedby = row.craa5_lastcleanedby;
  if (hours !== null && hours !== undefined) e.craa5_hoursworked = Math.max(0, Math.ceil(Number(hours) || 0));
  return e;
};
// The entries to break up, read just before anything is written (by id, a few at a time)
const readEntries = async (api, ids) => {
  const rs = await pool(chunked(ids, LIMITS.idChunk), 4, (c) => api.query(LOG_TABLE, { select: LOG_SELECT, filter: c.map(id => `craa5__log_id eq ${id}`).join(' or '), top: c.length }));
  const bad = rs.find(r => !r.ok);
  if (bad) throw bad.error;
  const out = new Map();
  rs.forEach(r => r.value.forEach(row => out.set(cleanGuid(row.craa5__log_id), row)));
  return out;
};
// Multiple entries on the same day are allowed, so all earlier entries can be moved and all child pieces receive entries.
const coveredByTarget = async () => ({ covered: new Set(), unchecked: false });
const isCovered = () => false;
// For each entry to break up, prepares all pieces (multiple entries on the same day are allowed). jobs: [{ id, pieces, keepOriginal }].
const planSplits = async (api, jobs, keepOriginal = false) => {
  const rows = await readEntries(api, Array.from(new Set(jobs.map(j => j.id))));
  const items = jobs.map(j => {
    const row = rows.get(cleanGuid(j.id));
    const keep = j.keepOriginal !== undefined ? !!j.keepOriginal : !!keepOriginal;
    if (!row) return { id: j.id, gone: true, pieces: j.pieces, todo: [], keepOriginal: keep };
    return { id: j.id, row, pieces: j.pieces, todo: j.pieces.slice(), keepOriginal: keep };
  });
  return { items, capped: [] };
};
// Saves the new entries first, then points the old entry at the first piece (unless keepOriginal is true, in which case all todo pieces are created as copies so the parent keeps its record too).
const runSplits = async (api, items, onStep) => {
  const out = { rows: 0, created: 0, failedRows: 0, error: '', fixedIds: [], pieceSkips: 0, leftAlone: 0, gone: 0, undated: 0 };
  let done = 0;
  await pool(items, 8, async (it) => {
    try {
      if (it.gone) { out.gone += 1; return; }
      if (it.undated) { out.undated += 1; return; }
      if (!it.todo.length) { out.leftAlone += 1; return; }
      out.pieceSkips += it.pieces.length - it.todo.length;
      const at = (x) => it.pieces.indexOf(x);
      let failed = 0;
      const startIdx = it.keepOriginal ? 0 : 1;
      for (let i = startIdx; i < it.todo.length; i++) {
        try { await api.create(LOG_TABLE, entryForPiece(it.row, it.todo[i], hoursFor(it.row, it.pieces.length, at(it.todo[i])))); out.created += 1; }
        catch (e) { failed += 1; if (!out.error) out.error = errText(e); }
      }
      if (failed) { out.failedRows += 1; return; }
      if (it.keepOriginal) { out.rows += 1; out.fixedIds.push(it.id); return; }
      const first = it.todo[0];
      const payload = pieceFields(first, it.row);
      const cur = it.row;
      if (it.todo.length === 1 && cleanGuid(cur.craa5_equipmentguid) === cleanGuid(first.id) && safeString(cur.craa5_equipment) === payload.craa5_equipment
        && safeString(cur.craa5_room) === payload.craa5_room && safeString(cur.craa5_area) === payload.craa5_area) { out.rows += 1; out.fixedIds.push(it.id); return; }
      const h = hoursFor(it.row, it.pieces.length, at(first));
      if (h !== null && h !== undefined && h !== it.row.craa5_hoursworked) payload.craa5_hoursworked = Math.max(0, Math.round(Number(h) || 0));
      try { await api.update(LOG_TABLE, it.id, payload); }
      catch (e) {
        let now = null;
        try { now = (await readEntries(api, [it.id])).get(cleanGuid(it.id)); } catch (_) { now = null; }
        const applied = !!now && cleanGuid(now.craa5_equipmentguid) === cleanGuid(first.id) && safeString(now.craa5_equipment) === safeString(payload.craa5_equipment)
          && (payload.craa5_hoursworked === undefined || Number(now.craa5_hoursworked) === Number(payload.craa5_hoursworked));
        if (!applied) throw e;
      }
      out.rows += 1; out.fixedIds.push(it.id);
    } catch (e) { out.failedRows += 1; if (!out.error) out.error = errText(e); }
    finally { done += 1; if (onStep) onStep(done); }
  });
  return out;
};
// What a plan will do, for the question before anything is saved
const splitStats = (items) => {
  const live = items.filter(it => !it.gone && it.todo.length);
  return {
    rows: live.length,
    creates: live.reduce((n, it) => n + (it.keepOriginal ? it.todo.length : it.todo.length - 1), 0),
    pieceSkips: live.reduce((n, it) => n + it.pieces.length - it.todo.length, 0),
    skippedHours: Math.round(live.reduce((n, it) => n + it.pieces.reduce((sum, x, i) => (it.todo.indexOf(x) >= 0 ? sum : sum + (Number(hoursFor(it.row, it.pieces.length, i)) || 0)), 0), 0) * 100) / 100,
    leftAlone: items.filter(it => !it.gone && !it.undated && !it.todo.length).length,
    gone: items.filter(it => it.gone).length,
    undated: items.filter(it => it.undated).length,
  };
};

// Equipment already logged for an order on a date
const fetchDupes = async (api, code, dateStr) => {
  const rows = await api.query(LOG_TABLE, {
    select: ['craa5_equipmentguid'],
    filter: `${ciEq('craa5_sap', code)} and craa5_lastcleaned ge ${dateStr}T00:00:00Z and craa5_lastcleaned lt ${nextDay(dateStr)}T00:00:00Z`,
    top: 500,
  });
  return new Set(rows.map(r => cleanGuid(r.craa5_equipmentguid)).filter(Boolean));
};

// ===== PICTURE TO JPG (every picture upload goes through this; the same block is in each app that uploads pictures) =====
// Whatever picture is picked (PNG, WebP, GIF, BMP, TIFF, an iPhone HEIC photo ...) goes up as a JPG, as large as maxSide px on
// its long side (default 1600). Chrome and Edge cannot open HEIC (Safari can), so a HEIC photo is turned into a JPG by a small
// converter that is loaded from a CDN the first time one is picked. A photo that fails says why, in plain words.
const PICTURE_MAX_SIDE = 1600;
const HEIC_CONVERTER_URLS = [
  'https://cdnjs.cloudflare.com/ajax/libs/heic2any/0.0.4/heic2any.min.js',
  'https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js',
  'https://unpkg.com/heic2any@0.0.4/dist/heic2any.min.js'
];
const HEIC_FILE_NAME = /\.(heic|heif)$/i;
const looksLikeHeic = (file) => /hei[cf]/i.test((file && file.type) || '') || HEIC_FILE_NAME.test((file && file.name) || '');
const isJpegFile = (file) => /^image\/(p?jpe?g)$/i.test((file && file.type) || '') || /\.(jpe?g|jfif)$/i.test((file && file.name) || '');
const HEIC_HELP = 'this is an iPhone HEIC photo and the converter that turns it into a JPG could not be loaded (is the network blocked?). It can be tried again, or save or share the photo as a JPG first (for new photos, set the iPhone to Settings > Camera > Formats > Most Compatible)';

// heic2any 0.0.4 leaves one "message" listener on its worker for every photo it converts, and each one keeps that photo's bytes in
// memory until the page is reloaded. Each listener answers a single request, so it is taken off again once its answer has come.
function tidyHeicWorker() {
  try {
    const w = window.__heic2any__worker;
    if (!w || w.__tidy) return;
    w.__tidy = true;
    let lastId = null;
    const post = w.postMessage.bind(w);
    const add = w.addEventListener.bind(w);
    w.postMessage = function (msg) { lastId = msg && msg.id; return post.apply(null, arguments); };
    w.addEventListener = function (type, fn, opts) {
      if (type !== 'message' || typeof fn !== 'function' || lastId === null) return add(type, fn, opts);
      const id = lastId;
      lastId = null;
      const wrapped = function (ev) {
        fn.call(this, ev);
        if (ev && ev.data && ev.data.id === id) w.removeEventListener('message', wrapped);
      };
      return add(type, wrapped, opts);
    };
  } catch (e) { /* only a tidy-up: the conversion works without it */ }
}

let heicConverterLoading = null;
function loadHeicConverter() {
  if (typeof window !== 'undefined' && typeof window.heic2any === 'function') return Promise.resolve(window.heic2any);
  if (heicConverterLoading) return heicConverterLoading;
  const tryUrl = (url) => new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = url;
    s.onload = () => { if (typeof window.heic2any === 'function') { tidyHeicWorker(); resolve(window.heic2any); } else reject(new Error('empty')); };
    s.onerror = () => { if (s.parentNode) s.parentNode.removeChild(s); reject(new Error('blocked')); };
    document.head.appendChild(s);
  });
  heicConverterLoading = (async () => {
    for (let i = 0; i < HEIC_CONVERTER_URLS.length; i += 1) {
      try { return await tryUrl(HEIC_CONVERTER_URLS[i]); } catch (e) { /* try the next address */ }
    }
    heicConverterLoading = null; // a later try may work
    const err = new Error(HEIC_HELP);
    err.retry = true; // not the photo's fault: it can be tried again
    throw err;
  })();
  return heicConverterLoading;
}

// The first bytes of a HEIC / HEIF file: a "ftyp" box that names one of its brands (a photo renamed to .jpg still counts)
function sniffHeic(file) {
  return new Promise((resolve) => {
    if (!file || typeof FileReader === 'undefined' || !file.slice) { resolve(false); return; }
    const reader = new FileReader();
    reader.onerror = () => resolve(false);
    reader.onload = () => {
      try {
        const b = new Uint8Array(reader.result);
        const tag = (o) => String.fromCharCode(b[o], b[o + 1], b[o + 2], b[o + 3]);
        if (b.length < 12 || tag(4) !== 'ftyp') { resolve(false); return; }
        const brands = [tag(8)];
        for (let o = 16; o + 4 <= b.length; o += 4) brands.push(tag(o));
        resolve(brands.some(x => /^(heic|heix|hevc|hevx|heim|heis|hevm|hevs|mif1|msf1|heif)$/.test(x)));
      } catch (e) { resolve(false); }
    };
    try { reader.readAsArrayBuffer(file.slice(0, 64)); } catch (e) { resolve(false); }
  });
}

// A HEIC photo as a JPEG blob; one picked file is converted once, however many parts of the app ask
const heicJpegs = typeof WeakMap === 'function' ? new WeakMap() : null;
function heicToJpegBlob(file) {
  if (heicJpegs && heicJpegs.has(file)) return heicJpegs.get(file);
  const p = loadHeicConverter().then(heic2any => heic2any({ blob: file, toType: 'image/jpeg', quality: 0.92 }).then(
    out => (Array.isArray(out) ? out[0] : out),
    err => { throw new Error(`this HEIC photo could not be converted (${(err && (err.message || err.code)) || 'unknown reason'}). Save or share it as a JPG first, then add it again`); }
  ));
  if (heicJpegs) {
    heicJpegs.set(file, p);
    p.catch(() => { heicJpegs.delete(file); });
  }
  return p;
}

const decodePicture = (blob) => new Promise((resolve, reject) => {
  const url = URL.createObjectURL(blob);
  const img = new Image();
  img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
  img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('not a picture this browser can open')); };
  img.src = url;
});

// Resolves the picture as a JPEG data URL. opts.maxSide: long side in px (default 1600; 0 keeps the size, up to 4096);
// opts.quality: 0 to 1 (default 0.8). Rejects with a plain sentence.
async function pictureToJpegDataUrl(file, opts) {
  const o = opts || {};
  const maxSide = o.maxSide === undefined ? PICTURE_MAX_SIDE : (o.maxSide || 4096);
  const quality = o.quality || 0.8;
  let img;
  try {
    img = await decodePicture(file);
  } catch (e) {
    if (!(looksLikeHeic(file) || await sniffHeic(file))) throw new Error('That file is not a picture this browser can open. Try a JPG or PNG.');
    const jpeg = await heicToJpegBlob(file); // throws a plain sentence of its own
    try { img = await decodePicture(jpeg); } catch (e2) { throw new Error('this HEIC photo could not be converted. Save or share it as a JPG first, then add it again'); }
  }
  const w = img.naturalWidth || img.width;
  const h = img.naturalHeight || img.height;
  if (!w || !h) throw new Error('That picture has no size this browser can read.');
  try {
    const scale = Math.min(1, maxSide / Math.max(w, h));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(w * scale));
    canvas.height = Math.max(1, Math.round(h * scale));
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#FFFFFF'; // JPEG has no transparency: see-through parts would turn black
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    return canvas.toDataURL('image/jpeg', quality);
  } catch (err) {
    throw new Error('The picture could not be prepared for upload.');
  }
}
// ===== END PICTURE TO JPG =====

// Paperwork must stay readable: up to 1600 px on the long side as a JPEG (a few hundred KB). Resolves { data: base64 } or { error: sentence }
const compressImage = (file) => pictureToJpegDataUrl(file).then(
  (url) => ({ data: url.split(',')[1] }),
  (err) => ({ error: (err && err.message) || 'That picture could not be read.' })
);

// ===== SHEET READER (paperwork: several pages and PDFs, and reading the order, date and hours off the sheet) =====
// The paperwork for an order can be one picture, one PDF, or several pictures and PDFs together (they are joined into one PDF).
// The sheet can also be read: the order, date, hours and initials printed on it are offered to the form and the admin decides.
// Reading needs two small libraries, loaded from a CDN the first time and then kept by the browser (pdf.js for PDFs, about 1 MB;
// Tesseract for pictures, about 7 MB). Attaching never needs them, except to join a PDF with other pages.
const SHEET_MAX_PAGES = 40;        // pages in one paperwork file (more are left out)
const SHEET_READ_PAGES = 8;        // pages that are read for details (every page is still attached)
const SHEET_ATTACH_SIDE = 1800;    // px, long side of a page that is attached as part of a joined PDF
const SHEET_READ_SIDE = 2600;      // px, long side of a page while it is read (small print needs more pixels than the copy that is kept)
const SHEET_PDF_MAX_BYTES = 24 * 1024 * 1024;
const PDFJS_VERSION = '3.11.174';
const PDFJS_URLS = [
  `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.min.js`,
  `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/build/pdf.min.js`,
  `https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/build/pdf.min.js`
];
const PDFJS_WORKER_URLS = [
  `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.worker.min.js`,
  `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/build/pdf.worker.min.js`,
  `https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/build/pdf.worker.min.js`
];
const PDFJS_ASSETS = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/`;
const TESSERACT_URLS = [
  'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js',
  'https://unpkg.com/tesseract.js@5.1.1/dist/tesseract.min.js'
];
const OCR_SOURCES = [
  { worker: 'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/worker.min.js', core: 'https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1', lang: 'https://cdn.jsdelivr.net/npm/@tesseract.js-data/eng@1.0.0/4.0.0_best_int' },
  { worker: 'https://unpkg.com/tesseract.js@5.1.1/dist/worker.min.js', core: 'https://unpkg.com/tesseract.js-core@5.1.1', lang: 'https://unpkg.com/@tesseract.js-data/eng@1.0.0/4.0.0_best_int' }
];
const READER_HELP = 'the reader that reads the sheet could not be loaded (the network may block it). The paperwork is still attached; type the details as before';

const isPdfFile = (f) => /^application\/(x-)?pdf$/i.test((f && f.type) || '') || /\.pdf$/i.test((f && f.name) || '');
const isPdfBytes = (b) => !!b && b.length > 8 && b[0] === 0x25 && b[1] === 0x50 && b[2] === 0x44 && b[3] === 0x46; // "%PDF"

const readFileBytes = (file) => new Promise((resolve, reject) => {
  const reader = new FileReader();
  reader.onerror = () => reject(new Error('That file could not be read.'));
  reader.onload = () => resolve(new Uint8Array(reader.result));
  try { reader.readAsArrayBuffer(file); } catch (e) { reject(new Error('That file could not be read.')); }
});

// A script from the first CDN that answers; one try per address, and a later call may try again after a failure
const libraryLoads = {};
function loadLibrary(key, urls, ready) {
  const have = ready();
  if (have) return Promise.resolve(have);
  if (libraryLoads[key]) return libraryLoads[key];
  const tryUrl = (url) => new Promise((resolve, reject) => {
    const s = document.createElement('script');
    let done = false;
    const end = (fn, arg) => { if (done) return; done = true; clearTimeout(timer); if (fn === reject && s.parentNode) s.parentNode.removeChild(s); fn(arg); };
    const timer = setTimeout(() => end(reject, new Error('slow')), 25000);
    s.src = url;
    s.async = true;
    s.onload = () => { const lib = ready(); if (lib) end(resolve, lib); else end(reject, new Error('empty')); };
    s.onerror = () => end(reject, new Error('blocked'));
    document.head.appendChild(s);
  });
  libraryLoads[key] = (async () => {
    for (let i = 0; i < urls.length; i += 1) {
      try { return await tryUrl(urls[i]); } catch (e) { /* try the next address */ }
    }
    libraryLoads[key] = null;
    const err = new Error(READER_HELP);
    err.reader = true; // not the sheet's fault: reading can be tried again later
    throw err;
  })();
  return libraryLoads[key];
}

let pdfWorkerReady = null; // one setup of the PDF worker, shared by every row that asks at the same time
async function setUpPdfWorker(lib) {
  let set = false;
  // The worker script sits on another site, which a browser will not start as a worker directly: fetch it and start a copy of it
  for (let i = 0; i < PDFJS_WORKER_URLS.length && !set; i += 1) {
    try {
      const res = await fetch(PDFJS_WORKER_URLS[i]);
      if (!res.ok) continue;
      const code = await res.text();
      lib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([code], { type: 'text/javascript' }));
      set = true;
    } catch (e) { /* try the next address */ }
  }
  if (!set) {
    // pdf.js needs some address; when the worker cannot be started it runs the worker script on the page itself (slower, still works)
    lib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER_URLS[0];
    try { await loadLibrary('pdfworker', PDFJS_WORKER_URLS, () => (typeof window !== 'undefined' && window.pdfjsWorker) || null); } catch (e) { /* nothing more to try */ }
  }
}
async function loadPdfJs() {
  const lib = await loadLibrary('pdfjs', PDFJS_URLS, () => (typeof window !== 'undefined' && window.pdfjsLib) || null);
  if (lib.GlobalWorkerOptions && !lib.GlobalWorkerOptions.workerSrc) {
    if (!pdfWorkerReady) pdfWorkerReady = setUpPdfWorker(lib);
    await pdfWorkerReady;
  }
  return lib;
}

async function openPdf(file) {
  const lib = await loadPdfJs();
  const bytes = await readFileBytes(file);
  if (!isPdfBytes(bytes)) throw new Error('That file is not a PDF.');
  const task = lib.getDocument({ data: bytes, cMapUrl: `${PDFJS_ASSETS}cmaps/`, cMapPacked: true, standardFontDataUrl: `${PDFJS_ASSETS}standard_fonts/`, isEvalSupported: false, verbosity: 0 });
  try {
    return await task.promise;
  } catch (e) {
    try { task.destroy(); } catch (e2) { /* the worker thread is freed when it can be */ }
    throw new Error(e && e.name === 'PasswordException' ? 'That PDF is protected with a password.' : 'That PDF could not be opened.');
  }
}

// The text of one PDF page as lines: items on the same height are one line, left to right
function pdfLinesOf(items) {
  const rows = [];
  (items || []).forEach((it) => {
    if (!it || typeof it.str !== 'string' || !it.str) return;
    const x = it.transform ? it.transform[4] : 0;
    const y = it.transform ? it.transform[5] : 0;
    let row = null;
    for (let i = 0; i < rows.length; i += 1) { if (Math.abs(rows[i].y - y) <= 3) { row = rows[i]; break; } }
    if (!row) { row = { y, cells: [] }; rows.push(row); }
    row.cells.push({ x, s: it.str, w: it.width || 0 });
  });
  rows.sort((a, b) => b.y - a.y);
  return rows.map((r) => {
    r.cells.sort((a, b) => a.x - b.x);
    let out = '';
    let end = null;
    r.cells.forEach((c) => {
      if (end !== null && c.x - end > 3 && !/\s$/.test(out) && !/^\s/.test(c.s)) out += c.x - end > 14 ? '   ' : ' ';
      out += c.s;
      end = c.x + c.w;
    });
    return out.replace(/\s+$/, '');
  }).filter(Boolean).join('\n');
}

async function renderPdfPage(page, side) {
  const v1 = page.getViewport({ scale: 1 });
  const scale = Math.min(4, side / Math.max(v1.width, v1.height));
  const vp = page.getViewport({ scale });
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(vp.width));
  canvas.height = Math.max(1, Math.round(vp.height));
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  await page.render({ canvasContext: ctx, viewport: vp }).promise;
  return canvas;
}

// A picked picture (HEIC too) on a canvas, as large as `side` px on its long side and never enlarged
async function decodeFilePicture(file) {
  try { return await decodePicture(file); } catch (e) {
    if (!(looksLikeHeic(file) || await sniffHeic(file))) throw new Error('That file is not a picture this browser can open. Try a JPG or PNG.');
    const jpeg = await heicToJpegBlob(file);
    try { return await decodePicture(jpeg); } catch (e2) { throw new Error('this HEIC photo could not be converted. Save or share it as a JPG first, then add it again'); }
  }
}
async function pictureCanvas(file, side) {
  const img = await decodeFilePicture(file);
  const w = img.naturalWidth || img.width;
  const h = img.naturalHeight || img.height;
  if (!w || !h) throw new Error('That picture has no size this browser can read.');
  const scale = Math.min(1, side / Math.max(w, h));
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(w * scale));
  canvas.height = Math.max(1, Math.round(h * scale));
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
  return canvas;
}
const canvasJpeg = (canvas, quality) => ({ b64: canvas.toDataURL('image/jpeg', quality).split(',')[1], w: canvas.width, h: canvas.height });

// --- Joining pages into one PDF (each page is a JPEG; no library needed) ---
function jpegPagesToPdf(pages) {
  const chunks = [];
  const offsets = [];
  let length = 0;
  const text = (s) => { const b = new Uint8Array(s.length); for (let i = 0; i < s.length; i += 1) b[i] = s.charCodeAt(i) & 255; return b; };
  const push = (b) => { chunks.push(b); length += b.length; };
  const object = (n, head, body) => {
    offsets[n] = length;
    push(text(`${n} 0 obj\n${head}`));
    if (body) { push(text('\nstream\n')); push(body); push(text('\nendstream')); }
    push(text('\nendobj\n'));
  };
  push(text('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n'));
  const kids = pages.map((p, i) => `${3 + i * 3} 0 R`).join(' ');
  object(1, '<< /Type /Catalog /Pages 2 0 R >>');
  object(2, `<< /Type /Pages /Kids [${kids}] /Count ${pages.length} >>`);
  pages.forEach((p, i) => {
    const n = 3 + i * 3;
    const k = 792 / Math.max(p.w, p.h);          // the long side is 792 points (11 inches)
    const W = Math.round(p.w * k * 100) / 100;
    const H = Math.round(p.h * k * 100) / 100;
    const content = `q ${W} 0 0 ${H} 0 0 cm /Im0 Do Q`;
    object(n, `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${W} ${H}] /Resources << /XObject << /Im0 ${n + 2} 0 R >> >> /Contents ${n + 1} 0 R >>`);
    object(n + 1, `<< /Length ${content.length} >>`, text(content));
    object(n + 2, `<< /Type /XObject /Subtype /Image /Width ${p.w} /Height ${p.h} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.bytes.length} >>`, p.bytes);
  });
  const count = 3 + pages.length * 3;
  const xref = length;
  let table = `xref\n0 ${count}\n0000000000 65535 f \n`;
  for (let n = 1; n < count; n += 1) table += `${String(offsets[n]).padStart(10, '0')} 00000 n \n`;
  push(text(`${table}trailer\n<< /Size ${count} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`));
  const out = new Uint8Array(length);
  let at = 0;
  chunks.forEach((c) => { out.set(c, at); at += c.length; });
  return out;
}

// All pages of one picked file as JPEGs (a picture is one page; a PDF is drawn page by page)
async function pageJpegsOf(file, maxPages) {
  const out = [];
  if (isPdfFile(file)) {
    const doc = await openPdf(file);
    try {
      const n = Math.min(doc.numPages, maxPages);
      for (let i = 1; i <= n; i += 1) {
        const page = await doc.getPage(i);
        const j = canvasJpeg(await renderPdfPage(page, SHEET_ATTACH_SIDE), 0.8);
        out.push({ b64: j.b64, w: j.w, h: j.h });
        if (page.cleanup) page.cleanup();
      }
      out.cut = doc.numPages > n ? doc.numPages - n : 0;
    } finally { try { doc.destroy(); } catch (e) { /* already closed */ } }
  } else {
    const j = canvasJpeg(await pictureCanvas(file, SHEET_ATTACH_SIDE), 0.8);
    out.push({ b64: j.b64, w: j.w, h: j.h });
    out.cut = 0;
  }
  return out;
}

// What is attached for the picked files. One picture goes up as the JPG it always was and one PDF as it is; anything else is joined
// into one PDF. Resolves { data (base64), mime, ext, pages, cut, skipped: [{ name, why }] } (no data when nothing could be used)
async function buildPaperwork(files, cache) {
  const skipped = [];
  const why = (e) => String((e && e.message) || 'That file could not be read.').replace(/\.$/, '');
  if (files.length === 1 && !isPdfFile(files[0])) {
    const r = await compressImage(files[0]);
    return r.data ? { data: r.data, mime: 'image/jpeg', ext: 'jpg', pages: 1, cut: 0, skipped } : { skipped: [{ name: files[0].name, file: files[0], why: why({ message: r.error }) }] };
  }
  if (files.length === 1) {
    try {
      const bytes = await readFileBytes(files[0]);
      if (!isPdfBytes(bytes)) throw new Error('That file is not a PDF.');
      if (bytes.length > SHEET_PDF_MAX_BYTES) throw new Error('This PDF is larger than 24 MB. Scan it at a lower quality or split it');
      return { data: bytesToBase64(bytes), mime: 'application/pdf', ext: 'pdf', pages: 0, cut: 0, skipped };
    } catch (e) { return { skipped: [{ name: files[0].name, file: files[0], why: why(e) }] }; }
  }
  const pages = [];
  let cut = 0;
  for (let i = 0; i < files.length; i += 1) {
    const file = files[i];
    if (pages.length >= SHEET_MAX_PAGES) { cut += 1; skipped.push({ name: file.name, file, why: `Only the first ${SHEET_MAX_PAGES} pages are attached` }); continue; }
    try {
      let got = cache.get(file);
      if (!got) { got = await pageJpegsOf(file, SHEET_MAX_PAGES); cache.set(file, got); }
      let taken = 0;
      for (let j = 0; j < got.length && pages.length < SHEET_MAX_PAGES; j += 1) { pages.push(got[j]); taken += 1; }
      cut += (got.length - taken) + (got.cut || 0);
    } catch (e) {
      skipped.push({ name: file.name, file, why: isPdfFile(file) && e && e.reader ? 'A PDF can only be joined with other pages when the PDF reader loads (the network may block it). Attach the PDF on its own' : why(e) });
    }
  }
  if (!pages.length) return { skipped };
  const bytes = jpegPagesToPdf(pages.map(p => ({ w: p.w, h: p.h, bytes: base64ToBytes(p.b64) })));
  return { data: bytesToBase64(bytes), mime: 'application/pdf', ext: 'pdf', pages: pages.length, cut, skipped };
}

// --- Reading a picture (OCR with Tesseract; one reader is kept for a couple of minutes, then let go to free memory) ---
let ocrJob = null;
let ocrIdle = null;
let ocrLog = null;     // called with Tesseract's progress while a sheet is being read
let ocrWarm = false;   // the reader is loaded and ready, so reading starts at once
async function getOcrWorker() {
  if (ocrIdle) { clearTimeout(ocrIdle); ocrIdle = null; }
  if (ocrJob) return ocrJob;
  const job = (async () => {
    const T = await loadLibrary('tesseract', TESSERACT_URLS, () => (typeof window !== 'undefined' && window.Tesseract) || null);
    let last = null;
    for (let i = 0; i < OCR_SOURCES.length; i += 1) {
      const src = OCR_SOURCES[i];
      try { const w = await T.createWorker('eng', 1, { workerPath: src.worker, corePath: src.core, langPath: src.lang, logger: (m) => { if (ocrLog) ocrLog(m); } }); ocrWarm = true; return w; }
      catch (e) { last = e; }
    }
    const err = new Error(READER_HELP);
    err.reader = true;
    err.detail = errText(last);
    throw err;
  })();
  ocrJob = job;
  job.catch(() => { if (ocrJob === job) ocrJob = null; });
  return job;
}
function releaseOcrLater() {
  if (ocrIdle) clearTimeout(ocrIdle);
  ocrIdle = setTimeout(() => {
    const job = ocrJob;
    ocrJob = null;
    ocrIdle = null;
    ocrWarm = false;
    if (job) job.then(w => { try { w.terminate(); } catch (e) { /* gone already */ } }, () => {});
  }, 120000);
}
const rotateCanvas = (canvas, quarter) => {
  const out = document.createElement('canvas');
  const turned = quarter % 2 === 1;
  out.width = turned ? canvas.height : canvas.width;
  out.height = turned ? canvas.width : canvas.height;
  const ctx = out.getContext('2d');
  ctx.translate(out.width / 2, out.height / 2);
  ctx.rotate(quarter * Math.PI / 2);
  ctx.drawImage(canvas, -canvas.width / 2, -canvas.height / 2);
  return out;
};
const ocrOnce = async (worker, canvas) => {
  const blob = await new Promise((resolve) => { try { canvas.toBlob(resolve, 'image/png'); } catch (e) { resolve(null); } });
  if (!blob) throw new Error('That page could not be prepared for reading.');
  const res = await Promise.race([
    worker.recognize(blob),
    new Promise((resolve, reject) => { setTimeout(() => reject(new Error('Reading this page took too long.')), 120000); })
  ]);
  const data = (res && res.data) || {};
  const text = String(data.text || '');
  const words = (text.match(/[A-Za-z0-9]{2,}/g) || []).length;
  return { text, conf: Number(data.confidence) || 0, words };
};
// A page that comes out as noise is turned a quarter each way, and the best reading is kept (a sheet photographed sideways)
async function ocrCanvas(canvas) {
  const worker = await getOcrWorker();
  try {
    let best = await ocrOnce(worker, canvas);
    if (best.conf < 45 || best.words < 15) {
      for (let q = 1; q <= 3 && (best.conf < 45 || best.words < 15); q += 2) {
        let r = null;
        try { r = await ocrOnce(worker, rotateCanvas(canvas, q)); } catch (e) { r = null; }
        if (r && r.words * r.conf > best.words * best.conf) best = r;
      }
    }
    return best.text;
  } catch (e) {
    if (ocrJob) { const job = ocrJob; ocrJob = null; ocrWarm = false; job.then(w => { try { w.terminate(); } catch (e2) { /* gone */ } }, () => {}); } // a reader that failed is not reused
    throw e;
  } finally { releaseOcrLater(); }
}

// How much of a PDF page one or more pictures cover (0 to 1): a scanned sheet is one big picture, a logo is a small one. Used to tell a
// scanned page with only a small printed stamp from a page that is plain text.
async function pdfPictureShare(page) {
  try {
    const lib = typeof window !== 'undefined' ? window.pdfjsLib : null;
    const ops = (lib && lib.OPS) || {};
    const pictures = [ops.paintImageXObject || 85, ops.paintInlineImageXObject || 86, ops.paintJpegXObject || 82];
    const list = await page.getOperatorList();
    const box = page.view || [0, 0, 612, 792];
    const area = Math.abs((box[2] - box[0]) * (box[3] - box[1])) || 1;
    let scale = 1; // the area one picture covers is the determinant of the matrices applied before it
    const stack = [];
    let covered = 0;
    for (let i = 0; i < list.fnArray.length; i += 1) {
      const op = list.fnArray[i];
      if (op === (ops.save || 10)) stack.push(scale);
      else if (op === (ops.restore || 11)) { if (stack.length) scale = stack.pop(); }
      else if (op === (ops.transform || 12)) { const a = list.argsArray[i] || []; scale *= Math.abs(a[0] * a[3] - a[1] * a[2]) || 0; }
      else if (pictures.indexOf(op) >= 0) covered += scale;
    }
    return Math.min(1, covered / area);
  } catch (e) { return 0; } // cannot tell: treat as text only
}

// The text of one picked file, page by page: a PDF's own text where it has any, otherwise the pictures are read.
// ctx: { left (pages that may still be read), stop() true to give up, page(n, of) before a page is read, ocr() before a picture is read }.
// Resolves { texts, total, unread } (unread: pages that needed the picture reader when it could not be loaded; their text-layer pages are still returned)
async function readFileText(file, ctx) {
  const texts = [];
  if (isPdfFile(file)) {
    const doc = await openPdf(file);
    try {
      const total = doc.numPages;
      const n = Math.min(total, ctx.left);
      let unread = 0;
      let blocked = null;
      for (let i = 1; i <= n; i += 1) {
        if (ctx.stop()) break;
        ctx.page(i, n);
        const page = await doc.getPage(i);
        let text = '';
        try { const tc = await page.getTextContent(); text = pdfLinesOf(tc.items); } catch (e) { text = ''; }
        const chars = text.replace(/\s+/g, '').length;
        // a scanned page has no text of its own (or only a small printed stamp next to the picture)
        if (chars < 25 || (chars < 600 && await pdfPictureShare(page) >= 0.35)) {
          if (blocked) unread += 1;
          else {
            try {
              ctx.ocr();
              const seen = await ocrCanvas(await renderPdfPage(page, SHEET_READ_SIDE));
              text = text ? `${text}\n${seen}` : seen;
            } catch (e) { blocked = e; unread += 1; } // the pages that have text are still used
          }
        }
        texts.push(text);
        if (page.cleanup) page.cleanup();
      }
      if (blocked && !texts.some(t => t.replace(/\s+/g, '').length >= 25)) throw blocked; // nothing at all could be read: say why
      return { texts, total, unread };
    } finally { try { doc.destroy(); } catch (e) { /* already closed */ } }
  }
  if (!ctx.stop()) {
    ctx.page(1, 1);
    ctx.ocr();
    texts.push(await ocrCanvas(await pictureCanvas(file, SHEET_READ_SIDE)));
  }
  return { texts, total: 1, unread: 0 };
}

// --- Finding the order, date, hours and initials in the text of the sheet (plain text in, suggestions out) ---
const SHEET_MONTHS = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };
const SHEET_MONTH_RE = 'jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?';
const SHEET_MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const SHEET_WORDS = /^(ORDER|NUMBER|DESCRIPTION|MAINTENANCE|SANITATION|PLANT|EQUIPMENT|LOCATION|PRIORITY|STATUS|OPERATION|OPERATIONS|ACTIVITY|WORKCENTER|CONFIRMATION|COMPLETED|SCHEDULED|FINISH|START|ACTUAL|PERFORMED|SIGNATURE|COMMENTS|COMMENT|PAGE|PRINTED|CREATED|CHANGED|REVISION|PLANNER|PLANNING|REQUIREMENT|REQUIREMENTS|PROCEDURE|INSTRUCTIONS|WORKORDER|DEPARTMENT|SUPERVISOR|TECHNICIAN|INSPECTION|VERIFIED|FUNCTIONAL|TEMPERATURE|CHEMICAL|CONCENTRATION|PREVENTIVE|CORRECTIVE|INTERNAL|MATERIAL|MATERIALS|COMPONENT|COMPONENTS|WEEKLY|MONTHLY|QUARTERLY|ANNUALLY|DAILY|LUBRICATION|CLEANING|SANITIZE)$/;
const sheetIso = (y, m, d) => {
  if (y < 100) y += 2000;
  const dt = new Date(Date.UTC(y, m - 1, d));
  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== m - 1 || dt.getUTCDate() !== d) return '';
  return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
};
const sheetDateWords = (iso) => { const p = iso.split('-'); return `${SHEET_MONTH_NAMES[Number(p[1]) - 1]} ${Number(p[2])}, ${p[0]}`; };
// Letters that are really digits (O for 0, l or I for 1) inside something that has the shape of a date or a time
const sheetDigits = (s) => s.replace(/[Oo]/g, '0').replace(/[lI|]/g, '1');
const sheetLines = (text) => String(text || '').replace(/\r/g, '').split('\n');

function sheetDatesIn(line, ctx) {
  const found = [];
  const inRange = (iso) => !!iso && iso >= ctx.minDate && iso <= ctx.today;
  // weak: the date only exists when read the other way round than the plant's usual way (so it is never filled in by itself)
  const add = (iso, at, end, o) => {
    const opt = o || {};
    if (inRange(iso) && !found.some(f => f.iso === iso && Math.abs(f.at - at) < 6)) found.push({ iso, at, end, amb: !!opt.amb, alt: !!opt.alt, pair: opt.pair || '', weak: !!opt.weak });
  };
  let m;
  const iso = /(?:^|[^0-9A-Za-z])((?:19|20)\d{2})[\/.\-](\d{1,2})[\/.\-](\d{1,2})(?![0-9])/g;
  while ((m = iso.exec(line))) add(sheetIso(Number(m[1]), Number(m[2]), Number(m[3])), m.index, m.index + m[0].length);
  const num = /(?:^|[^0-9A-Za-z])([0-9OolI|]{1,2})([\/.\-])([0-9OolI|]{1,2})\2((?:[0-9OolI|]{4})|(?:[0-9OolI|]{2}))(?![0-9])/g;
  while ((m = num.exec(line))) {
    const a = Number(sheetDigits(m[1]));
    const b = Number(sheetDigits(m[3]));
    const y = Number(sheetDigits(m[4]));
    const end = m.index + m[0].length;
    // 10/07/2026 is month first (a US plant); 07.10.2026 is day first (the usual SAP style with dots). When the other way round is a
    // real day too (a and b both 12 or less), it is offered as well, one point lower, and the panel says which way it was read.
    const us = sheetIso(y, a, b);
    const eu = sheetIso(y, b, a);
    const first = m[2] === '.' ? eu : us;
    const second = m[2] === '.' ? us : eu;
    const both = inRange(first) && inRange(second) && first !== second;
    if (inRange(first)) { add(first, m.index, end, { amb: both, pair: both ? second : '' }); if (both) add(second, m.index + 1, end, { amb: true, alt: true, pair: first }); }
    else add(second, m.index, end, { weak: !!first && !!second }); // 12/03 with 12/03 in the future: Mar 12 is a guess, 13/10 can only be Oct 13
  }
  const named = new RegExp(`(?:^|[^A-Za-z0-9])(${SHEET_MONTH_RE})\\.?\\s+(\\d{1,2})(?:st|nd|rd|th)?,?\\s+(\\d{4})(?![0-9])`, 'gi');
  while ((m = named.exec(line))) add(sheetIso(Number(m[3]), SHEET_MONTHS[m[1].slice(0, 3).toLowerCase()], Number(m[2])), m.index, m.index + m[0].length);
  const named2 = new RegExp(`(?:^|[^A-Za-z0-9])(\\d{1,2})(?:st|nd|rd|th)?\\s+(${SHEET_MONTH_RE})\\.?,?\\s+(\\d{4})(?![0-9])`, 'gi');
  while ((m = named2.exec(line))) add(sheetIso(Number(m[3]), SHEET_MONTHS[m[2].slice(0, 3).toLowerCase()], Number(m[1])), m.index, m.index + m[0].length);
  return found;
}

// The words that belong to a date: after the last blank to fill in ("Date: ____  10/09/2026" is a stamp, not the answer) or column line
const sheetDateWindow = (before) => { const parts = before.split(/_{2,}|\||\t/); return parts[parts.length - 1]; };

// How much a label in front of a date says it is the day the work was done
function sheetDateScore(before) {
  const b = sheetDateWindow(before).toLowerCase();
  let s = 0;
  if (/(actual|complet|confirm|perform|execut|done|closed|cleaned|sanitized)/.test(b)) s += 4;
  else if (/(finish|\bend)/.test(b)) s += 2;
  else if (/\bdate\b/.test(b)) s += 1;
  if (/(basic|schedul|plan|due|target|request|latest|earliest)/.test(b)) s -= 2;
  if (/(start|begin)/.test(b)) s -= /(finish|\bend|complet|done|closed)/.test(b) ? 1 : 3; // "Actual start" is not the day it was finished
  if (/(print|creat|enter|chang|issued|generat|releas|revis|\brev\b|\blast\b|previous|prior|\bnext\b|expir|renew|expected|forecast)/.test(b)) s -= 3;
  return s;
}

// "3.5", "3,5" and "3.500" are hours; "1,250" has a thousand separator (far too many hours), and anything else is not a number
const sheetNumber = (t) => {
  const m = /^(\d{1,3})(?:([.,])(\d{1,3}))?$/.exec(t);
  if (!m || (m[2] === ',' && m[3].length === 3)) return NaN;
  return Number(m[3] ? `${m[1]}.${m[3]}` : m[1]);
};
const round2 = (v) => Math.round(v * 100) / 100;
const HOUR_UNIT = /^(?:hours?|hrs?|h|std)$/i;
const MINUTE_UNIT = /^(?:mins?|minutes?)$/i;

// The hours written right after a label such as "Actual work:" (only spaces, colons and dots in between, so it is that field's
// number). Understands 3.5 H, 3.500 H, 30 min, 1 h 30 min, 03:30 and 06:00 - 09:30. A number that is cut, has noise in it or has an
// unknown unit after it (3.S H, 2 5 H, 30 MlN) is not read: a wrong hours figure is worse than an empty box.
// Resolves { value, unit (true when the sheet wrote one) } or null
function sheetHoursAfter(rest, labelText) {
  const text = rest.replace(/\.{2,}/g, ' ');
  const at = /^[\s:=_\-]{0,12}/.exec(text)[0].length;
  const body = text.slice(at);
  let m = /^(\d{1,2}):(\d{2})\s*(?:-|to)\s*(\d{1,2}):(\d{2})(?![\d:])/i.exec(body);
  if (m) { const v = ((Number(m[3]) * 60 + Number(m[4])) - (Number(m[1]) * 60 + Number(m[2])) + 1440) % 1440 / 60; return v > 0 ? { value: round2(v), unit: true } : null; }
  m = /^(\d{1,2})\s*(?:h|hrs?|hours?)\s*(\d{1,2})\s*(?:mins?|minutes?|m)(?![A-Za-z0-9])/i.exec(body);
  if (m) return { value: round2(Number(m[1]) + Number(m[2]) / 60), unit: true };
  m = /^(\d{1,2}):(\d{2})(?![\d:A-Za-z])/.exec(body);
  if (m) return /hou?rs?|hrs?|duration|spent|taken|worked|labou?r|work/i.test(labelText) ? { value: round2(Number(m[1]) + Number(m[2]) / 60), unit: true } : null; // 06:00 after "Actual time" is a clock time
  m = /^\d+(?:[.,]\d+)*/.exec(body);
  if (!m) return null;
  const n = sheetNumber(m[0]);
  if (!(n >= 0)) return null;
  const after = body.slice(m[0].length);
  const next = /^\s*(.?)/.exec(after)[1];
  if (/[0-9:]/.test(next)) return null;                                    // 2 5 H, 1 :30
  if (/^\s*[.,]\S/.test(after)) return null;                               // 3.S H, 1 .5 H
  const word = /^\s*([A-Za-z]+)(?![A-Za-z0-9])/.exec(after);
  if (word) {
    if (HOUR_UNIT.test(word[1])) return { value: round2(n), unit: true };
    if (MINUTE_UNIT.test(word[1])) return { value: round2(n / 60), unit: true };
    return null;                                                           // 1 day, 10 USD, 30 MlN
  }
  if (/[A-Za-z0-9]/.test(next)) return null;
  return { value: round2(n), unit: false };
}

function sheetHoursIn(line) {
  const found = [];
  const label = /(?:(?:actual|act\.?)\s*(?:work|labou?r|hours?|hrs?|time|duration)|(?:work|labou?r)\s*(?:actual|hours?)|hours?\s*(?:worked|spent|actual|taken)|time\s*(?:spent|taken)|total\s*(?:hours?|hrs?|time|work)|duration|hrs?\.?\s*worked|man\s*hours?)/ig;
  const plannedRe = /plan|estimat|target|budget|standard|expected|forecast|required|scheduled|remaining/i;
  let m;
  while ((m = label.exec(line))) {
    const head = line.slice(0, m.index + m[0].length);
    const got = sheetHoursAfter(line.slice(m.index + m[0].length, m.index + m[0].length + 40), m[0]);
    if (!got) continue;
    const planned = plannedRe.test(head);
    // Without a unit the number can be anything (an operation number): it needs a label that says hours
    const certain = got.unit || /hou?rs?|hrs?/i.test(m[0]);
    found.push({ value: got.value, score: planned ? 1 : certain ? 5 : 3, labeled: !planned && certain, total: /^total/i.test(m[0]) });
  }
  const unit = /(?:^|[^0-9A-Za-z.,:])(\d{1,3}(?:[.,]\d{1,3})?)\s*(hours?|hrs?|h|std)(?![A-Za-z0-9])/ig;
  while ((m = unit.exec(line))) {
    const n = sheetNumber(m[1]);
    if (!(n >= 0)) continue;
    const value = round2(n);
    if (!found.some(f => f.value === value)) found.push({ value, score: plannedRe.test(line) ? 0 : 2, labeled: false, total: false });
  }
  return found.filter(f => f.value > 0 && f.value <= 200);
}

// Initials after a label: "Initials: EL/LH", "Completed by EL, LH", "Done by Erica Lopez" (names become initials)
function sheetInitialsIn(line) {
  const out = [];
  const label = /(?:initials?|completed\s*by|done\s*by|performed\s*by|cleaned\s*by|sanitized\s*by|technician|operator|signed(?:\s*by)?|signature|entered\s*by|employee|worker)\s*[:\-]?\s*([^\n]{1,40})/ig;
  let m;
  while ((m = label.exec(line))) {
    const tail = m[1].replace(/[_.]{2,}/g, ' ').replace(/\s+[A-Za-z]+\s*:.*$/, '').trim(); // up to the next label ("Signature:")
    if (!tail || /^(n\/?a|none|no|yes|date|time|\d)/i.test(tail)) continue;
    const head = tail.split(/\s{3,}|\s{2,}(?=[A-Z][a-z]+:)/)[0];
    // groups of 1-4 capital letters ("EL/LH", "EL, LH", "EL & LH")
    const caps = head.replace(/\band\b/ig, '/').replace(/[,&;]+/g, '/').replace(/\s*\/\s*/g, '/').trim();
    const groups = caps.split(/[\/ ]+/).filter(Boolean);
    if (groups.length && groups.length <= 4 && groups.every(g => /^[A-Z]{1,4}$/.test(g))) {
      out.push({ value: groups.join('/'), who: '' });
      continue;
    }
    // names: the capital letters that start each name
    const names = head.split(/\s*(?:\/|,|&|\band\b)\s*/i).map(s => s.trim()).filter(Boolean);
    const initials = names.map((nm) => {
      const parts = nm.split(/\s+/).filter(w => /^[A-Z][a-z'\-]+$/.test(w));
      return parts.length >= 2 ? parts.map(w => w.charAt(0)).join('').slice(0, 4) : '';
    });
    if (names.length && names.length <= 4 && initials.every(Boolean)) out.push({ value: initials.join('/'), who: names.join(', ') });
  }
  return out;
}

// texts: the text of each page read. ctx: { today, minDate } as 'YYYY-MM-DD'.
// Resolves { orders: [{ token, score, labeled }], dates: [{ iso, words, score }], hours: [{ value, score, labeled }], hoursSum, initials: [{ value, who }] }
function extractSheet(texts, ctx) {
  const orders = new Map();
  const dates = new Map();
  const hours = new Map();
  const initials = new Map();
  const labeledHours = []; // every 'actual work' line on every page, one entry per line (the same figure on two pages is two lines)
  const label = /(?:\border\b|\bord\.?\b|\bauftrag\b|\bw\/?o\b|work\s*order|notification|task\s*list|\bplan\b|\bjob\b|\bshort\s*text\b|\bdescription\b)/i;
  (texts || []).forEach((text, pageIndex) => {
    const lines = sheetLines(text);
    lines.forEach((line, li) => {
      // Order codes: letters and digits, five or more characters, not a date, a plain number that is too short, or a heading word
      const re = /[A-Za-z0-9][A-Za-z0-9_\-]{3,22}[A-Za-z0-9]/g;
      let m;
      while ((m = re.exec(line))) {
        const raw = m[0];
        const token = raw.toUpperCase();
        if (token.length < 5 || token.length > 24) continue;
        if (/^\d+$/.test(token) && token.length < 6) continue;
        if (SHEET_WORDS.test(token)) continue;
        const hasDigit = /\d/.test(token);
        const allCaps = raw === raw.toUpperCase() && /^[A-Z]+$/.test(token);
        if (!hasDigit && !(allCaps && token.length >= 8)) continue;
        const before = line.slice(Math.max(0, m.index - 60), m.index) + (li > 0 && !line.slice(0, m.index).trim() ? lines[li - 1].slice(-60) : '');
        const labeled = label.test(before);
        const prev = orders.get(token) || { token, score: 0, labeled: false, count: 0, first: pageIndex * 1000 + li };
        prev.count += 1;
        prev.score = Math.max(prev.score, (labeled ? 3 : 0) + (/^\d{8,12}$/.test(token) ? 1 : 0) + (hasDigit && /[A-Z]/.test(token) ? 1 : 0) + 1);
        if (labeled) prev.labeled = true;
        orders.set(token, prev);
      }
      sheetDatesIn(line, ctx).forEach((d) => {
        const score = sheetDateScore(line.slice(Math.max(0, d.at - 50), d.at)) - (d.alt ? 1 : 0) - (d.weak ? 2 : 0);
        const prev = dates.get(d.iso);
        if (!prev) dates.set(d.iso, { iso: d.iso, words: sheetDateWords(d.iso), score, amb: d.amb, alt: d.alt, pair: d.pair });
        else { if (score > prev.score) prev.score = score; if (!d.amb) prev.amb = false; if (!d.alt) prev.alt = false; if (d.pair && !prev.pair) prev.pair = d.pair; }
      });
      sheetHoursIn(line).forEach((h) => {
        const prev = hours.get(h.value);
        if (!prev || h.score > prev.score) hours.set(h.value, { value: h.value, score: h.score, labeled: h.labeled || !!(prev && prev.labeled) });
        else if (h.labeled) prev.labeled = true;
        if (h.labeled) labeledHours.push(h);
      });
      sheetInitialsIn(line).forEach((x) => { if (INITIALS_RE.test(normalizeInitials(x.value)) && !initials.has(x.value)) initials.set(x.value, x); });
    });
  });
  orders.forEach((o) => { o.score += Math.min(4, o.count - 1); });
  const orderList = Array.from(orders.values()).sort((a, b) => b.score - a.score || a.first - b.first);
  const dateList = Array.from(dates.values()).sort((a, b) => b.score - a.score || (a.iso < b.iso ? 1 : -1));
  const hourList = Array.from(hours.values()).sort((a, b) => b.score - a.score || a.value - b.value);
  // Several "actual work" lines (one per operation, on one page or on several) add up to the order's hours; offered, never filled in.
  // Filled in by itself: the sheet's own "Total hours" line when there is exactly one (and the lines agree with it), or the only
  // "actual work" line on the whole sheet
  const totals = labeledHours.filter(h => h.total);
  const parts = labeledHours.filter(h => !h.total);
  const partsSum = round2(parts.reduce((t, x) => t + x.value, 0));
  let hoursSum = null;
  if (parts.length >= 2 && partsSum > 0 && partsSum <= 200) hoursSum = { value: partsSum, lines: parts.length };
  let hoursAuto = null;
  if (totals.length === 1 && (!parts.length || Math.abs(partsSum - totals[0].value) < 0.01)) hoursAuto = totals[0].value;
  else if (!totals.length && parts.length === 1) hoursAuto = parts[0].value;
  return { orders: orderList, dates: dateList, hours: hourList, hoursSum, hoursAuto, labeledCount: labeledHours.length, initials: Array.from(initials.values()) };
}

// Looks like OCR got a letter wrong: O for 0, I or L for 1, S for 5, B for 8, Z for 2, G for 6
const sheetFold = (s) => s.replace(/[OQD]/g, '0').replace(/[IL|]/g, '1').replace(/S/g, '5').replace(/B/g, '8').replace(/Z/g, '2').replace(/G/g, '6');
const sheetDistance = (a, b) => {
  if (Math.abs(a.length - b.length) > 1) return 2;
  const d = [];
  for (let i = 0; i <= a.length; i += 1) { d[i] = [i]; }
  for (let j = 1; j <= b.length; j += 1) d[0][j] = j;
  for (let i = 1; i <= a.length; i += 1) {
    for (let j = 1; j <= b.length; j += 1) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1));
  }
  return d[a.length][b.length];
};

// Which of the candidate order codes are SAP orders in the list? 'exact' is the code as read; 'close' differs by one character
// (a wrong letter, a missing end). A few small, capped lookups: the sheet's tokens are never searched all at once.
// Resolves [{ code, kind: 'exact' | 'close', from, score }] best first; .failed counts the lookups that did not answer
async function checkSheetOrders(store, tokens, memo) {
  const hits = new Map();
  let failed = 0;
  const keep = (code, kind, from, score) => {
    const old = hits.get(code);
    if (!old || (old.kind === 'close' && kind === 'exact') || (old.kind === kind && score > old.score)) hits.set(code, { code, kind, from, score });
  };
  const top = tokens.slice(0, 14);
  const rs = await pool(top, 3, async (t) => {
    let known = memo.get(t.token);
    if (!known) {
      const here = await store.sheetCodes(t.token);
      known = { exact: here.indexOf(t.token) >= 0, prefixed: here.filter(c => c !== t.token && c.indexOf(t.token) === 0 && c.length - t.token.length <= 2).slice(0, 3), close: null };
      memo.set(t.token, known);
    }
    return known;
  });
  rs.forEach((r) => { if (!r.ok) failed += 1; });
  top.forEach((t, i) => {
    const known = rs[i] && rs[i].ok ? rs[i].value : null;
    if (!known) return;
    if (known.exact) keep(t.token, 'exact', t.token, t.score);
    known.prefixed.forEach(c => keep(c, 'close', t.token, t.score));
    (known.close || []).forEach(c => keep(c, 'close', t.token, t.score));
  });
  // A code with one wrong character: look for the half of it that is likely to be right
  const lost = top.filter((t, i) => rs[i] && rs[i].ok && !rs[i].value.exact && !rs[i].value.prefixed.length && rs[i].value.close === null && t.token.length >= 7 && (/\d/.test(t.token) || /^[A-Z]{8,}$/.test(t.token))).slice(0, 4);
  const rs2 = await pool(lost, 2, async (t) => {
    const known = memo.get(t.token);
    const n = t.token.length;
    const halves = [t.token.slice(0, Math.ceil(n / 2)), t.token.slice(Math.floor(n / 2))].filter(h => h.length >= 4);
    const lists = await Promise.all(halves.map(h => store.sheetCodes(h)));
    const pooled = [];
    lists.forEach(l => l.forEach(c => { if (pooled.indexOf(c) < 0) pooled.push(c); }));
    known.close = pooled.filter(c => sheetDistance(sheetFold(c), sheetFold(t.token)) <= 1).slice(0, 3);
    known.close.forEach(c => keep(c, 'close', t.token, t.score));
  });
  rs2.forEach((r) => { if (!r.ok) failed += 1; });
  const out = Array.from(hits.values()).sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'exact' ? -1 : 1) || b.score - a.score);
  out.failed = failed;
  return out;
}

// What the panel shows, and what is filled in without asking: the codes found in the SAP list first, then close ones, then
// order numbers that are not in the list; one date, hours and initials suggestion list
function sheetView(found, checked) {
  const used = {};
  const orders = [];
  checked.forEach((h) => { used[h.from] = true; used[h.code] = true; orders.push({ code: h.code, kind: h.kind, from: h.from, score: h.score }); });
  found.orders.forEach((o) => {
    if (used[o.token] || orders.filter(x => x.kind === 'unchecked').length >= 4) return;
    if (o.labeled || /^\d{8,12}$/.test(o.token)) orders.push({ code: o.token, kind: 'unchecked', from: o.token, score: o.score });
  });
  const exact = orders.filter(o => o.kind === 'exact');
  const auto = {};
  // Only a code in the SAP list that is exactly what was read. A close match is never filled in by itself: orders that differ by one
  // character (the frequency letter at the end, IBL4 and IBL5) are different orders, so it is only offered as a button
  // ...and no better-labelled order number on the sheet that is not in the list ("Order: 4000123456" beats a number elsewhere that happens to be in it)
  const rival = exact.length > 0 && found.orders.some(o => o.labeled && !used[o.token] && o.score > exact[0].score);
  if (!rival && (exact.length === 1 || (exact.length > 1 && exact[0].score >= 2 * exact[1].score))) auto.code = exact[0].code;
  // The other reading of a date (Jul 10 for 10/07) is listed only for the best date; for the rest the first reading is enough
  const d = found.dates.filter((x, i) => !x.alt || (found.dates[0] && found.dates[0].pair === x.iso));
  if (d.length && d[0].score >= 3 && (d.length === 1 || d[0].score > d[1].score)) auto.date = d[0].iso;
  if (found.hoursAuto) auto.hours = found.hoursAuto;
  return {
    orders,
    dates: d.slice(0, 5),
    hours: found.hours.slice(0, 6),
    hoursSum: found.hoursSum,
    initials: found.initials.slice(0, 4),
    auto,
    empty: !orders.length && !d.length && !found.hours.length && !found.hoursSum && !found.initials.length,
  };
}
