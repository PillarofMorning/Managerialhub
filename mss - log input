// --- POPULATE PAST COMPLETIONS TO BROKEN-DOWN CHILD ASSETS ---
const PopulatePiecesTab = ({ ctx }) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [sourceAsset, setSourceAsset] = useState(null);
  const [legacyName, setLegacyName] = useState('');
  const [legacyRoom, setLegacyRoom] = useState('');
  const [legacyArea, setLegacyArea] = useState('');
  const [childPieces, setChildPieces] = useState([]);
  const [keepParent, setKeepParent] = useState(true);
  const [busy, setBusy] = useState('');
  const [progress, setProgress] = useState('');
  const [error, setError] = useState('');
  const [foundRows, setFoundRows] = useState(null);
  const [result, setResult] = useState(null);

  const pickParent = async (a) => {
    setSourceAsset(a);
    setLegacyName(a ? a.name : '');
    setLegacyRoom(a ? a.room : '');
    setLegacyArea(a ? a.area : '');
    setFoundRows(null); setResult(null); setError('');
    if (a) {
      const sug = await suggestPieces(store, { equipment: a.name, room: a.room, area: a.area });
      if (sug && sug.assets && sug.assets.length >= 2) {
        setChildPieces(sug.assets.filter(x => x.id !== a.id));
      }
    }
  };

  const findPastCompletions = async () => {
    const name = legacyName.trim();
    if (!sourceAsset && !name) { setError('Pick a parent asset or enter the old equipment name to find past completions.'); return; }
    setBusy('find'); setError(''); setResult(null); setFoundRows(null);
    try {
      setProgress('Searching log for past completions...');
      await store.ensureAssetCatalog();
      const filters = [];
      if (sourceAsset) filters.push(guidEq('craa5_equipmentguid', sourceAsset.id));
      if (name) {
        const placeParts = [ciContains('craa5_equipment', name)];
        if (legacyRoom.trim()) placeParts.push(ciContains('craa5_room', legacyRoom.trim()));
        if (legacyArea.trim()) placeParts.push(ciContains('craa5_area', legacyArea.trim()));
        filters.push(`(${placeParts.join(' and ')})`);
      }
      const rows = await api.query(LOG_TABLE, {
        select: LOG_SELECT,
        filter: filters.join(' or '),
        orderBy: 'craa5_lastcleaned desc',
        top: 500,
      });
      const matched = rows.filter(r => (sourceAsset && cleanGuid(r.craa5_equipmentguid) === cleanGuid(sourceAsset.id)) || (name && sameText(r.craa5_equipment, name)));
      setFoundRows(matched);
      if (!childPieces.length && (sourceAsset || name)) {
        const sug = await suggestPieces(store, { equipment: name || sourceAsset.name, room: legacyRoom || (sourceAsset && sourceAsset.room) || '', area: legacyArea || (sourceAsset && sourceAsset.area) || '' });
        if (sug && sug.assets && sug.assets.length) {
          setChildPieces(sug.assets.filter(x => !sourceAsset || x.id !== sourceAsset.id));
        }
      }
    } catch (e) { setError(errText(e)); }
    finally { setBusy(''); setProgress(''); }
  };

  const populateNow = async () => {
    if (!foundRows || !foundRows.length || childPieces.length < 1) return;
    setBusy('apply'); setError(''); setResult(null);
    try {
      const jobs = foundRows.map(r => ({ id: r.craa5__log_id, pieces: childPieces }));
      setProgress(`Checking existing completions for ${childPieces.length} child asset(s)...`);
      const plan = await planSplits(api, jobs, keepParent);
      setProgress(`Populating ${plan.items.length} historical completion(s) onto ${childPieces.length} child asset(s)...`);
      const split = await runSplits(api, plan.items, (k) => setProgress(`Populating completions... ${k} of ${plan.items.length}`));
      setResult(split);
      ctx.dataChanged();
    } catch (e) { setError(errText(e)); }
    finally { setBusy(''); setProgress(''); }
  };

  return (
    <div>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        When a large asset is broken down into smaller child assets, use this tool to populate past completions from the parent/old equipment onto the new smaller child assets so Shift Start and Ganttly immediately know when each child piece was last cleaned.
      </Text>
      <div className={styles.filterBar} style={{ alignItems: 'flex-end' }}>
        <div style={{ minWidth: 300, flex: 1 }}>
          <Text size={200} weight="semibold" block>1. Pick parent / old asset (or type legacy name on the right)</Text>
          <AssetPicker store={store} idTails ariaLabel="Pick parent equipment" placeholder="Search current assets for parent equipment..." disabled={!!busy} onPick={pickParent} />
        </div>
        <div>
          <Text size={200} weight="semibold" block>Legacy Equipment Name</Text>
          <Input aria-label="Legacy equipment name" placeholder="e.g. Spiral Freezer" value={legacyName} disabled={!!busy} onChange={(e, d) => setLegacyName(d.value)} />
        </div>
        <div>
          <Text size={200} weight="semibold" block>Room (optional)</Text>
          <Input aria-label="Legacy room" placeholder="Room" value={legacyRoom} disabled={!!busy} onChange={(e, d) => setLegacyRoom(d.value)} />
        </div>
        <div>
          <Text size={200} weight="semibold" block>Area (optional)</Text>
          <Input aria-label="Legacy area" placeholder="Area" value={legacyArea} disabled={!!busy} onChange={(e, d) => setLegacyArea(d.value)} />
        </div>
        <Button appearance="primary" className={styles.btnPrimary} disabled={!!busy} onClick={findPastCompletions}>
          {busy === 'find' ? 'Searching...' : 'Find Past Completions'}
        </Button>
      </div>
      <div style={{ marginTop: 10, padding: 10, border: `1px solid ${BRAND.line}`, borderRadius: 6, backgroundColor: '#FAFBFD' }}>
        <Text weight="semibold" block>2. Target Smaller Child Assets (current assets pull)</Text>
        <PiecesEditor
          store={store}
          g={{ equipment: legacyName || (sourceAsset && sourceAsset.name) || 'parent asset', room: legacyRoom || (sourceAsset && sourceAsset.room) || '', area: legacyArea || (sourceAsset && sourceAsset.area) || '' }}
          list={childPieces}
          disabled={!!busy}
          onChange={(next) => setChildPieces(next || [])}
        />
        <div style={{ marginTop: 8, display: 'flex', gap: 12, alignItems: 'center', flexWrap: 'wrap' }}>
          <Checkbox
            label="Keep original parent completion entries and copy completions to child pieces (recommended when keeping parent history)"
            checked={keepParent}
            disabled={!!busy}
            onChange={(e, d) => setKeepParent(!!d.checked)}
          />
          {foundRows && (
            <Button appearance="primary" className={styles.btnCta} disabled={!!busy || !foundRows.length || (keepParent ? childPieces.length < 1 : childPieces.length < 2)} onClick={populateNow}>
              {busy === 'apply' ? 'Populating...' : `Populate ${foundRows.length} past completion(s) to ${childPieces.length} child asset(s)`}
            </Button>
          )}
        </div>
      </div>
      <div aria-live="polite" style={{ marginTop: 8 }}>
        {progress && <Text className={styles.hint} block>{progress}</Text>}
        {error && <Text className={styles.errorText} block role="alert">{error}</Text>}
        {foundRows && <Text className={styles.hint} block>Found <strong>{foundRows.length}</strong> historical completion entries for <strong>{legacyName || (sourceAsset && sourceAsset.name)}</strong>.</Text>}
        {result && <Text className={result.failedRows ? styles.errorText : styles.okText} block>{splitSummary(result)} {splitNotes(result)}</Text>}
      </div>
    </div>
  );
};

