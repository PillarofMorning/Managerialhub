  const [photoMime, setPhotoMime] = useState('image/jpeg'); // image/jpeg for a picture, application/pdf for a PDF or several pages
  const [photoPages, setPhotoPages] = useState(0);
  const [paperFiles, setPaperFiles] = useState([]);   // the files picked for the paperwork, in page order
  const [sheet, setSheet] = useState({ status: 'idle' }); // what reading the paperwork found: { status, view, applied, ... }
  const [sheetAuto, setSheetAuto] = useState(sheetAuto0); // read the sheet as soon as paperwork is added
  const [stamp, setStamp] = useState({});             // field -> the value that came from the sheet (marked "from the sheet" while it stays)
  const [previewOpen, setPreviewOpen] = useState(false);
  const [sheetHidden, setSheetHidden] = useState(false);
  const previewEntry = useMemo(() => ({ equipment: 'Paperwork to attach', sap: normCode(code), date: dateStr }), [code, dateStr]);
  const previewLocal = useMemo(() => (photo ? { name: `paperwork.${photoMime === 'application/pdf' ? 'pdf' : 'jpg'}`, mime: photoMime, data: photo } : null), [photo, photoMime]);
  const [excluded, setExcluded] = useState({});
  const [chosen, setChosen] = useState({});          // lineKey -> equipment picked instead of the automatic one
  const [hoursOverride, setHoursOverride] = useState({}); // lineKey -> hours as typed
  const [editMode, setEditMode] = useState(false);
  const [edits, setEdits] = useState({});            // lineKey -> { id, name, room, area } for the equipment with that id
  const [dupes, setDupes] = useState(new Set());
  const [extras, setExtras] = useState([]);
  const [addOpen, setAddOpen] = useState(null); // null: open only for an order that is not in the SAP list
  const [linesOpen, setLinesOpen] = useState(true);
  const [addMode, setAddMode] = useState('search');
  const [addFreq, setAddFreq] = useState('craa5_sapw');
  const [newRoom, setNewRoom] = useState('');
  const [newArea, setNewArea] = useState('');
  const [newName, setNewName] = useState('');
  const [typing, setTyping] = useState({ room: '', area: '', roomCtx: '' });
  const [note, setNote] = useState('');
  const noteRef = useRef(null);
  // A new note can land below the visible part of a long order (the lines box scrolls on its own): bring it into view
  useEffect(() => {
    if (!note || !noteRef.current || !noteRef.current.scrollIntoView) return;
    try { noteRef.current.scrollIntoView({ block: 'nearest' }); } catch (_) { /* nothing to scroll */ }
  }, [note]);
  const [panel, setPanel] = useState({});            // lineKey -> 'list' | 'search' | 'new' while its Change panel is open
  const [moreRank, setMoreRank] = useState({});      // lineKey -> { busy, ranked, error } (similar names looked up on demand)
  const [newFor, setNewFor] = useState({});          // lineKey -> { name, room, area } typed for "Create new asset"
  const [retro, setRetro] = useState({});            // lineKey -> { status, count, more, from, stillUsed, filter, apply, error }
  const [pieces, setPieces] = useState({});          // lineKey -> the equipment its SAP row is broken up into (a key here means break up is on)
  const [hints, setHints] = useState({});            // lineKey -> { status, found, error } pieces looked for when break up was started
  const [splitOpen, setSplitOpen] = useState({});    // lineKey -> true while its pieces are being edited
  const seq = useRef(0);
  const orderGen = useRef(0);
  const piecesRef = useRef(pieces);                  // read by lookups that finish later, to see whether the line was broken up meanwhile
  piecesRef.current = pieces;
  const wrapRef = useRef(null);                      // the lines box, to move the focus into a pieces editor that was just opened
  const focusTo = useRef('');                        // selector (inside the lines box) of the control that takes the focus after the next render
  const photoSeq = useRef(0);
  const readSeq = useRef(0);                         // a reading is stale when this has moved on (stopped, new paperwork, row removed)
  const pageCache = useRef(new Map());               // file -> its pages as JPEGs (when pages are joined into a PDF)
  const readMemo = useRef(new Map());                // file -> its text, already read
  const orderMemo = useRef(new Map());               // order code read off a sheet -> what the SAP list said about it
  const dateTouched = useRef(false);                 // the admin chose the date: the sheet does not change it by itself
  const latest = useRef({});                         // the form values now, for a reading that finishes later
  const retroSeq = useRef({});
  const listRef = useRef(null);

  const normalizedCode = normCode(code);
  const ready = !!order && order.status === 'ready' && order.code === normalizedCode;
  const matches = useMemo(() => (ready ? order.entries : []), [ready, order]);
  const listId = `sap-list-${index}`;

  // Order suggestions: debounced server search, only while the box is open
  useEffect(() => {
    if (!showSuggest || normalizedCode.length < 2) { setSugg(s => (s.items.length || s.busy || s.error ? { items: [], truncated: false, busy: false, error: '' } : s)); return undefined; }
    let live = true;
    setSugg(s => ({ ...s, busy: true }));
    const t = setTimeout(async () => {
      try { const r = await store.searchOrders(normalizedCode); if (live) setSugg({ items: r.items, truncated: r.truncated, busy: false, error: '' }); }
      catch (e) { if (live) setSugg({ items: [], truncated: false, busy: false, error: errText(e) }); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, showSuggest, store]);

  // Load the typed/selected order (exact, not case sensitive) once typing pauses
  useEffect(() => {
    if (normalizedCode.length < 3) { setOrder(null); return undefined; }
    let live = true;
    // Reloading the same order (after a Fix tab change) keeps its lines on screen until the new ones arrive
    setOrder(o => (o && o.status === 'ready' && o.code === normalizedCode ? { ...o, refreshing: true } : { status: 'loading', code: normalizedCode, entries: [] }));
    const t = setTimeout(async () => {
      try { const r = await store.loadOrder(normalizedCode); if (live) setOrder({ status: 'ready', ...r }); }
      catch (e) { if (live) setOrder({ status: 'error', code: normalizedCode, entries: [], error: errText(e) }); }
    }, 350);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, store, dataVer]); // dataVer: IDs were repaired or unified on the Fix tab, so best fits are worked out again

  // Only suggestions that fit what is typed now are shown or picked (results for an earlier prefix are dropped)
  const suggestions = useMemo(() => sugg.items.filter(x => x.code.includes(normalizedCode)), [sugg.items, normalizedCode]);
  const suggestOpen = showSuggest && normalizedCode.length >= 2 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode && !sugg.busy);
  const listOpen = suggestOpen && suggestions.length > 0;
  const hiIndex = Math.min(hi, Math.max(0, suggestions.length - 1));

  useEffect(() => {
    const el = listRef.current && listRef.current.querySelector('[aria-selected="true"]');
    if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
  }, [hi, suggestions.length]);

  // Include ticks, typed hours and edits made on the pieces of a row go with the pieces: a piece added again starts fresh
  const dropPieceState = (isPiece) => {
    const drop = (p) => { const x = {}; Object.keys(p).forEach((k) => { if (!isPiece(k)) x[k] = p[k]; }); return x; };
    setExcluded(drop); setHoursOverride(drop); setEdits(drop);
  };
  // Manual picks and earlier-entry scans; orderGen makes any lookup still running for them stale
  const resetPicks = () => {
    orderGen.current += 1;
    setChosen({}); setPanel({}); setMoreRank({}); setRetro({}); setPieces({}); setHints({}); setSplitOpen({});
    dropPieceState(k => k.indexOf('~') >= 0);
    retroSeq.current = {};
  };
  const clearOrderState = () => {
    resetPicks();
    setExcluded({}); setHoursOverride({}); setExtras([]); setEdits({});
    setAddOpen(null); setLinesOpen(true); setEditMode(false); setNote(''); setNewFor({});
  };
  const selectCode = (c) => { setCode(c); setShowSuggest(false); clearOrderState(); };
  // IDs changed on the Fix tab: picks made by hand may point at equipment that was just unified away, so they are dropped
  const seenVer = useRef(dataVer);
  useEffect(() => {
    if (seenVer.current === dataVer) return;
    seenVer.current = dataVer;
    if (Object.keys(chosen).length || Object.keys(retro).length || Object.keys(pieces).length) {
      resetPicks();
      setNote('Equipment IDs were changed on the Fix tab, so the equipment for this order was worked out again. Check the lines and use Change or Break up again if needed.');
    } else if (Object.keys(hints).length) {
      orderGen.current += 1; // pieces looked for earlier were worked out from the old IDs (and a lookup still running is stale)
      setHints({});
    }
  }, [dataVer]); // eslint-disable-line react-hooks/exhaustive-deps

  // Lines: one per equipment on the order
  const lines = useMemo(() => {
    const seen = new Set();
    const out = [];
    // Equipment another row of the order holds (a line, a piece, or kept for a row broken up): a row that is only the same equipment
    // listed again folds into it, and comes back as a line of its own if that row is changed to other equipment
    const held = new Set();
    matches.forEach((e) => {
      (pieces[e.key] || []).forEach((a) => { held.add(a.id); });
