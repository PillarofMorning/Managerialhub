      const e = matches.find(m => m.key === key);
      const back = e && (chosen[key] || e.asset);
      if (editMode && back && !back.isNew) setEdits(p => (p[key] && p[key].id === back.id ? p : { ...p, [key]: { id: back.id, name: back.name, room: back.room, area: back.area } }));
