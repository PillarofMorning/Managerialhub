const safeString = (v) => (v === null || v === undefined ? '' : String(v).trim());
const normCode = (s) => safeString(s).toUpperCase().replace(/\s+/g, '');
const normName = (s) => safeString(s).toLowerCase().replace(/[^a-z0-9]/g, '');
