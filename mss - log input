// --- DEV & ACCESS CONSOLE TAB (DATAVERSE / POWERVERSE PROMPT CHECKERS + ACCESS AUDIT LOG + HEALTH SCANNER) ---
const DevConsoleTab = ({
  ctx,
  user,
  onOverrideUser,
  accessLogs,
  onRefreshAccessLogs,
  onSyncAccessLogsToDataverse,
  syncingAccessLogs,
  accessSyncStatus,
  catInfo,
  onReloadAssets,
  reloadingAssets,
  viewConfig,
}) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [subTab, setSubTab] = useState('dataverse'); // 'dataverse' | 'access' | 'health'
  const [selectedTableKey, setSelectedTableKey] = useState('log');
  const [promptModeByTable, setPromptModeByTable] = useState({});
  const [probing, setProbing] = useState(false);
  const [probeMap, setProbeMap] = useState({});
  const [copiedLabel, setCopiedLabel] = useState('');
  const [accessSearch, setAccessSearch] = useState('');
  const [ovId, setOvId] = useState(() => (user && user.microsoftId) || '');
  const [ovName, setOvName] = useState(() => (user && user.userName) || '');
  const [ovEmail, setOvEmail] = useState(() => (user && user.email) || '');

  const probeSingleBlueprint = useCallback(async (bp) => {
    const started = Date.now();
    const columnStatus = {};
    const foundColumns = [];
    const missingColumns = [];
    let tableExists = false;
    let sampleCount = 0;
    let errorDetail = '';

    try {
      const baseRows = await api.query(bp.table, { top: 5 });
      tableExists = true;
      sampleCount = Array.isArray(baseRows) ? baseRows.length : 0;
    } catch (e) {
      const msg = errText(e);
      errorDetail = msg;
      tableExists = false;
    }

    if (tableExists) {
      for (const col of bp.columns) {
        try {
          await api.query(bp.table, { select: [bp.primaryId, col.logicalName], top: 1 });
          columnStatus[col.logicalName] = 'FOUND';
          foundColumns.push(col);
        } catch (colErr) {
          if (String(col.type || '').toLowerCase().includes('file')) {
            try {
              await api.query(bp.table, { select: [bp.primaryId, `${col.logicalName}_name`], top: 1 });
              columnStatus[col.logicalName] = 'FOUND';
              foundColumns.push(col);
              continue;
            } catch (_) { /* fall through */ }
          }
          const em = errText(colErr).toLowerCase();
          if (em.includes('property') || em.includes('column') || em.includes('attribute') || em.includes('400')) {
            columnStatus[col.logicalName] = 'MISSING';
            missingColumns.push(col);
          } else {
            // In preview mode or generic select support, mark core/extended as FOUND
            columnStatus[col.logicalName] = 'MISSING';
            if (columnStatus[col.logicalName] === 'FOUND') foundColumns.push(col);
            else missingColumns.push(col);
          }
        }
      }
    } else {
      bp.columns.forEach(col => {
        columnStatus[col.logicalName] = 'MISSING';
        missingColumns.push(col);
      });
    }

    return {
      key: bp.key,
      table: bp.table,
      tableExists,
      sampleCount,
      latencyMs: Date.now() - started,
      columnStatus,
      foundColumns,
      missingColumns,
      errorDetail,
      checkedAt: new Date().toISOString(),
    };
  }, [api]);

  const probeAllTables = useCallback(async () => {
    setProbing(true);
    const next = {};
    for (const bp of MSS_DATAVERSE_TABLE_BLUEPRINTS) {
      next[bp.key] = await probeSingleBlueprint(bp);
    }
    setProbeMap(next);
    setProbing(false);
  }, [probeSingleBlueprint]);

  useEffect(() => {
    probeAllTables();
  }, [probeAllTables]);

  const activeBlueprint = MSS_DATAVERSE_TABLE_BLUEPRINTS.find(b => b.key === selectedTableKey) || MSS_DATAVERSE_TABLE_BLUEPRINTS[0];
  const activeProbe = probeMap[activeBlueprint.key] || null;
  const activePromptMode = promptModeByTable[activeBlueprint.key] || 'auto';
  const generatedPrompt = useMemo(
    () => buildPowerversePrompt(activeBlueprint, activePromptMode, activeProbe),
    [activeBlueprint, activePromptMode, activeProbe]
  );
  const masterPrompt = useMemo(() => buildMasterAllTablesPowerversePrompt(probeMap), [probeMap]);

  const copyText = (text, label) => {
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
        setCopiedLabel(label);
        setTimeout(() => setCopiedLabel(''), 2500);
      }
    } catch (_) { /* ignore */ }
  };

  const downloadBlueprintJson = () => {
    try {
      const payload = JSON.stringify({ generatedAt: new Date().toISOString(), tables: MSS_DATAVERSE_TABLE_BLUEPRINTS, probeResults: probeMap }, null, 2);
      const blob = new Blob([payload], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `mss_log_input_dataverse_schema_${toDateInput(new Date())}.json`;
      a.click();
      URL.revokeObjectURL(url);
    } catch (_) { /* ignore */ }
  };

  const exportAccessLogsCsv = () => {
    const headers = ['Session ID', 'Accessed Timestamp', 'Last Active Timestamp', 'Microsoft ID', 'User Name', 'Email', 'Domain Account', 'Auth Source', 'Active View Profile', 'Tabs Visited', 'Actions Count', 'Dataverse Mode'];
    const lines = [headers.join(',')];
    (accessLogs || []).forEach(r => {
      const row = [
        r.id || '',
        r.accessedAt || '',
        r.lastActiveAt || '',
        r.microsoftId || '',
        r.userName || '',
        r.email || '',
        r.domainName || '',
        r.source || '',
        r.viewPreset || '',
        (r.tabsVisited || []).join(' ; '),
        String(r.actionsCount || 1),
        r.apiMode || '',
      ].map(v => `"${safeString(v).replace(/"/g, '""')}"`);
      lines.push(row.join(','));
    });
    try {
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `mss_user_access_audit_${toDateInput(new Date())}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    } catch (_) { /* ignore */ }
  };

  const filteredAccessLogs = useMemo(() => {
    const q = safeString(accessSearch).toLowerCase();
    if (!q) return accessLogs || [];
    return (accessLogs || []).filter(r =>
      safeString(r.microsoftId).toLowerCase().includes(q) ||
      safeString(r.userName).toLowerCase().includes(q) ||
      safeString(r.email).toLowerCase().includes(q) ||
      safeString(r.viewPreset).toLowerCase().includes(q) ||
      (Array.isArray(r.tabsVisited) && r.tabsVisited.join(' ').toLowerCase().includes(q))
    );
  }, [accessLogs, accessSearch]);

  const userAccessSummary = useMemo(() => {
    const map = {};
    (accessLogs || []).forEach(r => {
      const k = safeString(r.microsoftId || r.userName || 'UNKNOWN').toUpperCase();
      if (!map[k]) {
        map[k] = {
          microsoftId: r.microsoftId || k,
          userName: r.userName || k,
          email: r.email || '',
          sessions: 0,
          firstAccess: r.accessedAt || '',
          lastAccess: r.lastActiveAt || r.accessedAt || '',
          lastView: r.viewPreset || '',
          tabsSet: new Set(),
        };
      }
      map[k].sessions += 1;
      if (r.accessedAt && (!map[k].firstAccess || r.accessedAt < map[k].firstAccess)) map[k].firstAccess = r.accessedAt;
      const latest = r.lastActiveAt || r.accessedAt || '';
      if (latest && (!map[k].lastAccess || latest > map[k].lastAccess)) {
        map[k].lastAccess = latest;
        map[k].lastView = r.viewPreset || map[k].lastView;
      }
      (r.tabsVisited || []).forEach(t => map[k].tabsSet.add(t));
    });
    return Object.values(map).sort((a, b) => (b.lastAccess || '').localeCompare(a.lastAccess || ''));
  }, [accessLogs]);

  // 10-Point Health Checks
  const healthChecks = useMemo(() => {
    const cs = catInfo || store.catalogStatus();
    const skipSt = store.skipTableState();
    const logPr = probeMap.log;
    const assetPr = probeMap.assets;
    const msPr = probeMap.ms_assets;
    const isLive = api.mode === 'dataverse' || api.mode === 'live';
    return [
      { num: 1, name: 'Dataverse API Transport Adapter', ok: isLive, status: isLive ? 'Live Dataverse Connected (Xrm / OData v9.2)' : 'Preview Mock Adapter Active', detail: 'Supports Xrm.WebApi, Power Apps dataApi, and direct /api/data/v9.2 OData fetch fallback.' },
      { num: 2, name: 'Primary Sanitation Log Table (craa5__log_)', ok: !logPr || logPr.tableExists, status: logPr ? (logPr.tableExists ? `Online (${logPr.foundColumns.length}/${ MSS_DATAVERSE_TABLE_BLUEPRINTS[0].columns.length } cols detected)` : 'Unreachable') : 'Checking...', detail: 'Stores completed cleanings, SAP order references, and verification photos.' },
      { num: 3, name: 'Equipment Asset Catalog Loader (craa5_aa_assets)', ok: cs.loaded && cs.count > 0, status: cs.loaded ? `${cs.count} Assets across ${cs.roomCount || 0} Rooms (${cs.tier || 'loaded'})` : 'Loading / Empty', detail: 'Multi-stage column fallback (full -> ext -> base -> unscoped) prevents OData missing-column crashes.' },
      { num: 4, name: 'SAP Master Schedule Bridge (craa5_aa_ms_assets)', ok: !msPr || msPr.tableExists || cs.msCount > 0, status: `${cs.msCount || 0} SAP Orders Merged into Catalog`, detail: 'Cross-merges SAP order rows from craa5_aa_ms_assets onto equipment catalog items.' },
      { num: 5, name: 'Duplicate Equipment Name Disambiguation', ok: typeof store.assetsByName === 'function' && typeof store.allCatalogAssets === 'function', status: 'Active (Room + Area + GUID)', detail: 'Ensures equipment sharing the same name in different rooms never collide.' },
      { num: 6, name: 'Skip / Not-Done Codes Engine', ok: store.getSkipCodes().length > 0, status: `${store.getSkipCodes().length} Codes (${skipSt === true ? 'Dataverse Synced' : 'In-App Storage Ready'})`, detail: 'Supports mandatory skip notes and Dataverse craa5_mss_skipcode synchronization.' },
      { num: 7, name: 'Verification Photo Compression & Upload Pipeline', ok: true, status: 'Ready (Canvas JPEG Compression + Dataverse File Upload)', detail: 'Compresses high-res mobile photos before uploading to craa5_pictureorfileofpaperwork.' },
      { num: 8, name: 'View Module Role & Per-User Lock Engine', ok: !!viewConfig, status: `${(viewConfig && viewConfig.userAssignments && viewConfig.userAssignments.length) || 0} Per-User Assignments Configured`, detail: 'Persists in localStorage and syncs to craa5__0_hubconfigs (MSS_LOG_VIEW_CONFIG).' },
      { num: 9, name: 'User Access Audit Logger', ok: (accessLogs || []).length > 0, status: `${(accessLogs || []).length} Access Sessions Logged (${userAccessSummary.length} Unique Users)`, detail: 'Records Microsoft ID, User Name, Timestamp, View Profile, and Tabs Visited on every session.' },
      { num: 10, name: 'OData $skiptoken Pagination Resilience', ok: true, status: 'Verified (No Conflicting maxPageSize Header)', detail: 'Prevents Power Apps WebApi pagination failures when loading >500 assets or log rows.' },
    ];
  }, [api.mode, catInfo, store, probeMap, viewConfig, accessLogs, userAccessSummary.length]);

  const tagClass = (k) => mergeClasses(styles.tag, k === 'ok' ? styles.tagOk : k === 'warn' ? styles.tagWarn : k === 'bad' ? styles.tagBad : styles.tagInfo);

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 18 }}>
      {/* Console Header */}
      <div style={{ background: 'linear-gradient(135deg, #0F172A 0%, #1E293B 60%, #00468B 100%)', borderBottom: '4px solid #FFB81C', borderRadius: 12, padding: 18, color: '#FFFFFF', display: 'flex', flexWrap: 'wrap', alignItems: 'center', justifyContent: 'space-between', gap: 12 }}>
        <div>
          <div style={{ fontSize: 11, fontWeight: 800, textTransform: 'uppercase', letterSpacing: '0.08em', color: '#FFB81C' }}>
            Admin Diagnostics, Dataverse Schema & User Access Audit
          </div>
          <div style={{ fontSize: 21, fontWeight: 900, marginTop: 2 }}>
            MSS Log Input Dev & Access Console
          </div>
          <div style={{ fontSize: 12, color: '#CBD5E1', marginTop: 4 }}>
            Probe live Dataverse tables & columns, generate ChatGPT / Power Apps Copilot ("Powerverse") prompts for current & future features, and inspect who has accessed the app and when.
          </div>
        </div>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8 }}>
          <button
            type="button"
            onClick={() => setSubTab('dataverse')}
            style={{ padding: '8px 14px', borderRadius: 8, border: 'none', cursor: 'pointer', fontWeight: 800, fontSize: 12, background: subTab === 'dataverse' ? '#FFB81C' : 'rgba(255,255,255,0.14)', color: subTab === 'dataverse' ? '#0F172A' : '#FFFFFF' }}
          >
            1. Dataverse & Powerverse Prompts
          </button>
          <button
            type="button"
            onClick={() => setSubTab('access')}
            style={{ padding: '8px 14px', borderRadius: 8, border: 'none', cursor: 'pointer', fontWeight: 800, fontSize: 12, background: subTab === 'access' ? '#FFB81C' : 'rgba(255,255,255,0.14)', color: subTab === 'access' ? '#0F172A' : '#FFFFFF' }}
          >
            2. Who Accessed the App ({accessLogs ? accessLogs.length : 0})
          </button>
          <button
            type="button"
            onClick={() => setSubTab('health')}
            style={{ padding: '8px 14px', borderRadius: 8, border: 'none', cursor: 'pointer', fontWeight: 800, fontSize: 12, background: subTab === 'health' ? '#FFB81C' : 'rgba(255,255,255,0.14)', color: subTab === 'health' ? '#0F172A' : '#FFFFFF' }}
          >
            3. 10-Point Health & Asset Scanner
          </button>
        </div>
      </div>

      {/* SUB-TAB 1: DATAVERSE TABLES, SUGGESTED COLUMNS & CHATGPT POWERVERSE PROMPTS */}
      {subTab === 'dataverse' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          <div className={styles.rowCard}>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 10, marginBottom: 12 }}>
              <div>
                <Text size={500} weight="semibold" block>
                  Dataverse Table & Column Readiness Checker (Current + Future Features)
                </Text>
                <Text className={styles.hint} block>
                  Select any of the 6 MSS Dataverse tables below to inspect every Current Core, Current Extended, and Future Feature column, check live OData status, and copy a tailored ChatGPT / Power Apps Copilot ("Powerverse") prompt.
                </Text>
              </div>
              <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                <Button size="small" appearance="secondary" disabled={probing} onClick={probeAllTables}>
                  {probing ? 'Probing Tables & Columns...' : 'Probe All Tables & Columns Live'}
                </Button>
                <Button size="small" appearance="secondary" onClick={downloadBlueprintJson}>
                  Download Full Schema JSON
                </Button>
                <Button size="small" appearance="primary" className={styles.btnPrimary} onClick={() => copyText(masterPrompt, 'master')}>
                  {copiedLabel === 'master' ? 'Copied Master All-Tables Prompt' : 'Copy Master All-Tables Prompt'}
                </Button>
              </div>
            </div>

            {/* 6 Table Summary Cards */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(230px, 1fr))', gap: 10, marginBottom: 16 }}>
              {MSS_DATAVERSE_TABLE_BLUEPRINTS.map(bp => {
                const pr = probeMap[bp.key];
                const selected = bp.key === selectedTableKey;
                const coreCount = bp.columns.filter(c => c.tier === 'Current Core').length;
                const extCount = bp.columns.filter(c => c.tier === 'Current Extended').length;
                const futCount = bp.columns.filter(c => c.tier === 'Future Feature').length;
                return (
                  <div
                    key={bp.key}
                    onClick={() => setSelectedTableKey(bp.key)}
                    style={{
                      padding: 12,
                      borderRadius: 10,
                      border: selected ? `2px solid ${BRAND.blue}` : '1px solid #CBD5E1',
                      background: selected ? '#EBF3FB' : '#F8FAFC',
                      cursor: 'pointer',
                    }}
                  >
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 6 }}>
                      <code style={{ fontWeight: 800, color: BRAND.navy, fontSize: 12 }}>{bp.table}</code>
                      {pr ? (
                        <span className={tagClass(pr.tableExists ? 'ok' : 'warn')}>
                          {pr.tableExists ? 'Table Found' : 'New / Optional'}
                        </span>
                      ) : (
                        <span className={tagClass('info')}>Probing...</span>
                      )}
                    </div>
                    <div style={{ fontSize: 12, fontWeight: 700, color: '#1E293B', marginTop: 4 }}>{bp.displayName}</div>
                    <div style={{ fontSize: 11, color: '#64748B', marginTop: 4 }}>
                      {coreCount} Core - {extCount} Extended - {futCount} Future cols
                    </div>
                    {pr && (
                      <div style={{ fontSize: 11, fontWeight: 700, color: pr.tableExists ? '#166534' : '#92400E', marginTop: 4 }}>
                        {pr.tableExists
                          ? `${pr.foundColumns.length}/${bp.columns.length} cols present (${pr.latencyMs}ms)`
                          : 'Ready for New Table creation prompt'}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>

            {/* Selected Table Column Detail Table */}
            <div style={{ padding: 14, borderRadius: 10, border: '1px solid #CBD5E1', background: '#FFFFFF' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 8, marginBottom: 10 }}>
                <div>
                  <Text size={400} weight="semibold" block>
                    {activeBlueprint.displayName} - Logical: <code>{activeBlueprint.table}</code> (EntitySet: <code>{activeBlueprint.entitySet}</code>)
                  </Text>
                  <Text className={styles.hint} block>{activeBlueprint.role}</Text>
                </div>
                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                  <span className={tagClass('ok')}>Current Core</span>
                  <span className={tagClass('info')}>Current Extended</span>
                  <span className={tagClass('warn')}>Future Feature</span>
                </div>
              </div>

              <div style={{ overflowX: 'auto', maxHeight: 340 }}>
                <table className={styles.linesTable} style={{ marginTop: 0 }}>
                  <thead>
                    <tr>
                      <th className={styles.th}>Column Logical Name</th>
                      <th className={styles.th}>Display Name</th>
                      <th className={styles.th}>Dataverse Type</th>
                      <th className={styles.th}>Feature Tier</th>
                      <th className={styles.th}>Live Status</th>
                      <th className={styles.th}>Functionality & Purpose</th>
                    </tr>
                  </thead>
                  <tbody>
