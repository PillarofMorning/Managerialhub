    if (included.some(l => hoursOverride[l.key] !== undefined && !(parseFloat(hoursOverride[l.key]) >= 0))) return 'Every selected equipment needs hours (0 or more).';
    if (Math.abs(hoursSum - total) > 0.01) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    if (lines.some(l => !l.splitting && retro[l.key] && retro[l.key].status === 'scanning')) return 'Still checking earlier entries for a changed line. Try again in a moment.';
