    if (auto.date && !dateTouched.current && auto.date !== cur.dateStr) { setDateStr(auto.date); applied.push(`date ${sheetDateWords(auto.date)}`); marks.date = auto.date; }
    if (auto.hours && !String(cur.totalHours).trim()) { setTotalHours(String(auto.hours)); applied.push(`${auto.hours} hours`); marks.hours = auto.hours; }
