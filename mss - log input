// --- EQUIPMENT PICKER: server search as you type, small result list ---
const AssetPicker = ({ store, onPick, inUse, initialQuery = '', ariaLabel = 'Search equipment', actionLabel = 'Add', placeholder = 'Start typing a name, room or area…', disabled = false, autoFocus = false, idTails = false }) => {
  const styles = useStyles();
  const [q, setQ] = useState(initialQuery);
  const [res, setRes] = useState([]);
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState('');

  useEffect(() => {
    if (q.trim().length < 2) { setRes([]); setErr(''); setBusy(false); return undefined; }
    let live = true;
    setBusy(true);
    const t = setTimeout(async () => {
      try { const r = await store.searchAssets(q); if (live) { setRes(r); setErr(''); } }
      catch (e) { if (live) setErr(errText(e)); }
      finally { if (live) setBusy(false); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [q, store]);

  // Equipment that cannot be used now (it is on another line, or already a piece) stays in the list with the reason, so it is never
  // mistaken for equipment the search could not find; usable equipment comes first
  const why = (a) => (inUse ? inUse(a) : '');
  const shown = res.filter(a => !why(a)).concat(res.filter(a => !!why(a)));
  // Records that look the same (same name, room and area) show the end of their ID, so the right one can be picked
  const looks = (a) => normName(`${a.name}|${placeText(a)}`);
  const twins = new Map();
  if (idTails) res.forEach(a => twins.set(looks(a), (twins.get(looks(a)) || 0) + 1));
  return (
    <div>
      <div className={styles.field} style={{ maxWidth: 420 }}>
        <Input aria-label={ariaLabel} autoComplete="off" autoFocus={autoFocus} placeholder={placeholder} value={q} onChange={(e, d) => setQ(d.value)} />
      </div>
      <div aria-live="polite">
        {busy && <Text className={styles.hint} block style={{ marginTop: 6 }}>Searching…</Text>}
        {err && <Text className={styles.errorText} block role="alert">Search failed: {err}</Text>}
        {!busy && !err && q.trim().length >= 2 && shown.length === 0 && <Text className={styles.hint} block style={{ marginTop: 6 }}>No matching equipment.</Text>}
      </div>
      {shown.length > 0 && (
        <div>
          <div className={styles.pickList}>
            <table className={styles.linesTable} style={{ marginTop: 0 }}>
              <tbody>
                {shown.map(a => (
                  <tr key={a.id}>
                    <td className={styles.td}><strong>{a.name}</strong>{twins.get(looks(a)) > 1 && <span className={styles.hint}> · ID …{shortId(a.id)}</span>}{why(a) && <span className={styles.hint}> · {why(a)}</span>}</td><td className={styles.td}>{a.room}</td><td className={styles.td}>{a.area}</td>
                    <td className={styles.td} style={{ textAlign: 'right' }}>
                      <Button size="small" appearance="primary" className={styles.btnPrimary} disabled={disabled || !!why(a)} aria-label={`${actionLabel} ${a.name} (${placeText(a)})${twins.get(looks(a)) > 1 ? ` ID …${shortId(a.id)}` : ''}`} onClick={() => onPick(a)}>{actionLabel}</Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {res.length >= LIMITS.assetSearch && <Text className={styles.hint} block style={{ marginTop: 4 }}>Showing the first {LIMITS.assetSearch}. Type more to narrow it down.</Text>}
        </div>
      )}
    </div>
  );
};

// Room / area suggestions while typing (server search, cached)
const useSuggest = (store, col, text, ctxRoom) => {
  const [opts, setOpts] = useState([]);
  useEffect(() => {
    const t = safeString(text);
    if (t.length < 2) { setOpts([]); return undefined; }
    let live = true;
    const h = setTimeout(() => { store.suggestField(col, t, ctxRoom).then(v => { if (live) setOpts(v); }).catch(() => {}); }, 250);
    return () => { live = false; clearTimeout(h); };
  }, [store, col, text, ctxRoom]);
  return opts;
};

// Status chip of an order line: [text, style key]
const lineStatus = (l, dupe) => {
  if (dupe) return ['already logged', 'warn'];
  if (l.splitting) return ['add pieces', 'warn'];
  if (l.parent) return [`piece ${l.piece} of ${l.pieceCount}`, 'info'];
  if (!l.asset) return ['needs equipment', 'warn'];
  if (l.how === 'linked') return ['linked', 'ok'];
  if (l.how === 'best fit') return [`best fit · ${TIER_LABEL[l.tier] || ''}${l.ambiguous ? ' · check' : ''}`, l.tier === 'high' && !l.ambiguous ? 'ok' : 'warn'];
  if (['changed', 'chosen', 'new asset', 'new equipment', 'added'].includes(l.how)) return [l.how, 'info'];
  return [l.how || 'ready', 'ok'];
};

