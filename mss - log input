  };
  // Find the earlier entries a change would correct (counted now, moved on submit)
  const scanRetro = async (l, to) => {
    const from = l.auto && !l.auto.isNew ? l.auto : null;
    const n = (retroSeq.current[l.key] || 0) + 1;
    retroSeq.current[l.key] = n;
    if (from && to && !to.isNew && from.id === to.id) { setRetro(p => { const x = { ...p }; delete x[l.key]; return x; }); return; }
    // Only a line that still has its automatic equipment keeps the old ID's entries; a changed line brings its own
    const stillUsed = !!from && lines.some(x => x.key !== l.key && !chosen[x.key] && x.asset && x.asset.id === from.id);
    const filter = retroFilter(normalizedCode, from, l.ms, stillUsed);
