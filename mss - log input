// Xrm.WebApi appends the options string to the URL as is, so text typed into a filter (& # + %) must be percent-encoded inside its quotes.
const encodeFilterText = (filter) => filter.replace(/'(?:[^']|'')*'/g, (lit) => `'${encodeURIComponent(lit.slice(1, -1))}'`);
const rowsOf = (res) => (Array.isArray(res) ? res : (res && (res.rows || res.value || res.entities)) || []);

// Xrm.WebApi (the page's own, or the hosting form's) or a webAPI handed in through props
const findWebApi = (props) => {
  const pick = (x) => (x && x.WebApi && x.WebApi.retrieveMultipleRecords ? x.WebApi : null);
  if (typeof window !== 'undefined') {
    for (const get of [() => window.Xrm, () => window.parent.Xrm, () => window.top.Xrm]) {
      try { const w = pick(get()); if (w) return w; } catch (_) { /* a cross-origin parent */ }
    }
  }
  const c = props && ((props.context && props.context.webAPI) || props.webAPI);
  return c && c.retrieveMultipleRecords ? c : null;
};

// --- FILE UPLOAD (File columns) ---
const findXrm = () => {
  const ok = (x) => (x && x.WebApi ? x : null);
  try { if (typeof Xrm !== 'undefined' && ok(Xrm)) return Xrm; } catch (_) { /* no global Xrm */ } // eslint-disable-line no-undef
  if (typeof window !== 'undefined') {
    for (const get of [() => window.Xrm, () => window.parent.Xrm, () => window.top.Xrm]) {
      try { const x = ok(get()); if (x) return x; } catch (_) { /* a cross-origin parent */ }
    }
  }
  return null;
};

const base64ToBytes = (b64) => {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i += 1) out[i] = bin.charCodeAt(i);
  return out;
};

// Xrm.WebApi.online.execute reads getMetadata from the request's prototype
const xrmAction = (name, params, types) => {
  const Req = function Req() {};
  Req.prototype.getMetadata = () => ({ boundParameter: null, parameterTypes: types, operationType: 0, operationName: name });
  const req = new Req();
  Object.keys(params).forEach((k) => { req[k] = params[k]; });
  return req;
};
const EDM_STRING = { typeName: 'Edm.String', structuralProperty: 1 };
const BLOCK_CHARS = 4 * 1024 * 1024; // base64 characters per block: 3 MB of file, under the 4 MB block limit
const readJson = async (res) => {
  if (!res) return {};
  if (typeof res.json === 'function') return (await res.json()) || {};
  return res.json ? (await res.json) || {} : res;
};

// The hosting app's own Xrm: InitializeFileBlocksUpload, one UploadBlock per 3 MB, CommitFileBlocksUpload
const uploadByBlocks = async (xrm, table, id, column, b64, fileName, mime) => {
  const exec = (req) => xrm.WebApi.online.execute(req);
  const init = await readJson(await exec(xrmAction('InitializeFileBlocksUpload',
    { Target: { '@odata.type': `Microsoft.Dynamics.CRM.${table}`, [ID_COL[table]]: id }, FileAttributeName: column, FileName: fileName },
    { Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 }, FileAttributeName: EDM_STRING, FileName: EDM_STRING })));
  const token = init.FileContinuationToken;
  if (!token) throw new Error('Dataverse did not start the file upload.');
  const blocks = [];
  for (let i = 0; i * BLOCK_CHARS < b64.length; i += 1) {
    const blockId = btoa(`block-${String(i).padStart(6, '0')}`); // every block id has the same length
    await exec(xrmAction('UploadBlock', { BlockId: blockId, BlockData: b64.slice(i * BLOCK_CHARS, (i + 1) * BLOCK_CHARS), FileContinuationToken: token },
      { BlockId: EDM_STRING, BlockData: { typeName: 'Edm.Binary', structuralProperty: 1 }, FileContinuationToken: EDM_STRING }));
    blocks.push(blockId);
  }
  await exec(xrmAction('CommitFileBlocksUpload', { FileName: fileName, MimeType: mime, BlockList: blocks, FileContinuationToken: token },
    { FileName: EDM_STRING, MimeType: EDM_STRING, BlockList: { typeName: 'Collection(Edm.String)', structuralProperty: 4 }, FileContinuationToken: EDM_STRING }));
};

// The Web API directly: one PATCH with the file's bytes (same site as the app)
const uploadByPatch = async (xrm, table, id, column, b64, fileName) => {
  let base = '';
  try { base = xrm && xrm.Utility && xrm.Utility.getGlobalContext ? safeString(xrm.Utility.getGlobalContext().getClientUrl()) : ''; } catch (_) { /* use this site */ }
  const res = await fetch(`${base.replace(/\/+$/, '')}/api/data/v9.2/${ENTITY_SET[table]}(${id})/${column}`, {
    method: 'PATCH',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/octet-stream', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0', Accept: 'application/json', 'x-ms-file-name': fileName },
    body: base64ToBytes(b64),
  });
  if (!res.ok) {
    let msg = '';
    try { const j = await res.json(); msg = j && j.error && j.error.message; } catch (_) { /* no JSON body */ }
    throw new Error(msg || `the server answered ${res.status}`);
  }
};

const uploadFileColumn = async (table, id, column, b64, fileName, mime) => {
  const xrm = findXrm();
  const errors = [];
  if (xrm && xrm.WebApi.online && typeof xrm.WebApi.online.execute === 'function') {
    try { await uploadByBlocks(xrm, table, id, column, b64, fileName, mime); return; } catch (e) { errors.push(errText(e)); }
  }
  if (typeof fetch === 'function') {
    try { await uploadByPatch(xrm, table, id, column, b64, fileName); return; } catch (e) { errors.push(errText(e)); }
  }
  throw new Error(errors.length ? Array.from(new Set(errors)).join('; ') : 'this app has no way to upload files');
};

const bytesToBase64 = (bytes) => {
  let s = '';
  for (let i = 0; i < bytes.length; i += 8192) s += String.fromCharCode.apply(null, Array.prototype.slice.call(bytes.subarray(i, i + 8192)));
  return btoa(s);
};
const EDM_INT64 = { typeName: 'Edm.Int64', structuralProperty: 1 };
const MIME_BY_EXT = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', pdf: 'application/pdf' };
const mimeOf = (name) => MIME_BY_EXT[safeString(name).toLowerCase().split('.').pop()] || 'application/octet-stream';
// The file's own first bytes say what it is, whatever its name
const sniffMime = (b64) => {
  let h = '';
  try { h = atob(safeString(b64).slice(0, 16)); } catch (_) { return ''; }
  const at = (i) => h.charCodeAt(i);
  if (at(0) === 0xFF && at(1) === 0xD8 && at(2) === 0xFF) return 'image/jpeg';
  if (at(0) === 0x89 && h.slice(1, 4) === 'PNG') return 'image/png';
  if (h.slice(0, 4) === 'GIF8') return 'image/gif';
  if (h.slice(0, 4) === 'RIFF' && h.slice(8, 12) === 'WEBP') return 'image/webp';
  if (h.slice(0, 2) === 'BM') return 'image/bmp';
  if (h.slice(0, 4) === '%PDF') return 'application/pdf';
  return '';
};
const fileMime = (f, name) => sniffMime(f.data) || (/^[a-z]+\/[\w.+-]+$/i.test(safeString(f.mime)) && f.mime !== 'application/octet-stream' ? f.mime : '') || mimeOf(name || f.name);

// Download through the hosting app's Xrm: InitializeFileBlocksDownload, then DownloadBlock until the whole file is read
const downloadByBlocks = async (xrm, table, id, column) => {
  const exec = (req) => xrm.WebApi.online.execute(req);
  const init = await readJson(await exec(xrmAction('InitializeFileBlocksDownload',
    { Target: { '@odata.type': `Microsoft.Dynamics.CRM.${table}`, [ID_COL[table]]: id }, FileAttributeName: column },
    { Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 }, FileAttributeName: EDM_STRING })));
  const size = Number(init.FileSizeInBytes) || 0;
  if (!init.FileContinuationToken || !size) throw new Error('no file is attached');
  const block = init.IsChunkingSupported === false ? size : 4 * 1024 * 1024;
  // Each block is base64 of its own bytes, so the bytes are joined, not the strings
  const parts = [];
  let total = 0;
  for (let offset = 0; offset < size; offset += block) {
    const part = await readJson(await exec(xrmAction('DownloadBlock', { Offset: offset, BlockLength: block, FileContinuationToken: init.FileContinuationToken },
      { Offset: EDM_INT64, BlockLength: EDM_INT64, FileContinuationToken: EDM_STRING })));
    const bytes = base64ToBytes(part.Data || '');
    if (!bytes.length) break;
    parts.push(bytes);
    total += bytes.length;
  }
  const all = new Uint8Array(total);
  let at = 0;
  parts.forEach((b) => { all.set(b, at); at += b.length; });
  return { name: safeString(init.FileName), data: bytesToBase64(all) };
};

// Or the Web API directly: GET .../column/$value (same site as the app)
const downloadByGet = async (xrm, table, id, column) => {
  let base = '';
  try { base = xrm && xrm.Utility && xrm.Utility.getGlobalContext ? safeString(xrm.Utility.getGlobalContext().getClientUrl()) : ''; } catch (_) { /* use this site */ }
  const res = await fetch(`${base.replace(/\/+$/, '')}/api/data/v9.2/${ENTITY_SET[table]}(${id})/${column}/$value`, {
    method: 'GET', credentials: 'same-origin', headers: { 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' },
  });
  if (res.status === 204 || res.status === 404) throw new Error('no file is attached');
  if (!res.ok) {
    let msg = '';
    try { const j = await res.json(); msg = j && j.error && j.error.message; } catch (_) { /* no JSON body */ }
    throw new Error(msg || `the server answered ${res.status}`);
  }
  const header = (h) => safeString(res.headers && res.headers.get ? res.headers.get(h) : '');
  const bytes = new Uint8Array(await res.arrayBuffer());
  if (!bytes.length) throw new Error('no file is attached');
  return { name: header('x-ms-file-name'), mime: header('mimetype'), data: bytesToBase64(bytes) };
};

// { name, mime, data (base64) } of a File column, or an error
const downloadFileColumn = async (table, id, column) => {
  const xrm = findXrm();
  const errors = [];
  if (xrm && xrm.WebApi.online && typeof xrm.WebApi.online.execute === 'function') {
    try { const f = await downloadByBlocks(xrm, table, id, column); return { ...f, mime: fileMime(f) }; } catch (e) {
      // Dataverse answered and there is no file: asking again another way would only say the same
      if (/no file is attached/i.test(errText(e))) throw e;
      errors.push(errText(e));
    }
  }
  if (typeof fetch === 'function') {
    try { const f = await downloadByGet(xrm, table, id, column); return { ...f, mime: fileMime(f) }; } catch (e) { errors.push(errText(e)); }
  }
  throw new Error(errors.length ? Array.from(new Set(errors)).join('; ') : 'this app has no way to download files');
};

const webApiAdapter = (w) => {
  const options = ({ select, filter, orderBy }, top) => {
    const parts = [];
    if (select) parts.push(`$select=${select.join(',')}`);
    if (filter) parts.push(`$filter=${encodeFilterText(filter)}`);
    if (orderBy) parts.push(`$orderby=${orderBy}`);
    if (top) parts.push(`$top=${top}`);
    return `?${parts.join('&')}`;
  };
  const wrap = (table, res, size) => ({
    rows: (res && res.entities) || [],
    next: res && res.nextLink ? async () => wrap(table, await w.retrieveMultipleRecords(table, `?${res.nextLink.split('?')[1]}`, size), size) : null,
  });
  return {
    mode: 'dataverse',
    async query(table, o = {}) { return ((await w.retrieveMultipleRecords(table, options(o, o.top || 100))) || {}).entities || []; },
    async page(table, o = {}) { const size = o.top || 100; return wrap(table, await w.retrieveMultipleRecords(table, options(o, 0), size), size); },
    async create(table, payload) { const r = await w.createRecord(table, payload); return r && typeof r === 'object' ? r.id : r; },
    async update(table, id, payload) { await w.updateRecord(table, id, payload); },
    async remove(table, id) { await w.deleteRecord(table, id); },
    uploadFile: uploadFileColumn,
    downloadFile: downloadFileColumn,
  };
};

// Power Apps generative page dataApi: queryTable returns { rows, hasMoreRows, loadMoreRows }.
const dataApiAdapter = (ref) => {
  const wrap = (res, seen, idc) => {
    const rows = rowsOf(res).filter(r => { const k = r && r[idc]; if (!k) return true; if (seen.has(k)) return false; seen.add(k); return true; });
    const more = res && res.hasMoreRows && typeof res.loadMoreRows === 'function';
    return {
      rows,
      next: more ? async () => {
        const got = await res.loadMoreRows();
        // loadMoreRows may return the next page or grow the original result; rows already seen are skipped either way
        return wrap(got && (Array.isArray(got) || got.rows) ? got : res, seen, idc);
      } : null,
    };
  };
  return {
    mode: 'dataverse',
    async query(table, { select, filter, orderBy, top = 100 } = {}) {
      return rowsOf(await ref.current.queryTable(table, { select, filter, orderBy, pageSize: top, top })).slice(0, top);
    },
    async page(table, { select, filter, orderBy, top = 100 } = {}) {
      return wrap(await ref.current.queryTable(table, { select, filter, orderBy, pageSize: top }), new Set(), ID_COL[table]);
    },
    async create(table, payload) {
      const res = await ref.current.createRow(table, payload);
      return res && typeof res === 'object' ? (res.id || res[`${table}id`]) : res;
    },
    async update(table, id, payload) { await ref.current.updateRow(table, id, payload); },
    async remove(table, id) { await ref.current.deleteRow(table, id); },
    uploadFile: uploadFileColumn, // dataApi has no file upload or download of its own
    downloadFile: downloadFileColumn,
  };
};

// At most a few requests in flight at once, whichever screens are asking
const makeLimiter = (max) => {
  let active = 0;
  const queue = [];
  const pump = () => {
    while (active < max && queue.length) {
      active += 1;
      const { fn, res, rej } = queue.shift();
      Promise.resolve().then(fn).then(res, rej).finally(() => { active -= 1; pump(); });
    }
  };
  return (fn) => new Promise((res, rej) => { queue.push({ fn, res, rej }); pump(); });
};

const makeApi = (dataApiRef, props) => {
  let base;
  if (typeof Xrm !== 'undefined' && Xrm && Xrm.WebApi) base = webApiAdapter(Xrm.WebApi); // eslint-disable-line no-undef
  else if (dataApiRef && dataApiRef.current) base = dataApiAdapter(dataApiRef);
  else { const w = findWebApi(props); base = w ? webApiAdapter(w) : makeMock(); }
  const limit = makeLimiter(6);
  const wrapPage = (pg) => ({ rows: pg.rows, next: pg.next ? () => limit(pg.next).then(wrapPage) : null });
  return {
    mode: base.mode,
    query: (t, o) => limit(() => base.query(t, o)),
    page: async (t, o) => wrapPage(await limit(() => base.page(t, o))),
    async create(t, p) {
      const id = cleanGuid(await limit(() => base.create(t, p)));
      if (!isGuid(id)) throw new Error('Dataverse did not return the id of the new row.');
      return id;
    },
    update: (t, id, p) => limit(() => base.update(t, id, p)),
    remove: (t, id) => limit(() => base.remove(t, id)),
    uploadFile: (t, id, col, data, name, mime) => limit(() => base.uploadFile(t, id, col, data, name, mime)),
    downloadFile: (t, id, col) => limit(() => base.downloadFile(t, id, col)),
  };
};

// --- STORE: targeted, cached lookups (never loads a whole table) ---
// An error from Dataverse that means the craa5_asset lookup column does not exist (anything else is a real error)
const MISSING_LOOKUP = /could not find a property|undeclared property|not a valid property|_craa5_asset_value|craa5_asset@odata/i;
// An error that means a selected column does not exist or cannot be read
const MISSING_COLUMN = /could not find a property|undeclared property|not a valid property|not a valid column|does not exist on|attribute.*not found/i;

const makeStore = (api) => {
  const assets = new Map();   // asset id -> { id, name, room, area }
  const gone = new Set();     // ids confirmed missing from craa5_aa_assets
  const cache = {
    orderSearch: new Map(), orderPending: new Map(), orderRows: new Map(), orders: new Map(), prev: new Map(), evidence: new Map(),
    assetSearch: new Map(), names: new Map(), field: new Map(),
  };
  const users = new Map();    // user id -> full name ('' when it could not be read)
  let usersOff = false;       // reading user names failed once: the table shows no names
  let createdOk = null;       // can log entries be read with createdon? null until first asked
  let lookup = null;          // does craa5_aa_ms_assets have the craa5_asset lookup? null until first probed
  let bindFailed = false;     // writing the lookup failed once: stop trying for this session

  // One shared promise per key, so repeat and simultaneous requests cost one query; a failure is forgotten so it can be retried.
  const once = (map, key, fn) => {
    if (!map.has(key)) map.set(key, fn().catch((e) => { map.delete(key); throw e; }));
    return map.get(key);
  };

  const toAsset = (r) => ({ id: cleanGuid(r.craa5_aa_assetsid), name: safeString(r.craa5_equipmentidentifier), room: safeString(r.craa5_roomname), area: safeString(r.craa5_areaname) });
  const keep = (rows) => rows.map(r => { const a = toAsset(r); assets.set(a.id, a); gone.delete(a.id); return a; });
  const queryAssets = async (filter, top) => keep(await api.query(ASSET_TABLE, { select: ASSET_SELECT, filter, top, orderBy: 'craa5_equipmentidentifier' }));

  // Look up specific assets by id (only the ones not already cached), in small chunks.
  const resolve = async (ids) => {
    const need = Array.from(new Set(ids.map(cleanGuid))).filter(id => isGuid(id) && !assets.has(id) && !gone.has(id));
    const rs = await pool(chunked(need, LIMITS.idChunk), 3, async (c) => {
      const found = await queryAssets(c.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), c.length);
      const got = new Set(found.map(a => a.id));
      c.forEach(id => { if (!got.has(id)) gone.add(id); });
    });
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
  };

  const msSelect = (withLookup) => ['craa5_aa_ms_assetsid', 'craa5_equipment', 'craa5_textroom', 'craa5_textarea', ...CODE_COLS, ...(withLookup ? ['_craa5_asset_value'] : [])];
  const toMs = (r) => ({
    id: r.craa5_aa_ms_assetsid, equipment: safeString(r.craa5_equipment), room: safeString(r.craa5_textroom), area: safeString(r.craa5_textarea),
    assetId: cleanGuid(r._craa5_asset_value) || null,
    codes: CODE_COLS.map(col => ({ col, code: normCode(r[col]) })).filter(c => c.code),
  });
  // SAP rows. The craa5_asset lookup may not exist yet: the first query probes it and, only when Dataverse says the
  // column is unknown, falls back without it. Any other error (throttling, network) is reported, not taken as "no lookup".
  const queryMs = async (filter, top) => {
    const f = (withLookup) => (typeof filter === 'function' ? filter(withLookup) : filter);
    if (lookup !== false) {
      try { const rows = await api.query(MS_TABLE, { select: msSelect(true), filter: f(true), top, orderBy: 'craa5_title' }); lookup = true; return rows.map(toMs); }
      catch (e) { if (lookup === true || !MISSING_LOOKUP.test(errText(e))) throw e; }
    }
    const rows = await api.query(MS_TABLE, { select: msSelect(false), filter: f(false), top, orderBy: 'craa5_title' });
    lookup = false;
    return rows.map(toMs);
  };
  const codeFilter = (op, code) => CODE_COLS.map(c => (op === 'eq' ? ciEq(c, code) : ciContains(c, code))).join(' or ');

  // Equipment with exactly these names (in these rooms when the SAP row names one), a few names per query
  const assetsByNames = async (wants) => {
    const uniq = Array.from(new Map(wants.filter(w => w.equipment).map(w => [`${normName(w.equipment)}|${normName(w.room)}`, w])).values());
    const rs = await pool(chunked(uniq, LIMITS.nameChunk), 3, (c) => queryAssets(c.map(w => (normName(w.room)
      ? `(${ciEq('craa5_equipmentidentifier', w.equipment)} and ${ciEq('craa5_roomname', w.room)})`
      : ciEq('craa5_equipmentidentifier', w.equipment))).join(' or '), 100));
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
    const out = new Map(); // canonical name -> assets
    rs.forEach(r => r.value.forEach(a => { const k = canonName(a.name); if (!out.has(k)) out.set(k, []); if (!out.get(k).some(x => x.id === a.id)) out.get(k).push(a); }));
    return out;
  };

  // Earlier log entries of one SAP order that carry a known equipment ID (the newest few hundred)
  const prevForOrder = (code) => once(cache.prev, code, async () => {
    const rows = await api.query(LOG_TABLE, {
      select: ['craa5__log_id', 'craa5_equipmentguid', 'craa5_equipment', 'craa5_room', 'craa5_area'],
      filter: `${ciEq('craa5_sap', code)} and craa5_equipmentguid ne null and craa5_equipmentguid ne ''`,
      orderBy: 'craa5_lastcleaned desc', top: LIMITS.prevEntries,
    });
    await resolve(rows.map(r => r.craa5_equipmentguid));
    return rows.map(r => ({ guid: cleanGuid(r.craa5_equipmentguid), equipment: safeString(r.craa5_equipment), room: safeString(r.craa5_room), area: safeString(r.craa5_area) }))
      .filter(r => assets.has(r.guid));
  });

  const store = {
    lookupState: () => lookup,
    getAsset: (id) => assets.get(cleanGuid(id)),
    hasAsset: (id) => assets.has(cleanGuid(id)),
    isGone: (id) => !isGuid(id) || gone.has(cleanGuid(id)),
    resolveAssets: resolve,
    dropOrders() { ['orderSearch', 'orderPending', 'orderRows', 'orders', 'prev', 'evidence'].forEach(k => cache[k].clear()); },
    invalidateAssets() { ['assetSearch', 'names', 'field'].forEach(k => cache[k].clear()); },

    // SAP order typeahead. Server search, small limit; a shorter cached search that was not truncated answers longer ones locally.
    async searchOrders(q) {
      const key = normCode(q);
      if (key.length < 2) return { items: [], truncated: false };
      let entry = cache.orderSearch.get(key);
      if (!entry) {
        const wider = Array.from(cache.orderSearch.entries()).find(([k, e]) => !e.truncated && key.includes(k));
        if (wider) entry = { rows: wider[1].rows.filter(r => r.codes.some(c => c.code.includes(key))), truncated: false };
        if (!entry) {
          entry = await once(cache.orderPending, key, async () => {
            const rows = await queryMs(codeFilter('contains', key), LIMITS.orderSuggest);
            return { rows, truncated: rows.length >= LIMITS.orderSuggest };
          });
        }
        cache.orderSearch.set(key, entry);
      }
      const by = new Map();
      entry.rows.forEach(r => r.codes.forEach(c => {
        if (!c.code.includes(key)) return;
        if (!by.has(c.code)) by.set(c.code, { code: c.code, ids: new Set(), names: new Set() });
        const x = by.get(c.code);
        x.ids.add(r.id);
        if (r.equipment) x.names.add(r.equipment);
      }));
      const items = Array.from(by.values())
        .sort((a, b) => (b.code.startsWith(key) ? 1 : 0) - (a.code.startsWith(key) ? 1 : 0) || a.code.localeCompare(b.code))
        .slice(0, 10)
        .map(x => ({ code: x.code, count: x.ids.size, names: Array.from(x.names).slice(0, 2).join(', ') }));
      return { items, truncated: entry.truncated };
    },

    // One SAP order's rows, with the equipment their craa5_asset lookup points at
    loadOrderRows(code) {
      const c = normCode(code);
      return once(cache.orderRows, c, async () => {
        const rows = (await queryMs(codeFilter('eq', c), LIMITS.orderRows + 1)).filter(r => r.codes.some(x => x.code === c));
        const list = rows.slice(0, LIMITS.orderRows);
        await resolve(list.map(r => r.assetId).filter(Boolean));
        return {
          code: c,
          capped: rows.length > LIMITS.orderRows,
          rows: list.map(r => ({ ...r, col: (r.codes.find(x => x.code === c) || {}).col, asset: r.assetId ? assets.get(r.assetId) || null : null })),
        };
      });
    },

    // One SAP order for the entry form: linked equipment, and the best fit for every row without a link
    loadOrder(code) {
      const c = normCode(code);
      return once(cache.orders, c, async () => {
        const base = await store.loadOrderRows(c);
        const entries = base.rows.map(r => ({
          key: r.id, msId: r.id, col: r.col, equipment: r.equipment, room: r.room, area: r.area,
          linked: r.asset, asset: r.asset, how: r.asset ? 'linked' : '', tier: r.asset ? 'linked' : 'none', ranked: [], partial: false, reason: '',
        }));
        const loose = entries.filter(e => !e.linked);
        if (loose.length) {
          const [prev, exact] = await Promise.all([prevForOrder(c).catch(() => []), assetsByNames(loose)]);
          const single = entries.length === 1;
          const rs = await pool(loose, 3, async (e, i) => {
            e.partial = i >= LIMITS.fuzzyLines;
            e.ranked = await rankForLine(store, e, { prev, exact, single, fuzzy: !e.partial });
          });
          const bad = rs.find(r => !r.ok);
          if (bad) throw bad.error;
          assignBestFits(entries);
        }
        return { code: c, entries, capped: base.capped };
      });
    },
    // Candidates for one SAP row on demand (rows past the first few dozen of a big order, or "Look for similar names")
    async rankLine(code, line, single) {
      const prev = await prevForOrder(normCode(code)).catch(() => []);
      const exact = await assetsByNames([line]);
      return rankForLine(store, line, { prev, exact, single, fuzzy: true, force: true });
    },

    // Free-text equipment search: every word must appear in the name, room or area.
    async searchAssets(text) {
      const tokens = tokenize(text).slice(0, 4);
      if (!tokens.length || tokens.join('').length < 2) return [];
      return once(cache.assetSearch, tokens.join(' '), async () => {
        const filter = tokens.map(t => `(${ciContains('craa5_equipmentidentifier', t)} or ${ciContains('craa5_roomname', t)} or ${ciContains('craa5_areaname', t)})`).join(' and ');
        const found = await queryAssets(filter, LIMITS.assetSearch);
        const score = (a) => tokens.filter(t => a.name.toLowerCase().includes(t)).length;
        return found.sort((a, b) => score(b) - score(a) || a.name.localeCompare(b.name));
      });
    },

    // Candidate equipment for a name: server searches on its main words (and number), in the same room first, never the whole table.
    assetsLikeName(p, room) {
      // Word stems, so "Floors" also finds "Floor"
      const ws = p.words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).filter(w => w.length >= 2).sort((a, b) => b.length - a.length).slice(0, 2);
      if (!ws.length) return Promise.resolve([]);
      const num = p.numList.slice(0, 1);
      return once(cache.names, `${ws.join(',')}|${num.join(',')}|${normName(room)}`, async () => {
        const named = (list, all) => `(${list.map(w => ciContains('craa5_equipmentidentifier', w)).join(all ? ' and ' : ' or ')})`;
        const inRoom = normName(room) ? ` and ${ciEq('craa5_roomname', room)}` : '';
        const good = (list) => list.some(a => nameSimilarity(p, nameProfile(a.name)) >= 0.8);
        let found = await queryAssets(named([...ws, ...num], true) + inRoom, LIMITS.assetNames);
        if (!good(found)) found = uniqueById([...found, ...await queryAssets(named(ws, false) + inRoom, LIMITS.assetNames)]);
        // Same names in other rooms: listed as options, never picked automatically
        if (!good(found) && inRoom) found = uniqueById([...found, ...await queryAssets(named([...ws, ...num], true), LIMITS.assetNames)]);
        return found;
      });
    },

    // Fix tab double-check: the newest few hundred entries of a group's equipment (same name, room and area) that already
    // carry an equipment ID, counted by the equipment they point at
    logEvidence(g) {
      if (!canonName(g.equipment)) return Promise.resolve({ by: [], unknown: 0, checked: 0, capped: false });
      return once(cache.evidence, familyKey(g), async () => {
        const ask = (filter) => api.query(LOG_TABLE, { select: EVIDENCE_SELECT, filter: `${filter} and ${LINKED}`, orderBy: 'craa5_lastcleaned desc', top: LIMITS.evidence });
        // Every spelling of the name; when that fills the cap, also the name as written, so similar names
        // ("Oven 1 racks", "Conveyor 10") cannot crowd it out
        const loose = await ask(familyFilter(g));
        const place = `${placeFilter('craa5_room', g.room)} and ${placeFilter('craa5_area', g.area)}`;
        const exact = loose.length >= LIMITS.evidence ? await ask(`${ciEq('craa5_equipment', g.equipment)} and ${place}`) : [];
        const rows = exact.concat(loose);
        const mine = uniqueRows(rows).filter(r => inFamily(g, r));
        await resolve(mine.map(r => r.craa5_equipmentguid));
        const by = new Map();
        let unknown = 0;
        mine.forEach(r => {
          const a = assets.get(cleanGuid(r.craa5_equipmentguid));
          if (!a) { unknown += 1; return; }
          if (!by.has(a.id)) by.set(a.id, { asset: a, count: 0 });
          by.get(a.id).count += 1;
        });
        return { by: Array.from(by.values()).sort((a, b) => b.count - a.count), unknown, checked: mine.length, capped: exact.length >= LIMITS.evidence || loose.length >= LIMITS.evidence };
      });
    },
    // Every entry of a group's equipment (same name, room and area) that needs this equipment: no ID, an ID that no longer
    // exists, or one of the wrong IDs given. Entries already on other existing equipment are only counted. Read page by page.
    // assetId may be a list (an entry broken up into pieces): entries already on any of them are left alone.
    async familyToFix(g, assetId, wrongIds, places) {
      if (!canonName(g.equipment)) return { rows: [], kept: 0, keptMore: false, capped: false };
      const keep = [].concat(assetId).map(cleanGuid).filter(Boolean);
      const readAll = async (filter, maxPages) => {
        const out = [];
        let pg = await api.page(LOG_TABLE, { select: FIX_SELECT, filter, top: LIMITS.familyPage });
        for (let pages = 1; ; pages++) {
          pg.rows.forEach(r => { if (inFamily(g, r)) out.push(r); });
          if (!pg.next) return { rows: out, capped: false };
          if (pages >= maxPages) return { rows: out, capped: true };
          pg = await pg.next();
        }
      };
      const base = familyFilter(g, places);
      const [blank, linked] = await Promise.all([
        readAll(`${base} and ${BLANK_GUID}`, LIMITS.familyPages),
        readAll(`${base} and ${LINKED}${keep.map(id => ` and ${guidNe('craa5_equipmentguid', id)}`).join('')}`, LIMITS.familyLinkedPages),
      ]);
      await resolve(linked.rows.map(r => r.craa5_equipmentguid));
      const wrong = (wrongIds || []).map(cleanGuid);
      const fix = linked.rows.filter(r => { const id = cleanGuid(r.craa5_equipmentguid); return keep.indexOf(id) < 0 && (wrong.includes(id) || store.isGone(id)); });
      const fixIds = new Set(fix.map(r => r.craa5__log_id));
      const keptIds = linked.rows.filter(r => !fixIds.has(r.craa5__log_id)).map(r => cleanGuid(r.craa5_equipmentguid));
      return { rows: blank.rows.concat(fix), kept: keptIds.length, keptIds, keptMore: linked.capped, capped: blank.capped || linked.capped };
    },

    async findAssetExact(name, room, area) {
      const rows = await queryAssets(`${ciEq('craa5_equipmentidentifier', name)} and ${ciEq('craa5_roomname', room)} and ${ciEq('craa5_areaname', area)}`, 5);
      return rows.find(a => sameText(a.name, name) && sameText(a.room, room) && sameText(a.area, area)) || null;
    },
    async createAsset(a) {
      const id = await api.create(ASSET_TABLE, { craa5_equipmentidentifier: a.name, craa5_roomname: a.room, craa5_areaname: a.area });
      const asset = { id, name: a.name, room: a.room, area: a.area };
      assets.set(id, asset); gone.delete(id);
      store.invalidateAssets();
      return asset;
    },
    // Writes only the fields that changed
    async updateAsset(a, name, room, area) {
      const payload = {};
      if (name !== a.name) payload.craa5_equipmentidentifier = name;
      if (room !== a.room) payload.craa5_roomname = room;
      if (area !== a.area) payload.craa5_areaname = area;
      if (Object.keys(payload).length) await api.update(ASSET_TABLE, a.id, payload);
      const asset = { id: a.id, name, room, area };
      assets.set(a.id, asset);
      store.invalidateAssets();
      return asset;
    },

    // Distinct values for room/area suggestions while typing
    suggestField(col, text, room) {
      const t = safeString(text);
      if (t.length < 2) return Promise.resolve([]);
      return once(cache.field, `${col}|${t.toLowerCase()}|${normName(room)}`, async () => {
        const parts = [ciContains(col, t)];
        if (normName(room)) parts.push(ciEq('craa5_roomname', room));
        const seen = new Map();
        // One big room can fill a whole page: ask again without the values already found (a few small queries at most)
        for (let round = 0; round < 10 && seen.size < 15; round++) {
          const not = Array.from(seen.values()).map(v => `${col} ne '${escOData(v)}'`);
          const rows = await api.query(ASSET_TABLE, { select: [col], filter: parts.concat(not).join(' and '), top: 40, orderBy: col });
          const before = seen.size;
          rows.forEach(r => { const v = safeString(r[col]); if (v && !seen.has(v.toLowerCase())) seen.set(v.toLowerCase(), v); });
          if (rows.length < 40 || seen.size === before) break;
        }
        return Array.from(seen.values()).slice(0, 15);
      });
    },

    // Equipment records in one room (and area), for finding duplicates
    async assetsInPlace(room, area) {
      const f = [ciEq('craa5_roomname', room)];
      if (normName(area)) f.push(ciEq('craa5_areaname', area));
      const rows = await queryAssets(f.join(' and '), LIMITS.unifyAssets + 1);
      const list = rows.filter(a => sameText(a.room, room) && (!normName(area) || sameText(a.area, area)));
      return { list: list.slice(0, LIMITS.unifyAssets), capped: rows.length > LIMITS.unifyAssets };
    },
    // How many log entries carry this equipment id (counted up to a cap) and when the newest of them was saved
    // (or, where the save time cannot be read, its date of clean)
    async logUse(id) {
      const ask = (saved) => api.query(LOG_TABLE, {
        select: saved ? ['craa5__log_id', CREATED_ON, 'craa5_lastcleaned'] : ['craa5__log_id', 'craa5_lastcleaned'],
        filter: guidEq('craa5_equipmentguid', id), orderBy: saved ? `${CREATED_ON} desc` : 'craa5_lastcleaned desc', top: LIMITS.countCap + 1,
      });
      let rows = null;
      if (createdOk !== false) {
        try { rows = await ask(true); createdOk = true; }
        catch (e) {
          if (createdOk === true) throw e;
          rows = await ask(false); // throws its own error if the problem is elsewhere
          if (MISSING_COLUMN.test(errText(e))) createdOk = false;
        }
      }
      if (!rows) rows = await ask(false);
      const top = rows[0];
      return { n: Math.min(rows.length, LIMITS.countCap), more: rows.length > LIMITS.countCap, newest: top ? safeString(top[CREATED_ON]) || safeString(top.craa5_lastcleaned) : '', saved: !!(top && top[CREATED_ON]) };
    },
    // When each equipment record was added (id -> createdon); missing where it cannot be read
    async assetsAdded(ids) {
      const added = new Map();
      await pool(chunked(Array.from(new Set(ids.map(cleanGuid))).filter(isGuid), LIMITS.idChunk), 2, async (c) => {
        const rows = await api.query(ASSET_TABLE, { select: ['craa5_aa_assetsid', CREATED_ON], filter: c.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), top: c.length });
        rows.forEach(r => added.set(cleanGuid(r.craa5_aa_assetsid), safeString(r[CREATED_ON])));
      });
      return added;
    },
    // Names of the people who saved entries, for rows that came without one: looked up once per person, a few at a time
    async userNames(ids) {
      const need = Array.from(new Set(ids.map(cleanGuid))).filter(id => isGuid(id) && !users.has(id));
      if (!need.length || usersOff) return;
      await pool(chunked(need, LIMITS.idChunk), 2, async (c) => {
        try {
          const rows = await api.query(USER_TABLE, { select: ['systemuserid', 'fullname'], filter: c.map(id => `systemuserid eq ${id}`).join(' or '), top: c.length });
          rows.forEach(r => users.set(cleanGuid(r.systemuserid), safeString(r.fullname)));
          c.forEach(id => { if (!users.has(id)) users.set(id, ''); });
        } catch (e) {
          // No access to user names: stop asking. Anything else (a throttle, a blip): the next page asks again.
          if (MISSING_COLUMN.test(errText(e)) || /privilege|permission|denied|forbidden|403|not found|does not exist/i.test(errText(e))) usersOff = true;
        }
      });
    },
    userName(id) { return users.get(cleanGuid(id)) || ''; },
    // SAP rows whose craa5_asset lookup points at any of these ids
    async msLinkedTo(ids) {
      if (!ids.length || lookup === false) return [];
      const out = [];
      for (const c of chunked(ids.map(cleanGuid), LIMITS.idChunk)) {
        try {
          const rows = await api.query(MS_TABLE, { select: msSelect(true), filter: c.map(id => `_craa5_asset_value eq ${id}`).join(' or '), top: 100 });
          lookup = true;
          out.push(...rows.map(toMs));
        } catch (e) {
          if (lookup !== true && MISSING_LOOKUP.test(errText(e))) { lookup = false; return []; }
          throw e;
        }
      }
      return out;
    },

    // The SAP row that belongs to one equipment (by lookup, else by exact name + room, area when the row has one)
    async findMsForAsset(asset) {
      const byName = `(${ciEq('craa5_equipment', asset.name)} and ${ciEq('craa5_textroom', asset.room)})`;
      const rows = await queryMs((withLookup) => (withLookup ? `_craa5_asset_value eq ${asset.id} or ${byName}` : byName), 10);
      return rows.find(r => r.assetId === asset.id)
        || rows.find(r => !r.assetId && sameText(r.equipment, asset.name) && (!r.room || sameText(r.room, asset.room)) && (!r.area || sameText(r.area, asset.area)))
        || null;
    },
    // Create (id null) or update an SAP row, linking it to its asset when the lookup exists. Returns { id, linked, tried, error }.
    async writeMs(id, payload, asset) {
      const run = (p) => (id ? api.update(MS_TABLE, id, p).then(() => id) : api.create(MS_TABLE, p));
      const empty = !Object.keys(payload).length;
      if (asset && lookup !== false && !bindFailed) {
        try { return { id: await run({ ...payload, 'craa5_asset@odata.bind': `/${ASSET_SET}(${asset.id})` }), linked: true, tried: true }; }
        catch (e) {
          bindFailed = true;
          if (empty) return { id, linked: false, tried: true, error: errText(e) };
        }
        return { id: await run(payload), linked: false, tried: true };
      }
      if (empty) return { id, linked: false, tried: false };
      return { id: await run(payload), linked: false, tried: false };
    },
  };
  return store;
};

// --- BEST FIT: ranking equipment for one SAP row ---
// Sources: equipment that earlier log entries of the order were saved to, the same name, then similar names.
// Room and area must agree for a candidate to be picked automatically.
const rankForLine = async (store, line, ctx) => {
  const p = nameProfile(line.equipment);
  const cand = new Map();
  const bump = (asset, score, reason, support = 0) => {
    const c = cand.get(asset.id);
    if (!c) { cand.set(asset.id, { asset, score, reason, support }); return; }
    c.support += support;
    if (score > c.score) { c.score = score; c.reason = reason; }
  };
  // Earlier entries of this order whose text names this equipment (any entry, when the order has one equipment)
  (ctx.prev || []).forEach(e => {
    const a = store.getAsset(e.guid);
    if (!a) return;
    const named = ctx.single || !p.full || nameSimilarity(p, nameProfile(e.equipment)) >= 0.8 || nameSimilarity(p, nameProfile(a.name)) >= 0.8;
    if (!named || !placeOk(line, e)) return;
    const s = scoreAsset(line, a, p);
    bump(a, placeOk(line, a) ? Math.max(s, 0.85) : s, s >= 0.999 ? 'same name' : 'earlier entries', 1);
  });
  if (p.full) {
    ((ctx.exact && ctx.exact.get(p.full)) || []).forEach(a => bump(a, scoreAsset(line, a, p), placeOk(line, a) ? 'same name' : 'same name, other room/area'));
    const best = Math.max(0, ...Array.from(cand.values()).filter(c => placeOk(line, c.asset)).map(c => c.score));
    if (ctx.force || (ctx.fuzzy && best < 0.95)) {
      (await store.assetsLikeName(p, line.room)).forEach(a => {
        const s = scoreAsset(line, a, p);
        if (s >= 0.25) bump(a, s, !placeOk(line, a) ? 'other room/area' : s >= 0.999 ? 'same name' : 'similar name');
      });
    }
  }
  return Array.from(cand.values()).sort((a, b) => b.score - a.score || b.support - a.support).slice(0, 6);
};

// Give each unlinked SAP row its best fit, most certain rows first, never the same equipment twice.
// A row whose exact match is already on the order is the same equipment listed twice and is folded into it.
const assignBestFits = (entries) => {
  const taken = new Set(entries.filter(e => e.linked).map(e => e.linked.id));
  entries.filter(e => !e.linked && e.ranked.length)
    .sort((a, b) => b.ranked[0].score - a.ranked[0].score || b.ranked[0].support - a.ranked[0].support)
    .forEach(e => {
      const top = e.ranked[0];
      // Folded only when that equipment is the one clear match and the SAP row names its room and area
      const tie = e.ranked.some((c, j) => j > 0 && top.score - c.score < 0.02);
      if (top.score >= 0.99 && taken.has(top.asset.id) && !tie && normName(e.room) && normName(e.area)) { e.asset = top.asset; e.how = 'same as another line'; return; }
      const i = e.ranked.findIndex(c => !taken.has(c.asset.id) && c.score >= 0.6 && placeOk(e, c.asset));
      if (i < 0) return;
      const pick = e.ranked[i];
      taken.add(pick.asset.id);
      // A tie with equipment another line already uses also needs a check (two identical records)
      const rival = (tie && pick !== top) || e.ranked.some((c, j) => j !== i && !taken.has(c.asset.id) && c.score >= 0.6 && pick.score - c.score < 0.02 && c.support === pick.support);
      let tier = tierOf(pick.score);
      if (rival) tier = downTier(tier);
      Object.assign(e, { asset: pick.asset, how: 'best fit', tier, ambiguous: rival, reason: reasonText(pick) });
    });
};

// Fix tab: ranks the closest equipment for one group of identical old log entries.
const rankCandidates = async (store, g) => {
  const p = nameProfile(g.equipment);
  const want = { equipment: g.equipment, room: g.room, area: g.area };
  const cand = new Map(); // assetId -> { asset, score, reason }
  const bump = (asset, score, reason) => {
    if (g.exclude && asset.id === g.exclude) return;
    const c = cand.get(asset.id);
    if (!c || score > c.score) cand.set(asset.id, { asset, score, reason });
  };
  let settled = false;
  // 1. SAP order: only its rows and their linked equipment are loaded
  if (g.sap) {
    const ord = await store.loadOrderRows(g.sap);
    const list = uniqueById(ord.rows.filter(r => r.asset).map(r => r.asset));
    const whole = !ord.capped && ord.rows.length > 0 && ord.rows.every(r => r.asset);
    if (list.length === 1 && whole) {
      const a = list[0];
      const sim = p.full ? nameSimilarity(p, nameProfile(a.name)) : 1;
      if (sim >= 0.5 && placeOk(want, a)) { bump(a, 0.97, 'SAP order'); settled = sim >= 0.8; }
      else bump(a, 0.7, sim >= 0.5 ? 'SAP order (room/area differ)' : 'SAP order (name differs)');
    } else {
      list.forEach(a => {
        const s = p.full ? scoreAsset(want, a, p) : 0;
        if (s >= 0.999) bump(a, 0.99, 'SAP order + same name');
        else if (s >= 0.6) bump(a, Math.min(0.94, s + 0.05), 'SAP order + similar name');
      });
    }
  }
  // 2. Name in the same room and area, from a few server-side name searches
  if (p.full && !settled) {
    (await store.assetsLikeName(p, g.room)).forEach(a => {
      const s = scoreAsset(want, a, p);
      if (s >= 0.5) bump(a, s, !placeOk(want, a) ? 'other room/area' : s < 0.999 ? 'similar name' : normName(g.room) || normName(g.area) ? 'same name, room, area' : 'same name');
    });
  }
  // 3. Double-check against the log: entries with this name in this room and area that already carry an equipment ID.
  // The log confirms equipment whose own name fits (or that the SAP order or the name search found); on its own it is
  // Medium at best, a single entry never makes High, and entries pointing at other rooms or areas weigh against it.
  let check = null;
  const logCount = new Map(); // asset id -> entries of this name here that use it
  const placed = !!(placeKey(g.room) && placeKey(g.area));
  const inPlace = (a) => placed && samePlace(g.room, a.room) && samePlace(g.area, a.area);
  if (canonName(g.equipment)) {
    try {
      const ev = await store.logEvidence(g);
      const uses = ev.by.filter(x => placeOk(want, x.asset) && x.asset.id !== g.exclude);
      const elsewhere = ev.by.filter(x => !placeOk(want, x.asset) && x.asset.id !== g.exclude).reduce((s, x) => s + x.count, 0);
      const total = uses.reduce((s, x) => s + x.count, 0);
      uses.forEach(x => {
        const share = x.count / total;
        const q = nameProfile(x.asset.name);
        const numClash = p.hasNums && q.hasNums && p.nums !== q.nums;
        const prior = cand.get(x.asset.id);
        const confirms = !numClash && (nameSimilarity(p, q) >= 0.8 || !!(prior && prior.score >= 0.6));
        let s = share === 1 ? (inPlace(x.asset) ? (x.count >= 2 ? 1 : 0.96) : 0.9) : share >= 0.8 ? 0.9 : 0.6 + 0.3 * share;
        if (x.count < 2 && !prior) s = Math.min(s, 0.94);
        if (!confirms) s = Math.min(s, numClash ? 0.6 : 0.85);
        if (elsewhere >= x.count) s = Math.min(s, 0.9);
        bump(x.asset, s, LOG_REASON);
        logCount.set(x.asset.id, x.count);
      });
      check = { uses, total, elsewhere, unknown: ev.unknown, capped: ev.capped };
    } catch (e) { check = { error: errText(e) }; }
  }
  // Equal scores: the equipment more entries of this name already use comes first
  const ranked = Array.from(cand.values()).sort((a, b) => b.score - a.score || (logCount.get(b.asset.id) || 0) - (logCount.get(a.asset.id) || 0)).slice(0, 5);
  let tier = ranked.length ? tierOf(ranked[0].score) : 'none';
  // Two equally good candidates (two "Floors" in the same place, or the same name in two rooms) are never High
  const ambiguous = ranked.length > 1 && ranked[0].score - ranked[1].score < 0.02;
  if (ambiguous && tier !== 'none') tier = downTier(tier);
  // The SAP order, the name and the log point at different equipment
  const src = (r) => (r.reason.startsWith('SAP') ? 'SAP order' : r.reason === LOG_REASON ? 'log' : 'name');
  const conflict = ranked.length > 1 && ranked[1].score >= 0.95 && src(ranked[0]) !== src(ranked[1]);
  // Most linked entries of this name here use other equipment than the suggestion
  const rival = check && check.uses && ranked.length
    ? check.uses.find(x => x.asset.id !== ranked[0].asset.id && inPlace(x.asset) && x.count >= 2 && x.count * 2 > check.total && (logCount.get(ranked[0].asset.id) || 0) < x.count)
    : null;
  if ((conflict || rival) && tier === 'high') tier = 'medium';
  const conflictText = conflict ? `${src(ranked[0])} and ${src(ranked[1])} disagree` : rival ? 'the log disagrees' : '';
  return { ranked, tier, ambiguous, conflict: conflict || !!rival, conflictText, check };
};
const LOG_REASON = 'earlier entries with this name';
// What the log double-check says about the equipment chosen for a group
const logCheck = (g, chosenId, asset) => {
  const c = g.check;
  if (!c) return null;
  if (c.error) return { kind: 'warn', text: `Log check failed: ${c.error}` };
  const placed = !!(placeKey(g.room) || placeKey(g.area));
  const here = placed ? 'here' : 'and no room or area';
  const notes = [
    c.elsewhere > 0 && `${plural(c.elsewhere, 'entry', 'entries')} with this name ${here} ${c.elsewhere === 1 ? 'points' : 'point'} at equipment in another room or area`,
    c.unknown > 0 && (c.unknown === 1 ? '1 entry has an ID that no longer exists' : `${c.unknown} entries have IDs that no longer exist`),
    c.capped && 'only the newest entries were checked',
  ].filter(Boolean);
  const tail = notes.length ? ` (${notes.join('; ')})` : '';
  if (!c.total) return { kind: c.elsewhere > 0 ? 'warn' : 'none', text: `Log check: no other entry with this name ${here} is linked to equipment ${placed ? 'in this room and area ' : ''}yet${tail}.` };
  const mine = chosenId ? c.uses.find(x => x.asset.id === chosenId) : null;
  const top = c.uses[0];
  if (mine && mine.count === c.total) {
    const fits = !asset || nameSimilarity(nameProfile(g.equipment), nameProfile(asset.name)) >= 0.8;
    const text = c.total === 1 ? `Log check: the one other entry with this name ${here} that has an ID uses this equipment` : `Log check: all ${c.total} entries with this name ${here} that have an ID use this equipment`;
    return { kind: fits && !c.elsewhere ? 'ok' : 'warn', text: `${text}${fits ? '' : ', but its name is different, so check it'}${tail}.` };
  }
  if (mine) return { kind: 'warn', text: `Log check: ${mine.count} of ${c.total} entries with this name ${here} use this equipment; the rest use ${plural(c.uses.length - 1, 'other one', 'others')}${tail}.` };
  return { kind: 'warn', text: `Log check: ${plural(top.count, 'entry', 'entries')} with this name ${here} ${top.count === 1 ? 'uses' : 'use'} ${top.asset.name} (${placeText(top.asset) || 'no room/area'})${chosenId ? ', not this one' : ''}${tail}.` };
};

// Entry's room/area text disagrees with the room/area of the equipment its ID points at
const placeDiffers = (r, a) => {
  const lr = placeKey(r.craa5_room), la = placeKey(r.craa5_area), ar = placeKey(a.room), aa = placeKey(a.area);
  return !!((lr && ar && lr !== ar) || (la && aa && la !== aa));
};

// --- MOVING LOG ENTRIES ONTO OTHER EQUIPMENT ---
// Earlier entries that belong to a changed order line: saved to the old equipment under this order (unless another line
// of the order still uses it), saved under this order with no ID and the line's name, or carrying the old ID while
// naming the line's own room and area.
const retroFilter = (code, from, ms, fromStillUsed) => {
  const sap = ciEq('craa5_sap', code);
  const parts = [];
  if (from && !fromStillUsed) parts.push(`(${sap} and ${guidEq('craa5_equipmentguid', from.id)})`);
  if (normName(ms.equipment)) {
    // a blank room or area on the entry is not a disagreement; a different one is
    const place = [];
    if (normName(ms.room)) place.push(`(craa5_room eq null or craa5_room eq '' or ${ciEq('craa5_room', ms.room)})`);
    if (normName(ms.area)) place.push(`(craa5_area eq null or craa5_area eq '' or ${ciEq('craa5_area', ms.area)})`);
    parts.push(`(${[sap, BLANK_GUID, ciEq('craa5_equipment', ms.equipment)].concat(place).join(' and ')})`);
  }
  if (from && normName(ms.equipment) && normName(ms.room) && normName(ms.area) && !(samePlace(from.room, ms.room) && samePlace(from.area, ms.area))) {
    parts.push(`(${guidEq('craa5_equipmentguid', from.id)} and ${ciEq('craa5_equipment', ms.equipment)} and ${ciEq('craa5_room', ms.room)} and ${ciEq('craa5_area', ms.area)})`);
  }
  return parts.length ? parts.join(' or ') : null;
};
// What to write on a moved entry: the new ID; display copies only where they were copies of the old equipment or blank.
const repointPayload = (r, from, target, guidOnly) => {
  const p = { craa5_equipmentguid: target.id };
  if (guidOnly) return p;
  const copiedFromOld = from && cleanGuid(r.craa5_equipmentguid) === from.id
    && sameText(r.craa5_equipment, from.name) && samePlace(r.craa5_room, from.room) && samePlace(r.craa5_area, from.area);
  if (copiedFromOld) return { ...p, craa5_equipment: target.name, craa5_room: target.room, craa5_area: target.area };
  if (!safeString(r.craa5_equipment)) p.craa5_equipment = target.name;
  if (!safeString(r.craa5_room)) p.craa5_room = target.room;
  if (!safeString(r.craa5_area)) p.craa5_area = target.area;
  return p;
};
// Point every log entry matching filter at target, a page at a time (moved entries drop out of the filter).
// more: the round limit was reached with entries possibly left over.
const repointEntries = async (api, filter, from, target, guidOnly = false) => {
  let fixed = 0;
  let error = '';
  let more = true;
  const failedIds = new Set();
  for (let round = 0; round < LIMITS.retroRounds; round++) {
    const rows = await api.query(LOG_TABLE, { select: FIX_SELECT, filter, top: LIMITS.retroPage });
    const todo = rows.filter(r => !failedIds.has(r.craa5__log_id));
    if (!todo.length) { more = false; break; }
    const res = await pool(todo, 6, (r) => api.update(LOG_TABLE, r.craa5__log_id, repointPayload(r, from, target, guidOnly)));
    res.forEach((x, i) => { if (x.ok) fixed += 1; else { failedIds.add(todo[i].craa5__log_id); if (!error) error = errText(x.error); } });
    if (rows.length < LIMITS.retroPage) { more = false; break; }
  }
  return { fixed, failed: failedIds.size, failedIds: Array.from(failedIds), error, more };
};
// Move a fixed list of entries (read before anything was written) onto target.
const repointRows = async (api, rows, from, target) => {
  const res = await pool(rows, 6, (r) => api.update(LOG_TABLE, r.craa5__log_id, repointPayload(r, from, target, false)));
  const movedIds = [];
  let error = '';
  res.forEach((x, i) => { if (x.ok) movedIds.push(rows[i].craa5__log_id); else if (!error) error = errText(x.error); });
  return { fixed: movedIds.length, failed: rows.length - movedIds.length, error, movedIds };
};

// --- BREAKING AN ENTRY UP INTO PIECES ---
// An old entry can cover several things ("Floor Cleaning, shadow board + tools") that are separate equipment records now.
// Breaking it up keeps the existing entry for the first piece and saves one new entry for every other piece, with the same
// date, SAP order and initials. The hours are shared out evenly, so their total stays the same. A piece that already has an
// entry for that order and date is not saved again.
const LISTING = /\s*(?:[,;+&\/]|\band\b|\bplus\b)\s*/i;
// The things a text lists ("Mixers 1, 2 & 3" -> Mixers 1, mixers 2, mixers 3); [] unless it lists two or more
const textParts = (text) => {
  const out = [];
  safeString(text).split(LISTING).map(x => x.trim()).filter(x => /[a-z0-9]/i.test(x)).forEach(x => {
    if (/^\d+$/.test(x)) {
      // A bare number takes the words of the part before it
      const words = out.length ? tokenize(out[out.length - 1]).filter(w => !/^\d+$/.test(w)) : [];
      if (words.length) out.push(`${words.join(' ')} ${x}`);
      return;
    }
    if (/[a-z0-9]{2}/i.test(x)) out.push(x);
  });
  const seen = new Set();
  const list = out.filter(x => { const k = canonName(x); if (!k || seen.has(k)) return false; seen.add(k); return true; });
  return list.length >= 2 ? list : [];
};
// Equipment records with the same name, room and area (twins, which the Unify tab merges) are one piece: the one more log
// entries already use, else the first. uses remembers the counts (id -> lookup) for the scan that passes it in.
const oneOfTwins = async (store, list, uses = new Map()) => {
  const useOf = (id) => { if (!uses.has(id)) uses.set(id, store.logUse(id)); return uses.get(id); };
  const key = (a) => [canonName(a.name), placeKey(a.room), placeKey(a.area)].join('|');
  const sets = new Map(); // key -> its records, in the order first seen
  list.forEach(a => { const k = key(a); if (!sets.has(k)) sets.set(k, []); sets.get(k).push(a); });
  const keys = Array.from(sets.keys());
  const picked = await pool(keys, 3, async (k) => {
    const twins = sets.get(k).slice().sort((x, y) => (x.id < y.id ? -1 : 1));
    if (twins.length === 1) return twins[0];
    const counts = await pool(twins, 3, (a) => useOf(a.id));
    let best = 0;
    twins.forEach((a, i) => { if (counts[i].ok && (!counts[best].ok || counts[i].value.n > counts[best].value.n)) best = i; });
    return twins[best];
  });
  return picked.map((r, i) => (r.ok ? r.value : sets.get(keys[i])[0]));
};
// Equipment an old entry may now be spread over: the things its text lists, or else the equipment whose names start from the
// entry's own name ("Smock Racking" -> "Smock Racking left" and "Smock Racking right"). Only equipment in the entry's own room
// and area, only for entries that name both, and never when equipment with the entry's own name is there (that is the match).
// A hint only: nothing is ticked for the admin.
const suggestPieces = async (store, g, uses) => {
  if (!(placeKey(g.room) && placeKey(g.area)) || !canonName(g.equipment)) return null;
  const here = (a) => samePlace(g.room, a.room) && samePlace(g.area, a.area);
  if ((g.ranked || []).some(c => canonName(c.asset.name) === canonName(g.equipment) && here(c.asset))) return null;
  const parts = textParts(g.equipment);
  if (parts.length) {
    const rs = await pool(parts, 3, async (part) => {
      const q = nameProfile(part);
      const want = { equipment: part, room: g.room, area: g.area };
      const scored = (await store.assetsLikeName(q, g.room)).filter(here)
        .map(a => ({ a, s: scoreAsset(want, a, q) })).filter(c => c.s >= 0.8)
        .sort((x, y) => y.s - x.s || (x.a.id < y.a.id ? -1 : 1));
      if (!scored.length) return null;
      // Equally good records with one name (twins) are one piece: the one the log uses. Several differently named ones
      // ("Racking left" / "Racking right" for "Racking") are not guessed between: the part counts as not found
      const tied = scored.filter(c => c.s >= scored[0].s - 1e-9).map(c => c.a);
      if (tied.some(a => canonName(a.name) !== canonName(tied[0].name))) return null;
      return (await oneOfTwins(store, tied, uses))[0];
    });
    const assets = uniqueById(rs.filter(r => r.ok && r.value).map(r => r.value));
    return assets.length >= 2 ? { how: 'text', assets, missing: parts.filter((x, i) => !(rs[i].ok && rs[i].value)) } : null;
  }
  const p = nameProfile(g.equipment);
  const stems = (words) => words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w));
  const mine = stems(p.words);
  if (!mine.length) return null;
  const found = await store.assetsLikeName(p, g.room);
  // The entry's own room has more equipment with this word than one search returns: a partial list would look complete
  // (rows of other rooms, which the last search of assetsLikeName adds, do not count)
  if (found.filter(a => samePlace(g.room, a.room)).length >= LIMITS.assetNames) return null;
  // Names that start with the entry's words and numbers and have at least one more word or number ("Racking" -> "Racking left", "Racking 2")
  const kids = found.filter(here).filter(a => {
    const q = nameProfile(a.name);
    const theirs = stems(q.words);
    return mine.every((w, i) => theirs[i] === w) && p.numList.every(n => q.numList.indexOf(n) >= 0)
      && theirs.length + q.numList.length > mine.length + p.numList.length;
  }).sort((x, y) => (x.name < y.name ? -1 : x.name > y.name ? 1 : 0));
  // Many more than a handful is a guess, not a suggestion: the admin picks the pieces
  const names = new Set(kids.map(a => canonName(a.name)));
  if (names.size < 2 || names.size > LIMITS.splitPieces) return null;
  return { how: 'name', assets: await oneOfTwins(store, kids, uses), missing: [] };
};
// A blank room or area on the piece is filled in from the entry, unless the piece is somewhere else than the entry says
const pieceFields = (a, row) => {
  const same = !!row && placeOk({ room: row.craa5_room, area: row.craa5_area }, a);
  return { craa5_equipmentguid: a.id, craa5_equipment: a.name, craa5_room: a.room || (same ? safeString(row.craa5_room) : ''), craa5_area: a.area || (same ? safeString(row.craa5_area) : '') };
};
// Hours of the old entry for one piece: its share when they can be shared out, else the entry's own value (null: none)
const hoursFor = (row, count, index) => {
  const raw = row.craa5_hoursworked;
  if (raw === null || raw === undefined || raw === '') return null;
  const total = Number(raw);
  if (!(total > 0) || count < 2) return raw;
  return splitHours(total, count)[index];
};
// A new entry for another piece: what the old entry says (date, SAP order, initials), with the piece in place of the equipment
const entryForPiece = (row, a, hours) => {
  const e = pieceFields(a, row);
  if (safeString(row.craa5_sap)) e.craa5_sap = row.craa5_sap;
  if (safeString(row.craa5_lastcleaned)) e.craa5_lastcleaned = row.craa5_lastcleaned;
  if (safeString(row.craa5_lastcleanedby)) e.craa5_lastcleanedby = row.craa5_lastcleanedby;
  if (hours !== null && hours !== undefined) e.craa5_hoursworked = hours;
  return e;
};
// The entries to break up, read just before anything is written (by id, a few at a time)
const readEntries = async (api, ids) => {
  const rs = await pool(chunked(ids, LIMITS.idChunk), 3, (c) => api.query(LOG_TABLE, { select: LOG_SELECT, filter: c.map(id => `craa5__log_id eq ${id}`).join(' or '), top: c.length }));
  const bad = rs.find(r => !r.ok);
  if (bad) throw bad.error;
  const out = new Map();
  rs.forEach(r => r.value.forEach(row => out.set(cleanGuid(row.craa5__log_id), row)));
  return out;
};
// A piece's entries between two dates (page by page, capped), to see which dates it is already logged on
const loggedFor = async (api, pieceId, from, to) => {
  const list = [];
  let pg = await api.page(LOG_TABLE, { select: ['craa5__log_id', 'craa5_sap', 'craa5_lastcleaned'], filter: `${guidEq('craa5_equipmentguid', pieceId)} and craa5_lastcleaned ge ${from}T00:00:00Z and craa5_lastcleaned lt ${nextDay(to)}T00:00:00Z`, top: LIMITS.familyPage });
  for (let pages = 1; ; pages++) {
    pg.rows.forEach(r => list.push({ id: r.craa5__log_id, sap: normCode(r.craa5_sap), day: dayKey(r.craa5_lastcleaned) }));
    if (!pg.next) return { list, capped: false };
    if (pages >= LIMITS.splitLoggedPages) return { list, capped: true };
    pg = await pg.next();
  }
};
// Of the earlier entries a changed order line would move onto target, the ones whose day target already has an entry for the same
// order: an order broken up into pieces has one entry per piece on one day, and moving one onto a sibling would log that equipment
// twice and lose the other piece's record. Reads only. unchecked: target has too many entries in that period to look through.
const coveredByTarget = async (api, rows, target) => {
  const out = { covered: new Set(), unchecked: false };
  if (!rows.length || !target || target.isNew) return out;
  const days = rows.map(r => dayKey(r.craa5_lastcleaned)).filter(Boolean).sort();
  if (!days.length) return out;
  const got = await loggedFor(api, target.id, days[0], days[days.length - 1]);
  if (got.capped) out.unchecked = true;
  got.list.forEach((x) => { out.covered.add(`${x.sap}|${x.day}`); });
  return out;
};
const isCovered = (cov, r) => { const d = dayKey(r.craa5_lastcleaned); return !!d && cov.covered.has(`${normCode(r.craa5_sap)}|${d}`); };
// For each entry to break up, the pieces that still need an entry: not those another entry already covers for the same
// SAP order and date. jobs: [{ id, pieces }]. Reads only; throws if it cannot check.
const planSplits = async (api, jobs) => {
  const rows = await readEntries(api, Array.from(new Set(jobs.map(j => j.id))));
  const days = [];
  jobs.forEach(j => { const r = rows.get(cleanGuid(j.id)); const d = r ? dayKey(r.craa5_lastcleaned) : ''; if (d) days.push(d); });
  days.sort();
  const pieceIds = Array.from(new Set(jobs.reduce((all, j) => all.concat(j.pieces.map(x => x.id)), [])));
  const logged = new Map(); // piece id -> its entries { id, sap, day }
  const capped = [];
  if (days.length) {
    const rs = await pool(pieceIds, 3, (id) => loggedFor(api, id, days[0], days[days.length - 1]));
    const bad = rs.find(r => !r.ok);
    if (bad) throw bad.error;
    rs.forEach((r, i) => { logged.set(pieceIds[i], r.value.list); if (r.value.capped) capped.push(pieceIds[i]); });
  }
  // What earlier entries of this same plan will already cover, so two entries for the same order and date do not both save a piece
  const claimed = new Set();
  const items = jobs.map(j => {
    const row = rows.get(cleanGuid(j.id));
    if (!row) return { id: j.id, gone: true, pieces: j.pieces, todo: [] };
    const sap = normCode(row.craa5_sap);
    const day = dayKey(row.craa5_lastcleaned);
    if (!day) return { id: j.id, row, pieces: j.pieces, todo: [], undated: true };
    const claim = (x) => `${cleanGuid(x.id)}|${sap}|${day}`;
    const have = (x) => claimed.has(claim(x)) || (logged.get(x.id) || []).some(e => e.day === day && e.sap === sap && cleanGuid(e.id) !== cleanGuid(row.craa5__log_id));
    const todo = j.pieces.filter(x => !have(x));
    todo.forEach(x => claimed.add(claim(x)));
    return { id: j.id, row, pieces: j.pieces, todo };
  });
  return { items, capped };
};
// Saves the new entries first, then points the old entry at the first piece: an entry that could not get all its new
// entries stays as it was and can be applied again (pieces already saved are found and skipped the next time).
const runSplits = async (api, items, onStep) => {
  const out = { rows: 0, created: 0, failedRows: 0, error: '', fixedIds: [], pieceSkips: 0, leftAlone: 0, gone: 0, undated: 0 };
  let done = 0;
  await pool(items, 4, async (it) => {
    try {
      if (it.gone) { out.gone += 1; return; }
      if (it.undated) { out.undated += 1; return; }
      if (!it.todo.length) { out.leftAlone += 1; return; }
      out.pieceSkips += it.pieces.length - it.todo.length;
      const at = (x) => it.pieces.indexOf(x);
      let failed = 0;
      for (let i = 1; i < it.todo.length; i++) {
        try { await api.create(LOG_TABLE, entryForPiece(it.row, it.todo[i], hoursFor(it.row, it.pieces.length, at(it.todo[i])))); out.created += 1; }
        catch (e) { failed += 1; if (!out.error) out.error = errText(e); }
      }
      if (failed) { out.failedRows += 1; return; }
      const first = it.todo[0];
      const payload = pieceFields(first, it.row);
      // Nothing else is left to save and the entry already is the first piece: an earlier apply went through (it may have reported
      // an error), so its hours are shared out already. Writing them again would share them out a second time.
      const cur = it.row;
      if (it.todo.length === 1 && cleanGuid(cur.craa5_equipmentguid) === cleanGuid(first.id) && safeString(cur.craa5_equipment) === payload.craa5_equipment
        && safeString(cur.craa5_room) === payload.craa5_room && safeString(cur.craa5_area) === payload.craa5_area) { out.rows += 1; out.fixedIds.push(it.id); return; }
      const h = hoursFor(it.row, it.pieces.length, at(first));
      if (h !== null && h !== undefined && h !== it.row.craa5_hoursworked) payload.craa5_hoursworked = h;
      try { await api.update(LOG_TABLE, it.id, payload); }
      catch (e) {
        // A save can be applied although it reported an error (a timeout after it went through): look before calling it a failure,
        // or applying again would share the hours out a second time
        let now = null;
        try { now = (await readEntries(api, [it.id])).get(cleanGuid(it.id)); } catch (_) { now = null; }
        const applied = !!now && cleanGuid(now.craa5_equipmentguid) === cleanGuid(first.id) && safeString(now.craa5_equipment) === safeString(payload.craa5_equipment)
          && (payload.craa5_hoursworked === undefined || Number(now.craa5_hoursworked) === Number(payload.craa5_hoursworked));
        if (!applied) throw e;
      }
      out.rows += 1; out.fixedIds.push(it.id);
    } catch (e) { out.failedRows += 1; if (!out.error) out.error = errText(e); }
    finally { done += 1; if (onStep) onStep(done); }
  });
  return out;
};
// What a plan will do, for the question before anything is saved
const splitStats = (items) => {
  const live = items.filter(it => !it.gone && it.todo.length);
  return {
    rows: live.length,
    creates: live.reduce((n, it) => n + it.todo.length - 1, 0),
    pieceSkips: live.reduce((n, it) => n + it.pieces.length - it.todo.length, 0),
    leftAlone: items.filter(it => !it.gone && !it.undated && !it.todo.length).length,
    gone: items.filter(it => it.gone).length,
    undated: items.filter(it => it.undated).length,
  };
};

// Equipment already logged for an order on a date
const fetchDupes = async (api, code, dateStr) => {
  const rows = await api.query(LOG_TABLE, {
