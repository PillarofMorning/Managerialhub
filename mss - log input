      if (stamp.date && cur.dateStr === stamp.date) { setDateStr(initialDate || maxDate); dateTouched.current = false; cleared.push('date'); }
      if (stamp.hours && String(cur.totalHours) === String(stamp.hours)) { setTotalHours(''); cleared.push('hours'); }
      if (stamp.initials && cur.initials === stamp.initials) { setInitials(''); cleared.push('initials'); }
