  const settling = matches.length === 0 && suggestOpen && (sugg.busy || suggestions.length > 0);
  const isUnknown = ready && matches.length === 0 && !settling;
  const roomOpts = useSuggest(store, 'craa5_roomname', typing.room);
  const areaOpts = useSuggest(store, 'craa5_areaname', typing.area, typing.roomCtx);
  const catalogPlaces = useMemo(() => store.allRoomsAndAreas(), [store, ready, dataVer]);
  const sameNameMatches = useMemo(() => {
    const q = nameQuery.trim();
    if (q.length < 2) return [];
    const exact = store.assetsByName(q);
    if (exact.length) return exact;
    const qLower = q.toLowerCase();
    return store.allCatalogAssets().filter(a => a.name.toLowerCase().includes(qLower)).slice(0, 60);
  }, [store, nameQuery, ready, dataVer]);

  // Attach an asset (and automatically attach all other assets in the catalog with the exact same equipment name!)
  const addExtra = (asset, attachSameName = true) => {
    if (!asset.isNew && takenIds.has(asset.id)) { setNote(`${asset.name} is already on this order.`); return; }
    const sibs = (attachSameName && !asset.isNew && asset.name)
      ? store.assetsByName(asset.name).filter(s => s.id !== asset.id && !takenRef.current.has(s.id))
      : [];
