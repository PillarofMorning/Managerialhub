                craa5_configkey: HUB_CONFIG_SKIPPED_LOG_KEY,
                craa5_configname: HUB_CONFIG_SKIPPED_LOG_KEY,
                craa5_category: 'SkippedEntries',
                craa5_scope: 'MSS_LOG_INPUT',
