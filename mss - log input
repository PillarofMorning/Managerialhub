// Tiny OData $filter evaluator so the preview data answers the same filters Dataverse does
// (eq/ne/gt/ge/lt/le, and/or/not, contains/startswith/endswith, null; text compares ignore case).
const parseFilter = (src) => {
  const toks = src.match(/'(?:[^']|'')*'|[()]|,|[^\s(),']+/g) || [];
  let i = 0;
  const next = () => toks[i++];
  const lit = (t) => (t === 'null' ? null : t[0] === "'" ? t.slice(1, -1).replace(/''/g, "'") : t);
  const norm = (x) => (x === undefined || x === null || x === '' ? null : String(x).toLowerCase());
  const orExpr = () => {
    let l = andExpr();
    while (toks[i] === 'or') { next(); const a = l, b = andExpr(); l = (r) => a(r) || b(r); }
    return l;
  };
  const andExpr = () => {
    let l = unary();
    while (toks[i] === 'and') { next(); const a = l, b = unary(); l = (r) => a(r) && b(r); }
    return l;
  };
  const unary = () => {
    const t = next();
    if (t === 'not') { const f = unary(); return (r) => !f(r); }
    if (t === '(') { const f = orExpr(); next(); return f; }
    if (t === 'contains' || t === 'startswith' || t === 'endswith') {
      next(); const col = next(); next(); const v = String(lit(next())).toLowerCase(); next();
      return (r) => { const s = safeString(r[col]).toLowerCase(); return t === 'contains' ? s.includes(v) : t === 'startswith' ? s.startsWith(v) : s.endsWith(v); };
    }
    const op = next(); const v = norm(lit(next()));
    return (r) => {
      const a = norm(r[t]);
      if (op === 'eq') return a === v;
      if (op === 'ne') return a !== v;
      if (a === null || v === null) return false;
      return op === 'gt' ? a > v : op === 'ge' ? a >= v : op === 'lt' ? a < v : a <= v;
    };
  };
  return orExpr();
};

