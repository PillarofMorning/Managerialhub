const escOData = (s) => String(s).replace(/'/g, "''");
const errText = (e) => (e && (e.message || (e.raw && e.raw.message) || (e.error && e.error.message))) || 'Unknown error';
const GUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const cleanGuid = (s) => safeString(s).replace(/[{}]/g, '').toLowerCase();
