        <Text size={200} block style={{ color: '#0A6A33', fontWeight: 700, marginTop: 4 }}>Filled in from the sheet: {sheet.applied.join(', ')}. Please check {sheet.applied.length === 1 ? 'it' : 'them'} against the paperwork.</Text>
      )}
      {sheet.checkFailed ? <Text className={styles.hint} block style={{ marginTop: 2 }}>The SAP list could not be checked for some order numbers, so they are not marked.</Text> : null}
      {sheet.unread ? <Text className={styles.warnText} block style={{ marginTop: 2 }}>{plural(sheet.unread, 'page', 'pages')} of scanned paper could not be read because the picture reader could not be loaded (the network may block it). The pages with text were read, and everything is attached.</Text> : null}
      {view && view.orders.length > 0 && (
        <div className={styles.sheetRow}><span className={styles.sheetLabel}>SAP order</span>{view.orders.map(o => chip('code', o.code, orderText(o), values.code === o.code, orderTip(o)))}</div>
      )}
      {view && view.dates.length > 0 && (
        <div className={styles.sheetRow}><span className={styles.sheetLabel}>Date</span>{view.dates.map(d => chip('date', d.iso, d.words, values.date === d.iso, d.amb ? 'A date like 10/07 can be read two ways; both are listed' : 'Date found on the sheet'))}</div>
      )}
      {ambiguous && <Text className={styles.hint} block style={{ marginLeft: 76 }}>A date such as 10/07/2026 is read month first (Oct 7); with dots (10.07.2026) day first. The other reading is listed too.</Text>}
      {view && (view.hours.length > 0 || view.hoursSum) && (
        <div className={styles.sheetRow}><span className={styles.sheetLabel}>Hours</span>
