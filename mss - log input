// --- FIX MISSING IDS ---
const FixIdsTab = ({ ctx, onScanned, onApplied }) => {
  const styles = useStyles();
  const { api, assets, assetById, codeIndex } = ctx;
  const [scope, setScope] = useState('all');
  const [scanning, setScanning] = useState(false);
  const [scanError, setScanError] = useState('');
  const [logs, setLogs] = useState(null);
  const [choice, setChoice] = useState({});     // groupKey -> assetId | ''
  const [apply, setApply] = useState({});       // groupKey -> bool
  const [search, setSearch] = useState({});     // groupKey -> text
  const [showAll, setShowAll] = useState(false);
  const [applying, setApplying] = useState(false);
  const [result, setResult] = useState(null);

  const scan = useCallback(async (keepResult) => {
    setScanning(true); setScanError('');
    if (keepResult !== true) setResult(null);
    try {
      const filter = scope === 'year'
        ? `craa5_lastcleaned ge ${toDateInput(new Date(Date.now() - 366 * 86400000))}T00:00:00Z`
        : undefined;
      const rows = await api.query(LOG_TABLE, { select: LOG_SELECT.filter(c => c !== 'craa5_hoursworked'), filter });
      setLogs(rows.map(r => ({
        id: r.craa5__log_id, equipment: safeString(r.craa5_equipment), guid: safeString(r.craa5_equipmentguid),
        sap: normCode(r.craa5_sap), room: safeString(r.craa5_room), area: safeString(r.craa5_area),
      })));
    } catch (e) { setScanError(errText(e)); } finally { setScanning(false); }
  }, [api, scope]);

  useEffect(() => { scan(); }, [scan]);

  const profiles = useMemo(() => assets.map(a => ({ asset: a, p: nameProfile(a.name), room: normName(a.room), area: normName(a.area) })), [assets]);
  const tokenIndex = useMemo(() => {
    const m = new Map();
    profiles.forEach((x, i) => x.p.words.forEach(w => { if (!m.has(w)) m.set(w, new Set()); m.get(w).add(i); }));
    return m;
  }, [profiles]);

  // SAP order -> candidate asset ids (via the SAP rows)
  const assetsForCode = useCallback((sap) => {
    const ids = new Set();
    (codeIndex.get(sap) || []).forEach(({ row }) => {
      if (row.assetId && assetById.has(row.assetId)) ids.add(row.assetId);
      else {
        const hits = assets.filter(a => normName(a.name) === normName(row.equipment) && (!row.room || normName(a.room) === normName(row.room)));
        if (hits.length === 1) ids.add(hits[0].id);
      }
    });
    return [...ids];
  }, [codeIndex, assetById, assets]);

  const groups = useMemo(() => {
    if (!logs) return [];
    const map = new Map();
    logs.forEach(l => {
      const stale = l.guid && !assetById.has(l.guid);
      if (l.guid && !stale) return;
      const key = [normName(l.equipment), normName(l.room), normName(l.area), l.sap, stale ? l.guid : ''].join('|');
      if (!map.has(key)) map.set(key, { key, equipment: l.equipment, room: l.room, area: l.area, sap: l.sap, kind: stale ? 'unknown id' : 'missing id', ids: [] });
      map.get(key).ids.push(l.id);
    });
    const out = [];
    map.forEach(g => {
      const p = nameProfile(g.equipment);
      const roomN = normName(g.room), areaN = normName(g.area);
      const cand = new Map(); // assetId -> { score, reason }
      const bump = (asset, score, reason) => { const c = cand.get(asset.id); if (!c || score > c.score) cand.set(asset.id, { asset, score, reason }); };
      // 1. SAP order
      const sapIds = g.sap ? assetsForCode(g.sap) : [];
      if (sapIds.length === 1 && assetById.get(sapIds[0])) {
        const a = assetById.get(sapIds[0]);
        const sim = p.key || p.full ? nameSimilarity(p, nameProfile(a.name)) : 0;
        if (!g.equipment || sim >= 0.5) bump(a, 0.97, 'SAP order');
        else bump(a, 0.7, 'SAP order (name differs)');
      } else if (sapIds.length > 1) {
        sapIds.forEach(id => { const a = assetById.get(id); const sim = nameSimilarity(p, nameProfile(a.name)); if (sim >= 0.6) bump(a, sim >= 0.8 ? Math.max(sim, 0.96) : Math.max(sim, 0.9), 'SAP order + name'); });
      }
      // 2. Name / room / area similarity
      if (p.full) {
        let pool_ = null;
        p.words.forEach(w => { const s = tokenIndex.get(w); if (s) { pool_ = pool_ || new Set(); s.forEach(i => pool_.add(i)); } });
        (pool_ ? [...pool_].map(i => profiles[i]) : profiles).forEach(x => {
          let s = nameSimilarity(p, x.p);
          if (s < 0.5) return;
          if (roomN && x.room === roomN) s = Math.min(1, s + 0.05);
          if (areaN && x.area === areaN) s = Math.min(1, s + 0.03);
          if (roomN && x.room && x.room !== roomN) s *= 0.9;
          bump(x.asset, s, s >= 0.999 ? 'same name' : 'similar name');
        });
      }
      const ranked = [...cand.values()].sort((a, b) => b.score - a.score).slice(0, 5);
      let tier = ranked.length ? tierOf(ranked[0].score) : 'none';
      const ambiguous = ranked.length > 1 && ranked[0].score - ranked[1].score < 0.02 && ranked[0].score < 0.999;
      if (ambiguous && tier !== 'none') tier = downTier(tier);
      out.push({ ...g, ranked, tier, ambiguous });
    });
    const order = { high: 0, medium: 1, low: 2, none: 3 };
    return out.sort((a, b) => order[a.tier] - order[b.tier] || b.ids.length - a.ids.length);
  }, [logs, assetById, assetsForCode, profiles, tokenIndex]);

  useEffect(() => { if (logs) onScanned(groups.reduce((s, g) => s + g.ids.length, 0)); }, [groups, logs, onScanned]);

  // Pre-select the top suggestion; pre-check only high confidence
  useEffect(() => {
    setChoice(prev => { const n = { ...prev }; groups.forEach(g => { if (n[g.key] === undefined) n[g.key] = g.ranked.length && g.tier !== 'none' ? g.ranked[0].asset.id : ''; }); return n; });
    setApply(prev => { const n = { ...prev }; groups.forEach(g => { if (n[g.key] === undefined) n[g.key] = g.tier === 'high'; }); return n; });
  }, [groups]);

  const selected = groups.filter(g => apply[g.key] && choice[g.key]);
  const selectedRows = selected.reduce((s, g) => s + g.ids.length, 0);
  const totalRows = groups.reduce((s, g) => s + g.ids.length, 0);

  const searchResults = (g) => {
    const q = normName(search[g.key] || '');
    if (q.length < 2) return [];
    return assets.filter(a => normName(`${a.room}${a.area}${a.name}`).includes(q)).slice(0, 15);
  };

  const applySelected = async (only) => {
    const todo = (only || selected).filter(g => choice[g.key]);
    if (!todo.length) return;
    setApplying(true); setResult(null);
    const jobs = todo.flatMap(g => {
      const a = assetById.get(choice[g.key]);
      return g.ids.map(id => ({ id, g, payload: { craa5_equipmentguid: a.id, ...(g.room ? {} : { craa5_room: a.room }), ...(g.area ? {} : { craa5_area: a.area }), ...(g.equipment ? {} : { craa5_equipment: a.name }) } }));
    });
    const res = await pool(jobs, 8, (j) => api.update(LOG_TABLE, j.id, j.payload));
    const failed = res.filter(r => !r.ok);
    setResult({ ok: res.length - failed.length, failed: failed.length, error: failed.length ? errText(failed[0].error) : '' });
    setApplying(false);
    await scan(true);
    if (onApplied) onApplied();
  };

  return (
    <div>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Fix Missing Equipment IDs</Text>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        Log entries need the equipment’s ID (craa5_equipmentguid) so the calendar can match them. This finds entries with no ID, or an ID that no longer exists, and suggests the closest equipment using the SAP order first, then equipment name, room and area (equipment numbers must agree). Nothing is saved until you apply.
      </Text>
      <div className={styles.filterBar}>
        <Select aria-label="Scan scope" value={scope} onChange={(e, d) => setScope(d.value)}>
          <option value="all">All entries</option>
          <option value="year">Last 12 months</option>
        </Select>
        <Button onClick={() => scan()} disabled={scanning}>{scanning ? 'Scanning…' : 'Rescan'}</Button>
        <Button appearance="primary" style={ctaStyle} disabled={applying || !selected.length} onClick={() => applySelected()}>
          Apply {selected.length} selected ({selectedRows} entries)
        </Button>
        <Button disabled={applying || !groups.some(g => g.tier === 'high')} onClick={() => applySelected(groups.filter(g => g.tier === 'high'))}>Apply all high confidence</Button>
        <Checkbox label="Show no-match groups" checked={showAll} onChange={(e, d) => setShowAll(!!d.checked)} />
      </div>
      {scanError && <Text className={styles.errorText} block>Scan failed: {scanError}</Text>}
      {result && <Text className={result.failed ? styles.errorText : styles.okText} block>{result.ok} entries updated{result.failed ? `; ${result.failed} failed (${result.error})` : ''}.</Text>}
      {logs && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{logs.length} entries scanned. {totalRows} need an ID, in {groups.length} distinct equipment groups.</Text>}
      {logs && groups.length === 0 && <Text className={styles.okText} block>Every scanned entry has a valid equipment ID.</Text>}
      {groups.length > 0 && (
        <div style={{ overflowX: 'auto' }}>
          <table className={styles.linesTable}>
            <thead><tr>
              <th className={styles.th}>Apply</th><th className={styles.th}>Logged as</th><th className={styles.th}>Room / Area</th><th className={styles.th}>SAP order</th>
              <th className={styles.th}>Entries</th><th className={styles.th}>Issue</th><th className={styles.th}>Map to</th><th className={styles.th}>Confidence</th>
            </tr></thead>
            <tbody>
              {groups.filter(g => showAll || g.tier !== 'none').map(g => {
                const sr = searchResults(g);
                const options = [...g.ranked.map(r => r.asset), ...sr].filter((a, i, arr) => arr.findIndex(b => b.id === a.id) === i);
                const top = g.ranked.find(r => r.asset.id === choice[g.key]);
                return (
                  <tr key={g.key}>
                    <td className={styles.td}><input type="checkbox" aria-label={`Apply ${g.equipment}`} checked={!!apply[g.key] && !!choice[g.key]} disabled={!choice[g.key]} onChange={(e) => setApply(p => ({ ...p, [g.key]: e.target.checked }))} /></td>
                    <td className={styles.td}><strong>{g.equipment || '(blank)'}</strong></td>
                    <td className={styles.td}>{[g.room, g.area].filter(Boolean).join(' / ')}</td>
                    <td className={styles.td}>{g.sap}</td>
                    <td className={styles.td}>{g.ids.length}</td>
                    <td className={styles.td}><span className={mergeClasses(styles.tag, g.kind === 'unknown id' ? styles.tagBad : styles.tagWarn)}>{g.kind}</span></td>
                    <td className={styles.td} style={{ minWidth: 260 }}>
                      <Select aria-label={`Equipment for ${g.equipment}`} value={choice[g.key] || ''} onChange={(e, d) => { setChoice(p => ({ ...p, [g.key]: d.value })); if (!d.value) setApply(p => ({ ...p, [g.key]: false })); }}>
                        <option value="">No match</option>
                        {options.map(a => <option key={a.id} value={a.id}>{a.name} — {a.room} / {a.area}</option>)}
                      </Select>
                      <Input size="small" aria-label={`Search equipment for ${g.equipment}`} placeholder="Search other equipment…" value={search[g.key] || ''} onChange={(e, d) => setSearch(p => ({ ...p, [g.key]: d.value }))} style={{ marginTop: 4, width: '100%' }} />
                    </td>
                    <td className={styles.td}>
                      {top ? (
                        <span className={mergeClasses(styles.tag, g.tier === 'high' ? styles.tagOk : g.tier === 'none' ? styles.tagBad : styles.tagWarn)}>
                          {TIER_LABEL[g.tier]} · {top.reason}{g.ambiguous ? ' · ambiguous' : ''}
                        </span>
                      ) : choice[g.key] ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>manual</span> : <span className={mergeClasses(styles.tag, styles.tagBad)}>No match</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
};

// --- APP ---
export default function GeneratedComponent(props) {
  const dataApi = props && props.dataApi;
  const styles = useStyles();
  const api = useMemo(() => makeApi(dataApi), [dataApi]);
  const maxDate = useMemo(() => toDateInput(new Date()), []);
  const minDate = useMemo(() => { const d = new Date(); d.setFullYear(d.getFullYear() - 1); return toDateInput(d); }, []);

  const [assets, setAssets] = useState([]);
  const [msRows, setMsRows] = useState([]);
  const dataRef = useRef({ assets: [], msRows: [] });
  const [loading, setLoading] = useState(false);
  const [loadError, setLoadError] = useState('');

  const [activeTab, setActiveTab] = useState('add');
  const [entries, setEntries] = useState([]);
  const [logPageSize, setLogPageSize] = useState(50);
  const [searchTerm, setSearchTerm] = useState('');
  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');
  const [isTableEditMode, setIsTableEditMode] = useState(false);
  const [tableEdits, setTableEdits] = useState({});
  const [selectedLogIds, setSelectedLogIds] = useState(new Set());
  const [tableMessage, setTableMessage] = useState(null);
  const [currentMonth, setCurrentMonth] = useState(() => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1); });
  const [missingIds, setMissingIds] = useState(null);

  const [rows, setRows] = useState([]);
  const [addRowCount, setAddRowCount] = useState(1);
  const [errorMessage, setErrorMessage] = useState('');
  const [successMessage, setSuccessMessage] = useState('');
  const [warnMessage, setWarnMessage] = useState('');
  const [saving, setSaving] = useState(false);
  const refs = useRef({});
  const rowSeq = useRef(0);
  const containerRef = useRef(null);

  const newRow = (shared) => { rowSeq.current += 1; return { key: `r${rowSeq.current}`, date: shared && shared.date, initials: shared && shared.initials }; };
  useEffect(() => { setRows([newRow()]); /* eslint-disable-next-line */ }, []);

  // --- LOAD (everything is cached up front) ---
  const loadRefData = useCallback(async () => {
    const [a, m] = await Promise.all([
      api.query(ASSET_TABLE, { select: ['craa5_aa_assetsid', 'craa5_equipmentidentifier', 'craa5_roomname', 'craa5_areaname'] }),
      api.query(MS_TABLE),
    ]);
    const A = a.map(r => ({ id: r.craa5_aa_assetsid, name: safeString(r.craa5_equipmentidentifier), room: safeString(r.craa5_roomname), area: safeString(r.craa5_areaname) }));
    const M = m.map(r => ({
      id: r.craa5_aa_ms_assetsid,
      equipment: safeString(r.craa5_equipment),
      room: safeString(r.craa5_textroom),
      area: safeString(r.craa5_textarea),
      assetId: r._craa5_asset_value || null,
      codes: CODE_COLS.map(col => ({ col, code: normCode(r[col]) })).filter(c => c.code),
    }));
    dataRef.current = { assets: A, msRows: M };
    setAssets(A); setMsRows(M);
  }, [api]);

  const buildFilter = useCallback(() => {
    const f = [];
    const term = searchTerm.trim().replace(/'/g, "''");
    if (term) f.push(`(startswith(craa5_sap,'${term}') or startswith(craa5_equipment,'${term}') or startswith(craa5_lastcleanedby,'${term}'))`);
    if (startDate) f.push(`craa5_lastcleaned ge ${startDate}T00:00:00Z`);
    if (endDate) f.push(`craa5_lastcleaned lt ${nextDay(endDate)}T00:00:00Z`);
    return f.length ? f.join(' and ') : undefined;
  }, [searchTerm, startDate, endDate]);

  const loadEntries = useCallback(async (filter, pageSize) => {
    const res = await api.query(LOG_TABLE, { select: LOG_SELECT, orderBy: 'craa5_lastcleaned desc', top: pageSize, filter });
    setEntries(res.map(r => ({
      id: r.craa5__log_id, sap: safeString(r.craa5_sap), equipment: safeString(r.craa5_equipment), guid: safeString(r.craa5_equipmentguid),
      room: safeString(r.craa5_room), area: safeString(r.craa5_area), date: dayKey(r.craa5_lastcleaned),
      hours: r.craa5_hoursworked === null || r.craa5_hoursworked === undefined ? null : Number(r.craa5_hoursworked), by: safeString(r.craa5_lastcleanedby),
    })));
  }, [api]);

  const reloadAll = useCallback(async () => {
    setLoading(true); setLoadError('');
    try { await Promise.all([loadRefData(), loadEntries(buildFilter(), logPageSize)]); }
    catch (e) { setLoadError(errText(e)); }
    finally { setLoading(false); }
  }, [loadRefData, loadEntries, buildFilter, logPageSize]);

  useEffect(() => { reloadAll(); /* eslint-disable-next-line */ }, [api]);

  const firstPage = useRef(true);
  useEffect(() => {
    if (firstPage.current) { firstPage.current = false; return; }
    loadEntries(buildFilter(), logPageSize).catch(e => setLoadError(errText(e)));
    // eslint-disable-next-line
  }, [logPageSize]);

  // --- INDEXES ---
  const assetById = useMemo(() => new Map(assets.map(a => [a.id, a])), [assets]);
  const assetsByName = useMemo(() => {
    const m = new Map();
    assets.forEach(a => { const k = normName(a.name); if (!m.has(k)) m.set(k, []); m.get(k).push(a); });
    return m;
  }, [assets]);
  const codeIndex = useMemo(() => {
    const m = new Map();
    msRows.forEach(r => r.codes.forEach(c => {
      if (!m.has(c.code)) m.set(c.code, []);
      m.get(c.code).push({ row: r, col: c.col });
    }));
    return m;
  }, [msRows]);
  const rooms = useMemo(() => [...new Set(assets.map(a => a.room).filter(Boolean))].sort(), [assets]);
  const areas = useMemo(() => [...new Set(assets.map(a => a.area).filter(Boolean))].sort(), [assets]);

  const ctx = useMemo(() => ({
    api, assets, assetById, assetsByName, codeIndex, rooms, areas, dataRef, maxDate, minDate,
    addAsset: (a) => { dataRef.current = { ...dataRef.current, assets: [...dataRef.current.assets, a] }; setAssets(dataRef.current.assets); },
    patchAsset: (a) => { dataRef.current = { ...dataRef.current, assets: dataRef.current.assets.map(x => (x.id === a.id ? a : x)) }; setAssets(dataRef.current.assets); },
    upsertMs: (row) => { const list = dataRef.current.msRows.filter(r => r.id !== row.id).concat(row); dataRef.current = { ...dataRef.current, msRows: list }; setMsRows(list); },
  }), [api, assets, assetById, assetsByName, codeIndex, rooms, areas, maxDate, minDate]);

  // --- ADD ENTRIES ---
  const addRows = (count, shared) => {
    const last = rows.length ? refs.current[rows[rows.length - 1].key] : null;
    const carry = shared || (last && last.getShared && last.getShared());
    setRows(prev => [...prev, ...Array.from({ length: count }, () => newRow(carry))]);
  };

  const handleEnter = (index) => {
    if (index < rows.length - 1) {
      const next = containerRef.current && containerRef.current.querySelector(`[data-row="${index + 1}"][data-col="sap"]`);
      if (next) next.focus();
    } else addRows(1);
  };

  const submitAll = async () => {
    setErrorMessage(''); setSuccessMessage(''); setWarnMessage('');
    for (let i = 0; i < rows.length; i++) {
      const h = refs.current[rows[i].key];
      const err = h ? h.validate() : 'Row is not ready.';
      if (err) { setErrorMessage(`Row ${i + 1}: ${err}`); return; }
    }
    setSaving(true);
    const done = [];
    const notes = [];
    let saved = 0;
    let lastShared = null;
    let failure = '';
    for (let i = 0; i < rows.length; i++) {
      const h = refs.current[rows[i].key];
      lastShared = h.getShared();
      const res = await h.commit();
      saved += res.saved || 0;
      (res.notes || []).forEach(n => notes.push(`Row ${i + 1}: ${n}`));
      if (res.error) { failure = `Row ${i + 1}: ${res.error}`; if (!res.saved) break; }
      done.push(rows[i].key);
      if (res.error) break;
    }
    setRows(prev => { const rest = prev.filter(r => !done.includes(r.key)); return rest.length ? rest : [newRow(lastShared)]; });
    if (failure) setErrorMessage(failure);
    else setSuccessMessage(`Saved ${saved} log ${saved === 1 ? 'entry' : 'entries'}.`);
    if (notes.length) setWarnMessage(notes.join(' '));
    setSaving(false);
    try { await loadRefData(); await loadEntries(buildFilter(), logPageSize); } catch (e) { setLoadError(errText(e)); }
  };

  // --- LOG TABLE ---
  const applyFilters = () => { setLogPageSize(50); loadEntries(buildFilter(), 50).catch(e => setLoadError(errText(e))); };
  const clearFilters = () => { setSearchTerm(''); setStartDate(''); setEndDate(''); setLogPageSize(50); loadEntries(undefined, 50).catch(e => setLoadError(errText(e))); };
  const handleGridEdit = (id, field, value) => setTableEdits(p => ({ ...p, [id]: { ...p[id], [field]: value } }));

  const saveBatchEdits = async () => {
    const jobs = [];
    for (const [id, c] of Object.entries(tableEdits)) {
      const payload = {};
      if (c.sap !== undefined) payload.craa5_sap = normCode(c.sap);
      if (c.date !== undefined) {
        if (!c.date || c.date > maxDate) { setTableMessage({ kind: 'error', text: 'Dates cannot be blank or in the future.' }); return; }
        payload.craa5_lastcleaned = toLogDate(c.date);
      }
      if (c.hours !== undefined) {
        if (!(c.hours > 0)) { setTableMessage({ kind: 'error', text: 'Hours must be greater than 0.' }); return; }
        payload.craa5_hoursworked = c.hours;
      }
      if (c.by !== undefined) {
        const ini = normalizeInitials(c.by);
        if (!INITIALS_RE.test(ini)) { setTableMessage({ kind: 'error', text: `Initials "${c.by}" are not valid (e.g. EL/LH).` }); return; }
        payload.craa5_lastcleanedby = ini;
      }
      if (Object.keys(payload).length) jobs.push({ id, payload });
    }
    const res = await pool(jobs, 8, (j) => api.update(LOG_TABLE, j.id, j.payload));
    const failed = res.filter(r => !r.ok);
    if (failed.length) setTableMessage({ kind: 'error', text: `${failed.length} of ${jobs.length} updates failed: ${errText(failed[0].error)}` });
    else { setTableMessage({ kind: 'ok', text: `Updated ${jobs.length} entries.` }); setTableEdits({}); setIsTableEditMode(false); }
    await loadEntries(buildFilter(), logPageSize);
  };

  const batchDelete = async () => {
    if (!selectedLogIds.size) return;
    if (!window.confirm(`Are you sure you want to permanently delete ${selectedLogIds.size} records from Dataverse?`)) return;
    const res = await pool([...selectedLogIds], 8, (id) => api.remove(LOG_TABLE, id));
    const failed = res.filter(r => !r.ok);
    setTableMessage(failed.length ? { kind: 'error', text: `${failed.length} deletes failed: ${errText(failed[0].error)}` } : { kind: 'ok', text: `Deleted ${res.length} entries.` });
    setSelectedLogIds(new Set());
    await loadEntries(buildFilter(), logPageSize);
  };

  const metrics = useMemo(() => {
    let total = 0;
    const orders = new Set();
    const byInitials = {};
    entries.forEach(e => {
      const h = e.hours || 0;
      total += h;
      if (e.sap) orders.add(e.sap);
      const k = (e.by || 'Unknown').toUpperCase();
      byInitials[k] = (byInitials[k] || 0) + h;
    });
    return {
      total: total.toFixed(1), orders: orders.size, count: entries.length,
      noId: entries.filter(e => !e.guid || !assetById.has(e.guid)).length,
      byInitials: Object.entries(byInitials).sort((a, b) => b[1] - a[1]),
    };
  }, [entries, assetById]);

  const idStatus = (e) => (!e.guid ? 'missing' : assetById.size && !assetById.has(e.guid) ? 'unknown' : 'ok');

  const renderTable = () => {
    const cols = [
      createTableColumn({ columnId: 'select',
        renderHeaderCell: () => (<input type="checkbox" aria-label="Select all" checked={selectedLogIds.size > 0 && selectedLogIds.size === entries.length}
          onChange={(e) => setSelectedLogIds(e.target.checked ? new Set(entries.map(x => x.id)) : new Set())} />),
        renderCell: (item) => (<input type="checkbox" aria-label={`Select ${item.equipment}`} checked={selectedLogIds.has(item.id)}
          onChange={(e) => { const n = new Set(selectedLogIds); if (e.target.checked) n.add(item.id); else n.delete(item.id); setSelectedLogIds(n); }} />) }),
      createTableColumn({ columnId: 'sap', renderHeaderCell: () => 'SAP Order',
        renderCell: (item) => isTableEditMode ? <Input value={tableEdits[item.id]?.sap ?? item.sap} onChange={(e, d) => handleGridEdit(item.id, 'sap', d.value)} /> : <Text>{item.sap}</Text> }),
      createTableColumn({ columnId: 'equipment', renderHeaderCell: () => 'Equipment', renderCell: (item) => <Text>{item.equipment || '...'}</Text> }),
      createTableColumn({ columnId: 'room', renderHeaderCell: () => 'Room', renderCell: (item) => <Text>{item.room || '...'}</Text> }),
      createTableColumn({ columnId: 'area', renderHeaderCell: () => 'Area', renderCell: (item) => <Text>{item.area || '...'}</Text> }),
      createTableColumn({ columnId: 'date', renderHeaderCell: () => 'Date of Clean',
        renderCell: (item) => isTableEditMode ? <Input type="date" max={maxDate} value={tableEdits[item.id]?.date ?? item.date} onChange={(e, d) => handleGridEdit(item.id, 'date', d.value)} /> : <Text>{item.date}</Text> }),
      createTableColumn({ columnId: 'hours', renderHeaderCell: () => 'Hours Worked',
        renderCell: (item) => isTableEditMode ? <Input type="number" value={String(tableEdits[item.id]?.hours ?? item.hours ?? '')} onChange={(e, d) => handleGridEdit(item.id, 'hours', d.value ? parseFloat(d.value) : null)} /> : <Text>{item.hours ?? ''}</Text> }),
      createTableColumn({ columnId: 'by', renderHeaderCell: () => 'Initials',
        renderCell: (item) => isTableEditMode ? <Input value={tableEdits[item.id]?.by ?? item.by} onChange={(e, d) => handleGridEdit(item.id, 'by', d.value)} /> : <Text>{item.by}</Text> }),
      createTableColumn({ columnId: 'id', renderHeaderCell: () => 'Equipment ID',
        renderCell: (item) => { const s = idStatus(item); return <span className={mergeClasses(styles.tag, s === 'ok' ? styles.tagOk : s === 'missing' ? styles.tagWarn : styles.tagBad)}>{s === 'ok' ? 'linked' : s === 'missing' ? 'missing' : 'unknown'}</span>; } }),
    ];
    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
        <div className={styles.filterBar}>
          <Input aria-label="Search" placeholder="Search order, equipment or initials…" value={searchTerm} onChange={(e, d) => setSearchTerm(d.value)} style={{ minWidth: '200px' }} />
          <Input type="date" aria-label="Start date" value={startDate} onChange={(e, d) => setStartDate(d.value)} />
          <Input type="date" aria-label="End date" value={endDate} onChange={(e, d) => setEndDate(d.value)} />
          <Button appearance="primary" style={primaryStyle} onClick={applyFilters}>Apply Filters</Button>
          <Button onClick={clearFilters}>Clear Filters</Button>
        </div>
        <div className={styles.actionBar}>
          {!isTableEditMode ? <Button onClick={() => setIsTableEditMode(true)}>✏️ Batch Edit Mode</Button> : (
            <>
              <Button appearance="primary" style={primaryStyle} onClick={saveBatchEdits}>💾 Save Changes</Button>
              <Button onClick={() => { setIsTableEditMode(false); setTableEdits({}); }}>❌ Cancel Edits</Button>
            </>
          )}
          <Button appearance="primary" style={selectedLogIds.size ? dangerStyle : undefined} disabled={!selectedLogIds.size} onClick={batchDelete}>🗑️ Delete Selected ({selectedLogIds.size})</Button>
        </div>
        {tableMessage && <Text className={tableMessage.kind === 'ok' ? styles.okText : styles.errorText} block>{tableMessage.text}</Text>}
        <div style={{ maxHeight: '60vh', overflow: 'auto', border: `1px solid ${BRAND.line}`, borderRadius: '4px' }}>
          <DataGrid items={entries} columns={cols} getRowId={(item) => item.id}>
            <DataGridHeader><DataGridRow>{({ renderHeaderCell }) => <DataGridHeaderCell>{renderHeaderCell()}</DataGridHeaderCell>}</DataGridRow></DataGridHeader>
            <DataGridBody>{({ item }) => (<DataGridRow key={item.id}>{({ renderCell }) => <DataGridCell>{renderCell(item)}</DataGridCell>}</DataGridRow>)}</DataGridBody>
          </DataGrid>
        </div>
        <div style={{ display: 'flex', justifyContent: 'center' }}>
          <Button onClick={() => setLogPageSize(p => p + 50)}>Load More Entries</Button>
        </div>
      </div>
    );
  };

  const renderDashboard = () => (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
      <div className={styles.dashboardGrid}>
        {[['Total Hours Logged', metrics.total, BRAND.blue], ['Unique SAP Orders', metrics.orders, BRAND.yellow], ['Loaded Log Entries', metrics.count, BRAND.logoBlue], ['Entries Missing Equipment ID', metrics.noId, BRAND.red]].map(([label, value, color]) => (
          <div key={label} className={styles.metricCard} style={{ borderTop: `4px solid ${color}` }}>
            <Text className={styles.metricLabel}>{label}</Text>
            <Text className={styles.metricValue}>{value}</Text>
          </div>
        ))}
      </div>
      <div className={styles.listCard}>
        <Text size={500} weight="semibold" block style={{ marginBottom: 12 }}>Hours Logged by Person (Initials)</Text>
        <div style={{ maxHeight: 400, overflowY: 'auto', paddingRight: 8 }}>
          {metrics.byInitials.length ? metrics.byInitials.map(([ini, h]) => (
            <div key={ini} className={styles.listItem}><Text weight="semibold">{ini}</Text><Text>{h.toFixed(1)} Hours</Text></div>
          )) : <Text>No entries loaded yet. Adjust your filters or load data.</Text>}
        </div>
      </div>
    </div>
  );

  const renderCalendar = () => {
    const y = currentMonth.getFullYear(), m = currentMonth.getMonth();
    const startDay = new Date(y, m, 1).getDay();
    const days = new Date(y, m + 1, 0).getDate();
    const cells = [...Array.from({ length: startDay }, () => null), ...Array.from({ length: days }, (_, i) => `${y}-${String(m + 1).padStart(2, '0')}-${String(i + 1).padStart(2, '0')}`)];
    const byDay = {};
    entries.forEach(e => { if (e.date) (byDay[e.date] = byDay[e.date] || []).push(e); });
    return (
      <div>
        <div className={styles.calHeader}>
          <Button onClick={() => setCurrentMonth(new Date(y, m - 1, 1))}>Previous</Button>
          <Text weight="semibold">{currentMonth.toLocaleString('default', { month: 'long', year: 'numeric' })}</Text>
          <Button onClick={() => setCurrentMonth(new Date(y, m + 1, 1))}>Next</Button>
        </div>
        <div className={styles.calGrid}>
          {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => <div key={d} className={styles.weekday}>{d}</div>)}
          {cells.map((k, i) => (
            <div key={k || `e${i}`} className={mergeClasses(styles.dayCell, k === maxDate && styles.dayCellToday)}>
              {k && <div style={{ fontWeight: 700, marginBottom: 4 }}>{Number(k.slice(8))}</div>}
              {(k && byDay[k] || []).map(e => <div key={e.id} className={styles.entryText} title={`${e.equipment} · ${e.by}`}>{e.equipment || e.sap} · {e.by}</div>)}
            </div>
          ))}
        </div>
        <Text className={styles.hint} block style={{ marginTop: 8 }}>Showing the loaded entries. Use the Log Table filters or “Load More” to bring in other dates.</Text>
      </div>
    );
  };

  const tabs = [['add', 'Add Log Entries'], ['table', 'Log Table'], ['dashboard', 'Dashboard'], ['calendar', 'Calendar'], ['fix', `Fix Missing IDs${missingIds ? ` (${missingIds})` : ''}`]];

  return (
    <FluentProvider theme={THEME} style={{ background: 'transparent', minHeight: '100%' }}>
      <div className={styles.root}>
        <div className={styles.header}>
          <div className={styles.title}>
            <span className={styles.titleMain}>MSS Log Input</span>
            <span className={styles.titleSub}>
              {loading ? 'Loading…' : `${assets.length} equipment · ${codeIndex.size} SAP orders cached`}
              {api.mode === 'preview' ? ' · preview data (no Dataverse connection)' : ''}
            </span>
          </div>
          <div className={styles.logo}><BrandLogo /></div>
        </div>

        <TabList selectedValue={activeTab} onTabSelect={(_, d) => setActiveTab(d.value)} className={styles.navBar}>
          {tabs.map(([v, label]) => (
            <Tab key={v} value={v} className={mergeClasses(styles.tab, activeTab === v && styles.activeTab)}>{label}</Tab>
          ))}
        </TabList>

        {loadError && <Text className={styles.errorText} block>Could not load Dataverse data: {loadError}</Text>}

        <div className={styles.mainContent}>
          {activeTab === 'add' && (
            <>
              <div className={styles.sidebar}>
                <Text size={500} className={styles.sidebarTitle} block>Recent Log Entries</Text>
                <ul style={{ paddingLeft: 18, margin: 0 }}>
                  {entries.slice(0, 10).map(e => (
                    <li key={e.id} style={{ marginBottom: 6, fontSize: 13 }}>
                      {e.date} · <strong>{e.sap || e.equipment}</strong> {e.sap && e.equipment ? `(${e.equipment})` : ''} — {e.by}
                    </li>
                  ))}
                  {!entries.length && <li style={{ listStyle: 'none', marginLeft: -18 }}>No entries yet.</li>}
                </ul>
              </div>
              <div className={styles.contentArea}>
                <Text size={600} weight="semibold" block className={styles.sectionTitle}>Add Log Entries</Text>
                <div ref={containerRef} style={{ display: 'flex', flexDirection: 'column', gap: 14, width: '100%' }}>
                  {rows.map((r, i) => (
                    <EntryRow key={r.key} ref={(el) => { if (el) refs.current[r.key] = el; else delete refs.current[r.key]; }}
                      ctx={ctx} index={i} initialDate={r.date} initialInitials={r.initials} canRemove={rows.length > 1}
                      onEnter={handleEnter} onRemove={() => setRows(prev => prev.filter(x => x.key !== r.key))} />
                  ))}
                  {errorMessage && <Text className={styles.errorText} block role="alert">{errorMessage}</Text>}
                  {successMessage && <Text className={styles.okText} block role="status">{successMessage}</Text>}
                  {warnMessage && <Text className={styles.warnText} block role="status">{warnMessage}</Text>}
                  <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                    <Input aria-label="Rows to add" type="number" min={1} value={String(addRowCount)} onChange={(e, d) => setAddRowCount(parseInt(d.value, 10) || 1)} style={{ width: 70 }} />
                    <Button onClick={() => addRows(addRowCount)}>Add More Rows</Button>
                  </div>
                  <Button appearance="primary" size="large" disabled={saving || loading} onClick={submitAll} style={{ ...ctaStyle, maxWidth: 300 }}>
                    {saving ? 'Saving…' : 'Submit All Records'}
                  </Button>
                </div>
              </div>
            </>
          )}
          {activeTab === 'table' && (
            <div className={styles.contentArea}>
              <Text size={600} weight="semibold" block className={styles.sectionTitle}>Log Table</Text>
              {renderTable()}
            </div>
          )}
          {activeTab === 'dashboard' && (
            <div className={styles.contentArea}>
              <Text size={600} weight="semibold" block className={styles.sectionTitle}>Dashboard Metrics</Text>
              {renderDashboard()}
            </div>
          )}
          {activeTab === 'calendar' && (
            <div className={styles.contentArea}>
              <Text size={600} weight="semibold" block className={styles.sectionTitle}>Calendar View</Text>
              {renderCalendar()}
            </div>
          )}
          {activeTab === 'fix' && (
            <div className={styles.contentArea}>
              <FixIdsTab ctx={ctx} onScanned={setMissingIds} onApplied={() => loadEntries(buildFilter(), logPageSize)} />
            </div>
          )}
        </div>
      </div>
    </FluentProvider>
  );
}
