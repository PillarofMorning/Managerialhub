const splitHours = (total, n) => {
  if (!n || !(total > 0)) return [];
  const each = Math.floor((total / n) * 100) / 100;
  const out = Array(n).fill(each);
  out[n - 1] = Math.round((total - each * (n - 1)) * 100) / 100;
  return out;
};

// Run fn over items with a small concurrency limit; never rejects, returns [{ok, value|error}].
const pool = async (items, limit, fn) => {
  const out = new Array(items.length);
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      try { out[i] = { ok: true, value: await fn(items[i], i) }; } catch (e) { out[i] = { ok: false, error: e }; }
    }
  };
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
  return out;
};

// --- EQUIPMENT NAME SIMILARITY (digit aware: "Mixer 1" = "Mixer 01", "Mixer 1" != "Mixer 2") ---
const tokenize = (s) => safeString(s).toLowerCase()
  .replace(/([a-z])(\d)/g, '$1 $2').replace(/(\d)([a-z])/g, '$1 $2')
  .split(/[^a-z0-9]+/).filter(Boolean);
const bigrams = (s) => {
  const t = ` ${s} `;
  const m = new Map();
  for (let i = 0; i < t.length - 1; i++) { const g = t.slice(i, i + 2); m.set(g, (m.get(g) || 0) + 1); }
  return m;
};
const dice = (a, b) => {
  if (!a.size || !b.size) return 0;
  let inter = 0, ta = 0, tb = 0;
  a.forEach(v => { ta += v; });
  b.forEach(v => { tb += v; });
  a.forEach((v, g) => { if (b.has(g)) inter += Math.min(v, b.get(g)); });
  return (2 * inter) / (ta + tb);
};
const nameProfile = (name) => {
  const t = tokenize(name);
  const nums = t.filter(x => /^\d+$/.test(x)).map(x => String(parseInt(x, 10)));
  const words = t.filter(x => !/^\d+$/.test(x));
  const key = words.join('');
  return { words, nums: nums.join(','), hasNums: nums.length > 0, key, full: normName(name), grams: bigrams(key) };
};
const nameSimilarity = (p, q) => {
  if (p.full && p.full === q.full) return 1;
  const w = p.key && q.key ? (p.key === q.key ? 1 : dice(p.grams, q.grams)) : 0;
  let n;
  if (!p.hasNums && !q.hasNums) n = 1;
  else if (p.nums === q.nums) n = 1;
  else if (!p.hasNums || !q.hasNums) n = 0.75;
  else n = 0.4;
  return w * n;
};
const tierOf = (score) => (score >= 0.95 ? 'high' : score >= 0.8 ? 'medium' : score >= 0.6 ? 'low' : 'none');
const TIER_LABEL = { high: 'High', medium: 'Medium', low: 'Low', none: 'No match' };
const downTier = (t) => (t === 'high' ? 'medium' : t === 'medium' ? 'low' : t);

