// A saved-at time in local time, e.g. 2026-10-07 14:32
const stampText = (v) => {
  const d = new Date(safeString(v));
  if (!safeString(v) || Number.isNaN(d.getTime())) return '';
  return `${toDateInput(d)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
};

// --- EQUIPMENT NAME SIMILARITY (digit aware: "Mixer 1" = "Mixer 01", "Mixer 1" != "Mixer 2") ---
const tokenize = (s) => safeString(s).toLowerCase()
  .replace(/([a-z])(\d)/g, '$1 $2').replace(/(\d)([a-z])/g, '$1 $2')
  .split(/[^a-z0-9]+/).filter(Boolean);
// Canonical name: words and numbers kept apart, leading zeros dropped ("Mixer-01" -> "mixer 1")
const canonName = (s) => tokenize(s).map(x => (/^\d+$/.test(x) ? String(parseInt(x, 10)) : x)).join(' ');
const bigrams = (s) => {
  const t = ` ${s} `;
  const m = new Map();
  for (let i = 0; i < t.length - 1; i++) { const g = t.slice(i, i + 2); m.set(g, (m.get(g) || 0) + 1); }
  return m;
};
const dice = (a, b) => {
  if (!a.size || !b.size) return 0;
  let inter = 0, ta = 0, tb = 0;
  a.forEach(v => { ta += v; });
  b.forEach(v => { tb += v; });
  a.forEach((v, g) => { if (b.has(g)) inter += Math.min(v, b.get(g)); });
  return (2 * inter) / (ta + tb);
};
const nameProfile = (name) => {
  const t = tokenize(name);
  const nums = t.filter(x => /^\d+$/.test(x)).map(x => String(parseInt(x, 10)));
  const words = t.filter(x => !/^\d+$/.test(x));
  const key = words.join('');
  const stem = words.map(w => (w.length > 3 ? w.replace(/s$/, '') : w)).join('');
  return { words, numList: nums, nums: nums.join(','), hasNums: nums.length > 0, key, stem, full: canonName(name), grams: bigrams(key) };
};
// 1 = the same name. Any other name scores at most 0.94, so only an identical name can reach High.
const nameSimilarity = (p, q) => {
  if (p.full && p.full === q.full) return 1;
  if (!p.key || !q.key) return 0;
  let n;
  if (!p.hasNums && !q.hasNums) n = 1;
  else if (p.nums === q.nums) n = 1;
  else if (!p.hasNums || !q.hasNums) n = 0.75;
  else n = 0.4;
  let w = p.key === q.key ? 0.94 : p.stem === q.stem ? 0.93 : dice(p.grams, q.grams);
  // every word of one name appears in the other ("Floors" / "Floors drains")
  const [a, b] = p.words.length <= q.words.length ? [p.words, q.words] : [q.words, p.words];
  if (a.length && a.some(x => x.length >= 3) && a.every(x => b.includes(x))) w = Math.max(w, 0.82);
  return Math.min(0.94, w * n);
};
const tierOf = (score) => (score >= 0.95 ? 'high' : score >= 0.8 ? 'medium' : score >= 0.6 ? 'low' : 'none');
const TIER_LABEL = { high: 'High', medium: 'Medium', low: 'Low', none: 'No match', manual: 'Manual', linked: 'Linked' };
const downTier = (t) => (t === 'high' ? 'medium' : t === 'medium' ? 'low' : t);

// Rooms and areas compare with numbers kept apart, so "Line 1-2" is not "Line 12"
const placeKey = (s) => canonName(s);
const samePlace = (a, b) => placeKey(a) === placeKey(b);
// Room and area of a candidate agree with what the entry or SAP row says (a blank on either side is not a disagreement).
const placeOk = (want, asset) =>
  (!placeKey(want.room) || !placeKey(asset.room) || samePlace(want.room, asset.room))
  && (!placeKey(want.area) || !placeKey(asset.area) || samePlace(want.area, asset.area));
// Name similarity with room and area agreement: a different room or area keeps a candidate out of any automatic pick.
const scoreAsset = (want, asset, p = nameProfile(want.equipment)) => {
  let s = nameSimilarity(p, nameProfile(asset.name));
  const wr = placeKey(want.room), wa = placeKey(want.area), ar = placeKey(asset.room), aa = placeKey(asset.area);
  if (wr && ar && wr !== ar) s *= 0.5;
  else if (wr && !ar) s *= 0.9;
  if (wa && aa && wa !== aa) s *= 0.55;
  else if (wa && !aa) s *= 0.9;
  return s;
};
const reasonText = (c) => [c.reason, c.support ? `${plural(c.support, 'earlier entry', 'earlier entries')}` : ''].filter(Boolean).join(' · ');
const placeText = (a) => [a.room, a.area].filter(Boolean).join(' / ');

// Log entries that are the same equipment as a group: the same name (case, spacing and leading zeros aside) in the same
// room and the same area. A blank room or area only matches blank, because names like "Floors" exist in many rooms.
const familyKey = (g) => [canonName(g.equipment), placeKey(g.room), placeKey(g.area)].join('|');
const inFamily = (g, r) => canonName(r.craa5_equipment) === canonName(g.equipment) && samePlace(r.craa5_room, g.room) && samePlace(r.craa5_area, g.area);
// Bulk picks need room and area filled in on the entry and the same on the equipment
const sameRoomAndArea = (g, a) => !!(a && placeKey(g.room) && placeKey(g.area)) && samePlace(g.room, a.room) && samePlace(g.area, a.area);
// A room or area as it may be written (every spelling seen in the list), or blank
const placeFilter = (col, values) => {
  const vs = Array.from(new Set([].concat(values).map(safeString).filter(v => placeKey(v))));
  return vs.length ? `(${vs.map(v => ciEq(col, v)).join(' or ')})` : `(${col} eq null or ${col} eq '')`;
};
// Server filter for a family: every word and number of the name, and the room and area (the exact name is checked after)
const familyFilter = (g, places) => {
  const p = nameProfile(g.equipment);
  const name = p.words.slice(0, 4).map(w => ciContains('craa5_equipment', w)).concat(p.numList.slice(0, 2).map(n => `contains(craa5_equipment,'${n}')`));
  return name.concat([placeFilter('craa5_room', places ? places.rooms : g.room), placeFilter('craa5_area', places ? places.areas : g.area)]).join(' and ');
};
const LINKED = `craa5_equipmentguid ne null and craa5_equipmentguid ne ''`;
const EVIDENCE_SELECT = ['craa5__log_id', 'craa5_equipment', 'craa5_equipmentguid', 'craa5_room', 'craa5_area'];
const uniqueRows = (rows) => Array.from(new Map(rows.map(r => [r.craa5__log_id, r])).values());

// --- DATA ACCESS (Xrm.WebApi, Power Apps dataApi, or an in-memory preview) ---
// Every query takes a row limit (default 100). There is deliberately no "load everything" call.

// Tiny OData $filter evaluator so the preview data answers the same filters Dataverse does
// (eq/ne/gt/ge/lt/le, and/or/not, contains/startswith/endswith, null). Text compares ignore case unless cs is set.
const parseFilter = (src, cs = false) => {
  const toks = src.match(/'(?:[^']|'')*'|[()]|,|[^\s(),']+/g) || [];
  let i = 0;
  const next = () => toks[i++];
  const lit = (t) => (t === 'null' ? null : t[0] === "'" ? t.slice(1, -1).replace(/''/g, "'") : t);
  const fold = (x) => (cs ? x : x.toLowerCase());
  const norm = (x) => (x === undefined || x === null || x === '' ? null : fold(String(x)));
  const orExpr = () => {
    let l = andExpr();
    while (toks[i] === 'or') { next(); const a = l, b = andExpr(); l = (r) => a(r) || b(r); }
    return l;
  };
  const andExpr = () => {
    let l = unary();
    while (toks[i] === 'and') { next(); const a = l, b = unary(); l = (r) => a(r) && b(r); }
    return l;
  };
  const unary = () => {
    const t = next();
    if (t === 'not') { const f = unary(); return (r) => !f(r); }
    if (t === '(') { const f = orExpr(); next(); return f; }
    if (t === 'contains' || t === 'startswith' || t === 'endswith') {
      next(); const col = next(); next(); const v = fold(String(lit(next()))); next();
      return (r) => { const s = fold(safeString(r[col])); return t === 'contains' ? s.includes(v) : t === 'startswith' ? s.startsWith(v) : s.endsWith(v); };
    }
    const op = next(); const v = norm(lit(next()));
    return (r) => {
      const a = norm(r[t]);
      if (op === 'eq') return a === v;
      if (op === 'ne') return a !== v;
      if (a === null || v === null) return false;
      return op === 'gt' ? a > v : op === 'ge' ? a >= v : op === 'lt' ? a < v : a <= v;
    };
  };
  return orExpr();
};

