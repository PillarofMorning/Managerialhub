// --- EQUIPMENT PICKER: server search as you type, small result list ---
const AssetPicker = ({ store, onPick, exclude, initialQuery = '', ariaLabel = 'Search equipment', actionLabel = 'Add', placeholder = 'Start typing a name, room or area…' }) => {
  const styles = useStyles();
  const [q, setQ] = useState(initialQuery);
  const [res, setRes] = useState([]);
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState('');

  useEffect(() => {
    if (q.trim().length < 2) { setRes([]); setErr(''); setBusy(false); return undefined; }
    let live = true;
    setBusy(true);
    const t = setTimeout(async () => {
      try { const r = await store.searchAssets(q); if (live) { setRes(r); setErr(''); } }
      catch (e) { if (live) setErr(errText(e)); }
      finally { if (live) setBusy(false); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [q, store]);

  const shown = res.filter(a => !exclude || !exclude.has(a.id));
  return (
    <div>
      <div className={styles.field} style={{ maxWidth: 420 }}>
        <Input aria-label={ariaLabel} autoComplete="off" placeholder={placeholder} value={q} onChange={(e, d) => setQ(d.value)} />
      </div>
      {busy && <Text className={styles.hint} block style={{ marginTop: 6 }}>Searching…</Text>}
      {err && <Text className={styles.errorText} block>{err}</Text>}
      {!busy && !err && q.trim().length >= 2 && shown.length === 0 && <Text className={styles.hint} block style={{ marginTop: 6 }}>No matching equipment.</Text>}
      {shown.length > 0 && (
        <>
          <table className={styles.linesTable}>
            <tbody>
              {shown.map(a => (
                <tr key={a.id}>
                  <td className={styles.td}><strong>{a.name}</strong></td><td className={styles.td}>{a.room}</td><td className={styles.td}>{a.area}</td>
                  <td className={styles.td} style={{ textAlign: 'right' }}><Button size="small" appearance="primary" style={primaryStyle} onClick={() => onPick(a)}>{actionLabel}</Button></td>
                </tr>
              ))}
            </tbody>
          </table>
          {res.length >= LIMITS.assetSearch && <Text className={styles.hint} block style={{ marginTop: 4 }}>Showing the first {LIMITS.assetSearch}. Type more to narrow it down.</Text>}
        </>
      )}
    </div>
  );
};

// Room / area suggestions while typing (server search, cached)
const useSuggest = (store, col, text, ctxRoom) => {
  const [opts, setOpts] = useState([]);
  useEffect(() => {
    const t = safeString(text);
    if (t.length < 2) { setOpts([]); return undefined; }
    let live = true;
    const h = setTimeout(() => { store.suggestField(col, t, ctxRoom).then(v => { if (live) setOpts(v); }).catch(() => {}); }, 250);
    return () => { live = false; clearTimeout(h); };
  }, [store, col, text, ctxRoom]);
  return opts;
};

// --- ENTRY ROW: one SAP order, one or more equipment ---
const EntryRow = forwardRef(function EntryRow({ ctx, index, initialDate, initialInitials, onRemove, onEnter, canRemove }, ref) {
  const styles = useStyles();
  const { api, store, maxDate, minDate } = ctx;

  const [code, setCode] = useState('');
  const [showSuggest, setShowSuggest] = useState(false);
  const [hi, setHi] = useState(0);
  const [sugg, setSugg] = useState({ items: [], truncated: false, busy: false, error: '' });
  const [order, setOrder] = useState(null);          // { status, code, entries, capped, error }
  const [dateStr, setDateStr] = useState(initialDate || maxDate);
  const [initials, setInitials] = useState(initialInitials || '');
  const [totalHours, setTotalHours] = useState('');
  const [photo, setPhoto] = useState(null);
  const [photoName, setPhotoName] = useState('');
  const [excluded, setExcluded] = useState({});
  const [pickedAsset, setPickedAsset] = useState({});
  const [hoursOverride, setHoursOverride] = useState({});
  const [editMode, setEditMode] = useState(false);
  const [edits, setEdits] = useState({});            // lineKey -> { name, room, area }
  const [dupes, setDupes] = useState(new Set());
  const [extras, setExtras] = useState([]);
  const [addOpen, setAddOpen] = useState(false);
  const [addMode, setAddMode] = useState('search');
  const [addFreq, setAddFreq] = useState('craa5_sapw');
  const [newRoom, setNewRoom] = useState('');
  const [newArea, setNewArea] = useState('');
  const [newName, setNewName] = useState('');
  const [typing, setTyping] = useState({ room: '', area: '', roomCtx: '' });
  const [note, setNote] = useState('');
  const seq = useRef(0);

  const normalizedCode = normCode(code);
  const ready = !!order && order.status === 'ready' && order.code === normalizedCode;
  const matches = useMemo(() => (ready ? order.entries : []), [ready, order]);

  // Order suggestions: debounced server search, only while the box is open
  useEffect(() => {
    if (!showSuggest || normalizedCode.length < 2) { setSugg(s => (s.items.length || s.busy || s.error ? { items: [], truncated: false, busy: false, error: '' } : s)); return undefined; }
    let live = true;
    setSugg(s => ({ ...s, busy: true }));
    const t = setTimeout(async () => {
      try { const r = await store.searchOrders(normalizedCode); if (live) setSugg({ items: r.items, truncated: r.truncated, busy: false, error: '' }); }
      catch (e) { if (live) setSugg({ items: [], truncated: false, busy: false, error: errText(e) }); }
    }, 250);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, showSuggest, store]);

  // Load the typed/selected order (exact, not case sensitive) once typing pauses
  useEffect(() => {
    if (normalizedCode.length < 3) { setOrder(null); return undefined; }
    let live = true;
    setOrder({ status: 'loading', code: normalizedCode, entries: [] });
    const t = setTimeout(async () => {
      try { const r = await store.loadOrder(normalizedCode); if (live) setOrder({ status: 'ready', ...r }); }
      catch (e) { if (live) setOrder({ status: 'error', code: normalizedCode, entries: [], error: errText(e) }); }
    }, 350);
    return () => { live = false; clearTimeout(t); };
  }, [normalizedCode, store]);

  const suggestions = sugg.items;
  const suggestOpen = showSuggest && normalizedCode.length >= 2 && !(suggestions.length === 1 && suggestions[0].code === normalizedCode && !sugg.busy);

  const clearOrderState = () => {
    setExcluded({}); setPickedAsset({}); setHoursOverride({}); setExtras([]); setEdits({});
    setAddOpen(false); setEditMode(false); setNote('');
  };
  const selectCode = (c) => { setCode(c); setShowSuggest(false); clearOrderState(); };

  // Lines: one per equipment on the order
  const lines = useMemo(() => {
    const seen = new Set();
    const out = [];
    matches.forEach((e) => {
      let asset = e.asset;
      let how = e.how;
      if (!asset && pickedAsset[e.key]) { asset = pickedAsset[e.key]; how = 'picked'; }
      if (asset) {
        if (seen.has(asset.id)) return;
        seen.add(asset.id);
      }
      out.push({ key: e.key, msId: e.msId, col: e.col, how, asset, name: asset ? asset.name : e.equipment, room: asset ? asset.room : e.room, area: asset ? asset.area : e.area });
    });
    extras.forEach(x => {
      if (!x.asset.isNew && seen.has(x.asset.id)) return;
      if (!x.asset.isNew) seen.add(x.asset.id);
      out.push({ key: x.key, msId: null, col: x.col, how: x.asset.isNew ? 'new equipment' : 'added', asset: x.asset, name: x.asset.name, room: x.asset.room, area: x.asset.area, extra: true });
    });
    // Apply "edit pre-filled details" overrides
    return out.map(l => (edits[l.key] ? { ...l, name: edits[l.key].name, room: edits[l.key].room, area: edits[l.key].area } : l));
  }, [matches, pickedAsset, extras, edits]);

  const takenIds = useMemo(() => new Set(lines.map(l => l.asset && l.asset.id).filter(Boolean)), [lines]);
  const included = lines.filter(l => !excluded[l.key] && l.asset);
  const evenHours = useMemo(() => {
    const free = included.filter(l => hoursOverride[l.key] === undefined);
    const fixed = included.reduce((s, l) => s + (hoursOverride[l.key] || 0), 0);
    const split = splitHours((parseFloat(totalHours) || 0) - fixed, free.length);
    const map = {};
    free.forEach((l, i) => { map[l.key] = split[i] || 0; });
    return map;
  }, [included, hoursOverride, totalHours]);
  const lineHours = (l) => (hoursOverride[l.key] !== undefined ? hoursOverride[l.key] : evenHours[l.key] || 0);
  const hoursSum = Math.round(included.reduce((s, l) => s + lineHours(l), 0) * 100) / 100;

  // Skip equipment already logged for the same order and date (one small filtered query, after the order has loaded)
  useEffect(() => {
    setDupes(new Set());
    if (!ready || !dateStr) return undefined;
    let cancelled = false;
    api.query(LOG_TABLE, {
      select: ['craa5_equipmentguid'],
      filter: `craa5_sap eq '${escOData(normalizedCode)}' and craa5_lastcleaned ge ${dateStr}T00:00:00Z and craa5_lastcleaned lt ${nextDay(dateStr)}T00:00:00Z`,
      top: 500,
    }).then(rows => { if (!cancelled) setDupes(new Set(rows.map(r => cleanGuid(r.craa5_equipmentguid)))); }).catch(() => {});
    return () => { cancelled = true; };
  }, [api, normalizedCode, dateStr, ready]);

  // While the typeahead is still offering orders, don't claim the typed text is unknown or open the add panel
  const settling = matches.length === 0 && suggestOpen && (sugg.busy || sugg.items.length > 0);
  const isUnknown = ready && matches.length === 0 && !settling;
  const roomOpts = useSuggest(store, 'craa5_roomname', typing.room);
  const areaOpts = useSuggest(store, 'craa5_areaname', typing.area, typing.roomCtx);

  const addExtra = (asset) => {
    seq.current += 1;
    setExtras(p => [...p, { key: `x-${seq.current}`, asset, col: addFreq }]);
    setNewName('');
  };
  const addNew = async () => {
    if (!newRoom.trim() || !newArea.trim() || !newName.trim()) { setNote('Enter room, area and equipment name for the new equipment.'); return; }
    setNote('');
    try {
      const existing = await store.findAssetExact(newName.trim(), newRoom.trim(), newArea.trim());
      if (existing) {
        if (takenIds.has(existing.id)) { setNote(`${existing.name} is already on this order.`); return; }
        addExtra(existing);
        setNote(`${existing.name} already exists in ${existing.room} / ${existing.area}; added the existing equipment instead of creating a duplicate.`);
        return;
      }
    } catch (e) { setNote(`Could not check for an existing match: ${errText(e)}`); return; }
    seq.current += 1;
    addExtra({ id: `new:${seq.current}`, isNew: true, name: newName.trim(), room: newRoom.trim(), area: newArea.trim() });
  };

  const startEdit = (on) => {
    setEditMode(on);
    if (!on) { setEdits({}); return; }
    const e = {};
    lines.forEach(l => { if (l.asset && !l.asset.isNew) e[l.key] = { name: l.name, room: l.room, area: l.area }; });
    setEdits(e);
  };

  const onPhoto = async (file) => {
    if (!file) { setPhoto(null); setPhotoName(''); return; }
    setPhotoName(file.name);
    setPhoto(await compressImage(file));
  };

  const validate = () => {
    if (!normalizedCode) return 'Enter a SAP order.';
    if (order && order.status === 'loading') return 'Still loading this SAP order. Try again in a moment.';
    if (order && order.status === 'error') return `Could not load this SAP order: ${order.error}`;
    if (!dateStr || dateStr > maxDate || dateStr < minDate) return 'Date must be within the last year and not in the future.';
    if (!INITIALS_RE.test(normalizeInitials(initials))) return 'Initials: letters only, up to 4 per person, separate people with "/" (e.g. EL/LH).';
    const total = parseFloat(totalHours);
    if (!(total > 0) || total > 200) return 'Enter the hours it took (greater than 0).';
    if (lines.length === 0) return 'This SAP order is not in the list. Add the equipment it covers.';
    if (lines.some(l => !excluded[l.key] && !l.asset)) return 'Pick the equipment for the highlighted line(s), or remove them.';
    if (lines.some(l => !excluded[l.key] && (!safeString(l.name) || !safeString(l.room) || !safeString(l.area)))) return 'Every equipment line needs a name, room and area.';
    if (included.length === 0) return 'Nothing to log: no equipment selected.';
    if (included.every(l => dupes.has(l.asset.id))) return 'Every selected equipment already has this order logged for that date.';
    if (Math.abs(hoursSum - total) > 0.01) return `Line hours add up to ${hoursSum} but the order total is ${total}.`;
    return '';
  };

  // Write the SAP order onto an equipment's SAP row (update its frequency column, or create the row)
  const storeCode = async (asset, col, notes) => {
    const row = await store.findMsForAsset(asset);
    const existing = row && (row.codes.find(c => c.col === col) || {}).code;
    if (row && existing === normalizedCode) return;
    if (row && existing && !window.confirm(`${asset.name} already has ${existing} as its ${freqLabel(col)} code. Replace it with ${normalizedCode}?`)) {
      notes.push(`${asset.name}: kept ${existing}; ${normalizedCode} was not stored on it.`);
      return;
    }
    if (row) {
      const r = await store.writeMs(row.id, { [col]: normalizedCode }, row.assetId ? null : asset);
      if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
      return;
    }
    const r = await store.writeMs(null, { craa5_title: normalizedCode, [col]: normalizedCode, craa5_equipment: asset.name, craa5_textroom: asset.room, craa5_textarea: asset.area }, asset);
    if (r.tried && !r.linked) notes.push(`${asset.name}: SAP order saved without its equipment lookup (craa5_asset).`);
  };

  const commit = async () => {
    const notes = [];
    const ini = normalizeInitials(initials);
    // 1. Equipment edits made through "Edit pre-filled details"
    for (const l of lines) {
      if (excluded[l.key] || !l.asset || l.asset.isNew || !edits[l.key]) continue;
      const a = l.asset;
      if (a.name !== l.name || a.room !== l.room || a.area !== l.area) {
        try { await store.updateAsset(a, l.name, l.room, l.area); }
        catch (e) { return { saved: 0, notes, error: `Could not update ${a.name}: ${errText(e)}` }; }
      }
    }
    // 2. Create new equipment (unless an identical one now exists), then store the SAP order on every added equipment
    const resolved = {};
    for (const l of included.filter(x => x.extra)) {
      let asset = { ...l.asset, name: l.name, room: l.room, area: l.area };
      if (l.asset.isNew) {
        try { asset = (await store.findAssetExact(asset.name, asset.room, asset.area)) || (await store.createAsset(asset)); }
        catch (e) { return { saved: 0, notes, error: `Could not create ${asset.name}: ${errText(e)}` }; }
      }
      resolved[l.key] = asset;
      try { await storeCode(asset, l.col, notes); } catch (e) { notes.push(`${asset.name}: could not store the SAP order (${errText(e)}).`); }
    }
    // 3. Existing SAP rows matched by name or picked by hand get their asset link written back
    const toLog = included.filter(l => !dupes.has((resolved[l.key] || l.asset).id))
      .map(l => ({ asset: resolved[l.key] || l.asset, name: l.name, room: l.room, area: l.area, hours: lineHours(l), msId: l.msId, how: l.how }));
    const skipped = included.length - toLog.length;
    if (skipped) notes.push(`${skipped} equipment skipped: already logged for this order and date.`);
    if (store.lookupState() !== false) {
      for (const l of toLog) {
        if (l.msId && (l.how === 'matched by name' || l.how === 'picked')) {
          try { await store.writeMs(l.msId, {}, l.asset); } catch (_) { notes.push(`Could not store the equipment link for ${l.asset.name} on the SAP row.`); }
        }
      }
    }
    // 4. One log row per equipment
    const results = await pool(toLog, 6, (l) => api.create(LOG_TABLE, {
      craa5_equipmentguid: l.asset.id,
      craa5_equipment: l.name,
      craa5_room: l.room,
      craa5_area: l.area,
      craa5_sap: normalizedCode,
      craa5_lastcleaned: toLogDate(dateStr),
      craa5_lastcleanedby: ini,
      craa5_hoursworked: l.hours,
    }));
    const failed = results.filter(r => !r.ok);
    const savedIds = results.filter(r => r.ok).map(r => r.value);
    if (photo && savedIds.length) {
      const pr = await pool(savedIds, 4, (id) => api.update(LOG_TABLE, id, { craa5_pictureorfileofpaperwork: photo }));
      if (pr.some(r => !r.ok)) notes.push('Entries saved, but the paperwork photo could not be attached.');
    }
    store.dropOrders();
    if (failed.length) {
      return { saved: savedIds.length, notes, error: `${savedIds.length} of ${results.length} saved. Failed: ${errText(failed[0].error)}. Submit again; saved equipment is skipped as already logged.` };
    }
    return { saved: savedIds.length, notes, code: normalizedCode, date: dateStr };
  };

  useImperativeHandle(ref, () => ({ validate, commit, getShared: () => ({ date: dateStr, initials: normalizeInitials(initials) }) }));

  // Summary values for the read-only Room / Area / Equipment fields
  const live = lines.filter(l => !excluded[l.key]);
  const summarize = (k) => { const v = [...new Set(live.map(l => l[k]).filter(Boolean))]; return v.length === 0 ? '' : v.length === 1 ? v[0] : `Multiple (${v.length})`; };
  const roomList = `mss-rooms-${index}`;
  const areaList = `mss-areas-${index}`;

  return (
    <div className={styles.rowCard}>
      <div className={styles.rowFields}>
        <div className={styles.field}>
          <Text className={styles.label}>SAP Order (Req)</Text>
          <Input
            data-row={index}
            data-col="sap"
            aria-label="SAP order"
            autoComplete="off"
            placeholder="Start typing the SAP order…"
            value={code}
            style={{ minWidth: '210px' }}
            onChange={(e, d) => { setCode(d.value); setShowSuggest(true); setHi(0); clearOrderState(); }}
            onFocus={() => setShowSuggest(true)}
            onBlur={() => setTimeout(() => setShowSuggest(false), 150)}
            onKeyDown={(e) => {
              const open = suggestOpen && suggestions.length > 0;
              if (open && e.key === 'ArrowDown') { e.preventDefault(); setHi(h => Math.min(h + 1, suggestions.length - 1)); }
              else if (open && e.key === 'ArrowUp') { e.preventDefault(); setHi(h => Math.max(h - 1, 0)); }
              else if (open && e.key === 'Enter') { e.preventDefault(); selectCode(suggestions[Math.min(hi, suggestions.length - 1)].code); }
              else if (e.key === 'Escape') setShowSuggest(false);
              else if (e.key === 'Enter') { e.preventDefault(); onEnter(index); }
            }}
          />
          {suggestOpen && (
            <div className={styles.suggest} role="listbox">
              {suggestions.map((s, i) => (
                <button key={s.code} type="button" role="option" aria-selected={i === hi} className={styles.suggestItem}
                  style={i === hi ? { backgroundColor: '#E6F1FC' } : undefined}
                  onMouseDown={(e) => e.preventDefault()} onClick={() => selectCode(s.code)}>
                  <span><strong>{s.code}</strong>{s.names && <span className={styles.hint}> · {s.names}{s.count > 2 ? '…' : ''}</span>}</span>
                  <span className={styles.hint}>{s.count}{sugg.truncated ? '+' : ''} equipment</span>
                </button>
              ))}
              {sugg.busy && <div className={styles.suggestNote}>Searching…</div>}
              {sugg.error && <div className={styles.suggestNote} style={{ color: BRAND.red }}>{sugg.error}</div>}
              {!sugg.busy && !sugg.error && suggestions.length === 0 && <div className={styles.suggestNote}>No SAP orders match “{normalizedCode}”.</div>}
              {!sugg.busy && sugg.truncated && <div className={styles.suggestNote}>Many matches. Keep typing to narrow the list.</div>}
            </div>
          )}
          {matches.length > 0 && lines.length > 0 && (
            <Checkbox label={<Text size={200}>Edit pre-filled details</Text>} checked={editMode} onChange={(e, d) => startEdit(!!d.checked)} />
          )}
        </div>

        <div className={styles.field}>
          <Text className={styles.label}>Room</Text>
          <Input aria-label="Room" value={summarize('room')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Area</Text>
          <Input aria-label="Area" value={summarize('area')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '110px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Equipment</Text>
          <Input aria-label="Equipment" value={live.length > 1 ? `${live.length} equipment` : summarize('name')} readOnly disabled placeholder={code ? 'Auto-filled' : ''} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Date (Req)</Text>
          <Input aria-label="Date completed" type="date" value={dateStr} min={minDate} max={maxDate} onChange={(e, d) => setDateStr(d.value)} style={{ minWidth: '140px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Total Hours (Req)</Text>
          <Input aria-label="Total hours" type="number" placeholder="Ex: 2.5" value={totalHours} onChange={(e, d) => setTotalHours(d.value)} style={{ width: '100px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Initials (Req)</Text>
          <Input aria-label="Initials" placeholder="Ex: EL/LH" value={initials} onChange={(e, d) => setInitials(d.value)} style={{ minWidth: '90px' }} />
        </div>
        <div className={styles.field}>
          <Text className={styles.label}>Paperwork Picture</Text>
          <input type="file" accept="image/*" aria-label="Paperwork picture" onChange={(e) => onPhoto(e.target.files && e.target.files[0])} style={{ minWidth: '150px', padding: '4px' }} />
          {photoName && <span className={styles.hint}>{photoName}</span>}
        </div>
        <Button appearance="subtle" style={{ alignSelf: 'flex-start', marginTop: '16px' }} disabled={!canRemove} onClick={onRemove}>Remove</Button>
      </div>

      {order && order.status === 'loading' && order.code === normalizedCode && (
        <Text className={styles.hint} block style={{ marginTop: 8 }}>Loading {normalizedCode}…</Text>
      )}
      {order && order.status === 'error' && order.code === normalizedCode && (
        <Text className={styles.errorText} block>Could not load {normalizedCode}: {order.error}</Text>
      )}
      {isUnknown && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          {normalizedCode} is not in the SAP orders. Add the equipment it covers below and it will be saved against that equipment.
        </Text>
      )}
      {ready && order.capped && (
        <Text size={200} weight="semibold" block style={{ color: '#8A5300', marginTop: '8px' }}>
          This order lists more than {LIMITS.orderRows} equipment. Only the first {LIMITS.orderRows} are shown.
        </Text>
      )}

      {lines.length > 0 && (
        <table className={styles.linesTable}>
          <thead><tr>
            <th className={styles.th}></th><th className={styles.th}>Equipment</th><th className={styles.th}>Room</th><th className={styles.th}>Area</th>
            <th className={styles.th}>Frequency</th><th className={styles.th}>Hours</th><th className={styles.th}>Status</th>
          </tr></thead>
          <tbody>
            {lines.map(l => {
              const off = !!excluded[l.key];
              const dupe = l.asset && dupes.has(l.asset.id);
              const editing = editMode && edits[l.key];
              return (
                <tr key={l.key} style={off ? { color: '#94A3B8' } : !l.asset ? { backgroundColor: '#FFF6E6' } : undefined}>
                  <td className={styles.td}><input type="checkbox" aria-label={`Include ${l.name}`} checked={!off} onChange={(e) => setExcluded(p => ({ ...p, [l.key]: !e.target.checked }))} /></td>
                  <td className={styles.td}>
                    {editing ? (
                      <Input size="small" value={edits[l.key].name} onChange={(e, d) => setEdits(p => ({ ...p, [l.key]: { ...p[l.key], name: d.value } }))} />
                    ) : <strong>{l.name || '(unnamed)'}</strong>}
                    {l.extra && <Button size="small" appearance="subtle" style={{ marginLeft: 6 }} onClick={() => setExtras(p => p.filter(x => x.key !== l.key))}>Remove</Button>}
                    {!l.asset && !off && (
                      <div style={{ marginTop: 4 }}>
                        <AssetPicker store={store} initialQuery={l.name} ariaLabel={`Pick equipment for ${l.name}`} actionLabel="Use" exclude={takenIds}
                          onPick={(a) => setPickedAsset(p => ({ ...p, [l.key]: a }))} />
                      </div>
                    )}
                  </td>
                  <td className={styles.td}>{editing ? <Input size="small" list={roomList} value={edits[l.key].room} onChange={(e, d) => { setEdits(p => ({ ...p, [l.key]: { ...p[l.key], room: d.value } })); setTyping(t => ({ ...t, room: d.value })); }} /> : l.room}</td>
                  <td className={styles.td}>{editing ? <Input size="small" list={areaList} value={edits[l.key].area} onChange={(e, d) => { setEdits(p => ({ ...p, [l.key]: { ...p[l.key], area: d.value } })); setTyping(t => ({ ...t, area: d.value, roomCtx: edits[l.key].room })); }} /> : l.area}</td>
                  <td className={styles.td}>{l.col ? freqLabel(l.col) : ''}</td>
                  <td className={styles.td}>
                    {l.asset && !off ? (
                      <Input size="small" aria-label={`Hours for ${l.name}`} type="number" style={{ width: 90 }} value={String(lineHours(l))}
                        onChange={(e, d) => setHoursOverride(p => ({ ...p, [l.key]: parseFloat(d.value) || 0 }))} />
                    ) : '–'}
                  </td>
                  <td className={styles.td}>
                    {dupe ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>already logged</span>
                      : !l.asset ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>needs equipment</span>
                      : <span className={mergeClasses(styles.tag, styles.tagOk)}>{l.how || 'ready'}</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
      {lines.length > 0 && <Text className={styles.hint} block style={{ marginTop: 6 }}>Total hours are split evenly across the selected equipment; edit a line to override it. Lines sum to {hoursSum}.</Text>}

      {ready && !settling && (
        <div className={styles.addPanel}>
          {!addOpen && !isUnknown ? (
            <Button size="small" appearance="secondary" onClick={() => setAddOpen(true)}>+ Equipment missing from this order?</Button>
          ) : (
            <>
              <Text weight="semibold" block style={{ marginBottom: 8 }}>Add equipment to {normalizedCode}</Text>
              <div className={styles.rowFields} style={{ alignItems: 'center', marginBottom: 8 }}>
                <label><input type="radio" name={`addmode-${index}`} checked={addMode === 'search'} onChange={() => setAddMode('search')} /> Search existing equipment</label>
                <label><input type="radio" name={`addmode-${index}`} checked={addMode === 'new'} onChange={() => setAddMode('new')} /> Create new equipment</label>
                <div className={styles.field}>
                  <Text className={styles.label}>Store SAP order as</Text>
                  <Select aria-label="Frequency" value={addFreq} onChange={(e, d) => setAddFreq(d.value)}>
                    {FREQUENCIES.map(f => <option key={f.col} value={f.col}>{f.label}</option>)}
                  </Select>
                </div>
              </div>
              {addMode === 'search' ? (
                <AssetPicker store={store} ariaLabel="Search equipment" exclude={takenIds} onPick={addExtra} />
              ) : (
                <div className={styles.rowFields} style={{ alignItems: 'flex-end' }}>
                  <div className={styles.field}><Text className={styles.label}>Room</Text><Input aria-label="New equipment room" list={roomList} value={newRoom} onChange={(e, d) => { setNewRoom(d.value); setTyping(t => ({ ...t, room: d.value })); }} /></div>
                  <div className={styles.field}><Text className={styles.label}>Area</Text><Input aria-label="New equipment area" list={areaList} value={newArea} onChange={(e, d) => { setNewArea(d.value); setTyping(t => ({ ...t, area: d.value, roomCtx: newRoom.trim() })); }} /></div>
                  <div className={styles.field}><Text className={styles.label}>Equipment name</Text><Input aria-label="New equipment name" value={newName} onChange={(e, d) => setNewName(d.value)} /></div>
                  <Button size="small" appearance="primary" style={primaryStyle} onClick={addNew}>Add</Button>
                </div>
              )}
            </>
          )}
        </div>
      )}
      {note && <Text className={styles.errorText} block>{note}</Text>}
      <datalist id={roomList}>{roomOpts.map(r => <option key={r} value={r} />)}</datalist>
      <datalist id={areaList}>{areaOpts.map(r => <option key={r} value={r} />)}</datalist>
    </div>
  );
});

// --- FIX MISSING IDS (batched; candidates looked up per group) ---
// Ranks the closest equipment for one group of identical old log entries.
const rankCandidates = async (store, g) => {
  const p = nameProfile(g.equipment);
  const roomN = normName(g.room), areaN = normName(g.area);
  const cand = new Map(); // assetId -> { asset, score, reason }
  const bump = (asset, score, reason) => { const c = cand.get(asset.id); if (!c || score > c.score) cand.set(asset.id, { asset, score, reason }); };
  // 1. SAP order (loads only that order's equipment)
  if (g.sap) {
    const ord = await store.loadOrder(g.sap).catch(() => null);
    const list = ord ? [...new Map(ord.entries.filter(e => e.asset).map(e => [e.asset.id, e.asset])).values()] : [];
    if (list.length === 1) {
      const a = list[0];
      const sim = p.key || p.full ? nameSimilarity(p, nameProfile(a.name)) : 0;
      if (!g.equipment || sim >= 0.5) bump(a, 0.97, 'SAP order');
      else bump(a, 0.7, 'SAP order (name differs)');
    } else if (list.length > 1) {
      list.forEach(a => { const sim = nameSimilarity(p, nameProfile(a.name)); if (sim >= 0.6) bump(a, sim >= 0.8 ? Math.max(sim, 0.96) : Math.max(sim, 0.9), 'SAP order + name'); });
    }
  }
  // 2. Name / room / area similarity among a few server-side name searches
  if (p.full) {
    const found = await store.assetsLikeName(p.words, g.room).catch(() => []);
    found.forEach(a => {
      let s = nameSimilarity(p, nameProfile(a.name));
      if (s < 0.5) return;
      const ar = normName(a.room), aa = normName(a.area);
      if (roomN && ar === roomN) s = Math.min(1, s + 0.05);
      if (areaN && aa === areaN) s = Math.min(1, s + 0.03);
      if (roomN && ar && ar !== roomN) s *= 0.9;
      bump(a, s, s >= 0.999 ? 'same name' : 'similar name');
    });
  }
  const ranked = [...cand.values()].sort((a, b) => b.score - a.score).slice(0, 5);
  let tier = ranked.length ? tierOf(ranked[0].score) : 'none';
  const ambiguous = ranked.length > 1 && ranked[0].score - ranked[1].score < 0.02 && ranked[0].score < 0.999;
  if (ambiguous && tier !== 'none') tier = downTier(tier);
  return { ranked, tier, ambiguous };
};

const FixIdsTab = ({ ctx, onCount }) => {
  const styles = useStyles();
  const { api, store } = ctx;
  const [mode, setMode] = useState('missing');   // 'missing' = no ID, 'unknown' = ID points at deleted equipment
  const [scope, setScope] = useState('all');
  const [scan, setScan] = useState({ started: false, done: false, scanned: 0 });
  const [groups, setGroups] = useState([]);
  const [busy, setBusy] = useState('');          // '', 'scan', 'apply'
  const [progress, setProgress] = useState('');
  const [scanError, setScanError] = useState('');
  const [choice, setChoice] = useState({});      // groupKey -> assetId | ''
  const [apply, setApply] = useState({});        // groupKey -> bool
  const [extraOpts, setExtraOpts] = useState({});// groupKey -> assets picked through search
  const [searchOpen, setSearchOpen] = useState({});
  const [showAll, setShowAll] = useState(false);
  const [result, setResult] = useState(null);
  const cursorRef = useRef(null);
  const scannedRef = useRef(0);

  const resetScan = useCallback(() => {
    cursorRef.current = null; scannedRef.current = 0;
    setScan({ started: false, done: false, scanned: 0 });
    setGroups([]); setChoice({}); setApply({}); setExtraOpts({}); setSearchOpen({}); setResult(null); setScanError('');
  }, []);
  useEffect(() => { resetScan(); }, [mode, scope, resetScan]);

  const totalRows = groups.reduce((s, g) => s + g.ids.length, 0);
  useEffect(() => { onCount(scan.started ? { rows: totalRows, more: !scan.done } : null); }, [scan, totalRows, onCount]);

  const scanBatch = async (reset) => {
    setBusy('scan'); setScanError(''); setResult(null);
    if (reset) resetScan();
    try {
      let cursor = reset ? null : cursorRef.current;
      let scanned = reset ? 0 : scannedRef.current;
      let done = false;
      const bad = [];
      const pageSize = mode === 'missing' ? 100 : 200;
      const maxPages = mode === 'missing' ? 1 : 5;
      for (let p = 0; p < maxPages && bad.length < 100 && !done; p++) {
        const parts = [mode === 'missing' ? `(craa5_equipmentguid eq null or craa5_equipmentguid eq '')` : `craa5_equipmentguid ne null and craa5_equipmentguid ne ''`];
        if (scope === 'year') parts.push(`craa5_lastcleaned ge ${daysAgo(366)}T00:00:00Z`);
        if (cursor) parts.push(`craa5__log_id gt ${cursor}`);
        setProgress(`Scanning entries ${scanned + 1}–${scanned + pageSize}…`);
        const rows = await api.query(LOG_TABLE, { select: FIX_SELECT, filter: parts.join(' and '), orderBy: 'craa5__log_id', top: pageSize });
        scanned += rows.length;
        if (rows.length) cursor = rows[rows.length - 1].craa5__log_id;
        if (rows.length < pageSize) done = true;
        if (mode === 'missing') bad.push(...rows);
        else {
          await store.resolveAssets(rows.map(r => r.craa5_equipmentguid));
          bad.push(...rows.filter(r => !store.hasAsset(r.craa5_equipmentguid)));
        }
      }
      cursorRef.current = cursor; scannedRef.current = scanned;

      // Group identical entries, then look up candidates once per new group
      const prior = reset ? new Map() : new Map(groups.map(g => [g.key, g]));
      const fresh = new Map();
      bad.forEach(r => {
        const l = { id: r.craa5__log_id, equipment: safeString(r.craa5_equipment), guid: safeString(r.craa5_equipmentguid), sap: normCode(r.craa5_sap), room: safeString(r.craa5_room), area: safeString(r.craa5_area) };
        const key = [normName(l.equipment), normName(l.room), normName(l.area), l.sap, l.guid].join('|');
        const into = prior.get(key) || fresh.get(key);
        if (into) { into.ids = [...into.ids, l.id]; return; }
        fresh.set(key, { key, equipment: l.equipment, room: l.room, area: l.area, sap: l.sap, kind: l.guid ? 'unknown id' : 'missing id', ids: [l.id] });
      });
      const todo = [...fresh.values()];
      let done_ = 0;
      const ranks = await pool(todo, 4, async (g) => {
        const r = await rankCandidates(store, g);
        done_ += 1; setProgress(`Finding closest equipment… ${done_} of ${todo.length} groups`);
        return r;
      });
      const added = todo.map((g, i) => ({ ...g, ...(ranks[i].ok ? ranks[i].value : { ranked: [], tier: 'none', ambiguous: false, lookupError: errText(ranks[i].error) }) }));
      setChoice(prev => { const n = { ...prev }; added.forEach(g => { n[g.key] = g.ranked.length && g.tier !== 'none' ? g.ranked[0].asset.id : ''; }); return n; });
      setApply(prev => { const n = { ...prev }; added.forEach(g => { n[g.key] = g.tier === 'high'; }); return n; });
      setGroups(() => {
        const merged = [...prior.values(), ...added];
        const order = { high: 0, medium: 1, low: 2, none: 3 };
        return merged.sort((a, b) => order[a.tier] - order[b.tier] || b.ids.length - a.ids.length);
      });
      setScan({ started: true, done, scanned });
    } catch (e) { setScanError(errText(e)); }
    finally { setBusy(''); setProgress(''); }
  };

  const selected = groups.filter(g => apply[g.key] && choice[g.key]);
  const selectedRows = selected.reduce((s, g) => s + g.ids.length, 0);

  const applySelected = async (only) => {
    const todo = (only || selected).filter(g => choice[g.key] && store.getAsset(choice[g.key]));
    if (!todo.length) return;
    setBusy('apply'); setResult(null);
    const jobs = todo.flatMap(g => {
      const a = store.getAsset(choice[g.key]);
      return g.ids.map(id => ({ id, key: g.key, payload: { craa5_equipmentguid: a.id, ...(g.room ? {} : { craa5_room: a.room }), ...(g.area ? {} : { craa5_area: a.area }), ...(g.equipment ? {} : { craa5_equipment: a.name }) } }));
    });
    const res = await pool(jobs, 8, (j) => api.update(LOG_TABLE, j.id, j.payload));
    const failedIds = new Set(jobs.filter((j, i) => !res[i].ok).map(j => j.id));
    const firstError = res.find(r => !r.ok);
    const appliedKeys = new Set(todo.map(g => g.key));
    // Remove fixed entries from the list in place; nothing is rescanned
    setGroups(prev => prev.map(g => (appliedKeys.has(g.key) ? { ...g, ids: g.ids.filter(id => failedIds.has(id)) } : g)).filter(g => g.ids.length));
    setResult({ ok: res.length - failedIds.size, failed: failedIds.size, error: firstError ? errText(firstError.error) : '' });
    setBusy('');
  };

  const pickManual = (g, a) => {
    setExtraOpts(p => ({ ...p, [g.key]: [...(p[g.key] || []).filter(x => x.id !== a.id), a] }));
    setChoice(p => ({ ...p, [g.key]: a.id }));
    setApply(p => ({ ...p, [g.key]: true }));
    setSearchOpen(p => ({ ...p, [g.key]: false }));
  };

  return (
    <div>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Fix Missing Equipment IDs</Text>
      <Text className={styles.hint} block style={{ marginBottom: 10 }}>
        Log entries need the equipment’s ID (craa5_equipmentguid) so the calendar can match them. This scans the log in small batches, groups identical entries, and suggests the closest equipment using the SAP order first, then equipment name, room and area (equipment numbers must agree). Only the equipment it needs is looked up. Nothing is saved until you apply.
      </Text>
      <div className={styles.filterBar}>
        <Select aria-label="Entries to look for" value={mode} onChange={(e, d) => setMode(d.value)}>
          <option value="missing">Entries with no equipment ID</option>
          <option value="unknown">Entries whose ID no longer exists (slower)</option>
        </Select>
        <Select aria-label="Scan scope" value={scope} onChange={(e, d) => setScope(d.value)}>
          <option value="all">All dates</option>
          <option value="year">Last 12 months</option>
        </Select>
        {!scan.started
          ? <Button appearance="primary" style={primaryStyle} onClick={() => scanBatch(true)} disabled={!!busy}>{busy === 'scan' ? 'Scanning…' : 'Start scan'}</Button>
          : <>
            <Button onClick={() => scanBatch(false)} disabled={!!busy || scan.done}>{busy === 'scan' ? 'Scanning…' : scan.done ? 'End of log reached' : 'Scan next batch'}</Button>
            <Button onClick={() => scanBatch(true)} disabled={!!busy}>Start over</Button>
          </>}
        <Button appearance="primary" style={ctaStyle} disabled={!!busy || !selected.length} onClick={() => applySelected()}>
          Apply {selected.length} selected ({selectedRows} entries)
        </Button>
        <Button disabled={!!busy || !groups.some(g => g.tier === 'high' && choice[g.key])} onClick={() => applySelected(groups.filter(g => g.tier === 'high'))}>Apply all high confidence</Button>
        <Checkbox label="Show no-match groups" checked={showAll} onChange={(e, d) => setShowAll(!!d.checked)} />
      </div>
      {progress && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{progress}</Text>}
      {scanError && <Text className={styles.errorText} block>Scan failed: {scanError}</Text>}
      {result && <Text className={result.failed ? styles.errorText : styles.okText} block>{result.ok} entries updated{result.failed ? `; ${result.failed} failed (${result.error})` : ''}.</Text>}
      {scan.started && <Text className={styles.hint} block style={{ marginBottom: 8 }}>{scan.scanned} entries checked. {totalRows} need an ID, in {groups.length} distinct equipment groups.{scan.done ? ' The whole log has been checked.' : ' More entries remain: scan the next batch.'}</Text>}
      {scan.started && scan.done && groups.length === 0 && <Text className={styles.okText} block>Every checked entry has a valid equipment ID.</Text>}
      {groups.length > 0 && (
        <div style={{ overflowX: 'auto' }}>
          <table className={styles.linesTable}>
            <thead><tr>
              <th className={styles.th}>Apply</th><th className={styles.th}>Logged as</th><th className={styles.th}>Room / Area</th><th className={styles.th}>SAP order</th>
              <th className={styles.th}>Entries</th><th className={styles.th}>Issue</th><th className={styles.th}>Map to</th><th className={styles.th}>Confidence</th>
            </tr></thead>
            <tbody>
              {groups.filter(g => showAll || g.tier !== 'none' || choice[g.key]).map(g => {
                const options = [...g.ranked.map(r => r.asset), ...(extraOpts[g.key] || [])].filter((a, i, arr) => arr.findIndex(b => b.id === a.id) === i);
                const top = g.ranked.find(r => r.asset.id === choice[g.key]);
                return (
                  <tr key={g.key}>
                    <td className={styles.td}><input type="checkbox" aria-label={`Apply ${g.equipment}`} checked={!!apply[g.key] && !!choice[g.key]} disabled={!choice[g.key]} onChange={(e) => setApply(p => ({ ...p, [g.key]: e.target.checked }))} /></td>
                    <td className={styles.td}><strong>{g.equipment || '(blank)'}</strong></td>
                    <td className={styles.td}>{[g.room, g.area].filter(Boolean).join(' / ')}</td>
                    <td className={styles.td}>{g.sap}</td>
                    <td className={styles.td}>{g.ids.length}</td>
                    <td className={styles.td}><span className={mergeClasses(styles.tag, g.kind === 'unknown id' ? styles.tagBad : styles.tagWarn)}>{g.kind}</span></td>
                    <td className={styles.td} style={{ minWidth: 260 }}>
                      <Select aria-label={`Equipment for ${g.equipment}`} value={choice[g.key] || ''} onChange={(e, d) => { setChoice(p => ({ ...p, [g.key]: d.value })); if (!d.value) setApply(p => ({ ...p, [g.key]: false })); }}>
                        <option value="">No match</option>
                        {options.map(a => <option key={a.id} value={a.id}>{a.name} — {a.room} / {a.area}</option>)}
                      </Select>
                      {searchOpen[g.key]
                        ? <div style={{ marginTop: 4 }}><AssetPicker store={store} initialQuery={g.equipment} ariaLabel={`Search equipment for ${g.equipment}`} actionLabel="Use" onPick={(a) => pickManual(g, a)} /></div>
                        : <Button size="small" appearance="subtle" aria-label={`Search other equipment for ${g.equipment}`} onClick={() => setSearchOpen(p => ({ ...p, [g.key]: true }))}>Search other equipment…</Button>}
                    </td>
                    <td className={styles.td}>
                      {top ? (
                        <span className={mergeClasses(styles.tag, g.tier === 'high' ? styles.tagOk : g.tier === 'none' ? styles.tagBad : styles.tagWarn)}>
                          {TIER_LABEL[g.tier]} · {top.reason}{g.ambiguous ? ' · ambiguous' : ''}
                        </span>
                      ) : choice[g.key] ? <span className={mergeClasses(styles.tag, styles.tagWarn)}>manual</span>
                        : <span className={mergeClasses(styles.tag, styles.tagBad)} title={g.lookupError || ''}>{g.lookupError ? 'Lookup failed' : 'No match'}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
};

// --- LOG TABLE (one filtered, limited page; "Load More" asks for 50 more) ---
const LogTableTab = ({ ctx }) => {
  const styles = useStyles();
  const { api, store, maxDate } = ctx;
  const [entries, setEntries] = useState([]);
  const [pageSize, setPageSize] = useState(LIMITS.logPage);
  const [loading, setLoading] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');
  const [isEdit, setIsEdit] = useState(false);
  const [edits, setEdits] = useState({});
  const [selected, setSelected] = useState(new Set());
  const [message, setMessage] = useState(null);
  const [, setIdTick] = useState(0);
  const applied = useRef({ term: '', start: '', end: '' });

  const buildFilter = (a) => {
    const f = [];
    const term = escOData(a.term.trim());
    if (term) f.push(`(contains(craa5_sap,'${term}') or contains(craa5_equipment,'${term}') or startswith(craa5_lastcleanedby,'${term}'))`);
    if (a.start) f.push(`craa5_lastcleaned ge ${a.start}T00:00:00Z`);
    if (a.end) f.push(`craa5_lastcleaned lt ${nextDay(a.end)}T00:00:00Z`);
    return f.length ? f.join(' and ') : undefined;
  };

  const load = useCallback(async (size) => {
    setLoading(true);
    try {
      const res = await api.query(LOG_TABLE, { select: LOG_SELECT, orderBy: 'craa5_lastcleaned desc', top: size, filter: buildFilter(applied.current) });
      const list = res.map(mapLog);
      setEntries(list);
      // Check this page's equipment ids (only the distinct ids on screen)
      store.resolveAssets(list.map(e => e.guid)).then(() => setIdTick(t => t + 1)).catch(() => {});
    } catch (e) { setMessage({ kind: 'error', text: `Could not load the log: ${errText(e)}` }); }
    finally { setLoading(false); }
  }, [api, store]);

  useEffect(() => { load(LIMITS.logPage); }, [load]);

  const applyFilters = () => { applied.current = { term: searchTerm, start: startDate, end: endDate }; setPageSize(LIMITS.logPage); setSelected(new Set()); load(LIMITS.logPage); };
  const clearFilters = () => { setSearchTerm(''); setStartDate(''); setEndDate(''); applied.current = { term: '', start: '', end: '' }; setPageSize(LIMITS.logPage); setSelected(new Set()); load(LIMITS.logPage); };
  const loadMore = () => { const n = Math.min(pageSize + LIMITS.logPage, LIMITS.logMax); setPageSize(n); load(n); };
  const handleEdit = (id, field, value) => setEdits(p => ({ ...p, [id]: { ...p[id], [field]: value } }));

  const saveBatchEdits = async () => {
    const jobs = [];
    for (const [id, c] of Object.entries(edits)) {
      const payload = {};
      if (c.sap !== undefined) payload.craa5_sap = normCode(c.sap);
      if (c.date !== undefined) {
        if (!c.date || c.date > maxDate) { setMessage({ kind: 'error', text: 'Dates cannot be blank or in the future.' }); return; }
        payload.craa5_lastcleaned = toLogDate(c.date);
      }
      if (c.hours !== undefined) {
        if (!(c.hours > 0)) { setMessage({ kind: 'error', text: 'Hours must be greater than 0.' }); return; }
        payload.craa5_hoursworked = c.hours;
      }
      if (c.by !== undefined) {
        const ini = normalizeInitials(c.by);
        if (!INITIALS_RE.test(ini)) { setMessage({ kind: 'error', text: `Initials "${c.by}" are not valid (e.g. EL/LH).` }); return; }
        payload.craa5_lastcleanedby = ini;
      }
      if (Object.keys(payload).length) jobs.push({ id, payload });
    }
    const res = await pool(jobs, 8, (j) => api.update(LOG_TABLE, j.id, j.payload));
    const failed = res.filter(r => !r.ok);
    if (failed.length) setMessage({ kind: 'error', text: `${failed.length} of ${jobs.length} updates failed: ${errText(failed[0].error)}` });
    else { setMessage({ kind: 'ok', text: `Updated ${jobs.length} entries.` }); setEdits({}); setIsEdit(false); }
    await load(pageSize);
  };

  const batchDelete = async () => {
    if (!selected.size) return;
    if (!window.confirm(`Are you sure you want to permanently delete ${selected.size} records from Dataverse?`)) return;
    const res = await pool([...selected], 8, (id) => api.remove(LOG_TABLE, id));
    const failed = res.filter(r => !r.ok);
    setMessage(failed.length ? { kind: 'error', text: `${failed.length} deletes failed: ${errText(failed[0].error)}` } : { kind: 'ok', text: `Deleted ${res.length} entries.` });
    setSelected(new Set());
    await load(pageSize);
  };

  const idStatus = (e) => (!e.guid ? 'missing' : store.hasAsset(e.guid) ? 'ok' : store.isGone(e.guid) ? 'unknown' : 'checking');

  const cols = [
    createTableColumn({ columnId: 'select',
      renderHeaderCell: () => (<input type="checkbox" aria-label="Select all" checked={selected.size > 0 && selected.size === entries.length}
        onChange={(e) => setSelected(e.target.checked ? new Set(entries.map(x => x.id)) : new Set())} />),
      renderCell: (item) => (<input type="checkbox" aria-label={`Select ${item.equipment}`} checked={selected.has(item.id)}
        onChange={(e) => { const n = new Set(selected); if (e.target.checked) n.add(item.id); else n.delete(item.id); setSelected(n); }} />) }),
    createTableColumn({ columnId: 'sap', renderHeaderCell: () => 'SAP Order',
      renderCell: (item) => isEdit ? <Input value={edits[item.id]?.sap ?? item.sap} onChange={(e, d) => handleEdit(item.id, 'sap', d.value)} /> : <Text>{item.sap}</Text> }),
    createTableColumn({ columnId: 'equipment', renderHeaderCell: () => 'Equipment', renderCell: (item) => <Text>{item.equipment || '...'}</Text> }),
    createTableColumn({ columnId: 'room', renderHeaderCell: () => 'Room', renderCell: (item) => <Text>{item.room || '...'}</Text> }),
    createTableColumn({ columnId: 'area', renderHeaderCell: () => 'Area', renderCell: (item) => <Text>{item.area || '...'}</Text> }),
    createTableColumn({ columnId: 'date', renderHeaderCell: () => 'Date of Clean',
      renderCell: (item) => isEdit ? <Input type="date" max={maxDate} value={edits[item.id]?.date ?? item.date} onChange={(e, d) => handleEdit(item.id, 'date', d.value)} /> : <Text>{item.date}</Text> }),
    createTableColumn({ columnId: 'hours', renderHeaderCell: () => 'Hours Worked',
      renderCell: (item) => isEdit ? <Input type="number" value={String(edits[item.id]?.hours ?? item.hours ?? '')} onChange={(e, d) => handleEdit(item.id, 'hours', d.value ? parseFloat(d.value) : null)} /> : <Text>{item.hours ?? ''}</Text> }),
    createTableColumn({ columnId: 'by', renderHeaderCell: () => 'Initials',
      renderCell: (item) => isEdit ? <Input value={edits[item.id]?.by ?? item.by} onChange={(e, d) => handleEdit(item.id, 'by', d.value)} /> : <Text>{item.by}</Text> }),
    createTableColumn({ columnId: 'id', renderHeaderCell: () => 'Equipment ID',
      renderCell: (item) => { const s = idStatus(item); return <span className={mergeClasses(styles.tag, s === 'ok' ? styles.tagOk : s === 'unknown' ? styles.tagBad : s === 'missing' ? styles.tagWarn : undefined)}>{s === 'ok' ? 'linked' : s}</span>; } }),
  ];

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Log Table</Text>
      <div className={styles.filterBar}>
        <Input aria-label="Search" placeholder="Search order, equipment or initials…" value={searchTerm} onChange={(e, d) => setSearchTerm(d.value)} onKeyDown={(e) => { if (e.key === 'Enter') applyFilters(); }} style={{ minWidth: '200px' }} />
        <Input type="date" aria-label="Start date" value={startDate} onChange={(e, d) => setStartDate(d.value)} />
        <Input type="date" aria-label="End date" value={endDate} onChange={(e, d) => setEndDate(d.value)} />
        <Button appearance="primary" style={primaryStyle} onClick={applyFilters}>Apply Filters</Button>
        <Button onClick={clearFilters}>Clear Filters</Button>
      </div>
      <div className={styles.actionBar}>
        {!isEdit ? <Button onClick={() => setIsEdit(true)}>✏️ Batch Edit Mode</Button> : (
          <>
            <Button appearance="primary" style={primaryStyle} onClick={saveBatchEdits}>💾 Save Changes</Button>
            <Button onClick={() => { setIsEdit(false); setEdits({}); }}>❌ Cancel Edits</Button>
          </>
        )}
        <Button appearance="primary" style={selected.size ? dangerStyle : undefined} disabled={!selected.size} onClick={batchDelete}>🗑️ Delete Selected ({selected.size})</Button>
        <Text className={styles.hint}>{loading ? 'Loading…' : `Showing the ${entries.length} most recent matching entries`}</Text>
      </div>
      {message && <Text className={message.kind === 'ok' ? styles.okText : styles.errorText} block>{message.text}</Text>}
      <div style={{ maxHeight: '60vh', overflow: 'auto', border: `1px solid ${BRAND.line}`, borderRadius: '4px' }}>
        <DataGrid items={entries} columns={cols} getRowId={(item) => item.id}>
          <DataGridHeader><DataGridRow>{({ renderHeaderCell }) => <DataGridHeaderCell>{renderHeaderCell()}</DataGridHeaderCell>}</DataGridRow></DataGridHeader>
          <DataGridBody>{({ item }) => (<DataGridRow key={item.id}>{({ renderCell }) => <DataGridCell>{renderCell(item)}</DataGridCell>}</DataGridRow>)}</DataGridBody>
        </DataGrid>
      </div>
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
        <Button onClick={loadMore} disabled={loading || entries.length < pageSize || pageSize >= LIMITS.logMax}>Load More Entries</Button>
        {pageSize >= LIMITS.logMax && entries.length >= pageSize && <Text className={styles.hint}>That is the most the table shows at once. Use the filters to narrow it down.</Text>}
      </div>
    </div>
  );
};

// --- DASHBOARD (one period, one or two small pages) ---
const DashboardTab = ({ ctx }) => {
  const styles = useStyles();
  const { api } = ctx;
  const [days, setDays] = useState('7');
  const [data, setData] = useState({ rows: [], capped: false });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    let live = true;
    (async () => {
      setLoading(true); setError('');
      try {
        let rows = [];
        let cursor = null;
        let capped = false;
        for (let p = 0; p < LIMITS.dashboardPages; p++) {
          const filter = `craa5_lastcleaned ge ${daysAgo(Number(days))}T00:00:00Z${cursor ? ` and craa5__log_id gt ${cursor}` : ''}`;
          const page = await api.query(LOG_TABLE, { select: ['craa5__log_id', 'craa5_sap', 'craa5_lastcleanedby', 'craa5_hoursworked', 'craa5_equipmentguid'], filter, orderBy: 'craa5__log_id', top: LIMITS.dashboard });
          rows = rows.concat(page);
          if (page.length < LIMITS.dashboard) break;
          cursor = page[page.length - 1].craa5__log_id;
          if (p === LIMITS.dashboardPages - 1) capped = true;
        }
        if (live) setData({ rows, capped });
      } catch (e) { if (live) setError(errText(e)); }
      finally { if (live) setLoading(false); }
    })();
    return () => { live = false; };
  }, [api, days]);

  const metrics = useMemo(() => {
    let total = 0;
    const orders = new Set();
    const byInitials = {};
    data.rows.forEach(r => {
      const h = Number(r.craa5_hoursworked) || 0;
      total += h;
      const sap = normCode(r.craa5_sap);
      if (sap) orders.add(sap);
      const k = safeString(r.craa5_lastcleanedby).toUpperCase() || 'Unknown';
      byInitials[k] = (byInitials[k] || 0) + h;
    });
    return { total: total.toFixed(1), orders: orders.size, count: data.rows.length, noId: data.rows.filter(r => !safeString(r.craa5_equipmentguid)).length, byInitials: Object.entries(byInitials).sort((a, b) => b[1] - a[1]) };
  }, [data]);

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Dashboard Metrics</Text>
      <div className={styles.actionBar}>
        <Select aria-label="Period" value={days} onChange={(e, d) => setDays(d.value)}>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="90">Last 90 days</option>
        </Select>
        <Text className={styles.hint}>{loading ? 'Loading…' : data.capped ? `Based on the first ${data.rows.length} entries in the period. Choose a shorter period for exact totals.` : `Based on ${data.rows.length} entries.`}</Text>
      </div>
      {error && <Text className={styles.errorText} block>{error}</Text>}
      <div className={styles.dashboardGrid}>
        {[['Total Hours Logged', metrics.total, BRAND.blue], ['Unique SAP Orders', metrics.orders, BRAND.yellow], ['Log Entries', metrics.count, BRAND.logoBlue], ['Entries With No Equipment ID', metrics.noId, BRAND.red]].map(([label, value, color]) => (
          <div key={label} className={styles.metricCard} style={{ borderTop: `4px solid ${color}` }}>
            <Text className={styles.metricLabel}>{label}</Text>
            <Text className={styles.metricValue}>{value}</Text>
          </div>
        ))}
      </div>
      <div className={styles.listCard}>
        <Text size={500} weight="semibold" block style={{ marginBottom: 12 }}>Hours Logged by Person (Initials)</Text>
        <div style={{ maxHeight: 400, overflowY: 'auto', paddingRight: 8 }}>
          {metrics.byInitials.length ? metrics.byInitials.map(([ini, h]) => (
            <div key={ini} className={styles.listItem}><Text weight="semibold">{ini}</Text><Text>{h.toFixed(1)} Hours</Text></div>
          )) : <Text>{loading ? 'Loading…' : 'No entries in this period.'}</Text>}
        </div>
      </div>
    </div>
  );
};

// --- CALENDAR (one month at a time) ---
const CalendarTab = ({ ctx }) => {
  const styles = useStyles();
  const { api, maxDate } = ctx;
  const [month, setMonth] = useState(() => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1); });
  const [entries, setEntries] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [open, setOpen] = useState(null);
  const y = month.getFullYear(), m = month.getMonth();

  useEffect(() => {
    let live = true;
    const from = `${y}-${String(m + 1).padStart(2, '0')}-01`;
    const to = toDateInput(new Date(y, m + 1, 1));
    setLoading(true); setError(''); setOpen(null);
    api.query(LOG_TABLE, { select: ['craa5__log_id', 'craa5_sap', 'craa5_equipment', 'craa5_lastcleaned', 'craa5_lastcleanedby'], filter: `craa5_lastcleaned ge ${from}T00:00:00Z and craa5_lastcleaned lt ${to}T00:00:00Z`, orderBy: 'craa5_lastcleaned asc', top: LIMITS.calendar })
      .then(rows => { if (live) setEntries(rows.map(mapLog)); })
      .catch(e => { if (live) setError(errText(e)); })
      .finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, y, m]);

  const startDay = new Date(y, m, 1).getDay();
  const days = new Date(y, m + 1, 0).getDate();
  const cells = [...Array.from({ length: startDay }, () => null), ...Array.from({ length: days }, (_, i) => `${y}-${String(m + 1).padStart(2, '0')}-${String(i + 1).padStart(2, '0')}`)];
  const byDay = {};
  entries.forEach(e => { if (e.date) (byDay[e.date] = byDay[e.date] || []).push(e); });

  return (
    <div>
      <Text size={600} weight="semibold" block className={styles.sectionTitle}>Calendar View</Text>
      <div className={styles.calHeader}>
        <Button onClick={() => setMonth(new Date(y, m - 1, 1))}>Previous</Button>
        <Text weight="semibold">{month.toLocaleString('default', { month: 'long', year: 'numeric' })}{loading ? ' · loading…' : ''}</Text>
        <Button onClick={() => setMonth(new Date(y, m + 1, 1))}>Next</Button>
      </div>
      {error && <Text className={styles.errorText} block>{error}</Text>}
      <div className={styles.calGrid}>
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => <div key={d} className={styles.weekday}>{d}</div>)}
        {cells.map((k, i) => {
          const list = (k && byDay[k]) || [];
          const expanded = open === k;
          return (
            <div key={k || `e${i}`} className={mergeClasses(styles.dayCell, k === maxDate && styles.dayCellToday)}>
              {k && <div style={{ fontWeight: 700, marginBottom: 4 }}>{Number(k.slice(8))}</div>}
              {(expanded ? list : list.slice(0, 3)).map(e => <div key={e.id} className={styles.entryText} title={`${e.equipment} · ${e.by}`}>{e.equipment || e.sap} · {e.by}</div>)}
              {list.length > 3 && <button type="button" onClick={() => setOpen(expanded ? null : k)} style={{ border: 'none', background: 'none', color: BRAND.blue, cursor: 'pointer', fontSize: 11, textAlign: 'left', padding: 0 }}>{expanded ? 'Show less' : `+${list.length - 3} more`}</button>}
            </div>
          );
        })}
      </div>
      {entries.length >= LIMITS.calendar && <Text className={styles.hint} block style={{ marginTop: 8 }}>This month has more than {LIMITS.calendar} entries; only the earliest {LIMITS.calendar} are shown. Use the Log Table filters for the rest.</Text>}
    </div>
  );
};

// --- APP ---
export default function GeneratedComponent(props) {
  const dataApi = props && props.dataApi;
  const styles = useStyles();
  const api = useMemo(() => makeApi(dataApi), [dataApi]);
  const store = useMemo(() => makeStore(api), [api]);
  const maxDate = useMemo(() => toDateInput(new Date()), []);
  const minDate = useMemo(() => { const d = new Date(); d.setFullYear(d.getFullYear() - 1); return toDateInput(d); }, []);
  const ctx = useMemo(() => ({ api, store, maxDate, minDate }), [api, store, maxDate, minDate]);

  const [activeTab, setActiveTab] = useState('add');
  const [fixVisited, setFixVisited] = useState(false);
  const [fixCount, setFixCount] = useState(null);
  const [recent, setRecent] = useState([]);
  const [loadError, setLoadError] = useState('');

  const [rows, setRows] = useState([]);
  const [addRowCount, setAddRowCount] = useState(1);
  const [errorMessage, setErrorMessage] = useState('');
  const [successMessage, setSuccessMessage] = useState('');
  const [warnMessage, setWarnMessage] = useState('');
  const [saving, setSaving] = useState(false);
  const refs = useRef({});
  const rowSeq = useRef(0);
  const containerRef = useRef(null);

  const newRow = (shared) => { rowSeq.current += 1; return { key: `r${rowSeq.current}`, date: shared && shared.date, initials: shared && shared.initials }; };
  useEffect(() => { setRows([newRow()]); /* eslint-disable-next-line */ }, []);

  // Sidebar: the 10 most recent entries (one tiny query)
  const loadRecent = useCallback(async () => {
    try {
      const res = await api.query(LOG_TABLE, { select: ['craa5__log_id', 'craa5_sap', 'craa5_equipment', 'craa5_lastcleaned', 'craa5_lastcleanedby'], orderBy: 'craa5_lastcleaned desc', top: 10 });
      setRecent(res.map(mapLog)); setLoadError('');
    } catch (e) { setLoadError(errText(e)); }
  }, [api]);
  useEffect(() => { loadRecent(); }, [loadRecent]);

  const addRows = (count, shared) => {
    const last = rows.length ? refs.current[rows[rows.length - 1].key] : null;
    const carry = shared || (last && last.getShared && last.getShared());
    setRows(prev => [...prev, ...Array.from({ length: count }, () => newRow(carry))]);
  };

  const handleEnter = (index) => {
    if (index < rows.length - 1) {
      const next = containerRef.current && containerRef.current.querySelector(`[data-row="${index + 1}"][data-col="sap"]`);
      if (next) next.focus();
    } else addRows(1);
  };

  const submitAll = async () => {
    setErrorMessage(''); setSuccessMessage(''); setWarnMessage('');
    for (let i = 0; i < rows.length; i++) {
      const h = refs.current[rows[i].key];
      const err = h ? h.validate() : 'Row is not ready.';
      if (err) { setErrorMessage(`Row ${i + 1}: ${err}`); return; }
    }
    setSaving(true);
    const done = [];
    const notes = [];
    let saved = 0;
    let lastShared = null;
    let failure = '';
    for (let i = 0; i < rows.length; i++) {
      const h = refs.current[rows[i].key];
      lastShared = h.getShared();
      const res = await h.commit();
      saved += res.saved || 0;
      (res.notes || []).forEach(n => notes.push(`Row ${i + 1}: ${n}`));
      if (res.error) { failure = `Row ${i + 1}: ${res.error}`; if (!res.saved) break; }
      done.push(rows[i].key);
      if (res.error) break;
    }
    setRows(prev => { const rest = prev.filter(r => !done.includes(r.key)); return rest.length ? rest : [newRow(lastShared)]; });
    if (failure) setErrorMessage(failure);
    else setSuccessMessage(`Saved ${saved} log ${saved === 1 ? 'entry' : 'entries'}.`);
    if (notes.length) setWarnMessage(notes.join(' '));
    setSaving(false);
    loadRecent();
  };

  const show = (t) => (activeTab === t ? undefined : { display: 'none' });
  const fixLabel = fixCount ? ` (${fixCount.rows}${fixCount.more ? '+' : ''})` : '';
  const tabs = [['add', 'Add Log Entries'], ['table', 'Log Table'], ['dashboard', 'Dashboard'], ['calendar', 'Calendar'], ['fix', `Fix Missing IDs${fixLabel}`]];

  return (
    <FluentProvider theme={THEME} style={{ background: 'transparent', minHeight: '100%' }}>
      <div className={styles.root}>
        <div className={styles.header}>
          <div className={styles.title}>
            <span className={styles.titleMain}>MSS Log Input</span>
            <span className={styles.titleSub}>
              {api.mode === 'preview' ? 'Preview data (no Dataverse connection)' : 'Connected to Dataverse'} · searches as you type, loads only what you open
            </span>
          </div>
          <div className={styles.logo}><BrandLogo /></div>
        </div>

        <TabList selectedValue={activeTab} onTabSelect={(_, d) => { setActiveTab(d.value); if (d.value === 'fix') setFixVisited(true); }} className={styles.navBar}>
          {tabs.map(([v, label]) => (
            <Tab key={v} value={v} className={mergeClasses(styles.tab, activeTab === v && styles.activeTab)}>{label}</Tab>
          ))}
        </TabList>

        {loadError && <Text className={styles.errorText} block>Could not load Dataverse data: {loadError}</Text>}

        <div className={styles.mainContent}>
          {/* The entry form stays mounted so half-typed rows survive tab switches */}
          <div className={styles.sidebar} style={show('add')}>
            <Text size={500} className={styles.sidebarTitle} block>Recent Log Entries</Text>
            <ul style={{ paddingLeft: 18, margin: 0 }}>
              {recent.map(e => (
                <li key={e.id} style={{ marginBottom: 6, fontSize: 13 }}>
                  {e.date} · <strong>{e.sap || e.equipment}</strong> {e.sap && e.equipment ? `(${e.equipment})` : ''} — {e.by}
                </li>
              ))}
              {!recent.length && <li style={{ listStyle: 'none', marginLeft: -18 }}>No entries yet.</li>}
            </ul>
          </div>
          <div className={styles.contentArea} style={show('add')}>
            <Text size={600} weight="semibold" block className={styles.sectionTitle}>Add Log Entries</Text>
            <div ref={containerRef} style={{ display: 'flex', flexDirection: 'column', gap: 14, width: '100%' }}>
              {rows.map((r, i) => (
                <EntryRow key={r.key} ref={(el) => { if (el) refs.current[r.key] = el; else delete refs.current[r.key]; }}
                  ctx={ctx} index={i} initialDate={r.date} initialInitials={r.initials} canRemove={rows.length > 1}
                  onEnter={handleEnter} onRemove={() => setRows(prev => prev.filter(x => x.key !== r.key))} />
              ))}
              {errorMessage && <Text className={styles.errorText} block role="alert">{errorMessage}</Text>}
              {successMessage && <Text className={styles.okText} block role="status">{successMessage}</Text>}
              {warnMessage && <Text className={styles.warnText} block role="status">{warnMessage}</Text>}
              <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                <Input aria-label="Rows to add" type="number" min={1} value={String(addRowCount)} onChange={(e, d) => setAddRowCount(parseInt(d.value, 10) || 1)} style={{ width: 70 }} />
                <Button onClick={() => addRows(addRowCount)}>Add More Rows</Button>
              </div>
              <Button appearance="primary" size="large" disabled={saving} onClick={submitAll} style={{ ...ctaStyle, maxWidth: 300 }}>
                {saving ? 'Saving…' : 'Submit All Records'}
              </Button>
            </div>
          </div>

          {/* The other tabs load when opened */}
          {activeTab === 'table' && <div className={styles.contentArea}><LogTableTab ctx={ctx} /></div>}
          {activeTab === 'dashboard' && <div className={styles.contentArea}><DashboardTab ctx={ctx} /></div>}
          {activeTab === 'calendar' && <div className={styles.contentArea}><CalendarTab ctx={ctx} /></div>}
          {fixVisited && <div className={styles.contentArea} style={show('fix')}><FixIdsTab ctx={ctx} onCount={setFixCount} /></div>}
        </div>
      </div>
    </FluentProvider>
  );
}
