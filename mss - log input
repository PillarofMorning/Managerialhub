    },
    async syncSkipCodesFromDataverse(force = false) {
      if (skipTableState === 'missing' && !force) {
        return { state: skipTableState, codes: store.getSkipCodes(), error: skipTableError };
      }
      try {
        const rows = await cfgFindRows(api, HUB_CONFIG_SKIP_CODES_KEY);
        skipTableState = 'connected';
        skipTableError = '';
        skipLastSync = new Date().toLocaleTimeString();
        const cfgRow = rows && rows[0];
        if (cfgRow && hubConfigJsonOf(cfgRow)) {
          const parsed = JSON.parse(hubConfigJsonOf(cfgRow));
          const list = Array.isArray(parsed) ? parsed : (parsed && Array.isArray(parsed.codes) ? parsed.codes : []);
          const fromDv = list.map((r, idx) => ({
            id: safeString(r.id || r.code || `dv-${idx}`),
            dvId: cleanGuid(cfgRow.craa5__0_hubconfigid) || null,
            code: normCode(r.code || r.craa5_code),
            label: safeString(r.label || r.craa5_label) || normCode(r.code || r.craa5_code),
            category: safeString(r.category || r.craa5_category) || 'General',
            requiresNote: !!(r.requiresNote !== undefined ? r.requiresNote : r.craa5_requiresnote),
            active: (r.active !== undefined ? r.active : r.craa5_active) !== false,
            sortOrder: Number.isFinite(Number(r.sortOrder !== undefined ? r.sortOrder : r.craa5_sortorder)) ? Number(r.sortOrder !== undefined ? r.sortOrder : r.craa5_sortorder) : (idx + 1) * 10,
            source: 'dataverse',
          })).filter(x => x.code);
          if (fromDv.length > 0) {
            skipCodes = fromDv;
            saveLocalSkipCodes(skipCodes);
          }
        }
        return { state: skipTableState, codes: store.getSkipCodes(), error: '' };
      } catch (e) {
        const msg = errText(e);
        if (MISSING_TABLE.test(msg) || MISSING_COLUMN.test(msg)) {
          skipTableState = 'missing';
          skipTableError = `Hub config table ${HUB_CONFIG_TABLE} not reachable (using in-app storage).`;
        } else {
          skipTableState = 'error';
          skipTableError = msg;
        }
        return { state: skipTableState, codes: store.getSkipCodes(), error: skipTableError };
      }
    },
    async saveSkipCode(item) {
      const code = normCode(item.code).replace(/[^A-Z0-9_\-]/g, '');
      const label = safeString(item.label);
      if (!code || !label) throw new Error('Both a short Skip Code and a Reason Description are required.');
      const category = safeString(item.category) || 'General';
      const requiresNote = !!item.requiresNote;
      const active = item.active !== false;
      const sortOrder = Number.isFinite(Number(item.sortOrder)) ? Math.round(Number(item.sortOrder)) : 100;
      const existingIdx = skipCodes.findIndex(x => (item.id && x.id === item.id) || x.code === code);
      const existing = existingIdx >= 0 ? skipCodes[existingIdx] : null;
      const entry = {
        id: (existing && existing.id) || item.id || `skip-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
        dvId: (existing && existing.dvId) || item.dvId || null,
        code,
        label,
        category,
        requiresNote,
        active,
        sortOrder,
        source: existing && existing.source ? existing.source : 'local',
      };
      if (existingIdx >= 0) skipCodes[existingIdx] = entry;
      else skipCodes.push(entry);
      saveLocalSkipCodes(skipCodes);

      if (api.mode === 'dataverse' || api.mode === 'live') {
        try {
          const allCodes = store.getSkipCodes();
          const jsonStr = JSON.stringify(allCodes);
          const rows = await cfgFindRows(api, HUB_CONFIG_SKIP_CODES_KEY);
          if (rows && rows[0] && rows[0].craa5__0_hubconfigid) {
            await api.update(HUB_CONFIG_TABLE, rows[0].craa5__0_hubconfigid, {
              craa5_configkey: HUB_CONFIG_SKIP_CODES_KEY,
              craa5_configname: HUB_CONFIG_SKIP_CODES_KEY,
              [HUB_MANIFEST_COL]: jsonStr,
              craa5_scope: 'MSS_LOG_INPUT',
            });
          } else {
            await api.create(HUB_CONFIG_TABLE, {
              craa5_configkey: HUB_CONFIG_SKIP_CODES_KEY,
              craa5_configname: HUB_CONFIG_SKIP_CODES_KEY,
              craa5_category: 'SkipCodes',
              craa5_scope: 'MSS_LOG_INPUT',
              [HUB_MANIFEST_COL]: jsonStr,
            });
          }
          entry.source = 'dataverse';
          saveLocalSkipCodes(skipCodes);
          skipTableState = 'connected';
          skipTableError = '';
        } catch (e) {
          if (MISSING_TABLE.test(errText(e)) || MISSING_COLUMN.test(errText(e))) {
            skipTableState = 'missing';
          }
        }
      }
      return store.getSkipCodes();
    },
    async deleteSkipCode(idOrCode) {
      skipCodes = skipCodes.filter(x => x.id !== idOrCode && x.code !== idOrCode);
      saveLocalSkipCodes(skipCodes);
