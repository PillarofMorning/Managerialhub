                        <td className={styles.td}><code><strong>{a.matchKey}</strong></code></td>
                        <td className={styles.td}>{a.displayName}</td>
                        <td className={styles.td}>
                          <span className={tagClass('info')}>
                            {(VIEW_ROLE_PRESETS[a.preset] && VIEW_ROLE_PRESETS[a.preset].label) || a.preset}
                          </span>
                        </td>
                        <td className={styles.td}>
                          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 4 }}>
                            {(a.tabs || []).map(tid => {
                              const tObj = ALL_APP_TABS.find(x => x.id === tid);
                              return (
                                <span key={tid} style={{ fontSize: 11, padding: '1px 6px', borderRadius: 4, background: '#F1F5F9', border: '1px solid #CBD5E1' }}>
                                  {tObj ? tObj.label : tid}
                                </span>
                              );
                            })}
                          </div>
                        </td>
                        <td className={styles.td}>
                          <span className={tagClass(a.lockedByAdmin ? 'warn' : 'ok')}>
                            {a.lockedByAdmin ? 'Locked by Admin' : 'Unlocked Default'}
                          </span>
                        </td>
                        <td className={styles.td}>
                          <div style={{ fontSize: 12 }}>{a.notes || '-'}</div>
                          <div className={styles.hint}>{a.updatedAt ? a.updatedAt.slice(0, 16).replace('T', ' ') : ''}</div>
                        </td>
                        <td className={styles.td} style={{ textAlign: 'right', whiteSpace: 'nowrap' }}>
                          <div style={{ display: 'inline-flex', gap: 6 }}>
                            <Button
                              size="small"
                              appearance={isPreviewing ? 'primary' : 'secondary'}
                              onClick={() => setPreviewTargetKey(isPreviewing ? '' : a.matchKey)}
                            >
                              {isPreviewing ? 'Stop Preview' : 'Preview As User'}
                            </Button>
                            <Button size="small" appearance="secondary" onClick={() => startEditAssignment(a)}>
                              Edit
                            </Button>
                            <Button size="small" appearance="subtle" style={{ color: BRAND.redText }} onClick={() => deleteUserAssignment(a)}>
                              Remove
                            </Button>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    </div>
  );
};

