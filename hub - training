        setBusy(true);
        var out: any = {}, chain: any = Promise.resolve();
        TM_OWN.forEach(function (k: string) { if (!data[k].table) return; chain = chain.then(function () { return tmProbeCols(dataApi, data[k].table, TM_COLS[k]).then(function (r: any) { out[k] = r; }); }); });
        chain.then(function () { colsState[1](out); setBusy(false); });
    }

    var tabs = TM_TAB_LIST.filter(function (t: any) { return t[0] !== 'baseline' || rights.baseline; }).concat(devOpen ? TM_DEV_TAB_LIST : []);
    var shownTab = tabs.some(function (t: any) { return t[0] === tab; }) ? tab : 'matrix';
    function setLang(l: string) { tmSetLang(l); hubSetLang(l); langState[1](l); setMsg(null); }
    function setTheme(t: string) { hubSetTheme(t); themeState[1](t); }
    var dark = theme === 'dark'; var th = dark ? HUB_COLORS.dark : HUB_COLORS.light;
    var noHost = !tmWeb() && !(dataApi && dataApi.queryTable);
    var problems: string[] = [];
    if (data.employees.err) problems.push(tmT('Employees could not be read: {err}', { err: data.employees.err }));
    TM_OWN.forEach(function (k: string) { if (!loadingState[0] && !noHost && !data[k].table) problems.push(tmT('The table {t} was not found yet, so nothing can be saved to it. Create it from the table prompts (Data tab says which name it looked for).', { t: TM_TABLES[k].label })); });
    if (data.employees.noEmail) problems.push(tmT('The Employees table has no craa5_email column, so the page cannot tell who you are (lead, supervisor). Until it does, only people on the developer list can change levels.'));
    if (data.msslog.err) problems.push(tmT('The MSS log could not be read: {err}. Levels work, but shifts, pace and ready for sign-off need it.', { err: data.msslog.err }));
    var first = user && user.name ? tmFirstName(user.name) : '';
    var mdl = modal;
    var openCell = function (emp: string, skill: string) { setModal({ type: 'cell', emp: emp, skill: skill }); };
    var openPerson = function (emp: string) { setModal({ type: 'person', emp: emp }); };
    var openSkill = function (skill: string) { setModal({ type: 'skill', skill: skill }); };
    return (
        <div ref={rootRef} className={'tm-root ' + (dark ? 'tm-dark' : '')} data-theme={theme} lang={lang === 'es' ? 'es-MX' : 'en'}
            style={{ height: heightState[0] ? heightState[0] : '100vh', overflowY: 'auto', overflowX: 'hidden', backgroundColor: th.bg, color: th.text, fontFamily: "'Segoe UI', Arial, sans-serif", position: 'relative' }}>
            <header className="bg-white border-b border-slate-200 sticky top-0 z-30 tm-noprint">
                <div className="flex flex-wrap items-center gap-3 px-4 py-2.5">
                    <div className="flex items-center gap-3 mr-2">
                        <TmLogo onClick={onLogo} open={devOpen} allowed={devAllowed} />
                        <div>
                            <div className="font-black text-[#00468B] leading-tight" data-welcome="1">{first ? tmT('Welcome, {name}, to the training matrix', { name: first }) : tmT('Welcome to the training matrix')}</div>
                            <div className="text-[11px] text-slate-500 leading-tight">{tmT('Who can clean what, and how fast they got there')}{rights.role ? ' - ' + tmT(rights.role === 'lead' ? 'Lead' : rights.role === 'supervisor' ? 'Supervisor' : rights.role === 'manager' ? 'Manager' : 'Sanitor') : ''}</div>
                        </div>
                    </div>
                    <div className="flex-1" />
                    <div className="flex flex-wrap items-center gap-2">
                        <div className="inline-flex rounded-lg border border-slate-300 overflow-hidden" role="group" aria-label={tmT('Language')}>
                            {[['en', 'EN'], ['es', 'ES']].map(function (x: any) { return <button key={x[0]} type="button" data-lang={x[0]} onClick={function () { setLang(x[0]); }} aria-pressed={lang === x[0]} title={x[0] === 'en' ? 'English' : 'Espa' + String.fromCharCode(241) + 'ol (M' + String.fromCharCode(233) + 'xico)'} className={'px-2.5 py-1.5 text-xs font-black ' + (lang === x[0] ? 'bg-[#0072CE] text-white' : 'bg-white text-slate-600 hover:bg-slate-100')}>{x[1]}</button>; })}
                        </div>
                        <TmBtn kind="ghost" onClick={function () { setTheme(dark ? 'light' : 'dark'); }} title={dark ? tmT('Light mode') : tmT('Dark mode')} label={dark ? tmT('Light mode') : tmT('Dark mode')} pressed={dark}><TmIcon name={dark ? 'sun' : 'moon'} size={18} /></TmBtn>
                        <TmBtn kind="ghost" onClick={function () { setModal({ type: 'help' }); }} title={tmT('Help')} label={tmT('Help')} className="font-black text-base">?</TmBtn>
                        <TmBtn onClick={function () { reloadState[1](reloadState[0] + 1); }} disabled={busy || loadingState[0]} title={tmT('Read again')}><TmIcon name="refresh" size={14} />{tmT('Read again')}</TmBtn>
                    </div>
                </div>
                <nav className="flex gap-1 px-3 pb-2 tm-tabs" style={{ overflowX: 'auto' }} role="tablist">
                    {tabs.map(function (t: any) {
                        var n = t[0] === 'signoffs' ? m.readyList.length : 0;
                        return <button key={t[0]} type="button" data-testtab={t[0]} role="tab" aria-selected={shownTab === t[0]} onClick={function () { tabState[1](t[0]); }} className={'px-3 py-1.5 rounded-full text-sm font-bold whitespace-nowrap inline-flex items-center gap-1 ' + (shownTab === t[0] ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]')}>{t[0] === 'setup' || t[0] === 'data' ? <TmIcon name="lock" size={12} /> : null}{tmT(t[1])}{n ? <span className="ml-1 rounded-full px-1.5 text-[11px] font-black" style={{ backgroundColor: '#FFB81C', color: '#1E293B' }}>{n}</span> : null}</button>;
                    })}
                </nav>
            </header>
            <main className="p-3 sm:p-4 space-y-4 max-w-[1600px] mx-auto">
                {twState[0] === 'failed' && <TmNote tone="warn">{tmT('The page styling (cdn.tailwindcss.com) did not load on this computer, so the page looks plain. Everything still works.')}</TmNote>}
                {noHost && <TmNote tone="bad">{tmT('This page is not connected to Dataverse (no Xrm.WebApi and no dataApi). Open it inside the model-driven app. Nothing below is real data until it is.')}</TmNote>}
                {loadingState[0] && !noHost && <TmNote>{tmT('Reading employees, skills, levels and the MSS log from Dataverse...')}</TmNote>}
                {problems.map(function (p: string, i: number) { return <TmNote key={i} tone="warn">{p}</TmNote>; })}
                {msg && <TmNote tone={msg.tone}><div className="flex items-start gap-2"><span className="flex-1" data-msg={msg.tone}>{msg.text}</span><button type="button" className="font-bold" onClick={function () { setMsg(null); }}>{tmT('Dismiss')}</button></div></TmNote>}
                {devOpen && (!S.devUsers || !S.devUsers.length) && shownTab !== 'setup' && <TmNote tone="warn"><div className="flex flex-wrap items-center gap-2"><span className="flex-1">{tmT('The developer tools are not locked to anyone yet. Lock them on Setup.')}</span><TmBtn onClick={function () { tabState[1]('setup'); }}>{tmT('Open Setup')}</TmBtn></div></TmNote>}
                {!loadingState[0] && !noHost && (
                    <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 tm-noprint">
                        <TmStat label={tmT('People')} value={String(m.people.length)} sub={tmT('active, with a crew')} />
                        <TmStat label={tmT('Skills')} value={String(m.skills.length)} sub={tmTn(m.skills.filter(function (s: any) { return s.kind === 'area'; }).length, '{n} area', '{n} areas')} />
                        <TmStat label={tmT('Ready for sign-off')} value={String(m.readyList.length)} sub={tmTn(m.refreshList.length, '{n} refresher due', '{n} refreshers due')} tone={m.readyList.length ? 'warn' : ''} />
                        <TmStat label={tmT('Cleans with names')} value={String(m.logCount)} sub={tmT('MSS log, last {d} days', { d: S.evidenceDays })} />
                    </div>
                )}
                {shownTab === 'matrix' && <TmMatrixTab m={m} filter={filter} onFilter={onFilter} dark={dark} onCell={openCell} onPerson={openPerson} onSkill={openSkill} maxHeight={Math.max(360, heightState[0] - 260)} />}
                {shownTab === 'signoffs' && <TmSignoffsTab m={m} filter={filter} onFilter={onFilter} dark={dark} onCell={openCell} />}
                {shownTab === 'coverage' && <TmCoverageTab m={m} onSkill={openSkill} />}
                {shownTab === 'people' && <TmPeopleTab m={m} filter={filter} onFilter={onFilter} rights={rights} onPerson={openPerson} />}
                {shownTab === 'baseline' && <TmBaselineTab m={m} filter={filter} rights={rights} busy={busy} onSave={saveBaseline} />}
                {shownTab === 'setup' && <TmSetupTab m={m} skills={tmSortSkills(norm.skills)} areas={norm.areas} settings={S} settingsWhere={sw} user={user} busy={busy} canSave={canSave.skill} onSaveSkills={saveSkills} onSaveSettings={saveSettings} />}
                {shownTab === 'data' && <TmDataTab data={data} cols={colsState[0]} settingsWhere={sw} manifest={manifestState[0]} busy={busy} onCheckCols={checkCols} onReload={function () { reloadState[1](reloadState[0] + 1); }} />}
            </main>
            {mdl && mdl.type === 'cell' && <TmCellModal key={mdl.emp + mdl.skill} m={m} emp={mdl.emp} skill={mdl.skill} maxLevel={maxLevel} busy={busy} dark={dark} onClose={function () { setModal(null); }} onSave={saveLevel} onEvent={saveEvent} />}
            {mdl && mdl.type === 'person' && <TmProfileModal m={m} emp={mdl.emp} rights={rights} dark={dark} onCell={openCell} onClose={function () { setModal(null); }} />}
            {mdl && mdl.type === 'skill' && <TmSkillModal m={m} skill={mdl.skill} dark={dark} onCell={openCell} onClose={function () { setModal(null); }} />}
            {mdl && mdl.type === 'help' && <TmHelpModal tab={shownTab} dark={dark} onClose={function () { setModal(null); }} />}
        </div>
    );
}
// ==== END TRAINING APP ====
