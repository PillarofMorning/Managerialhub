// True on short screens (a phone held sideways), where a pinned header would leave no room for the list
function useShortScreen() {
  const query = '(max-height: 520px)';
  const [short, setShort] = useState(() => typeof window !== 'undefined' && !!window.matchMedia && window.matchMedia(query).matches);
  useEffect(() => {
    if (typeof window === 'undefined' || !window.matchMedia) return undefined;
    const mq = window.matchMedia(query);
    const onChange = () => setShort(mq.matches);
    onChange();
    if (mq.addEventListener) mq.addEventListener('change', onChange); else mq.addListener(onChange);
    return () => { if (mq.removeEventListener) mq.removeEventListener('change', onChange); else mq.removeListener(onChange); };
  }, []);
  return short;
}

function TableTab({ submissions, timeFilteredCount, categoryBar, mapImage, logEvent, onLocate, onEdit }) {
  const [query, setQuery] = useState('');
  const shortScreen = useShortScreen();
  const [selectedItem, setSelectedItem] = useState(null);
  const [visibleCount, setVisibleCount] = useState(RAIL_PAGE);
  const scrollRef = useRef(null);
  const sentinelRef = useRef(null);
  const aspect = useImageAspect(mapImage);

  // Newest first, narrowed by the search box (the category chips already narrowed `submissions`)
  const items = useMemo(() => {
    const q = query.trim().toLowerCase();
    const matches = q
      ? submissions.filter(sub => [sub.room, sub.area, sub.equipment, sub.description, sub.whoToNotify, sub.submittedBy, categoryText(sub)].join(' ').toLowerCase().includes(q))
      : submissions;
    return matches.slice().sort((a, b) => new Date(b.submittedOn) - new Date(a.submittedOn));
  }, [submissions, query]);

  // Roll back to the top whenever the list itself changes (new search or filter)
  useEffect(() => {
    setVisibleCount(RAIL_PAGE);
    if (scrollRef.current) scrollRef.current.scrollTop = 0;
  }, [items]);

  // Roll more cards in as the end of the list comes into view
  const hasMore = visibleCount < items.length;
  useEffect(() => {
    if (!hasMore) return undefined;
    if (typeof IntersectionObserver === 'undefined') { setVisibleCount(items.length); return undefined; }
    const node = sentinelRef.current;
    if (!node) return undefined;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some(entry => entry.isIntersecting)) setVisibleCount(count => count + RAIL_PAGE);
    }, { root: scrollRef.current, rootMargin: '400px 0px' });
    observer.observe(node);
    return () => observer.disconnect();
  }, [hasMore, visibleCount, items.length]);

  // Day groups: Today / Yesterday / Last 7 days / ...
  const groups = useMemo(() => {
    const out = [];
    items.slice(0, visibleCount).forEach(item => {
      const label = dayBucket(item.submittedOn);
      const last = out[out.length - 1];
      if (last && last.label === label) last.items.push(item);
      else out.push({ label, items: [item] });
    });
    return out;
  }, [items, visibleCount]);

  const locate = (item) => { logEvent(`Action rail: locating ${item.id} on the map`, 'info'); onLocate(item); };
  const open = (item) => { logEvent(`Action rail: opened details for ${item.id}`, 'info'); setSelectedItem(item); };
  const pickCategory = (key) => categoryBar.onOnly(key);
  const hasNarrowing = query.trim() !== '' || categoryBar.selected.length > 0;

  const header = (
      <div className="shrink-0 bg-white border-b border-slate-200 shadow-sm px-4 sm:px-6 py-4 space-y-3 z-10">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 className="text-xl font-bold text-slate-800 flex items-center gap-2">
              <TableIcon className="text-blue-600" />
              Action Item Rail
            </h2>
            <p className="text-sm text-slate-500 mt-1">Newest first. Scroll to roll through every item; double-click a card (or press Locate) to jump to it on the map.</p>
          </div>
          <div className="relative w-full sm:w-72">
            <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none" />
            <input
              type="search"
              value={query}
              onChange={e => setQuery(e.target.value)}
              placeholder="Search room, area, equipment, text..."
              aria-label="Search action items"
              className="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
            />
          </div>
        </div>
        <CategoryFilterBar {...categoryBar} />
        <div role="status" className="text-xs text-slate-600">Showing <span className="font-bold text-slate-700">{items.length}</span> of {timeFilteredCount} items in this timeframe</div>
      </div>
  );

  return (
    <div className="h-full flex flex-col bg-slate-100">
      {!shortScreen && header}
      <div ref={scrollRef} className="flex-1 overflow-y-auto overflow-x-hidden">
        {shortScreen && header}
        <div className="max-w-3xl mx-auto px-4 sm:px-6 pb-8">
          {groups.map(group => (
            <section key={group.label}>
              <h3 className="sticky top-0 z-10 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 bg-slate-100/95 backdrop-blur text-xs font-bold uppercase tracking-wider text-slate-600">{group.label}</h3>
              {/* The rail itself: a vertical spine with a category-coloured node per item */}
              <ol className="relative ml-3 border-l-2 border-slate-300 space-y-3 py-3 list-none">
                {group.items.map(item => (
                  <li key={item.id} className="relative pl-6">
                    <span
                      className="absolute -left-[9px] top-6 w-4 h-4 rounded-full border-2 border-white shadow"
                      style={{ backgroundColor: categoryMeta(item.category).color }}
                      aria-hidden="true"
                    />
                    <RailCard item={item} mapImage={mapImage} aspect={aspect} onLocate={locate} onOpen={open} onEdit={onEdit} onPickCategory={pickCategory} />
                  </li>
                ))}
              </ol>
            </section>
          ))}

          {hasMore && <div ref={sentinelRef} className="py-6 text-center text-xs text-slate-500">Rolling in more items...</div>}
          {!hasMore && items.length > 0 && <div className="py-6 text-center text-xs text-slate-500">End of the rail - {items.length} item{items.length === 1 ? '' : 's'}</div>}

          {items.length === 0 && (
            <div className="text-center text-slate-500 py-16">
              {timeFilteredCount === 0 ? 'No data available for the selected timeframe.' : 'No action items match the current search or categories.'}
              {timeFilteredCount > 0 && hasNarrowing && (
                <div className="mt-2">
                  <button type="button" onClick={() => { setQuery(''); categoryBar.onClear(); }} className="text-blue-700 underline hover:text-blue-900">Clear search and filters</button>
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      <DetailModal
        selectedItem={selectedItem}
        onClose={() => setSelectedItem(null)}
        onEdit={(item) => { setSelectedItem(null); onEdit(item); }}
      />
    </div>
  );
}
