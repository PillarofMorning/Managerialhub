        <h2 className="text-2xl font-black text-[#00468B]">Observation Gallery</h2>
        <div className="flex flex-wrap items-center gap-2">
        <SearchBox query={categoryBar.query} onQuery={categoryBar.onQuery} className="w-full sm:w-72" />
        <div className="flex items-center gap-2 bg-white p-2 rounded-lg shadow-sm">
          <label className="text-sm text-slate-600 font-medium">Group By:</label>
