            {submissions.length === 0 && (
              <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 text-slate-500 font-medium bg-white/50 backdrop-blur-sm">
                 {categoryBar.selected.length > 0 ? (
                   <>
                     <span>No reports match the selected categories.</span>
                     <button type="button" onClick={categoryBar.onClear} className="text-sm text-blue-700 underline hover:text-blue-900">Show all categories</button>
                   </>
                 ) : (
                   <span>No reports submitted yet.</span>
                 )}
              </div>
            )}
          </div>
          
          <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
        </div>
      </div>

      {/* Issues Sidebar */}
      <div className="w-full md:w-72 lg:w-80 bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden shrink-0 mt-4 md:mt-0 h-[30vh] md:h-full">
         <div className="p-3 bg-slate-50 border-b border-slate-200 font-bold text-slate-700 flex justify-between items-center shrink-0">
            <span>Recent Issues</span>
            <span className="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full">{submissions.length}</span>
         </div>
         <div className="flex-1 overflow-y-auto p-2 space-y-2">
            {submissions.slice().sort((a,b) => new Date(b.submittedOn) - new Date(a.submittedOn)).map(sub => (
               <div 
                 key={sub.id} 
                 onClick={() => {
                     logEvent(`Sidebar clicked. Jumping to issue: ${sub.id}`, 'info');
                     setFocusItem(sub);
                 }}
                 className="p-3 rounded-lg border border-slate-100 hover:border-blue-300 hover:bg-blue-50 cursor-pointer transition-colors shadow-sm"
               >
                  <div className="flex justify-between items-start mb-2">
                     <span className="font-bold text-slate-800 text-xs">{new Date(sub.submittedOn).toLocaleDateString()}</span>
                     <span className="text-[10px] px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded font-medium inline-flex items-center gap-1">
                        <span className="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: categoryMeta(sub.category).color }} />
                        {categoryMeta(sub.category).label}
                     </span>
                  </div>
                  <div className="font-semibold text-blue-900 text-sm truncate mb-1">{sub.area} {sub.room ? `- ${sub.room}` : ''}</div>
                  <p className="text-slate-600 text-xs line-clamp-2">{sub.description}</p>
               </div>
            ))}
            {submissions.length === 0 && (
               <div className="text-slate-400 text-xs text-center p-4">No issues match the current filter.</div>
            )}
         </div>
      </div>

      <DetailModal selectedItem={selectedItem} onClose={() => setSelectedItem(null)} onEdit={onEdit} />
    </div>
  );
}

// ==========================================
// TAB 1: SUBMISSION & MAP
// ==========================================
function SubmitTab({ submissions, setSubmissions, logEvent, mapImage, setMainMapImage, editingItem, setEditingItem, pictureColumn }) {
  const mapRef = useRef(null);
  const containerRef = useRef(null);
  const [selection, setSelection] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [hoverPos, setHoverPos] = useState(null);
  const [isResizing, setIsResizing] = useState(false);
  const [zoomLevel, setZoomLevel] = useState(100);
  const [saving, setSaving] = useState(false);
  const [saveError, setSaveError] = useState('');
  // A ref as well as state: two submits in the same tick would both see saving === false
  const savingRef = useRef(false);
  // The tab may be left while a save is in flight; the save still finishes, but must not touch a form that is gone
  const mountedRef = useRef(true);
  useEffect(() => () => { mountedRef.current = false; }, []);

  // Catch edit triggers and set form/selection states
  useEffect(() => {
    if (editingItem) {
       logEvent(`Edit mode activated for ${editingItem.id}. Restoring map bounding box.`, 'debug');
       setSelection({
          x: editingItem.mapX - (editingItem.boxW / 2),
          y: editingItem.mapY - (editingItem.boxH / 2),
          w: editingItem.boxW,
          h: editingItem.boxH
       });
       
       centerMapOn(containerRef.current, editingItem.mapX, editingItem.mapY);

       setShowForm(true);
    }
  }, [editingItem, logEvent]);

  const handleMapInteraction = (e, isDoubleClick) => {
    // Prevent interaction trigger if we were just dragging the resize handle
    if (isResizing) return;
    if (!mapRef.current) return;

    const rect = mapRef.current.getBoundingClientRect();
    
    // Coordinates mathematically adapt to zoom level because they calculate % of current rect.width
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    if (isDoubleClick) {
      if (selection) {
        // Check bounds to see if user clicked outside the selection box
        const isOutside = x < selection.x || x > selection.x + selection.w || y < selection.y || y > selection.y + selection.h;
        if (isOutside) {
           setSelection(null);
           setEditingItem(null); 
           logEvent('Selection canceled by double-clicking outside the box.', 'info');
           return; // Stop here, don't open the form.
        }
      }
      
      // If we made it here, double click was inside selection (or selection was null, so we create it)
      if (!selection) {
         setSelection({ x: Math.max(0, x - 5), y: Math.max(0, y - 5), w: 10, h: 10 });
      }
      logEvent(`Map region double-clicked. Opening form...`, 'info');
      setShowForm(true);

    } else {
      // Single Click
      if (selection) {
        // Move existing selection center to the click point
        setSelection(prev => ({
          ...prev,
          x: Math.max(0, Math.min(x - prev.w/2, 100 - prev.w)),
          y: Math.max(0, Math.min(y - prev.h/2, 100 - prev.h))
        }));
        logEvent('Selection moved.', 'debug');
      } else {
        // Create new default 10x10 selection
        setSelection({
          x: Math.max(0, Math.min(x - 5, 90)),
          y: Math.max(0, Math.min(y - 5, 90)),
          w: 10,
          h: 10
        });
        logEvent(`Map region selected interactively. Pending confirmation.`, 'info');
      }
    }
  };

  return (
    <div className="h-full flex flex-col relative">
      <div className="p-3 bg-white shadow-sm z-10 flex flex-wrap gap-2 justify-between items-center text-sm text-slate-600 shrink-0">
        <span>Click to select/move box. Drag corner to resize. Dbl-click outside to cancel. Dbl-click inside to open form.</span>
        {selection && !showForm && (
          <button 
            onClick={() => { setShowForm(true); logEvent('User confirmed location. Opening form.', 'info'); }}
            className="bg-blue-600 text-white px-4 py-1.5 rounded-md hover:bg-blue-700 shadow flex items-center gap-2"
          >
            <CheckCircle className="w-4 h-4" /> {editingItem ? "Edit Observation" : "Confirm Location"}
          </button>
        )}
      </div>

      {/* Zoomable & Panning Area */}
      <div className="flex-1 bg-slate-300 relative overflow-auto" ref={containerRef}>
        <div 
          className="relative mx-auto select-none cursor-crosshair transition-all origin-top-left"
          ref={mapRef}
          style={{ width: `${zoomLevel}%`, minWidth: '100%' }}
          onClick={(e) => handleMapInteraction(e, false)}
          onDoubleClick={(e) => handleMapInteraction(e, true)}
          onMouseMove={(e) => {
             const rect = mapRef.current.getBoundingClientRect();
             const mouseX = ((e.clientX - rect.left) / rect.width) * 100;
             const mouseY = ((e.clientY - rect.top) / rect.height) * 100;
             
             if (isResizing && selection) {
                // Resize logic based on mouse drag. Works perfectly regardless of zoom size.
                setSelection(prev => ({
                  ...prev,
                  w: Math.max(2, Math.min(mouseX - prev.x, 100 - prev.x)),
                  h: Math.max(2, Math.min(mouseY - prev.y, 100 - prev.y))
                }));
             } else {
                // Hover guidelines logic mapped to pixel values of the container for visual dash lines
                setHoverPos({ x: e.clientX - rect.left, y: e.clientY - rect.top });
             }
          }}
          onMouseUp={() => setIsResizing(false)}
          onMouseLeave={() => { setHoverPos(null); setIsResizing(false); }}
        >
          {mapImage ? (
            <img src={mapImage} onError={() => setMainMapImage(null)} alt="Main Facility Map" className="w-full h-auto block pointer-events-none select-none" draggable="false" />
          ) : (
            <div className="w-full aspect-square"><FacilityMapSvg /></div>
          )}

          {/* Hover Crosshair guides */}
          {hoverPos && !showForm && !isResizing && (
            <>
              <div className="absolute top-0 bottom-0 border-l border-dashed border-slate-500/50 pointer-events-none" style={{ left: hoverPos.x }} />
              <div className="absolute left-0 right-0 border-t border-dashed border-slate-500/50 pointer-events-none" style={{ top: hoverPos.y }} />
            </>
          )}

          {/* Selection Box overlay */}
          {selection && (
            <div 
              className={`absolute border-2 border-blue-500 bg-blue-500/20 shadow-[0_0_0_9999px_rgba(0,0,0,0.4)] transition-all ${isResizing ? 'duration-0' : 'duration-200 pointer-events-none'}`}
              style={{
                left: `${selection.x}%`, top: `${selection.y}%`, 
                width: `${selection.w}%`, height: `${selection.h}%`
              }}
            >
              <div className="absolute -top-6 left-0 bg-blue-600 text-white text-xs px-2 py-0.5 rounded shadow pointer-events-none whitespace-nowrap">
                {editingItem ? 'Editing Selection' : 'Selected Area'}
              </div>
              
              {/* Resize Handle - pointer-events-auto ensures it catches mouse events even if parent is none */}
              <div 
                className="absolute -bottom-2 -right-2 w-4 h-4 bg-white border-2 border-blue-600 cursor-se-resize rounded-full pointer-events-auto shadow hover:scale-110 active:scale-95 transition-transform"
                onMouseDown={(e) => {
                  e.stopPropagation(); // Prevents map single click from firing
                  setIsResizing(true);
                  logEvent('Resizing map selection...', 'debug');
                }}
              />
            </div>
          )}

          {/* Existing Submissions Map Pins (Do not render the one currently being edited) */}
          {submissions.map(sub => {
            if (editingItem && editingItem.id === sub.id) return null;
            return (
              <div 
                key={sub.id} 
                className="absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm pointer-events-none"
                style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%`, transform: 'translate(-50%, -50%)', backgroundColor: categoryMeta(sub.category).color }}
                title={sub.description}
              />
            );
          })}
        </div>
        
        <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
      </div>

      {/* Submission Form Modal / Overlay */}
      {showForm && (
        <div className="absolute inset-0 bg-slate-900/50 backdrop-blur-sm flex justify-center items-center z-[110] p-4">
          <div className="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto flex flex-col animate-in fade-in zoom-in duration-200">
            <div className="p-4 border-b flex justify-between items-center sticky top-0 bg-white z-10">
              <h2 className="text-xl font-bold flex items-center gap-2 text-slate-800">
                <Activity className="text-blue-600" /> {editingItem ? 'Edit Observation' : 'New Observation'}
              </h2>
              <button disabled={saving} title={saving ? 'Saving - one moment' : 'Close'} onClick={() => { 
                setShowForm(false); 
                setEditingItem(null); 
                setSaveError('');
                logEvent('Form closed without submission.', 'info'); 
              }} className="text-slate-400 hover:text-red-500 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-slate-400">
                <X className="w-6 h-6" />
              </button>
            </div>
            
            <div className="p-6">
              <SubmissionForm 
                selection={selection} 
                logEvent={logEvent}
                editingItem={editingItem}
                pictureSupport={pictureColumn}
                saving={saving}
                saveError={saveError}
                onSubmit={async (localData, dbPayload, picture) => {
                  if (savingRef.current) return;
                  savingRef.current = true;
                  setSaving(true);
                  setSaveError('');

                  // LIVE DATAVERSE API FETCH LOGIC FOR CREATE/UPDATE
                  let baseUrl = '';
                  if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) {
                      baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
                  }

                  const url = editingItem 
                      ? `${baseUrl}/api/data/v9.2/craa5__facilityobservations(${editingItem.id})?$select=craa5__facilityobservationid`
                      : `${baseUrl}/api/data/v9.2/craa5__facilityobservations?$select=craa5__facilityobservationid`;
                      
                  const method = editingItem ? 'PATCH' : 'POST';
                  
                  logEvent(`${method} Request starting to ${url}...`, 'data', dbPayload);

                  try {
                      const response = await fetch(url, {
                          method: method,
                          headers: {
                              'Accept': 'application/json',
                              'Content-Type': 'application/json',
                              'OData-MaxVersion': '4.0', 
                              'OData-Version': '4.0',
                              'Prefer': 'return=representation',
                              // Without If-Match a PATCH is an upsert: it would quietly re-create an observation someone has deleted
                              ...(editingItem ? { 'If-Match': '*' } : {})
                          },
                          body: JSON.stringify(dbPayload)
                      });

                      if (response.ok) {
                          let savedId = localData.id;
                          
                          if (response.status === 201 || response.status === 200) {
                             try {
                               const resData = await response.json();
                               if (resData.craa5__facilityobservationid) {
                                   savedId = resData.craa5__facilityobservationid;
                                   localData.id = savedId;
                               }
                             } catch(e) {}
                          } else if (response.status === 204) {
                             const entityIdHeader = response.headers.get('OData-EntityId');
                             if (entityIdHeader) {
                                 const match = entityIdHeader.match(/\(([^)]+)\)/);
                                 if (match) savedId = match[1];
                                 localData.id = savedId;
                             }
                          }

                          // The picture travels in its own request once the record exists
                          let pictureFailure = '';
                          if (picture) {
                              try {
                                  if (!pictureColumn.ready) throw new Error(`Pictures cannot be saved: ${pictureColumn.reason}`);
                                  if (picture.op === 'new') {
                                      logEvent(`Uploading picture to ${pictureColumn.name} for ${savedId} (${Math.round(picture.dataUrl.length * 0.75 / 1024)} KB)...`, 'data',
                                          { column: pictureColumn.name, id: savedId, bytes: Math.round(picture.dataUrl.length * 0.75) },
                                          { method: 'PATCH', path: `${DATAVERSE_SCHEMA.TableName}(${savedId})/${pictureColumn.name}`, contentType: 'application/octet-stream' });
                                      await uploadPicture(pictureColumn.name, savedId, picture.dataUrl);
                                      logEvent(`Dataverse picture upload Success (ID: ${savedId})`, 'success');
                                  } else {
                                      logEvent(`Clearing picture in ${pictureColumn.name} for ${savedId}...`, 'data', { column: pictureColumn.name, id: savedId, action: 'delete' },
                                          { method: 'DELETE', path: `${DATAVERSE_SCHEMA.TableName}(${savedId})/${pictureColumn.name}`, contentType: '(no body)' });
                                      await deletePicture(pictureColumn.name, savedId);
                                      logEvent(`Dataverse picture removal Success (ID: ${savedId})`, 'success');
                                  }
                              } catch (picErr) {
                                  pictureFailure = picErr.message;
                                  logEvent(`Dataverse Picture Save Failed: ${picErr.message}`, 'error', { id: savedId, column: pictureColumn.name, op: picture.op });
                              }
                          }

                          // What the lists show: the new picture, none after a removal, or whatever was there before
                          if (picture && !pictureFailure) {
                              localData.image = picture.op === 'new' ? picture.dataUrl : null;
                              localData.picture = null;
                          } else if (picture && pictureFailure) {
                              // The record is saved but the picture is not: show the truth in the lists
                              localData.image = editingItem ? editingItem.image : null;
                              localData.picture = editingItem ? editingItem.picture : null;
                          }

                          if (editingItem) {
                            setSubmissions(prev => prev.map(s => s.id === localData.id ? localData : s));
                            logEvent(`Dataverse PATCH Success (ID: ${localData.id})`, 'success');
                          } else {
                            setSubmissions(prev => [localData, ...prev]);
                            logEvent(`Dataverse POST Success (ID: ${localData.id})`, 'success');
                          }

                          if (pictureFailure) {
                              // Keep the form open on the saved record so "Update" retries only the picture instead of creating a duplicate
                              if (mountedRef.current) {
                                  setEditingItem(localData);
                                  setSaveError(`The observation was saved, but its picture could not be ${picture.op === 'new' ? 'uploaded' : 'removed'}: ${pictureFailure} Press Update Observation to try the picture again.`);
                              }
                          } else {
                              setShowForm(false);
                              setSelection(null);
                              setEditingItem(null);
                          }
                      } else {
                          const errData = await response.text();
                          let reason = `HTTP ${response.status}`;
                          try { reason = `${JSON.parse(errData).error.message} (HTTP ${response.status})`; } catch (e) { /* not a Dataverse error body */ }
                          if (response.status === 404 && editingItem) reason = 'this observation no longer exists in Dataverse (HTTP 404)';
                          setSaveError(`Dataverse did not save the observation: ${reason}. Nothing was changed.`);
                          logEvent(`Dataverse Save Failed: HTTP ${response.status}`, 'error', { responseText: errData, payloadSent: dbPayload });
                      }
                  } catch (error) {
                      setSaveError(`The observation could not be sent: ${error.message}. Nothing was changed - try again.`);
                      logEvent(`Dataverse Network Error: ${error.message}`, 'error', dbPayload);
                  } finally {
                      savingRef.current = false;
                      setSaving(false);
                  }
                }} 
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function SubmissionForm({ selection, onSubmit, logEvent, editingItem, pictureSupport, saving, saveError }) {
  const [formData, setFormData] = useState({
    image: null, // a NEW picture picked in this form (data URL). The picture already stored is shown via editingItem.
    room: editingItem?.room || '',
    area: editingItem?.area || '',
    equipment: editingItem?.equipment || '',
    description: editingItem?.description || '',
    whoToNotify: editingItem?.whoToNotify || '',
    category: editingItem?.category || 'note',
    customNote: editingItem?.customNote || ''
  });
  const [errors, setErrors] = useState({});
  const [removedStored, setRemovedStored] = useState(false); // the user pressed Remove on the stored picture
  const [storedMissing, setStoredMissing] = useState(false);  // the stored picture turned out not to exist / not to load
  const [pictureError, setPictureError] = useState('');
  const storedSources = editingItem ? pictureSources(editingItem) : [];
  const storedShown = storedSources.length > 0 && !removedStored && !storedMissing;
  const previewSources = formData.image ? [formData.image] : (storedShown ? storedSources : []);
  const handleStoredMissing = useCallback(() => setStoredMissing(true), []);
  const [preparingPicture, setPreparingPicture] = useState(false);

  const handleImageChange = async (e) => {
    const file = e.target.files && e.target.files[0];
    e.target.value = ''; // picking the same file again must still fire onChange
    if (!file) return;
    logEvent(`Image selected: ${file.name} (${(file.size/1024).toFixed(1)} KB)`, 'debug');
    setPictureError('');
    setPreparingPicture(true);
    try {
      const dataUrl = await compressImage(file);
      setFormData(prev => ({ ...prev, image: dataUrl }));
      logEvent(`Image resized for upload: ${Math.round(dataUrl.length * 0.75 / 1024)} KB JPEG`, 'debug');
    } catch (err) {
      setPictureError(err.message);
      logEvent(`Image could not be prepared: ${err.message}`, 'error', { fileName: file.name, fileType: file.type, sizeKB: Math.round(file.size / 1024) });
    } finally {
      setPreparingPicture(false);
    }
  };

  const handleRemoveImage = () => {
    setFormData(prev => ({ ...prev, image: null }));
    setPictureError('');
    // Removing a stored picture means clearing it on the server when the form is saved
    if (storedSources.length > 0) setRemovedStored(true);
    logEvent('Picture removed from the form.', 'debug');
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (saving || preparingPicture) return;
    logEvent('Validating form data...', 'debug');
    const newErrors = {};
    if (!formData.area.trim()) newErrors.area = "Area is required";
    if (!formData.description.trim()) newErrors.description = "Description is required";
    if (formData.category === 'note' && !formData.customNote.trim()) newErrors.customNote = "Custom text is required for Notes";
    // The category and the note share one Dataverse column, so a note reading exactly like a category would become that category on reload
    else if (formData.category === 'note' && CATEGORIES.some(c => c.key !== 'note' && c.key === formData.customNote.trim().toLowerCase())) newErrors.customNote = "That is a category name - pick it from the Issue Category list instead";
    
    if (Object.keys(newErrors).length > 0) {
      logEvent('Form validation failed.', 'warn', newErrors);
      setErrors(newErrors);
      return;
    }

    logEvent('Form validation passed. Compiling payload mapped to live schema...', 'debug');
    
    const localData = {
      id: editingItem ? editingItem.id : `obs-${Date.now()}`,
      mapX: selection.x + (selection.w / 2),
      mapY: selection.y + (selection.h / 2),
      boxW: selection.w,
      boxH: selection.h,
      ...formData,
      // formData.image is only a NEW picture; keep whatever is already stored unless the save changes it
      image: editingItem ? editingItem.image : null,
      picture: editingItem ? editingItem.picture : null,
      submittedBy: editingItem ? editingItem.submittedBy : 'Current User',
      submittedOn: editingItem ? editingItem.submittedOn : new Date().toISOString()
    };

    // Mapped STRICTLY to Dataverse Schema Logical Names based on user's column specs
    const dbPayload = {
      craa5_mapx: parseFloat(localData.mapX.toFixed(4)),
      craa5_mapy: parseFloat(localData.mapY.toFixed(4)),
      craa5__boxwidth: parseFloat(localData.boxW.toFixed(4)),
      craa5__boxheight: parseFloat(localData.boxH.toFixed(4)),
      craa5__room: formData.room,
      craa5__area: formData.area,
      craa5__equipment: formData.equipment,
      craa5__description: formData.description,
      craa5__whotonotify: formData.whoToNotify,
      craa5__customnote: formData.category === 'note' ? formData.customNote : formData.category,
      craa5__facility: 'MAIN' 
    };

    // new picture -> upload it; stored picture removed -> clear it; otherwise leave the picture alone
    const pictureChange = formData.image
