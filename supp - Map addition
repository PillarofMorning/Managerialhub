// ==========================================
// TAB 1: SUBMISSION & MAP
// ==========================================
function SubmitTab({ submissions, setSubmissions, logEvent, mapImage, setMainMapImage, editingItem, setEditingItem }) {
  const mapRef = useRef(null);
  const containerRef = useRef(null);
  const [selection, setSelection] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [hoverPos, setHoverPos] = useState(null);
  const [isResizing, setIsResizing] = useState(false);
  const [zoomLevel, setZoomLevel] = useState(100);

  // Catch edit triggers and set form/selection states
  useEffect(() => {
    if (editingItem) {
       logEvent(`Edit mode activated for ${editingItem.id}. Restoring map bounding box.`, 'debug');
       setSelection({
          x: editingItem.mapX - (editingItem.boxW / 2),
          y: editingItem.mapY - (editingItem.boxH / 2),
          w: editingItem.boxW,
          h: editingItem.boxH
       });
       
       if (containerRef.current) {
          const scrollW = containerRef.current.scrollWidth;
          const scrollH = containerRef.current.scrollHeight;
          const x = (editingItem.mapX / 100) * scrollW;
          const y = (editingItem.mapY / 100) * scrollH;
          containerRef.current.scrollTo({
              left: x - containerRef.current.clientWidth / 2,
              top: y - containerRef.current.clientHeight / 2,
              behavior: 'smooth'
          });
       }

       setShowForm(true);
    }
  }, [editingItem, logEvent]);

  const handleMapInteraction = (e, isDoubleClick) => {
    // Prevent interaction trigger if we were just dragging the resize handle
    if (isResizing) return;
    if (!mapRef.current) return;

    const rect = mapRef.current.getBoundingClientRect();
    
    // Coordinates mathematically adapt to zoom level because they calculate % of current rect.width
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    if (isDoubleClick) {
      if (selection) {
        // Check bounds to see if user clicked outside the selection box
        const isOutside = x < selection.x || x > selection.x + selection.w || y < selection.y || y > selection.y + selection.h;
        if (isOutside) {
           setSelection(null);
           setEditingItem(null); 
           logEvent('Selection canceled by double-clicking outside the box.', 'info');
           return; // Stop here, don't open the form.
        }
      }
      
      // If we made it here, double click was inside selection (or selection was null, so we create it)
      if (!selection) {
         setSelection({ x: Math.max(0, x - 5), y: Math.max(0, y - 5), w: 10, h: 10 });
      }
      logEvent(`Map region double-clicked. Opening form...`, 'info');
      setShowForm(true);

    } else {
      // Single Click
      if (selection) {
        // Move existing selection center to the click point
        setSelection(prev => ({
          ...prev,
          x: Math.max(0, Math.min(x - prev.w/2, 100 - prev.w)),
          y: Math.max(0, Math.min(y - prev.h/2, 100 - prev.h))
        }));
        logEvent('Selection moved.', 'debug');
      } else {
        // Create new default 10x10 selection
        setSelection({
          x: Math.max(0, Math.min(x - 5, 90)),
          y: Math.max(0, Math.min(y - 5, 90)),
          w: 10,
          h: 10
        });
        logEvent(`Map region selected interactively. Pending confirmation.`, 'info');
      }
    }
  };

  return (
    <div className="h-full flex flex-col relative">
      <div className="p-3 bg-white shadow-sm z-10 flex flex-wrap gap-2 justify-between items-center text-sm text-slate-600 shrink-0">
        <span>Click to select/move box. Drag corner to resize. Dbl-click outside to cancel. Dbl-click inside to open form.</span>
        {selection && !showForm && (
          <button 
            onClick={() => { setShowForm(true); logEvent('User confirmed location. Opening form.', 'info'); }}
            className="bg-blue-600 text-white px-4 py-1.5 rounded-md hover:bg-blue-700 shadow flex items-center gap-2"
          >
            <CheckCircle className="w-4 h-4" /> {editingItem ? "Edit Observation" : "Confirm Location"}
          </button>
        )}
      </div>

      {/* Zoomable & Panning Area */}
      <div className="flex-1 bg-slate-300 relative overflow-auto" ref={containerRef}>
        <div 
          className="relative mx-auto select-none cursor-crosshair transition-all origin-top-left"
          ref={mapRef}
          style={{ width: `${zoomLevel}%`, minWidth: '100%' }}
          onClick={(e) => handleMapInteraction(e, false)}
          onDoubleClick={(e) => handleMapInteraction(e, true)}
          onMouseMove={(e) => {
             const rect = mapRef.current.getBoundingClientRect();
             const mouseX = ((e.clientX - rect.left) / rect.width) * 100;
             const mouseY = ((e.clientY - rect.top) / rect.height) * 100;
             
             if (isResizing && selection) {
                // Resize logic based on mouse drag. Works perfectly regardless of zoom size.
                setSelection(prev => ({
                  ...prev,
                  w: Math.max(2, Math.min(mouseX - prev.x, 100 - prev.x)),
                  h: Math.max(2, Math.min(mouseY - prev.y, 100 - prev.y))
                }));
             } else {
                // Hover guidelines logic mapped to pixel values of the container for visual dash lines
                setHoverPos({ x: e.clientX - rect.left, y: e.clientY - rect.top });
             }
          }}
          onMouseUp={() => setIsResizing(false)}
          onMouseLeave={() => { setHoverPos(null); setIsResizing(false); }}
        >
          {mapImage ? (
            <img src={mapImage} onError={() => setMainMapImage(null)} alt="Main Facility Map" className="w-full h-auto block pointer-events-none select-none" draggable="false" />
          ) : (
            <div className="w-full aspect-square"><FacilityMapSvg /></div>
          )}

          {/* Hover Crosshair guides */}
          {hoverPos && !showForm && !isResizing && (
            <>
              <div className="absolute top-0 bottom-0 border-l border-dashed border-slate-500/50 pointer-events-none" style={{ left: hoverPos.x }} />
              <div className="absolute left-0 right-0 border-t border-dashed border-slate-500/50 pointer-events-none" style={{ top: hoverPos.y }} />
            </>
          )}

          {/* Selection Box overlay */}
          {selection && (
            <div 
              className={`absolute border-2 border-blue-500 bg-blue-500/20 shadow-[0_0_0_9999px_rgba(0,0,0,0.4)] transition-all ${isResizing ? 'duration-0' : 'duration-200 pointer-events-none'}`}
              style={{
                left: `${selection.x}%`, top: `${selection.y}%`, 
                width: `${selection.w}%`, height: `${selection.h}%`
              }}
            >
              <div className="absolute -top-6 left-0 bg-blue-600 text-white text-xs px-2 py-0.5 rounded shadow pointer-events-none whitespace-nowrap">
                {editingItem ? 'Editing Selection' : 'Selected Area'}
              </div>
              
              {/* Resize Handle - pointer-events-auto ensures it catches mouse events even if parent is none */}
              <div 
                className="absolute -bottom-2 -right-2 w-4 h-4 bg-white border-2 border-blue-600 cursor-se-resize rounded-full pointer-events-auto shadow hover:scale-110 active:scale-95 transition-transform"
                onMouseDown={(e) => {
                  e.stopPropagation(); // Prevents map single click from firing
                  setIsResizing(true);
                  logEvent('Resizing map selection...', 'debug');
                }}
              />
            </div>
          )}

          {/* Existing Submissions Map Pins (Do not render the one currently being edited) */}
          {submissions.map(sub => {
            if (editingItem && editingItem.id === sub.id) return null;
            return (
              <div 
                key={sub.id} 
                className="absolute w-2.5 h-2.5 bg-red-500 rounded-full border border-white shadow-sm pointer-events-none"
                style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%`, transform: 'translate(-50%, -50%)' }}
                title={sub.description}
              />
            );
          })}
        </div>
        
        <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
      </div>

      {/* Submission Form Modal / Overlay */}
      {showForm && (
        <div className="absolute inset-0 bg-slate-900/50 backdrop-blur-sm flex justify-center items-center z-[110] p-4">
          <div className="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto flex flex-col animate-in fade-in zoom-in duration-200">
            <div className="p-4 border-b flex justify-between items-center sticky top-0 bg-white z-10">
              <h2 className="text-xl font-bold flex items-center gap-2 text-slate-800">
                <Activity className="text-blue-600" /> {editingItem ? 'Edit Observation' : 'New Observation'}
              </h2>
              <button onClick={() => { 
                setShowForm(false); 
                setEditingItem(null); 
                logEvent('Form closed without submission.', 'info'); 
              }} className="text-slate-400 hover:text-red-500">
                <X className="w-6 h-6" />
              </button>
            </div>
            
            <div className="p-6">
              <SubmissionForm 
                selection={selection} 
                logEvent={logEvent}
                editingItem={editingItem}
                onSubmit={async (localData, dbPayload) => {
                  
                  // LIVE DATAVERSE API FETCH LOGIC FOR CREATE/UPDATE
                  let baseUrl = '';
                  if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) {
                      baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
                  }

                  const url = editingItem 
                      ? `${baseUrl}/api/data/v9.2/craa5__facilityobservations(${editingItem.id})`
                      : `${baseUrl}/api/data/v9.2/craa5__facilityobservations`;
                      
                  const method = editingItem ? 'PATCH' : 'POST';
                  
                  logEvent(`${method} Request starting to ${url}...`, 'data', dbPayload);

                  try {
                      const response = await fetch(url, {
                          method: method,
                          headers: {
                              'Accept': 'application/json',
                              'Content-Type': 'application/json',
                              'OData-MaxVersion': '4.0', 
                              'OData-Version': '4.0',
                              'Prefer': 'return=representation'
                          },
                          body: JSON.stringify(dbPayload)
                      });

                      if (response.ok) {
                          let savedId = localData.id;
                          
                          if (response.status === 201 || response.status === 200) {
                             try {
                               const resData = await response.json();
                               if (resData.craa5__facilityobservationid) {
                                   savedId = resData.craa5__facilityobservationid;
                                   localData.id = savedId;
                               }
                             } catch(e) {}
                          } else if (response.status === 204) {
                             const entityIdHeader = response.headers.get('OData-EntityId');
                             if (entityIdHeader) {
                                 const match = entityIdHeader.match(/\(([^)]+)\)/);
                                 if (match) savedId = match[1];
                                 localData.id = savedId;
                             }
                          }

                          if (editingItem) {
                            setSubmissions(prev => prev.map(s => s.id === localData.id ? localData : s));
                            logEvent(`Dataverse PATCH Success (ID: ${localData.id})`, 'success');
                          } else {
                            setSubmissions(prev => [localData, ...prev]);
                            logEvent(`Dataverse POST Success (ID: ${localData.id})`, 'success');
                          }
                          
                          setShowForm(false);
                          setSelection(null);
                          setEditingItem(null);
                      } else {
                          const errData = await response.text();
                          logEvent(`Dataverse Save Failed: HTTP ${response.status}`, 'error', { responseText: errData, payloadSent: dbPayload });
                      }
                  } catch (error) {
                      logEvent(`Dataverse Network Error: ${error.message}`, 'error', dbPayload);
                  }
                }} 
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function SubmissionForm({ selection, onSubmit, logEvent, editingItem }) {
  const [formData, setFormData] = useState({
    image: editingItem?.image || null,
    room: editingItem?.room || '',
    area: editingItem?.area || '',
    equipment: editingItem?.equipment || '',
    description: editingItem?.description || '',
    whoToNotify: editingItem?.whoToNotify || '',
    category: editingItem?.category || 'note',
    customNote: editingItem?.customNote || ''
  });
  const [errors, setErrors] = useState({});

  const handleImageChange = (e) => {
    const file = e.target.files[0];
    if (file) {
      logEvent(`Image selected: ${file.name} (${(file.size/1024).toFixed(1)} KB)`, 'debug');
      const reader = new FileReader();
      reader.onloadend = () => {
        setFormData(prev => ({ ...prev, image: reader.result }));
      };
      reader.readAsDataURL(file);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    logEvent('Validating form data...', 'debug');
    const newErrors = {};
    if (!formData.area.trim()) newErrors.area = "Area is required";
    if (!formData.description.trim()) newErrors.description = "Description is required";
    if (formData.category === 'note' && !formData.customNote.trim()) newErrors.customNote = "Custom text is required for Notes";
    
    if (Object.keys(newErrors).length > 0) {
      logEvent('Form validation failed.', 'warn', newErrors);
      setErrors(newErrors);
      return;
    }

    logEvent('Form validation passed. Compiling payload mapped to live schema...', 'debug');
    
    const localData = {
      id: editingItem ? editingItem.id : `obs-${Date.now()}`,
      mapX: selection.x + (selection.w / 2),
      mapY: selection.y + (selection.h / 2),
      boxW: selection.w,
      boxH: selection.h,
      ...formData,
      submittedBy: editingItem ? editingItem.submittedBy : 'Current User',
      submittedOn: editingItem ? editingItem.submittedOn : new Date().toISOString()
    };

    // Mapped STRICTLY to Dataverse Schema Logical Names based on user's column specs
    const dbPayload = {
      craa5_mapx: parseFloat(localData.mapX.toFixed(4)),
      craa5_mapy: parseFloat(localData.mapY.toFixed(4)),
      craa5__boxwidth: parseFloat(localData.boxW.toFixed(4)),
      craa5__boxheight: parseFloat(localData.boxH.toFixed(4)),
      craa5__room: formData.room,
      craa5__area: formData.area,
      craa5__equipment: formData.equipment,
      craa5__description: formData.description,
      craa5__whotonotify: formData.whoToNotify,
      craa5__customnote: formData.category === 'note' ? formData.customNote : formData.category,
      craa5__facility: 'MAIN' 
    };

    onSubmit(localData, dbPayload);
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-5">
      {/* Image Upload */}
      <div>
        <label className="block text-sm font-medium text-slate-700 mb-1">Picture Upload</label>
        <div className="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-lg hover:border-blue-500 transition-colors bg-slate-50 relative overflow-hidden group">
          {formData.image ? (
            <>
              <img src={formData.image} alt="Preview" className="max-h-48 object-contain" />
              <div className="absolute inset-0 bg-black/50 hidden group-hover:flex items-center justify-center">
                 <span className="text-white text-sm font-medium">Click to change image</span>
                 <input type="file" accept="image/*" onChange={handleImageChange} className="absolute inset-0 opacity-0 cursor-pointer" />
              </div>
            </>
          ) : (
            <div className="space-y-1 text-center">
              <Camera className="mx-auto h-12 w-12 text-slate-400" />
              <div className="flex text-sm text-slate-600 justify-center">
                <label htmlFor="file-upload" className="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none px-2 py-1">
                  <span>Upload a file</span>
                  <input id="file-upload" name="file-upload" type="file" accept="image/*" className="sr-only" onChange={handleImageChange} />
                </label>
              </div>
              <p className="text-xs text-slate-500">PNG, JPG, GIF up to 10MB</p>
            </div>
          )}
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* Room */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Room</label>
          <input type="text" className="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border" 
            value={formData.room} onChange={e => setFormData({...formData, room: e.target.value})} />
        </div>
        
        {/* Area (Required) */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Area <span className="text-red-500">*</span></label>
          <input type="text" className={`mt-1 block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border ${errors.area ? 'border-red-500' : 'border-slate-300'}`}
            value={formData.area} onChange={e => { setFormData({...formData, area: e.target.value}); setErrors({...errors, area: null}) }} />
          {errors.area && <p className="text-red-500 text-xs mt-1">{errors.area}</p>}
        </div>

        {/* Equipment */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Equipment</label>
          <input type="text" className="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border"
            value={formData.equipment} onChange={e => setFormData({...formData, equipment: e.target.value})} />
        </div>

        {/* Who to notify */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Who to Notify</label>
          <input type="text" className="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border"
            value={formData.whoToNotify} onChange={e => setFormData({...formData, whoToNotify: e.target.value})} placeholder="e.g. Maintenance, Safety Officer" />
        </div>
      </div>

      {/* Description (Required) */}
      <div>
        <label className="block text-sm font-medium text-slate-700">Description <span className="text-red-500">*</span></label>
        <textarea rows="3" className={`mt-1 block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border ${errors.description ? 'border-red-500' : 'border-slate-300'}`}
          value={formData.description} onChange={e => { setFormData({...formData, description: e.target.value}); setErrors({...errors, description: null}) }} />
        {errors.description && <p className="text-red-500 text-xs mt-1">{errors.description}</p>}
      </div>

      {/* Category Dropdown */}
      <div className="bg-slate-50 p-4 rounded-lg border border-slate-200">
        <label className="block text-sm font-medium text-slate-700 mb-2">Issue Category</label>
        <select 
          className="block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border"
          value={formData.category} onChange={e => setFormData({...formData, category: e.target.value})}
        >
          <option value="to be cleaned">To Be Cleaned</option>
          <option value="to be fixed">To Be Fixed</option>
          <option value="safety concern">Safety Concern</option>
          <option value="idea">Idea</option>
          <option value="fsq concern">FSQ Concern</option>
          <option value="note">Note (Custom)</option>
        </select>

        {formData.category === 'note' && (
          <div className="mt-3">
             <label className="block text-sm font-medium text-slate-700">Custom Text <span className="text-red-500">*</span></label>
             <input type="text" className={`mt-1 block w-full rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border ${errors.customNote ? 'border-red-500' : 'border-slate-300'}`}
              value={formData.customNote} onChange={e => { setFormData({...formData, customNote: e.target.value}); setErrors({...errors, customNote: null}) }} placeholder="Enter custom category note..." />
             {errors.customNote && <p className="text-red-500 text-xs mt-1">{errors.customNote}</p>}
          </div>
        )}
      </div>

      <div className="pt-4 flex justify-end">
        <button type="submit" className="bg-blue-600 text-white px-6 py-2 rounded-lg shadow hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-all font-medium text-lg">
          {editingItem ? 'Update Observation' : 'Submit Observation'}
        </button>
      </div>
    </form>
  );
}

// ==========================================
// TAB 2: GALLERY VIEW
// ==========================================
function GalleryTab({ submissions, logEvent, onEdit }) {
  const [groupBy, setGroupBy] = useState('combined'); // 'combined' means Room -> Area -> Equipment
  const [selectedItem, setSelectedItem] = useState(null);

  // Group logic
  const groupedData = useMemo(() => {
    return submissions.reduce((acc, sub) => {
      let key = 'Other';
      if (groupBy === 'combined') {
        key = [sub.room, sub.area, sub.equipment].filter(Boolean).join(' > ') || 'Unassigned Location';
      } else {
        key = sub[groupBy] || `No ${groupBy}`;
      }
      if (!acc[key]) acc[key] = [];
      acc[key].push(sub);
      return acc;
    }, {});
  }, [submissions, groupBy]);

  const handleDoubleClick = (item) => {
    logEvent(`Gallery item double-clicked. ID: ${item.id}`, 'info');
    setSelectedItem(item);
  };

  return (
    <div className="h-full flex flex-col bg-slate-100 p-6 overflow-auto">
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-2xl font-bold text-slate-800">Observation Gallery</h2>
        <div className="flex items-center gap-2 bg-white p-2 rounded-lg shadow-sm">
          <label className="text-sm text-slate-600 font-medium">Group By:</label>
          <select 
            className="border-slate-300 rounded text-sm p-1"
            value={groupBy} onChange={e => { setGroupBy(e.target.value); logEvent(`Gallery grouping changed to: ${e.target.value}`, 'debug'); }}
          >
            <option value="combined">Location (Room/Area/Equip)</option>
            <option value="category">Category</option>
            <option value="area">Area Only</option>
            <option value="submittedBy">Submitter</option>
          </select>
        </div>
      </div>

      <div className="space-y-8 pb-12">
        {Object.entries(groupedData).map(([groupName, items]) => (
          <div key={groupName} className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div className="bg-slate-50 border-b border-slate-200 px-4 py-3 font-semibold text-slate-700 text-lg flex items-center gap-2">
               <Search className="w-5 h-5 text-slate-400" /> {groupName}
               <span className="text-xs bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-auto">{items.length} items</span>
            </div>
            <div className="p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {items.map(item => (
                <div 
                  key={item.id}
                  onDoubleClick={() => handleDoubleClick(item)}
                  className="group relative bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-all cursor-pointer hover:border-blue-400"
                >
                  <div className="aspect-video bg-slate-100 flex items-center justify-center overflow-hidden border-b border-slate-100">
                    {item.image ? (
                      <img src={item.image} alt="Observation" className="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                    ) : (
                      <ImageIcon className="w-10 h-10 text-slate-300" />
                    )}
                  </div>
                  <div className="p-3 space-y-1">
                    <div className="flex justify-between items-start">
                      <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 capitalize">
                        {item.category === 'note' ? 'Note' : item.category}
                      </span>
                      <span className="text-[10px] text-slate-400">{new Date(item.submittedOn).toLocaleDateString()}</span>
                    </div>
                    <p className="text-sm font-medium text-slate-800 line-clamp-1">{item.description}</p>
                    <p className="text-xs text-slate-500">By: {item.submittedBy}</p>
                  </div>
                  
                  {/* Overlay tooltip hint for double click */}
                  <div className="absolute inset-0 bg-blue-900/0 group-hover:bg-blue-900/5 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none">
                     <span className="bg-slate-900 text-white text-xs px-2 py-1 rounded-md flex items-center gap-1 shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-all">
                       <Maximize2 className="w-3 h-3" /> Double-click to expand
                     </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        {Object.keys(groupedData).length === 0 && (
          <div className="text-center text-slate-500 py-12">No observations submitted yet.</div>
        )}
      </div>

      <DetailModal 
         selectedItem={selectedItem} 
         onClose={() => setSelectedItem(null)} 
         onEdit={(item) => { setSelectedItem(null); onEdit(item); }} 
      />
    </div>
  );
}

// ==========================================
// TAB 3: TABLE VIEW
// ==========================================
function TableTab({ submissions, mapImage, onLocate }) {
  return (
    <div className="h-full bg-white overflow-auto flex flex-col">
      <div className="p-6 border-b border-slate-200 bg-slate-50 sticky top-0 z-10">
        <h2 className="text-xl font-bold text-slate-800 flex items-center gap-2">
          <TableIcon className="text-blue-600" />
          Raw Data Table
        </h2>
        <p className="text-sm text-slate-500 mt-1">Direct view of underlying records. Double-click any row to instantly jump to its location on the map.</p>
      </div>

      <div className="p-6 overflow-x-auto flex-1">
        <table className="w-full text-left border-collapse min-w-[1000px]">
          <thead>
            <tr className="bg-slate-100 border-y border-slate-200 text-sm text-slate-600 uppercase tracking-wider">
              <th className="p-3 font-semibold">Location</th>
              <th className="p-3 font-semibold">Date</th>
              <th className="p-3 font-semibold">Submitted By</th>
              <th className="p-3 font-semibold">Category</th>
              <th className="p-3 font-semibold">Rm/Ar/Eq</th>
              <th className="p-3 font-semibold">Description</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100 text-sm">
            {submissions.map((sub) => (
              <tr 
                key={sub.id} 
                className="hover:bg-blue-50 transition-colors cursor-pointer group"
                onDoubleClick={() => onLocate(sub)}
              >
                {/* CSS GENERATED LOCATION THUMBNAIL (800% ZOOM CROP) */}
                <td className="p-3">
                  {mapImage ? (
                    <div 
                       className="w-12 h-12 rounded border border-slate-300 shadow-sm relative overflow-hidden"
                       title="Double-click to zoom map"
                       style={{
                          backgroundImage: `url(${mapImage})`,
                          backgroundSize: '800% 800%',
                          backgroundPosition: `${sub.mapX}% ${sub.mapY}%`
                       }}
                    >
                       <div className="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/30 transition-colors" />
                       {/* Center dot to show pin in thumbnail */}
                       <div className="absolute top-1/2 left-1/2 w-1.5 h-1.5 bg-red-500 rounded-full transform -translate-x-1/2 -translate-y-1/2 shadow" />
                    </div>
                  ) : (
                    <div className="w-12 h-12 bg-slate-200 rounded border border-slate-300 flex items-center justify-center text-[10px] text-slate-400">N/A</div>
                  )}
                </td>
                <td className="p-3 text-slate-600 whitespace-nowrap">{new Date(sub.submittedOn).toLocaleDateString()}</td>
                <td className="p-3 font-medium text-slate-800">{sub.submittedBy}</td>
                <td className="p-3">
                  <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 capitalize border border-slate-200">
                    {sub.category}
                  </span>
                </td>
                <td className="p-3 text-slate-600">
                  {[sub.room, sub.area, sub.equipment].filter(Boolean).join(' / ')}
                </td>
                <td className="p-3 text-slate-800 max-w-xs truncate" title={sub.description}>
                  {sub.description}
                </td>
              </tr>
            ))}
            {submissions.length === 0 && (
              <tr>
                <td colSpan="6" className="p-8 text-center text-slate-500">
                  No data available for the selected timeframe.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
