const categoryMeta = (key) => CATEGORIES.find(c => c.key === key) || CATEGORIES[CATEGORIES.length - 1];

// Dataverse keeps the category AND the custom note in ONE column (craa5__customnote):
// a preset name for the five presets, or free text for a "note". Split it back apart so every
// free-text note counts as the single "note" category instead of becoming a category of its own.
const parseCategory = (raw) => {
  const text = (raw || '').trim();
  const preset = CATEGORIES.find(c => c.key !== 'note' && c.key === text.toLowerCase());
  return preset ? { category: preset.key, customNote: '' } : { category: 'note', customNote: text };
};

const categoryText = (item) => {
  if (item.category === 'note') return item.customNote ? `Note: ${item.customNote}` : 'Note';
  return categoryMeta(item.category).label;
};

// What the search box looks through
const searchText = (sub) => [sub.room, sub.area, sub.equipment, sub.description, sub.whoToNotify, sub.submittedBy, categoryText(sub)].join(' ').toLowerCase();

// Flag / pin colour: the category's, or grey once the item is closed
const itemColor = (item) => (item.closed ? CLOSED_COLOR : categoryMeta(item.category).color);

// --- TIME HELPERS FOR THE ACTION RAIL ---
// --- PICTURE HELPERS ---
const MAX_PICTURE_SIDE = 1600; // px on the long side. Phone photos (5-12 MB) become a JPEG of a few hundred KB.

// Re-encode whatever the user picked as a JPEG that is small enough to upload reliably. Resolves a data URL.
const compressImage = (file) => new Promise((resolve, reject) => {
  const objectUrl = URL.createObjectURL(file);
  const img = new Image();
  img.onerror = () => {
    URL.revokeObjectURL(objectUrl);
    reject(new Error('That file is not a picture this browser can open. Try a JPG or PNG.'));
  };
  img.onload = () => {
    URL.revokeObjectURL(objectUrl);
    try {
      const scale = Math.min(1, MAX_PICTURE_SIDE / Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.width * scale));
      canvas.height = Math.max(1, Math.round(img.height * scale));
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#FFFFFF'; // JPEG has no transparency: see-through parts would turn black
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', 0.8));
    } catch (err) {
      reject(new Error('The picture could not be prepared for upload.'));
    }
  };
  img.src = objectUrl;
});

const dataUrlToBytes = (dataUrl) => {
  const binary = atob(dataUrl.slice(dataUrl.indexOf(',') + 1));
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
  return bytes;
};

// Scroll a zoomable map container so the point (xPct, yPct) of the map sits in the middle of the view.
// Waits for the map picture to be laid out first: before that the container has nothing to scroll to.
const centerMapOn = (container, xPct, yPct) => {
  if (!container) return;
  const img = container.querySelector('img');
  const go = () => {
    container.scrollTo({
      left: (xPct / 100) * container.scrollWidth - container.clientWidth / 2,
      top: (yPct / 100) * container.scrollHeight - container.clientHeight / 2,
      behavior: 'smooth'
    });
  };
  if (img && !img.complete) img.addEventListener('load', go, { once: true });
  else go();
};

// "Tue, Oct 6, 5:49 PM" (the year too when it is not this year)
const formatWhen = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  const date = d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', ...(d.getFullYear() !== new Date().getFullYear() ? { year: 'numeric' } : {}) });
  return `${date}, ${d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
};

// A relative hint only while it is under a day old, so it can never disagree with the day heading
const recentAgo = (iso) => {
  const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
  if (isNaN(mins) || mins < 0 || mins >= 24 * 60) return '';
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins} min ago`;
  return `${Math.floor(mins / 60)} h ago`;
};

// Calendar-day buckets so the rail reads "Today / Yesterday / ..." as it rolls
const dayBucket = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return 'Older';
  const today = new Date(); today.setHours(0, 0, 0, 0);
  d.setHours(0, 0, 0, 0);
  const days = Math.round((today - d) / 86400000);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days <= 7) return '2-7 days ago';
  if (days <= 30) return '8-30 days ago';
  return 'Older';
};

export default function App() {
  const [activeTab, setActiveTab] = useState('overview');
  const [submissions, setSubmissions] = useState([]);
  const [mainMapImage, setMainMapImage] = useState(null);
  
  // UI & View States
  const [globalZoom, setGlobalZoom] = useState(100);
  const [editingItem, setEditingItem] = useState(null);
  const [focusItem, setFocusItem] = useState(null);
  const [timeFilter, setTimeFilter] = useState('all');
  const [categoryFilter, setCategoryFilter] = useState([]); // [] = every category
  const [statusFilter, setStatusFilter] = useState('all');  // 'open' | 'closed' | 'all'
  const [searchQuery, setSearchQuery] = useState('');       // shared by the map, gallery and action rail
  // Where the attached equipment's ids are kept (null = names only)
  const [equipmentColumns, setEquipmentColumns] = useState({ idColumn: null, equipmentMax: null, idMax: null, reason: 'the app is still checking the observations table.' });

  const [adminOpen, setAdminOpen] = useState(false);
  const [logs, setLogs] = useState([]);
  const [loadTime, setLoadTime] = useState(0);
  // Where observation pictures live. Until the table has been checked, saving a picture is held back.
  const [pictureColumn, setPictureColumn] = useState({ ready: false, name: null, type: null, reason: 'the app is still checking the observations table.' });

  // --- ADMIN LOGGER & HELPERS ---
  // Stable identity: effects that list logEvent as a dependency (like the edit-form setup in SubmitTab)
  // would otherwise re-run on every render, and each run logs, which renders again, and so on.
  // `request` ({ method, path, contentType }) is only for 'data' entries that are not the usual JSON call to the table
  const logEvent = useCallback((message, type = 'info', payload = null, request = null) => {
    setLogs(prev => [...prev, { time: new Date().toLocaleTimeString(), message, type, payload, request }]);
  }, []);

  const handleCopyPayload = (payload) => {
    const text = JSON.stringify(payload, null, 2);
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
    } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
    }
  };

  useEffect(() => {
    // UI FAILSAFE: Inject Tailwind CSS dynamically
    if (!document.getElementById('tailwind-cdn')) {
      const script = document.createElement('script');
      script.id = 'tailwind-cdn';
      script.src = 'https://cdn.tailwindcss.com';
      document.head.appendChild(script);
    }

    const initializeData = async () => {
      const startTime = performance.now();
      logEvent('App initialized. Building component tree...', 'debug');

      try {
        let baseUrl = '';
        if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) {
            baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
            logEvent(`Detected Xrm Context. Base URL: ${baseUrl}`, 'debug');
        } else {
            logEvent(`Xrm Context not found. Will attempt relative fetch (Dev Mode).`, 'warn');
        }

        // 1. Fetch Live Map Data
        try {
            logEvent('Attempting live HTTP connection to Dataverse Map API...', 'debug');
            const mapResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5___mapses?$select=craa5___mapsid,craa5_facility`, {
                headers: { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' }
            });

            if (mapResponse.ok) {
                const data = await mapResponse.json();
                const mapRecord = data.value.find(r => (r.craa5_facility || r.craa5_Facility)?.toUpperCase() === 'MAIN') || data.value[0];
                
                if (mapRecord) {
                    const recordId = mapRecord.craa5___mapsid || mapRecord.craa5___mapsId;
                    const imageUrl = `${baseUrl}/api/data/v9.2/craa5___mapses(${recordId})/craa5_mapimage/$value?size=full`;
                    logEvent(`Found live map record. Fetching full-res blob: ${imageUrl}`, 'info');
                    
                    const imgResponse = await fetch(imageUrl);
                    if (imgResponse.ok) {
                        const blob = await imgResponse.blob();
                        setMainMapImage(URL.createObjectURL(blob));
                        logEvent(`Success: Map Blob loaded (${(blob.size/1024).toFixed(2)} KB).`, 'success');
                    } else {
                        logEvent(`Failed to download map blob. Status: ${imgResponse.status}`, 'error');
                    }
                } else {
                    logEvent('No maps found in live table.', 'warn');
                }
            } else {
                logEvent(`Map API returned status: ${mapResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Map Live Fetch Failed: ${error.message}`, 'error');
        }

        // 2. Find the picture column, then fetch Live Observations Data
        try {
            let picColumn = { ready: false, name: null, type: null, reason: 'the picture column could not be checked.' };
            try {
                picColumn = await detectPictureColumn(logEvent);
            } catch (error) {
                picColumn.reason = `the picture column check failed (${error.message}).`;
                logEvent(`Picture column check failed: ${error.message}`, 'error');
            }
            setPictureColumn(picColumn);
            if (picColumn.ready) logEvent(`Pictures are stored in column "${picColumn.name}" (${picColumn.type || 'type unknown'}).`, 'info');
            else logEvent(`Pictures cannot be saved: ${picColumn.reason}`, 'warn');

            let eqColumns = { idColumn: null, equipmentMax: null, idMax: null, reason: 'the equipment columns could not be checked.' };
            try {
                eqColumns = await detectEquipmentColumns(logEvent);
            } catch (error) {
                eqColumns.reason = `the equipment column check failed (${error.message}).`;
                logEvent(`Equipment column check failed: ${error.message}`, 'error');
            }
            if (eqColumns.idColumn) logEvent(`Equipment ids are stored in column "${eqColumns.idColumn}".`, 'info');
            else logEvent(`Equipment is saved by name only: ${eqColumns.reason}`, 'warn');

            logEvent('Querying live observations from facilityobservations API...', 'debug');
            // statecode / statuscode / modifiedon are system columns every table has: they carry Open / Closed
            const baseSelect = 'craa5__facilityobservationid,craa5_mapx,craa5_mapy,craa5__boxwidth,craa5__boxheight,craa5__room,craa5__area,craa5__equipment,craa5__description,craa5__whotonotify,craa5__customnote,createdon,modifiedon,statecode,statuscode';
            // Ask for the picture marker (and the equipment ids) too; if Dataverse rejects a column (HTTP 400) step down to a plainer
            // query so a wrong guess can never blank the whole map.
            const pictureOptions = picColumn.ready ? pictureSelectOptions(picColumn.name, picColumn.type) : [[]];
            const selectOptions = eqColumns.idColumn
                ? pictureOptions.map(extra => extra.concat([eqColumns.idColumn])).concat([[]])
                : pictureOptions;
            let obsResponse = null;
            let pictureFields = [];
            let idsSelected = false;
            for (const extra of selectOptions) {
                const select = extra.length ? `${baseSelect},${extra.join(',')}` : baseSelect;
                obsResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5__facilityobservations?$select=${select}&$expand=createdby($select=fullname),modifiedby($select=fullname)&$orderby=createdon desc`, {
                    headers: { 
                      'Accept': 'application/json', 
                      'OData-MaxVersion': '4.0', 
                      'OData-Version': '4.0',
                      'Prefer': 'odata.include-annotations="*"'
                    }
                });
                if (obsResponse.status !== 400) {
                    idsSelected = !!eqColumns.idColumn && extra.indexOf(eqColumns.idColumn) !== -1;
                    pictureFields = extra.filter(f => f !== eqColumns.idColumn);
                    break;
                }
                logEvent(`Observation query with extra fields [${extra.join(', ') || 'none'}] was rejected (HTTP 400).`, 'warn');
            }
            // The ids are only written back when they could be read: saving without them would wipe the stored ones
            if (eqColumns.idColumn && !idsSelected) {
                logEvent(`The equipment id column "${eqColumns.idColumn}" could not be read, so equipment is saved by name only this session.`, 'warn');
                eqColumns = { ...eqColumns, idColumn: null, reason: `the column ${eqColumns.idColumn} could not be read.` };
            }
            setEquipmentColumns(eqColumns);

            if (obsResponse.ok) {
               const obsData = await obsResponse.json();
               if (picColumn.ready && pictureFields.length === 0) logEvent('Could not tell which observations have pictures; trying to show a picture for every one.', 'warn');
               const mappedObs = obsData.value.map(item => {
                  const id = item.craa5__facilityobservationid;
                  const hasPicture = picColumn.ready ? rowHasPicture(item, pictureFields) : false;
                  const equipmentList = parseEquipment(item.craa5__equipment, eqColumns.idColumn ? item[eqColumns.idColumn] : '');
                  return {
                  id,
                  mapX: item.craa5_mapx || 0,
                  mapY: item.craa5_mapy || 0,
                  boxW: item.craa5__boxwidth || 10,
                  boxH: item.craa5__boxheight || 10,
                  room: item.craa5__room || '',
                  area: item.craa5__area || 'Unknown Area',
                  equipmentList,
                  equipment: equipmentText({ equipmentList }),
                  description: item.craa5__description || '',
                  whoToNotify: item.craa5__whotonotify || '',
                  ...parseCategory(item.craa5__customnote),
                  closed: item.statecode === 1,
                  statusReason: item['statuscode@OData.Community.Display.V1.FormattedValue'] || '',
                  modifiedOn: item.modifiedon || item.createdon,
                  modifiedBy: item.modifiedby ? item.modifiedby.fullname : (item['_modifiedby_value@OData.Community.Display.V1.FormattedValue'] || ''),
                  image: null,
                  picture: hasPicture === false ? null : storedPictureUrls(picColumn.name, id),
                  submittedOn: item.createdon,
                  submittedBy: item.createdby ? item.createdby.fullname : (item['_createdby_value@OData.Community.Display.V1.FormattedValue'] || 'Unknown')
                  };
               });
               setSubmissions(mappedObs);
               logEvent(`Successfully loaded ${mappedObs.length} live observations.`, 'success');
            } else {
               logEvent(`Observation API returned status: ${obsResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Observation Live Fetch Failed: ${error.message}`, 'error');
        }

      } catch (fatalError) {
        logEvent(`Fatal initialization error: ${fatalError.message}`, 'error');
      }

      const endTime = performance.now();
      setLoadTime((endTime - startTime).toFixed(2));
    };

    initializeData();
  }, []);

  // --- TIMEFRAME FILTERING LOGIC ---
  const timeFilteredSubmissions = useMemo(() => {
    const now = new Date();
    return submissions.filter(sub => {
      if (timeFilter === 'all') return true;
      const subDate = new Date(sub.submittedOn);
      const diffHours = (now - subDate) / (1000 * 60 * 60);
      if (timeFilter === '24h') return diffHours <= 24;
      if (timeFilter === '7d') return diffHours <= 24 * 7;
      if (timeFilter === '30d') return diffHours <= 24 * 30;
      return true;
    });
  }, [submissions, timeFilter]);

  // --- STATUS, SEARCH AND CATEGORY FILTERING (shared by the map, sidebar, gallery and action rail) ---
  const statusCounts = useMemo(() => {
    const closed = timeFilteredSubmissions.filter(sub => sub.closed).length;
    return { open: timeFilteredSubmissions.length - closed, closed, all: timeFilteredSubmissions.length };
  }, [timeFilteredSubmissions]);

  const searchedSubmissions = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return timeFilteredSubmissions.filter(sub => {
      if (statusFilter === 'open' && sub.closed) return false;
      if (statusFilter === 'closed' && !sub.closed) return false;
      return !q || searchText(sub).includes(q);
    });
  }, [timeFilteredSubmissions, statusFilter, searchQuery]);

  const categoryCounts = useMemo(() => {
    const counts = {};
    searchedSubmissions.forEach(sub => { counts[sub.category] = (counts[sub.category] || 0) + 1; });
    return counts;
  }, [searchedSubmissions]);

  const filteredSubmissions = useMemo(() => (
    categoryFilter.length === 0
      ? searchedSubmissions
      : searchedSubmissions.filter(sub => categoryFilter.includes(sub.category))
  ), [searchedSubmissions, categoryFilter]);

  const categoryBar = {
    counts: categoryCounts,
    selected: categoryFilter,
    onToggle: (key) => setCategoryFilter(prev => prev.includes(key) ? prev.filter(k => k !== key) : prev.concat([key])),
    onOnly: (key) => setCategoryFilter([key]),
    onClear: () => setCategoryFilter([]),
    status: statusFilter,
    statusCounts,
    onStatus: setStatusFilter,
    query: searchQuery,
    onQuery: setSearchQuery,
    // true while anything besides the timeframe hides items
    narrowed: categoryFilter.length > 0 || statusFilter !== 'all' || searchQuery.trim() !== '',
    onClearAll: () => { setCategoryFilter([]); setStatusFilter('all'); setSearchQuery(''); }
  };

  // Close or reopen one observation. Resolves to '' when saved, else the reason it was not.
  const setItemClosed = useCallback(async (item, closed) => {
    try {
      await saveStatus(item.id, closed, logEvent);
      const when = new Date().toISOString();
      const who = currentUserName();
      setSubmissions(prev => prev.map(s => (s.id === item.id ? { ...s, closed, statusReason: '', modifiedOn: when, modifiedBy: who } : s)));
      logEvent(`Observation ${item.id} ${closed ? 'closed' : 'reopened'}.`, 'success');
      return '';
    } catch (error) {
      logEvent(`Could not ${closed ? 'close' : 'reopen'} ${item.id}: ${error.message}`, 'error', { id: item.id, closed });
      return error.message;
    }
  }, [logEvent]);

  // Latest copy of every observation by id, so an open details window shows a change (closed, reopened) straight away
