  useEffect(() => { if (assetView) setAssetsOpened(true); }, [assetView]);
  const [submissions, setSubmissions] = useState([]);
  const submissionsRef = useRef(submissions);
  submissionsRef.current = submissions;
  const [mainMapImage, setMainMapImage] = useState(null);
  // The maps (craa5___maps rows), the one on screen, and why its picture is missing ('' = none missing)
  const [maps, setMaps] = useState([]);
  const [mapId, setMapId] = useState(null);
  const [mapPicture, setMapPicture] = useState({ status: 'loading', note: '', bytes: 0, type: '' });
  const currentMap = useMemo(() => maps.filter(m => m.id === mapId)[0] || null, [maps, mapId]);
  const [signedIn, setSignedIn] = useState({ name: '', id: '', how: '', checking: true });
  // Which problems are loaded: all open ones, the closed ones page by page (see PROBLEMS)
  const [problemWindow, setProblemWindow] = useState({ status: 'loading', error: '', openTotal: null, openCapped: false, closedTotal: null, closedCapped: false, closedNext: null, closedCursor: '', olderBusy: false, olderError: '', splitNote: '' });
  const problemWindowRef = useRef(problemWindow);
  problemWindowRef.current = problemWindow;
  const [olderSearch, setOlderSearch] = useState({ text: '', busy: false, found: null, added: 0, error: '' });
  // Overview layers: problems, equipment and labels (remembered on this device)
  const [layers, setLayers] = useState(() => {
    const saved = readPref(LAYERS_PREF, null);
    return { ...DEFAULT_LAYERS, ...(saved && typeof saved === 'object' ? saved : {}) };
  });
  useEffect(() => { writePref(LAYERS_PREF, layers); }, [layers]);
  const changeLayers = useCallback((change) => setLayers(prev => ({ ...prev, ...change })), []);
  const [assetFocusRequest, setAssetFocusRequest] = useState(null); // { id, n }: open this asset on the Asset Map

  // UI & View States
  const [globalZoom, setGlobalZoom] = useState(100);
  const [editingItem, setEditingItem] = useState(null);
  const [focusItem, setFocusItem] = useState(null);
  const [timeFilter, setTimeFilter] = useState('all');
  const [categoryFilter, setCategoryFilter] = useState([]); // [] = every category
  const [statusFilter, setStatusFilter] = useState('all');  // 'open' | 'closed' | 'all'
  const [searchQuery, setSearchQuery] = useState('');       // shared by the map, gallery and action rail
  // The Overview map has its own "Hide closed" switch instead of Open / Closed / Both. On at first; remembered on this device.
  const [hideClosedOnMap, setHideClosedOnMap] = useState(() => readPref(HIDE_CLOSED_PREF, true) !== false);
  useEffect(() => { writePref(HIDE_CLOSED_PREF, hideClosedOnMap); }, [hideClosedOnMap]);
  // Where the attached equipment's ids are kept (null = names only)
  const [equipmentColumns, setEquipmentColumns] = useState({ idColumn: null, equipmentMax: null, idMax: null, reason: 'the app is still checking the observations table.', idsUnknown: true });

  // Assets tab: the table's columns and the placed assets, read once and kept while switching tabs
  const [mainMapKey, setMainMapKey] = useState('MAIN');
  const [assetMeta, setAssetMeta] = useState({ status: 'idle', ready: false, error: '', entitySet: ASSET_SET, fields: [], mapColumn: null, mapReason: '', warnings: [] });
  const [assetPins, setAssetPins] = useState({ status: 'idle', rows: [], capped: false, error: '' });

  const [adminOpen, setAdminOpen] = useState(false);
  const [drawerView, setDrawerView] = useState('logs'); // 'logs' | 'host' (the Host check card)
  const [logs, setLogs] = useState([]);
  const [loadTime, setLoadTime] = useState(0);
  // Where observation pictures live. Until the table has been checked, saving a picture is held back.
  const [pictureColumn, setPictureColumn] = useState({ ready: false, name: null, type: null, reason: 'the app is still checking the observations table.' });
  const marksColumn = useRef(null); // the column the loaded issues' picture marks were read with

  // --- ADMIN LOGGER & HELPERS ---
  // Stable identity: effects that list logEvent as a dependency (like the edit-form setup in SubmitTab)
  // would otherwise re-run on every render, and each run logs, which renders again, and so on.
  // `request` ({ method, path, contentType }) is only for 'data' entries that are not the usual JSON call to the table
  const logEvent = useCallback((message, type = 'info', payload = null, request = null) => {
    setLogs(prev => [...prev, { time: new Date().toLocaleTimeString(), message, type, payload, request }]);
  }, []);

  const handleCopyPayload = (payload) => {
    const text = JSON.stringify(payload, null, 2);
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
    } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
    }
  };

  // --- PROBLEMS: read a page at a time, for the map on screen (see PROBLEMS above App) ---
  // problemCtx: how problems are read (the columns that worked, the picture and equipment-id columns, whether maps can be told apart)
  const problemCtx = useRef(null);
  const openSeq = useRef(0);
  const closedSeq = useRef(0);
  const fullRead = useRef(false); // a read of the open and the closed problems is under way
  const lastRead = useRef(null);  // { mapId, time } the problems on screen were read for
  const openFor = useRef(undefined); // the map id the open problems on screen were read for (undefined: none read, or that read failed)
  const touchedRef = useRef(null);   // ids saved here while a read is under way: the copy saved here wins over what the read brings
  const searchSeq = useRef(0);       // a newer search of the older closed problems makes an older one drop its answer
  const mapKeyRef = useRef(mainMapKey);
  mapKeyRef.current = mainMapKey;
  // A save made here. The copy saved here wins over a read still under way. A new problem saved for another map (the map was
  // changed while it was being saved) is not put on this one, unless every problem shows on every map.
  const savedHere = useCallback((item, update) => {
    const ctx = problemCtx.current;
    if (item.mapKey && item.mapKey !== mapKeyRef.current && !(ctx && ctx.splitOff)) return;
    if (touchedRef.current && item.id) touchedRef.current[item.id] = true;
    setSubmissions(update);
  }, []);
  const [problemsReady, setProblemsReady] = useState(false);
  // 'all' = open and closed (the first load, another map); 'closed' = only the closed ones again (another timeframe).
  // A newer read makes an older one drop its answer.
  const readProblems = useCallback(async (requested, mapsNow, map, time) => {
    const ctx = problemCtx.current;
    if (!ctx) return;
    const readFor = map ? map.id : null;
    // Only the closed ones again when the open ones on screen are this map's (a failed read leaves none that can be trusted)
    const full = requested === 'all' || fullRead.current || !ctx.select || openFor.current !== readFor;
    if (full) {
      openSeq.current += 1;
      fullRead.current = true;
      openFor.current = undefined;
    }
    closedSeq.current += 1;
    searchSeq.current += 1;
    const touched = {};
    touchedRef.current = touched;
    const oSeq = openSeq.current;
    const cSeq = closedSeq.current;
    const stale = () => oSeq !== openSeq.current || cSeq !== closedSeq.current;
    lastRead.current = { mapId: map ? map.id : null, time };
    setProblemWindow(w => ({ ...w, status: 'loading', error: '', closedNext: null, olderBusy: false, olderError: '' }));
    setOlderSearch({ text: '', busy: false, found: null, added: 0, error: '' });
    const since = timeframeStart(time);
    try {
      let mapFilter = ctx.splitOff ? '' : problemMapFilter(mapsNow, map);
      let openItems = [];
      let openTotal = null;
      let openCapped = false;
      if (full) {
        logEvent(`Reading the open problems${map ? ` of the map ${map.label}` : ''}...`, 'debug');
        const first = await firstOpenProblems(ctx.selectOptions, mapFilter, logEvent);
        if (stale()) return;
        if (first.splitError) {
          ctx.splitOff = first.splitError;
          mapFilter = '';
          logEvent(`Dataverse refused to sort the problems by map (${first.splitError}). Every problem shows on every map until the craa5__facility column can be read.`, 'warn');
        }
        if (!ctx.select) {
          // The first read found the columns that can be read: later reads ask for the same
          ctx.select = first.select;
          ctx.selectOptions = [first.extra];
          const idColumn = ctx.eqColumns.idColumn;
          ctx.pictureFields = first.extra.filter(f => f !== idColumn);
          let eq = ctx.eqColumns;
          // The ids are only written back when they could be read: saving without them would wipe the stored ones
          if (idColumn && first.extra.indexOf(idColumn) === -1) {
            logEvent(`The equipment id column "${idColumn}" could not be read, so equipment is saved by name only this session.`, 'warn');
            eq = { ...eq, idColumn: null, idsUnknown: true, reason: `the column ${idColumn} could not be read.` };
          }
          ctx.idColumn = eq.idColumn;
          setEquipmentColumns(eq);
          if (ctx.picReady && ctx.pictureFields.length === 0) logEvent('Could not tell which observations have pictures; trying to show a picture for every one.', 'warn');
          marksColumn.current = ctx.picReady ? ctx.picName : null;
        }
        let page = first.page;
        let rows = page.rows;
        openTotal = page.count;
        while (page.next && rows.length < OPEN_MAX) {
          page = await fetchProblemPage(page.next, OPEN_PAGE);
          if (stale()) return;
          rows = rows.concat(page.rows);
        }
        openCapped = !!page.next;
        if (openCapped) logEvent(`Only the first ${rows.length} open problems are loaded; Dataverse has more.`, 'warn');
        openItems = rows.map(r => problemFromRow(r, ctx));
      }
      const closed = await fetchProblemPage(problemQueryUrl(ctx.select, true, mapFilter, since), CLOSED_PAGE);
      if (stale()) return;
      const closedItems = closed.rows.map(r => problemFromRow(r, ctx));
      // Saved here while this read was under way (a new problem, a close or reopen, an edit): the copy saved here wins
      const savedMeanwhile = (prev) => prev.filter(s => touched[s.id]);
      if (full) {
        fullRead.current = false;
        openFor.current = readFor;
        setSubmissions(prev => mergeProblems(mergeProblems(openItems, closedItems), savedMeanwhile(prev)));
      } else {
        // The open ones stay as they are; the closed ones are the new timeframe's
        setSubmissions(prev => mergeProblems(mergeProblems(prev.filter(s => !s.closed), closedItems), savedMeanwhile(prev)));
      }
      if (touchedRef.current === touched) touchedRef.current = null;
      const lastClosed = closed.rows[closed.rows.length - 1];
      setProblemWindow(w => ({
        ...w,
        status: 'ready',
        error: '',
        openTotal: full ? openTotal : w.openTotal,
        openCapped: full ? openCapped : w.openCapped,
        closedTotal: closed.count,
        closedCapped: closed.countCapped,
        closedNext: closed.next,
        closedCursor: lastClosed ? lastClosed.modifiedon || '' : '',
        splitNote: ctx.splitOff || ''
      }));
      logEvent(`Successfully loaded ${full ? `${openItems.length} open and ` : ''}${closedItems.length} closed live observations${map ? ` for the map ${map.label}` : ''}${closed.next ? '; older closed ones load on request' : ''}.`, 'success');
    } catch (error) {
      if (stale()) return;
      if (full) fullRead.current = false;
      if (touchedRef.current === touched) touchedRef.current = null;
      if (!ctx.select) setEquipmentColumns(ctx.eqColumns);
      logEvent(`Observation Live Fetch Failed: ${error.message}`, 'error');
      setProblemWindow(w => ({ ...w, status: 'error', error: error.message }));
    }
  }, [logEvent]);

  // Another map or another timeframe: read again (the first read is started by the start-up below)
  useEffect(() => {
    if (!problemsReady || !lastRead.current) return;
    const last = lastRead.current;
    if (last.mapId === mapId && last.time === timeFilter) return;
    readProblems(last.mapId === mapId ? 'closed' : 'all', maps, currentMap, timeFilter);
  }, [problemsReady, mapId, timeFilter]); // eslint-disable-line react-hooks/exhaustive-deps
  const retryProblems = useCallback(() => readProblems('all', maps, currentMap, timeFilter), [readProblems, maps, currentMap, timeFilter]);

  // The next page of closed problems (older closings)
  const olderBusyRef = useRef(false);
  const loadOlderClosed = useCallback(async () => {
    const w = problemWindowRef.current;
    const ctx = problemCtx.current;
    if (!w.closedNext || olderBusyRef.current || !ctx) return;
    olderBusyRef.current = true;
    const cSeq = closedSeq.current;
    setProblemWindow(x => ({ ...x, olderBusy: true, olderError: '' }));
    try {
      const page = await fetchProblemPage(w.closedNext, CLOSED_PAGE);
      if (cSeq !== closedSeq.current) return;
      const items = page.rows.map(r => problemFromRow(r, ctx));
      // A problem already in the lists (changed here meanwhile) keeps the copy the lists have
      setSubmissions(prev => {
        const have = {};
        prev.forEach(s => { have[s.id] = true; });
        return prev.concat(items.filter(s => !have[s.id]));
      });
      const lastOlder = page.rows[page.rows.length - 1];
      setProblemWindow(x => ({ ...x, olderBusy: false, closedNext: page.next, closedCursor: lastOlder ? lastOlder.modifiedon || x.closedCursor : x.closedCursor }));
      logEvent(`Loaded ${items.length} older closed problems.`, 'info');
    } catch (error) {
      if (cSeq !== closedSeq.current) return;
      logEvent(`Older closed problems could not be loaded: ${error.message}`, 'error');
      setProblemWindow(x => ({ ...x, olderBusy: false, olderError: error.message }));
    } finally {
      olderBusyRef.current = false;
    }
  }, [logEvent]);

  // A search in Dataverse among the closed problems not loaded yet (closed before the oldest one loaded, inside the
  // timeframe; with anyTime also those submitted before the timeframe); what it finds joins the lists
  const searchOlderClosed = useCallback(async (text, opts) => {
    const ctx = problemCtx.current;
    const words = String(text || '').trim().split(/\s+/).filter(Boolean).slice(0, 6);
    if (!ctx || !ctx.select || words.length === 0 || problemWindowRef.current.status === 'loading') return;
    const anyTime = !!(opts && opts.anyTime);
    searchSeq.current += 1;
    const sSeq = searchSeq.current;
    const cSeq = closedSeq.current;
    const stale = () => sSeq !== searchSeq.current || cSeq !== closedSeq.current;
    const asked = words.join(' ');
    const w = problemWindowRef.current;
    const since = timeframeStart(timeFilter);
    const notLoaded = [];
    if (w.closedNext && w.closedCursor) notLoaded.push(since ? `(createdon ge ${since} and modifiedon le ${w.closedCursor})` : `modifiedon le ${w.closedCursor}`);
    if (anyTime && since) notLoaded.push(`createdon lt ${since}`);
    if (notLoaded.length === 0) {
      setOlderSearch({ text: asked, anyTime, busy: false, found: 0, added: 0, more: false, error: '' });
      return;
    }
    setOlderSearch({ text: asked, anyTime, busy: true, found: null, added: 0, error: '' });
    try {
      const mapFilter = ctx.splitOff ? '' : problemMapFilter(maps, currentMap);
      const extra = `${problemWordFilter(words)} and ${notLoaded.length > 1 ? `(${notLoaded.join(' or ')})` : notLoaded[0]}`;
      const url = `${problemQueryUrl(ctx.select, true, mapFilter, '', extra)}&$top=${OLDER_SEARCH_TOP}`;
      const page = await fetchProblemPage(url, OLDER_SEARCH_TOP);
      if (stale()) return;
      const items = page.rows.map(r => problemFromRow(r, ctx));
      const have = {};
      submissionsRef.current.forEach(s => { have[s.id] = true; });
      const fresh = items.filter(s => !have[s.id]);
      setSubmissions(prev => {
        const now = {};
        prev.forEach(s => { now[s.id] = true; });
        return prev.concat(fresh.filter(s => !now[s.id]));
      });
      setOlderSearch({ text: asked, anyTime, busy: false, found: items.length, added: fresh.length, more: items.length >= OLDER_SEARCH_TOP, error: '' });
      logEvent(`Searched the older closed problems for "${asked}": ${items.length} found, ${fresh.length} added to the lists.`, 'info');
    } catch (error) {
      if (stale()) return;
      logEvent(`Older closed problems could not be searched: ${error.message}`, 'error');
      setOlderSearch({ text: asked, anyTime, busy: false, found: null, added: 0, error: error.message });
    }
  }, [maps, currentMap, timeFilter, logEvent]);

  // The picture of the map on screen: one download per map; the last one is let go
  useEffect(() => {
    if (!currentMap) return undefined;
    let alive = true;
    let url = null;
    setMainMapImage(null);
    setMapPicture({ status: 'loading', note: '', bytes: 0, type: '' });
    logEvent(`Downloading the picture of the map ${currentMap.label}...`, 'debug');
    loadMapPicture(currentMap).then(r => {
      if (!alive) {
        if (r.url) URL.revokeObjectURL(r.url);
        return;
      }
      if (r.url) {
        url = r.url;
        setMainMapImage(r.url);
        setMapPicture({ status: 'ready', note: '', bytes: r.bytes, type: r.type });
        logEvent(`Success: Map Blob loaded (${(r.bytes / 1024).toFixed(2)} KB).`, 'success');
      } else {
        setMapPicture({ status: 'none', note: r.note, bytes: 0, type: '' });
        logEvent(r.note, 'warn');
      }
    }).catch(error => {
      if (!alive) return;
      setMapPicture({ status: 'none', note: `The map picture could not be downloaded (${error.message}).`, bytes: 0, type: '' });
      logEvent(`Map picture download failed: ${error.message}`, 'error');
    });
    return () => {
      alive = false;
      if (url) URL.revokeObjectURL(url);
    };
  }, [currentMap && currentMap.id]); // eslint-disable-line react-hooks/exhaustive-deps
  // A picture the browser cannot show: say so instead of an empty map
  const dropMapImage = useCallback(() => {
    setMainMapImage(null);
    setMapPicture(p => ({ ...p, status: 'none', note: 'The map picture was downloaded, but this browser cannot show it (it may not be a picture file). Put a PNG or JPG in the map row\'s Map Image column.' }));
    logEvent('Browser failed to render the map picture.', 'error');
  }, [logEvent]);

  // Another map from the header's picker: its picture and its problems are read; anything placed on the old map is let go
  const chooseMap = useCallback((id) => {
    const m = maps.filter(x => x.id === id)[0];
    if (!m || m.id === mapId) return;
    writePref(MAP_PREF, m.id);
    setEditingItem(null);
    setFocusItem(null);
    // The old map's problems go at once: while the new map's are read (or if that fails) none of them shows on it. Whatever is
    // still being read for the old map (the start-up read too, a Load older, a search) drops its answer.
    closedSeq.current += 1;
    searchSeq.current += 1;
    setSubmissions([]);
    setProblemWindow(w => ({ ...w, status: 'loading', error: '', openTotal: null, openCapped: false, closedTotal: null, closedCapped: false, closedNext: null, closedCursor: '', olderBusy: false, olderError: '' }));
    setOlderSearch({ text: '', busy: false, found: null, added: 0, error: '' });
    setMainMapKey(m.key);
    setMapId(m.id);
    logEvent(`Map changed to ${m.label} (code ${m.key}).`, 'info');
  }, [maps, mapId, logEvent]);

  // Who is signed in (the header and the Host check)
  useEffect(() => {
    let alive = true;
    readSignedIn().then(s => {
      if (!alive) return;
      if (s.name) SIGNED_IN.name = s.name;
      setSignedIn({ ...s, checking: false });
      if (s.name) logEvent(`Signed in as ${s.name} (read from ${s.how}).`, 'info');
      else logEvent(`Who is signed in could not be read${s.error ? `: ${s.error}` : '.'}`, 'warn');
    });
    return () => { alive = false; };
  }, [logEvent]);

  useEffect(() => {
    // UI FAILSAFE: Inject Tailwind CSS dynamically
    if (!document.getElementById('tailwind-cdn')) {
      const script = document.createElement('script');
      script.id = 'tailwind-cdn';
      script.src = 'https://cdn.tailwindcss.com';
      document.head.appendChild(script);
    }

    const initializeData = async () => {
      const startTime = performance.now();
      logEvent('App initialized. Building component tree...', 'debug');
      const host = hostContext();
      if (host) {
        try { logEvent(`Detected Xrm Context. Base URL: ${host.getClientUrl()}`, 'debug'); } catch (e) { /* no address */ }
      } else {
        logEvent('Xrm Context not found. Will attempt relative fetch (Dev Mode).', 'warn');
      }

      try {
        // 1. The maps: ids and codes only. The picture of the one on screen follows (its own effect).
        let mapsFound = [];
        let mapsError = '';
        try {
          mapsFound = await loadMapRows();
          logEvent(`Maps found: ${mapsFound.map(m => `${m.label} (code ${m.key})`).join(', ') || 'none'}.`, mapsFound.length ? 'info' : 'warn');
        } catch (error) {
          mapsError = error.message;
          logEvent(`Map Live Fetch Failed: ${error.message}`, 'error');
        }
        MAP_STATE.mainKey = mapsFound.length ? mapsFound[0].key : 'MAIN';
        const savedMap = readPref(MAP_PREF, '');
        const firstMap = mapsFound.filter(m => m.id === savedMap)[0] || mapsFound[0] || null;
        setMaps(mapsFound);
        if (firstMap) {
          setMainMapKey(firstMap.key);
          setMapId(firstMap.id);
        } else {
          setMapPicture({ status: 'none', note: mapsError ? `The map list could not be read (${mapsError}).` : 'No map was found in the maps table (craa5___maps). Add a row with a Map Image to show the facility map.', bytes: 0, type: '' });
        }

        // 2. The picture column and the equipment-id column, then the problems of that map
        let picColumn = { ready: false, name: null, type: null, reason: 'the picture column could not be checked.' };
        try {
          picColumn = await detectPictureColumn(logEvent);
        } catch (error) {
          picColumn.reason = `the picture column check failed (${error.message}).`;
          logEvent(`Picture column check failed: ${error.message}`, 'error');
        }
        setPictureColumn(picColumn);
        if (picColumn.ready) logEvent(`Pictures are stored in column "${picColumn.name}" (${picColumn.type || 'type unknown'}).`, 'info');
        else logEvent(`Pictures cannot be saved: ${picColumn.reason}`, 'warn');

        let eqColumns = { idColumn: null, equipmentMax: null, idMax: null, reason: 'the equipment columns could not be checked.', idsUnknown: true };
        try {
          eqColumns = await detectEquipmentColumns(logEvent);
        } catch (error) {
          eqColumns.reason = `the equipment column check failed (${error.message}).`;
          logEvent(`Equipment column check failed: ${error.message}`, 'error');
        }
        if (eqColumns.idColumn) logEvent(`Equipment ids are stored in column "${eqColumns.idColumn}".`, 'info');
        else logEvent(`Equipment is saved by name only: ${eqColumns.reason}`, 'warn');

        // Ask for the picture marker (and the equipment ids) too; a rejected column steps down to a plainer query
        problemCtx.current = {
          selectOptions: problemSelectOptions(picColumn, eqColumns.idColumn),
          select: null,
          pictureFields: [],
          idColumn: eqColumns.idColumn,
          picReady: picColumn.ready,
          picName: picColumn.name,
          eqColumns,
          splitOff: ''
        };
        await readProblems('all', mapsFound, firstMap, 'all');
        setProblemsReady(true);
      } catch (fatalError) {
        logEvent(`Fatal initialization error: ${fatalError.message}`, 'error');
      }

      const endTime = performance.now();
      setLoadTime((endTime - startTime).toFixed(2));
    };

    initializeData();
  }, []);

  // --- TIMEFRAME FILTERING LOGIC ---
  const timeFilteredSubmissions = useMemo(() => {
    const now = new Date();
    return submissions.filter(sub => {
      if (timeFilter === 'all') return true;
      const subDate = new Date(sub.submittedOn);
      const diffHours = (now - subDate) / (1000 * 60 * 60);
      if (timeFilter === '24h') return diffHours <= 24;
      if (timeFilter === '7d') return diffHours <= 24 * 7;
      if (timeFilter === '30d') return diffHours <= 24 * 30;
      return true;
    });
  }, [submissions, timeFilter]);

  // --- STATUS, SEARCH AND CATEGORY FILTERING (shared by the map, sidebar, gallery and action rail) ---
  // Header line: everything in the timeframe
  const headerCounts = useMemo(() => {
    const closed = timeFilteredSubmissions.filter(sub => sub.closed).length;
    return { open: timeFilteredSubmissions.length - closed, closed };
  }, [timeFilteredSubmissions]);

  // Search: every typed word must appear somewhere in the item (any field, any order)
  const queryMatches = useMemo(() => {
    const words = searchQuery.trim().toLowerCase().split(/\s+/).filter(Boolean);
    if (words.length === 0) return timeFilteredSubmissions;
    return timeFilteredSubmissions.filter(sub => {
      const text = searchText(sub);
      return words.every(w => text.includes(w));
    });
  }, [timeFilteredSubmissions, searchQuery]);

  // Open / Closed / Both counts follow the search and categories (as the category chips follow the search and status)
  const statusCounts = useMemo(() => {
    const pool = categoryFilter.length === 0 ? queryMatches : queryMatches.filter(sub => categoryFilter.includes(sub.category));
    const closed = pool.filter(sub => sub.closed).length;
    return { open: pool.length - closed, closed, all: pool.length };
  }, [queryMatches, categoryFilter]);

  const searchedSubmissions = useMemo(() => queryMatches.filter(sub => {
    if (statusFilter === 'open' && sub.closed) return false;
    if (statusFilter === 'closed' && !sub.closed) return false;
    return true;
  }), [queryMatches, statusFilter]);

  const categoryCounts = useMemo(() => {
    const counts = {};
    searchedSubmissions.forEach(sub => { counts[sub.category] = (counts[sub.category] || 0) + 1; });
    return counts;
  }, [searchedSubmissions]);

  const filteredSubmissions = useMemo(() => (
    categoryFilter.length === 0
      ? searchedSubmissions
      : searchedSubmissions.filter(sub => categoryFilter.includes(sub.category))
  ), [searchedSubmissions, categoryFilter]);

  const closedLoaded = useMemo(() => timeFilteredSubmissions.filter(s => s.closed).length, [timeFilteredSubmissions]);
  const categoryBar = {
    counts: categoryCounts,
    selected: categoryFilter,
    onToggle: (key) => setCategoryFilter(prev => prev.includes(key) ? prev.filter(k => k !== key) : prev.concat([key])),
    onOnly: (key) => setCategoryFilter([key]),
    onClear: () => setCategoryFilter([]),
    status: statusFilter,
    statusCounts,
    onStatus: setStatusFilter,
    query: searchQuery,
    onQuery: setSearchQuery,
    // true while anything besides the timeframe hides items
    narrowed: categoryFilter.length > 0 || statusFilter !== 'all' || searchQuery.trim() !== '',
    onClearAll: () => { setCategoryFilter([]); setStatusFilter('all'); setSearchQuery(''); },
    // Which problems are loaded (all open ones, closed ones page by page): the lists say so and can load or search older ones
    loaded: { window: problemWindow, closedLoaded, onLoadOlder: loadOlderClosed, onRetry: retryProblems, search: olderSearch, onSearchOlder: searchOlderClosed, timeFilter }
  };

  // Overview: search and categories as everywhere, then the map's own "Hide closed" switch (not the shared status filter)
  const overviewPool = useMemo(() => (hideClosedOnMap ? queryMatches.filter(sub => !sub.closed) : queryMatches), [queryMatches, hideClosedOnMap]);
  const overviewCategoryCounts = useMemo(() => {
    const counts = {};
    overviewPool.forEach(sub => { counts[sub.category] = (counts[sub.category] || 0) + 1; });
    return counts;
  }, [overviewPool]);
  const overviewSubmissions = useMemo(() => (
    categoryFilter.length === 0 ? overviewPool : overviewPool.filter(sub => categoryFilter.includes(sub.category))
  ), [overviewPool, categoryFilter]);
  // How many closed items the switch is hiding right now (after the search and categories)
  const hiddenClosedCount = useMemo(() => (
    hideClosedOnMap ? queryMatches.filter(sub => sub.closed && (categoryFilter.length === 0 || categoryFilter.includes(sub.category))).length : 0
  ), [queryMatches, categoryFilter, hideClosedOnMap]);
  const overviewBar = {
    ...categoryBar,
    counts: overviewCategoryCounts,
    status: null,
    statusCounts: null,
    onStatus: null,
    hideClosed: hideClosedOnMap,
    hiddenClosed: hiddenClosedCount,
    onHideClosed: setHideClosedOnMap,
    narrowed: categoryFilter.length > 0 || searchQuery.trim() !== '',
    onClearAll: () => { setCategoryFilter([]); setSearchQuery(''); }
  };

  // Columns read once stay in use while "Check again" (or a column pick) reads them again, so the views (and anything being
  // typed in them) stay put; a failed re-read keeps them and only says so
  const assetMetaGood = useRef(false);
  const loadAssetMeta = useCallback(async () => {
    const recheck = assetMetaGood.current;
    setAssetMeta(prev => (recheck ? { ...prev, rechecking: true, recheckError: '' } : { ...prev, status: 'loading', error: '' }));
    try {
      const m = await loadAssetMetadata(logEvent);
      assetMetaGood.current = true;
      setAssetMeta({ ...m, status: 'ready', rechecking: false, recheckError: '' });
    } catch (error) {
      logEvent(`The Assets table's columns could not be read: ${error.message}`, 'error');
      if (recheck) {
        setAssetMeta(prev => ({ ...prev, rechecking: false, recheckError: error.message }));
        return;
      }
      // The list still works; spots only with a pinned ASSET_MAP_COLUMN. Uploads can still go to the picture and file
      // columns a one-row read shows (the bulk upload uses them).
      const probe = await probeAssetRowColumns(ASSET_SET);
      const uploadFields = inferUploadColumns(probe.keys, {}, null);
      if (uploadFields.length) logEvent(`Uploads can still use ${uploadFields.map(f => f.name).join(', ')} (found from a one-row read).`, 'info');
      setAssetMeta(prev => ({ ...prev, status: 'error', error: error.message, fields: uploadFields, mapColumn: ASSET_MAP_COLUMN ? { name: ASSET_MAP_COLUMN, maxLength: null } : null, mapReason: `the Assets table's columns could not be read (${error.message}).` }));
    }
  }, [logEvent]);

  // Observation pictures: check the table again (after a column was created), or use a column picked on this device
  const [pictureChecking, setPictureChecking] = useState(false);
  const pictureColumnRef = useRef(pictureColumn);
  pictureColumnRef.current = pictureColumn;
  // The loaded issues' picture marks (has a picture, where it is) belong to the column they were read with. After a switch
  // they are read again from the new column, so Remove, a replace warning and the map never act on the old one.
  const reloadPictureMarks = useCallback(async (col) => {
    marksColumn.current = col.name;
    // Until the new marks are read, any issue may have a picture there: replacing one asks first
    setSubmissions(prev => prev.map(sub => (sub.image ? sub : { ...sub, picture: storedPictureUrls(col.name, sub.id) })));
    // Problems read from now on (another map, older closed ones) carry the new column's marks too
    const ctx = problemCtx.current;
    const idColumn = ctx ? ctx.idColumn : null;
    const adopt = (fields) => {
      if (!ctx || marksColumn.current !== col.name) return;
      ctx.picReady = true;
      ctx.picName = col.name;
      if (!ctx.select) {
        ctx.selectOptions = problemSelectOptions(col, ctx.eqColumns.idColumn);
        return;
      }
      ctx.pictureFields = fields;
      const extra = fields.concat(idColumn ? [idColumn] : []);
      ctx.select = extra.length ? `${PROBLEM_SELECT},${extra.join(',')}` : PROBLEM_SELECT;
      ctx.selectOptions = [extra];
    };
    // Only the loaded issues are asked about, 50 ids a request (never the whole table)
    const ids = submissionsRef.current.map(s => s.id).filter(id => GUID_PATTERN.test(id));
    const options = pictureSelectOptions(col.name, col.type).filter(extra => extra.length > 0);
    for (let k = 0; k < options.length; k += 1) {
      const extra = options[k];
      const has = {};
      let refused = false;
      try {
        for (let start = 0; start < Math.max(ids.length, 1); start += 50) {
          const chunk = ids.slice(start, start + 50);
          const which = chunk.length ? `&$filter=${encodeURIComponent(chunk.map(id => `craa5__facilityobservationid eq ${id}`).join(' or '))}` : '&$top=1';
          const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}?$select=craa5__facilityobservationid,${extra.join(',')}${which}`), { headers: ODATA_HEADERS });
          if (res.status === 400) {
            refused = true;
            break;
          }
          if (!res.ok) {
            logEvent(`The issues' pictures in ${col.name} could not be read: ${await readApiError(res)}`, 'warn');
            adopt([]);
            return;
          }
          ((await res.json()).value || []).forEach(row => { has[row.craa5__facilityobservationid] = rowHasPicture(row, extra); });
        }
      } catch (error) {
        logEvent(`The issues' pictures in ${col.name} could not be read: ${error.message}`, 'warn');
        adopt([]);
        return;
      }
      if (refused) continue;
      if (marksColumn.current !== col.name) return; // switched again meanwhile
      adopt(extra);
      setSubmissions(prev => prev.map(sub => (sub.image || !(sub.id in has) || has[sub.id] !== false ? sub : { ...sub, picture: null })));
      logEvent(`Issue pictures now read from ${col.name}.`, 'info');
      return;
    }
    adopt([]);
    logEvent(`Could not tell which issues have a picture in ${col.name}; every issue may show one.`, 'warn');
  }, [logEvent]);
  const recheckPictureColumn = useCallback(async () => {
    setPictureChecking(true);
    try {
      const col = await detectPictureColumn(logEvent);
      const before = pictureColumnRef.current;
      if (!col.ready && col.lookupFailed && before && before.ready) {
        // A passing hiccup must not turn off a column that works
        logEvent(`The picture column could not be checked again (${col.reason}). Still using ${before.name}.`, 'warn');
        setPictureColumn({ ...before, candidates: before.candidates || col.candidates });
      } else {
        setPictureColumn(col);
        if (col.ready) logEvent(`Pictures are stored in column "${col.name}" (${col.type || 'type unknown'}).`, 'info');
        if (col.ready && col.name !== marksColumn.current) await reloadPictureMarks(col);
      }
    } catch (error) {
      logEvent(`Picture column check failed: ${error.message}`, 'error');
    }
    setPictureChecking(false);
  }, [logEvent, reloadPictureMarks]);
  const pickPictureColumn = useCallback((name) => { writeColumnPick('obsPicture', name); recheckPictureColumn(); }, [recheckPictureColumn]);
  const pictureFix = useMemo(() => ({ recheck: recheckPictureColumn, pick: pickPictureColumn, checking: pictureChecking, typed: readColumnPick('obsPicture') }), [recheckPictureColumn, pickPictureColumn, pictureChecking]);

  // The equipment id column: check the table again (after it was created), or use one picked or typed on this device. Another
  // column means the problems are read again, so the equipment of each one comes from it.
  const [equipmentChecking, setEquipmentChecking] = useState(false);
  const [equipmentCheckError, setEquipmentCheckError] = useState('');
  const equipmentColumnsRef = useRef(equipmentColumns);
  equipmentColumnsRef.current = equipmentColumns;
  const recheckEquipmentColumns = useCallback(async () => {
    setEquipmentChecking(true);
    setEquipmentCheckError('');
    try {
      const eq = await detectEquipmentColumns(logEvent);
      const before = equipmentColumnsRef.current;
      const ctx = problemCtx.current;
      if (eq.lookupFailed && !eq.idColumn && before && before.idColumn) {
        // A passing hiccup must not turn off a column that works
        logEvent(`The equipment id column could not be checked again (${eq.reason}). Still using ${before.idColumn}.`, 'warn');
        setEquipmentCheckError(eq.reason);
      } else if (!ctx || (ctx.select && eq.idColumn === ctx.idColumn)) {
        // The same column as now (or nothing read yet): only what is said about it changes
        setEquipmentColumns(eq);
        if (ctx) ctx.eqColumns = eq;
      } else {
        // Ask for the new column: the next read finds which columns Dataverse gives (a refused one steps down, as at start-up)
        const pic = pictureColumnRef.current;
        ctx.eqColumns = eq;
        ctx.select = null;
        ctx.selectOptions = problemSelectOptions(pic && pic.ready ? pic : { ready: false }, eq.idColumn);
        setEquipmentColumns(eq);
        logEvent(eq.idColumn ? `Equipment ids now read from ${eq.idColumn}; reading the problems again.` : 'No equipment id column now; reading the problems again.', 'info');
        await readProblems('all', maps, currentMap, timeFilter);
      }
    } catch (error) {
      logEvent(`Equipment column check failed: ${error.message}`, 'error');
      setEquipmentCheckError(error.message);
    }
    setEquipmentChecking(false);
  }, [logEvent, readProblems, maps, currentMap, timeFilter]);
  const pickEquipmentColumn = useCallback((name) => { writeColumnPick('obsEquipmentIds', name); recheckEquipmentColumns(); }, [recheckEquipmentColumns]);
  const equipmentFix = useMemo(() => ({ recheck: recheckEquipmentColumns, pick: pickEquipmentColumn, checking: equipmentChecking, error: equipmentCheckError }), [recheckEquipmentColumns, pickEquipmentColumn, equipmentChecking, equipmentCheckError]);

  // What the Bulk Upload tab needs to make issues (observations) from pictures, or add a picture to an issue
  const onIssueSaved = useCallback((item, isNew) => {
    savedHere(isNew ? item : { id: item.id }, prev => (isNew
      ? [item].concat(prev.filter(sub => sub.id !== item.id))
      : prev.map(sub => (sub.id === item.id ? { ...sub, ...item } : sub))));
  }, [savedHere]);
  const showIssue = useCallback((item) => { setFocusItem(item); setActiveTab('overview'); }, []);
  const openAssetView = useCallback((v) => setActiveTab(ASSET_VIEW_TABS[v] || 'assetmap'), []);
  // closedMore: older closed issues are not loaded, so a search can also ask Dataverse (searchOlder)
  // timeNarrowed: the header's timeframe leaves out closed issues submitted before it (the search can look there too)
  const closedMore = !!problemWindow.closedNext;
  const timeNarrowed = timeFilter !== 'all';
  const problemsLoading = problemWindow.status === 'loading';
  const issueKit = useMemo(() => ({
    submissions, pictureColumn, pictureFix, equipmentColumns, equipmentFix, mapImage: mainMapImage, mapKey: mainMapKey, onIssueSaved, onShowIssue: showIssue,
    closedMore, timeNarrowed, problemsLoading, searchOlder: searchOlderClosed, olderSearch
  }), [submissions, pictureColumn, pictureFix, equipmentColumns, equipmentFix, mainMapImage, mainMapKey, onIssueSaved, showIssue, closedMore, timeNarrowed, problemsLoading, searchOlderClosed, olderSearch]);

  // Placed equipment (the Asset Map and the Overview's Equipment layer share it). Spots saved while the pages are still coming
  // in win over what those pages said.
  const assetMapColumn = assetMeta.mapColumn ? assetMeta.mapColumn.name : null;
  const assetMetaDone = assetMeta.status === 'ready' || assetMeta.status === 'error';
  const pinSaves = useRef(null);
  const pinReq = useRef(0); // the newest pin load: an older one (another map column) is dropped when it ends
  const loadPins = useCallback(async () => {
    if (!assetMapColumn) return;
    pinReq.current += 1;
    const req = pinReq.current;
    pinSaves.current = {};
    setAssetPins(p => ({ ...p, status: 'loading', error: '' }));
    try {
      const r = await loadAssetPins(assetMeta.entitySet || ASSET_SET, assetMapColumn, logEvent);
      if (req !== pinReq.current) return;
      const saved = pinSaves.current || {};
      pinSaves.current = null;
      const savedRows = Object.keys(saved).map(id => saved[id]).filter(p => p.location);
      setAssetPins({ status: 'ready', rows: r.rows.filter(p => !saved[p.id]).concat(savedRows), capped: r.capped, error: '' });
    } catch (error) {
      if (req !== pinReq.current) return;
      pinSaves.current = null;
      logEvent(`Placed assets could not be loaded: ${error.message}`, 'error');
      setAssetPins(p => ({ ...p, status: 'error', error: error.message }));
    }
  }, [assetMeta.entitySet, assetMapColumn, logEvent]);
  // Another map column (picked on this device, or created and checked again): the pins are read again from it, and a load
  // from the old column still running is dropped. Done while rendering (not in an effect), so the views' effects, which run
  // before this component's, never start a load that this would then drop.
  const [pinColumn, setPinColumn] = useState(assetMapColumn);
  if (pinColumn !== assetMapColumn) {
    setPinColumn(assetMapColumn);
    pinReq.current += 1;
    pinSaves.current = null;
    setAssetPins({ status: 'idle', rows: [], capped: false, error: '' });
  }
  // The Overview's Equipment layer: the columns, then the pins, only once it is switched on
  const equipmentLayerWanted = activeTab === 'overview' && layers.equipment;
  useEffect(() => {
    if (!equipmentLayerWanted) return;
    if (assetMeta.status === 'idle') loadAssetMeta();
    else if (assetMetaDone && assetMapColumn && assetPins.status === 'idle') loadPins();
  }, [equipmentLayerWanted, assetMeta.status, assetMetaDone, assetMapColumn, assetPins.status, loadAssetMeta, loadPins]);
  const overviewPins = useMemo(() => (layers.equipment ? assetPins.rows.filter(p => pinOnMap(p.location, mainMapKey)) : []), [layers.equipment, assetPins.rows, mainMapKey]);
  const equipmentLayer = useMemo(() => {
    if (!layers.equipment) return { status: 'off', note: '' };
    if (assetMeta.status === 'idle' || assetMeta.status === 'loading' || (assetMapColumn && (assetPins.status === 'idle' || assetPins.status === 'loading'))) return { status: 'loading', note: 'Loading equipment...' };
    if (!assetMapColumn) return { status: 'none', note: `Equipment cannot be drawn: ${assetMeta.mapReason || 'the assets table has no map spot column.'}` };
    if (assetPins.status === 'error') return { status: 'error', note: `Equipment could not be loaded: ${assetPins.error}` };
    return { status: 'ready', note: assetPins.capped ? `Only the first ${assetPins.rows.length} placed pieces are drawn.` : '' };
  }, [layers.equipment, assetMeta.status, assetMeta.mapReason, assetMapColumn, assetPins.status, assetPins.error, assetPins.capped, assetPins.rows.length]);
  const openAssetOnMap = useCallback((id) => {
    setAssetFocusRequest(prev => ({ id, n: prev ? prev.n + 1 : 1 }));
    setActiveTab('assetmap');
    logEvent(`Opening asset ${id} on the Asset Map.`, 'info');
  }, [logEvent]);

  // Close or reopen one observation. Resolves to '' when saved, else the reason it was not.
  const setItemClosed = useCallback(async (item, closed) => {
    try {
      await saveStatus(item.id, closed, logEvent);
      const when = new Date().toISOString();
      const who = currentUserName();
      savedHere({ id: item.id }, prev => prev.map(s => (s.id === item.id ? { ...s, closed, statusReason: '', modifiedOn: when, modifiedBy: who } : s)));
      logEvent(`Observation ${item.id} ${closed ? 'closed' : 'reopened'}.`, 'success');
      return '';
    } catch (error) {
      logEvent(`Could not ${closed ? 'close' : 'reopen'} ${item.id}: ${error.message}`, 'error', { id: item.id, closed });
      return error.message;
    }
  }, [logEvent]);

  // Latest copy of every observation by id, so an open details window shows a change (closed, reopened) straight away
  // even when the filters now hide that item
  const liveItems = useMemo(() => {
    const byId = {};
    submissions.forEach(s => { byId[s.id] = s; });
    return byId;
  }, [submissions]);

  // The Dataverse address the requests go to (the host's, else this page's own); no line when neither is known
  const hostLine = useMemo(() => {
    let host = '';
    try {
      const g = hostContext();
      host = g ? new URL(g.getClientUrl()).host : window.location.host;
    } catch (e) { host = ''; }
    return host ? `Host: ${host}\n` : '';
  }, []);

  // Group logs for the 3 columns
  const infoLogs = logs.filter(l => l.type === 'info' || l.type === 'success').reverse();
  const debugLogs = logs.filter(l => l.type === 'debug' || l.type === 'warn' || l.type === 'error').reverse();
  const dataLogs = logs.filter(l => l.type === 'data').reverse();

  // The app zoom scales vh as well: the height is divided by it, so the app always fills exactly one screen (no bar falls
  // off the bottom when zoomed in, no empty band when zoomed out)
  return (
    <div className="flex flex-col h-screen w-full bg-[#F7F9FC] text-slate-900 overflow-hidden" style={{ zoom: `${globalZoom}%`, height: `${(10000 / globalZoom).toFixed(3)}vh`, fontFamily: BRAND_FONT }}>
      {/* Header: title left, logo top right, yellow rule underneath (company theme) */}
      <header className="bg-white border-b-4 border-[#FFB81C] shrink-0 z-[100]">
        <div className="px-4 sm:px-7 min-h-[72px] py-2 flex items-center justify-between gap-4">
          <div className="min-w-0">
            <h1 className="text-base sm:text-lg font-black text-[#00468B] leading-tight tracking-tight sm:truncate">{APP_TITLE}</h1>
            <p className="text-[11px] font-bold text-slate-500 leading-snug sm:truncate" data-testid="header-line">
              {signedIn.name ? <span data-testid="signed-in">Signed in as {signedIn.name} · </span> : null}
              {headerCounts.open} open · {problemWindow.closedNext && problemWindow.closedTotal !== null
                ? `${headerCounts.closed} of ${problemWindow.closedTotal}${problemWindow.closedCapped ? '+' : ''} closed loaded`
                : `${headerCounts.closed} closed`}
              {problemWindow.status === 'loading' ? ' · loading...' : ''}
            </p>
          </div>
          <div className="flex items-center gap-3 shrink-0">
            {maps.length > 1 && (
              <label className="flex items-center gap-1.5 bg-white px-2 py-1 rounded-lg border border-[#B3D4F2]" title="Which facility map to show. Each map has its own problems and equipment.">
                <MapIcon className="w-4 h-4 text-[#0072CE] shrink-0" />
                <span className="sr-only">Map</span>
                <select value={mapId || ''} onChange={e => chooseMap(e.target.value)} aria-label="Map" data-testid="map-picker" className="bg-transparent text-sm font-bold text-[#00468B] focus:outline-none cursor-pointer max-w-[10rem]">
                  {maps.map(m => <option key={m.id} value={m.id}>{m.label}</option>)}
                </select>
              </label>
            )}
            <BrandLogo />
          </div>
        </div>
      </header>

      {/* Tab bar: tabs, timeframe, app zoom, debug console */}
      <nav className="bg-white border-b border-slate-200 shrink-0 z-[90]">
        <div className="px-3 sm:px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-2">
          {/* Phones scroll the tabs sideways; from md up every tab stays in view and the controls move under them when needed */}
          <div className="flex gap-1 overflow-x-auto flex-1 min-w-[260px] md:flex-none md:flex-wrap md:overflow-visible md:max-w-full" role="tablist" aria-label="Views">
            <TabButton active={activeTab === 'overview'} onClick={() => { setActiveTab('overview'); logEvent('Navigated to Map Overview tab', 'info'); }} icon={<MapIcon />} label="Overview" />
            <TabButton active={activeTab === 'submit'} onClick={() => { setActiveTab('submit'); logEvent('Navigated to Submit Map tab', 'info'); }} icon={<MapPin />} label="Map Submission" />
            <TabButton active={activeTab === 'assetmap'} onClick={() => { setActiveTab('assetmap'); logEvent('Navigated to Asset Map tab', 'info'); }} icon={<BoxIcon />} label="Asset Map" />
            <TabButton active={activeTab === 'assettable'} onClick={() => { setActiveTab('assettable'); logEvent('Navigated to Asset Management tab', 'info'); }} icon={<WrenchIcon />} label="Asset Management" />
            <TabButton active={activeTab === 'bulk'} onClick={() => { setActiveTab('bulk'); logEvent('Navigated to Bulk Upload tab', 'info'); }} icon={<UploadIcon />} label="Bulk Upload" />
            <TabButton active={activeTab === 'gallery'} onClick={() => { setActiveTab('gallery'); logEvent('Navigated to Gallery View tab', 'info'); }} icon={<ImageIcon />} label="Gallery" />
            <TabButton active={activeTab === 'table'} onClick={() => { setActiveTab('table'); logEvent('Navigated to Data Table tab', 'info'); }} icon={<TableIcon />} label="Data Table" />
          </div>

          <div className="flex items-center gap-2 shrink-0 flex-wrap md:ml-auto">
            {/* Timeframe Filter */}
            <label className="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-[#B3D4F2]">
              <FilterIcon className="w-4 h-4 text-[#0072CE]" />
              <span className="sr-only">Timeframe</span>
              <select value={timeFilter} onChange={e => setTimeFilter(e.target.value)} className="bg-transparent text-sm font-bold text-[#00468B] focus:outline-none cursor-pointer">
                <option value="all">All Time</option>
                <option value="24h">Last 24h</option>
                <option value="7d">Last 7 Days</option>
                <option value="30d">Last 30 Days</option>
              </select>
            </label>

            {/* Global Zoom Control */}
            <div className="hidden md:flex items-center gap-1 bg-white px-1.5 py-1 rounded-lg border border-[#B3D4F2]">
              <button onClick={() => setGlobalZoom(z => Math.max(50, z - 10))} className="p-1 hover:bg-[#E6F1FB] text-[#0072CE] rounded transition-colors" title="Zoom Out App"><ZoomOut className="w-4 h-4" /></button>
              <span className="text-xs font-bold text-[#00468B] min-w-[3rem] text-center">{globalZoom}%</span>
              <button onClick={() => setGlobalZoom(z => Math.min(200, z + 10))} className="p-1 hover:bg-[#E6F1FB] text-[#0072CE] rounded transition-colors" title="Zoom In App"><ZoomIn className="w-4 h-4" /></button>
            </div>

            {/* PERMANENT DEBUG CONSOLE BUTTON */}
            <button
              onClick={() => {
                setAdminOpen(!adminOpen);
                if (!adminOpen) logEvent('Admin monitor opened', 'info');
              }}
              title={adminOpen ? 'Close Debug' : 'Debug'}
              aria-label={adminOpen ? 'Close Debug' : 'Debug'}
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg font-bold transition-colors text-xs uppercase tracking-wider ${adminOpen ? 'bg-[#FFB81C] text-slate-900 hover:bg-[#f5aa00]' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-300'}`}
            >
              <Terminal className="w-4 h-4" />
              <span className={adminOpen ? '' : 'hidden 2xl:inline'}>{adminOpen ? 'Close Debug' : 'Debug'}</span>
            </button>
          </div>
        </div>
      </nav>

      {/* Main Content Area */}
      <main className={`flex-1 overflow-hidden relative transition-all duration-300 ${adminOpen ? 'pb-[40vh]' : 'pb-0'}`}>
        {activeTab === 'overview' && (
           <OverviewTab
             submissions={overviewSubmissions}
             categoryBar={overviewBar}
             logEvent={logEvent}
             mapImage={mainMapImage}
             setMainMapImage={dropMapImage}
             mapPicture={mapPicture}
             layers={layers}
             onLayers={changeLayers}
             pins={overviewPins}
             equipmentLayer={equipmentLayer}
             onOpenAsset={openAssetOnMap}
             focusItem={focusItem}
             setFocusItem={setFocusItem}
             onEdit={(item) => { setEditingItem(item); setActiveTab('submit'); }}
             onSetClosed={setItemClosed}
             liveItems={liveItems}
           />
        )}
        {activeTab === 'submit' && (
           <SubmitTab
             key={mainMapKey}
             submissions={timeFilteredSubmissions}
             savedHere={savedHere}
             logEvent={logEvent}
             mapImage={mainMapImage}
             setMainMapImage={dropMapImage}
             mapNote={mapPicture.note}
             mapKey={mainMapKey}
             editingItem={editingItem}
             setEditingItem={setEditingItem}
             pictureColumn={pictureColumn}
             pictureFix={pictureFix}
             equipmentColumns={equipmentColumns}
           />
        )}
        {(assetView || assetsOpened) && (
          <div className={assetView ? 'h-full' : 'hidden'}>
           <AssetsTab
             view={assetView || 'map'}
             onView={openAssetView}
             mapImage={mainMapImage}
