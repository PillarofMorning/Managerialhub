// ==========================================
// "ASSIGN THIS SPOT": pick the asset for a clicked spot, or create one there
// ==========================================
function AssignSpot({ spot, set, mapColumn, mapReason, canCreate, onAssign, onCreate, onCancel, logEvent }) {
  const [text, setText] = useState('');
  const [res, setRes] = useState({ rows: [], loading: true, error: '', recent: true });
  const [busyId, setBusyId] = useState('');
  const [error, setError] = useState('');
  const req = useRef(0);
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);

  useEffect(() => {
    if (!mapColumn) return undefined;
    const words = text.trim().split(/\s+/).filter(Boolean).slice(0, 4);
    const t = setTimeout(() => {
      const r = req.current + 1;
      req.current = r;
      setRes(p => ({ ...p, loading: true, error: '' }));
      // Nothing typed: the latest changed assets that are not on the map yet
      fetchAssetPage({ set, words, mapColumn, placement: words.length ? 'all' : 'unplaced', pageSize: 25 })
        .then(page => { if (r === req.current && mounted.current) setRes({ rows: page.rows, loading: false, error: '', recent: words.length === 0 }); })
        .catch(e => { if (r === req.current && mounted.current) setRes({ rows: [], loading: false, error: e.message, recent: words.length === 0 }); });
    }, words.length ? 300 : 0);
    return () => clearTimeout(t);
  }, [text, set, mapColumn]);

  const assign = async (asset) => {
    if (busyId) return;
    setBusyId(asset.id);
    setError('');
    try {
      await onAssign(asset);
    } catch (e) {
      logEvent(`Could not put ${asset.name} on the map: ${e.message}`, 'error');
      if (mounted.current) setError(`Not saved: ${e.message}`);
    } finally {
      if (mounted.current) setBusyId('');
    }
  };

  return (
    <div className="flex flex-col flex-1 min-h-0">
      <div className="p-3 border-b-2 border-[#E6F1FB] flex items-center justify-between gap-2 shrink-0">
        <span className="font-black text-[11px] uppercase tracking-widest text-[#00468B]">This spot</span>
        <button type="button" onClick={onCancel} className="text-slate-400 hover:text-[#E4002B]" aria-label="Cancel this spot"><X className="w-5 h-5" /></button>
      </div>
      <div className="p-3 space-y-3 overflow-y-auto flex-1">
        {!mapColumn ? (
          <p className="text-sm text-[#9A6700] bg-[#FFF6E0] border border-[#FFB81C] rounded-md p-2">Assets cannot be placed yet: {mapReason}</p>
        ) : (
          <>
            <SpotNote spot={spot} />
            <div>
              <label htmlFor="assign-search" className="block text-xs font-bold text-slate-600 mb-1">Which asset is here?</label>
              <SearchBox query={text} onQuery={setText} placeholder="Search name, room, area..." ariaLabel="Search the asset for this spot" />
            </div>
            {error && <p className="text-xs text-[#C4001F]" role="alert">{error}</p>}
            {res.error && <p className="text-xs text-[#C4001F]" role="alert">The assets could not be loaded: {res.error}</p>}
            <div className="space-y-1.5">
              {res.recent && res.rows.length > 0 && <p className="text-[11px] font-bold uppercase tracking-wider text-slate-500">Not on the map yet (latest changed)</p>}
              {res.rows.map(a => (
                <div key={a.id} className="flex items-center justify-between gap-2 p-2 rounded-lg border border-slate-100">
                  <span className="min-w-0">
                    <span className="block font-semibold text-sm text-[#00468B] [overflow-wrap:anywhere]">{a.name}</span>
                    <span className="block text-xs text-slate-500">{[a.room, a.area].filter(Boolean).join(' · ') || 'No room or area'}{a.location ? ' · already on the map' : ''}</span>
                  </span>
                  <button
                    type="button"
                    onClick={() => assign(a)}
                    disabled={!!busyId}
                    className="shrink-0 bg-[#0072CE] text-white px-2.5 py-1 rounded-md text-xs font-bold hover:bg-[#00468B] disabled:opacity-50"
                    title={a.location ? 'Moves the pin of this asset here' : 'Puts this asset here'}
                  >
                    {busyId === a.id ? 'Saving...' : (a.location ? 'Move here' : 'Put here')}
                  </button>
                </div>
              ))}
              {res.loading && <p className="text-xs text-slate-500">Loading...</p>}
              {!res.loading && !res.error && res.rows.length === 0 && (
                <p className="text-xs text-slate-500">{res.recent ? 'Every asset is already on the map. Search to move one here.' : 'No assets match.'}</p>
              )}
            </div>
          </>
        )}
      </div>
      <div className="p-3 border-t border-slate-100 shrink-0 flex flex-wrap gap-2">
        <button type="button" onClick={onCreate} disabled={!canCreate} className="bg-[#00468B] text-white px-3 py-1.5 rounded-md text-sm font-semibold hover:bg-[#003366] disabled:opacity-50">
          {mapColumn ? '+ New asset here' : '+ New asset'}
        </button>
        <button type="button" onClick={onCancel} className="px-3 py-1.5 rounded-md text-sm font-semibold border border-slate-300 text-slate-700 hover:bg-slate-100">Cancel</button>
      </div>
    </div>
  );
}

// ==========================================
// ASSET EDITOR: every column of one asset, by type. New assets too.
// ==========================================
// On the map (new assets only) it gets onPlace / onClearNewSpot; in the equipment table it gets onShowOnMap and onFilesChanged.
function AssetEditor({ meta, set, assetId, createLocation, mapKey, placing, refreshToken, onRetryMeta, onDirtyChange, onClose, onSaved, onCreated, onPlace, onClearNewSpot, onShowOnMap, onFilesChanged, logEvent }) {
  const isNew = !assetId;
  const mapColumn = meta.mapColumn ? meta.mapColumn.name : null;
  // The map column has its own buttons; the id is shown under Record info
  const fields = useMemo(() => meta.fields.filter(f => f.name !== mapColumn && (!isNew || isEditableField(f, true))), [meta.fields, mapColumn, isNew]);
  const editable = useMemo(() => fields.filter(f => isEditableField(f, isNew)), [fields, isNew]);
  const emptyForm = () => {
    const v = {};
    fields.forEach(f => { v[f.name] = emptyValue(f); });
    return { initial: v, values: { ...v } };
  };
  const [load, setLoad] = useState({ status: isNew ? 'ready' : 'loading', error: '', row: null, etag: '' });
  const [form, setForm] = useState(emptyForm);
  const formRef = useRef(form);
  formRef.current = form;
  const clashRef = useRef(false); // kept until the next save or full reload
  const imageColumns = useMemo(() => fields.filter(f => f.kind === 'image').map(f => f.name), [fields]);
  const rowRef = useRef(null);
  const [errors, setErrors] = useState({});
  const [saving, setSaving] = useState(false);
  const [saveError, setSaveError] = useState('');
  const [stale, setStale] = useState(false);
  const [notice, setNotice] = useState('');
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);

  // Server values in; with keepEdits the fields the user has changed keep the user's text
  const applyRow = useCallback((fresh, keepEdits) => {
    // A save's answer has no image columns: keep what the last full read said about them
    const row = { ...fresh };
    imageColumns.forEach(c => { if (row[c] === undefined && rowRef.current) row[c] = rowRef.current[c]; });
    rowRef.current = row;
    const server = {};
    fields.forEach(f => { server[f.name] = toEditValue(f, row); });
    // Someone else changed a field the user is still editing: keep the version the edit started from, so Save
    // reports the clash ("Someone else changed this asset") instead of quietly writing over their change
    let clash = false;
    if (keepEdits) {
      const prev = formRef.current;
      fields.forEach(f => {
        const was = editKey(f, prev.initial[f.name]);
        const mine = editKey(f, prev.values[f.name]);
        const now = editKey(f, server[f.name]);
        if (mine !== was && now !== was && now !== mine) clash = true;
      });
    }
    setForm(prev => {
      const values = { ...server };
      if (keepEdits) {
        fields.forEach(f => {
          if (editKey(f, prev.values[f.name]) !== editKey(f, prev.initial[f.name])) values[f.name] = prev.values[f.name];
        });
      }
      return { initial: server, values };
    });
    if (!keepEdits) clashRef.current = false;
    else if (clash) clashRef.current = true;
    const keepEtag = clashRef.current;
    setLoad(l => ({ status: 'ready', error: '', row, etag: keepEtag && l.etag ? l.etag : (row['@odata.etag'] || '') }));
  }, [fields, imageColumns]);

  const reload = useCallback(async (keepEdits) => {
    if (isNew) return;
    if (!keepEdits) setLoad(l => ({ ...l, status: 'loading', error: '' }));
    try {
      const row = await loadAssetRow(set, assetId, imageColumns);
      if (mounted.current) applyRow(row, keepEdits);
    } catch (error) {
      logEvent(`Asset ${assetId} could not be read: ${error.message}`, 'error');
      if (!mounted.current) return;
      if (keepEdits) setNotice(`Could not refresh this asset: ${error.message}`);
      else setLoad({ status: 'error', error: error.message, row: null, etag: '' });
    }
  }, [isNew, set, assetId, applyRow, imageColumns, logEvent]);

  // The first read fills the form; when the columns are read again later (Check again, a column pick) the row is read again
  // keeping what is being typed
  const loadedOnce = useRef(false);
  useEffect(() => {
    if (meta.fields.length === 0) return;
    const keep = loadedOnce.current;
    loadedOnce.current = true;
    reload(keep);
  }, [reload, meta.fields.length]);
  // A spot or file saved elsewhere changed the row: read it again, keep what is being typed
  useEffect(() => {
    if (refreshToken) reload(true);
  }, [refreshToken]); // eslint-disable-line react-hooks/exhaustive-deps

  const changed = editable.filter(f => editKey(f, form.values[f.name]) !== editKey(f, form.initial[f.name]));
  const isDirty = changed.length > 0;
  useEffect(() => { onDirtyChange(isDirty); }, [isDirty, onDirtyChange]);
  useEffect(() => () => onDirtyChange(false), [onDirtyChange]);

  const setValue = (name, value) => {
    setForm(prev => ({ ...prev, values: { ...prev.values, [name]: value } }));
    setErrors(prev => (prev[name] ? { ...prev, [name]: '' } : prev));
    setNotice('');
  };

  const save = async (force) => {
    if (saving) return;
    // New: every column must be valid (required ones filled); existing: what was changed
    const toCheck = isNew ? editable : changed;
    const errs = {};
    toCheck.forEach(f => { const msg = validateField(f, form.values[f.name]); if (msg) errs[f.name] = msg; });
    setErrors(errs);
    if (Object.keys(errs).length > 0) {
      setSaveError('Fix the marked fields first.');
      return;
    }
    const payload = {};
    changed.forEach(f => { const kv = toPayloadEntry(f, form.values[f.name]); payload[kv[0]] = kv[1]; });
    if (isNew && createLocation && mapColumn) payload[mapColumn] = mapLocationText(createLocation, mapKey, meta.mapColumn.maxLength);
    if (!isNew && Object.keys(payload).length === 0) return;
    setSaving(true);
    setSaveError('');
    setStale(false);
    setNotice('');
    try {
      if (isNew) {
        const row = await createAsset(set, payload, logEvent);
        if (mounted.current) onCreated(row);
      } else {
        const row = await patchAsset(set, assetId, payload, force ? '*' : load.etag, logEvent);
        logEvent(`Saved asset ${assetId} (${changed.length} column${changed.length === 1 ? '' : 's'}).`, 'success');
        if (!mounted.current) return;
        applyRow(row, false);
        setNotice('Saved.');
        onSaved(row);
      }
    } catch (error) {
      logEvent(`Asset ${isNew ? 'create' : 'save'} failed: ${error.message}`, 'error', payload);
      if (!mounted.current) return;
      if (error.stale) {
        setStale(true);
        setSaveError('Someone else changed this asset after you opened it. Reload to see their version (your changes here are dropped), or save yours over it.');
      } else {
        setSaveError(`Not saved: ${error.message}`);
      }
    } finally {
      if (mounted.current) setSaving(false);
    }
  };

  const discard = () => {
    setForm(prev => ({ initial: prev.initial, values: { ...prev.initial } }));
    // Nothing of the user's is left to clash with the newer version on screen
    clashRef.current = false;
    setLoad(l => ({ ...l, etag: (l.row && l.row['@odata.etag']) || l.etag }));
    setErrors({});
    setSaveError('');
    setStale(false);
  };

  const row = load.row;
  const nameField = fields.find(f => f.isPrimaryName);
  const liveName = nameField ? String(form.values[nameField.name] || '').trim() : '';
  const title = liveName || (isNew ? 'New asset' : '(no name)');
  const placeText = [form.values.craa5_roomname, form.values.craa5_areaname].filter(v => v && String(v).trim()).join(' · ');
  const location = isNew ? createLocation : (row && mapColumn ? parseMapLocation(row[mapColumn]) : null);
  const onThisMap = pinOnMap(location, mapKey);

  if (meta.fields.length === 0) {
    return (
      <div className="flex-1 p-4 space-y-3">
        <EditorHeader title={isNew ? 'New asset' : 'Asset'} subtitle="" onClose={onClose} isNew={isNew} />
        {meta.status === 'error' ? (
          <div className="text-sm text-[#C4001F]" role="alert">
            The Assets table's columns could not be read: {meta.error}
            <div><button type="button" onClick={onRetryMeta} className="mt-2 text-[#0072CE] underline">Try again</button></div>
          </div>
        ) : <p className="text-sm text-slate-500">Reading the Assets table...</p>}
      </div>
    );
  }

  const { groups, info } = groupAssetFields(fields);

  return (
    <div className="flex flex-col flex-1 min-h-0" data-testid="asset-editor">
      <div className="p-4 border-b-2 border-[#E6F1FB] shrink-0 space-y-2">
        <EditorHeader title={title} subtitle={placeText} onClose={onClose} isNew={isNew} />
        {/* Map spot */}
        <div className="flex flex-wrap items-center gap-2 text-xs">
          {!mapColumn ? (
            <span className="text-[#9A6700]">Map spot: {meta.mapReason}</span>
          ) : placing ? (
            <span className="font-semibold text-[#00468B]">Click the map where this asset is...</span>
          ) : isNew ? (
            onPlace ? (
              <>
                <span className={`font-semibold ${createLocation ? 'text-[#00468B]' : 'text-slate-500'}`}>{createLocation ? 'Goes on the map at the highlighted spot.' : 'Not on the map.'}</span>
                <button type="button" onClick={() => onPlace({ id: 'new', name: title })} className="px-2 py-1 rounded-md font-bold border border-[#B3D4F2] text-[#0072CE] hover:bg-[#E6F1FB]">{createLocation ? 'Pick another spot' : 'Pick a spot on the map'}</button>
                {createLocation && <button type="button" onClick={onClearNewSpot} className="px-2 py-1 rounded-md font-bold border border-slate-300 text-slate-600 hover:bg-slate-100">No spot</button>}
              </>
            ) : (
              <span className="text-slate-500">Not on the map. Once it is created, "Open on map" takes you there to place it.</span>
            )
          ) : load.status !== 'ready' ? null : (
            <>
              <span className={`inline-flex items-center gap-1 font-semibold ${onThisMap ? 'text-[#00468B]' : 'text-slate-500'}`}>
                <MapPin className="w-3.5 h-3.5" />
                {onThisMap ? 'On the map' : (location ? `On another map (${location.map})` : 'Not on the map')}
              </span>
              {onShowOnMap && (
                <button type="button" onClick={() => onShowOnMap(assetId)} className="px-2 py-1 rounded-md font-bold bg-[#0072CE] text-white hover:bg-[#00468B]">{onThisMap ? 'Show on map' : 'Open on map'}</button>
              )}
            </>
          )}
        </div>
      </div>

      {/* Locked while saving: what is typed during the save would be replaced by the saved row */}
      <fieldset disabled={saving} className="flex-1 overflow-y-auto p-4 space-y-4 min-w-0 m-0 border-0">
        {load.status === 'loading' && <p className="text-sm text-slate-500">Loading the asset...</p>}
        {load.status === 'error' && (
          <div className="text-sm text-[#C4001F]" role="alert">
            This asset could not be loaded: {load.error}
            <div><button type="button" onClick={() => reload(false)} className="mt-2 text-[#0072CE] underline">Try again</button></div>
          </div>
        )}
        {load.status === 'ready' && groups.map(g => {
          const switches = g.key === 'freq' ? g.items.filter(f => f.kind === 'bool') : [];
          const rest = g.items.filter(f => switches.indexOf(f) === -1);
          return (
            <details key={g.key} open className="group/section rounded-lg border border-slate-200">
              <summary className="cursor-pointer select-none px-3 py-2 bg-[#F7F9FC] rounded-t-lg font-black text-[11px] uppercase tracking-widest text-[#00468B]">{g.title}</summary>
              <div className="p-3 space-y-3">
                {switches.length > 0 && (
                  <div className="grid grid-cols-2 gap-2" role="group" aria-label="Cleaning frequency">
                    {switches.map(f => (
                      <AssetField key={f.name} f={f} value={form.values[f.name]} onChange={v => setValue(f.name, v)} error={errors[f.name]} readOnly={!isEditableField(f, isNew)} row={row} compact />
                    ))}
                  </div>
                )}
                {rest.map(f => (
                  (f.kind === 'file' || f.kind === 'image') ? (
                    <AssetFileField key={f.name} f={f} row={row} set={set} assetId={assetId} isNew={isNew} canWrite={f.canUpdate} onChanged={() => { reload(true); if (onFilesChanged) onFilesChanged(); }} logEvent={logEvent} />
                  ) : (
                    <AssetField key={f.name} f={f} value={form.values[f.name]} onChange={v => setValue(f.name, v)} error={errors[f.name]} readOnly={!isEditableField(f, isNew)} row={row} />
                  )
                ))}
              </div>
            </details>
          );
        })}
        {load.status === 'ready' && !isNew && info.length > 0 && (
          <details className="rounded-lg border border-slate-200">
            <summary className="cursor-pointer select-none px-3 py-2 bg-[#F7F9FC] rounded-t-lg font-black text-[11px] uppercase tracking-widest text-slate-500">Record info</summary>
            <dl className="p-3 grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
              {info.map(f => (
                <div key={f.name} className="min-w-0">
                  <dt className="text-slate-400">{f.label}</dt>
                  <dd className="text-slate-700 font-medium [overflow-wrap:anywhere]">{displayValue(f, row) || '-'}</dd>
                </div>
              ))}
            </dl>
          </details>
        )}
        {isNew && fields.some(f => f.kind === 'file' || f.kind === 'image') && (
          <p className="text-xs text-slate-500">Pictures and files can be added once the asset is created.</p>
        )}
      </fieldset>

      <div className="p-3 border-t border-slate-200 bg-white shrink-0 space-y-2">
        {saveError && <p className="text-xs text-[#C4001F]" role="alert">{saveError}</p>}
        {stale && (
          <div className="flex gap-2">
            <button type="button" onClick={() => { setStale(false); setSaveError(''); setErrors({}); reload(false); }} className="px-3 py-1 rounded-md text-xs font-bold border border-slate-300 text-slate-700 hover:bg-slate-100">Reload</button>
            <button type="button" onClick={() => save(true)} className="px-3 py-1 rounded-md text-xs font-bold bg-[#E4002B] text-white hover:bg-[#C4001F]">Save mine anyway</button>
          </div>
        )}
        {notice && !saveError && <p className="text-xs text-green-700" role="status">{notice}</p>}
        <div className="flex items-center justify-between gap-2">
          <span className="text-xs text-slate-500">{isNew && placing ? 'Use the spot or Cancel on the map first.' : (isDirty ? `${changed.length} unsaved change${changed.length === 1 ? '' : 's'}` : (isNew ? '' : 'No changes'))}</span>
          <div className="flex gap-2">
            {isDirty && !isNew && <button type="button" onClick={discard} disabled={saving} className="px-3 py-1.5 rounded-md text-sm font-semibold border border-slate-300 text-slate-700 hover:bg-slate-100">Discard</button>}
            <button
              type="button"
              onClick={() => save(false)}
              disabled={saving || load.status !== 'ready' || (!isNew && !isDirty) || (isNew && placing)}
              className="px-4 py-1.5 rounded-md text-sm font-bold bg-[#0072CE] text-white hover:bg-[#00468B] disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
            >
              {saving ? 'Saving...' : (isNew ? 'Create asset' : 'Save changes')}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

function EditorHeader({ title, subtitle, onClose, isNew }) {
  return (
    <div className="flex items-start justify-between gap-2">
      <div className="min-w-0">
        <p className="text-[11px] font-black uppercase tracking-widest text-[#0072CE]">{isNew ? 'New asset' : 'Asset'}</p>
        <h3 className="text-lg font-black text-[#00468B] leading-tight [overflow-wrap:anywhere]">{title}</h3>
        {subtitle && <p className="text-xs text-slate-500">{subtitle}</p>}
      </div>
      <button type="button" onClick={onClose} className="text-slate-400 hover:text-[#E4002B] shrink-0" aria-label="Close the asset"><X className="w-5 h-5" /></button>
    </div>
  );
}

// One column: label, the control for its type, and its error
function AssetField({ f, value, onChange, error, readOnly, row, compact = false }) {
  const id = `asset-field-${f.name}`;
  const label = (
    <span className="flex items-baseline justify-between gap-2">
      <label htmlFor={id} className="text-xs font-bold text-slate-700" title={f.description || undefined}>
        {f.label}{(f.required || f.isPrimaryName) && !readOnly && <span className="text-[#E4002B]"> *</span>}
      </label>
      {!compact && <span className="text-[10px] text-slate-400 font-mono truncate" title={f.name}>{f.name}</span>}
    </span>
  );
  const inputClass = `w-full px-2.5 py-1.5 text-sm border rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ${error ? 'border-[#E4002B]' : 'border-slate-300 focus:border-[#0072CE]'}`;
  const err = error ? <p className="text-xs text-[#C4001F] mt-0.5" role="alert">{error}</p> : null;

  if (f.kind === 'bool' && compact) {
    return (
      <div>
        <button
          id={id}
          type="button"
          role="switch"
          aria-checked={value === true}
          disabled={readOnly}
          onClick={() => onChange(value !== true)}
          title={f.description || f.name}
          className={`w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg border text-xs font-bold transition-colors disabled:opacity-60 disabled:cursor-not-allowed ${value === true ? 'bg-[#E6F1FB] border-[#0072CE] text-[#00468B]' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}`}
        >
          <span className="text-left [overflow-wrap:anywhere]">{f.label}</span>
          <span className={`relative inline-block w-7 h-4 rounded-full shrink-0 transition-colors ${value === true ? 'bg-[#0072CE]' : 'bg-slate-300'}`} aria-hidden="true">
            <span className={`absolute top-0.5 w-3 h-3 rounded-full bg-white shadow transition-all ${value === true ? 'left-3.5' : 'left-0.5'}`} />
          </span>
        </button>
        {err}
      </div>
    );
  }

  if (readOnly) {
    const shown = displayValue(f, row);
    return (
      <div>
        {label}
        <p id={id} className="text-sm text-slate-800 mt-0.5 [overflow-wrap:anywhere]">{shown || <span className="text-slate-400">-</span>}</p>
      </div>
    );
  }

  let control;
  switch (f.kind) {
    case 'memo':
      control = <textarea id={id} rows={3} value={value} onChange={e => onChange(e.target.value)} className={inputClass} />;
      break;
    case 'int':
    case 'number':
      control = <input id={id} type="text" inputMode={f.kind === 'int' ? 'numeric' : 'decimal'} value={value} onChange={e => onChange(e.target.value)} className={inputClass} />;
      break;
    case 'bool':
      control = (
        <div id={id} className="inline-flex rounded-md border border-slate-300 overflow-hidden" role="group" aria-label={f.label}>
          {[[false, f.falseLabel || 'No'], [true, f.trueLabel || 'Yes']].map(([v, text]) => (
            <button key={text} type="button" aria-pressed={value === v} onClick={() => onChange(v)} className={`px-3 py-1 text-xs font-bold ${value === v ? 'bg-[#00468B] text-white' : 'bg-white text-slate-600 hover:bg-slate-100'}`}>{text}</button>
          ))}
        </div>
      );
      break;
    case 'choice':
      control = (
        <select id={id} value={value} onChange={e => onChange(e.target.value)} className={inputClass}>
          <option value="">-</option>
          {f.options.map(o => <option key={o.value} value={String(o.value)}>{o.label}</option>)}
        </select>
      );
      break;
    case 'choices':
      control = (
        <div id={id} className="flex flex-wrap gap-1.5" role="group" aria-label={f.label}>
          {f.options.map(o => {
            const key = String(o.value);
            const on = (value || []).indexOf(key) !== -1;
            return (
              <button key={key} type="button" aria-pressed={on} onClick={() => onChange(on ? value.filter(v => v !== key) : (value || []).concat([key]))} className={`px-2 py-0.5 rounded-full text-xs font-semibold border ${on ? 'bg-[#00468B] text-white border-[#00468B]' : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-100'}`}>{o.label}</button>
            );
          })}
        </div>
      );
      break;
    case 'date':
      control = <input id={id} type={f.dateOnly ? 'date' : 'datetime-local'} value={value} onChange={e => onChange(e.target.value)} className={inputClass} />;
      break;
    case 'lookup':
      control = <LookupField id={id} f={f} value={value} onChange={onChange} />;
      break;
    default: {
      const type = f.format === 'Email' ? 'email' : (f.format === 'Url' ? 'url' : (f.format === 'Phone' ? 'tel' : 'text'));
      control = (
        <div className="flex items-center gap-2">
          <input id={id} type={type} value={value} onChange={e => onChange(e.target.value)} className={inputClass} />
          {type === 'url' && /^https?:\/\//i.test(value || '') && <a href={value} target="_blank" rel="noopener noreferrer" className="text-xs font-bold text-[#0072CE] underline shrink-0">Open</a>}
        </div>
      );
    }
  }
  const length = (f.kind === 'text' || f.kind === 'memo') && f.maxLength && String(value || '').length > f.maxLength * 0.8
    ? <p className={`text-[10px] mt-0.5 ${String(value).length > f.maxLength ? 'text-[#C4001F]' : 'text-slate-400'}`}>{String(value).length} / {f.maxLength}</p>
    : null;
  return (
    <div>
      {label}
      <div className="mt-0.5">{control}</div>
      {length}
      {err}
    </div>
  );
}

// A lookup column: shows the linked row; "Change" searches the target table (25 rows at a time)
function LookupField({ id, f, value, onChange, label }) {
  const [open, setOpen] = useState(false);
  const [text, setText] = useState('');
  const [target, setTarget] = useState(null);
  const [res, setRes] = useState({ rows: [], loading: false, error: '' });
  const req = useRef(0);
  useEffect(() => {
    if (!open || target) return;
    loadTargetMeta(f.targets[0]).then(setTarget).catch(e => setRes({ rows: [], loading: false, error: e.message }));
  }, [open, target, f.targets]);
  useEffect(() => {
    if (!open || !target) return undefined;
    const t = setTimeout(() => {
      const r = req.current + 1;
      req.current = r;
      setRes(p => ({ ...p, loading: true, error: '' }));
      const filter = text.trim() ? `&$filter=${encodeURIComponent(`contains(${target.name},'${escLike(text.trim())}')`)}` : '';
      getJson(`${target.set}?$select=${target.id},${target.name}${filter}&$orderby=${target.name}&$top=25`)
        .then(d => { if (r === req.current) setRes({ rows: (d.value || []).map(x => ({ id: cleanGuid(x[target.id]), name: x[target.name] || '(no name)' })), loading: false, error: '' }); })
        .catch(e => { if (r === req.current) setRes({ rows: [], loading: false, error: e.message }); });
    }, text ? 250 : 0);
    return () => clearTimeout(t);
  }, [open, target, text]);

  return (
    <div id={id}>
      <div className="flex items-center gap-2">
        <span className={`text-sm ${value && value.id ? 'text-slate-800 font-medium' : 'text-slate-400'} [overflow-wrap:anywhere]`}>{value && value.id ? (value.name || value.id) : 'Not set'}</span>
        <button type="button" onClick={() => setOpen(o => !o)} aria-label={label ? `${open ? 'Close' : 'Change'} ${label}` : undefined} className="text-xs font-bold text-[#0072CE] underline">{open ? 'Close' : 'Change'}</button>
        {value && value.id && <button type="button" onClick={() => onChange({ id: '', name: '' })} aria-label={label ? `Clear ${label}` : undefined} className="text-xs font-bold text-slate-500 underline">Clear</button>}
      </div>
      {open && (
        <div className="mt-1.5 border border-slate-200 rounded-md p-2 space-y-1.5 bg-[#F7F9FC]">
          <input type="search" value={text} onChange={e => setText(e.target.value)} placeholder="Search..." aria-label={`Search ${f.label}`} className="w-full px-2 py-1 text-sm border border-slate-300 rounded-md bg-white" />
          {res.error && <p className="text-xs text-[#C4001F]">Could not search: {res.error}</p>}
          {res.loading && <p className="text-xs text-slate-500">Loading...</p>}
          <ul className="max-h-40 overflow-y-auto space-y-0.5">
            {res.rows.map(r => (
              <li key={r.id}>
                <button type="button" onClick={() => { onChange({ id: r.id, name: r.name, set: target.set }); setOpen(false); }} className="w-full text-left px-2 py-1 rounded text-sm hover:bg-[#E6F1FB]">{r.name}</button>
              </li>
            ))}
          </ul>
          {!res.loading && !res.error && res.rows.length === 0 && target && <p className="text-xs text-slate-500">Nothing found.</p>}
        </div>
      )}
    </div>
  );
}

// A File or Image column: upload, open and remove act straight away (they are their own requests in Dataverse).
// variant "cell" is the compact form used in the equipment table.
function AssetFileField({ f, row, set, assetId, isNew, canWrite, onChanged, logEvent, variant = 'field', assetLabel = '' }) {
  const [busy, setBusy] = useState('');
  const [error, setError] = useState('');
  const [confirmDelete, setConfirmDelete] = useState(false);
  const inputRef = useRef(null);
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
  const isImage = f.kind === 'image';
  const fileName = row ? row[`${f.name}_name`] || '' : '';
  const stamp = row ? (row[`${f.name}_timestamp`] || '') : '';
  const has = !!row && (isImage ? !!(row[f.name] || row[`${f.name}_timestamp`] || row[`${f.name}_url`]) : !!(row[f.name] || fileName));
  const sources = has && assetId
    ? (f.fullImage === false ? [] : [apiUrl(`${set}(${assetId})/${f.name}/$value?size=full&t=${encodeURIComponent(String(stamp))}`)]).concat([apiUrl(`${set}(${assetId})/${f.name}/$value?t=${encodeURIComponent(String(stamp))}`)])
    : [];

  const run = async (kind, work) => {
    if (busy) return;
    setBusy(kind);
    setError('');
    try {
      await work();
      if (mounted.current) setConfirmDelete(false);
      if (kind !== 'open') onChanged(); // a download does not change the row
    } catch (e) {
      logEvent(`${f.label}: ${kind} failed: ${e.message}`, 'error');
      if (mounted.current) setError(e.message);
    } finally {
      if (mounted.current) setBusy('');
    }
  };

  const onPick = (e) => {
    const file = e.target.files && e.target.files[0];
    e.target.value = '';
    if (!file) return;
    run('upload', async () => {
      // Phone photos for a picture column are shrunk to a JPEG first, as for observation pictures
      const up = await prepareAssetUpload(file, f);
      const done = await uploadAssetFile(set, assetId, f.name, up.body, up.name, logEvent, { mimeType: up.mimeType });
      logEvent(`Uploaded "${done.fileName}" to ${f.name} of asset ${assetId}${done.route === 'blocks' ? ' (sent in parts)' : ''}.`, 'success');
    });
  };

  const picker = canWrite && !isNew
    ? <input ref={inputRef} type="file" accept={isImage ? 'image/*,.heic,.heif' : undefined} onChange={onPick} className="hidden" aria-label={`Upload ${f.label}`} data-upload={f.name} />
    : null;
  const openIt = () => run('open', () => openAssetFile(set, assetId, f.name, fileName, isImage));
  const removeConfirm = confirmDelete && (
    <span className="inline-flex items-center gap-1.5 text-xs bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1">
      Remove {isImage ? 'the picture' : 'the file'}?
      <button type="button" disabled={!!busy} onClick={() => run('remove', () => deleteAssetFile(set, assetId, f.name, logEvent))} className="font-bold text-[#C4001F] underline">{busy === 'remove' ? 'Removing...' : 'Remove'}</button>
      <button type="button" onClick={() => setConfirmDelete(false)} className="font-bold text-slate-600 underline">Keep</button>
    </span>
  );

  if (variant === 'cell') {
    // Screen readers hear which asset a cell's buttons are for
    const of = assetLabel ? ` of ${assetLabel}` : '';
    // The small thumbnail Dataverse keeps (144 px), not the full picture
    const thumb = has && isImage && assetId ? [apiUrl(`${set}(${assetId})/${f.name}/$value?t=${encodeURIComponent(String(stamp))}`)] : [];
    return (
      <div data-file-field={f.name} className="min-w-0 px-1 py-0.5">
        <div className="flex items-center gap-1.5">
          {isImage && has && (
            <button type="button" onClick={openIt} disabled={!!busy} title={`Open the ${f.label.toLowerCase()}`} aria-label={`Open the ${f.label.toLowerCase()}${of}`} className="w-9 h-9 rounded border border-slate-200 bg-slate-50 overflow-hidden shrink-0 flex items-center justify-center">
              <StoredImage key={thumb.join('|')} sources={thumb} alt={f.label} className="w-full h-full object-cover" fallback={<ImageIcon className="w-4 h-4 text-slate-400" />} />
            </button>
          )}
          {!isImage && has && (
            <button type="button" onClick={openIt} disabled={!!busy} className="text-xs font-semibold text-[#0072CE] underline truncate max-w-[8rem] disabled:opacity-50" title={`Open ${fileName || 'the file'}`} aria-label={`Open ${fileName || 'the file'}, the ${f.label}${of}`}>
              {busy === 'open' ? 'Opening...' : (fileName || 'Open file')}
            </button>
          )}
          {!has && <span className="text-xs text-slate-400">{isImage ? 'No picture' : 'No file'}</span>}
          {picker}
          {picker && (
            <button type="button" disabled={!!busy} onClick={() => inputRef.current && inputRef.current.click()} title={`${has ? 'Replace' : 'Upload'} the ${f.label}`} aria-label={`${busy === 'upload' ? 'Uploading' : (has ? 'Replace' : 'Upload')} the ${f.label}${of}`} className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold bg-[#0072CE] text-white hover:bg-[#00468B] disabled:opacity-50 shrink-0">
              <Download className="w-3 h-3 rotate-180" />{busy === 'upload' ? 'Uploading...' : (has ? 'Replace' : 'Upload')}
            </button>
          )}
          {has && canWrite && !confirmDelete && (
            <button type="button" disabled={!!busy} onClick={() => setConfirmDelete(true)} title={`Remove the ${f.label}`} aria-label={`Remove the ${f.label}${of}`} className="p-0.5 rounded text-slate-400 hover:text-[#E4002B] hover:bg-slate-100 disabled:opacity-50 shrink-0">
              <X className="w-3.5 h-3.5" />
            </button>
          )}
        </div>
        {removeConfirm && <div className="mt-1">{removeConfirm}</div>}
        {error && <p className="text-[11px] text-[#C4001F] mt-0.5" role="alert">Not done: {error}</p>}
      </div>
    );
  }

  return (
    <div data-file-field={f.name}>
      <span className="flex items-baseline justify-between gap-2">
        <span className="text-xs font-bold text-slate-700" title={f.description || undefined}>{f.label}</span>
        <span className="text-[10px] text-slate-400 font-mono truncate">{f.name}</span>
      </span>
      {isImage && has && (
        <div className="mt-1 rounded-md border border-slate-200 bg-slate-50 overflow-hidden max-w-[16rem]">
          <StoredImage key={sources.join('|')} sources={sources} alt={f.label} className="w-full h-auto max-h-48 object-contain" fallback={<p className="text-xs text-slate-500 p-2">The picture could not be shown.</p>} />
        </div>
      )}
      <p className="text-sm text-slate-800 mt-0.5 [overflow-wrap:anywhere]">
        {has ? (isImage ? '' : (fileName || 'A file is stored.')) : <span className="text-slate-400">{isImage ? 'No picture' : 'No file'}</span>}
      </p>
      {isNew ? null : (
        <div className="flex flex-wrap items-center gap-2 mt-1">
          {picker && (
            <>
              {picker}
              <button type="button" disabled={!!busy} onClick={() => inputRef.current && inputRef.current.click()} className="px-2.5 py-1 rounded-md text-xs font-bold bg-[#0072CE] text-white hover:bg-[#00468B] disabled:opacity-50">
                {busy === 'upload' ? 'Uploading...' : (has ? 'Replace' : (isImage ? 'Upload picture' : 'Upload file'))}
              </button>
            </>
          )}
          {has && (
            <button type="button" disabled={!!busy} onClick={openIt} className="px-2.5 py-1 rounded-md text-xs font-bold border border-[#B3D4F2] text-[#0072CE] hover:bg-[#E6F1FB] disabled:opacity-50">
              {busy === 'open' ? 'Opening...' : 'Open'}
            </button>
          )}
          {has && canWrite && !confirmDelete && (
            <button type="button" disabled={!!busy} onClick={() => setConfirmDelete(true)} className="px-2.5 py-1 rounded-md text-xs font-bold border border-slate-300 text-slate-600 hover:bg-slate-100 disabled:opacity-50">Remove</button>
          )}
          {removeConfirm}
        </div>
      )}
      {error && <p className="text-xs text-[#C4001F] mt-0.5" role="alert">Not done: {error}</p>}
    </div>
  );
}

// ==========================================
// BULK UPLOAD. Many pictures and documents at once. Each file goes to a piece of equipment (one of the equipment table's File
// or Image columns), becomes a new issue (an observation with its picture), or is added to an issue that already exists.
// Equipment is found by a search (or by the suggestion its file name gives); uploads run one at a time and each asks
// Dataverse for its own row only, never the whole table.
// ==========================================
const FileDocIcon = createIcon(<><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="13" y2="17" /></>);
const endSentence = (s) => { const t = String(s || '').trim(); return /[.!?]$/.test(t) ? t : `${t}.`; };
const BULK_SEARCH_TOP = 8;          // equipment (or issues) shown for one search
const BULK_SUGGEST_AT_ONCE = 2;     // file-name lookups running together
const BULK_PICTURE_COLUMN = /pic|photo|image|img/i;
const BULK_DOC_COLUMN = /sop|procedure|doc|manual|instruction/i;
const BULK_SPOT_SIZES = [{ key: 2, label: 'Small' }, { key: 4, label: 'Medium' }, { key: 8, label: 'Large' }]; // % of the map
// The columns a new issue is saved with (the picture and the equipment ids come on top, when the table has them)
const ISSUE_COLUMNS = ['craa5_mapx', 'craa5_mapy', 'craa5__boxwidth', 'craa5__boxheight', 'craa5__room', 'craa5__area', 'craa5__equipment',
  'craa5__description', 'craa5__whotonotify', 'craa5__customnote', 'craa5__facility'];
const BULK_TARGETS = [{ key: 'asset', label: 'Equipment' }, { key: 'newIssue', label: 'New issue' }, { key: 'issue', label: 'Existing issue' }];
// What to change after a refusal that would come again
const BULK_FATAL_HINT = {
  asset: 'Change the column, the equipment or the file to try again.',
  newIssue: 'Change the details or the file to try again.',
  issue: 'Pick another issue or another file to try again.'
};
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Words in a file name that never name equipment
const BULK_NOISE_WORDS = ['img', 'image', 'images', 'dsc', 'dscn', 'dcim', 'pxl', 'photo', 'photos', 'pic', 'pics', 'picture', 'pictures',
  'scan', 'scanned', 'screenshot', 'whatsapp', 'sop', 'sops', 'ssop', 'ssops', 'final', 'draft', 'copy', 'rev', 'ver', 'new', 'old', 'the', 'of', 'for',
  'mp', 'hdr', 'portrait', 'night', 'burst', 'wa', 'vid', 'mvimg', 'edited'];
// A phone's or camera's own name at the start (IMG_1234, IMG_E1234, PXL_20240105_101532123.MP, DSC01234, IMG-20240105-WA0001)
const BULK_CAMERA_NAME = /^\s*(img|pxl|dsc|dscn|dcim|vid|mvimg|fb_img|photo|image|screenshot|scan|signal)[-_ ]?[a-z]?\d[\w.-]*/i;

// A file name without its type and copy marks: "Mixer 7 (2).jpg" -> "Mixer 7"
const bulkStem = (fileName) => String(fileName || '').replace(/\.[^.]*$/, '').replace(/\s*\(\d+\)\s*$/, '').replace(/\s*-\s*copy\s*$/i, '').trim();

// "Mixer7_SOP (2).pdf" -> ['Mixer', '7']: the words of a file name that could be in an equipment name, room or area
function bulkNameWords(fileName) {
  // The camera's own name, version marks ("v2", "rev 3") and an SOP's number ("SOP 2", "sop3": it picks the SOP column, it
  // is not part of the equipment's name) go before letters and digits are split apart
  const stem = bulkStem(fileName).replace(BULK_CAMERA_NAME, ' ').replace(/(^|[^a-z0-9])(?:v|ver|rev)\s*\d+(?=$|[^a-z0-9])/gi, '$1 ')
    .replace(/(^|[^a-z0-9])s?sop[\s_\-#]*[0-9](?=$|[^0-9])/gi, '$1 ');
  const words = stem.replace(/([a-z])([0-9])/gi, '$1 $2').replace(/([0-9])([a-z])/gi, '$1 $2').split(/[^A-Za-z0-9]+/).filter(Boolean);
  const kept = words.filter(w => BULK_NOISE_WORDS.indexOf(w.toLowerCase()) === -1 && !/^\d{5,}$/.test(w) && !/^[a-z]$/i.test(w));
  // Only numbers left (20240101_101500) says nothing about the equipment
  if (!kept.some(w => /[a-z]/i.test(w))) return [];
  return kept.slice(0, 4);
}

// A first description for an issue from its file name ("leaking valve_mixer 7.jpg" -> "leaking valve mixer 7"); '' for camera names
function bulkDescriptionFrom(fileName) {
  const stem = bulkStem(fileName);
  if (BULK_CAMERA_NAME.test(stem) || !bulkNameWords(fileName).length) return '';
  return stem.replace(/[_]+/g, ' ').replace(/\s+/g, ' ').trim();
}

// Does the equipment hold every word as a whole number or the start of a word? ("3" is not in "Slicer 13", "mp" not in "Sump")
function bulkWordsFit(asset, words) {
  const text = ` ${asset.name} ${asset.room} ${asset.area} `.toLowerCase().replace(/([a-z])([0-9])/g, '$1 $2').replace(/([0-9])([a-z])/g, '$1 $2');
  return words.every(w => {
    const lw = String(w).toLowerCase().replace(/[^a-z0-9]/g, '');
    if (!lw) return true;
    return (/^\d+$/.test(lw) ? new RegExp(`(^|[^0-9])${lw}([^0-9]|$)`) : new RegExp(`(^|[^a-z])${lw}`)).test(text);
  });
}

// The picture column and the document column files go to unless the user picks another: a column picked on this device,
// else the expected one (Picture of Equipment / SSOP), else one named like it. '' = none.
function bulkPictureColumn(fields) {
  const picked = readColumnPick('assetPicture');
  const f = fields.filter(c => c.name === picked)[0];
  if (f) return f.name;
  const images = fields.filter(c => c.kind === 'image');
  const expected = images.filter(c => c.name === ASSET_PICTURE_COLUMN)[0];
  if (expected) return expected.name;
  const named = images.filter(c => BULK_PICTURE_COLUMN.test(`${c.name} ${c.label}`))[0] || images[0];
  if (named) return named.name;
  const pictureFile = fields.filter(c => c.kind === 'file' && BULK_PICTURE_COLUMN.test(`${c.name} ${c.label}`))[0];
  return pictureFile ? pictureFile.name : '';
}
function bulkDocColumn(fields) {
  const files = fields.filter(c => c.kind === 'file');
  const picked = files.filter(c => c.name === readColumnPick('assetDoc'))[0];
  if (picked) return picked.name;
  for (let i = 0; i < ASSET_DOC_COLUMNS.length; i += 1) {
    const expected = files.filter(c => c.name === ASSET_DOC_COLUMNS[i])[0];
    if (expected) return expected.name;
  }
  const docs = files.filter(c => !BULK_PICTURE_COLUMN.test(`${c.name} ${c.label}`));
  const sop = docs.filter(c => BULK_DOC_COLUMN.test(`${c.name} ${c.label}`))[0];
  if (sop) return sop.name;
  return docs.length === 1 ? docs[0].name : '';
}

// The column a file goes to until the user picks another. A document named "... SOP 2 ..." goes to the SOP 2 column and
// "... SSOP ..." to the SSOP column when the table has them; otherwise pictures to the picture column, documents to the SSOP.
function bulkDefaultColumn(fields, picture, fileName) {
  if (picture) return bulkPictureColumn(fields);
  const name = ` ${String(fileName || '').toLowerCase().replace(/[_.\-]+/g, ' ')} `;
  const files = fields.filter(c => c.kind === 'file');
  const textOf = (c) => `${c.name} ${c.label}`.toLowerCase();
  const num = /[^a-z]sop\s*([0-9])(?![0-9])/.exec(name);
  if (num) {
    const n = num[1];
    const f = files.filter(c => new RegExp(`(^|[^s])sop\\s*${n}(?![0-9])`).test(textOf(c)))[0];
    if (f) return f.name;
  }
  if (/ssop|sanitation/.test(name)) {
    const f = files.filter(c => /ssop/.test(textOf(c)))[0];
    if (f) return f.name;
  }
  return bulkDocColumn(fields);
}

// A piece of equipment from a search, with what it already holds in each upload column (when Dataverse said) and its map spot
function bulkAssetOf(row, uploadFields, mapColumn) {
  const current = {};
  uploadFields.forEach(f => {
    if (f.kind === 'file') {
      const name = f.nameColumn ? row[f.nameColumn] : undefined;
      if (row[f.name] !== undefined || name !== undefined) current[f.name] = { has: !!(row[f.name] || name), name: name || '' };
    } else if (f.stampColumn && row[f.stampColumn] !== undefined) {
      current[f.name] = { has: !!row[f.stampColumn], name: '' };
    }
  });
  return {
    id: cleanGuid(row[ASSET_ID_COLUMN]),
    name: String(row[ASSET_NAME_COLUMN] || '').trim() || '(no name)',
    room: row.craa5_roomname || '',
    area: row.craa5_areaname || '',
    location: mapColumn && row[mapColumn] !== undefined ? parseMapLocation(row[mapColumn]) : null,
    current
  };
}

// Equipment for a search: typed words (the equipment named exactly so first, then every one whose name, room or area holds
// all the words), an asset id, or a ready-made filter. At most BULK_SEARCH_TOP rows, with what each holds in the upload
// columns and its map spot; if Dataverse refuses those extra columns, once more without them.
async function searchBulkAssets(set, text, uploadFields, opts) {
  const o = opts || {};
  const trimmed = String(text || '').trim();
  const id = cleanGuid(trimmed);
  const base = [ASSET_ID_COLUMN, ASSET_NAME_COLUMN, 'craa5_roomname', 'craa5_areaname'];
  const extra = o.mapColumn ? [o.mapColumn] : [];
  uploadFields.forEach(f => {
    (f.kind === 'file' ? [f.name, f.nameColumn] : [f.stampColumn]).forEach(c => { if (c && extra.indexOf(c) === -1) extra.push(c); });
  });
  const query = async (filter) => {
    const ask = (cols) => getJson(`${set}?$select=${cols.join(',')}&$filter=${encodeURIComponent(filter)}&$orderby=${encodeURIComponent(`${ASSET_NAME_COLUMN} asc,${ASSET_ID_COLUMN}`)}&$top=${BULK_SEARCH_TOP}`);
    try {
      return (await ask(base.concat(extra))).value || [];
    } catch (e) {
      if (e.status !== 400 || !extra.length) throw e;
      return (await ask(base)).value || [];
    }
  };
  let rows;
  if (o.filter) rows = await query(o.filter);
  else if (GUID_PATTERN.test(id)) rows = await query(`${ASSET_ID_COLUMN} eq ${id}`);
  else {
    const words = assetWordFilter(trimmed.split(/\s+/).filter(Boolean).slice(0, 4)).join(' and ');
    if (!words) return [];
    // Sorted by name, "Conveyor 3" would come after "Conveyor 1023" and drop off the list: so the exact name is asked for too
