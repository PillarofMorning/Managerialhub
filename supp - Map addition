const RAIL_PAGE = 30;        // cards that roll in at a time as the user scrolls
const THUMB_SIZE = 80;       // px, square location / photo thumbnails
const THUMB_MAP_WIDTH = 480; // px the whole map is drawn at inside a location thumbnail

// Natural width/height of the map, so location thumbnails are cropped without squashing the picture
function useImageAspect(src) {
  const [aspect, setAspect] = useState(null);
  useEffect(() => {
    if (!src) { setAspect(null); return undefined; }
    let cancelled = false;
    const img = new Image();
    img.onload = () => { if (!cancelled && img.naturalHeight) setAspect(img.naturalWidth / img.naturalHeight); };
    img.src = src;
    return () => { cancelled = true; };
  }, [src]);
  return aspect;
}

// Crop of the facility map centred exactly on the reported box
function MapThumb({ item, mapImage, aspect }) {
  if (!mapImage || !aspect) {
    return <div className="w-20 h-20 shrink-0 bg-slate-200 rounded-lg border border-slate-300 flex items-center justify-center text-[10px] text-slate-400">N/A</div>;
  }
  const color = itemColor(item);
  const mapW = THUMB_MAP_WIDTH;
  const mapH = mapW / aspect;
  const boxW = Math.min(THUMB_SIZE, Math.max(8, (item.boxW / 100) * mapW));
  const boxH = Math.min(THUMB_SIZE, Math.max(8, (item.boxH / 100) * mapH));
  return (
    <div
      className="w-20 h-20 shrink-0 rounded-lg border border-slate-300 shadow-sm relative overflow-hidden bg-slate-200"
      title="Where this was reported"
      style={{
        backgroundImage: `url(${mapImage})`,
        backgroundRepeat: 'no-repeat',
        backgroundSize: `${mapW}px ${mapH}px`,
        backgroundPosition: `${THUMB_SIZE / 2 - (item.mapX / 100) * mapW}px ${THUMB_SIZE / 2 - (item.mapY / 100) * mapH}px`
      }}
    >
      <div
        className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 border-2 rounded-sm"
        style={{ width: boxW, height: boxH, borderColor: color, backgroundColor: `${color}33` }}
      />
    </div>
  );
}

function PhotoThumb({ item, label, onClick }) {
  const [missing, setMissing] = useState(false);
  const sources = pictureSources(item, true);
  const key = sources.join('|');
  useEffect(() => { setMissing(false); }, [key]);
  const handleMissing = useCallback(() => setMissing(true), []);
  if (sources.length === 0 || missing) return null;
  return (
    <button type="button" onClick={onClick} title="View photo" aria-label={`View photo for ${label}`} className="w-20 h-20 shrink-0 rounded-lg overflow-hidden border border-slate-300 shadow-sm bg-slate-100 hover:ring-2 hover:ring-[#0072CE] transition">
      <StoredImage sources={sources} alt="Observation" className="w-full h-full object-cover" onMissing={handleMissing} />
    </button>
  );
}

function RailCard({ item, mapImage, aspect, onLocate, onOpen, onEdit, onPickCategory, onSetClosed }) {
  const meta = categoryMeta(item.category);
  const place = [item.room, item.area].filter(Boolean).join(' / ');
  // Picking a category re-flows the list, so the second click of a double-click can land somewhere else (another card,
  // or the same card's text). Only a double-click whose two clicks were both on this card's body jumps to the map.
  const recentClicks = useRef([]);
  return (
    <article
      aria-label={`${categoryText(item)}: ${place || 'Unassigned location'}`}
      onClick={(e) => { const now = Date.now(); recentClicks.current = [...recentClicks.current.filter(c => now - c.at < 600), { at: now, onButton: !!e.target.closest('button') }]; }}
      onDoubleClick={(e) => { const last = recentClicks.current.slice(-2); if (!e.target.closest('button') && last.length === 2 && last.every(c => !c.onButton)) onLocate(item); }}
      title="Double-click to jump to this location on the map"
      className={`group rounded-xl border shadow-sm hover:shadow-md hover:border-[#0072CE]/40 transition-all flex flex-col sm:flex-row gap-3 p-3 sm:p-4 ${item.closed ? 'bg-slate-50 border-slate-200' : 'bg-white border-slate-200'}`}
      style={{ borderLeft: `4px solid ${itemColor(item)}` }}
      data-status={item.closed ? 'closed' : 'open'}
    >
      <div className="flex sm:flex-col gap-2 shrink-0">
        <MapThumb item={item} mapImage={mapImage} aspect={aspect} />
        <PhotoThumb item={item} label={place || 'this item'} onClick={() => onOpen(item)} />
      </div>

      <div className="flex-1 min-w-0">
        <div className="flex flex-wrap items-center gap-2 mb-1.5">
          <button
            type="button"
            onClick={() => onPickCategory(item.category)}
            title="Show only this category"
            className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold border max-w-full"
            style={{ color: meta.color, borderColor: `${meta.color}55`, backgroundColor: `${meta.color}14` }}
          >
            <span className="w-1.5 h-1.5 rounded-full shrink-0" style={{ backgroundColor: meta.color }} />
            <span className="truncate">{categoryText(item)}</span>
          </button>
          <StatusBadge item={item} />
          <time dateTime={item.submittedOn} className="text-xs text-slate-600" title={new Date(item.submittedOn).toLocaleString()}>
            {formatWhen(item.submittedOn)}
            {recentAgo(item.submittedOn) && <span className="text-slate-500"> - {recentAgo(item.submittedOn)}</span>}
          </time>
        </div>

        <h4 className={`font-semibold text-sm sm:text-base [overflow-wrap:anywhere] ${item.closed ? 'text-slate-500' : 'text-slate-800'}`}>{place || 'Unassigned location'}</h4>
        {item.equipmentList && item.equipmentList.length > 0 && (
          <ul className="mt-1 flex flex-wrap gap-1" aria-label="Equipment">
            {item.equipmentList.map((e, i) => (
              <li key={`${e.id || 'text'}-${i}`} className={`px-1.5 py-0.5 rounded text-[11px] font-semibold border [overflow-wrap:anywhere] ${e.id ? 'bg-[#E6F1FB] text-[#00468B] border-[#B3D4F2]' : 'bg-slate-100 text-slate-700 border-slate-200'}`}>{e.name}</li>
            ))}
          </ul>
        )}
        <p className="text-sm text-slate-600 mt-1 line-clamp-3 whitespace-pre-wrap break-words">{item.description}</p>

        <div className="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
          {item.whoToNotify && <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">Notify: <span className="font-medium text-slate-700">{item.whoToNotify}</span></span>}
          <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">By <span className="font-medium text-slate-700">{item.submittedBy}</span></span>
          {item.closed && <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">Closed (last change) {formatWhen(item.modifiedOn)}{item.modifiedBy ? ` by ${item.modifiedBy}` : ''}</span>}
        </div>

        <div className="mt-3 flex flex-wrap gap-2">
          <button type="button" onClick={() => onLocate(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#0072CE] text-white text-xs font-semibold hover:bg-[#00468B] shadow-sm">
            <MapPin className="w-3.5 h-3.5" /> Locate on map
          </button>
          <button type="button" onClick={() => onOpen(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white text-slate-700 border border-slate-300 text-xs font-semibold hover:bg-slate-100">
            <Maximize2 className="w-3.5 h-3.5" /> Details
          </button>
          <button type="button" onClick={() => onEdit(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white text-slate-700 border border-slate-300 text-xs font-semibold hover:bg-slate-100">
            <PencilIcon className="w-3.5 h-3.5" /> Edit
          </button>
          <CloseButton item={item} onSetClosed={onSetClosed} compact />
        </div>
      </div>
    </article>
  );
}

function TableTab({ submissions, timeFilteredCount, timeFilter, categoryBar, mapImage, logEvent, onLocate, onEdit, onSetClosed, liveItems }) {
  const [selectedItem, setSelectedItem] = useState(null);
  const [visibleCount, setVisibleCount] = useState(RAIL_PAGE);
  const scrollRef = useRef(null);
  const sentinelRef = useRef(null);
  const aspect = useImageAspect(mapImage);

  // Newest first (the shared search, status and category filters already narrowed `submissions`)
  const items = useMemo(() => submissions.slice().sort((a, b) => new Date(b.submittedOn) - new Date(a.submittedOn)), [submissions]);

  // Roll back to the top when the search, a filter or the timeframe changes - not when one item is closed, reopened
  // or edited in place, so someone working down the list keeps their place
  const filterKey = [categoryBar.query.trim().toLowerCase(), categoryBar.status, categoryBar.selected.join('|'), timeFilter].join('#');
  useEffect(() => {
    setVisibleCount(RAIL_PAGE);
    if (scrollRef.current) scrollRef.current.scrollTop = 0;
  }, [filterKey]);

  // Roll more cards in as the end of the list comes into view
  const hasMore = visibleCount < items.length;
  useEffect(() => {
    if (!hasMore) return undefined;
    if (typeof IntersectionObserver === 'undefined') { setVisibleCount(items.length); return undefined; }
    const node = sentinelRef.current;
    if (!node) return undefined;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some(entry => entry.isIntersecting)) setVisibleCount(count => count + RAIL_PAGE);
    }, { root: scrollRef.current, rootMargin: '400px 0px' });
    observer.observe(node);
    return () => observer.disconnect();
  }, [hasMore, visibleCount, items.length]);

  // Day groups: Today / Yesterday / 2-7 days ago / ...
  const groups = useMemo(() => {
    const out = [];
    items.slice(0, visibleCount).forEach(item => {
      const label = dayBucket(item.submittedOn);
      const last = out[out.length - 1];
      if (last && last.label === label) last.items.push(item);
      else out.push({ label, items: [item] });
    });
    return out;
  }, [items, visibleCount]);

  const locate = (item) => { logEvent(`Action rail: locating ${item.id} on the map`, 'info'); onLocate(item); };
  const open = (item) => { logEvent(`Action rail: opened details for ${item.id}`, 'info'); setSelectedItem(item); };
  const pickCategory = (key) => categoryBar.onOnly(key);
  const hasNarrowing = categoryBar.narrowed;

  return (
    <div className="h-full flex flex-col bg-slate-100">
      <div className="shrink-0 bg-white border-b border-slate-200 shadow-sm px-4 sm:px-6 py-4 space-y-3 z-10 [@media(max-height:520px)]:py-2 [@media(max-height:520px)]:space-y-1">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 className="text-xl font-black text-[#00468B] flex items-center gap-2">
              <TableIcon className="text-[#0072CE]" />
              Action Item Rail
            </h2>
            <p className="text-sm text-slate-600 mt-1 [@media(max-height:520px)]:hidden">Newest first. Scroll to roll through every item; double-click a card (or press Locate) to jump to it on the map.</p>
          </div>
          <SearchBox query={categoryBar.query} onQuery={categoryBar.onQuery} className="w-full sm:w-72" />
        </div>
        <CategoryFilterBar {...categoryBar} />
        <div role="status" className="text-xs text-slate-600">Showing <span className="font-bold text-slate-700">{items.length}</span> of {timeFilteredCount} loaded items in this timeframe</div>
        <LoadedNote loaded={categoryBar.loaded} query={categoryBar.query} showClosed={categoryBar.status !== 'open'} />
      </div>
      <div ref={scrollRef} className="flex-1 overflow-y-auto overflow-x-hidden">
        <div className="max-w-3xl mx-auto px-4 sm:px-6 pb-8">
          {groups.map(group => (
            <section key={group.label}>
              <h3 className="sticky top-0 z-10 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 bg-slate-100/95 backdrop-blur text-xs font-bold uppercase tracking-wider text-slate-600">{group.label}</h3>
              {/* The rail itself: a vertical spine with a category-coloured node per item */}
              <ol className="relative ml-3 border-l-2 border-slate-300 space-y-3 py-3 list-none">
                {group.items.map(item => (
                  <li key={item.id} className="relative pl-6">
                    <span
                      className="absolute -left-[9px] top-6 w-4 h-4 rounded-full border-2 border-white shadow"
                      style={{ backgroundColor: itemColor(item) }}
                      aria-hidden="true"
                    />
                    <RailCard item={item} mapImage={mapImage} aspect={aspect} onLocate={locate} onOpen={open} onEdit={onEdit} onPickCategory={pickCategory} onSetClosed={onSetClosed} />
                  </li>
                ))}
              </ol>
            </section>
          ))}

          {hasMore && <div ref={sentinelRef} className="py-6 text-center text-xs text-slate-500">Rolling in more items...</div>}
          {!hasMore && items.length > 0 && <div className="py-6 text-center text-xs text-slate-500">End of the rail - {items.length} item{items.length === 1 ? '' : 's'}{categoryBar.loaded && categoryBar.loaded.window.closedNext && categoryBar.status !== 'open' ? ' (older closed ones are not loaded yet)' : ''}</div>}

          {items.length === 0 && (
            <div className="text-center text-slate-500 py-16">
              {timeFilteredCount === 0 ? 'No data available for the selected timeframe.' : 'No action items match the current search or categories.'}
              {timeFilteredCount > 0 && hasNarrowing && (
                <div className="mt-2">
                  <button type="button" onClick={categoryBar.onClearAll} className="text-[#0072CE] underline hover:text-[#00468B]">Clear search and filters</button>
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      <DetailModal
        selectedItem={selectedItem && (liveItems[selectedItem.id] || selectedItem)}
        onClose={() => setSelectedItem(null)}
        onEdit={(item) => { setSelectedItem(null); onEdit(item); }}
        onSetClosed={onSetClosed}
      />
    </div>
  );
}

// =======================================================================
// ASSETS TAB: equipment on the map (smart snap) and an editor for every column of the equipment table (craa5_aa_assets)
// =======================================================================
const ASSET_LOGICAL_NAME = 'craa5_aa_assets';
const ASSET_ID_COLUMN = 'craa5_aa_assetsid';
const ASSET_NAME_COLUMN = 'craa5_equipmentidentifier';
// The text column that keeps an asset's spot on the map. null = found by its name ("Map Location", craa5_maplocation).
const ASSET_MAP_COLUMN = null;
const ASSET_MAP_HINT = /map.?(loc|pos|pin|point|spot|xy|coord)/i;
// Columns the app expects on Assets (Gerald's table, Oct 9). If Dataverse's column list leaves one out, a one-row read
// still finds it; a missing one can be swapped for another column on this device, or created and checked again.
const ASSET_PICTURE_COLUMN = 'craa5_pictureofequipment';                       // Image
const ASSET_DOC_COLUMNS = ['craa5_ssop', 'craa5_sop1', 'craa5_sop2', 'craa5_sop3']; // File (the SSOP first)
// Text columns that already hold something the apps read (name, room, area, codes): never offered as the map spot column
const ASSET_MAP_NOT_THESE = ['craa5_equipmentidentifier', 'craa5_roomname', 'craa5_areaname', 'craa5_workareacode', 'craa5_departmentcode', 'craa5_subcategory'];
const ASSET_KNOWN_LABELS = { craa5_pictureofequipment: 'Picture of Equipment', craa5_ssop: 'SSOP', craa5_sop1: 'SOP 1', craa5_sop2: 'SOP 2', craa5_sop3: 'SOP 3', craa5_maplocation: 'Map Location' };
const ASSET_LIST_PAGE = 50;      // rows per page in the asset list ("Show more" asks for the next page)
const ASSET_PIN_PAGE = 500;      // placed assets per request when the map is drawn
const ASSET_PIN_MAX = 5000;      // stop there and say so
const FILE_SINGLE_UPLOAD_MAX = 128 * 1024 * 1024; // the most Dataverse takes in one upload request
const SNAP_PREF = 'stillwell.assets.smartSnap';
const ANNOTATIONS = { Prefer: 'odata.include-annotations="*"' };
// Microsoft's advice for Web API reads: never answer them from the browser cache
const NO_CACHE = { 'If-None-Match': 'null' };

const metaLabel = (l) => {
  if (!l) return '';
  if (l.UserLocalizedLabel && l.UserLocalizedLabel.Label) return l.UserLocalizedLabel.Label;
  if (l.LocalizedLabels && l.LocalizedLabels.length && l.LocalizedLabels[0].Label) return l.LocalizedLabels[0].Label;
  return '';
};

const getJson = async (path, headers) => {
  const res = await fetch(apiUrl(path), { headers: { ...ODATA_HEADERS, ...NO_CACHE, ...(headers || {}) } });
  if (!res.ok) {
    const err = new Error(await readApiError(res));
    err.status = res.status;
    throw err;
  }
  return res.json();
};

const formatted = (row, key) => (row ? row[`${key}@OData.Community.Display.V1.FormattedValue`] : undefined);

// --- WHICH COLUMNS THE EDITOR SHOWS, AND HOW ---
// AttributeTypeName first (it tells File, Image and multi-select choices apart; all three are "Virtual"), then AttributeType
const ASSET_KIND_BY_TYPENAME = {
  StringType: 'text', MemoType: 'memo', IntegerType: 'int', BigIntType: 'int', DecimalType: 'number', DoubleType: 'number', MoneyType: 'number',
  BooleanType: 'bool', PicklistType: 'choice', MultiSelectPicklistType: 'choices', DateTimeType: 'date', LookupType: 'lookup',
  CustomerType: 'fixedlookup', OwnerType: 'fixedlookup', FileType: 'file', ImageType: 'image', StateType: 'status', StatusType: 'status', UniqueidentifierType: 'id'
};
const ASSET_KIND_BY_TYPE = {
  String: 'text', Memo: 'memo', Integer: 'int', BigInt: 'int', Decimal: 'number', Double: 'number', Money: 'number', Boolean: 'bool',
  Picklist: 'choice', DateTime: 'date', Lookup: 'lookup', Customer: 'fixedlookup', Owner: 'fixedlookup', State: 'status', Status: 'status', Uniqueidentifier: 'id'
};
// Bookkeeping columns nobody needs to see
const ASSET_HIDDEN_COLUMNS = ['versionnumber', 'importsequencenumber', 'overriddencreatedon', 'timezoneruleversionnumber', 'utcconversiontimezonecode',
  'owningbusinessunit', 'owninguser', 'owningteam', 'createdonbehalfby', 'modifiedonbehalfby'];
// Shown read-only under "Record info"
const ASSET_INFO_COLUMNS = ['createdon', 'createdby', 'modifiedon', 'modifiedby', 'ownerid', 'statecode', 'statuscode'];
// Sections of the editor, in this order. Known columns keep this order; other columns follow by name.
const ASSET_GROUPS = [
  { key: 'main', title: 'Equipment', names: ['craa5_equipmentidentifier', 'craa5_roomname', 'craa5_areaname', 'craa5_area_lookup', 'craa5_subcategory', 'craa5_uniqueid', 'craa5_departmentcode', 'craa5_workareacode', 'craa5_esequipment'] },
  { key: 'freq', title: 'Cleaning frequency and time', names: ['craa5_dailyclean', 'craa5_midweek', 'craa5_weeklyclean', 'craa5_monthlyclean', 'craa5_month', 'craa5_quarterly', 'craa5_annually', 'craa5_dailyweekly', 'craa5_hoursrequired', 'craa5_minalrg', 'craa5_dailymin', 'craa5_heads', 'craa5_lastcleaneddate', 'craa5_timetocleanaveragefromlog', 'craa5_cleanorder', 'craa5_priority', 'craa5_bundle'], hint: /clean|freq|daily|weekly|monthly|quarter|annual|midweek|minute|hours/i },
  { key: 'docs', title: 'Pictures and documents', kinds: ['file', 'image'] },
  { key: 'other', title: 'Other columns' }
];

// Extra details per column type. Each is its own request, so one that fails only loses that detail.
const ASSET_TYPED_QUERIES = [
  { cast: 'StringAttributeMetadata', q: '$select=LogicalName,MaxLength,FormatName', apply: (f, a) => { f.maxLength = a.MaxLength || null; f.format = a.FormatName && a.FormatName.Value ? a.FormatName.Value : ''; } },
  { cast: 'MemoAttributeMetadata', q: '$select=LogicalName,MaxLength', apply: (f, a) => { f.maxLength = a.MaxLength || null; } },
  { cast: 'IntegerAttributeMetadata', q: '$select=LogicalName,MinValue,MaxValue', apply: (f, a) => { f.min = a.MinValue; f.max = a.MaxValue; } },
  { cast: 'DecimalAttributeMetadata', q: '$select=LogicalName,MinValue,MaxValue,Precision', apply: (f, a) => { f.min = a.MinValue; f.max = a.MaxValue; f.precision = a.Precision; } },
  { cast: 'DoubleAttributeMetadata', q: '$select=LogicalName,MinValue,MaxValue,Precision', apply: (f, a) => { f.min = a.MinValue; f.max = a.MaxValue; f.precision = a.Precision; } },
  { cast: 'BooleanAttributeMetadata', q: '$select=LogicalName&$expand=OptionSet($select=TrueOption,FalseOption)', apply: (f, a) => {
    const os = a.OptionSet || {};
    f.trueLabel = metaLabel(os.TrueOption && os.TrueOption.Label) || 'Yes';
    f.falseLabel = metaLabel(os.FalseOption && os.FalseOption.Label) || 'No';
  } },
  { cast: 'PicklistAttributeMetadata', q: '$select=LogicalName&$expand=OptionSet($select=Options),GlobalOptionSet($select=Options)', apply: (f, a) => { f.options = optionList(a); } },
  { cast: 'MultiSelectPicklistAttributeMetadata', q: '$select=LogicalName&$expand=OptionSet($select=Options),GlobalOptionSet($select=Options)', apply: (f, a) => { f.options = optionList(a); } },
  { cast: 'DateTimeAttributeMetadata', q: '$select=LogicalName,Format,DateTimeBehavior', apply: (f, a) => {
    f.behavior = a.DateTimeBehavior && a.DateTimeBehavior.Value ? a.DateTimeBehavior.Value : 'UserLocal';
    f.dateOnly = a.Format === 'DateOnly' || f.behavior === 'DateOnly';
  } },
  { cast: 'LookupAttributeMetadata', q: '$select=LogicalName,Targets', apply: (f, a) => { f.targets = a.Targets || []; } },
  { cast: 'FileAttributeMetadata', q: '$select=LogicalName,MaxSizeInKB', apply: (f, a) => { f.maxKB = a.MaxSizeInKB || null; } },
  { cast: 'ImageAttributeMetadata', q: '$select=LogicalName,MaxSizeInKB,CanStoreFullImage', apply: (f, a) => { f.maxKB = a.MaxSizeInKB || null; f.fullImage = a.CanStoreFullImage !== false; } }
];

function optionList(a) {
  const set = (a.OptionSet && a.OptionSet.Options && a.OptionSet.Options.length) ? a.OptionSet : a.GlobalOptionSet;
  return ((set && set.Options) || []).map(o => ({ value: o.Value, label: metaLabel(o.Label) || String(o.Value) }));
}

const ATTRIBUTE_SELECT = 'LogicalName,AttributeType,AttributeTypeName,DisplayName,Description,RequiredLevel,IsValidForCreate,IsValidForUpdate,IsValidForRead,IsValidODataAttribute,AttributeOf,IsPrimaryId,IsPrimaryName,IsCustomAttribute';

// Everything the Assets tab needs to know about the table, read once.
// Result: { ready, error, entitySet, fields, mapColumn: { name, maxLength } | null, mapReason, warnings }
async function loadAssetMetadata(logEvent) {
  const def = `EntityDefinitions(LogicalName='${ASSET_LOGICAL_NAME}')`;
  let entity;
  let attributes;
  try {
    entity = await getJson(`${def}?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute&$expand=Attributes($select=${ATTRIBUTE_SELECT})`);
    if (!entity.LogicalName && entity.value && entity.value[0]) entity = entity.value[0];
    attributes = entity.Attributes || [];
  } catch (error) {
    // Some setups refuse the expand: ask for the table and its columns separately
    logEvent(`Asset table metadata (with columns) failed: ${error.message}. Trying the columns on their own.`, 'warn');
    entity = await getJson(`${def}?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute`);
    if (!entity.LogicalName && entity.value && entity.value[0]) entity = entity.value[0];
    attributes = (await getJson(`${def}/Attributes?$select=${ATTRIBUTE_SELECT}`)).value || [];
  }

  const kindOf = (a) => {
    const typeName = a.AttributeTypeName && a.AttributeTypeName.Value ? a.AttributeTypeName.Value : '';
    return ASSET_KIND_BY_TYPENAME[typeName] || ASSET_KIND_BY_TYPE[a.AttributeType] || null;
  };
  const readable = {};
  attributes.forEach(a => { if (a && a.LogicalName && a.IsValidForRead !== false && a.IsValidODataAttribute !== false) readable[a.LogicalName] = a; });
  // File and Image columns count even when Dataverse lists them as part of another column (an Image column can name its
  // own id column as AttributeOf, which hid "Picture of Equipment" before). Their helper columns never show on their own:
  // a file's _name, a picture's id, _url and _timestamp.
  const uploadKinds = {};
  Object.keys(readable).forEach(n => { const k = kindOf(readable[n]); if (k === 'file' || k === 'image') uploadKinds[n] = k; });
  const companions = {};
  Object.keys(readable).forEach(n => { if (readable[n].AttributeOf && !uploadKinds[n]) companions[n] = true; });
  const helperSuffixes = (kind) => (kind === 'image' ? ['id', '_url', '_timestamp'] : ['_name']);
  Object.keys(uploadKinds).forEach(n => { helperSuffixes(uploadKinds[n]).forEach(sfx => { if (readable[n + sfx] && !uploadKinds[n + sfx]) companions[n + sfx] = true; }); });

  const fields = [];
  const byName = {};
  attributes.forEach(a => {
    // Companion columns (file names, lookup names) and columns the Web API does not expose are left out
    if (!a || !a.LogicalName || !readable[a.LogicalName] || companions[a.LogicalName]) return;
    if (ASSET_HIDDEN_COLUMNS.indexOf(a.LogicalName) !== -1) return;
    const kind = kindOf(a);
    if (!kind) return;
    // Dataverse reports File columns as not valid for create or update, because their bytes never go in a row save: they
    // take an upload of their own once the row exists. So File and Image columns always offer Upload, and Dataverse
    // checks the user's rights when the upload is sent.
    const upload = kind === 'file' || kind === 'image';
    if (a.AttributeOf && !upload) return;
    const required = a.RequiredLevel && (a.RequiredLevel.Value === 'ApplicationRequired' || a.RequiredLevel.Value === 'SystemRequired');
    const field = {
      name: a.LogicalName,
      label: metaLabel(a.DisplayName) || ASSET_KNOWN_LABELS[a.LogicalName] || a.LogicalName,
      description: metaLabel(a.Description),
      kind,
      required: !!required && kind !== 'id' && kind !== 'status',
      canCreate: upload ? false : a.IsValidForCreate !== false,
      canUpdate: upload ? true : a.IsValidForUpdate !== false,
      isPrimaryName: !!a.IsPrimaryName || a.LogicalName === (entity.PrimaryNameAttribute || ASSET_NAME_COLUMN),
      isPrimaryId: !!a.IsPrimaryId || a.LogicalName === (entity.PrimaryIdAttribute || ASSET_ID_COLUMN),
      info: ASSET_INFO_COLUMNS.indexOf(a.LogicalName) !== -1
    };
    if (field.kind === 'bool') { field.trueLabel = 'Yes'; field.falseLabel = 'No'; }
    // The table asks for these instead of the file itself: the file's name, the picture's time stamp
    if (field.kind === 'file' && readable[`${field.name}_name`]) field.nameColumn = `${field.name}_name`;
    if (field.kind === 'image' && readable[`${field.name}_timestamp`]) field.stampColumn = `${field.name}_timestamp`;
    fields.push(field);
    byName[field.name] = field;
  });

  // A one-row read shows what the table really has (an Image column brings <name>_url and <name>_timestamp, a File column
  // <name>_name): picture and file columns the list left out are added from it
  const set = entity.EntitySetName || ASSET_SET;
  const probe = await probeAssetRowColumns(set);
  if (probe.error) logEvent(`The one-row column check of the Assets table failed: ${probe.error}`, 'warn');
  const added = inferUploadColumns(probe.keys, byName, readable);
  added.forEach(f => { fields.push(f); byName[f.name] = f; });
  if (added.length) {
    // Their helper columns must not show as columns of their own
    const helpers = {};
    added.forEach(f => { helperSuffixes(f.kind).forEach(sfx => { helpers[f.name + sfx] = true; }); });
    for (let i = fields.length - 1; i >= 0; i -= 1) if (helpers[fields[i].name]) { delete byName[fields[i].name]; fields.splice(i, 1); }
    logEvent(`Found ${added.length} picture or file column${added.length === 1 ? '' : 's'} on Assets from a one-row read: ${added.map(f => f.name).join(', ')}.`, 'info');
  }

  const warnings = [];
  await Promise.all(ASSET_TYPED_QUERIES.map(async (t) => {
    try {
      const list = (await getJson(`${def}/Attributes/Microsoft.Dynamics.CRM.${t.cast}?${t.q}`)).value || [];
      list.forEach(a => { if (a && byName[a.LogicalName]) t.apply(byName[a.LogicalName], a); });
    } catch (error) {
      warnings.push(`${t.cast}: ${error.message}`);
    }
  }));
  // Lookups are written through their navigation property ("Area_Lookup@odata.bind"), which only the relationships know
  try {
    const rels = (await getJson(`${def}/ManyToOneRelationships?$select=ReferencingAttribute,ReferencingEntityNavigationPropertyName,ReferencedEntity`)).value || [];
    rels.forEach(r => {
      const f = byName[r.ReferencingAttribute];
      if (f && f.kind === 'lookup' && !f.nav) { f.nav = r.ReferencingEntityNavigationPropertyName; if (!f.targets || !f.targets.length) f.targets = [r.ReferencedEntity]; }
    });
  } catch (error) {
    warnings.push(`relationships: ${error.message}`);
  }
  if (warnings.length) logEvent(`Some asset column details could not be read; those columns are shown read-only or plainer.`, 'warn', { warnings });

  // The map spot column
  const textFields = fields.filter(f => f.kind === 'text' || f.kind === 'memo');
  let mapField = null;
  let mapReason = '';
  const mapPick = readColumnPick('assetMap');
  if (mapPick && byName[mapPick] && (byName[mapPick].kind === 'text' || byName[mapPick].kind === 'memo')) {
    mapField = byName[mapPick];
    logEvent(`Map spots go in ${mapPick} (picked on this device).`, 'info');
  } else if (ASSET_MAP_COLUMN) {
    mapField = byName[ASSET_MAP_COLUMN] || null;
    if (!mapField) mapReason = `ASSET_MAP_COLUMN "${ASSET_MAP_COLUMN}" is not a text column of the Assets table.`;
  } else {
    const candidates = textFields.filter(f => f.name === 'craa5_maplocation' || ASSET_MAP_HINT.test(f.name) || /map\s*location/i.test(f.label));
    candidates.sort((a, b) => (b.name === 'craa5_maplocation' ? 1 : 0) - (a.name === 'craa5_maplocation' ? 1 : 0) || (b.maxLength || 0) - (a.maxLength || 0));
    mapField = candidates[0] || null;
    if (candidates.length > 1) logEvent(`Several map columns found on Assets (${candidates.map(c => c.name).join(', ')}). Using ${mapField.name}. Set ASSET_MAP_COLUMN at the top of the assets section to choose another.`, 'warn');
    if (!mapField) mapReason = 'the Assets table has no column for map spots yet. Add a "Single line of text" column named "Map Location" (100 characters is enough) and press Check again, or pick a text column below.';
  }
  if (mapField && !mapField.canUpdate) { mapReason = `the column ${mapField.name} cannot be written.`; mapField = null; }
  logEvent(`Asset table: ${fields.length} columns; map spots ${mapField ? `in ${mapField.name}` : 'not available'}.`, mapField ? 'info' : 'warn');
  const missing = expectedAssetColumns(byName).filter(c => !c.found);
  if (missing.length) logEvent(`Expected Assets columns not found: ${missing.map(c => `${c.name} (${c.kind})`).join(', ')}.`, 'warn');

  return {
    ready: true,
    error: '',
    entitySet: set,
    fields,
    mapColumn: mapField ? { name: mapField.name, maxLength: mapField.maxLength || null } : null,
    mapPicked: !!(mapField && mapPick && mapField.name === mapPick),
    mapReason,
    warnings
  };
}

// Reads one asset row with every column, only for the names of its keys (Gerald's own read showed the picture's
// _url / _timestamp and each file's _name). { keys: [] | null, error }
async function probeAssetRowColumns(set) {
  try {
    const rows = (await getJson(`${set}?$top=1`)).value || [];
    return { keys: rows[0] ? Object.keys(rows[0]).filter(k => k.indexOf('@') === -1) : null, error: '' };
  } catch (error) {
    return { keys: null, error: error.message };
  }
}

// Picture and file columns a row's keys show that the column list did not give. `known` = fields by name, `listed` = every
// column Dataverse listed (a column listed as something else is left alone).
function inferUploadColumns(keys, known, listed) {
  if (!keys) return [];
  const has = {};
  keys.forEach(k => { has[k] = true; });
  const out = [];
  const taken = {};
  keys.forEach(k => {
    let name = '';
    let kind = '';
    if (/_timestamp$/.test(k) && has[k.replace(/_timestamp$/, '_url')]) { name = k.replace(/_timestamp$/, ''); kind = 'image'; }
    else if (/_name$/.test(k) && k.charAt(0) !== '_' && has[k.replace(/_name$/, '')]) { name = k.replace(/_name$/, ''); kind = 'file'; }
    if (!name || taken[name] || known[name]) return;
    const l = listed && listed[name];
    if (l && !(l.AttributeTypeName && /^(FileType|ImageType)$/.test(l.AttributeTypeName.Value || ''))) return;
    taken[name] = true;
    const f = {
      name,
      label: ASSET_KNOWN_LABELS[name] || name,
      description: 'Found from a one-row read of the table',
      kind,
      required: false,
      canCreate: false,
      canUpdate: true,
      isPrimaryName: false,
      isPrimaryId: false,
      info: false,
      inferred: true
    };
    if (kind === 'file') f.nameColumn = `${name}_name`;
    if (kind === 'image') f.stampColumn = `${name}_timestamp`;
    out.push(f);
  });
  return out;
}

// The columns this app expects on Assets, and whether the table has each: [{ role, name, label, kind, found }]
function expectedAssetColumns(byName) {
  const one = (role, name, kind) => ({ role, name, label: ASSET_KNOWN_LABELS[name] || name, kind, found: !!(byName[name] && byName[name].kind === kind) });
  return [one('picture', ASSET_PICTURE_COLUMN, 'image')].concat(ASSET_DOC_COLUMNS.map(n => one('doc', n, 'file')));
}

// --- ASSET ROWS ---
const assetListSelect = (mapColumn) => [ASSET_ID_COLUMN, ASSET_NAME_COLUMN, 'craa5_roomname', 'craa5_areaname', 'modifiedon'].concat(mapColumn ? [mapColumn] : []).join(',');

const toAssetSummary = (row, mapColumn) => ({
  ...toAsset(row),
  modifiedOn: row.modifiedon || '',
  location: mapColumn ? parseMapLocation(row[mapColumn]) : null
});

const assetWordFilter = (words) => words.map(w => `(contains(craa5_equipmentidentifier,'${escLike(w)}') or contains(craa5_roomname,'${escLike(w)}') or contains(craa5_areaname,'${escLike(w)}'))`);

// The filter and order of an asset list (the map's list and the equipment table). `sort` = { name, desc } from a column header.
function assetListQuery({ words, room, placement, mapColumn, orderById, sort }) {
  const parts = assetWordFilter(words || []);
  if (room) parts.push(`craa5_roomname eq '${escOData(room)}'`);
  if (mapColumn && placement === 'placed') parts.push(`${mapColumn} ne null`);
  if (mapColumn && placement === 'unplaced') parts.push(`${mapColumn} eq null`);
  // Nothing searched yet: the latest changed first. The id last, so paging never repeats or skips a row.
  let first = '';
  if (sort) first = `${sort.name} ${sort.desc ? 'desc' : 'asc'}`;
  else if (!orderById) first = (words || []).length === 0 && !room ? 'modifiedon desc' : `${ASSET_NAME_COLUMN} asc`;
  return { filter: parts.join(' and '), order: first ? `${first},${ASSET_ID_COLUMN}` : ASSET_ID_COLUMN };
}

// One page of assets. `next` is the previous page's @odata.nextLink (an absolute URL), else a new query.
// Never the whole table: Dataverse sends `pageSize` rows at a time.
async function fetchAssetPage({ set, words, room, placement, mapColumn, next, pageSize, orderById }) {
  let url = next;
  if (!url) {
    const q = assetListQuery({ words, room, placement, mapColumn, orderById });
    url = apiUrl(`${set}?$select=${assetListSelect(mapColumn)}${q.filter ? `&$filter=${encodeURIComponent(q.filter)}` : ''}&$orderby=${encodeURIComponent(q.order)}`);
  }
  // The same page size on every page (a nextLink is fetched exactly as Dataverse gave it)
  const res = await fetch(url, { headers: { ...ODATA_HEADERS, ...NO_CACHE, Prefer: `odata.maxpagesize=${pageSize || ASSET_LIST_PAGE}` } });
  if (!res.ok) throw new Error(await readApiError(res));
  const data = await res.json();
  return {
    rows: (data.value || []).map(r => toAssetSummary(r, mapColumn)).filter(a => GUID_PATTERN.test(a.id)),
    next: data['@odata.nextLink'] || null
  };
}

// Every asset that has a map spot (name, room, area and the spot only), page by page up to ASSET_PIN_MAX
async function loadAssetPins(set, mapColumn, logEvent) {
  let rows = [];
  let next = null;
  let pages = 0;
  do {
    const page = await fetchAssetPage({ set, words: [], room: '', placement: 'placed', mapColumn, next, pageSize: ASSET_PIN_PAGE, orderById: true });
    rows = rows.concat(page.rows.filter(r => r.location));
    next = page.next;
    pages += 1;
  } while (next && rows.length < ASSET_PIN_MAX && pages < 50);
  const capped = !!next;
  if (capped) logEvent(`Only the first ${rows.length} placed assets are drawn on the map (more exist).`, 'warn');
  logEvent(`Loaded ${rows.length} assets that have a map spot.`, 'info');
  return { rows: rows.slice(0, ASSET_PIN_MAX), capped };
}

// Distinct room names (Dataverse groups them; the rows themselves are not loaded)
async function loadAssetRooms(set) {
  const data = await getJson(`${set}?$apply=groupby((craa5_roomname))`);
  const seen = {};
  return (data.value || []).map(r => (r.craa5_roomname || '').trim()).filter(r => r && !seen[r] && (seen[r] = true)).sort((a, b) => a.localeCompare(b));
}

// All columns of one asset. Image columns are left out of an all-columns read, so they are asked for by name (the
// 144 px thumbnail, small) to tell whether a picture is stored.
async function loadAssetRow(set, id, imageColumns) {
  const row = await getJson(`${set}(${id})`, ANNOTATIONS);
  if (imageColumns && imageColumns.length) {
    try {
      const extra = await getJson(`${set}(${id})?$select=${imageColumns.join(',')}`);
      imageColumns.forEach(c => { if (extra[c] !== undefined) row[c] = extra[c]; });
    } catch (e) { /* the picture shows as "not known"; the rest still works */ }
  }
  return row;
}

// PATCH some columns of one asset. `etag` guards against overwriting someone else's change (HTTP 412); '*' = just "it must exist".
async function patchAsset(set, id, payload, etag, logEvent) {
  const path = `${set}(${id})`;
  logEvent(`PATCH asset ${id}`, 'data', payload, { method: 'PATCH', path, contentType: 'application/json' });
  const res = await fetch(apiUrl(path), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json', 'If-Match': etag || '*', Prefer: 'return=representation,odata.include-annotations="*"' },
    body: JSON.stringify(payload)
  });
  if (res.status === 412) {
    const err = new Error('someone else changed this asset after you opened it');
    err.stale = true;
    throw err;
  }
  if (res.status === 404) throw new Error('this asset no longer exists in Dataverse (HTTP 404)');
  if (!res.ok) throw new Error(await readApiError(res));
  if (res.status === 200) {
    try { return await res.json(); } catch (e) { /* no body: read it again below */ }
  }
  return loadAssetRow(set, id);
}

async function createAsset(set, payload, logEvent) {
  logEvent(`POST new asset`, 'data', payload, { method: 'POST', path: set, contentType: 'application/json' });
  const res = await fetch(apiUrl(set), {
    method: 'POST',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json', Prefer: 'return=representation,odata.include-annotations="*"' },
    body: JSON.stringify(payload)
  });
  if (!res.ok) throw new Error(await readApiError(res));
  if (res.status === 201 || res.status === 200) {
    try {
      const row = await res.json();
      if (row && row[ASSET_ID_COLUMN]) return row;
    } catch (e) { /* no body */ }
  }
  const header = res.headers.get('OData-EntityId') || '';
  const match = header.match(/\(([0-9a-fA-F-]{36})\)/);
  if (!match) throw new Error('Dataverse did not return the new asset id.');
  return loadAssetRow(set, match[1]);
}

// File and Image columns take the bytes in their own request (up to 128 MB at once)
// The x-ms-file-name header only takes plain ASCII
const headerFileName = (name) => (String(name || 'file').replace(/[^\x20-\x7E]/g, '_').replace(/["\\]/g, '_').trim() || 'file');
const FILE_BLOCK_SIZE = 4 * 1024 * 1024; // the most one UploadBlock takes

// The part after "base64," of a piece of a file
const blobToBase64 = (blob) => new Promise((resolve, reject) => {
  const reader = new FileReader();
  reader.onload = () => { const s = String(reader.result || ''); resolve(s.slice(s.indexOf(',') + 1)); };
  reader.onerror = () => reject(new Error('the file could not be read'));
  reader.readAsDataURL(blob);
});

async function postDataverseMessage(name, payload) {
  const res = await fetch(apiUrl(name), {
    method: 'POST',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json; charset=utf-8' },
    body: JSON.stringify(payload)
  });
  if (!res.ok) {
    const err = new Error(await readApiError(res));
    err.status = res.status;
    throw err;
  }
  if (res.status === 204) return {};
  try { return await res.json(); } catch (e) { return {}; }
}

// Dataverse's other way in, which works for File and Image columns of any size: start, send 4 MB parts, commit
async function uploadAssetFileInBlocks(id, column, blob, fileName, mimeType, onProgress) {
  const started = await postDataverseMessage('InitializeFileBlocksUpload', {
    Target: { [ASSET_ID_COLUMN]: id, '@odata.type': `Microsoft.Dynamics.CRM.${ASSET_LOGICAL_NAME}` },
    FileAttributeName: column,
    FileName: fileName
  });
  const token = started.FileContinuationToken;
  if (!token) throw new Error('Dataverse did not start the upload');
  const parts = Math.max(1, Math.ceil(blob.size / FILE_BLOCK_SIZE));
  const blockIds = [];
  for (let n = 0; n < parts; n += 1) {
    // Every block id of one upload has the same length
    const blockId = btoa(`block-${(`00000${n}`).slice(-6)}`);
    const data = await blobToBase64(blob.slice(n * FILE_BLOCK_SIZE, (n + 1) * FILE_BLOCK_SIZE));
    await postDataverseMessage('UploadBlock', { BlockId: blockId, BlockData: data, FileContinuationToken: token });
    blockIds.push(blockId);
    if (onProgress) onProgress((n + 1) / parts);
  }
  await postDataverseMessage('CommitFileBlocksUpload', { FileName: fileName, MimeType: mimeType || 'application/octet-stream', BlockList: blockIds, FileContinuationToken: token });
}

// Answers the other way in would only repeat: signed out, no right to change the row, the row is gone, too many requests,
// or the file is too big for the column
const FINAL_UPLOAD_STATUSES = [401, 403, 404, 429];
const TOO_BIG_ANSWER = /0x80044a02|file size|too big|exceeds the maximum size/i;
const plainUploadError = (err) => {
  if (err.status === 403) err.message = `you do not have permission to change this equipment's files in Dataverse (${err.message})`;
  return err;
};

// One PATCH with the whole file first. If that is refused (or the file is over 128 MB), the same file goes again in parts.
// Resolves { route: 'single' | 'blocks', fileName, bytes }; a failure says what both ways answered.
async function uploadAssetFile(set, id, column, body, rawName, logEvent, opts) {
  const o = opts || {};
  // The x-ms-file-name header only takes plain ASCII; the block messages carry the name as it is
  const realName = String(rawName || 'file').replace(/[\x00-\x1F]/g, '').trim() || 'file';
  const fileName = headerFileName(realName);
  const blob = body instanceof Blob ? body : new Blob([body]);
  const mimeType = o.mimeType || blob.type || 'application/octet-stream';
  const path = `${set}(${id})/${column}`;
  const sent = { column, id, fileName, bytes: blob.size, mimeType };
  let first = null;
  if (blob.size <= FILE_SINGLE_UPLOAD_MAX) {
    logEvent(`Uploading "${fileName}" to ${column} of asset ${id}`, 'data', sent, { method: 'PATCH', path, contentType: 'application/octet-stream' });
    try {
      const res = await fetch(apiUrl(path), {
        method: 'PATCH',
        headers: { ...ODATA_HEADERS, 'Content-Type': 'application/octet-stream', 'x-ms-file-name': fileName },
        body: blob
      });
      if (res.ok) return { route: 'single', fileName, bytes: blob.size };
      first = new Error(await readApiError(res));
      first.status = res.status;
    } catch (e) {
      first = e;
    }
    if (FINAL_UPLOAD_STATUSES.indexOf(first.status) !== -1 || TOO_BIG_ANSWER.test(first.message || '')) throw plainUploadError(first);
    logEvent(`The one-request upload of "${fileName}" was refused (${first.message}). Sending it in parts instead.`, 'warn');
  }
  const parts = Math.max(1, Math.ceil(blob.size / FILE_BLOCK_SIZE));
  logEvent(`Uploading "${realName}" to ${column} of asset ${id} in ${parts} part${parts === 1 ? '' : 's'}`, 'data', { ...sent, fileName: realName, parts },
    { method: 'POST', path: 'InitializeFileBlocksUpload, UploadBlock, CommitFileBlocksUpload', contentType: 'application/json' });
  try {
    await uploadAssetFileInBlocks(id, column, blob, realName, mimeType, o.onProgress);
    return { route: 'blocks', fileName: realName, bytes: blob.size };
  } catch (e) {
    if (!first || e.message === first.message) throw plainUploadError(e);
    const both = new Error(`${first.message}. Sending it in parts failed too: ${e.message}`);
    both.status = e.status;
    throw plainUploadError(both);
  }
}

const formatBytes = (n) => (n >= 1024 * 1024 ? `${(n / (1024 * 1024)).toFixed(1)} MB` : `${Math.max(1, Math.ceil(n / 1024))} KB`);
const PICTURE_FILE_NAME = /\.(jpe?g|jfif|png|gif|bmp|webp|heic|heif|tiff?|avif)$/i;
const isPictureFile = (file) => /^image\//i.test((file && file.type) || '') || PICTURE_FILE_NAME.test((file && file.name) || '');
const isHeicFile = looksLikeHeic;
const MIME_BY_EXTENSION = {
  pdf: 'application/pdf', doc: 'application/msword', docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  xls: 'application/vnd.ms-excel', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  ppt: 'application/vnd.ms-powerpoint', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
  txt: 'text/plain', csv: 'text/csv', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', bmp: 'image/bmp',
  webp: 'image/webp', tif: 'image/tiff', tiff: 'image/tiff', heic: 'image/heic', heif: 'image/heif', mp4: 'video/mp4', mov: 'video/quicktime'
};
const mimeFromName = (name) => {
  const m = /\.([a-z0-9]+)$/i.exec(String(name || ''));
  return (m && MIME_BY_EXTENSION[m[1].toLowerCase()]) || 'application/octet-stream';
};

// The first bytes of a file say what it really is, whatever its name claims
const readHead = (file, n) => new Promise((resolve) => {
  try {
    const reader = new FileReader();
    reader.onload = () => resolve(new Uint8Array(reader.result));
    reader.onerror = () => resolve(null);
    reader.readAsArrayBuffer(file.slice(0, n));
  } catch (e) { resolve(null); }
});
const hasJpegBytes = async (file) => {
  const head = await readHead(file, 3);
  return !head || (head[0] === 0xFF && head[1] === 0xD8 && head[2] === 0xFF); // unreadable: take its word
};

// What goes up for one picked file. A picture is saved as a JPG: for an Image column it is also shrunk (as observation pictures
// are); for a File column a picture that is not a JPG yet (PNG, HEIC, WebP ...) is converted at its own size, and one that is too
// big for the column is shrunk. A picture this browser cannot open (a TIFF scan, say) goes into a File column as it is, like any
// document. A file that is called .jpg but is really a HEIC or PNG is told apart by its first bytes.
async function prepareAssetUpload(file, f) {
  if (!file || !file.size) throw new Error('the file is empty');
  const limit = f.maxKB ? f.maxKB * 1024 : 0;
  const tooBig = (n) => `the file is ${formatBytes(n)} and ${f.label} takes at most ${formatBytes(limit)}`;
  const stem = String(file.name || '').replace(/\.[^.]+$/, '') || (f.kind === 'image' ? 'picture' : 'file');
  const ext = (/\.([a-z0-9]+)$/i.exec(file.name || '') || ['', ''])[1].toUpperCase();
  const picture = isPictureFile(file);
  const realJpeg = picture && isJpegFile(file) && await hasJpegBytes(file);
  const heic = picture && !realJpeg && (looksLikeHeic(file) || await sniffHeic(file));
  const convertedFrom = realJpeg ? '' : (heic ? 'HEIC' : (isJpegFile(file) ? 'picture' : (ext || 'picture')));
  const asJpg = async (opts) => {
    const bytes = dataUrlToBytes(await compressImage(file, opts));
    return { body: bytes, name: `${stem}.jpg`, mimeType: 'image/jpeg', bytes: bytes.length, shrunk: true, convertedFrom };
  };
  if (f.kind === 'image') {
    if (!picture) throw new Error(`${f.label} only takes pictures`);
    const up = await asJpg();
    if (limit && up.bytes > limit) throw new Error(tooBig(up.bytes));
    return up;
  }
  if (picture && !realJpeg) {
    try {
      let up = await asJpg({ maxSide: 0, quality: 0.9 });
      if (limit && up.bytes > limit) up = await asJpg();
      if (limit && up.bytes > limit) throw new Error(tooBig(up.bytes));
      return up;
    } catch (error) {
      // A HEIC that cannot be turned into a JPG, or a file that is simply too big, stops here; a picture this browser cannot open goes as it is
      if (heic || error.retry || /^the file is /.test(error.message)) throw error;
    }
  }
  if (limit && file.size > limit) {
    if (picture) {
      try {
        const up = await asJpg();
        if (up.bytes <= limit) return up;
      } catch (e) { /* the file is too big either way */ }
    }
    throw new Error(tooBig(file.size));
  }
  return { body: file, name: file.name || 'file', mimeType: file.type || mimeFromName(file.name), bytes: file.size, shrunk: false, convertedFrom: '' };
}

async function deleteAssetFile(set, id, column, logEvent) {
  const path = `${set}(${id})/${column}`;
  logEvent(`Removing the file in ${column} of asset ${id}`, 'data', { column, id, action: 'delete' }, { method: 'DELETE', path, contentType: '(no body)' });
  const res = await fetch(apiUrl(path), { method: 'DELETE', headers: ODATA_HEADERS });
  if (!res.ok && res.status !== 404) throw new Error(await readApiError(res));
}

// Downloads the stored file and hands it to the browser under its own name
async function openAssetFile(set, id, column, fileName, isImage) {
  const tries = isImage ? [`${set}(${id})/${column}/$value?size=full`, `${set}(${id})/${column}/$value`] : [`${set}(${id})/${column}/$value`];
  let res = null;
  for (let i = 0; i < tries.length; i += 1) {
    res = await fetch(apiUrl(tries[i]), { headers: { Accept: '*/*', ...NO_CACHE } });
    // 204 = no full-size copy stored: try the thumbnail
    if (res.ok && res.status !== 204) break;
  }
  if (!res || !res.ok) throw new Error(res ? await readApiError(res) : 'no response');
  if (res.status === 204) throw new Error('nothing is stored in this column');
  const blob = await res.blob();
  const name = fileName || res.headers.get('x-ms-file-name') || `${column}${isImage ? '.jpg' : ''}`;
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = name;
  a.rel = 'noopener';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 60000);
}

// --- MAP SPOTS ---
// Saved as a little JSON text: {"v":1,"m":"MAIN","x":12.34,"y":56.78,"b":[left,top,width,height],"s":1}, in percent of the map picture.
// "s":1 = smart snap found an outline around a click, "s":2 = a dragged box was fitted to the lines in it. "12.3;45.6" typed by
// hand also counts as a spot.
const clampPct = (n) => Math.max(0, Math.min(100, n));
const round2 = (n) => Math.round(n * 100) / 100;

function parseMapLocation(text) {
  if (text === null || text === undefined || String(text).trim() === '') return null;
  const num = (v) => (typeof v === 'number' && isFinite(v) ? clampPct(v) : null);
  try {
    const o = JSON.parse(text);
    if (o && typeof o === 'object') {
      const x = num(o.x);
      const y = num(o.y);
      if (x === null || y === null) return null;
      const box = Array.isArray(o.b) && o.b.length === 4 && o.b.every(v => typeof v === 'number' && isFinite(v)) ? o.b : null;
      return { x, y, box, snapped: o.s === 1 || o.s === 2, how: o.s === 2 ? 'box' : 'click', map: typeof o.m === 'string' ? o.m.toUpperCase() : '' };
    }
  } catch (e) { /* not JSON */ }
  const m = String(text).match(/^\s*(\d+(?:\.\d+)?)\s*[;,]\s*(\d+(?:\.\d+)?)\s*$/);
  return m ? { x: clampPct(parseFloat(m[1])), y: clampPct(parseFloat(m[2])), box: null, snapped: false, how: 'click', map: '' } : null;
}

function mapLocationText(spot, mapKey, maxLength) {
  const o = { v: 1, m: mapKey || 'MAIN', x: round2(spot.x), y: round2(spot.y) };
  if (spot.box) o.b = spot.box.map(round2);
  if (spot.snapped) o.s = spot.how === 'box' ? 2 : 1;
  let text = JSON.stringify(o);
  if (maxLength && text.length > maxLength) { delete o.b; text = JSON.stringify(o); }
  if (maxLength && text.length > maxLength) text = `${o.x};${o.y}`;
  return text;
}

// Pins belong to the map they were placed on; older spots without a map code (or coded MAIN) belong to the main map
const pinOnMap = (location, mapKey) => {
  if (!location) return false;
  const key = mapKey || 'MAIN';
  const at = mapKeyOf(location.map);
  return at === key || (onMainMapCode(at) && key === MAP_STATE.mainKey);
};

// --- SMART SNAP ---
// The map picture is read once into a dark / light grid (dark = lines, walls and solid shapes). A click inside an outlined
// area fills outward until the fill meets dark lines. Small gaps such as doors are closed first so the fill stays in the room,
// then the area is grown back to the lines. A fill that reaches the picture's edge or gets huge is open floor: no snap.
const SNAP_MAX_SIDE = 1600;    // px; bigger pictures are scaled down before they are analysed (memory on phones)
const SNAP_MAX_SHARE = 0.25;   // a fill bigger than this share of the picture is not an outlined area
const SNAP_SOLID_SHARE = 0.02; // a dark shape bigger than this share is the wall network, not a piece of equipment
const SNAP_MIN_PX = 25;        // smaller than this is a speck

let snapCache = { src: null, promise: null };

const loadPicture = (src) => new Promise((resolve, reject) => {
  const img = new Image();
  img.onload = () => resolve(img);
  img.onerror = () => reject(new Error('the map picture could not be opened'));
  img.src = src;
});

// Otsu: the grey level that best splits the picture into dark and light
function otsuThreshold(hist, total) {
  let sum = 0;
  for (let i = 0; i < 256; i += 1) sum += i * hist[i];
  let sumB = 0;
  let wB = 0;
  let best = 0;
  let threshold = 128;
  for (let t = 0; t < 256; t += 1) {
    wB += hist[t];
    if (wB === 0) continue;
    const wF = total - wB;
    if (wF === 0) break;
    sumB += t * hist[t];
    const mB = sumB / wB;
    const mF = (sum - sumB) / wF;
    const between = wB * wF * (mB - mF) * (mB - mF);
    if (between > best) { best = between; threshold = t + 1; }
  }
  return threshold;
}

// Square dilation (a pixel turns dark when any pixel within r is dark), two passes of a sliding window count
function dilate(src, w, h, r) {
  const tmp = new Uint8Array(w * h);
  const out = new Uint8Array(w * h);
  for (let y = 0; y < h; y += 1) {
    const row = y * w;
    let count = 0;
    for (let x = 0; x < Math.min(r, w); x += 1) count += src[row + x];
    for (let x = 0; x < w; x += 1) {
      if (x + r < w) count += src[row + x + r];
      if (x - r - 1 >= 0) count -= src[row + x - r - 1];
      tmp[row + x] = count > 0 ? 1 : 0;
    }
  }
  for (let x = 0; x < w; x += 1) {
    let count = 0;
    for (let y = 0; y < Math.min(r, h); y += 1) count += tmp[y * w + x];
    for (let y = 0; y < h; y += 1) {
      if (y + r < h) count += tmp[(y + r) * w + x];
      if (y - r - 1 >= 0) count -= tmp[(y - r - 1) * w + x];
      out[y * w + x] = count > 0 ? 1 : 0;
    }
  }
  return out;
}

async function buildSnapGrid(src) {
  const img = await loadPicture(src);
  const nw = img.naturalWidth || img.width;
  const nh = img.naturalHeight || img.height;
  if (!nw || !nh) throw new Error('the map picture has no size');
  const scale = Math.min(1, SNAP_MAX_SIDE / Math.max(nw, nh));
  const w = Math.max(1, Math.round(nw * scale));
  const h = Math.max(1, Math.round(nh * scale));
  const canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#FFFFFF'; // see-through parts count as light floor
  ctx.fillRect(0, 0, w, h);
  if (scale < 1) {
    // Shrinking blends thin walls with the floor around them into light grey, and they would stop counting as walls.
    // Keep each cell's darkest pixel instead: draw the picture once per offset inside a cell, unsmoothed, keeping the darker colour.
    const cell = 1 / scale;
    const k = Math.min(8, Math.ceil(cell));
    ctx.imageSmoothingEnabled = false;
    ctx.globalCompositeOperation = 'darken';
    for (let oy = 0; oy < k; oy += 1) {
      for (let ox = 0; ox < k; ox += 1) {
        ctx.drawImage(img, (ox * cell) / k, (oy * cell) / k, w * cell, h * cell, 0, 0, w, h);
      }
    }
    ctx.globalCompositeOperation = 'source-over';
  } else {
    ctx.drawImage(img, 0, 0, w, h);
  }
  let pixels;
  try {
    pixels = ctx.getImageData(0, 0, w, h).data;
  } catch (e) {
    throw new Error('this browser does not let the app read the map picture');
  }
  const n = w * h;
  const lum = new Uint8Array(n);
  const hist = new Array(256);
  for (let i = 0; i < 256; i += 1) hist[i] = 0;
  for (let i = 0; i < n; i += 1) {
    const l = Math.round(0.299 * pixels[i * 4] + 0.587 * pixels[i * 4 + 1] + 0.114 * pixels[i * 4 + 2]);
    lum[i] = l;
    hist[l] += 1;
  }
  // Keep the split in a sane range: an almost all-white picture must not turn light grey into "walls"
  const threshold = Math.max(40, Math.min(200, otsuThreshold(hist, n)));
  const dark = new Uint8Array(n);
  for (let i = 0; i < n; i += 1) dark[i] = lum[i] < threshold ? 1 : 0;
  const gap = Math.max(1, Math.round(Math.max(w, h) / 600));
  const closed = dilate(dark, w, h, gap);
  // Number every light area once (4-connected), with its size and whether it reaches the picture's edge,
  // so a click only has to look its area up
  const labels = new Int32Array(n);
  const sizes = [0];
  const edges = [false];
  const stack = new Int32Array(n);
  let next = 1;
  for (let start = 0; start < n; start += 1) {
    if (closed[start] || labels[start]) continue;
    let top = 0;
    let size = 0;
    let edge = false;
    stack[top++] = start;
    labels[start] = next;
    while (top > 0) {
      const i = stack[--top];
      size += 1;
      const x = i % w;
      const y = (i - x) / w;
      if (x === 0 || y === 0 || x === w - 1 || y === h - 1) edge = true;
      if (x > 0 && !closed[i - 1] && !labels[i - 1]) { labels[i - 1] = next; stack[top++] = i - 1; }
      if (x < w - 1 && !closed[i + 1] && !labels[i + 1]) { labels[i + 1] = next; stack[top++] = i + 1; }
      if (y > 0 && !closed[i - w] && !labels[i - w]) { labels[i - w] = next; stack[top++] = i - w; }
      if (y < h - 1 && !closed[i + w] && !labels[i + w]) { labels[i + w] = next; stack[top++] = i + w; }
    }
    sizes.push(size);
    edges.push(edge);
    next += 1;
  }
  return { w, h, dark, closed, labels, sizes, edges, gap, threshold };
}

function getSnapGrid(src) {
  if (snapCache.src !== src || !snapCache.promise) {
    snapCache = { src, promise: buildSnapGrid(src) };
    // A failure is not kept: the next click tries again
    snapCache.promise.catch(() => { if (snapCache.src === src) snapCache = { src: null, promise: null }; });
  }
  return snapCache.promise;
}

// 4-connected fill over cells equal to `want`. Returns { pixels, edge } or null when it passes `maxArea`.
function floodFill(cells, w, h, seed, want, maxArea) {
  if (seed < 0 || cells[seed] !== want) return null;
  const seen = new Uint8Array(w * h);
  const stack = [seed];
  const pixels = [];
  let edge = false;
  seen[seed] = 1;
  while (stack.length) {
    const i = stack.pop();
    pixels.push(i);
    if (pixels.length > maxArea) return null;
    const x = i % w;
    const y = (i - x) / w;
    if (x === 0 || y === 0 || x === w - 1 || y === h - 1) edge = true;
    if (x > 0 && !seen[i - 1] && cells[i - 1] === want) { seen[i - 1] = 1; stack.push(i - 1); }
    if (x < w - 1 && !seen[i + 1] && cells[i + 1] === want) { seen[i + 1] = 1; stack.push(i + 1); }
    if (y > 0 && !seen[i - w] && cells[i - w] === want) { seen[i - w] = 1; stack.push(i - w); }
    if (y < h - 1 && !seen[i + w] && cells[i + w] === want) { seen[i + w] = 1; stack.push(i + w); }
  }
  return { pixels, edge };
}

// Region -> what the map draws and saves: pin point, box (percent) and a mask cut to the box
function describeRegion(grid, pixels, kind, clickIndex) {
  const { w, h } = grid;
  let minX = w; let minY = h; let maxX = 0; let maxY = 0; let sx = 0; let sy = 0;
  for (let k = 0; k < pixels.length; k += 1) {
    const i = pixels[k];
    const x = i % w;
    const y = (i - x) / w;
    if (x < minX) minX = x;
    if (x > maxX) maxX = x;
    if (y < minY) minY = y;
    if (y > maxY) maxY = y;
    sx += x;
    sy += y;
  }
  const bw = maxX - minX + 1;
  const bh = maxY - minY + 1;
  const mask = new Uint8Array(bw * bh);
  for (let k = 0; k < pixels.length; k += 1) {
    const i = pixels[k];
    const x = i % w;
    const y = (i - x) / w;
    mask[(y - minY) * bw + (x - minX)] = 1;
  }
  // The pin goes in the middle; for an L or U shape whose middle is outside, the area's pixel nearest the middle
  let cx = Math.round(sx / pixels.length);
  let cy = Math.round(sy / pixels.length);
  if (!mask[(cy - minY) * bw + (cx - minX)]) {
    let best = clickIndex;
    let bestD = Infinity;
    for (let k = 0; k < pixels.length; k += 1) {
      const i = pixels[k];
      const x = i % w;
      const y = (i - x) / w;
      const d = (x - cx) * (x - cx) + (y - cy) * (y - cy);
      if (d < bestD) { bestD = d; best = i; }
    }
    cx = best % w;
    cy = (best - cx) / w;
  }
  return {
    kind,
    x: ((cx + 0.5) / w) * 100,
    y: ((cy + 0.5) / h) * 100,
    box: [(minX / w) * 100, (minY / h) * 100, (bw / w) * 100, (bh / h) * 100],
    mask: { w: bw, h: bh, data: mask },
    origin: [minX, minY],
    area: pixels.length,
    gridW: w
  };
}

// Is grid pixel (px, py) part of the region?
const regionHas = (region, px, py) => {
  const x = px - region.origin[0];
  const y = py - region.origin[1];
  return x >= 0 && y >= 0 && x < region.mask.w && y < region.mask.h && region.mask.data[y * region.mask.w + x] === 1;
};

// The outlined area (or solid shape) at a click, or null when there is none
function snapAt(grid, xPct, yPct) {
  const { w, h, dark, closed, labels, sizes, edges, gap } = grid;
  const n = w * h;
  const px = Math.max(0, Math.min(w - 1, Math.floor((xPct / 100) * w)));
  const py = Math.max(0, Math.min(h - 1, Math.floor((yPct / 100) * h)));
  const click = py * w + px;
  // Smaller than this is a speck (the inside of a letter "o" in a label), not an area
  const minArea = Math.max(SNAP_MIN_PX, Math.floor(n * 0.00004));
  const maxArea = Math.floor(n * SNAP_MAX_SHARE);
  // 'room' = an outlined area, 'open' = open floor (reaches the edge or is huge), 'speck' = too small
  const kindOf = (label) => (edges[label] || sizes[label] > maxArea ? 'open' : (sizes[label] < minArea ? 'speck' : 'room'));

  // The area of a light seed, grown back over the strip the gap closing took, up to the real lines.
  // `inside`: the click itself is in the area (not on its wall or label), so the pin can stay where it was clicked.
  const roomFrom = (seed) => {
    const region = growRoom(seed);
    if (region) region.inside = regionHas(region, px, py);
    return region;
  };
  const growRoom = (seed) => {
    const room = floodFill(closed, w, h, seed, 0, maxArea);
    if (!room) return null;
    const inside = new Uint8Array(n);
    room.pixels.forEach(i => { inside[i] = 1; });
    let frontier = room.pixels;
    const all = room.pixels.slice();
    for (let step = 0; step < gap; step += 1) {
      const nextFrontier = [];
      for (let k = 0; k < frontier.length; k += 1) {
        const i = frontier[k];
        const x = i % w;
        const nb = [x > 0 ? i - 1 : -1, x < w - 1 ? i + 1 : -1, i - w, i + w];
        for (let j = 0; j < 4; j += 1) {
          const q = nb[j];
          if (q < 0 || q >= n || inside[q] || dark[q]) continue;
          inside[q] = 1;
          nextFrontier.push(q);
          all.push(q);
        }
      }
      frontier = nextFrontier;
    }
    return describeRegion(grid, all, 'room', seed);
  };

  if (!closed[click]) {
    const kind = kindOf(labels[click]);
    if (kind === 'room') return roomFrom(click);
    if (kind === 'open') return null; // open floor: no outlined area here
  } else if (dark[click]) {
    // On something dark: a solid shape (equipment drawn in black) is the target when it is filled, chunky and big enough;
    // the strokes of a room's text label or a line are not
    const solid = floodFill(dark, w, h, click, 1, Math.floor(n * SNAP_SOLID_SHARE));
    if (solid && !solid.edge && solid.pixels.length >= Math.max(minArea * 4, Math.floor(n * 0.0003))) {
      const shape = describeRegion(grid, solid.pixels, 'shape', click);
      if (shape.area / (shape.mask.w * shape.mask.h) >= 0.6 && Math.min(shape.mask.w, shape.mask.h) >= gap * 3 + 3) return shape;
    }
  }

  // A line, a label or a speck: the nearest outlined area around the click (open floor and specks are skipped)
  const radius = (gap * 3 + 3) * 4;
  const seen = {};
  for (let r = 1; r <= radius; r += 1) {
    let best = -1;
    let bestD = Infinity;
    for (let dy = -r; dy <= r; dy += 1) {
      for (let dx = -r; dx <= r; dx += 1) {
        if (Math.max(Math.abs(dx), Math.abs(dy)) !== r) continue;
        const x = px + dx;
        const y = py + dy;
        if (x < 0 || y < 0 || x >= w || y >= h) continue;
        const i = y * w + x;
        if (closed[i]) continue;
        const label = labels[i];
        const d = dx * dx + dy * dy;
        if (!seen[label]) seen[label] = kindOf(label);
        if (seen[label] === 'room' && d < bestD) { best = i; bestD = d; }
      }
    }
    if (best >= 0) return roomFrom(best);
  }
  return null;
}

// Does a freshly found region still match a saved box (the map picture may have been replaced since)?
const boxesAgree = (a, b) => {
  if (!a || !b) return false;
  const ix = Math.max(0, Math.min(a[0] + a[2], b[0] + b[2]) - Math.max(a[0], b[0]));
  const iy = Math.max(0, Math.min(a[1] + a[3], b[1] + b[3]) - Math.max(a[1], b[1]));
  const inter = ix * iy;
  const union = a[2] * a[3] + b[2] * b[3] - inter;
  return union > 0 && inter / union > 0.6;
};

// A dragged box (percent of the picture: [x0, y0, x1, y1]): the outline the black lines inside it draw. Areas those lines
// close off inside the box are filled, with the lines around them; lines that only run on past them are cut. When the lines
// close nothing off, the box shrinks to the lines themselves. No lines in the box: null (the box is used as drawn).
function snapBox(grid, rect) {
  const { w, h, dark, closed, gap } = grid;
  const x0 = Math.max(0, Math.floor((Math.min(rect[0], rect[2]) / 100) * w));
  const x1 = Math.min(w - 1, Math.ceil((Math.max(rect[0], rect[2]) / 100) * w) - 1);
  const y0 = Math.max(0, Math.floor((Math.min(rect[1], rect[3]) / 100) * h));
  const y1 = Math.min(h - 1, Math.ceil((Math.max(rect[1], rect[3]) / 100) * h) - 1);
  const bw = x1 - x0 + 1;
  const bh = y1 - y0 + 1;
  if (bw < 3 || bh < 3) return null;
  const n = bw * bh;
  const at = (k) => { const lx = k % bw; return (y0 + (k - lx) / bw) * w + x0 + lx; };
  // Light floor that can be reached from the box's edge (with door gaps closed) is outside what the lines draw
  const outside = new Uint8Array(n);
  const stack = new Int32Array(n);
  let top = 0;
  const reach = (k) => { if (!outside[k] && !closed[at(k)]) { outside[k] = 1; stack[top++] = k; } };
  // Every light pixel on the box's edge is outside, even one close to the lines (a box drawn tight round a shape);
  // only the ones clear of the lines spread, so a doorway on the edge does not open the room behind it
  const seed = (k) => { if (outside[k] || dark[at(k)]) return; outside[k] = 1; if (!closed[at(k)]) stack[top++] = k; };
  for (let lx = 0; lx < bw; lx += 1) { seed(lx); seed((bh - 1) * bw + lx); }
  for (let ly = 0; ly < bh; ly += 1) { seed(ly * bw); seed(ly * bw + bw - 1); }
  while (top > 0) {
    const k = stack[--top];
    const lx = k % bw;
    if (lx > 0) reach(k - 1);
    if (lx < bw - 1) reach(k + 1);
    if (k >= bw) reach(k - bw);
    if (k + bw < n) reach(k + bw);
  }
  // ...and the strip the gap closing took from it, back up to the real lines
  for (let step = 0; step < gap; step += 1) {
    const grow = [];
    for (let k = 0; k < n; k += 1) {
      if (outside[k] || dark[at(k)]) continue;
      const lx = k % bw;
      if ((lx > 0 && outside[k - 1]) || (lx < bw - 1 && outside[k + 1]) || (k >= bw && outside[k - bw]) || (k + bw < n && outside[k + bw])) grow.push(k);
    }
    grow.forEach(k => { outside[k] = 1; });
  }
  const isDark = new Uint8Array(n);
  const light = new Uint8Array(n); // closed off by lines, not yet sorted
  let darkCount = 0;
  let minX = bw; let minY = bh; let maxX = -1; let maxY = -1;
  for (let k = 0; k < n; k += 1) {
    if (dark[at(k)]) {
      isDark[k] = 1;
      darkCount += 1;
      const lx = k % bw;
      const ly = (k - lx) / bw;
      if (lx < minX) minX = lx;
      if (lx > maxX) maxX = lx;
      if (ly < minY) minY = ly;
      if (ly > maxY) maxY = ly;
    } else if (!outside[k]) {
      light[k] = 1;
    }
  }
  if (darkCount === 0) return null;
  // Closed-off areas big enough to be a room or an outlined machine (the holes in letters are not)
  const minArea = Math.max(SNAP_MIN_PX, Math.floor(w * h * 0.00004));
  const enclosed = new Uint8Array(n);
  let enclosedCount = 0;
  for (let start = 0; start < n; start += 1) {
    if (!light[start]) continue;
    const part = [start];
    light[start] = 0;
    for (let j = 0; j < part.length; j += 1) {
      const k = part[j];
      const lx = k % bw;
      if (lx > 0 && light[k - 1]) { light[k - 1] = 0; part.push(k - 1); }
      if (lx < bw - 1 && light[k + 1]) { light[k + 1] = 0; part.push(k + 1); }
      if (k >= bw && light[k - bw]) { light[k - bw] = 0; part.push(k - bw); }
      if (k + bw < n && light[k + bw]) { light[k + bw] = 0; part.push(k + bw); }
    }
    if (part.length >= minArea) {
      part.forEach(k => { enclosed[k] = 1; });
      enclosedCount += part.length;
    }
  }
  // Closed-off areas that fill a fair part of the box are what was boxed; a few small pockets (between letters) are not
  if (enclosedCount >= n * 0.1) {
    // The closed-off areas, and the lines around them (lines that run on are cut about one line width past the area)
    const near = dilate(enclosed, bw, bh, gap + 2);
    const pixels = [];
    for (let k = 0; k < n; k += 1) if (enclosed[k] || (isDark[k] && near[k])) pixels.push(at(k));
    const region = describeRegion(grid, pixels, 'box', at(Math.floor(bh / 2) * bw + Math.floor(bw / 2)));
    region.inside = false;
    return region;
  }
  // Nothing closed off: the box pulled in to the lines in it
  const rw = maxX - minX + 1;
  const rh = maxY - minY + 1;
  const mask = new Uint8Array(rw * rh);
  mask.fill(1);
  return {
    kind: 'box',
    x: ((x0 + minX + rw / 2) / w) * 100,
    y: ((y0 + minY + rh / 2) / h) * 100,
    box: [((x0 + minX) / w) * 100, ((y0 + minY) / h) * 100, (rw / w) * 100, (rh / h) * 100],
    mask: { w: rw, h: rh, data: mask },
    origin: [x0 + minX, y0 + minY],
    area: rw * rh,
    gridW: w,
    inside: false
  };
}

// --- EDITOR VALUES ---
// What a column holds while it is edited: text for text and numbers, true / false / null for yes-no, an array for
// multi-select choices, "YYYY-MM-DD" (or "YYYY-MM-DDTHH:mm") for dates, { id, name, set } for lookups.
const pad2 = (n) => (n < 10 ? `0${n}` : String(n));
const localDateText = (d) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;

function dateToInput(f, v) {
  if (!v) return '';
  const s = String(v);
  if (f.dateOnly) {
    // "Date only" behaviour and time-zone independent values are stored as written; user-local ones are an instant
    if (f.behavior !== 'UserLocal' || s.length <= 10) return s.slice(0, 10);
    const d = new Date(s);
    return isNaN(d.getTime()) ? s.slice(0, 10) : localDateText(d);
  }
  if (f.behavior === 'TimeZoneIndependent') return s.slice(0, 16);
  const d = new Date(s);
  return isNaN(d.getTime()) ? '' : `${localDateText(d)}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
}

// The wire format follows the behaviour: "Date only" is a plain date, time-zone independent is the wall clock as written,
// user local is the user's local time as UTC
function inputToDate(f, v) {
  if (!v) return null;
  if (f.behavior === 'DateOnly') return v;
  if (f.behavior === 'TimeZoneIndependent') return f.dateOnly ? `${v}T00:00:00Z` : `${v}:00Z`;
  return new Date(f.dateOnly ? `${v}T00:00:00` : v).toISOString();
}

function emptyValue(f) {
  if (f.kind === 'bool') return null;
  if (f.kind === 'choices') return [];
  if (f.kind === 'lookup') return { id: '', name: '' };
  return '';
}

function toEditValue(f, row) {
  if (!row) return emptyValue(f);
  const v = f.kind === 'lookup' ? row[`_${f.name}_value`] : row[f.name];
  switch (f.kind) {
    case 'text': case 'memo': case 'int': case 'number': case 'choice':
      return v === null || v === undefined ? '' : String(v);
    case 'bool': return v === true ? true : (v === false ? false : null);
    case 'choices': return v === null || v === undefined || v === '' ? [] : String(v).split(',').map(s => s.trim()).filter(Boolean);
    case 'date': return dateToInput(f, v);
    case 'lookup': return v ? { id: cleanGuid(v), name: formatted(row, `_${f.name}_value`) || '' } : { id: '', name: '' };
    default: return v;
  }
}

// Comparable form of a value (to tell what changed)
function editKey(f, v) {
  if (f.kind === 'bool') return v === null || v === undefined ? '' : (v ? '1' : '0');
  if (f.kind === 'choices') return (v || []).slice().sort().join(',');
  if (f.kind === 'lookup') return (v && v.id) || '';
  if (f.kind === 'int' || f.kind === 'number') return String(v === null || v === undefined ? '' : v).trim();
  return v === null || v === undefined ? '' : String(v);
}

const parseNumber = (v) => {
  const s = String(v).trim();
  // "12,5" from a comma-decimal keyboard
  return Number(s.indexOf('.') === -1 ? s.replace(',', '.') : s);
};

function isEmptyValue(f, v) {
  if (f.kind === 'bool') return v === null || v === undefined;
  if (f.kind === 'choices') return !v || v.length === 0;
  if (f.kind === 'lookup') return !v || !v.id;
  return String(v === null || v === undefined ? '' : v).trim() === '';
}

function validateField(f, v) {
  if (isEmptyValue(f, v)) return f.required || f.isPrimaryName ? 'Required.' : '';
  if ((f.kind === 'text' || f.kind === 'memo') && f.maxLength && String(v).length > f.maxLength) return `At most ${f.maxLength} characters (now ${String(v).length}).`;
  if (f.kind === 'int') {
    if (!/^-?\d+$/.test(String(v).trim())) return 'Enter a whole number.';
    const n = parseInt(v, 10);
    if (typeof f.min === 'number' && n < f.min) return `At least ${f.min}.`;
    if (typeof f.max === 'number' && n > f.max) return `At most ${f.max}.`;
  }
  if (f.kind === 'number') {
    const n = parseNumber(v);
    if (!isFinite(n)) return 'Enter a number.';
    if (typeof f.min === 'number' && n < f.min) return `At least ${f.min}.`;
    if (typeof f.max === 'number' && n > f.max) return `At most ${f.max}.`;
    const decimals = (String(v).trim().split(/[.,]/)[1] || '').length;
    if (typeof f.precision === 'number' && decimals > f.precision) return `At most ${f.precision} decimal${f.precision === 1 ? '' : 's'}.`;
  }
  if (f.kind === 'date' && isNaN(new Date(f.dateOnly ? `${v}T00:00:00` : v).getTime())) return 'Enter a valid date.';
  return '';
}

// [key, value] for the PATCH / POST body
function toPayloadEntry(f, v) {
  switch (f.kind) {
    case 'text': case 'memo': return [f.name, String(v).trim() === '' ? null : v];
    case 'int': return [f.name, String(v).trim() === '' ? null : parseInt(v, 10)];
    case 'number': return [f.name, String(v).trim() === '' ? null : parseNumber(v)];
    case 'bool': return [f.name, v];
    case 'choice': return [f.name, v === '' ? null : parseInt(v, 10)];
    case 'choices': return [f.name, v && v.length ? v.join(',') : null];
    case 'date': return [f.name, inputToDate(f, v)];
    // Clearing a lookup is the bare navigation property set to null (Microsoft's recommended form)
    case 'lookup': return v && v.id ? [`${f.nav}@odata.bind`, `/${v.set}(${v.id})`] : [f.nav, null];
    default: return [f.name, v];
  }
}

// What a column shows when it cannot be edited
function displayValue(f, row) {
  if (!row) return '';
  if (f.kind === 'lookup' || f.kind === 'fixedlookup') return formatted(row, `_${f.name}_value`) || '';
  if (f.kind === 'file') return row[`${f.name}_name`] || '';
  const fv = formatted(row, f.name);
  if (fv !== undefined && fv !== null) return String(fv);
  const v = row[f.name];
  if (v === null || v === undefined) return '';
  if (f.kind === 'bool') return v ? (f.trueLabel || 'Yes') : (f.falseLabel || 'No');
  if (f.kind === 'date') { const d = new Date(v); return isNaN(d.getTime()) ? String(v) : (f.dateOnly ? String(v).slice(0, 10) : d.toLocaleString()); }
  return String(v);
}

// Can the editor change this column (now)?
function isEditableField(f, isNew) {
  if (f.info || f.kind === 'status' || f.kind === 'id' || f.kind === 'fixedlookup' || f.kind === 'file' || f.kind === 'image') return false;
  if (isNew ? !f.canCreate : !f.canUpdate) return false;
  if (f.kind === 'lookup' && !(f.nav && f.targets && f.targets.length === 1)) return false;
  if ((f.kind === 'choice' || f.kind === 'choices') && !(f.options && f.options.length)) return false;
  return true;
}

// Sections of the editor
function groupAssetFields(fields) {
  const groups = ASSET_GROUPS.map(g => ({ ...g, items: [] }));
  const info = [];
  fields.forEach(f => {
    if (f.info || f.kind === 'status' || f.kind === 'id' || f.kind === 'fixedlookup') { info.push(f); return; }
    let g = groups.find(x => x.names && x.names.indexOf(f.name) !== -1);
    if (!g) g = groups.find(x => x.kinds && x.kinds.indexOf(f.kind) !== -1);
    if (!g && (f.kind === 'bool' || f.kind === 'int' || f.kind === 'number')) g = groups.find(x => x.hint && (x.hint.test(f.name) || x.hint.test(f.label)));
    if (!g && f.isPrimaryName) g = groups[0];
    if (!g) g = groups[groups.length - 1];
    g.items.push(f);
  });
  groups.forEach(g => {
    const rank = (f) => (g.names && g.names.indexOf(f.name) !== -1 ? g.names.indexOf(f.name) : 1000) - (f.isPrimaryName ? 2000 : 0);
    g.items.sort((a, b) => rank(a) - rank(b) || a.label.localeCompare(b.label));
  });
  return { groups: groups.filter(g => g.items.length > 0), info };
}

const targetMetaCache = {};
function loadTargetMeta(logicalName) {
  if (!targetMetaCache[logicalName]) {
    targetMetaCache[logicalName] = getJson(`EntityDefinitions(LogicalName='${logicalName}')?$select=EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute`)
      .then(d => ({ set: d.EntitySetName, id: d.PrimaryIdAttribute, name: d.PrimaryNameAttribute }));
    targetMetaCache[logicalName].catch(() => { delete targetMetaCache[logicalName]; });
  }
  return targetMetaCache[logicalName];
}

const hexRgb = (hex) => [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];

// ==========================================
// SHARED ON / OFF SWITCH
// ==========================================
function Switch({ on, onChange, label, title, disabled = false, className = '' }) {
  return (
    <button
      type="button"
      role="switch"
      aria-checked={!!on}
      disabled={disabled}
      onClick={() => onChange(!on)}
      title={title}
      className={`inline-flex items-center gap-2 pl-1 pr-3 py-0.5 rounded-full text-xs font-bold border whitespace-nowrap shrink-0 transition-colors disabled:opacity-50 disabled:cursor-not-allowed ${on ? 'bg-[#00468B] text-white border-[#00468B]' : 'bg-white text-[#00468B] border-[#B3D4F2] hover:bg-[#E6F1FB]'} ${className}`}
    >
      <span className={`relative inline-block w-7 h-4 rounded-full transition-colors ${on ? 'bg-[#FFB81C]' : 'bg-slate-300'}`} aria-hidden="true">
        <span className={`absolute top-0.5 w-3 h-3 rounded-full bg-white shadow transition-all ${on ? 'left-3.5' : 'left-0.5'}`} />
      </span>
      {label}
    </button>
  );
}

// Paints a smart-snap area on the map: tinted inside, solid edge. Drawn at the area's own size and stretched over its box.
function RegionOverlay({ region, fill, edge, testId }) {
  const ref = useRef(null);
  useEffect(() => {
    const canvas = ref.current;
    if (!canvas || !region) return;
    const { w, h, data } = region.mask;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    const img = ctx.createImageData(w, h);
    const f = hexRgb(fill);
    const e = hexRgb(edge);
    // A thicker edge on big pictures, which are shown scaled down
    const t = region.gridW > 1200 ? 2 : 1;
    const inside = (x, y) => x >= 0 && y >= 0 && x < w && y < h && data[y * w + x] === 1;
    for (let y = 0; y < h; y += 1) {
      for (let x = 0; x < w; x += 1) {
        const i = y * w + x;
        if (!data[i]) continue;
        let border = false;
        for (let d = 1; d <= t && !border; d += 1) border = !inside(x - d, y) || !inside(x + d, y) || !inside(x, y - d) || !inside(x, y + d);
        const c = border ? e : f;
        img.data[i * 4] = c[0];
        img.data[i * 4 + 1] = c[1];
        img.data[i * 4 + 2] = c[2];
        img.data[i * 4 + 3] = border ? 255 : 95;
      }
    }
    ctx.putImageData(img, 0, 0);
  }, [region, fill, edge]);
  if (!region) return null;
  return (
    <canvas
      ref={ref}
      aria-hidden="true"
      data-testid={testId}
      className="absolute pointer-events-none"
      style={{ left: `${region.box[0]}%`, top: `${region.box[1]}%`, width: `${region.box[2]}%`, height: `${region.box[3]}%`, imageRendering: 'pixelated' }}
    />
  );
}

// ==========================================
