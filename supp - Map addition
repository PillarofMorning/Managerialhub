function TabButton({ active, icon, label, onClick }) {
  return (
    <button
      onClick={onClick}
      role="tab"
      aria-selected={active}
      className={`flex items-center gap-2 px-3 py-2 text-[11px] font-extrabold uppercase tracking-[0.08em] rounded-xl whitespace-nowrap shrink-0 transition-colors ${
        active ? 'bg-[#0072CE] text-white shadow-[0_6px_14px_rgba(0,114,206,0.25)]' : 'text-slate-500 hover:bg-[#E6F1FB] hover:text-[#0072CE]'
