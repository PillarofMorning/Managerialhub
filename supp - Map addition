        <p className="mt-1 text-[#7A5200]" data-testid={testId ? `${testId}-typed-unused` : undefined}>
          The name kept on this device, <span className="font-mono break-all">{typed}</span>, is not {expectedType ? `${/^[AEIOU]/i.test(expectedType) ? 'an' : 'a'} ${expectedType}` : 'a usable'} column of this table{found ? <>, so <span className="font-mono break-all">{found}</span> is used</> : ''}. Check the spelling (the logical name), or go back to the app's choice.
        </p>
      )}
      <div className="mt-1 flex flex-wrap items-center gap-1.5">
        {list.length > 0 && (
