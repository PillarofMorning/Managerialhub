  <svg className={className} {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={fill} stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
    {paths}
  </svg>
);

const Activity = createIcon(<polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />);
const MapPin = createIcon(<><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></>);
const MapIcon = createIcon(<><polygon points="1 6 8 2 16 6 23 2 23 18 16 22 8 18 1 22 1 6" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" /></>);
const FlagIcon = createIcon(<><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" /><line x1="4" y1="22" x2="4" y2="15" /></>);
const ImageIcon = createIcon(<><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></>);
const TableIcon = createIcon(<><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="3" y1="15" x2="21" y2="15" /><line x1="9" y1="3" x2="9" y2="21" /><line x1="15" y1="3" x2="15" y2="21" /></>);
const Terminal = createIcon(<><polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" /></>);
const X = createIcon(<><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></>);
const CheckCircle = createIcon(<><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></>);
const Camera = createIcon(<><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" /><circle cx="12" cy="13" r="3" /></>);
const Search = createIcon(<><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></>);
const Maximize2 = createIcon(<><polyline points="15 3 21 3 21 9" /><polyline points="9 21 3 21 3 15" /><line x1="21" y1="3" x2="14" y2="10" /><line x1="3" y1="21" x2="10" y2="14" /></>);
const ZoomIn = createIcon(<><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></>);
const ZoomOut = createIcon(<><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="8" y1="11" x2="14" y2="11" /></>);
const PencilIcon = createIcon(<><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" /></>);
const FilterIcon = createIcon(<><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></>);
const CopyIcon = createIcon(<><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></>);
const Download = createIcon(<><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></>);

// --- SHARED FACILITY MAP SVG (Fallback if Fetch completely fails) ---
const FacilityMapSvg = () => (
  <svg className="w-full h-full text-slate-400" viewBox="0 0 100 100" preserveAspectRatio="none">
    <rect width="100" height="100" fill="#e2e8f0" />
    <path d="M 10,10 L 90,10 L 90,40 L 60,40 L 60,90 L 10,90 Z" fill="#cbd5e1" stroke="#94a3b8" strokeWidth="0.5" />
    <text x="35" y="50" fontSize="5" fill="#94a3b8">No Map Loaded</text>
  </svg>
);

// --- DATAVERSE SCHEMA DEFINITIONS ---
const DATAVERSE_MAPS_SCHEMA = { TableName: 'craa5___mapses' };
const DATAVERSE_SCHEMA = { TableName: 'craa5__facilityobservations' };

export default function App() {
  const [activeTab, setActiveTab] = useState('overview');
  const [submissions, setSubmissions] = useState([]);
  const [mainMapImage, setMainMapImage] = useState(null);
  
  // UI & View States
  const [globalZoom, setGlobalZoom] = useState(100);
  const [editingItem, setEditingItem] = useState(null);
  const [focusItem, setFocusItem] = useState(null);
  const [timeFilter, setTimeFilter] = useState('all');
  
  const [adminOpen, setAdminOpen] = useState(false);
  const [logs, setLogs] = useState([]);
  const [loadTime, setLoadTime] = useState(0);

  // --- ADMIN LOGGER & HELPERS ---
  const logEvent = (message, type = 'info', payload = null) => {
    setLogs(prev => [...prev, { time: new Date().toLocaleTimeString(), message, type, payload }]);
  };

  const handleCopyPayload = (payload) => {
    const text = JSON.stringify(payload, null, 2);
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
    } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
    }
  };

  useEffect(() => {
    // UI FAILSAFE: Inject Tailwind CSS dynamically
    if (!document.getElementById('tailwind-cdn')) {
      const script = document.createElement('script');
      script.id = 'tailwind-cdn';
      script.src = 'https://cdn.tailwindcss.com';
      document.head.appendChild(script);
    }

    const initializeData = async () => {
      const startTime = performance.now();
      logEvent('App initialized. Building component tree...', 'debug');

      try {
        let baseUrl = '';
        if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) {
            baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
            logEvent(`Detected Xrm Context. Base URL: ${baseUrl}`, 'debug');
        } else {
            logEvent(`Xrm Context not found. Will attempt relative fetch (Dev Mode).`, 'warn');
        }

        // 1. Fetch Live Map Data
        try {
            logEvent('Attempting live HTTP connection to Dataverse Map API...', 'debug');
            const mapResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5___mapses?$select=craa5___mapsid,craa5_facility`, {
                headers: { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' }
            });

            if (mapResponse.ok) {
                const data = await mapResponse.json();
                const mapRecord = data.value.find(r => (r.craa5_facility || r.craa5_Facility)?.toUpperCase() === 'MAIN') || data.value[0];
                
                if (mapRecord) {
                    const recordId = mapRecord.craa5___mapsid || mapRecord.craa5___mapsId;
                    const imageUrl = `${baseUrl}/api/data/v9.2/craa5___mapses(${recordId})/craa5_mapimage/$value?size=full`;
                    logEvent(`Found live map record. Fetching full-res blob: ${imageUrl}`, 'info');
                    
                    const imgResponse = await fetch(imageUrl);
                    if (imgResponse.ok) {
                        const blob = await imgResponse.blob();
                        setMainMapImage(URL.createObjectURL(blob));
                        logEvent(`Success: Map Blob loaded (${(blob.size/1024).toFixed(2)} KB).`, 'success');
                    } else {
                        logEvent(`Failed to download map blob. Status: ${imgResponse.status}`, 'error');
                    }
                } else {
                    logEvent('No maps found in live table.', 'warn');
                }
            } else {
                logEvent(`Map API returned status: ${mapResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Map Live Fetch Failed: ${error.message}`, 'error');
        }

        // 2. Fetch Live Observations Data
        try {
            logEvent('Querying live observations from facilityobservations API...', 'debug');
            const obsResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5__facilityobservations?$select=craa5__facilityobservationid,craa5_mapx,craa5_mapy,craa5__boxwidth,craa5__boxheight,craa5__room,craa5__area,craa5__equipment,craa5__description,craa5__whotonotify,craa5__customnote,createdon&$expand=createdby($select=fullname)&$orderby=createdon desc`, {
                headers: { 
                  'Accept': 'application/json', 
                  'OData-MaxVersion': '4.0', 
                  'OData-Version': '4.0',
                  'Prefer': 'odata.include-annotations="*"'
                }
            });

            if (obsResponse.ok) {
               const obsData = await obsResponse.json();
               const mappedObs = obsData.value.map(item => ({
                  id: item.craa5__facilityobservationid,
                  mapX: item.craa5_mapx || 0,
                  mapY: item.craa5_mapy || 0,
                  boxW: item.craa5__boxwidth || 10,
                  boxH: item.craa5__boxheight || 10,
                  room: item.craa5__room || '',
                  area: item.craa5__area || 'Unknown Area',
                  equipment: item.craa5__equipment || '',
                  description: item.craa5__description || '',
                  whoToNotify: item.craa5__whotonotify || '',
                  category: item.craa5__customnote || 'note', 
                  customNote: item.craa5__customnote || '',
                  submittedOn: item.createdon,
                  submittedBy: item.createdby ? item.createdby.fullname : (item['_createdby_value@OData.Community.Display.V1.FormattedValue'] || 'Unknown')
               }));
               setSubmissions(mappedObs);
               logEvent(`Successfully loaded ${mappedObs.length} live observations.`, 'success');
            } else {
               logEvent(`Observation API returned status: ${obsResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Observation Live Fetch Failed: ${error.message}`, 'error');
        }

      } catch (fatalError) {
        logEvent(`Fatal initialization error: ${fatalError.message}`, 'error');
      }

      const endTime = performance.now();
      setLoadTime((endTime - startTime).toFixed(2));
    };

    initializeData();
  }, []);

  // --- TIMEFRAME FILTERING LOGIC ---
  const filteredSubmissions = useMemo(() => {
    const now = new Date();
    return submissions.filter(sub => {
      if (timeFilter === 'all') return true;
      const subDate = new Date(sub.submittedOn);
      const diffHours = (now - subDate) / (1000 * 60 * 60);
      if (timeFilter === '24h') return diffHours <= 24;
      if (timeFilter === '7d') return diffHours <= 24 * 7;
      if (timeFilter === '30d') return diffHours <= 24 * 30;
      return true;
    });
  }, [submissions, timeFilter]);

  // Group logs for the 3 columns
  const infoLogs = logs.filter(l => l.type === 'info' || l.type === 'success').reverse();
  const debugLogs = logs.filter(l => l.type === 'debug' || l.type === 'warn' || l.type === 'error').reverse();
  const dataLogs = logs.filter(l => l.type === 'data').reverse();

  return (
    <div className="flex flex-col h-screen w-full bg-slate-50 text-slate-900 font-sans overflow-hidden" style={{ zoom: `${globalZoom}%` }}>
      {/* Header - Pinned via Sticky */}
      <header className="sticky top-0 z-[100] bg-blue-900 text-white shadow-md p-4 flex flex-col lg:flex-row gap-4 justify-between items-center shrink-0">
        <div className="flex items-center justify-between w-full lg:w-auto gap-3">
          <div className="flex items-center gap-3">
            <Activity className="w-8 h-8 text-blue-400" />
            <div>
              <h1 className="text-xl font-bold leading-tight">Facility Operations Tracker</h1>
              <p className="text-xs text-blue-300">Live Dataverse Connection</p>
            </div>
          </div>
          
          {/* Timeframe Filter (Mobile visible, Desktop hidden via flex order) */}
          <div className="lg:hidden flex items-center gap-2 bg-blue-800 p-1.5 rounded-lg border border-blue-700">
             <FilterIcon className="w-4 h-4 text-blue-300" />
             <select value={timeFilter} onChange={e => setTimeFilter(e.target.value)} className="bg-transparent text-sm text-white focus:outline-none cursor-pointer">
                <option value="all" className="text-slate-900">All Time</option>
                <option value="24h" className="text-slate-900">Last 24h</option>
                <option value="7d" className="text-slate-900">Last 7 Days</option>
                <option value="30d" className="text-slate-900">Last 30 Days</option>
             </select>
          </div>
        </div>
        
        <div className="flex items-center gap-4 w-full lg:w-auto overflow-x-auto hide-scrollbar pb-1 lg:pb-0">
          
          {/* Global Zoom Control */}
          <div className="hidden md:flex items-center gap-1 bg-blue-800 px-2 py-1.5 rounded-lg border border-blue-700 shrink-0">
             <button onClick={() => setGlobalZoom(z => Math.max(50, z - 10))} className="p-1 hover:bg-blue-700 text-blue-200 rounded transition-colors" title="Zoom Out App"><ZoomOut className="w-4 h-4" /></button>
             <span className="text-xs font-bold text-white min-w-[3.5rem] text-center">{globalZoom}%</span>
             <button onClick={() => setGlobalZoom(z => Math.min(200, z + 10))} className="p-1 hover:bg-blue-700 text-blue-200 rounded transition-colors" title="Zoom In App"><ZoomIn className="w-4 h-4" /></button>
          </div>

          {/* Timeframe Filter (Desktop) */}
          <div className="hidden lg:flex items-center gap-2 bg-blue-800 px-3 py-2 rounded-lg border border-blue-700 shrink-0">
             <FilterIcon className="w-4 h-4 text-blue-300" />
             <select value={timeFilter} onChange={e => setTimeFilter(e.target.value)} className="bg-transparent text-sm text-white focus:outline-none cursor-pointer">
                <option value="all" className="text-slate-900">All Time</option>
                <option value="24h" className="text-slate-900">Last 24h</option>
                <option value="7d" className="text-slate-900">Last 7 Days</option>
                <option value="30d" className="text-slate-900">Last 30 Days</option>
             </select>
          </div>

          {/* Tab Navigation */}
          <div className="flex bg-blue-800 rounded-lg p-1 shrink-0">
            <TabButton active={activeTab === 'overview'} onClick={() => { setActiveTab('overview'); logEvent('Navigated to Map Overview tab', 'info'); }} icon={<MapIcon />} label="Overview" />
            <TabButton active={activeTab === 'submit'} onClick={() => { setActiveTab('submit'); logEvent('Navigated to Submit Map tab', 'info'); }} icon={<MapPin />} label="Map Submission" />
            <TabButton active={activeTab === 'gallery'} onClick={() => { setActiveTab('gallery'); logEvent('Navigated to Gallery View tab', 'info'); }} icon={<ImageIcon />} label="Gallery" />
            <TabButton active={activeTab === 'table'} onClick={() => { setActiveTab('table'); logEvent('Navigated to Data Table tab', 'info'); }} icon={<TableIcon />} label="Data Table" />
          </div>

          {/* PERMANENT DEBUG CONSOLE BUTTON */}
          <button 
            onClick={() => {
              setAdminOpen(!adminOpen);
              if (!adminOpen) logEvent('Admin monitor opened', 'info');
            }}
            className={`flex items-center gap-2 px-4 py-2 rounded-lg font-bold shadow-md transition-colors text-sm shrink-0 ${adminOpen ? 'bg-yellow-500 text-slate-900 hover:bg-yellow-400' : 'bg-slate-800 text-yellow-400 hover:bg-slate-700 border border-slate-700'}`}
          >
            <Terminal className="w-4 h-4" />
            {adminOpen ? 'Close Debug' : 'Debug Console'}
          </button>
        </div>
      </header>

      {/* Main Content Area */}
      <main className={`flex-1 overflow-hidden relative transition-all duration-300 ${adminOpen ? 'pb-[40vh]' : 'pb-0'}`}>
        {activeTab === 'overview' && (
           <OverviewTab 
             submissions={filteredSubmissions} 
             logEvent={logEvent} 
             mapImage={mainMapImage} 
             setMainMapImage={setMainMapImage} 
             focusItem={focusItem} 
             setFocusItem={setFocusItem} 
             onEdit={(item) => { setEditingItem(item); setActiveTab('submit'); }}
           />
        )}
        {activeTab === 'submit' && (
           <SubmitTab 
             submissions={filteredSubmissions} 
             setSubmissions={setSubmissions} 
             logEvent={logEvent} 
             mapImage={mainMapImage} 
             setMainMapImage={setMainMapImage} 
             editingItem={editingItem}
             setEditingItem={setEditingItem}
           />
        )}
        {activeTab === 'gallery' && (
           <GalleryTab 
             submissions={filteredSubmissions} 
             logEvent={logEvent} 
             onEdit={(item) => { setEditingItem(item); setActiveTab('submit'); }}
           />
        )}
        {activeTab === 'table' && (
           <TableTab 
             submissions={filteredSubmissions} 
             mapImage={mainMapImage}
             onLocate={(item) => { setFocusItem(item); setActiveTab('overview'); }}
           />
        )}
      </main>

      {/* Admin Debug Panel (Collapsible Bottom Drawer) */}
      <div 
        className={`fixed bottom-0 left-0 right-0 bg-slate-950 text-slate-300 font-mono text-xs shadow-[0_-20px_50px_rgba(0,0,0,0.8)] flex flex-col z-[99999] border-t-4 border-yellow-500 transition-all duration-300 ease-in-out ${adminOpen ? 'h-[40vh] translate-y-0' : 'h-0 translate-y-full'}`}
      >
        <div className="flex justify-between items-center p-3 bg-slate-900 border-b border-slate-700 shrink-0">
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 text-yellow-400 font-bold text-sm">
              <Terminal className="w-5 h-5" />
              Live Dataverse Monitor
            </div>
            <div className="hidden sm:flex gap-2">
              <div className="px-3 py-1 bg-slate-800 rounded-full text-slate-400 border border-slate-700">
                Init Load: {loadTime}ms
              </div>
              <div className="px-3 py-1 bg-slate-800 rounded-full text-slate-400 border border-slate-700">
                Records: {submissions.length}
              </div>
            </div>
          </div>
          
          <div className="flex items-center gap-3">
            <button onClick={() => setAdminOpen(false)} className="text-slate-400 hover:text-white p-1 hover:bg-slate-800 rounded">
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        <div className="flex-1 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-800 overflow-hidden">
          {/* Column 1: Info Log */}
          <div className="flex flex-col h-full overflow-hidden">
            <div className="bg-slate-900 p-2 text-slate-400 font-semibold border-b border-slate-800 shrink-0 flex items-center justify-between">
              <span>Information Log</span>
              <span className="text-[10px] bg-slate-800 px-2 py-0.5 rounded">{infoLogs.length} events</span>
            </div>
            <div className="flex-1 overflow-y-auto p-2 space-y-1">
              {infoLogs.map((log, i) => (
                <div key={i} className={`flex gap-2 ${log.type === 'success' ? 'text-green-400' : 'text-slate-300'}`}>
                  <span className="text-blue-500 shrink-0">[{log.time}]</span>
                  <span className="break-words">{log.message}</span>
                </div>
              ))}
              {infoLogs.length === 0 && <div className="text-slate-600 italic">No info events logged.</div>}
            </div>
          </div>

          {/* Column 2: Debug Console */}
          <div className="flex flex-col h-full overflow-hidden">
            <div className="bg-slate-900 p-2 text-yellow-500 font-semibold border-b border-slate-800 shrink-0 flex items-center justify-between">
              <span>API Error & Warning Log</span>
              <span className="text-[10px] bg-slate-800 px-2 py-0.5 rounded">{debugLogs.length} events</span>
            </div>
            <div className="flex-1 overflow-y-auto p-2 space-y-2">
              {debugLogs.map((log, i) => (
                <div key={i} className={`flex flex-col border-b border-slate-800/50 pb-2 ${log.type === 'error' ? 'text-red-400' : log.type === 'warn' ? 'text-orange-400' : 'text-yellow-300/80'}`}>
                  <div className="flex gap-2">
                    <span className="opacity-70 shrink-0">[{log.time}]</span>
                    <span className="break-words">{log.message}</span>
                  </div>
                  {log.payload && (
                    <div className="mt-2 ml-14">
                      <button onClick={() => handleCopyPayload(log.payload)} className="flex items-center gap-1 mb-1 px-2 py-1 bg-slate-800 hover:bg-slate-700 text-blue-400 rounded text-[10px] transition-colors w-max border border-slate-700">
                        <CopyIcon className="w-3 h-3" /> Copy Error Payload JSON
                      </button>
                      <pre className="text-[10px] text-slate-500 whitespace-pre-wrap max-h-24 overflow-y-auto bg-slate-950 p-2 rounded border border-slate-800">
                        {JSON.stringify(log.payload, null, 2)}
                      </pre>
                    </div>
                  )}
                </div>
              ))}
              {debugLogs.length === 0 && <div className="text-slate-600 italic">No debug events logged.</div>}
            </div>
          </div>

          {/* Column 3: Data Submission Console */}
          <div className="flex flex-col h-full overflow-hidden bg-[#0A0A0A]">
            <div className="bg-slate-900 p-2 text-green-400 font-semibold border-b border-slate-800 shrink-0 flex items-center justify-between">
              <span>Dataverse Outbound REST Console</span>
              <span className="text-[10px] bg-slate-800 px-2 py-0.5 rounded text-slate-300">{dataLogs.length} requests</span>
            </div>
            <div className="flex-1 overflow-y-auto p-3 space-y-4">
              {dataLogs.map((log, i) => (
                <div key={i} className="bg-slate-900 p-2 rounded border border-slate-800 shadow-inner">
                  <div className="flex justify-between items-start mb-2 border-b border-slate-800 pb-2">
                    <div className="flex gap-2 text-green-300">
                      <span className="text-green-600 shrink-0">[{log.time}]</span>
                      <span className="font-bold">{log.message}</span>
                    </div>
                    <button onClick={() => handleCopyPayload(log.payload)} className="flex items-center gap-1 px-2 py-1 bg-slate-800 hover:bg-slate-700 text-blue-400 rounded text-[10px] transition-colors shrink-0 border border-slate-700 shadow-sm" title="Copy exact JSON payload">
                      <CopyIcon className="w-3 h-3" /> Copy Payload
                    </button>
                  </div>
                  <pre className="text-[10px] text-green-500/80 whitespace-pre-wrap font-mono mt-2">
                    {`${log.message.includes('PATCH') ? 'PATCH' : 'POST'} /api/data/v9.2/${DATAVERSE_SCHEMA.TableName}\nHost: mock-dataverse-env.crm.dynamics.com\nContent-Type: application/json\n\n`}
                    {JSON.stringify(log.payload, null, 2)}
                  </pre>
                </div>
              ))}
              {dataLogs.length === 0 && (
                <div className="text-slate-600 italic flex flex-col items-center justify-center h-full text-center p-4">
                  <Download className="w-8 h-8 mb-2 opacity-20" />
                  No outbound data submissions yet.<br/>Submit or edit a form to view exact REST payloads here.
                </div>
              )}
            </div>
          </div>

        </div>
      </div>
    </div>
  );
}

// --- TAB COMPONENT LOGIC ---

function TabButton({ active, icon, label, onClick }) {
  return (
    <button
      onClick={onClick}
      className={`flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium transition-all whitespace-nowrap ${
        active ? 'bg-white text-blue-900 shadow' : 'text-blue-100 hover:bg-blue-700'
      }`}
    >
      {React.cloneElement(icon, { className: "w-4 h-4" })}
      {label}
    </button>
  );
}

// ==========================================
// SHARED MAP ZOOM CONTROLS
// ==========================================
function ZoomControls({ zoomLevel, setZoomLevel }) {
  return (
    <div className="absolute bottom-4 right-4 bg-white rounded-lg shadow-lg flex items-center border border-slate-200 z-10">
      <button 
        onClick={() => setZoomLevel(prev => Math.max(50, prev - 25))} 
        className="p-2 hover:bg-slate-100 text-slate-700 rounded-l-lg transition-colors"
        title="Zoom Out"
      >
        <ZoomOut className="w-5 h-5" />
      </button>
      <span className="px-3 text-sm font-bold text-slate-700 border-x border-slate-200 min-w-[3.5rem] text-center">
        {zoomLevel}%
      </span>
      <button 
        onClick={() => setZoomLevel(prev => Math.min(500, prev + 25))} 
        className="p-2 hover:bg-slate-100 text-slate-700 rounded-r-lg transition-colors"
        title="Zoom In"
      >
        <ZoomIn className="w-5 h-5" />
      </button>
    </div>
  );
}


// ==========================================
// SHARED DETAIL MODAL
// ==========================================
function DetailModal({ selectedItem, onClose, onEdit }) {
  if (!selectedItem) return null;
  
  return (
    <div className="fixed inset-0 bg-slate-900/80 backdrop-blur-sm flex justify-center items-center z-[60] p-4 sm:p-8" onClick={onClose}>
      <div className="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-full overflow-hidden flex flex-col md:flex-row animate-in fade-in zoom-in duration-200" onClick={e => e.stopPropagation()}>
        {/* Image Side */}
        <div className="md:w-1/2 bg-slate-100 border-r border-slate-200 flex items-center justify-center relative min-h-[250px]">
          {selectedItem.image ? (
             <img src={selectedItem.image} alt="Enlarged" className="w-full h-full object-contain" />
          ) : (
             <div className="text-center text-slate-400">
                <ImageIcon className="w-16 h-16 mx-auto mb-2 opacity-50" />
                <p>No Image Provided</p>
             </div>
          )}
          <div className="absolute top-4 left-4">
             <span className="bg-slate-900/70 backdrop-blur text-white px-3 py-1 rounded-full text-sm font-medium capitalize shadow-sm">
                {selectedItem.category === 'note' ? `Note: ${selectedItem.customNote}` : selectedItem.category}
             </span>
          </div>
        </div>
        
        {/* Detail Side */}
        <div className="md:w-1/2 flex flex-col h-full bg-white relative">
          
          <div className="absolute top-4 right-4 flex gap-2 z-10">
            {onEdit && (
              <button onClick={() => onEdit(selectedItem)} className="text-slate-500 hover:text-blue-600 bg-slate-100 hover:bg-slate-200 rounded-full p-1.5 transition-colors shadow-sm border border-slate-200" title="Edit Observation">
                <PencilIcon className="w-4 h-4" />
              </button>
            )}
            <button onClick={onClose} className="text-slate-500 hover:text-red-500 bg-slate-100 hover:bg-slate-200 rounded-full p-1.5 transition-colors shadow-sm border border-slate-200">
              <X className="w-4 h-4" />
            </button>
          </div>
          
          <div className="p-8 overflow-y-auto">
            <h3 className="text-2xl font-bold text-slate-800 mb-6 border-b pb-4">Observation Details</h3>
            
            <div className="space-y-4">
              <DetailRow label="Description" value={selectedItem.description} />
              
              <div className="grid grid-cols-2 gap-4 pt-2">
                <DetailRow label="Room" value={selectedItem.room || 'N/A'} />
                <DetailRow label="Area" value={selectedItem.area} />
                <DetailRow label="Equipment" value={selectedItem.equipment || 'N/A'} />
                <DetailRow label="Notify" value={selectedItem.whoToNotify || 'N/A'} />
              </div>

              <div className="border-t border-slate-100 pt-4 mt-4 grid grid-cols-2 gap-4 text-sm">
                <div>
                  <span className="block text-slate-400 mb-1">Submitted By</span>
                  <span className="font-medium text-slate-700">{selectedItem.submittedBy}</span>
                </div>
                <div>
                  <span className="block text-slate-400 mb-1">Date</span>
                  <span className="font-medium text-slate-700">{new Date(selectedItem.submittedOn).toLocaleString()}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

function DetailRow({ label, value }) {
  return (
    <div>
      <span className="block text-sm font-medium text-slate-500 mb-1">{label}</span>
      <p className="text-slate-800 font-medium whitespace-pre-wrap">{value}</p>
    </div>
  );
}

// ==========================================
// TAB 0: MAP OVERVIEW
// ==========================================
function OverviewTab({ submissions, logEvent, mapImage, setMainMapImage, focusItem, setFocusItem, onEdit }) {
  const [selectedItem, setSelectedItem] = useState(null);
  const [zoomLevel, setZoomLevel] = useState(100);
  const containerRef = useRef(null);

  // Handle auto-focus double clicking from the table or sidebar
  useEffect(() => {
    if (focusItem && containerRef.current) {
        logEvent(`Centering overview map on observation ID: ${focusItem.id}`, 'debug');
        setZoomLevel(300);
        setSelectedItem(focusItem);
        
        setTimeout(() => {
            if (containerRef.current) {
                const scrollW = containerRef.current.scrollWidth;
                const scrollH = containerRef.current.scrollHeight;
                const x = (focusItem.mapX / 100) * scrollW;
                const y = (focusItem.mapY / 100) * scrollH;
                
                containerRef.current.scrollTo({
                    left: x - containerRef.current.clientWidth / 2,
                    top: y - containerRef.current.clientHeight / 2,
                    behavior: 'smooth'
                });
            }
            setFocusItem(null); 
        }, 100);
    }
  }, [focusItem, setFocusItem, logEvent]);

  const handleImageError = () => {
    logEvent('Browser failed to natively render the Base64 Map Image payload. Dropping to SVG fallback.', 'error');
    setMainMapImage(null); 
  };

  return (
    <div className="h-full flex flex-col md:flex-row bg-slate-100 p-4 md:p-6 overflow-hidden gap-4">
      
      {/* Map Content Container */}
      <div className="flex-1 flex flex-col overflow-hidden relative">
        <div className="mb-4 shrink-0">
          <h2 className="text-2xl font-bold text-slate-800">Facility Map Overview</h2>
          <p className="text-sm text-slate-500">Holistic view of all reported items across the facility.</p>
        </div>
        
        {/* Zoomable Container */}
        <div className="flex-1 relative rounded-xl shadow-inner border border-slate-400/50 bg-slate-300 overflow-auto" ref={containerRef}>
          <div 
            className="relative mx-auto transition-all origin-top-left"
            style={{ width: `${zoomLevel}%`, minWidth: '100%' }}
          >
            {mapImage ? (
              <img src={mapImage} onError={handleImageError} alt="Main Facility Map" className="w-full h-auto block pointer-events-none select-none" draggable="false" />
            ) : (
              <div className="w-full aspect-square"><FacilityMapSvg /></div>
            )}
            
            {/* Render Flags mapped via percentage overlays */}
            {submissions.map(sub => (
              <div 
                key={sub.id} 
                className="absolute transform -translate-x-1/2 -translate-y-[90%] cursor-pointer group"
                style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%` }}
                onClick={() => {
                  logEvent(`Map overview flag clicked. ID: ${sub.id}`, 'info');
                  setSelectedItem(sub);
                }}
              >
                <FlagIcon className="w-6 h-6 md:w-8 md:h-8 text-red-600 drop-shadow-md group-hover:scale-125 transition-transform origin-bottom" fill="#ef4444" />
                
                {/* Tooltip */}
                <div className="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 bg-slate-900/90 backdrop-blur text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap shadow-lg transition-opacity z-20">
                  <span className="font-bold block capitalize border-b border-slate-700 mb-0.5 pb-0.5">
                    {sub.category === 'note' ? 'Note' : sub.category}
                  </span>
                  <span className="text-slate-300">{sub.area}</span>
                </div>
              </div>
            ))}

            {submissions.length === 0 && (
              <div className="absolute inset-0 flex items-center justify-center text-slate-500 font-medium bg-white/50 backdrop-blur-sm">
                 No reports submitted yet.
              </div>
            )}
          </div>
          
          <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
        </div>
      </div>

      {/* Issues Sidebar */}
      <div className="w-full md:w-72 lg:w-80 bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden shrink-0 mt-4 md:mt-0 h-[30vh] md:h-full">
         <div className="p-3 bg-slate-50 border-b border-slate-200 font-bold text-slate-700 flex justify-between items-center shrink-0">
            <span>Recent Issues</span>
            <span className="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full">{submissions.length}</span>
         </div>
         <div className="flex-1 overflow-y-auto p-2 space-y-2">
            {submissions.slice().sort((a,b) => new Date(b.submittedOn) - new Date(a.submittedOn)).map(sub => (
               <div 
                 key={sub.id} 
                 onClick={() => {
                     logEvent(`Sidebar clicked. Jumping to issue: ${sub.id}`, 'info');
                     setFocusItem(sub);
                 }}
