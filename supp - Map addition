        {!typing && (
          <button type="button" onClick={() => { setTyping(true); setText(typed || ''); }} className="px-2 py-0.5 rounded font-bold border border-slate-300 bg-white text-[#00468B] hover:bg-slate-50" data-testid={testId ? `${testId}-type` : undefined}>
