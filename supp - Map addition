// Closed = Inactive (statecode 1, Status Reason 2); Open = Active (statecode 0, Status Reason 1). A table with its own
// Status Reasons may refuse those numbers, so a 400 retries with the state alone and Dataverse picks that state's default reason.
async function saveStatus(id, closed, logEvent) {
  const path = `${DATAVERSE_SCHEMA.TableName}(${id})`;
  const send = async (body) => {
    logEvent(`PATCH ${closed ? 'close' : 'reopen'} ${id}`, 'data', body, { method: 'PATCH', path, contentType: 'application/json' });
    return fetch(apiUrl(path), {
      method: 'PATCH',
      headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json', 'If-Match': '*' },
      body: JSON.stringify(body)
    });
  };
  let res = await send(closed ? { statecode: 1, statuscode: 2 } : { statecode: 0, statuscode: 1 });
  if (res.status === 400) {
    logEvent(`Status change with a Status Reason was refused: ${await readApiError(res)}. Retrying with the state only.`, 'warn');
    res = await send({ statecode: closed ? 1 : 0 });
  }
  if (res.status === 404) throw new Error('this observation no longer exists in Dataverse (HTTP 404)');
  if (!res.ok) throw new Error(await readApiError(res));
}

