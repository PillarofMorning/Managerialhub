    <div className="h-full flex flex-col md:flex-row bg-slate-100 p-4 md:p-6 overflow-hidden gap-4">
      
      {/* Map Content Container */}
      <div className="flex-1 flex flex-col overflow-hidden relative">
        <div className="mb-4 shrink-0">
          <h2 className="text-2xl font-bold text-slate-800">Facility Map Overview</h2>
          <p className="text-sm text-slate-500">Holistic view of all reported items across the facility.</p>
        </div>
        <CategoryFilterBar {...categoryBar} className="mb-3 shrink-0" />
        
        {/* Zoomable Container */}
        <div className="flex-1 relative rounded-xl shadow-inner border border-slate-400/50 bg-slate-300 overflow-auto" ref={containerRef}>
          <div 
            className={`relative mx-auto origin-top-left ${jumping ? '' : 'transition-all'}`}
            style={{ width: `${zoomLevel}%`, minWidth: '100%' }}
          >
            {mapImage ? (
              <img src={mapImage} onError={handleImageError} alt="Main Facility Map" className="w-full h-auto block pointer-events-none select-none" draggable="false" />
            ) : (
              <div className="w-full aspect-square"><FacilityMapSvg /></div>
            )}
            
            {/* Render Flags mapped via percentage overlays */}
            {submissions.map(sub => {
              const flagColor = categoryMeta(sub.category).color;
              return (
                <div 
                  key={sub.id} 
                  className="absolute transform -translate-x-1/2 -translate-y-[90%] cursor-pointer group"
                  style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%` }}
                  onClick={() => {
                    logEvent(`Map overview flag clicked. ID: ${sub.id}`, 'info');
                    setSelectedItem(sub);
                  }}
                >
                  <FlagIcon className="w-6 h-6 md:w-8 md:h-8 drop-shadow-md group-hover:scale-125 transition-transform origin-bottom" style={{ color: flagColor }} fill={flagColor} />
                  
                  {/* Tooltip */}
                  <div className="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 bg-slate-900/90 backdrop-blur text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap shadow-lg transition-opacity z-20">
                    <span className="font-bold block border-b border-slate-700 mb-0.5 pb-0.5">
                      {categoryMeta(sub.category).label}
                    </span>
                    <span className="text-slate-300">{sub.area}</span>
