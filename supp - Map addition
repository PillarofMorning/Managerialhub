      setAssetMeta(prev => ({ ...prev, status: 'error', error: error.message, fields: [], mapColumn: ASSET_MAP_COLUMN ? { name: ASSET_MAP_COLUMN, maxLength: null } : null, mapReason: `the Assets table's columns could not be read (${error.message}).` }));
    }
