// --- PICTURES ---
// Logical name of the Image (or File) column that holds an observation's picture on craa5__facilityobservation.
// Leave it null and the app finds the table's picture column itself; pin it (e.g. 'craa5_picture') if the table has more than one.
const PICTURE_COLUMN = null;
const OBSERVATION_LOGICAL_NAME = 'craa5__facilityobservation';
const ODATA_HEADERS = { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' };
const PICTURE_NAME_HINT = /pic|photo|image|upload|attach/i;

const apiUrl = (path) => {
  let baseUrl = '';
  try {
    if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
  } catch (e) { /* same-origin relative URL */ }
  return `${baseUrl}/api/data/v9.2/${path}`;
};

const readApiError = async (res) => {
  let text = '';
  try { text = await res.text(); } catch (e) { /* no body */ }
  try {
    const parsed = JSON.parse(text);
    if (parsed && parsed.error && parsed.error.message) return `${parsed.error.message} (HTTP ${res.status})`;
  } catch (e) { /* not JSON */ }
  return text ? `${text.slice(0, 300)} (HTTP ${res.status})` : `HTTP ${res.status}`;
};

// Finds the column pictures are stored in: { ready, name, type: 'image' | 'file' | null, reason }
async function detectPictureColumn(logEvent) {
  const listColumns = async (cast) => {
    const res = await fetch(apiUrl(`EntityDefinitions(LogicalName='${OBSERVATION_LOGICAL_NAME}')/Attributes/Microsoft.Dynamics.CRM.${cast}?$select=LogicalName,SchemaName`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    return ((await res.json()).value || []).map(a => a.LogicalName).filter(Boolean);
  };

  const failures = [];
  const lookup = (cast) => listColumns(cast).catch(e => { failures.push(e.message); return []; });
  const [images, files] = await Promise.all([lookup('ImageAttributeMetadata'), lookup('FileAttributeMetadata')]);
  logEvent(`Picture column scan: image columns [${images.join(', ')}], file columns [${files.join(', ')}]`, failures.length ? 'warn' : 'debug', failures.length ? { failures } : null);

  if (PICTURE_COLUMN) {
    const type = images.includes(PICTURE_COLUMN) ? 'image' : (files.includes(PICTURE_COLUMN) ? 'file' : null);
    // Both lookups worked and neither lists the pinned column: it is a typo or the wrong kind of column
    if (!type && failures.length === 0) {
      return { ready: false, name: null, type: null, reason: `PICTURE_COLUMN "${PICTURE_COLUMN}" is not an Image or File column of ${OBSERVATION_LOGICAL_NAME}.` };
    }
    return { ready: true, name: PICTURE_COLUMN, type, reason: '' };
  }

  // Image columns before File columns; within a kind prefer a name like a picture, then any other custom column, then the system "entityimage"
  const candidates = [...images.map(name => ({ name, type: 'image' })), ...files.map(name => ({ name, type: 'file' }))];
  const rank = (c) => (c.type === 'file' ? 10 : 0) + (c.name === 'entityimage' ? 2 : (PICTURE_NAME_HINT.test(c.name) ? 0 : 1));
  candidates.sort((a, b) => rank(a) - rank(b));
  if (candidates.length > 0) {
    if (candidates.length > 1) logEvent(`Several picture columns found (${candidates.map(c => c.name).join(', ')}). Using ${candidates[0].name}. Set PICTURE_COLUMN at the top of the file to choose another.`, 'warn');
    return { ready: true, name: candidates[0].name, type: candidates[0].type, reason: '' };
  }
  if (failures.length > 0) {
    return { ready: false, name: null, type: null, reason: `the app could not look up the table's columns (${failures[0]}). Set PICTURE_COLUMN at the top of the file to the Image column's logical name.` };
  }
  return { ready: false, name: null, type: null, reason: `the ${OBSERVATION_LOGICAL_NAME} table has no Image or File column. Add an Image column (for example "Picture") in Dataverse.` };
}

// Extra $select fields that tell a row has a picture, tried in order. Selecting the image column itself would drag
// a base64 thumbnail into every row, and a wrong guess is a 400, so the list query steps down until one is accepted.
const pictureSelectOptions = (col, type) => {
  const imageStyle = [[`${col}_timestamp`], [`${col}_url`]];
  const fileStyle = [[`${col}_name`], [col]];
  const order = type === 'image' ? imageStyle : (type === 'file' ? fileStyle : [...imageStyle, ...fileStyle]);
  return [...order, []];
};

// true / false when the query returned a marker for the picture, null when it could not tell
const rowHasPicture = (row, fields) => {
  if (fields.length === 0) return null;
  return fields.some(f => {
    const v = row[f];
    return v !== null && v !== undefined && v !== '' && v !== 0 && v !== '0';
  });
};

// Stored pictures: full size first (needs "can store full image"), then the 144 px thumbnail Dataverse always keeps
const storedPictureUrls = (col, id) => ({
