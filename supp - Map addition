// ==========================================
// WHICH PROBLEMS ARE LOADED: every open one; closed ones page by page (newest closed first). Said plainly, with
// "Load older" and a search in Dataverse for older closed ones, so a search or a count never pretends to cover them.
// ==========================================
const TIMEFRAME_WORDS = { '24h': 'the last 24 hours', '7d': 'the last 7 days', '30d': 'the last 30 days' };
function LoadedNote({ loaded, query, showClosed = true, className = '' }) {
  if (!loaded) return null;
  const w = loaded.window;
  if (w.status === 'loading') {
    return <div role="status" className={`text-xs text-slate-500 ${className}`} data-testid="loaded-note">Loading problems from Dataverse...</div>;
  }
  if (w.status === 'error') {
    return (
      <div role="alert" className={`text-xs text-[#C4001F] ${className}`} data-testid="loaded-note">
        Problems could not be loaded: {w.error}{' '}
        <button type="button" onClick={loaded.onRetry} className="font-bold underline">Try again</button>
      </div>
    );
  }
  const words = String(query || '').trim().split(/\s+/).filter(Boolean).slice(0, 6).join(' ');
  const search = loaded.search;
  const result = words && search && search.text === words ? search : null;
  const moreClosed = showClosed && !!w.closedNext;
  const offerSearch = !!words && !!w.closedNext && !result;
  if (!w.splitNote && !w.openCapped && !moreClosed && !w.olderError && !offerSearch && !result) return null;
  const within = TIMEFRAME_WORDS[loaded.timeFilter] ? `, submitted in ${TIMEFRAME_WORDS[loaded.timeFilter]}` : '';
  return (
    <div className={`text-xs text-slate-600 flex flex-wrap items-center gap-x-3 gap-y-1 ${className}`} data-testid="loaded-note">
      {w.splitNote && <span className="text-[#7A5200]">Problems are not split by map ({w.splitNote}): every problem shows on every map.</span>}
      {w.openCapped && <span className="text-[#7A5200]">Only the first {OPEN_MAX} open problems are loaded.</span>}
      {moreClosed && (
        <span data-testid="closed-window">
          Closed problems: the {loaded.closedLoaded} most recently closed{w.closedTotal !== null ? ` of ${w.closedTotal}${w.closedCapped ? '+' : ''}` : ''}{within} are loaded.{' '}
          <button type="button" onClick={loaded.onLoadOlder} disabled={w.olderBusy} className="font-bold text-[#0072CE] underline hover:text-[#00468B] disabled:opacity-50 disabled:cursor-wait" data-testid="load-older">
            {w.olderBusy ? 'Loading...' : `Load ${CLOSED_PAGE} older`}
          </button>
        </span>
      )}
      {w.olderError && <span className="text-[#C4001F]">Older closed problems could not be loaded: {w.olderError}</span>}
      {offerSearch && (
        <button type="button" onClick={() => loaded.onSearchOlder(words)} className="font-bold text-[#0072CE] underline hover:text-[#00468B]" data-testid="search-older">
          Also search older closed problems in Dataverse for "{words}"
        </button>
      )}
      {result && (
        <span data-testid="search-older-result" className={result.error ? 'text-[#C4001F]' : ''}>
          {result.busy ? 'Searching the older closed problems in Dataverse...'
            : result.error ? `The search in Dataverse could not run: ${result.error}`
            : result.found === 0 ? `No older closed problem matches "${result.text}".`
            : `${result.found}${result.more ? '+' : ''} closed problem${result.found === 1 ? '' : 's'} in Dataverse match "${result.text}"${result.added ? `; ${result.added} added to the lists` : ' (all were already here)'}.`}
        </span>
      )}
    </div>
  );
}

