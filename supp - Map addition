      {saveError && (
        <div className="text-sm bg-red-50 border border-red-200 text-red-800 rounded-lg p-3" role="alert">{saveError}</div>
      )}

      <div className="pt-4 flex justify-end">
        <button type="submit" disabled={saving || preparingPicture} className="bg-[#0072CE] text-white px-6 py-2 rounded-lg shadow hover:bg-[#00468B] focus:ring-4 focus:ring-[#0072CE]/30 transition-all font-medium text-lg disabled:opacity-60 disabled:cursor-not-allowed">
          {saving ? 'Saving...' : (editingItem ? 'Update Observation' : 'Submit Observation')}
        </button>
      </div>
    </form>
  );
}

// ==========================================
// EQUIPMENT PICKER: attach equipment from the equipment table (craa5_aa_assets) by search or by ticking a room's list.
// Every lookup is a filtered query of at most 100 rows; the equipment table is never loaded whole.
// ==========================================
const EMPTY_RESULTS = { mode: null, label: '', rows: [], loading: false, error: '', limit: 0, retry: null };

function EquipmentPicker({ value, onChange, onPlace, room, area, equipmentColumns, error, logEvent }) {
  const [text, setText] = useState('');
  const [results, setResults] = useState(EMPTY_RESULTS);
  const [notice, setNotice] = useState('');
  const requestRef = useRef(0);   // only the newest lookup may fill the list
  const modeRef = useRef(null);   // which kind of lookup the list shows: 'search' | 'place' | null
  const cacheRef = useRef({});    // lookups already answered, by mode + text
  const mountedRef = useRef(true);
  useEffect(() => { mountedRef.current = true; return () => { mountedRef.current = false; }; }, []);

  const run = useCallback(async (mode, key, label, limit, loader) => {
    const cacheKey = `${mode}|${key.toLowerCase()}`;
    const request = ++requestRef.current;
    modeRef.current = mode;
    const retry = () => { delete cacheRef.current[cacheKey]; run(mode, key, label, limit, loader); };
    if (cacheRef.current[cacheKey]) {
      setResults({ mode, label, rows: cacheRef.current[cacheKey], loading: false, error: '', limit, retry });
      return;
    }
    setResults(prev => ({ mode, label, rows: prev.mode === mode ? prev.rows : [], loading: true, error: '', limit, retry }));
    try {
      const rows = await loader();
      cacheRef.current[cacheKey] = rows;
      logEvent(`Equipment lookup (${label}): ${rows.length} found.`, 'debug');
      if (mountedRef.current && request === requestRef.current) setResults({ mode, label, rows, loading: false, error: '', limit, retry });
    } catch (err) {
      logEvent(`Equipment lookup failed (${label}): ${err.message}`, 'error');
      if (mountedRef.current && request === requestRef.current) setResults({ mode, label, rows: [], loading: false, error: err.message, limit, retry });
    }
  }, [logEvent]);

  // Search as the user types (a short pause first, at least 2 characters)
  useEffect(() => {
    const q = text.trim();
    if (q.length < 2) {
      // Clearing the search box closes a search list (and drops its pending answer), never a room list
      if (modeRef.current === 'search') {
        requestRef.current += 1;
        modeRef.current = null;
        setResults(EMPTY_RESULTS);
      }
      return undefined;
    }
    const timer = setTimeout(() => run('search', q, `Equipment matching "${q}"`, ASSET_SEARCH_LIMIT, () => searchAssets(q)), 300);
    return () => clearTimeout(timer);
  }, [text, run]);

  const placeLabel = [room.trim(), area.trim()].filter(Boolean).join(' / ');
  const listPlace = () => {
    if (!room.trim()) return;
    run('place', `${room.trim()}|${area.trim()}`, `Equipment in ${placeLabel}`, ASSET_PLACE_LIMIT, () => assetsInPlace(room, area));
  };

  const isAttached = (asset) => value.some(e => e.id && e.id === asset.id);

  const toggle = (asset) => {
    setNotice('');
    if (isAttached(asset)) {
      onChange(value.filter(e => e.id !== asset.id));
      return;
    }
    if (value.length >= MAX_EQUIPMENT) { setNotice(`At most ${MAX_EQUIPMENT} pieces of equipment per observation.`); return; }
    onChange(value.concat([{ id: asset.id, name: asset.name, room: asset.room, area: asset.area }]));
    onPlace(asset);
  };

  const typed = text.trim();
  const typedTaken = typed !== '' && value.some(e => e.name.toLowerCase() === typed.toLowerCase());
  const addText = () => {
    if (!typed || typedTaken) return;
    if (value.length >= MAX_EQUIPMENT) { setNotice(`At most ${MAX_EQUIPMENT} pieces of equipment per observation.`); return; }
    onChange(value.concat([{ id: '', name: typed.replace(/;/g, ','), room: '', area: '' }]));
    setText('');
    setNotice('');
  };

  const remove = (index) => { onChange(value.filter((e, i) => i !== index)); setNotice(''); };

  return (
    <div className="bg-[#F7F9FC] p-4 rounded-lg border border-[#B3D4F2]">
      <div className="flex flex-wrap items-baseline justify-between gap-2 mb-2">
        <label htmlFor="equipment-search" className="block text-sm font-bold text-[#00468B]">Equipment</label>
        <span className="text-xs text-slate-500">Attach the equipment this request is about. Search, or list the room's equipment and tick it.</span>
      </div>

      {value.length > 0 && (
        <ul className="flex flex-wrap gap-1.5 mb-3" aria-label="Attached equipment">
          {value.map((e, i) => (
            <li key={`${e.id || 'text'}-${i}`} className={`inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-md text-xs font-semibold border max-w-full ${e.id ? 'bg-white text-[#00468B] border-[#0072CE]/40' : 'bg-slate-100 text-slate-700 border-slate-300'}`} title={e.id ? [e.room, e.area].filter(Boolean).join(' / ') || 'Linked to the equipment table' : 'Typed text, not linked to the equipment table'}>
              <span className="[overflow-wrap:anywhere]">{e.name}</span>
              {!e.id && <span className="text-[10px] font-normal text-slate-500">(text)</span>}
              <button type="button" onClick={() => remove(i)} className="p-0.5 rounded hover:bg-[#FDE8EC] hover:text-[#C4001F]" aria-label={`Remove ${e.name}`}>
                <X className="w-3 h-3" />
              </button>
            </li>
          ))}
        </ul>
      )}

      <div className="flex flex-wrap gap-2">
        <div className="relative flex-1 min-w-[200px]">
          <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none" />
          <input
            id="equipment-search"
            type="search"
            value={text}
            onChange={e => setText(e.target.value)}
            onKeyDown={e => { if (e.key === 'Enter') e.preventDefault(); }}
            placeholder="Search equipment by name, room or area..."
            autoComplete="off"
            className="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]"
          />
        </div>
        <button type="button" onClick={listPlace} disabled={!room.trim()} title={room.trim() ? `List the equipment in ${placeLabel}` : 'Fill in the Room first'}
          className="px-3 py-2 rounded-md text-xs font-bold uppercase tracking-wider bg-white text-[#0072CE] border border-[#B3D4F2] hover:bg-[#E6F1FB] disabled:opacity-50 disabled:cursor-not-allowed">
          {room.trim() ? `List ${placeLabel}` : 'List room equipment'}
        </button>
        <button type="button" onClick={addText} disabled={!typed || typedTaken} title="Attach what you typed as text, without a link to the equipment table"
          className="px-3 py-2 rounded-md text-xs font-bold uppercase tracking-wider bg-white text-slate-600 border border-slate-300 hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed">
          Add as text
        </button>
      </div>

      {results.mode && (
        <div className="mt-3 bg-white border border-slate-200 rounded-md">
          <div className="flex items-center justify-between gap-2 px-3 py-2 border-b border-slate-100">
            <span className="text-xs font-bold text-[#00468B] [overflow-wrap:anywhere]">{results.label}</span>
            <button type="button" onClick={() => { requestRef.current += 1; modeRef.current = null; setResults(EMPTY_RESULTS); }} className="text-xs font-semibold text-[#0072CE] hover:underline shrink-0">Done</button>
          </div>
          <div role="status" className="sr-only">{results.loading ? 'Looking up equipment' : `${results.rows.length} equipment found`}</div>
          {results.loading && <p className="px-3 py-2 text-xs text-slate-500">Looking up equipment...</p>}
          {results.error && (
            <p className="px-3 py-2 text-xs text-[#C4001F]" role="alert">
              The equipment table did not answer: {results.error}{' '}
              {results.retry && <button type="button" onClick={results.retry} className="underline font-semibold">Retry</button>}
            </p>
          )}
          {!results.loading && !results.error && results.rows.length === 0 && (
            <p className="px-3 py-2 text-xs text-slate-500">No equipment found. You can still attach what you typed with Add as text.</p>
          )}
          {results.rows.length > 0 && (
            <ul className="max-h-60 overflow-y-auto divide-y divide-slate-100">
              {results.rows.map(asset => (
                <li key={asset.id}>
                  <label className="flex items-start gap-2 px-3 py-2 cursor-pointer hover:bg-[#E6F1FB]">
                    <input type="checkbox" className="mt-0.5 accent-[#0072CE]" checked={isAttached(asset)} onChange={() => toggle(asset)} />
                    <span className="min-w-0">
                      <span className="block text-sm font-medium text-slate-800 [overflow-wrap:anywhere]">{asset.name}</span>
                      <span className="block text-[11px] text-slate-500">{[asset.room, asset.area].filter(Boolean).join(' / ') || 'No room / area'}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          )}
          {!results.loading && results.rows.length >= results.limit && results.limit > 0 && (
            <p className="px-3 py-2 text-[11px] text-slate-500 border-t border-slate-100">Showing the first {results.limit}. {results.mode === 'search' ? 'Type more of the name to narrow it down.' : 'Search by name to find the rest.'}</p>
          )}
        </div>
      )}

      {notice && <p className="text-xs text-[#8A5A00] mt-2" role="alert">{notice}</p>}
      {error && <p className="text-red-600 text-xs mt-2" role="alert">{error}</p>}
      {!equipmentColumns.idColumn && (
        <p className="text-[11px] text-slate-500 mt-2">Equipment is saved by name: {equipmentColumns.reason}</p>
      )}
    </div>
  );
}

