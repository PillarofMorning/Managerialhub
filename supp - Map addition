// Where a point of the picture lands on the turned map, and back (fractions 0..1; turns are clockwise)
const turnPoint = (rotation, x, y) => {
  if (rotation === 90) return [1 - y, x];
  if (rotation === 180) return [1 - x, 1 - y];
  if (rotation === 270) return [y, 1 - x];
  return [x, y];
};
const unturnPoint = (rotation, u, v) => {
  if (rotation === 90) return [v, 1 - u];
  if (rotation === 180) return [1 - u, 1 - v];
  if (rotation === 270) return [1 - v, u];
  return [u, v];
};
const clamp01 = (n) => Math.max(0, Math.min(1, n));

