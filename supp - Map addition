// Close / Reopen button with its own saving state and error
function CloseButton({ item, onSetClosed, compact = false }) {
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
  if (!onSetClosed) return null;
  const toggle = async (e) => {
    // The second click of a double-click would undo the first once a fast save has returned
    if (busy || (e && e.detail > 1)) return;
    setBusy(true);
    setError('');
    const reason = await onSetClosed(item, !item.closed);
    if (!mounted.current) return;
    setBusy(false);
    if (reason) setError(`Not saved: ${reason}`);
  };
  const size = compact ? 'px-3 py-1.5 text-xs' : 'px-4 py-2 text-sm';
  return (
    <span className="inline-flex flex-col items-start gap-1">
      <button
        type="button"
        onClick={toggle}
        disabled={busy}
        className={`inline-flex items-center gap-1.5 ${size} rounded-md font-semibold border shadow-sm disabled:opacity-60 disabled:cursor-wait ${item.closed ? 'bg-white text-slate-700 border-slate-300 hover:bg-slate-100' : 'bg-green-700 text-white border-green-700 hover:bg-green-800'}`}
      >
        <CheckCircle className={compact ? 'w-3.5 h-3.5' : 'w-4 h-4'} />
        {busy ? 'Saving...' : (item.closed ? 'Reopen' : 'Mark closed')}
      </button>
      {error && <span className="text-xs text-[#C4001F] max-w-xs" role="alert">{error}</span>}
    </span>
  );
}

// ==========================================
// SHARED DETAIL MODAL
// ==========================================
function DetailModal({ selectedItem, onClose, onEdit, onSetClosed }) {
  const dialogRef = useRef(null);
  const onCloseRef = useRef(onClose);
  onCloseRef.current = onClose;
  const isOpen = !!selectedItem;
  // Escape closes the window (capture phase: before a focused search box behind it would clear itself), and focus moves in
  useEffect(() => {
    if (!isOpen) return undefined;
    const previous = document.activeElement;
    const onKey = (e) => {
      if (e.key === 'Escape' || e.key === 'Esc') {
        e.preventDefault();
        e.stopPropagation();
        onCloseRef.current();
      }
    };
    document.addEventListener('keydown', onKey, true);
    if (dialogRef.current) dialogRef.current.focus();
    return () => {
      document.removeEventListener('keydown', onKey, true);
      if (previous && previous.focus && document.body.contains(previous)) previous.focus();
    };
  }, [isOpen]);
  if (!selectedItem) return null;
  const equipmentList = selectedItem.equipmentList || [];

  return (
    <div className="fixed inset-0 bg-slate-900/80 backdrop-blur-sm flex justify-center items-center z-[120] p-4 sm:p-8" onClick={onClose}>
      <div ref={dialogRef} tabIndex={-1} role="dialog" aria-modal="true" aria-label="Observation details" className="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-full overflow-y-auto md:overflow-hidden flex flex-col md:flex-row focus:outline-none animate-in fade-in zoom-in duration-200" onClick={e => e.stopPropagation()}>
        {/* Image Side */}
        <div className="md:w-1/2 bg-slate-100 border-r border-slate-200 flex items-center justify-center relative min-h-[250px]">
          <StoredImage
            sources={pictureSources(selectedItem)}
            alt="Enlarged"
            className="w-full h-full object-contain"
            fallback={(
              <div className="text-center text-slate-400">
                <ImageIcon className="w-16 h-16 mx-auto mb-2 opacity-50" />
                <p>No Image Provided</p>
              </div>
            )}
          />
          <div className="absolute top-4 left-4">
             <span className="bg-slate-900/70 backdrop-blur text-white px-3 py-1 rounded-full text-sm font-medium shadow-sm">
                {categoryText(selectedItem)}
             </span>
          </div>
        </div>
        
        {/* Detail Side */}
        <div className="md:w-1/2 flex flex-col md:min-h-0 bg-white relative">
          
          <div className="absolute top-4 right-4 flex gap-2 z-10">
            {onEdit && (
              <button onClick={() => onEdit(selectedItem)} className="text-slate-500 hover:text-[#0072CE] bg-slate-100 hover:bg-slate-200 rounded-full p-1.5 transition-colors shadow-sm border border-slate-200" title="Edit Observation">
                <PencilIcon className="w-4 h-4" />
              </button>
            )}
            <button onClick={onClose} className="text-slate-500 hover:text-red-500 bg-slate-100 hover:bg-slate-200 rounded-full p-1.5 transition-colors shadow-sm border border-slate-200">
              <X className="w-4 h-4" />
            </button>
          </div>
          
          <div className="p-8 md:flex-1 md:min-h-0 md:overflow-y-auto">
            <h3 className="text-2xl font-black text-[#00468B] mb-6 border-b-2 border-[#E6F1FB] pb-4 pr-16 flex flex-wrap items-center gap-2">
              Observation Details <StatusBadge item={selectedItem} />
            </h3>

            <div className="space-y-4">
              <DetailRow label="Description" value={selectedItem.description} />

              <div className="grid grid-cols-2 gap-4 pt-2">
                <DetailRow label="Room" value={selectedItem.room || 'N/A'} />
                <DetailRow label="Area" value={selectedItem.area} />
                <DetailRow label="Notify" value={selectedItem.whoToNotify || 'N/A'} />
              </div>

              <div>
                <span className="block text-sm font-medium text-slate-500 mb-1">Equipment</span>
                {equipmentList.length === 0 ? (
                  <p className="text-slate-800 font-medium">N/A</p>
