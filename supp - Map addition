              // No picture (yet): a plain panel and, once known, why - never a made-up drawing that looks like the real map
              <div className="w-full aspect-[4/3] bg-slate-200 flex items-start justify-center p-4" data-testid="map-missing">
                {mapPicture && mapPicture.status === 'loading'
                  ? <span className="mt-8 text-sm font-semibold text-slate-500">Loading the map picture...</span>
                  : <MapNote note={(mapPicture && mapPicture.note) || 'There is no map picture to show.'} className="max-w-xl text-sm" />}
              </div>
            )}

            {/* Equipment on this map: dots under the problem flags. A tap shows the name and "Open in Asset Map". */}
            {pins.map(pin => {
              const key = `a:${pin.id}`;
              const open = tapped === key;
              const named = open || layers.labels;
              return (
                <div key={pin.id} className={`absolute group ${open ? 'z-30' : 'z-[5]'}`} style={{ left: `${pin.location.x}%`, top: `${pin.location.y}%`, transform: 'translate(-50%, -50%)' }} data-overview-pin={pin.id}>
                  <button
                    type="button"
                    aria-label={`Equipment ${pin.name}`}
                    aria-expanded={open}
                    onClick={(e) => { e.stopPropagation(); setTapped(open ? null : key); if (!open) logEvent(`Equipment dot tapped on the overview: ${pin.name}`, 'info'); }}
                    className="block p-1"
                  >
                    <span className={`block rounded-full border-2 shadow transition-transform ${open ? 'w-4 h-4 bg-[#FFB81C] border-[#00468B]' : 'w-3 h-3 bg-[#0072CE] border-white group-hover:scale-125'}`} />
                  </button>
                  <div
                    onClick={e => e.stopPropagation()}
                    className={`absolute bottom-full mb-0.5 left-1/2 -translate-x-1/2 bg-slate-900/90 text-white text-xs text-left px-2 py-1 rounded w-max max-w-[16rem] break-words shadow-lg ${open ? 'block' : (named ? 'block pointer-events-none' : 'hidden group-hover:block pointer-events-none')}`}
                    style={{ transform: 'translateX(-50%)' }}
                    data-testid={named ? 'map-label' : undefined}
                  >
                    <span className="font-bold block">{pin.name}</span>
                    {open && (pin.room || pin.area) && <span className="text-slate-300 block">{[pin.room, pin.area].filter(Boolean).join(' · ')}</span>}
                    {open && (
                      <button type="button" onClick={() => onOpenAsset(pin.id)} className="mt-1 px-2 py-0.5 rounded bg-[#FFB81C] text-slate-900 font-bold hover:bg-[#f5aa00]" data-testid="open-in-asset-map">
                        Open in Asset Map
                      </button>
                    )}
                  </div>
                </div>
              );
            })}

            {/* Render Flags mapped via percentage overlays (closed ones first, so open flags sit on top) */}
            {layers.problems && mapFlags.map(sub => {
              const flagColor = itemColor(sub);
              const key = `p:${sub.id}`;
              const open = tapped === key;
              const named = open || layers.labels;
              return (
                <div 
                  key={sub.id} 
                  className={`absolute transform -translate-x-1/2 -translate-y-[90%] cursor-pointer group ${open ? 'z-30' : 'z-10'} ${sub.closed ? 'opacity-80 hover:opacity-100' : ''}`}
                  style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%` }}
                  onPointerDown={notePointer}
                  onClick={(e) => {
                    e.stopPropagation();
                    if (pointerKind.current === 'touch' && !layers.labels && !open) {
                      logEvent(`Map overview flag tapped (label shown). ID: ${sub.id}`, 'info');
                      setTapped(key);
                      return;
                    }
                    setTapped(null);
                    logEvent(`Map overview flag clicked. ID: ${sub.id}`, 'info');
                    setSelectedItem(sub);
                  }}
                  data-status={sub.closed ? 'closed' : 'open'}
                >
                  <FlagIcon className="w-6 h-6 md:w-8 md:h-8 drop-shadow-md group-hover:scale-125 transition-transform origin-bottom" style={{ color: flagColor }} fill={flagColor} />
                  {sub.closed && (
                    <span className="absolute -top-1 -right-1.5 w-4 h-4 rounded-full bg-white shadow flex items-center justify-center pointer-events-none" aria-hidden="true">
                      <CheckCircle className="w-3.5 h-3.5" style={{ color: CLOSED_CHECK_COLOR }} />
                    </span>
                  )}
                  
                  {/* Label: on hover, after a tap, or always with "Labels on" */}
                  {/* display:none until shown: a hidden-but-laid-out label near the edge would widen the scroll area */}
                  <div
                    className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-1 bg-slate-900/90 backdrop-blur text-white text-xs px-2 py-1 rounded w-max max-w-[16rem] break-words shadow-lg z-20 ${open ? 'block' : (named ? 'block pointer-events-none' : 'hidden group-hover:block pointer-events-none')}`}
                    data-testid={named ? 'map-label' : undefined}
                  >
                    <span className="font-bold block border-b border-slate-700 mb-0.5 pb-0.5">
                      {sub.closed ? 'Closed - ' : ''}{categoryText(sub)}
                    </span>
                    <span className="text-slate-300">{sub.area}{sub.equipment ? ` - ${sub.equipment}` : ''}</span>
                    {open && <span className="block mt-0.5 font-bold text-[#FFB81C]">Tap again for details</span>}
                  </div>
                </div>
              );
            })}

            {layers.problems && submissions.length === 0 && (
              <div className={layers.equipment
                ? 'absolute top-3 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-slate-600 text-sm font-medium bg-white/90 rounded-lg shadow px-4 py-2 z-20'
                : 'absolute inset-0 flex flex-col items-center justify-center gap-2 text-slate-500 font-medium bg-white/50 backdrop-blur-sm'}
                style={layers.equipment ? { transform: 'translateX(-50%)' } : undefined}
                onClick={e => e.stopPropagation()}
              >
                 {categoryBar.hideClosed && categoryBar.hiddenClosed > 0 ? (
                   <>
                     <span>{categoryBar.hiddenClosed === 1 ? 'The only matching item is closed.' : `All ${categoryBar.hiddenClosed} matching items are closed.`}</span>
                     <button type="button" onClick={() => categoryBar.onHideClosed(false)} className="text-sm text-[#0072CE] underline hover:text-[#00468B]">Show closed items</button>
                   </>
                 ) : categoryBar.narrowed ? (
                   <>
                     <span>No reports match the search and filters.</span>
                     <button type="button" onClick={categoryBar.onClearAll} className="text-sm text-[#0072CE] underline hover:text-[#00468B]">Clear search and filters</button>
                   </>
                 ) : (
                   <span>No reports submitted yet.</span>
                 )}
              </div>
            )}
          </div>
          
          <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
        </div>
      </div>

      {/* Issues Sidebar */}
      <div className="w-full md:w-72 lg:w-80 bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden shrink-0 mt-4 md:mt-0 h-[30vh] md:h-full">
         <div className="p-3 bg-white border-b-2 border-[#E6F1FB] font-black text-[11px] uppercase tracking-widest text-[#00468B] flex justify-between items-center shrink-0">
            <span>Recent Issues</span>
            <span className="text-xs bg-[#E6F1FB] text-[#00468B] px-2 py-0.5 rounded-full">{submissions.length}</span>
         </div>
         <div className="flex-1 overflow-y-auto p-2 space-y-2">
            {submissions.slice().sort((a,b) => new Date(b.submittedOn) - new Date(a.submittedOn)).map(sub => (
               <div 
                 key={sub.id} 
                 onClick={() => {
                     logEvent(`Sidebar clicked. Jumping to issue: ${sub.id}`, 'info');
                     setFocusItem(sub);
                 }}
                 className={`p-3 rounded-lg border hover:border-[#0072CE]/40 hover:bg-[#E6F1FB] cursor-pointer transition-colors shadow-sm ${sub.closed ? 'border-slate-200 bg-slate-50' : 'border-slate-100'}`}
               >
                  <div className="flex justify-between items-start gap-1 mb-2">
                     <span className="font-bold text-slate-800 text-xs">{new Date(sub.submittedOn).toLocaleDateString()}</span>
                     <span className="flex items-center gap-1 min-w-0 max-w-[70%]">
                        <StatusBadge item={sub} />
                        <span className="text-[10px] px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded font-medium inline-flex items-center gap-1 min-w-0">
                           <span className="w-1.5 h-1.5 rounded-full shrink-0" style={{ backgroundColor: categoryMeta(sub.category).color }} />
                           <span className="truncate">{categoryText(sub)}</span>
                        </span>
                     </span>
                  </div>
                  <div className={`font-semibold text-sm truncate mb-1 ${sub.closed ? 'text-slate-500' : 'text-[#00468B]'}`}>{sub.area} {sub.room ? `- ${sub.room}` : ''}</div>
                  {sub.equipment && <div className="text-[11px] text-slate-500 truncate mb-1" title={sub.equipment}>Equipment: {sub.equipment}</div>}
                  <p className="text-slate-600 text-xs line-clamp-2">{sub.description}</p>
               </div>
            ))}
            {submissions.length === 0 && (
               <div className="text-slate-400 text-xs text-center p-4">No issues match the current filter.</div>
            )}
         </div>
      </div>

      <DetailModal
        selectedItem={selectedItem && (liveItems[selectedItem.id] || selectedItem)}
        onClose={() => setSelectedItem(null)}
        onEdit={onEdit}
        onSetClosed={onSetClosed}
      />
    </div>
  );
}

// ==========================================
// TAB 1: SUBMISSION & MAP
// ==========================================
function SubmitTab({ submissions, savedHere, logEvent, mapImage, setMainMapImage, mapNote, mapKey, editingItem, setEditingItem, pictureColumn, pictureFix, equipmentColumns }) {
  const mapRef = useRef(null);
  const containerRef = useRef(null);
  const [selection, setSelection] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [hoverPos, setHoverPos] = useState(null);
  const [isResizing, setIsResizing] = useState(false);
  const [zoomLevel, setZoomLevel] = useState(100);
  const [saving, setSaving] = useState(false);
  const [saveError, setSaveError] = useState('');
  // A ref as well as state: two submits in the same tick would both see saving === false
  const savingRef = useRef(false);
  // The tab may be left while a save is in flight; the save still finishes, but must not touch a form that is gone
  const mountedRef = useRef(true);
  useEffect(() => {
    mountedRef.current = true;
    return () => { mountedRef.current = false; };
  }, []);

  // Catch edit triggers and set form/selection states
  useEffect(() => {
    if (editingItem) {
       logEvent(`Edit mode activated for ${editingItem.id}. Restoring map bounding box.`, 'debug');
       setSelection({
          x: editingItem.mapX - (editingItem.boxW / 2),
          y: editingItem.mapY - (editingItem.boxH / 2),
          w: editingItem.boxW,
          h: editingItem.boxH
       });
       
       centerMapOn(containerRef.current, editingItem.mapX, editingItem.mapY);

       setShowForm(true);
    }
  }, [editingItem, logEvent]);

  const handleMapInteraction = (e, isDoubleClick) => {
    // Prevent interaction trigger if we were just dragging the resize handle
    if (isResizing) return;
    if (!mapRef.current) return;

    const rect = mapRef.current.getBoundingClientRect();
    
    // Coordinates mathematically adapt to zoom level because they calculate % of current rect.width
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    if (isDoubleClick) {
      if (selection) {
        // Check bounds to see if user clicked outside the selection box
        const isOutside = x < selection.x || x > selection.x + selection.w || y < selection.y || y > selection.y + selection.h;
        if (isOutside) {
           setSelection(null);
           setEditingItem(null); 
           logEvent('Selection canceled by double-clicking outside the box.', 'info');
           return; // Stop here, don't open the form.
        }
      }
      
      // If we made it here, double click was inside selection (or selection was null, so we create it)
      if (!selection) {
         setSelection({ x: Math.max(0, x - 5), y: Math.max(0, y - 5), w: 10, h: 10 });
      }
      logEvent(`Map region double-clicked. Opening form...`, 'info');
      setShowForm(true);

    } else {
      // Single Click
      if (selection) {
        // Move existing selection center to the click point
        setSelection(prev => ({
          ...prev,
          x: Math.max(0, Math.min(x - prev.w/2, 100 - prev.w)),
          y: Math.max(0, Math.min(y - prev.h/2, 100 - prev.h))
        }));
        logEvent('Selection moved.', 'debug');
      } else {
        // Create new default 10x10 selection
        setSelection({
          x: Math.max(0, Math.min(x - 5, 90)),
          y: Math.max(0, Math.min(y - 5, 90)),
          w: 10,
          h: 10
        });
        logEvent(`Map region selected interactively. Pending confirmation.`, 'info');
      }
    }
  };

  return (
    <div className="h-full flex flex-col relative">
      <div className="p-3 bg-white shadow-sm z-10 flex flex-wrap gap-2 justify-between items-center text-sm text-slate-600 shrink-0">
        <span>Click to select/move box. Drag corner to resize. Dbl-click outside to cancel. Dbl-click inside to open form.</span>
        {!mapImage && <MapNote note={mapNote} className="w-full" />}
        {selection && !showForm && (
          <button 
            onClick={() => { setShowForm(true); logEvent('User confirmed location. Opening form.', 'info'); }}
            className="bg-[#0072CE] text-white px-4 py-1.5 rounded-md hover:bg-[#00468B] shadow flex items-center gap-2 font-semibold"
          >
            <CheckCircle className="w-4 h-4" /> {editingItem ? "Edit Observation" : "Confirm Location"}
          </button>
        )}
      </div>

      {/* Zoomable & Panning Area */}
      <div className="flex-1 bg-slate-300 relative overflow-auto" ref={containerRef}>
        <div 
          className="relative mx-auto select-none cursor-crosshair transition-all origin-top-left"
          ref={mapRef}
          style={{ width: `${zoomLevel}%`, minWidth: '100%' }}
          onClick={(e) => handleMapInteraction(e, false)}
          onDoubleClick={(e) => handleMapInteraction(e, true)}
          onMouseMove={(e) => {
             const rect = mapRef.current.getBoundingClientRect();
             const mouseX = ((e.clientX - rect.left) / rect.width) * 100;
             const mouseY = ((e.clientY - rect.top) / rect.height) * 100;
             
             if (isResizing && selection) {
                // Resize logic based on mouse drag. Works perfectly regardless of zoom size.
                setSelection(prev => ({
                  ...prev,
                  w: Math.max(2, Math.min(mouseX - prev.x, 100 - prev.x)),
                  h: Math.max(2, Math.min(mouseY - prev.y, 100 - prev.y))
                }));
             } else {
                // Hover guidelines logic mapped to pixel values of the container for visual dash lines
                setHoverPos({ x: e.clientX - rect.left, y: e.clientY - rect.top });
             }
          }}
          onMouseUp={() => setIsResizing(false)}
          onMouseLeave={() => { setHoverPos(null); setIsResizing(false); }}
        >
          {mapImage ? (
            <img src={mapImage} onError={() => setMainMapImage(null)} alt="Main Facility Map" className="w-full h-auto block pointer-events-none select-none" draggable="false" />
          ) : (
            <div className="w-full aspect-square"><FacilityMapSvg /></div>
          )}

          {/* Hover Crosshair guides */}
          {hoverPos && !showForm && !isResizing && (
            <>
              <div className="absolute top-0 bottom-0 border-l border-dashed border-slate-500/50 pointer-events-none" style={{ left: hoverPos.x }} />
              <div className="absolute left-0 right-0 border-t border-dashed border-slate-500/50 pointer-events-none" style={{ top: hoverPos.y }} />
            </>
          )}

          {/* Selection Box overlay */}
          {selection && (
            <div 
              className={`absolute border-2 border-[#0072CE] bg-[#0072CE]/20 shadow-[0_0_0_9999px_rgba(0,0,0,0.4)] transition-all ${isResizing ? 'duration-0' : 'duration-200 pointer-events-none'}`}
              style={{
                left: `${selection.x}%`, top: `${selection.y}%`, 
                width: `${selection.w}%`, height: `${selection.h}%`
              }}
            >
              <div className="absolute -top-6 left-0 bg-[#0072CE] text-white text-xs px-2 py-0.5 rounded shadow pointer-events-none whitespace-nowrap">
                {editingItem ? 'Editing Selection' : 'Selected Area'}
              </div>
              
              {/* Resize Handle - pointer-events-auto ensures it catches mouse events even if parent is none */}
              <div 
                className="absolute -bottom-2 -right-2 w-4 h-4 bg-white border-2 border-[#0072CE] cursor-se-resize rounded-full pointer-events-auto shadow hover:scale-110 active:scale-95 transition-transform"
                onMouseDown={(e) => {
                  e.stopPropagation(); // Prevents map single click from firing
                  setIsResizing(true);
                  logEvent('Resizing map selection...', 'debug');
                }}
              />
            </div>
          )}

          {/* Existing Submissions Map Pins (Do not render the one currently being edited) */}
          {submissions.map(sub => {
            if (editingItem && editingItem.id === sub.id) return null;
            return (
              <div 
                key={sub.id} 
                className={`absolute w-2.5 h-2.5 rounded-full border shadow-sm pointer-events-none ${sub.closed ? 'border-slate-500 opacity-70' : 'border-white'}`}
                style={{ left: `${sub.mapX}%`, top: `${sub.mapY}%`, transform: 'translate(-50%, -50%)', backgroundColor: sub.closed ? '#ffffff' : itemColor(sub) }}
                title={`${sub.closed ? 'Closed: ' : ''}${sub.description}`}
              />
            );
          })}
        </div>
        
        <ZoomControls zoomLevel={zoomLevel} setZoomLevel={setZoomLevel} />
      </div>

      {/* Submission Form Modal / Overlay */}
      {showForm && (
        <div className="absolute inset-0 bg-slate-900/50 backdrop-blur-sm flex justify-center items-center z-[110] p-4">
          <div className="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-full overflow-y-auto flex flex-col animate-in fade-in zoom-in duration-200">
            <div className="p-4 border-b flex justify-between items-center sticky top-0 bg-white z-10">
              <h2 className="text-xl font-black flex flex-wrap items-center gap-2 text-[#00468B]">
                <Activity className="text-[#0072CE]" /> {editingItem ? 'Edit Observation' : 'New Observation'}
                {editingItem && <StatusBadge item={editingItem} />}
              </h2>
              <button disabled={saving} title={saving ? 'Saving - one moment' : 'Close'} onClick={() => { 
                setShowForm(false); 
                setEditingItem(null); 
                setSaveError('');
                logEvent('Form closed without submission.', 'info'); 
              }} className="text-slate-400 hover:text-red-500 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-slate-400">
                <X className="w-6 h-6" />
              </button>
            </div>
            
            <div className="p-6">
              <SubmissionForm 
                selection={selection} 
                mapKey={mapKey}
                logEvent={logEvent}
                editingItem={editingItem}
                pictureSupport={pictureColumn}
                pictureFix={pictureFix}
                equipmentColumns={equipmentColumns}
                saving={saving}
                saveError={saveError}
                onSubmit={async (localData, dbPayload, picture) => {
                  if (savingRef.current) return;
                  savingRef.current = true;
                  setSaving(true);
                  setSaveError('');

                  // LIVE DATAVERSE API FETCH LOGIC FOR CREATE/UPDATE
                  const url = editingItem 
                      ? apiUrl(`${DATAVERSE_SCHEMA.TableName}(${editingItem.id})?$select=craa5__facilityobservationid`)
                      : apiUrl(`${DATAVERSE_SCHEMA.TableName}?$select=craa5__facilityobservationid`);
                      
                  const method = editingItem ? 'PATCH' : 'POST';
                  
                  logEvent(`${method} Request starting to ${url}...`, 'data', dbPayload);

                  try {
                      const response = await fetch(url, {
                          method: method,
                          headers: {
                              'Accept': 'application/json',
                              'Content-Type': 'application/json',
                              'OData-MaxVersion': '4.0', 
                              'OData-Version': '4.0',
                              'Prefer': 'return=representation',
                              // Without If-Match a PATCH is an upsert: it would quietly re-create an observation someone has deleted
                              ...(editingItem ? { 'If-Match': '*' } : {})
                          },
                          body: JSON.stringify(dbPayload)
                      });

                      if (response.ok) {
                          let savedId = localData.id;
                          
                          if (response.status === 201 || response.status === 200) {
                             try {
                               const resData = await response.json();
                               if (resData.craa5__facilityobservationid) {
                                   savedId = resData.craa5__facilityobservationid;
                                   localData.id = savedId;
                               }
                             } catch(e) {}
                          } else if (response.status === 204) {
                             const entityIdHeader = response.headers.get('OData-EntityId');
                             if (entityIdHeader) {
                                 const match = entityIdHeader.match(/\(([^)]+)\)/);
                                 if (match) savedId = match[1];
                                 localData.id = savedId;
                             }
                          }

                          // The picture travels in its own request once the record exists
                          let pictureFailure = '';
                          if (picture) {
                              try {
                                  if (!pictureColumn.ready) throw new Error(`Pictures cannot be saved: ${pictureColumn.reason}`);
                                  if (picture.op === 'new') {
                                      logEvent(`Uploading picture to ${pictureColumn.name} for ${savedId} (${Math.round(picture.dataUrl.length * 0.75 / 1024)} KB)...`, 'data',
                                          { column: pictureColumn.name, id: savedId, bytes: Math.round(picture.dataUrl.length * 0.75) },
                                          { method: 'PATCH', path: `${DATAVERSE_SCHEMA.TableName}(${savedId})/${pictureColumn.name}`, contentType: 'application/octet-stream' });
                                      await uploadPicture(pictureColumn.name, savedId, picture.dataUrl);
                                      logEvent(`Dataverse picture upload Success (ID: ${savedId})`, 'success');
                                  } else {
                                      logEvent(`Clearing picture in ${pictureColumn.name} for ${savedId}...`, 'data', { column: pictureColumn.name, id: savedId, action: 'delete' },
                                          { method: 'DELETE', path: `${DATAVERSE_SCHEMA.TableName}(${savedId})/${pictureColumn.name}`, contentType: '(no body)' });
                                      await deletePicture(pictureColumn.name, savedId);
                                      logEvent(`Dataverse picture removal Success (ID: ${savedId})`, 'success');
                                  }
                              } catch (picErr) {
                                  pictureFailure = picErr.message;
                                  logEvent(`Dataverse Picture Save Failed: ${picErr.message}`, 'error', { id: savedId, column: pictureColumn.name, op: picture.op });
                              }
                          }

                          // What the lists show: the new picture, none after a removal, or whatever was there before
                          if (picture && !pictureFailure) {
                              localData.image = picture.op === 'new' ? picture.dataUrl : null;
                              localData.picture = null;
                          } else if (picture && pictureFailure) {
                              // The record is saved but the picture is not: show the truth in the lists
                              localData.image = editingItem ? editingItem.image : null;
                              localData.picture = editingItem ? editingItem.picture : null;
                          }

                          if (editingItem) {
                            // The edit never writes the status: keep whatever it is now (it may have been closed or reopened meanwhile)
                            savedHere({ id: localData.id }, prev => prev.map(s => (s.id === localData.id ? { ...localData, closed: s.closed, statusReason: s.statusReason } : s)));
                            logEvent(`Dataverse PATCH Success (ID: ${localData.id})`, 'success');
                          } else {
                            savedHere(localData, prev => [localData].concat(prev.filter(s => s.id !== localData.id)));
                            logEvent(`Dataverse POST Success (ID: ${localData.id})`, 'success');
                          }

                          if (pictureFailure) {
                              // Keep the form open on the saved record so "Update" retries only the picture instead of creating a duplicate
                              if (mountedRef.current) {
                                  setEditingItem(localData);
                                  setSaveError(`The observation was saved, but its picture could not be ${picture.op === 'new' ? 'uploaded' : 'removed'}: ${pictureFailure} Press Update Observation to try the picture again.`);
                              }
                          } else {
                              setShowForm(false);
                              setSelection(null);
                              setEditingItem(null);
                          }
                      } else {
                          const errData = await response.text();
                          let reason = `HTTP ${response.status}`;
                          try { reason = `${JSON.parse(errData).error.message} (HTTP ${response.status})`; } catch (e) { /* not a Dataverse error body */ }
                          if (response.status === 404 && editingItem) reason = 'this observation no longer exists in Dataverse (HTTP 404)';
                          setSaveError(`Dataverse did not save the observation: ${reason}. Nothing was changed.`);
                          logEvent(`Dataverse Save Failed: HTTP ${response.status}`, 'error', { responseText: errData, payloadSent: dbPayload });
                      }
                  } catch (error) {
                      setSaveError(`The observation could not be sent: ${error.message}. Nothing was changed - try again.`);
                      logEvent(`Dataverse Network Error: ${error.message}`, 'error', dbPayload);
                  } finally {
                      savingRef.current = false;
                      setSaving(false);
                  }
                }} 
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function SubmissionForm({ selection, mapKey, onSubmit, logEvent, editingItem, pictureSupport, pictureFix, equipmentColumns, saving, saveError }) {
  const [formData, setFormData] = useState({
    image: null, // a NEW picture picked in this form (data URL). The picture already stored is shown via editingItem.
    room: editingItem?.room || '',
    area: editingItem?.area || '',
    equipmentList: editingItem && editingItem.equipmentList ? editingItem.equipmentList : [],
    description: editingItem?.description || '',
    whoToNotify: editingItem?.whoToNotify || '',
    category: editingItem?.category || 'note',
    customNote: editingItem?.customNote || ''
  });
  const [errors, setErrors] = useState({});
  const [removedStored, setRemovedStored] = useState(false); // the user pressed Remove on the stored picture
  const [storedMissing, setStoredMissing] = useState(false);  // the stored picture turned out not to exist / not to load
  const [pictureError, setPictureError] = useState('');
  const storedSources = editingItem ? pictureSources(editingItem) : [];
  const storedShown = storedSources.length > 0 && !removedStored && !storedMissing;
  const previewSources = formData.image ? [formData.image] : (storedShown ? storedSources : []);
  const handleStoredMissing = useCallback(() => setStoredMissing(true), []);
  const [preparingPicture, setPreparingPicture] = useState(false);
  const pictureSeq = useRef(0); // each pick gets a number; Remove or a newer pick makes an older conversion's result be ignored

  // Stored ids are only trusted while they still name the same equipment (someone may have changed the names elsewhere).
  // One filtered query of at most MAX_EQUIPMENT rows; an id whose equipment now has another name becomes a text entry.
  useEffect(() => {
    const ids = (editingItem && editingItem.equipmentList ? editingItem.equipmentList : []).map(e => e.id).filter(Boolean).slice(0, MAX_EQUIPMENT);
    if (ids.length === 0) return undefined;
    let live = true;
    queryAssets(ids.map(id => `craa5_aa_assetsid eq ${id}`).join(' or '), MAX_EQUIPMENT).then(rows => {
      if (!live) return;
      const nameOf = {};
      rows.forEach(a => { nameOf[a.id] = a.name.replace(/;/g, ',').trim().toLowerCase(); });
      setFormData(prev => ({
        ...prev,
        equipmentList: prev.equipmentList.map(e => (
          e.id && nameOf[e.id] !== undefined && nameOf[e.id] !== e.name.trim().toLowerCase() ? { ...e, id: '' } : e
        ))
      }));
    }).catch(err => logEvent(`Could not check the attached equipment ids: ${err.message}`, 'warn'));
    return () => { live = false; };
  }, []); // eslint-disable-line react-hooks/exhaustive-deps -- once, for the observation the form was opened on

  const handleImageChange = async (e) => {
    const file = e.target.files && e.target.files[0];
    e.target.value = ''; // picking the same file again must still fire onChange
    if (!file) return;
    logEvent(`Image selected: ${file.name} (${(file.size/1024).toFixed(1)} KB)`, 'debug');
    setPictureError('');
    setPreparingPicture(true);
    const mine = ++pictureSeq.current;
    try {
      const dataUrl = await compressImage(file);
      if (mine !== pictureSeq.current) return; // Remove was pressed meanwhile: the picture stays removed
      setFormData(prev => ({ ...prev, image: dataUrl }));
      logEvent(`Image resized for upload: ${Math.round(dataUrl.length * 0.75 / 1024)} KB JPEG`, 'debug');
    } catch (err) {
      if (mine !== pictureSeq.current) return;
      setPictureError(err.message);
      logEvent(`Image could not be prepared: ${err.message}`, 'error', { fileName: file.name, fileType: file.type, sizeKB: Math.round(file.size / 1024) });
    } finally {
      if (mine === pictureSeq.current) setPreparingPicture(false);
    }
  };

  const handleRemoveImage = () => {
    pictureSeq.current += 1; // a picture still being converted is dropped when it finishes
    setPreparingPicture(false);
    setFormData(prev => ({ ...prev, image: null }));
    setPictureError('');
    // Removing a stored picture means clearing it on the server when the form is saved
    if (storedSources.length > 0) setRemovedStored(true);
    logEvent('Picture removed from the form.', 'debug');
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (saving || preparingPicture) return;
    logEvent('Validating form data...', 'debug');
    const newErrors = {};
    if (!formData.area.trim()) newErrors.area = "Area is required";
    if (!formData.description.trim()) newErrors.description = "Description is required";
    // The names and ids share fixed-length text columns: say so here instead of letting Dataverse refuse the save
    const namesText = equipmentNamesText(formData.equipmentList);
    const idsText = equipmentIdsText(formData.equipmentList);
    if (equipmentColumns.equipmentMax && namesText.length > equipmentColumns.equipmentMax) {
      newErrors.equipment = `The equipment names are ${namesText.length} characters; the Equipment column holds ${equipmentColumns.equipmentMax}. Remove some equipment.`;
    } else if (equipmentColumns.idColumn && equipmentColumns.idMax && idsText.length > equipmentColumns.idMax) {
      newErrors.equipment = `The equipment ids need ${idsText.length} characters; the ${equipmentColumns.idColumn} column holds ${equipmentColumns.idMax} (${Math.max(1, Math.floor((equipmentColumns.idMax + 1) / 37))} linked pieces). Remove some equipment.`;
    } else if (editingItem && equipmentColumns.idsUnknown && namesText !== equipmentNamesText(editingItem.equipmentList || [])) {
      // Changing the names without rewriting the stored ids would pair the ids with the wrong names
      newErrors.equipment = `The equipment of a saved observation can't be changed right now: ${equipmentColumns.reason} Reload the page and try again.`;
    }
    if (formData.category === 'note' && !formData.customNote.trim()) newErrors.customNote = "Custom text is required for Notes";
    // The category and the note share one Dataverse column, so a note reading exactly like a category would become that category on reload
    else if (formData.category === 'note' && CATEGORIES.some(c => c.key !== 'note' && c.key === formData.customNote.trim().toLowerCase())) newErrors.customNote = "That is a category name - pick it from the Issue Category list instead";
    
    if (Object.keys(newErrors).length > 0) {
      logEvent('Form validation failed.', 'warn', newErrors);
      setErrors(newErrors);
      return;
    }

    logEvent('Form validation passed. Compiling payload mapped to live schema...', 'debug');
    
    const localData = {
      id: editingItem ? editingItem.id : `obs-${Date.now()}`,
      mapX: selection.x + (selection.w / 2),
      mapY: selection.y + (selection.h / 2),
      boxW: selection.w,
      boxH: selection.h,
      ...formData,
      // Without an id column only the names are saved: show them as text now, as they will look after a reload
      equipmentList: equipmentColumns.idColumn ? formData.equipmentList : formData.equipmentList.map(e => ({ ...e, id: '' })),
      equipment: equipmentText(formData),
      // formData.image is only a NEW picture; keep whatever is already stored unless the save changes it
      image: editingItem ? editingItem.image : null,
      picture: editingItem ? editingItem.picture : null,
      closed: editingItem ? !!editingItem.closed : false,
      statusReason: editingItem ? editingItem.statusReason || '' : '',
      modifiedOn: new Date().toISOString(),
      modifiedBy: currentUserName(),
      submittedBy: editingItem ? editingItem.submittedBy : currentUserName(),
      submittedOn: editingItem ? editingItem.submittedOn : new Date().toISOString()
    };

    // Mapped STRICTLY to Dataverse Schema Logical Names based on user's column specs
    const dbPayload = {
      craa5_mapx: parseFloat(localData.mapX.toFixed(4)),
      craa5_mapy: parseFloat(localData.mapY.toFixed(4)),
      craa5__boxwidth: parseFloat(localData.boxW.toFixed(4)),
      craa5__boxheight: parseFloat(localData.boxH.toFixed(4)),
      craa5__room: formData.room,
      craa5__area: formData.area,
      craa5__equipment: namesText,
      craa5__description: formData.description,
      craa5__whotonotify: formData.whoToNotify,
      craa5__customnote: formData.category === 'note' ? formData.customNote : formData.category
    };
    // A new problem belongs to the map on screen; an edit leaves its map as it is
    if (!editingItem) {
      dbPayload.craa5__facility = mapKey || 'MAIN';
      localData.mapKey = dbPayload.craa5__facility;
    }
    // The ids line up with the names (blank for typed text); only written when the table has a column for them
    if (equipmentColumns.idColumn) dbPayload[equipmentColumns.idColumn] = idsText;

    // new picture -> upload it; stored picture removed -> clear it; otherwise leave the picture alone
    const pictureChange = formData.image
      ? { op: 'new', dataUrl: formData.image }
      : (removedStored && storedSources.length > 0 && !storedMissing ? { op: 'removed' } : null);
    onSubmit(localData, dbPayload, pictureChange);
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-5">
      {/* Image Upload */}
      <div>
        <label className="block text-sm font-medium text-slate-700 mb-1">Picture Upload</label>
        {!pictureSupport.ready && (
          <div className="mb-2 flex flex-col gap-1">
            <div className="text-xs bg-amber-50 border border-amber-200 text-amber-800 rounded-md p-2">
              Pictures cannot be saved yet: {pictureSupport.reason}
            </div>
            {pictureFix && (
              <ColumnFix
                need="Observation picture column"
                expected="craa5_picture"
                expectedLabel="Picture"
                expectedType="Image"
                found=""
                message={pictureSupport.missing ? '' : 'pick the column to use, or press Check again.'}
                candidates={pictureSupport.candidates}
                picked=""
                typed={pictureFix.typed}
                onPick={pictureFix.pick}
                onRecheck={pictureFix.recheck}
                checking={pictureFix.checking}
                testId="observation-picture-fix"
              />
            )}
          </div>
        )}
        <div className="mt-1 flex flex-col items-center justify-center gap-3 px-6 py-5 border-2 border-slate-300 border-dashed rounded-lg bg-slate-50">
          {previewSources.length > 0 ? (
            <>
              <StoredImage sources={previewSources} alt="Preview" className="max-h-48 object-contain rounded" onMissing={handleStoredMissing} />
              <div className="flex flex-wrap justify-center gap-2">
                <label className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-300 text-sm font-medium text-slate-700 focus-within:ring-2 focus-within:ring-[#0072CE]/40 ${pictureSupport.ready && !preparingPicture ? 'cursor-pointer hover:bg-slate-100' : 'opacity-50 cursor-not-allowed'}`}>
                  <Camera className="w-4 h-4" /> Replace picture
                  <input type="file" accept="image/*,.heic,.heif" className="sr-only" onChange={handleImageChange} disabled={!pictureSupport.ready || preparingPicture} />
                </label>
                <button type="button" onClick={handleRemoveImage} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white border border-slate-300 text-sm font-medium text-red-600 hover:bg-red-50">
                  <X className="w-4 h-4" /> Remove
                </button>
              </div>
            </>
          ) : (
            <label className={`space-y-1 text-center rounded-md focus-within:ring-2 focus-within:ring-[#0072CE]/40 ${pictureSupport.ready && !preparingPicture ? 'cursor-pointer' : 'opacity-50 cursor-not-allowed'}`}>
              <Camera className="mx-auto h-12 w-12 text-slate-400" />
              <span className="block text-sm font-medium text-[#0072CE]">Take or upload a picture</span>
              <span className="block text-xs text-slate-500">Any picture (PNG, WebP, an iPhone HEIC photo ...) is converted to a JPG and resized to 1600 px before saving</span>
              <input id="file-upload" name="file-upload" type="file" accept="image/*,.heic,.heif" className="sr-only" onChange={handleImageChange} disabled={!pictureSupport.ready || preparingPicture} />
            </label>
          )}
          {preparingPicture && <p className="text-xs text-slate-500">Converting the picture to a JPG...</p>}
          {pictureError && <p className="text-xs text-red-600" role="alert">{pictureError}</p>}
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* Room */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Room</label>
          <input type="text" className="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border" 
            value={formData.room} onChange={e => setFormData({...formData, room: e.target.value})} />
        </div>
        
        {/* Area (Required) */}
        <div>
          <label className="block text-sm font-medium text-slate-700">Area <span className="text-red-500">*</span></label>
          <input type="text" className={`mt-1 block w-full rounded-md shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border ${errors.area ? 'border-red-500' : 'border-slate-300'}`}
            value={formData.area} onChange={e => { setFormData({...formData, area: e.target.value}); setErrors({...errors, area: null}) }} />
          {errors.area && <p className="text-red-500 text-xs mt-1">{errors.area}</p>}
        </div>

        {/* Who to notify */}
        <div className="md:col-span-2">
          <label className="block text-sm font-medium text-slate-700">Who to Notify</label>
          <input type="text" className="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border"
            value={formData.whoToNotify} onChange={e => setFormData({...formData, whoToNotify: e.target.value})} placeholder="e.g. Maintenance, Safety Officer" />
        </div>
      </div>

      {/* Equipment from the equipment table (or typed text) */}
      <EquipmentPicker
        value={formData.equipmentList}
        onChange={(list) => { setFormData(prev => ({ ...prev, equipmentList: list })); setErrors(prev => ({ ...prev, equipment: null })); }}
        onPlace={(asset) => {
          setFormData(prev => ({ ...prev, room: prev.room.trim() ? prev.room : asset.room, area: prev.area.trim() ? prev.area : asset.area }));
          if (asset.area) setErrors(prev => ({ ...prev, area: null }));
        }}
        room={formData.room}
        area={formData.area}
        equipmentColumns={equipmentColumns}
        error={errors.equipment}
        logEvent={logEvent}
      />

      {/* Description (Required) */}
      <div>
        <label className="block text-sm font-medium text-slate-700">Description <span className="text-red-500">*</span></label>
        <textarea rows="3" className={`mt-1 block w-full rounded-md shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border ${errors.description ? 'border-red-500' : 'border-slate-300'}`}
          value={formData.description} onChange={e => { setFormData({...formData, description: e.target.value}); setErrors({...errors, description: null}) }} />
        {errors.description && <p className="text-red-500 text-xs mt-1">{errors.description}</p>}
      </div>

      {/* Category Dropdown */}
      <div className="bg-slate-50 p-4 rounded-lg border border-slate-200">
        <label className="block text-sm font-medium text-slate-700 mb-2">Issue Category</label>
        <select 
          className="block w-full rounded-md border-slate-300 shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border"
          value={formData.category} onChange={e => setFormData({...formData, category: e.target.value})}
        >
          {CATEGORIES.map(c => (
            <option key={c.key} value={c.key}>{c.key === 'note' ? 'Note (Custom)' : c.label}</option>
          ))}
        </select>

        {formData.category === 'note' && (
          <div className="mt-3">
             <label className="block text-sm font-medium text-slate-700">Custom Text <span className="text-red-500">*</span></label>
             <input type="text" className={`mt-1 block w-full rounded-md shadow-sm focus:border-[#0072CE] focus:ring-[#0072CE] p-2 border ${errors.customNote ? 'border-red-500' : 'border-slate-300'}`}
              value={formData.customNote} onChange={e => { setFormData({...formData, customNote: e.target.value}); setErrors({...errors, customNote: null}) }} placeholder="Enter custom category note..." />
             {errors.customNote && <p className="text-red-500 text-xs mt-1">{errors.customNote}</p>}
          </div>
        )}
      </div>

      {saveError && (
        <div className="text-sm bg-red-50 border border-red-200 text-red-800 rounded-lg p-3" role="alert">{saveError}</div>
      )}

      <div className="pt-4 flex justify-end">
        <button type="submit" disabled={saving || preparingPicture} className="bg-[#0072CE] text-white px-6 py-2 rounded-lg shadow hover:bg-[#00468B] focus:ring-4 focus:ring-[#0072CE]/30 transition-all font-medium text-lg disabled:opacity-60 disabled:cursor-not-allowed">
          {saving ? 'Saving...' : (editingItem ? 'Update Observation' : 'Submit Observation')}
        </button>
      </div>
    </form>
  );
}

// ==========================================
// EQUIPMENT PICKER: attach equipment from the equipment table (craa5_aa_assets) by search or by ticking a room's list.
// Every lookup is a filtered query of at most 100 rows; the equipment table is never loaded whole.
// ==========================================
const EMPTY_RESULTS = { mode: null, label: '', rows: [], loading: false, error: '', limit: 0, retry: null };

function EquipmentPicker({ value, onChange, onPlace, room, area, equipmentColumns, error, logEvent }) {
  const [text, setText] = useState('');
  const [results, setResults] = useState(EMPTY_RESULTS);
  const [notice, setNotice] = useState('');
  const requestRef = useRef(0);   // only the newest lookup may fill the list
  const modeRef = useRef(null);   // which kind of lookup the list shows: 'search' | 'place' | null
  const searchTimerRef = useRef(null); // the typed search still waiting out its pause
  const cancelPendingSearch = () => {
    if (searchTimerRef.current) { clearTimeout(searchTimerRef.current); searchTimerRef.current = null; }
  };
  const cacheRef = useRef({});    // lookups already answered, by mode + text
  const mountedRef = useRef(true);
  useEffect(() => { mountedRef.current = true; return () => { mountedRef.current = false; }; }, []);

  const run = useCallback(async (mode, key, label, limit, loader) => {
    const cacheKey = `${mode}|${key.toLowerCase()}`;
    const request = ++requestRef.current;
    modeRef.current = mode;
    const retry = () => { delete cacheRef.current[cacheKey]; run(mode, key, label, limit, loader); };
    const hit = cacheRef.current[cacheKey];
    if (hit) {
      setResults({ mode, label: hit.label, rows: hit.rows, loading: false, error: '', limit, retry });
      return;
    }
    setResults(prev => ({ mode, label, rows: prev.mode === mode ? prev.rows : [], loading: true, error: '', limit, retry }));
    try {
      // A loader answers with the rows, or with { rows, label } when it has something to say about them
      const out = await loader();
      const found = Array.isArray(out) ? { rows: out, label } : { rows: out.rows, label: out.label || label };
      cacheRef.current[cacheKey] = found;
      logEvent(`Equipment lookup (${found.label}): ${found.rows.length} found.`, 'debug');
      if (mountedRef.current && request === requestRef.current) setResults({ mode, label: found.label, rows: found.rows, loading: false, error: '', limit, retry });
    } catch (err) {
      logEvent(`Equipment lookup failed (${label}): ${err.message}`, 'error');
      if (mountedRef.current && request === requestRef.current) setResults({ mode, label, rows: [], loading: false, error: err.message, limit, retry });
    }
  }, [logEvent]);

  // Search as the user types (a short pause first, at least 2 characters)
  useEffect(() => {
    const q = text.trim();
    if (q.length < 2) {
      // Clearing the search box closes a search list (and drops its pending answer), never a room list
      if (modeRef.current === 'search') {
        requestRef.current += 1;
        modeRef.current = null;
        setResults(EMPTY_RESULTS);
      }
      return undefined;
    }
    const timer = setTimeout(() => {
      searchTimerRef.current = null;
      run('search', q, `Equipment matching "${q}"`, ASSET_SEARCH_LIMIT, () => searchAssets(q));
    }, 300);
    searchTimerRef.current = timer;
    return () => {
      clearTimeout(timer);
      if (searchTimerRef.current === timer) searchTimerRef.current = null;
    };
  }, [text, run]);

  const placeLabel = [room.trim(), area.trim()].filter(Boolean).join(' / ');
  const listPlace = () => {
    const r = room.trim();
    const a = area.trim();
    if (!r) return;
    cancelPendingSearch(); // the list just asked for must not be replaced by a search typed a moment ago
    run('place', `${r}|${a}`, `Equipment in ${placeLabel}`, ASSET_PLACE_LIMIT, async () => {
      const found = await assetsInPlace(r, a);
      return {
        rows: found.rows,
        label: a && !found.areaMatched ? `Equipment in ${r} (none listed for area "${a}", showing the whole room)` : `Equipment in ${placeLabel}`
      };
    });
  };

  const isAttached = (asset) => value.some(e => e.id && e.id === asset.id);

  const toggle = (asset) => {
    setNotice('');
    if (isAttached(asset)) {
      onChange(value.filter(e => e.id !== asset.id));
      return;
    }
    if (value.length >= MAX_EQUIPMENT) { setNotice(`At most ${MAX_EQUIPMENT} pieces of equipment per observation.`); return; }
    onChange(value.concat([{ id: asset.id, name: asset.name, room: asset.room, area: asset.area }]));
    onPlace(asset);
  };

  const typed = text.trim();
  const typedTaken = typed !== '' && value.some(e => e.name.toLowerCase() === typed.toLowerCase());
  const addText = () => {
    if (!typed || typedTaken) return;
    if (value.length >= MAX_EQUIPMENT) { setNotice(`At most ${MAX_EQUIPMENT} pieces of equipment per observation.`); return; }
    onChange(value.concat([{ id: '', name: typed.replace(/;/g, ','), room: '', area: '' }]));
    setText('');
    setNotice('');
  };

  const remove = (index) => { onChange(value.filter((e, i) => i !== index)); setNotice(''); };

  return (
    <div className="bg-[#F7F9FC] p-4 rounded-lg border border-[#B3D4F2]">
      <div className="flex flex-wrap items-baseline justify-between gap-2 mb-2">
        <label htmlFor="equipment-search" className="block text-sm font-bold text-[#00468B]">Equipment</label>
        <span className="text-xs text-slate-500">Attach the equipment this request is about. Search, or list the room's equipment and tick it.</span>
      </div>

      {value.length > 0 && (
        <ul className="flex flex-wrap gap-1.5 mb-3" aria-label="Attached equipment">
          {value.map((e, i) => (
            <li key={`${e.id || 'text'}-${i}`} className={`inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-md text-xs font-semibold border max-w-full ${e.id ? 'bg-white text-[#00468B] border-[#0072CE]/40' : 'bg-slate-100 text-slate-700 border-slate-300'}`} title={e.id ? [e.room, e.area].filter(Boolean).join(' / ') || 'Linked to the equipment table' : 'Typed text, not linked to the equipment table'}>
              <span className="[overflow-wrap:anywhere]">{e.name}</span>
              {!e.id && <span className="text-[10px] font-normal text-slate-500">(text)</span>}
              <button type="button" onClick={() => remove(i)} className="p-0.5 rounded hover:bg-[#FDE8EC] hover:text-[#C4001F]" aria-label={`Remove ${e.name}`}>
                <X className="w-3 h-3" />
              </button>
            </li>
          ))}
        </ul>
      )}

      <div className="flex flex-wrap gap-2">
        <div className="relative flex-1 min-w-[200px]">
          <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none" />
          <input
            id="equipment-search"
            type="search"
            value={text}
            onChange={e => setText(e.target.value)}
            onKeyDown={e => { if (e.key === 'Enter') e.preventDefault(); }}
            placeholder="Search equipment by name, room or area..."
            autoComplete="off"
            className="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]"
          />
        </div>
        <button type="button" onClick={listPlace} disabled={!room.trim()} title={room.trim() ? `List the equipment in ${placeLabel}` : 'Fill in the Room first'}
          className="px-3 py-2 rounded-md text-xs font-bold uppercase tracking-wider bg-white text-[#0072CE] border border-[#B3D4F2] hover:bg-[#E6F1FB] disabled:opacity-50 disabled:cursor-not-allowed">
          {room.trim() ? `List ${placeLabel}` : 'List room equipment'}
        </button>
        <button type="button" onClick={addText} disabled={!typed || typedTaken} title="Attach what you typed as text, without a link to the equipment table"
          className="px-3 py-2 rounded-md text-xs font-bold uppercase tracking-wider bg-white text-slate-600 border border-slate-300 hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed">
          Add as text
        </button>
      </div>

      {results.mode && (
        <div className="mt-3 bg-white border border-slate-200 rounded-md">
          <div className="flex items-center justify-between gap-2 px-3 py-2 border-b border-slate-100">
            <span className="text-xs font-bold text-[#00468B] [overflow-wrap:anywhere]">{results.label}</span>
            <button type="button" onClick={() => { cancelPendingSearch(); requestRef.current += 1; modeRef.current = null; setResults(EMPTY_RESULTS); }} className="text-xs font-semibold text-[#0072CE] hover:underline shrink-0">Done</button>
          </div>
          <div role="status" className="sr-only">{results.loading ? 'Looking up equipment' : `${results.rows.length} equipment found`}</div>
          {results.loading && <p className="px-3 py-2 text-xs text-slate-500">Looking up equipment...</p>}
          {results.error && (
            <p className="px-3 py-2 text-xs text-[#C4001F]" role="alert">
              The equipment table did not answer: {results.error}{' '}
              {results.retry && <button type="button" onClick={results.retry} className="underline font-semibold">Retry</button>}
            </p>
          )}
          {!results.loading && !results.error && results.rows.length === 0 && (
            <p className="px-3 py-2 text-xs text-slate-500">{results.mode === 'search'
              ? 'No equipment found. You can still attach what you typed with Add as text.'
              : `No equipment listed for room "${room.trim()}". Check the Room spelling, or search by name above (you can also type the equipment there and press Add as text).`}</p>
          )}
          {results.rows.length > 0 && (
            <ul className="max-h-60 overflow-y-auto divide-y divide-slate-100">
              {results.rows.map(asset => (
                <li key={asset.id}>
                  <label className="flex items-start gap-2 px-3 py-2 cursor-pointer hover:bg-[#E6F1FB]">
                    <input type="checkbox" className="mt-0.5 accent-[#0072CE]" checked={isAttached(asset)} onChange={() => toggle(asset)} />
                    <span className="min-w-0">
                      <span className="block text-sm font-medium text-slate-800 [overflow-wrap:anywhere]">{asset.name}</span>
                      <span className="block text-[11px] text-slate-500">{[asset.room, asset.area].filter(Boolean).join(' / ') || 'No room / area'}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          )}
          {!results.loading && results.rows.length >= results.limit && results.limit > 0 && (
            <p className="px-3 py-2 text-[11px] text-slate-500 border-t border-slate-100">Showing the first {results.limit}. {results.mode === 'search' ? 'Type more of the name to narrow it down.' : 'Search by name to find the rest.'}</p>
          )}
        </div>
      )}

      {notice && <p className="text-xs text-[#8A5A00] mt-2" role="alert">{notice}</p>}
      {error && <p className="text-red-600 text-xs mt-2" role="alert">{error}</p>}
      {!equipmentColumns.idColumn && (
        <p className="text-[11px] text-slate-500 mt-2">Equipment is saved by name: {equipmentColumns.reason}</p>
      )}
    </div>
  );
}

