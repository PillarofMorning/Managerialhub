            logEvent(`Bulk upload: "${it.file.name}" could not be converted to a JPG yet: ${error.message}`, 'warn');
          }
          if (!mounted.current || !itemsRef.current.some(x => x.key === it.key)) { if (url) URL.revokeObjectURL(url); continue; }
          patchItem(it.key, { preview: url, converting: false, convertNote: note, convertFatal: !!note && !failure.retry });
        }
      })();
    }
  };
  const onPick = (e) => {
    const files = e.target.files;
    // Copied out before the input is cleared (clearing empties the list the browser handed over)
    const list = [];
    for (let i = 0; files && i < files.length; i += 1) list.push(files[i]);
    e.target.value = '';
    addFiles(list);
  };
  const dragHasFiles = (e) => {
    const types = e.dataTransfer && e.dataTransfer.types;
    if (!types) return false;
    for (let i = 0; i < types.length; i += 1) if (types[i] === 'Files') return true;
    return false;
  };
  const onDragOver = (e) => {
    if (!dragHasFiles(e)) return;
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = canAdd ? 'copy' : 'none';
    if (!dragging) setDragging(true);
  };
  const onDragLeave = (e) => {
    // Only when the pointer leaves the whole view, not when it moves between its parts
    if (e.currentTarget.contains && e.relatedTarget && e.currentTarget.contains(e.relatedTarget)) return;
    setDragging(false);
  };
  const onDrop = (e) => {
    if (!dragHasFiles(e)) return;
    e.preventDefault();
    setDragging(false);
    const files = e.dataTransfer.files;
    const list = [];
    for (let i = 0; files && i < files.length; i += 1) list.push(files[i]);
    addFiles(list);
  };

  const removeItem = (key) => {
    const it = itemsRef.current.find(x => x.key === key);
    if (!it || it.status === 'uploading') return;
    if (it.preview) URL.revokeObjectURL(it.preview);
    if (viewing === key) setViewing(null);
    if (placing === key) setPlacing(null);
    setItems(prev => prev.filter(x => x.key !== key));
  };
  const clearWhere = (test) => {
    const gone = itemsRef.current.filter(it => it.status !== 'uploading' && test(it));
    gone.forEach(it => { if (it.preview) URL.revokeObjectURL(it.preview); });
    const keys = gone.map(it => it.key);
    if (viewing && keys.indexOf(viewing) !== -1) setViewing(null);
    if (placing && keys.indexOf(placing) !== -1) setPlacing(null);
    setItems(prev => prev.filter(it => keys.indexOf(it.key) === -1));
  };

  // --- where a file goes, its equipment, its issue ---
  const retarget = useCallback((key, target) => {
    patchItem(key, (it) => {
      if (it.created || it.status === 'done' || it.status === 'uploading' || it.target === target) return {};
      return {
        target,
        status: it.status === 'error' ? 'waiting' : it.status,
        message: '',
        fatal: false,
        choosing: false,
        choosingIssue: false,
        issue: target === 'newIssue' ? (it.issue || bulkIssueDraft(it, mapKey)) : it.issue
      };
    });
  }, [patchItem, mapKey]);
  const chooseAsset = useCallback((key, asset) => patchItem(key, (it) => (asset ? bulkWithAsset(it, asset, mapKey) : bulkWithoutAsset(it))), [patchItem, mapKey]);
  const setIssueField = useCallback((key, field, value) => {
    patchItem(key, (it) => {
      // Not while it is being sent or once saved: what is shown must be what was sent
      if (!it.issue || it.created || it.status === 'uploading' || it.status === 'done') return {};
      const issue = { ...it.issue, [field]: value };
      if (field === 'room') issue.roomAuto = false;
      if (field === 'area') issue.areaAuto = false;
      return { issue, status: it.status === 'error' ? 'waiting' : it.status, message: '', fatal: false };
    });
  }, [patchItem]);
  // The category, note and who-to-notify of one new issue, for every other new issue of the list
  const shareIssueDetails = useCallback((key) => {
    setItems(prev => {
      const from = prev.find(x => x.key === key);
      if (!from || !from.issue) return prev;
      const d = from.issue;
      return prev.map(x => ((x.key !== key && x.target === 'newIssue' && x.issue && !x.created && x.status !== 'done' && x.status !== 'uploading')
        ? { ...x, issue: { ...x.issue, category: d.category, customNote: d.customNote, ...((d.whoToNotify || '').trim() ? { whoToNotify: d.whoToNotify } : {}) }, status: x.status === 'error' ? 'waiting' : x.status, fatal: false }
        : x));
    });
  }, []);

  // --- suggestions from file names, a few lookups at a time ---
  const suggesting = useRef(0);
  const [suggestTick, setSuggestTick] = useState(0);
  useEffect(() => {
    if (!ready || meta.status !== 'ready') return;
    const waiting = items.filter(it => it.suggestion === null);
    const free = BULK_SUGGEST_AT_ONCE - suggesting.current;
    if (!waiting.length || free <= 0) return;
    waiting.slice(0, free).forEach(it => {
      suggesting.current += 1;
      patchItem(it.key, { suggestion: { state: 'looking' } });
      suggestBulkAsset(set, it.file.name, it.words, uploadFields, mapColumn)
        .then(suggestion => { if (mounted.current) patchItem(it.key, { suggestion }); })
        .catch(error => {
          if (mounted.current) patchItem(it.key, { suggestion: { state: 'error', text: it.words.join(' '), message: error.message } });
        })
        .then(() => {
          suggesting.current -= 1;
          if (mounted.current) setSuggestTick(t => t + 1);
        });
    });
  }, [items, ready, meta.status, suggestTick, set, uploadFields, mapColumn, patchItem]);

  // --- what is ready ---
  const places = useMemo(() => {
    const o = {};
    items.forEach(it => { const k = bulkPlaceKey(it); if (k) o[k] = (o[k] || 0) + 1; });
    return o;
  }, [items]);
  const problems = useMemo(() => {
    const o = {};
    items.forEach(it => { o[it.key] = bulkProblem(it, byName, places, kit); });
    return o;
  }, [items, byName, places, kit]);
  const readyItems = items.filter(it => (it.status === 'waiting' || it.status === 'error') && !it.fatal && !problems[it.key]);
  const needItems = items.filter(it => it.status !== 'done' && it.status !== 'uploading' && (problems[it.key] || it.fatal));
  const replacingItems = readyItems.filter(it => bulkReplaces(it, byName, kit));
  const doneItems = items.filter(it => it.status === 'done');
  const suggestedItems = items.filter(it => !it.asset && it.target !== 'issue' && !it.created && it.status !== 'done' && it.suggestion && it.suggestion.state === 'one');
  const open = (it) => it.status !== 'done' && it.status !== 'uploading' && !it.created;
  const picturesNotIssues = items.filter(it => open(it) && it.picture && it.target !== 'newIssue');
  const picturesNotAssets = items.filter(it => open(it) && it.picture && it.target !== 'asset');
  const assetDocs = items.filter(it => open(it) && !it.picture && it.target === 'asset');

  const useAllSuggestions = () => {
    setItems(prev => prev.map(it => ((!it.asset && !it.choosing && it.target !== 'issue' && !it.created && it.status !== 'done' && it.status !== 'uploading' && it.suggestion && it.suggestion.state === 'one')
      ? { ...it, ...bulkWithAsset(it, it.suggestion.asset, mapKey) } : it)));
  };
  const retargetAll = (list, target) => { list.forEach(it => retarget(it.key, target)); };
  const setDocColumnForAll = (column) => {
    if (!column) return;
    setItems(prev => prev.map(it => ((open(it) && !it.picture && it.target === 'asset')
      ? { ...it, column, columnTouched: true, status: it.status === 'error' ? 'waiting' : it.status, message: '', fatal: false } : it)));
  };
  const pickColumn = (role, name) => {
    writeColumnPick(role === 'picture' ? 'assetPicture' : 'assetDoc', name);
    setPicks(p => ({ ...p, [role]: name }));
  };
  // "Upload anyway?" when some files take the place of a stored file (it hides once none of the ready files does)
  const [confirmReplace, setConfirmReplace] = useState(false);
  // A question left open on an emptied list must not come back with the next files
  useEffect(() => { if (!items.length) { setConfirmClear(false); setConfirmReplace(false); } }, [items.length]);

  // --- uploading, one file at a time ---
  const readRow = async (id) => {
    if (!rowSelect) return getJson(`${set}(${id})`, ANNOTATIONS);
    try {
      return await getJson(`${set}(${id})?$select=${rowSelect}`, ANNOTATIONS);
    } catch (error) {
      if (error.status !== 400) throw error;
      return getJson(`${set}(${id})`, ANNOTATIONS);
    }
  };
  const uploadToAsset = async (it) => {
    const f = byName[it.column];
    const asset = it.asset;
    let up;
    try {
      up = await prepareAssetUpload(it.file, f);
    } catch (error) {
      if (!error.retry) error.fatal = true; // this file cannot go in this column as it is (a converter that could not load can be tried again)
      throw error;
    }
    const result = await uploadAssetFile(set, asset.id, f.name, up.body, up.name, logEvent, {
      mimeType: up.mimeType,
      onProgress: (p) => { if (mounted.current) patchItem(it.key, { progress: p }); }
    });
    if (mounted.current) {
      // Every other file of the list for this equipment now knows what is stored there (for "Replaces ...")
      const stored = { has: true, name: f.kind === 'file' ? result.fileName : '' };
      const withStored = (a) => (a && a.id === asset.id ? { ...a, current: { ...(a.current || {}), [f.name]: stored } } : a);
      const sent = { kind: 'asset', route: result.route, fileName: result.fileName, bytes: result.bytes, shrunk: up.shrunk, convertedFrom: up.convertedFrom, column: f.name, label: f.label, path: `${set}(${asset.id})/${f.name}` };
      setItems(prev => prev.map(x => {
        const sug = x.suggestion && x.suggestion.asset ? { ...x.suggestion, asset: withStored(x.suggestion.asset) } : x.suggestion;
        if (x.key === it.key) return { ...x, status: 'done', progress: null, message: '', fatal: false, sent, suggestion: sug };
        return { ...x, asset: withStored(x.asset), suggestion: sug };
      }));
    }
    logEvent(`Bulk upload: "${result.fileName}" went to ${f.label} of ${asset.name}.`, 'success');
    // The equipment table, the map card and the pins show it straight away
    try {
      const row = await readRow(asset.id);
      if (mounted.current) onAssetSaved(row, 'bulk', false);
    } catch (error) {
      logEvent(`${asset.name} could not be read again after the upload: ${error.message}`, 'warn');
    }
  };
  const uploadToIssue = async (it) => {
    const col = kit.pictureColumn;
    let dataUrl;
    try {
      dataUrl = await compressImage(it.file);
    } catch (error) {
      if (it.target === 'newIssue' && it.created) {
        // It was read fine when its issue was saved: only its picture is left, so it stays ready to try again
        error.message = `The issue was saved, but its picture could not be prepared: ${error.message}`;
        error.retry = true;
      } else if (!error.retry) {
        error.fatal = true; // (a converter that could not load can be tried again)
      }
      throw error;
    }
    const bytes = dataUrlToBytes(dataUrl).length;
    let id = it.target === 'issue' ? it.existing.id : (it.created || '');
    let createdNow = null;
    let payload = it.payload || null; // what the issue was saved with (this run, or an earlier one whose picture failed)
    if (it.target === 'newIssue' && !id) {
      const p = bulkIssuePayload(it, kit);
      payload = p.db;
      // The id is picked before the first try and kept, so a try whose answer was lost and is sent again finds its own issue
      const newId = it.pendingId || newGuid();
      if (!it.pendingId && mounted.current) patchItem(it.key, { pendingId: newId });
      logEvent(`Bulk upload: creating an issue for "${it.file.name}"...`, 'data', p.db, { method: 'PATCH', path: `${DATAVERSE_SCHEMA.TableName}(${newId})`, contentType: 'application/json' });
      id = await createObservation(p.db, newId);
      createdNow = { ...p.local, id };
      // Saved: from here on only its picture is left, so a retry never makes a second issue
      if (mounted.current) patchItem(it.key, { created: id, createdItem: createdNow, payload: p.db });
      kit.onIssueSaved(createdNow, true);
      logEvent(`Bulk upload: issue ${id} created.`, 'success');
    }
    const path = `${DATAVERSE_SCHEMA.TableName}(${id})/${col.name}`;
    logEvent(`Bulk upload: picture of "${it.file.name}" to ${path} (${formatBytes(bytes)})...`, 'data', { column: col.name, id, bytes }, { method: 'PATCH', path, contentType: 'application/octet-stream' });
    try {
      await uploadPicture(col.name, id, dataUrl);
    } catch (error) {
      if (it.target === 'newIssue') {
        error.message = `The issue was saved, but its picture could not be uploaded: ${error.message}`;
        error.retry = true; // the issue exists and cannot change any more: only sending its picture again is left
      }
      throw error;
    }
    const when = new Date().toISOString();
    kit.onIssueSaved({ id, image: dataUrl, picture: null, modifiedOn: when, modifiedBy: currentUserName() }, false);
    const sent = {
      kind: it.target,
      id,
      path,
      bytes,
      payload,
      title: it.target === 'issue' ? it.existing.title : issueTitle(createdNow || it.createdItem || { category: 'note', area: '' })
    };
    if (mounted.current) patchItem(it.key, { status: 'done', progress: null, message: '', fatal: false, sent });
    logEvent(`Bulk upload: "${it.file.name}" ${it.target === 'issue' ? 'added to' : 'is the picture of'} issue ${id}.`, 'success');
  };
  const uploadAll = async (replaceOk) => {
    if (runningRef.current) return;
    const queue = readyItems.map(it => it.key);
    if (!queue.length) return;
    // Files that take the place of a stored SOP or picture are asked about first, as removing a file is
    if (replacingItems.length && replaceOk !== true) { setConfirmReplace(true); return; }
    setConfirmReplace(false);
    runningRef.current = true;
    stopRef.current = false;
    setRunning(true);
    setStopping(false);
    setConfirmClear(false);
    setNote(`Uploading ${queue.length} file${queue.length === 1 ? '' : 's'}...`);
    let done = 0;
    let failed = 0;
    for (let k = 0; k < queue.length; k += 1) {
      if (stopRef.current || !mounted.current) break;
      // As the list is now: a file removed or changed since Upload was pressed is checked again
      const now = itemsRef.current;
      const it = now.find(x => x.key === queue[k]);
      if (!it || it.fatal || (it.status !== 'waiting' && it.status !== 'error')) continue;
      const counts = {};
      now.forEach(x => { const c = bulkPlaceKey(x); if (c) counts[c] = (counts[c] || 0) + 1; });
      if (bulkProblem(it, byName, counts, kit)) continue;
      patchItem(it.key, { status: 'uploading', message: '', progress: null, sent: null });
      const where = it.target === 'asset' ? `${(byName[it.column] || {}).label} of ${it.asset.name}` : (it.target === 'issue' ? `issue ${it.existing.id}` : 'a new issue');
      try {
        if (it.target === 'asset') await uploadToAsset(it);
        else await uploadToIssue(it);
        done += 1;
      } catch (error) {
        failed += 1;
        // A refusal that would come again (no right, too big, not a usable picture) waits for a change; a lost connection
        // or a busy server can simply be tried again
        const fatal = !error.retry && (!!error.fatal || (error.status >= 400 && error.status < 500 && error.status !== 408 && error.status !== 429));
        logEvent(`Bulk upload of "${it.file.name}" to ${where} failed: ${error.message}`, 'error');
        if (mounted.current) patchItem(it.key, { status: 'error', progress: null, message: error.message, fatal });
      }
    }
    runningRef.current = false;
    if (!mounted.current) return;
    setRunning(false);
    setStopping(false);
    const left = queue.length - done - failed;
    setNote(`${done} uploaded${failed ? `, ${failed} not done (the red notes say why)` : ''}${left > 0 ? `, ${left} not started` : ''}.`);
  };
  const stop = () => { stopRef.current = true; setStopping(true); };

  // --- the picture shown large, the file being placed on the map ---
  const viewed = viewing ? items.find(it => it.key === viewing) : null;
  useEffect(() => {
    if (!viewing) return undefined;
    const onKey = (e) => { if (e.key === 'Escape') setViewing(null); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [viewing]);
  // The picker closes by itself once its file is being sent or saved (its spot can no longer change)
  const placed = placing ? items.find(it => it.key === placing && !it.created && it.status !== 'uploading' && it.status !== 'done') : null;
  const showIssue = (id) => {
    const sub = (kit.submissions || []).find(x => x.id === id);
    if (sub) kit.onShowIssue(sub);
  };

  const columnChip = (f) => (
    <li key={f.name} className="inline-flex flex-wrap items-center gap-1 max-w-full rounded-2xl border border-green-200 bg-green-50 text-green-900 px-2 py-0.5">
      <CheckCircle className="w-3 h-3" />
      <span className="font-bold">{f.label}</span>
      <span className="font-mono text-[10px] text-green-800/80 break-all min-w-0">{f.name}</span>
      <span>{f.kind === 'image' ? 'Image' : 'File'}{f.maxKB ? `, up to ${formatBytes(f.maxKB * 1024)}` : ''}{f.inferred ? ', found from a row' : ''}</span>
    </li>
  );
  const pictureExpected = expected.filter(c => c.role === 'picture')[0];
  const docExpected = expected.filter(c => c.role === 'doc')[0];
  const missingDocs = expected.filter(c => c.role === 'doc' && !c.found);
  const eq = kit.equipmentColumns || {};

  return (
    <div
      className="h-full flex flex-col bg-slate-100 overflow-hidden relative"
      data-testid="assets-bulk-view"
      onDragOver={onDragOver}
      onDragLeave={onDragLeave}
      onDrop={onDrop}
    >
      <div className="flex-1 min-h-0 overflow-y-auto p-3 md:p-6 pt-3 md:pt-4 flex flex-col gap-3" data-bulk-scroll="">
        <div className="shrink-0">
          <h2 className="text-2xl font-black text-[#00468B]">Bulk upload</h2>
          <p className="text-sm text-slate-500">Add pictures and documents. Send each one to a piece of equipment, make a picture a new issue, or add it to an issue, then press Save to Dataverse at the bottom to save them all at once.</p>
        </div>

        {!metaDone && <p className="text-sm text-slate-500" role="status">Reading the equipment table's columns...</p>}
        {metaDone && !ready && (
          <div className="shrink-0 text-sm text-[#C4001F] bg-white rounded-lg border border-slate-200 p-3" role="alert">
            The Assets table's columns could not be read{meta.error ? `: ${meta.error}` : '.'}
            <button type="button" onClick={loadAssetMeta} className="ml-2 text-[#0072CE] underline">Try again</button>
          </div>
        )}

        {metaDone && (
          <details className="shrink-0 rounded-lg border border-slate-200 bg-white p-3 text-xs text-slate-700" data-testid="bulk-columns" open={!hasImageColumn || !hasFileColumn || !issuesReady || !!picks.picture || !!picks.doc || missingDocs.length > 0 || (!!eq.typed && !eq.picked)}>
            <summary className="font-bold text-slate-800 cursor-pointer">Dataverse columns this tab uses</summary>
            <p className="font-bold text-slate-800 mt-2">Equipment table ({ASSET_LOGICAL_NAME})</p>
            {ready && (
              <ul className="flex flex-wrap gap-1.5 mt-1.5">
                {uploadFields.map(columnChip)}
                {missingDocs.map(c => (
                  <li key={c.name} className="inline-flex flex-wrap items-center gap-1 max-w-full rounded-2xl border border-slate-300 bg-slate-50 text-slate-600 px-2 py-0.5" data-missing={c.name}>
                    <span className="font-bold">Not found:</span> {c.label} <span className="font-mono text-[10px] break-all">{c.name}</span> (File)
                  </li>
                ))}
              </ul>
            )}
            {ready && (
              <div className="mt-1.5 flex flex-col gap-1.5">
                <ColumnFix
                  need="Equipment pictures"
                  expected={ASSET_PICTURE_COLUMN}
                  expectedLabel={ASSET_KNOWN_LABELS[ASSET_PICTURE_COLUMN]}
                  expectedType="Image"
                  found={pictureCol}
                  candidates={uploadFields.filter(f => f.kind === 'image').concat(uploadFields.filter(f => f.kind === 'file'))}
                  picked={picks.picture && pictureCol === picks.picture ? picks.picture : ''}
                  typed={picks.picture || ''}
                  onPick={(name) => pickColumn('picture', name)}
                  onRecheck={loadAssetMeta}
                  checking={meta.status === 'loading' || !!meta.rechecking}
                  checkError={meta.recheckError}
                  testId="bulk-picture-fix"
                />
                <ColumnFix
                  need="Equipment documents (SOPs)"
                  expected={ASSET_DOC_COLUMNS[0]}
                  expectedLabel={ASSET_KNOWN_LABELS[ASSET_DOC_COLUMNS[0]]}
                  expectedType="File"
                  found={docCol}
                  candidates={uploadFields.filter(f => f.kind === 'file')}
                  picked={picks.doc && docCol === picks.doc ? picks.doc : ''}
                  typed={picks.doc || ''}
                  onPick={(name) => pickColumn('doc', name)}
                  onRecheck={loadAssetMeta}
                  checking={meta.status === 'loading' || !!meta.rechecking}
                  checkError={meta.recheckError}
                  testId="bulk-doc-fix"
                />
                <ColumnFix
                  need="Map spot column"
                  message={mapColumn ? '' : (meta.mapReason || '')}
                  expected="craa5_maplocation"
                  expectedLabel="Map Location"
                  expectedType="Single line of text"
                  found={mapColumn || ''}
                  candidates={(meta.fields || []).filter(f => (f.kind === 'text' || f.kind === 'memo') && f.canUpdate && !f.isPrimaryName && ASSET_MAP_NOT_THESE.indexOf(f.name) === -1)}
                  picked={meta.mapPicked ? mapColumn : ''}
                  typed={readColumnPick('assetMap')}
                  onPick={(name) => { writeColumnPick('assetMap', name); loadAssetMeta(); }}
                  onRecheck={loadAssetMeta}
                  checking={meta.status === 'loading' || !!meta.rechecking}
                  checkError={meta.recheckError}
                  testId="bulk-map-fix"
                />
              </div>
            )}
            <p className="font-bold text-slate-800 mt-3">Issues ({OBSERVATION_LOGICAL_NAME})</p>
            <p className="mt-1">A new issue is saved with <span className="font-mono [overflow-wrap:anywhere]">{ISSUE_COLUMNS.join(', ')}</span>{eq.idColumn ? <>, the equipment id in <span className="font-mono">{eq.idColumn}</span></> : null}; its picture goes in its own request.</p>
            {!eq.idColumn && <p className="mt-1 text-slate-500">Equipment is saved by name only: {endSentence(eq.reason || 'the observations table has no equipment id column.')}</p>}
            <div className="mt-1.5 flex flex-col gap-1.5">
              <ColumnFix
                need="Equipment ids (link each issue to its equipment)"
                expected="craa5_equipmentguids"
                expectedLabel="Equipment GUIDs"
                expectedType="Multiple lines of text"
                found={eq.idColumn || ''}
                message={!eq.idColumn && (eq.lookupFailed || eq.idsUnknown) ? endSentence(eq.reason || 'the app could not check the observations table.') : ''}
                candidates={eq.candidates || []}
                picked={eq.picked || ''}
                typed={eq.typed || ''}
                onPick={kit.equipmentFix ? kit.equipmentFix.pick : () => {}}
                onRecheck={kit.equipmentFix ? kit.equipmentFix.recheck : null}
                checking={kit.equipmentFix ? kit.equipmentFix.checking : false}
                checkError={kit.equipmentFix ? kit.equipmentFix.error : ''}
                testId="bulk-equipment-ids-fix"
              />
              <ColumnFix
                need="Issue pictures"
                expected={issuesReady ? '' : 'craa5_picture'}
                expectedLabel="Picture"
                expectedType="Image"
                found={issuesReady ? kit.pictureColumn.name : ''}
                message={issuesReady || kit.pictureColumn.missing ? '' : kit.pictureColumn.reason}
                candidates={kit.pictureColumn.candidates || []}
                picked={kit.pictureColumn.picked || ''}
                typed={kit.pictureFix ? kit.pictureFix.typed : ''}
                onPick={kit.pictureFix ? kit.pictureFix.pick : () => {}}
                onRecheck={kit.pictureFix ? kit.pictureFix.recheck : null}
                checking={kit.pictureFix ? kit.pictureFix.checking : false}
                testId="bulk-issue-picture-fix"
              />
            </div>
          </details>
        )}

        <div
          className={`shrink-0 rounded-xl border-2 border-dashed p-4 flex flex-col sm:flex-row items-center justify-center gap-3 text-center transition-colors ${dragging && canAdd ? 'border-[#0072CE] bg-[#E6F1FB]' : 'border-[#B3D4F2] bg-white'}`}
          data-testid="bulk-drop"
        >
          <ImageIcon className="w-8 h-8 text-[#0072CE] shrink-0" />
          <p className="text-sm text-slate-600">{canAdd ? (ready && uploadFields.length > 0 ? 'Drop pictures and documents here, or' : 'Drop pictures here, or') : (metaDone ? 'Files can be added once the equipment table has a picture or file column, or issues can take pictures (see above).' : 'Files can be added once the columns above are known.')}
            {canAdd && <span className="block text-[11px] text-slate-500">Every picture (PNG, WebP, iPhone HEIC ...) is converted to a JPG automatically.</span>}</p>
          <input ref={inputRef} type="file" multiple onChange={onPick} className="hidden" aria-label="Choose pictures and documents to upload" data-testid="bulk-input" />
          <button
            type="button"
            disabled={!canAdd}
            onClick={() => inputRef.current && inputRef.current.click()}
            className="bg-[#0072CE] text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-[#00468B] disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
          >
            Choose files
          </button>
        </div>

        {items.length > 0 && (
          <div className="shrink-0 flex flex-wrap items-center gap-2 text-xs">
            <span className="font-bold text-slate-700">{items.length} file{items.length === 1 ? '' : 's'}</span>
            {suggestedItems.length > 0 && (
              <button type="button" onClick={useAllSuggestions} className="px-2.5 py-1 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]" data-testid="bulk-use-all">
                Use all suggestions ({suggestedItems.length})
              </button>
            )}
            {picturesNotIssues.length > 0 && (
              <button type="button" onClick={() => retargetAll(picturesNotIssues, 'newIssue')} className="px-2.5 py-1 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]" data-testid="bulk-all-issues">
                Make every picture a new issue ({picturesNotIssues.length})
              </button>
            )}
            {picturesNotAssets.length > 0 && uploadFields.length > 0 && (
              <button type="button" onClick={() => retargetAll(picturesNotAssets, 'asset')} className="px-2.5 py-1 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]" data-testid="bulk-all-assets">
                Send every picture to equipment ({picturesNotAssets.length})
              </button>
            )}
            {assetDocs.length > 0 && uploadFields.some(f => f.kind === 'file') && (
              <label className="inline-flex items-center gap-1">
                <span className="font-bold text-slate-600">Every document in</span>
                <select value="" onChange={e => setDocColumnForAll(e.target.value)} aria-label="Column for every document" className="border border-slate-300 rounded-md px-1.5 py-1 text-xs bg-white" data-testid="bulk-doc-all">
                  <option value="">Choose...</option>
                  {uploadFields.filter(f => f.kind === 'file').map(f => <option key={f.name} value={f.name}>{f.label}</option>)}
                </select>
              </label>
            )}
            {!running && (
              confirmClear ? (
                <span className="inline-flex items-center gap-1.5 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1">
                  Take every file off this list? Nothing is deleted from Dataverse.
                  <button type="button" onClick={() => { clearWhere(() => true); setConfirmClear(false); setNote(''); }} className="font-bold text-[#C4001F] underline">Clear list</button>
                  <button type="button" onClick={() => setConfirmClear(false)} className="font-bold text-slate-600 underline">Keep</button>
                </span>
              ) : (
                <button type="button" onClick={() => setConfirmClear(true)} className="px-2.5 py-1 rounded-md font-bold border border-slate-300 bg-white text-slate-600 hover:bg-slate-100">Clear list</button>
              )
            )}
          </div>
        )}

        {items.length > 0 && (
          <ul className="grid gap-2 xl:grid-cols-2 pb-2" aria-label="Files to upload">
            {items.map(it => (
              <BulkFileCard
                key={it.key}
                it={it}
                problem={problems[it.key]}
                fields={uploadFields}
                byName={byName}
                set={set}
                mapColumn={mapColumn}
                kit={kit}
                onChange={patchItem}
                onRetarget={retarget}
                onChooseAsset={chooseAsset}
                onIssueField={setIssueField}
                onShareIssue={shareIssueDetails}
                onPlace={setPlacing}
                onShowIssue={showIssue}
                onRemove={removeItem}
                onView={setViewing}
                onEditInTable={onEditInTable}
              />
            ))}
          </ul>
        )}
      </div>

      {/* Always on screen, even before files are added, so it is clear where the files get saved */}
      <div className="shrink-0 border-t-4 border-[#FFB81C] bg-white px-3 md:px-6 py-2 flex flex-wrap items-center gap-2 text-xs" data-testid="bulk-bar">
        <span className="text-slate-700" role="status">
          {items.length === 0 ? (
            <>No files yet. Add pictures or documents above, then save them to Dataverse here.</>
          ) : (
            <>
              <b>{readyItems.length}</b> ready, <b>{needItems.length}</b> need something, <b>{doneItems.length}</b> uploaded
              {replacingItems.length > 0 && <span className="text-[#7A5200]">; <b>{replacingItems.length}</b> replace{replacingItems.length === 1 ? 's' : ''} a stored file</span>}
              {!running && readyItems.length === 0 && needItems.length > 0 && (
                <span className="block text-[#7A5200]" data-testid="bulk-save-why">Nothing can be saved yet: each file says in amber what it still needs (for example its equipment or its map spot).</span>
              )}
            </>
          )}
        </span>
        <span className="flex-1" />
        {note && <span className="text-slate-600" data-testid="bulk-note">{note}</span>}
        {!running && confirmReplace && replacingItems.length > 0 ? (
          <span className="inline-flex flex-wrap items-center gap-1.5 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1" data-testid="bulk-confirm-replace" role="alert">
            {replacingItems.length === 1 ? '1 of these takes the place of a file or picture already stored.' : `${replacingItems.length} of these take the place of a file or picture already stored.`} Upload anyway?
            <button type="button" onClick={() => uploadAll(true)} className="px-2 py-0.5 rounded font-bold bg-[#0072CE] text-white hover:bg-[#00468B]">Upload anyway</button>
            <button type="button" onClick={() => setConfirmReplace(false)} className="px-2 py-0.5 rounded font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100">Not yet</button>
          </span>
        ) : running ? (
          <button type="button" onClick={stop} disabled={stopping} className="px-3 py-1.5 rounded-md font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 disabled:opacity-60">
            {stopping ? 'Stopping after this file...' : 'Stop after this file'}
          </button>
        ) : (
          <button
            type="button"
            onClick={uploadAll}
            disabled={readyItems.length === 0}
            title={readyItems.length === 0 ? 'Nothing is ready to save yet' : `Save the ${readyItems.length} ready file${readyItems.length === 1 ? '' : 's'} to Dataverse`}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-bold bg-[#0072CE] text-white hover:bg-[#00468B] shadow-sm disabled:bg-slate-300 disabled:text-slate-600 disabled:shadow-none disabled:cursor-not-allowed"
            data-testid="bulk-upload"
          >
            <UploadIcon className="w-4 h-4" /> Save to Dataverse ({readyItems.length})
          </button>
        )}
        {doneItems.length > 0 && (
          <button type="button" onClick={() => clearWhere(it => it.status === 'done')} className="px-3 py-1.5 rounded-md font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100">
            Clear uploaded ({doneItems.length})
          </button>
        )}
      </div>

      {dragging && canAdd && (
        <div className="absolute inset-0 pointer-events-none border-4 border-[#0072CE] rounded-lg bg-[#0072CE]/5 flex items-center justify-center">
          <span className="bg-white text-[#00468B] font-bold text-sm rounded-lg px-4 py-2 shadow">Drop to add</span>
        </div>
      )}

      {viewed && viewed.preview && (
        <div className="fixed inset-0 z-[120] bg-black/80 flex flex-col p-3 md:p-6" role="dialog" aria-modal="true" aria-label={`Picture ${viewed.file.name}`} onClick={() => setViewing(null)}>
          <div className="shrink-0 flex items-center gap-2 text-white mb-2">
            <span className="font-bold truncate flex-1 min-w-0">{viewed.file.name}</span>
            <button type="button" onClick={() => setViewing(null)} className="px-3 py-1.5 rounded-md text-sm font-bold bg-white text-[#00468B] hover:bg-slate-100">Close</button>
          </div>
          <div className="flex-1 min-h-0 flex items-center justify-center">
            <img src={viewed.preview} alt={viewed.file.name} className="max-w-full max-h-full object-contain" onClick={e => e.stopPropagation()} />
          </div>
        </div>
      )}

      {placed && placed.issue && (
        <BulkSpotPicker
          mapImage={kit.mapImage}
          fileName={placed.file.name}
          preview={placed.preview}
          value={placed.issue.spot}
          onPick={(spot) => { setIssueField(placed.key, 'spot', { ...spot, map: kit.mapKey }); setPlacing(null); }}
          onCancel={() => setPlacing(null)}
        />
      )}
    </div>
  );
}

// One file of the bulk list: what it is, where it goes (equipment, a new issue or an issue), and how its upload went
function BulkFileCard({ it, problem, fields, byName, set, mapColumn, kit, onChange, onRetarget, onChooseAsset, onIssueField, onShareIssue, onPlace, onShowIssue, onRemove, onView, onEditInTable }) {
  const toAsset = it.target === 'asset';
  const newIssue = it.target === 'newIssue';
  const toIssue = it.target === 'issue';
  const f = toAsset ? (byName[it.column] || null) : null;
  const busy = it.status === 'uploading';
  const done = it.status === 'done';
  const locked = busy || done;
  // The search is open while the item says "choosing", so an upload run leaves this file alone until one is picked
  const searching = !!it.choosing && !locked;
  const searchingIssue = !!it.choosingIssue && !locked;
  const [seed, setSeed] = useState({ text: '', n: 0 });
  const sug = it.suggestion;
  const current = bulkReplaces(it, byName, kit);
  const where = (a) => [a.room, a.area].filter(Boolean).join(', ');
  // What a piece of equipment already holds in this file's column
  const storedIn = (a) => (f && a && a.current && a.current[f.name] && a.current[f.name].has ? a.current[f.name] : null);
  const storedText = (cur) => (toIssue ? 'the picture now on this issue' : (f.kind === 'image' ? `the picture now in ${f.label}` : `${cur.name ? `"${cur.name}"` : 'the file'} now in ${f.label}`));
  const choose = (asset) => onChooseAsset(it.key, asset);
  const openSearch = (text) => { setSeed(s => ({ text: text || '', n: s.n + 1 })); onChange(it.key, { choosing: true }); };
  const closeSearch = () => onChange(it.key, { choosing: false });
  const pickIssue = (sub) => onChange(it.key, { existing: issueSummary(sub), choosingIssue: false, status: it.status === 'error' ? 'waiting' : it.status, message: '', fatal: false });
  const sugStored = sug && sug.state === 'one' ? storedIn(sug.asset) : null;
  const d = it.issue;
  const formLocked = locked || !!it.created;
  const label = 'block text-[11px] font-bold text-slate-600';
  const input = 'mt-0.5 w-full border border-slate-300 rounded-md px-2 py-1 text-xs bg-white disabled:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]';

  let state = null;
  if (done && it.sent && it.sent.kind === 'asset') {
    state = (
      <div className="text-xs text-green-800" role="status">
        <p className="font-bold">Uploaded to {it.sent.label} of {it.asset.name}.</p>
        <p className="text-[11px] text-slate-500 [overflow-wrap:anywhere]">
          Sent: {it.sent.route === 'blocks' ? 'InitializeFileBlocksUpload, UploadBlock, CommitFileBlocksUpload for' : `PATCH ${it.sent.path},`} "{it.sent.fileName}", {formatBytes(it.sent.bytes)}{it.sent.convertedFrom ? ` (converted from ${it.sent.convertedFrom} to JPG)` : (it.sent.shrunk ? ' (shrunk to a JPEG)' : '')}
        </p>
        <button type="button" onClick={() => onEditInTable(it.asset.id)} aria-label={`Open ${it.asset.name} in Asset Management`} className="mt-0.5 font-bold text-[#0072CE] underline">Open in Asset Management</button>
      </div>
    );
  } else if (done && it.sent) {
    state = (
      <div className="text-xs text-green-800" role="status">
        <p className="font-bold">{it.sent.kind === 'issue' ? `Added to the issue ${it.sent.title}.` : `New issue saved: ${it.sent.title}.`}</p>
        <p className="text-[11px] text-slate-500 [overflow-wrap:anywhere]">Sent: {it.sent.payload ? `PATCH ${DATAVERSE_SCHEMA.TableName}(${it.sent.id}) to create it, then ` : ''}PATCH {it.sent.path}, a JPEG of {formatBytes(it.sent.bytes)}</p>
        {it.sent.payload && (
          <details className="text-[11px] text-slate-600">
            <summary className="cursor-pointer font-bold">What was saved</summary>
            <pre className="mt-1 whitespace-pre-wrap [overflow-wrap:anywhere] bg-slate-50 border border-slate-200 rounded p-1.5 font-mono text-[10px]" data-testid="bulk-issue-payload">{JSON.stringify(it.sent.payload, null, 2)}</pre>
          </details>
        )}
        <button type="button" onClick={() => onShowIssue(it.sent.id)} aria-label={`Show the issue of ${it.file.name} on the map`} className="mt-0.5 font-bold text-[#0072CE] underline">Show on the map</button>
      </div>
    );
  } else if (busy) {
    state = (
      <p className="text-xs font-bold text-[#00468B]" role="status">
        Uploading{it.progress !== null && it.progress !== undefined ? ` in parts, ${Math.round(it.progress * 100)}%` : '...'}
      </p>
    );
  } else if (it.status === 'error') {
    state = (
      <p className="text-xs text-[#C4001F]" role="alert">
        Not uploaded: {endSentence(it.message)}{problem ? ` ${problem}` : (it.fatal ? ` ${BULK_FATAL_HINT[it.target] || BULK_FATAL_HINT.asset}` : ' Press Save to Dataverse to try again.')}
      </p>
    );
  } else if (problem) {
    state = <p className="text-xs text-[#7A5200]">{problem}</p>;
  } else if (current) {
    state = (
      <p className="text-xs text-[#7A5200] bg-[#FFF6E0] border border-[#FFB81C] rounded px-1.5 py-0.5 self-start" data-replaces="">
        Ready. It replaces {storedText(current)}.
      </p>
    );
  } else {
    state = <p className="text-xs text-green-800">{it.created ? 'The issue is saved; its picture is ready to go.' : 'Ready.'}</p>;
  }

  // Equipment: the piece the file goes to (or, for a new issue, the one it is about)
  const equipment = (
    <div className="text-xs min-w-0">
      {it.asset && !searching ? (
        <div className="flex flex-wrap items-center gap-1.5 min-w-0">
          <span className="font-bold text-slate-600 shrink-0">{newIssue ? 'Equipment (optional)' : 'Equipment'}</span>
          <span className="inline-flex items-center gap-1 rounded-md bg-[#E6F1FB] text-[#00468B] px-2 py-0.5 min-w-0 max-w-full">
            <span className="font-bold truncate">{it.asset.name}</span>
            {where(it.asset) && <span className="text-[11px] text-slate-600 truncate">{where(it.asset)}</span>}
          </span>
          {!locked && !(newIssue && it.created) && <button type="button" onClick={() => openSearch('')} aria-label={`Change the equipment for ${it.file.name}`} className="font-bold text-[#0072CE] underline">Change</button>}
          {!locked && newIssue && !it.created && <button type="button" onClick={() => choose(null)} aria-label={`Remove the equipment from the issue of ${it.file.name}`} className="font-bold text-slate-600 underline">Remove</button>}
        </div>
      ) : !searching ? (
        <div className="flex flex-wrap items-center gap-1.5 min-w-0">
          {newIssue && <span className="font-bold text-slate-600 shrink-0">Equipment (optional)</span>}
          {!locked && !(newIssue && it.created) && (
            <button type="button" onClick={() => openSearch('')} aria-label={`Find the equipment for ${it.file.name}`} className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]">
              <Search className="w-3 h-3" /> Find equipment
            </button>
          )}
          {sug && sug.state === 'looking' && <span className="text-slate-500">Looking for "{it.words.join(' ')}"...</span>}
          {sug && sug.state === 'one' && !(newIssue && it.created) && (
            <span className="inline-flex flex-wrap items-center gap-1 min-w-0">
              <span className="text-slate-500">From the name:</span>
              <span className="font-bold text-slate-800 [overflow-wrap:anywhere]">{sug.asset.name}</span>
              {where(sug.asset) && <span className="text-[11px] text-slate-500">{where(sug.asset)}</span>}
              {sugStored && <span className="text-[11px] text-[#7A5200] bg-[#FFF6E0] rounded px-1">would replace {storedText(sugStored)}</span>}
              {!locked && <button type="button" onClick={() => choose(sug.asset)} aria-label={`Use ${sug.asset.name} for ${it.file.name}`} className="font-bold text-[#0072CE] underline" data-testid="bulk-use">Use</button>}
            </span>
          )}
          {sug && sug.state === 'many' && !locked && !(newIssue && it.created) && (
            <button type="button" onClick={() => openSearch(sug.text)} aria-label={`Show the possible matches for ${it.file.name}`} className="text-[#0072CE] underline">
              {sug.count >= BULK_SEARCH_TOP ? `${BULK_SEARCH_TOP} or more possible matches` : `${sug.count} possible match${sug.count === 1 ? '' : 'es'}`} for "{sug.text}"
            </button>
          )}
          {sug && sug.state === 'error' && <span className="text-slate-500">The name lookup failed ({sug.message}); use Find equipment.</span>}
        </div>
      ) : null}
      {searching && !locked && (
        <BulkAssetSearch
          key={seed.n}
          initialText={seed.text}
          set={set}
          fields={fields}
          mapColumn={mapColumn}
          column={f}
          onPick={choose}
          onCancel={closeSearch}
          label={it.file.name}
        />
      )}
    </div>
  );

  return (
    <li className={`bg-white rounded-lg border p-2.5 flex gap-2.5 min-w-0 ${done ? 'border-green-300' : it.status === 'error' ? 'border-[#E4002B]/50' : 'border-slate-200'}`} data-bulk-item={it.file.name} data-target={it.target}>
      <div className="shrink-0">
        {it.preview ? (
          <button type="button" onClick={() => onView(it.key)} title="Show the picture large" aria-label={`Show ${it.file.name} large`} className="block w-16 h-16 sm:w-20 sm:h-20 rounded-md border border-slate-200 bg-slate-50 overflow-hidden">
            <img src={it.preview} alt="" loading="lazy" className="w-full h-full object-cover" />
          </button>
        ) : (
          <div className="w-16 h-16 sm:w-20 sm:h-20 rounded-md border border-slate-200 bg-slate-50 flex flex-col items-center justify-center text-[10px] font-bold text-slate-500 uppercase">
            {it.picture ? <ImageIcon className="w-6 h-6 text-slate-400" /> : <FileDocIcon className="w-6 h-6 text-slate-400" />}
            <span className="mt-0.5 max-w-full truncate px-1">{it.converting ? 'to JPG...' : (/\.([a-z0-9]+)$/i.exec(it.file.name) || ['', 'file'])[1]}</span>
          </div>
        )}
      </div>
      <div className="flex-1 min-w-0 flex flex-col gap-1.5">
        <div className="flex items-start gap-2 min-w-0">
          <p className="flex-1 min-w-0 text-sm font-bold text-slate-800 [overflow-wrap:anywhere]">{it.file.name}</p>
          <span className="shrink-0 text-[11px] text-slate-500">{formatBytes(it.file.size || 0)}</span>
          {!busy && (
            <button type="button" onClick={() => onRemove(it.key)} title="Take this file off the list" aria-label={`Take ${it.file.name} off the list`} className="shrink-0 p-0.5 rounded text-slate-400 hover:text-[#E4002B] hover:bg-slate-100">
              <X className="w-4 h-4" />
            </button>
          )}
        </div>
        {it.taken && <p className="text-[11px] text-slate-500 -mt-1">Taken {bulkTakenText(it.taken)}</p>}
        {it.picture && !isJpegFile(it.file) && !done && !it.convertFatal && (it.heic || opensInBrowser(it.file) || it.target !== 'asset' || ((fields.find(f => f.name === it.column) || {}).kind === 'image')) && (
          <p className="text-[11px] text-slate-500 -mt-1" data-testid="bulk-to-jpg">{it.converting ? 'Converting to JPG...' : 'Saved as a JPG'}{it.convertNote ? <span className="text-[#7A5200]"> (preview not ready: {endSentence(it.convertNote)})</span> : null}</p>
        )}

        <div className="flex flex-wrap items-center gap-1.5 text-xs min-w-0">
          <span className="shrink-0 font-bold text-slate-600">Goes to</span>
          <div className="inline-flex flex-wrap rounded-md border border-[#B3D4F2] bg-white p-0.5" role="radiogroup" aria-label={`Where ${it.file.name} goes`}>
            {BULK_TARGETS.map(t => {
              const off = locked || !!it.created || (t.key !== 'asset' && !it.picture) || (t.key === 'asset' && fields.length === 0);
              return (
                <button
                  key={t.key}
                  type="button"
                  role="radio"
                  aria-checked={it.target === t.key}
                  disabled={off && it.target !== t.key}
                  onClick={() => { if (!off) onRetarget(it.key, t.key); }}
                  title={t.key !== 'asset' && !it.picture ? 'Only pictures can go on an issue' : undefined}
                  className={`px-2 py-0.5 rounded font-bold text-[11px] ${it.target === t.key ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB] disabled:text-slate-400 disabled:hover:bg-transparent disabled:cursor-not-allowed'}`}
                  data-testid={`bulk-target-${t.key}`}
                >
                  {t.label}
                </button>
              );
            })}
          </div>
        </div>

        {toAsset && (
          <>
            <label className="flex items-center gap-1.5 text-xs text-slate-600 min-w-0">
              <span className="shrink-0 font-bold">Goes in</span>
              <select
                value={it.column}
                disabled={locked}
                onChange={e => onChange(it.key, { column: e.target.value, columnTouched: true, status: it.status === 'error' ? 'waiting' : it.status, message: '', fatal: false })}
                aria-label={`Column for ${it.file.name}`}
                className="min-w-0 flex-1 sm:flex-none border border-slate-300 rounded-md px-2 py-1 text-xs bg-white disabled:bg-slate-50"
              >
                <option value="">Choose a column...</option>
                {fields.map(c => (
                  <option key={c.name} value={c.name} disabled={c.kind === 'image' && !it.picture}>
                    {c.label} ({c.kind === 'image' ? 'picture' : 'file'}){c.kind === 'image' && !it.picture ? ', pictures only' : ''}
                  </option>
                ))}
              </select>
            </label>
            {equipment}
          </>
        )}

        {newIssue && d && (
          <div className="flex flex-col gap-1.5" data-testid="bulk-issue-form">
            {it.created && <p className="text-[11px] text-slate-500">This issue is saved in Dataverse; only its picture is left to send.</p>}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
              <label className={label}>
                Issue category <span className="text-[#C4001F]">*</span>
                <select value={d.category} disabled={formLocked} onChange={e => onIssueField(it.key, 'category', e.target.value)} className={input} aria-label={`Issue category for ${it.file.name}`} data-testid="bulk-issue-category">
                  <option value="">Choose...</option>
                  {CATEGORIES.map(c => <option key={c.key} value={c.key}>{c.label}</option>)}
                </select>
              </label>
              {d.category === 'note' ? (
                <label className={label}>
                  Note text <span className="text-[#C4001F]">*</span>
                  <input type="text" value={d.customNote} disabled={formLocked} onChange={e => onIssueField(it.key, 'customNote', e.target.value)} className={input} aria-label={`Note text for ${it.file.name}`} />
                </label>
              ) : (
                <label className={label}>
                  Who to notify
                  <input type="text" value={d.whoToNotify} disabled={formLocked} onChange={e => onIssueField(it.key, 'whoToNotify', e.target.value)} placeholder="e.g. Maintenance" className={input} aria-label={`Who to notify for ${it.file.name}`} data-testid="bulk-issue-notify" />
                </label>
              )}
              <label className={`${label} sm:col-span-2`}>
                Description <span className="text-[#C4001F]">*</span>
                <textarea rows={2} value={d.description} disabled={formLocked} onChange={e => onIssueField(it.key, 'description', e.target.value)} className={input} aria-label={`Description for ${it.file.name}`} data-testid="bulk-issue-description" />
              </label>
              <label className={label}>
                Room
                <input type="text" value={d.room} disabled={formLocked} onChange={e => onIssueField(it.key, 'room', e.target.value)} className={input} aria-label={`Room for ${it.file.name}`} data-testid="bulk-issue-room" />
              </label>
              <label className={label}>
                Area <span className="text-[#C4001F]">*</span>
                <input type="text" value={d.area} disabled={formLocked} onChange={e => onIssueField(it.key, 'area', e.target.value)} className={input} aria-label={`Area for ${it.file.name}`} data-testid="bulk-issue-area" />
              </label>
              {d.category === 'note' && (
                <label className={`${label} sm:col-span-2`}>
                  Who to notify
                  <input type="text" value={d.whoToNotify} disabled={formLocked} onChange={e => onIssueField(it.key, 'whoToNotify', e.target.value)} placeholder="e.g. Maintenance" className={input} aria-label={`Who to notify for ${it.file.name}`} data-testid="bulk-issue-notify" />
                </label>
              )}
            </div>
            {equipment}
            <div className="flex flex-wrap items-center gap-1.5 text-xs">
              <span className="font-bold text-slate-600">Map spot</span>
              <span className={d.spot ? 'text-slate-700' : 'text-[#7A5200]'} data-testid="bulk-issue-spot">
                {d.spot ? (d.spot.from === 'equipment' && it.asset ? `from ${it.asset.name}'s spot on the map` : 'placed on the map') : 'not placed yet'}
              </span>
              {!formLocked && (
                <button type="button" onClick={() => onPlace(it.key)} className="px-2 py-0.5 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]" aria-label={`Place the issue of ${it.file.name} on the map`} data-testid="bulk-place">
                  {d.spot ? 'Move' : 'Place on the map'}
                </button>
              )}
            </div>
            {it.taken && (
              <label className="inline-flex items-center gap-1.5 text-[11px] text-slate-600">
                <input type="checkbox" checked={!!d.addTaken} disabled={formLocked} onChange={e => onIssueField(it.key, 'addTaken', e.target.checked)} />
                Add "Photo taken {bulkTakenText(it.taken)}" to the description
              </label>
            )}
            {!formLocked && d.category && (
              <button type="button" onClick={() => onShareIssue(it.key)} className="self-start text-[11px] font-bold text-[#0072CE] underline" data-testid="bulk-issue-share">
                Use this category{d.whoToNotify ? ' and who to notify' : ''} for every new issue in the list
              </button>
            )}
          </div>
        )}

        {toIssue && (
          <div className="text-xs min-w-0">
            {it.existing && !searchingIssue ? (
              <div className="flex flex-wrap items-center gap-1.5 min-w-0">
                <span className="font-bold text-slate-600 shrink-0">Issue</span>
                <span className="inline-flex flex-col rounded-md bg-[#E6F1FB] text-[#00468B] px-2 py-0.5 min-w-0 max-w-full">
                  <span className="font-bold [overflow-wrap:anywhere]">{it.existing.title}{it.existing.closed ? ' (closed)' : ''}</span>
                  {it.existing.description && <span className="text-[11px] text-slate-600 truncate">{it.existing.description}</span>}
                </span>
                {!locked && <button type="button" onClick={() => onChange(it.key, { choosingIssue: true })} aria-label={`Change the issue for ${it.file.name}`} className="font-bold text-[#0072CE] underline">Change</button>}
              </div>
            ) : !searchingIssue ? (
              !locked && (
                <button type="button" onClick={() => onChange(it.key, { choosingIssue: true })} aria-label={`Find the issue for ${it.file.name}`} className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB]" data-testid="bulk-find-issue">
                  <Search className="w-3 h-3" /> Find the issue
                </button>
              )
            ) : (
              <BulkIssueSearch
                submissions={kit.submissions}
                kit={kit}
                initialText={it.asset ? it.asset.name : ''}
                onPick={pickIssue}
                onCancel={() => onChange(it.key, { choosingIssue: false })}
                label={it.file.name}
              />
            )}
          </div>
        )}

        {state}
      </div>
    </li>
  );
}

// The equipment search of one bulk file: typed words (name, room, area) or an asset id; at most BULK_SEARCH_TOP results
function BulkAssetSearch({ initialText, set, fields, mapColumn, column, onPick, onCancel, label }) {
  const [text, setText] = useState(initialText || '');
  const [found, setFound] = useState({ rows: [], loading: false, error: '', asked: '' });
  const req = useRef(0);
  const inputRef = useRef(null);
  useEffect(() => { if (inputRef.current) inputRef.current.focus(); }, []);
  useEffect(() => {
    const t = text.trim();
    const n = req.current + 1;
    req.current = n;
    if (t.length < 2) { setFound({ rows: [], loading: false, error: '', asked: '' }); return undefined; }
    const timer = setTimeout(() => {
      setFound(s => ({ ...s, loading: true, error: '' }));
      searchBulkAssets(set, t, fields, { mapColumn })
        .then(rows => { if (req.current === n) setFound({ rows, loading: false, error: '', asked: t }); })
        .catch(error => { if (req.current === n) setFound({ rows: [], loading: false, error: error.message, asked: t }); });
    }, 300);
    return () => clearTimeout(timer);
  }, [text, set, fields, mapColumn]);
  const where = (a) => [a.room, a.area].filter(Boolean).join(', ');
  return (
    <div className="mt-0.5 rounded-md border border-[#B3D4F2] bg-[#F7FBFF] p-2 flex flex-col gap-1.5" data-testid="bulk-search">
      <div className="flex items-center gap-1.5">
        <div className="relative flex-1 min-w-0">
          <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            ref={inputRef}
            type="search"
            value={text}
            onChange={e => setText(e.target.value)}
            onKeyDown={e => {
              if (e.key === 'Escape') { e.preventDefault(); onCancel(); }
              // Only the answer for what is typed now (not the one before the last keystroke)
              if (e.key === 'Enter' && !found.loading && found.asked === text.trim() && found.rows.length === 1) { e.preventDefault(); onPick(found.rows[0]); }
            }}
            placeholder="Equipment name, room or area..."
            aria-label={`Find the equipment for ${label}`}
            className="w-full pl-7 pr-2 py-1 text-xs border border-slate-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]"
          />
        </div>
        <button type="button" onClick={onCancel} className="shrink-0 font-bold text-slate-600 underline">Cancel</button>
      </div>
      {text.trim().length < 2 && <p className="text-[11px] text-slate-500">Type at least 2 letters.</p>}
      {found.loading && <p className="text-[11px] text-slate-500" role="status">Searching...</p>}
      {found.error && <p className="text-[11px] text-[#C4001F]" role="alert">The search failed: {found.error}</p>}
      {!found.loading && !found.error && found.asked && found.rows.length === 0 && <p className="text-[11px] text-slate-500">No equipment matches "{found.asked}".</p>}
      {found.rows.length > 0 && (
        <ul className="flex flex-col gap-0.5 max-h-56 overflow-y-auto" aria-label="Matching equipment">
          {found.rows.map(a => {
            const cur = column && a.current ? a.current[column.name] : null;
            return (
              <li key={a.id}>
                <button type="button" onClick={() => onPick(a)} className="w-full text-left rounded px-2 py-1 hover:bg-[#E6F1FB] focus:bg-[#E6F1FB] focus:outline-none">
                  <span className="font-bold text-slate-800">{a.name}</span>
                  {where(a) && <span className="text-[11px] text-slate-500"> {where(a)}</span>}
                  {cur && cur.has && <span className="block text-[11px] text-[#7A5200]">Has {column.kind === 'image' ? 'a picture' : (cur.name ? `"${cur.name}"` : 'a file')} in {column.label} already</span>}
                </button>
              </li>
            );
          })}
          {found.rows.length >= BULK_SEARCH_TOP && <li className="text-[11px] text-slate-500 px-2">Only the first {BULK_SEARCH_TOP} are shown; type more to narrow it down.</li>}
        </ul>
      )}
    </div>
  );
}

// The issue search of one bulk file: the issues the app already holds (open ones first, the newest first). Older closed
// issues are not all loaded: a button asks Dataverse for them, and what it finds joins the list.
function BulkIssueSearch({ submissions, kit, initialText, onPick, onCancel, label }) {
  const [text, setText] = useState(initialText || '');
  const inputRef = useRef(null);
  useEffect(() => { if (inputRef.current) inputRef.current.focus(); }, []);
  const rows = useMemo(() => searchIssues(submissions, text), [submissions, text]);
  const day = (iso) => { const t = new Date(iso); return isNaN(t.getTime()) ? '' : `${t.getDate()} ${MONTHS[t.getMonth()]} ${t.getFullYear()}`; };
  return (
    <div className="mt-0.5 rounded-md border border-[#B3D4F2] bg-[#F7FBFF] p-2 flex flex-col gap-1.5" data-testid="bulk-issue-search">
      <div className="flex items-center gap-1.5">
        <div className="relative flex-1 min-w-0">
          <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            ref={inputRef}
            type="search"
            value={text}
            onChange={e => setText(e.target.value)}
            onKeyDown={e => {
              if (e.key === 'Escape') { e.preventDefault(); onCancel(); }
              if (e.key === 'Enter' && rows.length === 1) { e.preventDefault(); onPick(rows[0]); }
            }}
            placeholder="Room, area, equipment, words of the issue..."
            aria-label={`Find the issue for ${label}`}
            className="w-full pl-7 pr-2 py-1 text-xs border border-slate-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 focus:border-[#0072CE]"
          />
        </div>
        <button type="button" onClick={onCancel} className="shrink-0 font-bold text-slate-600 underline">Cancel</button>
      </div>
      {!text.trim() && <p className="text-[11px] text-slate-500">The newest open issues; type to search {kit && (kit.closedMore || kit.timeNarrowed) ? 'every open issue and the closed ones loaded so far' : 'them all'}.</p>}
      {text.trim() && rows.length === 0 && <p className="text-[11px] text-slate-500">No loaded issue matches "{text.trim()}".</p>}
      {text.trim() && kit && (kit.closedMore || kit.timeNarrowed || (kit.olderSearch && kit.olderSearch.text)) && (() => {
        const words = text.trim().split(/\s+/).filter(Boolean).slice(0, 6).join(' ');
        // A search that stayed inside the timeframe does not answer for the closed issues before it
        const done = kit.olderSearch && kit.olderSearch.text === words && (kit.olderSearch.anyTime || !kit.timeNarrowed) ? kit.olderSearch : null;
        if (done) {
          return (
            <p className={`text-[11px] ${done.error ? 'text-[#C4001F]' : 'text-slate-500'}`} data-testid="bulk-older-result">
              {done.busy ? 'Searching older closed issues in Dataverse...'
                : done.error ? `The search in Dataverse could not run: ${done.error}`
                : done.found === 0 ? 'No older closed issue matches either.'
                : `${done.found}${done.more ? '+' : ''} closed issue${done.found === 1 ? '' : 's'} found in Dataverse${done.added ? ' and added to this list' : ' (already in this list)'}.`}
            </p>
          );
        }
        if (kit.problemsLoading) return <p className="text-[11px] text-slate-500">The issues are still loading from Dataverse...</p>;
        return kit.closedMore || kit.timeNarrowed ? (
          <button type="button" onClick={() => kit.searchOlder(words, { anyTime: true })} className="self-start text-[11px] font-bold text-[#0072CE] underline hover:text-[#00468B]" data-testid="bulk-search-older">
            Also search older closed issues in Dataverse
          </button>
        ) : null;
      })()}
      {rows.length > 0 && (
        <ul className="flex flex-col gap-0.5 max-h-56 overflow-y-auto" aria-label="Matching issues">
          {rows.map(sub => (
            <li key={sub.id}>
              <button type="button" onClick={() => onPick(sub)} className="w-full text-left rounded px-2 py-1 hover:bg-[#E6F1FB] focus:bg-[#E6F1FB] focus:outline-none">
                <span className="font-bold text-slate-800">{issueTitle(sub)}</span>
                <span className="text-[11px] text-slate-500"> {day(sub.submittedOn)}{sub.closed ? ', closed' : ''}</span>
                {sub.description && <span className="block text-[11px] text-slate-600 truncate">{sub.description}</span>}
                {issueHasPicture(sub) && <span className="block text-[11px] text-[#7A5200]">Has a picture already</span>}
              </button>
            </li>
          ))}
          {rows.length >= BULK_SEARCH_TOP && <li className="text-[11px] text-slate-500 px-2">Only the first {BULK_SEARCH_TOP} are shown; type more to narrow it down.</li>}
        </ul>
      )}
    </div>
  );
}

// Places a new issue on the facility map: a click puts a box of the chosen size there. Scrolls and zooms; Escape cancels.
function BulkSpotPicker({ mapImage, fileName, preview, value, onPick, onCancel }) {
  const [spot, setSpot] = useState(value || null);
  const [size, setSize] = useState(value && value.w ? (BULK_SPOT_SIZES.some(s => s.key === value.w) ? value.w : 4) : 4);
  const [zoom, setZoom] = useState(100);
  const [imageFailed, setImageFailed] = useState(false);
  const stageRef = useRef(null);
  useEffect(() => {
    const onKey = (e) => { if (e.key === 'Escape') onCancel(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [onCancel]);
  const onClick = (e) => {
    const r = stageRef.current.getBoundingClientRect();
    if (!r.width || !r.height) return;
    const x = clampPct(((e.clientX - r.left) / r.width) * 100);
    const y = clampPct(((e.clientY - r.top) / r.height) * 100);
    setSpot(clampSpot({ x, y, w: size, h: size, from: 'map' }));
  };
  const resize = (n) => { setSize(n); setSpot(s => (s ? clampSpot({ ...s, w: n, h: n, from: 'map' }) : s)); };
  return (
    <div className="fixed inset-0 z-[120] bg-slate-900/60 flex items-center justify-center p-2 md:p-6" role="dialog" aria-modal="true" aria-label={`Place ${fileName} on the map`} data-testid="bulk-spot-picker">
      <div className="bg-white rounded-xl shadow-2xl w-full max-w-5xl max-h-full flex flex-col overflow-hidden">
        <div className="shrink-0 px-3 py-2 border-b border-slate-200 flex items-center gap-2">
          {preview && <img src={preview} alt="" className="w-10 h-10 rounded object-cover border border-slate-200 shrink-0" />}
          <div className="min-w-0 flex-1">
            <p className="font-black text-[#00468B] text-sm">Where is it?</p>
            <p className="text-[11px] text-slate-500 truncate">Click the map where {fileName} was taken.</p>
          </div>
          <button type="button" onClick={onCancel} className="shrink-0 p-1 rounded text-slate-400 hover:text-[#E4002B]" aria-label="Close without placing"><X className="w-5 h-5" /></button>
        </div>
        <div className="flex-1 min-h-0 overflow-auto bg-slate-200 p-2">
          <div ref={stageRef} onClick={onClick} className="relative cursor-crosshair select-none mx-auto" style={{ width: `${zoom}%` }} data-testid="bulk-spot-stage">
            {mapImage && !imageFailed ? (
              <img src={mapImage} alt="Facility map" className="w-full h-auto block pointer-events-none" draggable="false" onError={() => setImageFailed(true)} />
            ) : (
              <div className="w-full aspect-square pointer-events-none"><FacilityMapSvg /></div>
            )}
            {spot && (
              <div className="absolute border-2 border-[#E4002B] bg-[#E4002B]/20 pointer-events-none" style={{ left: `${spot.x - spot.w / 2}%`, top: `${spot.y - spot.h / 2}%`, width: `${spot.w}%`, height: `${spot.h}%` }} data-testid="bulk-spot-box" />
            )}
          </div>
        </div>
        <div className="shrink-0 px-3 py-2 border-t border-slate-200 flex flex-wrap items-center gap-2 text-xs">
          <span className="font-bold text-slate-600">Size</span>
          <div className="inline-flex rounded-md border border-[#B3D4F2] bg-white p-0.5" role="group" aria-label="Size of the box">
            {BULK_SPOT_SIZES.map(s => (
              <button key={s.key} type="button" onClick={() => resize(s.key)} aria-pressed={size === s.key} className={`px-2 py-0.5 rounded font-bold ${size === s.key ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]'}`}>{s.label}</button>
            ))}
          </div>
          <span className="font-bold text-slate-600 ml-1">Zoom</span>
          <button type="button" onClick={() => setZoom(z => Math.max(50, z - 25))} className="p-1 rounded border border-[#B3D4F2] text-[#0072CE] hover:bg-[#E6F1FB]" aria-label="Zoom out"><ZoomOut className="w-4 h-4" /></button>
          <span className="min-w-[3rem] text-center font-bold text-[#00468B]">{zoom}%</span>
          <button type="button" onClick={() => setZoom(z => Math.min(400, z + 25))} className="p-1 rounded border border-[#B3D4F2] text-[#0072CE] hover:bg-[#E6F1FB]" aria-label="Zoom in"><ZoomIn className="w-4 h-4" /></button>
          <span className="flex-1" />
          <button type="button" onClick={onCancel} className="px-3 py-1.5 rounded-md font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100">Cancel</button>
          <button type="button" disabled={!spot} onClick={() => onPick(spot)} className="px-3 py-1.5 rounded-md font-bold bg-[#0072CE] text-white hover:bg-[#00468B] disabled:opacity-50 disabled:cursor-not-allowed" data-testid="bulk-spot-use">Use this spot</button>
        </div>
      </div>
    </div>
  );
}
