const RAIL_PAGE = 30;        // cards that roll in at a time as the user scrolls
const THUMB_SIZE = 80;       // px, square location / photo thumbnails
const THUMB_MAP_WIDTH = 480; // px the whole map is drawn at inside a location thumbnail

// Natural width/height of the map, so location thumbnails are cropped without squashing the picture
function useImageAspect(src) {
  const [aspect, setAspect] = useState(null);
  useEffect(() => {
    if (!src) { setAspect(null); return undefined; }
    let cancelled = false;
    const img = new Image();
    img.onload = () => { if (!cancelled && img.naturalHeight) setAspect(img.naturalWidth / img.naturalHeight); };
    img.src = src;
    return () => { cancelled = true; };
  }, [src]);
  return aspect;
}

// Crop of the facility map centred exactly on the reported box
function MapThumb({ item, mapImage, aspect }) {
  if (!mapImage || !aspect) {
    return <div className="w-20 h-20 shrink-0 bg-slate-200 rounded-lg border border-slate-300 flex items-center justify-center text-[10px] text-slate-400">N/A</div>;
  }
  const color = itemColor(item);
  const mapW = THUMB_MAP_WIDTH;
  const mapH = mapW / aspect;
  const boxW = Math.min(THUMB_SIZE, Math.max(8, (item.boxW / 100) * mapW));
  const boxH = Math.min(THUMB_SIZE, Math.max(8, (item.boxH / 100) * mapH));
  return (
    <div
      className="w-20 h-20 shrink-0 rounded-lg border border-slate-300 shadow-sm relative overflow-hidden bg-slate-200"
      title="Where this was reported"
      style={{
        backgroundImage: `url(${mapImage})`,
        backgroundRepeat: 'no-repeat',
        backgroundSize: `${mapW}px ${mapH}px`,
        backgroundPosition: `${THUMB_SIZE / 2 - (item.mapX / 100) * mapW}px ${THUMB_SIZE / 2 - (item.mapY / 100) * mapH}px`
      }}
    >
      <div
        className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 border-2 rounded-sm"
        style={{ width: boxW, height: boxH, borderColor: color, backgroundColor: `${color}33` }}
      />
    </div>
  );
}

function PhotoThumb({ item, label, onClick }) {
  const [missing, setMissing] = useState(false);
  const sources = pictureSources(item, true);
  const key = sources.join('|');
  useEffect(() => { setMissing(false); }, [key]);
  const handleMissing = useCallback(() => setMissing(true), []);
  if (sources.length === 0 || missing) return null;
  return (
    <button type="button" onClick={onClick} title="View photo" aria-label={`View photo for ${label}`} className="w-20 h-20 shrink-0 rounded-lg overflow-hidden border border-slate-300 shadow-sm bg-slate-100 hover:ring-2 hover:ring-[#0072CE] transition">
      <StoredImage sources={sources} alt="Observation" className="w-full h-full object-cover" onMissing={handleMissing} />
    </button>
  );
}

function RailCard({ item, mapImage, aspect, onLocate, onOpen, onEdit, onPickCategory, onSetClosed }) {
  const meta = categoryMeta(item.category);
