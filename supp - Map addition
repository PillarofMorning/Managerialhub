// --- PICTURES ---
// Logical name of the Image (or File) column that holds an observation's picture on craa5__facilityobservation.
// Leave it null and the app finds the table's picture column itself; pin it (e.g. 'craa5_picture') if the table has more than one.
const PICTURE_COLUMN = null;
const OBSERVATION_LOGICAL_NAME = 'craa5__facilityobservation';
const ODATA_HEADERS = { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' };
const PICTURE_NAME_HINT = /pic|photo|image|upload|attach/i;

const apiUrl = (path) => {
  let baseUrl = '';
  try {
    if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
  } catch (e) { /* same-origin relative URL */ }
  return `${baseUrl}/api/data/v9.2/${path}`;
};

const readApiError = async (res) => {
  let text = '';
  try { text = await res.text(); } catch (e) { /* no body */ }
  try {
    const parsed = JSON.parse(text);
    if (parsed && parsed.error && parsed.error.message) return `${parsed.error.message} (HTTP ${res.status})`;
  } catch (e) { /* not JSON */ }
  return text ? `${text.slice(0, 300)} (HTTP ${res.status})` : `HTTP ${res.status}`;
};

// Finds the column pictures are stored in: { ready, name, type: 'image' | 'file' | null, reason }
async function detectPictureColumn(logEvent) {
  const listColumns = async (cast) => {
    const res = await fetch(apiUrl(`EntityDefinitions(LogicalName='${OBSERVATION_LOGICAL_NAME}')/Attributes/Microsoft.Dynamics.CRM.${cast}?$select=LogicalName,SchemaName`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    return ((await res.json()).value || []).map(a => a.LogicalName).filter(Boolean);
  };

  let images = [];
  let files = [];
  const failures = [];
  try { images = await listColumns('ImageAttributeMetadata'); } catch (e) { failures.push(e.message); }
  try { files = await listColumns('FileAttributeMetadata'); } catch (e) { failures.push(e.message); }
  logEvent(`Picture column scan: image columns [${images.join(', ')}], file columns [${files.join(', ')}]`, failures.length ? 'warn' : 'debug', failures.length ? { failures } : null);

  if (PICTURE_COLUMN) {
    const type = images.includes(PICTURE_COLUMN) ? 'image' : (files.includes(PICTURE_COLUMN) ? 'file' : null);
    // Both lookups worked and neither lists the pinned column: it is a typo or the wrong kind of column
    if (!type && failures.length === 0) {
      return { ready: false, name: null, type: null, reason: `PICTURE_COLUMN "${PICTURE_COLUMN}" is not an Image or File column of ${OBSERVATION_LOGICAL_NAME}.` };
    }
    return { ready: true, name: PICTURE_COLUMN, type, reason: '' };
  }

  // Image columns before File columns; within a kind prefer a name like a picture, then any other custom column, then the system "entityimage"
  const candidates = [...images.map(name => ({ name, type: 'image' })), ...files.map(name => ({ name, type: 'file' }))];
  const rank = (c) => (c.type === 'file' ? 10 : 0) + (c.name === 'entityimage' ? 2 : (PICTURE_NAME_HINT.test(c.name) ? 0 : 1));
  candidates.sort((a, b) => rank(a) - rank(b));
  if (candidates.length > 0) {
    if (candidates.length > 1) logEvent(`Several picture columns found (${candidates.map(c => c.name).join(', ')}). Using ${candidates[0].name}. Set PICTURE_COLUMN at the top of the file to choose another.`, 'warn');
    return { ready: true, name: candidates[0].name, type: candidates[0].type, reason: '' };
  }
  if (failures.length > 0) {
    return { ready: false, name: null, type: null, reason: `the app could not look up the table's columns (${failures[0]}). Set PICTURE_COLUMN at the top of the file to the Image column's logical name.` };
  }
  return { ready: false, name: null, type: null, reason: `the ${OBSERVATION_LOGICAL_NAME} table has no Image or File column. Add an Image column (for example "Picture") in Dataverse.` };
}

// Extra $select fields that tell a row has a picture, tried in order. Selecting the image column itself would drag
// a base64 thumbnail into every row, and a wrong guess is a 400, so the list query steps down until one is accepted.
const pictureSelectOptions = (col, type) => {
  const imageStyle = [[`${col}_timestamp`], [`${col}_url`]];
  const fileStyle = [[`${col}_name`], [col]];
  const order = type === 'image' ? imageStyle : (type === 'file' ? fileStyle : [...imageStyle, ...fileStyle]);
  return [...order, []];
};

// true / false when the query returned a marker for the picture, null when it could not tell
const rowHasPicture = (row, col, fields) => {
  if (fields.length === 0) return null;
  return fields.some(f => {
    const v = row[f];
    return v !== null && v !== undefined && v !== '' && v !== 0 && v !== '0';
  });
};

// Stored pictures: full size first (needs "can store full image"), then the 144 px thumbnail Dataverse always keeps
const storedPictureUrls = (col, id) => ({
  full: apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${col}/$value?size=full`),
  thumb: apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${col}/$value`)
});

// Every URL that might show this item's picture, best first (small thumbnails want the cheap 144 px one first)
const pictureSources = (item, thumbFirst = false) => {
  if (!item) return [];
  if (item.image) return [item.image];
  if (item.picture) return thumbFirst ? [item.picture.thumb, item.picture.full] : [item.picture.full, item.picture.thumb];
  return [];
};

const GUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// One request per picture: Dataverse cannot take it inside the create call (only the table's primary image can)
async function uploadPicture(column, id, dataUrl) {
  if (!GUID_PATTERN.test(id)) throw new Error('Dataverse did not return the new record id, so the picture could not be attached.');
  const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${column}`), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/octet-stream', 'x-ms-file-name': `observation-${id}.jpg` },
    body: dataUrlToBytes(dataUrl)
  });
  if (!res.ok) throw new Error(await readApiError(res));
}

async function deletePicture(column, id) {
  const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${column}`), { method: 'DELETE', headers: ODATA_HEADERS });
  if (!res.ok && res.status !== 404) throw new Error(await readApiError(res));
}

// --- ISSUE CATEGORIES ---
// One list drives the form dropdown, the map flag colours, the filter chips and the action rail.
const CATEGORIES = [
  // 700-weight colours so white text on a selected chip (and the tinted badge text) stays readable (WCAG AA)
  { key: 'to be cleaned', label: 'To Be Cleaned', color: '#1d4ed8' },
  { key: 'to be fixed', label: 'To Be Fixed', color: '#c2410c' },
  { key: 'safety concern', label: 'Safety Concern', color: '#b91c1c' },
  { key: 'idea', label: 'Idea', color: '#15803d' },
  { key: 'fsq concern', label: 'FSQ Concern', color: '#7e22ce' },
  { key: 'note', label: 'Note', color: '#475569' }
];

const categoryMeta = (key) => CATEGORIES.find(c => c.key === key) || CATEGORIES[CATEGORIES.length - 1];

// Dataverse keeps the category AND the custom note in ONE column (craa5__customnote):
// a preset name for the five presets, or free text for a "note". Split it back apart so every
// free-text note counts as the single "note" category instead of becoming a category of its own.
const parseCategory = (raw) => {
  const text = (raw || '').trim();
  const preset = CATEGORIES.find(c => c.key !== 'note' && c.key === text.toLowerCase());
  return preset ? { category: preset.key, customNote: '' } : { category: 'note', customNote: text };
};

const categoryText = (item) => {
  if (item.category === 'note') return item.customNote ? `Note: ${item.customNote}` : 'Note';
  return categoryMeta(item.category).label;
};

// --- TIME HELPERS FOR THE ACTION RAIL ---
const timeAgo = (iso) => {
  const then = new Date(iso).getTime();
  if (isNaN(then)) return '';
  const mins = Math.round((Date.now() - then) / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins} min ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs} h ago`;
  const days = Math.round(hrs / 24);
  if (days < 30) return `${days} d ago`;
  return new Date(iso).toLocaleDateString();
};

// --- PICTURE HELPERS ---
const MAX_PICTURE_SIDE = 1600; // px on the long side. Phone photos (5-12 MB) become a JPEG of a few hundred KB.

// Re-encode whatever the user picked as a JPEG that is small enough to upload reliably. Resolves a data URL.
const compressImage = (file) => new Promise((resolve, reject) => {
  const objectUrl = URL.createObjectURL(file);
  const img = new Image();
  img.onerror = () => {
    URL.revokeObjectURL(objectUrl);
    reject(new Error('That file is not a picture this browser can open. Try a JPG or PNG.'));
  };
  img.onload = () => {
    URL.revokeObjectURL(objectUrl);
    try {
      const scale = Math.min(1, MAX_PICTURE_SIDE / Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.width * scale));
      canvas.height = Math.max(1, Math.round(img.height * scale));
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#FFFFFF'; // JPEG has no transparency: see-through parts would turn black
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', 0.8));
    } catch (err) {
      reject(new Error('The picture could not be prepared for upload.'));
    }
  };
  img.src = objectUrl;
});

const dataUrlToBytes = (dataUrl) => {
  const binary = atob(dataUrl.slice(dataUrl.indexOf(',') + 1));
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
  return bytes;
};

// Scroll a zoomable map container so the point (xPct, yPct) of the map sits in the middle of the view.
// Waits for the map picture to be laid out first: before that the container has nothing to scroll to.
const centerMapOn = (container, xPct, yPct) => {
  if (!container) return;
  const img = container.querySelector('img');
  const go = () => {
    container.scrollTo({
      left: (xPct / 100) * container.scrollWidth - container.clientWidth / 2,
      top: (yPct / 100) * container.scrollHeight - container.clientHeight / 2,
      behavior: 'smooth'
    });
  };
  if (img && !img.complete) img.addEventListener('load', go, { once: true });
  else go();
};

// "Tue, Oct 6, 5:49 PM" (the year too when it is not this year)
const formatWhen = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  const date = d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', ...(d.getFullYear() !== new Date().getFullYear() ? { year: 'numeric' } : {}) });
  return `${date}, ${d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
};

// A relative hint only while it is under a day old, so it can never disagree with the day heading
const recentAgo = (iso) => {
  const diff = Date.now() - new Date(iso).getTime();
  return diff >= 0 && diff < 24 * 3600 * 1000 ? timeAgo(iso) : '';
};

// Calendar-day buckets so the rail reads "Today / Yesterday / ..." as it rolls
const dayBucket = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return 'Older';
  const today = new Date(); today.setHours(0, 0, 0, 0);
  d.setHours(0, 0, 0, 0);
  const days = Math.round((today - d) / 86400000);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days <= 7) return '2-7 days ago';
  if (days <= 30) return '8-30 days ago';
  return 'Older';
};

export default function App() {
  const [activeTab, setActiveTab] = useState('overview');
  const [submissions, setSubmissions] = useState([]);
  const [mainMapImage, setMainMapImage] = useState(null);
  
  // UI & View States
  const [globalZoom, setGlobalZoom] = useState(100);
  const [editingItem, setEditingItem] = useState(null);
  const [focusItem, setFocusItem] = useState(null);
  const [timeFilter, setTimeFilter] = useState('all');
  const [categoryFilter, setCategoryFilter] = useState([]); // [] = every category

  const [adminOpen, setAdminOpen] = useState(false);
  const [logs, setLogs] = useState([]);
  const [loadTime, setLoadTime] = useState(0);
  // Where observation pictures live. Until the table has been checked, saving a picture is held back.
  const [pictureColumn, setPictureColumn] = useState({ ready: false, name: null, type: null, reason: 'the app is still checking the observations table.' });

  // --- ADMIN LOGGER & HELPERS ---
  // Stable identity: effects that list logEvent as a dependency (like the edit-form setup in SubmitTab)
  // would otherwise re-run on every render, and each run logs, which renders again, and so on.
  // `request` ({ method, path, contentType }) is only for 'data' entries that are not the usual JSON call to the table
  const logEvent = useCallback((message, type = 'info', payload = null, request = null) => {
    setLogs(prev => [...prev, { time: new Date().toLocaleTimeString(), message, type, payload, request }]);
  }, []);

  const handleCopyPayload = (payload) => {
    const text = JSON.stringify(payload, null, 2);
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
    } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
    }
  };

  useEffect(() => {
    // UI FAILSAFE: Inject Tailwind CSS dynamically
    if (!document.getElementById('tailwind-cdn')) {
      const script = document.createElement('script');
      script.id = 'tailwind-cdn';
      script.src = 'https://cdn.tailwindcss.com';
      document.head.appendChild(script);
    }

    const initializeData = async () => {
      const startTime = performance.now();
      logEvent('App initialized. Building component tree...', 'debug');

      try {
        let baseUrl = '';
        if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) {
            baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
            logEvent(`Detected Xrm Context. Base URL: ${baseUrl}`, 'debug');
        } else {
            logEvent(`Xrm Context not found. Will attempt relative fetch (Dev Mode).`, 'warn');
        }

        // 1. Fetch Live Map Data
        try {
            logEvent('Attempting live HTTP connection to Dataverse Map API...', 'debug');
            const mapResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5___mapses?$select=craa5___mapsid,craa5_facility`, {
                headers: { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' }
            });

            if (mapResponse.ok) {
                const data = await mapResponse.json();
                const mapRecord = data.value.find(r => (r.craa5_facility || r.craa5_Facility)?.toUpperCase() === 'MAIN') || data.value[0];
                
                if (mapRecord) {
                    const recordId = mapRecord.craa5___mapsid || mapRecord.craa5___mapsId;
                    const imageUrl = `${baseUrl}/api/data/v9.2/craa5___mapses(${recordId})/craa5_mapimage/$value?size=full`;
                    logEvent(`Found live map record. Fetching full-res blob: ${imageUrl}`, 'info');
                    
                    const imgResponse = await fetch(imageUrl);
                    if (imgResponse.ok) {
                        const blob = await imgResponse.blob();
                        setMainMapImage(URL.createObjectURL(blob));
                        logEvent(`Success: Map Blob loaded (${(blob.size/1024).toFixed(2)} KB).`, 'success');
                    } else {
                        logEvent(`Failed to download map blob. Status: ${imgResponse.status}`, 'error');
                    }
                } else {
                    logEvent('No maps found in live table.', 'warn');
                }
            } else {
                logEvent(`Map API returned status: ${mapResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Map Live Fetch Failed: ${error.message}`, 'error');
        }

        // 2. Find the picture column, then fetch Live Observations Data
        try {
            let picColumn = { ready: false, name: null, type: null, reason: 'the picture column could not be checked.' };
            try {
                picColumn = await detectPictureColumn(logEvent);
            } catch (error) {
                picColumn.reason = `the picture column check failed (${error.message}).`;
                logEvent(`Picture column check failed: ${error.message}`, 'error');
            }
            setPictureColumn(picColumn);
            if (picColumn.ready) logEvent(`Pictures are stored in column "${picColumn.name}" (${picColumn.type || 'type unknown'}).`, 'info');
            else logEvent(`Pictures cannot be saved: ${picColumn.reason}`, 'warn');

            logEvent('Querying live observations from facilityobservations API...', 'debug');
            const baseSelect = 'craa5__facilityobservationid,craa5_mapx,craa5_mapy,craa5__boxwidth,craa5__boxheight,craa5__room,craa5__area,craa5__equipment,craa5__description,craa5__whotonotify,craa5__customnote,createdon';
            // Ask for the picture marker too; if Dataverse rejects a guessed column (HTTP 400) step down to a plainer query
            // so a wrong guess can never blank the whole map.
            const selectOptions = picColumn.ready ? pictureSelectOptions(picColumn.name, picColumn.type) : [[]];
            let obsResponse = null;
            let pictureFields = [];
            for (const extra of selectOptions) {
                const select = extra.length ? `${baseSelect},${extra.join(',')}` : baseSelect;
                obsResponse = await fetch(`${baseUrl}/api/data/v9.2/craa5__facilityobservations?$select=${select}&$expand=createdby($select=fullname)&$orderby=createdon desc`, {
                    headers: { 
                      'Accept': 'application/json', 
                      'OData-MaxVersion': '4.0', 
                      'OData-Version': '4.0',
                      'Prefer': 'odata.include-annotations="*"'
                    }
                });
                if (obsResponse.status !== 400) { pictureFields = extra; break; }
                logEvent(`Observation query with picture fields [${extra.join(', ') || 'none'}] was rejected (HTTP 400).`, 'warn');
            }

            if (obsResponse.ok) {
               const obsData = await obsResponse.json();
               if (picColumn.ready && pictureFields.length === 0) logEvent('Could not tell which observations have pictures; trying to show a picture for every one.', 'warn');
               const mappedObs = obsData.value.map(item => {
                  const id = item.craa5__facilityobservationid;
                  const hasPicture = picColumn.ready ? rowHasPicture(item, picColumn.name, pictureFields) : false;
                  return {
                  id,
                  mapX: item.craa5_mapx || 0,
                  mapY: item.craa5_mapy || 0,
                  boxW: item.craa5__boxwidth || 10,
                  boxH: item.craa5__boxheight || 10,
                  room: item.craa5__room || '',
                  area: item.craa5__area || 'Unknown Area',
                  equipment: item.craa5__equipment || '',
                  description: item.craa5__description || '',
                  whoToNotify: item.craa5__whotonotify || '',
                  ...parseCategory(item.craa5__customnote),
                  image: null,
                  picture: hasPicture === false ? null : storedPictureUrls(picColumn.name, id),
                  submittedOn: item.createdon,
                  submittedBy: item.createdby ? item.createdby.fullname : (item['_createdby_value@OData.Community.Display.V1.FormattedValue'] || 'Unknown')
                  };
               });
               setSubmissions(mappedObs);
               logEvent(`Successfully loaded ${mappedObs.length} live observations.`, 'success');
            } else {
               logEvent(`Observation API returned status: ${obsResponse.status}`, 'error');
            }
        } catch (error) {
            logEvent(`Observation Live Fetch Failed: ${error.message}`, 'error');
        }

      } catch (fatalError) {
        logEvent(`Fatal initialization error: ${fatalError.message}`, 'error');
      }

      const endTime = performance.now();
      setLoadTime((endTime - startTime).toFixed(2));
    };

    initializeData();
  }, []);

  // --- TIMEFRAME FILTERING LOGIC ---
  const timeFilteredSubmissions = useMemo(() => {
    const now = new Date();
    return submissions.filter(sub => {
      if (timeFilter === 'all') return true;
      const subDate = new Date(sub.submittedOn);
      const diffHours = (now - subDate) / (1000 * 60 * 60);
      if (timeFilter === '24h') return diffHours <= 24;
      if (timeFilter === '7d') return diffHours <= 24 * 7;
      if (timeFilter === '30d') return diffHours <= 24 * 30;
      return true;
    });
  }, [submissions, timeFilter]);

  // --- CATEGORY FILTERING LOGIC (shared by the map, sidebar, gallery and action rail) ---
  const categoryCounts = useMemo(() => {
    const counts = {};
    timeFilteredSubmissions.forEach(sub => { counts[sub.category] = (counts[sub.category] || 0) + 1; });
    return counts;
  }, [timeFilteredSubmissions]);

  const filteredSubmissions = useMemo(() => (
    categoryFilter.length === 0
      ? timeFilteredSubmissions
      : timeFilteredSubmissions.filter(sub => categoryFilter.includes(sub.category))
