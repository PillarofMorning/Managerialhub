  const toPicture = (u, v) => {
    const p = unturnPoint(rotation, u, v);
    return [clampPct(p[0] * 100), clampPct(p[1] * 100)];
  };

  // What to do with a picked spot: the asset being placed gets it, otherwise "which asset is here?"
  const usePicked = (next) => {
    if (placingFor) { setSpot(next); return; }
    guard(() => {
      setSelectedId(null);
      setCreating(null);
      setSpot(next);
    });
  };

  const pickPoint = async (x, y) => {
    if (savingSpot) return;
    const seq = clickSeq.current + 1;
    clickSeq.current = seq;
    setActionError('');
    let region = null;
    let note = '';
    if (!mapColumn) note = 'nocolumn';
    else if (snapOn && mapImage) {
      setSnapBusy(true);
      try {
        const grid = await getSnapGrid(mapImage);
        region = snapAt(grid, x, y);
        if (!region) note = 'none';
      } catch (error) {
        note = `error:${error.message}`;
        logEvent(`Smart snap is not available: ${error.message}`, 'warn');
      }
      if (seq === clickSeq.current) setSnapBusy(false);
    } else if (snapOn && !mapImage) note = 'nomap';
    if (seq !== clickSeq.current) return; // a later pick won
    // Inside the area the pin stays where it was clicked (so several assets in one room don't sit on one point);
    // a click on a line, a label or a solid shape puts it in the middle
    const next = region
      ? { x: region.inside ? x : region.x, y: region.inside ? y : region.y, box: region.box, snapped: true, how: 'click', region, note: '' }
      : { x, y, box: null, snapped: false, how: 'click', region: null, note };
    logEvent(region ? `Smart snap found an outlined area around ${round2(next.x)}%, ${round2(next.y)}%.` : `Map spot picked at ${round2(x)}%, ${round2(y)}% (${note || 'smart snap off'}).`, 'debug');
    usePicked(next);
  };

  const pickBox = async (rect) => {
    if (savingSpot) return;
    const seq = clickSeq.current + 1;
    clickSeq.current = seq;
    setActionError('');
    const box = [rect[0], rect[1], rect[2] - rect[0], rect[3] - rect[1]];
    const middle = [rect[0] + box[2] / 2, rect[1] + box[3] / 2];
    let region = null;
    let note = '';
    if (!mapColumn) note = 'nocolumn';
    else if (snapOn && mapImage) {
      setSnapBusy(true);
      try {
        const grid = await getSnapGrid(mapImage);
        region = snapBox(grid, rect);
        if (!region) note = 'nolines';
      } catch (error) {
        note = `error:${error.message}`;
        logEvent(`Smart snap is not available: ${error.message}`, 'warn');
      }
      if (seq === clickSeq.current) setSnapBusy(false);
    } else if (snapOn && !mapImage) note = 'nomap';
    if (seq !== clickSeq.current) return;
    const next = region
      ? { x: region.x, y: region.y, box: region.box, snapped: true, how: 'box', region, note: '' }
      : { x: middle[0], y: middle[1], box, snapped: false, how: 'box', region: null, note };
    logEvent(region ? `Smart snap fitted the box to the lines at ${region.box.map(round2).join(', ')}.` : `Map box drawn at ${box.map(round2).join(', ')} (${note || 'smart snap off'}).`, 'debug');
    usePicked(next);
  };

  // Pointer gestures on the map: a click picks a point; a drag draws a box (or moves the map); two fingers zoom and move
  const gesture = useRef({ pointers: {}, mode: '', start: null, pinch: null });
  const onPointerDown = (e) => {
    if (e.pointerType === 'mouse' && e.button !== 0 && e.button !== 1) return;
    const pinEl = e.target && e.target.closest ? e.target.closest('[data-asset-pin]') : null;
    if (pinEl && !placingFor) return; // the pin's own click opens it
    const g = gesture.current;
    g.pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) { /* not needed for a plain click */ }
    const ids = Object.keys(g.pointers);
    if (ids.length === 2) {
      const a = g.pointers[ids[0]];
      const b = g.pointers[ids[1]];
      g.mode = 'pinch';
      g.start = null;
      g.pinch = { dist: Math.hypot(a.x - b.x, a.y - b.y), zoom: zoomRef.current.level, mid: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } };
      setDragRect(null);
      return;
    }
    if (ids.length > 2) return;
    const c = containerRef.current;
    if (e.button === 1) e.preventDefault();
    g.mode = 'press';
    g.start = { id: e.pointerId, x: e.clientX, y: e.clientY, left: c ? c.scrollLeft : 0, top: c ? c.scrollTop : 0, button: e.button, pan: e.button === 1 || dragMode === 'move', frac: stageFraction(e.clientX, e.clientY) };
  };
  const onPointerMove = (e) => {
    const g = gesture.current;
    if (!g.pointers[e.pointerId]) return;
    g.pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
    const c = containerRef.current;
    // Pointer moves are in screen pixels; scrolling is in the map's own pixels, which the app's zoom scales
    const perPx = () => { const w = c ? c.getBoundingClientRect().width : 0; return w > 0 ? c.offsetWidth / w : 1; };
    if (g.mode === 'pinch') {
      const ids = Object.keys(g.pointers);
      if (ids.length < 2 || !c) return;
      const a = g.pointers[ids[0]];
      const b = g.pointers[ids[1]];
      const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      const k = perPx();
      c.scrollLeft -= (mid.x - g.pinch.mid.x) * k;
      c.scrollTop -= (mid.y - g.pinch.mid.y) * k;
      g.pinch.mid = mid;
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      if (g.pinch.dist > 0) {
        const z = g.pinch.zoom * (dist / g.pinch.dist);
        if (Math.abs(z - zoomRef.current.level) >= 2) zoomTo(z, mid.x, mid.y);
      }
      return;
    }
    const s = g.start;
    if (!s || s.id !== e.pointerId) return;
    const dx = e.clientX - s.x;
    const dy = e.clientY - s.y;
    if (g.mode === 'press') {
      if (Math.hypot(dx, dy) < 6) return;
      g.mode = s.pan ? 'pan' : 'box';
    }
    if (g.mode === 'pan') {
      if (c) { const k = perPx(); c.scrollLeft = s.left - dx * k; c.scrollTop = s.top - dy * k; }
      return;
    }
    if (g.mode === 'box') {
      const f = stageFraction(e.clientX, e.clientY);
      setDragRect([s.frac[0], s.frac[1], f[0], f[1]]);
    }
  };
  const onPointerEnd = (e) => {
    const g = gesture.current;
    if (!g.pointers[e.pointerId]) return;
    delete g.pointers[e.pointerId];
    if (g.mode === 'pinch') {
      if (Object.keys(g.pointers).length === 0) { g.mode = ''; g.pinch = null; }
      return;
    }
    const s = g.start;
    const mode = g.mode;
    g.mode = '';
    g.start = null;
    if (!s || s.id !== e.pointerId) return;
    if (e.type === 'pointercancel') { setDragRect(null); return; }
    if (mode === 'press') {
      if (s.button === 1) return; // the middle button only moves the map
      const p = toPicture(s.frac[0], s.frac[1]);
      pickPoint(p[0], p[1]);
    } else if (mode === 'box') {
      setDragRect(null);
      const f = stageFraction(e.clientX, e.clientY);
      const a = toPicture(s.frac[0], s.frac[1]);
      const b = toPicture(f[0], f[1]);
      const rect = [Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.max(a[0], b[0]), Math.max(a[1], b[1])];
      // A box too small to mean anything is a click
      if (rect[2] - rect[0] < 0.4 && rect[3] - rect[1] < 0.4) pickPoint((rect[0] + rect[2]) / 2, (rect[1] + rect[3]) / 2);
      else pickBox(rect);
    }
  };

  const openAsset = (asset, center) => {
    const go = () => {
      setCreating(null);
      setSpot(null);
      setPlacingFor(null);
      setActionError('');
      setSelectedId(asset.id);
      if (center && asset.location && pinOnMap(asset.location, mapKey)) centerOn(asset.location);
    };
    // The asset already open: nothing to lose
    if (asset.id === selectedId && !creating) go();
    else guard(go);
  };

  // Asked from the table: open this asset here
  useEffect(() => {
    if (!focus) return;
    const pin = assetPins.rows.find(p => p.id === focus.id);
    openAsset(pin || { id: focus.id, location: null }, true);
  }, [focus && focus.n]); // eslint-disable-line react-hooks/exhaustive-deps

  const closePanel = () => guard(() => {
    setSelectedId(null);
    setCreating(null);
    setPlacingFor(null);
    setSpot(null);
    setActionError('');
  });

  const startNew = (location) => guard(() => {
    setSelectedId(null);
    setPlacingFor(null);
    setSpot(null);
    setActionError('');
    setCreating({ location: location || null });
  });

  // Save (or clear) one asset's spot. Resolves to the saved summary.
  const saveSpot = async (asset, s) => {
    const text = s ? mapLocationText(s, mapKey, meta.mapColumn.maxLength) : null;
    const row = await patchAsset(set, asset.id, { [mapColumn]: text }, '*', logEvent);
    const summary = toAssetSummary(row, mapColumn);
    saved(row, false);
    setRefreshToken(t => t + 1);
    logEvent(s ? `Saved the map spot of ${summary.name}.` : `Removed ${summary.name} from the map.`, 'success');
    return summary;
  };

  const confirmPlacing = async () => {
    if (!spot || !placingFor) return;
    if (placingFor.id === 'new') {
      if (creating) setCreating(c => ({ ...(c || {}), location: spot }));
      setPlacingFor(null);
      setSpot(null);
      return;
    }
    setSavingSpot(true);
    setActionError('');
    try {
      await saveSpot(placingFor, spot);
      setPlacingFor(null);
      setSpot(null);
    } catch (error) {
      logEvent(`Map spot not saved: ${error.message}`, 'error');
      setActionError(`The spot was not saved: ${error.message}`);
    } finally {
      setSavingSpot(false);
    }
  };

  const assignSpot = async (asset) => {
    const summary = await saveSpot(asset, spot);
    setSpot(null);
    setSelectedId(summary.id);
    return summary;
  };

  const removeFromMap = async (asset) => {
    await saveSpot(asset, null);
  };

  const panel = creating ? 'editor' : (selectedId ? 'card' : (spot && !placingFor ? 'spot' : 'list'));
  const placingName = placingFor ? (placingFor.id === 'new' ? 'the new asset' : placingFor.name) : '';

  let pinsLine = '';
  if (!metaDone) pinsLine = 'Reading the Assets table...';
  else if (!mapColumn) pinsLine = 'Assets cannot be placed on the map yet.';
  else if (assetPins.status === 'loading') pinsLine = 'Loading the placed assets...';
  else if (assetPins.status === 'error') pinsLine = `The placed assets could not be loaded: ${assetPins.error}`;
  else {
    pinsLine = `${pinsHere.length} asset${pinsHere.length === 1 ? '' : 's'} on the map`;
    if (pinWords.length) pinsLine += `, ${visiblePins.length} match${visiblePins.length === 1 ? 'es' : ''} the search`;
    if (otherMapPins > 0) pinsLine += ` (${otherMapPins} on other maps)`;
    if (assetPins.capped) pinsLine += ` - only the first ${ASSET_PIN_MAX} are drawn`;
  }

  const toolButton = 'inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB] disabled:opacity-50';
  // Where a pin's name shows: below it when the pin is near the top of the view
  const labelBelow = (loc) => turnPoint(rotation, loc.x / 100, loc.y / 100)[1] < 0.15;
  const pinTransform = `translate(-50%, -50%) rotate(${-rotation}deg)`;

  return (
    <div
      ref={rootRef}
      className={`${popped ? 'fixed inset-0 z-[300]' : 'h-full'} flex flex-col md:flex-row bg-slate-100 p-4 md:p-6 pt-3 md:pt-4 overflow-y-auto md:overflow-hidden gap-4`}
      data-testid="assets-map-view"
      data-popped={popped ? 'true' : 'false'}
    >
      {/* Map */}
      <div className="flex-1 flex flex-col md:min-h-0 md:overflow-hidden">
        <div className="mb-2 shrink-0 flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 className="text-2xl font-black text-[#00468B]">Asset Map</h2>
            <p className="text-sm text-slate-500">Click a room, or drag a box around something, to put an asset there. Click a pin to open its asset.</p>
          </div>
          <SearchBox query={query} onQuery={setQuery} placeholder="Search assets: name, room, area..." ariaLabel="Search assets" className="w-full sm:w-80" />
        </div>
        <div className="mb-2 shrink-0 flex flex-wrap items-center gap-x-2 gap-y-2">
          <Switch
            on={snapOn}
            onChange={setSnapOn}
            label="Smart snap"
            title={snapOn ? 'A click finds the outlined area around it; a dragged box is fitted to the black lines inside it.' : 'A click puts the pin exactly where you click; a dragged box is used as drawn.'}
          />
          <div className="inline-flex shrink-0 rounded-full border border-[#B3D4F2] bg-white p-0.5" role="group" aria-label="What dragging on the map does">
            {[['box', 'Drag: box'], ['move', 'Drag: move map']].map(([key, label]) => (
              <button
                key={key}
                type="button"
                onClick={() => setDragMode(key)}
                aria-pressed={dragMode === key}
                className={`px-2.5 py-0.5 rounded-full text-xs font-bold whitespace-nowrap transition-colors ${dragMode === key ? 'bg-[#00468B] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]'}`}
              >
                {label}
              </button>
            ))}
          </div>
          <button type="button" onClick={() => rotate(-90)} className={toolButton} title="Turn the map a quarter turn to the left" aria-label="Turn the map left"><RotateLeft className="w-4 h-4" /></button>
          <button type="button" onClick={() => rotate(90)} className={toolButton} title="Turn the map a quarter turn to the right" aria-label="Turn the map right"><RotateRight className="w-4 h-4" /></button>
          <button type="button" onClick={fit} className={toolButton} title="Show the whole map">Fit</button>
          <button type="button" onClick={() => setPop(!popped)} className={toolButton} title={popped ? 'Back to the normal view (Esc)' : 'Make the map fill the screen'} aria-pressed={popped}>
            {popped ? <PopInIcon className="w-4 h-4" /> : <PopOutIcon className="w-4 h-4" />}
            {popped ? 'Close pop-out' : 'Pop out'}
          </button>
          <span className="text-xs text-slate-600" role="status">{pinsLine}</span>
          {assetPins.status === 'error' && <button type="button" onClick={loadPins} className="text-xs text-[#0072CE] underline hover:text-[#00468B]">Try again</button>}
          {metaDone && (!mapColumn || meta.mapPicked || !!readColumnPick('assetMap')) && (
            <div className="basis-full">
              <ColumnFix
                need="Map spot column"
                message={mapColumn ? '' : `To place assets: ${meta.mapReason || 'the map column is missing.'}`}
                expected="craa5_maplocation"
                expectedLabel="Map Location"
                expectedType="Single line of text"
                found={mapColumn || ''}
                candidates={(meta.fields || []).filter(f => (f.kind === 'text' || f.kind === 'memo') && f.canUpdate && !f.isPrimaryName && ASSET_MAP_NOT_THESE.indexOf(f.name) === -1)}
                picked={meta.mapPicked ? mapColumn : ''}
                typed={readColumnPick('assetMap')}
                onPick={(name) => { writeColumnPick('assetMap', name); loadAssetMeta(); }}
                onRecheck={loadAssetMeta}
                checking={meta.status === 'loading' || !!meta.rechecking}
                checkError={meta.recheckError}
                testId="asset-map-fix"
              />
            </div>
          )}
        </div>

        <div className="flex-1 relative min-h-[50vh] md:min-h-0">
          {!mapImage && <MapNote note={mapNote} className="absolute top-2 left-2 right-2 z-40" />}
          <div className="absolute inset-0 rounded-xl shadow-inner border border-slate-400/50 bg-slate-300 overflow-auto" ref={containerRef}>
            <div
              ref={stageRef}
              className={`relative mx-auto select-none ${snapBusy ? 'cursor-wait' : (dragMode === 'move' ? 'cursor-grab' : 'cursor-crosshair')}`}
              style={stageStyle}
              onPointerDown={onPointerDown}
              onPointerMove={onPointerMove}
              onPointerUp={onPointerEnd}
              onPointerCancel={onPointerEnd}
              onContextMenu={e => { if (gesture.current.mode) e.preventDefault(); }}
              data-testid="asset-map"
              data-rotation={rotation}
            >
              <div className="absolute" style={pictureStyle} data-testid="asset-picture">
                {mapImage ? (
                  <img
                    src={mapImage}
                    onLoad={e => { const im = e.currentTarget; if (im.naturalWidth && im.naturalHeight) setNatural({ w: im.naturalWidth, h: im.naturalHeight }); }}
                    onError={() => setMainMapImage(null)}
                    alt="Facility map with assets"
                    className="w-full h-full block pointer-events-none select-none"
                    draggable="false"
                  />
                ) : (
                  <div className="w-full h-full"><FacilityMapSvg /></div>
                )}

                {/* The open asset's area */}
                {selectedRegion && <RegionOverlay region={selectedRegion} fill="#0072CE" edge="#00468B" testId="selected-region" />}
                {!selectedRegion && selectedLocation && selectedLocation.box && (
                  <div className="absolute border-2 border-[#00468B] bg-[#0072CE]/15 rounded-sm pointer-events-none" style={{ left: `${selectedLocation.box[0]}%`, top: `${selectedLocation.box[1]}%`, width: `${selectedLocation.box[2]}%`, height: `${selectedLocation.box[3]}%` }} />
                )}
                {/* The picked spot, or the spot a new asset will get */}
                {spot && spot.region && <RegionOverlay region={spot.region} fill="#FFB81C" edge="#00468B" testId="spot-region" />}
                {spot && !spot.region && spot.box && (
                  <div data-testid="spot-box" className="absolute border-2 border-dashed border-[#00468B] bg-[#FFB81C]/25 pointer-events-none" style={{ left: `${spot.box[0]}%`, top: `${spot.box[1]}%`, width: `${spot.box[2]}%`, height: `${spot.box[3]}%` }} />
                )}
                {!spot && creating && creating.location && creating.location.region && <RegionOverlay region={creating.location.region} fill="#FFB81C" edge="#00468B" testId="new-spot-region" />}

                {visiblePins.map(pin => {
                  const selected = pin.id === selectedId;
                  const moving = placingFor && placingFor.id === pin.id;
                  const off = pinOffsets[pin.id];
                  return (
                    <button
                      type="button"
                      key={pin.id}
                      data-asset-pin={pin.id}
                      aria-label={`Asset ${pin.name}`}
                      onClick={(e) => { e.stopPropagation(); logEvent(`Asset pin clicked: ${pin.name}`, 'info'); openAsset(pin, false); }}
                      className={`absolute group p-1 ${selected ? 'z-20' : 'z-10'} ${moving ? 'opacity-40' : ''} ${placingFor ? 'pointer-events-none' : ''}`}
                      style={{ left: `${pin.location.x}%`, top: `${pin.location.y}%`, marginLeft: off ? off[0] : 0, marginTop: off ? off[1] : 0, transform: pinTransform }}
                    >
                      <span className={`block rounded-full border-2 shadow transition-transform ${selected ? 'w-5 h-5 bg-[#FFB81C] border-[#00468B]' : 'w-3.5 h-3.5 bg-[#0072CE] border-white group-hover:scale-125'}`} />
                      <span className={`absolute ${labelBelow(pin.location) ? 'top-full mt-1' : 'bottom-full mb-1'} left-1/2 transform -translate-x-1/2 bg-slate-900/90 text-white text-xs text-left px-2 py-1 rounded w-max max-w-[16rem] break-words pointer-events-none shadow-lg ${selected ? 'block' : 'hidden group-hover:block'}`}>
                        <span className="font-bold block">{pin.name}</span>
                        {(pin.room || pin.area) && <span className="text-slate-300">{[pin.room, pin.area].filter(Boolean).join(' · ')}</span>}
                      </span>
                    </button>
                  );
                })}

                {!spot && creating && creating.location && (
                  <span
                    data-testid="new-spot-pin"
                    className="absolute w-5 h-5 rounded-full bg-[#FFB81C] border-2 border-[#00468B] shadow-lg pointer-events-none z-30"
                    style={{ left: `${creating.location.x}%`, top: `${creating.location.y}%`, transform: 'translate(-50%, -50%)' }}
                  />
                )}
                {spot && (
                  <span
                    data-testid="spot-pin"
                    className="absolute w-5 h-5 rounded-full bg-[#FFB81C] border-2 border-[#00468B] shadow-lg pointer-events-none z-30"
                    style={{ left: `${spot.x}%`, top: `${spot.y}%`, transform: 'translate(-50%, -50%)' }}
                  />
                )}
              </div>
              {/* The box being drawn (on the map as seen) */}
              {dragRect && (
                <div
                  data-testid="drag-box"
                  className="absolute border-2 border-dashed border-[#E4002B] bg-[#E4002B]/10 pointer-events-none z-40"
                  style={{ left: `${Math.min(dragRect[0], dragRect[2]) * 100}%`, top: `${Math.min(dragRect[1], dragRect[3]) * 100}%`, width: `${Math.abs(dragRect[2] - dragRect[0]) * 100}%`, height: `${Math.abs(dragRect[3] - dragRect[1]) * 100}%` }}
                />
              )}
            </div>
          </div>
          <div className="absolute bottom-4 right-4 bg-white rounded-lg shadow-lg flex items-center border border-slate-200 z-10">
            <button type="button" onClick={() => zoomStep(-1)} className="p-2 hover:bg-slate-100 text-slate-700 rounded-l-lg transition-colors" title="Zoom Out" aria-label="Zoom out"><ZoomOut className="w-5 h-5" /></button>
            <span className="px-3 text-sm font-bold text-slate-700 border-x border-slate-200 min-w-[3.5rem] text-center" data-testid="asset-zoom">{zoomLevel}%</span>
            <button type="button" onClick={() => zoomStep(1)} className="p-2 hover:bg-slate-100 text-slate-700 rounded-r-lg transition-colors" title="Zoom In" aria-label="Zoom in"><ZoomIn className="w-5 h-5" /></button>
          </div>

          {/* Placing an asset: what to do, then save */}
          {placingFor && (
            <div className="absolute left-3 right-3 sm:right-auto bottom-3 z-30 bg-white rounded-xl shadow-xl border-2 border-[#FFB81C] p-3 max-w-md" role="status">
              {!spot ? (
                <p className="text-sm text-slate-700"><span className="font-bold text-[#00468B]">Click the map where {placingName} is, or drag a box around it.</span> {snapOn ? 'Smart snap fits it to the lines.' : 'The pin goes exactly where you click.'}</p>
              ) : (
                <SpotNote spot={spot} />
              )}
              {actionError && <p className="text-xs text-[#C4001F] mt-1" role="alert">{actionError}</p>}
              <div className="flex flex-wrap gap-2 mt-2">
                {spot && (
                  <button type="button" onClick={confirmPlacing} disabled={savingSpot} className="bg-[#0072CE] text-white px-3 py-1.5 rounded-md text-sm font-semibold hover:bg-[#00468B] disabled:opacity-60">
                    {savingSpot ? 'Saving...' : (placingFor.id === 'new' ? 'Use this spot' : 'Save this spot')}
                  </button>
                )}
                <button type="button" onClick={() => { setPlacingFor(null); setSpot(null); setActionError(''); }} disabled={savingSpot} className="px-3 py-1.5 rounded-md text-sm font-semibold border border-slate-300 text-slate-700 hover:bg-slate-100">Cancel</button>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Side panel: list, "assign this spot", the open asset, or the new-asset form */}
      <aside className="w-full md:w-[22rem] lg:w-[26rem] bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden shrink-0 h-[80vh] md:h-full" aria-label="Assets panel">
        {pendingNav && (
          <div className="p-3 bg-[#FFF6E0] border-b-2 border-[#FFB81C] text-sm shrink-0" role="alert">
            <p className="font-semibold text-slate-800">This asset has unsaved changes.</p>
            <div className="flex gap-2 mt-2">
              <button type="button" onClick={() => { const run = pendingNav.run; setPendingNav(null); setDirty(false); run(); }} className="px-3 py-1 rounded-md text-xs font-bold bg-[#E4002B] text-white hover:bg-[#C4001F]">Discard changes</button>
              <button type="button" onClick={() => setPendingNav(null)} className="px-3 py-1 rounded-md text-xs font-bold border border-slate-300 text-slate-700 hover:bg-slate-100">Keep editing</button>
            </div>
          </div>
        )}

        {panel === 'editor' && (
          <AssetEditor
            key="new"
            meta={meta}
            set={set}
            assetId={null}
            createLocation={creating ? creating.location : null}
            mapKey={mapKey}
            placing={!!placingFor}
            refreshToken={0}
            onRetryMeta={loadAssetMeta}
            onDirtyChange={setDirty}
            onClose={closePanel}
            onSaved={(row) => saved(row, false)}
            onCreated={(row) => {
              const summary = toAssetSummary(row, mapColumn);
              saved(row, true);
              setDirty(false);
              setCreating(null);
              setPlacingFor(null);
              setSpot(null);
              setSelectedId(summary.id);
              logEvent(`Created asset ${summary.name} (${summary.id}).`, 'success');
            }}
            onPlace={(asset) => { setSpot(null); setActionError(''); setPlacingFor(asset); }}
            onClearNewSpot={() => setCreating(c => ({ ...(c || {}), location: null }))}
            logEvent={logEvent}
          />
        )}

        {panel === 'card' && (
          <AssetCard
            key={selectedId}
            meta={meta}
            set={set}
            assetId={selectedId}
            mapKey={mapKey}
            pinLocation={selectedPin ? selectedPin.location : undefined}
            placing={!!placingFor}
            refreshToken={refreshToken}
            onRetryMeta={loadAssetMeta}
            onClose={closePanel}
            onPlace={(asset) => { setSpot(null); setActionError(''); setPlacingFor(asset); }}
            onRemoveFromMap={removeFromMap}
            onLocate={(loc) => centerOn(loc)}
            onEditInTable={onEditInTable}
            logEvent={logEvent}
          />
        )}

        {panel === 'spot' && (
          <AssignSpot
            spot={spot}
            set={set}
            mapColumn={mapColumn}
            mapReason={meta.mapReason}
            canCreate={meta.status === 'ready'}
            onAssign={assignSpot}
            onCreate={() => startNew(spot && spot.note !== 'nocolumn' ? spot : null)}
            onCancel={() => setSpot(null)}
            logEvent={logEvent}
          />
        )}

        <div className={panel === 'list' ? 'flex flex-col flex-1 min-h-0' : 'hidden'}>
          <AssetBrowser
            meta={meta}
            list={list}
            words={words}
            searching={query !== debounced}
            placement={placement}
            setPlacement={setPlacement}
            room={room}
            setRoom={setRoom}
            rooms={rooms}
            mapColumn={mapColumn}
            mapKey={mapKey}
            onShowMore={showMore}
            onOpen={(a) => openAsset(a, true)}
            onNew={() => startNew(null)}
          />
        </div>
      </aside>
    </div>
  );
}

// ==========================================
// THE OPEN ASSET ON THE MAP: a short card; everything else is edited in the equipment table
// ==========================================
function AssetCard({ meta, set, assetId, mapKey, pinLocation, placing, refreshToken, onRetryMeta, onClose, onPlace, onRemoveFromMap, onLocate, onEditInTable, logEvent }) {
  const mapColumn = meta.mapColumn ? meta.mapColumn.name : null;
  const imageField = useMemo(() => meta.fields.find(f => f.kind === 'image') || null, [meta.fields]);
  const [load, setLoad] = useState({ status: 'loading', row: null, error: '' });
  const [confirmRemove, setConfirmRemove] = useState(false);
  const [removing, setRemoving] = useState(false);
  const [error, setError] = useState('');
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);

  const read = useCallback(async (quiet) => {
    if (!quiet) setLoad(l => ({ ...l, status: 'loading', error: '' }));
    try {
      const row = await loadAssetRow(set, assetId, imageField ? [imageField.name] : []);
      if (mounted.current) setLoad({ status: 'ready', row, error: '' });
    } catch (e) {
      logEvent(`Asset ${assetId} could not be read: ${e.message}`, 'error');
      if (mounted.current && !quiet) setLoad({ status: 'error', row: null, error: e.message });
    }
  }, [set, assetId, imageField, logEvent]);
  useEffect(() => { read(false); }, [read]);
  useEffect(() => { if (refreshToken) read(true); }, [refreshToken]); // eslint-disable-line react-hooks/exhaustive-deps

  const row = load.row;
  const title = row ? (row[ASSET_NAME_COLUMN] || '(no name)') : 'Asset';
  const place = row ? [row.craa5_roomname, row.craa5_areaname].filter(v => v && String(v).trim()).join(' · ') : '';
  const location = pinLocation !== undefined ? pinLocation : (row && mapColumn ? parseMapLocation(row[mapColumn]) : null);
  const onThisMap = pinOnMap(location, mapKey);

  // A short summary: the cleaning frequencies that are on, and a few filled-in columns
  const summary = useMemo(() => {
    if (!row) return { freq: [], facts: [] };
    const { groups } = groupAssetFields(meta.fields.filter(f => f.name !== mapColumn));
    const freq = groups.find(g => g.key === 'freq');
    const main = groups.find(g => g.key === 'main');
    const skip = [ASSET_NAME_COLUMN, 'craa5_roomname', 'craa5_areaname'];
    const factFields = (freq ? freq.items.filter(f => f.kind !== 'bool') : []).concat(main ? main.items.filter(f => skip.indexOf(f.name) === -1) : []);
    return {
      freq: freq ? freq.items.filter(f => f.kind === 'bool' && row[f.name] === true).map(f => f.label) : [],
      facts: factFields.map(f => [f.label, displayValue(f, row)]).filter(x => x[1] !== '' && x[1] !== null && x[1] !== undefined).slice(0, 6)
    };
  }, [row, meta.fields, mapColumn]);

  const stamp = row && imageField ? (row[`${imageField.name}_timestamp`] || '') : '';
  const hasPicture = !!(row && imageField && (row[imageField.name] || row[`${imageField.name}_timestamp`] || row[`${imageField.name}_url`]));
  const pictureSources = hasPicture
    ? (imageField.fullImage === false ? [] : [apiUrl(`${set}(${assetId})/${imageField.name}/$value?size=full&t=${encodeURIComponent(String(stamp))}`)]).concat([apiUrl(`${set}(${assetId})/${imageField.name}/$value?t=${encodeURIComponent(String(stamp))}`)])
    : [];

  return (
    <div className="flex flex-col flex-1 min-h-0" data-testid="asset-card">
      <div className="p-4 border-b-2 border-[#E6F1FB] shrink-0 space-y-2">
        <EditorHeader title={title} subtitle={place} onClose={onClose} isNew={false} />
        <div className="flex flex-wrap items-center gap-2 text-xs">
          {!mapColumn ? (
            <span className="text-[#9A6700]">Map spot: {meta.mapReason}</span>
          ) : placing ? (
            <span className="font-semibold text-[#00468B]">Click the map where this asset is, or drag a box around it...</span>
          ) : load.status !== 'ready' ? null : (
            <>
              <span className={`inline-flex items-center gap-1 font-semibold ${onThisMap ? 'text-[#00468B]' : 'text-slate-500'}`}>
                <MapPin className="w-3.5 h-3.5" />
                {onThisMap ? 'On the map' : (location ? `On another map (${location.map})` : 'Not on the map')}
              </span>
              {onThisMap && <button type="button" onClick={() => onLocate(location)} className="px-2 py-1 rounded-md font-bold border border-[#B3D4F2] text-[#0072CE] hover:bg-[#E6F1FB]">Show</button>}
              <button type="button" onClick={() => onPlace({ id: assetId, name: title })} className="px-2 py-1 rounded-md font-bold bg-[#0072CE] text-white hover:bg-[#00468B]">{location ? 'Move' : 'Place on map'}</button>
              {location && !confirmRemove && <button type="button" onClick={() => setConfirmRemove(true)} className="px-2 py-1 rounded-md font-bold border border-slate-300 text-slate-600 hover:bg-slate-100">Remove from map</button>}
              {confirmRemove && (
                <span className="inline-flex items-center gap-1.5 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1">
                  Remove the pin?
                  <button
                    type="button"
                    disabled={removing}
                    onClick={async () => {
                      setRemoving(true);
                      setError('');
                      try { await onRemoveFromMap({ id: assetId, name: title }); if (mounted.current) setConfirmRemove(false); }
                      catch (e) { logEvent(`Could not remove ${title} from the map: ${e.message}`, 'error'); if (mounted.current) setError(`The pin was not removed: ${e.message}`); }
                      finally { if (mounted.current) setRemoving(false); }
                    }}
                    className="font-bold text-[#C4001F] underline"
                  >
                    {removing ? 'Removing...' : 'Remove'}
                  </button>
                  <button type="button" onClick={() => setConfirmRemove(false)} className="font-bold text-slate-600 underline">Keep</button>
                </span>
              )}
            </>
          )}
        </div>
        {error && <p className="text-xs text-[#C4001F]" role="alert">{error}</p>}
      </div>

      <div className="flex-1 overflow-y-auto p-4 space-y-3">
        {meta.fields.length === 0 && meta.status === 'error' && (
          <div className="text-sm text-[#C4001F]" role="alert">
            The Assets table's columns could not be read: {meta.error}
            <div><button type="button" onClick={onRetryMeta} className="mt-2 text-[#0072CE] underline">Try again</button></div>
          </div>
        )}
        {load.status === 'loading' && <p className="text-sm text-slate-500">Loading the asset...</p>}
        {load.status === 'error' && (
          <div className="text-sm text-[#C4001F]" role="alert">
            This asset could not be loaded: {load.error}
            <div><button type="button" onClick={() => read(false)} className="mt-2 text-[#0072CE] underline">Try again</button></div>
          </div>
        )}
        {load.status === 'ready' && (
          <>
            {hasPicture && (
              <div className="rounded-md border border-slate-200 bg-slate-50 overflow-hidden">
                <StoredImage key={pictureSources.join('|')} sources={pictureSources} alt={imageField.label} className="w-full h-auto max-h-48 object-contain" fallback={<p className="text-xs text-slate-500 p-2">The picture could not be shown.</p>} />
              </div>
            )}
            {summary.freq.length > 0 && (
              <div className="flex flex-wrap gap-1.5" aria-label="Cleaning frequency">
                {summary.freq.map(label => <span key={label} className="px-2 py-0.5 rounded-full text-[11px] font-bold bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]">{label}</span>)}
              </div>
            )}
            {summary.facts.length > 0 && (
              <dl className="grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
                {summary.facts.map(([label, value]) => (
                  <div key={label} className="min-w-0">
                    <dt className="text-slate-400">{label}</dt>
                    <dd className="text-slate-700 font-medium [overflow-wrap:anywhere]">{value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {!hasPicture && summary.freq.length === 0 && summary.facts.length === 0 && <p className="text-sm text-slate-500">Nothing else is filled in for this asset yet.</p>}
          </>
        )}
      </div>

      <div className="p-3 border-t border-slate-200 bg-white shrink-0 flex items-center justify-between gap-2">
        <span className="text-xs text-slate-500">Edit every column, pictures and files in the table.</span>
        <button type="button" onClick={() => onEditInTable(assetId)} className="px-4 py-1.5 rounded-md text-sm font-bold bg-[#0072CE] text-white hover:bg-[#00468B] shadow-sm shrink-0">Edit in table</button>
      </div>
    </div>
  );
}

// ==========================================
// ASSETS: THE EQUIPMENT TABLE. Every column, 50 rows a page (never the whole table). Changes are saved row by row with the
// row's etag; pictures and files upload straight from their cells.
// ==========================================
const ASSET_TABLE_COLUMNS_PREF = 'stillwell.assets.tableColumns';
const ASSET_TABLE_PAGE = 50;
// Column headers that sort: only types Dataverse can sort by
const ASSET_SORTABLE_KINDS = ['text', 'int', 'number', 'date', 'bool', 'choice', 'status'];
// Starting width of each kind of column
const ASSET_CELL_WIDTH = {
  text: 'min-w-[11rem]', memo: 'min-w-[15rem]', int: 'min-w-[6.5rem]', number: 'min-w-[6.5rem]', bool: 'min-w-[5.5rem]', choice: 'min-w-[9rem]',
  choices: 'min-w-[12rem]', date: 'min-w-[10rem]', lookup: 'min-w-[12rem]', fixedlookup: 'min-w-[10rem]', file: 'min-w-[13rem]', image: 'min-w-[12rem]',
  status: 'min-w-[7rem]', id: 'min-w-[10rem]'
};
const ASSET_CELL_INPUT = 'w-full bg-transparent px-1.5 py-1 text-sm rounded border border-transparent hover:border-slate-300 focus:border-[#0072CE] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/30 disabled:text-slate-500 disabled:hover:border-transparent';

// What the table asks for to show a column: lookups by their id (the name comes as an annotation), files by their name,
// pictures by their time stamp (never the picture itself)
function tableSelectOf(f) {
  if (f.kind === 'lookup' || f.kind === 'fixedlookup') return [`_${f.name}_value`];
  if (f.kind === 'file') return f.nameColumn ? [f.name, f.nameColumn] : [f.name];
  if (f.kind === 'image') return [f.stampColumn || f.name];
  return [f.name];
}
function assetTableSelect(fields, mapColumn) {
  const seen = {};
  const out = [];
  const add = (c) => { if (c && !seen[c]) { seen[c] = true; out.push(c); } };
  [ASSET_ID_COLUMN, ASSET_NAME_COLUMN, 'craa5_roomname', 'craa5_areaname', 'modifiedon'].concat(mapColumn ? [mapColumn] : []).forEach(add);
  fields.forEach(f => tableSelectOf(f).forEach(add));
  return out.join(',');
}

// One page of whole rows for the table, with the total on the first page (Dataverse counts up to 5000)
async function fetchAssetRows({ set, select, words, room, placement, mapColumn, sort, next }) {
  let url = next;
  if (!url) {
    const q = assetListQuery({ words, room, placement, mapColumn, sort });
    url = apiUrl(`${set}?${select ? `$select=${select}&` : ''}${q.filter ? `$filter=${encodeURIComponent(q.filter)}&` : ''}$orderby=${encodeURIComponent(q.order)}&$count=true`);
  }
  const res = await fetch(url, { headers: { ...ODATA_HEADERS, ...NO_CACHE, Prefer: `odata.maxpagesize=${ASSET_TABLE_PAGE},odata.include-annotations="*"` } });
  if (!res.ok) {
    const err = new Error(await readApiError(res));
    err.status = res.status;
    throw err;
  }
  const data = await res.json();
  const count = typeof data['@odata.count'] === 'number' ? data['@odata.count'] : null;
  return {
    rows: (data.value || []).filter(r => GUID_PATTERN.test(cleanGuid(r[ASSET_ID_COLUMN]))),
    next: data['@odata.nextLink'] || null,
    count,
    countCapped: data['@Microsoft.Dynamics.CRM.totalrecordcountlimitexceeded'] === true || (count !== null && count >= 5000)
  };
}

// A row of the table: the row as Dataverse last sent it, the etag a save sends, and what the user has typed
// (edits[name] = { value, from }: `from` is the server value the edit started from)
const blankAssetEntry = (row) => ({ row: row || {}, etag: (row && row['@odata.etag']) || '', edits: {}, errors: {}, status: '', message: '', clash: false });

// The columns of a row the user has changed (and not changed back)
function changedAssetFields(entry, byName) {
  const out = [];
  if (!entry) return out;
  Object.keys(entry.edits).forEach(name => {
    const f = byName[name];
    if (f && editKey(f, entry.edits[name].value) !== editKey(f, toEditValue(f, entry.row))) out.push(f);
  });
  return out;
}

// The version in a Dataverse etag (W/"12345"); it only goes up
const etagVersion = (row) => { const m = /"(\d+)"/.exec((row && row['@odata.etag']) || ''); return m ? Number(m[1]) : null; };

// A newer copy of a row from Dataverse. The edits stay. If someone else changed a column the user is changing, the etag
// the edit started from is kept, so Save reports the clash instead of quietly writing over their change.
function mergeAssetEntry(entry, fresh, byName) {
  if (!entry) return blankAssetEntry(fresh);
  // A copy older than the one here (a list that was on its way while the row saved) changes nothing
  const had = etagVersion(entry.row);
  const got = etagVersion(fresh);
  if (had !== null && got !== null && got < had) return entry;
  const row = { ...entry.row, ...fresh };
  const freshTag = fresh['@odata.etag'] || entry.etag;
  let clash = entry.clash;
  const edits = {};
  Object.keys(entry.edits).forEach(name => {
    const f = byName[name];
    const e = entry.edits[name];
    if (!f) { edits[name] = e; return; }
    const mine = editKey(f, e.value);
    const now = editKey(f, toEditValue(f, row));
    // Typed back to where it started, or Dataverse already holds it: nothing is left to save there
    if (mine === e.from || mine === now) return;
    edits[name] = e;
    if (now !== e.from) clash = true;
  });
  if (Object.keys(edits).length === 0) {
    const settled = entry.status === 'stale' || entry.status === 'error';
    return { ...entry, row, edits: {}, errors: {}, clash: false, etag: freshTag, status: settled ? '' : entry.status, message: settled ? '' : entry.message };
  }
  return { ...entry, row, edits, clash, etag: clash ? entry.etag : freshTag };
}

// A row that must not drop out of view: unsaved, saving, or waiting on a decision
const entryNeedsKeeping = (e, byName) => !!e && (changedAssetFields(e, byName).length > 0 || e.status === 'saving' || e.status === 'stale' || e.status === 'error');

function AssetsTable({ meta, set, mapColumn, mapKey, metaDone, loadAssetMeta, rooms, rowEvent, focus, onAssetSaved, onShowOnMap, logEvent }) {
  const ready = meta.status === 'ready' && meta.fields.length > 0;
  // Every column but the id and the map spot (the pin button shows that); the name is always the first column
  const allFields = useMemo(() => meta.fields.filter(f => !f.isPrimaryId && f.name !== mapColumn), [meta.fields, mapColumn]);
  const byName = useMemo(() => { const o = {}; allFields.forEach(f => { o[f.name] = f; }); return o; }, [allFields]);
  const nameField = useMemo(() => allFields.find(f => f.isPrimaryName) || null, [allFields]);
  const grouped = useMemo(() => groupAssetFields(allFields.filter(f => !f.isPrimaryName)), [allFields]);
  const orderedFields = useMemo(() => {
    const out = [];
    grouped.groups.forEach(g => g.items.forEach(f => out.push(f)));
    grouped.info.forEach(f => out.push(f));
    return out;
  }, [grouped]);
  // At first: the equipment, cleaning and pictures / documents columns. The choice is remembered on this device.
  const defaultColumns = useMemo(() => {
    const out = [];
    grouped.groups.forEach(g => { if (g.key !== 'other') g.items.forEach(f => out.push(f.name)); });
    return out;
  }, [grouped]);
  const [columnPref, setColumnPref] = useState(() => { const v = readPref(ASSET_TABLE_COLUMNS_PREF, null); return Array.isArray(v) ? v : null; });
  useEffect(() => { writePref(ASSET_TABLE_COLUMNS_PREF, columnPref); }, [columnPref]);
  const shownNames = columnPref || defaultColumns;
  const columns = useMemo(() => orderedFields.filter(f => shownNames.indexOf(f.name) !== -1), [orderedFields, shownNames]);
  // Every column is asked for (not only the shown ones), so showing another column needs no new query
  const select = useMemo(() => (ready ? assetTableSelect(allFields, mapColumn) : ''), [ready, allFields, mapColumn]);
  const useSelect = useRef(true);

  // Search and filters
  const [query, setQuery] = useState('');
  const [debounced, setDebounced] = useState('');
  useEffect(() => {
    const t = setTimeout(() => setDebounced(query), 300);
    return () => clearTimeout(t);
  }, [query]);
  const words = useMemo(() => debounced.trim().split(/\s+/).filter(Boolean).slice(0, 4), [debounced]);
  const [room, setRoom] = useState('');
  const [placement, setPlacement] = useState('all');
  const [sort, setSort] = useState(null); // { name, desc }

  // Rows
  const [rows, setRows] = useState({});
  const rowsRef = useRef(rows);
  rowsRef.current = rows;
  const [page, setPage] = useState({ ids: [], next: null, loading: true, error: '', count: null, countCapped: false });
  const pageRef = useRef(page);
  pageRef.current = page;
  // Rows kept at the top: changed rows outside this search, new assets, the asset asked for from the map
  const [pinned, setPinned] = useState([]);
  const pinnedRef = useRef(pinned);
  pinnedRef.current = pinned;
  const focusKeep = useRef(null); // the asset asked for from the map stays until the search changes
  const req = useRef(0);
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);

  const [drawer, setDrawer] = useState(null); // { id } = details of a row, { id: null } = a new asset
  const drawerRef = useRef(drawer);
  drawerRef.current = drawer;
  const [drawerDirty, setDrawerDirty] = useState(false);
  const drawerDirtyRef = useRef(false);
  drawerDirtyRef.current = drawerDirty;
  const [confirmClose, setConfirmClose] = useState(null); // { run }
  const [drawerRefresh, setDrawerRefresh] = useState(0);
  const [highlight, setHighlight] = useState(null); // { id, n }
  const focusSeqLocal = useRef(0);
  const [chooserOpen, setChooserOpen] = useState(false);
  const chooserRef = useRef(null);
  const [savingAll, setSavingAll] = useState(false);
  const [bulkNote, setBulkNote] = useState('');
  const [confirmDiscard, setConfirmDiscard] = useState(false);
  const [notice, setNotice] = useState('');
  const scrollRef = useRef(null);

  // The user changed the search: the asset asked for from the map need not stay
  const userChanged = (fn) => (v) => { focusKeep.current = null; fn(v); };
  const onQuery = userChanged(setQuery);
  const onRoom = userChanged(setRoom);
  const onPlacement = userChanged(setPlacement);

  // A query, with every column by name; if Dataverse refuses a name, once more without the list
  const runQuery = async (args) => {
    try {
      return await fetchAssetRows({ ...args, select: useSelect.current ? select : '' });
    } catch (error) {
      if (error.status === 400 && useSelect.current && select && !args.next) {
        useSelect.current = false;
        logEvent(`The equipment table's column list was refused (${error.message}). Asking for every column instead.`, 'warn');
        return fetchAssetRows({ ...args, select: '' });
      }
      throw error;
    }
  };
  const fetchRow = async (id) => {
    const path = (withSelect) => `${set}(${id})${withSelect && select ? `?$select=${select}` : ''}`;
    try {
      return await getJson(path(useSelect.current), ANNOTATIONS);
    } catch (error) {
      if (error.status !== 400 || !useSelect.current || !select) throw error;
      useSelect.current = false;
      logEvent(`The equipment table's column list was refused (${error.message}). Asking for every column instead.`, 'warn');
      return getJson(path(false), ANNOTATIONS);
    }
  };

  // The first page, whenever the search, filters or sort change (or Try again)
  const [reloadSeq, setReloadSeq] = useState(0);
  const listKey = [words.join(' '), room, placement, sort ? `${sort.name}:${sort.desc ? 1 : 0}` : '', mapColumn || '', select].join('#');
  useEffect(() => {
    if (!ready) return;
    const r = req.current + 1;
    req.current = r;
    setPage(p => ({ ...p, loading: true, error: '' }));
    runQuery({ set, words, room, placement, mapColumn, sort, next: null })
      .then(res => {
        if (r !== req.current || !mounted.current) return;
        const cur = rowsRef.current;
        const ids = res.rows.map(x => cleanGuid(x[ASSET_ID_COLUMN]));
        const inPage = {};
        ids.forEach(id => { inPage[id] = true; });
        const open = drawerRef.current && drawerRef.current.id;
        const before = pinnedRef.current.concat(pageRef.current.ids);
        const keep = before.filter((id, i) => before.indexOf(id) === i && !inPage[id] && (entryNeedsKeeping(cur[id], byName) || id === open || id === focusKeep.current));
        setRows(prev => {
          const next = {};
          keep.forEach(id => { if (prev[id]) next[id] = prev[id]; });
          res.rows.forEach(x => { const id = cleanGuid(x[ASSET_ID_COLUMN]); next[id] = mergeAssetEntry(prev[id], x, byName); });
          return next;
        });
        setPinned(keep);
        setPage({ ids, next: res.next, loading: false, error: '', count: res.count, countCapped: res.countCapped });
      })
      .catch(error => {
        if (r !== req.current || !mounted.current) return;
        logEvent(`Equipment table query failed: ${error.message}`, 'error');
        setPage(p => ({ ...p, next: null, loading: false, error: error.message }));
      });
  }, [listKey, ready, reloadSeq]); // eslint-disable-line react-hooks/exhaustive-deps
  const retry = () => setReloadSeq(n => n + 1);

  const showMore = () => {
    if (!page.next || page.loading) return;
    const r = req.current + 1;
    req.current = r;
    setPage(p => ({ ...p, loading: true, error: '' }));
    runQuery({ set, next: page.next })
      .then(res => {
        if (r !== req.current || !mounted.current) return;
        setRows(prev => {
          const next = { ...prev };
          res.rows.forEach(x => { const id = cleanGuid(x[ASSET_ID_COLUMN]); next[id] = mergeAssetEntry(prev[id], x, byName); });
          return next;
        });
        setPage(p => {
          const have = {};
          p.ids.forEach(id => { have[id] = true; });
          const add = res.rows.map(x => cleanGuid(x[ASSET_ID_COLUMN])).filter(id => !have[id] && (have[id] = true));
          return { ...p, ids: p.ids.concat(add), next: res.next, loading: false, error: '' };
        });
      })
      .catch(error => { if (r === req.current && mounted.current) setPage(p => ({ ...p, loading: false, error: error.message })); });
  };

  // --- Row actions ---
  const patchEntry = (id, changes) => setRows(prev => (prev[id] ? { ...prev, [id]: { ...prev[id], ...changes } } : prev));

  const setCell = (id, name, value) => {
    setRows(prev => {
      const e = prev[id];
      const f = byName[name];
      if (!e || !f || e.status === 'saving') return prev;
      const old = e.edits[name];
      const edits = { ...e.edits, [name]: { value, from: old ? old.from : editKey(f, toEditValue(f, e.row)) } };
      // Back to what Dataverse holds: no change is left in that cell
      if (editKey(f, value) === editKey(f, toEditValue(f, e.row))) delete edits[name];
      const errors = e.errors[name] ? { ...e.errors, [name]: '' } : e.errors;
      const settled = e.status === 'saved' || e.status === 'error' || (e.status === '' && e.message);
      return { ...prev, [id]: { ...e, edits, errors, status: settled ? '' : e.status, message: settled ? '' : e.message } };
    });
  };

  const undoRow = (id) => setRows(prev => (prev[id] && prev[id].status !== 'saving' ? { ...prev, [id]: blankAssetEntry(prev[id].row) } : prev));

  // Saves one row: only the changed columns, with the etag. Resolves to 'saved', 'error' or 'skip'.
  const saveRow = async (id, force) => {
    const e = rowsRef.current[id];
    if (!e || e.status === 'saving') return 'skip';
    const changed = changedAssetFields(e, byName);
    if (changed.length === 0) { patchEntry(id, { edits: {}, errors: {}, status: '', message: '' }); return 'skip'; }
    const errs = {};
    changed.forEach(f => { const msg = validateField(f, e.edits[f.name].value); if (msg) errs[f.name] = msg; });
    if (Object.keys(errs).length > 0) {
      patchEntry(id, { errors: errs, status: 'error', message: 'Fix the marked cells first.' });
      return 'error';
    }
    const payload = {};
    changed.forEach(f => { const kv = toPayloadEntry(f, e.edits[f.name].value); payload[kv[0]] = kv[1]; });
    patchEntry(id, { status: 'saving', message: '', errors: {} });
    try {
      const fresh = await patchAsset(set, id, payload, force ? '*' : e.etag, logEvent);
      const base = rowsRef.current[id];
      const row = { ...(base ? base.row : e.row), ...fresh };
      setRows(prev => (prev[id] ? { ...prev, [id]: { ...blankAssetEntry(row), status: 'saved', message: 'Saved.' } } : prev));
      logEvent(`Saved asset ${id} from the table (${changed.length} column${changed.length === 1 ? '' : 's'}).`, 'success');
      onAssetSaved(row, 'table', false);
      return 'saved';
    } catch (error) {
      logEvent(`Asset ${id} not saved from the table: ${error.message}`, 'error', payload);
      if (error.stale) patchEntry(id, { status: 'stale', message: 'Someone else changed this asset after it was loaded here.' });
      else patchEntry(id, { status: 'error', message: `Not saved: ${error.message}` });
      return 'error';
    }
  };

  // Reads one row again. `discard` drops its edits (Reload after a clash); otherwise they stay (after an upload).
  const refreshRow = async (id, discard) => {
    try {
      const fresh = await fetchRow(id);
      if (!mounted.current) return null;
      setRows(prev => {
        if (!prev[id]) return prev;
        return { ...prev, [id]: discard ? blankAssetEntry({ ...prev[id].row, ...fresh }) : mergeAssetEntry(prev[id], fresh, byName) };
      });
      return fresh;
    } catch (error) {
      logEvent(`Asset ${id} could not be read again: ${error.message}`, 'error');
      if (mounted.current) patchEntry(id, { message: `Could not read this asset again: ${error.message}` });
      return null;
    }
  };

  // A picture or file changed (in a cell or in Details): the row, the map card and the pins follow
  const fileChanged = async (id) => {
    const fresh = await refreshRow(id, false);
    // Details open on the same asset reads it again too (the upload gave the record a new version)
    if (fresh && drawerRef.current && drawerRef.current.id === id) setDrawerRefresh(t => t + 1);
    if (fresh) {
      const e = rowsRef.current[id];
      onAssetSaved({ ...(e ? e.row : {}), ...fresh }, 'table', false);
    }
  };

  // The drawer: one asset's every column (as in the map's editor), or a new asset. Unsaved changes are never dropped silently.
  const requestDrawer = (next) => {
    if (drawerDirtyRef.current) setConfirmClose({ run: () => { setDrawerDirty(false); setDrawer(next); } });
    else setDrawer(next);
  };
  const closeDrawer = () => requestDrawer(null);

  const openDetails = (id) => {
    if (changedAssetFields(rowsRef.current[id], byName).length > 0) {
      patchEntry(id, { message: 'Save or undo the changes in this row first, then open Details.' });
      return;
    }
    if (drawerRef.current && drawerRef.current.id === id) return;
    requestDrawer({ id });
  };

  const onDrawerSaved = (row) => {
    const id = cleanGuid(row[ASSET_ID_COLUMN]);
    setRows(prev => (prev[id] ? { ...prev, [id]: mergeAssetEntry(prev[id], row, byName) } : prev));
    onAssetSaved(row, 'table', false);
  };
  const onDrawerCreated = (row) => {
    const id = cleanGuid(row[ASSET_ID_COLUMN]);
    setRows(prev => ({ ...prev, [id]: blankAssetEntry(row) }));
    setPinned(p => [id].concat(p.filter(x => x !== id)));
    onAssetSaved(row, 'table', true);
    logEvent(`Created asset ${(row[ASSET_NAME_COLUMN] || '').trim() || id} from the table.`, 'success');
    setDrawerDirty(false);
    // Stays open on the new asset, so pictures and files can be added straight away
    setDrawer({ id });
    focusSeqLocal.current += 1;
    setHighlight({ id, n: focusSeqLocal.current });
  };

  // Stable handlers for the rows (a row only draws again when its own data changes)
  const act = useRef({});
  act.current = { setCell, saveRow, undoRow, openDetails, onShowOnMap, refreshRow, fileChanged };
  const actions = useMemo(() => ({
    setCell: (id, name, v) => act.current.setCell(id, name, v),
    save: (id, force) => act.current.saveRow(id, force),
    undo: (id) => act.current.undoRow(id),
    details: (id) => act.current.openDetails(id),
    showOnMap: (id) => act.current.onShowOnMap(id),
    reload: (id) => act.current.refreshRow(id, true),
    fileChanged: (id) => act.current.fileChanged(id)
  }), []);

  // Saved on the map: the row here follows; a new asset made there is added at the top
  useEffect(() => {
    if (!rowEvent || rowEvent.from === 'table') return;
    const id = rowEvent.summary.id;
    if (rowsRef.current[id]) setRows(prev => (prev[id] ? { ...prev, [id]: mergeAssetEntry(prev[id], rowEvent.row, byName) } : prev));
    else if (rowEvent.isNew) {
      setRows(prev => ({ ...prev, [id]: blankAssetEntry(rowEvent.row) }));
      setPinned(p => [id].concat(p.filter(x => x !== id)));
    }
    if (drawerRef.current && drawerRef.current.id === id) setDrawerRefresh(t => t + 1);
  }, [rowEvent && rowEvent.n]); // eslint-disable-line react-hooks/exhaustive-deps

  // Asked from the map ("Edit in table"): show that row at the top and point at it
  const focusDone = useRef(0);
  useEffect(() => {
    const f = focus;
    if (!f || !ready || focusDone.current >= f.n) return;
    focusDone.current = f.n;
    const id = f.id;
    focusKeep.current = id;
    // Another asset's Details would cover the row asked for (unsaved changes there are asked about first)
    if (drawerRef.current && drawerRef.current.id !== id) requestDrawer(null);
    const show = () => {
      setPinned(p => (pageRef.current.ids.indexOf(id) !== -1 || p.indexOf(id) !== -1 ? p : [id].concat(p)));
      focusSeqLocal.current += 1;
      setHighlight({ id, n: focusSeqLocal.current });
    };
    if (rowsRef.current[id]) { show(); return; }
    fetchRow(id)
      .then(fresh => {
        if (!mounted.current) return;
        setRows(prev => (prev[id] ? prev : { ...prev, [id]: blankAssetEntry(fresh) }));
        show();
      })
      .catch(error => {
        logEvent(`Asset ${id} could not be shown in the table: ${error.message}`, 'error');
        if (mounted.current) setNotice(`That asset could not be loaded: ${error.message}`);
      });
  }, [focus && focus.n, ready]); // eslint-disable-line react-hooks/exhaustive-deps

  // Scroll to the row being pointed at, and let the colour fade
  useEffect(() => {
    if (!highlight) return undefined;
    const n = highlight.n;
    const t1 = setTimeout(() => {
      const c = scrollRef.current;
      const tr = c ? c.querySelector(`tr[data-row-id="${highlight.id}"]`) : null;
      if (c && tr) {
        // Rows kept at the top: show the top (with its label); other rows: only scroll if the row is out of view
        const head = c.querySelector('thead');
        const top = tr.offsetTop - (head ? head.offsetHeight : 0);
        if (pinnedRef.current.indexOf(highlight.id) !== -1) c.scrollTop = 0;
        else if (top < c.scrollTop || tr.offsetTop + tr.offsetHeight > c.scrollTop + c.clientHeight) c.scrollTop = Math.max(0, top - 8);
        c.scrollLeft = 0;
      }
    }, 60);
    const t2 = setTimeout(() => setHighlight(h => (h && h.n === n ? null : h)), 2600);
    return () => { clearTimeout(t1); clearTimeout(t2); };
  }, [highlight && highlight.n]); // eslint-disable-line react-hooks/exhaustive-deps

  // The column list closes on a click outside it, or Escape
  useEffect(() => {
    if (!chooserOpen) return undefined;
    const onDown = (e) => { if (chooserRef.current && !chooserRef.current.contains(e.target)) setChooserOpen(false); };
    const onKey = (e) => { if (e.key === 'Escape') setChooserOpen(false); };
    document.addEventListener('pointerdown', onDown);
    document.addEventListener('keydown', onKey);
    return () => { document.removeEventListener('pointerdown', onDown); document.removeEventListener('keydown', onKey); };
  }, [chooserOpen]);

  const dirtyIds = Object.keys(rows).filter(id => rows[id].status !== 'saving' && changedAssetFields(rows[id], byName).length > 0);
  // Nothing left to discard (saved or undone row by row): the question goes away and does not come back by itself
  useEffect(() => { if (dirtyIds.length === 0 && !savingAll) setConfirmDiscard(false); }, [dirtyIds.length, savingAll]);

  const saveAll = async () => {
    if (savingAll) return;
    const ids = dirtyIds.slice();
    setSavingAll(true);
    setBulkNote('');
    let ok = 0;
    let bad = 0;
    for (let i = 0; i < ids.length; i += 1) {
      const r = await saveRow(ids[i], false);
      if (r === 'saved') ok += 1;
      else if (r === 'error') bad += 1;
    }
    if (!mounted.current) return;
    setSavingAll(false);
    setBulkNote(bad ? `${ok} saved, ${bad} not saved (see the marked rows).` : `${ok} row${ok === 1 ? '' : 's'} saved.`);
  };

  const discardAll = () => {
    setRows(prev => {
      const next = { ...prev };
      Object.keys(next).forEach(id => {
        const e = next[id];
        if (e.status !== 'saving' && (Object.keys(e.edits).length > 0 || e.status === 'stale' || e.status === 'error')) next[id] = blankAssetEntry(e.row);
      });
      return next;
    });
    setConfirmDiscard(false);
    setBulkNote('');
  };

  const toggleSort = (name) => {
    focusKeep.current = null;
    setSort(s => (!s || s.name !== name ? { name, desc: false } : (s.desc ? null : { name, desc: true })));
  };

  // What is drawn: the kept rows first, then the page
  const pinnedShown = pinned.filter(id => rows[id]);
  const pinnedIndex = {};
  pinnedShown.forEach(id => { pinnedIndex[id] = true; });
  const pageShown = page.ids.filter(id => rows[id] && !pinnedIndex[id]);
  const drawerId = drawer ? drawer.id : null;
  const colCount = columns.length + 1;

  let countLine = '';
  if (!metaDone) countLine = 'Reading the Assets table...';
  else if (!ready) countLine = '';
  else if (page.loading && page.ids.length === 0) countLine = 'Loading...';
  else if (page.count !== null) countLine = `${page.ids.length} of ${page.count}${page.countCapped ? '+' : ''} asset${page.count === 1 ? '' : 's'} shown`;
  else countLine = `${page.ids.length} asset${page.ids.length === 1 ? '' : 's'} shown`;

  const headerCell = 'sticky top-0 bg-[#00468B] text-white text-left text-[11px] font-bold uppercase tracking-wide px-2 py-2 border-b border-[#003366] align-bottom';
  const renderRow = (id) => (
    <AssetTableRow
      key={id}
      id={id}
      entry={rows[id]}
      columns={columns}
      nameField={nameField}
      byName={byName}
      mapColumn={mapColumn}
      mapKey={mapKey}
      set={set}
      highlight={!!highlight && highlight.id === id}
      locked={drawerId === id}
      actions={actions}
      logEvent={logEvent}
    />
  );

  return (
    <div className="h-full flex flex-col bg-slate-100 p-3 md:p-6 pt-3 md:pt-4 overflow-hidden relative" data-testid="assets-table-view">
      {/* On a short screen (a phone turned sideways) this part scrolls, so the rows and Show more can still be reached */}
      <div className="flex-1 min-h-0 flex flex-col gap-2 overflow-y-auto" data-assets-table-scroll="">
      <div className="shrink-0 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 className="text-2xl font-black text-[#00468B]">Asset Management</h2>
          <p className="hidden sm:block text-sm text-slate-500">The equipment table: change any cell, then Save the row. Pictures and files upload straight from their cells.</p>
        </div>
        <SearchBox query={query} onQuery={onQuery} placeholder="Search name, room, area..." ariaLabel="Search the equipment table" className="w-full sm:w-80" />
      </div>

      <div className="shrink-0 flex flex-wrap items-center gap-2 relative">
        {mapColumn && (
          <div className="inline-flex shrink-0 rounded-full border border-[#B3D4F2] bg-white p-0.5" role="group" aria-label="Filter the table by map spot">
            {[['all', 'All'], ['placed', 'On the map'], ['unplaced', 'Not on the map']].map(([key, label]) => (
              <button
                key={key}
                type="button"
                onClick={() => onPlacement(key)}
                aria-pressed={placement === key}
                className={`px-2.5 py-0.5 rounded-full text-xs font-bold whitespace-nowrap transition-colors ${placement === key ? 'bg-[#00468B] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]'}`}
              >
                {label}
              </button>
            ))}
          </div>
        )}
        {rooms.length > 0 && (
          <label className="flex items-center gap-1 text-xs text-slate-600">
            <span className="sr-only">Room</span>
            <select value={room} onChange={e => onRoom(e.target.value)} aria-label="Filter the table by room" className="border border-slate-300 rounded-md px-2 py-1 text-xs bg-white max-w-[11rem]">
              <option value="">Every room</option>
              {rooms.map(r => <option key={r} value={r}>{r}</option>)}
            </select>
          </label>
        )}
        <div className="md:relative" ref={chooserRef}>
          <button
            type="button"
            onClick={() => setChooserOpen(o => !o)}
            aria-expanded={chooserOpen}
            disabled={!ready}
            className="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold border border-[#B3D4F2] bg-white text-[#00468B] hover:bg-[#E6F1FB] disabled:opacity-50"
          >
            <TableIcon className="w-3.5 h-3.5" /> Columns ({columns.length})
          </button>
          {chooserOpen && (
            <AssetColumnChooser
              grouped={grouped}
              shown={shownNames}
              onChange={names => setColumnPref(names)}
              onDefault={() => setColumnPref(null)}
              onAll={() => setColumnPref(orderedFields.map(f => f.name))}
              onClose={() => setChooserOpen(false)}
            />
          )}
        </div>
        <button
          type="button"
          onClick={() => requestDrawer({ id: null })}
          disabled={!ready}
          title={ready ? 'Create an asset (it can be placed on the map afterwards)' : 'Waiting for the Assets table columns'}
          className="bg-[#0072CE] text-white px-3 py-1 rounded-md text-xs font-bold hover:bg-[#00468B] disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
        >
          + New asset
        </button>
        <span className="text-xs text-slate-600" role="status">{countLine}</span>
        {(dirtyIds.length > 0 || savingAll) && (
          <span className="sm:ml-auto inline-flex flex-wrap items-center gap-2 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1 text-xs" data-testid="table-unsaved">
            <span className="font-bold text-slate-800">{savingAll ? 'Saving...' : `${dirtyIds.length} row${dirtyIds.length === 1 ? '' : 's'} with unsaved changes`}</span>
            {!confirmDiscard ? (
              <>
                <button type="button" onClick={saveAll} disabled={savingAll} className="px-2 py-0.5 rounded font-bold bg-[#0072CE] text-white hover:bg-[#00468B] disabled:opacity-50">Save all ({dirtyIds.length})</button>
                <button type="button" onClick={() => setConfirmDiscard(true)} disabled={savingAll} className="px-2 py-0.5 rounded font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 disabled:opacity-50">Discard all</button>
              </>
            ) : (
              <>
                <span>Drop every unsaved change?</span>
                <button type="button" onClick={discardAll} className="px-2 py-0.5 rounded font-bold bg-[#E4002B] text-white hover:bg-[#C4001F]">Discard</button>
                <button type="button" onClick={() => setConfirmDiscard(false)} className="px-2 py-0.5 rounded font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100">Keep</button>
              </>
            )}
          </span>
        )}
        {bulkNote && !savingAll && <span className="text-xs text-slate-700" role="status">{bulkNote}</span>}
      </div>

      {metaDone && !ready && (
        <div className="shrink-0 text-sm text-[#C4001F] bg-white rounded-lg border border-slate-200 p-3" role="alert">
          The Assets table's columns could not be read{meta.error ? `: ${meta.error}` : '.'}
          <button type="button" onClick={loadAssetMeta} className="ml-2 text-[#0072CE] underline">Try again</button>
        </div>
      )}
      {page.error && (
        <div className="shrink-0 text-xs text-[#C4001F]" role="alert">
          The assets could not be loaded: {page.error}
          <button type="button" onClick={retry} className="ml-2 text-[#0072CE] underline">Try again</button>
        </div>
      )}
      {notice && (
        <div className="shrink-0 text-xs text-[#9A6700]" role="status">
          {notice}
          <button type="button" onClick={() => setNotice('')} className="ml-2 text-[#0072CE] underline">OK</button>
        </div>
      )}

      <div ref={scrollRef} className="flex-1 min-h-[10rem] overflow-auto bg-white rounded-xl border border-slate-200 shadow-sm relative" aria-busy={page.loading}>
        {ready && (
          <table className="border-separate border-spacing-0 text-sm min-w-full" data-testid="asset-table">
            <thead>
              <tr>
                <th scope="col" className={`${headerCell} left-0 z-30 w-[10.5rem] min-w-[10.5rem] max-w-[10.5rem] sm:w-[16rem] sm:min-w-[16rem] sm:max-w-[16rem] border-r`}>
                  {nameField ? <SortHeader f={nameField} sort={sort} onSort={toggleSort} /> : 'Equipment'}
                </th>
                {columns.map(f => (
                  <th key={f.name} scope="col" className={`${headerCell} z-20 ${ASSET_CELL_WIDTH[f.kind] || 'min-w-[9rem]'}`} title={f.description ? `${f.description} (${f.name})` : f.name}>
                    {ASSET_SORTABLE_KINDS.indexOf(f.kind) !== -1 ? <SortHeader f={f} sort={sort} onSort={toggleSort} /> : f.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {pinnedShown.length > 0 && (
                <tr>
                  <td colSpan={colCount} className="bg-[#FFF6E0] border-b border-[#FFB81C] px-2 py-1">
                    <span className="sticky left-2 text-[11px] font-bold uppercase tracking-wider text-[#9A6700]">Kept at the top: new, changed or opened from the map</span>
                  </td>
                </tr>
              )}
              {pinnedShown.map(renderRow)}
              {pinnedShown.length > 0 && pageShown.length > 0 && (
                <tr><td colSpan={colCount} className="h-2 bg-slate-100 border-b border-slate-200" /></tr>
              )}
              {pageShown.map(renderRow)}
              {!page.loading && !page.error && pinnedShown.length === 0 && pageShown.length === 0 && (
                <tr>
                  <td colSpan={colCount} className="p-6">
                    <span className="sticky left-6 text-sm text-slate-500">{words.length || room || placement !== 'all' ? 'No assets match.' : 'No assets yet.'}</span>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        )}
        {(page.loading || page.next) && ready && (
          <div className="sticky left-0 p-3 flex justify-center">
            {page.loading ? <span className="text-xs text-slate-500">Loading...</span> : (
              <button type="button" onClick={showMore} className="px-4 py-1.5 text-xs font-bold text-[#0072CE] hover:bg-[#E6F1FB] rounded-lg border border-[#B3D4F2]">Show more</button>
            )}
          </div>
        )}
        {!metaDone && <p className="p-4 text-sm text-slate-500">Reading the Assets table...</p>}
      </div>
      </div>

      {drawer && (
        <>
          <div className="absolute inset-0 bg-slate-900/25 z-40" onClick={closeDrawer} aria-hidden="true" />
          <aside className="absolute inset-y-0 right-0 z-50 w-full sm:w-[28rem] lg:w-[32rem] bg-white shadow-2xl border-l border-slate-200 flex flex-col" aria-label={drawer.id ? 'Asset details' : 'New asset'} data-testid="asset-drawer">
            {confirmClose && (
              <div className="p-3 bg-[#FFF6E0] border-b-2 border-[#FFB81C] text-sm shrink-0" role="alert">
                <p className="font-semibold text-slate-800">This asset has unsaved changes.</p>
                <div className="flex gap-2 mt-2">
                  <button type="button" onClick={() => { const run = confirmClose.run; setConfirmClose(null); run(); }} className="px-3 py-1 rounded-md text-xs font-bold bg-[#E4002B] text-white hover:bg-[#C4001F]">Discard changes</button>
                  <button type="button" onClick={() => setConfirmClose(null)} className="px-3 py-1 rounded-md text-xs font-bold border border-slate-300 text-slate-700 hover:bg-slate-100">Keep editing</button>
                </div>
              </div>
            )}
            <AssetEditor
              key={drawer.id || 'new'}
              meta={meta}
              set={set}
              assetId={drawer.id}
              createLocation={null}
              mapKey={mapKey}
              placing={false}
              refreshToken={drawerRefresh}
              onRetryMeta={loadAssetMeta}
              onDirtyChange={setDrawerDirty}
              onClose={closeDrawer}
              onSaved={onDrawerSaved}
              onCreated={onDrawerCreated}
              onShowOnMap={onShowOnMap}
              onFilesChanged={() => { if (drawer.id) fileChanged(drawer.id); }}
              logEvent={logEvent}
            />
          </aside>
        </>
      )}
    </div>
  );
}

function SortHeader({ f, sort, onSort }) {
  const on = sort && sort.name === f.name;
  return (
    <button
      type="button"
      onClick={() => onSort(f.name)}
      className="inline-flex items-end gap-1 text-left uppercase font-bold hover:text-[#FFB81C]"
      aria-label={`Sort by ${f.label}${on ? (sort.desc ? ' (now Z to A)' : ' (now A to Z)') : ''}`}
    >
      <span>{f.label}</span>
      <span aria-hidden="true" className={on ? 'text-[#FFB81C]' : 'text-white/40'}>{on ? (sort.desc ? '▼' : '▲') : '↕'}</span>
    </button>
  );
}

// The Columns list: tick what the table shows, by section
function AssetColumnChooser({ grouped, shown, onChange, onDefault, onAll, onClose }) {
  const sections = grouped.groups.map(g => ({ key: g.key, title: g.title, items: g.items }))
    .concat(grouped.info.length ? [{ key: 'info', title: 'Record info', items: grouped.info }] : []);
  const toggle = (name) => onChange(shown.indexOf(name) !== -1 ? shown.filter(n => n !== name) : shown.concat([name]));
  const setSection = (items, on) => {
    const names = items.map(f => f.name);
    onChange(on ? shown.concat(names.filter(n => shown.indexOf(n) === -1)) : shown.filter(n => names.indexOf(n) === -1));
  };
  // No taller than the room left below it in the view (in the list's own pixels, as the app may be zoomed)
  const boxRef = useRef(null);
  React.useLayoutEffect(() => {
    const el = boxRef.current;
    const view = el && el.closest ? el.closest('[data-assets-table-scroll]') : null;
    if (!view) return;
    const r = el.getBoundingClientRect();
    const vr = view.getBoundingClientRect();
    const k = r.height > 0 ? el.offsetHeight / r.height : 1;
    el.style.maxHeight = `min(60vh, ${Math.max(120, Math.floor((vr.bottom - r.top) * k) - 12)}px)`;
  });
  return (
    <div ref={boxRef} className="absolute left-0 top-full mt-1 z-[60] w-[min(22rem,calc(100vw-2rem))] max-h-[60vh] overflow-y-auto bg-white rounded-xl shadow-xl border border-slate-200 p-3 space-y-3" role="dialog" aria-label="Columns to show" data-testid="column-chooser">
      <div className="flex items-center justify-between gap-2">
        <span className="font-black text-[11px] uppercase tracking-widest text-[#00468B]">Columns</span>
        <span className="flex items-center gap-3 text-xs font-bold">
          <button type="button" onClick={onDefault} className="text-[#0072CE] underline">Default</button>
          <button type="button" onClick={onAll} className="text-[#0072CE] underline">All</button>
          <button type="button" onClick={onClose} className="text-slate-400 hover:text-[#E4002B]" aria-label="Close the column list"><X className="w-4 h-4" /></button>
        </span>
      </div>
      {sections.map(s => {
        const on = s.items.filter(f => shown.indexOf(f.name) !== -1).length;
        return (
          <div key={s.key} role="group" aria-label={s.title}>
            <div className="flex items-center justify-between gap-2 text-xs font-bold text-slate-700">
              <span>{s.title} <span className="text-slate-400 font-semibold">({on}/{s.items.length})</span></span>
              <button type="button" onClick={() => setSection(s.items, on < s.items.length)} className="text-[#0072CE] underline">{on < s.items.length ? 'Show all' : 'Hide all'}</button>
            </div>
            <div className="mt-1 grid grid-cols-2 gap-x-2 gap-y-1">
              {s.items.map(f => (
                <label key={f.name} className="flex items-center gap-1.5 text-xs text-slate-700 min-w-0 cursor-pointer" title={f.name}>
                  <input type="checkbox" checked={shown.indexOf(f.name) !== -1} onChange={() => toggle(f.name)} className="accent-[#0072CE] shrink-0" />
                  <span className="truncate">{f.label}</span>
                </label>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  );
}

// One row of the table. Drawn again only when its own data changes.
const AssetTableRow = React.memo(function AssetTableRow({ id, entry, columns, nameField, byName, mapColumn, mapKey, set, highlight, locked, actions, logEvent }) {
  const row = entry.row;
  const saving = entry.status === 'saving';
  const disabled = saving || locked;
  const changed = changedAssetFields(entry, byName);
  const changedNames = {};
  changed.forEach(f => { changedNames[f.name] = true; });
  const dirty = changed.length > 0;
  const valueOf = (f) => (entry.edits[f.name] ? entry.edits[f.name].value : toEditValue(f, row));
  const name = nameField ? String(valueOf(nameField) || '') : '';
  const label = (row[ASSET_NAME_COLUMN] || '').trim() || name.trim() || '(no name)';
  const location = mapColumn ? parseMapLocation(row[mapColumn]) : null;
  const onMap = pinOnMap(location, mapKey);
  const bg = highlight ? 'bg-[#FFF6E0]' : (dirty ? 'bg-[#FFFBEB]' : 'bg-white');
  const nameEditable = !!nameField && isEditableField(nameField, false);
  const iconButton = 'p-1 rounded hover:bg-[#E6F1FB] shrink-0 disabled:opacity-40';
  let statusLine = null;
  if (saving) statusLine = <span className="text-slate-600">Saving...</span>;
  else if (locked) statusLine = <span className="text-slate-500">Open in Details.</span>;
  else if (entry.status === 'stale') {
    statusLine = (
      <>
        <span className="text-[#C4001F]">{entry.message}</span>
        <button type="button" onClick={() => actions.reload(id)} className="font-bold text-[#0072CE] underline">Reload row</button>
        <button type="button" onClick={() => actions.save(id, true)} className="font-bold text-[#C4001F] underline">Save mine anyway</button>
      </>
    );
  } else if (dirty || entry.message) {
    statusLine = (
      <>
        {entry.message && <span className={entry.status === 'error' ? 'text-[#C4001F]' : (entry.status === 'saved' ? 'text-green-700' : 'text-[#9A6700]')}>{entry.message}</span>}
        {dirty && <span className="text-slate-600">{changed.length} change{changed.length === 1 ? '' : 's'}</span>}
        {dirty && <button type="button" onClick={() => actions.save(id, false)} aria-label={`Save ${label}`} className="px-2 py-0.5 rounded font-bold bg-[#0072CE] text-white hover:bg-[#00468B]">Save</button>}
        {dirty && <button type="button" onClick={() => actions.undo(id)} aria-label={`Undo the changes to ${label}`} className="px-2 py-0.5 rounded font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100">Undo</button>}
      </>
    );
  }
  return (
    <tr data-row-id={id} className={`${bg} ${highlight ? 'outline outline-2 outline-[#FFB81C]' : ''}`} aria-busy={saving}>
      <td className={`sticky left-0 z-10 ${bg} border-b border-r border-slate-200 p-1 align-top w-[10.5rem] min-w-[10.5rem] max-w-[10.5rem] sm:w-[16rem] sm:min-w-[16rem] sm:max-w-[16rem]`}>
        <div className="flex items-start gap-0.5">
          {nameEditable ? (
            <input
              value={name}
              onChange={e => actions.setCell(id, nameField.name, e.target.value)}
              disabled={disabled}
              aria-label={`${nameField.label}, ${label}`}
              className={`${ASSET_CELL_INPUT} font-semibold text-[#00468B] min-w-0 ${entry.errors[nameField.name] ? 'border-[#E4002B] bg-white' : ''} ${changedNames[nameField.name] ? 'bg-[#FFF6E0]' : ''}`}
            />
          ) : (
            <span className="flex-1 min-w-0 px-1.5 py-1 font-semibold text-[#00468B] truncate" title={label}>{label}</span>
          )}
          <button type="button" onClick={() => actions.details(id)} className={`${iconButton} text-[#0072CE]`} title="Details: every column of this asset" aria-label={`Details of ${label}`}><PencilIcon className="w-4 h-4" /></button>
          <button
            type="button"
            onClick={() => actions.showOnMap(id)}
            className={`${iconButton} ${onMap ? 'text-[#0072CE]' : 'text-slate-400'}`}
            title={onMap ? 'Show on the map' : (location ? `On another map (${location.map})` : 'Not on the map yet: open it on the map to place it')}
            aria-label={`Show ${label} on the map`}
            data-on-map={onMap ? 'true' : 'false'}
          >
            <MapPin className="w-4 h-4" fill={onMap ? 'currentColor' : 'none'} />
          </button>
        </div>
        {nameField && entry.errors[nameField.name] && <p className="text-[11px] text-[#C4001F] px-1.5" role="alert">{entry.errors[nameField.name]}</p>}
        {statusLine && <div className="flex flex-wrap items-center gap-x-2 gap-y-1 px-1.5 pt-0.5 text-[11px]" data-row-status>{statusLine}</div>}
      </td>
      {columns.map(f => (
        <td key={f.name} data-cell={`${id}:${f.name}`} className={`border-b border-slate-200 p-1 align-top ${ASSET_CELL_WIDTH[f.kind] || 'min-w-[9rem]'} ${changedNames[f.name] ? 'bg-[#FFF6E0]' : ''}`}>
          {(f.kind === 'file' || f.kind === 'image') ? (
            <AssetFileField variant="cell" assetLabel={label} f={f} row={row} set={set} assetId={id} isNew={false} canWrite={f.canUpdate && !disabled} onChanged={() => actions.fileChanged(id)} logEvent={logEvent} />
          ) : (
            <AssetCell
              f={f}
              value={valueOf(f)}
              row={row}
              error={entry.errors[f.name]}
              readOnly={!isEditableField(f, false)}
              disabled={disabled}
              label={`${f.label}, ${label}`}
              onChange={v => actions.setCell(id, f.name, v)}
            />
          )}
        </td>
      ))}
    </tr>
  );
});

// One cell, by the column's type
function AssetCell({ f, value, row, error, readOnly, disabled, label, onChange }) {
  const cls = `${ASSET_CELL_INPUT} ${error ? 'border-[#E4002B] bg-white' : ''}`;
  const err = error ? <p className="text-[11px] text-[#C4001F] px-1.5" role="alert">{error}</p> : null;
  if (readOnly || (f.kind === 'lookup' && disabled)) {
    const shown = f.kind === 'lookup' && value && value.id ? (value.name || value.id) : displayValue(f, row);
    return <div className="px-1.5 py-1 text-sm text-slate-600 truncate max-w-[18rem]" title={shown || undefined}>{shown || <span className="text-slate-300">-</span>}</div>;
  }
  let control;
  switch (f.kind) {
    case 'bool':
      control = (
        <label className="flex justify-center py-1 cursor-pointer" title={value === true ? (f.trueLabel || 'Yes') : (value === false ? (f.falseLabel || 'No') : 'Not set')}>
          <input type="checkbox" checked={value === true} disabled={disabled} onChange={e => onChange(e.target.checked)} aria-label={label} className="w-4 h-4 accent-[#0072CE] cursor-pointer" />
        </label>
      );
      break;
    case 'memo':
      control = <textarea rows={1} value={value} onChange={e => onChange(e.target.value)} disabled={disabled} aria-label={label} className={`${cls} resize-y min-h-[2rem] block`} />;
      break;
    case 'int':
    case 'number':
      control = <input type="text" inputMode={f.kind === 'int' ? 'numeric' : 'decimal'} value={value} onChange={e => onChange(e.target.value)} disabled={disabled} aria-label={label} className={`${cls} text-right tabular-nums`} />;
      break;
    case 'choice':
      control = (
        <select value={value} onChange={e => onChange(e.target.value)} disabled={disabled} aria-label={label} className={cls}>
          <option value="">-</option>
          {f.options.map(o => <option key={o.value} value={String(o.value)}>{o.label}</option>)}
        </select>
      );
      break;
    case 'choices':
      control = <ChoicesCell f={f} value={value} disabled={disabled} label={label} onChange={onChange} />;
      break;
    case 'date':
      control = <input type={f.dateOnly ? 'date' : 'datetime-local'} value={value} onChange={e => onChange(e.target.value)} disabled={disabled} aria-label={label} className={cls} />;
      break;
    case 'lookup':
      control = <div className="px-1.5 py-1 text-sm"><LookupField id={undefined} f={f} value={value} onChange={onChange} label={label} /></div>;
      break;
    default: {
      const type = f.format === 'Email' ? 'email' : (f.format === 'Url' ? 'url' : (f.format === 'Phone' ? 'tel' : 'text'));
      const over = f.maxLength && String(value || '').length > f.maxLength;
      control = <input type={type} value={value} onChange={e => onChange(e.target.value)} disabled={disabled} aria-label={label} className={`${cls} ${over ? 'border-[#E4002B]' : ''}`} title={over ? `At most ${f.maxLength} characters` : undefined} />;
    }
  }
  return <div>{control}{err}</div>;
}

// Multi-select choices in a cell: the picked ones, and a list to tick when opened
function ChoicesCell({ f, value, disabled, label, onChange }) {
  const [open, setOpen] = useState(false);
  const list = value || [];
  const picked = f.options.filter(o => list.indexOf(String(o.value)) !== -1).map(o => o.label);
  return (
    <div>
      <button type="button" disabled={disabled} onClick={() => setOpen(o => !o)} aria-expanded={open} aria-label={`${label}: ${picked.length ? picked.join(', ') : 'none'}`} className={`${ASSET_CELL_INPUT} text-left truncate`}>
        {picked.length ? picked.join(', ') : <span className="text-slate-300">-</span>}
      </button>
      {open && !disabled && (
        <div className="mt-1 flex flex-wrap gap-1 px-1">
          {f.options.map(o => {
            const key = String(o.value);
            const on = list.indexOf(key) !== -1;
            return (
              <button key={key} type="button" aria-pressed={on} onClick={() => onChange(on ? list.filter(v => v !== key) : list.concat([key]))} className={`px-2 py-0.5 rounded-full text-[11px] font-semibold border ${on ? 'bg-[#00468B] text-white border-[#00468B]' : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-100'}`}>{o.label}</button>
            );
          })}
          <button type="button" onClick={() => setOpen(false)} className="text-[11px] font-bold text-[#0072CE] underline">Done</button>
        </div>
      )}
    </div>
  );
}

// What smart snap made of a click or a dragged box
function SpotNote({ spot }) {
  let text;
  const failed = spot.note && spot.note.indexOf('error:') === 0 ? spot.note.slice(6) : '';
  if (spot.how === 'box') {
    if (spot.snapped) text = 'Smart snap fitted the box to the black lines inside it (highlighted).';
    else if (spot.note === 'nolines') text = 'No black lines in the box, so the box you drew is used.';
    else if (spot.note === 'nomap') text = 'There is no map picture to snap to, so the box you drew is used.';
    else if (failed) text = `Smart snap is not available (${failed}), so the box you drew is used.`;
    else text = 'The box you drew is used.';
  } else if (spot.snapped) text = spot.region && spot.region.kind === 'shape' ? 'Smart snap picked the solid shape you clicked (highlighted).' : (spot.region && spot.region.inside ? 'Smart snap found the outlined area you clicked in (highlighted).' : 'Smart snap found the outlined area next to your click (highlighted). The pin goes in its middle.');
  else if (spot.note === 'none') text = 'No closed outline here, so the pin goes exactly where you clicked. Drag a box around it to fit it to the lines instead.';
  else if (spot.note === 'nomap') text = 'There is no map picture to snap to, so the pin goes where you clicked.';
  else if (failed) text = `Smart snap is not available (${failed}), so the pin goes where you clicked.`;
  else text = 'The pin goes exactly where you clicked.';
  return <p className="text-sm text-slate-700" data-testid="spot-note">{text}</p>;
}

