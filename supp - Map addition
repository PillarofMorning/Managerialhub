const apiUrl = (path) => {
  let baseUrl = '';
  try {
    if (typeof window !== 'undefined' && window.Xrm && window.Xrm.Utility) baseUrl = window.Xrm.Utility.getGlobalContext().getClientUrl();
  } catch (e) { /* same-origin relative URL */ }
  return `${baseUrl}/api/data/v9.2/${path}`;
};

const readApiError = async (res) => {
  let text = '';
  try { text = await res.text(); } catch (e) { /* no body */ }
  try {
    const parsed = JSON.parse(text);
    if (parsed && parsed.error && parsed.error.message) return `${parsed.error.message} (HTTP ${res.status})`;
  } catch (e) { /* not JSON */ }
  return text ? `${text.slice(0, 300)} (HTTP ${res.status})` : `HTTP ${res.status}`;
};

// Finds the column pictures are stored in: { ready, name, type: 'image' | 'file' | null, reason }
async function detectPictureColumn(logEvent) {
  const listColumns = async (cast) => {
    const res = await fetch(apiUrl(`EntityDefinitions(LogicalName='${OBSERVATION_LOGICAL_NAME}')/Attributes/Microsoft.Dynamics.CRM.${cast}?$select=LogicalName,SchemaName`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    return ((await res.json()).value || []).map(a => a.LogicalName).filter(Boolean);
  };

  const failures = [];
  const lookup = (cast) => listColumns(cast).catch(e => { failures.push(e.message); return []; });
  const [images, files] = await Promise.all([lookup('ImageAttributeMetadata'), lookup('FileAttributeMetadata')]);
  logEvent(`Picture column scan: image columns [${images.join(', ')}], file columns [${files.join(', ')}]`, failures.length ? 'warn' : 'debug', failures.length ? { failures } : null);

  // The columns a picture could go in, for "Or use:" when the app's choice is missing or wrong
  const choices = images.map(name => ({ name, label: name, kind: 'image' })).concat(files.map(name => ({ name, label: name, kind: 'file' })));
  // A column picked on this device wins while the table still has it
  const picked = readColumnPick('obsPicture');
  // (also when the lookups failed and cannot say: the pick is then trusted the way PICTURE_COLUMN is)
  if (picked && (images.indexOf(picked) !== -1 || files.indexOf(picked) !== -1 || failures.length > 0)) {
    logEvent(`Pictures go in ${picked} (picked on this device).`, 'info');
    const type = images.indexOf(picked) !== -1 ? 'image' : (files.indexOf(picked) !== -1 ? 'file' : null);
    return { ready: true, name: picked, type, reason: '', candidates: choices, picked };
  }
  if (PICTURE_COLUMN) {
    const type = images.includes(PICTURE_COLUMN) ? 'image' : (files.includes(PICTURE_COLUMN) ? 'file' : null);
    // Both lookups worked and neither lists the pinned column: it is a typo or the wrong kind of column
    if (!type && failures.length === 0) {
      return { ready: false, name: null, type: null, reason: `PICTURE_COLUMN "${PICTURE_COLUMN}" is not an Image or File column of ${OBSERVATION_LOGICAL_NAME}.`, candidates: choices };
    }
    return { ready: true, name: PICTURE_COLUMN, type, reason: '', candidates: choices };
  }

  // Image columns before File columns; within a kind prefer a name like a picture, then any other custom column, then the system "entityimage"
  const candidates = [...images.map(name => ({ name, type: 'image' })), ...files.map(name => ({ name, type: 'file' }))];
  const rank = (c) => (c.type === 'file' ? 10 : 0) + (c.name === 'entityimage' ? 2 : (PICTURE_NAME_HINT.test(c.name) ? 0 : 1));
  candidates.sort((a, b) => rank(a) - rank(b));
  if (candidates.length > 0) {
    if (candidates.length > 1) logEvent(`Several picture columns found (${candidates.map(c => c.name).join(', ')}). Using ${candidates[0].name}. Set PICTURE_COLUMN at the top of the file to choose another.`, 'warn');
    return { ready: true, name: candidates[0].name, type: candidates[0].type, reason: '', candidates: choices };
  }
  if (failures.length > 0) {
    return { ready: false, name: null, type: null, reason: `the app could not look up the table's columns (${failures[0]}). Press Check again, or set PICTURE_COLUMN at the top of the file to the Image column's logical name.`, candidates: choices, lookupFailed: true };
  }
  return { ready: false, name: null, type: null, reason: `the ${OBSERVATION_LOGICAL_NAME} table has no Image or File column. Add an Image column (for example "Picture") in Dataverse, then press Check again.`, candidates: choices, missing: true };
}

// Extra $select fields that tell a row has a picture, tried in order. Selecting the image column itself would drag
// a base64 thumbnail into every row, and a wrong guess is a 400, so the list query steps down until one is accepted.
const pictureSelectOptions = (col, type) => {
  const imageStyle = [[`${col}_timestamp`], [`${col}_url`]];
  const fileStyle = [[`${col}_name`], [col]];
  const order = type === 'image' ? imageStyle : (type === 'file' ? fileStyle : [...imageStyle, ...fileStyle]);
  return [...order, []];
};

// true / false when the query returned a marker for the picture, null when it could not tell
const rowHasPicture = (row, fields) => {
  if (fields.length === 0) return null;
  return fields.some(f => {
    const v = row[f];
    return v !== null && v !== undefined && v !== '' && v !== 0 && v !== '0';
  });
};

// Stored pictures: full size first (needs "can store full image"), then the 144 px thumbnail Dataverse always keeps
const storedPictureUrls = (col, id) => ({
  full: apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${col}/$value?size=full`),
  thumb: apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${col}/$value`)
});

// Every URL that might show this item's picture, best first (small thumbnails want the cheap 144 px one first)
const pictureSources = (item, thumbFirst = false) => {
  if (!item) return [];
  if (item.image) return [item.image];
  if (item.picture) return thumbFirst ? [item.picture.thumb, item.picture.full] : [item.picture.full, item.picture.thumb];
  return [];
};

const GUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// One request per picture: Dataverse cannot take it inside the create call (only the table's primary image can)
async function uploadPicture(column, id, dataUrl) {
  if (!GUID_PATTERN.test(id)) throw new Error('Dataverse did not return the new record id, so the picture could not be attached.');
  const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${column}`), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/octet-stream', 'x-ms-file-name': `observation-${id}.jpg` },
    body: dataUrlToBytes(dataUrl)
  });
  if (!res.ok) {
    const err = new Error(await readApiError(res));
    err.status = res.status;
    throw err;
  }
}

// A fresh record id made here, so a create can be sent again without making a second record
function newGuid() {
  const c = typeof window !== 'undefined' ? (window.crypto || window.msCrypto) : null;
  if (c && typeof c.randomUUID === 'function') return c.randomUUID();
  const b = new Uint8Array(16);
  if (c && typeof c.getRandomValues === 'function') c.getRandomValues(b);
  else for (let i = 0; i < 16; i += 1) b[i] = Math.floor(Math.random() * 256);
  b[6] = (b[6] & 15) | 64;
  b[8] = (b[8] & 63) | 128;
  const h = Array.prototype.map.call(b, x => (x + 256).toString(16).slice(1)).join('');
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
}

// A new observation from a ready payload (the Bulk Upload tab), saved under an id chosen here (an upsert). If the answer is
// lost and the same id is sent again, Dataverse updates the issue the first try made instead of making a second one.
async function createObservation(payload, id) {
  if (!GUID_PATTERN.test(id)) throw new Error('The new issue has no usable id.');
  const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})`), {
    method: 'PATCH',
    headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });
  if (!res.ok) {
    const err = new Error(await readApiError(res));
    err.status = res.status;
    throw err;
  }
  return id;
}

async function deletePicture(column, id) {
  const res = await fetch(apiUrl(`${DATAVERSE_SCHEMA.TableName}(${id})/${column}`), { method: 'DELETE', headers: ODATA_HEADERS });
  if (!res.ok && res.status !== 404) throw new Error(await readApiError(res));
}

// --- EQUIPMENT HELPERS ---
// The text columns of the observation table with their length limits, and the column (if any) that keeps the equipment ids.
// Result: { idColumn, equipmentMax, idMax, reason, candidates, picked, typed }. A failed lookup leaves the limits unknown and
// the ids unsaved. A column picked or typed on this device ('obsEquipmentIds') wins while the table has it as a text column.
async function detectEquipmentColumns(logEvent) {
  const listColumns = async (cast) => {
    const res = await fetch(apiUrl(`EntityDefinitions(LogicalName='${OBSERVATION_LOGICAL_NAME}')/Attributes/Microsoft.Dynamics.CRM.${cast}?$select=LogicalName,MaxLength`), { headers: ODATA_HEADERS });
    if (!res.ok) throw new Error(await readApiError(res));
    return ((await res.json()).value || []).filter(a => a && a.LogicalName);
  };
  const failures = [];
  const lookup = (cast) => listColumns(cast).catch(e => { failures.push(e.message); return []; });
  const lists = await Promise.all([lookup('StringAttributeMetadata'), lookup('MemoAttributeMetadata')]);
  const columns = lists[0].concat(lists[1]);
  const find = (name) => columns.find(c => c.LogicalName === name) || null;
  const equipmentCol = find('craa5__equipment');
  const equipmentMax = equipmentCol && equipmentCol.MaxLength ? equipmentCol.MaxLength : null;
  // The text columns that could hold the ids ("Or use:"): not the ones a new issue already fills
  const candidates = columns
    .filter(c => ISSUE_COLUMNS.indexOf(c.LogicalName) === -1 && c.LogicalName.indexOf('craa5_') === 0)
    .map(c => ({ name: c.LogicalName, label: c.LogicalName, kind: 'text' }));
  const typed = readColumnPick('obsEquipmentIds');

  let idCol = null;
  let reason = '';
  let picked = '';
  if (typed && (find(typed) || failures.length > 0)) {
    // (also when the lookups failed and cannot say: the pick is then trusted the way EQUIPMENT_ID_COLUMN is)
    idCol = find(typed) || { LogicalName: typed, MaxLength: null };
    picked = typed;
    logEvent(`Equipment ids go in ${typed} (picked on this device).`, 'info');
  } else if (EQUIPMENT_ID_COLUMN) {
    idCol = find(EQUIPMENT_ID_COLUMN);
    if (!idCol && failures.length === 0) reason = `EQUIPMENT_ID_COLUMN "${EQUIPMENT_ID_COLUMN}" is not a text column of ${OBSERVATION_LOGICAL_NAME}.`;
    else if (!idCol) idCol = { LogicalName: EQUIPMENT_ID_COLUMN, MaxLength: null };
  } else {
    const candidates = columns.filter(c => c.LogicalName !== 'craa5__equipment' && EQUIPMENT_ID_HINT.test(c.LogicalName));
    // The longest column wins: it holds the most ids
    candidates.sort((a, b) => (b.MaxLength || 0) - (a.MaxLength || 0));
    idCol = candidates[0] || null;
    if (candidates.length > 1) logEvent(`Several equipment id columns found (${candidates.map(c => c.LogicalName).join(', ')}). Using ${idCol.LogicalName}. Set EQUIPMENT_ID_COLUMN at the top of the file to choose another.`, 'warn');
    if (!idCol) {
      reason = failures.length
        ? `the app could not look up the table's columns (${failures[0]}).`
        : `the ${OBSERVATION_LOGICAL_NAME} table has no text column for equipment ids (for example "Equipment GUIDs", craa5_equipmentguids).`;
    }
  }
  if (typed && !picked) logEvent(`The equipment id column "${typed}" kept on this device is not a text column of ${OBSERVATION_LOGICAL_NAME}; ${idCol ? `using ${idCol.LogicalName}` : 'no id column is used'}.`, 'warn');
  logEvent(`Equipment columns: names in craa5__equipment (max ${equipmentMax || 'unknown'} characters), ids in ${idCol ? idCol.LogicalName : 'no column'}.`, failures.length ? 'warn' : 'debug', failures.length ? { failures } : null);
  // idsUnknown: the table may have an id column the app could not see, so names must not change on saved observations
  return { idColumn: idCol ? idCol.LogicalName : null, equipmentMax, idMax: idCol && idCol.MaxLength ? idCol.MaxLength : null, reason, idsUnknown: !idCol && failures.length > 0, candidates, picked, typed, lookupFailed: failures.length > 0 };
}

const escOData = (s) => String(s).replace(/'/g, "''");
// Inside contains() / startswith() Dataverse treats % _ [ as LIKE wildcards: wrap them in brackets to mean the character itself
const escLike = (s) => escOData(s).replace(/\[/g, '[[]').replace(/%/g, '[%]').replace(/_/g, '[_]');
const cleanGuid = (s) => String(s || '').replace(/[{}]/g, '').trim().toLowerCase();

const toAsset = (row) => ({
  id: cleanGuid(row.craa5_aa_assetsid),
  name: (row.craa5_equipmentidentifier || '').trim() || '(no name)',
  room: (row.craa5_roomname || '').trim(),
  area: (row.craa5_areaname || '').trim()
});

async function queryAssets(filter, top) {
  const url = apiUrl(`${ASSET_SET}?$select=${ASSET_SELECT}&$filter=${encodeURIComponent(filter)}&$orderby=craa5_equipmentidentifier&$top=${top}`);
  const res = await fetch(url, { headers: ODATA_HEADERS });
  if (!res.ok) throw new Error(await readApiError(res));
  return ((await res.json()).value || []).map(toAsset).filter(a => GUID_PATTERN.test(a.id));
}

// Every typed word must appear in the equipment's name, room or area. Never the whole table: at most ASSET_SEARCH_LIMIT rows.
// When that fills the cap, names that start with the whole text are asked for too (also capped) and listed first, so a
// full name such as "Mixer 7" is not pushed out by "Mixer 1057", "Mixer 17" or equipment in a room with a 7 in its name.
const searchAssets = async (text) => {
  const words = text.trim().split(/\s+/).filter(Boolean).slice(0, 4);
  const filter = words.map(w => `(contains(craa5_equipmentidentifier,'${escLike(w)}') or contains(craa5_roomname,'${escLike(w)}') or contains(craa5_areaname,'${escLike(w)}'))`).join(' and ');
  const loose = await queryAssets(filter, ASSET_SEARCH_LIMIT);
  if (loose.length < ASSET_SEARCH_LIMIT) return loose;
  const named = await queryAssets(`startswith(craa5_equipmentidentifier,'${escLike(words.join(' '))}')`, ASSET_SEARCH_LIMIT);
  const seen = {};
  return named.concat(loose).filter(a => (seen[a.id] ? false : (seen[a.id] = true))).slice(0, ASSET_SEARCH_LIMIT);
};

// The equipment of one room and area. Area is free text, so when it matches nothing the whole room is listed (one more capped query).
const assetsInPlace = async (room, area) => {
  const roomFilter = `craa5_roomname eq '${escOData(room.trim())}'`;
  if (area && area.trim()) {
    const rows = await queryAssets(`${roomFilter} and craa5_areaname eq '${escOData(area.trim())}'`, ASSET_PLACE_LIMIT);
    if (rows.length > 0) return { rows, areaMatched: true };
  }
  return { rows: await queryAssets(roomFilter, ASSET_PLACE_LIMIT), areaMatched: false };
};

// craa5__equipment holds the names with "; " between them; the id column holds the ids in the same order ("" for text-only entries).
const parseEquipment = (namesText, idsText) => {
  const names = (namesText || '').split(';').map(s => s.trim()).filter(Boolean);
  const ids = idsText ? String(idsText).split(';').map(cleanGuid) : [];
  // Ids only count when they line up with the names (someone may have edited one column by hand)
  const aligned = ids.length === names.length;
  return names.map((name, i) => ({ name, id: aligned && GUID_PATTERN.test(ids[i]) ? ids[i] : '', room: '', area: '' }));
};

const equipmentNamesText = (list) => list.map(e => e.name.replace(/;/g, ',')).join(EQUIPMENT_SEPARATOR);
const equipmentIdsText = (list) => (list.some(e => e.id) ? list.map(e => e.id || '').join(';') : '');
const equipmentText = (item) => (item.equipmentList || []).map(e => e.name).join(', ');

// --- STATUS HELPERS ---
const currentUserName = () => {
  try {
    if (window.Xrm && window.Xrm.Utility) return window.Xrm.Utility.getGlobalContext().userSettings.userName || SIGNED_IN.name || 'You';
  } catch (e) { /* not inside the app */ }
  return SIGNED_IN.name || 'You';
};

// Closed = Inactive (statecode 1, Status Reason 2); Open = Active (statecode 0, Status Reason 1). A table with its own
// Status Reasons may refuse those numbers, so a 400 retries with the state alone and Dataverse picks that state's default reason.
async function saveStatus(id, closed, logEvent) {
  const path = `${DATAVERSE_SCHEMA.TableName}(${id})`;
  const send = async (body) => {
    logEvent(`PATCH ${closed ? 'close' : 'reopen'} ${id}`, 'data', body, { method: 'PATCH', path, contentType: 'application/json' });
    return fetch(apiUrl(path), {
      method: 'PATCH',
      headers: { ...ODATA_HEADERS, 'Content-Type': 'application/json', 'If-Match': '*' },
      body: JSON.stringify(body)
    });
  };
  let res = await send(closed ? { statecode: 1, statuscode: 2 } : { statecode: 0, statuscode: 1 });
  if (res.status === 400) {
    logEvent(`Status change with a Status Reason was refused: ${await readApiError(res)}. Retrying with the state only.`, 'warn');
    res = await send({ statecode: closed ? 1 : 0 });
  }
  if (res.status === 404) throw new Error('this observation no longer exists in Dataverse (HTTP 404)');
  if (!res.ok) throw new Error(await readApiError(res));
}

// --- MAPS (craa5___maps: one row per map picture, craa5_facility = the map's code) ---
// A problem keeps its map's code in craa5__facility. Blank or MAIN counts for the main map (the row coded MAIN, else the
// oldest row), so everything saved before there was a second map stays on the first one.
const MAP_KEY_MAX = 20; // codes are cut to 20 characters: an asset's spot (JSON in a 100-character column) carries the code
const mapKeyOf = (code) => String(code || '').trim().toUpperCase().slice(0, MAP_KEY_MAX);
const onMainMapCode = (code) => !code || code === 'MAIN';
const MAP_PREF = 'stillwell.mapId';
// The main map's code, set once the map rows are read (pinOnMap needs it)
const MAP_STATE = { mainKey: 'MAIN' };

// The map rows as the picker shows them, the main map first: [{ id, code, key, label, main, renamed }]. A code two rows share
// gets -2, -3 on the second and third, so each map keeps its own problems.
function mapList(rows) {
  const list = (rows || []).map(r => ({ id: r.craa5___mapsid || r.craa5___mapsId, code: String(r.craa5_facility || r.craa5_Facility || '').trim() })).filter(m => m.id);
  if (!list.length) return [];
  let mainIndex = -1;
  list.forEach((m, i) => { if (mainIndex === -1 && mapKeyOf(m.code) === 'MAIN') mainIndex = i; });
  if (mainIndex === -1) mainIndex = 0;
  const ordered = [list[mainIndex]].concat(list.filter((m, i) => i !== mainIndex));
  const used = {};
  return ordered.map((m, i) => {
    const base = mapKeyOf(m.code) || (i === 0 ? 'MAIN' : `MAP${i + 1}`);
    let key = base;
    for (let n = 2; used[key]; n += 1) key = `${base.slice(0, MAP_KEY_MAX - String(n).length - 1)}-${n}`;
    used[key] = true;
    return { id: m.id, code: m.code, key, label: m.code || (i === 0 ? 'Main map' : `Map ${i + 1}`), main: i === 0, renamed: key !== mapKeyOf(m.code) };
  });
}

// The rows of craa5___maps: ids and codes only (the pictures are fetched one at a time, for the map on screen)
async function loadMapRows() {
  const path = `${DATAVERSE_MAPS_SCHEMA.TableName}?$select=craa5___mapsid,craa5_facility`;
  let res = await fetch(apiUrl(`${path}&$orderby=createdon asc`), { headers: ODATA_HEADERS });
  if (res.status === 400) res = await fetch(apiUrl(path), { headers: ODATA_HEADERS });
  if (!res.ok) throw new Error(await readApiError(res));
  return mapList((await res.json()).value);
}

// One map's picture: { url, bytes, type } or { note } saying plainly why there is none
async function loadMapPicture(map) {
  const res = await fetch(apiUrl(`${DATAVERSE_MAPS_SCHEMA.TableName}(${map.id})/craa5_mapimage/$value?size=full`));
  if (res.status === 204 || res.status === 404) return { note: `The map "${map.label}" has no picture in Dataverse yet. Add one to its Map Image column (craa5_mapimage) in the maps table.` };
  if (!res.ok) return { note: `The picture of the map "${map.label}" could not be downloaded (${await readApiError(res)}).` };
  const blob = await res.blob();
  if (!blob.size) return { note: `The map "${map.label}" has no picture in Dataverse yet (the picture came back empty). Add one to its Map Image column (craa5_mapimage).` };
  return { url: URL.createObjectURL(blob), bytes: blob.size, type: blob.type || '' };
}

// --- PROBLEMS (craa5__facilityobservations), a page at a time ---
// Open problems are all read (500 a page, at most 5,000). Closed ones come newest-closed first, 200 a page, and only those
// submitted inside the timeframe; "Load older" reads the next page. Only the map on screen. Never the whole table at once.
const OPEN_PAGE = 500;
const OPEN_MAX = 5000;
const CLOSED_PAGE = 200;
const OLDER_SEARCH_TOP = 50;
// statecode / statuscode / modifiedon are system columns every table has: they carry Open / Closed
const PROBLEM_SELECT = 'craa5__facilityobservationid,craa5_mapx,craa5_mapy,craa5__boxwidth,craa5__boxheight,craa5__room,craa5__area,craa5__equipment,craa5__description,craa5__whotonotify,craa5__customnote,createdon,modifiedon,statecode,statuscode';
const PROBLEM_EXPAND = 'createdby($select=fullname),modifiedby($select=fullname)';
const TIMEFRAME_HOURS = { '24h': 24, '7d': 24 * 7, '30d': 24 * 30 };
const timeframeStart = (timeFilter) => (TIMEFRAME_HOURS[timeFilter] ? new Date(Date.now() - TIMEFRAME_HOURS[timeFilter] * 3600000).toISOString().replace(/\.\d{3}Z$/, 'Z') : '');

// The problems of one map. With a single map row every problem is on it (no filter).
function problemMapFilter(maps, map) {
  if (!map || !maps || maps.length < 2) return '';
  const own = `craa5__facility eq '${escOData(map.key)}'`;
  if (!map.main) return own;
  return `(craa5__facility eq null or craa5__facility eq '' or craa5__facility eq 'MAIN'${map.key !== 'MAIN' ? ` or ${own}` : ''})`;
}

// The extra columns a problem read asks for, tried in order: the picture marker (and the equipment ids), else plainer
const problemSelectOptions = (pic, idColumn) => {
  const pictureOptions = pic && pic.ready ? pictureSelectOptions(pic.name, pic.type) : [[]];
  return idColumn ? pictureOptions.map(extra => extra.concat([idColumn])).concat([[]]) : pictureOptions;
};

// Every typed word somewhere in the problem's text columns
const problemWordFilter = (words) => words.map(w => `(${['craa5__description', 'craa5__room', 'craa5__area', 'craa5__equipment', 'craa5__customnote', 'craa5__whotonotify'].map(c => `contains(${c},'${escLike(w)}')`).join(' or ')})`).join(' and ');

function problemQueryUrl(select, closed, mapFilter, since, extraFilter) {
  const filter = [`statecode eq ${closed ? 1 : 0}`, mapFilter, since ? `createdon ge ${since}` : '', extraFilter || ''].filter(Boolean).join(' and ');
  const order = `${closed ? 'modifiedon' : 'createdon'} desc,craa5__facilityobservationid asc`;
  return apiUrl(`${DATAVERSE_SCHEMA.TableName}?$select=${select}&$expand=${PROBLEM_EXPAND}&$filter=${encodeURIComponent(filter)}&$orderby=${encodeURIComponent(order)}&$count=true`);
}

// One page of problems: `url` is a new query, or the nextLink Dataverse gave with the page before
async function fetchProblemPage(url, pageSize) {
  const res = await fetch(url, { headers: { ...ODATA_HEADERS, Prefer: `odata.include-annotations="*",odata.maxpagesize=${pageSize}` } });
  if (!res.ok) {
    const error = new Error(await readApiError(res));
    error.status = res.status;
    throw error;
  }
  const data = await res.json();
  return {
    rows: data.value || [],
    next: data['@odata.nextLink'] || null,
    count: typeof data['@odata.count'] === 'number' ? data['@odata.count'] : null,
    countCapped: data['@Microsoft.Dynamics.CRM.totalrecordcountlimitexceeded'] === true
  };
}

// The first page of open problems. A 400 means Dataverse refused something: the map filter is dropped when the same columns
// work without it, else the next plainer column list is tried, so a wrong guess can never blank the map.
async function firstOpenProblems(selectOptions, mapFilter, logEvent) {
  for (let k = 0; k < selectOptions.length; k += 1) {
    const extra = selectOptions[k];
    const select = extra.length ? `${PROBLEM_SELECT},${extra.join(',')}` : PROBLEM_SELECT;
    try {
      return { page: await fetchProblemPage(problemQueryUrl(select, false, mapFilter, ''), OPEN_PAGE), extra, select, splitError: '' };
    } catch (error) {
      if (error.status !== 400) throw error;
      if (mapFilter) {
        let page = null;
        try {
          page = await fetchProblemPage(problemQueryUrl(select, false, '', ''), OPEN_PAGE);
        } catch (plain) {
          if (plain.status !== 400) throw plain;
        }
        if (page) return { page, extra, select, splitError: error.message };
      }
      logEvent(`Problem query with extra fields [${extra.join(', ') || 'none'}] was rejected (HTTP 400).`, 'warn');
    }
  }
  throw new Error('Dataverse refused every way the app asks for the problems (HTTP 400).');
}

// A problem row as the app holds it. `ctx` = { picReady, picName, pictureFields, idColumn }
function problemFromRow(item, ctx) {
  const id = item.craa5__facilityobservationid;
  const hasPicture = ctx.picReady ? rowHasPicture(item, ctx.pictureFields) : false;
  const equipmentList = parseEquipment(item.craa5__equipment, ctx.idColumn ? item[ctx.idColumn] : '');
  return {
    id,
    mapX: item.craa5_mapx || 0,
    mapY: item.craa5_mapy || 0,
    boxW: item.craa5__boxwidth || 10,
    boxH: item.craa5__boxheight || 10,
    room: item.craa5__room || '',
    area: item.craa5__area || 'Unknown Area',
    equipmentList,
    equipment: equipmentText({ equipmentList }),
    description: item.craa5__description || '',
    whoToNotify: item.craa5__whotonotify || '',
    ...parseCategory(item.craa5__customnote),
    closed: item.statecode === 1,
    statusReason: item['statuscode@OData.Community.Display.V1.FormattedValue'] || '',
    modifiedOn: item.modifiedon || item.createdon,
    modifiedBy: item.modifiedby ? item.modifiedby.fullname : (item['_modifiedby_value@OData.Community.Display.V1.FormattedValue'] || ''),
    image: null,
    picture: hasPicture === false ? null : storedPictureUrls(ctx.picName, id),
    submittedOn: item.createdon,
    submittedBy: item.createdby ? item.createdby.fullname : (item['_createdby_value@OData.Community.Display.V1.FormattedValue'] || 'Unknown')
  };
}

// New rows join a list once (by id); `fresh` wins over what the list had
const mergeProblems = (list, fresh) => {
  const ids = {};
  fresh.forEach(s => { ids[s.id] = true; });
