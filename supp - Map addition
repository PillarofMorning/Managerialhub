// Close / Reopen button with its own saving state and error
function CloseButton({ item, onSetClosed, compact = false }) {
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const mounted = useRef(true);
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
  if (!onSetClosed) return null;
  const toggle = async (e) => {
    // The second click of a double-click would undo the first once a fast save has returned
    if (busy || (e && e.detail > 1)) return;
    setBusy(true);
    setError('');
    const reason = await onSetClosed(item, !item.closed);
    if (!mounted.current) return;
    setBusy(false);
    if (reason) setError(`Not saved: ${reason}`);
  };
  const size = compact ? 'px-3 py-1.5 text-xs' : 'px-4 py-2 text-sm';
  return (
    <span className="inline-flex flex-col items-start gap-1">
      <button
        type="button"
        onClick={toggle}
        disabled={busy}
        className={`inline-flex items-center gap-1.5 ${size} rounded-md font-semibold border shadow-sm disabled:opacity-60 disabled:cursor-wait ${item.closed ? 'bg-white text-slate-700 border-slate-300 hover:bg-slate-100' : 'bg-green-700 text-white border-green-700 hover:bg-green-800'}`}
      >
        <CheckCircle className={compact ? 'w-3.5 h-3.5' : 'w-4 h-4'} />
        {busy ? 'Saving...' : (item.closed ? 'Reopen' : 'Mark closed')}
      </button>
      {error && <span className="text-xs text-[#C4001F] max-w-xs" role="alert">{error}</span>}
    </span>
  );
}

