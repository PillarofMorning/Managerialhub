  const recentClicks = useRef([]);
  return (
    <article
      aria-label={`${categoryText(item)}: ${place || 'Unassigned location'}`}
      onClick={(e) => { const now = Date.now(); recentClicks.current = [...recentClicks.current.filter(c => now - c.at < 600), { at: now, onButton: !!e.target.closest('button') }]; }}
      onDoubleClick={(e) => { const last = recentClicks.current.slice(-2); if (!e.target.closest('button') && last.length === 2 && last.every(c => !c.onButton)) onLocate(item); }}
      title="Double-click to jump to this location on the map"
      className={`group rounded-xl border shadow-sm hover:shadow-md hover:border-[#0072CE]/40 transition-all flex flex-col sm:flex-row gap-3 p-3 sm:p-4 ${item.closed ? 'bg-slate-50 border-slate-200' : 'bg-white border-slate-200'}`}
      style={{ borderLeft: `4px solid ${itemColor(item)}` }}
      data-status={item.closed ? 'closed' : 'open'}
    >
      <div className="flex sm:flex-col gap-2 shrink-0">
        <MapThumb item={item} mapImage={mapImage} aspect={aspect} />
        <PhotoThumb item={item} label={place || 'this item'} onClick={() => onOpen(item)} />
      </div>

      <div className="flex-1 min-w-0">
        <div className="flex flex-wrap items-center gap-2 mb-1.5">
          <button
            type="button"
            onClick={() => onPickCategory(item.category)}
            title="Show only this category"
            className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold border max-w-full"
            style={{ color: meta.color, borderColor: `${meta.color}55`, backgroundColor: `${meta.color}14` }}
          >
            <span className="w-1.5 h-1.5 rounded-full shrink-0" style={{ backgroundColor: meta.color }} />
            <span className="truncate">{categoryText(item)}</span>
          </button>
          <StatusBadge item={item} />
          <time dateTime={item.submittedOn} className="text-xs text-slate-600" title={new Date(item.submittedOn).toLocaleString()}>
            {formatWhen(item.submittedOn)}
            {recentAgo(item.submittedOn) && <span className="text-slate-500"> - {recentAgo(item.submittedOn)}</span>}
          </time>
        </div>

        <h4 className={`font-semibold text-sm sm:text-base [overflow-wrap:anywhere] ${item.closed ? 'text-slate-500' : 'text-slate-800'}`}>{place || 'Unassigned location'}</h4>
        {item.equipmentList && item.equipmentList.length > 0 && (
          <ul className="mt-1 flex flex-wrap gap-1" aria-label="Equipment">
            {item.equipmentList.map((e, i) => (
              <li key={`${e.id || 'text'}-${i}`} className={`px-1.5 py-0.5 rounded text-[11px] font-semibold border [overflow-wrap:anywhere] ${e.id ? 'bg-[#E6F1FB] text-[#00468B] border-[#B3D4F2]' : 'bg-slate-100 text-slate-700 border-slate-200'}`}>{e.name}</li>
            ))}
          </ul>
        )}
        <p className="text-sm text-slate-600 mt-1 line-clamp-3 whitespace-pre-wrap break-words">{item.description}</p>

        <div className="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
          {item.whoToNotify && <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">Notify: <span className="font-medium text-slate-700">{item.whoToNotify}</span></span>}
          <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">By <span className="font-medium text-slate-700">{item.submittedBy}</span></span>
          {item.closed && <span className="min-w-0 max-w-full [overflow-wrap:anywhere]">Closed (last change) {formatWhen(item.modifiedOn)}{item.modifiedBy ? ` by ${item.modifiedBy}` : ''}</span>}
        </div>

        <div className="mt-3 flex flex-wrap gap-2">
          <button type="button" onClick={() => onLocate(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#0072CE] text-white text-xs font-semibold hover:bg-[#00468B] shadow-sm">
            <MapPin className="w-3.5 h-3.5" /> Locate on map
          </button>
          <button type="button" onClick={() => onOpen(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white text-slate-700 border border-slate-300 text-xs font-semibold hover:bg-slate-100">
            <Maximize2 className="w-3.5 h-3.5" /> Details
          </button>
          <button type="button" onClick={() => onEdit(item)} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white text-slate-700 border border-slate-300 text-xs font-semibold hover:bg-slate-100">
            <PencilIcon className="w-3.5 h-3.5" /> Edit
          </button>
          <CloseButton item={item} onSetClosed={onSetClosed} compact />
        </div>
      </div>
    </article>
  );
}

function TableTab({ submissions, timeFilteredCount, timeFilter, categoryBar, mapImage, logEvent, onLocate, onEdit, onSetClosed, liveItems }) {
  const [selectedItem, setSelectedItem] = useState(null);
  const [visibleCount, setVisibleCount] = useState(RAIL_PAGE);
  const scrollRef = useRef(null);
  const sentinelRef = useRef(null);
  const aspect = useImageAspect(mapImage);

  // Newest first (the shared search, status and category filters already narrowed `submissions`)
  const items = useMemo(() => submissions.slice().sort((a, b) => new Date(b.submittedOn) - new Date(a.submittedOn)), [submissions]);

  // Roll back to the top when the search, a filter or the timeframe changes - not when one item is closed, reopened
  // or edited in place, so someone working down the list keeps their place
  const filterKey = [categoryBar.query.trim().toLowerCase(), categoryBar.status, categoryBar.selected.join('|'), timeFilter].join('#');
  useEffect(() => {
    setVisibleCount(RAIL_PAGE);
    if (scrollRef.current) scrollRef.current.scrollTop = 0;
  }, [filterKey]);

  // Roll more cards in as the end of the list comes into view
  const hasMore = visibleCount < items.length;
  useEffect(() => {
    if (!hasMore) return undefined;
    if (typeof IntersectionObserver === 'undefined') { setVisibleCount(items.length); return undefined; }
    const node = sentinelRef.current;
    if (!node) return undefined;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some(entry => entry.isIntersecting)) setVisibleCount(count => count + RAIL_PAGE);
    }, { root: scrollRef.current, rootMargin: '400px 0px' });
    observer.observe(node);
    return () => observer.disconnect();
  }, [hasMore, visibleCount, items.length]);

  // Day groups: Today / Yesterday / 2-7 days ago / ...
  const groups = useMemo(() => {
    const out = [];
    items.slice(0, visibleCount).forEach(item => {
      const label = dayBucket(item.submittedOn);
      const last = out[out.length - 1];
      if (last && last.label === label) last.items.push(item);
      else out.push({ label, items: [item] });
    });
    return out;
  }, [items, visibleCount]);

  const locate = (item) => { logEvent(`Action rail: locating ${item.id} on the map`, 'info'); onLocate(item); };
  const open = (item) => { logEvent(`Action rail: opened details for ${item.id}`, 'info'); setSelectedItem(item); };
  const pickCategory = (key) => categoryBar.onOnly(key);
  const hasNarrowing = categoryBar.narrowed;

  return (
    <div className="h-full flex flex-col bg-slate-100">
      <div className="shrink-0 bg-white border-b border-slate-200 shadow-sm px-4 sm:px-6 py-4 space-y-3 z-10 [@media(max-height:520px)]:py-2 [@media(max-height:520px)]:space-y-1">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 className="text-xl font-black text-[#00468B] flex items-center gap-2">
              <TableIcon className="text-[#0072CE]" />
              Action Item Rail
            </h2>
            <p className="text-sm text-slate-600 mt-1 [@media(max-height:520px)]:hidden">Newest first. Scroll to roll through every item; double-click a card (or press Locate) to jump to it on the map.</p>
          </div>
          <SearchBox query={categoryBar.query} onQuery={categoryBar.onQuery} className="w-full sm:w-72" />
        </div>
        <CategoryFilterBar {...categoryBar} />
        <div role="status" className="text-xs text-slate-600">Showing <span className="font-bold text-slate-700">{items.length}</span> of {timeFilteredCount} items in this timeframe</div>
      </div>
      <div ref={scrollRef} className="flex-1 overflow-y-auto overflow-x-hidden">
