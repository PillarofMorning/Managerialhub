// --- PICTURE HELPERS ---
const MAX_PICTURE_SIDE = 1600; // px on the long side. Phone photos (5-12 MB) become a JPEG of a few hundred KB.

// Re-encode whatever the user picked as a JPEG that is small enough to upload reliably. Resolves a data URL.
const compressImage = (file) => new Promise((resolve, reject) => {
  const objectUrl = URL.createObjectURL(file);
  const img = new Image();
  img.onerror = () => {
    URL.revokeObjectURL(objectUrl);
    reject(new Error('That file is not a picture this browser can open. Try a JPG or PNG.'));
  };
  img.onload = () => {
    URL.revokeObjectURL(objectUrl);
    try {
      const scale = Math.min(1, MAX_PICTURE_SIDE / Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.width * scale));
      canvas.height = Math.max(1, Math.round(img.height * scale));
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#FFFFFF'; // JPEG has no transparency: see-through parts would turn black
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', 0.8));
    } catch (err) {
      reject(new Error('The picture could not be prepared for upload.'));
    }
  };
  img.src = objectUrl;
});

const dataUrlToBytes = (dataUrl) => {
  const binary = atob(dataUrl.slice(dataUrl.indexOf(',') + 1));
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
  return bytes;
};

// Scroll a zoomable map container so the point (xPct, yPct) of the map sits in the middle of the view.
// Waits for the map picture to be laid out first: before that the container has nothing to scroll to.
const centerMapOn = (container, xPct, yPct) => {
  if (!container) return;
  const img = container.querySelector('img');
  // Measure the zoomed map itself (the container's first child), not the scroll area, so nothing else that overflows
  // (a wide tooltip near the edge) can move the target
  const go = () => {
    const map = container.firstElementChild || container;
    const left = map === container ? 0 : map.offsetLeft;
    const top = map === container ? 0 : map.offsetTop;
    container.scrollTo({
      left: left + (xPct / 100) * map.offsetWidth - container.clientWidth / 2,
      top: top + (yPct / 100) * map.offsetHeight - container.clientHeight / 2,
      behavior: 'smooth'
    });
  };
  if (img && !img.complete) img.addEventListener('load', go, { once: true });
  else go();
};

// "Tue, Oct 6, 5:49 PM" (the year too when it is not this year)
const formatWhen = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  const date = d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', ...(d.getFullYear() !== new Date().getFullYear() ? { year: 'numeric' } : {}) });
  return `${date}, ${d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
};

// A relative hint only while it is under a day old, so it can never disagree with the day heading
const recentAgo = (iso) => {
  const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
  if (isNaN(mins) || mins < 0 || mins >= 24 * 60) return '';
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins} min ago`;
  return `${Math.floor(mins / 60)} h ago`;
};

// Calendar-day buckets so the rail reads "Today / Yesterday / ..." as it rolls
const dayBucket = (iso) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return 'Older';
  const today = new Date(); today.setHours(0, 0, 0, 0);
  d.setHours(0, 0, 0, 0);
  const days = Math.round((today - d) / 86400000);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days <= 7) return '2-7 days ago';
  if (days <= 30) return '8-30 days ago';
  return 'Older';
};

export default function App() {
