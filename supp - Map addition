// HOST CHECK (Debug drawer): what this page can and cannot do where it is hosted, one line each (green / red / amber,
// with a symbol too). Read once the card is opened; "Run again" reads it again. "Copy as text" for sending it on.
// ==========================================
// Tiny scripts on the three public CDNs (the QR label library the roadmap uses): loaded only when the card runs
const CDN_PROBES = [
  { name: 'cdnjs', url: 'https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js' },
  { name: 'jsdelivr', url: 'https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js' },
  { name: 'unpkg', url: 'https://unpkg.com/qrcode-generator@1.4.4/qrcode.js' }
];
const probeScript = (url, ms) => new Promise(resolve => {
  const tag = document.createElement('script');
  let done = false;
  let timer = null;
  const finish = (ok) => {
    if (done) return;
    done = true;
    clearTimeout(timer);
    tag.onload = null;
    tag.onerror = null;
    if (tag.parentNode) tag.parentNode.removeChild(tag);
    resolve(ok);
  };
  timer = setTimeout(() => finish(false), ms);
  tag.onload = () => finish(true);
  tag.onerror = () => finish(false);
  tag.async = true;
  tag.src = url;
  document.head.appendChild(tag);
});

const inFrame = () => {
  try { return window.self !== window.top; } catch (e) { return true; }
};

// What reaches the page from its link: the address after ? and #, and the host's page context (a custom page's input)
function readLinkParams() {
  const found = [];
  const idLike = [];
  const take = (where, text) => {
    String(text || '').replace(/^[?#]/, '').split('&').forEach(part => {
      if (!part) return;
      let shown = part;
      try { shown = decodeURIComponent(part.replace(/\+/g, ' ')); } catch (e) { /* shown as it is */ }
      if (shown.length > 60) shown = `${shown.slice(0, 57)}...`;
      found.push(`${where}${shown}`);
      if (/^(asset|assetid|issue|issueid|id|recordid|entityid|data)=/i.test(part)) idLike.push(`${where}${shown}`);
    });
  };
  try {
    take('?', window.location.search);
    take('#', window.location.hash);
  } catch (e) { /* the address cannot be read */ }
  let page = '';
  try {
    const pc = window.Xrm && window.Xrm.Utility && window.Xrm.Utility.getPageContext ? window.Xrm.Utility.getPageContext() : null;
    const input = pc && pc.input;
    if (input) {
      page = ['pageType', 'name', 'entityName', 'entityId'].filter(k => input[k]).map(k => `${k}=${input[k]}`).join(', ');
      if (input.entityId) idLike.push(`page context entityId=${input.entityId}`);
      else if (input.recordId) idLike.push(`page context recordId=${input.recordId}`);
      else if (input.data) idLike.push('page context data');
    }
  } catch (e) { /* no page context */ }
  return { found, idLike, page };
}

// The signed-in user's security roles: from the host, else the roles given straight to the user in Dataverse
async function readRoles(signedIn) {
  try {
    const g = hostContext();
    const roles = g && g.userSettings && g.userSettings.roles;
    if (roles && typeof roles.forEach === 'function') {
      const names = [];
      roles.forEach(r => { if (r) names.push(r.name || r.id || '?'); });
      return { ok: true, names, how: 'host' };
    }
  } catch (e) { /* not from the host */ }
  if (!signedIn || !signedIn.id) return { ok: false, error: 'the page cannot tell who is signed in' };
  try {
    const data = await getJson(`systemusers(${signedIn.id})/systemuserroles_association?$select=name`);
    return { ok: true, names: (data.value || []).map(r => r.name).filter(Boolean), how: 'dataverse' };
  } catch (error) {
    return { ok: false, error: error.message };
  }
}

// The map picture column's settings: does it keep full-size pictures, and how big may one be
async function readMapPictureColumn() {
  let logical = 'craa5___maps';
  try {
    const d = await getJson(`EntityDefinitions?$select=LogicalName&$filter=${encodeURIComponent(`EntitySetName eq '${DATAVERSE_MAPS_SCHEMA.TableName}'`)}`);
    if (d.value && d.value[0] && d.value[0].LogicalName) logical = d.value[0].LogicalName;
  } catch (e) { /* the usual name */ }
  const m = await getJson(`EntityDefinitions(LogicalName='${logical}')/Attributes(LogicalName='craa5_mapimage')/Microsoft.Dynamics.CRM.ImageAttributeMetadata?$select=CanStoreFullImage,MaxSizeInKB`);
  return { canFull: m.CanStoreFullImage === true, maxKB: typeof m.MaxSizeInKB === 'number' ? m.MaxSizeInKB : null };
}

// How many problems the whole table holds (Dataverse keeps this count from a snapshot it refreshes about once a day)
async function readProblemTableCount() {
  const d = await getJson(`RetrieveTotalRecordCount(EntityNames=@p)?@p=${encodeURIComponent(JSON.stringify([OBSERVATION_LOGICAL_NAME]))}`);
  const c = d && d.EntityRecordCountCollection;
  const at = c && c.Keys ? c.Keys.indexOf(OBSERVATION_LOGICAL_NAME) : -1;
  return at === -1 ? null : c.Values[at];
}

// Resolves to true when the text was copied (a frame may refuse the clipboard: the old copy command is tried then)
const copyText = (text) => {
  const fallback = () => {
    const area = document.createElement('textarea');
    area.value = text;
    document.body.appendChild(area);
    area.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { /* not copied */ }
    area.remove();
    return ok;
  };
  if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text).then(() => true, () => fallback());
  return Promise.resolve(fallback());
};

const CHECK_MARK = { ok: '✓', bad: '✗', warn: '!', info: 'i', wait: '…' };
const CHECK_WORD = { ok: 'fine', bad: 'problem', warn: 'needs a look', info: 'for information', wait: 'checking' };
const CHECK_COLOR = { ok: 'text-green-400', bad: 'text-red-400', warn: 'text-amber-300', info: 'text-sky-300', wait: 'text-slate-500' };
const kb = (bytes) => `${Math.round(bytes / 1024).toLocaleString()} KB`;

function HostCheck({ maps, currentMap, mapPicture, mapImage, problemWindow, signedIn, loadedCount, timeFilter, logEvent }) {
  const [run, setRun] = useState(1);
  const [roles, setRoles] = useState({ wait: true });
  const [cdn, setCdn] = useState(null);
  const [pictureMeta, setPictureMeta] = useState({ wait: true });
  const [tableCount, setTableCount] = useState({ wait: true });
  const [natural, setNatural] = useState(null);
  const [copied, setCopied] = useState(false);
  const link = useMemo(() => readLinkParams(), [run]); // eslint-disable-line react-hooks/exhaustive-deps
  const framed = useMemo(() => inFrame(), []);

  useEffect(() => {
    let alive = true;
    setRoles({ wait: true });
    setCdn(null);
    setPictureMeta({ wait: true });
    setTableCount({ wait: true });
    logEvent('Host check: reading roles, scripts, the map picture column and the problem count...', 'debug');
    readRoles(signedIn).then(r => { if (alive) setRoles(r); });
    Promise.all(CDN_PROBES.map(p => probeScript(p.url, 8000).then(ok => ({ name: p.name, ok })))).then(r => { if (alive) setCdn(r); });
    readMapPictureColumn().then(m => { if (alive) setPictureMeta(m); }).catch(error => { if (alive) setPictureMeta({ error: error.message }); });
    readProblemTableCount().then(n => { if (alive) setTableCount({ n }); }).catch(error => { if (alive) setTableCount({ error: error.message }); });
    return () => { alive = false; };
  }, [run, signedIn.id, signedIn.checking]); // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    setNatural(null);
    if (!mapImage) return undefined;
    let alive = true;
    loadPicture(mapImage).then(img => { if (alive) setNatural({ w: img.naturalWidth, h: img.naturalHeight }); }).catch(() => {});
    return () => { alive = false; };
  }, [mapImage]);

  const lines = [];
  const add = (key, state, title, text) => lines.push({ key, state, title, text });

  if (signedIn.checking) add('who', 'wait', 'Signed in', 'Checking...');
  else if (signedIn.name) add('who', 'ok', 'Signed in', `${signedIn.name} (read from ${signedIn.how}).`);
  else add('who', 'bad', 'Signed in', `The page cannot tell who is signed in${signedIn.error ? ` (${signedIn.error})` : ''}. Saves still carry the Dataverse user.`);

  if (roles.wait) add('roles', 'wait', 'Security roles', 'Checking...');
  else if (roles.ok) {
    add('roles', roles.names.length ? 'ok' : 'warn', 'Security roles', roles.names.length
      ? `${roles.names.length}: ${roles.names.join(', ')}${roles.how === 'dataverse' ? ' (read from Dataverse: roles given through a team are not listed).' : '.'}`
      : 'The page can read them, but none are given straight to this user (team roles are not listed).');
  } else add('roles', 'bad', 'Security roles', `The page cannot read them (${roles.error}). Showing buttons by role needs them; Dataverse's own security still decides what is saved.`);

  if (link.idLike.length) add('link', 'ok', 'Link to a record', `The page sees ${link.idLike.join(', ')}, so a link (or a QR code) can open a record.`);
  else add('link', 'warn', 'Link to a record', `No record id reached the page${link.found.length ? ` (the address carries ${link.found.join(', ')})` : ''}${link.page ? `; the host's page context: ${link.page}` : ''}. To test: add ?asset=TEST to the end of this page's address, open it, and run this check again.`);

  add('frame', 'info', 'Runs in a frame', framed ? 'Yes: the page runs inside the app, in a frame.' : 'No: the page has the browser window to itself.');

  const tailwind = typeof window !== 'undefined' && !!window.tailwind;
  if (!cdn) add('cdn', 'wait', 'Scripts from CDNs', `Tailwind (the page's styles) ${tailwind ? 'loaded' : 'not loaded'}; testing cdnjs, jsdelivr and unpkg...`);
  else {
    const okCount = cdn.filter(c => c.ok).length;
    add('cdn', okCount === cdn.length && tailwind ? 'ok' : (okCount ? 'warn' : 'bad'), 'Scripts from CDNs',
      `Tailwind (the page's styles) ${tailwind ? 'loaded' : 'not loaded (the styles come from somewhere else, or are missing)'}; ${cdn.map(c => `${c.name} ${c.ok ? 'loads' : 'could not load'}`).join(', ')}. The iPhone photo converter and QR labels need at least one.`);
  }

  if (!currentMap) add('picture', 'bad', 'Map picture', mapPicture.note || 'No map row was found.');
  else if (mapPicture.status === 'loading') add('picture', 'wait', 'Map picture', 'Downloading...');
  else if (mapPicture.status !== 'ready') add('picture', 'bad', 'Map picture', mapPicture.note || 'The picture could not be shown.');
  else {
    const size = `${currentMap.label}: ${kb(mapPicture.bytes)}${mapPicture.type ? ` ${mapPicture.type.replace('image/', '').toUpperCase()}` : ''}${natural ? `, ${natural.w} × ${natural.h} px` : ''}`;
    if (pictureMeta.wait) add('picture', 'wait', 'Map picture', `${size}. Checking the column...`);
    else if (pictureMeta.error) add('picture', 'warn', 'Map picture', `${size}. The column's settings could not be read (${pictureMeta.error}).`);
    else {
      const small = natural && Math.max(natural.w, natural.h) <= 144;
      add('picture', pictureMeta.canFull && !small ? 'ok' : 'bad', 'Map picture',
        `${size}. The Map Image column ${pictureMeta.canFull ? 'keeps full-size pictures' : 'keeps only a small thumbnail: turn on "Can store full images" on craa5_mapimage'}${pictureMeta.maxKB ? `; the largest picture it takes is ${pictureMeta.maxKB.toLocaleString()} KB` : ''}.`);
    }
  }

  const w = problemWindow;
  const within = TIMEFRAME_WORDS[timeFilter] ? ` submitted in ${TIMEFRAME_WORDS[timeFilter]}` : '';
  const here = w.status === 'ready'
    ? `This map: ${w.openTotal !== null ? `${w.openTotal}${w.openCapped ? '+' : ''}` : '?'} open, ${w.closedTotal !== null ? `${w.closedTotal}${w.closedCapped ? '+' : ''}` : '?'} closed${within}; ${loadedCount} loaded now.`
    : (w.status === 'error' ? `This map's problems could not be read (${w.error}).` : 'This map: still loading.');
  if (tableCount.wait) add('problems', 'wait', 'Problems', `${here} Counting the whole table...`);
  else add('problems', w.status === 'error' ? 'bad' : (tableCount.error ? 'warn' : 'ok'), 'Problems',
    `${tableCount.error ? `The whole table could not be counted (${tableCount.error}).` : `About ${tableCount.n !== null && tableCount.n !== undefined ? Number(tableCount.n).toLocaleString() : '?'} in the whole table (a count Dataverse refreshes about once a day).`} ${here}`);

  const renamed = maps.filter(m => m.renamed && !m.main);
  add('maps', !maps.length ? 'bad' : (renamed.length || w.splitNote ? 'warn' : 'ok'), 'Maps',
    !maps.length ? 'No map rows in craa5___maps.'
      : `${maps.length}: ${maps.map(m => `${m.label} (code ${m.key})`).join(', ')}. ${maps.length < 2 ? 'Every problem is on the only map.' : (w.splitNote ? `Problems cannot be split by map: ${w.splitNote}` : 'Each map shows its own problems (craa5__facility; blank or MAIN = the main map).')}${renamed.length ? ` ${renamed.map(m => `${m.label} has no code of its own, so it uses ${m.key}`).join('; ')}: give each map its own Facility code.` : ''}`);

  const copy = () => {
    const text = lines.map(l => `${CHECK_MARK[l.state]} ${l.title}: ${l.text}`).join('\n');
    copyText(`Host check (${new Date().toLocaleString()})\n${text}`).then(ok => { setCopied(ok ? 'Copied' : 'Not copied: select the text'); setTimeout(() => setCopied(false), ok ? 1500 : 4000); });
  };

  return (
    <div className="flex-1 overflow-y-auto p-3" data-testid="host-check">
      <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
        <span className="text-yellow-400 font-bold">Host check: what this page can do where it runs</span>
        <span className="flex gap-2">
          <button type="button" onClick={() => setRun(r => r + 1)} className="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-blue-300 rounded border border-slate-700">Run again</button>
          <button type="button" onClick={copy} className="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-blue-300 rounded border border-slate-700">{copied || 'Copy as text'}</button>
        </span>
      </div>
      <ul className="space-y-1.5">
        {lines.map(l => (
          <li key={l.key} className="flex gap-2" data-check={l.key} data-state={l.state}>
            <span className={`w-4 shrink-0 font-bold text-center ${CHECK_COLOR[l.state]}`} aria-hidden="true">{CHECK_MARK[l.state]}</span>
            <span className="break-words min-w-0">
              <span className={`font-bold ${CHECK_COLOR[l.state]}`}>{l.title}</span>
              <span className="sr-only"> ({CHECK_WORD[l.state]})</span>
              <span className="text-slate-300">: {l.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  );
}

