// DATAVERSE CHECK ENGINE (no React in this block, so it can be tested alone)
// Rule: a table is only called found when Dataverse said so; a column is only
// called there or missing when the table's metadata (or a real row) said so.
// Anything else is "could not tell" and never shows green.
// ============================================================================

const DV_TIMEOUT_MS = 15000;
const DV_COUNT_CAP_FETCH = 5000;
const DV_COUNT_CAP_AGG = 50000;

function dvErrText(e) {
  if (!e) return '';
  if (typeof e === 'string') return e.replace(/\s+/g, ' ').slice(0, 400);
  let m = '';
  try { m = e.message || (e.error && e.error.message) || ''; } catch (x) {}
  if (!m) { try { m = JSON.stringify(e); } catch (x) { m = String(e); } }
  const code = (e && (e.errorCode || e.code)) ? ' (' + (e.errorCode || e.code) + ')' : '';
  return (String(m) + code).replace(/\s+/g, ' ').slice(0, 400);
}

// What kind of refusal this is. Wordings are the ones Dataverse uses (same list as hub - manager).
function dvClassify(err) {
  const m = typeof err === 'string' ? err : dvErrText(err);
  if (/resource not found for the segment|not found in the metadatacache/i.test(m)) return 'table';
  if (/could not find a property|property .{0,80}(does not exist|not found)|undeclared property|not a valid (attribute|property|column)|invalid (column|attribute|property)|(attribute|column) .{0,60}(does not exist|not found)|0x80040203|0x80060888|(does not|doesn'?t) contain (an? )?(attribute|column|property)/i.test(m)) return 'column';
  if (/with ids? ?=.{0,80}(does not|do not) exist/i.test(m)) return 'gone';
  if (/(entity|table) .{0,120}(does not exist|not found)|could not find (an? )?(entity|table)|could not find table with name|(unable to|could not) (find|retrieve|load) (the )?(entity )?metadata|not a valid (entity|table)|unknown (table|entity)|\b404\b|0x80040217|0x80060891|0x80094005|doesn'?t exist/i.test(m)) return 'table';
  if (/\b40[13]\b|forbidden|privilege|prv(read|create|write|append|delete)|access (is )?denied|not authori[sz]ed|unauthori[sz]ed|permission|does not have \w*access right|SecLib::AccessCheckEx|0x80040220|0x80040277|-2147187962/i.test(m)) return 'denied';
  if (/timed out|timeout expired|sql timeout|0x80044151|failed to fetch|network|offline|\b(429|5\d\d)\b|unavailable|too many requests|number of requests exceeded|0x8007232[126]|try again later|server busy|gateway time-?out|bad gateway/i.test(m)) return 'network';
  return 'other';
}

// A refusal that names a privilege proves the table is there; a bare 401/403 (sign-in) proves nothing.
function dvNamesPrivilege(m) {
  return /prv(read|create|write|append|delete)|privilege|SecLib::AccessCheckEx|0x80040220|0x80040277|-2147187962|principal user/i.test(String(m || ''));
}

function dvTimeout(make, label, ms) {
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error(label + ' timed out')), ms || DV_TIMEOUT_MS);
    let p;
    try { p = typeof make === 'function' ? make() : make; } catch (e) { clearTimeout(t); reject(e); return; }
    Promise.resolve(p).then(v => { clearTimeout(t); resolve(v); }, e => { clearTimeout(t); reject(e); });
  });
}

// "_craa5_area_lookup_value" (how rows show a lookup) and "craa5_area_lookup" (its metadata name) are the same column.
function dvColKey(c) {
  const s = String(c || '').toLowerCase();
  const m = s.match(/^_(.+)_value$/);
  return m ? m[1] : s;
}
function dvIsLookupCol(c) { return /^_.+_value$/i.test(String(c || '')); }

function dvFrames() {
  const out = [];
  try { if (typeof window !== 'undefined') out.push(window); } catch (e) {}
  try { if (typeof window !== 'undefined' && window.parent && window.parent !== window) out.push(window.parent); } catch (e) {}
  try { if (typeof window !== 'undefined' && window.top && window.top !== window) out.push(window.top); } catch (e) {}
  return out;
}

function dvFindXrm() {
  const fr = dvFrames();
  for (let i = 0; i < fr.length; i++) {
    try { if (fr[i] && fr[i].Xrm) return fr[i].Xrm; } catch (e) {}
  }
  return null;
}

// Every way this page can reach Dataverse. Found once per page, not on every render.
function dvConnect(props) {
  const conn = { web: null, dataApi: null, clientUrl: '', xrm: null, routes: [] };
  try {
    if (props && props.webApi && typeof props.webApi.retrieveMultipleRecords === 'function') conn.web = props.webApi;
    else if (props && props.context && props.context.webAPI && typeof props.context.webAPI.retrieveMultipleRecords === 'function') conn.web = props.context.webAPI;
  } catch (e) {}
  const xrm = dvFindXrm();
  conn.xrm = xrm;
  try { if (!conn.web && xrm && xrm.WebApi && typeof xrm.WebApi.retrieveMultipleRecords === 'function') conn.web = xrm.WebApi; } catch (e) {}
  try { if (props && props.dataApi && typeof props.dataApi.queryTable === 'function') conn.dataApi = props.dataApi; } catch (e) {}
  try {
    if (xrm && xrm.Utility && typeof xrm.Utility.getGlobalContext === 'function') {
      const ctx = xrm.Utility.getGlobalContext();
      if (ctx && typeof ctx.getClientUrl === 'function') conn.clientUrl = String(ctx.getClientUrl() || '').replace(/\/+$/, '');
    }
  } catch (e) {}
  try {
    if (!conn.clientUrl && typeof window !== 'undefined' && window.location && /\.crm[0-9]*\.dynamics\.com$/i.test(window.location.hostname)) {
      conn.clientUrl = window.location.origin.replace(/\/+$/, '');
    }
  } catch (e) {}
  if (conn.web) conn.routes.push('Xrm.WebApi');
  if (conn.clientUrl) conn.routes.push('Web API');
  if (conn.dataApi) conn.routes.push('dataApi');
  return conn;
}

// Who is signed in. Never invents an ID: unknown stays unknown.
function dvReadUser(conn, props) {
  try {
    const xrm = conn && conn.xrm;
    if (xrm && xrm.Utility && typeof xrm.Utility.getGlobalContext === 'function') {
      const us = xrm.Utility.getGlobalContext().userSettings;
      if (us && (us.userName || us.userId)) {
        return { userName: String(us.userName || '').trim(), userId: String(us.userId || '').replace(/[{}]/g, ''), source: 'Dataverse' };
      }
    }
  } catch (e) {}
  try {
    const us = props && props.context && props.context.userSettings;
    if (us && (us.userName || us.userId)) {
      return { userName: String(us.userName || '').trim(), userId: String(us.userId || '').replace(/[{}]/g, ''), source: 'Dataverse' };
    }
  } catch (e) {}
  return { userName: '', userId: '', source: 'unknown' };
}

async function dvFetchJson(conn, path) {
  if (!conn || !conn.clientUrl || typeof fetch !== 'function') return { ok: false, status: 0, json: null, err: 'No Web API address on this page.' };
  try {
    const resp = await dvTimeout(() => fetch(conn.clientUrl + '/api/data/v9.2/' + path, {
      headers: { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0', 'Prefer': 'odata.include-annotations="*"' },
      credentials: 'same-origin'
    }), 'Web API');
    if (resp.ok) {
      const json = await resp.json();
      return { ok: true, status: resp.status, json, err: '' };
    }
    let txt = '';
    try { txt = await resp.text(); } catch (e) {}
    let msg = txt;
    try { const j = JSON.parse(txt); if (j && j.error && j.error.message) msg = j.error.message; } catch (e) {}
    return { ok: false, status: resp.status, json: null, err: 'HTTP ' + resp.status + ': ' + dvErrText(msg) };
  } catch (e) {
    return { ok: false, status: 0, json: null, err: dvErrText(e) };
  }
}

// The table's definition. state: 'found' | 'missing' | 'unknown'. cols: Set of column logical names, or null when columns could not be read.
async function dvReadMeta(conn, logical, wantCols) {
  const out = { state: 'unknown', meta: null, cols: null, colSource: '', err: '' };
  if (conn.clientUrl) {
    const r = await dvFetchJson(conn, "EntityDefinitions(LogicalName='" + logical + "')?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute,OwnershipType,ObjectTypeCode&$expand=Attributes($select=LogicalName,AttributeType)");
    if (r.ok && r.json) {
      out.state = 'found';
      out.meta = {
        EntitySetName: r.json.EntitySetName || '',
        PrimaryIdAttribute: r.json.PrimaryIdAttribute || '',
        PrimaryNameAttribute: r.json.PrimaryNameAttribute || '',
        OwnershipType: r.json.OwnershipType || '',
        ObjectTypeCode: r.json.ObjectTypeCode || null
      };
      if (Array.isArray(r.json.Attributes) && r.json.Attributes.length > 0) {
        out.cols = new Set(r.json.Attributes.map(a => String(a && a.LogicalName || '').toLowerCase()).filter(Boolean));
        out.colSource = 'metadata';
        out.types = dvAttrTypes(r.json.Attributes);
      }
      return out;
    }
    out.err = r.err;
    if (r.status === 404 || dvClassify(r.err) === 'table') { out.state = 'missing'; return out; }
  }
  // Second way: the model-driven app's own metadata call. Only the columns asked for come back.
  const xrm = conn.xrm;
  if (xrm && xrm.Utility && typeof xrm.Utility.getEntityMetadata === 'function') {
    try {
      const asked = (wantCols || []).map(dvColKey);
      const md = await dvTimeout(() => xrm.Utility.getEntityMetadata(logical, asked), 'Xrm metadata');
      if (md) {
        out.state = 'found';
        out.meta = {
          EntitySetName: md.EntitySetName || '',
          PrimaryIdAttribute: md.PrimaryIdAttribute || '',
          PrimaryNameAttribute: md.PrimaryNameAttribute || '',
          OwnershipType: md.OwnershipType || '',
          ObjectTypeCode: md.ObjectTypeCode || null
        };
        const names = dvAttrNames(md.Attributes);
        out.types = dvAttrTypes(md.Attributes);
        // An empty answer to a non-empty ask is more likely a client quirk than a table with none of its columns: leave columns unchecked.
        if (names && !(names.length === 0 && asked.length > 0)) {
          out.cols = new Set(names);
          out.colSource = 'metadata';
          out.colsAskedOnly = true;
        }
        out.err = '';
        return out;
      }
    } catch (e) {
      const m = dvErrText(e);
      if (!out.err) out.err = m;
      if (dvClassify(m) === 'table') { out.state = 'missing'; out.err = m; }
    }
  }
  return out;
}

// Xrm metadata hands back its Attributes in different shapes depending on the client.
function dvAttrNames(attrs) {
  try {
    if (!attrs) return null;
    let list = null;
    if (typeof attrs.getAll === 'function') list = attrs.getAll();
    else if (Array.isArray(attrs)) list = attrs;
    else if (attrs._collection && typeof attrs._collection === 'object') list = Object.keys(attrs._collection).map(k => attrs._collection[k]);
    if (!Array.isArray(list)) return null;
    return list.map(a => String((a && (a.LogicalName || a.logicalName)) || '').toLowerCase()).filter(Boolean);
  } catch (e) { return null; }
}

// Column types by name ('Boolean', 'Integer', 'Decimal', 'String', ...). Xrm gives a number, the Web API a word.
const ATTR_TYPE_CODES = { 0: 'Boolean', 1: 'Customer', 2: 'DateTime', 3: 'Decimal', 4: 'Double', 5: 'Integer', 6: 'Lookup', 7: 'Memo', 8: 'Money', 9: 'Owner', 10: 'PartyList', 11: 'Picklist', 12: 'State', 13: 'Status', 14: 'String', 15: 'Uniqueidentifier', 18: 'BigInt' };
function dvAttrTypes(attrs) {
  const out = {};
  try {
    let list = null;
    if (!attrs) return out;
    if (typeof attrs.getAll === 'function') list = attrs.getAll();
    else if (Array.isArray(attrs)) list = attrs;
    else if (attrs._collection && typeof attrs._collection === 'object') list = Object.keys(attrs._collection).map(k => attrs._collection[k]);
    (list || []).forEach(a => {
      const n = String((a && (a.LogicalName || a.logicalName)) || '').toLowerCase();
      const t = a && (a.AttributeType != null ? a.AttributeType : a.attributeType);
      if (n && t != null) out[n] = typeof t === 'number' ? (ATTR_TYPE_CODES[t] || String(t)) : String(t);
    });
  } catch (e) {}
  return out;
}

// How many rows the table holds (active and inactive). Tries each route; the most useful refusal wins.
async function dvCountRows(conn, logical, idCol, entitySet) {
  const tries = [];
  if (conn.web) {
    tries.push(async () => {
      const xml = "<fetch aggregate='true'><entity name='" + logical + "'><attribute name='" + idCol + "' aggregate='count' alias='n'/></entity></fetch>";
      try {
        const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, '?fetchXml=' + encodeURIComponent(xml)), 'Xrm.WebApi ' + logical);
        const row = res && Array.isArray(res.entities) ? res.entities[0] : null;
        const n = row ? Number(row.n) : NaN;
        if (!isFinite(n)) return { ok: false, err: 'Count answer held no number.' };
        return { ok: true, count: n, capped: false, via: 'Xrm.WebApi' };
      } catch (e) {
        const m = dvErrText(e);
        if (/aggregatequeryrecordlimit|maximum record limit|exceeded/i.test(m)) return { ok: true, count: DV_COUNT_CAP_AGG, capped: true, via: 'Xrm.WebApi' };
        return { ok: false, err: m };
      }
    });
  }
  if (conn.clientUrl && entitySet) {
    tries.push(async () => {
      const r = await dvFetchJson(conn, entitySet + '?$select=' + idCol + '&$count=true&$top=1');
      if (!r.ok) return { ok: false, err: r.err };
      const n = Number(r.json && r.json['@odata.count']);
      if (!isFinite(n)) return { ok: false, err: 'Count answer held no number.' };
      return { ok: true, count: n, capped: n >= DV_COUNT_CAP_FETCH, via: 'Web API' };
    });
  }
  if (conn.dataApi) {
    tries.push(async () => {
      try {
        const page = await dvTimeout(() => conn.dataApi.queryTable(logical, { select: [idCol], pageSize: DV_COUNT_CAP_FETCH }), 'dataApi ' + logical);
        if (!page || !Array.isArray(page.rows)) return { ok: false, err: 'The answer for ' + logical + ' held no list of rows.' };
        const n = page.rows.length;
        const more = !!(page.hasMoreRows || page.hasMore || page.nextLink || page['@odata.nextLink']);
        return { ok: true, count: n, capped: more || n >= DV_COUNT_CAP_FETCH, via: 'dataApi' };
      } catch (e) {
        return { ok: false, err: dvErrText(e) };
      }
    });
  }
  if (tries.length === 0) return { ok: false, err: 'No way to reach Dataverse on this page.', kind: 'none' };
  let best = null;
  const rank = k => ({ denied: 4, network: 3, other: 3, column: 2, table: 1 }[k] || 0);
  for (let i = 0; i < tries.length; i++) {
    const r = await tries[i]();
    if (r.ok) return r;
    r.kind = dvClassify(r.err);
    if (!best || rank(r.kind) > rank(best.kind)) best = r;
  }
  return best;
}

// One row, all columns, only used to see which columns exist when metadata could not be read. The row's values are dropped at once.
async function dvSampleKeys(conn, logical) {
  if (!conn.web) return null;
  try {
    const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, '?$top=1'), 'Xrm.WebApi ' + logical);
    const row = res && Array.isArray(res.entities) ? res.entities[0] : null;
    if (!row) return null;
    return new Set(Object.keys(row).filter(k => k.indexOf('@') === -1).map(dvColKey));
  } catch (e) { return null; }
}

// The whole check for one table. Returns plain data only (no rows).
async function dvAuditTable(conn, spec) {
  const want = (spec.requiredCols || []).concat(spec.optionalCols || []);
  const meta = await dvReadMeta(conn, spec.logicalName, want);
  const idCol = (meta.meta && meta.meta.PrimaryIdAttribute) || spec.primaryId || (spec.logicalName + 'id');
  const entitySet = (meta.meta && meta.meta.EntitySetName) || spec.entitySetName || '';
  const cnt = meta.state === 'missing' ? null : await dvCountRows(conn, spec.logicalName, idCol, entitySet);

  const r = {
    logicalName: spec.logicalName,
    entitySetName: entitySet,
    primaryId: idCol,
    primaryName: (meta.meta && meta.meta.PrimaryNameAttribute) || spec.primaryName || '',
    ownership: (meta.meta && meta.meta.OwnershipType) || '',
    state: 'unknown',
    count: null,
    countCapped: false,
    via: '',
    colSource: '',
    cols: {},
    missingRequired: [],
    uncheckedRequired: [],
    missingOptional: [],
    error: ''
  };

  // Table state
  if (meta.state === 'missing') {
    r.state = 'missing';
    r.error = meta.err;
  } else if (cnt && cnt.ok) {
    r.state = 'found';
    r.count = cnt.count;
    r.countCapped = !!cnt.capped;
    r.via = cnt.via;
  } else {
    const k = cnt ? cnt.kind : 'other';
    const m = cnt ? cnt.err : '';
    r.error = m || meta.err;
    if (k === 'denied' && (meta.state === 'found' || dvNamesPrivilege(m))) r.state = 'denied';
    else if (k === 'table' && meta.state !== 'found') r.state = 'missing';
    else if ((k === 'column' || k === 'table') && meta.state === 'found') { r.state = 'found'; r.countUnknown = true; }
    else r.state = 'unknown';
  }

  // Column state: only metadata (or a real row) can say a column is there
  let colSet = meta.cols;
  let fromRow = false;
  if (!colSet && r.state === 'found' && r.count > 0) {
    colSet = await dvSampleKeys(conn, spec.logicalName);
    fromRow = !!colSet;
  }
  // The table's real primary name column counts as the expected one, whatever it is called (Gerald keeps the names Dataverse gave).
  const realPrimary = meta.meta && meta.meta.PrimaryNameAttribute ? String(meta.meta.PrimaryNameAttribute).toLowerCase() : '';
  if (colSet && realPrimary && spec.primaryName && dvColKey(spec.primaryName) !== realPrimary && colSet.has(realPrimary)) {
    colSet = new Set(colSet);
    colSet.add(dvColKey(spec.primaryName));
    r.primaryNameAlias = realPrimary;
  }
  r.colSource = colSet ? (fromRow ? 'row' : 'metadata') : '';
  // Names only (no values): the table's own columns, for the filled-value count.
  r.allCols = meta.cols && !meta.colsAskedOnly ? Array.from(meta.cols).filter(c => c.indexOf('craa5_') === 0).sort() : [];
  want.forEach(c => {
    const key = dvColKey(c);
    let st = 'unchecked';
    if (colSet && r.state !== 'missing') {
      if (colSet.has(key)) st = 'present';
      else if (!fromRow) st = 'missing';   // one row can leave a column out, so only metadata says missing
    }
    r.cols[c] = st;
  });
  // For a missing column, name the table's columns that end the same way (craa5__c_chemicalname missing, craa5_chemicalname there).
  r.similar = {};
  (spec.requiredCols || []).forEach(c => {
    if (r.cols[c] !== 'missing' || !colSet) return;
    const stem = dvColKey(c).split('_').filter(Boolean).pop() || '';
    if (stem.length < 4) return;
    const near = Array.from(colSet).filter(x => x !== dvColKey(c) && x.indexOf(stem) !== -1 && x.indexOf('@') === -1).slice(0, 5);
    if (near.length) r.similar[c] = near;
  });
  (spec.requiredCols || []).forEach(c => {
    if (r.cols[c] === 'missing') r.missingRequired.push(c);
    else if (r.cols[c] === 'unchecked') r.uncheckedRequired.push(c);
  });
  (spec.optionalCols || []).forEach(c => { if (r.cols[c] === 'missing') r.missingOptional.push(c); });
  return r;
}

// Tries each name the contract lists for a table, in order (Gerald's prefixed name first, plain name after).
// A name that is there wins; a name that could not be told does not stop the later ones.
async function dvAuditCandidates(conn, spec) {
  const names = (spec.candidates && spec.candidates.length) ? spec.candidates : [spec.logicalName];
  const tried = [];
  let firstUnsure = null;
  let last = null;
  for (let i = 0; i < names.length; i++) {
    const name = names[i];
    const same = name === spec.logicalName;
    const r = await dvAuditTable(conn, { ...spec, logicalName: name, primaryId: same ? spec.primaryId : name + 'id', entitySetName: same ? spec.entitySetName : '' });
    r.resolvedName = name;
    r.triedNames = tried.slice();
    if (r.state === 'found' || r.state === 'denied') return r;
    if (r.state === 'unknown' && !firstUnsure) firstUnsure = r;
    tried.push(name + ': ' + r.state);
    last = r;
  }
  const out = firstUnsure || last;
  out.triedNames = tried;
  if (!firstUnsure) out.resolvedName = '';
  return out;
}

// The one word each table gets. Green only for a table that was read AND whose required columns were all seen.
// spec.status from the contract: a missing 'abandoned' or 'proposed' table is expected, not a problem.
function dvVerdict(r, spec) {
  if (!r) return { code: 'notscanned', tone: 'gray' };
  const status = spec && spec.status;
  if (status === 'abandoned') {
    if (r.state === 'missing') return { code: 'gone', tone: 'gray' };
    if (r.state === 'found') return { code: 'abandonedthere', tone: 'gray', n: r.count, capped: r.countCapped };
  }
  if (status === 'proposed' && r.state === 'missing') return { code: 'notmade', tone: 'gray' };
  if (status === 'absent' && r.state === 'missing') return { code: 'absent', tone: 'gray' };
  if (r.state === 'missing') return { code: 'missing', tone: 'red' };
  if (r.state === 'denied') return { code: 'denied', tone: 'purple' };
  if (r.state !== 'found') return { code: 'unknown', tone: 'gray' };
  if (r.missingRequired.length > 0) return { code: 'missingcols', tone: 'amber', n: r.missingRequired.length };
  if (r.uncheckedRequired.length > 0) return { code: 'colsunchecked', tone: 'amber' };
  if (r.countUnknown) return { code: 'foundnocount', tone: 'amber' };
  if (r.count === 0) return { code: 'empty', tone: 'teal' };
  return { code: 'ok', tone: 'green', n: r.count, capped: r.countCapped };
}

// Every craa5 table in the environment (needs the Web API address). null = could not list.
async function dvListCustomTables(conn) {
  if (!conn.clientUrl) return null;
  const r = await dvFetchJson(conn, 'EntityDefinitions?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute,OwnershipType');
  if (!r.ok || !r.json || !Array.isArray(r.json.value)) return null;
  return r.json.value
    .filter(d => d && d.LogicalName && d.LogicalName.indexOf('craa5_') === 0)
    .map(d => ({ logicalName: d.LogicalName, entitySetName: d.EntitySetName || '', primaryId: d.PrimaryIdAttribute || '', primaryName: d.PrimaryNameAttribute || '', ownership: d.OwnershipType || '' }))
    .sort((a, b) => a.logicalName.localeCompare(b.logicalName));
}

// Runs the checks a few at a time so a big list does not flood the server.
async function dvRunPool(items, worker, size, onEach) {
  const out = new Array(items.length);
  let next = 0;
  const lanes = [];
  for (let l = 0; l < Math.min(size, items.length); l++) {
    lanes.push((async () => {
      while (next < items.length) {
        const i = next++;
        try { out[i] = await worker(items[i], i); } catch (e) { out[i] = null; }
        if (onEach) onEach(i, out[i]);
      }
    })());
  }
  await Promise.all(lanes);
  return out;
}

// The display name to type so Dataverse makes exactly this logical name (craa5_ + display name in lower case, no spaces).
function colDisplay(logical) { return String(logical || '').replace(/^craa5_/, ''); }
// A first guess at a column's type from its name. The maker can change it; text is the safe default.
function colTypeGuess(logical) {
  const n = String(logical || '').toLowerCase();
  if (/(date|on|at|start|end)$/.test(n) && !/(location|reason|section|option|button)$/.test(n)) return 'date and time';
  if (/(minutes|minuteslost|count|qty|quantity|number|total|heads|hour|hours)$/.test(n) && !/(itemnumber|vendornumber|badgenumber|ordernumber)$/.test(n)) return 'whole number';
  if (/(price|cost|amount|rate)$/.test(n)) return 'currency';
  if (/^(craa5_)?(is|has)|active|complete|done$/.test(n)) return 'yes/no';
  return 'text';
}

// How many rows have a value in one column (a count only; no values are read).
async function dvCountFilled(conn, logical, idCol, entitySet, col) {
  if (conn.web) {
    const xml = "<fetch aggregate='true'><entity name='" + logical + "'><attribute name='" + idCol + "' aggregate='count' alias='n'/><filter><condition attribute='" + col + "' operator='not-null'/></filter></entity></fetch>";
    try {
      const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, '?fetchXml=' + encodeURIComponent(xml)), 'Xrm.WebApi ' + logical);
      const n = res && res.entities && res.entities[0] ? Number(res.entities[0].n) : NaN;
      if (isFinite(n)) return { ok: true, count: n };
    } catch (e) {
      const m = dvErrText(e);
      if (/aggregatequeryrecordlimit/i.test(m)) return { ok: true, count: DV_COUNT_CAP_AGG, capped: true };
      if (!conn.clientUrl || !entitySet) return { ok: false, err: m };
    }
  }
  if (conn.clientUrl && entitySet) {
    const r = await dvFetchJson(conn, entitySet + '?$select=' + idCol + '&$filter=' + col + ' ne null&$count=true&$top=1');
    if (r.ok) {
      const n = Number(r.json && r.json['@odata.count']);
      if (isFinite(n)) return { ok: true, count: n, capped: n >= DV_COUNT_CAP_FETCH };
    }
    return { ok: false, err: r.err };
  }
  return { ok: false, err: 'No way to count on this page.' };
}

// ============================================================================
// APP MANIFESTS (v2.2). Each app saves one row in Hub config:
//   craa5_configkey = 'manifest|<appId>', craa5_configjson = {"m":1,"app","appId","version","savedAt",
//   "tables":[{"t":logical,"names":[candidates],"read":[cols],"write":[cols]}]}
// The monitor only reads these rows. Logical names only; no data.
// ============================================================================
const HUBCONFIG_NAMES = ['craa5__e_hubconfig', 'craa5__0_hubconfig'];   // the new shared table first, the old one second
const MANIFEST_PREFIX = 'manifest|';
// The contract's fixed app ids and the writer names the contract uses for them.
const APP_WRITER_NAMES = {
  ganttly: 'Ganttly', shiftstart: 'Shift Start', prodsched: 'Production Scheduler', msscalendar: 'MSS Calendar', msslog: 'MSS Log Input',
  pbed: 'PBED', bolo: 'Pathogen BOLO', managerhub: 'Manager hub', chemicals: 'Chemical hub', mapsubmit: 'Map submission tool',
  monitor: 'Dataverse monitor', training: 'Training matrix'
};
function appIdOf(name) { return String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, ''); }

// Turns one saved row into a checked-shape manifest, or an error saying what is wrong with it.
function dvParseManifest(row) {
  const key = String(row && row.craa5_configkey || '');
  const out = { key, source: '', fromScan: key.indexOf('scan|') === 0, appId: key.slice(key.indexOf('|') + 1), app: String(row && row.craa5_configname || '').replace(/ manifest$/i, ''), version: '', savedAt: '', contract: '', hash: '', config: [], tables: [], error: '', modifiedOn: row && row.modifiedon ? String(row.modifiedon) : '' };
  // The full list lives in Manifest json when the table has that column; Config json then holds only a pointer.
  const mText = row && row.craa5_manifestjson != null ? String(row.craa5_manifestjson) : '';
  out.source = mText.trim() ? 'craa5_manifestjson' : 'craa5_configjson';
  let j = null;
  try { j = JSON.parse(mText.trim() ? mText : String(row && row.craa5_configjson || '')); } catch (e) { out.error = 'not valid JSON in ' + out.source + ' (' + dvErrText(e).slice(0, 80) + ')'; return out; }
  if (j && typeof j === 'object' && !Array.isArray(j.tables) && j.in && out.source === 'craa5_configjson') {
    // A pointer alone: the app saved its list to a column that is empty or not readable here. Not a broken manifest.
    out.stub = true; out.pointer = String(j.in);
    out.version = String(j.version || ''); out.savedAt = String(j.savedAt || ''); out.hash = String(j.hash || '');
    if (j.appId) out.appId = String(j.appId);
    out.app = String(j.app || out.app || out.appId);
    return out;
  }
  if (!j || typeof j !== 'object' || !Array.isArray(j.tables)) { out.error = 'no "tables" list'; return out; }
  out.app = String(j.app || out.app || out.appId);
  out.version = String(j.version || '');
  out.savedAt = String(j.savedAt || '');
  out.contract = String(j.contract || '');
  out.hash = String(j.hash || '');
  if (j.appId) out.appId = String(j.appId);
  const clean = list => (Array.isArray(list) ? list : []).map(x => String(x || '').trim().toLowerCase()).filter(x => /^[a-z0-9_]+$/.test(x));
  j.tables.forEach(t => {
    if (!t || typeof t !== 'object') return;
    const logical = String(t.t || '').trim().toLowerCase();
    if (!/^[a-z0-9_]+$/.test(logical)) return;
    const names = clean(t.names);
    const row = { t: logical, names: names.length ? names : [logical], read: clean(t.read), write: clean(t.write), opt: clean(t.opt) };
    // Manifest v2 (HUB SHARED v1.2): column types and what a new table should look like. The builder reads these.
    if (t.cols && typeof t.cols === 'object') {
      row.cols = {};
      Object.keys(t.cols).forEach(c => { const k = String(c).trim().toLowerCase(); const v = t.cols[c]; if (/^[a-z0-9_]+$/.test(k) && v && typeof v === 'object' && typeof v.type === 'string') row.cols[k] = v; });
    }
    if (t.label) row.label = String(t.label);
    if (t['new'] === true) row['new'] = true;
    if (t.owner === 'org' || t.owner === 'user') row.owner = t.owner;
    if (t.primary && t.primary.n) row.primary = { n: String(t.primary.n).toLowerCase(), len: t.primary.len, label: t.primary.label };
    out.tables.push(row);
  });
  out.config = (Array.isArray(j.config) ? j.config : []).map(x => String(x || '')).filter(Boolean);
  return out;
}

// Reads Hub config rows (only the manifest rows when prefix is given). Resolves { state: 'ok'|'missing'|'denied'|'unknown', table, rows, err }.
function dvReadManifestRows(conn) { return dvReadHubConfigRows(conn, MANIFEST_PREFIX); }
// Tries each Hub config table in order (new first). On each, asks for Manifest json too and drops it if that table has no such column.
async function dvReadHubConfigRows(conn, prefix, tables) {
  const names = tables || HUBCONFIG_NAMES;
  const base = ['craa5_configkey', 'craa5_configname', 'craa5_configjson', 'modifiedon'];
  let last = null;
  const notes = [];
  for (let i = 0; i < names.length; i++) {
    const first = await dvReadHubConfigRowsWith(conn, prefix, base.concat(['craa5_manifestjson']), [names[i]]);
    if (first.state === 'ok') return Object.assign(first, { manifestCol: true, notes });
    let res = first;
    if (first.kind === 'column') {
      res = await dvReadHubConfigRowsWith(conn, prefix, base, [names[i]]);
      if (res.state === 'ok') return Object.assign(res, { manifestCol: false, notes });
    }
    if (res.state !== 'missing') notes.push(names[i] + ': ' + res.state + (res.err ? ' (' + res.err + ')' : ''));
    last = res;
  }
  return Object.assign(last || { state: 'unknown', rows: [], err: '' }, { manifestCol: null, notes });
}
async function dvReadHubConfigRowsWith(conn, prefix, select, tables) {
  let lastErr = '';
  let lastKind = '';
  for (let i = 0; i < tables.length; i++) {
    const t = tables[i];
    if (conn.web) {
      try {
        const q = '?$select=' + select.join(',') + (prefix ? "&$filter=startswith(craa5_configkey,'" + prefix + "')" : '') + '&$top=500';
        const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(t, q), 'Xrm.WebApi ' + t);
        return { state: 'ok', table: t, rows: (res && res.entities) || [] };
      } catch (e) { lastErr = dvErrText(e); lastKind = dvClassify(lastErr); }
    }
    if (conn.dataApi) {
      try {
        const page = await dvTimeout(() => conn.dataApi.queryTable(t, prefix ? { select, filter: "startswith(craa5_configkey,'" + prefix + "')", pageSize: 500 } : { select, pageSize: 500 }), 'dataApi ' + t);
        if (page && Array.isArray(page.rows)) return { state: 'ok', table: t, rows: page.rows };
      } catch (e) { const m = dvErrText(e); if (!lastErr || dvClassify(m) === 'denied') { lastErr = m; lastKind = dvClassify(m); } }
    }
  }
  if (!conn.web && !conn.dataApi) return { state: 'unknown', rows: [], err: 'No way to read Hub config on this page.' };
  return { state: lastKind === 'table' ? 'missing' : (lastKind === 'denied' ? 'denied' : 'unknown'), kind: lastKind, rows: [], err: lastErr };
}

// Checks one manifest against Dataverse metadata. metaCache is shared across manifests so a table is asked about once.
async function dvCheckManifest(conn, man, metaCache, contractTables) {
  const tables = [];
  for (let i = 0; i < man.tables.length; i++) {
    const mt = man.tables[i];
    const cols = Array.from(new Set(mt.read.concat(mt.write, mt.opt || [])));
    let found = null;
    let lastState = 'unknown';
    for (let k = 0; k < mt.names.length && !found; k++) {
      const name = mt.names[k];
      const ck = name + '|' + cols.join(',');
      if (!metaCache[ck]) metaCache[ck] = dvReadMeta(conn, name, cols);
      const meta = await metaCache[ck];
      lastState = meta.state;
      if (meta.state === 'found') found = { name, meta };
      else if (meta.state === 'unknown') break;   // no clear answer: do not guess the next name
    }
    const row = { t: mt.t, foundAs: found ? found.name : '', state: found ? 'found' : lastState, missingRead: [], missingWrite: [], notYet: [], unchecked: [], contractNotes: [] };
    if (found) {
      const set = found.meta.cols;
      const realPrimary = found.meta.meta && found.meta.meta.PrimaryNameAttribute ? String(found.meta.meta.PrimaryNameAttribute).toLowerCase() : '';
      cols.forEach(c => {
        const key = dvColKey(c);
        if (!set) { row.unchecked.push(c); return; }
        if (set.has(key) || key === realPrimary) return;
        // "opt" wins when a column is listed in read or write too: the app drops it from its saves when it is not there.
        if ((mt.opt || []).indexOf(c) !== -1) row.notYet.push(c);
        else if (mt.write.indexOf(c) !== -1) row.missingWrite.push(c);
        else if (mt.read.indexOf(c) !== -1) row.missingRead.push(c);
        else row.notYet.push(c);   // an "opt" column: the app works without it
      });
    }
    tables.push(row);
  }
  // Against the contract: tables it does not know, abandoned or absent tables, and writes by an app the contract does not list as a writer.
  if (contractTables) {
    tables.forEach((row, i) => {
      const mt = man.tables[i];
      const spec = contractTables.find(s => s.logicalName === mt.t || (s.candidates || []).indexOf(mt.t) !== -1 || mt.names.indexOf(s.logicalName) !== -1);
      if (!spec) { row.contractNotes.push('notincontract'); return; }
      if (spec.status === 'abandoned' || spec.status === 'absent') row.contractNotes.push('status:' + spec.status);
      const me = APP_WRITER_NAMES[man.appId];
      // A column listed under columnOwners for this app may be written by it even when it is not a table writer.
      const ownCols = (spec.columnOwners || []).filter(o => appIdOf(o.writer) === appIdOf(me)).reduce((a, o) => a.concat(o.columns || []), []);
      const notAllowed = mt.write.filter(c => ownCols.indexOf(c) === -1);
      if (notAllowed.length && me && (spec.writers || []).map(appIdOf).indexOf(appIdOf(me)) === -1) { row.contractNotes.push('notwriter'); row.notAllowed = notAllowed; }
    });
  }
  const problems = tables.filter(t => t.state !== 'found' || t.missingRead.length || t.missingWrite.length || t.contractNotes.length).length;
  const unsure = tables.filter(t => t.state === 'unknown' || t.unchecked.length).length;
  return { tables, problems, unsure };
}

// The Hub config keys the contract lists (contract.json configKeys), matched exactly, case included.
// status: planned (contract key, may not exist yet), inuse (an older key apps write today), legacy (unused).
const HUB_CONFIG_KEYS = CONTRACT_CONFIG_KEYS;

// Checks every Hub config row the way the tables are checked: is it what the contract expects, and is it healthy.
// Looks at keys, text length and whether the text is valid JSON. Never keeps or shows the values.
function dvCheckHubConfig(rows, maxLen, apps, mMaxLen) {
  const keyCount = {};
  const list = (rows || []).map(r => {
    const rawKey = String(r && r.craa5_configkey || '').trim();
    const nameKey = String(r && r.craa5_configname || '').trim();
    // Readers match Config key first and Config name second (old rows with a blank key).
    const key = rawKey || (HUB_CONFIG_KEYS.some(k => k.key === nameKey) ? nameKey : '');
    const text = r && r.craa5_configjson != null ? String(r.craa5_configjson) : '';
    if (key) keyCount[key] = (keyCount[key] || 0) + 1;
    let json = 'empty';
    let jsonAppId = '';
    if (text.trim()) {
      try { const j = JSON.parse(text); json = 'ok'; if (j && typeof j === 'object' && j.appId) jsonAppId = String(j.appId); } catch (e) { json = 'bad'; }
    }
    const mText = r && r.craa5_manifestjson != null ? String(r.craa5_manifestjson) : '';
    let mjson = 'empty';
    if (mText.trim()) { try { JSON.parse(mText); mjson = 'ok'; } catch (e) { mjson = 'bad'; } }
    let stub = false;
    if (json === 'ok') { try { const j = JSON.parse(text); stub = !!(j && typeof j === 'object' && j.in && !Array.isArray(j.tables)); } catch (e) { stub = false; } }
    const isManifest = key.indexOf(MANIFEST_PREFIX) === 0;
    const isScan = key.indexOf('scan|') === 0;
    const setting = HUB_CONFIG_KEYS.find(k => k.key === key);
    const appId = isManifest || isScan ? key.slice(key.indexOf('|') + 1) : (setting ? setting.app : '');
    return { key, keyInName: !rawKey && !!key, name: nameKey, len: text.length, json, jsonAppId, kind: isManifest ? 'manifest' : isScan ? 'scan' : (setting ? (setting.status === 'legacy' ? 'legacy' : 'setting') : 'unlisted'), appId, mLen: mText.length, mjson, stub, modifiedOn: r && r.modifiedon ? String(r.modifiedon) : '', issues: [], warnings: setting && setting.otherWriters && setting.otherWriters.length ? ['twowriters'] : [] };
  });
  list.forEach(x => {
    if (!x.key) x.issues.push('blankkey');
    else if (keyCount[x.key] > 1) x.issues.push('dupkey');
    if (x.keyInName) x.warnings.push('keyinname');
    if (x.json === 'bad') x.issues.push(maxLen && x.len >= maxLen ? 'cutoff' : 'badjson');
    if (x.json === 'empty' && x.mjson === 'empty' && x.key) x.warnings.push('emptyjson');   // waiting for the app to save
    if (x.json === 'empty' && x.mjson === 'empty' && !x.key) x.issues.push('emptyjson');
    if (maxLen && x.json !== 'bad' && x.len >= maxLen * 0.9) x.issues.push('nearlimit');
    if (x.kind === 'manifest' && CONTRACT_APP_IDS.indexOf(x.appId) === -1) x.issues.push('unknownapp');
    if (x.mjson === 'bad') x.issues.push(mMaxLen && x.mLen >= mMaxLen ? 'mcutoff' : 'mbadjson');
    if (mMaxLen && x.mjson === 'ok' && x.mLen >= mMaxLen * 0.9) x.issues.push('mnearlimit');
    if (x.stub && x.mjson === 'empty') x.warnings.push('pointeronly');
    if (x.kind === 'manifest' && x.jsonAppId && x.jsonAppId !== x.appId) x.issues.push('appmismatch');
  });
  const have = new Set(list.map(x => x.key));
  // Legacy keys are not needed: listed only when the row is still there.
  const expected = HUB_CONFIG_KEYS.filter(k => k.status !== 'legacy' || have.has(k.key)).map(k => ({ key: k.key, app: k.app, otherWriters: k.otherWriters || [], status: k.status || 'planned', note: k.note || '', kind: 'setting' }))
    .concat(CONTRACT_APP_IDS.map(a => ({ key: MANIFEST_PREFIX + a, app: a, otherWriters: [], status: 'manifest', kind: 'manifest' })))
    .map(e => { const row = list.find(x => x.key === e.key); return Object.assign(e, { state: !have.has(e.key) ? 'notyet' : (row.issues.length ? 'problem' : (row.warnings.length ? 'warn' : 'saved')) }); });
  // Keys a manifest says the app writes: must be on the contract's list and belong to that app.
  const claims = [];
  (apps || []).forEach(a => (a.config || []).forEach(k => {
    // Case-insensitive: manifests saved before hubManifest kept case may hold lower-cased keys. Row keys stay exact.
    const owner = HUB_CONFIG_KEYS.find(x => x.key.toLowerCase() === String(k).toLowerCase());
    if (k.indexOf(MANIFEST_PREFIX) === 0) return;
    if (!owner) claims.push({ appId: a.appId, key: k, issue: 'notincontract' });
    else if (owner.app !== a.appId && (owner.otherWriters || []).indexOf(a.appId) === -1) claims.push({ appId: a.appId, key: k, issue: 'otherapp', owner: owner.app });
  }));
  const problems = list.filter(x => x.issues.length).length + claims.length;
  const warnings = list.filter(x => x.warnings.length && !x.issues.length).length;
  return { rows: list, expected, claims, unlisted: list.filter(x => x.kind === 'unlisted' && x.key).map(x => x.key), problems, warnings };
}

// How long the config text column may be (so a manifest is known to fit). null = could not tell.
async function dvConfigJsonMaxLength(conn, hubTable, column) {
  if (!conn.clientUrl) return null;
  const base = "EntityDefinitions(LogicalName='" + hubTable + "')/Attributes(LogicalName='" + (column || 'craa5_configjson') + "')/";
  const kinds = ['Microsoft.Dynamics.CRM.MemoAttributeMetadata', 'Microsoft.Dynamics.CRM.StringAttributeMetadata'];
  for (let i = 0; i < kinds.length; i++) {
    const r = await dvFetchJson(conn, base + kinds[i] + '?$select=MaxLength');
    if (r.ok && r.json && isFinite(Number(r.json.MaxLength))) return Number(r.json.MaxLength);
  }
  return null;
}

// ---------------------------------------------------------------------------
// App code scanner: finds the craa5 tables and columns an app's code names,
// checks them against Dataverse, and can save the result in Hub config
// (key scan|<appId>) so every later check watches that app. Only names are
// kept, never the code itself.
// ---------------------------------------------------------------------------
const SCAN_PREFIX = 'scan|';
const SCAN_TABLE_CALL = /(retrieveMultipleRecords|retrieveRecord|createRecord|updateRecord|deleteRecord|queryTable|getEntityMetadata|LogicalName=)\W{0,6}$/;

// known: { tables: Set of logical names, sets: { entitySetName: logical } }
function dvScanCode(code, known) {
  const text = String(code || '');
  const tokens = [];
  const re = /(_?)(craa5_[a-z0-9_]*[a-z0-9])/gi;
  let m;
  while ((m = re.exec(text)) !== null) {
    let name = m[2].toLowerCase();
    let lookup = false;
    if (m[1] === '_' && /_value$/.test(name)) { name = name.replace(/_value$/, ''); lookup = true; }
    if (name.replace(/^craa5_+/, '').replace(/_/g, '').length < 3) continue;   // prefix pieces like craa5__c
    const before = text.slice(Math.max(0, m.index - 40), m.index);
    tokens.push({ name, pos: m.index, lookup, call: SCAN_TABLE_CALL.test(before) });
  }
  const isTable = tok => known.tables.has(tok.name) || !!known.sets[tok.name] || (tok.call && !tok.lookup);
  const tablePos = [];
  const tableSet = {};
  tokens.forEach(tok => {
    if (!isTable(tok)) return;
    const t = known.sets[tok.name] || tok.name;
    tableSet[t] = true;
    tablePos.push({ t, pos: tok.pos });
  });
  const colPos = {};
  tokens.forEach(tok => {
    if (isTable(tok) && !tok.lookup) return;
    if (tableSet[tok.name.replace(/id$/, '')] && /id$/.test(tok.name)) return;   // a table's own id column
    (colPos[tok.name] = colPos[tok.name] || []).push(tok.pos);
  });
  return { tables: Object.keys(tableSet).sort(), cols: Object.keys(colPos).sort(), tablePos, colPos };
}

// The table written closest before a column (else closest after): the best guess when no table has the column.
function dvNearestTable(scan, col) {
  let best = null;
  (scan.colPos[col] || []).forEach(p => {
    scan.tablePos.forEach(tp => {
      const d = tp.pos <= p ? p - tp.pos : (tp.pos - p) * 4;   // before counts more than after
      if (!best || d < best.d) best = { t: tp.t, d };
    });
  });
  return best ? best.t : '';
}

// Checks the scanned names in Dataverse. Columns go to the table that has them; the rest to the nearest table (a guess).
async function dvScanCheck(conn, scan) {
  const metas = {};
  await dvRunPool(scan.tables, t => dvReadMeta(conn, t, scan.cols), 4, (i, res) => { metas[scan.tables[i]] = res; });
  const out = scan.tables.map(t => ({ t, state: metas[t] ? metas[t].state : 'unknown', checked: !!(metas[t] && metas[t].cols), have: [], missing: [], err: metas[t] ? metas[t].err || '' : '' }));
  const byName = {};
  out.forEach(r => { byName[r.t] = r; });
  const loose = [];
  scan.cols.forEach(c => {
    const owners = out.filter(r => metas[r.t] && metas[r.t].cols && metas[r.t].cols.has(c));
    if (owners.length) { owners.forEach(r => r.have.push(c)); return; }
    const anyUnchecked = out.some(r => r.state === 'found' && !r.checked);
    const guess = dvNearestTable(scan, c);
    if (guess && byName[guess] && !anyUnchecked) byName[guess].missing.push(c);
    else loose.push(c);
  });
  return { tables: out, loose };
}

// The list saved for a scanned app, in the manifest format, so the manifest checks run on it.
function dvScanManifest(appId, app, result) {
  return {
    m: 1, appId, app, source: 'scan', savedAt: new Date().toISOString(),
    tables: result.tables.map(r => ({ t: r.t, names: [r.t], read: r.have.concat(r.missing).sort(), write: [], opt: [] }))
  };
}

// One create or update through Xrm.WebApi, else the Web API. Resolves { ok, id, err }.
async function dvWriteRow(conn, logical, entitySet, id, body) {
  try {
    if (conn.web && typeof conn.web.createRecord === 'function') {
      if (id) { await dvTimeout(() => conn.web.updateRecord(logical, id, body), 'save'); return { ok: true, id, err: '' }; }
      const r = await dvTimeout(() => conn.web.createRecord(logical, body), 'save');
      return { ok: true, id: r && r.id ? String(r.id) : '', err: '' };
    }
    if (conn.clientUrl && entitySet && typeof fetch === 'function') {
      const url = conn.clientUrl + '/api/data/v9.2/' + entitySet + (id ? '(' + String(id).replace(/[{}]/g, '') + ')' : '');
      const resp = await fetch(url, { method: id ? 'PATCH' : 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' }, body: JSON.stringify(body) });
      if (resp.ok) return { ok: true, id: id || '', err: '' };
      let t = ''; try { t = await resp.text(); } catch (e) {}
      return { ok: false, id: '', err: 'HTTP ' + resp.status + ': ' + dvErrText(t) };
    }
    return { ok: false, id: '', err: 'This page has no way to save.' };
  } catch (e) { return { ok: false, id: '', err: dvErrText(e) }; }
}

// Saves (or replaces) the scan|<appId> row.
async function dvSaveScan(conn, hubTable, appId, app, result, rows, manifestCol) {
  const key = SCAN_PREFIX + appId;
  const old = (rows || []).find(r => String(r.craa5_configkey || '') === key);
  const idCol = hubTable + 'id';
  const list = JSON.stringify(dvScanManifest(appId, app, result));
  // Old table: list in Manifest json (its Config json holds 100 characters). New table: Config json is big enough.
  const body = manifestCol === false ? { craa5_configkey: key, craa5_configname: app + ' scan', craa5_configjson: list }
    : { craa5_configkey: key, craa5_configname: app + ' scan', craa5_manifestjson: list };
  return dvWriteRow(conn, hubTable, hubTable + 's', old ? old[idCol] : '', body);
}

// Reads every row of a table, page by page (Xrm.WebApi). Resolves { ok, rows, err }.
async function dvReadAllRows(conn, logical, select, limit) {
  if (!conn.web) return { ok: false, rows: [], err: 'This page cannot read rows page by page.' };
  const rows = [];
  let options = '?$select=' + select.join(',');
  try {
    for (let guard = 0; guard < 200; guard++) {
      const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, options, 500), 'read ' + logical);
      (res && res.entities || []).forEach(e => rows.push(e));
      if (rows.length >= (limit || 20000) || !res || !res.nextLink) break;
      options = '?' + String(res.nextLink).split('?').slice(1).join('?');
    }
    return { ok: true, rows, err: '' };
  } catch (e) { return { ok: false, rows, err: dvErrText(e) }; }
}

// Turns a value into what the target column takes. { ok, v }. A save with the wrong kind of value fails in Dataverse
// (error 0x80048d19), so every value is converted here first, or the row is left out and counted.
const TYPE_WORDS = { Boolean: 'Yes/No', Integer: 'Whole number', BigInt: 'Whole number', Decimal: 'Decimal', Double: 'Float', Money: 'Currency', String: 'Text', Memo: 'Multiline text', Picklist: 'Choice', DateTime: 'Date', Lookup: 'Lookup' };
function dvConvertValue(v, type) {
  const num = typeof v === 'number' ? v : (typeof v === 'string' && v.trim() !== '' && isFinite(Number(v)) ? Number(v) : NaN);
  switch (type) {
    case 'Boolean':
      if (typeof v === 'boolean') return { ok: true, v };
      if (isFinite(num)) return { ok: true, v: num > 0 };
      if (/^(yes|true|si|y)$/i.test(String(v).trim())) return { ok: true, v: true };
      if (/^(no|false|n)$/i.test(String(v).trim())) return { ok: true, v: false };
      return { ok: false };
    case 'Integer': case 'BigInt':
      if (typeof v === 'boolean') return { ok: false };
      return isFinite(num) ? { ok: true, v: Math.round(num) } : { ok: false };
    case 'Decimal': case 'Double': case 'Money':
      if (typeof v === 'boolean') return { ok: false };
      return isFinite(num) ? { ok: true, v: num } : { ok: false };
    case 'String': case 'Memo':
      return { ok: true, v: typeof v === 'boolean' ? (v ? 'Yes' : 'No') : String(v) };
    case 'Picklist':
      return isFinite(num) && Math.round(num) === num ? { ok: true, v: num } : { ok: false };
    case undefined: case '':
      return { ok: true, v };
    default:
      return typeof v === 'object' ? { ok: false } : { ok: true, v };
  }
}

// Copy one column's value into other columns on the same rows. Plan first (no writes), then run.
// types: { column: AttributeType } when known; values are converted to each target's type.
function dvPlanCopy(rows, idCol, from, to, types) {
  const ty = types || {};
  const changes = [];
  let skippedBlank = 0;
  let cannot = 0;
  rows.forEach(r => {
    const v = r[from];
    if (v === null || v === undefined || v === '') { skippedBlank++; return; }
    const body = {};
    let bad = false;
    to.forEach(c => {
      const cv = dvConvertValue(v, ty[c]);
      if (!cv.ok) { bad = true; return; }
      if (r[c] !== cv.v) body[c] = cv.v;
    });
    if (bad) { cannot++; return; }
    if (Object.keys(body).length) changes.push({ id: r[idCol], body });
  });
  // A number into a Yes/No column only says "has minutes"; say so on the page.
  const toFlag = to.filter(c => ty[c] === 'Boolean' && ty[from] && ty[from] !== 'Boolean');
  return { total: rows.length, changes, skippedBlank, cannot, types: ty, toFlag };
}
async function dvRunCopy(conn, logical, plan, onProgress) {
  let done = 0;
  const failed = [];
  await dvRunPool(plan.changes, ch => dvWriteRow(conn, logical, '', ch.id, ch.body), 4, (i, res) => {
    done++;
    if (!res.ok) failed.push(res.err);
    if (onProgress) onProgress(done, failed.length);
  });
  return { done, failed };
}

// ---------------------------------------------------------------------------
// Security roles: which roles can read, write and create each craa5 table, and
// at what level (own rows, business unit, organization). Read only.
// ---------------------------------------------------------------------------
const DEPTH_NAMES = { Basic: 'User', Local: 'BU', Deep: 'Parent BU', Global: 'Org', 0: 'User', 1: 'BU', 2: 'Parent BU', 3: 'Org' };
const DEPTH_RANK = { User: 1, BU: 2, 'Parent BU': 3, Org: 4 };
const PRIV_OPS = ['Create', 'Read', 'Write', 'Delete', 'AppendTo', 'Append', 'Assign', 'Share'];

function dvParsePrivName(name) {
  const n = String(name || '');
  for (let i = 0; i < PRIV_OPS.length; i++) {
    const p = 'prv' + PRIV_OPS[i];
    if (n.indexOf(p) === 0 && /^craa5_/i.test(n.slice(p.length))) return { op: PRIV_OPS[i], table: n.slice(p.length).toLowerCase() };
  }
  return null;
}

// Resolves { state: 'ok'|'denied'|'unknown', roles: [{ id, name, privs: { table: { Read: 'Org', ... } } }], mine: [names], err }.
async function dvReadRoles(conn, userId) {
  if (!conn.clientUrl) return { state: 'unknown', roles: [], mine: [], err: 'Needs the Web API address, which this page does not have.' };
  const pr = await dvFetchJson(conn, "privileges?$select=privilegeid,name&$filter=contains(name,'craa5_')");
  if (!pr.ok) return { state: dvClassify(pr.err) === 'denied' ? 'denied' : 'unknown', roles: [], mine: [], err: pr.err };
  const privById = {};
  (pr.json.value || []).forEach(p => { const x = dvParsePrivName(p.name); if (x) privById[String(p.privilegeid).toLowerCase()] = x; });
  const rr = await dvFetchJson(conn, 'roles?$select=name,roleid,ismanaged&$filter=_parentroleid_value eq null&$orderby=name');
  if (!rr.ok) return { state: dvClassify(rr.err) === 'denied' ? 'denied' : 'unknown', roles: [], mine: [], err: rr.err };
  const roles = (rr.json.value || []).map(r => ({ id: String(r.roleid), name: String(r.name || ''), managed: r.ismanaged === true, privs: {}, err: '' }));
  await dvRunPool(roles, async role => {
    const res = await dvFetchJson(conn, 'RetrieveRolePrivilegesRole(RoleId=' + role.id + ')');
    if (!res.ok) { role.err = res.err; return; }
    (res.json.RolePrivileges || []).forEach(p => {
      const x = privById[String(p.PrivilegeId).toLowerCase()];
      if (!x) return;
      const d = DEPTH_NAMES[p.Depth] || String(p.Depth);
      const t = role.privs[x.table] = role.privs[x.table] || {};
      if (!t[x.op] || DEPTH_RANK[d] > DEPTH_RANK[t[x.op]]) t[x.op] = d;
    });
  }, 4);
  let mine = [];
  if (userId) {
    const ur = await dvFetchJson(conn, 'systemusers(' + String(userId).replace(/[{}]/g, '') + ')/systemuserroles_association?$select=name');
    if (ur.ok) mine = (ur.json.value || []).map(r => String(r.name || ''));
  }
  return { state: 'ok', roles: roles.filter(r => Object.keys(r.privs).length || r.err), mine, err: '' };
}

// Roles Dataverse makes by itself. They get rights on new tables automatically (or are for support staff), so they
// say nothing about whether the hub's own users can open a table and are left out of the findings.
// A managed role came with Dataverse or an installed solution; roles Gerald makes are unmanaged.
const BUILTIN_ROLES = ['support user', 'delegate', 'service reader', 'service writer', 'service deleter', 'async ingestion', 'system administrator', 'system customizer', 'environment maker', 'app opener', 'common data service role'];
// Basic User is managed too, but it is the role most staff get, so it always counts.
function dvIsBuiltinRole(name, managed) { if (String(name || '').trim().toLowerCase() === 'basic user') return false; return managed === true || BUILTIN_ROLES.indexOf(String(name || '').trim().toLowerCase()) !== -1; }

// The roles (not built in) that give rights on at least one hub table: [{ name, tables }].
function dvHubRoles(roles) {
  return roles.filter(r => !dvIsBuiltinRole(r.name, r.managed) && Object.keys(r.privs).length).map(r => ({ name: r.name, tables: Object.keys(r.privs).length }));
}

// What the role levels mean for the apps. tables: [{ logicalName, resolved, ownership }]. Built-in roles do not count.
function dvRoleFindings(allRoles, tables) {
  const roles = allRoles.filter(r => !dvIsBuiltinRole(r.name, r.managed));
  const out = [];
  tables.forEach(t => {
    const name = t.resolved || t.logicalName;
    const withRead = roles.filter(r => r.privs[name] && r.privs[name].Read);
    if (!withRead.length) { out.push({ table: name, kind: 'noread' }); return; }
    if (/user/i.test(t.ownership || '')) {
      const partial = withRead.filter(r => r.privs[name].Read !== 'Org').map(r => r.name);
      if (partial.length) out.push({ table: name, kind: 'ownonly', roles: partial });
    }
    if (t.written && !roles.some(r => r.privs[name] && (r.privs[name].Write || r.privs[name].Create))) out.push({ table: name, kind: 'nowrite' });
  });
  return out;
}

// ---------------------------------------------------------------------------
// Cross-app keys: for each contract key "this column must match that table's
// column", counts rows whose value is not found there. Counts only, no values.
// ---------------------------------------------------------------------------
// A few unmatched rows, each with its own value, in a table made by the Copilot table maker: most likely the sample rows it adds.
function dvKeyLooksLikeSamples(k) { return k.bad > 0 && k.bad <= 10 && k.badDistinct === k.bad; }

const KEY_EXACT_KINDS = ['equipment', 'employee', 'employees', 'areaguid', 'user'];
function dvKeyCanon(kind, v) {
  let s = String(v == null ? '' : v).trim().toLowerCase();
  // A clean can have several log rows: key, key|2 .. key|9 (contract 1.0.54). They all match the base key.
  if (kind === 'completion') s = s.replace(/\|[2-9]$/, '');
  if (KEY_EXACT_KINDS.indexOf(kind) !== -1) return s.replace(/[{}]/g, '');
  return s.replace(/[^a-z0-9]/g, '');
}

// Which keys can be checked: mustMatch names one table.column, and both tables were found.
function dvKeyPlan(tables, results) {
  const byName = {};
  tables.forEach(t => { byName[t.logicalName] = t; });
  const plan = [];
  tables.forEach(t => (t.keys || []).forEach(k => {
    const m = String(k.mustMatch || '').match(/^(craa5_[a-z0-9_]+)\.(craa5_[a-z0-9_]+)/);
    if (!m || !byName[m[1]]) return;
    const rFrom = results[t.logicalName];
    const rTo = results[m[1]];
    if (!rFrom || rFrom.state !== 'found' || !rTo || rTo.state !== 'found') return;
    const notMade = [];
    if (dvColNotMade(rFrom, k.column)) notMade.push((rFrom.resolvedName || t.logicalName) + '.' + k.column);
    if (dvColNotMade(rTo, m[2])) notMade.push((rTo.resolvedName || m[1]) + '.' + m[2]);
    plan.push({ notMade, from: t.logicalName, fromAs: rFrom.resolvedName || t.logicalName, col: k.column, to: m[1], toAs: rTo.resolvedName || m[1], toCol: m[2], kind: k.kind });
  }));
  return plan;
}

// True only when the table's full column list was read and the column is not on it.
function dvColNotMade(r, col) {
  if (r.cols && r.cols[col] === 'missing') return true;
  return !!(r.allCols && r.allCols.length && r.allCols.indexOf(String(col).toLowerCase()) === -1);
}

// Up to 3 unmatched values are shown, only for kinds that name places and things (never people or free text),
// and never from the tables that hold names, emails or notes.
const KEY_EXAMPLE_KINDS = ['area', 'room', 'item', 'sapw', 'vendor', 'line', 'location', 'cart', 'sapcart', 'equipment', 'areaguid', 'skill', 'skilllevel', 'swabsite', 'payrole', 'crew'];
const KEY_NO_EXAMPLE_TABLES = /personnelnote|employeenote|accesslog|access_log/;
function dvKeyExamplesAllowed(p) {
  return KEY_EXAMPLE_KINDS.indexOf(p.kind) !== -1 && !KEY_NO_EXAMPLE_TABLES.test(p.from + ' ' + p.fromAs);
}

async function dvKeyCheck(conn, plan, limit, onProgress) {
  const cache = {};
  // A lookup column cannot be asked for by its own name: on "Could not find a property", ask for _col_value and
  // use its display name (the formatted value Xrm.WebApi sends with it), else the raw id.
  const readOne = async (t, c) => {
    const r = await dvReadAllRows(conn, t, [c], limit);
    if (r.ok || !/could not find a property/i.test(r.err || '')) return r;
    const lk = '_' + c + '_value';
    const r2 = await dvReadAllRows(conn, t, [lk], limit);
    if (!r2.ok) return r;
    const fv = lk + '@OData.Community.Display.V1.FormattedValue';
    return { ok: true, lookup: true, err: '', rows: r2.rows.map(x => ({ [c]: x[fv] != null ? x[fv] : x[lk] })) };
  };
  const readCol = (t, c) => (cache[t + '|' + c] = cache[t + '|' + c] || readOne(t, c));
  const out = [];
  for (let i = 0; i < plan.length; i++) {
    const p = plan[i];
    if (onProgress) onProgress(i + 1, plan.length);
    if (p.notMade && p.notMade.length) { out.push(Object.assign({}, p, { err: '' })); continue; }
    const [a, b] = await Promise.all([readCol(p.fromAs, p.col), readCol(p.toAs, p.toCol)]);
    if (!a.ok || !b.ok) { out.push(Object.assign({}, p, { err: (a.ok ? b.err : a.err) || 'could not read' })); continue; }
    const target = new Set();
    b.rows.forEach(r => String(r[p.toCol] == null ? '' : r[p.toCol]).split(';').forEach(v => { const c = dvKeyCanon(p.kind, v); if (c) target.add(c); }));
    let blank = 0;
    let bad = 0;
    const badDistinct = new Set();
    const examples = [];
    const showEx = dvKeyExamplesAllowed(p);
    a.rows.forEach(r => {
      const raw = String(r[p.col] == null ? '' : r[p.col]).split(';').map(v => v.trim()).filter(v => dvKeyCanon(p.kind, v));
      if (!raw.length) { blank++; return; }
      const miss = raw.filter(v => !target.has(dvKeyCanon(p.kind, v)));
      if (miss.length) {
        bad++;
        miss.forEach(v => {
          const c = dvKeyCanon(p.kind, v);
          if (showEx && !badDistinct.has(c) && examples.length < 3) examples.push(v.length > 40 ? v.slice(0, 40) + '...' : v);
          badDistinct.add(c);
        });
      }
    });
    // A lookup to roles: list the role names it carries (names of roles, never of people).
    let lookupValues;
    if ((a.lookup || b.lookup) && p.kind === 'payrole') {
      const seen = {};
      const side = a.lookup ? a : b;
      const col = a.lookup ? p.col : p.toCol;
      side.rows.forEach(r => { const v = String(r[col] == null ? '' : r[col]).trim(); if (v) seen[v] = true; });
      lookupValues = Object.keys(seen).sort().slice(0, 20);
    }
    out.push(Object.assign({}, p, { lookup: !!a.lookup, toLookup: !!b.lookup, lookupValues, rows: a.rows.length, blank, bad, badDistinct: badDistinct.size, examples, capped: a.rows.length >= (limit || 20000), targetEmpty: target.size === 0, err: '' }));
  }
  return out;
}

// ---------------------------------------------------------------------------
// App health and daily history. One dot per app from its tables, its saved
// app list (manifest) and the key checks; one summary per day kept in Hub
// config (key MONITOR_HISTORY) so the trend shows. Counts only, never values.
// ---------------------------------------------------------------------------
const HISTORY_KEY = 'MONITOR_HISTORY';
const HISTORY_DAYS = 60;
if (!HUB_CONFIG_KEYS.some(k => k.key === HISTORY_KEY)) {
  HUB_CONFIG_KEYS.push({ key: HISTORY_KEY, app: 'monitor', otherWriters: [], status: 'live', note: 'Dataverse monitor: one summary per day (counts only).' });
}

// The manifest saved by this app (contract id -> app name -> card id), or null.
function dvAppManifest(apps, cardId) {
  return (apps || []).find(a => !a.fromScan && appIdOf(APP_WRITER_NAMES[a.appId] || a.appId) === cardId)
    || (apps || []).find(a => a.fromScan && appIdOf(APP_WRITER_NAMES[a.appId] || a.appId) === cardId) || null;
}

// { tone: 'green'|'amber'|'red'|'gray', reasons: [text] }. Red: a table the app needs is missing, or its own
// list names a table or written column that is not there. Amber: anything else that needs a look.
function dvAppHealth(cardId, appTables, verdicts, man, keyResults) {
  const reasons = [];
  let tone = 'green';
  const bump = t => { if (t === 'red' || (t === 'amber' && tone === 'green')) tone = t; };
  if (!appTables.some(t => verdicts[t.logicalName] && verdicts[t.logicalName].code !== 'notscanned')) return { tone: 'gray', reasons: ['not checked yet'] };
  const bad = appTables.filter(t => NOT_PROBLEMS.indexOf(verdicts[t.logicalName].code) === -1);
  const redT = bad.filter(t => verdicts[t.logicalName].tone === 'red');
  if (redT.length) { bump('red'); reasons.push(redT.length + ' table(s) missing or broken'); }
  if (bad.length > redT.length) { bump('amber'); reasons.push((bad.length - redT.length) + ' table(s) need a look'); }
  if (man && man.error) { bump('amber'); reasons.push('saved app list cannot be read'); }
  if (man && man.check) {
    const gone = man.check.tables.filter(t => t.state !== 'found');
    const wMiss = man.check.tables.reduce((n, t) => n + t.missingWrite.length, 0);
    const rMiss = man.check.tables.reduce((n, t) => n + t.missingRead.length, 0);
    const notes = man.check.tables.filter(t => t.contractNotes.length).length;
    if (gone.length) { bump('red'); reasons.push(gone.length + ' table(s) in its list not found'); }
    if (wMiss) { bump('red'); reasons.push(wMiss + ' column(s) it saves to are missing'); }
    if (rMiss) { bump('amber'); reasons.push(rMiss + ' column(s) it reads are missing'); }
    if (notes) { bump('amber'); reasons.push(notes + ' table(s) differ from the contract'); }
  }
  if (keyResults) {
    const names = {};
    appTables.forEach(t => { if (t.writers.map(appIdOf).indexOf(cardId) !== -1) names[t.logicalName] = true; });
    const kb = keyResults.filter(k => names[k.from] && !k.err && !(k.notMade && k.notMade.length) && k.bad > 0);
    if (kb.length) { bump('amber'); reasons.push(kb.length + ' key column(s) with values not found'); }
  }
  if (!reasons.length) reasons.push(man ? 'all good' : 'tables good (no saved app list yet)');
  return { tone, reasons };
}

function dvLocalDay(d) {
  const x = d || new Date();
  return x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0');
}

// Reads the saved history from the Hub config rows already read. Resolves to { row, days: [] }.
function dvReadHistory(rows) {
  const row = (rows || []).find(r => String(r.craa5_configkey || '') === HISTORY_KEY) || null;
  if (!row) return { row: null, days: [] };
  const text = String(row.craa5_manifestjson || '').trim() || String(row.craa5_configjson || '').trim();
  try {
    const j = JSON.parse(text);
    return { row, days: Array.isArray(j.days) ? j.days.filter(x => x && typeof x.d === 'string') : [] };
  } catch (e) { return { row, days: [] }; }
}

// Puts today's counts in (replacing today's earlier entry, keeping fields not given) and keeps the last 60 days.
function dvMergeHistory(days, entry) {
  const list = (days || []).filter(x => x.d !== entry.d);
  const prev = (days || []).find(x => x.d === entry.d) || {};
  const merged = Object.assign({}, prev);
  Object.keys(entry).forEach(k => { if (entry[k] !== undefined) merged[k] = entry[k]; });
  return list.concat([merged]).sort((a, b) => a.d.localeCompare(b.d)).slice(-HISTORY_DAYS);
}

// Saves the history row. New table: the list in Config json. Old table: the list in Manifest json, a pointer in Config json.
async function dvSaveHistory(conn, hubTable, row, days, manifestCol) {
  const list = JSON.stringify({ m: 1, days });
  const body = manifestCol === true
    ? { craa5_configkey: HISTORY_KEY, craa5_configname: 'Dataverse monitor history', craa5_configjson: JSON.stringify({ m: 1, in: 'craa5_manifestjson' }), craa5_manifestjson: list }
    : { craa5_configkey: HISTORY_KEY, craa5_configname: 'Dataverse monitor history', craa5_configjson: list };
  return dvWriteRow(conn, hubTable, hubTable + 's', row ? row[hubTable + 'id'] : '', body);
}

// ---------------------------------------------------------------------------
// Table builder, part 1: the build list (read only). Merges what the contract
// and each app's saved list (manifest) need with what Dataverse really has, and
// says per table what to make or change. Types: the contract decides; a manifest
// type that disagrees is a conflict and is not built. Names only, never values.
// ---------------------------------------------------------------------------
const BUILD_TYPES = {
  text: { attr: 'String', word: 'Single line of text', len: 200 },
  memo: { attr: 'Memo', word: 'Multiple lines of text', len: 100000 },
  int: { attr: 'Integer', word: 'Whole number' },
  decimal: { attr: 'Decimal', word: 'Decimal number' },
  money: { attr: 'Money', word: 'Currency' },
  yesno: { attr: 'Boolean', word: 'Yes/No' },
  date: { attr: 'DateTime', word: 'Date only', format: 'DateOnly' },
  datetime: { attr: 'DateTime', word: 'Date and time', format: 'DateAndTime' },
  choice: { attr: 'Picklist', word: 'Choice' },
  guid: { attr: 'String', word: 'Single line of text (id)', len: 100 }
};
// The old name-based guess, in the builder's words. Always marked as a guess.
function dvGuessType(col) {
  const g = colTypeGuess(col);
  return g === 'date and time' ? 'datetime' : g === 'whole number' ? 'int' : g === 'currency' ? 'money' : g === 'yes/no' ? 'yesno' : /guids?$/.test(col) ? (/guids$/.test(col) ? 'memo' : 'guid') : 'text';
}
function dvTypeWord(spec) {
  if (!spec) return 'unknown';
  const b = BUILD_TYPES[spec.type];
  return (b ? b.word : spec.type) + (spec.len ? ' (' + spec.len + ')' : '');
}

// What each table needs: { logical: { t, names, label, isNew, owner, primary, status, named: {col: [who]}, types: {col: spec+source}, conflicts: [] } }.
// apps: parsed manifests (dvParseManifest), scans included (they name columns, never types).
function dvBuildWants(tables, apps) {
  const out = {};
  const byName = {};
  tables.forEach(t => {
    const w = out[t.logicalName] = { t: t.logicalName, names: t.candidates && t.candidates.length ? t.candidates : [t.logicalName], label: t.newLabel || t.label || '', isNew: !!t.isNew, owner: t.newOwner || '', primary: t.newPrimary || null, status: t.status, spec: t, named: {}, types: {}, conflicts: [] };
    w.names.concat([t.logicalName]).forEach(n => { byName[n] = w; });
    const name = (c, who) => { (w.named[c] = w.named[c] || []).indexOf(who) === -1 && w.named[c].push(who); };
    (t.requiredCols || []).forEach(c => name(c, 'contract'));
    (t.optionalCols || []).forEach(c => name(c, 'contract'));
    (t.columnOwners || []).forEach(o => (o.columns || []).forEach(c => name(c, 'contract')));
    Object.keys(t.colTypes || {}).forEach(c => { name(c, 'contract'); w.types[c] = Object.assign({}, t.colTypes[c], { source: 'contract' }); });
  });
  (apps || []).forEach(a => (a.tables || []).forEach(mt => {
    let w = byName[mt.t] || (mt.names || []).map(n => byName[n]).find(Boolean);
    if (!w) {
      w = out[mt.t] = { t: mt.t, names: mt.names && mt.names.length ? mt.names : [mt.t], label: mt.label || '', isNew: !!mt['new'], owner: mt.owner || '', primary: mt.primary || null, status: 'app only', spec: null, named: {}, types: {}, conflicts: [] };
      w.names.forEach(n => { byName[n] = w; });
    }
    if (mt['new'] && !w.spec) w.isNew = true;
    if (!w.label && mt.label) w.label = mt.label;
    if (!w.owner && mt.owner) w.owner = mt.owner;
    if (!w.primary && mt.primary) w.primary = mt.primary;
    const who = a.appId + (a.fromScan ? ' (scan)' : '');
    mt.read.concat(mt.write, mt.opt || []).forEach(c => { (w.named[c] = w.named[c] || []).indexOf(who) === -1 && w.named[c].push(who); });
    Object.keys(mt.cols || {}).forEach(c => {
      const want = mt.cols[c];
      (w.named[c] = w.named[c] || []).indexOf(who) === -1 && w.named[c].push(who);
      const have = w.types[c];
      if (!have) { w.types[c] = Object.assign({}, want, { source: a.appId }); return; }
      if (have.type !== want.type) w.conflicts.push({ col: c, have: dvTypeWord(have) + ' from ' + have.source, want: dvTypeWord(want) + ' from ' + a.appId });
      else if (!have.len && want.len && have.source !== 'contract') have.len = want.len;
    });
  }));
  return out;
}

// One table's columns with type and length (Web API). Resolves { ok, cols: { name: { type, maxLen, format, custom, helper } }, err }.
async function dvReadColumnDetails(conn, logical) {
  const base = "EntityDefinitions(LogicalName='" + logical + "')/Attributes";
  const all = await dvFetchJson(conn, base + '?$select=LogicalName,AttributeType,IsCustomAttribute,AttributeOf');
  if (!all.ok) return { ok: false, cols: {}, err: all.err };
  const cols = {};
  (all.json.value || []).forEach(a => {
    const n = String(a.LogicalName || '').toLowerCase();
    if (n) cols[n] = { type: String(a.AttributeType || ''), custom: a.IsCustomAttribute === true, helper: !!a.AttributeOf };
  });
  const extra = [['StringAttributeMetadata', 'MaxLength', 'maxLen'], ['MemoAttributeMetadata', 'MaxLength', 'maxLen'], ['DateTimeAttributeMetadata', 'Format', 'format']];
  for (let i = 0; i < extra.length; i++) {
    const r = await dvFetchJson(conn, base + '/Microsoft.Dynamics.CRM.' + extra[i][0] + '?$select=LogicalName,' + extra[i][1]);
    if (r.ok) (r.json.value || []).forEach(a => { const n = String(a.LogicalName || '').toLowerCase(); if (cols[n]) cols[n][extra[i][2]] = a[extra[i][1]]; });
  }
  return { ok: true, cols, err: '' };
}

// The build list. found: { logical: { name (real), primaryId, primaryName } | null when missing | undefined when unknown }.
// details: { realName: dvReadColumnDetails result }. manifestApps: app ids with a saved list (not a scan).
function dvBuildPlan(wants, found, details, manifestApps) {
  const items = [];
  const haveList = new Set(manifestApps || []);
  Object.keys(wants).sort().forEach(k => {
    const w = wants[k];
    if (w.status === 'abandoned' || w.status === 'absent') return;
    w.conflicts.forEach(c => items.push({ kind: 'conflict', t: w.t, col: c.col, text: c.have + ' vs ' + c.want }));
    const f = found[w.t];
    if (f === null) {
      if (w.isNew || w.status === 'live' || w.status === 'proposed' || w.status === 'app only') {
        const cols = Object.keys(w.named).filter(c => c !== w.t + 'id' && !(w.primary && c === w.primary.n));
        items.push({ kind: 'table', t: w.t, label: w.label, owner: w.owner || 'org', primary: w.primary || { n: 'craa5_name', len: 200 }, cols: cols.map(c => ({ col: c, spec: w.types[c] || { type: dvGuessType(c), source: 'guess' } })), text: (w.label || w.t) + ', ' + (w.owner === 'user' ? 'user' : 'organization') + '-owned, ' + cols.length + ' columns' });
      }
      return;
    }
    if (!f) return;
    const d = details[f.name];
    if (!d || !d.ok) { items.push({ kind: 'unread', t: w.t, text: d ? d.err : 'columns not read' }); return; }
    const skip = c => c === (f.primaryId || w.t + 'id') || c === f.primaryName || (w.spec && c === w.spec.primaryName && f.primaryName);
    Object.keys(w.named).sort().forEach(c => {
      if (skip(c) || c.indexOf('@') !== -1) return;
      const have = d.cols[c];
      const spec = w.types[c];
      if (!have) {
        const s = spec || { type: dvGuessType(c), source: 'guess' };
        items.push({ kind: 'column', t: w.t, as: f.name, col: c, spec: s, who: w.named[c], text: dvTypeWord(s) + (s.source === 'guess' ? ' (guessed from the name)' : ' (' + s.source + ')') });
        return;
      }
      if (!spec || !BUILD_TYPES[spec.type]) return;
      const b = BUILD_TYPES[spec.type];
      if (have.type !== b.attr || (b.format && have.format && have.format !== b.format && spec.source === 'contract')) {
        items.push({ kind: 'type', t: w.t, as: f.name, col: c, spec, text: 'is ' + have.type + (have.format ? ' ' + have.format : '') + ', should be ' + dvTypeWord(spec) + ' (' + spec.source + ')' });
        return;
      }
      const wantLen = spec.len || b.len;
      if ((spec.type === 'text' || spec.type === 'memo' || spec.type === 'guid') && spec.len && have.maxLen && have.maxLen < wantLen) {
        items.push({ kind: 'short', t: w.t, as: f.name, col: c, spec, have: have.maxLen, text: 'holds ' + have.maxLen + ', needs ' + wantLen });
      }
    });
    // Unused: only judged when every app that uses the table has saved its list, or a name would be missed.
    const users = w.spec ? w.spec.writers.concat(w.spec.readers).filter(x => !/model-driven/i.test(x)).map(x => Object.keys(APP_WRITER_NAMES).find(id => appIdOf(APP_WRITER_NAMES[id]) === appIdOf(x))).filter(Boolean) : [];
    if (users.length && users.every(u => haveList.has(u))) {
      Object.keys(d.cols).sort().forEach(c => {
        const x = d.cols[c];
        if (!x.custom || x.helper || c.indexOf('craa5_') !== 0 || skip(c) || w.named[c]) return;
        items.push({ kind: 'unused', t: w.t, as: f.name, col: c, text: 'named by no app and not in the contract' });
      });
    }
  });
  return items;
}
