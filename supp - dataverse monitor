// ============================================================================
// DATAVERSE CHECK ENGINE (no React in this block, so it can be tested alone)
// Rule: a table is only called found when Dataverse said so; a column is only
// called there or missing when the table's metadata (or a real row) said so.
// Anything else is "could not tell" and never shows green.
// ============================================================================

const DV_TIMEOUT_MS = 15000;
const DV_COUNT_CAP_FETCH = 5000;
const DV_COUNT_CAP_AGG = 50000;

function dvErrText(e) {
  if (!e) return '';
  if (typeof e === 'string') return e.replace(/\s+/g, ' ').slice(0, 400);
  let m = '';
  try { m = e.message || (e.error && e.error.message) || ''; } catch (x) {}
  if (!m) { try { m = JSON.stringify(e); } catch (x) { m = String(e); } }
  const code = (e && (e.errorCode || e.code)) ? ' (' + (e.errorCode || e.code) + ')' : '';
  return (String(m) + code).replace(/\s+/g, ' ').slice(0, 400);
}

// What kind of refusal this is. Wordings are the ones Dataverse uses (same list as hub - manager).
function dvClassify(err) {
  const m = typeof err === 'string' ? err : dvErrText(err);
  if (/resource not found for the segment|not found in the metadatacache/i.test(m)) return 'table';
  if (/could not find a property|property .{0,80}(does not exist|not found)|undeclared property|not a valid (attribute|property|column)|invalid (column|attribute|property)|(attribute|column) .{0,60}(does not exist|not found)|0x80040203|0x80060888|(does not|doesn'?t) contain (an? )?(attribute|column|property)/i.test(m)) return 'column';
  if (/with ids? ?=.{0,80}(does not|do not) exist/i.test(m)) return 'gone';
  if (/(entity|table) .{0,120}(does not exist|not found)|could not find (an? )?(entity|table)|could not find table with name|(unable to|could not) (find|retrieve|load) (the )?(entity )?metadata|not a valid (entity|table)|unknown (table|entity)|\b404\b|0x80040217|0x80060891|0x80094005|doesn'?t exist/i.test(m)) return 'table';
  if (/\b40[13]\b|forbidden|privilege|prv(read|create|write|append|delete)|access (is )?denied|not authori[sz]ed|unauthori[sz]ed|permission|does not have \w*access right|SecLib::AccessCheckEx|0x80040220|0x80040277|-2147187962/i.test(m)) return 'denied';
  if (/timed out|timeout expired|sql timeout|0x80044151|failed to fetch|network|offline|\b(429|5\d\d)\b|unavailable|too many requests|number of requests exceeded|0x8007232[126]|try again later|server busy|gateway time-?out|bad gateway/i.test(m)) return 'network';
  return 'other';
}

// A refusal that names a privilege proves the table is there; a bare 401/403 (sign-in) proves nothing.
function dvNamesPrivilege(m) {
  return /prv(read|create|write|append|delete)|privilege|SecLib::AccessCheckEx|0x80040220|0x80040277|-2147187962|principal user/i.test(String(m || ''));
}

function dvTimeout(make, label, ms) {
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error(label + ' timed out')), ms || DV_TIMEOUT_MS);
    let p;
    try { p = typeof make === 'function' ? make() : make; } catch (e) { clearTimeout(t); reject(e); return; }
    Promise.resolve(p).then(v => { clearTimeout(t); resolve(v); }, e => { clearTimeout(t); reject(e); });
  });
}

// "_craa5_area_lookup_value" (how rows show a lookup) and "craa5_area_lookup" (its metadata name) are the same column.
function dvColKey(c) {
  const s = String(c || '').toLowerCase();
  const m = s.match(/^_(.+)_value$/);
  return m ? m[1] : s;
}
function dvIsLookupCol(c) { return /^_.+_value$/i.test(String(c || '')); }

function dvFrames() {
  const out = [];
  try { if (typeof window !== 'undefined') out.push(window); } catch (e) {}
  try { if (typeof window !== 'undefined' && window.parent && window.parent !== window) out.push(window.parent); } catch (e) {}
  try { if (typeof window !== 'undefined' && window.top && window.top !== window) out.push(window.top); } catch (e) {}
  return out;
}

function dvFindXrm() {
  const fr = dvFrames();
  for (let i = 0; i < fr.length; i++) {
    try { if (fr[i] && fr[i].Xrm) return fr[i].Xrm; } catch (e) {}
  }
  return null;
}

// Every way this page can reach Dataverse. Found once per page, not on every render.
function dvConnect(props) {
  const conn = { web: null, dataApi: null, clientUrl: '', xrm: null, routes: [] };
  try {
    if (props && props.webApi && typeof props.webApi.retrieveMultipleRecords === 'function') conn.web = props.webApi;
    else if (props && props.context && props.context.webAPI && typeof props.context.webAPI.retrieveMultipleRecords === 'function') conn.web = props.context.webAPI;
  } catch (e) {}
  const xrm = dvFindXrm();
  conn.xrm = xrm;
  try { if (!conn.web && xrm && xrm.WebApi && typeof xrm.WebApi.retrieveMultipleRecords === 'function') conn.web = xrm.WebApi; } catch (e) {}
  try { if (props && props.dataApi && typeof props.dataApi.queryTable === 'function') conn.dataApi = props.dataApi; } catch (e) {}
  try {
    if (xrm && xrm.Utility && typeof xrm.Utility.getGlobalContext === 'function') {
      const ctx = xrm.Utility.getGlobalContext();
      if (ctx && typeof ctx.getClientUrl === 'function') conn.clientUrl = String(ctx.getClientUrl() || '').replace(/\/+$/, '');
    }
  } catch (e) {}
  try {
    if (!conn.clientUrl && typeof window !== 'undefined' && window.location && /\.crm[0-9]*\.dynamics\.com$/i.test(window.location.hostname)) {
      conn.clientUrl = window.location.origin.replace(/\/+$/, '');
    }
  } catch (e) {}
  if (conn.web) conn.routes.push('Xrm.WebApi');
  if (conn.clientUrl) conn.routes.push('Web API');
  if (conn.dataApi) conn.routes.push('dataApi');
  return conn;
}

// Who is signed in. Never invents an ID: unknown stays unknown.
function dvReadUser(conn, props) {
  try {
    const xrm = conn && conn.xrm;
    if (xrm && xrm.Utility && typeof xrm.Utility.getGlobalContext === 'function') {
      const us = xrm.Utility.getGlobalContext().userSettings;
      if (us && (us.userName || us.userId)) {
        return { userName: String(us.userName || '').trim(), userId: String(us.userId || '').replace(/[{}]/g, ''), source: 'Dataverse' };
      }
    }
  } catch (e) {}
  try {
    const us = props && props.context && props.context.userSettings;
    if (us && (us.userName || us.userId)) {
      return { userName: String(us.userName || '').trim(), userId: String(us.userId || '').replace(/[{}]/g, ''), source: 'Dataverse' };
    }
  } catch (e) {}
  return { userName: '', userId: '', source: 'unknown' };
}

async function dvFetchJson(conn, path) {
  if (!conn || !conn.clientUrl || typeof fetch !== 'function') return { ok: false, status: 0, json: null, err: 'No Web API address on this page.' };
  try {
    const resp = await dvTimeout(() => fetch(conn.clientUrl + '/api/data/v9.2/' + path, {
      headers: { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0', 'Prefer': 'odata.include-annotations="*"' },
      credentials: 'same-origin'
    }), 'Web API');
    if (resp.ok) {
      const json = await resp.json();
      return { ok: true, status: resp.status, json, err: '' };
    }
    let txt = '';
    try { txt = await resp.text(); } catch (e) {}
    let msg = txt;
    try { const j = JSON.parse(txt); if (j && j.error && j.error.message) msg = j.error.message; } catch (e) {}
    return { ok: false, status: resp.status, json: null, err: 'HTTP ' + resp.status + ': ' + dvErrText(msg) };
  } catch (e) {
    return { ok: false, status: 0, json: null, err: dvErrText(e) };
  }
}

// The table's definition. state: 'found' | 'missing' | 'unknown'. cols: Set of column logical names, or null when columns could not be read.
async function dvReadMeta(conn, logical, wantCols) {
  const out = { state: 'unknown', meta: null, cols: null, colSource: '', err: '' };
  if (conn.clientUrl) {
    const r = await dvFetchJson(conn, "EntityDefinitions(LogicalName='" + logical + "')?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute,OwnershipType,ObjectTypeCode&$expand=Attributes($select=LogicalName,AttributeType)");
    if (r.ok && r.json) {
      out.state = 'found';
      out.meta = {
        EntitySetName: r.json.EntitySetName || '',
        PrimaryIdAttribute: r.json.PrimaryIdAttribute || '',
        PrimaryNameAttribute: r.json.PrimaryNameAttribute || '',
        OwnershipType: r.json.OwnershipType || '',
        ObjectTypeCode: r.json.ObjectTypeCode || null
      };
      if (Array.isArray(r.json.Attributes) && r.json.Attributes.length > 0) {
        out.cols = new Set(r.json.Attributes.map(a => String(a && a.LogicalName || '').toLowerCase()).filter(Boolean));
        out.colSource = 'metadata';
      }
      return out;
    }
    out.err = r.err;
    if (r.status === 404 || dvClassify(r.err) === 'table') { out.state = 'missing'; return out; }
  }
  // Second way: the model-driven app's own metadata call. Only the columns asked for come back.
  const xrm = conn.xrm;
  if (xrm && xrm.Utility && typeof xrm.Utility.getEntityMetadata === 'function') {
    try {
      const asked = (wantCols || []).map(dvColKey);
      const md = await dvTimeout(() => xrm.Utility.getEntityMetadata(logical, asked), 'Xrm metadata');
      if (md) {
        out.state = 'found';
        out.meta = {
          EntitySetName: md.EntitySetName || '',
          PrimaryIdAttribute: md.PrimaryIdAttribute || '',
          PrimaryNameAttribute: md.PrimaryNameAttribute || '',
          OwnershipType: md.OwnershipType || '',
          ObjectTypeCode: md.ObjectTypeCode || null
        };
        const names = dvAttrNames(md.Attributes);
        // An empty answer to a non-empty ask is more likely a client quirk than a table with none of its columns: leave columns unchecked.
        if (names && !(names.length === 0 && asked.length > 0)) {
          out.cols = new Set(names);
          out.colSource = 'metadata';
          out.colsAskedOnly = true;
        }
        out.err = '';
        return out;
      }
    } catch (e) {
      const m = dvErrText(e);
      if (!out.err) out.err = m;
      if (dvClassify(m) === 'table') { out.state = 'missing'; out.err = m; }
    }
  }
  return out;
}

// Xrm metadata hands back its Attributes in different shapes depending on the client.
function dvAttrNames(attrs) {
  try {
    if (!attrs) return null;
    let list = null;
    if (typeof attrs.getAll === 'function') list = attrs.getAll();
    else if (Array.isArray(attrs)) list = attrs;
    else if (attrs._collection && typeof attrs._collection === 'object') list = Object.keys(attrs._collection).map(k => attrs._collection[k]);
    if (!Array.isArray(list)) return null;
    return list.map(a => String((a && (a.LogicalName || a.logicalName)) || '').toLowerCase()).filter(Boolean);
  } catch (e) { return null; }
}

// How many rows the table holds (active and inactive). Tries each route; the most useful refusal wins.
async function dvCountRows(conn, logical, idCol, entitySet) {
  const tries = [];
  if (conn.web) {
    tries.push(async () => {
      const xml = "<fetch aggregate='true'><entity name='" + logical + "'><attribute name='" + idCol + "' aggregate='count' alias='n'/></entity></fetch>";
      try {
        const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, '?fetchXml=' + encodeURIComponent(xml)), 'Xrm.WebApi ' + logical);
        const row = res && Array.isArray(res.entities) ? res.entities[0] : null;
        const n = row ? Number(row.n) : NaN;
        if (!isFinite(n)) return { ok: false, err: 'Count answer held no number.' };
        return { ok: true, count: n, capped: false, via: 'Xrm.WebApi' };
      } catch (e) {
        const m = dvErrText(e);
        if (/aggregatequeryrecordlimit|maximum record limit|exceeded/i.test(m)) return { ok: true, count: DV_COUNT_CAP_AGG, capped: true, via: 'Xrm.WebApi' };
        return { ok: false, err: m };
      }
    });
  }
  if (conn.clientUrl && entitySet) {
    tries.push(async () => {
      const r = await dvFetchJson(conn, entitySet + '?$select=' + idCol + '&$count=true&$top=1');
      if (!r.ok) return { ok: false, err: r.err };
      const n = Number(r.json && r.json['@odata.count']);
      if (!isFinite(n)) return { ok: false, err: 'Count answer held no number.' };
      return { ok: true, count: n, capped: n >= DV_COUNT_CAP_FETCH, via: 'Web API' };
    });
  }
  if (conn.dataApi) {
    tries.push(async () => {
      try {
        const page = await dvTimeout(() => conn.dataApi.queryTable(logical, { select: [idCol], pageSize: DV_COUNT_CAP_FETCH }), 'dataApi ' + logical);
        if (!page || !Array.isArray(page.rows)) return { ok: false, err: 'The answer for ' + logical + ' held no list of rows.' };
        const n = page.rows.length;
        const more = !!(page.hasMoreRows || page.hasMore || page.nextLink || page['@odata.nextLink']);
        return { ok: true, count: n, capped: more || n >= DV_COUNT_CAP_FETCH, via: 'dataApi' };
      } catch (e) {
        return { ok: false, err: dvErrText(e) };
      }
    });
  }
  if (tries.length === 0) return { ok: false, err: 'No way to reach Dataverse on this page.', kind: 'none' };
  let best = null;
  const rank = k => ({ denied: 4, network: 3, other: 3, column: 2, table: 1 }[k] || 0);
  for (let i = 0; i < tries.length; i++) {
    const r = await tries[i]();
    if (r.ok) return r;
    r.kind = dvClassify(r.err);
    if (!best || rank(r.kind) > rank(best.kind)) best = r;
  }
  return best;
}

// One row, all columns, only used to see which columns exist when metadata could not be read. The row's values are dropped at once.
async function dvSampleKeys(conn, logical) {
  if (!conn.web) return null;
  try {
    const res = await dvTimeout(() => conn.web.retrieveMultipleRecords(logical, '?$top=1'), 'Xrm.WebApi ' + logical);
    const row = res && Array.isArray(res.entities) ? res.entities[0] : null;
    if (!row) return null;
    return new Set(Object.keys(row).filter(k => k.indexOf('@') === -1).map(dvColKey));
  } catch (e) { return null; }
}

// The whole check for one table. Returns plain data only (no rows).
async function dvAuditTable(conn, spec) {
  const want = (spec.requiredCols || []).concat(spec.optionalCols || []);
  const meta = await dvReadMeta(conn, spec.logicalName, want);
  const idCol = (meta.meta && meta.meta.PrimaryIdAttribute) || spec.primaryId || (spec.logicalName + 'id');
  const entitySet = (meta.meta && meta.meta.EntitySetName) || spec.entitySetName || '';
  const cnt = meta.state === 'missing' ? null : await dvCountRows(conn, spec.logicalName, idCol, entitySet);

  const r = {
    logicalName: spec.logicalName,
    entitySetName: entitySet,
    primaryId: idCol,
    primaryName: (meta.meta && meta.meta.PrimaryNameAttribute) || spec.primaryName || '',
    ownership: (meta.meta && meta.meta.OwnershipType) || '',
    state: 'unknown',
    count: null,
    countCapped: false,
    via: '',
    colSource: '',
    cols: {},
    missingRequired: [],
    uncheckedRequired: [],
    missingOptional: [],
    error: ''
  };

  // Table state
  if (meta.state === 'missing') {
    r.state = 'missing';
    r.error = meta.err;
  } else if (cnt && cnt.ok) {
    r.state = 'found';
    r.count = cnt.count;
    r.countCapped = !!cnt.capped;
    r.via = cnt.via;
  } else {
    const k = cnt ? cnt.kind : 'other';
    const m = cnt ? cnt.err : '';
    r.error = m || meta.err;
    if (k === 'denied' && (meta.state === 'found' || dvNamesPrivilege(m))) r.state = 'denied';
    else if (k === 'table' && meta.state !== 'found') r.state = 'missing';
    else if ((k === 'column' || k === 'table') && meta.state === 'found') { r.state = 'found'; r.countUnknown = true; }
    else r.state = 'unknown';
  }

  // Column state: only metadata (or a real row) can say a column is there
  let colSet = meta.cols;
  let fromRow = false;
  if (!colSet && r.state === 'found' && r.count > 0) {
    colSet = await dvSampleKeys(conn, spec.logicalName);
    fromRow = !!colSet;
  }
  r.colSource = colSet ? (fromRow ? 'row' : 'metadata') : '';
  want.forEach(c => {
    const key = dvColKey(c);
    let st = 'unchecked';
    if (colSet && r.state !== 'missing') {
      if (colSet.has(key)) st = 'present';
      else if (!fromRow) st = 'missing';   // one row can leave a column out, so only metadata says missing
    }
    r.cols[c] = st;
  });
  (spec.requiredCols || []).forEach(c => {
    if (r.cols[c] === 'missing') r.missingRequired.push(c);
    else if (r.cols[c] === 'unchecked') r.uncheckedRequired.push(c);
  });
  (spec.optionalCols || []).forEach(c => { if (r.cols[c] === 'missing') r.missingOptional.push(c); });
  return r;
}

// Tries each name the contract lists for a table, in order (Gerald's prefixed name first, plain name after).
// A name that is there wins; a name that could not be told does not stop the later ones.
async function dvAuditCandidates(conn, spec) {
  const names = (spec.candidates && spec.candidates.length) ? spec.candidates : [spec.logicalName];
  const tried = [];
  let firstUnsure = null;
  let last = null;
  for (let i = 0; i < names.length; i++) {
    const name = names[i];
    const same = name === spec.logicalName;
    const r = await dvAuditTable(conn, { ...spec, logicalName: name, primaryId: same ? spec.primaryId : name + 'id', entitySetName: same ? spec.entitySetName : '' });
    r.resolvedName = name;
    r.triedNames = tried.slice();
    if (r.state === 'found' || r.state === 'denied') return r;
    if (r.state === 'unknown' && !firstUnsure) firstUnsure = r;
    tried.push(name + ': ' + r.state);
    last = r;
  }
  const out = firstUnsure || last;
  out.triedNames = tried;
  if (!firstUnsure) out.resolvedName = '';
  return out;
}

// The one word each table gets. Green only for a table that was read AND whose required columns were all seen.
// spec.status from the contract: a missing 'abandoned' or 'proposed' table is expected, not a problem.
function dvVerdict(r, spec) {
  if (!r) return { code: 'notscanned', tone: 'gray' };
  const status = spec && spec.status;
  if (status === 'abandoned') {
    if (r.state === 'missing') return { code: 'gone', tone: 'gray' };
    if (r.state === 'found') return { code: 'abandonedthere', tone: 'gray', n: r.count, capped: r.countCapped };
  }
  if (status === 'proposed' && r.state === 'missing') return { code: 'notmade', tone: 'gray' };
  if (r.state === 'missing') return { code: 'missing', tone: 'red' };
  if (r.state === 'denied') return { code: 'denied', tone: 'purple' };
  if (r.state !== 'found') return { code: 'unknown', tone: 'gray' };
  if (r.missingRequired.length > 0) return { code: 'missingcols', tone: 'amber', n: r.missingRequired.length };
  if (r.uncheckedRequired.length > 0) return { code: 'colsunchecked', tone: 'amber' };
  if (r.countUnknown) return { code: 'foundnocount', tone: 'amber' };
  if (r.count === 0) return { code: 'empty', tone: 'teal' };
  return { code: 'ok', tone: 'green', n: r.count, capped: r.countCapped };
}

// Every craa5 table in the environment (needs the Web API address). null = could not list.
async function dvListCustomTables(conn) {
  if (!conn.clientUrl) return null;
  const r = await dvFetchJson(conn, 'EntityDefinitions?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute,OwnershipType');
  if (!r.ok || !r.json || !Array.isArray(r.json.value)) return null;
  return r.json.value
    .filter(d => d && d.LogicalName && d.LogicalName.indexOf('craa5_') === 0)
    .map(d => ({ logicalName: d.LogicalName, entitySetName: d.EntitySetName || '', primaryId: d.PrimaryIdAttribute || '', primaryName: d.PrimaryNameAttribute || '', ownership: d.OwnershipType || '' }))
    .sort((a, b) => a.logicalName.localeCompare(b.logicalName));
}

// Runs the checks a few at a time so a big list does not flood the server.
async function dvRunPool(items, worker, size, onEach) {
  const out = new Array(items.length);
  let next = 0;
  const lanes = [];
  for (let l = 0; l < Math.min(size, items.length); l++) {
    lanes.push((async () => {
      while (next < items.length) {
        const i = next++;
        try { out[i] = await worker(items[i], i); } catch (e) { out[i] = null; }
        if (onEach) onEach(i, out[i]);
      }
    })());
  }
  await Promise.all(lanes);
  return out;
}


