                                <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, color: textSub }}>{L('leave empty', '')}</td>
                                <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol }}>{appName(e.app) + (e.otherWriters.length ? ' + ' + e.otherWriters.map(appName).join(', ') : '')}</td>
                                <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, color: textSub }}>{(statusWord[e.status] ? statusWord[e.status] + '. ' : '') + e.note}</td>
                                <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol }}>
