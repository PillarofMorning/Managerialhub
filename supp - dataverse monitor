// Read-only look at the browser storage keys the apps share. Nothing here writes.
function inspectStorage() {
  return STORAGE_BRIDGES.map(b => {
    let status = 'empty';
    let detail = '';
    let issue = '';
    try {
      const storeObj = b.store === 'sessionStorage' ? window.sessionStorage : window.localStorage;
      const raw = storeObj ? storeObj.getItem(b.key) : null;
      if (raw) {
        const parsed = JSON.parse(raw);
        const chars = raw.length;
        status = 'ok';
        if (b.key === 'ss_live_boards_local_v1' && Array.isArray(parsed)) {
          const now = Date.now();
          const stale = parsed.filter(x => x && (x.status === 'archived' || (x.slotEnd && (now - new Date(x.slotEnd).getTime() > 4 * 3600000))));
          detail = parsed.length + ' board(s), ' + chars + ' chars';
          if (stale.length > 0) { status = 'warn'; issue = 'stale:' + stale.length; }
        } else if (b.key === 'mss_log_asset_catalog_v4' && parsed && typeof parsed === 'object') {
          const hasBoth = Array.isArray(parsed.items) && Array.isArray(parsed.assets);
          const cnt = Array.isArray(parsed.items) ? parsed.items.length : (Array.isArray(parsed.assets) ? parsed.assets.length : 0);
          detail = cnt + ' item(s), ' + chars + ' chars';
          if (!hasBoth) { status = 'warn'; issue = 'onekey'; }
        } else {
          detail = (Array.isArray(parsed) ? parsed.length + ' item(s)' : (parsed && typeof parsed === 'object' ? Object.keys(parsed).length + ' key(s)' : 'value')) + ', ' + chars + ' chars';
        }
      }
    } catch (err) {
      status = 'bad';
      issue = 'json';
      detail = dvErrText(err);
    }
    return { key: b.key, store: b.store, writers: b.writers, readers: b.readers, contract: b.contract, status, detail, issue };
  });
}

const TONES = {
