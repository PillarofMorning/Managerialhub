    const hubRes = read.table ? await dvReadMeta(conn, read.table, ['craa5_manifestjson']) : null;
    // Is the Manifest json column there? Metadata decides when it can be read; otherwise what the row read showed.
    const manifestCol = hubRes && hubRes.cols ? hubRes.cols.has('craa5_manifestjson') : read.manifestCol;
    const mMaxLen = manifestCol ? await dvConfigJsonMaxLength(conn, read.table, 'craa5_manifestjson') : null;
    if (scanRef.current !== myScan) return;
    const hub = read.state === 'ok' ? dvCheckHubConfig(read.rows, maxLen, apps, mMaxLen) : null;
    // While apps move to the new table, also look at the old one (keys only, for the move list).
    let oldKeys = null;
    if (old && old.state === 'ok') oldKeys = old.rows.map(r => String(r.craa5_configkey || '').trim() || String(r.craa5_configname || '').trim()).filter(Boolean);
    // The new Hub config table is skipped when it has no Config key column; say so plainly.
    let newNeedsKey = false;
    if (read.table !== 'craa5__e_hubconfig') {
      const nm = await dvReadMeta(conn, 'craa5__e_hubconfig', ['craa5_configkey']);
      newNeedsKey = nm.state === 'found' && !!nm.cols && !nm.cols.has('craa5_configkey');
    }
    if (scanRef.current !== myScan) return;
    setManifests({ newNeedsKey, state: read.state, table: read.table || '', err: read.err || '', rows: read.rows, apps, maxLen, hub, oldKeys, readNotes: read.notes || [], manifestCol, mMaxLen, ownership: hubRes && hubRes.meta ? hubRes.meta.OwnershipType : '', expectedOwnership: hubSpec ? hubSpec.expectedOwnership : '' });
    setLastScanTime(new Date().toISOString());
    setScanning(false);
    if (read.state === 'ok') setHistory(h => ({ ...h, days: dvReadHistory(read.rows).days, read: { table: read.table, rows: read.rows, manifestCol, maxLen } }));
  }, [conn, online]);

  useEffect(() => {
    refreshStorage();
    runScan();
  }, [refreshStorage, runScan]);

  const verdicts = useMemo(() => {
    const out = {};
    ECOSYSTEM_TABLES.forEach(t => { out[t.logicalName] = dvVerdict(tableResults[t.logicalName], t); });
    return out;
  }, [tableResults]);

  const summary = useMemo(() => {
    const s = {};
    VERDICT_ORDER.forEach(c => { s[c] = 0; });
    ECOSYSTEM_TABLES.forEach(t => { s[verdicts[t.logicalName].code]++; });
    return s;
  }, [verdicts]);

  const unclaimed = useMemo(() => {
    if (!Array.isArray(discovered)) return null;
    const known = new Set();
    ECOSYSTEM_TABLES.forEach(t => t.candidates.concat([t.logicalName]).forEach(n => known.add(n.toLowerCase())));
    return discovered.filter(d => !known.has(d.logicalName.toLowerCase()));
  }, [discovered]);

  const filteredTables = useMemo(() => {
    let list = ECOSYSTEM_TABLES;
    if (filterApp !== 'all') list = list.filter(t => t.usedBy.indexOf(filterApp) !== -1);
    if (filterState === 'problems') list = list.filter(t => NOT_PROBLEMS.indexOf(verdicts[t.logicalName].code) === -1);
    return list;
  }, [filterApp, filterState, verdicts]);

  // One dot per app: its tables, its saved app list and the key checks.
  const appHealth = useMemo(() => {
    const out = {};
    ECOSYSTEM_APPS.forEach(app => {
      const appTables = ECOSYSTEM_TABLES.filter(t => t.usedBy.indexOf(app.id) !== -1);
      const man = manifests && manifests.apps ? dvAppManifest(manifests.apps, app.id) : null;
      out[app.id] = dvAppHealth(app.id, appTables, verdicts, man, keyResults);
    });
    return out;
  }, [verdicts, manifests, keyResults]);

  // Daily history: after a full check (and again after key checks), today's counts replace today's entry.
  useEffect(() => {
    const rd = history.read;
    if (!rd || scanning || !Object.keys(tableResults).length) return;
    const entry = {
      d: dvLocalDay(), v: MONITOR_VERSION, c: CONTRACT_VERSION,
      t: ECOSYSTEM_TABLES.filter(t => verdicts[t.logicalName].code !== 'notscanned').length,
      p: ECOSYSTEM_TABLES.filter(t => NOT_PROBLEMS.indexOf(verdicts[t.logicalName].code) === -1).length,
      r: ECOSYSTEM_TABLES.filter(t => verdicts[t.logicalName].tone === 'red').length,
      m: manifests && manifests.apps ? manifests.apps.filter(a => a.check && a.check.tables.some(t => t.state !== 'found' || t.missingWrite.length || t.missingRead.length)).length : undefined,
      k: keyResults ? keyResults.filter(k => k.bad && !k.err).length : undefined,
      a: ECOSYSTEM_APPS.filter(a => appHealth[a.id].tone === 'red').length
    };
    const days = dvMergeHistory(history.days, entry);
    const text = JSON.stringify({ m: 1, days });
    // Old table without Manifest json: Config json is too short for the list, so nothing is saved.
    if (rd.manifestCol !== true && rd.maxLen != null && text.length > rd.maxLen) { setHistory(h => ({ ...h, days, read: null, note: 'History not saved: Config json in ' + rd.table + ' is too short.' })); return; }
    setHistory(h => ({ ...h, days, read: null, note: 'Saving today\'s summary...' }));
    const row = dvReadHistory(rd.rows).row;
    dvSaveHistory(conn, rd.table, row, days, rd.manifestCol).then(res => {
      if (res.ok && !row && res.id) rd.rows.push({ craa5_configkey: HISTORY_KEY, [rd.table + 'id']: res.id });
      setHistory(h => ({ ...h, note: res.ok ? 'Today\'s summary saved in ' + rd.table + ' (' + HISTORY_KEY + ').' : 'History not saved: ' + res.err, rows: rd }));
    });
  }, [history.read, scanning, tableResults, verdicts, manifests, keyResults, appHealth, conn]);

  // The printout carries states, counts, column names and errors. It never carries row values.
  const printoutText = useMemo(() => {
    const rows = ECOSYSTEM_TABLES.map(t => {
      const r = tableResults[t.logicalName];
      const v = verdicts[t.logicalName];
      const base = {
        table: t.logicalName,
        contractStatus: t.status,
        foundAs: r && r.resolvedName && r.resolvedName !== t.logicalName ? r.resolvedName : undefined,
        result: verdictText(v, 'en'),
        rows: r && r.count != null ? (r.count + (r.countCapped ? '+' : '')) : null,
        usedBy: t.usedBy,
        missingRequired: r ? r.missingRequired : [],
        similarColumns: r && r.similar && Object.keys(r.similar).length ? r.similar : undefined,
        primaryNameInDataverse: r && r.missingRequired.length ? r.primaryName : undefined,
        notCheckedRequired: r ? r.uncheckedRequired : [],
        missingOptional: r ? r.missingOptional : [],
        columnsFrom: r ? (r.colSource || 'not read') : 'not scanned',
        error: r && r.error ? r.error : null,
        filledValues: fillCounts[t.logicalName] ? Object.keys(fillCounts[t.logicalName].cols).map(c => { const f = fillCounts[t.logicalName].cols[c]; return c + ': ' + (f && f.ok ? f.count + (f.capped ? '+' : '') : '?'); }) : undefined
      };
      if (printoutMode === 'full') {
        base.entitySet = r ? r.entitySetName : '';
        base.primaryId = r ? r.primaryId : t.primaryId;
        base.primaryName = r ? r.primaryName : t.primaryName;
        base.ownership = r ? r.ownership : '';
        base.readVia = r ? r.via : '';
      }
      return base;
    });
    const payload = {
      tool: 'Dataverse Monitor ' + MONITOR_VERSION,
      contractVersion: CONTRACT_VERSION,
      generatedAt: new Date().toISOString(),
      lastScan: lastScanTime,
      routes: conn.routes,
      environment: conn.clientUrl || 'unknown',
      summary: VERDICT_ORDER.filter(c => summary[c] > 0).map(c => summaryLabel(c, 'en') + ': ' + summary[c]),
      tables: printoutMode === 'full' ? rows : rows.filter(x => NOT_PROBLEMS.indexOf(verdicts[x.table].code) === -1 || x.filledValues),
      // Columns other threads are waiting on (contract notes): there, missing, or not checked.
      watchedColumns: Object.keys(NOTE_OPTIONAL_COLS).map(t => { const r = tableResults[t]; return t + ': ' + NOTE_OPTIONAL_COLS[t].map(c => c + ' ' + (!r || !r.cols || !r.cols[c] ? 'not checked' : r.cols[c])).join(', '); }),
      // Tables found under a name other than the contract's first one (answers "which name did Gerald make?").
      foundUnderOtherName: ECOSYSTEM_TABLES.filter(t => { const r = tableResults[t.logicalName]; return r && r.resolvedName && r.resolvedName !== t.logicalName; }).map(t => t.logicalName + ' -> ' + tableResults[t.logicalName].resolvedName),
      notConfirmedTables: ECOSYSTEM_TABLES.filter(t => t.status === 'unknown').map(t => t.logicalName + ': ' + verdictText(verdicts[t.logicalName], 'en')),
      hubConfig: !manifests ? 'not read' : (manifests.state !== 'ok' || !manifests.hub ? manifests.state + (manifests.err ? ': ' + manifests.err : '') : {
        rows: manifests.hub.rows.length,
        configJsonMaxLength: manifests.maxLen,
        manifestJsonColumn: manifests.manifestCol === true ? 'present' : (manifests.manifestCol === false ? 'not there' : 'could not tell'),
        manifestJsonMaxLength: manifests.mMaxLen,
        ownership: manifests.ownership || 'unknown',
        warnings: manifests.hub.rows.filter(x => x.warnings.length && !x.issues.length).map(x => x.key + ': ' + x.warnings.join(',')),
        problems: manifests.hub.rows.filter(x => x.issues.length).map(x => (x.key || '(blank key, name "' + x.name + '")') + ': ' + x.issues.join(',') + ' (' + x.len + ' chars' + (x.mLen ? ', manifestjson ' + x.mLen : '') + ')').concat(manifests.hub.claims.map(c => c.appId + ' writes ' + c.key + ': ' + (c.issue === 'otherapp' ? 'belongs to ' + c.owner : 'not in contract'))),
        notSavedYet: manifests.hub.expected.filter(e => e.state === 'notyet' && !(manifests.oldKeys && manifests.oldKeys.indexOf(e.key) !== -1)).map(e => e.key),
        onlyOnOldTable: manifests.oldKeys ? manifests.hub.expected.filter(e => e.state === 'notyet' && manifests.oldKeys.indexOf(e.key) !== -1).map(e => e.key) : undefined,
        notInContract: manifests.hub.unlisted,
        largest: manifests.hub.rows.slice().sort((a, b) => b.len - a.len).slice(0, 3).map(x => (x.key || 'name "' + x.name + '"') + ' ' + x.len)
      }),
      appManifests: !manifests ? 'not read' : (manifests.state !== 'ok' ? manifests.state + (manifests.err ? ': ' + manifests.err : '') : {
        configJsonMaxLength: manifests.maxLen,
        manifestJsonColumn: manifests.manifestCol === true ? 'present' : (manifests.manifestCol === false ? 'not there' : 'could not tell'),
        manifestJsonMaxLength: manifests.mMaxLen,
        hubConfigOwnership: manifests.ownership || 'unknown',
        apps: manifests.apps.map(a => ({
          app: a.app, appId: a.appId, version: a.version, savedIn: a.inTable, hubShared: a.contract, savedAt: a.savedAt, error: a.error || undefined, source: a.source || undefined, pointerOnly: a.stub ? a.pointer : undefined,
          problems: a.check ? a.check.tables.filter(t => t.state !== 'found' || t.missingRead.length || t.missingWrite.length || t.contractNotes.length).map(t => t.t + (t.state !== 'found' ? ': ' + t.state : '') + (t.missingWrite.length ? ' write-missing ' + t.missingWrite.join(',') : '') + (t.missingRead.length ? ' read-missing ' + t.missingRead.join(',') : '') + (t.contractNotes.length ? ' contract ' + t.contractNotes.join(',') + (t.notAllowed ? ' (' + t.notAllowed.join(',') + ')' : '') : '')) : [],
          notYet: a.check ? a.check.tables.filter(t => t.notYet.length).map(t => t.t + ' ' + t.notYet.join(',')) : []
        }))
      }),
      securityRoles: !roleData ? 'not read (press Read security roles)' : (roleData.state !== 'ok' ? roleData.state + ': ' + roleData.err : {
        yourRoles: roleData.mine,
        rolesWithHubRights: (roleData.hubRoles || []).map(r => r.name + ' (' + r.tables + ' tables)'),
        builtInRolesLeftOut: roleData.builtin || [],
        findings: roleData.findings.map(f => f.table + ': ' + f.kind + (f.roles ? ' (' + f.roles.join(', ') + ')' : ''))
      }),
      keyChecks: !keyResults ? 'not run (press Check keys)' : keyResults.filter(k => k.bad || k.err || k.targetEmpty || (k.notMade && k.notMade.length)).map(k => k.from + '.' + k.col + ' -> ' + k.to + '.' + k.toCol + ': ' + (k.notMade && k.notMade.length ? 'column not made yet: ' + k.notMade.join(', ') : (k.err ? 'error ' + k.err : k.bad + ' of ' + k.rows + ' rows not found (' + k.badDistinct + ' distinct)' + (k.examples && k.examples.length ? ', e.g. ' + k.examples.map(x => '"' + x + '"').join(', ') : '') + (k.lookup || k.toLookup ? ', lookup (display names compared)' : '') + (dvKeyLooksLikeSamples(k) ? ', maybe Copilot sample rows' : '') + (k.targetEmpty ? ', target empty' : '') + (k.capped ? ', first 20000 rows' : '')))),
      lookupRoleNames: keyResults ? Array.from(new Set(keyResults.filter(k => (k.lookup || k.toLookup) && k.lookupValues).map(k => (k.lookup ? k.from + '.' + k.col : k.to + '.' + k.toCol) + ' (lookup) carries: ' + k.lookupValues.join(', ')))) : undefined,
      buildList: !buildItems ? 'not made (press Make build list)' : buildItems.map(b => BUILD_KIND_WORDS[b.kind] + ': ' + b.t + (b.col ? '.' + b.col : '') + ' - ' + b.text),
      appHealth: ECOSYSTEM_APPS.map(a => a.name + ': ' + appHealth[a.id].tone + ' - ' + appHealth[a.id].reasons.join('; ')),
      history: history.days.length ? history.days.slice(-7).map(d => d.d + ' problems ' + d.p + ' red ' + d.r + ' app-list ' + d.m + (d.k != null ? ' keys ' + d.k : '')) : 'none saved yet',
      tablesNotOnList: unclaimed ? unclaimed.map(d => d.logicalName) : 'could not list (no Web API address)',
      browserStorage: storageState.filter(s => printoutMode === 'full' || s.status === 'warn' || s.status === 'bad').map(s => ({ key: s.key, status: s.status, detail: s.detail, issue: s.issue || null }))
    };
    return JSON.stringify(payload, null, 2);
  }, [tableResults, verdicts, summary, lastScanTime, conn, printoutMode, unclaimed, storageState, fillCounts, manifests, roleData, keyResults, appHealth, history, buildItems]);

  // Work for the table maker, one card per table. Copilot does best with one short prompt per table and
  // cannot edit tables, so a missing table gets a short create prompt (required columns only) and missing
  // columns on an existing table are listed to add by hand. Lookup columns are never asked for.
  // Code scanner: which names are tables. Ecosystem tables by name; any Dataverse table by its plural (entity set) name.
  const scanKnown = useMemo(() => {
    const tables = new Set();
    const sets = {};
    ECOSYSTEM_TABLES.forEach(t => { tables.add(t.logicalName); (t.candidates || []).forEach(c => tables.add(c)); if (t.entitySetName) sets[t.entitySetName] = t.logicalName; });
    (Array.isArray(discovered) ? discovered : []).forEach(d => { if (d.entitySetName && d.entitySetName !== d.logicalName) sets[d.entitySetName.toLowerCase()] = d.logicalName; });
    return { tables, sets };
  }, [discovered]);
  const scanAppId = scanApp === 'other' ? appIdOf(scanOther) : scanApp;
  const scanAppName = scanApp === 'other' ? scanOther.trim() : (APP_WRITER_NAMES[scanApp] || scanApp);
  const runCodeScan = useCallback(async () => {
    setScanBusy(true); setScanSaved(''); setScanResult(null);
    const sc = dvScanCode(scanCode, scanKnown);
    const res = await dvScanCheck(conn, sc);
    setScanResult(Object.assign(res, { tokenTables: sc.tables.length, tokenCols: sc.cols.length }));
    setScanBusy(false);
  }, [conn, scanCode, scanKnown]);
  const saveCodeScan = useCallback(async () => {
    if (!scanResult || !scanAppId || !manifests || !manifests.table) return;
    setScanSaved(L('Saving...', 'Guardando...'));
    const r = await dvSaveScan(conn, manifests.table, scanAppId, scanAppName || scanAppId, scanResult, manifests.rows || [], manifests.manifestCol);
    setScanSaved(r.ok ? L('Saved. Every check now watches this app.', 'Guardado. Cada revision ahora vigila esta app.') : L('Could not save: ', 'No se pudo guardar: ') + r.err);
    if (r.ok) runScan();
  }, [conn, scanResult, scanAppId, scanAppName, manifests, L]);
  const scanCards = useMemo(() => {
    if (!scanResult) return [];
    return scanResult.tables.map(r => {
      const cols = r.missing.filter(c => !dvIsLookupCol(c));
      const text = r.state === 'missing' ? 'Create one table. Display name: ' + colDisplay(r.t) + '. Primary column: name (text).'
        + (cols.length ? ' Add only these columns: ' + cols.map(c => colDisplay(c) + ' (' + colTypeGuess(c) + ')').join(', ') + '.' : '')
        + ' No lookup, choice or formula columns. Do not add any other columns.' : '';
      return Object.assign({}, r, { text, cols });
    });
  }, [scanResult]);

  // Copy column values: plan (read only), then copy on a second press.
  const planCopy = useCallback(async () => {
    const table = copyTable.trim().toLowerCase();
    const from = copyFrom.trim().toLowerCase();
    const to = copyTo.split(/[ ,]+/).map(x => x.trim().toLowerCase()).filter(Boolean);
    setCopyPlan(null); setCopyDone(null); setCopyConfirm(false);
    if (!table || !from || !to.length) return;
    setCopyBusy(L('Reading rows...', 'Leyendo filas...'));
    const meta = await dvReadMeta(conn, table, [from].concat(to));
    if (meta.state !== 'found') { setCopyPlan({ err: L('Table not found or no permission: ', 'Tabla no encontrada o sin permiso: ') + (meta.err || meta.state) }); setCopyBusy(''); return; }
    const missingCols = meta.cols ? [from].concat(to).filter(c => !meta.cols.has(c)) : [];
    if (missingCols.length) { setCopyPlan({ err: L('These columns are not on the table: ', 'Estas columnas no estan en la tabla: ') + missingCols.join(', ') }); setCopyBusy(''); return; }
    const idCol = (meta.meta && meta.meta.PrimaryIdAttribute) || table + 'id';
    const read = await dvReadAllRows(conn, table, [idCol, from].concat(to));
    if (!read.ok) { setCopyPlan({ err: read.err }); setCopyBusy(''); return; }
    setCopyPlan(Object.assign(dvPlanCopy(read.rows, idCol, from, to, meta.types || {}), { table, from, to }));
    setCopyBusy('');
  }, [conn, copyTable, copyFrom, copyTo, L]);
  const runCopy = useCallback(async () => {
    if (!copyPlan || !copyPlan.changes || !copyPlan.changes.length) return;
    // No browser pop-up: Power Apps pages block them, so the second press on the page is the confirmation.
    setCopyConfirm(false);
    if (!conn.web || typeof conn.web.updateRecord !== 'function') { setCopyDone({ done: 0, failed: ['This page cannot save rows (no Xrm.WebApi).'] }); return; }
    const res = await dvRunCopy(conn, copyPlan.table, copyPlan, (d, f) => setCopyBusy(L('Copying ', 'Copiando ') + d + ' / ' + copyPlan.changes.length + (f ? L(', failed ', ', fallaron ') + f : '')));
    setCopyBusy('');
    setCopyDone(res);
    setCopyPlan(null);
  }, [conn, copyPlan, L]);

  // Adds the settings rows the contract lists to the new Hub config table: key and name filled, JSON left for the app.
  const addKeyRows = useCallback(async keys => {
    if (!manifests || !manifests.table) return;
    let ok = 0;
    const errs = [];
    for (let i = 0; i < keys.length; i++) {
      setKeyAdd(L('Adding ', 'Agregando ') + (i + 1) + ' / ' + keys.length);
      const r = await dvWriteRow(conn, manifests.table, manifests.table + 's', '', { craa5_configkey: keys[i], craa5_configname: keys[i] });
      if (r.ok) ok++; else errs.push(keys[i] + ': ' + r.err);
    }
    setKeyAdd(L('Added ', 'Agregadas ') + ok + L(' rows', ' filas') + (errs.length ? L('. Failed: ', '. Fallaron: ') + errs.join('; ') : '.'));
    runScan();
  }, [conn, manifests, L]);

  // Security roles (on demand, read only).
  const readRoles = useCallback(async () => {
    setRoleBusy(true);
    const d = await dvReadRoles(conn, msUser && msUser.userId);
    const found = ECOSYSTEM_TABLES.filter(t => t.status === 'live' && tableResults[t.logicalName] && tableResults[t.logicalName].state === 'found')
      .map(t => ({ logicalName: t.logicalName, resolved: tableResults[t.logicalName].resolvedName || t.logicalName, ownership: tableResults[t.logicalName].ownership || (tableResults[t.logicalName].meta && tableResults[t.logicalName].meta.OwnershipType) || '', written: (t.writers || []).some(w => !/admin/i.test(w)) }));
    d.tables = found;
    d.findings = d.state === 'ok' ? dvRoleFindings(d.roles, found) : [];
    d.hubRoles = d.state === 'ok' ? dvHubRoles(d.roles) : [];
    d.builtin = d.state === 'ok' ? d.roles.filter(r => dvIsBuiltinRole(r.name, r.managed)).map(r => r.name) : [];
    setRoleData(d);
    setRoleBusy(false);
  }, [conn, msUser, tableResults]);
  // Build list (on demand, read only): what to make or change, from the contract and the apps' saved lists.
  const runBuildList = useCallback(async () => {
    const apps = manifests && manifests.apps ? manifests.apps.filter(a => !a.error && !a.stub) : [];
    const wants = dvBuildWants(ECOSYSTEM_TABLES, apps);
    const found = {};
    Object.keys(wants).forEach(k => {
      const r = tableResults[k];
      if (r) { found[k] = r.state === 'found' ? { name: r.resolvedName || k, primaryId: r.primaryId, primaryName: r.primaryName } : (r.state === 'missing' ? null : undefined); return; }
      let st;
      apps.forEach(a => a.check && a.check.tables.forEach(t => { if (t.t === k) st = t.state === 'found' ? { name: t.foundAs || k, primaryId: (t.foundAs || k) + 'id', primaryName: '' } : (t.state === 'missing' ? null : st); }));
      found[k] = st;
    });
    const names = Array.from(new Set(Object.keys(found).filter(k => found[k] && Object.keys(wants[k].named).length).map(k => found[k].name)));
    const details = {};
    let n = 0;
    setBuildBusy('Reading columns 0 / ' + names.length);
    await dvRunPool(names, nm => dvReadColumnDetails(conn, nm), 4, (i, res) => { details[names[i]] = res; n++; setBuildBusy('Reading columns ' + n + ' / ' + names.length); });
    setBuildItems(dvBuildPlan(wants, found, details, apps.filter(a => !a.fromScan).map(a => a.appId)));
    setBuildBusy('');
  }, [conn, manifests, tableResults]);

  // Cross-app keys (on demand; reads the key columns only, counts only).
  const runKeyChecks = useCallback(async () => {
    const plan = dvKeyPlan(ECOSYSTEM_TABLES, tableResults);
    setKeyBusy('Checking 0 / ' + plan.length);
    const res = await dvKeyCheck(conn, plan, 20000, (i, n) => setKeyBusy('Checking ' + i + ' / ' + n));
    setKeyResults(res);
    setKeyBusy('');
    setHistory(h => (h.rows ? { ...h, read: h.rows } : h));
  }, [conn, tableResults]);

  const promptCards = useMemo(() => {
    const cards = [];
    ECOSYSTEM_TABLES.forEach(t => {
      const r = tableResults[t.logicalName];
      if (!r || (t.status !== 'live' && t.status !== 'proposed')) return;
      if (r.state === 'missing') {
        const cols = t.requiredCols.filter(c => !dvIsLookupCol(c) && c !== t.primaryId && c !== t.primaryName);
        const text = 'Create one table. Display name: ' + colDisplay(t.logicalName) + '. Primary column: ' + colDisplay(t.primaryName || 'craa5_name') + ' (text).'
          + (cols.length ? ' Add only these columns: ' + cols.map(c => colDisplay(c) + ' (' + colTypeGuess(c) + ')').join(', ') + '.' : '')
          + ' No lookup, choice or formula columns. Do not add any other columns.';
        cards.push({ key: t.logicalName, kind: 'create', table: t, text });
      } else if (r.state === 'found') {
        const cols = r.missingRequired.filter(c => !dvIsLookupCol(c));
        if (cols.length) cards.push({ key: t.logicalName, kind: 'add', table: t, cols, similar: r.similar || {} });
      }
    });
    return cards;
  }, [tableResults]);

  // Counts how many rows have a value in each of the selected table's columns. On demand only: one small count per column.
  const countFilled = useCallback(async (spec, r) => {
    if (!r || r.state !== 'found') return;
    const table = r.resolvedName || spec.logicalName;
    const cols = r.allCols && r.allCols.length ? r.allCols : spec.requiredCols.concat(spec.optionalCols).map(dvColKey).filter(c => r.cols && Object.keys(r.cols).some(k => dvColKey(k) === c && r.cols[k] === 'present'));
    setFillBusy(spec.logicalName);
    const out = {};
    await dvRunPool(cols, c => dvCountFilled(conn, table, r.primaryId, r.entitySetName, c), 4, (i, res) => { out[cols[i]] = res; });
    setFillCounts(prev => ({ ...prev, [spec.logicalName]: { total: r.count, cols: out, at: new Date().toISOString() } }));
    setFillBusy('');
  }, [conn]);

  const copyText = useCallback((txt, label) => {
    try {
      if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt);
      } else {
        const ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      showToast(L('Copied ', 'Copiado: ') + label);
    } catch (e) {
      showToast(L('Copy failed - select the text and press Ctrl+C.', 'No se pudo copiar - seleccione el texto y presione Ctrl+C.'));
    }
  }, [L, showToast]);

  const selectedSpec = useMemo(() => ECOSYSTEM_TABLES.find(t => t.logicalName === selectedTable) || ECOSYSTEM_TABLES[0], [selectedTable]);
  const selectedResult = tableResults[selectedSpec.logicalName] || null;
  const selectedVerdict = verdicts[selectedSpec.logicalName];

  const bgMain = isDark ? '#0f172a' : '#f8fafc';
  const bgCard = isDark ? '#1e293b' : '#ffffff';
  const bgSub = isDark ? '#0f172a' : '#f1f5f9';
  const textMain = isDark ? '#f8fafc' : '#0f172a';
  const textSub = isDark ? '#94a3b8' : '#475569';
  const borderCol = isDark ? '#334155' : '#cbd5e1';

  const pill = tone => ({ padding: '3px 8px', borderRadius: '999px', fontSize: '11px', fontWeight: 700, background: TONES[tone].bg, color: TONES[tone].fg, whiteSpace: 'nowrap' });
  const btn = (primary, color) => ({
    padding: '8px 14px', borderRadius: '6px', border: primary ? 'none' : '1px solid ' + borderCol,
    background: primary ? (color || '#2563eb') : bgSub, color: primary ? '#ffffff' : textMain,
    fontWeight: 600, fontSize: '13px', cursor: 'pointer'
  });
  const colChip = st => {
    const tone = st === 'present' ? 'green' : (st === 'missing' ? 'red' : 'gray');
    return { padding: '3px 8px', borderRadius: '4px', fontFamily: 'Consolas, monospace', fontSize: '12px', background: TONES[tone].bg, color: TONES[tone].fg };
  };
  const colWord = st => (st === 'present' ? L('there', 'esta') : (st === 'missing' ? L('missing', 'falta') : L('not checked', 'sin revisar')));

  const appName = id => {
    const a = ECOSYSTEM_APPS.find(x => x.id === id);
    return a ? a.name : id;
  };

  const userLabel = msUser.userName || L('unknown user', 'usuario desconocido');

  return (
    <div ref={rootRef} style={{ fontFamily: 'Segoe UI, system-ui, sans-serif', background: bgMain, color: textMain, minHeight: '100vh', padding: '16px 20px' }}>
      {/* Banner: welcome, logo, light/dark, English/Spanish */}
      <div style={{ display: 'flex', flexWrap: 'wrap', justifyContent: 'space-between', alignItems: 'center', gap: '12px', padding: '10px 16px', marginBottom: '14px', borderRadius: '10px', background: bgCard, border: '1px solid ' + borderCol, borderBottom: '4px solid ' + BRAND.yellow }}>
        <div style={{ fontSize: '13px', fontWeight: 700 }}>
          {L('Welcome ', 'Bienvenido(a) ') + userLabel + L(' to the Dataverse Monitor', ' al Monitor de Dataverse')}
          {msUser.source === 'unknown' && (
            <span style={{ marginLeft: 8, fontSize: '11px', fontWeight: 400, color: textSub }}>
              {L('(this page could not read who is signed in)', '(esta pagina no pudo leer quien inicio sesion)')}
            </span>
          )}
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
          <BrandLogo isDark={isDark} lang={lang} />
          <div style={{ display: 'flex', padding: 2, borderRadius: 8, border: '1px solid ' + borderCol, background: bgSub }}>
            {['light', 'dark'].map(m => (
              <button key={m} type="button" onClick={() => toggleTheme(m)} style={{ padding: '4px 10px', borderRadius: 6, fontSize: 11, fontWeight: 700, border: 'none', cursor: 'pointer', background: (m === 'dark') === isDark ? (isDark ? '#1E293B' : '#FFFFFF') : 'transparent', color: (m === 'dark') === isDark ? (isDark ? '#38BDF8' : '#0F172A') : textSub }}>
                {m === 'light' ? L('Light', 'Claro') : L('Dark', 'Oscuro')}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Title, connection, actions */}
      <div style={{ display: 'flex', flexWrap: 'wrap', justifyContent: 'space-between', alignItems: 'center', gap: '12px', borderBottom: '1px solid ' + borderCol, paddingBottom: '14px', marginBottom: '14px' }}>
        <div>
          <h1 style={{ margin: 0, fontSize: '20px', fontWeight: 700 }}>
            {L('Dataverse Monitor', 'Monitor de Dataverse')} <span style={{ fontSize: '12px', color: textSub, fontWeight: 600 }}>{MONITOR_VERSION}</span>
          </h1>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px' }}>
            {L('Checks every hub table: is it there, can you read it, how many rows, and are the needed columns there.', 'Revisa cada tabla del hub: si existe, si la puede leer, cuantas filas tiene y si estan las columnas necesarias.')}
          </div>
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
          <span style={{ ...pill(online ? 'green' : 'amber'), fontSize: '12px', padding: '6px 12px' }}>
            {online ? L('Connected: ', 'Conectado: ') + conn.routes.join(' + ') : L('Not connected - open this page inside the Power App', 'Sin conexion - abra esta pagina dentro de la Power App')}
          </span>
          <button type="button" onClick={runScan} disabled={scanning || !online} style={{ ...btn(true), cursor: scanning ? 'wait' : (online ? 'pointer' : 'not-allowed'), opacity: online ? 1 : 0.5 }}>
            {scanning ? L('Checking ', 'Revisando ') + scanDone + ' / ' + ECOSYSTEM_TABLES.length + '...' : L('Run full check', 'Revisar todo')}
          </button>
          <button type="button" onClick={() => copyText(printoutText, L('the printout', 'el reporte'))} style={btn(true, '#0284c7')}>
            {L('Copy printout', 'Copiar reporte')}
          </button>
        </div>
      </div>

      {toast && (
        <div style={{ marginBottom: '12px', padding: '10px 14px', borderRadius: '6px', background: '#065f46', color: '#ecfdf5', fontSize: '13px', fontWeight: 600 }}>{toast}</div>
      )}

      {/* Summary: how many tables are in each state */}
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px', marginBottom: '16px', alignItems: 'center' }}>
        {VERDICT_ORDER.filter(c => summary[c] > 0).map(c => {
          const tone = CODE_TONE[c];
          return (
            <span key={c} style={{ ...pill(tone), fontSize: '12px', padding: '5px 10px' }}>
              {summaryLabel(c, lang)}: {summary[c]}
            </span>
          );
        })}
        {lastScanTime && (
          <span style={{ fontSize: '12px', color: textSub }}>
            {L('Last check: ', 'Ultima revision: ') + new Date(lastScanTime).toLocaleString()}
          </span>
        )}
      </div>

      {/* Tabs */}
      <div style={{ display: 'flex', gap: '8px', marginBottom: '18px', flexWrap: 'wrap' }}>
        {[
          { id: 'audit', label: L('Tables', 'Tablas') + ' (' + ECOSYSTEM_TABLES.length + ')' },
          { id: 'printout', label: L('Printout', 'Reporte') },
          { id: 'bridges', label: L('Browser storage', 'Almacenamiento del navegador') + ' (' + STORAGE_BRIDGES.length + ')' },
          { id: 'apps', label: L('Apps', 'Apps') + ' (' + ECOSYSTEM_APPS.length + ')' },
          { id: 'manifests', label: L('Hub config', 'Hub config') + (manifests && manifests.hub ? ' (' + manifests.hub.rows.length + (manifests.hub.problems ? ', ' + manifests.hub.problems + L(' to fix', ' por corregir') : '') + ')' : '') },
          { id: 'prompts', label: L('Table maker prompt', 'Prompt para crear tablas') },
          { id: 'scancode', label: L('Scan app code', 'Escanear codigo') },
          { id: 'copy', label: L('Copy column values', 'Copiar valores') },
          { id: 'security', label: 'Security roles' + (roleData && roleData.findings ? ' (' + roleData.findings.length + ')' : '') },
          { id: 'build', label: 'Build' + (buildItems ? ' (' + buildItems.filter(b => b.kind !== 'unused').length + ')' : '') },
          { id: 'keys', label: 'Key checks' + (keyResults ? ' (' + keyResults.filter(k => (k.bad || k.err) && !(k.notMade && k.notMade.length)).length + ')' : '') }
        ].map(tab => (
          <button key={tab.id} type="button" onClick={() => setActiveTab(tab.id)} style={{ padding: '9px 16px', borderRadius: '6px', border: '1px solid ' + (activeTab === tab.id ? '#3b82f6' : borderCol), background: activeTab === tab.id ? '#1d4ed8' : bgCard, color: activeTab === tab.id ? '#ffffff' : textMain, fontWeight: 600, fontSize: '13px', cursor: 'pointer' }}>
            {tab.label}
          </button>
        ))}
      </div>

      {/* TABLES */}
      {activeTab === 'audit' && (
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: '20px', alignItems: 'flex-start' }}>
          <div style={{ flex: '1 1 300px', minWidth: 0, boxSizing: 'border-box', maxWidth: '420px', background: bgCard, borderRadius: '8px', padding: '14px', border: '1px solid ' + borderCol }}>
            <label style={{ display: 'block', fontSize: '12px', color: textSub, marginBottom: '4px' }}>{L('App:', 'App:')}</label>
            <select value={filterApp} onChange={e => setFilterApp(e.target.value)} style={{ width: '100%', padding: '7px 10px', borderRadius: '6px', background: bgSub, color: textMain, border: '1px solid ' + borderCol, fontSize: '13px', marginBottom: '8px' }}>
              <option value="all">{L('All apps', 'Todas las apps')}</option>
              {ECOSYSTEM_APPS.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
            </select>
            <div style={{ display: 'flex', gap: '6px', marginBottom: '10px' }}>
              {[['all', L('All tables', 'Todas')], ['problems', L('Only problems', 'Solo problemas')]].map(o => (
                <button key={o[0]} type="button" onClick={() => setFilterState(o[0])} style={{ ...btn(filterState === o[0]), padding: '5px 10px', fontSize: '12px' }}>{o[1]}</button>
              ))}
            </div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', maxHeight: '680px', overflowY: 'auto' }}>
              {filteredTables.length === 0 && (
                <div style={{ fontSize: '13px', color: textSub, padding: '8px' }}>{L('No tables match.', 'Ninguna tabla coincide.')}</div>
              )}
              {filteredTables.map(t => {
                const v = verdicts[t.logicalName];
                const isSel = t.logicalName === selectedSpec.logicalName;
                return (
                  <div key={t.logicalName} onClick={() => setSelectedTable(t.logicalName)} style={{ padding: '10px 12px', borderRadius: '6px', cursor: 'pointer', background: isSel ? (isDark ? '#1e3a8a' : '#dbeafe') : bgSub, border: '1px solid ' + (isSel ? '#3b82f6' : borderCol), display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px' }}>
                    <div style={{ minWidth: 0 }}>
                      <div style={{ fontSize: '13px', fontWeight: 600 }}>{esLabel(lang, t.label)}</div>
                      <div style={{ fontSize: '11px', color: textSub, fontFamily: 'Consolas, monospace', overflow: 'hidden', textOverflow: 'ellipsis' }}>{t.logicalName}</div>
                    </div>
                    <span style={pill(v.tone)}>{verdictText(v, lang)}</span>
                  </div>
                );
              })}
            </div>
            {unclaimed && unclaimed.length > 0 && (
              <div style={{ marginTop: '14px', paddingTop: '10px', borderTop: '1px solid ' + borderCol }}>
                <div style={{ fontSize: '12px', fontWeight: 700, color: textSub, marginBottom: '6px' }}>
                  {L('craa5 tables no app on this list uses', 'Tablas craa5 que ninguna app de la lista usa')} ({unclaimed.length})
                </div>
                <div style={{ fontFamily: 'Consolas, monospace', fontSize: '11px', color: textSub, lineHeight: 1.6, wordBreak: 'break-word' }}>
                  {unclaimed.map(d => d.logicalName).join(', ')}
                </div>
              </div>
            )}
          </div>

          <div style={{ flex: '2 1 420px', minWidth: 0, boxSizing: 'border-box', background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
            <div style={{ display: 'flex', flexWrap: 'wrap', justifyContent: 'space-between', alignItems: 'flex-start', gap: '10px', borderBottom: '1px solid ' + borderCol, paddingBottom: '12px', marginBottom: '14px' }}>
              <div style={{ minWidth: 0 }}>
                <h2 style={{ margin: 0, fontSize: '18px' }}>{esLabel(lang, selectedSpec.label)}</h2>
                <div style={{ fontSize: '12px', color: textSub, marginTop: '4px', fontFamily: 'Consolas, monospace', wordBreak: 'break-word' }}>
                  {selectedSpec.logicalName}
                  {selectedResult && selectedResult.entitySetName ? ' - ' + selectedResult.entitySetName : ''}
                </div>
                <div style={{ fontSize: '12px', color: textSub, marginTop: '2px' }}>
                  {esLabel(lang, selectedSpec.category)}
                  {selectedResult && selectedResult.ownership ? ' - ' + L('Owner type: ', 'Tipo de propietario: ') + selectedResult.ownership : ''}
                </div>
              </div>
              <span style={{ ...pill(selectedVerdict.tone), fontSize: '13px', padding: '5px 12px' }}>{verdictText(selectedVerdict, lang)}</span>
            </div>

            <div style={{ marginBottom: '14px', padding: '10px 12px', borderRadius: '6px', background: bgSub, border: '1px solid ' + borderCol, fontSize: '13px' }}>
              {verdictSentence(selectedResult, selectedVerdict, lang)}
              {selectedResult && selectedResult.ownership === 'UserOwned' && (
                <div style={{ marginTop: '6px', color: TONES.amber.fg }}>
                  {L('This table is User-owned: every hub role needs Read at Organization level, or people only see their own rows.', 'Esta tabla es de propiedad de usuario: cada rol del hub necesita Leer a nivel Organizacion, o cada quien solo vera sus propias filas.')}
                </div>
              )}
            </div>

            <div style={{ marginBottom: '14px' }}>
              {[['w', L('Written by:', 'Escrita por:'), selectedSpec.writers], ['r', L('Read by:', 'Leida por:'), selectedSpec.readers]].filter(g => g[2].length > 0).map(g => (
                <div key={g[0]} style={{ display: 'flex', gap: '6px', flexWrap: 'wrap', alignItems: 'center', marginBottom: '6px' }}>
                  <span style={{ fontSize: '12px', fontWeight: 600, color: textSub, minWidth: '80px' }}>{g[1]}</span>
                  {g[2].map(n => (
                    <span key={n} style={{ padding: '4px 10px', borderRadius: '999px', background: '#1e3a8a', color: '#bfdbfe', fontSize: '12px', fontWeight: 600 }}>{n}</span>
                  ))}
                </div>
              ))}
              <div style={{ fontSize: '12px', color: textSub, marginTop: '4px' }}>
                {L('Contract status: ', 'Estado en el contrato: ')}<strong>{selectedSpec.status}</strong>
                {selectedSpec.expectedOwnership ? ' - ' + L('expected owner type: ', 'tipo de propietario esperado: ') + selectedSpec.expectedOwnership : ''}
                {selectedSpec.candidates.length > 1 ? ' - ' + L('names tried in order: ', 'nombres probados en orden: ') + selectedSpec.candidates.join(', ') : ''}
              </div>
              {selectedResult && selectedResult.primaryNameAlias && (
                <div style={{ fontSize: '12px', color: textSub, marginTop: '4px' }}>
                  {L('Name column in Dataverse: ', 'Columna de nombre en Dataverse: ')}<strong>{selectedResult.primaryNameAlias}</strong>{L(' (counts as ', ' (cuenta como ') + selectedSpec.primaryName + ')'}
                </div>
              )}
              {selectedResult && selectedResult.resolvedName && selectedResult.resolvedName !== selectedSpec.logicalName && (
                <div style={{ fontSize: '12px', color: TONES.amber.fg, marginTop: '4px' }}>
                  {L('Found under the name ', 'Encontrada con el nombre ')}<strong>{selectedResult.resolvedName}</strong>
                </div>
              )}
            </div>

            {[['req', L('Required columns', 'Columnas requeridas'), selectedSpec.requiredCols], ['opt', L('Optional columns', 'Columnas opcionales'), selectedSpec.optionalCols]].filter(g => g[2].length > 0).map(g => (
              <div key={g[0]} style={{ background: bgSub, padding: '12px', borderRadius: '6px', border: '1px solid ' + borderCol, marginBottom: '12px' }}>
                <div style={{ fontSize: '13px', fontWeight: 600, marginBottom: '8px' }}>{g[1]} ({g[2].length})</div>
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
                  {g[2].map(c => {
                    const st = selectedResult ? (selectedResult.cols[c] || 'unchecked') : 'unchecked';
                    return <span key={c} title={colWord(st)} style={colChip(st)}>{c}</span>;
                  })}
                </div>
              </div>
            ))}
            <div style={{ display: 'flex', gap: '12px', flexWrap: 'wrap', fontSize: '11px', color: textSub, marginBottom: '12px' }}>
              <span><span style={colChip('present')}>{L('green', 'verde')}</span> {L('there', 'esta')}</span>
              <span><span style={colChip('missing')}>{L('red', 'rojo')}</span> {L('missing', 'falta')}</span>
              <span><span style={colChip('unchecked')}>{L('gray', 'gris')}</span> {L('not checked', 'sin revisar')}</span>
              {selectedResult && selectedResult.colSource === 'row' && (
                <span>{L('Columns read from one row: a gray column may still be there.', 'Columnas leidas de una fila: una columna gris aun puede existir.')}</span>
              )}
            </div>

            {selectedResult && selectedResult.similar && Object.keys(selectedResult.similar).length > 0 && (
              <div style={{ padding: '10px 12px', borderRadius: '6px', background: bgSub, border: '1px solid ' + borderCol, fontSize: '12px', marginBottom: '12px' }}>
                <strong>{L('Columns with a similar name in Dataverse:', 'Columnas con nombre parecido en Dataverse:')}</strong>
                {Object.keys(selectedResult.similar).map(c => (
                  <div key={c} style={{ fontFamily: 'Consolas, monospace', marginTop: '3px', wordBreak: 'break-word' }}>{c} {'=>'} {selectedResult.similar[c].join(', ')}</div>
                ))}
              </div>
            )}

            {selectedResult && selectedResult.error && (
              <div style={{ padding: '10px 12px', borderRadius: '6px', background: TONES.red.bg, color: TONES.red.fg, fontSize: '12px', fontFamily: 'Consolas, monospace', marginBottom: '12px', wordBreak: 'break-word' }}>
                {L('What Dataverse said: ', 'Lo que dijo Dataverse: ')}{selectedResult.error}
              </div>
            )}

            {selectedResult && selectedResult.state === 'found' && (
              <div style={{ background: bgSub, padding: '12px', borderRadius: '6px', border: '1px solid ' + borderCol, marginBottom: '12px' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap' }}>
                  <div style={{ fontSize: '13px', fontWeight: 600 }}>{L('Filled values per column', 'Valores llenos por columna')}</div>
                  <button type="button" disabled={!!fillBusy} onClick={() => countFilled(selectedSpec, selectedResult)} style={{ ...btn(false), padding: '5px 10px', fontSize: '12px' }}>
                    {fillBusy === selectedSpec.logicalName ? L('Counting...', 'Contando...') : L('Count filled values', 'Contar valores llenos')}
                  </button>
                </div>
                <div style={{ fontSize: '11px', color: textSub, marginTop: '4px' }}>{L('How many rows have something in each column. Counts only; no values are read. It also goes in the printout.', 'Cuantas filas tienen algo en cada columna. Solo conteos; no se leen valores. Tambien va en el reporte.')}</div>
                {fillCounts[selectedSpec.logicalName] && (
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px', marginTop: '8px' }}>
                    {Object.keys(fillCounts[selectedSpec.logicalName].cols).map(c => {
                      const f = fillCounts[selectedSpec.logicalName].cols[c];
                      const total = fillCounts[selectedSpec.logicalName].total;
                      const tone = !f || !f.ok ? 'gray' : (f.count === 0 ? 'red' : (total != null && f.count < total ? 'amber' : 'green'));
                      return <span key={c} title={f && !f.ok ? f.err : ''} style={{ ...colChip('present'), background: TONES[tone].bg, color: TONES[tone].fg }}>{c}: {f && f.ok ? f.count.toLocaleString() + (f.capped ? '+' : '') : '?'}{total != null ? ' / ' + total.toLocaleString() : ''}</span>;
                    })}
                  </div>
                )}
              </div>
            )}

            {selectedSpec.keys.length > 0 && (
              <div style={{ background: bgSub, padding: '12px', borderRadius: '6px', border: '1px solid ' + borderCol, marginBottom: '12px' }}>
                <div style={{ fontSize: '13px', fontWeight: 600, marginBottom: '8px' }}>{L('Keys that must match other tables', 'Claves que deben coincidir con otras tablas')}</div>
                {selectedSpec.keys.map(k => (
                  <div key={k.column} style={{ fontSize: '12px', fontFamily: 'Consolas, monospace', marginBottom: '3px', wordBreak: 'break-word' }}>
                    {k.column} ({k.kind}) {'=>'} {k.mustMatch}
                  </div>
                ))}
                <div style={{ fontSize: '11px', color: textSub, marginTop: '6px' }}>{L('Checking the values themselves comes in v2.3.', 'La revision de los valores llega en v2.3.')}</div>
              </div>
            )}

            <div style={{ fontSize: '12px', color: textSub }}>
              <strong>{L('Note:', 'Nota:')}</strong> {selectedSpec.notes}
            </div>
          </div>
        </div>
      )}

      {/* PRINTOUT */}
      {activeTab === 'printout' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '12px', flexWrap: 'wrap', gap: '10px' }}>
            <div>
              <h2 style={{ margin: 0, fontSize: '18px' }}>{L('Printout for a bug-hunting thread', 'Reporte para un hilo de busqueda de errores')}</h2>
              <div style={{ fontSize: '13px', color: textSub, marginTop: '4px' }}>
                {L('Table states, row counts, column names and errors. No row values, names or PINs are ever included.', 'Estados, conteos, nombres de columnas y errores. Nunca incluye valores de filas, nombres ni PIN.')}
              </div>
            </div>
            <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
              <button type="button" onClick={() => setPrintoutMode('problems')} style={btn(printoutMode === 'problems')}>{L('Problems only', 'Solo problemas')}</button>
              <button type="button" onClick={() => setPrintoutMode('full')} style={btn(printoutMode === 'full')}>{L('Every table', 'Todas las tablas')}</button>
              <button type="button" onClick={() => copyText(printoutText, L('the printout', 'el reporte'))} style={btn(true, '#059669')}>{L('Copy printout', 'Copiar reporte')}</button>
            </div>
          </div>
          <textarea readOnly value={printoutText} style={{ width: '100%', boxSizing: 'border-box', height: '540px', background: '#0f172a', color: '#a7f3d0', border: '1px solid ' + borderCol, borderRadius: '6px', padding: '12px', fontFamily: 'Consolas, monospace', fontSize: '12px' }} />
        </div>
      )}

      {/* BROWSER STORAGE (read only) */}
      {activeTab === 'bridges' && (
