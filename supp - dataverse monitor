                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      <div style={{ fontSize: '12px', color: textSub, marginTop: '8px' }}>
                        {L('App lists: ', '') + hub.expected.filter(e => e.kind === 'manifest').map(e => e.key + ' ' + (e.state === 'notyet' ? '(not yet)' : '(' + stateWord[e.state] + ')')).join(', ')}
                      </div>
                    </div>
                  );
                })()}
                <div style={{ fontSize: '14px', fontWeight: 700, margin: '14px 0 6px' }}>{L('Every row', 'Todas las filas') + ' (' + hub.rows.length + ')'}</div>
