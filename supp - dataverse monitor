          {manifests && manifests.hub && (() => {
            const hub = manifests.hub;
            const issueText = i => ({ blankkey: L('blank key', 'clave vacia'), dupkey: L('key saved more than once (apps may read the wrong one)', 'clave guardada mas de una vez (las apps pueden leer la equivocada)'), badjson: L('text is not valid JSON (the app cannot read it)', 'el texto no es JSON valido (la app no lo puede leer)'), cutoff: L('text was cut off at the column limit; raise the maximum length', 'el texto se corto en el limite de la columna; suba la longitud maxima'), emptyjson: L('no text saved', 'sin texto guardado'), nearlimit: L('within 10% of the column limit', 'a menos del 10% del limite de la columna'), unknownapp: L('manifest for an app the contract does not know', 'manifiesto de una app que el contrato no conoce'), appmismatch: L('appId inside does not match the key', 'el appId de adentro no coincide con la clave'), mbadjson: L('Manifest json is not valid JSON', 'Manifest json no es JSON valido'), mcutoff: L('Manifest json was cut off at its column limit', 'Manifest json se corto en el limite de su columna'), mnearlimit: L('Manifest json within 10% of its column limit', 'Manifest json a menos del 10% del limite de su columna') }[i] || i);
            const warnText = x => (x.warnings.indexOf('pointeronly') !== -1 ? L(' - holds only a pointer to Manifest json, which is empty or missing (add the column; the app saves the full list next time it opens)', ' - solo tiene un enlace a Manifest json, que esta vacia o no existe (agregue la columna; la app guarda la lista completa la proxima vez que abra)') : L(' - two apps write this key; the contract thread will pick one owner', ' - dos apps escriben esta clave; el hilo del contrato elegira un dueno'));
            const appName = a => APP_WRITER_NAMES[a] || a;
            const stateTone = { saved: 'green', notyet: 'gray', problem: 'red', warn: 'amber' };
            const stateWord = { saved: L('saved', 'guardada'), notyet: L('not saved yet', 'aun no guardada'), problem: L('needs a fix', 'por corregir'), warn: L('see note', 'ver nota') };
            const statusWord = { planned: L('planned', 'planeada'), inuse: L('in use today', 'en uso hoy'), legacy: L('old, not used', 'vieja, sin uso'), manifest: '' };
            return (
              <div style={{ marginBottom: '18px' }}>
                <div style={{ fontSize: '14px', fontWeight: 700, marginBottom: '6px' }}>{L('Keys the apps need', 'Claves que necesitan las apps')}</div>
                <div style={{ fontSize: '12px', color: textSub, marginBottom: '6px' }}>{L('"Not saved yet" is normal until that app saves its settings or manifest the first time.', '"Aun no guardada" es normal hasta que esa app guarde su configuracion o manifiesto la primera vez.')}</div>
                <div style={{ display: 'grid', gap: '4px' }}>
                  {hub.expected.map(e => (
                    <div key={e.key} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap', fontSize: '12px' }}>
                      <span style={{ fontFamily: 'Consolas, monospace', wordBreak: 'break-word', minWidth: 0 }}>{e.key} <span style={{ color: textSub, fontFamily: 'inherit' }}>{'- ' + appName(e.app) + (e.otherWriters.length ? ' + ' + e.otherWriters.map(appName).join(', ') : '') + (statusWord[e.status] ? ' (' + statusWord[e.status] + ')' : '')}</span></span>
                      <span style={pill(stateTone[e.state])}>{stateWord[e.state]}</span>
                    </div>
                  ))}
                </div>
                <div style={{ fontSize: '14px', fontWeight: 700, margin: '14px 0 6px' }}>{L('Every row', 'Todas las filas') + ' (' + hub.rows.length + ')'}</div>
                {hub.rows.length === 0 && <div style={{ fontSize: '13px', color: textSub }}>{L('Hub config has no rows yet.', 'Hub config aun no tiene filas.')}</div>}
                <div style={{ display: 'grid', gap: '4px' }}>
                  {hub.rows.map((x, i) => (
                    <div key={x.key + '-' + i} style={{ fontSize: '12px', fontFamily: 'Consolas, monospace', wordBreak: 'break-word', color: x.issues.length ? textMain : textSub }}>
                      {(x.key || L('(blank key)', '(clave vacia)')) + ' - ' + x.len.toLocaleString() + L(' chars', ' caracteres') + (x.json === 'ok' ? ' - JSON ok' : '') + (x.stub ? L(' (pointer)', ' (enlace)') : '') + (x.mLen ? ' - Manifest json ' + x.mLen.toLocaleString() + L(' chars', ' caracteres') + (x.mjson === 'ok' ? ' - JSON ok' : '') : '')}
                      {x.kind === 'legacy' && <span style={{ color: textSub }}>{L(' - old key, no app uses it (safe to leave)', ' - clave vieja, ninguna app la usa (se puede dejar)')}</span>}
                      {x.warnings.length > 0 && !x.issues.length && <span style={{ color: TONES.amber.fg }}>{warnText(x)}</span>}
                      {x.kind === 'unlisted' && x.key && <span style={{ color: TONES.amber.fg }}>{L(' - not on the contract list (tell the contract thread)', ' - no esta en la lista del contrato (avise al hilo del contrato)')}</span>}
                      {x.issues.length > 0 && <span style={{ color: TONES.red.fg }}>{' - ' + x.issues.map(issueText).join('; ')}</span>}
                    </div>
                  ))}
                </div>
                {hub.claims.length > 0 && (
                  <div style={{ marginTop: '10px' }}>
                    {hub.claims.map(c => (
                      <div key={c.appId + c.key} style={{ fontSize: '12px', color: TONES.red.fg }}>
                        {appName(c.appId) + L(' says it writes ', ' dice que escribe ') + c.key + ': ' + (c.issue === 'otherapp' ? L('that key belongs to ', 'esa clave es de ') + appName(c.owner) : L('the contract does not list that key', 'el contrato no lista esa clave'))}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            );
          })()}
          <div style={{ fontSize: '14px', fontWeight: 700, marginBottom: '4px' }}>{L('App manifests: what each app says it needs', 'Manifiestos: lo que cada app dice que necesita')}</div>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            {L('Each app saves a short list of the tables and columns it reads and writes (its manifest) in Hub config when its version changes. This tab checks every list against Dataverse, so a new app version is checked without changing this page.', 'Cada app guarda una lista corta de las tablas y columnas que lee y escribe (su manifiesto) en Hub config cuando cambia de version. Esta pestana revisa cada lista contra Dataverse, asi una version nueva se revisa sin cambiar esta pagina.')}
          </div>
          {!manifests && <div style={{ fontSize: '13px', color: textSub }}>{L('Run a check first.', 'Primero haga una revision.')}</div>}
          {manifests && manifests.state !== 'ok' && (
            <div style={{ fontSize: '13px', color: TONES.amber.fg }}>
              {manifests.state === 'missing' ? L('The Hub config table was not found.', 'No se encontro la tabla Hub config.') : (manifests.state === 'denied' ? L('Your role cannot read Hub config.', 'Su rol no puede leer Hub config.') : L('Could not read Hub config.', 'No se pudo leer Hub config.'))}
              {manifests.err ? ' (' + manifests.err + ')' : ''}
            </div>
          )}
          {manifests && manifests.state === 'ok' && (
            <div>
              <div style={{ fontSize: '12px', color: textSub, marginBottom: '10px' }}>
                {L('Read from ', 'Leido de ') + manifests.table + ' - ' + L('config text column holds up to ', 'la columna de texto acepta hasta ') + (manifests.maxLen != null ? manifests.maxLen.toLocaleString() : L('(could not tell)', '(no se pudo saber)')) + L(' characters', ' caracteres') + (manifests.ownership ? ' - ' + L('owner type: ', 'tipo de propietario: ') + manifests.ownership : '')}
              </div>
              {manifests.ownership === 'UserOwned' && (
                <div style={{ fontSize: '12px', color: textSub, marginBottom: '10px' }}>
                  {L('Hub config is User-owned: every hub role needs Read at Organization level, and Write at Organization level for a newer app version to replace a manifest someone else saved.', 'Hub config es de propiedad de usuario: cada rol del hub necesita Leer a nivel Organizacion, y Escribir a nivel Organizacion para que una version nueva reemplace un manifiesto que guardo otra persona.')}
                </div>
              )}
              {manifests.apps.length === 0 && (
                <div style={{ fontSize: '13px', color: textSub }}>{L('No app has saved a manifest yet. Ganttly will be the first.', 'Ninguna app ha guardado un manifiesto todavia. Ganttly sera la primera.')}</div>
              )}
              <div style={{ display: 'grid', gap: '12px' }}>
                {manifests.apps.map(a => {
                  const c = a.check;
                  const tone = a.error ? 'red' : (a.stub ? 'amber' : (c && c.problems ? 'amber' : (c && c.unsure ? 'gray' : 'green')));
                  const word = a.error ? L('Unreadable list', 'Lista ilegible') : a.stub ? L('List not readable here (pointer only)', 'Lista no legible aqui (solo enlace)') : (c && c.problems ? c.problems + L(' table(s) need a look', ' tabla(s) por revisar') : (c && c.unsure ? L('Some columns not checked', 'Algunas columnas sin revisar') : L('Everything it needs is there', 'Todo lo que necesita existe')));
                  return (
                    <div key={a.key} style={{ background: bgSub, padding: '14px', borderRadius: '6px', border: '1px solid ' + borderCol }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap', marginBottom: '6px' }}>
                        <div>
                          <div style={{ fontSize: '14px', fontWeight: 700 }}>{a.app}{a.version ? ' ' + a.version : ''}</div>
                          <div style={{ fontSize: '11px', color: textSub }}>
                            {L('Saved ', 'Guardado ') + (a.savedAt ? new Date(a.savedAt).toLocaleString() : (a.modifiedOn ? new Date(a.modifiedOn).toLocaleString() : '?'))}
                            {a.contract ? ' - ' + L('built on contract ', 'hecha con contrato ') + a.contract + (a.contract !== CONTRACT_VERSION ? L(' (monitor has ', ' (el monitor tiene ') + CONTRACT_VERSION + ')' : '') : ''}
                          </div>
                        </div>
                        <span style={pill(tone)}>{word}</span>
                      </div>
                      {a.error && <div style={{ fontSize: '12px', color: TONES.red.fg }}>{a.error}</div>}
                      {a.stub && <div style={{ fontSize: '12px', color: TONES.amber.fg }}>{L('The app saved its list in ' + a.pointer + ', which is empty or not on the table. Add the Manifest json column (see the note at the top); the app fills it the next time it opens.', 'La app guardo su lista en ' + a.pointer + ', que esta vacia o no existe en la tabla. Agregue la columna Manifest json (vea la nota arriba); la app la llena la proxima vez que abra.')}</div>}
                      {!a.stub && !a.error && a.source === 'craa5_manifestjson' && <div style={{ fontSize: '11px', color: textSub }}>{L('Read from Manifest json', 'Leido de Manifest json')}</div>}
                      {c && c.tables.map(t => {
                        const ok = t.state === 'found' && !t.missingRead.length && !t.missingWrite.length && !t.unchecked.length && !t.contractNotes.length;
                        const noteText = n => (n === 'notincontract' ? L('not in the contract', 'no esta en el contrato') : (n === 'notwriter' ? L('writes here but the contract does not list it as a writer', 'escribe aqui pero el contrato no la lista como escritora') : (n === 'status:abandoned' ? L('table is abandoned in the contract', 'tabla abandonada en el contrato') : (n === 'status:absent' ? L('table is absent in the contract', 'tabla ausente en el contrato') : n))));
                        return (
                          <div key={t.t} style={{ fontSize: '12px', fontFamily: 'Consolas, monospace', marginTop: '3px', wordBreak: 'break-word', color: ok ? textSub : textMain }}>
                            {t.t}{t.foundAs && t.foundAs !== t.t ? ' (' + L('as ', 'como ') + t.foundAs + ')' : ''}: {t.state === 'found' ? (ok ? L('ok', 'ok') : '') : (t.state === 'missing' ? L('TABLE MISSING', 'FALTA LA TABLA') : (t.state === 'denied' ? L('no permission', 'sin permiso') : L('could not tell', 'no se pudo saber')))}
                            {t.missingWrite.length > 0 && <span style={{ color: TONES.red.fg }}>{L(' missing (writes): ', ' faltan (escribe): ') + t.missingWrite.join(', ')}</span>}
                            {t.missingRead.length > 0 && <span style={{ color: TONES.amber.fg }}>{L(' missing (reads): ', ' faltan (lee): ') + t.missingRead.join(', ')}</span>}
                            {t.unchecked.length > 0 && <span style={{ color: textSub }}>{L(' not checked: ', ' sin revisar: ') + t.unchecked.join(', ')}</span>}
                            {t.notYet.length > 0 && <span style={{ color: textSub }}>{L(' not yet (app works without): ', ' aun no (la app funciona sin ellas): ') + t.notYet.join(', ')}</span>}
                            {t.contractNotes.length > 0 && <span style={{ color: TONES.amber.fg }}>{' - ' + t.contractNotes.map(noteText).join('; ')}</span>}
                          </div>
                        );
                      })}
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )}

      {/* TABLE MAKER: one card per table */}
      {activeTab === 'prompts' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>{L('Tables and columns to make', 'Tablas y columnas por crear')}</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            {L('One table at a time. Paste a create prompt into the Copilot table maker by itself. Missing columns on a table that already exists are faster to add by hand (Tables - the table - New column), because Copilot does not edit tables well. If Dataverse says a name is too similar to one that exists, tell this thread; the existing column is usually the one to keep.', 'Una tabla a la vez. Pegue cada prompt solo en el creador de tablas de Copilot. Las columnas que faltan en una tabla existente se agregan mas rapido a mano (Tablas - la tabla - Nueva columna), porque Copilot no edita bien las tablas. Si Dataverse dice que un nombre se parece demasiado a uno existente, aviselo en este hilo; casi siempre se queda la columna existente.')}
          </div>
          {promptCards.length === 0 && (
            <div style={{ fontSize: '13px', color: textSub }}>{Object.keys(tableResults).length ? L('Nothing to make: no live table or required column is missing.', 'Nada por crear: no falta ninguna tabla activa ni columna requerida.') : L('Run a check first.', 'Primero haga una revision.')}</div>
          )}
          <div style={{ display: 'grid', gap: '12px' }}>
            {promptCards.map(c => (
              <div key={c.key} style={{ background: bgSub, padding: '14px', borderRadius: '6px', border: '1px solid ' + borderCol }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap', marginBottom: '8px' }}>
                  <div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>{esLabel(lang, c.table.label)}</div>
                    <div style={{ fontSize: '11px', color: textSub, fontFamily: 'Consolas, monospace' }}>{c.table.logicalName}{c.table.status === 'proposed' ? ' - ' + L('proposed', 'propuesta') : ''}</div>
                  </div>
                  {c.kind === 'create' ? (
                    <button type="button" onClick={() => copyText(c.text, L('the prompt', 'el prompt'))} style={btn(true, '#059669')}>{L('Copy prompt', 'Copiar prompt')} ({c.text.length} {L('chars', 'caracteres')})</button>
                  ) : (
                    <span style={pill('amber')}>{L('Add by hand', 'Agregar a mano')}</span>
                  )}
                </div>
                {c.kind === 'create' ? (
                  <div style={{ fontFamily: 'Consolas, monospace', fontSize: '12px', lineHeight: 1.5, wordBreak: 'break-word' }}>{c.text}</div>
                ) : (
                  <div style={{ fontSize: '12px' }}>
                    {c.cols.map(col => (
                      <div key={col} style={{ marginBottom: '4px', wordBreak: 'break-word' }}>
                        <span style={{ fontFamily: 'Consolas, monospace' }}>{L('Display name ', 'Nombre para mostrar ') + colDisplay(col)} ({colTypeGuess(col)})</span>
                        {c.similar[col] && <span style={{ color: TONES.amber.fg }}>{L(' - already there with a similar name: ', ' - ya existe con nombre parecido: ') + c.similar[col].join(', ') + L('. Keep that one and skip this.', '. Use esa y omita esta.')}</span>}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
