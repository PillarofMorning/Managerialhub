                        return (
                          <div key={t.t} style={{ fontSize: '12px', fontFamily: 'Consolas, monospace', marginTop: '3px', wordBreak: 'break-word', color: ok ? textSub : textMain }}>
                            {t.t}{t.foundAs && t.foundAs !== t.t ? ' (' + L('as ', 'como ') + t.foundAs + ')' : ''}: {t.state === 'found' ? (ok ? L('ok', 'ok') : '') : (t.state === 'missing' ? L('TABLE MISSING', 'FALTA LA TABLA') : (t.state === 'denied' ? L('no permission', 'sin permiso') : L('could not tell', 'no se pudo saber')))}
                            {t.missingWrite.length > 0 && <span style={{ color: TONES.red.fg }}>{L(' missing (writes): ', ' faltan (escribe): ') + t.missingWrite.join(', ')}</span>}
                            {t.missingRead.length > 0 && <span style={{ color: TONES.amber.fg }}>{L(' missing (reads): ', ' faltan (lee): ') + t.missingRead.join(', ')}</span>}
                            {t.unchecked.length > 0 && <span style={{ color: textSub }}>{L(' not checked: ', ' sin revisar: ') + t.unchecked.join(', ')}</span>}
                            {t.notYet.length > 0 && <span style={{ color: textSub }}>{L(' not yet (app works without): ', ' aun no (la app funciona sin ellas): ') + t.notYet.join(', ')}</span>}
                            {t.contractNotes.length > 0 && <span style={{ color: TONES.amber.fg }}>{' - ' + t.contractNotes.map(noteText).join('; ') + (t.notAllowed ? ': ' + t.notAllowed.join(', ') : '')}</span>}
                          </div>
                        );
                      })}
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      )}

      {/* SCAN APP CODE: tables and columns an app names, checked and (optionally) watched */}
      {activeTab === 'scancode' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>{L('Scan an app\'s code', 'Escanear el codigo de una app')}</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            {L('Paste an app\'s code (or load its .txt file). The monitor finds every craa5 table and column the code names, checks them in Dataverse, and writes one short Copilot prompt per missing table. Save the scan and every later check watches that app, with no change to this page. Only table and column names are saved, never the code. Columns the code names that no table has are given to the nearest table in the code: that part is a guess, check it before you make the column.', 'Pegue el codigo de una app (o cargue su archivo .txt). El monitor encuentra cada tabla y columna craa5 que nombra el codigo, las revisa en Dataverse y escribe un prompt corto de Copilot por cada tabla que falta. Guarde el escaneo y cada revision siguiente vigila esa app, sin cambiar esta pagina. Solo se guardan nombres de tablas y columnas, nunca el codigo. Las columnas que ninguna tabla tiene se asignan a la tabla mas cercana en el codigo: eso es una suposicion, revisela antes de crear la columna.')}
          </div>
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'center', marginBottom: '8px' }}>
            <select value={scanApp} onChange={e => setScanApp(e.target.value)} style={{ padding: '7px 10px', borderRadius: '6px', background: bgSub, color: textMain, border: '1px solid ' + borderCol, fontSize: '13px', maxWidth: '100%' }}>
              <option value="">{L('Which app is this?', 'Que app es?')}</option>
              {CONTRACT_APP_IDS.map(a => <option key={a} value={a}>{APP_WRITER_NAMES[a] || a}</option>)}
              <option value="other">{L('Other (type a name)', 'Otra (escriba un nombre)')}</option>
            </select>
            {scanApp === 'other' && <input value={scanOther} onChange={e => setScanOther(e.target.value)} placeholder={L('App name', 'Nombre de la app')} style={{ padding: '7px 10px', borderRadius: '6px', background: bgSub, color: textMain, border: '1px solid ' + borderCol, fontSize: '13px', minWidth: 0 }} />}
            <input type="file" accept=".txt,.js,.jsx,.ts,.tsx,.html" onChange={e => { const f = e.target.files && e.target.files[0]; if (!f) return; const fr = new FileReader(); fr.onload = () => setScanCode(String(fr.result || '')); fr.readAsText(f); }} style={{ fontSize: '12px', color: textSub, maxWidth: '100%' }} />
          </div>
          <textarea value={scanCode} onChange={e => setScanCode(e.target.value)} placeholder={L('Paste the app code here', 'Pegue aqui el codigo de la app')} style={{ width: '100%', boxSizing: 'border-box', height: '140px', background: bgSub, color: textMain, border: '1px solid ' + borderCol, borderRadius: '6px', padding: '10px', fontFamily: 'Consolas, monospace', fontSize: '12px' }} />
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginTop: '8px', alignItems: 'center' }}>
            <button type="button" disabled={!scanCode.trim() || scanBusy} onClick={runCodeScan} style={btn(true)}>{scanBusy ? L('Scanning...', 'Escaneando...') : L('Scan code', 'Escanear codigo')}</button>
            {scanResult && <button type="button" disabled={!scanAppId || !manifests || !manifests.table} onClick={saveCodeScan} style={btn(true, '#059669')}>{L('Save scan so every check watches this app', 'Guardar para que cada revision vigile esta app')}</button>}
            {scanResult && !scanAppId && <span style={{ fontSize: '12px', color: TONES.amber.fg }}>{L('Pick the app first.', 'Primero elija la app.')}</span>}
            {scanSaved && <span style={{ fontSize: '12px', color: /^(Could|No se)/.test(scanSaved) ? TONES.red.fg : textSub }}>{scanSaved}</span>}
          </div>
          {scanResult && (
            <div style={{ marginTop: '14px' }}>
              <div style={{ fontSize: '13px', color: textSub, marginBottom: '8px' }}>{L('Found ', 'Se encontraron ') + scanResult.tokenTables + L(' tables and ', ' tablas y ') + scanResult.tokenCols + L(' column names.', ' nombres de columna.')}</div>
              <div style={{ display: 'grid', gap: '10px' }}>
                {scanCards.map(c => {
                  const tone = c.state === 'missing' ? 'red' : (c.state === 'denied' ? 'purple' : (c.state === 'found' ? (c.missing.length ? 'amber' : 'green') : 'gray'));
                  const word = c.state === 'missing' ? L('Table missing', 'Falta la tabla') : (c.state === 'denied' ? L('No permission', 'Sin permiso') : (c.state === 'found' ? (c.missing.length ? c.missing.length + L(' column(s) missing', ' columna(s) faltan') : (c.checked ? L('Everything there', 'Todo existe') : L('Columns not checked', 'Columnas sin revisar'))) : L('Could not tell', 'No se pudo saber')));
                  return (
                    <div key={c.t} style={{ background: bgSub, padding: '12px', borderRadius: '6px', border: '1px solid ' + borderCol }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap' }}>
                        <span style={{ fontFamily: 'Consolas, monospace', fontSize: '13px', fontWeight: 700, wordBreak: 'break-word', minWidth: 0 }}>{c.t}</span>
                        <span style={pill(TONES[tone] ? tone : 'gray')}>{word}</span>
                      </div>
                      {c.have.length > 0 && <div style={{ fontSize: '12px', color: textSub, marginTop: '4px', wordBreak: 'break-word' }}>{L('There: ', 'Existen: ') + c.have.join(', ')}</div>}
                      {c.missing.length > 0 && <div style={{ fontSize: '12px', color: TONES.amber.fg, marginTop: '4px', wordBreak: 'break-word' }}>{(c.state === 'missing' ? L('Columns (guessed from the code): ', 'Columnas (adivinadas del codigo): ') : L('Missing (guessed, add by hand): ', 'Faltan (adivinadas, agregue a mano): ')) + c.missing.join(', ')}</div>}
                      {c.text && <button type="button" onClick={() => copyText(c.text, L('the prompt', 'el prompt'))} style={{ ...btn(true, '#059669'), marginTop: '8px' }}>{L('Copy prompt', 'Copiar prompt')} ({c.text.length} {L('chars', 'caracteres')})</button>}
                    </div>
                  );
                })}
              </div>
              {scanResult.loose.length > 0 && <div style={{ fontSize: '12px', color: textSub, marginTop: '10px', wordBreak: 'break-word' }}>{L('Names not placed on a table (could be settings keys or text): ', 'Nombres sin tabla (pueden ser claves o texto): ') + scanResult.loose.join(', ')}</div>}
            </div>
          )}
        </div>
      )}

      {/* COPY COLUMN VALUES: one-time fill of new columns from an old one */}
      {activeTab === 'copy' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>{L('Copy one column into others', 'Copiar una columna a otras')}</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            {L('For one-time fills, like copying the old allergen clean flag into the new egg and pecan columns. Check first only reads and counts. Copy changes only the "to" columns, only where they differ, and skips rows where the "from" column is blank. This tab and saving a code scan are the only parts of the monitor that write to Dataverse.', 'Para llenados de una sola vez, como copiar la marca vieja de limpieza de alergeno a las columnas nuevas de huevo y nuez. Revisar solo lee y cuenta. Copiar cambia solo las columnas "a", solo donde son distintas, y salta filas donde la columna "de" esta vacia. Esta pestana y guardar un escaneo son las unicas partes del monitor que escriben en Dataverse.')}
          </div>
          {[[L('Table', 'Tabla'), copyTable, setCopyTable], [L('From column', 'De la columna'), copyFrom, setCopyFrom], [L('To columns (comma between)', 'A las columnas (separe con coma)'), copyTo, setCopyTo]].map(f => (
            <label key={f[0]} style={{ display: 'block', fontSize: '12px', color: textSub, marginBottom: '8px' }}>{f[0]}
              <input value={f[1]} onChange={e => { f[2](e.target.value); setCopyPlan(null); setCopyConfirm(false); }} style={{ display: 'block', width: '100%', boxSizing: 'border-box', marginTop: '3px', padding: '7px 10px', borderRadius: '6px', background: bgSub, color: textMain, border: '1px solid ' + borderCol, fontSize: '13px', fontFamily: 'Consolas, monospace' }} />
            </label>
          ))}
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'center' }}>
            <button type="button" disabled={!!copyBusy} onClick={planCopy} style={btn(false)}>{L('Check first', 'Revisar primero')}</button>
            {copyPlan && copyPlan.changes && copyPlan.changes.length > 0 && !copyConfirm && <button type="button" disabled={!!copyBusy} onClick={() => setCopyConfirm(true)} style={btn(true, '#b45309')}>{L('Copy to ', 'Copiar a ') + copyPlan.changes.length + L(' rows', ' filas')}</button>}
            {copyPlan && copyPlan.changes && copyPlan.changes.length > 0 && copyConfirm && <button type="button" disabled={!!copyBusy} onClick={runCopy} style={btn(true, '#b91c1c')}>{L('Yes, change ' + copyPlan.changes.length + ' rows in ' + copyPlan.table, 'Si, cambiar ' + copyPlan.changes.length + ' filas')}</button>}
            {copyConfirm && <button type="button" onClick={() => setCopyConfirm(false)} style={btn(false)}>{L('Cancel', 'Cancelar')}</button>}
            {copyBusy && <span style={{ fontSize: '12px', color: textSub }}>{copyBusy}</span>}
          </div>
          {copyPlan && copyPlan.err && <div style={{ fontSize: '13px', color: TONES.red.fg, marginTop: '10px' }}>{copyPlan.err}</div>}
          {copyPlan && copyPlan.changes && (
            <div style={{ fontSize: '13px', marginTop: '10px' }}>
              {copyPlan.total + L(' rows read. ', ' filas leidas. ') + copyPlan.changes.length + L(' will change. ', ' van a cambiar. ') + copyPlan.skippedBlank + L(' skipped because ', ' se saltan porque ') + copyPlan.from + L(' is blank.', ' esta vacia.')}
              {copyPlan.cannot > 0 && <span style={{ color: TONES.amber.fg }}>{' ' + copyPlan.cannot + ' left out because the value does not fit the target column.'}</span>}
              {Object.keys(copyPlan.types || {}).length > 0 && <div style={{ fontSize: '12px', color: textSub, marginTop: '4px' }}>{'Column types: ' + [copyPlan.from].concat(copyPlan.to).map(c => c + ' ' + (TYPE_WORDS[copyPlan.types[c]] || copyPlan.types[c] || 'unknown')).join(', ') + '.'}</div>}
              {copyPlan.toFlag && copyPlan.toFlag.length > 0 && <div style={{ fontSize: '12px', color: TONES.amber.fg, marginTop: '4px' }}>{copyPlan.toFlag.join(' and ') + (copyPlan.toFlag.length > 1 ? ' are' : ' is') + ' Yes/No, so it will be set to Yes where ' + copyPlan.from + ' is above 0 and No where it is 0. To copy the minutes themselves, copy into Whole number columns instead (for example craa5_eggminutes and craa5_pecanminutes).'}</div>}
              {copyPlan.changes.length === 0 && <span style={{ color: TONES.green.fg }}>{L(' Nothing to copy: the columns already match.', ' Nada que copiar: las columnas ya coinciden.')}</span>}
            </div>
          )}
          {copyDone && (
            <div style={{ fontSize: '13px', marginTop: '10px', color: copyDone.failed.length ? TONES.red.fg : TONES.green.fg }}>
              {L('Done: ', 'Listo: ') + (copyDone.done - copyDone.failed.length) + L(' rows changed', ' filas cambiadas') + (copyDone.failed.length ? L(', ', ', ') + copyDone.failed.length + L(' failed (first error: ', ' fallaron (primer error: ') + copyDone.failed[0] + ')' : '') + L('. Press Check first again to confirm.', '. Presione Revisar primero otra vez para confirmar.')}
            </div>
          )}
        </div>
      )}

      {/* SECURITY ROLES */}
      {activeTab === 'security' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>Security roles</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            Which roles can read (R), write (W) and create (C) each hub table, and how far: User = own rows only, BU = business unit, Org = everyone's rows. Read only. Needs a role that may read security roles (System Customizer or System Administrator); otherwise it says no permission.
          </div>
          <button type="button" disabled={roleBusy || !Object.keys(tableResults).length} onClick={readRoles} style={btn(true)}>{roleBusy ? 'Reading...' : 'Read security roles'}</button>
          {roleData && roleData.state !== 'ok' && <div style={{ fontSize: '13px', color: TONES.amber.fg, marginTop: '10px' }}>{(roleData.state === 'denied' ? 'Your role cannot read security roles. ' : 'Could not read security roles. ') + roleData.err}</div>}
          {roleData && roleData.state === 'ok' && (
            <div style={{ marginTop: '12px' }}>
              <div style={{ fontSize: '12px', color: textSub, marginBottom: '8px' }}>{'Your roles: ' + (roleData.mine.length ? roleData.mine.join(', ') : '(could not tell)') + '. Roles with hub table rights: ' + (roleData.hubRoles.length ? roleData.hubRoles.map(r => r.name).join(', ') : 'none yet, so only administrators can use the hub tables') + '.'}</div>
              {roleData.builtin.length > 0 && <div style={{ fontSize: '12px', color: textSub, marginBottom: '8px' }}>{'Left out (built into Dataverse, not used by hub staff): ' + roleData.builtin.join(', ') + '.'}</div>}
              {roleData.findings.length > 0 && (
                <div style={{ marginBottom: '12px' }}>
                  {roleData.findings.map((f, i) => (
                    <div key={i} style={{ fontSize: '12px', marginBottom: '3px', color: f.kind === 'noread' ? TONES.red.fg : TONES.amber.fg }}>
                      <span style={{ fontFamily: 'Consolas, monospace' }}>{f.table}</span>
                      {f.kind === 'noread' ? ': no hub role can read it (only administrators see it)' : (f.kind === 'nowrite' ? ': no role can write or create rows, but an app saves here' : ': owned by user, and these roles read only their own rows, so they miss other people\'s: ' + f.roles.join(', '))}
                    </div>
                  ))}
                </div>
              )}
              <div style={{ overflowX: 'auto' }}>
                <table style={{ borderCollapse: 'collapse', fontSize: '11px', minWidth: '100%' }}>
                  <thead>
                    <tr>
                      <th style={{ textAlign: 'left', padding: '4px 6px', borderBottom: '1px solid ' + borderCol, position: 'sticky', left: 0, background: bgCard }}>Table</th>
                      {roleData.roles.filter(r => !dvIsBuiltinRole(r.name, r.managed)).map(r => <th key={r.id} style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, whiteSpace: 'nowrap', color: roleData.mine.indexOf(r.name) !== -1 ? '#60a5fa' : textMain }}>{r.name}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {roleData.tables.map(t => (
                      <tr key={t.resolved}>
                        <td style={{ padding: '3px 6px', borderBottom: '1px solid ' + borderCol, fontFamily: 'Consolas, monospace', position: 'sticky', left: 0, background: bgCard, whiteSpace: 'nowrap' }}>{t.resolved}</td>
                        {roleData.roles.filter(r => !dvIsBuiltinRole(r.name, r.managed)).map(r => {
                          const p = r.privs[t.resolved] || {};
                          const txt = ['Read', 'Write', 'Create'].filter(op => p[op]).map(op => op[0] + ':' + p[op]).join(' ');
                          return <td key={r.id} style={{ padding: '3px 6px', borderBottom: '1px solid ' + borderCol, whiteSpace: 'nowrap', color: txt ? textMain : textSub }}>{txt || '-'}</td>;
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      )}

      {/* BUILD LIST */}
      {activeTab === 'build' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>Build list</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            The monitor is the one table builder: apps only say what they need in their saved lists, and the contract decides each column's type. This list compares both with Dataverse and says what to make or change. It is read only for now; the build buttons come next. Types marked guessed come from the column name, because no app or contract entry gave one yet.
          </div>
          <button type="button" disabled={!!buildBusy || !Object.keys(tableResults).length || !manifests} onClick={runBuildList} style={btn(true)}>{buildBusy || 'Make build list'}</button>
          {buildItems && buildItems.length === 0 && <div style={{ fontSize: '13px', color: TONES.green.fg, marginTop: '12px' }}>Nothing to build: every table and column the contract and the apps name is there with the right type.</div>}
          {buildItems && buildItems.length > 0 && (
            <div style={{ marginTop: '12px' }}>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px', marginBottom: '12px' }}>
                {Object.keys(BUILD_KIND_WORDS).filter(k => buildItems.some(b => b.kind === k)).map(k => <span key={k} style={pill(k === 'conflict' || k === 'type' ? 'red' : (k === 'unused' || k === 'unread' ? 'gray' : 'amber'))}>{BUILD_KIND_WORDS[k] + ': ' + buildItems.filter(b => b.kind === k).length}</span>)}
              </div>
              {Array.from(new Set(buildItems.map(b => b.t))).map(t => (
                <div key={t} style={{ background: bgSub, borderRadius: '6px', padding: '10px 12px', marginBottom: '8px', border: '1px solid ' + borderCol }}>
                  <div style={{ fontFamily: 'Consolas, monospace', fontSize: '13px', fontWeight: 700, marginBottom: '6px', wordBreak: 'break-word' }}>{t}</div>
                  {buildItems.filter(b => b.t === t).map((b, i) => (
                    <div key={i} style={{ fontSize: '12px', marginBottom: '4px', wordBreak: 'break-word' }}>
                      <span style={pill(b.kind === 'conflict' || b.kind === 'type' ? 'red' : (b.kind === 'unused' || b.kind === 'unread' ? 'gray' : 'amber'))}>{BUILD_KIND_WORDS[b.kind]}</span>
                      {b.col && <span style={{ fontFamily: 'Consolas, monospace' }}>{' ' + b.col}</span>}
                      <span style={{ color: textSub }}>{' ' + b.text}</span>
                      {b.kind === 'table' && <div style={{ marginTop: '4px', color: textSub }}>{'Name column ' + b.primary.n + ' (' + (b.primary.len || 200) + '). Columns: ' + b.cols.map(c => c.col + ' ' + dvTypeWord(c.spec) + (c.spec.source === 'guess' ? '?' : '')).join(', ')}</div>}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* KEY CHECKS */}
      {activeTab === 'keys' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>Key checks between apps</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            The contract says some columns must match another table (for example an asset's area name must be an area in the MSS area table). This counts the rows whose value is not found there. For places and things (areas, rooms, items, SAP work areas, vendors, equipment ids) up to 3 unmatched values are shown so you can tell typos from sample rows; values from people columns are never shown. A pair whose column has not been made yet says so instead of failing. Area and room names are compared ignoring case, spaces and punctuation; ids are compared exactly. Reads up to 20,000 rows per table.
          </div>
          <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap' }}>
            <button type="button" disabled={!!keyBusy || !Object.keys(tableResults).length} onClick={runKeyChecks} style={btn(true)}>{keyBusy || 'Check keys'}</button>
          </div>
          {keyResults && (
            <div style={{ overflowX: 'auto', marginTop: '12px' }}>
              <table style={{ borderCollapse: 'collapse', fontSize: '12px', width: '100%', minWidth: '600px' }}>
                <thead>
                  <tr style={{ textAlign: 'left', color: textSub }}>
                    {['Column', 'Must match', 'Rows', 'Blank', 'Not found', 'Result'].map(h => <th key={h} style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, fontWeight: 600 }}>{h}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {keyResults.map((k, i) => {
                    const notMade = k.notMade && k.notMade.length;
                    const tone = notMade || k.err ? 'gray' : (k.bad ? 'amber' : (k.targetEmpty ? 'gray' : 'green'));
                    const word = notMade ? 'column not made yet' : (k.err ? 'could not read' : (k.bad ? k.bad + ' rows (' + k.badDistinct + ' values) not found' : (k.targetEmpty ? 'target empty' : 'all match')));
                    const extra = notMade ? ' ' + k.notMade.join(', ') : (k.err ? ' ' + k.err : ((k.examples && k.examples.length ? ' e.g. ' + k.examples.map(x => '"' + x + '"').join(', ') : '') + (dvKeyLooksLikeSamples(k) ? ' (only a few: maybe the sample rows the Copilot table maker adds)' : '')));
                    return (
                      <tr key={i}>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, fontFamily: 'Consolas, monospace', wordBreak: 'break-word' }}>{k.from + '.' + k.col}</td>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, fontFamily: 'Consolas, monospace', wordBreak: 'break-word' }}>{k.to + '.' + k.toCol}</td>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol }}>{k.err || notMade ? '-' : k.rows + (k.capped ? '+' : '')}</td>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol }}>{k.err || notMade ? '-' : k.blank}</td>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol }}>{k.err || notMade ? '-' : k.bad}</td>
                        <td style={{ padding: '4px 6px', borderBottom: '1px solid ' + borderCol, wordBreak: 'break-word' }}><span style={pill(tone)}>{word}</span>{extra ? <span style={{ color: textSub }}>{extra}</span> : null}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              {keyResults.length === 0 && <div style={{ fontSize: '13px', color: textSub }}>No key pairs to check yet: both tables of a pair must be found first.</div>}
            </div>
          )}
        </div>
      )}

      {/* TABLE MAKER: one card per table */}
      {activeTab === 'prompts' && (
        <div style={{ background: bgCard, borderRadius: '8px', padding: '18px', border: '1px solid ' + borderCol }}>
          <h2 style={{ margin: 0, fontSize: '18px' }}>{L('Tables and columns to make', 'Tablas y columnas por crear')}</h2>
          <div style={{ fontSize: '13px', color: textSub, marginTop: '4px', marginBottom: '14px' }}>
            {L('One table at a time. Paste a create prompt into the Copilot table maker by itself. Missing columns on a table that already exists are faster to add by hand (Tables - the table - New column), because Copilot does not edit tables well. If Dataverse says a name is too similar to one that exists, tell this thread; the existing column is usually the one to keep.', 'Una tabla a la vez. Pegue cada prompt solo en el creador de tablas de Copilot. Las columnas que faltan en una tabla existente se agregan mas rapido a mano (Tablas - la tabla - Nueva columna), porque Copilot no edita bien las tablas. Si Dataverse dice que un nombre se parece demasiado a uno existente, aviselo en este hilo; casi siempre se queda la columna existente.')}
          </div>
          {promptCards.length === 0 && (
            <div style={{ fontSize: '13px', color: textSub }}>{Object.keys(tableResults).length ? L('Nothing to make: no live table or required column is missing.', 'Nada por crear: no falta ninguna tabla activa ni columna requerida.') : L('Run a check first.', 'Primero haga una revision.')}</div>
          )}
          <div style={{ display: 'grid', gap: '12px' }}>
            {promptCards.map(c => (
              <div key={c.key} style={{ background: bgSub, padding: '14px', borderRadius: '6px', border: '1px solid ' + borderCol }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px', flexWrap: 'wrap', marginBottom: '8px' }}>
                  <div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>{esLabel(lang, c.table.label)}</div>
                    <div style={{ fontSize: '11px', color: textSub, fontFamily: 'Consolas, monospace' }}>{c.table.logicalName}{c.table.status === 'proposed' ? ' - ' + L('proposed', 'propuesta') : ''}</div>
                  </div>
                  {c.kind === 'create' ? (
                    <button type="button" onClick={() => copyText(c.text, L('the prompt', 'el prompt'))} style={btn(true, '#059669')}>{L('Copy prompt', 'Copiar prompt')} ({c.text.length} {L('chars', 'caracteres')})</button>
                  ) : (
                    <span style={pill('amber')}>{L('Add by hand', 'Agregar a mano')}</span>
                  )}
                </div>
                {c.kind === 'create' ? (
                  <div style={{ fontFamily: 'Consolas, monospace', fontSize: '12px', lineHeight: 1.5, wordBreak: 'break-word' }}>{c.text}</div>
                ) : (
                  <div style={{ fontSize: '12px' }}>
                    {c.cols.map(col => (
                      <div key={col} style={{ marginBottom: '4px', wordBreak: 'break-word' }}>
                        <span style={{ fontFamily: 'Consolas, monospace' }}>{L('Display name ', 'Nombre para mostrar ') + colDisplay(col)} ({colTypeGuess(col)})</span>
                        {c.similar[col] && <span style={{ color: TONES.amber.fg }}>{L(' - already there with a similar name: ', ' - ya existe con nombre parecido: ') + c.similar[col].join(', ') + L('. Keep that one and skip this.', '. Use esa y omita esta.')}</span>}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
