function ppCardParts(spec) {
    const s = spec && typeof spec === 'object' ? spec : {};
    const tk = typeof s.tableKey === 'string' ? s.tableKey : '';
    const T = ppHas(PPL_COLUMN_SPECS, tk) ? PPL_COLUMN_SPECS[tk] : null;
    const lg = typeof s.logical === 'string' ? s.logical : '';
    const state = s.state === 'unreachable' || s.state === 'unconfirmed' ? s.state : 'missing';
    const label = T ? T.label : 'this';
    const colDef = T && lg ? (T.columns.filter(c => c.logical === lg)[0] || null) : null;
    const strip = (x) => String(x).replace(/^craa5_/, '');
    const view = { missing: lg || (s.tableName || (T ? T.table : '')), heading: '', where: '', intro: '', rows: [], then: '', columns: [], footer: [], pickNote: '', tableBox: null };
    if (!T) return { title: 'Something is not set up yet', text: ['Press Check again after it is created.'], view: view };

    if (lg) {
        const ownSpec = ppHas(PP_CARD_OWN, tk + '.' + lg) ? PP_CARD_OWN[tk + '.' + lg] : null;
        const display = colDef ? colDef.display : lg;
        const aLabel = /^[AEIOU]/.test(label) ? 'an ' + label : 'a ' + label;
        view.heading = 'Create this column in Dataverse';
        view.where = '(Tables > the ' + label + ' table, ' + T.table + ' > Columns > New column):';
        view.rows = [
            { label: 'Display name', value: display },
            { label: 'Name to type', value: strip(lg), note: 'Dataverse adds craa5_ in front. If your screen differs, the full name must end up as ' + lg + '.' },
            { label: 'Type', value: ownSpec ? ownSpec.longType : ppLongType(colDef ? colDef.type : '') }
        ];
        if (ownSpec && ownSpec.dflt) view.rows.push({ label: 'Default', value: ownSpec.dflt });
        view.rows.push({ label: 'Needed for', value: ownSpec ? ownSpec.needed : (colDef ? colDef.why : ''), plain: true });
        if (ownSpec && ownSpec.please) view.rows.push({ label: 'Please', value: ownSpec.please, plain: true });
        view.pickNote = ownSpec ? ownSpec.pickNote : 'The list shows columns really found on ' + aLabel + ' row. The choice is remembered on this device only.';
        if (ownSpec) return { title: ownSpec.title, text: [ownSpec.text], view: view };
        const required = tk === 'employee' && PP_EMP_REQUIRED.indexOf(lg) > -1;
        return {
            title: display + ' column is not set up yet',
            text: [required ? 'The ' + label + ' table has no "' + display + '" column. The People tab can\'t work without this column.' : 'The ' + label + ' table has no "' + display + '" column, ' + ppAfterSentence(tk, lg)],
            view: view
        };
    }

    const ownSpec = ppHas(PP_TABLE_OWN, tk) ? PP_TABLE_OWN[tk] : null;
    const current = typeof s.tableName === 'string' && s.tableName.trim() ? s.tableName.trim() : T.table;
    const names = ppHas(PPL_TABLES, tk) && Array.isArray(PPL_TABLES[tk]) ? PPL_TABLES[tk] : [T.table];
    const others = names.filter(n => n !== current);
    view.missing = current;
    view.tableBox = { label: 'My table is called', value: current, note: (others.length ? 'The page also tries ' + others.join(' and ') + '.' : '') + (ownSpec && ownSpec.boxNote ? ' ' + ownSpec.boxNote : '') };
    const still = ownSpec ? ownSpec.still : 'Everything else here still works.';
    if (state === 'unreachable') {
        return { title: 'This page cannot see the new table yet.', text: ['Dataverse may have the "' + label + '" table, but this page cannot reach it. ' + still, 'Ask whoever registered this page how the table craa5_shiftpreset was made visible to it.'], view: view };
    }
    if (state === 'unconfirmed') {
        return { title: 'Found (no rows yet), not confirmed until the first save.', text: ['The "' + label + '" table answers, but it has no rows yet, so this page cannot check its columns until the first save. ' + still], view: view };
    }
    if (!ownSpec) {
        return { title: label + ' table is not set up yet', text: ['Dataverse has no table called "' + label + '" (or this page cannot see it). ' + still], view: view };
    }
    view.intro = ownSpec.intro;
    view.heading = 'Create this table in Dataverse';
    view.where = '(Tables > New table; choose "Table (advanced properties)" if it is offered):';
    view.rows = [
        { label: 'Display name', value: ownSpec.display },
        { label: 'Plural display name', value: ownSpec.plural },
        { label: 'Name to type', value: ownSpec.name, note: 'Dataverse adds craa5_ in front. If your screen differs, the full name must end up as ' + T.table + '.' },
        { label: 'Record ownership', value: 'Organization' },
        { label: 'Primary column', value: 'leave as Name (craa5_name)', plain: true },
        { label: 'Everything else', value: 'leave as it is (no attachments, no notes)', plain: true }
    ];
    view.then = ownSpec.then;
    view.columns = T.columns.filter(c => c.logical !== 'craa5_name').map((c, i) => ({ n: i + 1, display: c.display, name: strip(c.logical), type: ppLongType(c.type), need: c.need, why: c.why }));
    view.footer = ownSpec.footer;
    return { title: ownSpec.display + ' table is not set up yet', text: [ownSpec.text + ' ' + ownSpec.still], view: view };
}

