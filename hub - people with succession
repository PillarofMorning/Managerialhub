        }
        console.warn('[People] ' + table + ' via ' + via + ' (' + cl.kind + ')' + shown);
    } catch (e) {}
}

async function pplQuery(tables, dataApi, opts) {
    const o = opts || {};
    const filter = typeof o.filter === 'string' ? o.filter.trim() : '';
    if (!filter) return { rows: null, error: { kind: 'other', text: 'no filter', columns: [] }, table: '', via: '' };
    let top = Number(o.top);
    if (o.top === undefined || o.top === null || isNaN(top)) top = 25;
    top = Math.min(500, Math.max(1, Math.floor(top)));
    const select = (Array.isArray(o.select) ? o.select : []).filter(function (s) { return typeof s === 'string' && s && PPL_NEVER_READ.indexOf(s.toLowerCase()) < 0; });
    const asList = Array.isArray(tables) ? tables : [tables];
    const hint = o.store === 'emp' ? 'employee' : (typeof o.store === 'string' ? o.store : '');
    const key = hint && pplHas(PPL_TABLES, hint) && asList.some(function (t) { return pplIndexLow(PPL_TABLES[hint], t) >= 0; }) ? hint : pplKeyOfList(asList);   // only when the list holds a spelling of that store's own table
    const list = pplCandidates(tables, key, o.noMemory);
    const local = function (text) { return { rows: null, error: { kind: 'other', text: text, columns: [], limit: null }, table: '', via: '' }; };
    if (!list.length) return local('no table');
    if (!select.length && key === 'employee') return local('employee reads need a select');   // never an all-columns read of Employee (RD-12: that pulls craa5_pin)
    const web = safeGetXrm()?.WebApi;
    const useXrm = !!(web && typeof web.retrieveMultipleRecords === 'function');
    const useApi = !!(dataApi && typeof dataApi.queryTable === 'function');
    if (!useXrm && !useApi) return local('No Dataverse read connection in this environment.');
    const timeoutMs = typeof o.timeoutMs === 'number' && o.timeoutMs > 0 ? o.timeoutMs : API_TIMEOUT_MS;
    const orderby = typeof o.orderby === 'string' && o.orderby ? o.orderby : '';
    const safeFilter = filter.replace(/%/g, '%25').replace(/&/g, '%26').replace(/#/g, '%23').replace(/\+/g, '%2B');   // a name with & # % + must not cut the Xrm query string short
    const odata = ['$filter=' + safeFilter, select.length ? '$select=' + select.join(',') : '', orderby ? '$orderby=' + orderby : '', '$top=' + top].filter(Boolean).join('&');
    const runXrm = async function (en) {
        const res = await withTimeout(web.retrieveMultipleRecords(en, '?' + odata), timeoutMs, 'Xrm.WebApi ' + en);
        if (!Array.isArray(res?.entities)) throw new Error('no rows');
        return res.entities.slice(0, top);
    };
    const runApi = async function (en) {
        const q = { pageSize: Math.min(top, 500), filter: filter };
        if (orderby) q.orderBy = orderby;
        if (select.length) q.select = select;
        let page = await withTimeout(dataApi.queryTable(en, q), timeoutMs, 'dataApi ' + en);
        if (!Array.isArray(page?.rows)) throw new Error('no rows');
        let rows = page.rows.slice();
        while (page?.hasMoreRows && typeof page.loadMoreRows === 'function' && rows.length < top) {
            page = await withTimeout(page.loadMoreRows(), timeoutMs, 'dataApi ' + en);
            rows = rows.concat(Array.isArray(page?.rows) ? page.rows : []);
        }
        return rows.slice(0, top);
    };
    const order = [];
    if (useXrm) order.push('xrm');
    if (useApi) order.push('dataapi');
    let lastMissing = null;
    for (let i = 0; i < list.length; i++) {
        const en = list[i];
        let first = null, moveOn = false;
        for (let t = 0; t < order.length; t++) {
            const via = order[t];
            try {
                const rows = via === 'xrm' ? await runXrm(en) : await runApi(en);
                if (!o.noMemory) pplRememberTable(key, en);
                return { rows: rows, error: null, table: en, via: via };
            } catch (e) {
                const cl = classifyDataverseError(e, { select: select, navs: [] });   // a read has no @odata.bind names; the select list says which columns an error names (SPEC 7.3 d)
                if (!o.quiet) pplWarn(en, via, cl, filter, o.store);
                if (cl.kind === 'missing_table') { lastMissing = cl; moveOn = true; break; }   // this spelling does not exist: next candidate
                if (PPL_READ_STOP.indexOf(cl.kind) >= 0) {   // the server answered: stop and say so
                    if (cl.kind === 'missing_column' && !o.noMemory) pplRememberTable(key, en);
                    return { rows: null, error: cl, table: en, via: via };
                }
                if (!first) first = { cl: cl, via: via };   // timeout / network / other: try the other transport once, then report the first error
            }
        }
        if (moveOn) continue;
        return { rows: null, error: first.cl, table: en, via: first.via };
    }
    return { rows: null, error: lastMissing || { kind: 'missing_table', text: '', columns: [], limit: null }, table: '', via: '' };
}

async function pplControlProbe(table, dataApi) {
    const r = await pplQuery([table], dataApi, { filter: 'statecode eq 0', select: [PPL_PROBE_COLUMN], top: 1, noMemory: true, quiet: true });
    if (!r.error) return { throws: false };
    const k = r.error.kind;
    if ((!r.via && k === 'other') || k === 'timeout' || k === 'network') return { throws: false, inconclusive: true, error: r.error };   // no answer from Dataverse proves nothing
    return { throws: true, error: r.error };
}

function pplPayloadHasPin(payload) {
    return pplIsObj(payload) && Object.keys(payload).some(function (k) { return PPL_NEVER_READ.indexOf(k.toLowerCase()) >= 0; });
}

function pplWriteCtx(payload) {
    const select = [], navs = [];
    if (pplIsObj(payload)) {
        Object.keys(payload).forEach(function (k) {
            const bound = /@odata\.bind$/i.test(k);
            const name = bound ? k.slice(0, k.length - '@odata.bind'.length) : k;
            if (name && select.indexOf(name) < 0) select.push(name);
            if (bound && name && navs.indexOf(name) < 0) navs.push(name);
        });
    }
    return { select: select, navs: navs };
}

async function pplWrite(api, ctx) {
    const c = ctx || {};
    const key = typeof c.key === 'string' ? c.key : '';
    if (key) {   // set before the first await: React state would let a double click through before the re-render
        if (pplHas(pplLocks.current, key) && pplLocks.current[key]) return { ok: false, busy: true };
        pplLocks.current[key] = true;
    }
    try {
        const fail = function (kind, text) { return { ok: false, error: { kind: kind, text: text, columns: [], limit: null } }; };
        const w = api && typeof api.create === 'function' && typeof api.update === 'function' ? api : getWriteApi(api);
        if (!w) return fail('other', 'no write connection');
        if (c.op !== 'create' && c.op !== 'update') return fail('other', 'unknown operation');
        if (typeof c.table !== 'string' || !c.table) return fail('other', 'no table');
        if (!pplIsObj(c.payload)) return fail('other', 'no payload');
        if (pplPayloadHasPin(c.payload)) return fail('other', 'blocked: the PIN column is never written');
        const id = cleanGuid(c.id);
        if (c.op === 'update' && !id) return fail('other', 'no id');
        const limit = typeof c.timeoutMs === 'number' && c.timeoutMs > 0 ? c.timeoutMs : PPL_WRITE_TIMEOUT_MS;
        const t0 = pplNow();
        try {
            if (c.op === 'create') {
                const made = idOf(await withTimeout(w.create(c.table, c.payload), limit, 'write'));
                return { ok: true, id: made || '', noId: !made, ms: pplNow() - t0 };   // a missing id is NOT an error: the row exists; the caller verifies by reading
            }
            await withTimeout(w.update(c.table, id, c.payload), limit, 'write');
            return { ok: true, id: id, noId: false, ms: pplNow() - t0 };
        } catch (e) {
            const cl = classifyDataverseError(e, pplWriteCtx(c.payload));
            return { ok: false, error: cl, timedOut: cl.kind === 'timeout', ms: pplNow() - t0 };   // a timed-out write may still land: the caller runs the "did it save?" read
        }
    } finally {
        if (key) delete pplLocks.current[key];
    }
}

function pplSplitJobRole(patch, extraNavs) {
    if (!pplIsObj(patch)) return [{}, null];
    const navs = [];
    lookupBindCandidates('jobRole', { max: 64 }).forEach(function (b) { navs.push(pplLow(b.nav)); });
    (Array.isArray(extraNavs) ? extraNavs : (typeof extraNavs === 'string' ? [extraNavs] : [])).forEach(function (n) { if (typeof n === 'string' && n) navs.push(pplLow(n)); });
    const main = {};
    const job = {};
    let found = false;
    Object.keys(patch).forEach(function (k) {
        const low = pplLow(k);
        const bound = /@odata\.bind$/.test(low);
        const base = bound ? low.slice(0, low.length - '@odata.bind'.length) : low;
        const isJob = navs.indexOf(base) >= 0 && (bound || base !== 'craa5_role');
        if (isJob) { job[k] = patch[k]; found = true; } else main[k] = patch[k];
    });
    return [main, found ? job : null];
}

function pplWhoReset() { pplWhoState.promise = null; pplWhoState.name = ''; }
function pplWhoCached() { return pplWhoState.name; }

function pplWho(props, dataApi) {
    if (pplWhoState.promise) return pplWhoState.promise;
    const run = async function () {
        let raw = '';
        try { const us = safeGetXrm()?.Utility?.getGlobalContext?.()?.userSettings; raw = us?.userName || ''; } catch (e) {}
        try { if (!raw) raw = props?.context?.userSettings?.userName || ''; } catch (e) {}
        try { if (!raw) raw = props?.userEmail || ''; } catch (e) {}
        raw = typeof raw === 'string' ? raw.trim() : '';
        if (!raw) return '';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw)) return raw;
        try {
            const f = emailFilter(raw);
            const r = f ? await pplQuery(PPL_TABLES.employee, dataApi, { filter: f, select: ['craa5__aa_employeeid', 'craa5_name'], top: 1, quiet: true }) : null;
            const nm = r && r.rows && r.rows[0] ? r.rows[0].craa5_name : '';
            return typeof nm === 'string' && nm.trim() ? nm.trim() : raw;
        } catch (e) { return raw; }
    };
    pplWhoState.promise = run().then(function (n) { pplWhoState.name = n; return n; }, function () { return ''; });
    return pplWhoState.promise;
}

function pplNewColEntry() {
    return { phase: 'idle', found: [], missing: [], unknown: [], rows: [], report: null, checkedAt: null, busy: false, confirmed: null, hostReports: null, types: {}, table: '', error: null };
}

function pplCopyEntry(e) {
    const n = pplNewColEntry();
    if (!pplIsObj(e)) return n;
    n.phase = e.phase === 'checking' || e.phase === 'done' ? e.phase : 'idle';
    n.found = Array.isArray(e.found) ? e.found.slice() : [];
    n.missing = Array.isArray(e.missing) ? e.missing.slice() : [];
    n.unknown = Array.isArray(e.unknown) ? e.unknown.slice() : [];
    n.rows = Array.isArray(e.rows) ? e.rows.slice() : [];
    n.report = e.report || null;
    n.checkedAt = typeof e.checkedAt === 'number' ? e.checkedAt : null;
    n.busy = !!e.busy;
    n.confirmed = e.confirmed === true || e.confirmed === false ? e.confirmed : null;
    n.hostReports = e.hostReports === true || e.hostReports === false ? e.hostReports : null;
    n.types = {};
    if (pplIsObj(e.types)) Object.keys(e.types).forEach(function (k) { n.types[k] = e.types[k]; });
    n.table = typeof e.table === 'string' ? e.table : '';
    n.error = pplIsObj(e.error) ? e.error : null;
    return n;
}

function pplAddName(list, name) { if (pplIndexLow(list, name) < 0) list.push(name); }
function pplDropName(list, name) { const i = pplIndexLow(list, name); if (i >= 0) list.splice(i, 1); }

function pplPlainError(err) {
    if (!pplIsObj(err)) return null;
    return { kind: err.kind || 'other', text: String(err.text || '').replace(/\s+/g, ' ').slice(0, 300), columns: Array.isArray(err.columns) ? err.columns.slice() : [] };
}

function pplNamedColumns(text, select) {
    let low = pplLow(text);
    const cut = low.indexOf(' on type');
    if (cut >= 0) low = low.slice(0, cut);
    const out = [];
    (Array.isArray(select) ? select : []).forEach(function (s) {
        if (typeof s !== 'string' || !s) return;
        const names = [pplLow(s)];
        if (s.charAt(0) === '_') names.push(pplLow(s.slice(1)));
        const hit = names.some(function (nm) {
            let from = 0;
            for (;;) {
                const at = low.indexOf(nm, from);
                if (at < 0) return false;
                const before = at === 0 ? '' : low.charAt(at - 1), after = low.charAt(at + nm.length);
                if (!/[a-z0-9_]/.test(before) && !/[a-z0-9_]/.test(after)) return true;
                from = at + 1;
            }
        });
        if (hit) out.push(s);
    });
    return out;
}

function pplRequired(tableKey, forWrite, picks) {
    if (tableKey === 'employee') return forWrite ? [pplCol('emp', 'train', picks)] : ['craa5__aa_employeeid', 'craa5_name', 'craa5_role', 'craa5_shift', 'statecode'];
    if (tableKey === 'plan' || tableKey === 'pip') return (forWrite ? PPL_NEEDED_WRITE : PPL_NEEDED_READ)[tableKey].map(function (f) { return pplCol(tableKey, f, picks); });
    return [];
}

async function pplProbeColumns(table, dataApi, cols, timeoutMs, trustEmpty) {
    const out = { ok: [], missing: [], unknown: [] };
    for (let i = 0; i < cols.length; i += PPL_PROBE_BATCH) {
        const batch = cols.slice(i, i + PPL_PROBE_BATCH);
        const results = await Promise.all(batch.map(function (c) {
            return pplQuery([table], dataApi, { filter: 'statecode eq 0', select: [c], top: 1, timeoutMs: timeoutMs, noMemory: true, quiet: true });
        }));
        results.forEach(function (r, j) {
            const c = batch[j];
            if (!r.error) { if (r.rows.length || trustEmpty) out.ok.push(c); else out.unknown.push({ col: c, text: 'no rows to prove it' }); }   // zero rows prove nothing on a host that swallows errors
            else if (r.error.kind === 'missing_column') out.missing.push(c);
            else out.unknown.push({ col: c, text: String(r.error.text || '').replace(/\s+/g, ' ').slice(0, 200) });
        });
    }
    return out;
}

function pplPickUsedBy(store, field, name, picks) {
    if (!pplHas(PPL_COLS, store)) return false;
    const pickNorm = function (c) { return pplLow(c).replace(/^_/, '').replace(/_value$/, ''); };   // fix T1 (D14, LINT-L1): not 'norm', the helper block has one
    const want = pickNorm(name);
    const def = PPL_COLS[store], pk = pplPicks(picks);
    const used = ['craa5_pin', 'createdon', 'modifiedon', 'statecode', 'statuscode', 'versionnumber', 'ownerid'];
    Object.keys(def).forEach(function (f) { if (f !== field) { used.push(def[f]); used.push(pplCol(store, f, pk)); } });
    if (store === 'emp') PPL_EMP_SELECT.forEach(function (c) { if (c !== def[field]) used.push(c); });
    return used.some(function (c) { return pickNorm(c) === want && pickNorm(c) !== pickNorm(def[field]); });
}

async function pplCheckPick(dataApi, store, field, name, picks, tables, trustEmpty) {
    const k = typeof name === 'string' ? name.trim() : '';
    if (!PPL_NAME_RE.test(k) || pplLow(k) === 'craa5_pin') return { ok: false, why: 'bad' };
    if (pplPickUsedBy(store, field, k, picks)) return { ok: false, why: 'used' };
    const r = await pplQuery(tables, dataApi, { filter: 'statecode eq 0', select: [k], top: 1, noMemory: true, quiet: true });
    if (r.error) return r.error.kind === 'missing_column' ? { ok: false, why: 'missing' } : { ok: false, why: 'unknown' };
    const rows = Array.isArray(r.rows) ? r.rows : [];
    if (!rows.length) return trustEmpty ? { ok: true } : { ok: false, why: 'unknown' };   // zero rows prove nothing on a host that swallows errors
    if (store === 'emp' && pplIsObj(rows[0]) && pplHas(rows[0], k)) {
        const v = rows[0][k];
        const kind = v === null || v === undefined ? 'none' : typeof v === 'boolean' ? 'bool' : typeof v === 'string' ? 'text' : 'other';
        const need = field === 'train' ? 'bool' : 'text';
        if (kind !== 'none' && kind !== need) return { ok: false, why: 'type' };
    }
    return { ok: true };
}

function pplTypeCheck(store, rows, picks, types) {
    const out = {};
    Object.keys(types || {}).forEach(function (k) { out[k] = types[k]; });
    if ((store !== 'plan' && store !== 'pip') || !Array.isArray(rows) || !rows.length) return out;
    const cols = pplCols(store, picks);
    const sample = rows.slice(0, 3);
    const parsed = [];
    sample.forEach(function (r) { try { const p = parsePlanRow(r, store, cols); if (p) parsed.push(p); } catch (e) {} });
    if (!parsed.length) return out;
    Object.keys(PPL_COLS[store]).forEach(function (field) {
        const logical = cols[field];
        if (!logical) return;
        const present = sample.some(function (r) { return pplIsObj(r) && pplHas(r, logical); });
        const wrong = parsed.some(function (p) { return p.wrongTypes.indexOf(field) >= 0; });
        const timed = (field === 'start' || field === 'due') && sample.some(function (r) { return pplIsObj(r) && typeof r[logical] === 'string' && /^\s*\d{4}-\d{2}-\d{2}T/.test(r[logical]); });
        if (wrong) out[logical] = 'wrong';
        else if (timed) out[logical] = 'datetime';
        else if (present) delete out[logical];
    });
    if (cols.data && parsed.some(function (p) { return p.hints.indexOf('data_richtext') >= 0; })) out[cols.data] = 'richtext';
    return out;
}

function pplColReport(tableKey, entry, picks) {
    const specT = pplHas(PPL_COLUMN_SPECS, tableKey) ? PPL_COLUMN_SPECS[tableKey] : null;
    if (!specT || !pplIsObj(entry)) return null;
    const store = tableKey === 'employee' ? 'emp' : tableKey;
    const rp = {};
    if (pplHas(PPL_COLS, store)) {
        const pk = pplPicks(picks);
        Object.keys(PPL_COLS[store]).forEach(function (f) { const d = PPL_COLS[store][f], p = pplCol(store, f, pk); if (p && p !== d) rp[d] = p; });
    }
    const seen = {};
    (entry.found || []).forEach(function (k) { seen[k] = null; });
    (entry.rows || []).forEach(function (r) { if (pplIsObj(r)) Object.keys(r).forEach(function (k) { seen[k] = null; }); });
    const base = missingColumnsReport(tableKey, Object.keys(seen).length ? [seen] : [], { picks: rp });
    if (!base) return null;
    const cols = base.columns.map(function (c) {
        let st = 'unknown';
        let usedKey = c.pickedKey;
        let isFound = c.status === 'found';
        if (!isFound && tableKey === 'jobrole' && c.logical === 'craa5_name') {
            const alias = PPQ_ROLE_NAME_COLUMNS.filter(function (k) { return pplHas(seen, k); })[0];
            if (alias) { isFound = true; if (alias !== c.logical) usedKey = alias; }
        }
        if (entry.confirmed !== false) {
            if (isFound) st = 'found';
            else {
                const sp = specT.columns.filter(function (x) { return x.logical === c.logical; })[0];
                const keys = c.pickedKey ? [c.pickedKey] : (sp ? sp.rowKeys : [c.logical]);
                if (keys.some(function (k) { return pplIndexLow(entry.missing || [], k) >= 0; })) st = 'missing';   // only a read that named the column may say so
            }
        }
        return { logical: c.logical, display: c.display, type: c.type, need: c.need, why: c.why, status: st, pickedKey: usedKey };
    });
    const by = function (st) { return cols.filter(function (c) { return c.status === st; }); };
    const fmt = function (c) { return c.display + ' (' + c.logical + ', ' + c.type + ')'; };
    const found = by('found'), missing = by('missing'), unknown = by('unknown');
    let summary = base.label + ' (' + base.tableName + '): found ' + found.length + ' of ' + cols.length + '.';
    if (missing.length) summary += ' Missing: ' + missing.map(fmt).join(', ') + '.';
    if (unknown.length) summary += ' Could not check: ' + unknown.map(fmt).join(', ') + '.';
    return {
        table: base.table, tableName: base.tableName, label: base.label, checked: base.checked, rowCount: base.rowCount, columns: cols,
        found: found.map(function (c) { return c.logical; }), missing: missing.map(function (c) { return c.logical; }), unknown: unknown.map(function (c) { return c.logical; }),
        missingNeeded: missing.filter(function (c) { return c.need === 'needed'; }).map(function (c) { return c.logical; }),
        missingRecommended: missing.filter(function (c) { return c.need === 'recommended'; }).map(function (c) { return c.logical; }),
        summary: summary
    };
}

function pplColStatusText(entry) {
    if (!pplIsObj(entry) || !entry.checkedAt) return '';
    const head = 'Checked at ' + pplTimeLabel(entry.checkedAt) + '.';
    if (entry.error) return head + ' Could not read this table.';
    if (entry.confirmed === false) return head + ' Found (no rows yet), not confirmed until the first save.';   // never counted as found
    const rep = entry.report;
    if (!rep) return head;
    const names = function (st) { return rep.columns.filter(function (c) { return c.status === st; }).map(function (c) { return c.display; }); };
    let t = head + ' Found ' + rep.found.length + ' of ' + rep.columns.length + '.';
    const miss = names('missing'), unk = names('unknown');
    if (miss.length) t += ' Still missing: ' + miss.join(', ') + '.';
    if (unk.length) t += ' Could not check: ' + unk.join(', ') + '.';
    return t;
}

async function pplReadTable(dataApi, spec) {
    const sp = spec || {};
    const store = typeof sp.store === 'string' ? sp.store : '';
    const tableKey = store === 'emp' ? 'employee' : store;
    const entry = pplCopyEntry(sp.colEntry);
    const required = (Array.isArray(sp.required) ? sp.required : []).filter(function (x) { return typeof x === 'string' && x; });
    const isRequired = function (c) { return pplIndexLow(required, c) >= 0; };
    let dropped = [];
    const finish = function (rows, error, table, via, columnStop) {
        entry.phase = 'done';
        entry.busy = false;
        entry.error = error && !columnStop ? pplPlainError(error) : null;
        if (table) entry.table = table;
        entry.report = pplColReport(tableKey, entry, sp.picks);
        return { rows: rows, error: error, dropped: dropped, colEntry: entry, table: table || '', via: via || '', confirmed: entry.confirmed };
    };
    const localError = function (text) { return finish(null, { kind: 'other', text: text, columns: [], limit: null }, '', ''); };
    if (PPL_STORES.indexOf(store) < 0) return localError('unknown store');
    let select = (Array.isArray(sp.select) ? sp.select : []).filter(function (s) { return typeof s === 'string' && s && PPL_NEVER_READ.indexOf(s.toLowerCase()) < 0; });
    const noSelectOk = store === 'team' || store === 'jobrole';
    if (!select.length && !noSelectOk) return localError('no select');
    const sent = [];
    select.forEach(function (c) { if (pplIndexLow(entry.missing, c) >= 0 && !isRequired(c)) pplAddName(dropped, c); else sent.push(c); });
    select = sent;
    if (!select.length && !noSelectOk) return localError('no select');
    const base = { filter: sp.filter, orderby: sp.orderby, top: sp.top, timeoutMs: sp.timeoutMs };
    let tablesNow = sp.tables;   // after the first answer the table that answered is the only candidate (a retry must not walk the other spellings again)
    const ask = function (cols) { return pplQuery(tablesNow, dataApi, { filter: base.filter, select: cols, orderby: base.orderby, top: base.top, timeoutMs: base.timeoutMs, noMemory: tablesNow !== sp.tables, store: store }); };
    let loops = 0, probed = false, worked = false, res;
    for (;;) {
        res = await ask(select);
        if (!res.error) break;
        const err = res.error;
        if (res.table) tablesNow = [res.table];
        if (err.kind !== 'missing_column' || !select.length) return finish(null, err, res.table, res.via);
        entry.hostReports = true;   // an error came back: the host reports errors, so what it says about columns can be trusted
        entry.confirmed = true;
        worked = true;
        const named = pplNamedColumns(err.text, select);
        named.forEach(function (c) { pplAddName(entry.missing, c); pplDropName(entry.found, c); });
        const probeEach = async function () {
            probed = true;
            const pr = await pplProbeColumns(res.table, dataApi, select, sp.timeoutMs, true);
            pr.ok.forEach(function (c) { pplAddName(entry.found, c); pplDropName(entry.missing, c); });
            pr.missing.forEach(function (c) { pplAddName(entry.missing, c); pplDropName(entry.found, c); });
            entry.unknown = pr.unknown;
            return pr;
        };
        let gone = [];
        if (named.length && loops < PPL_DROP_LOOPS) {
            gone = named;
        } else {
            if (probed) return finish(null, err, res.table, res.via);
            gone = (await probeEach()).missing;
            if (!gone.length) return finish(null, err, res.table, res.via);   // nothing to drop: the same error would come back
        }
        if (gone.some(isRequired)) {   // a required column is missing: no retry, the card of that column shows (fix T1, columns:F-REACHFIRST / F-REQCARD)
            if (!probed) await probeEach();   // so the Columns block and the card know every missing column, not only the one the text named
            return finish(null, err, res.table, res.via, true);
        }
        gone.forEach(function (c) { pplAddName(dropped, c); });
        select = select.filter(function (c) { return pplIndexLow(gone, c) < 0; });
        if (!select.length && !noSelectOk) return finish(null, err, res.table, res.via);
        loops++;
    }
    const rows = res.rows;
    const table = res.table;
    if (rows.length) entry.confirmed = true;
    else if ((store === 'plan' || store === 'pip' || store === 'emp') && entry.hostReports === null) {
        const probe = await pplControlProbe(table, dataApi);
        worked = true;
        if (probe.throws) { entry.hostReports = true; entry.confirmed = true; }
        else if (!probe.inconclusive) { entry.hostReports = false; if (entry.confirmed !== true) entry.confirmed = false; }
    }
    if (rows.length || entry.hostReports === true) {
        let keys = null;
        if (rows.length && store !== 'emp' && store !== 'pip') {   // key names only, and never for Employee or PIP; a key in a real row is present for certain (a missing key in one row proves nothing)
            keys = {};
            rows.slice(0, 3).forEach(function (r) { if (pplIsObj(r)) Object.keys(r).forEach(function (k) { if (k.indexOf('@') < 0) keys[k] = true; }); });
        }
        const proven = select.concat(keys ? Object.keys(keys) : []);   // the select list was accepted; the keys of a real row are present for certain
        proven.forEach(function (c) { pplAddName(entry.found, c); pplDropName(entry.missing, c); });
        if (keys) {
            const sample = {};
            Object.keys(keys).forEach(function (k) { sample[k] = null; });
            entry.rows = [sample];
        }
    }
    entry.types = pplTypeCheck(store, rows, sp.picks, entry.types);
    if (!entry.checkedAt || worked || loops > 0 || sp.markChecked) entry.checkedAt = pplNow();
    return finish(rows, null, table, res.via);
}

function pplEmpSelect(picks) {
    return employeeSelect([]).map(function (c) {
        const fields = Object.keys(PPL_COLS.emp);
        for (let i = 0; i < fields.length; i++) { if (PPL_COLS.emp[fields[i]] === c) return pplCol('emp', fields[i], picks); }
        return c;
    });
}

async function pplCheckAgain(dataApi, tableKey, colEntry, picks, tableName) {
    const pk = pplPicks(picks);
    const store = tableKey === 'employee' ? 'emp' : tableKey;
    if (PPL_STORES.indexOf(store) < 0 || !pplHas(PPL_COLUMN_SPECS, tableKey)) {
        const e0 = pplCopyEntry(colEntry);
        return { colEntry: e0, report: e0.report, error: { kind: 'other', text: 'unknown table', columns: [] }, table: '', dropped: [], text: pplColStatusText(e0) };
    }
    let select = [];
    if (store === 'emp') select = pplEmpSelect(pk);
    else if (store === 'plan' || store === 'pip') select = Object.keys(PPL_COLS[store]).map(function (f) { return pplCol(store, f, pk); });
    const typed = typeof tableName === 'string' ? tableName.trim() : '';
    const tableList = typed && PPL_NAME_RE.test(typed) ? [typed].concat(PPL_TABLES[tableKey].filter(function (t) { return pplLow(t) !== pplLow(typed); })) : PPL_TABLES[tableKey];
    const res = await pplReadTable(dataApi, {
        store: store, tables: tableList, filter: 'statecode eq 0', select: select, required: pplRequired(tableKey, false, pk),
        top: 1, colEntry: pplNewColEntry(), picks: pk, markChecked: true
    });
    let entry = res.colEntry;
    if (!res.error && (store === 'team' || store === 'jobrole')) {
        const specT = PPL_COLUMN_SPECS[tableKey];
        const todo = [];
        specT.columns.forEach(function (cs) {
            const spellings = tableKey === 'jobrole' && cs.logical === 'craa5_name' ? PPQ_ROLE_NAME_COLUMNS : cs.rowKeys;   // fix T1 (columns:F-ROLENAME): the accepted spellings of the role name
            if (spellings.some(function (k) { return pplIndexLow(entry.found, k) >= 0; })) return;
            spellings.forEach(function (k) { pplAddName(todo, k); });
        });
        if (todo.length && (entry.hostReports === true || res.rows.length)) {
            const pr = await pplProbeColumns(res.table, dataApi, todo, undefined, entry.hostReports === true);
            pr.ok.forEach(function (c) { pplAddName(entry.found, c); pplDropName(entry.missing, c); });
            pr.missing.forEach(function (c) { pplAddName(entry.missing, c); });
            entry.unknown = pr.unknown;
            if (pr.missing.length) { entry.hostReports = true; entry.confirmed = true; }
        }
    }
    entry = pplCopyEntry(entry);
    entry.phase = 'done';
    entry.busy = false;
    entry.checkedAt = pplNow();
    entry.report = pplColReport(tableKey, entry, pk);
    return { colEntry: entry, report: entry.report, error: res.error, table: entry.table, dropped: res.dropped, text: pplColStatusText(entry) };
}

const PPQ_FRESH_MS = 5 * 60 * 1000;              // a list or plan read stays fresh for 5 minutes (SPEC 5.2, Cache column)
const PPQ_SEARCH_DEBOUNCE_MS = 250;              // typing in Find by name (E2)
const PPQ_SEARCH_MAX = 25;                       // Q1b / Q1c
const PPQ_PLANS_MAX = 200;                       // Q2
const PPQ_PIPS_MAX = 100;                        // Q3
const PPQ_PLAN_ROWS_MAX = 10;                    // Q4 / Q5
const PPQ_TEAMS_MAX = 20;                        // Q8
const PPQ_JOBROLES_MAX = 200;                    // Q9
const PPQ_DUPES_MAX = 5;                         // Q13
const PPQ_EMP_GUID_COLUMN = 'craa5__aa_employeeid';
const PPQ_ROLE_NAME_COLUMNS = ['craa5_name', 'craa5_rolename', 'craa5_role'];
const PPQ_ROLE_ID_COLUMNS = ['craa5__aa_roleid', 'craa5_aa_roleid', 'craa5_roleid'];
const PPQ_GUID_ANY = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi;
const PPQ_TABLE_KEYS = ['employee', 'plan', 'pip', 'team', 'jobrole'];   // the five column-state keys of ppCols (INTERFACE 9.4)

function ppqError(text) { return { kind: 'other', text: String(text === undefined || text === null ? '' : text), columns: [], limit: null }; }
function ppqIsObj(x) { return x !== null && typeof x === 'object' && !Array.isArray(x); }

function ppqSafeError(err) {
    if (!ppqIsObj(err)) return err;
    return { kind: err.kind || 'other', text: String(err.text || '').replace(PPQ_GUID_ANY, '(id)').replace(/\s+/g, ' ').slice(0, 200), columns: Array.isArray(err.columns) ? err.columns.slice() : [], limit: err.limit === undefined ? null : err.limit };
}

function ppqEnv(env) {
    const e = ppqIsObj(env) ? env : {};
    return {
        colEntry: ppqIsObj(e.colEntry) ? e.colEntry : pplNewColEntry(),
        picks: ppqIsObj(e.picks) ? e.picks : pplLsGet('stillwell.columnPicks', {}),
        guidStyle: e.guidStyle === 'bare' || e.guidStyle === 'quoted' ? e.guidStyle : '',
        jobNameById: ppqIsObj(e.jobNameById) ? e.jobNameById : {}
    };
}

function ppqJobRoleList(byId) {
    return Object.keys(ppqIsObj(byId) ? byId : {}).map(function (id) { return { id: id, name: String(byId[id] || '') }; });
}

function ppqApplyEmpPicks(rows, picks) {
    const list = Array.isArray(rows) ? rows : [];
    const moves = [];
    Object.keys(PPL_COLS.emp).forEach(function (field) {
        const picked = pplCol('emp', field, picks), plain = PPL_COLS.emp[field];
        if (picked && picked !== plain) moves.push([picked, plain]);
    });
    if (!moves.length) return list;
    return list.map(function (r) {
        if (!ppqIsObj(r)) return r;
        const c = Object.assign({}, r);
        moves.forEach(function (m) {
            if (Object.prototype.hasOwnProperty.call(r, m[0]) && !Object.prototype.hasOwnProperty.call(r, m[1])) c[m[1]] = r[m[0]];
            if (Object.prototype.hasOwnProperty.call(r, m[0] + FMT_SUFFIX) && !Object.prototype.hasOwnProperty.call(r, m[1] + FMT_SUFFIX)) c[m[1] + FMT_SUFFIX] = r[m[0] + FMT_SUFFIX];
        });
        return c;
    });
}

function ppqApplyJobNames(rows, byId) {
    if (!Array.isArray(rows)) return [];
    if (!ppqIsObj(byId)) return rows;
    let changed = false;
    const out = rows.map(function (r) {
        if (!r || !r.jobRole || !r.jobRole.id || r.jobRole.name) return r;
        const name = byId[cleanGuid(r.jobRole.id)];
        if (typeof name !== 'string' || !name) return r;
        changed = true;
        return Object.assign({}, r, { jobRole: { id: r.jobRole.id, name: name }, techLevel: techLevelOfJob(name) });
    });
    return changed ? out : rows;
}

function ppqParseEmployees(raw, e) {
    const rows = parseEmployeeRows(ppqApplyEmpPicks(raw, e.picks), { jobRoles: ppqJobRoleList(e.jobNameById) });
    return ppqApplyJobNames(rows, e.jobNameById);
}

async function ppqEmployeeRead(dataApi, filter, orderby, top, env) {
    const e = ppqEnv(env);
    const empty = { rows: [], count: 0, enc: null, capped: false, error: null, dropped: [], colEntry: e.colEntry, skipped: false };
    if (!filter) return Object.assign({}, empty, { skipped: true });
    let res;
    try {
        res = await pplReadTable(dataApi, {
            store: 'emp', tables: PPL_TABLES.employee, filter: filter, select: pplEmpSelect(e.picks), required: pplRequired('employee', false, e.picks),
            orderby: orderby, top: top, colEntry: e.colEntry, picks: e.picks
        });
    } catch (err) { return Object.assign({}, empty, { error: ppqError('The employee table could not be read.') }); }
    if (res.error) return Object.assign({}, empty, { error: res.error, dropped: res.dropped || [], colEntry: res.colEntry });
    const raw = Array.isArray(res.rows) ? res.rows : [];
    return {
        rows: ppqParseEmployees(raw, e), count: raw.length, enc: raw.length ? detectCrewEncoding(raw) : null, capped: raw.length >= top,
        error: null, dropped: res.dropped || [], colEntry: res.colEntry, skipped: false
    };
}

function ppqCrewList(dataApi, crew, env) {
    return ppqEmployeeRead(dataApi, crewEmployeeFilter(crew), 'craa5_name asc', PP_CREW_MAX, env);
}

function ppqSearch(dataApi, text, noCrew, env) {
