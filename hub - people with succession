function ppIsPipEntry(e) {
    if (!e || typeof e !== 'object') return false;
    if (e.store === 'pip' || e.pip === true || e.kind === 'pip') return true;
    const t = String(e.table || '').toLowerCase();
    if (!t) return false;
    return /pip/.test(t) || PPL_TABLES.pip.map(n => n.toLowerCase()).indexOf(t) > -1;
}

function ppSentId(e) { return String(e && e.at !== undefined ? e.at : '') + '|' + String(e && e.op ? e.op : '') + '|' + String(e && e.table ? e.table : ''); }

function ppSentTableLabel(table) {
    const t = String(table || '').toLowerCase();
    let found = '';
    Object.keys(PPL_COLUMN_SPECS).forEach(k => { if (!found && String(PPL_COLUMN_SPECS[k].table).toLowerCase() === t) found = PPL_COLUMN_SPECS[k].label; });
    return found || String(table || 'record');
}

function ppSentJson(payload, hideValues) {
    if (!payload || typeof payload !== 'object') return '{}';
    try {
        if (hideValues) {
            const o = {};
            Object.keys(payload).forEach(k => { if (k !== '__proto__' && k.toLowerCase() !== 'craa5_pin') o[k] = '(hidden)'; });
            return JSON.stringify(o, null, 2);
        }
        return JSON.stringify(payload, (k, val) => (String(k).toLowerCase() === 'craa5_pin' ? undefined : val), 2);
    } catch (err) { return '{}'; }
}

function ppSentLine(e) {
    const op = String(e.op || '').toLowerCase();
    const word = op === 'create' ? 'Create' : op === 'update' ? 'Update' : (op ? op.charAt(0).toUpperCase() + op.slice(1) : 'Write');
    const nm = typeof e.label === 'string' && e.label ? e.label : (e.payload && typeof e.payload === 'object' && typeof e.payload.craa5_name === 'string' ? e.payload.craa5_name : '');
    return word + ' ' + ppSentTableLabel(e.table) + (nm ? ' "' + nm + '"' : '');
}

function ppSentResult(e) {
    if (e.ok) return 'OK';
    const kind = e.error && typeof e.error === 'object' ? e.error.kind : '';
    if (kind === 'timeout') return 'No answer (may have saved)';
    if (kind === 'network') return 'Connection lost (may have saved)';
    const t = ppErrText(e.error);
    return 'Refused' + (t ? ': ' + t : '');
}

function ppSentCopyText(entries) {
    return entries.map(e => {
        const pip = ppIsPipEntry(e);
        const res = ppSentResult(e);
        return ppClock(e.at) + ' ' + (pip ? 'Private record (hidden)' : ppSentLine(e)) + ' ' + res + '\n' + (pip ? '' : ppSentJson(e.payload, false));
    }).join('\n\n');
}

function ppSentItem(e, i, showPip, onShowPip) {
    const pip = ppIsPipEntry(e);
    const id = ppSentId(e);
    const on = pip && (showPip === true || showPip === id || (Array.isArray(showPip) && showPip.indexOf(id) > -1));
    const op = String(e.op || '').toLowerCase();
    return (
        <li key={id + '#' + i} data-sent={op === 'create' ? 'create' : 'update'} data-table={String(e.table || '')} data-ok={e.ok ? '1' : '0'} className="border-b border-slate-100 pb-2">
            <div className="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                <span className="font-bold text-slate-600">{ppClock(e.at)}</span>
                {pip ? (
                    <span className="inline-flex items-center gap-1 font-semibold text-slate-700"><LockIcon className="w-3 h-3" />Private record (hidden)</span>
                ) : <span className="font-semibold text-slate-800">{ppSentLine(e)}</span>}
                {e.ok ? <span className="font-bold text-[#00468B]">OK</span> : <span className="font-bold text-[#B80022]">{ppSentResult(e)}</span>}
                {pip ? (
                    <button type="button" data-testid="pp-sent-show-pip" aria-expanded={on ? 'true' : 'false'}
                        onClick={() => { if (onShowPip) onShowPip(id, e); }}
                        className="text-xs font-semibold text-[#0072CE] underline px-1 min-h-[44px] md:min-h-0">{on ? 'Hide' : 'Show'}</button>
                ) : null}
            </div>
            {!pip || on ? <pre data-sent-payload="1" className="mt-1 text-[11px] leading-snug bg-slate-50 border border-slate-200 rounded p-2 overflow-x-auto whitespace-pre-wrap break-all text-slate-700">{ppSentJson(e.payload, pip)}</pre> : null}
        </li>
    );
}

const PpSentBlock = ({ sent, panel, showPip, onShowPip, onCopy }) => {
    const all = Array.isArray(sent) ? sent.filter(e => e && typeof e === 'object') : [];
    const first = all.slice(0, 20), older = all.slice(20);
    return (
        <details data-panel={panel || 'people-sent'} className={PP_LOOK.card + ' p-4'}>
            <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-black text-[#00468B] uppercase tracking-widest">What was sent to Dataverse<span className="ml-2 text-[11px] font-semibold normal-case tracking-normal text-slate-500">(last 20 saves, newest first)</span></summary>
            <div className="mt-3 space-y-3">
                {all.length === 0 ? <p className="text-sm text-slate-600">Nothing has been sent yet.</p> : null}
                {first.length ? <ul className="space-y-2">{first.map((e, i) => ppSentItem(e, i, showPip, onShowPip))}</ul> : null}
                {older.length ? (
                    <details data-sent-older="1">
                        <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-semibold text-[#0072CE]">{'Show older (' + older.length + ')'}</summary>
                        <ul className="space-y-2 mt-2">{older.map((e, i) => ppSentItem(e, i + 20, showPip, onShowPip))}</ul>
                    </details>
                ) : null}
                <button type="button" data-testid="pp-sent-copy" aria-disabled={all.length ? undefined : 'true'} className={all.length ? PP_LOOK.secondary : PP_LOOK.dimmed}
                    onClick={() => { if (all.length && onCopy) onCopy(ppSentCopyText(all.slice(0, 20))); }}>Copy</button>
            </div>
        </details>
    );
};


