function ppNewDraft(id, row) {
    const isNew = id === 'new';
    return {
        id: id,
        emp: {
            base: isNew ? null : (row || null),
            edited: isNew ? { last: '', first: '', mi: '', role: 'employee', crew: '', jobRole: null, email: '', badge: '' } : {},
