async function sceCheckSaved(a0) {
    const a = peStart(a0);
    const att = scObj(a.attempt) ? a.attempt : null;
    if (!att) return peRes(a, 'idle', { ok: true, message: 'There was nothing to check.' });
    const kind = att.kind === 'framework' ? 'framework' : 'succession';
    const crew = kind === 'framework' ? '' : scCrewOf(att.crew || a.crew);
    const lock = SC_FLOW + sceKey(kind, crew);
    if (!peFlowTake(lock)) return peBusy();
    try {
        const rd = await sceRead(a, kind);
        if (rd.error) return peRes(a, 'unknown', { ok: false, alert: 'I could not read the plan to check it. Press Check what was saved again.', code: 'readback', offers: ['check-saved'], attempt: att });
        let row = null;
        if (att.type === 'create') {
            const known = Array.isArray(att.knownIds) ? att.knownIds : [];
            const fresh = rd.rows.filter(function (r) { return known.indexOf(r.id) < 0 && (kind === 'framework' || r.crew === crew); }).sort(peOldestFirst);
            row = fresh.filter(function (r) { return r.dataState === 'text' && planTextHash(r.text) === att.hash; })[0] || null;   // only a row that holds the text this page wrote is ours
            if (!row && fresh.length) return peRes(a, 'idle', { ok: false, message: PE_NOT_SAVED_OTHER, code: 'not_saved' });
        } else {
            row = rd.rows.filter(function (r) { return r.id === att.rowId; })[0] || null;
            if (!row) return peFail(a, kind === 'framework' ? SC_GONE_FW : scGoneText(crew), { code: 'row_gone', offers: ['reload'] });
            if (row.dataState !== 'text' || planTextHash(row.text) !== att.hash) row = null;
        }
        if (!row) return peRes(a, 'idle', { ok: false, message: PE_NOT_SAVED, code: 'not_saved' });
        const pr = row.dataState === 'text' ? parsePlanData(row.text, kind) : { ok: false };
        const base = pr.ok ? { text: row.text, hash: planTextHash(row.text), doc: pr.data } : null;
        const act = scPickRows(rd.rows, kind, crew);
        return peRes(a, 'saved', {
            ok: true, message: peJoin(['It did save.', act.count > 1 && kind === 'succession' ? scTwoActiveText(crew, act) : '']), row: row, rows: rd.rows, capped: rd.capped, unassigned: rd.unassigned,
            base: base, doc: base ? safeClone(base.doc) : null, adopted: att.type === 'create', twoActive: act.count > 1
        });
    } catch (e) { return peCrash(a); } finally { peFlowFree(lock); }
}


