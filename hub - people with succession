            body = noneView();
        }
        if (pipColCard && !pipColUsed && view !== 'missing') body = <div className="space-y-3">{pipColCard}{body}</div>;
        return frame(right, body);
    };


    const pdPlural = (n, one, many) => n + ' ' + (n === 1 ? one : many);
    const pdBase = () => (ppDraft && ppDraft.emp && ppDraft.emp.base ? ppDraft.emp.base : null);
    const pdName = (b) => (b ? String(b.display || b.name || '') : '');
    const pdWho = (d) => {
        const b = d && d.emp ? d.emp.base : null;
        if (b && pdName(b)) return pdName(b);
        if (d && d.id === 'new' && d.emp && d.emp.edited) {
            const ed = d.emp.edited;
            const nm = String(formatFullName(composeEmployeeName(ed.last, ed.first, ed.mi)) || '').trim();
            return nm || 'the new employee';
        }
        return 'this person';
    };
    const pdIdent = (b) => (b ? <PpIdentity emp={b} /> : null);
    const pdEffRole = (b) => {
        const ed = ppDraft && ppDraft.emp && ppDraft.emp.edited ? ppDraft.emp.edited : {};
        return ed.role !== undefined ? ed.role : (b ? b.role : '');
    };
    const pdCopyFail = 'Could not copy. Select the text and copy it yourself.';
    const pdCopy = (text, okMsg) => {
        const cb = typeof navigator !== 'undefined' ? navigator.clipboard : null;
        if (cb && typeof cb.writeText === 'function') {
            try {
                const p = cb.writeText(String(text));
                if (p && typeof p.then === 'function') p.then(() => ppNotify(okMsg, 'success'), () => ppNotify(pdCopyFail, 'error'));
                else ppNotify(okMsg, 'success');
                return;
            } catch (err) { /* falls through to the message below */ }
        }
        ppNotify(pdCopyFail, 'error');
    };

    const pdBtn = (id, label, tone, onClick, o) => {
        const x = o || {};
        const off = !!x.off;
        const look = off ? PP_LOOK.dimmed : tone === 'danger' ? PP_LOOK.danger : tone === 'primary' ? PP_LOOK.primary : PP_LOOK.secondary;
        return (
            <button
                type="button" data-testid={id} data-safe={x.safe ? '1' : undefined} aria-disabled={off ? 'true' : undefined}
                onClick={() => { if (!off) onClick(); else if (typeof x.onOff === 'function') x.onOff(); }}
                className={look + (x.safe ? ' focus:outline-none focus:ring-2 focus:ring-[#0072CE]' : '')}
            >{label}</button>
        );
    };
    const pdDone = (kind) => { setPpConfirm(cur => (cur && cur.kind === kind ? null : cur)); };
    const pdYes = (kind, fn) => () => { fn(); pdDone(kind); };
    const pdCancel = () => { ppCloseConfirm(); };
    const pdTick = (id, checked, label, onChange) => (
        <label className="flex items-start gap-2 text-sm text-slate-800 min-h-[44px] md:min-h-0 py-1">
            <input type="checkbox" data-testid={id} checked={!!checked} onChange={(e) => onChange(!!e.target.checked)} className="mt-0.5 h-4 w-4 flex-shrink-0 accent-[#0072CE]" />
            <span>{label}</span>
        </label>
    );

    const pdNextLabel = (n) => {
        if (!n || !n.sel) return 'Save and close';
        if (n.sel === 'new') return 'Save and add an employee';
        const row = n.row || ppPersonRow(n.sel);
        const nm = row ? pdName(row) : '';
        return nm ? 'Save and open ' + nm : 'Save and open the next person';
    };
    const pdGuardSaveOnce = async () => {
        if (pplLocks.current['ui:guard-save']) return;
        pplLocks.current['ui:guard-save'] = true;
        try { await ppGuardSave(); } finally { delete pplLocks.current['ui:guard-save']; }
    };
    const pdGuardDialog = () => {
        const n = (ppGuard && ppGuard.next) || {};
        const busy = ppSave.phase === 'saving';
        const lines = ppDiffLines.profile.concat(ppDiffLines.training);
        const priv = ppDiffLines.privateCount;
        const dupes = ppSel === 'new' && ppDraft && ppDraft.emp && ppDraft.emp.create && Array.isArray(ppDraft.emp.create.dupes) ? ppDraft.emp.create.dupes : [];
        const namesake = !!n.sel && n.sel !== 'new' && dupes.some(x => x && x.id === n.sel && x.status !== 'left');
        return (
            <PpDialog
                kind="unsaved" title="Unsaved changes"
                onEscape={() => { if (!busy) ppGuardKeep(); }}
                footer={(
                    <React.Fragment>
                        {pdBtn('pp-guard-keep', 'Keep editing', 'secondary', () => ppGuardKeep(), { safe: true, off: busy })}
                        {pdBtn('pp-guard-discard', 'Discard my changes', 'danger', () => ppGuardDiscard(), { off: busy })}
                        {namesake ? null : pdBtn('pp-guard-save', busy ? 'Saving...' : pdNextLabel(n), 'primary', () => { pdGuardSaveOnce(); }, { off: busy })}
