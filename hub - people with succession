    const errText = error && typeof error === 'object' ? String(error.text || '') : (error ? String(error) : '');
    const errCode = error && typeof error === 'object' ? String(error.code || 'invalid') : 'invalid';
    const errId = id + '-err', helpId = id + '-help';
    const describedBy = (errText ? errId : '') + (errText && help ? ' ' : '') + (help ? helpId : '');
    let control = children;
    if (React.isValidElement(children) && typeof children.type === 'string' && /^(input|select|textarea)$/.test(children.type)) {
        const add = {};
        if (!children.props.id) add.id = id;
        if (!children.props['data-testid']) add['data-testid'] = id;
        if (errText) { add['aria-invalid'] = 'true'; add['data-error'] = errCode; }
        if (describedBy && !children.props['aria-describedby']) add['aria-describedby'] = describedBy;
        control = React.cloneElement(children, add);
    }
    return (
        <div data-changed={changed ? '1' : undefined} className={'min-w-0 pl-2 border-l-[3px] ' + (changed ? 'border-l-[#FFB81C]' : 'border-l-transparent')}>
            <label htmlFor={id} className={PP_LOOK.label}>
                {label}
                {changed ? <span className="ml-2 normal-case tracking-normal text-[10px] font-extrabold text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded px-1">changed</span> : null}
            </label>
            {control}
            {errText ? <p id={errId} role="alert" className="mt-1 text-xs font-bold text-[#B80022]">{errText}</p> : null}
            {help ? <p id={helpId} className="mt-1 text-xs text-slate-600">{help}</p> : null}
        </div>
    );
};

const PP_DIALOG_OPENERS = [];

function ppDialogRef(el) {
    if (el) {
        let prev = null;
        try { prev = document.activeElement; } catch (e) { prev = null; }
        PP_DIALOG_OPENERS.push(prev && prev !== document.body && !el.contains(prev) ? prev : null);
        const safe = el.querySelector('[data-safe="1"]') || el.querySelector('[data-testid="pp-confirm-no"]') || el.querySelector('[data-testid="pp-guard-keep"]')
            || el.querySelector('[data-testid="pp-conflict-keep"]') || el.querySelector('[data-dialog-footer] button')
            || el.querySelector('button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
        (safe || el).focus();
    } else {
        const back = PP_DIALOG_OPENERS.pop();
        if (back && document.body.contains(back)) { try { back.focus(); } catch (e) { /* the control may be gone */ } }
        else {   // SPEC 7.12: the control that opened it is gone (the guard opened from a Succession row, whose tab left the screen): the heading of the open person, so focus is never lost to the page body
            try { const h = document.querySelector('[data-focus="detail-heading"]'); if (h && typeof h.focus === 'function') h.focus(); } catch (e) { /* no heading on this screen */ }
        }
    }
}

function ppOverlayDown(e) {
    if (e.target === e.currentTarget) e.preventDefault();      // a click on the dark area must not pull focus out of the dialog
}

const PpDialog = ({ kind, title, describedBy, children, footer, onEscape }) => {
    const k = kind || 'confirm';
