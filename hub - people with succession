async function sceRun(a, kind) {
    const crew = kind === 'framework' ? '' : scCrewOf(a.crew);
    if (kind === 'succession' && !crew) return peFail(a, 'Choose a crew first. Nothing was sent.', { code: 'no_crew', offers: [] });
    if (!a.hasSend) return peNoWrite(a);
    const lock = SC_FLOW + (a.key || sceKey(kind, crew));
    if (!peFlowTake(lock)) return peBusy();
    try {
        const s = { kind: kind, crew: crew, row: a.row, base: a.base, doc: a.doc, conflictChoice: a.conflictChoice };
        return a.row ? await sceSaveInner(a, s) : await sceCreateInner(a, s);
    } catch (e) { return peCrash(a); } finally { peFlowFree(lock); }
}
async function sceSavePlan(a0) { return sceRun(peStart(a0), 'succession'); }
