const PP_TABLE_STATUS_WORDS = { found: 'Found', 'found-unconfirmed': 'Found (no rows yet), not confirmed until the first save', missing: 'Missing', unknown: 'Could not check' };

function ppColumnsRows(t) {
    const spec = t && ppHas(PPL_COLUMN_SPECS, t.key) ? PPL_COLUMN_SPECS[t.key] : null;
    if (!spec) return null;
    const cols = t.report && Array.isArray(t.report.columns) ? t.report.columns : spec.columns.map(c => ({ logical: c.logical, display: c.display, type: c.type, need: c.need, why: c.why, status: 'unknown', pickedKey: '' }));
    return { spec: spec, cols: cols };
}

