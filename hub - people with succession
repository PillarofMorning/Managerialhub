            <div
                role="alertdialog" aria-modal="true" aria-labelledby="pp-dialog-h" aria-describedby={bodyId} tabIndex={-1}
                ref={ppDialogRef}
                onKeyDown={(e) => {
                    if (e.key === 'Escape' || e.key === 'Esc') { e.stopPropagation(); e.preventDefault(); if (onEscape) onEscape(e); return; }
                    trapTabKey(e);
                }}
                data-panel={k === 'unsaved' ? 'people-guard' : 'people-confirm'} data-confirm={k}
                className="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[92vh] flex flex-col overflow-hidden"
