function ppEditedForPatch(emp) {
    const ed = emp && emp.edited ? emp.edited : {};
    const out = {};
    if (ed.last !== undefined || ed.first !== undefined || ed.mi !== undefined) {
        const p = emp && emp.base && emp.base.nameParts ? emp.base.nameParts : { last: '', first: '', mi: '' };
        out.name = composeEmployeeName(ed.last !== undefined ? ed.last : p.last, ed.first !== undefined ? ed.first : p.first, ed.mi !== undefined ? ed.mi : p.mi);
    }
    ['role', 'crew', 'jobRole', 'email', 'badge'].forEach(k => { if (ed[k] !== undefined) out[k] = ed[k]; });
    return out;
}
function ppNameParts(emp) {
    const ed = emp && emp.edited ? emp.edited : {};
    if (ed.last === undefined && ed.first === undefined && ed.mi === undefined) return null;
    const p = emp && emp.base && emp.base.nameParts ? emp.base.nameParts : { last: '', first: '', mi: '' };
    return { last: ed.last !== undefined ? ed.last : p.last, first: ed.first !== undefined ? ed.first : p.first, mi: ed.mi !== undefined ? ed.mi : p.mi };
}
function ppEditedForCheck(emp) {
    const out = ppEditedForPatch(emp);
    const parts = ppNameParts(emp);
    if (parts) { delete out.name; out.last = parts.last; out.first = parts.first; out.mi = parts.mi; }
    return out;
}
function ppStoreOfTable(table) {
    const t = String(table || '').toLowerCase();
    const pairs = [['emp', 'employee'], ['plan', 'plan'], ['pip', 'pip'], ['team', 'team'], ['jobrole', 'jobrole']];
    for (let i = 0; i < pairs.length; i++) {
        const names = PPL_TABLES[pairs[i][1]] || [];
        if (names.some(n => String(n).toLowerCase() === t)) return pairs[i][0];
    }
    return /pip/.test(t) ? 'pip' : '';
}
function ppFirst(emp) {
    const f = emp && emp.nameParts && typeof emp.nameParts.first === 'string' ? emp.nameParts.first.trim() : '';
    return f || 'them';
}
function ppCrewText(crew) { return /^[A-D]$/.test(String(crew || '')) ? 'Crew ' + crew : 'No crew'; }
function ppFlagLines(empBase, t) {
    const out = [];
    if (!t || !t.flag) return out;
    const wasOn = !!(empBase && empBase.inTraining === true);
    const wasArea = empBase && typeof empBase.trainingArea === 'string' ? empBase.trainingArea.trim() : '';
    const area = String(t.flag.area || '').trim();
    if (t.flag.on !== wasOn) out.push({ field: 'flag', text: 'In training: ' + (wasOn ? 'on' : 'off') + ' to ' + (t.flag.on ? 'on' : 'off') });
    if (t.flag.on && area !== wasArea) out.push({ field: 'area', text: 'Training area: ' + (wasArea || 'nothing') + ' to ' + (area || 'nothing') });
    return out;
}

