    };

    const pdPickTarget = (tk, lg) => {
        if (tk === 'jobrole') return lg === 'craa5_name' ? { store: 'jobrole', field: 'name' } : null;
        const store = tk === 'employee' ? 'emp' : tk;
        const map = PPL_COLS[store];
        if (!map) return null;
        const keys = Object.keys(map);
        for (let i = 0; i < keys.length; i++) { if (map[keys[i]] === lg) return { store: store, field: keys[i] }; }
        return null;
    };
    const pdColMissing = (tk, lg, picked) => {
        if (ppColState(tk, lg) === 'missing') return true;
        const e = ppCols[tk];
        const low = String(picked || '').toLowerCase();
        return !!(low && e && (e.missing || []).some(n => String(n).toLowerCase() === low));
    };
    const pdTableCardState = (tk) => {
        const ts = ppTableState(tk);
        if (ts === 'missing') return 'missing';
        const sub = ppDraft ? (tk === 'plan' ? ppDraft.training : tk === 'pip' ? ppDraft.pip : null) : null;
        if (sub && sub.phase === 'error' && sub.error && sub.error.kind === 'missing_table') return 'missing';
        if (ts === 'found-unconfirmed') return 'unconfirmed';
        const e = ppCols[tk];
        if (ts === 'unknown' && e && e.error && e.error.kind === 'other') return 'unreachable';
        return '';
    };
    const pdMarkChecked = (tk) => { setPpUiState(u => Object.assign({}, u, { cardChecked: Object.assign({}, u.cardChecked, { [tk]: pplNow() }) })); };
    const pdCardChecked = (tk) => (ppUi.cardChecked && typeof ppUi.cardChecked[tk] === 'number' ? ppUi.cardChecked[tk] : 0);
    const pdStatusText = (tk, e) => {
        const pickNote = ppUi.pickNote && typeof ppUi.pickNote[tk] === 'string' ? ppUi.pickNote[tk] : '';   // fix T1 (columns:F-BOGUSPICK): why the typed column was not used
        if (pickNote) return pickNote;
        const err = e && e.error ? e.error : null;
        const mark = pdCardChecked(tk);
        const ownAt = e && typeof e.checkedAt === 'number' ? e.checkedAt : 0;
        const at = Math.max(ownAt, mark);
        if (!at) return '';
        if (err && err.kind === 'missing_table') return 'Last checked ' + pplTimeLabel(at) + ' - still missing';
        if (err) return tk !== 'pip' && err.text ? 'Could not check: ' + String(err.text).slice(0, 300) : 'Checked at ' + pplTimeLabel(at) + '. Could not read this table.';
        if (ownAt && ownAt >= mark && tk !== 'pip' && e.confirmed !== false && e.report && Array.isArray(e.report.columns) && e.report.columns.length && e.report.columns.every(c => c.status === 'unknown')) return 'Checked at ' + pplTimeLabel(at) + '. Could not check: no rows came back to look at.';
        return ownAt && ownAt >= mark && tk !== 'pip' ? pplColStatusText(e) : 'Checked at ' + pplTimeLabel(at) + '.';
    };
    const renderPeopleMissing = (tableKey, logical) => {
        const tk = String(tableKey || '');
        if (PPQ_TABLE_KEYS.indexOf(tk) < 0) return null;
        const lg = String(logical || '');
        const e = ppCols[tk] || pplNewColEntry();
        let spec = null;
        let picks;
        let target = null;
        let title;
        let text;
        if (!lg) {
            const state = pdTableCardState(tk);
            if (!state) return null;
            spec = { tableKey: tk, state: state, tableName: pplRememberedTable(tk) || '' };
        } else {
            if (pdTableCardState(tk) === 'missing') return null;   // the table card says it; no card per column of a table that is not there
            target = pdPickTarget(tk, lg);
            const stored = pplLsGet('stillwell.columnPicks', {});
            const pk = target && target.store !== 'jobrole' ? pplCol(target.store, target.field, stored) : '';
            const wrongType = lg === 'craa5_data' && (tk === 'plan' || tk === 'pip') && !!(e.types && (e.types[lg] === 'wrong' || e.types[lg] === 'richtext'));
            const gone = pdColMissing(tk, lg, pk !== lg ? pk : '');
            if (!gone && !wrongType) return null;
            spec = { tableKey: tk, logical: lg };
            if (!gone) {   // the column is there but is not plain multiline text (for example Rich text): the generated words would say it is absent
                title = 'Data column has the wrong type';
                text = ['The ' + (tk === 'pip' ? 'PIP plan' : 'People plan') + ' table has a "Data" column, but it is not plain multiline text, so a plan cannot be saved in it. Create the column again with the type shown below.'];
            }
            if (target) {
                const keys = tk === 'employee' || tk === 'pip' ? [] : pickableKeys(e.rows);
                const have = stored && typeof stored['ppl.' + target.store + '.' + target.field] === 'string' ? stored['ppl.' + target.store + '.' + target.field] : '';
                picks = { keys: keys, current: have, typed: !keys.length };
            }
        }
        return (
            <PpMissingCard
                panel="people-missing" spec={spec} title={title} text={text} picks={picks} busy={!!e.busy} statusText={pdStatusText(tk, e)}
                onCheck={(name) => { pdMarkChecked(tk); return ppCheckAgain(tk, name); }}
                onUse={(v) => { if (target) { pdMarkChecked(tk); ppUsePick(target.store, target.field, v); } }}
            />
        );
    };

    const renderPeopleMissingFirst = (tableKey, logicals) => {
        const list = Array.isArray(logicals) ? logicals : [];
        for (let i = 0; i < list.length; i++) {
            const card = renderPeopleMissing(tableKey, list[i]);
            if (card) return card;
        }
        return null;
    };
    const PD_PLAN_COLUMNS = ['craa5_kind', 'craa5_employeeguid', 'craa5_status', 'craa5_data', 'craa5_name', 'craa5_crew', 'craa5_startdate', 'craa5_duedate', 'craa5_progress'];
    const PD_PIP_COLUMNS = ['craa5_employeeguid', 'craa5_status', 'craa5_data', 'craa5_name', 'craa5_startdate', 'craa5_nextreview'];
    const PD_EMP_REQUIRED_COLUMNS = ['craa5__aa_employeeid', 'craa5_name', 'craa5_role', 'craa5_shift'];

    const PD_BLOCK_TABLES = ['employee', 'plan', 'pip', 'jobrole', 'team'];
    const pdCheckAll = async () => {
        for (let i = 0; i < PD_BLOCK_TABLES.length; i++) { pdMarkChecked(PD_BLOCK_TABLES[i]); await ppCheckAgain(PD_BLOCK_TABLES[i]); }
    };
    const pdToggleSent = (id) => setPpUiState(u => {
        const cur = Array.isArray(u.sentShow) ? u.sentShow : [];
        return Object.assign({}, u, { sentShow: cur.indexOf(id) > -1 ? cur.filter(x => x !== id) : cur.concat([id]) });
    });
    const pdLookupText = (r, label) => {
        if (!r || r.state === 'none') return '';
        if (r.state === 'running') return 'Testing...';
        if (r.text) return r.text;
        return label + (r.state === 'ok' ? ': works' : ': refused') + (r.at ? ', tested ' + pplTimeLabel(r.at) : '');
    };
    const pdLookups = () => {
        const b = pdBase();
        const open = !!(ppDraft && ppDraft.id !== 'new' && ppSel && b && !ppAnyDirty && ppCanWrite);
        const defs = [
            { which: 'jobrole', key: 'jobRole', label: 'Job role', set: !!(b && b.jobRole && b.jobRole.id) },
            { which: 'team', key: 'team', label: 'Crew team', set: !!(b && b.team && b.team.id) }
        ];
        const items = defs.map(d => {
            const r = ppLookup[d.key] || { state: 'none', text: '', at: 0 };
            const busy = r.state === 'running';
            return {
                which: d.which, label: d.label, state: r.state === 'ok' || r.state === 'failed' ? r.state : 'none', text: pdLookupText(r, d.label),
                canTest: open && d.set && !busy, busy: busy, onTest: () => ppAskTestLookup(d.key)
            };
        });
        const answered = (k) => ppLookup[k] && (ppLookup[k].state === 'ok' || ppLookup[k].state === 'failed');
        return { unproven: !(answered('jobRole') && answered('team')), items: items };
    };
    const pdColumnsBlock = () => {
        const picks = pplLsGet('stillwell.columnPicks', {});
        let newest = 0;
        let busy = false;
        const tables = PD_BLOCK_TABLES.map(k => {
            const e = ppCols[k] || pplNewColEntry();
            if (typeof e.checkedAt === 'number' && e.checkedAt > newest) newest = e.checkedAt;
            if (e.busy) busy = true;
            const seen = !!(e.checkedAt || (e.found && e.found.length) || (e.missing && e.missing.length) || (e.rows && e.rows.length));
            const err = e.error ? e.error : null;
            const noteText = err ? (k === 'pip' ? 'details are shown only in the PIP section' : String(err.text || '')) : '';
            return { key: k, status: ppTableState(k), note: noteText, report: seen ? pplColReport(k, e, picks) : null };
        });
        const typeOf = (tk, field) => { const e = ppCols[tk]; return e && e.types ? e.types[pplCol(tk, field, picks)] : ''; };
        const notes = [];
        ['plan', 'pip'].forEach(tk => { if (!notes.some(n => n.id === 'dates') && (typeOf(tk, 'start') === 'datetime' || typeOf(tk, 'due') === 'datetime')) notes.push({ id: 'dates', text: 'Date columns should use Date only.' }); });
        if (typeOf('plan', 'kind') === 'wrong') notes.push({ id: 'kind', text: 'Kind must be Single line of text, not Choice.' });
        if (typeOf('plan', 'status') === 'wrong' || typeOf('pip', 'status') === 'wrong') notes.push({ id: 'status', text: 'Status must be Single line of text, not Choice.' });
        return (
            <PpColumnsBlock
                key="columns" panel="people-columns" tables={tables} checkedAt={newest || undefined} busy={busy} onCheckAll={() => { pdCheckAll(); }} lookups={pdLookups()}
            >
                {notes.map(n => <p key={n.id} data-testid={'pp-columns-note-' + n.id} className="text-sm text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded-lg px-3 py-2">{n.text}</p>)}
                <p data-testid="pp-lookup-hint" className="text-xs text-slate-600">Open a person who has a job role or a crew team link and no unsaved changes to run these tests. Each test asks first.</p>
            </PpColumnsBlock>
        );
    };
    const pdSameTable = () => {
        const a = String(ppCols.pip.table || pplRememberedTable('pip') || '').toLowerCase();
        const b = String(ppCols.plan.table || pplRememberedTable('plan') || '').toLowerCase();
        return !!a && a === b;
    };
    const pdPrivacyBlock = () => (
        <details key="privacy" data-panel="people-privacy" className={PP_LOOK.card + ' p-4'}>
            <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-black text-[#00468B] uppercase tracking-widest">Who can see this</summary>
            <div className="mt-3 space-y-3 text-sm text-slate-700">
                <label className="flex items-start gap-2 font-semibold text-slate-800 min-h-[44px] md:min-h-0">
                    <input type="checkbox" data-testid="pp-pip-marks" checked={!!ppPipMarks} onChange={(e) => ppSetPipMarks(!!e.target.checked)} className="mt-0.5 h-4 w-4 flex-shrink-0 accent-[#0072CE]" />
                    <span>Show PIP marks on this screen</span>
                </label>
                <p data-testid="pp-privacy-marks-note">When on, a lock-marked PIP badge shows in the people list and a filter for people on a PIP appears; Succession shows one folded row, Private checks. Turn it off before you share your screen.</p>
                <p data-testid="pp-privacy-off-note" className="text-xs text-slate-600">{'The setting is off every time this page opens and is never remembered. It turns itself off after ' + PP_IDLE_WORDS + ' without use or when this browser tab is hidden.'}</p>
                <div className="space-y-1">
                    <p className="font-semibold text-slate-800">Ask whoever manages Dataverse security to set:</p>
                    <ul className="list-disc pl-5 space-y-1">
                        <li>PIP plan table: Create, Read and Write for the managers who handle PIPs, and nobody else.</li>
                        <li>People plan table: Read and Write for managers only. No lower role, the Training Lead included: training notes (and later the Succession ratings) are in the same table and Dataverse cannot restrict by kind.</li>
                        <li>Switch on auditing for both plan tables and for the Employee columns this page changes (role, crew, email, badge number, job role).</li>
                        <li>Employee table: Write for the managers who use this editor. The table is owned by users, so a manager who does not own a row may be refused; this page will say so.</li>
                    </ul>
                </div>
                {pdSameTable() ? <p data-testid="pp-privacy-same-table" className={PP_LOOK.error}>PIPs are stored with training and succession, so anyone who can read those can read PIPs.</p> : null}
                <p className="text-xs text-slate-600">This page cannot see security roles, so it does not claim that any of this is already set.</p>
                <p data-testid="pp-privacy-never" className="text-xs text-slate-600">Never shown or sent by this app: the PIN, PIP text in a tooltip, the console or the list of what was sent.</p>
            </div>
        </details>
    );
    const renderPeopleBlocks = () => (
        <React.Fragment>
            {pdColumnsBlock()}
            <PpSentBlock
                key="sent" panel="people-sent" sent={ppSent} showPip={ppUi.sentShow}
                onShowPip={(id) => pdToggleSent(id)} onCopy={(text) => pdCopy(text, 'Copied what was sent')}
            />
            {pdPrivacyBlock()}
        </React.Fragment>
    );

    ppLive.current.ppDlg = { dialogs: renderPeopleDialogs, blocks: renderPeopleBlocks, repair: renderPeopleRepair, conflict: renderPeopleConflict, missing: renderPeopleMissing };


    const SCU_ORDER = { order: -1 };
    const scuDoc = () => (scDraftNow && scDraftNow.doc ? scDraftNow.doc : null);
    const scuReadOnly = () => !!(scDraftNow && scDraftNow.readOnly);
    const scuSlot = (slot) => {
        const d = scuDoc();
        const s = d && d.slots && typeof d.slots === 'object' ? d.slots[slot] : null;
        return s && typeof s === 'object' ? s : { primary: null, since: '', next: [], note: '', ts: 0 };
    };
    const scuNextList = (slot) => { const s = scuSlot(slot); return Array.isArray(s.next) ? s.next.filter(n => n && typeof n === 'object') : []; };
    const scuEmp = (id) => {
        const g = cleanGuid(id);
        if (!g) return null;
        const hit = (scEmployees || []).filter(e => e && e.id === g)[0];
        return hit || null;
    };
    const scuBaseSlot = (slot) => {
        const b = scDraftNow && scDraftNow.base && scDraftNow.base.doc && scDraftNow.base.doc.slots ? scDraftNow.base.doc.slots[slot] : null;
        return b && typeof b === 'object' ? b : null;
    };
    const scuPrimaryId = (slot) => { const s = scuSlot(slot); return s.primary && typeof s.primary === 'object' ? cleanGuid(s.primary.id) : ''; };
    const scuPersonName = (p) => { const e = p ? scuEmp(p.id) : null; return e ? (e.display || scvName(e)) : scvName(p); };
    const scuFirstOf = (p) => { const e = p ? scuEmp(p.id) : null; return scvFirst(e || p); };
    const scuChips = (e) => {
        const out = [];
        if (!e) return out;
        if (typeof e.techLevel === 'number') out.push({ kind: 'tech', text: 'Tech ' + e.techLevel });
        else if (scPeopleState === 'read') out.push({ kind: 'role', text: 'Tech level unknown' });
        if (e.inTraining === true) out.push({ kind: 'training', text: 'Training' });
        if (e.status === 'left') out.push({ kind: 'left', text: 'No crew' });
        else if (e.crew && e.crew !== scCrew) out.push({ kind: 'crew', text: scvCrewLabel(e.crew) });
        return out;
    };
    const scuChipNodes = (chips, keyBase) => chips.map((c, i) => <React.Fragment key={keyBase + ':' + i}>{' '}<PpBadge kind={c.kind}>{c.text}</PpBadge></React.Fragment>);
    const scuStateOk = () => scPlanState === 'found' || scPlanState === 'none' || scPlanState === 'duplicate' || scPlanState === 'unreadable' || scPlanState === 'newer';
    const scuCrewWord = () => scvCrewLabel(scCrew) || 'the crews';
    const scuMissing = (tk, logicals) => {
        const card = logicals ? renderPeopleMissingFirst(tk, logicals) : renderPeopleMissing(tk);
        if (!card) return null;
        const asked = card.props.text ? (Array.isArray(card.props.text) ? card.props.text : [card.props.text]) : ppCardParts(card.props.spec).text;
        const words = asked.map(t => String(t).replace(/Profile, the In training box and P[I]P still work\./, 'Profile and the In training box still work.'));
        const unreachable = card.props.spec && card.props.spec.state === 'unreachable' && (tk === 'employee' || tk === 'team');
        if (unreachable) {
            const what = tk === 'employee' ? 'Employee' : 'Leadership teams';
            const waits = tk === 'employee' ? 'The seats below and the checks that need the crew list wait until it answers.' : 'The supervisor check waits until it answers.';
            return <div key={'miss-' + tk} data-missing-table={tk}>{React.cloneElement(card, { panel: 'succession-missing', title: 'The ' + what + ' table did not answer just now.', text: ['This page could not read the ' + what + ' table a moment ago. ' + waits + ' Press Check again. If it keeps happening, tell whoever looks after Dataverse.'] })}</div>;
        }
        return <div key={'miss-' + tk} data-missing-table={tk}>{React.cloneElement(card, { panel: 'succession-missing', text: words })}</div>;
    };

    const renderScHeader = () => (
        <div style={SCU_ORDER} data-panel="succession-header" className="mb-3">
            <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">Succession</h2>
            <p className="text-sm text-slate-500">Who holds each of the seven lead seats on a crew, who is next in line, and who covers the shift if someone is out.</p>
            <div className="mt-3">
                <span id="sc-crew-label" className={PP_LOOK.label}>Crew</span>
                <div role="group" aria-labelledby="sc-crew-label" className="flex flex-wrap gap-1.5">
                    {SC_CREWS.map(c => {
                        const on = scCrew === c;
                        const dirty = (scDiffs[c] || []).length > 0;
                        return (
                            <button
                                key={c} type="button" data-testid={'sc-crew-' + c} data-focus={on ? 'sc-crew' : undefined} data-dirty={dirty ? '1' : undefined} data-now={currentCrew === c ? '1' : undefined}
                                aria-pressed={on} onClick={() => scSelectCrew(c)}
                                className={'px-3 py-1.5 min-h-[44px] md:min-h-0 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap inline-flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 '
                                    + (on ? 'bg-[#0072CE] text-white border-[#0072CE] shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]')}
                            >
                                {dirty ? <span aria-hidden="true" className="inline-block w-2 h-2 rounded-full bg-[#FFB81C] ring-1 ring-white"></span> : null}
                                {'Crew ' + c}
                                {dirty ? <span className="sr-only"> (unsaved changes)</span> : null}
                            </button>
                        );
                    })}
                </div>
            </div>
        </div>
    );

    const renderScFacts = () => {
        const f = scFacts || {};
        const sup = f.supervisor || { text: '' };
        const t3 = f.tech3 || { text: '' };
        const sv = f.saved || { text: '' };
        return (
            <p style={SCU_ORDER} data-testid="sc-facts" className="mb-3 text-sm font-semibold text-slate-700 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span data-fact="supervisor">{sup.text}</span>
                <span aria-hidden="true">{' · '}</span>
                <span data-fact="tech3" data-over={t3.state === 'ok' && t3.over ? '1' : undefined}>{t3.text}</span>
                <span aria-hidden="true">{' · '}</span>
                <span data-fact="saved" data-state={sv.state}>{sv.text}</span>
            </p>
        );
    };

    const scuStateStrip = () => {
        const st = scPlanState;
        const dr = scDraftNow;
        if (st === 'loading') {
            return (
                <div style={SCU_ORDER} data-testid="sc-loading" role="status" className={PP_LOOK.info + ' mb-4'}>
                    <div>{'Reading the succession plans and ' + scuCrewWord() + '...'}</div>
                    <div aria-hidden="true" className="mt-2 h-1 rounded bg-[#B3D4F2] overflow-hidden"><div className="h-1 w-1/3 bg-[#0072CE] animate-pulse"></div></div>
                </div>
            );
        }
        if (st === 'preview') return <div style={SCU_ORDER} data-testid="sc-preview" role="status" className={PP_LOOK.warn + ' mb-4'}>{SC_TEXT.noApi}</div>;
        if (st === 'missing') return <div style={SCU_ORDER} className="mb-4">{scuMissing('plan')}</div>;
        if (st === 'error') {
            const colCard = scPlans && scPlans.error && scPlans.error.kind === 'missing_column' ? scuMissing('plan', SC_PLAN_REQUIRED_COLUMNS) : null;
            if (colCard) return <div style={SCU_ORDER} className="mb-4">{colCard}</div>;
            const errText = scPlans && scPlans.error ? ppErrText(scPlans.error) : '';
            return (
                <div style={SCU_ORDER} data-testid="sc-plans-error" role="alert" className={PP_LOOK.error + ' mb-4'}>
                    <div>{'The succession plans could not be read.' + (errText ? ' Dataverse said: "' + errText + '"' : '')}</div>
                    <button type="button" data-testid="sc-plans-retry" onClick={() => scTryAgain('plan')} className={PP_LOOK.secondary + ' mt-2'}>Try again</button>
                </div>
            );
        }
        if (st === 'unreadable' || st === 'newer') {
            const hiddenPlan = dr && dr.mode === 'hidden';
            const text = st === 'newer' ? SC_TEXT.newer : hiddenPlan ? SC_TEXT.hidden : SC_TEXT.unreadable;
            const saved = dr && typeof dr.recoveredText === 'string' ? dr.recoveredText : '';
            return (
                <div style={SCU_ORDER} className="mb-4">
                    <div data-testid="sc-readonly-note" data-state={st} className={PP_LOOK.warn} role="status">
                        <p>{text}</p>
                        {st === 'unreadable' ? <p className="mt-1" data-testid="sc-readonly-who">{hiddenPlan ? SC_TEXT.askAccess : SC_TEXT.askFix}</p> : null}
                        {st === 'unreadable' && saved ? (
                            <button type="button" data-testid="sc-show-text" aria-expanded={scUi.showText ? 'true' : 'false'} onClick={() => scSetUi({ showText: !scUi.showText })} className={PP_LOOK.secondary + ' mt-2'}>
                                {scUi.showText ? 'Hide the saved text' : 'Show the saved text'}
                            </button>
                        ) : null}
                    </div>
                    {st === 'unreadable' && saved && scUi.showText ? (
                        <pre data-testid="sc-saved-text" className="mt-2 text-xs leading-snug bg-slate-50 border border-slate-200 rounded p-2 overflow-x-auto whitespace-pre-wrap break-all text-slate-700 max-h-60 overflow-y-auto">{saved.slice(0, 4000)}</pre>
                    ) : null}
                </div>
            );
        }
        return null;
    };

    const scuGapRow = (g, i, isPrivate) => {
        const sev = g.severity === 'fix' ? 'fix' : g.severity === 'check' ? 'check' : 'info';
        const look = isPrivate ? 'bg-slate-100 border-slate-300' : sev === 'fix' ? 'bg-[#FDE8EC] border-[#E4002B]/40' : sev === 'check' ? 'bg-[#FFF6E0] border-[#FFB81C]' : 'bg-[#E6F1FB] border-[#B3D4F2]';
        const wordLook = isPrivate ? 'text-slate-700' : sev === 'fix' ? 'text-[#B80022]' : sev === 'check' ? 'text-slate-800' : 'text-[#00468B]';
        const label = scvGapButton(g);
        const typeId = g.type === 'not-checked' ? 'not-checked' : g.type;
        return (
            <li
                key={g.type + ':' + (g.slot || '') + ':' + (g.personId || '') + ':' + i}
                data-gap={g.type} data-severity={isPrivate ? undefined : sev} data-slot={g.slot || ''} data-private={isPrivate ? '1' : undefined}
                className={'flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border px-3 py-2 ' + look}
            >
                <span className={'text-[11px] font-black uppercase tracking-wider w-14 flex-shrink-0 ' + wordLook}>{(isPrivate ? 'Private' : scvGapWord(sev)) + ' '}</span>
                <span className="flex-1 min-w-[12rem] text-sm text-slate-800">{g.text}</span>
                {label ? (
                    <button type="button" data-testid={'sc-gap-go-' + typeId} data-slot={g.slot || undefined} onClick={() => scGoTo(g)} className={PP_LOOK.secondary + ' flex-shrink-0 max-w-full text-left'}>{label}</button>
                ) : null}
            </li>
        );
    };
    const renderScGaps = () => {
        if (scPlanState === 'none') {
            return <p style={SCU_ORDER} data-testid="sc-not-set-up" className={PP_LOOK.info + ' mb-4'}>{SC_TEXT.notSetUp}</p>;
        }
        if (scPlanState !== 'found' && scPlanState !== 'duplicate') return null;
        const g = scGaps;
        if (!g || !g.ran) return null;
        if (g.checking) {
            return (
                <section style={SCU_ORDER} data-panel="succession-gaps" data-fix-count="0" data-check-count="0" data-checking="1" aria-label="Gaps" className={PP_LOOK.card + ' mb-4 px-4 py-3'}>
                    <p data-testid="sc-gaps-checking" role="status" className="text-sm font-bold text-slate-700">Checking...</p>
                </section>
            );
        }
        const open = scUi.gapsOpen === null || scUi.gapsOpen === undefined ? scvWide() : !!scUi.gapsOpen;
        const listClass = scUi.gapsOpen === null || scUi.gapsOpen === undefined ? 'hidden lg:block' : (scUi.gapsOpen ? 'block' : 'hidden');
        const rows = Array.isArray(g.rows) ? g.rows : [];
        const priv = Array.isArray(g.priv) ? g.priv : [];
        const pOpen = !!scUi.privateOpen;
        const clean = g.fixCount === 0 && g.checkCount === 0;
        return (
            <section style={SCU_ORDER} data-panel="succession-gaps" data-fix-count={g.fixCount} data-check-count={g.checkCount} aria-label="Gaps" className={PP_LOOK.card + ' mb-4 overflow-hidden'}>
                <button
                    type="button" data-testid="sc-gaps-toggle" aria-expanded={open ? 'true' : 'false'} aria-controls="sc-gaps-list" onClick={() => scSetUi({ gapsOpen: !open })}
                    className={'w-full flex items-center justify-between gap-3 text-left px-4 py-3 min-h-[44px] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0072CE]/60 ' + (clean && !rows.length ? 'bg-[#E6F1FB] text-[#00468B]' : 'bg-white text-slate-800')}
                >
                    <span data-testid="sc-gaps-headline" className="text-sm font-black">{g.headline}</span>
                    {open ? <ChevronUpIcon className="w-4 h-4 flex-shrink-0" /> : <ChevronDownIcon className="w-4 h-4 flex-shrink-0" />}
                </button>
                <div id="sc-gaps-list" className={listClass + ' px-3 pb-3'}>
                    {rows.length ? <ul className="space-y-2">{rows.map((r, i) => scuGapRow(r, i, false))}</ul> : null}
                </div>
                {ppPipMarks ? (
                    <div data-panel="succession-private" data-private-count={g.privateCount} className="border-t border-slate-200 px-3 py-2">
                        <button
                            type="button" data-testid="sc-private-toggle" aria-expanded={pOpen ? 'true' : 'false'} aria-controls={pOpen ? 'sc-private-list' : undefined} onClick={() => scSetUi({ privateOpen: !pOpen })}
                            className="w-full flex items-center justify-between gap-3 text-left min-h-[44px] md:min-h-0 px-1 py-1 text-sm font-bold text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 rounded"
                        >
                            <span className="inline-flex items-center gap-2"><LockIcon className="w-3.5 h-3.5 text-slate-600" />{'Private checks (' + g.privateCount + ')'}</span>
                            {pOpen ? <ChevronUpIcon className="w-4 h-4 flex-shrink-0" /> : <ChevronDownIcon className="w-4 h-4 flex-shrink-0" />}
                        </button>
                        {pOpen ? <ul id="sc-private-list" className="mt-2 space-y-2">{priv.map((r, i) => scuGapRow(r, i, true))}</ul> : null}
                    </div>
                ) : null}
            </section>
        );
    };

    const scuSeatChips = (slot) => {
        const s = scuSlot(slot);
        const e = s.primary ? scuEmp(s.primary.id) : null;
        return scuChips(e);
    };
    const scuNextRow = (slot, n, i, ro) => {
        const e = scuEmp(n.id);
        const name = scuPersonName(n);
        const ready = SC_READY_OPTIONS.some(o => o.value === n.ready) ? n.ready : 'now';
        const asked = scUi.removeAsk && scUi.removeAsk.slot === slot && scUi.removeAsk.index === i;
        const only = scuNextList(slot).length === 1;
        const first = scuFirstOf(n);
        const open = !!(scUi.picker && scUi.picker.slot === slot && scUi.picker.mode === 'next' && scUi.picker.index === i);
        return (
            <li key={cleanGuid(n.id) + ':' + i} data-next="1" data-person={cleanGuid(n.id)} data-readiness={ready} className="rounded-lg border border-slate-200 bg-slate-50 px-2 py-2">
                <div className="flex flex-wrap items-center gap-2">
                    <span aria-hidden="true" className="text-xs font-black text-slate-500 w-4 text-center">{i + 1}</span>
                    <button
                        type="button" data-testid={'sc-next-person-' + slot + '-' + i} data-focus={'next:' + slot + ':' + i} aria-haspopup="listbox" aria-expanded={open ? 'true' : 'false'} aria-disabled={ro ? 'true' : undefined}
                        onClick={() => { if (!ro) { if (open) scClosePicker(); else scOpenPicker({ slot: slot, mode: 'next', index: i }); } }}
                        className="min-h-[44px] md:min-h-0 max-w-full min-w-0 break-words px-2 py-1 rounded-md text-sm font-bold text-slate-800 bg-white border border-slate-300 hover:bg-slate-50 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60"
                    >{name}</button>
                    {scuChipNodes(scuChips(e).filter(c => c.kind === 'tech' || c.kind === 'left' || c.kind === 'crew'), 'nx' + slot + i)}
                    <div className="ml-auto flex flex-wrap items-center gap-2 min-w-0 max-w-full">
                        <label htmlFor={'sc-readiness-' + slot + '-' + i} className="sr-only">{'Readiness for ' + name}</label>
                        <select
                            id={'sc-readiness-' + slot + '-' + i} data-testid={'sc-readiness-' + slot + '-' + i} value={ready} aria-disabled={ro ? 'true' : undefined}
                            onChange={(ev) => { if (!ro) scSetReady(slot, i, ev.target.value); }}
                            className="border border-slate-300 rounded-lg py-1.5 px-2 min-h-[44px] md:min-h-0 max-w-full text-base md:text-sm font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40"
                        >
                            {SC_READY_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                        </select>
                        <button
                            type="button" data-testid={'sc-next-remove-' + slot + '-' + i} aria-label={'Remove ' + name + ' from next in line for ' + seatName(slot)} aria-disabled={ro ? 'true' : undefined}
                            onClick={() => { if (!ro) scAskRemoveNext(slot, i); }}
                            className={PP_LOOK.secondary}
                        >Remove</button>
                    </div>
                </div>
                {ready === '12_plus' ? <p className="mt-1 ml-6"><PpBadge kind="late">Not ready</PpBadge></p> : null}
                {asked ? (
                    <div
                        role="alert" data-testid="sc-next-remove-strip"
                        onKeyDown={(ev) => { if (ev.key === 'Escape' || ev.key === 'Esc') { ev.stopPropagation(); ev.preventDefault(); scRemoveNextKeep(); } }}
                        className="mt-2 rounded-lg border border-[#E4002B]/40 bg-[#FDE8EC] px-3 py-2 text-sm text-slate-800"
                    >
                        <p className="font-semibold">
                            {'Remove ' + name + ' from next in line for ' + seatName(slot) + '? ' + (first === 'them' ? 'They stay' : first + ' stays') + ' in the company; only this plan changes.'}
                            {only ? ' ' + seatName(slot) + ' will have nobody next in line.' : ''}
                        </p>
                        <div className="mt-2 flex flex-wrap gap-2">
                            <button type="button" data-testid="sc-next-remove-yes" onClick={() => scRemoveNextYes()} className={PP_LOOK.danger}>Yes, remove</button>
                            <button type="button" data-testid="sc-next-remove-keep" data-focus="remove-keep" autoFocus onClick={() => scRemoveNextKeep()} className={PP_LOOK.secondary + ' focus:outline-none focus:ring-2 focus:ring-[#0072CE]/60'}>Keep</button>
                        </div>
                    </div>
                ) : null}
            </li>
        );
    };
    const scuDuties = (slot) => {
        const d = Object.prototype.hasOwnProperty.call(SC_SEAT_DUTIES, slot) ? SC_SEAT_DUTIES[slot] : null;
        const role = SUCCESSION_ROLES.filter(r => r.key === slot)[0];
        if (!d || !role) return null;
        return (
            <details data-testid={'sc-duties-' + slot} className="mt-3">
                <summary className="cursor-pointer text-sm font-semibold text-[#0072CE] min-h-[44px] md:min-h-0 flex items-center">What this seat does</summary>
                <div className="mt-2 text-sm text-slate-700 space-y-2">
                    <ul className="list-disc pl-5 space-y-1">
                        {d.does.map((t, i) => (
                            <li key={i}>{d.ours && d.ourLines.indexOf(i) > -1 ? <em data-ours="1">{t + ' (our reading)'}</em> : t}</li>
                        ))}
                        {d.rule ? <li data-testid={'sc-rule-' + slot}>{d.rule}</li> : null}
                        <li>{SC_TEXT.tech3Seat}</li>
                    </ul>
                    {role.specialist ? <p data-testid={'sc-specialist-' + slot}>{SC_TEXT.specialist + ' ' + SC_TEXT.specialistWho}</p> : null}
                </div>
            </details>
        );
    };
    const renderScSeat = (slot) => {
        const role = SUCCESSION_ROLES.filter(r => r.key === slot)[0];
        if (!role) return null;
        const s = scuSlot(slot);
        const ro = scuReadOnly();
        const pid = scuPrimaryId(slot);
        const empty = !pid;
        const hid = 'sc-seat-' + slot + '-h';
        const tid = 'sc-holder-' + slot + '-t';
        const pk = scUi.picker && scUi.picker.slot === slot ? scUi.picker : null;
        const holderOpen = !!(pk && pk.mode === 'holder');
        const next = scuNextList(slot);
        const holderName = s.primary ? scuPersonName(s.primary) : '';
        const stepsIn = role.stepsInFor === 'supervisor' ? 'the Supervisor' : seatName(role.stepsInFor);
        const base = scuBaseSlot(slot);
        const noteChanged = (s.note || '') !== (base && typeof base.note === 'string' ? base.note : '');
        const refusal = scUi.refusal && scUi.refusal.slot === slot ? scUi.refusal : null;
        return (
            <article
                key={slot} aria-labelledby={hid} data-slot={slot} data-holder={pid} data-empty={empty ? '1' : undefined}
                className={'bg-white rounded-xl border border-slate-200 shadow-sm p-4 min-w-0 ' + SC_INDENT[role.depth > 3 ? 3 : role.depth]}
            >
                <div className="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h3 id={hid} className="text-sm font-black text-[#00468B]">{role.name}</h3>
                    <p className="text-xs text-slate-600">{'Steps in for: ' + stepsIn}</p>
                </div>

                <div className="mt-3">
                    <span className={PP_LOOK.label}>Holder</span>
                    <div className="flex flex-wrap items-center gap-2">
                        <button
                            type="button" id={'sc-holder-' + slot} data-testid={'sc-holder-' + slot} data-focus={'seat:' + slot} aria-haspopup="listbox" aria-expanded={holderOpen ? 'true' : 'false'}
                            aria-labelledby={hid + ' ' + tid} aria-disabled={ro ? 'true' : undefined}
                            onClick={() => { if (!ro) { if (holderOpen) scClosePicker(); else scOpenPicker({ slot: slot, mode: 'holder', index: -1 }); } }}
                            className={'inline-flex items-center justify-between gap-2 min-h-[44px] md:min-h-0 w-full sm:w-auto sm:min-w-[14rem] px-3 py-2 rounded-lg border text-sm font-bold text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 '
                                + (empty ? 'border-dashed border-slate-400 bg-white text-slate-600' : 'border-slate-300 bg-white text-slate-800 hover:bg-slate-50')}
                        >
                            <span id={tid}>{empty ? 'Choose someone' : holderName}</span>
                            <ChevronDownIcon className="w-4 h-4 flex-shrink-0 text-slate-500" />
                        </button>
                        {empty ? <PpBadge kind={scPlanState === 'none' ? 'notset' : 'empty'}>{scPlanState === 'none' ? 'Not set up' : 'Empty'}</PpBadge> : null}
                        {scuChipNodes(scuSeatChips(slot), 'hc' + slot)}
                    </div>
                </div>
                {holderOpen ? renderScPicker(slot) : null}

                <div className="mt-3">
                    <span className={PP_LOOK.label}>Next in line</span>
                    {next.length === 0 ? <p data-testid={'sc-next-none-' + slot} className="text-sm text-slate-600">Nobody next in line yet.</p> : null}
                    {next.length ? <ul className="space-y-2">{next.map((n, i) => scuNextRow(slot, n, i, ro))}</ul> : null}
                    {pk && pk.mode === 'next' ? <div className="mt-2">{renderScPicker(slot)}</div> : null}
                    {next.length < 2 ? (
                        <button
                            type="button" data-testid={'sc-next-add-' + slot} data-focus={'add:next:' + slot} aria-disabled={ro ? 'true' : undefined}
                            onClick={() => { if (!ro) scOpenPicker({ slot: slot, mode: 'next', index: next.length }); }}
                            className={'mt-2 inline-flex items-center gap-1.5 ' + PP_LOOK.secondary}
                        ><PlusIcon className="w-3.5 h-3.5" />Add next in line</button>
                    ) : null}
                </div>
                {refusal ? <p id="sc-picker-refusal" data-testid="sc-picker-refusal" role="alert" className="mt-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm font-semibold text-slate-800">{refusal.text}</p> : null}

                <div className="mt-3">
                    <PpField id={'sc-note-' + slot} label="Note" changed={noteChanged} help={SC_TEXT.noteHelp}>
                        <input
                            type="text" value={s.note || ''} maxLength={SC_NOTE_MAX} spellCheck={false} autoComplete="off" readOnly={ro} placeholder={SC_TEXT.notePlaceholder}
                            onChange={(ev) => { if (!ro) scSetNote(slot, ev.target.value); }} className={PP_LOOK.input + ' min-h-[44px] md:min-h-0' + (ro ? ' bg-slate-50 text-slate-600' : '')}
                        />
                    </PpField>
                </div>
                {scuDuties(slot)}
            </article>
        );
    };
    const renderScSeats = () => (
        <section data-panel="succession-seats" aria-label="The seven lead seats" className="min-w-0 space-y-3">
            {SUCCESSION_ROLES.map(r => renderScSeat(r.key))}
            <p data-testid="sc-seats-foot" className="text-xs text-slate-600">{SC_TEXT.seatsFoot + ' ' + SC_TEXT.gapsFoot}</p>
        </section>
    );

    const renderScSim = () => {
        const res = scSimResult;
        const doc = scSimDoc || scuDoc();       // the draft with the people named as the Employee table names them now (browser S02)
        if (!res || !doc || (scPlanState !== 'found' && scPlanState !== 'duplicate')) return null;
        const ro = scuReadOnly();
        const inputs = scvSimInputs(doc, scSupervisor || null);
        const ticked = Array.isArray(scUi.sim) ? scUi.sim : [];
        const first = doc.cover && Array.isArray(doc.cover.lol) && doc.cover.lol[0] === 'rte' ? 'rte' : 'raw';
        const bad = res.state === 'nobody_left' || res.state === 'open_seats';
        let summaryText = res.summary;
        if (res.state === 'no_effect') {
            const outNames = [];
            inputs.groups.forEach(gr => gr.people.forEach(p => { if (ticked.indexOf(p.id) > -1) outNames.push(p.name); }));
            if (outNames.length === 1) summaryText = outNames[0] + ' is not in a seat, so nothing changes.';
            else if (outNames.length > 1) summaryText = scvJoin(outNames) + ' are not in a seat, so nothing changes.';
        }
        const dutiesLine = res.state === 'idle' || res.state === 'empty_plan' || res.state === 'no_effect' ? '' : scvDutiesLine(res.openSlots);
        const body = (
            <div id="sc-sim-body" className={(scUi.simOpen ? 'block' : 'hidden lg:block') + ' mt-3 space-y-3'}>
                <p className="text-sm text-slate-600">{SC_TEXT.simNote}</p>
                <div role="group" aria-labelledby="sc-sim-inputs-h" className="space-y-2">
                    <div className="flex items-center justify-between gap-2">
                        <span id="sc-sim-inputs-h" className={PP_LOOK.label + ' mb-0'}>Tick everyone who is out</span>
                        <button
                            type="button" data-testid="sc-sim-clear" aria-disabled={ticked.length ? undefined : 'true'} onClick={() => { if (ticked.length) scSimClear(); }}
                            className={ticked.length ? PP_LOOK.secondary : PP_LOOK.dimmed}
                        >Clear all</button>
                    </div>
                    {inputs.groups.length === 0 ? <p className="text-sm text-slate-600">Choose who holds the seats first.</p> : null}
                    {inputs.groups.map(gr => (
                        <div key={gr.id} data-sim-group={gr.id} role="group" aria-label={gr.label}>
                            {gr.id === 'next' ? <p className="text-xs font-bold text-slate-600 mt-2 mb-1">{gr.label}</p> : null}
                            <ul className="space-y-1">
                                {gr.people.map(p => {
                                    const on = ticked.indexOf(p.id) > -1;
                                    return (
                                        <li key={p.id}>
                                            <label className="flex items-start gap-2 min-h-[44px] md:min-h-0 py-1 text-sm font-semibold text-slate-800">
                                                <input
                                                    type="checkbox" data-testid={'sc-sim-' + p.id} data-sim-person={p.id} checked={on} onChange={() => scSimToggle(p.id)}
                                                    className="mt-0.5 h-4 w-4 flex-shrink-0 accent-[#0072CE]"
                                                />
                                                <span>{scvSimLabel(p, gr.id)}</span>
                                            </label>
                                        </li>
                                    );
                                })}
                            </ul>
                        </div>
                    ))}
                </div>
                <div className="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2">
                    <p data-testid="sc-sim-cover-note" className="text-xs text-slate-700">{'Lead of Leads is covered by ' + (first === 'raw' ? 'Raw Lead first, then RTE Lead.' : 'RTE Lead first, then Raw Lead.')}</p>
                    <div className="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="Who covers Lead of Leads first">
                        <button type="button" data-testid="sc-cover-raw" aria-pressed={first === 'raw'} aria-disabled={ro ? 'true' : undefined} onClick={() => { if (!ro) scSetCoverFirst('raw'); }}
                            className={'px-3 py-1.5 min-h-[44px] md:min-h-0 rounded-lg text-xs font-extrabold border whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 ' + (first === 'raw' ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB]')}
                        >Try Raw first</button>
                        <button type="button" data-testid="sc-cover-rte" aria-pressed={first === 'rte'} aria-disabled={ro ? 'true' : undefined} onClick={() => { if (!ro) scSetCoverFirst('rte'); }}
                            className={'px-3 py-1.5 min-h-[44px] md:min-h-0 rounded-lg text-xs font-extrabold border whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 ' + (first === 'rte' ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB]')}
                        >Try RTE first</button>
                    </div>
                </div>
                <div>
                    <p
                        role="status" aria-live="polite" aria-atomic="true" data-testid="sc-sim-summary" data-state={res.state}
                        className={'text-sm font-bold ' + (bad ? 'text-[#B80022]' : res.state === 'covered' ? 'text-[#00468B]' : 'text-slate-700')}
                    >{summaryText}</p>
                    {res.alreadyOpenText ? <p data-testid="sc-sim-already-open" className="mt-1 text-xs text-slate-700">{res.alreadyOpenText}</p> : null}
                </div>
                {res.rows && res.rows.length ? (
                    <ol data-panel="succession-sim-result" data-open-count={(res.openSlots || []).length} data-out={ticked.length} className="space-y-2">
                        {res.rows.map(row => {
                            const open = row.coverBy === 'none';
                            return (
                                <li
                                    key={row.n + ':' + row.slot} data-sim-row="1" data-slot={row.slot} data-acting={row.cover && row.cover.id ? row.cover.id : undefined} data-open={open ? '1' : undefined} data-suggested="1"
                                    className={'rounded-lg border px-3 py-2 text-sm ' + (open ? 'bg-[#FDE8EC] border-[#E4002B]/40' : 'bg-white border-slate-200')}
                                >
                                    <p className="font-bold text-slate-800"><span aria-hidden="true" className="mr-2 text-slate-700">{row.n}</span>{row.openText}</p>
                                    <p className={open ? 'mt-0.5 font-semibold text-[#B80022]' : 'mt-0.5 text-slate-700'}>{row.coverText}</p>
                                    <p className="mt-1 flex flex-wrap items-center gap-1.5">
                                        <span className="text-[10px] font-extrabold uppercase tracking-wider text-slate-600 bg-slate-100 border border-slate-200 rounded-full px-2 py-0.5">Suggested</span>
                                        {row.notReady ? <PpBadge kind="late">Not ready</PpBadge> : null}
                                        {open ? <span className="text-[10px] font-extrabold uppercase tracking-wider text-[#B80022] bg-white border border-[#E4002B]/40 rounded-full px-2 py-0.5">Open</span> : null}
                                    </p>
                                </li>
                            );
                        })}
                    </ol>
                ) : null}
                {dutiesLine ? <p data-testid="sc-sim-duties" className="text-sm font-semibold text-slate-800 rounded-lg bg-[#FFF6E0] border border-[#FFB81C] px-3 py-2">{dutiesLine}</p> : null}
            </div>
        );
        return (
            <section data-panel="succession-sim" data-sim-source="draft" aria-labelledby="sc-sim-h" className="min-w-0 bg-white rounded-xl border border-slate-200 shadow-sm p-4 mt-4 lg:mt-0">
                <h3 id="sc-sim-h" className="hidden lg:block text-sm font-black text-[#00468B]">{SC_TEXT.simTitle}</h3>
                <button
                    type="button" data-testid="sc-sim-toggle" aria-expanded={scUi.simOpen ? 'true' : 'false'} aria-controls="sc-sim-body" onClick={() => scSetUi({ simOpen: !scUi.simOpen })}
                    className="lg:hidden w-full flex items-center justify-between gap-3 text-left min-h-[44px] text-sm font-black text-[#00468B] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]/60 rounded"
                >
                    <span>{SC_TEXT.simTitle}</span>
                    {scUi.simOpen ? <ChevronUpIcon className="w-4 h-4 flex-shrink-0" /> : <ChevronDownIcon className="w-4 h-4 flex-shrink-0" />}
                </button>
                {body}
            </section>
        );
    };

    const scuKeepClear = (ev) => {
        const el = ev.target, root = ev.currentTarget;
        if (!el || !root || typeof el.getBoundingClientRect !== 'function' || typeof root.querySelector !== 'function') return;
        setTimeout(() => {
            const bar = root.querySelector('[data-testid="sc-bar"]');
            const main = typeof root.closest === 'function' ? root.closest('main') : null;
            if (!bar || !main || bar.contains(el)) return;
            const e = el.getBoundingClientRect(), b = bar.getBoundingClientRect();
            if (!e.height || !b.height) return;
            const list = bar.querySelector('[data-panel="succession-diff"]');      // the open list of changes sits ABOVE the bar and covers the page too
            const top = list ? Math.min(b.top, list.getBoundingClientRect().top) : b.top;
            if (e.bottom > top && e.top < b.bottom) main.scrollTop += e.bottom - top + 12;
        }, 0);
    };
    const renderSuccessionTab = () => {
        const f = scFacts || {};
        const t3 = f.tech3 || {};
        const showSeats = scuStateOk();
        const listOpen = !!scUi.changesOpen && (scBarScope() === 'settings' ? ((scSettingsView && scSettingsView.lines) || []).length : (scDiffNow || []).length) > 0;
        return (
            <div
                data-tab-root="succession" data-crew={scCrew} data-plan-state={scPlanState} data-people-state={scPeopleState}
                data-tech3-count={typeof t3.count === 'number' ? t3.count : ''} data-tech3-limit={typeof t3.limit === 'number' ? t3.limit : ''} data-tech3-checked={t3.state === 'ok' ? '1' : '0'}
                onFocus={scuKeepClear} className="flex-1 flex flex-col"
            >
                {renderScHeader()}
                {renderScFacts()}
                {scuStateStrip()}
                {showSeats ? renderScGaps() : null}
                {showSeats ? (
                    <div style={SCU_ORDER} className="lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-4 lg:items-start mb-4">
                        {renderScSeats()}
                        {renderScSim()}
                    </div>
                ) : null}
                {showSeats ? renderScSettings() : null}
                {renderScBlocks()}
                {showSeats && listOpen ? <div aria-hidden="true" data-testid="sc-bar-room" style={Object.assign({}, SCU_ORDER, { height: '40vh', flexShrink: 0 })}></div> : null}
                {showSeats ? renderScBar() : null}
            </div>
        );
    };


    const SCU_PICK_MAX = 30;
    const scuActive = (count) => { const a = scUi.pickerActive; return a && a.ref === scUi.picker && typeof a.n === 'number' && count > 0 ? Math.max(-1, Math.min(a.n, count - 1)) : -1; };
    const scuSetActive = (n) => scSetUi({ pickerActive: { ref: scUi.picker, n: n } });
    const scuRowOf = (c) => {
        const pools = [scPeople && scPeople.rows, scPeople && scPeople.holders, scSearch && scSearch.rows];
        for (let i = 0; i < pools.length; i++) {
            const hit = (pools[i] || []).filter(r => r && r.id === c.id)[0];
            if (hit) return hit;
        }
        if (scKnown && scKnown[c.id]) return scKnown[c.id];
        return { id: c.id, name: c.name, display: c.display, crew: c.crew, role: c.role, status: c.status, techLevel: c.techLevel };
    };
    const scuPickItem = (slot, it) => {
        const pk = scUi.picker;
        if (!pk || !it) return;
        if (it.kind === 'empty') { scClearHolder(slot); return; }
        const row = scuRowOf(it.c);
        if (pk.mode === 'next') scSetNext(slot, pk.index, row);
        else scPick(slot, row);
    };
    const scuOptionChips = (c) => {
        const out = [];
        if (typeof c.techLevel === 'number') out.push({ kind: 'tech', text: 'Tech ' + c.techLevel });
        (c.marks || []).forEach(m => {
            if (m === 'below-tech-3') return;
            const t = scvMarkText(m, c);
            if (t) out.push({ kind: scvMarkKind(m), text: t });
        });
        return out;
    };
    const renderScPicker = (slot) => {
        const pk = scUi.picker;
        if (!pk || pk.slot !== slot) return null;
        const doc = scuDoc();
        const mode = pk.mode === 'next' ? 'next' : 'holder';
        const text = typeof pk.text === 'string' ? pk.text : '';
        const everyone = !!pk.everyone;
        const crewWord = scvCrewLabel(scCrew);
        const letters = normText(text).replace(/ /g, '').length;
        let cands = [];
        let note = '';
        if (everyone) {
            if (letters < PP_SEARCH_MIN) note = 'Type ' + PP_SEARCH_MIN + ' or more letters to search everyone.';
            else {
                cands = seatCandidates((scSearch && scSearch.rows) || [], doc, slot, { crew: scCrew, everyone: true }).filter(c => scvMatches(text, c.name));
                if (scSearch && scSearch.loading) note = 'Searching...';
                else if (scSearch && scSearch.error) note = 'The search could not be read. Type again to try again.';
                else if (!cands.length) note = 'Nobody found.';
            }
        } else if (scPeopleState === 'loading') {
            note = 'Reading ' + crewWord + '...';
        } else if (scPeopleState === 'read') {
            cands = seatCandidates((scPeople && scPeople.rows) || [], doc, slot, { crew: scCrew }).filter(c => scvMatches(text, c.name));
            if (!cands.length) note = text ? 'Nobody on ' + crewWord + ' matches.' : 'Nobody is on ' + crewWord + '.';
        }
        const items = [];
        if (mode === 'holder' && (!text || !cands.length)) items.push({ kind: 'empty' });     // text typed and people found: ArrowDown reaches a person first, so Enter can never empty the seat by mistake (browser J01)
        cands.slice(0, SCU_PICK_MAX).forEach(c => items.push({ kind: 'person', c: c }));
        const more = cands.length > SCU_PICK_MAX;
        const active = scuActive(items.length);
        const listId = 'sc-picker-list-' + slot;
        const optId = (i) => 'sc-opt-' + slot + '-' + i;
        const scuShow = (el) => { if (el && typeof el.scrollIntoView === 'function') { try { el.scrollIntoView({ block: 'nearest' }); } catch (err) { /* an old browser: the list is simply not moved */ } } };
        const title = mode === 'next' ? 'Choose who is next in line for ' + seatName(slot) : 'Choose who holds ' + seatName(slot);
        const onKey = (e) => {
            const n = items.length;
            if (e.key === 'ArrowDown') { e.preventDefault(); if (n) scuSetActive(active + 1 >= n ? 0 : active + 1); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) scuSetActive(active <= 0 ? n - 1 : active - 1); }
            else if (e.key === 'Enter') {
                const persons = items.filter(x => x.kind === 'person');
                const it = active >= 0 ? items[active] : (persons.length === 1 && text ? persons[0] : null);
                e.preventDefault();
                if (it) scuPickItem(slot, it);
            }
        };
        return (
            <div
                data-testid="sc-picker" data-picker-mode={mode} data-slot={slot}
                onKeyDown={(e) => { if (e.key === 'Escape' || e.key === 'Esc') { e.stopPropagation(); e.preventDefault(); scClosePicker(); } }}
                className="mt-2 rounded-xl border border-[#B3D4F2] bg-[#E6F1FB] p-3"
            >
                <div className="flex items-center justify-between gap-2">
                    <label htmlFor="sc-picker-input" className="text-sm font-bold text-slate-800">{title}</label>
                    <button type="button" data-testid="sc-picker-close" onClick={() => scClosePicker()} className={PP_LOOK.secondary}>Cancel</button>
                </div>
                <div className="relative mt-2">
                    <SearchIcon className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                    <input
                        id="sc-picker-input" data-testid="sc-picker-input" data-focus="picker" type="text" autoComplete="off" spellCheck={false}
                        role="combobox" aria-expanded="true" aria-controls={listId} aria-autocomplete="list" aria-activedescendant={active >= 0 ? optId(active) : undefined}
                        placeholder={everyone ? 'Search everyone by name' : 'Search ' + crewWord} value={text}
                        onChange={(e) => { scPickerText(e.target.value); scuSetActive(-1); }} onKeyDown={onKey}
                        className={PP_LOOK.input + ' pl-9 min-h-[44px] md:min-h-0'}
                    />
                </div>
                <ul role="listbox" id={listId} data-testid="sc-picker-list" aria-label={title} className="mt-2 rounded-lg border border-slate-200 bg-white divide-y divide-slate-100 max-h-[40vh] overflow-y-auto">
                    {items.map((it, i) => {
                        const on = i === active;
                        const look = 'flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2 min-h-[44px] md:min-h-0 text-sm cursor-pointer ' + (on ? 'bg-[#E6F1FB]' : 'bg-white hover:bg-slate-50');
                        if (it.kind === 'empty') {
                            return (
                                <li
                                    key="empty" id={optId(i)} ref={on ? scuShow : undefined} role="option" aria-selected={on} data-testid="sc-picker-empty"
                                    onMouseDown={(e) => { e.preventDefault(); scuPickItem(slot, it); }} onClick={() => scuPickItem(slot, it)} className={look}
                                ><span className="font-semibold text-slate-700">Leave this seat empty</span></li>
                            );
                        }
                        const c = it.c;
                        return (
                            <li
                                key={c.id} id={optId(i)} ref={on ? scuShow : undefined} role="option" aria-selected={on} data-person={c.id}
                                onMouseDown={(e) => { e.preventDefault(); scuPickItem(slot, it); }} onClick={() => scuPickItem(slot, it)} className={look}
                            >
                                <span className="font-bold text-slate-800">{c.display || scvName(c)}</span>
                                {c.role === 'lead' ? <React.Fragment>{' '}<span className="text-xs font-semibold text-slate-600">Lead</span></React.Fragment> : null}
                                {scuChipNodes(scuOptionChips(c), 'oc' + c.id)}
                            </li>
                        );
                    })}
                </ul>
                {note ? <p data-testid="sc-picker-note" className="mt-2 text-sm text-slate-600">{note}</p> : null}
                {more ? <p className="mt-1 text-xs text-slate-600">{'Showing the first ' + SCU_PICK_MAX + '. Type to narrow the list.'}</p> : null}
                {!everyone && scPeopleState === 'unreadable' ? (
                    <p role="alert" data-testid="sc-picker-unreadable" className={PP_LOOK.warn + ' mt-2'}>
                        {'The crew list could not be read. '}
                        <button type="button" data-testid="sc-picker-retry" onClick={() => scTryAgain('people')} className="font-bold text-[#0072CE] underline min-h-[44px] md:min-h-0">Try again</button>
                    </p>
                ) : null}
                <div className="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-700">
                    <span>{everyone ? 'Showing people from every crew.' : 'Not on this crew?'}</span>
                    <button
                        type="button" data-testid="sc-picker-everyone" aria-pressed={everyone} onClick={() => scPickerEveryone(!everyone)}
                        className="font-semibold text-[#0072CE] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] rounded-full px-4 py-1.5 min-h-[44px] md:min-h-0"
                    >{everyone ? 'Back to ' + crewWord : 'Search everyone'}</button>
                </div>
                <p className="sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="sc-picker-count">{cands.length + (cands.length === 1 ? ' person' : ' people')}</p>
            </div>
        );
    };

    const scuBtnSafe = 'focus:outline-none focus:ring-2 focus:ring-[#0072CE]/60';
    const renderScConfirm = () => {
        const c = scConfirm;
        if (!c || typeof c !== 'object') return null;
        if (c.kind === 'succession-save') {
            const lines = Array.isArray(c.lines) ? c.lines : [];
            return (
                <PpDialog
                    kind="succession-save" title={'Save ' + (scvCrewLabel(c.crew) || 'this') + ' plan?'} describedBy="sc-confirm-body" onEscape={() => scConfirmNo()}
                    footer={(
                        <React.Fragment>
                            <button type="button" data-testid="pp-confirm-no" data-safe="1" onClick={() => scConfirmNo()} className={PP_LOOK.secondary + ' ' + scuBtnSafe}>Keep editing</button>
                            <button type="button" data-testid="pp-confirm-yes" onClick={() => scConfirmYes()} className={PP_LOOK.primary}>Yes, save the plan</button>
                        </React.Fragment>
                    )}
                >
                    <p id="sc-confirm-body" className="font-semibold text-slate-800">{scvRiskSentence(c.seats, c.names)}</p>
                    {lines.length ? <ul className="list-disc pl-5 space-y-1 text-slate-700">{lines.map((l, i) => <li key={String(l && l.id) + ':' + i}>{l && l.text}</li>)}</ul> : null}
                </PpDialog>
            );
        }
        if (c.kind === 'discard') {
            const n = typeof c.count === 'number' ? c.count : 0;
            const what = (c.scope === 'settings' ? 'The settings go back to what is saved.' : (scvCrewLabel(c.crew) || 'This crew') + ' goes back to what is saved.') + ' You can undo this for ' + (SC_UNDO_DISCARD_MS / 60000) + ' minutes.';
            return (
                <PpDialog
                    kind="discard" title={'Discard ' + n + (n === 1 ? ' change' : ' changes') + '?'} describedBy="sc-confirm-body" onEscape={() => scConfirmNo()}
                    footer={(
                        <React.Fragment>
                            <button type="button" data-testid="pp-confirm-no" data-safe="1" onClick={() => scConfirmNo()} className={PP_LOOK.secondary + ' ' + scuBtnSafe}>Keep editing</button>
                            <button type="button" data-testid="pp-confirm-yes" onClick={() => scConfirmYes()} className={PP_LOOK.danger}>Discard</button>
                        </React.Fragment>
                    )}
                >
                    <p id="sc-confirm-body" className="font-semibold text-slate-800">{what}</p>
                </PpDialog>
            );
        }
        return null;
    };

    const renderScConflict = () => {
        const key = scBarScope() === 'settings' ? 'settings' : scCrew;
        const sv = scSave && scSave[key];
        const c = sv && sv.conflict && typeof sv.conflict === 'object' ? sv.conflict : null;
        if (!c) return null;
        const fields = Array.isArray(c.fields) ? c.fields : [];
        const kept = typeof c.keptCount === 'number' ? c.keptCount : 0;
        const when = typeof c.at === 'number' && c.at > 0 ? pplTimeLabel(c.at) : '';
        const onKey = (e) => { if (e.key === 'Escape' || e.key === 'Esc') { e.stopPropagation(); e.preventDefault(); scConflictChoose('keep'); } };
        return (
            <div data-panel="succession-conflict" data-conflict-kind={c.kind} onKeyDown={onKey} className={PP_LOOK.warn + ' space-y-2 text-left'}>
                <p className="font-bold text-slate-800">{'Someone else saved changes to ' + (c.name || 'this plan') + ' while you were editing.'}</p>
                {when ? <p data-testid="sc-conflict-saved" className="text-xs text-slate-700">{'Saved at ' + when + '.'}</p> : null}
                {fields.length ? (
                    <ul className="space-y-1">
                        {fields.map((f, i) => (
                            <li key={String(f.field) + ':' + i} data-conflict-field={f.field} className="text-sm text-slate-800">
                                {(f.label || 'A detail') + ': you chose ' + f.mineText + ', Dataverse now has ' + f.theirsText}
                            </li>
                        ))}
                    </ul>
                ) : null}
                {kept > 0 ? <p data-testid="sc-conflict-kept" className="text-xs text-slate-700">{(kept === 1 ? '1 seat' : kept + ' seats') + ' from the other version ' + (kept === 1 ? 'was' : 'were') + ' kept.'}</p> : null}
                <div className="flex flex-wrap gap-2">
                    <button type="button" data-testid="sc-conflict-keep" autoFocus onClick={() => scConflictChoose('keep')} className={PP_LOOK.secondary + ' ' + scuBtnSafe}>Keep editing</button>
                    <button type="button" data-testid="sc-conflict-theirs" onClick={() => scConflictChoose('theirs')} className={PP_LOOK.secondary}>Keep their change</button>
                    <button type="button" data-testid="sc-conflict-mine" onClick={() => scConflictChoose('mine')} className={PP_LOOK.primary}>Use my change instead</button>
                </div>
            </div>
        );
    };

    const renderScSettings = () => {
        const v = scSettingsView;
        if (!v) return null;
        const open = !!scUi.settingsOpen;
        const reading = scFw && (scFw.state === 'idle' || scFw.state === 'reading');
        const ro = !!v.readOnly || !!reading;
        const savedPlant = frameworkSettings(scFw && scFw.doc ? scFw.doc : null).tech3Scope === 'plant';
        const d = v.draft || { tech3Cap: '', bypassDays: '' };
        const errs = v.errors || { tech3Cap: '', bypassDays: '' };
        const sv = v.saved || { tech3Cap: 10, bypassDays: 30 };
        const roWhy = scFw && scFw.state === 'newer' ? SC_TEXT.newer : 'The saved settings could not be read, so they cannot be changed here.';
        return (
            <details data-panel="succession-settings" open={open} style={SCU_ORDER} className={PP_LOOK.card + ' p-4 mb-4'}>
                <summary
                    data-focus="settings" onClick={(e) => { e.preventDefault(); scSetUi({ settingsOpen: !open }); }}
                    className="cursor-pointer text-sm font-black text-[#00468B] uppercase tracking-widest min-h-[44px] md:min-h-0 flex items-center gap-2"
                >
                    Succession settings
                    {v.dirty ? <span aria-hidden="true" className="inline-block w-2 h-2 rounded-full bg-[#FFB81C] ring-1 ring-white"></span> : null}
                    {v.dirty ? <span className="sr-only"> (unsaved changes)</span> : null}
                </summary>
                <div className="mt-3 space-y-4 max-w-xl">
                    {reading ? <p data-testid="sc-set-reading" className="text-sm text-slate-600">Reading the saved settings...</p> : null}
                    {v.readOnly && !reading ? <p data-testid="sc-set-readonly" className={PP_LOOK.warn}>{roWhy}</p> : null}
                    {v.usingDefaults && !reading ? <p data-testid="sc-set-defaults" className="text-sm text-slate-600">{SC_TEXT.defaults}</p> : null}
                    <PpField id="sc-set-tech3-cap" label="Limit of Tech 3 people" changed={String(d.tech3Cap) !== String(sv.tech3Cap)} error={errs.tech3Cap} help={'How many Tech 3 people one crew may have. Your slides say ' + frameworkSettings(null).tech3Cap + '.'}>
                        <input type="text" inputMode="numeric" autoComplete="off" spellCheck={false} value={d.tech3Cap} readOnly={ro} onChange={(e) => { if (!ro) scSetSetting('tech3Cap', e.target.value); }} className={PP_LOOK.input + ' min-h-[44px] md:min-h-0' + (ro ? ' bg-slate-50 text-slate-600' : '')} />
                    </PpField>
                    <div>
                        <span className={PP_LOOK.label}>Limit applies to</span>
                        <p data-testid="sc-set-tech3-scope" className="text-sm font-semibold text-slate-800">Each crew</p>
                        <p className="mt-1 text-xs text-slate-600">{SC_TEXT.scopeHelp}</p>
                        {savedPlant ? <p data-testid="sc-set-scope-plant" className={PP_LOOK.warn + ' mt-2'}>{SC_TEXT.scopePlant}</p> : null}
                    </div>
                    <PpField id="sc-set-bypass-days" label="Short-term bypass for the 95 percent SSOP item, at most (days)" changed={String(d.bypassDays) !== String(sv.bypassDays)} error={errs.bypassDays} help={'From 1 to ' + BYPASS_MAX_DAYS + ' days. The built-in value is ' + frameworkSettings(null).bypassDays + '; the slides call a bypass short-term.'}>
                        <input type="text" inputMode="numeric" autoComplete="off" spellCheck={false} value={d.bypassDays} readOnly={ro} onChange={(e) => { if (!ro) scSetSetting('bypassDays', e.target.value); }} className={PP_LOOK.input + ' min-h-[44px] md:min-h-0' + (ro ? ' bg-slate-50 text-slate-600' : '')} />
                    </PpField>
                </div>
            </details>
        );
    };

    const renderScBar = () => {
        const scope = scBarScope() === 'settings' ? 'settings' : 'succession';
        const isSet = scope === 'settings';
        const key = isSet ? 'settings' : scCrew;
        const sv = (scSave && scSave[key]) || scNewSave();
        const dr = scDraftNow;
        const view = scSettingsView || { lines: [], valid: true, errors: {}, readOnly: false };
        const lines = (isSet ? view.lines : scDiffNow) || [];
        const count = lines.length;
        const planRO = !isSet && !!(dr && dr.readOnly);
        const setRO = isSet && !!view.readOnly;
        const blocked = isSet && view.valid === false;
        let phase = sv.phase;
        if (!ppCanWrite || planRO || setRO || blocked) phase = 'readonly';
        if (phase === 'saved' && count > 0) phase = 'idle';
        const ud = scUi.undoDiscard;
        const baseHashNow = isSet ? (scFw && scFw.base ? scFw.base.hash : '') : (dr && dr.base ? dr.base.hash : '');
        const undoOn = !!ud && ud.scope === scope && (isSet || ud.crew === scCrew) && ud.baseHash === baseHashNow && count === 0 && phase !== 'saving';
        const seatsWait = isSet && scDiffNow.length > 0;
        let statusText = '';
        if (phase === 'saved') statusText = sv.message || ('Saved at ' + pplTimeLabel(sv.at));
        else if (sv.message) statusText = sv.message;
        else if (undoOn) statusText = SC_DISCARD_TEXT;
        else if (seatsWait) statusText = scvCrewLabel(scCrew) + ' has ' + scDiffNow.length + (scDiffNow.length === 1 ? ' seat change' : ' seat changes') + ' that are not saved. Close Succession settings to save them.';
        ppLive.current.barStatus = statusText;   // the shell leaves the sr-only live region empty when it would say the same sentence (browser S04, as renderPeopleBar of 40)
        let alertText = null;
        if (phase === 'readonly') {
            if (!ppCanWrite) alertText = PP_NO_WRITE_TEXT;
            else if (planRO) alertText = dr.mode === 'newer' ? SC_TEXT.newer : dr.mode === 'hidden' ? SC_TEXT.hidden : SC_TEXT.unreadable;
            else if (setRO) alertText = scFw && scFw.state === 'newer' ? SC_TEXT.newer : 'The saved settings could not be read, so they cannot be changed here.';
            else alertText = 'Not saved yet. ' + (view.errors && (view.errors.tech3Cap || view.errors.bypassDays) ? (view.errors.tech3Cap || view.errors.bypassDays) : 'Check the numbers above.');
        } else if (phase === 'conflict') alertText = renderScConflict();
        else if (sv.alert) alertText = sv.alert;
        const extra = [];
        if (phase !== 'saving') (sv.offers || []).forEach(id => {
            if (!PP_OFFER_LABELS[id]) return;
            extra.push(<button key={id} type="button" data-testid={'sc-offer-' + id} onClick={() => scRunOffer(id)} className={PP_LOOK.secondary}>{PP_OFFER_LABELS[id]}</button>);
        });
        if (undoOn) extra.push(<button key="undo-discard" type="button" data-testid="sc-undo" data-undo="discard" onClick={() => scUndoDiscard()} className={PP_LOOK.secondary}>Undo</button>);
        if (seatsWait && phase !== 'saving') extra.push(<button key="back-to-plan" type="button" data-testid="sc-back-to-plan" onClick={() => { scSetUi({ settingsOpen: false }); ppFocusTo('save'); }} className={PP_LOOK.secondary}>{'Show ' + (scvCrewLabel(scCrew) || 'the crew') + ' plan'}</button>);
        const crewPlan = (scvCrewLabel(scCrew) || 'Crew') + ' plan';
        return (
            <PpBar
                testPrefix="sc" scope={scope} phase={phase} label={isSet ? 'Succession settings' : crewPlan} count={count} lines={lines.map(l => ({ field: l.field, text: l.text }))}
                statusText={statusText} alertText={alertText} extra={extra.length ? extra : null} errorCode={sv.code || ''} idleText={seatsWait ? 'No settings changes' : undefined}
                saveLabel={isSet ? 'Save settings' : 'Save ' + crewPlan} onSave={() => scSaveSection()} onDiscard={() => scDiscard({})}
                open={scUi.changesOpen} onToggle={() => scSetUi({ changesOpen: !scUi.changesOpen })}
            />
        );
    };

    const SCU_BLOCK_TABLES = ['plan', 'employee', 'team'];
    const scuCheckAll = async () => {
        for (let i = 0; i < SCU_BLOCK_TABLES.length; i++) { await scCheckAgain(SCU_BLOCK_TABLES[i]); }
    };
    const scuCopy = (text) => {
        const cb = typeof navigator !== 'undefined' ? navigator.clipboard : null;
        const fail = 'Could not copy. Select the text and copy it yourself.';
        if (cb && typeof cb.writeText === 'function') {
            try {
                const p = cb.writeText(String(text));
                if (p && typeof p.then === 'function') p.then(() => ppNotify('Copied what was sent', 'success'), () => ppNotify(fail, 'error'));
                else ppNotify('Copied what was sent', 'success');
                return;
            } catch (err) { /* falls through to the message below */ }
        }
        ppNotify(fail, 'error');
    };
    const scuColumnsBlock = () => {
        const picks = pplLsGet('stillwell.columnPicks', {});
        let newest = 0;
        let busy = false;
        const tables = SCU_BLOCK_TABLES.map(k => {
            const e = ppCols[k] || pplNewColEntry();
            if (typeof e.checkedAt === 'number' && e.checkedAt > newest) newest = e.checkedAt;
            if (e.busy) busy = true;
            const seen = !!(e.checkedAt || (e.found && e.found.length) || (e.missing && e.missing.length) || (e.rows && e.rows.length));
            const err = e.error || null;
            return { key: k, status: ppTableState(k), note: err ? String(err.text || '') : '', report: seen ? pplColReport(k, e, picks) : null };
        });
        const blocks = tables.map(ppColumnsRows).filter(Boolean);
        let missingN = 0;
        let foundN = 0;
        let total = 0;
        blocks.forEach(b => b.cols.forEach(c => {
            total++;
            if (c.status === 'found') foundN++;
            if (c.status === 'missing' && c.need !== 'system') missingN++;
        }));
        const line = newest ? 'Checked at ' + ppClock(newest) + '. Found ' + foundN + ' of ' + total + '.' : '';
        return (
            <details key="columns" data-panel="succession-columns" className={PP_LOOK.card + ' p-4'}>
                <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-black text-[#00468B] uppercase tracking-widest">
                    Columns this needs{' '}
                    {missingN > 0 ? <span data-missing-count={missingN} className="inline-block ml-1 text-[11px] font-extrabold normal-case tracking-normal text-[#B80022] bg-[#FDE8EC] border border-[#E4002B]/40 rounded-full px-2 py-0.5">{missingN} missing</span> : null}
                </summary>
                <div className="mt-3 space-y-3">
                    <div className="space-y-1">
                        {tables.map(t => {
                            const spec = PPL_COLUMN_SPECS[t.key];
                            const st = ppHas(PP_TABLE_STATUS_WORDS, t.status) ? t.status : (t.report && t.report.checked ? 'found' : 'unknown');
                            const word = !t.report && st === 'unknown' && !t.note ? 'Not checked yet.' : PP_TABLE_STATUS_WORDS[st] + (st === 'unknown' && t.note ? ': ' + ppErrText(t.note) : '');
                            const tone = st === 'found' ? 'text-[#00468B]' : st === 'missing' ? 'text-[#B80022]' : 'text-slate-800';
                            return <p key={t.key} data-table={spec.table} data-table-status={st} className={'text-sm font-semibold ' + tone}>{spec.label + ': ' + word}</p>;
                        })}
                    </div>
                    <div className="overflow-x-auto">
                        <table className="w-full text-xs text-left">
                            <caption className="sr-only">Columns the Succession tab needs</caption>
                            <thead className="hidden md:table-header-group">
                                <tr className="text-[10px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-200">
                                    <th scope="col" className="py-2 pr-3">Table</th>
                                    <th scope="col" className="py-2 pr-3">Column (display name)</th>
                                    <th scope="col" className="py-2 pr-3">Name in Dataverse</th>
                                    <th scope="col" className="py-2 pr-3">Type</th>
                                    <th scope="col" className="py-2 pr-3">Needed for</th>
                                    <th scope="col" className="py-2">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {blocks.map(b => b.cols.map(c => {
                                    const st = c.status === 'found' || c.status === 'missing' ? c.status : 'unknown';
                                    const tone = 'whitespace-nowrap ' + (st === 'found' ? 'text-[#00468B]' : st === 'missing' ? 'text-[#B80022] font-bold' : 'inline-block text-slate-800 bg-[#FFF6E0] rounded px-1.5 py-0.5');
                                    return (
                                        <tr key={b.spec.table + ':' + c.logical} data-col={c.logical} data-col-status={st} data-col-table={b.spec.table} className="block md:table-row border-b border-slate-100 py-2 md:py-0">
                                            <td className="block md:table-cell md:py-2 md:pr-3 text-slate-600"><span className="md:hidden font-bold text-slate-500">Table: </span>{b.spec.label}</td>
                                            <td className="block md:table-cell md:py-2 md:pr-3 font-semibold text-slate-800"><span className="md:hidden font-bold text-slate-500">Column: </span>{c.display}</td>
                                            <td className="block md:table-cell md:py-2 md:pr-3 font-mono text-slate-700 break-all"><span className="md:hidden font-bold text-slate-500 font-sans">Name in Dataverse: </span>{c.logical}</td>
                                            <td className="block md:table-cell md:py-2 md:pr-3 text-slate-600"><span className="md:hidden font-bold text-slate-500">Type: </span>{c.type}</td>
                                            <td className="block md:table-cell md:py-2 md:pr-3 text-slate-600"><span className="md:hidden font-bold text-slate-500">Needed for: </span>{c.why + ' (' + c.need + ')'}</td>
                                            <td className="block md:table-cell md:py-2"><span className="md:hidden font-bold text-slate-500">Status: </span><span className={tone}>{st === 'found' ? 'Found' : st === 'missing' ? 'Missing' : 'Could not check'}</span>{c.pickedKey ? <span className="text-slate-500">{' (using ' + c.pickedKey + ')'}</span> : null}</td>
                                        </tr>
                                    );
                                }))}
                            </tbody>
                        </table>
                    </div>
                    <div className="space-y-1 text-xs text-slate-600">
                        <p>Never read or shown: the PIN column.</p>
                        <p>Crew numbers: both 1 to 4 and 256000000 to 256000003 are accepted (A to D).</p>
                        <p>Plan details are saved as text in the Data column.</p>
                    </div>
                    <div className="flex flex-wrap items-center gap-3">
                        <button type="button" data-testid="pp-check-all-again" aria-busy={busy ? 'true' : undefined} aria-disabled={busy ? 'true' : undefined}
                            className={busy ? PP_LOOK.dimmed : PP_LOOK.secondary}
                            onClick={() => { if (!busy) scuCheckAll(); }}>{busy ? <LoaderIcon className="w-4 h-4 inline-block mr-1.5 align-text-bottom animate-spin" /> : null}Check all again</button>
                        <p role="status" data-testid="pp-columns-check-line" className="text-sm text-slate-600">{line}</p>
                    </div>
                </div>
            </details>
        );
    };
    const renderScBlocks = () => {
        const cards = [];
        if (scPlanState !== 'missing') cards.push(scuMissing('plan'));
        cards.push(scuMissing('employee'));
        cards.push(scuMissing('employee', PD_EMP_REQUIRED_COLUMNS));                          // a required Employee column the crew list needs (columns Z2); null when none is missing
        cards.push(scuMissing('team'));
        cards.push(scuMissing('team', ['craa5_teamname', 'craa5_teamleademployeeid']));       // the Leadership teams columns that name a supervisor (columns Z3)
        const shown = cards.filter(Boolean);
        return (
            <div style={SCU_ORDER} className="mt-2 mb-4 space-y-3">
                {shown}
                {scuColumnsBlock()}
                <PpSentBlock key="sent" panel="succession-sent" sent={(ppSent || []).filter(e => !ppIsPipEntry(e))} onCopy={(text) => scuCopy(text)} />
            </div>
        );
    };
    const renderSuccessionDialogs = () => renderScConfirm();

    ppLive.current.scr = { tab: renderSuccessionTab, dialogs: renderSuccessionDialogs, dirty: scAnyDirty };
    ppLive.current.sc = {
        state: { scCrew: scCrew, scPlans: scPlans, scPeople: scPeople, scSearch: scSearch, scFw: scFw, scKnown: scKnown, scDraft: scDraft, scSave: scSave, scSettings: scSettings, scUi: scUi, scConfirm: scConfirm },
        derived: { scDraftNow: scDraftNow, scDiffs: scDiffs, scDiffNow: scDiffNow, scSettingsView: scSettingsView, scAnyDirty: scAnyDirty, scSupervisor: scSupervisor, scPlanState: scPlanState, scEmployees: scEmployees, scPeopleState: scPeopleState, scFacts: scFacts, scGaps: scGaps, scSimDoc: scSimDoc, scSimResult: scSimResult },
        set: { scCrew: setScCrew, scPlans: setScPlans, scPeople: setScPeople, scSearch: setScSearch, scFw: setScFw, scKnown: setScKnown, scDraft: setScDraft, scSave: setScSave, scSettings: setScSettings, scUi: setScUiState, scConfirm: setScConfirm },
        ops: {
            scSelectCrew: scSelectCrew, scGoTo: scGoTo, scOpenPerson: scOpenPerson, scTryAgain: scTryAgain, scCheckAgain: scCheckAgain,
            scOpenPicker: scOpenPicker, scClosePicker: scClosePicker, scPickerText: scPickerText, scPickerEveryone: scPickerEveryone, scPick: scPick, scClearHolder: scClearHolder,
            scSetNext: scSetNext, scSetReady: scSetReady, scAskRemoveNext: scAskRemoveNext, scRemoveNextYes: scRemoveNextYes, scRemoveNextKeep: scRemoveNextKeep, scSetNote: scSetNote, scSetCoverFirst: scSetCoverFirst,
            scSimToggle: scSimToggle, scSimClear: scSimClear, scSetSetting: scSetSetting,
            scBarScope: scBarScope, scSavePlan: scSavePlan, scSaveSettings: scSaveSettings, scSaveSection: scSaveSection, scDiscard: scDiscard, scUndoDiscard: scUndoDiscard, scConfirmYes: scConfirmYes, scConfirmNo: scConfirmNo,
            scConflictChoose: scConflictChoose, scCheckSaved: scCheckSaved, scRunOffer: scRunOffer, scShowSent: scShowSent, scSetUi: scSetUi
        },
        render: { renderSuccessionTab: renderSuccessionTab, renderSuccessionDialogs: renderSuccessionDialogs, renderScHeader: renderScHeader, renderScFacts: renderScFacts, renderScGaps: renderScGaps, renderScSeat: renderScSeat, renderScSeats: renderScSeats, renderScSim: renderScSim, renderScPicker: renderScPicker, renderScConfirm: renderScConfirm, renderScConflict: renderScConflict, renderScSettings: renderScSettings, renderScBar: renderScBar, renderScBlocks: renderScBlocks },
        calls: scCallsRef.current
    };


    const tabs = [
        { id: 'people', label: 'People', icon: UsersIcon },
        { id: 'succession', label: 'Succession', icon: ListTreeIcon }
    ];
    const reloading = !!(ppList.loading || ppPlans.loading);
    const todayLabel = ymdLabel(today);
    const scr = (ppLive.current && ppLive.current.scr) || null;

    return (
        <div className="flex flex-col h-screen bg-slate-50 text-slate-800 overflow-hidden" style={{ fontFamily: BRAND_FONT }} data-page="people" data-preview={apiReady ? 'off' : 'on'}>
            <header className="bg-white border-b-4 border-[#FFB81C] flex-shrink-0 z-20">
                <div className="max-w-[1900px] mx-auto px-4 sm:px-7 h-[72px] flex items-center justify-between gap-4">
                    <div className="min-w-0">
                        <h1 className="text-lg font-black text-[#00468B] leading-tight tracking-tight truncate">People</h1>
                        <p className="text-[11px] font-bold text-slate-500 leading-snug break-words">{todayLabel}{currentCrew ? ' · Crew ' + currentCrew + ' is on shift' : ''}</p>
                    </div>
                    <PpBrandLogo />
                </div>
            </header>

            <nav className="bg-white border-b border-slate-200 flex-shrink-0 z-10" aria-label="Pages">
                <div className="max-w-[1900px] mx-auto px-3 sm:px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <div className="brand-tabs flex gap-1.5 overflow-x-auto flex-1 min-w-[280px]">
                        {tabs.map(tab => {
                            const Icon = tab.icon;
                            const isActive = activeTab === tab.id;
                            const dirty = (tab.id === 'people' && ppAnyDirty) || (tab.id === 'succession' && !!(scr && scr.dirty));
                            return (
                                <button
                                    key={tab.id}
                                    type="button"
                                    data-tab={tab.id}
                                    aria-current={isActive ? 'page' : undefined}
                                    onClick={() => requestTab(tab.id)}
                                    className={`px-4 py-2 min-h-[44px] md:min-h-0 text-[11px] font-extrabold uppercase tracking-[0.08em] rounded-xl flex items-center gap-2 whitespace-nowrap flex-shrink-0 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] ${
                                        isActive ? 'bg-[#0072CE] text-white shadow-[0_6px_14px_rgba(0,114,206,0.25)]' : 'text-slate-500 hover:bg-[#E6F1FB] hover:text-[#0072CE]'
                                    }`}
                                >
                                    <Icon className="w-4 h-4" />
                                    <span>{tab.label}</span>
                                    {dirty && <span data-testid="pp-tab-dot" aria-hidden="true" className="inline-block w-2 h-2 rounded-full bg-[#FFB81C] ring-1 ring-white"></span>}
                                    {dirty && <span className="sr-only"> (unsaved changes)</span>}
                                </button>
                            );
                        })}
                    </div>
                    <div className="flex items-center gap-2 flex-shrink-0">
                        <button
                            type="button"
                            data-testid="pp-reload"
                            onClick={() => { if (!reloading) ppReload(); }}
                            aria-disabled={reloading ? 'true' : undefined}
                            className={`text-[11px] font-extrabold uppercase tracking-wider text-[#0072CE] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] rounded-lg px-3 py-2 min-h-[44px] md:min-h-0 whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] ${reloading ? 'opacity-50 cursor-not-allowed' : ''}`}
                        >{reloading ? 'Loading...' : 'Reload data'}</button>
                    </div>
                </div>
            </nav>

            <main className="flex-1 min-h-0 overflow-y-auto relative scroll-pb-24">
                {notice && (
                    <div role="status" data-testid="pp-toast" className={`fixed top-4 right-4 z-[100] max-w-sm px-4 py-3 rounded-xl shadow-lg border text-sm font-bold ${notice.type === 'error' ? 'bg-[#FDE8EC] border-[#E4002B]/40 text-[#B80022]' : 'bg-[#E6F1FB] border-[#B3D4F2] text-[#00468B]'}`}>
                        {notice.message}
                    </div>
                )}
                <div className="p-4 md:p-6 max-w-[1700px] mx-auto w-full min-h-full flex flex-col">
                    {activeTab === 'people' && renderPeopleTab()}
                    {activeTab === 'succession' && scr && scr.tab()}
                    {activeTab === 'succession' && !scr && (
                        <section data-tab-root="succession" className="flex-1 flex flex-col">
                            <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 max-w-2xl">
                                <h2 className="text-base font-black text-[#00468B]">Succession is coming next</h2>
                                <p className="mt-2 text-sm font-semibold text-slate-600">This is where the seven lead seats of each crew will be planned. Nothing is saved here yet, and nothing you do on this tab changes any record.</p>
                                <button
                                    type="button"
                                    data-testid="pp-back-to-people"
                                    onClick={() => requestTab('people')}
                                    className="mt-4 text-[11px] font-extrabold uppercase tracking-wider text-[#0072CE] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] rounded-lg px-3 py-2 min-h-[44px] md:min-h-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]"
                                >Back to People</button>
                            </div>
                        </section>
                    )}
                </div>
            </main>

            {renderPeopleDialogs()}
            {scr ? scr.dialogs() : null}

            <div className="sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="pp-live">{ppLive.current.barStatus && ppLive.current.barStatus === ppStatus ? '' : ppStatus}</div>
        </div>
    );
}

