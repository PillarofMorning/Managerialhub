                <p>{'You have unsaved changes for '}<span className="font-semibold">{pdWho(ppDraft)}</span>{':'}</p>
                <ul data-testid="pp-guard-lines" className="list-disc pl-5 space-y-1">
                    {lines.map((l, i) => <li key={String(l.field) + ':' + i} data-field={l.field}>{l.text}</li>)}
                    {priv > 0 ? <li key="private" data-field="private">{priv === 1 ? '1 private change' : priv + ' private changes'}</li> : null}
                </ul>
            </PpDialog>
        );
    };

    const pdConsequence = (l, b) => {
        const first = ppFirst(b);
        const to = String(l.to === undefined || l.to === null ? '' : l.to);
        const from = String(l.from === undefined || l.from === null ? '' : l.from);
        const out = [];
        if (l.field === 'role') {
            if (to === 'Supervisor' || to === 'Manager') out.push(first + ' will be counted in Active Supervisors on the Overview, listed for Delegation, and gets the Supervisor screens in the Lead hub.');
            else if (to === 'Lead') out.push(first + ' will show as a lead in Shift Start and Ganttly.');
            else if (to === 'Employee' && from && from !== 'Employee') out.push(first + ' will no longer be a ' + from.toLowerCase() + ' in Shift Start and Ganttly.');
        } else if (l.field === 'crew') {
            out.push(to ? first + ' will show on Crew ' + to + ' in Shift Start and Employee Query.' : first + ' will have no crew, so ' + first + ' stops showing in crew lists, Shift Start and Ganttly.');
        } else if (l.field === 'email') {
            out.push(first + ' signs in with this email. Role decides which Lead hub screen ' + first + ' gets; Supervisor and Manager see manager screens. A wrong email lets someone else in as ' + first + '.');
            const hit = ppEmpCheck.byField && ppEmpCheck.byField.email ? ppEmpCheck.byField.email : null;
            if (hit) (hit.errors || []).concat(hit.warnings || []).forEach(x => { if (x && x.text) out.push(String(x.text)); });
            const r = pdEffRole(b);
            if (r === 'supervisor' || r === 'manager') out.push('Tasks assigned to the old email in the Lead hub will not follow.');
        } else if (l.field === 'jobRole') {
            out.push(to ? 'This changes which tasks ' + first + ' receives in Ganttly. This page does not change pay.' : first + ' will have no job role, so Ganttly may give ' + first + ' no tasks.');
        } else if (l.field === 'badge') {
            out.push('Copied into saved task rows; make sure no one else has it.');
        } else if (l.field === 'name') {
            out.push("Rename supervisors between shifts and keep the email, or today's board may not be found.");
        }
        return out;
    };
    const pdSaveRiskyDialog = (c) => {
        const b = pdBase();
        const diff = Array.isArray(c.diff) ? c.diff.filter(l => l && typeof l === 'object') : [];
        const risky = diff.filter(l => l.risky);
        const others = diff.filter(l => !l.risky);
        let access = c.access === 'Supervisor' || c.access === 'Manager' ? c.access : '';
        if (!access) risky.forEach(l => { if (l.field === 'role' && (l.to === 'Supervisor' || l.to === 'Manager')) access = l.to; });
        const title = access ? 'Give ' + (pdName(b) || 'this person') + ' ' + access + ' access?' : (b ? <React.Fragment>{'Please confirm these changes for '}{pdIdent(b)}</React.Fragment> : 'Please confirm these changes');
        return (
            <PpDialog
                kind="save-risky" title={title} onEscape={pdCancel}
                footer={(
                    <React.Fragment>
                        {pdBtn('pp-confirm-no', 'Cancel', 'secondary', pdCancel, { safe: true })}
                        {pdBtn('pp-confirm-yes', 'Yes, save these changes', 'primary', pdYes('save-risky', () => { const then = c.then; Promise.resolve(ppSaveEmployee({ confirmed: true })).then(res => { if (then && res && res.ok) ppSaveThenGo(then, true); }); }))}
                    </React.Fragment>
                )}
            >
                {access && b ? <p>{pdIdent(b)}</p> : null}
                <ul data-testid="pp-risk-list" className="space-y-3">
                    {risky.map((l, i) => (
                        <li key={String(l.field) + ':' + i} data-field={l.field}>
                            <p className="font-bold text-slate-800">{l.text}</p>
                            {pdConsequence(l, b).map((t, j) => <p key={j} className="text-slate-600">{t}</p>)}
                        </li>
                    ))}
                </ul>
                {others.length ? <p data-testid="pp-risk-also" className="text-xs text-slate-600">{'Also saved: ' + others.map(l => l.text).join('; ') + '.'}</p> : null}
            </PpDialog>
        );
    };

    const pdLeftDialog = (c) => {
        const b = pdBase();
        const first = ppFirst(b);
        const crew = b && /^[A-D]$/.test(String(b.crew || '')) ? b.crew : '';
        const linked = !!(b && b.team && b.team.id);
        const open = c.open && typeof c.open === 'object' ? c.open : {};
        const showTraining = !!open.training;
        const showPip = !!(open.pip && open.pipKnown);
        const role = b ? b.role : '';
        const stopped = !!c.checking || !!c.blocked;
        const where = crew ? 'Crew ' + crew : 'their crew';
        const title = b ? <React.Fragment>{pdIdent(b)}{crew ? '. Was Crew ' + crew + '.' : '.'}</React.Fragment> : 'Mark as left the company?';
        const effect = crew || linked
            ? 'This takes ' + first + ' off ' + where + (linked ? ' and removes the crew team link' : '') + ', so ' + first + ' stops showing in crew lists, Shift Start and Ganttly. Nothing is deleted. You can bring ' + first + ' back from No crew.'
            : first + ' has no crew now. Nothing is deleted. You can bring ' + first + ' back from No crew.';
        return (
            <PpDialog
                kind="left" title={title} onEscape={pdCancel}
                footer={(
                    <React.Fragment>
                        {pdBtn('pp-confirm-no', crew ? 'Keep ' + first + ' on Crew ' + crew : 'Keep ' + first + ' as they are', 'secondary', pdCancel, { safe: true })}
                        {pdBtn('pp-confirm-yes', 'Yes, ' + first + ' left the company', 'danger', pdYes('left', () => ppLeaveEmployee({ closeTraining: !!c.closeTraining, closePip: !!c.closePip, alsoEmployeeRole: !!c.alsoRole, confirmed: true })), { off: stopped })}
                    </React.Fragment>
                )}
