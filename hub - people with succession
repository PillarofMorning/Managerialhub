};

const PP_BAR_PHASES = ['idle', 'dirty', 'saving', 'saved', 'partial', 'failed', 'conflict', 'unknown', 'readonly'];

const PpBar = ({ phase, label, count, lines, statusText, alertText, saveLabel, onSave, onDiscard, open, onToggle, extra, testPrefix, scope, errorCode, idleText }) => {
    const p = testPrefix || 'pp';
    const n = typeof count === 'number' && count > 0 ? Math.floor(count) : 0;
    const raw = PP_BAR_PHASES.indexOf(phase) > -1 ? phase : 'idle';
    const shown = raw === 'idle' && n > 0 ? 'dirty' : raw;
    const canSave = shown === 'dirty' || shown === 'partial' || shown === 'failed';
    const canDiscard = n > 0 && shown !== 'saving';
    const items = (Array.isArray(lines) ? lines : []).map(l => (typeof l === 'string' ? { field: '', text: l } : { field: l && l.field ? String(l.field) : '', text: l && l.text ? String(l.text) : '' })).filter(l => l.text);
    const listOpen = !!open && items.length > 0;
    const listId = p + '-changes-list';
    const name = String(label || '').trim();
    const region = /^Save changes/i.test(name) ? name : 'Save changes' + (name ? ' for ' + name : '');
    const saveText = shown === 'saving' ? 'Saving...' : shown === 'saved' && n === 0 ? 'Saved' : (saveLabel || 'Save changes');
    const hasStrip = !!alertText || !!extra;
    const hasStatus = String(statusText === undefined || statusText === null ? '' : statusText).trim() !== '';
    const tone = shown === 'failed' ? 'bg-[#FDE8EC] text-[#B80022] border-b border-[#E4002B]/40 font-bold'
        : (shown === 'partial' || shown === 'unknown' || shown === 'conflict' || shown === 'readonly') ? 'bg-[#FFF6E0] text-slate-800 border-b border-[#FFB81C]'
            : 'bg-[#E6F1FB] text-[#00468B] border-b border-[#B3D4F2] font-semibold';
    const codeAttr = (shown === 'failed' || shown === 'partial') && errorCode ? String(errorCode) : undefined;
    let left;
    if (shown === 'saving') left = <span className="text-sm font-bold text-[#00468B]">Saving...</span>;
    else if (n > 0) {
        left = (
            <button type="button" data-testid={p + '-changes-toggle'} data-focus="changes" aria-expanded={listOpen ? 'true' : 'false'} aria-controls={listOpen ? listId : undefined}
                onClick={onToggle ? onToggle : undefined}
                className="inline-flex items-center gap-2 min-h-[44px] md:min-h-0 px-1 md:px-2 py-1 rounded-md text-sm font-bold text-slate-800 hover:bg-slate-100">
                <span aria-hidden="true" className="w-2 h-2 rounded-full bg-[#FFB81C]"></span>
                {n === 1 ? '1 change' : n + ' changes'}
                {listOpen ? <ChevronDownIcon className="w-3.5 h-3.5" /> : <ChevronUpIcon className="w-3.5 h-3.5" />}
            </button>
        );
    }
    else if (shown === 'saved') left = <CheckIcon className="w-4 h-4 text-[#0072CE]" />;
    else left = <span className="text-sm text-slate-500">{idleText || 'No changes'}</span>;   // idleText (Landing 2, browser R01): the Succession settings bar says "No settings changes" while seat changes wait on another part
    return (
        <div role="region" aria-label={region} data-testid={p + '-bar'} data-phase={shown} data-scope={scope || undefined} data-error-code={codeAttr}
            className="sticky bottom-0 mt-auto -mx-4 md:-mx-6 -mb-4 md:-mb-6 z-10 bg-white border-t border-slate-200 shadow-[0_-2px_8px_rgba(0,0,0,0.06)] pb-[env(safe-area-inset-bottom)] flex flex-col max-h-[40vh]">
            {listOpen ? (
                <div id={listId} data-panel={p === 'sc' ? 'succession-diff' : 'people-diff'}
                    className="absolute bottom-full left-0 right-0 max-h-[40vh] overflow-y-auto bg-white border border-slate-200 border-b-0 rounded-t-xl shadow-[0_-4px_12px_rgba(0,0,0,0.08)] px-3 md:px-6 py-3">
                    <ul className="space-y-1 text-sm text-slate-800">
                        {items.map((l, i) => (
                            <li key={i} data-field={l.field || undefined} className="flex gap-2">
                                <span aria-hidden="true" className="w-1.5 h-1.5 mt-2 rounded-full bg-[#FFB81C] flex-shrink-0"></span>
                                <span className="min-w-0 break-words">{l.text}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ) : null}
            {shown === 'saving' ? <span aria-hidden="true" className="absolute top-0 left-0 right-0 h-0.5 bg-[#0072CE] animate-pulse"></span> : null}
            <div data-bar-strip="1" className={hasStrip ? 'px-3 md:px-6 py-2 text-sm min-h-0 overflow-y-auto ' + tone : ''}>
                <div role="alert" data-testid={p + '-alert'}>{alertText}</div>
                {extra ? <div className="mt-1 flex flex-wrap items-center gap-2">{extra}</div> : null}
            </div>
            <div className="flex flex-wrap items-center gap-x-2 md:gap-x-3 gap-y-1 px-3 md:px-6 py-1 md:py-1.5 shrink-0">
                <div className="flex items-center gap-2 min-w-0">{left}</div>
                <div role="status" aria-live="polite" aria-atomic="true" data-testid={p + '-status'} className={'min-w-0 text-sm font-semibold text-slate-600 break-words ' + (hasStatus ? 'order-first basis-full md:order-none md:basis-0 md:flex-1' : 'flex-1')}>{statusText}</div>
                <div className="flex items-center gap-2 ml-auto flex-shrink-0">
                    <button type="button" data-testid={p + '-discard'} data-focus="discard" aria-disabled={canDiscard ? undefined : 'true'}
                        onClick={() => { if (canDiscard && onDiscard) onDiscard(); }}
                        className={(canDiscard ? PP_LOOK.secondary : PP_LOOK.dimmed).replace('px-4', 'px-3 md:px-4')}>Discard</button>
                    <button type="button" data-testid={scope === 'settings' ? p + '-set-save' : p + '-save'} data-focus="save" aria-disabled={canSave ? undefined : 'true'}
                        onClick={() => { if (canSave && onSave) onSave(); }}
                        className={(canSave ? PP_LOOK.primary : PP_LOOK.dimmed).replace('px-4', 'px-3 md:px-4')}>{saveText}</button>
                </div>
            </div>
        </div>
    );
};

function ppLongType(t) {
    const s = String(t || '');
    let m = /^Text \((\d+)\)$/.exec(s);
    if (m) return 'Text (single line), maximum length ' + m[1];
    m = /^Multiline text \((\d+)\)$/.exec(s);
    if (m) return 'Multiline text (plain, not Rich text), maximum length ' + m[1];
    if (s === 'Date only') return 'Date and time, format Date only, behavior Date only (not User local)';
    m = /^Whole number (\d+) to (\d+)$/.exec(s);
    if (m) return 'Whole number, minimum ' + m[1] + ', maximum ' + m[2];
    if (s === 'Text') return 'Text (single line)';
    return s;
}

const PP_EMP_REQUIRED = ['craa5__aa_employeeid', 'craa5_name', 'craa5_role', 'craa5_shift', 'statecode'];

function ppAfterSentence(tk, lg) {
    if (tk === 'plan') {
        if (lg === 'craa5_crew') return "so a plan's crew is not shown in lists. Everything else here still works.";
        if (lg === 'craa5_startdate' || lg === 'craa5_duedate') return 'so that date is not shown in lists (it is still kept inside the plan). Everything else here still works.';
        if (lg === 'craa5_progress') return 'so the list tag shows plain "Training" instead of the percentage. Everything else here still works.';
        return 'so no training plan, succession plan or framework setting can be found or saved. The Profile, the In training box and PIP still work.';
    }
    if (tk === 'pip') {
        if (lg === 'craa5_startdate' || lg === 'craa5_nextreview') return 'so that date is not shown in lists or usable for reminders (it is still kept inside the PIP). Everything else here still works.';
        return "so the PIP section can't find or save a PIP. The Profile, Training and Succession still work.";
    }
    if (tk === 'employee') {
        if (lg === 'craa5_roleid') return 'so the Job role box is read-only. Everything else here still works.';
        if (lg === 'craa5_leadershipteamid') return 'so this page cannot move a person who has a team link to another crew (Shift Start decides the crew from the team link first). A person with no team link still moves by crew letter.';
        if (lg === 'craa5_email' || lg === 'craa5_badgenumber') return 'so that box is not shown. Everything else here still works.';
    }
    if (tk === 'team' && (lg === 'craa5_teamname' || lg === 'craa5_teamleademployeeid')) return "so the page can't tell who leads a crew and shows \"Not checked\". Crew moves still work.";
    if (tk === 'jobrole' && lg === 'craa5_name') return 'so the Job role box is read-only. Everything else here still works.';
    return 'so that part is not available. Everything else here still works.';
}

