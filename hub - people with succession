        if (!u) return { ok: false, phase: 'nothing' };
        const gone = (text) => { scSetUi({ undoDiscard: null }); ppAnnounce(text); return { ok: false, phase: 'expired' }; };
        if (pplNow() > u.until) return gone('The Undo is no longer available.');
        if (u.scope === 'settings') {
            const fw = st.scFw;
            if ((fw && fw.base ? fw.base.hash : '') !== u.baseHash) return gone('The settings changed while the Undo was waiting, so the Undo is no longer available.');
            setScSettings(u.snap);
        } else {
            const d = st.scDraft[u.crew];
            if (!d || d.readOnly || (d.base ? d.base.hash : '') !== u.baseHash) return gone(scCrewWord(u.crew) + ' changed while the Undo was waiting, so the Undo is no longer available.');
            scPatchDraft(u.crew, cur => (cur.readOnly || (cur.base ? cur.base.hash : '') !== u.baseHash ? cur : Object.assign({}, cur, { doc: safeClone(u.snap) })));
        }
        scSetUi({ undoDiscard: null });
        ppAnnounce('Changes brought back.');
        ppFocusTo('save');
        return { ok: true, phase: 'undone' };
    };
    const scConfirmYes = async () => {
        const c = scxState().scConfirm;
        setScConfirm(null);
        if (!c) return { ok: false, phase: 'nothing' };
        if (c.kind === 'succession-save') return scSavePlan({ crew: c.crew, confirmed: true });
        if (c.kind === 'discard') { scDiscard({ confirmed: true, scope: c.scope, crew: c.crew }); return { ok: true, phase: 'discarded' }; }
        return { ok: false, phase: 'nothing' };
    };
    const scConfirmNo = () => { setScConfirm(null); };

    const scxKeyWith = (test) => {
        const st = scxState();
        const first = scxBarKey();
        const other = first === 'settings' ? st.scCrew : 'settings';
        if (first && test(first)) return first;
        if (other && test(other)) return other;
        return first;
    };
    const scConflictChoose = async (choice) => {
        const st = scxState();
        const key = scxKeyWith(k => !!(st.scSave[k] && st.scSave[k].conflict));
        if (!key || !st.scSave[key] || !st.scSave[key].conflict) return { ok: false, phase: 'idle' };
        const clear = { phase: 'idle', conflict: null, alert: '', message: '', code: '', offers: [] };
        scSetSaveFor(key, clear);
        if (choice !== 'theirs' && choice !== 'mine') { ppFocusTo('save'); return { ok: false, phase: 'idle' }; }
        return key === 'settings' ? scSaveSettings({ conflictChoice: choice }) : scSavePlan({ crew: key, conflictChoice: choice });
    };
    const scCheckSaved = async () => {
        const st = scxState();
        const key = scxKeyWith(k => !!scMemoRef.current['scpending:' + k]);
        const mem = key ? scMemoRef.current['scpending:' + key] : null;
        const scope = key === 'settings' ? 'settings' : 'succession';
        if (!mem) {
            if (key) scSetSaveFor(key, { phase: 'idle', message: 'There was nothing to check.', alert: '', code: '', offers: [], conflict: null, table: '', scope: scope, at: pplNow() });
            return { ok: true, phase: 'idle' };
        }
        scxSaving(key, scope);
        const r = await sceCheckSaved(scxArgs({ crew: key === 'settings' ? '' : key, attempt: mem.attempt }));
        if (r.phase === 'busy') return { ok: false, phase: 'busy' };
        if (r.phase === 'idle') {
            delete scMemoRef.current['scpending:' + key];
            scxBar(key, scope, r);
            return { ok: false, phase: 'idle', code: r.code || '' };
        }
        if (r.phase !== 'saved') {
            scxBar(key, scope, r);
            return { ok: false, phase: r.phase, code: r.code || '' };
        }
        delete scMemoRef.current['scpending:' + key];
        if (key === 'settings') scxAfterSettings(r, mem.typed || null);
        else scxAfterPlan(key, r, mem.savedDoc);
        scxSay(r);
        return r;
    };
    const scShowSent = () => {
        try {
            const el = document.querySelector('[data-panel="succession-sent"]');
            if (!el) return;
            el.open = true;
            if (typeof el.scrollIntoView === 'function') el.scrollIntoView();
            const s = el.querySelector('summary');
            if (s && typeof s.focus === 'function') s.focus();
        } catch (e) { /* a missing DOM feature must not break the page */ }
    };
    const scRunOffer = (id) => {
        switch (id) {
            case 'retry': case 'retry-name': return scSaveSection();
            case 'check-saved': return scCheckSaved();
            case 'show-payload': return scShowSent();
            case 'check-again': { const sv = scxState().scSave[scxBarKey()]; return scCheckAgain(sv && sv.table ? sv.table : 'plan'); }
            case 'reload': return ppReload();
            default: return undefined;
        }
    };

    const PU_CREWS = ['A', 'B', 'C', 'D'];
    const puChipClass = (on) => 'px-3 py-1.5 min-h-[44px] md:min-h-0 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] '
        + (on ? 'bg-[#0072CE] text-white border-[#0072CE] shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]');
    const puChip = (id, on, label, onClick, now) => (
        <button key={id} type="button" data-testid={id} aria-pressed={!!on} data-now={now ? '1' : undefined} onClick={onClick} className={puChipClass(on)}>{label}</button>
    );
    const puInput = (ro, extra) => PP_LOOK.input + (ro ? ' bg-slate-50 text-slate-600' : '') + (extra ? ' ' + extra : '');
    const puCap = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);
    const puNm = (emp) => { const f = ppFirst(emp); return f === 'them' ? 'this person' : f; };
    const puNote = (key, code, children) => (
        <span key={key} data-warning={code || undefined} className="block mt-1.5 text-xs text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1">{children}</span>
    );
    const puDashed = (children, testId) => (
        <div data-testid={testId || undefined} className="bg-white rounded-xl border border-dashed border-slate-300 px-6 py-10 text-center">{children}</div>
    );
    const PU_MISSING_WORDS = [
        [/roleid/i, 'Job roles', 'Job role'],
        [/leadershipteamid/i, 'Crew team links', 'Crew team link'],
        [/intraining/i, 'In training marks', 'In training'],
        [/trainingarea/i, 'Training areas', 'Training area'],
        [/email/i, 'Emails', 'Email'],
        [/badgenumber/i, 'Badge numbers', 'Badge number'],
        [/utilized/i, 'The available-list mark', 'Utilized']
    ];
    const puMissingLines = (missing) => {
        const out = [];
        (missing || []).forEach(m => {
            const name = String(m || '');
            const hit = PU_MISSING_WORDS.filter(w => w[0].test(name))[0];
            const line = hit ? hit[1] + (hit[1] === 'The available-list mark' ? ' is' : ' are') + ' not shown: the ' + hit[2] + ' column could not be read. See Columns this needs.' : 'One column could not be read (' + name.replace(/^_/, '').replace(/_value$/, '') + '). See Columns this needs.';
            if (out.indexOf(line) < 0) out.push(line);
        });
        return out;
    };

    const puRow = (p, dim) => {
        const tag = ppTags[p.id] || { training: { show: false }, pip: false };
        const tr = tag.training || { show: false };
        const showPip = !!(ppPipMarks && tag.pip);
        const jobName = p.jobRoleKnown && p.jobRole ? (p.jobRole.name || ppJobNames()[p.jobRole.id] || '') : '';
        const line2 = [jobName, p.roleLabel].filter(Boolean).join(PP_DOT);
        const searchingNow = String(ppFilters.text || '').trim().length >= PP_SEARCH_MIN;
        const states = [];
        if (tr.show) states.push('training');
        if (tr.show && tr.overdue) states.push('overdue');
        if (showPip) states.push('pip');
        if (p.status === 'left') states.push('left');
        if (ppIsEditing(p.id)) states.push('editing');
        const selected = ppSel === p.id;
        return (
            <li key={p.id}>
                <button
                    type="button" data-person={p.id} data-focus={'row:' + p.id} data-crew={p.crew || ''} data-tech={p.techLevel === null || p.techLevel === undefined ? '' : String(p.techLevel)} data-state={states.join(' ')}
                    aria-current={selected ? 'true' : undefined} onClick={() => ppOpenPerson(p.id, p)}
                    className={'w-full text-left px-3 py-2.5 min-h-[56px] flex items-start justify-between gap-2 border-b border-slate-100 last:border-b-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0072CE] ' + (selected ? 'bg-[#E6F1FB]' : 'bg-white hover:bg-slate-50') + (dim ? ' opacity-60' : '')}
                >
                    <span className="min-w-0 flex-1">
                        <span className="block text-sm font-bold text-slate-800 break-words">{p.name || 'No name'}</span>
                        {line2 ? <span className={'block text-xs ' + (selected ? 'text-slate-600' : 'text-slate-500')}>{line2}</span> : null}
                        <span className="mt-1 flex flex-wrap gap-1">
                            {p.techLevel !== null && p.techLevel !== undefined ? <PpBadge kind="tech">{'Tech ' + p.techLevel}</PpBadge> : null}
                            {tr.show ? <PpBadge kind="training">{tr.text}</PpBadge> : null}
                            {tr.show && tr.overdue ? <PpBadge kind="late">Past target date</PpBadge> : null}
                            {showPip ? <PpBadge kind="pip">PIP</PpBadge> : null}
                            {!p.crew ? <PpBadge kind="left">No crew</PpBadge> : null}
                            {p.crew && searchingNow ? <PpBadge kind="crew">{'Crew ' + p.crew}</PpBadge> : null}
                            {ppIsEditing(p.id) ? <PpBadge kind="unsaved">Editing</PpBadge> : null}
                        </span>
                    </span>
                    <ChevronRightIcon className="w-4 h-4 text-slate-400 flex-shrink-0 mt-1" />
                </button>
            </li>
        );
    };

    const renderPeopleList = () => {
        const f = ppFilters;
        const q = String(f.text || '').trim();
        const searching = q.length >= PP_SEARCH_MIN;
        const crewAsk = /^[A-D]$/.test(f.crew) ? f.crew : '';
        const noCrew = f.crew === 'none';
        const asked = searching || !!crewAsk;
        const matches = searching ? (ppList.kind === 'search' && !!ppList.noCrew === noCrew) : (!!crewAsk && ppList.kind === 'crew' && ppList.crew === crewAsk);
        const listCrewAttr = noCrew ? 'none' : searching ? 'search' : crewAsk;
        const countWord = (n) => n + (n === 1 ? ' person' : ' people');
        const first = ppRowsView.rows;

        let state;
        if (!apiReady) state = 'preview';
        else if (!asked && !noCrew) state = 'choose';
        else if (!asked) state = 'nocrew-hint';
        else if (ppList.loading) state = 'loading';
        else if (ppList.error) state = 'error';
        else if (!matches || !ppList.readAt) state = 'loading';
        else state = ppRowsView.total === 0 ? 'empty' : 'ready';

        const askLabel = searching ? (noCrew ? 'No crew' : 'Search results') : 'Crew ' + crewAsk;
        const ulLabel = searching ? (noCrew ? 'People with no crew' : 'People found') : 'People on Crew ' + crewAsk;
        const filtered = f.role !== 'all' || f.training || (ppPipMarks && f.pip);
        const missingLines = puMissingLines(ppList.missing);
        const rowsList = (dim) => (
            <ul aria-label={ulLabel} onKeyDown={ppListKeyDown} className="rounded-lg border border-slate-200 overflow-hidden">
                {first.map(p => puRow(p, dim))}
            </ul>
        );

        let body = null;
        if (state === 'preview') {
            body = <div className={PP_LOOK.warn} role="status">Preview mode: there is no Dataverse connection here, so people cannot be searched.</div>;
        } else if (state === 'choose') {
            body = puDashed(<p className="text-sm text-slate-500">Choose a crew or type a name to see people.</p>, 'pp-list-choose');
        } else if (state === 'nocrew-hint') {
            body = puDashed(<p className="text-sm text-slate-500">Type 2 or more letters to find someone who left or has no crew.</p>, 'pp-list-nocrew');
        } else if (state === 'loading') {
            body = (
                <div data-testid="pp-list-loading">
                    <div role="status" className={PP_LOOK.info}>
                        <div>{searching ? (noCrew ? 'Searching people with no crew...' : 'Searching for "' + q + '"...') : 'Reading Crew ' + crewAsk + '...'}</div>
                        <div aria-hidden="true" className="mt-2 h-1 rounded bg-[#B3D4F2] overflow-hidden"><div className="h-1 w-1/3 bg-[#0072CE] animate-pulse"></div></div>
                    </div>
                    <ul aria-hidden="true" className="mt-3 space-y-2">
                        {[0, 1, 2, 3, 4].map(i => <li key={i} className="h-14 rounded-lg bg-slate-100 animate-pulse"></li>)}
                    </ul>
                </div>
            );
        } else if (state === 'error') {
            const errText = ppList.error ? ppErrText(ppList.error) : '';
            const keep = matches && ppList.rows.length > 0;
            const reqCard = renderPeopleMissingFirst('employee', PD_EMP_REQUIRED_COLUMNS);   // fix T3 (columns:F-REQCARD): a required Employee column that is missing: its card, not the raw Dataverse text
            body = (
                <div data-testid="pp-list-error">
                    {reqCard || (
                        <div role="alert" className={PP_LOOK.error}>
                            <div>{'The people list could not be read.' + (errText ? ' Dataverse said: "' + errText + '"' : '')}</div>
                            <button type="button" data-testid="pp-list-retry" onClick={() => ppReload()} className={PP_LOOK.secondary + ' mt-2'}>Try again</button>
                        </div>
                    )}
                    {keep ? (
                        <div className="mt-3">
                            <p className="text-xs text-slate-600 mb-2">{'Showing the last list we read at ' + pplTimeLabel(ppList.readAt) + '.'}</p>
                            {rowsList(true)}
                        </div>
                    ) : null}
                </div>
            );
        } else if (state === 'empty') {
            if (filtered && ppList.rows.length > 0) {
                body = puDashed(<div><p className="text-sm font-bold text-slate-800">No one matches these choices.</p><p className="mt-1 text-sm text-slate-500">Change the Role or Show only choices.</p></div>, 'pp-list-empty-filter');
            } else if (searching) {
                body = puDashed(<div><p className="text-sm font-bold text-slate-800">{noCrew ? 'No one with no crew has "' + q + '" in their name.' : 'No employee has "' + q + '" in their name.'}</p><p className="mt-1 text-sm text-slate-500">Try fewer letters.</p></div>, 'pp-list-empty-search');
            } else {
                body = puDashed(
                    <div>
                        <UsersIcon className="w-8 h-8 text-[#0072CE] mx-auto mb-2" />
                        <p className="text-sm font-bold text-slate-800">{'Nobody is on Crew ' + crewAsk + ' right now.'}</p>
                        <p className="mt-1 text-sm text-slate-500">{"Crews are set on each person's Profile. To find someone who left, press No crew and type a name."}</p>
                        <p className="mt-2 text-sm text-slate-500">If this looks wrong, the crew numbers may be stored differently than 1 to 4.</p>
                        <button type="button" data-testid="pp-list-check-again" onClick={() => ppCheckAgain('employee')} className={PP_LOOK.secondary + ' mt-3'}>Check again</button>
                    </div>, 'pp-list-empty-crew');
            }
        } else if (state === 'ready') {
            body = (
                <div>
                    <p data-testid="pp-count" className="text-sm font-bold text-slate-700 mb-2">{askLabel + PP_DOT + (ppList.capped ? 'At least ' : '') + countWord(ppRowsView.total)}</p>
                    {rowsList(false)}
                    {ppRowsView.left > 0 ? (
                        <div className="mt-3 text-center">
                            <button type="button" data-testid="pp-show-more" onClick={() => ppShowMore()} className="text-sm font-semibold text-[#0072CE] bg-white border border-[#B3D4F2] hover:bg-[#E6F1FB] px-6 py-2 min-h-[44px] md:min-h-0 rounded-full">{'Show ' + PP_PAGE + ' more (' + ppRowsView.left + ' left)'}</button>
                        </div>
                    ) : null}
                </div>
            );
        }

        const searchHint = searching
            ? (noCrew ? 'Searching only people with no crew. Clear the box to see the crew chips again.' : 'Searching everyone.' + (f.prevCrew ? ' Clear the box to go back to Crew ' + f.prevCrew + '.' : ''))
            : '';

        return (
            <div className={(ppSel ? 'hidden lg:block ' : '') + 'min-w-0 bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 space-y-4'}>
                <div data-panel="people-filters" className="space-y-3">
                    <div>
                        <label htmlFor="pp-search" className={PP_LOOK.label}>Find by name</label>
                        <div className="relative">
                            <input
                                id="pp-search" data-testid="pp-search" data-focus="search" type="text" autoComplete="off" value={f.text}
                                placeholder="Type 2 or more letters"
                                onChange={(e) => ppSetFilters({ text: e.target.value })}
                                className={PP_LOOK.input + ' pr-11 placeholder:text-slate-500'}
                            />
                            {f.text ? (
                                <button type="button" data-testid="pp-search-clear" aria-label="Clear the name" onClick={() => { ppSetFilters({ text: '' }); ppFocusTo('search'); }}
                                    className="absolute right-0.5 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE]">
                                    <XIcon className="w-4 h-4" />
                                </button>
                            ) : null}
                        </div>
                        {searchHint ? <p data-testid="pp-search-hint" className="mt-1.5 text-xs text-slate-600">{searchHint}</p> : null}
                    </div>

                    <div>
                        <span className={PP_LOOK.label}>Crew</span>
                        <div role="group" aria-label="Crew" className="flex flex-wrap gap-1.5">
                            {PU_CREWS.map(c => puChip('pp-crew-' + c, f.crew === c, 'Crew ' + c, () => ppSetFilters({ crew: c }), currentCrew === c))}
                            {puChip('pp-crew-none', f.crew === 'none', 'No crew', () => ppSetFilters({ crew: 'none' }), false)}
                        </div>
                    </div>

                    <div>
                        <label htmlFor="pp-role-filter" className={PP_LOOK.label}>Role</label>
                        <select id="pp-role-filter" data-testid="pp-role-filter" value={f.role} onChange={(e) => ppSetFilters({ role: e.target.value })} className={PP_LOOK.input}>
                            <option value="all">All roles</option>
                            <option value="employee">Employees</option>
                            <option value="lead">Leads</option>
                            <option value="supervisor">Supervisors</option>
                            <option value="manager">Managers</option>
                        </select>
                    </div>

                    <div>
                        <span className={PP_LOOK.label}>Show only</span>
                        <div role="group" aria-label="Show only" className="flex flex-wrap gap-1.5">
                            {puChip('pp-filter-training', f.training, 'In training', () => ppSetFilters({ training: !f.training }), false)}
                            {ppPipMarks ? puChip('pp-filter-pip', f.pip, 'On a PIP', () => ppSetFilters({ pip: !f.pip }), false) : null}
                        </div>
                    </div>

                    <div>
                        <span className={PP_LOOK.label}>Private</span>
                        <div role="group" aria-label="Private" className="flex flex-wrap gap-1.5">
                            {puChip('pp-pip-marks-chip', ppPipMarks, 'PIP marks', () => ppSetPipMarks(!ppPipMarks), false)}
                        </div>
                        {ppPipMarks ? (
                            <div data-testid="pp-pip-banner" role="note" className="mt-2 flex gap-2 rounded-lg bg-slate-100 border border-slate-300 text-slate-800 text-xs px-3 py-2">
                                <LockIcon className="w-4 h-4 flex-shrink-0 mt-0.5" />
                                <span>{'Private view: PIP marks are showing. Turn them off before you share your screen. They turn off by themselves after ' + PP_IDLE_WORDS + ' without use or when this browser tab is hidden.'}</span>
                            </div>
                        ) : null}
                    </div>
                </div>

                {renderPeopleRepair()}

                <div data-panel="people-list" data-crew={listCrewAttr} data-shown={first.length} data-total={ppRowsView.total} data-capped={ppList.capped && matches ? '1' : undefined} data-loading={state === 'loading' ? '1' : undefined} className="space-y-3">
                    {missingLines.length && state !== 'preview' ? (
                        <div data-testid="pp-list-missing" className={PP_LOOK.warn}>
                            {missingLines.map(t => <p key={t}>{t}</p>)}
                        </div>
                    ) : null}
                    {body}
                    {state === 'ready' && ppList.capped ? (
                        <p data-testid="pp-list-capped" className="text-xs text-slate-600">{'Showing the first ' + ppList.rows.length + '. ' + (searching ? 'Type more letters to narrow it down.' : 'Type a name to narrow it down.')}</p>
                    ) : null}
                </div>
            </div>
        );
    };

    const puLastChanged = (base) => {
        if (!base || !base.stamp || !base.stamp.modifiedOn) return '';
        const t = Date.parse(base.stamp.modifiedOn);
        if (t !== t) return '';
        const age = pplNow() - t;
        if (age > 3600000) return '';
        const mine = (ppSent || []).some(x => x && x.ok && x.store === 'emp' && cleanGuid(x.id) === base.id && x.at >= t - 300000);
        return mine ? '' : 'Last changed ' + pplTimeLabel(t) + ' by someone else';
    };

    const renderPeopleDetail = () => {
        if (!ppSel) {
            return (
                <div data-panel="people-detail-empty" className="hidden lg:block min-w-0">
                    {puDashed(
                        <div>
                            <UsersIcon className="w-8 h-8 text-[#0072CE] mx-auto mb-2" />
                            <h3 className="text-base font-black text-[#00468B]">Pick someone from the list</h3>
                            <p className="mt-1 text-sm text-slate-500">Their details, training and PIP open here.</p>
                        </div>)}
                </div>
            );
        }
        const isNew = ppSel === 'new';
        const d = ppDraft && ppDraft.id === ppSel ? ppDraft : null;
        const base = isNew ? null : ((d && d.emp && d.emp.base) || ppPersonRow(ppSel));
        const dirty = ppAnyDirty;
        const counts = ppDiffLines.counts;
        const tr = base && ppTags[base.id] ? ppTags[base.id].training : null;
        const trainingLabel = tr && tr.show ? (tr.flagOnly ? 'Training: on' : tr.text) : 'Training';
        const sections = [
            { id: 'profile', label: 'Profile', dot: counts.profile > 0 },
            { id: 'training', label: trainingLabel, dot: counts.training > 0 },
            { id: 'pip', label: 'PIP', dot: false }   // the PIP chip never carries a state (outside the PIP section the bar says "1 private change")
        ];
        const last = base ? puLastChanged(base) : '';
        const title = isNew ? 'Add employee' : (base ? null : 'Reading this file...');
        return (
            <section
                data-panel="people-detail" data-person={ppSel} data-section={isNew ? 'profile' : ppSection} aria-labelledby="pp-detail-h" onKeyDown={ppDetailKeyDown}
                className={'min-w-0 flex flex-col'}
            >
                <div className="lg:hidden sticky top-0 z-10 -mt-4 -mx-4 md:-mt-6 md:-mx-6 mb-3 px-3 h-12 flex items-center gap-2 bg-white border-b border-slate-200">
                    <button type="button" data-testid="pp-back" onClick={() => ppClosePerson()} className="inline-flex items-center gap-1 min-h-[44px] pr-3 text-sm font-bold text-[#0072CE] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] rounded-md">
                        <ChevronLeftIcon className="w-4 h-4" />People
                    </button>
                    <span aria-hidden="true" className="flex-1 min-w-0 truncate text-sm font-bold text-slate-800 text-center">{isNew ? 'Add employee' : (base ? base.name : '')}</span>
                    {dirty ? <span data-testid="pp-top-dot" aria-hidden="true" className="inline-block w-2.5 h-2.5 rounded-full bg-[#FFB81C] ring-1 ring-white"></span> : <span aria-hidden="true" className="inline-block w-2.5 h-2.5"></span>}
                    {dirty ? <span className="sr-only">(unsaved changes)</span> : null}
                </div>

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm p-4 md:p-5 space-y-4">
                    <div className="flex items-start justify-between gap-3">
                        <div className="min-w-0">
                            <h2 id="pp-detail-h" tabIndex={-1} data-focus="detail-heading" className="text-base font-black text-[#00468B] leading-snug break-words focus:outline-none">
                                {title !== null ? title : <PpIdentity emp={base} />}
                            </h2>
                            {last ? <p data-testid="pp-last-changed" className="mt-1 text-xs text-slate-600">{last}</p> : null}
                        </div>
                        <div className="flex items-center gap-2 flex-shrink-0">
                            {dirty ? <PpBadge kind="unsaved">Unsaved</PpBadge> : null}
                            <button type="button" data-testid="pp-close" onClick={() => ppClosePerson()} className={'hidden lg:inline-flex ' + PP_LOOK.secondary}>Close</button>
                        </div>
                    </div>

                    {base ? (
                        <div className="flex flex-wrap gap-1.5">
                            {base.roleLabel ? <PpBadge kind="role">{base.roleLabel}</PpBadge> : null}
                            {base.crew ? <PpBadge kind="crew">{'Crew ' + base.crew}</PpBadge> : <PpBadge kind="left">No crew</PpBadge>}
                            {base.jobRoleKnown && base.jobRole && (base.jobRole.name || ppJobNames()[base.jobRole.id]) ? <PpBadge kind="tech">{base.jobRole.name || ppJobNames()[base.jobRole.id]}</PpBadge> : null}
                        </div>
                    ) : null}

                    {!isNew ? (
                        <div role="group" aria-label={"Sections of " + (base ? base.name : 'this person') + "'s file"} className="flex flex-wrap gap-1.5">
                            {sections.map(s => (
                                <button key={s.id} type="button" data-testid={'pp-section-' + s.id} aria-pressed={ppSection === s.id} onClick={() => ppSetSection(s.id)} className={puChipClass(ppSection === s.id) + ' inline-flex items-center gap-1.5'}>
                                    {s.id === 'pip' ? <LockIcon className="w-3 h-3" /> : null}
                                    {s.label}
                                    {s.dot ? <span aria-hidden="true" className="inline-block w-2 h-2 rounded-full bg-[#FFB81C] ring-1 ring-white"></span> : null}
                                    {s.dot ? <span className="sr-only">(unsaved changes)</span> : null}
                                </button>
                            ))}
                        </div>
                    ) : null}

                    <div>
                        {isNew ? renderPeopleAdd() : ppSection === 'training' ? renderPeopleTraining() : ppSection === 'pip' ? renderPeoplePip() : renderPeopleProfile()}
                    </div>
                </div>
            </section>
        );
    };

    const puCardHead = (id, text) => (
        <h3 id={id} className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-4 md:px-5 py-2.5 text-[11px] font-black text-[#00468B] uppercase tracking-widest">{text}</h3>
    );
    const puCard = (id, head, children) => (
        <section key={id} aria-labelledby={id} className="rounded-xl border border-slate-200 overflow-hidden bg-white">
            {puCardHead(id, head)}
            <div className="p-4 md:p-5 space-y-4">{children}</div>
        </section>
    );

    const puFields = (mode, nameExtra) => {
        const isNew = mode === 'new';
        const emp = ppDraft.emp;
        const base = emp.base;
        const ed = emp.edited || {};
        const parts = base && base.nameParts ? base.nameParts : { last: '', first: '', mi: '' };
        const val = {
            last: ed.last !== undefined ? ed.last : parts.last,
            first: ed.first !== undefined ? ed.first : parts.first,
            mi: ed.mi !== undefined ? ed.mi : parts.mi,
            role: ed.role !== undefined ? ed.role : (base ? base.role : 'employee'),
            crew: ed.crew !== undefined ? ed.crew : (base ? base.crew : ''),
            jobRole: ed.jobRole !== undefined ? ed.jobRole : (base ? base.jobRole : null),
            email: ed.email !== undefined ? ed.email : (base ? base.email : ''),
            badge: ed.badge !== undefined ? ed.badge : (base ? base.badge : '')
        };
        const create = emp.create || { dupes: [], override: false, checking: false, key: '' };
        const changedOf = (k) => {
            if (isNew || ed[k] === undefined) return false;
            if (k === 'last' || k === 'first') return String(ed[k]).replace(/\s+/g, ' ').trim() !== parts[k];
            return true;
        };
        const ro = !ppCanWrite || ppSave.phase === 'saving';
        const chk = ppEmpCheck.byField || {};
        const listOf = (field, kind) => (chk[field] ? chk[field][kind] : []) || [];
        const shown = (field) => !isNew || !!(create.attempted || (create.touched && create.touched[field]));
        const nm = base ? puNm(base) : 'this person';
        const touch = (name) => { if (isNew) ppTouchField(name); };

        const nameErrs = listOf('name', 'errors');
        const nameWarns = listOf('name', 'warnings');
        const lastErr = nameErrs.filter(x => x.code === 'last_required')[0];
        const firstErr = nameErrs.filter(x => x.code === 'first_required')[0];
        const nameOther = nameErrs.filter(x => x.code !== 'last_required' && x.code !== 'first_required' && !(isNew && x.code === 'duplicate_name_active'));
        const composed = composeEmployeeName(val.last, val.first, val.mi);
        const nameBlur = (field) => () => { touch(field); if (isNew && String(val.last).trim() && String(val.first).trim()) ppCheckDupes('name'); };

        const roleKnown = ROLE_OPTIONS.some(o => o.key === val.role);
        let roleLine = '';
        if (!isNew && changedOf('role') && base) {
            if (val.role === 'supervisor' || val.role === 'manager') roleLine = 'Counted in Active Supervisors on the Overview, listed for Delegation, and gets the Supervisor screens in the Lead hub.';
            else if (val.role === 'employee' && (base.role === 'lead' || base.role === 'supervisor')) roleLine = puCap(nm) + ' will no longer be a ' + base.role + ' in Shift Start and Ganttly.';
        }

        const teamLeads = ppTeamLeads();   // null = the teams were not read: "Not checked"
        let leadsOf = '';
        if (!isNew && teamLeads && base) PU_CREWS.forEach(c => { if (teamLeads[c] && cleanGuid(teamLeads[c].leadId) === base.id) leadsOf = c; });

        const jr = ppSupport.jobRoles;
        const jrList = jr && Array.isArray(jr.list) ? jr.list : null;
        const jrBroken = !!(jr && jr.error) || ppColState('employee', 'craa5_roleid') === 'missing' || ppTableState('jobrole') === 'missing';
        const jrReading = !jr;
        const jrCurrent = val.jobRole && val.jobRole.id ? val.jobRole : null;
        const jrName = jrCurrent ? (jrCurrent.name || ppJobNames()[jrCurrent.id] || '') : '';
        const jrOptions = (jrList || []).slice();
        if (jrCurrent && !jrOptions.some(x => x.id === jrCurrent.id)) jrOptions.unshift({ id: jrCurrent.id, name: jrName || 'Current job role' });
        const jrChanged = changedOf('jobRole');
        let jrLine = '';
        if (jrChanged) jrLine = jrCurrent ? 'This changes which tasks ' + nm + ' receives in Ganttly. This page does not change pay.' : puCap(nm) + ' will have no job role, so Ganttly may give ' + nm + ' no tasks.';
        const tech0 = techLevelOfJob(jrName) === 0;

        const emailEdited = isNew ? !!val.email : ed.email !== undefined;
        const dupE = emp.dup && emp.dup.emailKey === val.email && emailEdited ? (emp.dup.email || []) : [];
        const useWarn = emailEdited ? listOf('email', 'errors').concat(listOf('email', 'warnings')).filter(x => x.code === 'email_in_use')[0] : null;
        let dupName = '';
        if (dupE.length) dupName = dupE[0].display || formatFullName(dupE[0].name);
        else if (useWarn) dupName = String(useWarn.text || '').replace(/ already (has|uses) this email.*$/, '');
        const emailDup = !!dupName;
        const emailInvalid = listOf('email', 'errors').filter(x => x.code === 'email_invalid')[0];
        const emailDupText = dupName + ' already uses this email. Two people with one email can end up signed in as each other. Change it, or tick that you share it on purpose.';
        const emailNotes = [];
        if (emailDup && emp.emailShared) emailNotes.push(puNote('dup', 'email_shared', dupName + ' also uses this email. You marked it as shared on purpose.'));
        listOf('email', 'warnings').filter(x => x.code !== 'email_in_use').forEach((x, i) => emailNotes.push(puNote('w' + i, x.code, x.text)));
        const emailMissingCol = ppColState('employee', 'craa5_email') === 'missing';
        const badgeMissingCol = ppColState('employee', 'craa5_badgenumber') === 'missing';

        const badgeEdited = isNew ? !!val.badge : ed.badge !== undefined;
        const dupB = emp.dup && emp.dup.badgeKey === val.badge && badgeEdited ? (emp.dup.badge || []) : [];
        const badgeWarn = badgeEdited ? listOf('badge', 'warnings').filter(x => x.code === 'badge_in_use')[0] : null;
        let badgeNote = '';
        if (badgeWarn) badgeNote = badgeWarn.text;
        else if (dupB.length) badgeNote = (dupB[0].display || formatFullName(dupB[0].name)) + ' already has this badge number.';

        const checkTexts = (ppEmpCheck.errors || []).map(x => x && x.text);
        const patchProblems = !isNew && ppDiffLines.empPatch && Array.isArray(ppDiffLines.empPatch.problems)
            ? ppDiffLines.empPatch.problems.filter(x => x && x.severity === 'block' && x.text && checkTexts.indexOf(x.text) < 0) : [];
        const blockedOnly = !isNew && ed && Object.keys(ed).length > 0 && ppDiffLines.counts.profile === 0;

        return (
            <div className="space-y-4">
                {patchProblems.length && blockedOnly ? (
                    <div data-testid="pp-patch-problems" role="alert" className={PP_LOOK.error}>
                        <p className="font-bold">This change cannot be saved yet.</p>
                        {patchProblems.map((x, i) => <p key={'pp' + i} data-error={x.code}>{x.text}</p>)}
                    </div>
                ) : null}
                {puCard('pp-card-name', 'Name', (
                    <div>
                        <div className="grid grid-cols-1 sm:grid-cols-[1fr_1fr_6rem] gap-3">
                            <PpField id="pp-last" label="Last name" changed={changedOf('last')} error={shown('last') && lastErr ? { code: lastErr.code, text: 'Enter a last name.' } : null}>
                                <input type="text" autoComplete="off" value={val.last} readOnly={ro} aria-required={isNew ? 'true' : undefined} data-focus="field:last" onChange={(e) => ppSetField('last', e.target.value)} onBlur={nameBlur('last')} className={puInput(ro)} />
                            </PpField>
                            <PpField id="pp-first" label="First name" changed={changedOf('first')} error={shown('first') && firstErr ? { code: firstErr.code, text: 'Enter a first name.' } : null}>
                                <input type="text" autoComplete="off" value={val.first} readOnly={ro} aria-required={isNew ? 'true' : undefined} data-focus="field:first" onChange={(e) => ppSetField('first', e.target.value)} onBlur={nameBlur('first')} className={puInput(ro)} />
                            </PpField>
                            <PpField id="pp-mi" label="Middle initial" changed={changedOf('mi')}>
                                <input type="text" autoComplete="off" maxLength={1} value={val.mi} readOnly={ro} data-focus="field:mi" onChange={(e) => ppSetField('mi', e.target.value)} className={puInput(ro, 'uppercase')} />
                            </PpField>
                        </div>
                        <p data-testid="pp-saved-as" aria-live="off" className="mt-2 text-sm text-slate-600">{'Saved as: ' + composed}</p>
                        {shown('last') || shown('first') ? nameOther.map((x, i) => <p key={'ne' + i} role="alert" data-error={x.code} className="mt-1 text-xs font-bold text-[#B80022]">{x.text}</p>) : null}
                        {nameWarns.map((x, i) => puNote('nw' + i, x.code, x.text))}
                        {nameExtra ? <div className="mt-3">{nameExtra}</div> : null}
                    </div>
                ))}

                {puCard('pp-card-work', 'Work', (
                    <div className="space-y-4">
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <PpField
                                id="pp-role" label="Role" changed={changedOf('role')} error={shown('role') && listOf('role', 'errors')[0] ? { code: listOf('role', 'errors')[0].code, text: listOf('role', 'errors')[0].text } : null}
                                help={<span>Role decides which Lead hub screen they get and who counts as a lead or supervisor in Shift Start.{roleLine ? <span data-testid="pp-role-line" className="block mt-1 font-semibold text-slate-800">{roleLine}</span> : null}{listOf('role', 'warnings').map((x, i) => puNote('rw' + i, x.code, x.text))}</span>}
                            >
                                <select value={val.role} aria-disabled={ro ? 'true' : undefined} data-focus="field:role" onChange={(e) => { if (!ro) ppSetField('role', e.target.value); }} className={puInput(ro)}>
                                    {!roleKnown ? <option value="">Not set</option> : null}
                                    {ROLE_OPTIONS.map(o => <option key={o.key} value={o.key}>{o.label}</option>)}
                                </select>
                            </PpField>

                            {leadsOf ? (
                                <PpField id="pp-crew" label="Crew" changed={false} help={<span data-testid="pp-crew-leads-note" className="block text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded-md px-2 py-1">{puCap(nm) + ' leads Crew ' + leadsOf + '. To move ' + nm + ', first choose a new supervisor for Crew ' + leadsOf + ' in Dataverse (Leadership teams).'}</span>}>
                                    <input type="text" readOnly aria-readonly="true" value={'Crew ' + leadsOf} data-focus="field:crew" className={puInput(true)} />
                                </PpField>
                            ) : (
                                <PpField
                                    id="pp-crew" label="Crew" changed={changedOf('crew')} error={shown('crew') && listOf('crew', 'errors')[0] ? { code: listOf('crew', 'errors')[0].code, text: listOf('crew', 'errors')[0].code === 'crew_required' ? 'Choose a crew.' : listOf('crew', 'errors')[0].text } : null}
                                    help={<span>Moving someone also moves them in Shift Start.{listOf('crew', 'warnings').map((x, i) => puNote('cw' + i, x.code, x.text))}</span>}
                                >
                                    <select value={val.crew} aria-disabled={ro ? 'true' : undefined} aria-required={isNew ? 'true' : undefined} data-focus="field:crew" onChange={(e) => { if (!ro) ppSetField('crew', e.target.value); }} onBlur={() => touch('crew')} className={puInput(ro)}>
                                        {val.crew === '' ? <option value="">{isNew ? 'Choose a crew' : 'No crew'}</option> : null}
                                        {PU_CREWS.map(c => <option key={c} value={c}>{'Crew ' + c}</option>)}
                                    </select>
                                </PpField>
                            )}
                        </div>

                        {jrBroken || jrReading ? (
                            <PpField id="pp-jobrole" label="Job role" changed={false} help={jrReading && !jrBroken ? 'Reading the job role list...' : 'Change it in Dataverse for now.'}>
                                <input type="text" readOnly aria-readonly="true" value={jrName || 'Not set'} data-focus="field:jobrole" className={puInput(true)} />
                            </PpField>
                        ) : (
                            <PpField
                                id="pp-jobrole" label="Job role" changed={jrChanged}
                                help={<span>{jrLine ? <span data-testid="pp-jobrole-line" className="block font-semibold text-slate-800">{jrLine}</span> : null}{tech0 ? <span className="block mt-1">Ganttly gives no equipment tasks to Tech 0 yet.</span> : null}</span>}
                            >
                                <select value={jrCurrent ? jrCurrent.id : ''} aria-disabled={ro ? 'true' : undefined} data-focus="field:jobrole"
                                    onChange={(e) => { if (ro) return; const id = e.target.value; ppSetField('jobRole', id ? (jrOptions.filter(x => x.id === id)[0] || null) : null); }} className={puInput(ro)}>
                                    <option value="">None</option>
                                    {jrOptions.map(x => <option key={x.id} value={x.id}>{x.name}</option>)}
                                </select>
                            </PpField>
                        )}
                        {jrBroken ? renderPeopleMissing('jobrole', '') : null}
                        {ppColState('employee', 'craa5_roleid') === 'missing' ? renderPeopleMissing('employee', 'craa5_roleid') : null}
                        {!isNew ? renderPeopleMissing('employee', 'craa5_leadershipteamid') : null}
                        {!isNew ? renderPeopleMissing('team', '') : null}
                        {!isNew ? renderPeopleMissingFirst('team', ['craa5_teamname', 'craa5_teamleademployeeid']) : null}

                        {!isNew ? (
                            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                                <div data-testid="pp-supervisor-of">
                                    <span className={PP_LOOK.label}>Supervisor of crew</span>
                                    <p className="font-semibold text-slate-800">{teamLeads === null ? 'Not checked' : (leadsOf ? 'Crew ' + leadsOf : 'None')}</p>
                                </div>
                                <div data-testid="pp-utilized">
                                    <span className={PP_LOOK.label}>{"In Shift Start's available list"}</span>
                                    <p className="font-semibold text-slate-800">{base && base.utilized === true ? 'No' : base && base.utilized === false ? 'Yes' : 'Not shown'}</p>
                                    <p className="text-xs text-slate-500">Set in Dataverse. This app does not change it.</p>
                                </div>
                            </div>
                        ) : null}
                    </div>
                ))}

                {puCard('pp-card-contact', 'Contact', (
                    <div className="space-y-4">
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <PpField
                                id="pp-email" label="Email" changed={changedOf('email')}
                                error={emailDup && !emp.emailShared && emailEdited ? { code: 'email_in_use', text: emailDupText } : (shown('email') && emailInvalid ? { code: emailInvalid.code, text: emailInvalid.text } : null)}
                                help={<span>Used to sign in. A wrong email lets someone else in as this person.{emailNotes}</span>}
                            >
                                <input type="text" inputMode="email" autoComplete="off" spellCheck={false} value={val.email} readOnly={ro || emailMissingCol} data-focus="field:email"
                                    onChange={(e) => ppSetField('email', e.target.value)} onBlur={() => { touch('email'); if (String(val.email).trim()) ppCheckDupes('email'); }} className={puInput(ro || emailMissingCol)} />
                            </PpField>
                            <PpField id="pp-badge" label="Badge number" changed={changedOf('badge')} help={badgeNote ? puNote('bn', 'badge_in_use', badgeNote) : undefined}>
                                <input type="text" autoComplete="off" value={val.badge} readOnly={ro || badgeMissingCol} data-focus="field:badge"
                                    onChange={(e) => ppSetField('badge', e.target.value)} onBlur={() => { touch('badge'); if (String(val.badge).trim()) ppCheckDupes('badge'); }} className={puInput(ro || badgeMissingCol)} />
                            </PpField>
                        </div>
                        {emailDup && emailEdited ? (
                            <label className="flex items-start gap-2 text-sm text-slate-800">
                                <input type="checkbox" id="pp-email-shared" data-testid="pp-email-shared" checked={!!emp.emailShared} onChange={(e) => { if (!ro) ppPatchEmp(ppSel, { emailShared: !!e.target.checked }); }} aria-disabled={ro ? 'true' : undefined} className="mt-1 accent-[#0072CE]" />
                                <span>These two people share this email on purpose</span>
                            </label>
                        ) : null}
                        {!isNew ? renderPeopleMissing('employee', 'craa5_email') : null}
                        {!isNew ? renderPeopleMissing('employee', 'craa5_badgenumber') : null}
                    </div>
                ))}
            </div>
        );
    };

    const renderPeopleProfile = () => {
        const d = ppDraft && ppDraft.id === ppSel ? ppDraft : null;
        const emp = d && d.emp ? d.emp : null;
        const base = emp ? emp.base : ppPersonRow(ppSel);
        const nm = base ? puNm(base) : 'this person';
        const phase = emp ? emp.phase : 'reading';
        let inner;
        const reqCardFile = emp && phase === 'error' ? renderPeopleMissingFirst('employee', PD_EMP_REQUIRED_COLUMNS) : null;   // fix T3 (columns:F-REQCARD): a required Employee column that is missing
        if (emp && phase === 'error' && reqCardFile) {
            inner = reqCardFile;
        } else if (emp && phase === 'error') {
            const errText = emp.error ? ppErrText(emp.error) : '';
            inner = (
                <div role="alert" data-testid="pp-detail-error" className={PP_LOOK.error}>
                    <div>{(base ? puCap(nm) + (nm === 'this person' ? ' file' : "'s file") : 'This file') + ' could not be read.' + (errText ? ' Dataverse said: "' + errText + '"' : '')}</div>
                    <button type="button" data-testid="pp-detail-retry" onClick={() => ppRetryPerson()} className={PP_LOOK.secondary + ' mt-2'}>Try again</button>
                </div>
            );
        } else if (emp && phase === 'gone') {
            inner = (
                <div role="alert" data-testid="pp-detail-gone" className={PP_LOOK.error}>
                    <div>{(base ? base.name : 'This person') + ' is no longer in the employee table.'}</div>
                    <button type="button" data-testid="pp-detail-back" onClick={() => ppClosePerson()} className={PP_LOOK.secondary + ' mt-2'}>Back to the list</button>
                </div>
            );
        } else if (!emp || !base) {
            inner = (
                <div data-testid="pp-detail-reading" role="status" className={PP_LOOK.info}>
                    <div>Reading this file...</div>
                    <div aria-hidden="true" className="mt-2 h-1 rounded bg-[#B3D4F2] overflow-hidden"><div className="h-1 w-1/3 bg-[#0072CE] animate-pulse"></div></div>
                </div>
            );
        } else {
            const leftNow = !base.crew;
            const blocked = ppAnyDirty;
            const saving = ppSave.phase === 'saving';
            inner = (
                <div className="space-y-4">
                    {phase === 'reading' ? <div role="status" data-testid="pp-detail-reading" className={PP_LOOK.info}>{'Reading ' + (nm === 'this person' ? 'this' : nm + "'s") + ' file...'}</div> : null}
                    {puFields('edit')}
                    {puCard('pp-card-status', 'Status', (
                        <div>
                            {leftNow ? (
                                <button type="button" data-testid="pp-bring-back" data-focus="bring-back" aria-disabled={blocked || saving ? 'true' : undefined} aria-describedby={blocked ? 'pp-left-help' : undefined} onClick={() => { if (!blocked && !saving) ppAskBringBack(); }} className={blocked || saving ? PP_LOOK.dimmed : PP_LOOK.secondary}>Bring back to a crew...</button>
                            ) : (
                                <button type="button" data-testid="pp-left" data-focus="left" aria-disabled={blocked || saving ? 'true' : undefined} aria-describedby={blocked ? 'pp-left-help' : undefined} onClick={() => { if (!blocked && !saving) ppAskLeave(); }} className={blocked || saving ? PP_LOOK.dimmed : PP_LOOK.secondary}>Mark as left the company...</button>
                            )}
                            {blocked ? <p id="pp-left-help" data-testid="pp-left-help" className="mt-2 text-xs text-slate-600">Save or discard your changes first.</p> : <p className="mt-2 text-xs text-slate-500">{leftNow ? 'Puts ' + nm + ' on a crew again.' : 'Takes ' + nm + ' off the crew. Nothing is deleted, and you can bring ' + nm + ' back later.'}</p>}
                        </div>
                    ))}
                </div>
            );
        }
        return (
            <section aria-labelledby="pp-profile-h" data-panel="people-profile" className="space-y-4">
                <h3 id="pp-profile-h" className="sr-only">Profile</h3>
                {inner}
            </section>
        );
    };

    const renderPeopleAdd = () => {
        const d = ppDraft && ppDraft.id === 'new' ? ppDraft : null;
        if (!d || !d.emp) return null;
        const emp = d.emp;
        const ed = emp.edited || {};
        const create = emp.create || { dupes: [], override: false, checking: false, key: '' };
        const dupes = Array.isArray(create.dupes) ? create.dupes : [];
        const composed = composeEmployeeName(ed.last, ed.first, ed.mi);
        const key = employeeNameKey(composed);
        const exact = key ? dupes.filter(x => x && employeeNameKey(x.name) === key) : [];
        const activeDup = exact.filter(x => x.status !== 'left')[0];
        const leftDup = !activeDup ? exact.filter(x => x.status === 'left')[0] : null;
        const saving = ppSave.phase === 'saving';
        const emailDupBlocks = (() => {
            const k = String(ed.email || '');
            if (!k) return false;
            const dup = (emp.dup && emp.dup.emailKey === k && (emp.dup.email || []).length > 0) || (ppEmpCheck.byField.email && ppEmpCheck.byField.email.warnings.concat(ppEmpCheck.byField.email.errors).some(x => x.code === 'email_in_use'));
            return !!dup && !emp.emailShared;
        })();
        const invalid = ppEmpCheck.errors.length > 0 || !!activeDup || (!!leftDup && !create.override) || emailDupBlocks;
        const blocked = invalid || !!create.checking || saving || !ppCanWrite;
        const firstBad = ppEmpCheck.errors.map(x => x.code).indexOf('last_required') > -1 ? 'last' : ppEmpCheck.errors.map(x => x.code).indexOf('first_required') > -1 ? 'first' : ppEmpCheck.errors.map(x => x.code).indexOf('crew_required') > -1 ? 'crew' : emailDupBlocks ? 'email' : '';
        const onAdd = () => {
            if (saving || create.checking) return;
            if (invalid) { ppTouchField('attempt'); if (firstBad) ppFocusTo('field:' + firstBad); return; }
            if (!ppCanWrite) return;
            ppCreateEmployee();
        };
        const first = (x) => { const f = ppFirst(x); return f === 'them' ? 'this person' : f; };
        const msg = ppSave.scope === 'profile' || ppSave.scope === '' ? ppSave : null;
        const dupePanel = dupes.length > 0 ? (
                <div data-panel="people-dupes" className={PP_LOOK.warn}>
                    <h4 className="text-sm font-black text-slate-800">Already in the employee list</h4>
                    <ul className="mt-2 space-y-2">
                        {dupes.map(x => {
                            const isLeft = x.status === 'left';
                            const job = x.jobRoleKnown && x.jobRole && x.jobRole.name ? PP_DOT + x.jobRole.name : '';
                            return (
                                <li key={x.id} data-person={x.id} className="flex flex-wrap items-center justify-between gap-2 text-sm">
                                    <span className="min-w-0 break-words">{x.name + PP_DOT + (x.crew ? 'Crew ' + x.crew : 'No crew') + job}</span>
                                    {isLeft
                                        ? <button type="button" data-testid={'pp-dupe-bring-' + x.id} onClick={() => ppRequestNav({ sel: x.id, section: 'profile', row: x, focus: 'bring-back' })} className={PP_LOOK.secondary}>{'Bring ' + first(x) + ' back'}</button>
                                        : <button type="button" data-testid={'pp-dupe-open-' + x.id} onClick={() => ppGoTo({ sel: x.id, section: 'profile', row: x })} className={PP_LOOK.secondary}>{'Open ' + first(x)}</button>}
                                </li>
                            );
                        })}
                    </ul>
                    {activeDup ? <p role="alert" data-testid="pp-add-active-dupe" className="mt-2 text-sm font-bold text-slate-800">{formatFullName(activeDup.name) + (activeDup.crew ? ' is already on Crew ' + activeDup.crew + '.' : ' is already in the employee list.') + ' Open ' + first(activeDup) + ' instead.'}</p> : null}
                    {leftDup ? (
                        <label className="mt-2 flex items-start gap-2 text-sm text-slate-800">
                            <input type="checkbox" data-testid="pp-add-override" checked={!!create.override} onChange={(e) => ppSetCreate({ override: !!e.target.checked })} className="mt-1 accent-[#0072CE]" />
                            <span>This is a different person with the same name</span>
                        </label>
                    ) : null}
                </div>
        ) : null;
        return (
            <div data-panel="people-add" className="space-y-4">
                <p className="text-sm text-slate-600">Last name, first name and crew are required.</p>
                {puFields('new', dupePanel)}
                {msg && msg.alert ? <div role="alert" data-testid="pp-add-alert" className={PP_LOOK.error}>{typeof msg.alert === 'string' ? msg.alert : null}</div> : null}
                {msg && msg.message && !msg.alert ? <p role="status" data-testid="pp-add-status" className="text-sm font-semibold text-slate-700">{msg.message}</p> : null}
                <div className="flex flex-wrap items-center justify-between gap-2 pt-1">
                    <button type="button" data-testid="pp-add-cancel" onClick={() => ppClosePerson()} className={PP_LOOK.secondary}>Cancel</button>
                    <button type="button" data-testid="pp-add-submit" data-focus="save" aria-disabled={blocked ? 'true' : undefined} onClick={onAdd} className={blocked ? PP_LOOK.dimmed : PP_LOOK.primary}>{saving ? 'Adding...' : 'Add employee'}</button>
                </div>
            </div>
        );
    };

    ppLive.current.ppFresh = { ppSaveEmployee: ppSaveEmployee, ppSaveTraining: ppSaveTraining, ppSavePip: ppSavePip, ppCreateEmployee: ppCreateEmployee };
    ppLive.current.ppNav = { goTo: ppGoTo, requestNav: ppRequestNav, guardKeep: ppGuardKeep, guardDiscard: ppGuardDiscard, guardSave: ppGuardSave, discard: ppDiscard, discardNow: ppDiscardNow, setField: ppSetField, setFilters: ppSetFilters, setPipMarks: ppSetPipMarks, showMore: ppShowMore };

    const renderPeopleTab = () => {
        const blocks = renderPeopleBlocks();
        return (
            <div data-tab-root="people" data-pip-marks={ppPipMarks ? 'on' : 'off'} className="flex-1 flex flex-col">
                <div className={(ppSel ? 'hidden lg:flex ' : 'flex ') + 'flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-4'}>
                    <div className="min-w-0">
                        <h2 className="text-base font-black text-[#00468B] uppercase tracking-widest">People</h2>
                        <p className="hidden lg:block text-sm text-slate-500">Find a person, fix their details, set them in training, or manage a PIP.</p>
                        <p className="lg:hidden text-sm text-slate-500">Pick a crew or type a name.</p>
                    </div>
                    <button type="button" data-testid="pp-add-employee" data-focus="add:employee" onClick={() => ppStartAdd()} className={PP_LOOK.primary + ' inline-flex items-center justify-center gap-2 w-full sm:w-auto flex-shrink-0'}>
                        <PlusIcon className="w-4 h-4" />Add employee
                    </button>
                </div>
                <div className="lg:grid lg:grid-cols-[360px_minmax(0,1fr)] lg:gap-4 lg:items-start">
                    {renderPeopleList()}
                    {renderPeopleDetail()}
                </div>
                {blocks ? <div className="mt-6 space-y-3">{blocks}</div> : null}
                {renderPeopleBar()}
            </div>
        );
    };

    const renderPeopleTraining = () => {
        const d = ppDraft && ppDraft.id === ppSel ? ppDraft : null;
        const emp = d && d.emp ? d.emp : null;
        const base = emp && emp.base ? emp.base : ppPersonRow(ppSel);
        const t = d && d.training ? d.training : null;
        const first = ppFirst(base);
        const poss = first === 'them' ? 'their' : first + "'s";
        const cap = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);
        const saving = ppSave.phase === 'saving' && ppSave.scope === 'training';
        const locked = !ppCanWrite || saving;
        const who = ppWhoName();

        const savedOn = !!(base && base.inTraining === true);
        const savedArea = base && typeof base.trainingArea === 'string' ? base.trainingArea : '';
        const flagOn = t && t.flag ? !!t.flag.on : savedOn;
        const docArea = t && t.doc && typeof t.doc.area === 'string' ? t.doc.area : '';
        const areaVal = t && t.flag && typeof t.flag.area === 'string' ? t.flag.area : (savedArea || docArea);
        const flagChanged = !!(t && t.flag && !!t.flag.on !== savedOn);
        const areaChanged = !!(t && t.flag && flagOn && String(t.flag.area || '').trim() !== savedArea.trim());
        const flagCard = renderPeopleMissing('employee', 'craa5_intraining');
        const flagDim = ppColState('employee', 'craa5_intraining') === 'missing' || !!flagCard;
        const areaCard = ppColState('employee', 'craa5_trainingarea') === 'missing' ? renderPeopleMissing('employee', 'craa5_trainingarea') : null;
        const areaDim = !flagOn;
        const planColCard = renderPeopleMissingFirst('plan', PD_PLAN_COLUMNS);
        let planColUsed = false;

        const phase = t ? t.phase : 'reading';
        const reading = !base || !t || phase === 'reading';
        let mode = t ? t.mode : 'none';
        const hasDoc = !!(t && t.doc && typeof t.doc === 'object' && (mode === 'starting' || mode === 'active' || mode === 'two-active' || mode === 'newer' || mode === 'closed'));
        if (hasDoc && t.doc.closed && typeof t.doc.closed === 'object') mode = 'closed';
        if (mode === 'none' || mode === 'flag-only') mode = flagOn ? 'flag-only' : 'none';
        const ro = !!(t && (t.readOnly || mode === 'newer' || mode === 'closed'));
        const dis = locked || ro;
        const planTableMissing = ppTableState('plan') === 'missing' || !!(t && phase === 'error' && t.error && t.error.kind === 'missing_table');

        const card = (id, head, right, children) => (
            <section key={id} aria-labelledby={id} className="rounded-xl border border-slate-200 overflow-hidden bg-white">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-4 md:px-5 py-2.5 flex flex-wrap items-baseline justify-between gap-2">
                    <h3 id={id} className="text-[11px] font-black text-[#00468B] uppercase tracking-widest">{head}</h3>
                    {right}
                </div>
                <div className="p-4 md:p-5 space-y-4">{children}</div>
            </section>
        );
        const yellow = 'text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded px-2 py-0.5';
        const shortDate = (ymd) => { const s = ymdLabel(ymd); return s && ymd.slice(0, 4) === today.slice(0, 4) ? s.replace(/, \d{4}$/, '') : s; };
        const dueText = (due, tplKey) => {            // the words come from here, not from the helper's text, so the wording of 7.16 holds with any version of the block
            const ds = trainingDueState(due, today, tplKey);
            let text = '';
            if (ds.state === 'overdue') text = 'Target date was ' + (0 - ds.days) + ((0 - ds.days) === 1 ? ' day ago' : ' days ago');
            else if (ds.state === 'ok' || ds.state === 'soon') text = ds.days === 0 ? 'Due today' : 'Due in ' + ds.days + (ds.days === 1 ? ' day' : ' days');
            return { state: ds.state, days: ds.days, text: text };
        };

        const onFlag = (e) => {
            if (locked || flagDim) return;
            ppTrainingEdit('flag', { on: !!e.target.checked, area: areaVal });
        };
        const flagBlock = card('pp-training-flag-h', 'In training', null, (
            <div className="space-y-4">
                <div data-changed={flagChanged ? '1' : undefined} className={'pl-2 border-l-[3px] ' + (flagChanged ? 'border-l-[#FFB81C]' : 'border-l-transparent')}>
                    <label className={'inline-flex items-center gap-2 min-h-[44px] md:min-h-0 text-sm font-bold ' + (flagDim ? 'text-slate-500' : 'text-slate-800')}>
                        <input
                            type="checkbox" id="pp-intraining" data-testid="pp-intraining" data-focus="flag" data-dim={flagDim ? '1' : undefined}
                            checked={flagOn} aria-disabled={flagDim || locked ? 'true' : undefined} aria-describedby="pp-flag-note" onChange={onFlag}
                            className={'w-4 h-4 accent-[#0072CE] ' + (flagDim ? 'opacity-50 cursor-not-allowed' : '')}
                        />
                        <span>In training</span>
                        {flagChanged ? <span className="normal-case tracking-normal text-[10px] font-extrabold text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded px-1">changed</span> : null}
                    </label>
                    <p id="pp-flag-note" data-testid="pp-flag-note" className="mt-1 text-xs text-slate-600">{"Shows a Training tag next to " + first + " on the Overview's Team Deployment card. Shift Start and Ganttly do not show it yet."}</p>
                </div>
                {flagCard}
                <div data-dim={areaDim ? '1' : undefined}>
                    <PpField
                        id="pp-training-area" changed={areaChanged}
                        label={<span>What are they training on? <span className="normal-case tracking-normal font-semibold text-slate-500">(optional)</span></span>}
                        help="Everyone who loads employee lists can see this. Do not type performance remarks here. For example: Wash pit, Drains."
                    >
                        <input
                            type="text" list="pp-training-area-list" data-focus="area" autoComplete="off" maxLength={200} value={areaVal} readOnly={locked || areaDim}
                            aria-disabled={areaDim ? 'true' : undefined} onChange={(e) => { if (locked || areaDim) return; ppTrainingEdit('area', { area: e.target.value }); }} className={PP_LOOK.input + (areaDim ? ' bg-slate-50' : '')}
                        />
                    </PpField>
                    <datalist id="pp-training-area-list">
                        {['Wash pit', 'Drains', 'Trash', 'Raw side', 'RTE side', 'CIP', 'Chemical room'].map(v => <option key={v} value={v} />)}
                    </datalist>
                    {areaDim ? <p className="mt-1 text-xs text-slate-600">Switch on In training to set this.</p> : null}
                </div>
                {areaCard}
            </div>
        ));

        const noPlan = () => {
            const jr = base && base.jobRole ? (base.jobRole.name || ppJobNames()[base.jobRole.id] || '') : '';
            const hint = jr ? trainingTemplateKey(techLevelOfJob(jr)) : '';
            const starts = [['t0', 'pp-plan-start-t0'], ['t1_t2', 'pp-plan-start-t1t2'], ['t2_t3', 'pp-plan-start-t2t3'], ['custom', 'pp-plan-start-custom']];
            return (
                <div data-testid="pp-noplan" className="space-y-3">
                    <p className="text-sm text-slate-800">No training plan yet. Start from a list, or just mark them as in training.</p>
                    <p data-testid="pp-example-note" className="text-xs text-slate-600">These lists come from an example deck (Stilwell) that is being adapted for BBF. Thresholds are starting points. Ask for a change if a wording or a threshold is off.</p>
                    <div role="group" aria-label="Start a training plan from a list" className="flex flex-wrap gap-2">
                        {starts.map(s => {
                            const suggested = hint === s[0];
                            return (
                                <button
                                    key={s[0]} type="button" data-testid={s[1]} data-plan-template={s[0]} data-suggested={suggested ? '1' : undefined} data-focus={'start:' + s[0]}
                                    aria-disabled={locked ? 'true' : undefined} onClick={() => { if (!locked) ppStartTraining(s[0]); }}
                                    className={locked ? PP_LOOK.dimmed : suggested ? PP_LOOK.primary : PP_LOOK.secondary}
                                >{TRAINING_TEMPLATES[s[0]].title}</button>
                            );
                        })}
                    </div>
                    {hint ? <p data-testid="pp-plan-suggest" className="text-xs text-slate-600">{'Suggested: ' + TRAINING_TEMPLATES[hint].title + ', from the job role ' + jr + '.'}</p> : null}
                </div>
            );
        };

        const planView = () => {
            const doc = t.doc;
            const tplKey = trainingTemplateKey(doc.template) || 'custom';
            const tpl = TRAINING_TEMPLATES[tplKey] || TRAINING_TEMPLATES.custom;
            const prog = trainingPlanProgress(doc, { today: today });
            const metBy = {};
            prog.items.forEach(x => { metBy[x.id] = x; });
            const progress = doc.progress && typeof doc.progress === 'object' ? doc.progress : {};
            const entryOf = (id) => (ppHas(progress, id) && progress[id] && typeof progress[id] === 'object' ? progress[id] : {});
            const starting = mode === 'starting';
            const freshStart = t.startFresh === true;   // details started fresh over text that could not be read: on screen only until Save training
            const closed = mode === 'closed' && doc.closed && typeof doc.closed === 'object' ? doc.closed : null;
            const baseDoc = t.base && t.base.doc && typeof t.base.doc === 'object' ? t.base.doc : null;
            const differs = (fn) => !!baseDoc && fn(baseDoc) !== fn(doc);
            const ds = dueText(doc.due, tplKey);
            const maxDays = Math.min(90, frameworkSettings(ppSupport.framework && ppSupport.framework.doc ? ppSupport.framework.doc : null).bypassDays);

            const fw = buildTrainingChecklist(tplKey);
            const groups = [];
            TRAINING_LEVELS.filter(L => tpl.levels.indexOf(L.key) > -1).forEach(L => L.groups.forEach(g => {
                const its = fw.filter(it => it.group === g.id);
                if (its.length) groups.push({ id: g.id, name: g.name, level: L.name, fw: its, own: [] });
            }));
            const ownGroup = { id: 'own', name: 'Your own items', level: '', fw: [], own: [] };
            (Array.isArray(doc.items) ? doc.items : []).filter(it => it && typeof it === 'object' && typeof it.id === 'string' && it.removed !== true).forEach(it => {
                const g = groups.filter(x => x.id === it.group)[0];
                (g || ownGroup).own.push(it);
            });
            const shownGroups = groups.slice();
            if (ownGroup.own.length || tplKey === 'custom') shownGroups.push(ownGroup);
            const ownCount = (Array.isArray(doc.items) ? doc.items : []).filter(it => it && typeof it === 'object' && typeof it.id === 'string' && it.removed !== true).length;
            const ownNo = {};
            (Array.isArray(doc.items) ? doc.items : []).filter(it => it && typeof it === 'object' && typeof it.id === 'string' && it.removed !== true).forEach((it, i) => { ownNo[it.id] = i + 1; });
            const otherKeys = (() => { try { const pr = parsePlanData(JSON.stringify(doc), 'training'); return pr.ok && Array.isArray(pr.unknownKeys) ? pr.unknownKeys : []; } catch (e) { return []; } })();
            const groupOptions = groups.concat([ownGroup]);
            let firstOpen = '';
            shownGroups.forEach(g => {
                g.fw.concat(g.own).forEach(it => {
                    if (!firstOpen && !it.soft && !(metBy[it.id] && metBy[it.id].met)) firstOpen = it.id;
                });
            });

            const sign = (it) => (it.requiresVerification && who ? { verifiedBy: who, verifiedOn: today } : {});
            const onTick = (it, on) => {
                if (dis) return;
                ppTrainingEdit('item', { id: it.id, patch: on ? Object.assign({ done: true, doneOn: today }, sign(it)) : { done: false } });
            };
            const onNumber = (it, raw) => {
                if (dis) return;
                if (raw === '') { ppTrainingEdit('item', { id: it.id, patch: { value: '' } }); return; }
                const n = Number(raw);
                if (!isFinite(n) || n < 0 || (it.kind === 'percent' && n > 100)) {
                    ppAnnounce(it.kind === 'percent' ? 'Enter a number from 0 to 100.' : 'Enter a number, 0 or more.');
                    return;
                }
                ppTrainingEdit('item', { id: it.id, patch: Object.assign({ value: n, valueOn: today }, sign(it)) });
            };
            const needs = (it) => {
                const th = it.threshold;
                if (!th) return '';
                const unit = th.unit === '%' ? '%' : (th.unit ? ' ' + th.unit : '');
                return (th.op === 'gt' ? 'needs more than ' : 'needs ') + th.value + unit + (th.goal ? ' (goal ' + th.goal + unit + ')' : '');
            };
            const stripFor = (id, noun) => {
                const c = ppConfirm;
                if (!c || c.kind !== 'remove' || c.section !== 'training' || c.id !== id) return null;
                return (
                    <div
                        role="alert" data-confirm="remove" data-testid="pp-remove-strip" className={PP_LOOK.warn + ' mt-2 flex flex-wrap items-center gap-2'}
                        onKeyDown={(e) => { if (e.key === 'Escape') { e.stopPropagation(); ppCloseConfirm(); ppFocusTo('item:' + id); } }}
                    >
                        <span className="font-bold">{'Remove this ' + noun + '?'}</span>
                        {c.label ? <span className="min-w-0 break-words text-slate-600">{'"' + c.label + '"'}</span> : null}
                        <button type="button" data-testid="pp-remove-yes" onClick={() => { ppTrainingEdit('item-remove', { id: id, confirmed: true }); ppCloseConfirm(); }} className={PP_LOOK.danger}>Yes, remove</button>
                        <button type="button" data-testid="pp-remove-keep" data-safe="1" autoFocus onClick={() => { ppCloseConfirm(); ppFocusTo('item:' + id); }} className={PP_LOOK.secondary}>Keep</button>
                    </div>
                );
            };
            const metMark = (it, st) => (
                <span data-testid={'pp-item-met-' + it.id} data-met={st.met ? '1' : '0'} className={'inline-flex items-center gap-1 text-xs font-bold whitespace-nowrap ' + (st.met ? 'text-[#00468B]' : 'text-slate-600')}>
                    {st.met ? <CheckCircleIcon className="w-4 h-4 text-[#0072CE]" /> : <span aria-hidden="true" className="inline-block w-4 h-4 rounded-full border-2 border-slate-300"></span>}
                    {st.met ? (st.via === 'bypass' ? 'Met by bypass' : 'Met') : 'Not met yet'}
                </span>
            );
            const verifiedRow = (it, en) => {
                if (!it.requiresVerification) return null;
                const vid = 'pp-item-verified-' + it.id;
                return (
                    <div className="mt-1 ml-6 flex flex-wrap items-center gap-2 text-xs text-slate-600">
                        <label htmlFor={vid} className="font-bold">Verified by</label>
                        <input
                            type="text" id={vid} data-testid={vid} maxLength={200} value={typeof en.verifiedBy === 'string' ? en.verifiedBy : ''} readOnly={dis || !!who} aria-readonly={who ? 'true' : undefined}
                            onChange={(e) => { if (dis || who) return; ppTrainingEdit('item', { id: it.id, patch: { verifiedBy: e.target.value, verifiedOn: today } }); }}
                            className="w-44 border border-slate-300 rounded-lg py-1 px-2 text-base md:text-sm font-semibold bg-white"
                        />
                        {isYmd(en.verifiedOn) && en.verifiedBy ? <span>on <PpDate ymd={en.verifiedOn} /></span> : null}
                        {who && !en.verifiedBy ? <span>{'Filled in with ' + who + ' when you tick it or enter the number.'}</span> : null}
                        {!who && !en.verifiedBy ? <span>Type who verified this.</span> : null}
                    </div>
                );
            };
            const bypassBlock = (it) => {
                if (!it.bypassAllowed) return null;
                const bp = doc.bypass && typeof doc.bypass === 'object' && doc.bypass.item === it.id ? doc.bypass : null;
                const active = !!(bp && isYmd(bp.until) && bp.until >= today);
                const bf = t.bypassForm && typeof t.bypassForm === 'object' ? t.bypassForm : { days: '', reason: '', by: '', tried: false };
                const setBf = (patch) => ppPatchTraining(ppSel, { bypassForm: Object.assign({}, bf, patch) });
                const daysN = Number(bf.days);
                const daysOk = String(bf.days).trim() !== '' && isFinite(daysN) && Math.floor(daysN) === daysN && daysN >= 1 && daysN <= maxDays;
                const reasonOk = String(bf.reason || '').trim() !== '';
                const byName = who || String(bf.by || '').trim();
                const canApply = daysOk && reasonOk && !!byName;
                const onApply = () => {
                    if (dis) return;
                    if (!canApply) { setBf({ tried: true }); ppAnnounce('The bypass needs the number of days, a reason and a name.'); return; }
                    ppSetBypass({ item: it.id, days: daysN, reason: String(bf.reason).trim(), by: byName });
                    ppPatchTraining(ppSel, { bypassForm: null });
                };
                return (
                    <div className="mt-2 ml-6" data-testid="pp-bypass">
                        {active ? (
                            <div className="flex flex-wrap items-center gap-2 text-sm">
                                <p data-testid="pp-bypass-granted" data-date={bp.until} className="font-bold text-[#00468B]">Bypass granted by {bp.by || 'someone'} until <PpDate ymd={bp.until} /></p>
                                <button type="button" data-testid="pp-bypass-clear" aria-disabled={dis ? 'true' : undefined} onClick={() => { if (!dis) ppSetBypass({ clear: true }); }} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary}>Clear the bypass</button>
                            </div>
                        ) : (
                            <details className="text-sm">
                                <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-xs font-extrabold text-[#00468B]">Short-term bypass</summary>
                                <div className="mt-2 space-y-2">
                                    {bp && isYmd(bp.until) ? <p className="text-xs text-slate-600">{'The last bypass ended on ' + ymdLabel(bp.until) + '.'}</p> : null}
                                    <p className="text-xs text-slate-600">A supervisor can allow this item for a short time. It counts as met until the date you choose.</p>
                                    <div className="flex flex-wrap gap-3">
                                        <PpField id="pp-bypass-days" label="Days" error={bf.tried && !daysOk ? 'Enter the number of days, 1 to ' + maxDays + '.' : ''}>
                                            <input type="number" min={1} max={maxDays} step={1} value={bf.days} readOnly={dis} onChange={(e) => { if (!dis) setBf({ days: e.target.value }); }} className={PP_LOOK.input + ' w-28'} />
                                        </PpField>
                                        <div className="min-w-[12rem] flex-1">
                                            <PpField id="pp-bypass-reason" label="Reason" error={bf.tried && !reasonOk ? 'Say why the bypass is needed.' : ''}>
                                                <input type="text" maxLength={300} value={bf.reason} readOnly={dis} onChange={(e) => { if (!dis) setBf({ reason: e.target.value }); }} className={PP_LOOK.input} />
                                            </PpField>
                                        </div>
                                        {!who ? (
                                            <div className="min-w-[10rem]">
                                                <PpField id="pp-bypass-by" label="Granted by" error={bf.tried && !byName ? 'Enter who is granting this.' : ''}>
                                                    <input type="text" maxLength={100} value={bf.by} readOnly={dis} onChange={(e) => { if (!dis) setBf({ by: e.target.value }); }} className={PP_LOOK.input} />
                                                </PpField>
                                            </div>
                                        ) : null}
                                    </div>
                                    <button type="button" data-testid="pp-bypass-apply" aria-disabled={dis || !canApply ? 'true' : undefined} onClick={onApply} className={dis || !canApply ? PP_LOOK.dimmed : PP_LOOK.primary}>Grant the bypass</button>
                                </div>
                            </details>
                        )}
                    </div>
                );
            };

            const fwItem = (it) => {
                const st = metBy[it.id] || { met: false, via: '', verified: false };
                const en = entryOf(it.id);
                const checkId = 'pp-item-check-' + it.id;
                const valId = 'pp-item-value-' + it.id;
                let main;
                if (it.kind === 'check') {
                    main = (
                        <label htmlFor={checkId} className="flex items-start gap-2 min-w-0 flex-1 text-sm text-slate-800">
                            <input type="checkbox" id={checkId} data-testid={checkId} data-focus={'item:' + it.id} checked={!!st.met} aria-disabled={dis ? 'true' : undefined} onChange={(e) => onTick(it, !!e.target.checked)} className="mt-1 w-4 h-4 accent-[#0072CE]" />
                            <span className="min-w-0 break-words">{it.text}</span>
                        </label>
                    );
                } else if (it.kind === 'count' || it.kind === 'percent' || it.kind === 'weeks') {
                    const v = en.value === undefined || en.value === null ? '' : String(en.value);
                    main = (
                        <div className="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0 flex-1">
                            <label htmlFor={valId} className="min-w-[10rem] flex-1 text-sm text-slate-800 break-words">{it.text}</label>
                            <span className="inline-flex items-center gap-1 whitespace-nowrap">
                                <input
                                    type="number" id={valId} data-testid={valId} data-focus={'item:' + it.id} min={0} max={it.kind === 'percent' ? 100 : undefined} step={1} value={v} readOnly={dis}
                                    aria-describedby={'pp-item-need-' + it.id} onChange={(e) => onNumber(it, e.target.value)}
                                    className="w-20 border border-slate-300 rounded-lg py-1 px-2 text-base md:text-sm font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40"
                                />
                                {it.kind === 'percent' ? <span aria-hidden="true" className="text-sm text-slate-600">%</span> : null}
                            </span>
                            <span id={'pp-item-need-' + it.id} className="text-xs text-slate-600">{needs(it)}</span>
                            {isYmd(en.valueOn) && v !== '' ? <span className="text-xs text-slate-600">as of <PpDate ymd={en.valueOn} /></span> : null}
                        </div>
                    );
                } else if (it.kind === 'text') {
                    const tid = 'pp-item-text-' + it.id;
                    main = (
                        <div className="min-w-0 flex-1">
                            <label htmlFor={tid} className="text-sm text-slate-800 break-words">{it.text}{it.soft ? <span className="ml-2 text-xs font-bold text-slate-600">Optional</span> : null}</label>
                            <textarea
                                id={tid} data-testid={tid} data-focus={'item:' + it.id} rows={2} maxLength={1000} value={typeof en.text === 'string' ? en.text : ''} readOnly={dis}
                                onChange={(e) => { if (!dis) ppTrainingEdit('item-text', { id: it.id, text: e.target.value }); }} className={PP_LOOK.input + ' mt-1'}
                            />
                        </div>
                    );
                } else {
                    main = <span className="min-w-0 flex-1 text-sm text-slate-800 break-words">{it.text}</span>;
                }
                const derived = it.kind !== 'check' && it.kind !== 'text';
                return (
                    <li key={it.id} data-item={it.id} data-done={st.met ? '1' : '0'} data-kind={it.kind} className="py-2 border-b border-slate-100 last:border-b-0">
                        <div className="flex items-start gap-3">
                            {main}
                            {derived ? metMark(it, st) : null}
                        </div>
                        {it.kind === 'check' && st.met && isYmd(en.doneOn) ? <p className="mt-0.5 ml-6 text-xs text-slate-600">done <PpDate ymd={en.doneOn} /></p> : null}
                        {verifiedRow(it, en)}
                        {bypassBlock(it)}
                    </li>
                );
            };
            const ownItem = (it) => {
                const done = it.done === true;
                const txt = typeof it.text === 'string' ? it.text : '';
                const ownName = 'Your own item ' + (ownNo[it.id] || 1);
                return (
                    <li key={it.id} data-item={it.id} data-done={done ? '1' : '0'} data-kind="own" data-own="1" className="py-2 border-b border-slate-100 last:border-b-0">
                        <div className="flex items-center gap-2">
                            <input type="checkbox" id={'pp-item-check-' + it.id} data-testid={'pp-item-check-' + it.id} aria-label={'Done: ' + (txt.trim() ? txt.trim().slice(0, 80) : ownName)} checked={done} aria-disabled={dis ? 'true' : undefined} onChange={(e) => { if (!dis) ppTrainingEdit('item', { id: it.id, patch: { done: !!e.target.checked } }); }} className="w-4 h-4 accent-[#0072CE]" />
                            <input
                                type="text" id={'pp-item-text-' + it.id} data-testid={'pp-item-text-' + it.id} data-focus={'item:' + it.id} aria-label={ownName} maxLength={300} value={txt} readOnly={dis}
                                onChange={(e) => { if (!dis) ppTrainingEdit('item', { id: it.id, patch: { text: e.target.value } }); }} className={PP_LOOK.input + ' flex-1'}
                            />
                            <button
                                type="button" data-testid={'pp-item-remove-' + it.id} aria-label={'Remove item: ' + (txt || 'new item')} aria-disabled={dis ? 'true' : undefined}
                                onClick={() => { if (!dis) ppTrainingEdit('item-remove', { id: it.id }); }} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary}
                            >Remove</button>
                        </div>
                        {stripFor(it.id, 'item')}
                    </li>
                );
            };

            const liveNotes = (Array.isArray(doc.notes) ? doc.notes : []).filter(n => n && typeof n === 'object' && n.removed !== true);
            const lastNote = liveNotes.length ? liveNotes[liveNotes.length - 1] : null;
            const noteOf = (dd) => {
                const l = (Array.isArray(dd.notes) ? dd.notes : []).filter(n => n && typeof n === 'object' && n.removed !== true);
                return l.length && typeof l[l.length - 1].text === 'string' ? l[l.length - 1].text : '';
            };
            const trainerId = doc.trainer && typeof doc.trainer === 'object' && doc.trainer.id ? cleanGuid(doc.trainer.id) : '';
            const trainerName = doc.trainer && typeof doc.trainer === 'object' && typeof doc.trainer.name === 'string' ? doc.trainer.name : '';
            const pool = (ppList.rows || []).filter(r => r && r.id && r.status === 'crew' && (!base || r.id !== base.id));
            const sameCrew = base && base.crew ? pool.filter(r => r.crew === base.crew) : [];
            const people = sameCrew.length ? sameCrew : pool;
            const trainerOptions = people.map(r => ({ id: r.id, label: r.name + (r.role && r.role !== 'employee' ? ' (' + r.roleLabel + ')' : '') }));
            if (trainerId && !trainerOptions.some(o => o.id === trainerId)) trainerOptions.unshift({ id: trainerId, label: trainerName || 'Chosen trainer' });
            const onTrainer = (e) => {
                if (dis) return;
                const id = e.target.value;
                const hit = trainerOptions.filter(o => o.id === id)[0];
                ppTrainingEdit('trainer', { id: id, name: hit ? (people.filter(r => r.id === id)[0] ? people.filter(r => r.id === id)[0].name : hit.label) : '' });
            };

            const onAddItem = (e) => {
                if (dis) return;
                const wrap = e.currentTarget.closest ? e.currentTarget.closest('[data-add-item]') : null;
                const sel = wrap ? wrap.querySelector('select') : null;
                ppTrainingEdit('item-add', { text: '', group: sel && sel.value && sel.value !== 'own' ? sel.value : '' });
            };

            const yearBanner = !closed && !starting && !ro && tplKey === 't1_t2' && isYmd(doc.due) && ds.state === 'overdue' ? (
                <section aria-label="One-year target" data-testid="pp-year-banner" className={PP_LOOK.warn + ' space-y-3'}>
                    <p className="font-bold">{'The one-year target for ' + first + ' to reach Tech 2 was ' + ymdLabel(doc.due) + ' (counted from the plan start date). What would help most?'}</p>
                    <div className="flex flex-wrap gap-2">
                        <button type="button" data-testid="pp-year-time" aria-disabled={dis ? 'true' : undefined} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary} onClick={() => { if (dis) return; ppFocusTo('plan-due'); ppAnnounce('Change the due date, then save training.'); }}>Add training time</button>
                        <button type="button" data-testid="pp-year-review" className={PP_LOOK.secondary} onClick={() => ppFocusTo(firstOpen ? 'item:' + firstOpen : 'plan-list')}>Review the plan</button>
                        <button type="button" data-testid="pp-year-perf" aria-disabled={dis ? 'true' : undefined} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary} onClick={() => { if (!dis) ppAskStartPip(); }}>Set up a performance plan (PIP)...</button>
                    </div>
                </section>
            ) : null;

            const closedLine = closed ? (
                <p data-testid="pp-closed-line" data-result={closed.result} className={PP_LOOK.info}>
                    {closed.result === 'completed' ? 'Training completed' : closed.result === 'cancelled' ? 'Training stopped' : 'Plan stopped'}
                    {isYmd(closed.on) ? ' on ' + ymdLabel(closed.on) : ''}.
                    {closed.result === 'cancelled' ? ' What was done is kept.' : ''}
                </p>
            ) : null;
            const status = t.row && t.row.statusKey ? t.row.statusKey : (closed ? 'closed' : 'active');
            const right = starting ? <PpBadge kind="unsaved">Not saved yet</PpBadge> : closed ? null : <PpBadge kind="training">Plan active</PpBadge>;

            return card('pp-training-plan-h', 'Training plan', (
                <span className="flex items-center gap-2 text-xs font-bold text-[#00468B]">{tpl.title}{right}</span>
            ), (
                <div data-testid="pp-plan" data-plan={tplKey} data-status={status} data-result={closed ? closed.result : undefined} data-done={prog.done} data-total={prog.total} data-saved={t.row ? '1' : '0'} className="space-y-4">
                    {starting ? <p data-testid="pp-starting-note" className={PP_LOOK.warn}>This plan is not saved yet. Press Save training to keep it.</p> : null}
                    {freshStart ? <p data-testid="pp-fresh-note" className={PP_LOOK.warn}>{'These details are new and not saved yet.' + (typeof doc.recovered === 'string' && doc.recovered ? ' The old text is kept with them (see Other saved fields).' : '') + ' Press Save training to keep them, or Discard to go back.'}</p> : null}
                    {mode === 'newer' ? <p data-testid="pp-newer-note" className={PP_LOOK.warn}>Saved by a newer version of this app. You can read it here, but it cannot be changed from this page.</p> : null}
                    {mode === 'two-active' && t.others && t.others.length ? (
                        <div data-testid="pp-two-active" className={PP_LOOK.warn}>
                            <p className="font-bold">2 active plans found, editing the older one.</p>
                            <ul className="mt-1 text-xs text-slate-700">
                                {t.others.map(o => <li key={o.id} data-other-plan={o.id}>{'The other one: ' + (o.name || 'a training plan') + (ymdOf(o.createdOn) ? ', created ' + ymdLabel(ymdOf(o.createdOn)) : '') + '. Nothing is changed in it from here.'}</li>)}
                            </ul>
                        </div>
                    ) : null}
                    {closedLine}

                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <PpField id="pp-trainer" label="Trainer" changed={differs(dd => (dd.trainer && dd.trainer.id) || '')}
                            help={trainerOptions.length === 0 ? 'Open a crew in the list to choose a trainer from it.' : undefined}>
                            <select value={trainerId} aria-disabled={dis ? 'true' : undefined} onChange={onTrainer} className={PP_LOOK.input}>
                                <option value="">No trainer chosen</option>
                                {trainerOptions.map(o => <option key={o.id} value={o.id}>{o.label}</option>)}
                            </select>
                        </PpField>
                        <PpField id="pp-plan-start-date" label="Starts" changed={differs(dd => dd.start || '')} help="The clock starts on this date.">
                            <input type="date" value={isYmd(doc.start) ? doc.start : ''} readOnly={dis} onChange={(e) => { if (!dis && e.target.value) ppTrainingEdit('start-date', { ymd: e.target.value }); }} className={PP_LOOK.input} />
                        </PpField>
                        <PpField id="pp-plan-due-date" label="Due" changed={differs(dd => dd.due || '')}>
                            <input type="date" data-focus="plan-due" value={isYmd(doc.due) ? doc.due : ''} readOnly={dis} onChange={(e) => { if (!dis) ppTrainingEdit('due-date', { ymd: e.target.value }); }} className={PP_LOOK.input} />
                        </PpField>
                    </div>
                    {isYmd(doc.due) ? (
                        <div className="space-y-1">
                            {ds.text ? <p data-testid="pp-due-state" data-date={doc.due} data-state={ds.state} data-overdue={ds.state === 'overdue' ? '1' : undefined} className={'inline-block text-sm font-bold ' + (ds.state === 'soon' || ds.state === 'overdue' ? yellow : 'text-slate-700')}>{ds.text}</p> : null}
                            {isYmd(doc.start) ? <p data-testid="pp-clock-note" className="text-xs text-slate-600">{'Counted from the plan start date (' + shortDate(doc.start) + '), not a hire date.'}</p> : null}
                        </div>
                    ) : <p className="text-xs text-slate-600">No target date for this list. You can add one above.</p>}

                    {yearBanner}

                    {prog.total > 0 ? (
                        <div data-testid="pp-progress" data-percent={prog.percent} className="space-y-1">
                            <p className="text-sm font-bold text-slate-800">{prog.done + ' of ' + prog.total + ' done (' + prog.percent + '%)'}</p>
                            <div aria-hidden="true" className="h-2 rounded-full bg-slate-200 overflow-hidden"><div className="h-2 bg-[#0072CE]" style={{ width: prog.percent + '%' }}></div></div>
                        </div>
                    ) : null}

                    <div data-focus="plan-list" tabIndex={-1} className="space-y-4 focus:outline-none">
                        {shownGroups.map(g => (
                            <section key={g.id} aria-labelledby={'pp-grp-' + g.id} data-group={g.id}>
                                <h4 id={'pp-grp-' + g.id} className="text-[11px] font-black text-slate-600 uppercase tracking-widest">{g.name}{groups.length > 1 && g.level ? <span className="ml-2 normal-case tracking-normal font-semibold text-slate-500">{g.level}</span> : null}</h4>
                                {g.fw.length + g.own.length === 0 ? <p className="mt-1 text-xs text-slate-600">No items yet. Add the first one below.</p> : null}
                                <ul className="mt-1">
                                    {g.fw.map(fwItem)}
                                    {g.own.map(ownItem)}
                                </ul>
                            </section>
                        ))}
                    </div>

                    {!ro ? (
                        <div data-add-item="1" className="flex flex-wrap items-center gap-2">
                            {groupOptions.length > 1 ? (
                                <span className="inline-flex items-center gap-2">
                                    <label htmlFor="pp-item-group" className="text-xs font-bold text-slate-600">Add to</label>
                                    <select id="pp-item-group" data-testid="pp-item-group" defaultValue="own" className="border border-slate-300 rounded-lg py-2 px-3 text-base md:text-sm font-semibold bg-white max-w-[16rem]">
                                        {groupOptions.map(g => <option key={g.id} value={g.id}>{g.name}</option>)}
                                    </select>
                                </span>
                            ) : null}
                            <button type="button" id="pp-item-add" data-testid="pp-item-add" data-focus="add:item" aria-disabled={dis ? 'true' : undefined} onClick={onAddItem} className={(dis ? PP_LOOK.dimmed : PP_LOOK.secondary) + ' inline-flex items-center gap-2'}>
                                <PlusIcon className="w-4 h-4" />Add your own item
                            </button>
                            {ownCount >= PLAN_LIST_CAPS.training.items ? <p data-testid="pp-items-full" className={'text-sm font-bold ' + yellow}>{'This list is full (' + PLAN_LIST_CAPS.training.items + ' items). Remove one first.'}</p> : null}
                        </div>
                    ) : null}

                    <div>
                        {liveNotes.length > 1 ? (
                            <ul data-testid="pp-notes-earlier" aria-label="Earlier notes" className="mb-2 space-y-1 text-xs text-slate-700">
                                {liveNotes.slice(0, liveNotes.length - 1).map(n => <li key={n.id}>{(isYmd(n.date) ? ymdLabel(n.date) + ': ' : '') + (n.text || '')}</li>)}
                            </ul>
                        ) : null}
                        <PpField id="pp-training-notes" label="Notes" changed={differs(noteOf)} help="Facts about the work only. No health, leave or discipline details.">
                            <textarea rows={3} maxLength={1000} value={lastNote && typeof lastNote.text === 'string' ? lastNote.text : ''} readOnly={dis} onChange={(e) => { if (!dis) ppTrainingEdit('notes', { text: e.target.value }); }} className={PP_LOOK.input} />
                        </PpField>
                    </div>

                    {otherKeys.length ? (
                        <details data-testid="pp-training-other" className="text-xs text-slate-600">
                            <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 font-bold text-[#00468B]">{'Other saved fields (' + otherKeys.length + ')'}</summary>
                            <p className="mt-1 break-words">{otherKeys.join(', ') + '. This page does not change them.'}</p>
                        </details>
                    ) : null}

                    {!ro && !starting && !freshStart ? (
                        <div className="flex flex-wrap gap-2 pt-1">
                            <button type="button" data-testid="pp-training-complete" data-focus="complete" aria-disabled={dis ? 'true' : undefined} onClick={() => { if (!dis) ppAskCompleteTraining(); }} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary}>Complete training...</button>
                            <button type="button" data-testid="pp-training-stop" data-focus="stop" aria-disabled={dis ? 'true' : undefined} onClick={() => { if (!dis) ppAskStopTraining(); }} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary}>Stop training...</button>
                        </div>
                    ) : null}
                </div>
            ));
        };

        let body = null;
        const readingStrip = (
            <div role="status" data-testid="pp-training-reading" className={PP_LOOK.info}>
                <div>{'Reading ' + poss + ' training plan...'}</div>
                <div aria-hidden="true" className="mt-2 h-1 rounded bg-[#B3D4F2] overflow-hidden"><div className="h-1 w-1/3 bg-[#0072CE] animate-pulse"></div></div>
            </div>
        );
        if (planTableMissing && !hasDoc) {
            const pc = renderPeopleMissing('plan', '');
            body = pc || (
                <div role="alert" data-testid="pp-training-error" className={PP_LOOK.error}>{cap(poss) + ' training plan cannot be read: the plan table was not found. See Columns this needs.'}</div>
            );
        } else if (t && phase === 'error' && !hasDoc && planColCard) {
            body = planColCard;   // the read failed because a column is missing: the card says which, with its steps, instead of the raw Dataverse text
            planColUsed = true;
        } else if (t && phase === 'error' && !hasDoc) {
            const et = t.error ? ppErrText(t.error) : '';
            body = (
                <div role="alert" data-testid="pp-training-error" className={PP_LOOK.error}>
                    <div>{cap(poss) + ' training plan could not be read.' + (et ? ' Dataverse said: "' + et + '"' : '')}</div>
                    <button type="button" data-testid="pp-training-retry" onClick={() => ppPatchTraining(ppSel, { phase: 'reading', error: null })} className={PP_LOOK.secondary + ' mt-2'}>Try again</button>
                </div>
            );
        } else if (reading && !hasDoc) {
            body = readingStrip;
        } else if (mode === 'hidden') {
            body = <p data-testid="pp-training-hidden" className={PP_LOOK.warn}>This training plan's saved details are hidden from your account, or empty (column security can do this). Nothing is overwritten, and nothing can be saved here.</p>;
        } else if (mode === 'unreadable') {
            const miss = t.problem === 'absent' || t.problem === 'wrong_type' ? renderPeopleMissing('plan', 'craa5_data') : null;
            if (miss) planColUsed = true;
            const shown = String(t.recoveredText || (t.base && typeof t.base.text === 'string' ? t.base.text : '') || '').slice(0, 4000);
            const rich = !!(t.row && Array.isArray(t.row.hints) && t.row.hints.indexOf('data_richtext') > -1) || /^\s*</.test(shown);
            const emptyData = t.problem === 'empty' && shown.trim() === '';
            const canStart = !miss && t.problem !== 'hidden' && t.problem !== 'newer_version' && !!t.row && !!t.base;
            const startOff = locked || !ppCanWrite;
            body = (
                <div className="space-y-3">
                    {miss}
                    {emptyData ? (
                        <p data-testid="pp-training-unreadable" className={PP_LOOK.warn}>This training plan has no saved details yet. Nothing is overwritten.</p>
                    ) : (
                        <p data-testid="pp-training-unreadable" className={PP_LOOK.warn}>This training plan's saved text could not be read, so it is not shown as a plan. Nothing is overwritten.</p>
                    )}
                    {rich ? <p data-testid="pp-training-richtext" className={PP_LOOK.warn}>Data must be plain Multiline text, not Rich text. This text looks like Rich text, which this page cannot read.</p> : null}
                    {shown ? (
                        <details data-testid="pp-training-saved-text">
                            <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-bold text-[#00468B]">Show the saved text</summary>
                            <textarea readOnly aria-label="The saved text, read only" rows={6} value={shown} className={PP_LOOK.input + ' mt-2 font-mono'} />
                        </details>
                    ) : null}
                    {shown || canStart ? (
                        <div className="flex flex-wrap items-center gap-2">
                            {shown ? <button type="button" data-testid="pp-training-copy-text" onClick={() => ppCopySavedText()} className={PP_LOOK.secondary}>Copy the saved text</button> : null}
                            {canStart ? (
                                <button type="button" data-testid="pp-training-start-fresh" data-focus="start-fresh" aria-disabled={startOff ? 'true' : undefined} onClick={() => { if (!startOff) ppStartFresh(); }} className={startOff ? PP_LOOK.dimmed : PP_LOOK.primary}>{emptyData ? 'Set up the details' : 'Start the details fresh'}</button>
                            ) : null}
                        </div>
                    ) : null}
                    {canStart && !emptyData && shown ? <p data-testid="pp-training-fresh-help" className="text-xs text-slate-600">Starting fresh keeps the old text with the new details. Nothing is saved until you press Save training.</p> : null}
                </div>
            );
        } else if (hasDoc) {
            body = (
                <div className="space-y-3">
                    {reading ? readingStrip : null}
                    {planView()}
                </div>
            );
        } else {
            body = card('pp-training-plan-h', 'Training plan', null, noPlan());
        }

        const token = !t ? 'none' : mode === 'starting' || mode === 'active' || mode === 'two-active' || mode === 'newer' || mode === 'closed' || mode === 'unreadable' || mode === 'hidden' || mode === 'flag-only' || mode === 'none' ? mode : 'none';
        return (
            <section aria-labelledby="pp-training-h" data-panel="people-training" data-training={token} data-phase={phase} className="space-y-4">
                <h3 id="pp-training-h" className="sr-only">Training</h3>
                {flagBlock}
                {planColCard && !planColUsed && !(planTableMissing && !hasDoc) ? planColCard : null}
                {body}
            </section>
        );
    };

    const renderPeoplePip = () => {
        if (ppUi.pipCover && ppUi.pipCover === ppSel) {
            return (
                <section aria-labelledby="pp-pip-h" data-panel="people-pip" data-pip="covered" data-phase="covered" className="rounded-xl border border-slate-200 overflow-hidden bg-white">
                    <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-4 md:px-5 py-2.5 flex flex-wrap items-center gap-2">
                        <h3 id="pp-pip-h" tabIndex={-1} data-focus="pip-heading" className="text-[11px] font-black text-[#00468B] uppercase tracking-widest focus:outline-none">PIP</h3>
                        <span data-testid="pp-pip-private" data-private="1" className="inline-flex items-center gap-1 text-[10px] font-extrabold tracking-wide px-2 py-0.5 rounded-full whitespace-nowrap bg-slate-100 text-slate-700 border border-slate-300"><LockIcon className="w-3 h-3" />Private</span>
                    </div>
                    <div className="p-4 md:p-5 space-y-3">
                        <p data-testid="pp-pip-cover-text" className="text-sm text-slate-700">{'Hidden after ' + PP_IDLE_WORDS + ' without use.'}</p>
                        <button type="button" data-testid="pp-pip-cover-show" data-focus="pip-cover" onClick={() => ppPipShowAgain()} className={PP_LOOK.primary}>Show the private plan again</button>
                    </div>
                </section>
            );
        }
        const d = ppDraft && ppDraft.id === ppSel ? ppDraft : null;
        const emp = d && d.emp ? d.emp : null;
        const base = emp && emp.base ? emp.base : ppPersonRow(ppSel);
        const p = d && d.pip && typeof d.pip === 'object' ? d.pip : null;
        const first = ppFirst(base);
        const nm = first === 'them' ? 'This person' : first;
        const poss = first === 'them' ? 'their' : first + "'s";
        const who = ppWhoName();
        const saving = ppSave.phase === 'saving' && ppSave.scope === 'pip';
        const locked = !ppCanWrite || saving;
        const phase = p ? p.phase : 'reading';
        const ui = p && p.ui && typeof p.ui === 'object' ? p.ui : {};
        const noSpell = { spellCheck: false, autoComplete: 'off' };
        const yellow = 'text-slate-800 bg-[#FFF6E0] border border-[#FFB81C] rounded px-2 py-0.5';
        const fieldErr = 'mt-1 text-xs font-bold text-[#B80022]';

        const isO = (x) => x !== null && typeof x === 'object' && !Array.isArray(x);
        const liveOf = (list) => (Array.isArray(list) ? list : []).filter(x => isO(x) && x.removed !== true);
        const tx = (v) => (typeof v === 'string' ? v : '');
        const countWord = (n, w) => n + ' ' + w + (n === 1 ? '' : 's');
        const isDone = (g) => g.done === true || g.done === 1 || (typeof g.done === 'string' && /^(true|yes)$/i.test(g.done.trim()));
        const shortDate = (ymd) => { const s = ymdLabel(ymd); return s && ymd.slice(0, 4) === today.slice(0, 4) ? s.replace(/, \d{4}$/, '') : s; };
        const dt = (ymd) => (isYmd(ymd) ? <time dateTime={ymd} data-date={ymd}>{shortDate(ymd)}</time> : <span data-date="">not set</span>);
        const psOf = (dd) => {
            const sy = isYmd(dd.start) ? dd.start : (p && p.row && isYmd(p.row.start) ? p.row.start : '');
            return { startY: sy, ps: pipState(sy && sy !== dd.start ? Object.assign({}, dd, { start: sy }) : dd, today) };
        };
        const when = (n) => (n === 0 ? 'today' : n > 0 ? 'in ' + countWord(n, 'day') : countWord(0 - n, 'day') + ' ago');
        const fullLine = (n, noun) => 'This list is full (' + n + ' ' + noun + '). Close the PIP and start a new one if you need more.';
        const byLine = (by) => { const b = tx(by).trim(); return b ? 'Entered by ' + formatFullName(b) : 'Entered by: not recorded'; };
        const RATINGS = { on_track: ['On track', 'on-track'], some_progress: ['Making progress', 'some-progress'], off_track: ['Not yet on track', 'not-improving'] };
        const ratingWord = (r) => (typeof r === 'string' && ppHas(RATINGS, r) ? RATINGS[r][0] : (r ? String(r).slice(0, 60) : 'No rating'));   // an unknown word is shown as it is (RD-17, SPEC 4.3)
        const ratingAttr = (r) => (typeof r === 'string' && ppHas(RATINGS, r) ? RATINGS[r][1] : 'unknown');
        const OUTCOMES = { met: 'Met the goals', not_met: 'Did not meet the goals', cancelled: 'Cancelled' };
        const chipClass = (on) => 'px-3 py-1.5 min-h-[44px] md:min-h-0 rounded-lg text-xs font-extrabold border transition-colors whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0072CE] '
            + (on ? 'bg-[#0072CE] text-white border-[#0072CE] shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-[#E6F1FB] hover:text-[#0072CE] hover:border-[#B3D4F2]');
        const badge = (look, children, tid) => (
            <span data-testid={tid || undefined} className={'inline-flex items-center gap-1 text-[10px] font-extrabold tracking-wide px-2 py-0.5 rounded-full whitespace-nowrap ' + look}>{children}</span>
        );
        const BLUE = 'bg-[#E6F1FB] text-[#00468B] border border-[#B3D4F2]';
        const SLATE = 'bg-slate-100 text-slate-700 border border-slate-300';
        const subHead = (id, text) => <h4 id={id} className="text-[11px] font-black text-slate-600 uppercase tracking-widest">{text}</h4>;

        const setUi = (patch) => ppPatchPip(ppSel, prev => (prev ? Object.assign({}, prev, { ui: Object.assign({}, prev.ui || {}, patch) }) : prev));
        const rawMap = ui.raw && typeof ui.raw === 'object' ? ui.raw : {};
        const shownText = (key, saved) => { const s = tx(saved); return ppHas(rawMap, key) && typeof rawMap[key] === 'string' && rawMap[key].trim() === s.trim() ? rawMap[key] : s; };
        const putRaw = (key, v) => ppPatchPip(ppSel, prev => (prev ? Object.assign({}, prev, { ui: Object.assign({}, prev.ui || {}, { raw: Object.assign({}, (prev.ui && prev.ui.raw) || {}, { [key]: v }) }) }) : prev));
        const dropRaw = (key) => ppPatchPip(ppSel, prev => {
            if (!prev || !prev.ui || !prev.ui.raw || !ppHas(prev.ui.raw, key)) return prev;
            const next = Object.assign({}, prev.ui.raw);
            delete next[key];
            return Object.assign({}, prev, { ui: Object.assign({}, prev.ui, { raw: next }) });
        });
        const typeInto = (key, value, send) => { send(value); putRaw(key, value); };

        const byNow = who || tx(ui.by).trim();

        const docRight = (dd, closedNow) => {
            const o = psOf(dd), ps0 = o.ps;
            const dayText = !o.startY || ps0.notStarted ? '' : (ps0.totalDays ? 'Day ' + ps0.elapsedDays + ' of ' + ps0.totalDays : 'Day ' + ps0.elapsedDays);
            return (
                <span className="flex flex-wrap items-center gap-2 text-xs font-bold text-[#00468B]">
                    {closedNow ? badge(SLATE, 'Closed', 'pp-pip-state') : badge(BLUE, 'Active', 'pp-pip-state')}
                    {!closedNow && dayText ? <span data-testid="pp-pip-day">{dayText}</span> : null}
                </span>
            );
        };

        let mode = p ? p.mode : 'none';
        const doc = p && isO(p.doc) ? p.doc : null;
        const hasDoc = !!doc && (mode === 'active' || mode === 'two-active' || mode === 'closed' || mode === 'newer');
        if (hasDoc && mode !== 'newer' && isO(doc.outcome)) mode = 'closed';
        const ro = !!(p && (p.readOnly || mode === 'newer' || mode === 'closed'));
        const dis = locked || ro;
        const earlier = p && Array.isArray(p.earlier) ? p.earlier : [];
        const planTab = (ppCols.plan && ppCols.plan.table) || pplTableMemo.current.plan || '';
        const pipTab = (ppCols.pip && ppCols.pip.table) || pplTableMemo.current.pip || '';
        const sameTable = !!planTab && !!pipTab && String(planTab).toLowerCase() === String(pipTab).toLowerCase();
        const tableMissing = ppTableState('pip') === 'missing' || !!(p && phase === 'error' && p.error && p.error.kind === 'missing_table');
        let view = 'none';
        if (p && mode === 'starting' && !tableMissing) view = 'starting';
        else if (tableMissing && !hasDoc) view = 'missing';
        else if (p && phase === 'error' && !hasDoc && mode !== 'unreadable') view = 'error';
        else if (!p || (phase === 'reading' && !hasDoc && mode !== 'unreadable')) view = 'reading';
        else if (mode === 'unreadable') view = 'unreadable';
        else if (hasDoc) view = 'doc';
        const token = view === 'starting' ? 'starting' : view === 'unreadable' ? 'unreadable' : view === 'doc' ? mode : 'none';

        const NOTE = "Private. Only managers should see this. PIP notes are saved in their own table (PIP plan); ask whoever manages Dataverse security to let only the managers who handle PIPs read it. Unsaved PIP text is kept in memory only, never in this device's storage.";
        const frame = (right, children) => (
            <section aria-labelledby="pp-pip-h" data-panel="people-pip" data-pip={token} data-phase={phase} className="rounded-xl border border-slate-200 overflow-hidden bg-white">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-4 md:px-5 py-2.5 flex flex-wrap items-center justify-between gap-2">
                    <div className="flex flex-wrap items-center gap-2">
                        <h3 id="pp-pip-h" tabIndex={-1} data-focus="pip-heading" className="text-[11px] font-black text-[#00468B] uppercase tracking-widest focus:outline-none">PIP</h3>
                        <span data-testid="pp-pip-private" data-private="1" className={'inline-flex items-center gap-1 text-[10px] font-extrabold tracking-wide px-2 py-0.5 rounded-full whitespace-nowrap ' + SLATE}><LockIcon className="w-3 h-3" />Private</span>
                    </div>
                    {right}
                </div>
                <div className="p-4 md:p-5 space-y-4">
                    <p role="note" data-testid="pp-pip-note" className="text-xs text-slate-600">{NOTE}</p>
                    {sameTable ? <p data-testid="pp-pip-same-table" className={PP_LOOK.error}>PIPs are stored with training and succession, so anyone who can read those can read PIPs.</p> : null}
                    {children}
                </div>
            </section>
        );

        const readingStrip = (
            <div role="status" data-testid="pp-pip-reading" className={PP_LOOK.info}>
                <div>{'Reading ' + poss + ' PIP details...'}</div>
                <div aria-hidden="true" className="mt-2 h-1 rounded bg-[#B3D4F2] overflow-hidden"><div className="h-1 w-1/3 bg-[#0072CE] animate-pulse"></div></div>
            </div>
        );
        const earlierBlock = () => {
            if (!earlier.length) return <p data-testid="pp-pip-earlier-none" className="text-sm text-slate-600">Earlier PIPs: none</p>;
            return (
                <details data-testid="pp-pip-earlier" className="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
                    <summary className="cursor-pointer min-h-[44px] py-2.5 md:min-h-0 md:py-1 text-sm font-bold text-[#00468B]">{'Earlier PIPs (' + earlier.length + ')'}</summary>
                    <ul aria-label="Earlier PIPs" className="mt-2 space-y-2">
                        {earlier.map((row, i) => {
                            const parsed = row && row.dataState === 'text' ? parsePlanData(row.text, 'pip') : null;
                            const rd = parsed && parsed.ok && isO(parsed.data) ? parsed.data : null;
                            const startY = rd && isYmd(rd.start) ? rd.start : (row && isYmd(row.start) ? row.start : '');
                            const endY = rd && isYmd(rd.end) ? rd.end : '';
                            const res = rd && isO(rd.outcome) && typeof rd.outcome.result === 'string' ? rd.outcome.result : '';
                            const word = ppHas(OUTCOMES, res) ? OUTCOMES[res] : (rd ? 'Closed' : 'Saved details could not be read');
                            return (
                                <li key={(row && row.id) || 'e' + i} data-earlier="1" data-result={res || undefined} className="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-800">
                                    <span>{startY ? dt(startY) : 'Start date not set'}{endY ? <span>{' to '}{dt(endY)}</span> : null}</span>
                                    <span className="font-bold">{word}</span>
                                    {rd ? (
                                        <button
                                            type="button" data-testid="pp-pip-earlier-open" aria-disabled={locked ? 'true' : undefined}
                                            onClick={() => {
                                                if (locked) return;
                                                ppPatchPip(ppSel, prev => (prev ? Object.assign({}, prev, {
                                                    mode: 'closed', row: row, others: [], phase: 'ready', error: null, problem: '', recoveredText: '', readOnly: false,
                                                    base: { text: row.text, hash: planTextHash(row.text), doc: rd }, doc: safeClone(rd), ui: { fromEarlier: true }
                                                }) : prev));
                                            }}
                                            className={locked ? PP_LOOK.dimmed : PP_LOOK.secondary}
                                        >Open</button>
                                    ) : null}
                                </li>
                            );
                        })}
                    </ul>
                </details>
            );
        };

        const startView = () => {
            const f = isO(p.form) ? p.form : {};
            const form = Object.assign({ why: '', starts: today, length: 0, ends: '', reviewEvery: PIP_DEFAULT_REVIEW_DAYS, goals: [], enteredBy: '', stopTraining: false }, f);
            const goals = Array.isArray(form.goals) ? form.goals.filter(g => isO(g)) : [];
            const tried = !!ui.startTried;
            const setForm = (patch) => ppPipEdit('form', { patch: patch });
            const revText = String(form.reviewEvery === undefined || form.reviewEvery === null ? '' : form.reviewEvery);
            const revNum = /^\s*\d+\s*$/.test(revText) ? Number(revText) : NaN;
            const kept = goals.filter(g => tx(g.text).trim() !== '' || tx(g.due).trim() !== '');
            const vdoc = newPipData(form.starts, { length: form.length, end: form.ends, reviewEvery: revNum, reason: form.why, goals: [] });
            vdoc.reviewEvery = revNum;
            vdoc.goals = kept.map(g => ({ id: g.id, text: tx(g.text), due: tx(g.due), done: false }));
            const v = validatePipData(vdoc, today);
            const codes = {};
            const goalMsg = {};
            v.errors.forEach(e => {
                const m = /^Goal (\d+) /.exec(e.text);
                if (m && /^goal_/.test(e.code)) { const g = kept[Number(m[1]) - 1]; if (g) goalMsg[g.id] = e.text; return; }
                if (!codes[e.code]) codes[e.code] = e.text;
            });
            const LIVE = { start_invalid: 1, end_invalid: 1, end_before_start: 1, review_every_invalid: 1 };
            const showErr = (code) => (codes[code] && (tried || LIVE[code]) ? codes[code] : '');
            const needBy = !who && tx(form.enteredBy).trim() === '';
            const firstReview = !codes.start_invalid && !codes.review_every_invalid && isYmd(vdoc.nextReview) ? vdoc.nextReview : '';
            const lengthOn = (n) => form.length === n;
            const onLength = (n) => {
                if (locked) return;
                if (lengthOn(n)) setForm({ length: 0, ends: '' });
                else setForm({ length: n, ends: ymdAddDays(form.starts, n) });
            };
            const onStarts = (value) => {
                if (locked) return;
                if (form.length > 0 && isYmd(value)) setForm({ starts: value, ends: ymdAddDays(value, form.length) });
                else setForm({ starts: value });
            };
            const onEnds = (value) => {
                if (locked) return;
                setForm({ ends: value, length: isYmd(form.starts) && isYmd(value) && [30, 60, 90].indexOf(ymdDiffDays(form.starts, value)) > -1 ? ymdDiffDays(form.starts, value) : 0 });
            };
            const onReviewDays = (value) => {
                if (locked) return;
                setForm({ reviewEvery: /^\s*\d+\s*$/.test(value) ? Number(value) : value });
            };
            const onStart = () => {
                if (locked) return;
                if (!v.ok || needBy) {
                    setUi({ startTried: true });
                    ppAnnounce('Check the marked boxes first.');
                    ppFocusTo(codes.reason_required ? 'pip-why' : codes.start_invalid ? 'pip-starts' : (codes.end_invalid || codes.end_before_start) ? 'pip-ends' : codes.review_every_invalid ? 'pip-review' : needBy && !Object.keys(goalMsg).length ? 'entered-by' : 'add:goal');
                    return;
                }
                ppAskStartPip();
            };
            return (
                <div data-testid="pp-pip-form" className="space-y-4">
                    <h4 className="text-sm font-black text-[#00468B]">{'Start a PIP for ' + (first === 'them' ? 'this person' : first)}</h4>
                    <PpField
                        id="pp-pip-why" label="What needs to improve? Describe the specific work behavior." error={showErr('reason_required')}
                        help="Facts about the work only. No health, leave or discipline details. Do not name coworkers or complainants."
                    >
                        <textarea
                            {...noSpell} rows={4} maxLength={1000} autoFocus data-focus="pip-why" value={shownText('why', form.why)} readOnly={locked}
                            onChange={(e) => { if (!locked) typeInto('why', e.target.value, (val) => setForm({ why: val })); }} onBlur={() => dropRaw('why')} className={PP_LOOK.input}
                        />
                    </PpField>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
                        <PpField id="pp-pip-starts" label="Starts" error={showErr('start_invalid')}>
                            <input type="date" {...noSpell} data-focus="pip-starts" value={isYmd(form.starts) ? form.starts : ''} readOnly={locked} onChange={(e) => onStarts(e.target.value)} className={PP_LOOK.input} />
                        </PpField>
                        <div className="min-w-0">
                            <p id="pp-pip-length-h" className={PP_LOOK.label}>Length (optional)</p>
                            <div role="group" aria-labelledby="pp-pip-length-h" className="flex flex-wrap gap-2">
                                {[30, 60, 90].map(n => (
                                    <button key={n} type="button" data-testid={'pp-pip-length-' + n} aria-pressed={lengthOn(n)} aria-disabled={locked ? 'true' : undefined} onClick={() => onLength(n)} className={chipClass(lengthOn(n)) + (locked ? ' opacity-60 cursor-not-allowed' : '')}>{n + ' days'}</button>
                                ))}
                            </div>
                        </div>
                        <PpField id="pp-pip-ends" label="Ends" error={showErr('end_invalid') || showErr('end_before_start')}>
                            <input type="date" {...noSpell} data-focus="pip-ends" value={isYmd(form.ends) ? form.ends : ''} readOnly={locked} onChange={(e) => onEnds(e.target.value)} className={PP_LOOK.input} />
                        </PpField>
                    </div>
                    <div className="flex flex-wrap items-start gap-4">
                        <div className="w-48 max-w-full">
                            <PpField id="pp-pip-review-days" label="Review every N days" error={showErr('review_every_invalid')}>
                                <input type="number" {...noSpell} min={1} max={365} step={1} data-focus="pip-review" value={revText} readOnly={locked} onChange={(e) => onReviewDays(e.target.value)} className={PP_LOOK.input} />
                            </PpField>
                        </div>
                        {firstReview ? <p data-testid="pp-pip-first-review" data-date={firstReview} className="mt-7 text-sm font-bold text-slate-800">First review: {dt(firstReview)}</p> : null}
                    </div>
                    <div>
                        {subHead('pp-pip-form-goals-h', 'Goals')}
                        {goals.length === 0 ? <p className="mt-1 text-xs text-slate-600">No goals yet. A goal is one thing to do by a date.</p> : null}
                        <ul aria-labelledby="pp-pip-form-goals-h" className="mt-1 space-y-2">
                            {goals.map((g, i) => {
                                const gid = tx(g.id) || 'i' + i;
                                const msg = goalMsg[g.id] || '';
                                return (
                                    <li key={gid} data-form-goal={gid} className="flex flex-wrap items-start gap-2">
                                        <span aria-hidden="true" className="mt-2.5 w-5 text-xs font-bold text-slate-500">{i + 1}</span>
                                        <div className="flex-1 min-w-[12rem]">
                                            <input
                                                type="text" {...noSpell} id={'pp-form-goal-text-' + gid} data-testid={'pp-form-goal-text-' + gid} data-focus={'goal:' + gid} aria-label={'Goal ' + (i + 1)}
                                                aria-invalid={tried && msg ? 'true' : undefined} maxLength={300} value={shownText('fg:' + gid, g.text)} readOnly={locked}
                                                onChange={(e) => { if (!locked) typeInto('fg:' + gid, e.target.value, (val) => ppPipEdit('form-goal', { id: g.id, text: val })); }} onBlur={() => dropRaw('fg:' + gid)} className={PP_LOOK.input}
                                            />
                                            {tried && msg ? <p role="alert" className={fieldErr}>{msg}</p> : null}
                                        </div>
                                        <input
                                            type="date" {...noSpell} id={'pp-form-goal-due-' + gid} data-testid={'pp-form-goal-due-' + gid} aria-label={'Goal ' + (i + 1) + ' due date'}
                                            value={isYmd(g.due) ? g.due : ''} readOnly={locked} onChange={(e) => { if (!locked) ppPipEdit('form-goal', { id: g.id, due: e.target.value }); }} className={PP_LOOK.input + ' w-auto'}
                                        />
                                        <button
                                            type="button" data-testid={'pp-form-goal-remove-' + gid} aria-label={'Remove goal ' + (i + 1)} aria-disabled={locked ? 'true' : undefined}
                                            onClick={() => { if (!locked) ppPipEdit('form-goal-remove', { id: g.id }); }} className={locked ? PP_LOOK.dimmed : PP_LOOK.secondary}
                                        >Remove</button>
                                    </li>
                                );
                            })}
                        </ul>
                        <button
                            type="button" data-testid="pp-goal-add" data-focus="add:goal" aria-disabled={locked ? 'true' : undefined}
                            onClick={() => { if (!locked) ppPipEdit('form-goal-add', {}); }} className={(locked ? PP_LOOK.dimmed : PP_LOOK.secondary) + ' mt-2 inline-flex items-center gap-2'}
                        ><PlusIcon className="w-4 h-4" />Add goal</button>
                    </div>
                    {!who ? (
                        <PpField
                            id="pp-entered-by" label="Entered by" error={tried && needBy ? 'Enter your name first.' : ''}
                            help="This page could not tell who is signed in, so type your name. It is saved with the PIP and with every goal, check-in and extension you add."
                        >
                            <input type="text" {...noSpell} data-focus="entered-by" maxLength={100} value={shownText('eb', form.enteredBy)} readOnly={locked} onChange={(e) => { if (!locked) typeInto('eb', e.target.value, (val) => setForm({ enteredBy: val })); }} onBlur={() => dropRaw('eb')} className={PP_LOOK.input} />
                        </PpField>
                    ) : null}
                    <div className="flex flex-wrap items-center justify-between gap-2 pt-1">
                        <button type="button" data-testid="pp-pip-cancel" data-focus="pip-cancel" onClick={() => ppPipEdit('cancel', {})} className={PP_LOOK.secondary}>Cancel</button>
                        <button type="button" data-testid="pp-pip-start-submit" data-focus="pip-start-submit" aria-disabled={locked ? 'true' : undefined} onClick={onStart} className={locked ? PP_LOOK.dimmed : PP_LOOK.primary}>Start PIP...</button>
                    </div>
                </div>
            );
        };

        const noneView = () => (
            <div className="space-y-3">
                <p data-testid="pp-pip-none" className="text-sm font-bold text-slate-800">{nm} is not on a PIP.</p>
                <p className="text-sm text-slate-600">A PIP sets goals and review dates so you can follow progress.</p>
                <button
                    type="button" data-testid="pp-pip-start" data-focus="pip-start" aria-disabled={locked ? 'true' : undefined}
                    onClick={() => { if (!locked) ppPipEdit('begin', {}); }} className={locked ? PP_LOOK.dimmed : PP_LOOK.primary}
                >Start a PIP</button>
                {earlierBlock()}
            </div>
        );

        const docView = () => {
            const closed = mode === 'closed';
            const out = isO(doc.outcome) ? doc.outcome : null;
            const pso = psOf(doc), ps = pso.ps, startY = pso.startY;
            const prog = pipProgress(doc.goals, doc.checkins, today);
            const goals = liveOf(doc.goals);
            const checkins = liveOf(doc.checkins).map((c, i) => ({ c: c, i: i })).sort((a, b) => {
                const da = isYmd(a.c.date) ? a.c.date : '', db = isYmd(b.c.date) ? b.c.date : '';
                if (da !== db) return da < db ? 1 : -1;
                const ta = typeof a.c.ts === 'number' ? a.c.ts : 0, tb = typeof b.c.ts === 'number' ? b.c.ts : 0;
                if (ta !== tb) return tb - ta;
                return b.i - a.i;   // same day and same moment: the entry added later is the newest and goes first
            }).map(x => x.c);
            const baseDoc = p.base && isO(p.base.doc) ? p.base.doc : null;
            const differs = (fn) => !!baseDoc && fn(baseDoc) !== fn(doc);
            const plainNotes = (dd) => liveOf(dd.notes).filter(n => !tx(n.event));
            const lastPlain = (dd) => { const l = plainNotes(dd); return l.length ? l[l.length - 1] : null; };
            const noteText = (dd) => { const n = lastPlain(dd); return n ? tx(n.text) : ''; };
            const val = validatePipData(doc, today);
            const errOf = (re) => { const e = val.errors.filter(x => re.test(x.code))[0]; return e ? e.text : ''; };

            const dev = pplLsGet('stillwell.ppl', {});
            const learned = dev && isO(dev.learnedMax) && typeof dev.learnedMax.pip === 'number' && dev.learnedMax.pip > 0 ? dev.learnedMax.pip : 0;
            const cap = learned ? Math.min(PLAN_DATA_CAP, learned) : PLAN_DATA_CAP;
            const ser = mode === 'newer' ? null : serializePlanData(doc, 'pip', { bumpRev: false, maxLength: cap });
            const sizeLine = ser && ser.length > cap * 0.8 ? ser.length + ' of ' + cap + ' characters used. Shorten notes or ask for a longer column.' : '';
            const otherKeys = (() => { try { const pr = mode === 'newer' ? null : parsePlanData(JSON.stringify(doc), 'pip'); return pr && pr.ok && Array.isArray(pr.unknownKeys) ? pr.unknownKeys : []; } catch (e) { return []; } })();

            const needBy = !who && !byNow;
            const askBy = () => { setUi({ byTried: true }); ppAnnounce('Enter your name first.'); ppFocusTo('entered-by'); };
            const withBy = (fn) => { if (dis) return; if (!byNow) { askBy(); return; } fn(byNow); };

            let reviewLine = null;
            if (!closed) {
                if (!startY) {
                    reviewLine = <p data-testid="pp-pip-no-start" className={'inline-block text-sm font-bold ' + yellow}>No start date is saved for this PIP, so the day count and the reviews cannot be shown.</p>;
                } else if (ps.notStarted) {
                    reviewLine = <p data-testid="pp-pip-review" data-review-date={startY} className="text-sm font-bold text-slate-800">Starts {dt(startY)} ({when(ymdDiffDays(today, startY))})</p>;
                } else if (ps.nextReview) {
                    const late = ps.daysToReview !== null && ps.daysToReview < 0;
                    reviewLine = (
                        <p data-testid="pp-pip-review" data-review-date={ps.nextReview} data-overdue={late ? '1' : undefined} className={'inline-block text-sm font-bold ' + (late ? yellow : 'text-slate-800')}>
                            {late ? 'Review was due ' : 'Next review '}{dt(ps.nextReview)} ({late ? countWord(0 - ps.daysToReview, 'day') + ' ago' : when(ps.daysToReview)})
                        </p>
                    );
                } else {
                    reviewLine = <p data-testid="pp-pip-review" className="text-sm font-bold text-slate-800">No review is scheduled before the end date.</p>;
                }
            }
            const endPassed = !closed && ps.endPassed && isYmd(doc.end);
            const created = p.row && typeof p.row.createdOn === 'string' ? Date.parse(p.row.createdOn) : NaN;
            const ageHours = created === created ? (pplNow() - created) / 3600000 : null;
            const mistakeOk = !closed && !ro && !!p.row && (checkins.length === 0 || (ageHours !== null && ageHours < 24));

            const onTick = (g, on) => { if (dis) return; ppPipEdit('goal', { id: g.id, patch: on ? { done: true, doneOn: today } : { done: false, doneOn: '' } }); };
            const stripFor = (g) => {
                const c = ppConfirm;
                if (!c || c.kind !== 'remove' || c.section !== 'pip' || c.id !== g.id) return null;
                return (
                    <div
                        role="alert" data-confirm="remove" data-testid="pp-remove-strip" className={PP_LOOK.warn + ' mt-2 flex flex-wrap items-center gap-2'}
                        onKeyDown={(e) => { if (e.key === 'Escape') { e.stopPropagation(); ppCloseConfirm(); ppFocusTo('goal:' + g.id); } }}
                    >
                        <span className="font-bold">Remove this goal?</span>
                        {c.label ? <span className="min-w-0 break-words text-slate-600">{'"' + c.label + '"'}</span> : null}
                        <button type="button" data-testid="pp-remove-yes" onClick={() => { ppPipEdit('goal-remove', { id: g.id, confirmed: true }); ppCloseConfirm(); }} className={PP_LOOK.danger}>Yes, remove</button>
                        <button type="button" data-testid="pp-remove-keep" data-safe="1" autoFocus onClick={() => { ppCloseConfirm(); ppFocusTo('goal:' + g.id); }} className={PP_LOOK.secondary}>Keep</button>
                    </div>
                );
            };

            const ci = ui.checkin && isO(ui.checkin) ? ui.checkin : null;
            const setCi = (patch) => setUi({ checkin: Object.assign({}, ci, patch) });
            const closeCi = () => { setUi({ checkin: null }); ppFocusTo('add:checkin'); };
            const ciDateErr = ci && ci.tried && !isYmd(ci.date) ? 'Enter a date for the check-in.' : '';
            const ciRateErr = ci && ci.tried && !ppHas(RATINGS, tx(ci.rating)) ? 'Choose how it is going.' : '';
            const onAddCheckin = () => {
                if (dis || !ci) return;
                if (!isYmd(ci.date) || !ppHas(RATINGS, tx(ci.rating)) || needBy) {
                    setUi({ checkin: Object.assign({}, ci, { tried: true }), byTried: needBy ? true : ui.byTried });
                    ppAnnounce(needBy && isYmd(ci.date) && ppHas(RATINGS, tx(ci.rating)) ? 'Enter your name first.' : 'Check the marked boxes first.');
                    ppFocusTo(!isYmd(ci.date) ? 'checkin-date' : !ppHas(RATINGS, tx(ci.rating)) ? 'checkin-rating' : 'entered-by');
                    return;
                }
                ppPipEdit('checkin-add', { date: ci.date, rating: ci.rating, note: tx(ci.note).trim(), by: byNow });
                setUi({ checkin: null, byTried: false });
            };

            const ex = ui.extend && isO(ui.extend) ? ui.extend : null;
            const setEx = (patch) => setUi({ extend: Object.assign({}, ex, patch) });
            const closeEx = () => { setUi({ extend: null }); ppFocusTo('extend'); };
            const exToErr = ex && ex.tried ? (!isYmd(ex.to) ? 'Choose the new end date.' : (isYmd(doc.end) && ex.to <= doc.end ? 'Choose a date after ' + ymdLabel(doc.end) + '.' : (!isYmd(doc.end) && isYmd(doc.start) && ex.to <= doc.start ? 'Choose a date after the start date.' : ''))) : '';
            const exWhyErr = ex && ex.tried && tx(ex.reason).trim() === '' ? 'Say why the end date is moving.' : '';
            const onExtend = () => {
                if (dis || !ex) return;
                const toOk = isYmd(ex.to) && (isYmd(doc.end) ? ex.to > doc.end : (!isYmd(doc.start) || ex.to > doc.start));
                const whyOk = tx(ex.reason).trim() !== '';
                if (!toOk || !whyOk || needBy) {
                    setEx({ tried: true });
                    ppAnnounce(needBy && toOk && whyOk ? 'Enter your name first.' : 'Check the marked boxes first.');
                    ppFocusTo(!toOk ? 'extend-to' : !whyOk ? 'extend-reason' : 'entered-by');
                    return;
                }
                const r = ppExtendPip({ to: ex.to, reason: tx(ex.reason).trim(), by: byNow });
                if (r && r.ok === false) return;      // the handler said no: the form stays open
                setUi({ extend: null });
            };

            const others = Array.isArray(p.others) ? p.others : [];
            const dup = ui.dup && isO(ui.dup) ? ui.dup : null;
            const startOf = (row) => (row && isYmd(row.start) ? row.start : (row ? ymdOf(row.createdOn) : ''));
            const twoBanner = mode === 'two-active' && others.length ? (
                <div data-testid="pp-pip-two-active" className={PP_LOOK.warn + ' space-y-2'}>
                    <p className="font-bold">
                        {(others.length === 1 ? 'Two active PIPs exist for ' : (others.length + 1) + ' active PIPs exist for ') + (first === 'them' ? 'this person' : first) + ' (started '}
                        {dt(startOf(p.row))}{others.map((o, i) => <span key={i}>{i === others.length - 1 ? ' and ' : ', '}{dt(startOf(o))}</span>)}
                        {'). This page edits the older one.'}
                    </p>
                    <div className="flex flex-wrap gap-2">
                        <button type="button" data-testid="pp-pip-open-other" aria-disabled={locked ? 'true' : undefined} onClick={() => { if (!locked) ppPipOpenOther(); }} className={locked ? PP_LOOK.dimmed : PP_LOOK.secondary}>Open the other one (read only)</button>
                        <button
                            type="button" data-testid="pp-pip-close-dup" data-focus="pip-close-dup" aria-expanded={dup ? 'true' : 'false'} aria-disabled={locked ? 'true' : undefined}
                            onClick={() => { if (!locked) setUi({ dup: dup ? null : { reason: '', tried: false } }); }} className={locked ? PP_LOOK.dimmed : PP_LOOK.secondary}
                        >Close the newer one as a duplicate</button>
                    </div>
                    {dup ? (
                        <div
                            data-testid="pp-pip-dup-form" className="space-y-2"
                            onKeyDown={(e) => { if (e.key === 'Escape') { e.stopPropagation(); setUi({ dup: null }); ppFocusTo('pip-close-dup'); } }}
                        >
                            <PpField id="pp-pip-dup-reason" label="Why is it being closed?" error={dup.tried && tx(dup.reason).trim() === '' ? 'Say why it is a duplicate.' : ''}>
                                <input type="text" {...noSpell} autoFocus maxLength={300} value={tx(dup.reason)} onChange={(e) => setUi({ dup: Object.assign({}, dup, { reason: e.target.value }) })} className={PP_LOOK.input} />
                            </PpField>
                            <div className="flex flex-wrap gap-2">
                                <button
                                    type="button" data-testid="pp-pip-dup-yes" aria-disabled={locked ? 'true' : undefined}
                                    onClick={() => {
                                        if (locked) return;
                                        if (tx(dup.reason).trim() === '') { setUi({ dup: Object.assign({}, dup, { tried: true }) }); return; }
                                        ppPipCloseDup(tx(dup.reason).trim());
                                        setUi({ dup: null });
                                    }}
                                    className={locked ? PP_LOOK.dimmed : PP_LOOK.danger}
                                >Yes, close it</button>
                                <button type="button" data-testid="pp-pip-dup-no" onClick={() => { setUi({ dup: null }); ppFocusTo('pip-close-dup'); }} className={PP_LOOK.secondary}>Keep both</button>
                            </div>
                        </div>
                    ) : null}
                </div>
            ) : null;

            const goalRow = (g, i) => {
                const gid = tx(g.id) || 'i' + i;
                const done = isDone(g);
                const textErr = ui.touched && ppHas(ui.touched, gid) && tx(g.text).trim() === '' ? 'Goal ' + (i + 1) + ' has no text.' : '';
                return (
                    <li key={gid} data-goal={gid} data-done={done ? '1' : '0'} className="py-2 border-b border-slate-100 last:border-b-0">
                        <div className="flex flex-wrap items-start gap-2">
                            <input
                                type="checkbox" id={'pp-goal-check-' + gid} data-testid={'pp-goal-check-' + gid} aria-label={'Goal ' + (i + 1) + ' done'} checked={done}
                                aria-disabled={dis ? 'true' : undefined} onChange={(e) => onTick(g, !!e.target.checked)} className="mt-2 md:mt-2.5 w-6 h-6 md:w-4 md:h-4 accent-[#0072CE]"
                            />
                            <div className="flex-1 min-w-[12rem]">
                                <input
                                    type="text" {...noSpell} id={'pp-goal-text-' + gid} data-testid={'pp-goal-text-' + gid} data-focus={'goal:' + gid} aria-label={'Goal ' + (i + 1)} maxLength={300} value={shownText('g:' + gid, g.text)} readOnly={dis}
                                    aria-invalid={textErr ? 'true' : undefined}
                                    onChange={(e) => { if (!dis) typeInto('g:' + gid, e.target.value, (val) => ppPipEdit('goal', { id: g.id, patch: { text: val } })); }}
                                    onBlur={() => { dropRaw('g:' + gid); if (!ro && !(ui.touched && ui.touched[gid])) setUi({ touched: Object.assign({}, ui.touched || {}, { [gid]: true }) }); }}
                                    className={PP_LOOK.input}
                                />
                                {textErr ? <p role="alert" className={fieldErr}>{textErr}</p> : null}
                            </div>
                            <input
                                type="date" {...noSpell} id={'pp-goal-due-' + gid} data-testid={'pp-goal-due-' + gid} aria-label={'Goal ' + (i + 1) + ' due date'} value={isYmd(g.due) ? g.due : ''} readOnly={dis}
                                onChange={(e) => { if (!dis) ppPipEdit('goal', { id: g.id, patch: { due: e.target.value } }); }} className={PP_LOOK.input + ' w-auto'}
                            />
                            {!ro ? (
                                <button
                                    type="button" data-testid={'pp-goal-remove-' + gid} aria-label={'Remove goal ' + (i + 1)} aria-disabled={dis ? 'true' : undefined}
                                    onClick={() => { if (!dis) ppPipEdit('goal-remove', { id: g.id }); }} className={dis ? PP_LOOK.dimmed : PP_LOOK.secondary}
                                >Remove</button>
                            ) : null}
                        </div>
                        <p className="mt-0.5 ml-6 text-xs text-slate-600">
                            {done && isYmd(g.doneOn) ? <span>Done {dt(g.doneOn)}. </span> : null}{byLine(g.by)}
                        </p>
                        {stripFor(g)}
                    </li>
                );
            };

            const removedGoals = (Array.isArray(doc.goals) ? doc.goals : []).filter(g => isO(g) && g.removed === true && tx(g.text).trim() !== '');
            const exts = liveOf(doc.extensions);
            const events = liveOf(doc.notes).filter(n => tx(n.event));
            const historyCount = removedGoals.length + exts.length + events.length;
            const eventWord = (e) => (e === 'removed' ? 'Marked as started by mistake' : e === 'reopened' ? 'Reopened' : tx(e));
            const noteSaysWord = (n) => { const t = tx(n.text).trim().toLowerCase(), w = eventWord(n.event).trim().toLowerCase(); return w !== '' && t.indexOf(w) === 0 && !/[a-z0-9]/.test(t.charAt(w.length)); };

            const copyText = tx(ppUi.pipCopy);

            const warnBits = [];
            if (mode === 'newer') warnBits.push(<p key="newer" data-testid="pp-pip-newer" className={PP_LOOK.warn}>Saved by a newer version of this app. You can read it here, but it cannot be changed from this page.</p>);
            if (sizeLine) warnBits.push(<p key="size" data-testid="pp-pip-size" className={PP_LOOK.warn}>{sizeLine}</p>);
            if (phase === 'error' && p.error) warnBits.push(<p key="err" role="alert" data-testid="pp-pip-reread-error" className={PP_LOOK.error}>{'This PIP could not be read again. Dataverse said: "' + ppErrText(p.error) + '". What you see is the last copy that was read.'}</p>);

            const reviewVal = ui.reviewRaw !== undefined ? ui.reviewRaw : (doc.reviewEvery === undefined || doc.reviewEvery === null ? '' : String(doc.reviewEvery));
            const reviewBad = ui.reviewRaw !== undefined && !(/^\s*\d+\s*$/.test(String(ui.reviewRaw)) && Number(ui.reviewRaw) >= 1 && Number(ui.reviewRaw) <= 365);
            const onReview = (e) => {
                if (dis) return;
                const raw = e.target.value;
                if (/^\s*\d+\s*$/.test(raw) && Number(raw) >= 1 && Number(raw) <= 365) { ppPipEdit('review-days', { days: Number(raw) }); setUi({ reviewRaw: undefined }); }
                else setUi({ reviewRaw: raw });
            };
            const reviewErr = reviewBad ? 'Review every N days: N must be a whole number from 1 to 365.' : (ui.reviewRaw === undefined ? errOf(/^review_every_invalid$/) : '');
            const endErr = errOf(/^end_/);

            return (
                <div className="space-y-4" data-testid="pp-pip-doc" data-saved={p.row ? '1' : '0'} data-mode={mode}>
                    {warnBits}
                    {twoBanner}
                    {phase === 'reading' ? readingStrip : null}
                    {closed ? (
                        <p data-testid="pp-pip-closed-line" data-result={out && out.result ? out.result : undefined} className={PP_LOOK.info}>
                            {'Closed as ' + (out && ppHas(OUTCOMES, out.result) ? OUTCOMES[out.result] : 'no outcome recorded')}
                            {out && isYmd(out.on) ? <span>{' on '}{dt(out.on)}</span> : null}
                            {'.'}
                            {out && tx(out.note).trim() ? <span className="block font-normal mt-1">{tx(out.note)}</span> : null}
                            <span className="block font-normal text-xs mt-1">{byLine(out && out.by)}</span>
                        </p>
                    ) : null}
                    {reviewLine}
                    {endPassed ? <p data-testid="pp-pip-end-passed" data-date={doc.end} className={'inline-block text-sm font-bold ' + yellow}>The end date was {dt(doc.end)} ({countWord(ymdDiffDays(doc.end, today), 'day')} ago). Extend it or close the PIP.</p> : null}

                    <div data-testid="pp-pip-figures" className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <p data-testid="pp-pip-goals-figure" className="text-sm font-bold text-slate-800">{prog.goalsTotal === 0 ? 'No goals yet' : prog.goalsDone + ' of ' + prog.goalsTotal + (prog.goalsTotal === 1 ? ' goal done' : ' goals done')}</p>
                            <div aria-hidden="true" className="mt-1 h-2 rounded-full bg-slate-200 overflow-hidden"><div className="h-2 bg-[#0072CE]" style={{ width: prog.goalsPercent + '%' }}></div></div>
                        </div>
                        {ps.timePercent !== null ? (
                            <div>
                                <p data-testid="pp-pip-time-figure" className="text-sm font-bold text-slate-800"><span className="text-[10px] font-black uppercase tracking-widest text-slate-600">Time</span>{' '}{ps.timePercent}%</p>
                                <div aria-hidden="true" className="mt-1 h-2 rounded-full bg-slate-200 overflow-hidden"><div className="h-2 bg-slate-500" style={{ width: ps.timePercent + '%' }}></div></div>
                            </div>
                        ) : null}
                    </div>

                    <div className="space-y-1">
                        <p data-testid="pp-pip-reason" className="text-sm text-slate-800 whitespace-pre-wrap break-words"><span className="font-bold">Why: </span>{tx(doc.reason) || '(none recorded)'}</p>
                        {tx(doc.expectations).trim() ? <p data-testid="pp-pip-expectations" className="text-sm text-slate-800 whitespace-pre-wrap break-words"><span className="font-bold">Expectations: </span>{tx(doc.expectations)}</p> : null}
                    </div>

                    {!ro && !who ? (
                        <PpField
                            id="pp-entered-by" label="Entered by" error={ui.byTried && !byNow ? 'Enter your name first.' : ''}
                            help="This page could not tell who is signed in, so type your name. It is saved with each goal, check-in and extension you add."
                        >
                            <input type="text" {...noSpell} data-focus="entered-by" maxLength={100} value={tx(ui.by)} readOnly={locked} onChange={(e) => { if (!locked) setUi({ by: e.target.value }); }} className={PP_LOOK.input} />
                        </PpField>
                    ) : null}

                    {!ro ? (
                        <div className="flex flex-wrap gap-2">
                            <button
                                type="button" id="pp-checkin-add" data-testid="pp-checkin-add" data-focus="add:checkin" aria-expanded={ci ? 'true' : 'false'} aria-disabled={dis ? 'true' : undefined}
                                onClick={() => { if (!dis) setUi({ checkin: ci ? null : { date: today, rating: '', note: '', tried: false }, extend: null }); }}
                                className={(dis ? PP_LOOK.dimmed : PP_LOOK.secondary) + ' inline-flex items-center gap-2'}
                            ><PlusIcon className="w-4 h-4" />Add check-in</button>
                            {checkins.length >= PLAN_LIST_CAPS.pip.checkins ? <p data-testid="pp-checkins-full" className={'self-center text-sm font-bold ' + yellow}>{fullLine(PLAN_LIST_CAPS.pip.checkins, 'check-ins')}</p> : null}
                        </div>
                    ) : null}

                    {ci && !ro ? (
                        <div
                            data-testid="pp-checkin-form" className="rounded-xl border border-[#B3D4F2] bg-[#E6F1FB] p-4 space-y-3"
                            onKeyDown={(e) => { if (e.key === 'Escape') { e.stopPropagation(); closeCi(); } }}
                        >
                            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <PpField id="pp-checkin-date" label="Date" error={ciDateErr}>
                                    <input type="date" {...noSpell} autoFocus data-focus="checkin-date" value={isYmd(ci.date) ? ci.date : ''} readOnly={dis} onChange={(e) => setCi({ date: e.target.value })} className={PP_LOOK.input} />
                                </PpField>
                                <PpField id="pp-checkin-rating" label="How is it going?" error={ciRateErr}>
                                    <select data-focus="checkin-rating" value={tx(ci.rating)} aria-disabled={dis ? 'true' : undefined} onChange={(e) => { if (!dis) setCi({ rating: e.target.value }); }} className={PP_LOOK.input}>
                                        <option value="">Choose...</option>
                                        <option value="on_track">On track</option>
                                        <option value="some_progress">Making progress</option>
                                        <option value="off_track">Not yet on track</option>
                                    </select>
                                </PpField>
                            </div>
                            <PpField id="pp-checkin-note" label="What happened?" help="Facts about the work only. No health, leave or discipline details.">
                                <textarea {...noSpell} rows={3} maxLength={1000} value={tx(ci.note)} readOnly={dis} onChange={(e) => setCi({ note: e.target.value })} className={PP_LOOK.input} />
                            </PpField>
                            <div className="flex flex-wrap gap-2">
                                <button type="button" data-testid="pp-checkin-submit" aria-disabled={dis ? 'true' : undefined} onClick={onAddCheckin} className={dis ? PP_LOOK.dimmed : PP_LOOK.primary}>Add check-in</button>
                                <button type="button" data-testid="pp-checkin-cancel" onClick={closeCi} className={PP_LOOK.secondary}>Cancel</button>
                            </div>
                        </div>
                    ) : null}

                    <div>
                        {subHead('pp-pip-goals-h', 'Goals')}
                        {goals.length === 0 ? <p className="mt-1 text-xs text-slate-600">No goals yet.</p> : null}
                        <ul aria-labelledby="pp-pip-goals-h" className="mt-1">{goals.map(goalRow)}</ul>
                        {!ro ? (
                            <button
                                type="button" id="pp-goal-add" data-testid="pp-goal-add" data-focus="add:goal" aria-disabled={dis ? 'true' : undefined}
                                onClick={() => withBy((by) => ppPipEdit('goal-add', { text: '', due: '', by: by }))} className={(dis ? PP_LOOK.dimmed : PP_LOOK.secondary) + ' mt-2 inline-flex items-center gap-2'}
                            ><PlusIcon className="w-4 h-4" />Add goal</button>
                        ) : null}
                        {!ro && goals.length >= PLAN_LIST_CAPS.pip.goals ? <p data-testid="pp-goals-full" className={'mt-2 inline-block text-sm font-bold ' + yellow}>{fullLine(PLAN_LIST_CAPS.pip.goals, 'goals')}</p> : null}
                    </div>

                    <div>
                        {subHead('pp-pip-checkins-h', 'Check-ins (newest first)')}
                        {checkins.length === 0 ? <p className="mt-1 text-xs text-slate-600">No check-ins yet.</p> : null}
                        <ul aria-labelledby="pp-pip-checkins-h" className="mt-1 space-y-2">
                            {checkins.map((c, i) => (
