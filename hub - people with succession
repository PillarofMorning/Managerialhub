}

async function ppqEmployeeSearch(dataApi, spec, env) {
    const s = ppqIsObj(spec) ? spec : {};
    let filter = '';
    if (s.name !== undefined) filter = nameExactFilter(s.name);
    else if (s.email !== undefined) filter = emailFilter(s.email);
    else if (s.badge !== undefined) filter = badgeFilter(s.badge);
    const r = await ppqEmployeeRead(dataApi, filter, '', PPQ_DUPES_MAX, env);
    return { rows: r.rows, error: r.error, colEntry: r.colEntry, skipped: r.skipped, dropped: r.dropped };
}

function ppqRememberGuidStyle(style) {
    if (style !== 'bare' && style !== 'quoted') return;
    const st = pplLsGet('stillwell.ppl', {});
    if (st.guidStyle === style) return;
    st.guidStyle = style;
    pplLsSet('stillwell.ppl', st);
}

async function ppqEmployeeById(dataApi, id, env) {
    const e = ppqEnv(env);
    const g = cleanGuid(id);
    const failed = function (error, entry) { return { row: null, error: error, gone: false, colEntry: entry || e.colEntry, guidStyle: e.guidStyle }; };
    if (!g || !pplGuidFilter(PPQ_EMP_GUID_COLUMN, g, 'bare')) return failed(ppqError('This person has no usable id.'));
    const dev = pplLsGet('stillwell.ppl', {});
    const remembered = e.guidStyle || (dev && (dev.guidStyle === 'bare' || dev.guidStyle === 'quoted') ? dev.guidStyle : '');
    const order = remembered === 'quoted' ? ['quoted', 'bare'] : remembered === 'bare' ? ['bare', 'quoted'] : ['bare', 'quoted'];
    let entry = e.colEntry, cleanEntry = null, lastError = null, cleanEmpty = false;
    for (let i = 0; i < order.length; i++) {
        const style = order[i];
        const filter = pplGuidFilter(PPQ_EMP_GUID_COLUMN, g, style);
        let res;
        try {
            res = await pplReadTable(dataApi, {
                store: 'emp', tables: PPL_TABLES.employee, filter: filter, select: pplEmpSelect(e.picks), required: pplRequired('employee', false, e.picks),
                top: 1, colEntry: entry, picks: e.picks
            });
        } catch (err) { return failed(ppqError('The employee table could not be read.'), entry); }
        entry = res.colEntry;
        if (res.error) {
            const k = res.error.kind;
            if (k === 'row_gone') return { row: null, error: null, gone: true, colEntry: entry, guidStyle: e.guidStyle };
            if (k === 'other' || k === 'bind') { lastError = res.error; continue; }      // the other form of the guid may be the one this host wants
            return failed(res.error, entry);                                             // missing column / table, denied, too long, timeout, network: the other form would not help
        }
        lastError = null;
        const rows = ppqParseEmployees(Array.isArray(res.rows) ? res.rows : [], e);
        const hit = rows.filter(function (r) { return r && r.id === g; })[0] || null;
        if (hit) {
            ppqRememberGuidStyle(style);
            return { row: hit, error: null, gone: false, colEntry: entry, guidStyle: style };
        }
        cleanEmpty = true;
        cleanEntry = entry;                                                              // a refusal of the OTHER form later must not leave its error on the table: the table answered
        if (remembered === style) break;                                                 // the form that worked before found nothing: the row is gone
    }
    if (!cleanEmpty && lastError) return failed(lastError, entry);
    return { row: null, error: null, gone: true, colEntry: cleanEntry || entry, guidStyle: e.guidStyle };
}

async function ppqTeams(dataApi, env) {
    const e = ppqEnv(env);
    let res;
    try {
        res = await pplReadTable(dataApi, { store: 'team', tables: PPL_TABLES.team, filter: 'statecode eq 0', select: [], required: [], top: PPQ_TEAMS_MAX, colEntry: e.colEntry, picks: e.picks });
    } catch (err) { return { list: [], rows: [], error: ppqError('The Leadership teams table could not be read.'), colEntry: e.colEntry, table: '' }; }
    if (res.error) return { list: [], rows: [], error: res.error, colEntry: res.colEntry, table: res.table || '' };
    let rows = Array.isArray(res.rows) ? res.rows : [];
    let table = res.table || '';
    if (!rows.length && PPL_TABLES.team.length > 1) {
        const others = PPL_TABLES.team.filter(function (t) { return pplLow(t) !== pplLow(table); });
        for (let i = 0; i < others.length && !rows.length; i++) {
            try {
                const r2 = await pplQuery([others[i]], dataApi, { filter: 'statecode eq 0', select: [], top: PPQ_TEAMS_MAX, noMemory: true, quiet: true, store: 'team' });
                if (!r2.error && Array.isArray(r2.rows) && r2.rows.length) { rows = r2.rows; table = r2.table || others[i]; pplRememberTable('team', table); }
            } catch (err) { /* the next spelling */ }
        }
    }
    return { list: parseTeamRows(rows), rows: rows, error: null, colEntry: res.colEntry, table: table };
}

function ppqJobRoleColumns(rows, table, picks) {
    const list = rows.filter(ppqIsObj);
    const isText = function (cname) { return list.some(function (r) { return typeof r[cname] === 'string' && r[cname].trim() !== ''; }); };   // fix T1 (D14): not 'col'
    const candidates = [];
    const pick = ppqIsObj(picks) ? picks['ppl.jobrole.name'] : '';
    if (typeof pick === 'string' && /^[A-Za-z_][A-Za-z0-9_]*$/.test(pick.trim()) && pick.trim().toLowerCase() !== 'craa5_pin') candidates.push(pick.trim());
    PPQ_ROLE_NAME_COLUMNS.forEach(function (c) { candidates.push(c); });
    let nameKey = '';
    for (let i = 0; i < candidates.length && !nameKey; i++) { if (isText(candidates[i])) nameKey = candidates[i]; }
    const idCandidates = (table ? [table + 'id'] : []).concat(PPQ_ROLE_ID_COLUMNS);
    let idKey = '';
    for (let j = 0; j < idCandidates.length && !idKey; j++) { if (list.some(function (r) { return r[idCandidates[j]] !== undefined && r[idCandidates[j]] !== null; })) idKey = idCandidates[j]; }
    return { nameKey: nameKey, idKey: idKey };
}

async function ppqJobRoles(dataApi, env) {
    const e = ppqEnv(env);
    let res;
    try {
        res = await pplReadTable(dataApi, { store: 'jobrole', tables: PPL_TABLES.jobrole, filter: 'statecode eq 0', select: [], required: [], top: PPQ_JOBROLES_MAX, colEntry: e.colEntry, picks: e.picks });
    } catch (err) { return { rows: [], list: [], byId: {}, nameKey: '', error: ppqError('The Job roles table could not be read.'), colEntry: e.colEntry }; }
    if (res.error) return { rows: [], list: [], byId: {}, nameKey: '', error: res.error, colEntry: res.colEntry };
    const rows = Array.isArray(res.rows) ? res.rows : [];
    const cols = ppqJobRoleColumns(rows, res.table, e.picks);
    const byId = {};
    const list = [];
    if (cols.nameKey) {
        rows.forEach(function (r) {
            if (!ppqIsObj(r)) return;
            const id = cols.idKey ? cleanGuid(r[cols.idKey]) : '';
            const name = typeof r[cols.nameKey] === 'string' ? r[cols.nameKey].trim() : '';
            if (!id || !name || byId[id] !== undefined) return;
            byId[id] = name;
            list.push({ id: id, name: name });
        });
        list.sort(function (a, b) { const x = a.name.toLowerCase(), y = b.name.toLowerCase(); return x < y ? -1 : x > y ? 1 : (a.id < b.id ? -1 : 1); });
    }
    return { rows: rows, list: list, byId: byId, nameKey: cols.nameKey, error: null, colEntry: res.colEntry };
}

function ppqPick(list) {
    const out = [];
    list.forEach(function (c) { if (typeof c === 'string' && c && out.indexOf(c) < 0) out.push(c); });
    return out;
}

function ppqFixPlanIds(rows, store) {
    const want = store === 'pip' ? 'craa5_pipplanid' : 'craa5_peopleplanid';
    return rows.map(function (r) {
        if (!ppqIsObj(r) || r[want] !== undefined) return r;
        const key = Object.keys(r).filter(function (k) { return /planid$/i.test(k); })[0];
        return key ? Object.assign({}, r, { [want]: r[key] }) : r;
    });
}

function ppqParsePlans(raw, store, cols, secret) {
    const out = [];
    ppqFixPlanIds(raw, store).forEach(function (r) {
        let p = null;
        try { p = parsePlanRow(r, store, cols); } catch (err) { p = null; }
        if (p && p.id) out.push(secret ? Object.assign(p, { text: p.text }) : p);
    });
    return out;
}

function ppqOnlyPipKind(rows, kindCol) {
    if (!kindCol) return rows;
    return rows.filter(function (r) { return ppqIsObj(r) && typeof r[kindCol] === 'string' && r[kindCol].trim().toLowerCase() === 'pip'; });
}

