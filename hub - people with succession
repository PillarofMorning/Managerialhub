const WORKSHIFT_TABLE = 'craa5_workshift';

const WORKSHIFT_COLUMNS = ['craa5_shiftcode', 'craa5_dayname', 'craa5_daynumber', 'craa5_shiftstarthour', 'craa5_shiftendhour'];

function parseWorkShiftRows(rows) {
    const read = (r, n) => (r[n + FMT_SUFFIX] !== undefined && r[n + FMT_SUFFIX] !== null && r[n + FMT_SUFFIX] !== '') ? r[n + FMT_SUFFIX] : r[n];
    const raw = (rows || []).map(r => ({ crew: crewOfValue(read(r, 'craa5_shiftcode')), dayName: String(renderSafe(read(r, 'craa5_dayname')) || ''), dayNum: parseInt(read(r, 'craa5_daynumber'), 10), startH: parseInt(read(r, 'craa5_shiftstarthour'), 10), endH: parseInt(read(r, 'craa5_shiftendhour'), 10) }));
    const hours = [];
    raw.forEach(x => { if (!isNaN(x.startH)) hours.push(x.startH); if (!isNaN(x.endH)) hours.push(x.endH); });
    const plusOne = hours.length > 0 && hours.every(h => h >= 1 && (h - 1) % 6 === 0);
    const hasZeroDay = raw.some(x => x.dayNum === 0);
    const fixHour = (h) => plusOne ? (h - 1 + 24) % 24 : (h === 1 || h === 24) ? 0 : ((h % 24) + 24) % 24;
    const DAYS = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
    const slots = [], pending = [];
    raw.forEach(x => {
        const m = x.dayName.toLowerCase().match(/sun|mon|tue|wed|thu|fri|sat/);
        let day = m ? DAYS.indexOf(m[0]) : (isNaN(x.dayNum) ? -1 : (hasZeroDay ? x.dayNum : x.dayNum - 1));
        if (!x.crew || day < 0 || isNaN(x.startH) || isNaN(x.endH)) return;
        day = ((day % 7) + 7) % 7;
        const sH = fixHour(x.startH), eH = fixHour(x.endH);
        const slot = { crew: x.crew, day, startHour: sH, lengthHours: ((eH - sH + 24) % 24) || 24 };
        (sH < 4 ? pending : slots).push(slot);
    });
    const hoursOf = (s) => Array.from({ length: s.lengthHours }, (_, h) => (s.day * 24 + s.startHour + h) % 168);
    pending.forEach(p => {
        const taken = new Set();
        slots.forEach(s => hoursOf(s).forEach(h => taken.add(h)));
        const next = { ...p, day: (p.day + 1) % 7 };
        const clash = (s) => hoursOf(s).filter(h => taken.has(h)).length;
        slots.push(clash(p) < clash(next) ? p : next);
    });
    return slots;
}

function slotEndMs(start, lengthHours) { const e = new Date(start); e.setHours(e.getHours() + lengthHours, 0, 0, 0); return e.getTime(); }

function findCurrentShift(slots, now) {
    now = now || new Date();
    for (let i = 0; i < slots.length; i++) {
        const s = slots[i];
        for (let back = 0; back <= 1; back++) {
            const d = new Date(now); d.setDate(d.getDate() - back);
            if (d.getDay() !== s.day) continue;
            const start = new Date(d); start.setHours(s.startHour, 0, 0, 0);
            const end = slotEndMs(start, s.lengthHours);
            if (now.getTime() >= start.getTime() && now.getTime() < end) return { crew: s.crew, startMs: start.getTime(), endMs: end };
        }
    }
    return { crew: '', startMs: 0, endMs: 0 };
}

