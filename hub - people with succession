async function ppqActivePips(dataApi, env) {
    const e = ppqEnv(env);
    const cols = pplCols('pip', e.picks);
    const same = pplSamePipTable(e.colEntry) ? pplCol('plan', 'kind', e.picks) : '';   // D4: the PIP table is the People plan table, so a PIP row is the row of Kind PIP
    const filter = pipFilter({ status: 'active' }, cols, same || undefined);
    const empty = { rows: [], capped: false, error: null, dropped: [], colEntry: e.colEntry };
    if (!filter) return Object.assign({}, empty, { error: ppqError('The filter could not be built.') });
    let res;
    try {
        res = await pplReadTable(dataApi, {
            store: 'pip', tables: PPL_TABLES.pip, filter: filter, required: pplRequired('pip', false, e.picks), top: PPQ_PIPS_MAX, colEntry: e.colEntry, picks: e.picks,
            select: ppqPick([same ? 'craa5_peopleplanid' : 'craa5_pipplanid', same, cols.emp, cols.status, cols.start, cols.due, 'createdon', 'modifiedon'])
        });
    } catch (err) { return Object.assign({}, empty, { error: ppqError('The list could not be read.') }); }
