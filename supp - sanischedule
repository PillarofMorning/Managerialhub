export default function SanitationScheduleApp({ dataApi }) {
    const api = useMemo(() => makeApi(dataApi), [dataApi]);
    const isPreview = !api.canRead;

    const [lang, setLang] = useState('en');
    const t = useCallback((key) => translations[lang][key] || key, [lang]);

    const [activeTab, setActiveTab] = useState('daily');
    const [focus, setFocus] = useState(startOfDay(new Date()));
    const [calZoom, setCalZoom] = useState(100);
    const [hiddenCats, setHiddenCats] = useState([]);

    const [areas, setAreas] = useState([]);
    const [areasState, setAreasState] = useState('loading');

    const [rows, setRows] = useState([]);
    const [loadState, setLoadState] = useState({ status: 'idle', truncated: false, error: null });
    const [reloadKey, setReloadKey] = useState(0);

    const [createInitial, setCreateInitial] = useState(() => blankForm(startOfDay(new Date())));
    const [editInitial, setEditInitial] = useState(null);

    const win = useMemo(() => getWindow(focus), [focus.getFullYear(), focus.getMonth()]);

    // AREAS: small lookup table, active rows only, capped.
    useEffect(() => {
        let cancelled = false;
        (async () => {
            setAreasState('loading');
            if (isPreview) { setAreas([{ name: 'IBL4', emoji: '🧼' }, { name: 'IBL5', emoji: '🧼' }, { name: 'Breading', emoji: '🧼' }]); setAreasState('ready'); return; }
            try {
                const { rows: areaRows } = await api.query(TABLE_AREAS, { filter: 'statecode eq 0', top: 500 });
                if (cancelled) return;
                const list = areaRows
                    .map(r => ({ name: renderSafe(r.craa5_area).trim(), emoji: renderSafe(r.craa5_emojiselection) || '🧼' }))
                    .filter(a => a.name)
                    .sort((a, b) => a.name.localeCompare(b.name));
                setAreas(list);
                setAreasState(list.length ? 'ready' : 'error');
            } catch (e) {
                if (!cancelled) { setAreas([]); setAreasState('error'); }
            }
        })();
        return () => { cancelled = true; };
    }, [api, isPreview, reloadKey]);

    // EVENTS: only the visible 6-week window, filtered and paged in Dataverse.
    useEffect(() => {
        let cancelled = false;
        (async () => {
            setLoadState(s => ({ ...s, status: 'loading', error: null }));
            if (isPreview) { setRows(demoRows(focus)); setLoadState({ status: 'ready', truncated: false, error: null }); return; }
            const fromIso = win.from.toISOString(), toIso = win.to.toISOString();
            try {
                const res = await api.query(TABLE_SANI, {
                    select: SANI_SELECT,
                    filter: `statecode eq 0 and craa5_datetimestart lt ${toIso} and (craa5_datetimeend ge ${fromIso} or (craa5_datetimeend eq null and craa5_datetimestart ge ${fromIso}))`,
                    orderBy: 'craa5_datetimestart asc',
                });
                if (cancelled) return;
                setRows(res.rows);
                setLoadState({ status: 'ready', truncated: res.truncated, error: null });
            } catch (e) {
                if (!cancelled) setLoadState({ status: 'error', truncated: false, error: e?.message || String(e) });
            }
        })();
        return () => { cancelled = true; };
    }, [api, isPreview, win.from.getTime(), reloadKey]);

    const allEvents = useMemo(() => rows.map(toEvent).filter(ev => ev.start), [rows]);
    const events = useMemo(() => allEvents.filter(ev => !hiddenCats.includes(ev.category)), [allEvents, hiddenCats]);

    const reload = () => setReloadKey(k => k + 1);
    const openEdit = (ev) => setEditInitial(formFromEvent(ev));
    useEffect(() => {
        const onKey = (e) => { if (e.key === 'Escape') setEditInitial(null); };
        window.addEventListener('keydown', onKey);
        return () => window.removeEventListener('keydown', onKey);
    }, []);

    const toggleCat = (value) => setHiddenCats(prev => prev.includes(value) ? prev.filter(v => v !== value) : [...prev, value]);

    const step = (dir) => {
        if (activeTab === 'weekly') setFocus(f => addDays(f, 7 * dir));
        else if (activeTab === 'calendar' || activeTab === 'list') setFocus(f => addMonths(f, dir));
        else setFocus(f => addDays(f, dir));
    };

    const handleDrop = async (id, day) => {
        const ev = allEvents.find(x => x.id === id);
        if (!ev) return;
        const shift = startOfDay(day).getTime() - startOfDay(ev.start).getTime();
        if (!shift) return;
        const payload = { craa5_datetimestart: new Date(ev.start.getTime() + shift).toISOString() };
        if (ev.end) payload.craa5_datetimeend = new Date(ev.end.getTime() + shift).toISOString();
        try {
            if (api.canWrite) await api.update(TABLE_SANI, id, payload);
            else setRows(prev => prev.map(r => r[SANI_ID] === id ? { ...r, ...payload } : r));
            if (api.canWrite) reload();
        } catch (e) { alert(t('saveFailed') + (e?.message || e)); }
    };

    // ------------------------------------------------------------------------
    // RENDERERS
    // ------------------------------------------------------------------------
    const renderStatus = () => {
        if (loadState.status === 'loading') return <div className="sp-status"><RotateCcwIcon className="sp-icon-sm sp-spin" /> {t('loading')}</div>;
        if (loadState.status === 'error') return (
            <div className="sp-status sp-status-error">{t('loadError')} <span className="sp-muted">{loadState.error}</span>
                <button className="sp-btn sp-btn-ghost" onClick={reload}>{t('retry')}</button></div>
        );
        return (
            <div className="sp-status">
                <span>{events.length} {t('loaded')} • {fmtDate(win.from, lang)} - {fmtDate(addDays(win.to, -1), lang)}</span>
                {loadState.truncated && <span className="sp-warn">{t('truncated').replace('{n}', MAX_ROWS)}</span>}
            </div>
        );
    };

    const renderDailyView = () => {
        const dayJobs = eventsOn(events, focus);
        return (
            <div className="sp-daily">
                <div className="sp-daily-list">
                    <h3 className="sp-section-title">{t('timeline')}</h3>
                    {dayJobs.length === 0 ? <p className="sp-empty">{t('noEvents')}</p>
                        : dayJobs.map(ev => <EventCard key={ev.id} ev={ev} lang={lang} onOpen={openEdit} />)}
                </div>
                <div className="sp-daily-callouts">
                    <h3 className="sp-section-title">{t('callouts')}</h3>
                    <div className="sp-callout-grid">
                        {dayJobs.map(ev => {
                            const cat = getCategory(ev.category);
                            return (
                                <div key={`callout-${ev.id}`} className="sp-callout" onClick={() => openEdit(ev)}>
                                    <div className="sp-callout-head" style={{ background: cat.color }}>
