                                        <div className="sp-callout-time"><ClockIcon className="sp-icon-xs" /> {fmtRange(ev, lang)}</div>
                                    </div>
                                    <div className="sp-callout-body">
                                        <p className="sp-label">{t('targetArea')}</p>
                                        <p className="sp-strong">{ev.area === 'all' ? t('allAreas') : ev.area}</p>
                                        {ev.nameForPTO && (<><p className="sp-label">{t('nameForPTO')}</p><p className="sp-strong">{ev.nameForPTO}</p></>)}
                                        <p className="sp-label">{t('details')}</p>
                                        <p className="sp-pre">{ev.details || '...'}</p>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            </div>
        );
    };

    const renderWeeklyView = () => (
        <div className="sp-week">
            {weekDays(focus).map(day => {
                const isToday = sameDay(day, new Date());
                return (
                    <div key={toYMD(day)} className={`sp-week-col ${sameDay(day, focus) ? 'sp-week-focus' : ''}`}>
                        <div className="sp-week-head" onClick={() => { setFocus(startOfDay(day)); setActiveTab('daily'); }}>
                            <span className="sp-label">{t(DAY_KEYS[day.getDay()])}</span>
                            <span className={`sp-week-num ${isToday ? 'sp-today' : ''}`}>{day.getDate()}</span>
                        </div>
                        <div className="sp-week-body">
                            {eventsOn(events, day).map(ev => <EventCard key={ev.id} ev={ev} lang={lang} onOpen={openEdit} compact />)}
                        </div>
                    </div>
                );
            })}
        </div>
    );

    const renderCalendarTab = () => {
        const scale = calZoom / 100;
        const days = Array.from({ length: 42 }, (_, i) => addDays(win.from, i));
        return (
            <div className="sp-month-wrap">
                <div className="sp-month-tools">
                    <h2 className="sp-month-title">{focus.toLocaleString(lang === 'es' ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' })}</h2>
                    <div className="sp-zoom">
                        <ZoomInIcon className="sp-icon-sm" />
                        <span className="sp-label">{t('zoom')}: {calZoom}%</span>
                        <input type="range" min="40" max="100" value={calZoom} onChange={e => setCalZoom(parseInt(e.target.value, 10))} />
                    </div>
                </div>
                <div className="sp-month-scroll">
                    <div className="sp-month" style={{ transform: `scale(${scale})`, width: `${100 / scale}%` }}>
                        {DAY_KEYS.map(k => <div key={k} className="sp-month-dow">{t(k)}</div>)}
                        {days.map(day => {
                            const outside = day.getMonth() !== focus.getMonth();
                            const isToday = sameDay(day, new Date());
                            return (
                                <div key={toYMD(day)} className={`sp-month-cell ${outside ? 'sp-outside' : ''}`}
                                    onDragOver={e => e.preventDefault()}
                                    onDrop={e => handleDrop(e.dataTransfer.getData('text'), day)}>
                                    <span className={`sp-month-num ${isToday ? 'sp-today' : ''}`}
