                {inMonth.length === 0 ? <p className="sp-empty">{t('noEventsRange')}</p> : (
                    <table className="sp-table">
                        <thead><tr><th>{t('when')}</th><th>{t('title')}</th><th>{t('category')}</th><th>{t('area')}</th><th>{t('person')}</th><th>{t('details')}</th></tr></thead>
                        <tbody>
                            {inMonth.map(ev => {
                                const cat = getCategory(ev.category);
                                return (
                                    <tr key={ev.id} onClick={() => openEdit(ev)}>
                                        <td className="sp-nowrap">{fmtRange(ev, lang)}</td>
                                        <td className="sp-strong">{ev.title}</td>
                                        <td className="sp-nowrap"><CategoryDot cat={cat} /> {catLabel(cat, lang)}</td>
                                        <td>{ev.area === 'all' ? t('allAreas') : ev.area}</td>
                                        <td>{ev.nameForPTO}</td>
                                        <td className="sp-clip">{ev.details}</td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
