                            <div className="space-y-2">
                                <label className="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('procedureDetails')}</label>
                                <textarea rows={4} value={editSchData.details} onChange={e => setEditSchData(p => ({...p, details: e.target.value}))} className="w-full border-2 border-gray-100 p-4 rounded-xl font-medium bg-gray-50 focus:bg-white transition-all resize-none text-gray-700" />
                            </div>

                            {parseInt(editSchData.category) === 256000004 && (
                                <div className="space-y-2 animate-in slide-in-from-top-2">
                                    <label className="text-[10px] font-black text-gray-400 uppercase tracking-widest">{t('nameForPTO')}</label>
                                    <input type="text" placeholder={t('enterName')} value={editSchData.nameForPTO} onChange={e => setEditSchData(p => ({...p, nameForPTO: e.target.value}))} className="w-full border-2 border-gray-100 rounded-xl p-4 bg-gray-50 focus:bg-white focus:border-emerald-500 outline-none transition-all font-bold text-gray-700" />
                                </div>
                            )}

                            <div className="bg-emerald-50 p-6 rounded-[1.5rem] border-2 border-emerald-100 space-y-4">
                                <div className="flex items-center gap-3">
                                    <MessageSquareIcon className="w-4 h-4 text-emerald-600" />
                                    <label className="text-[10px] font-black text-emerald-700 uppercase tracking-widest">{t('comments')}</label>
                                </div>
                                <div className="space-y-4">
                                    <textarea placeholder={t('addFindings')} value={editSchData.comments} onChange={e => setEditSchData(p => ({...p, comments: e.target.value}))} className="w-full border-none p-4 rounded-xl font-medium bg-white shadow-sm resize-none text-gray-700" />
                                    <div className="flex items-center gap-4">
                                        <label className="text-[10px] font-black text-emerald-600 uppercase tracking-widest shrink-0">{t('signOff')}</label>
                                        <input type="text" placeholder={t('enterName')} value={editSchData.commentor} onChange={e => setEditSchData(p => ({...p, commentor: e.target.value}))} className="flex-1 bg-white border-none rounded-lg p-2 text-sm font-bold text-emerald-800 shadow-sm" />
                                    </div>
                                </div>
                            </div>

                            {!isConfirmingDelete ? (
                                <button onClick={() => setIsConfirmingDelete(true)} className="w-full text-red-500 text-[10px] font-black uppercase tracking-[0.2em] py-4 rounded-2xl hover:bg-red-50 transition-colors">{t('terminate')}</button>
                            ) : (
                                <div className="flex gap-4 animate-in slide-in-from-top-2">
                                    <button onClick={handleDelete} className="flex-1 bg-red-600 text-white font-black py-4 rounded-2xl shadow-xl uppercase text-xs tracking-widest">{t('confirmWipe')}</button>
                                    <button onClick={() => setIsConfirmingDelete(false)} className="flex-1 bg-gray-100 text-gray-500 font-black py-4 rounded-2xl uppercase text-xs tracking-widest">{t('cancel')}</button>
                                </div>
                            )}
                        </div>

                        <div className="bg-gray-50 p-8 border-t border-gray-100 flex justify-end gap-4">
                            <button onClick={() => setEditSchData(null)} className="px-8 py-3 text-xs font-black text-gray-400 uppercase tracking-widest hover:text-gray-600">{t('close')}</button>
                            <button onClick={handleUpdateRecord} className="px-10 py-3 bg-emerald-700 text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg hover:bg-emerald-800 transition-all">{t('save')}</button>
                        </div>
                    </div>
                </div>
            )}

            <style dangerouslySetInnerHTML={{__html: `
                .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
                .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
                .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
                .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
                .no-scrollbar::-webkit-scrollbar { display: none; }
                .grid { backface-visibility: hidden; }
                .flex-row { flex-direction: row !important; }
            `}} />
        </div>
    );
}
