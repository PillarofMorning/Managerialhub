    const end = ev.end || new Date(ev.start.getTime() + 8 * 3600000);
    return { id: ev.id, seriesId: ev.seriesId, title: ev.title, category: ev.category ?? DEFAULT_CATEGORY, area: ev.area,
        nameForPTO: ev.nameForPTO, startDate: toYMD(ev.start), startTime: toHM(ev.start), endDate: toYMD(end), endTime: toHM(end),
        details: ev.details, comments: ev.comments, commentor: ev.commentor, isRecurring: false, recurDays: 2 };
}

function EventForm({ initial, mode, defaultDate, api, areas, areasState, lang, t, onSaved, onCancel, onRemoved }) {
    const [f, setF] = useState(initial);
    const [busy, setBusy] = useState(false);
    const [msg, setMsg] = useState(null);
    const [confirmRemove, setConfirmRemove] = useState(false);
    // A new starting point (after a save) keeps the success message until the next edit.
    useEffect(() => { setF(initial); setConfirmRemove(false); }, [initial]);

    const set = (field, value) => { setMsg(null); setF(prev => ({ ...prev, [field]: value })); };
    const start = combine(f.startDate, f.startTime);
    const end = combine(f.endDate, f.endTime);
    const cat = getCategory(f.category);

    // Moving the start keeps the same length.
    const setStart = (field, value) => { setMsg(null); setF(prev => {
        const next = { ...prev, [field]: value };
        const oldS = combine(prev.startDate, prev.startTime), oldE = combine(prev.endDate, prev.endTime);
        const newS = combine(next.startDate, next.startTime);
        if (oldS && oldE && newS && oldE > oldS) {
            const newE = new Date(newS.getTime() + (oldE - oldS));
            next.endDate = toYMD(newE); next.endTime = toHM(newE);
        }
        return next;
    }); };
    // Scheduler tab: follow the Focus Point date without clearing what was typed.
    useEffect(() => {
        if (mode === 'create' && defaultDate) setF(prev => {
            if (prev.startDate === defaultDate) return prev;
            const oldS = combine(prev.startDate, prev.startTime), oldE = combine(prev.endDate, prev.endTime);
            const newS = combine(defaultDate, prev.startTime);
            const next = { ...prev, startDate: defaultDate, endDate: defaultDate };
            if (oldS && oldE && newS && oldE > oldS) {
                const newE = new Date(newS.getTime() + (oldE - oldS));
                next.endDate = toYMD(newE); next.endTime = toHM(newE);
            }
            return next;
        });
    }, [defaultDate, mode]);
    const setLength = (hours) => {
        if (!start) return;
        const e = new Date(start.getTime() + hours * 3600000);
        setMsg(null);
        setF(prev => ({ ...prev, endDate: toYMD(e), endTime: toHM(e) }));
    };

    const payloadFor = (s, e, seriesId) => ({
        craa5_title: f.title.trim(),
        craa5_category: toChoice(f.category),
        craa5_areaaffected: f.area,
        craa5_datetimestart: s.toISOString(),
        craa5_datetimeend: e.toISOString(),
        craa5_details: f.details,
        craa5_comments: f.comments,
        craa5_nameofcommentor: f.commentor,
        craa5_nameforpto: cat.isPTO ? f.nameForPTO.trim() : '',
        ...(SERIES_FIELD && seriesId ? { [SERIES_FIELD]: seriesId } : {}),
    });

    const submit = async (scope) => {
        if (!f.title.trim() || !f.area || !start) { setMsg({ type: 'error', text: t('required') }); return; }
        if (!end || end <= start) { setMsg({ type: 'error', text: t('endBeforeStart') }); return; }
        setBusy(true); setMsg(null);
        try {
            if (mode === 'create') {
                const days = f.isRecurring ? Math.max(1, Math.min(31, parseInt(f.recurDays, 10) || 1)) : 1;
                const seriesId = days > 1 ? newSeriesId() : '';
                const ops = [];
                for (let i = 0; i < days; i++) {
                    const s = new Date(start.getTime() + i * DAY_MS), e = new Date(end.getTime() + i * DAY_MS);
                    if (api.canWrite) ops.push(api.create(TABLE_SANI, payloadFor(s, e, seriesId)));
                }
                await Promise.all(ops);
            } else if (scope === 'series' && SERIES_FIELD && f.seriesId) {
                // Same text and category for the whole series; each copy keeps its own dates.
                const { rows } = await api.query(TABLE_SANI, { select: [SANI_ID], filter: `statecode eq 0 and ${SERIES_FIELD} eq '${odataString(f.seriesId)}'` });
                const shared = payloadFor(start, end, f.seriesId);
                delete shared.craa5_datetimestart; delete shared.craa5_datetimeend;
                await Promise.all(rows.map(r => api.update(TABLE_SANI, r[SANI_ID], shared)));
                if (api.canWrite) await api.update(TABLE_SANI, f.id, payloadFor(start, end, f.seriesId));
            } else if (api.canWrite) {
                await api.update(TABLE_SANI, f.id, payloadFor(start, end, f.seriesId));
            }
            setBusy(false);
            if (mode === 'create') setMsg({ type: 'success', text: t('successMsg') });
            onSaved();
        } catch (e) {
            setBusy(false);
            setMsg({ type: 'error', text: t('saveFailed') + (e?.message || e) });
        }
    };

    const remove = async (scope) => {
        setBusy(true);
        try {
            if (scope === 'series' && SERIES_FIELD && f.seriesId) {
                const { rows } = await api.query(TABLE_SANI, { select: [SANI_ID], filter: `statecode eq 0 and ${SERIES_FIELD} eq '${odataString(f.seriesId)}'` });
                await Promise.all(rows.map(r => api.deactivate(TABLE_SANI, r[SANI_ID])));
            } else if (api.canWrite) {
                await api.deactivate(TABLE_SANI, f.id);
            }
            setBusy(false);
            onRemoved();
        } catch (e) {
            setBusy(false);
            setMsg({ type: 'error', text: t('removeFailed') + (e?.message || e) });
        }
    };

    const hasSeries = mode === 'edit' && SERIES_FIELD && f.seriesId;

    return (
        <div className="sp-form">
            <div className="sp-grid-2">
                <label className="sp-field">
                    <span className="sp-label">{t('targetArea')}</span>
                    <select className="sp-input" value={f.area} onChange={e => set('area', e.target.value)} disabled={areasState === 'loading'}>
                        <option value="">{areasState === 'loading' ? t('areasLoading') : t('selectArea')}</option>
                        <option value="all">🏢 {t('allAreas')}</option>
                        {areas.map(a => <option key={a.name} value={a.name}>{a.emoji} {a.name}</option>)}
                        {f.area && f.area !== 'all' && !areas.some(a => a.name === f.area) && <option value={f.area}>{f.area}</option>}
                    </select>
                    {areasState === 'error' && <span className="sp-hint sp-hint-error">{t('areasError')}</span>}
                </label>
                <label className="sp-field">
                    <span className="sp-label">{t('jobCategory')}</span>
                    <select className="sp-input" value={f.category ?? ''} onChange={e => set('category', toChoice(e.target.value))}>
                        {CATEGORIES.map(c => <option key={c.value} value={c.value}>{catLabel(c, lang)}</option>)}
                    </select>
                </label>
            </div>

            <label className="sp-field">
                <span className="sp-label">{t('taskTitle')}</span>
                <input className="sp-input" type="text" value={f.title} onChange={e => set('title', e.target.value)} placeholder="..." />
            </label>

            {cat.isPTO && (
                <label className="sp-field">
                    <span className="sp-label">{t('nameForPTO')}</span>
                    <EmployeeSearch api={api} value={f.nameForPTO} onChange={v => set('nameForPTO', v)} t={t} />
                </label>
            )}

            <div className="sp-grid-4">
                <label className="sp-field"><span className="sp-label">{t('start')}</span>
                    <input className="sp-input" type="date" value={f.startDate} onChange={e => setStart('startDate', e.target.value)} /></label>
                <label className="sp-field"><span className="sp-label">&nbsp;</span>
                    <input className="sp-input" type="time" value={f.startTime} onChange={e => setStart('startTime', e.target.value)} /></label>
                <label className="sp-field"><span className="sp-label">{t('end')}</span>
                    <input className="sp-input" type="date" value={f.endDate} onChange={e => set('endDate', e.target.value)} /></label>
                <label className="sp-field"><span className="sp-label">&nbsp;</span>
                    <input className="sp-input" type="time" value={f.endTime} onChange={e => set('endTime', e.target.value)} /></label>
            </div>
            <div className="sp-length-row">
                <span className="sp-label">{t('duration')}: <b className="sp-duration">{fmtDuration(start, end)}</b></span>
                <span className="sp-label">{t('quickLength')}:</span>
                {[4, 8, 12, 24].map(h => <button key={h} type="button" className="sp-chip" onClick={() => setLength(h)}>{h}h</button>)}
            </div>

            <label className="sp-field">
                <span className="sp-label">{t('taskDetails')}</span>
                <textarea className="sp-input" rows={4} value={f.details} onChange={e => set('details', e.target.value)} />
            </label>

            <div className="sp-comments">
                <div className="sp-comments-head"><MessageSquareIcon className="sp-icon-sm" /><span className="sp-label">{t('comments')}</span></div>
                <textarea className="sp-input" rows={3} placeholder={t('addFindings')} value={f.comments} onChange={e => set('comments', e.target.value)} />
                <div className="sp-signoff">
                    <span className="sp-label">{t('signOff')}</span>
                    <input className="sp-input" type="text" placeholder={t('enterName')} value={f.commentor} onChange={e => set('commentor', e.target.value)} />
                </div>
            </div>

            {mode === 'create' && (
                <div className="sp-recur">
                    <label className="sp-check">
                        <input type="checkbox" checked={f.isRecurring} onChange={e => set('isRecurring', e.target.checked)} />
                        <span>{t('recurrence')}</span>
                    </label>
                    {f.isRecurring && (
                        <span className="sp-recur-days">
                            {t('forDays')} <input className="sp-input sp-input-num" type="number" min="1" max="31" value={f.recurDays} onChange={e => set('recurDays', e.target.value)} /> {t('daysLabel')}
                        </span>
                    )}
                </div>
            )}

            {msg && <div className={`sp-msg sp-msg-${msg.type}`}>{msg.text}</div>}

            <div className="sp-actions">
                {mode === 'edit' && !confirmRemove && <button type="button" className="sp-btn sp-btn-ghost-danger" onClick={() => setConfirmRemove(true)} disabled={busy}>{t('remove')}</button>}
                {mode === 'edit' && confirmRemove && (
                    <span className="sp-actions-left">
                        <button type="button" className="sp-btn sp-btn-danger" onClick={() => remove('one')} disabled={busy}>{hasSeries ? t('thisEvent') : t('confirmRemove')}</button>
                        {hasSeries && <button type="button" className="sp-btn sp-btn-danger" onClick={() => remove('series')} disabled={busy}>{t('wholeSeries')}</button>}
                        <button type="button" className="sp-btn sp-btn-ghost" onClick={() => setConfirmRemove(false)} disabled={busy}>{t('cancel')}</button>
                    </span>
                )}
                <span className="sp-spacer" />
                {onCancel && <button type="button" className="sp-btn sp-btn-ghost" onClick={onCancel} disabled={busy}>{mode === 'edit' ? t('close') : t('cancel')}</button>}
                {hasSeries && <button type="button" className="sp-btn sp-btn-secondary" onClick={() => submit('series')} disabled={busy}>{t('wholeSeries')}</button>}
                <button type="button" className="sp-btn sp-btn-primary" onClick={() => submit('one')} disabled={busy}>
                    {busy ? t('saving') : (mode === 'create' ? t('commit') : (hasSeries ? t('thisEvent') : t('save')))}
                </button>
            </div>
        </div>
    );
}

