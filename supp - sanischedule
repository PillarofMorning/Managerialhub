// Raw Dataverse row -> one clean event object used by every view.
function toEvent(r) {
    const start = r.craa5_datetimestart ? new Date(r.craa5_datetimestart) : null;
    const end = r.craa5_datetimeend ? new Date(r.craa5_datetimeend) : null;
    const validEnd = start && end && end > start ? end : null;
    return {
        id: r[SANI_ID] || r.id,
        title: renderSafe(r.craa5_title),
        category: toChoice(r.craa5_category),
        area: renderSafe(r.craa5_areaaffected),
        start,
        end: validEnd,
        endExclusive: validEnd ? validEnd.getTime() : (start ? start.getTime() + 1 : 0),
        details: renderSafe(r.craa5_details),
        comments: renderSafe(r.craa5_comments),
        commentor: renderSafe(r.craa5_nameofcommentor),
        nameForPTO: renderSafe(r.craa5_nameforpto),
        seriesId: SERIES_FIELD ? renderSafe(r[SERIES_FIELD]) : '',
    };
}

