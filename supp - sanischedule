function EmployeeSearch({ api, value, onChange, t }) {
    const [results, setResults] = useState([]);
    const [open, setOpen] = useState(false);
    const [searched, setSearched] = useState(false);
    const timer = useRef(null);

    const search = (text) => {
        onChange(text);
        clearTimeout(timer.current);
        if (!api.canRead || text.trim().length < 2) { setResults([]); setSearched(false); return; }
        timer.current = setTimeout(async () => {
            try {
                const { rows } = await api.query(TABLE_EMPLOYEES, {
                    select: ['craa5_name'],
                    // Blank shift = no longer with the company (deactivating doesn't hide them).
                    filter: `statecode eq 0 and craa5_shift ne null and contains(craa5_name,'${odataString(text.trim())}')`,
                    orderBy: 'craa5_name asc',
                    top: 8,
                });
                setResults(rows.map(r => renderSafe(r.craa5_name)).filter(Boolean));
            } catch (e) { setResults([]); }
            setSearched(true);
            setOpen(true);
        }, 300);
    };
    useEffect(() => () => clearTimeout(timer.current), []);

    return (
        <div className="sp-typeahead">
            <input className="sp-input" type="text" placeholder={t('searchEmployee')} value={value}
                onChange={e => search(e.target.value)} onFocus={() => setOpen(true)} onBlur={() => setTimeout(() => setOpen(false), 150)} />
            {open && searched && (
                <div className="sp-typeahead-menu">
                    {results.length === 0
                        ? <div className="sp-typeahead-empty">{t('noMatches')}</div>
                        : results.map(name => (
                            <div key={name} className="sp-typeahead-item" onMouseDown={() => { onChange(name); setOpen(false); }}>{name}</div>
                        ))}
                </div>
            )}
        </div>
    );
}

