// ============================================================================
export default function SanitationScheduleApp({ dataApi }) {
    const TABLE_SANI = "craa5__sani_schedule_";
    const TABLE_AREAS = "craa5_aa_mss_area";

    const [lang, setLang] = useState('en');
    const [isLoadingAreas, setIsLoadingAreas] = useState(true);
    const [isLoadingSchedules, setIsLoadingSchedules] = useState(false);
    const [hasFetchedSchedules, setHasFetchedSchedules] = useState(false);

    const [activeTab, setActiveTab] = useState("daily");
    const [selectedDate, setSelectedDate] = useState(getLocalYMD(new Date()));
    const [calendarMonth, setCalendarMonth] = useState(new Date(new Date().getFullYear(), new Date().getMonth(), 1));
    const [calZoom, setCalZoom] = useState(100);

    const [areas, setAreas] = useState([]);
    const [schedules, setSchedules] = useState([]);

    const t = (key) => translations[lang][key] || key;
    const currentCategories = CATEGORIES_DICT[lang];

    // FORM STATE
    const [schPayload, setSchPayload] = useState({
        area: "",
        title: "",
        details: "",
        category: 256000000,
        startDate: selectedDate,
        startTime: "06:00",
        endDate: selectedDate,
        endTime: "14:00",
        runLength: "8",
        isRecurring: false,
        recurDays: 1,
        comments: "",
        commentor: "",
        nameForPTO: ""
    });

    const [isSubmitting, setIsSubmitting] = useState(false);
    const [submitStatus, setSubmitStatus] = useState(null);
    const [editSchData, setEditSchData] = useState(null);
    const [isConfirmingDelete, setIsConfirmingDelete] = useState(false);

    // TAILWIND INJECTION & AREA HYDRATION
    useEffect(() => {
        if (typeof document !== 'undefined' && !document.getElementById('tailwind-cdn')) {
            const script = document.createElement('script');
            script.id = 'tailwind-cdn';
            script.src = 'https://cdn.tailwindcss.com';
            document.head.appendChild(script);
        }

        const loadAreas = async () => {
            setIsLoadingAreas(true);
            try {
                const areaRecords = await fetchAllActiveRecords(TABLE_AREAS, dataApi);
                const processedAreas = [
                    { name: "all", emoji: "🏢", raw: "all" },
                    ...areaRecords.map(item => ({
                        name: renderSafe(item.craa5_area || item.craa5_AREA || item.craa5_Area || "Unnamed Area"),
                        emoji: renderSafe(item.craa5_emojiselection || "🧼"),
                        raw: renderSafe(item.craa5_area || item.craa5_AREA || item.craa5_Area)
                    }))
                ];
                if (processedAreas.length <= 1) {
                    setAreas([
                        { name: 'all', emoji: "🏢", raw: "all" },
                        { name: 'Breading Room', emoji: "🥖", raw: "Breading Room" },
                        { name: 'Fryer Line 1', emoji: "🔥", raw: "Fryer Line 1" },
                        { name: 'Packaging A', emoji: "📦", raw: "Packaging A" }
                    ]);
                } else {
                    setAreas(processedAreas);
                }
            } catch (err) { console.error("Area Load Error", err); }
            finally { setIsLoadingAreas(false); }
        };
        loadAreas();
    }, [dataApi]);

    // FETCH SCHEDULES LOGIC
    const loadSchedules = async () => {
        setIsLoadingSchedules(true);
        try {
            const schList = await fetchAllActiveRecords(TABLE_SANI, dataApi);
            const normalized = schList.map(r => ({
                ...r,
                id: r.craa5__sani_schedule_id || r.id,
                craa5_Areaaffected: r.craa5_areaaffected || r.craa5_Areaaffected,
                craa5_Datetimestart: r.craa5_datetimestart || r.craa5_Datetimestart,
                craa5_Details: r.craa5_details || r.craa5_Details,
                craa5_Comments: r.craa5_comments || r.craa5_Comments,
                craa5_NameforPTO: r.craa5_nameforpto || r.craa5_NameforPTO
            }));
            setSchedules(normalized);
            setHasFetchedSchedules(true);
        } catch (err) {
            console.error("Schedule Load Error", err);
        } finally {
            setIsLoadingSchedules(false);
        }
    };

    // HYDRATION: TRIGGER ON TAB ACTIVATION
    useEffect(() => {
        const dataTabs = ['daily', 'weekly', 'calendar'];
        if (dataTabs.includes(activeTab) && !hasFetchedSchedules) {
            loadSchedules();
        }
    }, [activeTab, hasFetchedSchedules]);

    // HANDLERS
    const updateScheduleTime = (field, value) => {
        const next = { ...schPayload, [field]: value };
        if (['startDate', 'startTime', 'runLength'].includes(field)) {
            const sd = new Date(`${next.startDate}T${next.startTime}:00`);
            if (!isNaN(sd.getTime()) && next.runLength) {
                const ed = new Date(sd.getTime() + (parseFloat(next.runLength) * 3600000));
                next.endDate = getLocalYMD(ed);
                next.endTime = ed.toTimeString().substring(0, 5);
            }
        }
        setSchPayload(next);
    };

    const handleCreateSchedule = async () => {
        if (!schPayload.area || !schPayload.title || !schPayload.startDate) {
            setSubmitStatus({ type: 'error', message: lang === 'en' ? 'Area, Title, and Date are required.' : 'El Área, Título y Fecha son requeridos.' });
            return;
        }
        setIsSubmitting(true);
        const writeApi = dataApi?.createRecord ? dataApi : safeGetXrm()?.WebApi;

        try {
            let ops = [];
            const baseStart = new Date(`${schPayload.startDate}T${schPayload.startTime}:00`);
            const durationMs = (parseFloat(schPayload.runLength) * 3600000);

            const buildPayload = (sTime, eTime) => ({
                craa5_areaaffected: schPayload.area,
                craa5_title: schPayload.title,
                craa5_details: schPayload.details,
                craa5_category: parseInt(schPayload.category),
                craa5_datetimestart: sTime.toISOString(),
                craa5_datetimeend: eTime.toISOString(),
                craa5_comments: schPayload.comments,
                craa5_nameofcommentor: schPayload.commentor,
                craa5_nameforpto: schPayload.nameForPTO
            });

            if (schPayload.isRecurring) {
                const days = parseInt(schPayload.recurDays, 10) || 1;
                for (let i = 0; i < days; i++) {
                    const s = new Date(baseStart.getTime() + (i * 86400000));
                    const e = new Date(s.getTime() + durationMs);
                    ops.push(writeApi ? writeApi.createRecord(TABLE_SANI, buildPayload(s, e)) : Promise.resolve({ id: `mock-${Math.random()}`, ...buildPayload(s,e) }));
                }
            } else {
                const e = new Date(baseStart.getTime() + durationMs);
                ops.push(writeApi ? writeApi.createRecord(TABLE_SANI, buildPayload(baseStart, e)) : Promise.resolve({ id: `mock-${Math.random()}`, ...buildPayload(baseStart, e) }));
            }

            await Promise.all(ops);
            await loadSchedules();

            setSubmitStatus({ type: 'success', message: t('successMsg') });
            setTimeout(() => setSubmitStatus(null), 3000);
        } catch (e) { setSubmitStatus({ type: 'error', message: e.message }); }
        finally { setIsSubmitting(false); }
    };

    const handleUpdateRecord = async () => {
        if (!editSchData) return;
        const writeApi = dataApi?.updateRecord ? dataApi : safeGetXrm()?.WebApi;
        try {
            // CRITICAL FIX: All lowercase logical names to ensure Dataverse mapping success
            const payload = {
                craa5_title: editSchData.title,
                craa5_details: editSchData.details,
                craa5_comments: editSchData.comments,
                craa5_nameofcommentor: editSchData.commentor,
                craa5_category: parseInt(editSchData.category),
                craa5_nameforpto: editSchData.nameForPTO
            };

            // 1. Persist to Dataverse
            if (writeApi) {
                await writeApi.updateRecord(TABLE_SANI, editSchData.id, payload);
            }

            // 2. Immediate Local State Patch (Ensures zero-latency UI update for the "UID" associated)
            setSchedules(prev => prev.map(s => (s.craa5__sani_schedule_id || s.id) === editSchData.id ? {
                ...s,
                ...payload,
                craa5_Details: payload.craa5_details,
                craa5_Comments: payload.craa5_comments,
                craa5_NameforPTO: payload.craa5_nameforpto
            } : s));

            // 3. Background Sync to ensure all tab data matches exactly
            await loadSchedules();

            setEditSchData(null);
        } catch (e) { alert("Update failed: " + e.message); }
    };

    const handleDelete = async () => {
        if (!editSchData) return;
        const writeApi = dataApi?.deleteRecord ? dataApi : safeGetXrm()?.WebApi;
        try {
            if (writeApi) await writeApi.deleteRecord(TABLE_SANI, editSchData.id);
            setSchedules(prev => prev.filter(s => (s.craa5__sani_schedule_id || s.id) !== editSchData.id));
            setEditSchData(null);
        } catch (e) { alert("Delete failed: " + e.message); }
    };

    const handleDragDrop = async (schId, targetDateObj) => {
        const sch = schedules.find(s => (s.craa5__sani_schedule_id || s.id) === schId);
        if (!sch) return;
        const oldStart = new Date(sch.craa5_datetimestart || sch.craa5_Datetimestart || sch.createdon);
        const oldEnd = new Date(sch.craa5_datetimeend || sch.modifiedon);
        const diff = new Date(targetDateObj.getFullYear(), targetDateObj.getMonth(), targetDateObj.getDate()).getTime() - new Date(oldStart.getFullYear(), oldStart.getMonth(), oldStart.getDate()).getTime();

        const sTime = new Date(oldStart.getTime() + diff).toISOString();
        const eTime = new Date(oldEnd.getTime() + diff).toISOString();

        const writeApi = dataApi?.updateRecord ? dataApi : safeGetXrm()?.WebApi;
        try {
            if (writeApi) await writeApi.updateRecord(TABLE_SANI, schId, { craa5_datetimestart: sTime, craa5_datetimeend: eTime });
            await loadSchedules();
        } catch (e) { console.error(e); }
    };

    const getCalendarDays = () => {
        const year = calendarMonth.getFullYear();
        const month = calendarMonth.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push(null);
        for (let i = 1; i <= daysInMonth; i++) days.push(i);
        return days;
    };

    const getWeeklyDays = () => {
        const start = new Date(selectedDate + "T00:00:00");
        const day = start.getDay();
        const first = start.getDate() - day;
        return Array.from({length: 7}, (_, i) => {
            const d = new Date(start);
            d.setDate(first + i);
            return d;
        });
    };

    const openEdit = (job) => {
        setEditSchData({
            id: job.craa5__sani_schedule_id || job.id,
            title: renderSafe(job.craa5_title),
            details: renderSafe(job.craa5_details || job.craa5_Details),
            area: renderSafe(job.craa5_areaaffected || job.craa5_Areaaffected),
            category: job.craa5_category || 256000000,
            comments: renderSafe(job.craa5_comments || job.craa5_Comments),
            commentor: renderSafe(job.craa5_nameofcommentor || job.craa5_Nameofcommentor),
            nameForPTO: renderSafe(job.craa5_nameforpto || job.craa5_NameforPTO),
            start: job.craa5_datetimestart || job.craa5_Datetimestart,
            end: job.craa5_datetimeend
        });
        setIsConfirmingDelete(false);
    };

    const cycleMonth = (offset) => setCalendarMonth(new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + offset, 1));

    // ============================================================================
    // RENDERERS
    // ============================================================================

    const renderDailyView = () => {
        if (isLoadingSchedules) return (
            <div className="h-full w-full flex flex-col items-center justify-center p-12">
                <RotateCcwIcon className="w-10 h-10 text-emerald-600 animate-spin mb-4" />
                <p className="font-black text-emerald-800 uppercase tracking-widest text-xs">{t('syncingDaily')}</p>
            </div>
        );

        const dayJobs = schedules.filter(s => isDateInRange(selectedDate, s.craa5_datetimestart || s.craa5_Datetimestart, s.craa5_datetimeend || s.craa5_datetimeend)).sort((a,b) => new Date(a.craa5_datetimestart || a.craa5_Datetimestart) - new Date(b.craa5_datetimestart || b.craa5_Datetimestart));

        return (
            <div className="flex flex-col lg:flex-row gap-6 h-full animate-in fade-in duration-500 overflow-hidden" style={{ display: 'flex', flexDirection: 'row' }}>
                <div className="lg:w-1/3 flex flex-col gap-4 overflow-y-auto pr-2 custom-scrollbar">
                    <h3 className="text-sm font-black text-emerald-600 uppercase tracking-widest border-b border-emerald-100 pb-2">{t('timeline')}</h3>
                    {dayJobs.length === 0 ? (
                        <div className="py-12 px-4 text-center">
                            <p className="text-gray-400 italic text-sm">{t('noJobsFound')}</p>
                        </div>
                    ) : dayJobs.map(job => (
                        <div key={job.id || Math.random()} onClick={() => openEdit(job)} className="bg-white p-4 rounded-xl border border-gray-100 shadow-sm hover:border-emerald-300 transition-all cursor-pointer group">
