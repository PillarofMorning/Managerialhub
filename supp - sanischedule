                <p>{t('configProcedures')}</p>
            </div>
            <EventForm mode="create" initial={createInitial} defaultDate={toYMD(focus)} api={api} areas={areas} areasState={areasState} lang={lang} t={t}
                onSaved={() => { setCreateInitial(blankForm(focus)); reload(); }} />
        </div>
    );

    const tabs = [
        { id: 'daily', label: t('daily'), icon: ClockIcon },
        { id: 'weekly', label: t('weekly'), icon: AlignLeftIcon },
        { id: 'calendar', label: t('calendar'), icon: CalendarIcon },
        { id: 'list', label: t('list'), icon: ListIcon },
        { id: 'form', label: t('form'), icon: ClipboardListIcon },
    ];
    const showsData = activeTab !== 'form';

    return (
        <div className="sp-app">
            <style dangerouslySetInnerHTML={{ __html: STYLES }} />
            <aside className="sp-side">
                <div className="sp-brand">SANI-PLAN<span>.</span></div>
                <div className="sp-side-block">
                    <label className="sp-focus">
                        <span className="sp-label">{t('focusPoint')}</span>
                        <input className="sp-input" type="date" value={toYMD(focus)} onChange={e => e.target.value && setFocus(fromYMD(e.target.value))} />
                    </label>
                    <button className="sp-lang" onClick={() => setLang(lang === 'en' ? 'es' : 'en')}>
                        {lang === 'en' ? '🇺🇸 EN | Traducir' : '🇲🇽 ES | Translate'}
                    </button>
                </div>
                <nav className="sp-nav">
                    {tabs.map(tab => (
                        <button key={tab.id} className={`sp-nav-btn ${activeTab === tab.id ? 'sp-nav-active' : ''}`} onClick={() => setActiveTab(tab.id)}>
                            <tab.icon className="sp-icon" /><span>{tab.label}</span>
                        </button>
                    ))}
                </nav>
            </aside>

            <main className="sp-main">
                <header className="sp-header">
                    <div className="sp-header-left">
                        <h1>{tabs.find(x => x.id === activeTab)?.label}</h1>
                        <span className="sp-muted">{new Date().toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</span>
                    </div>
                    <BrandLogo />
                </header>

                {isPreview && <div className="sp-preview">{t('previewMode')}</div>}

                {showsData && (
                    <div className="sp-toolbar">
                        <div className="sp-nav-date">
                            <button className="sp-btn sp-btn-ghost" onClick={() => step(-1)}>{'<'}</button>
                            <button className="sp-btn sp-btn-secondary" onClick={() => setFocus(startOfDay(new Date()))}>{t('today')}</button>
                            <button className="sp-btn sp-btn-ghost" onClick={() => step(1)}>{'>'}</button>
                            <span className="sp-strong">{fmtDate(focus, lang, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}</span>
                        </div>
                        <div className="sp-chips">
                            <button className={`sp-chip ${hiddenCats.length === 0 ? 'sp-chip-on' : ''}`} onClick={() => setHiddenCats([])}>{t('allCategories')}</button>
                            {CATEGORIES.map(c => {
                                const on = !hiddenCats.includes(c.value);
                                return (
                                    <button key={c.value} className={`sp-chip ${on ? 'sp-chip-on' : ''}`} onClick={() => toggleCat(c.value)}
                                        style={on ? { borderColor: c.color, color: c.color } : undefined}>
                                        <CategoryDot cat={c} /> {catLabel(c, lang)}
                                    </button>
                                );
                            })}
                        </div>
                        <button className="sp-btn sp-btn-ghost" onClick={reload}><RotateCcwIcon className="sp-icon-sm" /> {t('refresh')}</button>
                    </div>
                )}
                {showsData && renderStatus()}

                <div className="sp-content">
                    {activeTab === 'daily' && renderDailyView()}
                    {activeTab === 'weekly' && renderWeeklyView()}
                    {activeTab === 'calendar' && renderCalendarTab()}
                    {activeTab === 'list' && renderListView()}
                    {activeTab === 'form' && renderScheduler()}
                </div>
            </main>

            {editInitial && (
                <div className="sp-modal-back" onMouseDown={e => { if (e.target === e.currentTarget) setEditInitial(null); }}>
                    <div className="sp-modal">
                        <div className="sp-modal-head" style={{ background: getCategory(editInitial.category).color }}>
                            <div>
                                <p className="sp-modal-kicker">{t('editEvent')}</p>
                                <h3>{editInitial.title || '-'}</h3>
                            </div>
                            <button className="sp-icon-btn" onClick={() => setEditInitial(null)} aria-label={t('close')}><XIcon className="sp-icon" /></button>
                        </div>
                        <div className="sp-modal-body">
                            <EventForm mode="edit" initial={editInitial} api={api} areas={areas} areasState={areasState} lang={lang} t={t}
                                onSaved={() => { setEditInitial(null); reload(); }}
                                onRemoved={() => { setEditInitial(null); reload(); }}
                                onCancel={() => setEditInitial(null)} />
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}

