// ============================================================================
// DATE HELPERS (all display in local time; Dataverse stores UTC)
// ============================================================================
const DAY_MS = 86400000;

function startOfDay(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
function addDays(d, n) { const x = new Date(d); x.setDate(x.getDate() + n); return x; }
function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth() + n, Math.min(d.getDate(), 28)); }
function sameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }

function toYMD(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
function toHM(d) { return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`; }
function fromYMD(ymd) { const [y, m, d] = ymd.split('-').map(Number); return new Date(y, m - 1, d); }
function combine(ymd, hm) {
    if (!ymd) return null;
    const d = new Date(`${ymd}T${hm || '00:00'}:00`);
    return isNaN(d.getTime()) ? null : d;
}

// 6-week grid around the focus month. The focus week is always inside it, so
// Day, Week, Month and List all read from the same loaded window.
function getWindow(focus) {
    const first = new Date(focus.getFullYear(), focus.getMonth(), 1);
    const from = addDays(first, -first.getDay());
    return { from, to: addDays(from, 42) };
}

function weekDays(focus) {
    const sun = addDays(startOfDay(focus), -focus.getDay());
    return Array.from({ length: 7 }, (_, i) => addDays(sun, i));
}

// Overlap test with an exclusive end, so an event ending at 00:00 does not
// spill onto the next day (V8 bug).
function eventsOn(events, day) {
    const dayStart = startOfDay(day).getTime();
    const dayEnd = dayStart + DAY_MS;
    return events.filter(ev => ev.start && ev.start.getTime() < dayEnd && ev.endExclusive > dayStart);
}

function fmtTime(d, lang) {
    return d ? d.toLocaleTimeString(lang === 'es' ? 'es-MX' : 'en-US', { hour: '2-digit', minute: '2-digit' }) : '';
}
function fmtDate(d, lang, opts) {
    return d ? d.toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-US', opts || { month: 'short', day: 'numeric' }) : '';
}
function fmtRange(ev, lang) {
    if (!ev.start) return '';
    if (!ev.end) return `${fmtDate(ev.start, lang)} ${fmtTime(ev.start, lang)}`;
    if (sameDay(ev.start, ev.end)) return `${fmtDate(ev.start, lang)} ${fmtTime(ev.start, lang)} - ${fmtTime(ev.end, lang)}`;
    return `${fmtDate(ev.start, lang)} ${fmtTime(ev.start, lang)} - ${fmtDate(ev.end, lang)} ${fmtTime(ev.end, lang)}`;
}
function fmtDuration(start, end) {
    if (!start || !end || end <= start) return '-';
    const mins = Math.round((end - start) / 60000);
    const d = Math.floor(mins / 1440), h = Math.floor((mins % 1440) / 60), m = mins % 60;
    return [d ? `${d}d` : '', h ? `${h}h` : '', m ? `${m}m` : ''].filter(Boolean).join(' ') || '0m';
}

// ============================================================================
// DATA HELPERS
// ============================================================================
function renderSafe(val) {
    if (val === null || val === undefined) return "";
    if (typeof val === 'object') return String(val.Label || val.Value || val.name || JSON.stringify(val));
    return String(val);
}
function toChoice(val) {
    if (val === null || val === undefined || val === '') return null;
    const n = parseInt(typeof val === 'object' ? val.Value : val, 10);
    return isNaN(n) ? null : n;
}
function getCategory(value) { return CATEGORIES.find(c => c.value === toChoice(value)) || UNKNOWN_CATEGORY; }
function catLabel(cat, lang) { return lang === 'es' ? cat.es : cat.en; }
function odataString(s) { return String(s).replace(/'/g, "''"); }

function safeGetXrm() {
    if (typeof window === 'undefined') return null;
    if (window.Xrm) return window.Xrm;
    try { if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm; } catch (e) {}
    try { if (window.top && window.top !== window && window.top.Xrm) return window.top.Xrm; } catch (e) {}
    return null;
}

// One adapter for reads and writes. Reads: Xrm.WebApi first, then dataApi.queryTable
// (same order as V8). Writes: dataApi.*Record, then Xrm.WebApi, then dataApi.*Row.
function makeApi(dataApi) {
    const web = safeGetXrm()?.WebApi || null;
    const canRead = !!(web || dataApi?.queryTable);
    const writer = (dataApi?.createRecord && dataApi) || web || (dataApi?.createRow && {
        createRecord: (t, p) => dataApi.createRow(t, p),
        updateRecord: (t, id, p) => dataApi.updateRow(t, id, p),
    }) || null;

    return {
        canRead,
        canWrite: !!writer,
        // Paged, filtered read. Stops at maxRows and reports truncation.
        async query(entity, { select, filter, orderBy, top, maxRows = MAX_ROWS }) {
            const rows = [];
            if (web) {
                const parts = [];
                if (select) parts.push(`$select=${select.join(',')}`);
                if (filter) parts.push(`$filter=${filter}`);
                if (orderBy) parts.push(`$orderby=${orderBy}`);
                if (top) parts.push(`$top=${top}`);
                let res = await web.retrieveMultipleRecords(entity, '?' + parts.join('&'), top ? undefined : PAGE_SIZE);
                rows.push(...(res?.entities || []));
                while (res?.nextLink && rows.length < maxRows) {
                    res = await web.retrieveMultipleRecords(entity, '?' + res.nextLink.split('?')[1], PAGE_SIZE);
                    rows.push(...(res?.entities || []));
                }
                return { rows: rows.slice(0, maxRows), truncated: !!res?.nextLink || rows.length > maxRows };
            }
            if (dataApi?.queryTable) {
                let res = await dataApi.queryTable(entity, { select, filter, orderBy, pageSize: top || PAGE_SIZE });
                rows.push(...(res?.rows || []));
                while (!top && res?.hasMoreRows && typeof res.loadMoreRows === 'function' && rows.length < maxRows) {
                    res = await res.loadMoreRows();
                    rows.push(...(res?.rows || []));
                }
                return { rows: rows.slice(0, maxRows), truncated: !top && (!!res?.hasMoreRows || rows.length > maxRows) };
            }
            return { rows: [], truncated: false };
        },
        create(entity, payload) { return writer.createRecord(entity, payload); },
        update(entity, id, payload) { return writer.updateRecord(entity, id, payload); },
        // Remove = deactivate, so a mistake can be undone in Dataverse.
        deactivate(entity, id) { return writer.updateRecord(entity, id, { statecode: 1, statuscode: 2 }); },
    };
}

const SANI_SELECT = [SANI_ID, 'craa5_title', 'craa5_category', 'craa5_areaaffected', 'craa5_datetimestart', 'craa5_datetimeend',
