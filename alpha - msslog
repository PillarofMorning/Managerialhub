// --- HELPERS ---
const getProp = (obj, targetKey) => {
  if (!obj || !targetKey) return null;
  const lowerTarget = targetKey.toLowerCase();
  const formattedKey = `${targetKey}@OData.Community.Display.V1.FormattedValue`;
  if (obj[formattedKey] !== undefined) return obj[formattedKey];
  const internalFormattedKey = `_${targetKey}_value@OData.Community.Display.V1.FormattedValue`;
  if (obj[internalFormattedKey] !== undefined) return obj[internalFormattedKey];
  const lookupVal = obj[`_${targetKey}_value`];
  if (lookupVal !== undefined) return lookupVal;
  if (obj[targetKey] !== undefined) {
    const val = obj[targetKey];
    if (val && typeof val === 'object') return val.name || val.Value || JSON.stringify(val);
    return val;
  }
  const foundKey = Object.keys(obj).find(k => k.toLowerCase() === lowerTarget);
  if (foundKey) {
    const val = obj[foundKey];
    if (val && typeof val === 'object') return val.name || val.Value || JSON.stringify(val);
    return val;
  }
  return null;
};

const safeString = (val) => {
  if (val === null || val === undefined) return '';
  if (typeof val === 'object') return JSON.stringify(val).trim();
  return String(val).trim();
};

const normalizeName = (s) => (s || "").toLowerCase().replace(/[^a-z0-9]/g, '');

const isLenientMatch = (assetName, logName) => {
  const a = normalizeName(assetName);
  const l = normalizeName(logName);
  if (!a || !l) return false;
  return a === l || a.includes(l) || l.includes(a);
};

const normalizeDateStr = (d) => {
  if (!d) return "";
  const dateObj = new Date(d);
  if (isNaN(dateObj.getTime())) return "";
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, '0');
  const day = String(dateObj.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const getWeekNumber = (d) => {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  date.setUTCDate(date.getUTCDate() + 4 - (date.getUTCDay() || 7));
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
};

const getMarkerColor = (log) => {
  if (!log) return "#e2e8f0"; 
  const allergenClean = safeString(getProp(log, 'craa5_allergenclean')).toLowerCase();
  const cleanedBy = (safeString(getProp(log, 'craa5_lastcleanedby')) + " " + safeString(getProp(log, 'craa5_nameofemployee'))).toLowerCase();

  if (allergenClean === 'yes') return "#f97316";
  if (cleanedBy.includes('pssi') || cleanedBy.includes('7')) return "#3b82f6";
  if (cleanedBy.includes('8')) return "#eab308";
  return "#10b981";
};

const RenderMarker = ({ match, onHover, onLeave }) => {
  if (!match) return <div className="marker-empty" />;
  const mColor = getMarkerColor(match);
  if (mColor === "#f97316") {
    return <div className="marker-text" style={{ color: mColor, fontWeight: 900, fontSize: '15px', cursor: 'help', lineHeight: 1 }} onMouseEnter={onHover} onMouseLeave={onLeave}>A</div>;
  }
  return <div className="marker" style={{ backgroundColor: mColor }} onMouseEnter={onHover} onMouseLeave={onLeave} />;
};

const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

export default function App() {
  const [activeTab, setActiveTab] = useState('master'); 
  const [assets, setAssets] = useState([]);
  const [logs, setLogs] = useState([]);
  const [anchorYear, setAnchorYear] = useState(new Date().getFullYear());
  
  const [currentPage, setCurrentPage] = useState(0);
  const pageSize = 5; 
  const [areaPages, setAreaPages] = useState({});
  const equipmentPageSize = 10;
  
  const [visibleMonths, setVisibleMonths] = useState([]); 
  const [modalContext, setModalContext] = useState(null); 
  const [isModalMaximized, setIsModalMaximized] = useState(false);
  const [isTheaterMode, setIsTheaterMode] = useState(false);
  
  const [isLoading, setIsLoading] = useState(false);
  const [loadProgress, setLoadProgress] = useState(0);
  const [searchQuery, setSearchQuery] = useState("");
  const [zoom, setZoom] = useState(1.0);
  const [hoveredLog, setHoveredLog] = useState(null);
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });
  
  const [expandedKeys, setExpandedKeys] = useState({});
  const [completionMap, setCompletionMap] = useState(new Map());
  const [groupCompletionMap, setGroupCompletionMap] = useState(new Set());
  const [weeklyCompletions, setWeeklyCompletions] = useState(new Set()); // Tracks if an asset was cleaned during a specific week
  const [unmappedLogs, setUnmappedLogs] = useState([]);

  const today = useMemo(() => new Date(), []);
  const todayStr = useMemo(() => normalizeDateStr(today), [today]);
  const thisWeekNum = useMemo(() => getWeekNumber(today), [today]);
  const thisYear = useMemo(() => today.getFullYear(), [today]);

  useEffect(() => {
    const curMonth = today.getMonth();
    const range = [];
    if (curMonth > 0) range.push(curMonth - 1);
    range.push(curMonth);
    if (curMonth < 11) range.push(curMonth + 1);
    setVisibleMonths(range);
  }, [today]);

  const triggerSync = async () => {
    if (isLoading) return;
    setIsLoading(true);
    setLoadProgress(5);
    
    try {
      let fetchedAssets = [];
      let fetchedLogs = [];

      if (typeof Xrm !== 'undefined') {
        const assetRes = await Xrm.WebApi.retrieveMultipleRecords("craa5_aa_assets", "?$top=5000");
        fetchedAssets = assetRes.entities || [];
        setLoadProgress(30);

        const start = new Date(anchorYear, 0, 1).toISOString();
        const end = new Date(anchorYear, 11, 31, 23, 59).toISOString();
        const logOptions = `?$filter=craa5_lastcleaned ge '${start}' and craa5_lastcleaned le '${end}'`;
        
        const fetchAllLogs = async (query) => {
            const res = await Xrm.WebApi.retrieveMultipleRecords("craa5__log_", query);
            let combined = res.entities;
            if (res.nextLink) {
                const nextQuery = "?" + res.nextLink.split("?")[1];
                const nextPart = await fetchAllLogs(nextQuery);
                combined = [...combined, ...nextPart];
            }
            return combined;
        };

        fetchedLogs = await fetchAllLogs(logOptions);
      } else {
        setLoadProgress(40);
        fetchedAssets = Array.from({ length: 60 }, (_, i) => ({
          craa5_aa_assetsid: `asset-guid-${i}`,
          craa5_equipmentidentifier: `Asset ${i + 1}`,
          craa5_roomname: i < 30 ? 'Creme' : 'Bakery',
          craa5_areaname: i < 30 ? 'IBL4' : 'Ovens',
          craa5_dailyclean: i % 2 === 0 ? 'yes' : 'no',
          craa5_weeklyclean: i % 3 === 0 ? 'yes' : 'no',
          craa5_monthlyclean: i % 5 === 0 ? 'yes' : 'no',
          craa5_annually: i % 7 === 0 ? 'yes' : 'no',
          craa5_quarterly: i % 6 === 0 ? 'yes' : 'no',
          craa5_midweekclean: i % 4 === 0 ? 'yes' : 'no',
        }));
        fetchedLogs = [
          { _craa5_equipment_value: 'asset-guid-0', craa5_equipment: 'Asset 1', craa5_lastcleaned: normalizeDateStr(today), craa5_lastcleanedby: 'EL/LH 8', craa5_uid: 'YEL-001', craa5_roomname: 'Creme', craa5_areaname: 'IBL4' },
          { _craa5_equipment_value: 'asset-guid-1', craa5_equipment: 'Asset 2', craa5_lastcleaned: normalizeDateStr(new Date(today.getTime() - 86400000 * 10)), craa5_allergenclean: 'yes', craa5_uid: 'ORG-001', craa5_roomname: 'Creme', craa5_areaname: 'IBL4' },
          { _craa5_equipment_value: 'non-existent-guid', craa5_equipment: 'Asset FAIL', craa5_lastcleaned: normalizeDateStr(today), craa5_uid: 'FAIL-001', craa5_roomname: 'WrongRoom', craa5_areaname: 'WrongArea' }
        ];
      }

      setLoadProgress(80);
      const newMap = new Map();
      const groupMap = new Set(); 
      const weeklyMap = new Set();
      const unmapped = [];
      const mappedLogIds = new Set();

      fetchedLogs.forEach(l => {
        const lName = safeString(getProp(l, 'craa5_equipment'));
        const lEquipId = safeString(getProp(l, '_craa5_equipment_value') || getProp(l, 'craa5_equipmentid') || getProp(l, 'craa5_equipmentguid')).toLowerCase();
        const lDate = normalizeDateStr(getProp(l, 'craa5_lastcleaned'));
        const lRoom = safeString(getProp(l, 'craa5_roomname') || getProp(l, 'craa5_room') || getProp(l, 'room'));
        const lArea = safeString(getProp(l, 'craa5_areaname') || getProp(l, 'craa5_area') || getProp(l, 'area'));
        const lId = l.craa5__log_id || l.craa5_uid;

        let matchedAny = false;
        let partialReason = null;

        fetchedAssets.forEach(asset => {
          const aId = safeString(getProp(asset, 'craa5_aa_assetsid')).toLowerCase();
          const aName = safeString(getProp(asset, 'craa5_equipmentidentifier'));
          const aRoom = safeString(getProp(asset, 'craa5_roomname')) || '[Unassigned Room]';
          const aArea = safeString(getProp(asset, 'craa5_areaname')) || '[Unassigned Area]';
          
          let isMatch = false;

          // 1. Primary Priority: Exact GUID Match
          if (aId && lEquipId && aId === lEquipId) {
             isMatch = true;
          } 
          // 2. Fallback Priority: Strict Hierarchical Text Match
          else if (isLenientMatch(aName, lName)) {
            let isRoomMatch = true;
            if (lRoom && aRoom !== '[Unassigned Room]') isRoomMatch = isLenientMatch(aRoom, lRoom);
            
            let isAreaMatch = true;
            if (lArea && aArea !== '[Unassigned Area]') isAreaMatch = isLenientMatch(aArea, lArea);
            
            if (isRoomMatch && isAreaMatch) {
               isMatch = true;
            } else {
               if (!isRoomMatch) partialReason = `Room mismatch (${lRoom} != ${aRoom})`;
               else partialReason = `Area mismatch (${lArea} != ${aArea})`;
            }
          }

          if (isMatch) {
            const rNorm = normalizeName(aRoom);
            const arNorm = normalizeName(aArea);
            newMap.set(`${rNorm}|${arNorm}|${aId}|${lDate}`, l);
            groupMap.add(`${aRoom}|${lDate}`);
            groupMap.add(`${aRoom}|${aArea}|${lDate}`);
            
            // Build Weekly Completions Index for Missed Tasks
            const lDateObj = new Date(lDate + 'T00:00:00'); 
            const lWk = getWeekNumber(lDateObj);
            const lYr = lDateObj.getFullYear();
            weeklyMap.add(`${aId}|${lWk}|${lYr}`);
            
            mappedLogIds.add(lId);
            matchedAny = true;
          }
        });

        if (!matchedAny) {
           l._mappingReason = partialReason || "Equipment GUID or Name not found in active directory.";
           unmapped.push(l);
        }
      });

      setAssets(fetchedAssets);
      setLogs(fetchedLogs);
      setCompletionMap(newMap);
      setGroupCompletionMap(groupMap);
      setWeeklyCompletions(weeklyMap);
      setUnmappedLogs(unmapped);
      
      const initialExpands = {};
      fetchedAssets.forEach(a => {
        const r = safeString(getProp(a, 'craa5_roomname')) || '[Unassigned Room]';
        initialExpands[r] = true;
      });
      setExpandedKeys(initialExpands);
      setLoadProgress(100);
    } catch (err) {
      console.error("Sync Failure:", err);
    } finally {
      setTimeout(() => {
        setIsLoading(false);
        setLoadProgress(0);
      }, 500);
    }
  };

  const dayColWidth = useMemo(() => Math.floor(26 * zoom), [zoom]);
  const frozenWidth = 380;
  
  const timelineDays = useMemo(() => {
    const days = [];
    let cur = new Date(anchorYear, 0, 1);
    while (cur.getFullYear() === anchorYear) {
      const mIdx = cur.getMonth();
      const isVisible = visibleMonths.includes(mIdx);
      if (isVisible) {
          days.push({
            dateStr: normalizeDateStr(cur),
            dayNum: cur.getDate(),
            month: MONTHS[mIdx],
            monthIdx: mIdx,
            week: getWeekNumber(cur),
            year: cur.getFullYear(),
            label: cur.toLocaleDateString('en-US', { weekday: 'short' }) + ' ' + cur.getDate(),
            isToday: normalizeDateStr(cur) === todayStr,
            isWeekend: cur.getDay() === 0 || cur.getDay() === 6
          });
      }
      cur.setDate(cur.getDate() + 1);
    }
    return days;
  }, [anchorYear, todayStr, visibleMonths]);

  const monthSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const weekSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.week === d.week && s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ week: d.week, month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const filteredTreeData = useMemo(() => {
    const map = {};
    const q = searchQuery.toLowerCase();
    assets.forEach(asset => {
      const equip = safeString(getProp(asset, 'craa5_equipmentidentifier'));
      const room = safeString(getProp(asset, 'craa5_roomname')) || '[Unassigned Room]';
      const area = safeString(getProp(asset, 'craa5_areaname')) || '[Unassigned Area]';
      const matchesSearch = !q || equip.toLowerCase().includes(q) || room.toLowerCase().includes(q) || area.toLowerCase().includes(q);
      if (matchesSearch) {
        if (!map[room]) map[room] = {};
        if (!map[room][area]) map[room][area] = [];
        map[room][area].push(asset);
      }
    });
    return map;
  }, [assets, searchQuery]);

  const roomKeys = Object.keys(filteredTreeData);
  const totalPages = Math.ceil(roomKeys.length / pageSize);
  const pagedRoomKeys = roomKeys.slice(currentPage * pageSize, (currentPage + 1) * pageSize);

  const toggleMonthSlicer = (idx) => {
      setVisibleMonths(prev => prev.includes(idx) ? prev.filter(i => i !== idx) : [...prev, idx].sort((a,b) => a-b));
  };

  const openScopedModal = (type, value) => {
      setModalContext({ type, value });
      setIsModalMaximized(false);
  };

  const updateAreaPage = (areaKey, delta) => {
      setAreaPages(prev => ({
          ...prev,
          [areaKey]: Math.max(0, (prev[areaKey] || 0) + delta)
      }));
  };

  const handlePopout = () => {
    const baseUrl = window.location.origin + window.location.pathname;
    window.open(baseUrl, '_blank', 'width=1400,height=900,scrollbars=yes,resizable=yes');
  };

  return (
    <div className={`pa-app flex flex-col h-screen bg-[#f1f5f9] text-[#0f172a] ${isTheaterMode ? 'theater-active' : ''}`} onMouseMove={e => setMousePos({ x: e.clientX, y: e.clientY })}>
      
      <style>{`
