                                    <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? '#eff6ff' : d.isWeekend ? '#f8fafc' : 'transparent' }}>
                                      {groupCompletionMap.has(`${room}|${area}|${d.dateStr}`) && <CheckCircleIcon color="#10b981" style={{ width: '12px' }} />}
                                    </div>
                                ))}
                             </div>
                          </div>
                          {expandedKeys[ak] && (
                            <>
                              {pagedEquipment.map(asset => {
                                const name = safeString(getProp(asset, 'craa5_equipmentidentifier'));
                                const aId = safeString(getProp(asset, 'craa5_aa_assetsid')).toLowerCase();
                                const rNorm = normalizeName(room);
                                const arNorm = normalizeName(area);
                                
                                const isD = safeString(getProp(asset, 'craa5_dailyclean')).toLowerCase() === 'yes';
                                const isW = safeString(getProp(asset, 'craa5_weeklyclean')).toLowerCase() === 'yes';
                                const isM = safeString(getProp(asset, 'craa5_monthlyclean')).toLowerCase() === 'yes';
                                const isMW = safeString(getProp(asset, 'craa5_midweekclean')).toLowerCase() === 'yes';
                                const isQ = safeString(getProp(asset, 'craa5_quarterly')).toLowerCase() === 'yes';
                                const isA = safeString(getProp(asset, 'craa5_annually')).toLowerCase() === 'yes';

                                return (
                                  <div key={asset.craa5_aa_assetsid} className="asset-row">
                                    <div className="frozen-labels" style={{ paddingLeft: '48px', paddingRight: '12px' }}>
                                      <div className="flex flex-col flex-1" style={{ overflow: 'hidden' }}>
                                        <div className="flex items-center" style={{ overflow: 'hidden' }}>
                                          <FileIcon />
                                          <span style={{ marginLeft: '8px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{name}</span>
                                        </div>
                                        <div style={{ paddingLeft: '22px', fontSize: '9px', color: '#94a3b8', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                          {aId || 'No GUID'}
                                        </div>
                                      </div>
                                      <div className="flex items-center shrink-0 flex-wrap justify-end gap-1" style={{ maxWidth: '70px' }}>
                                        {isD && <span className="freq-badge freq-d" title="Daily">D</span>}
                                        {isW && <span className="freq-badge freq-w" title="Weekly">W</span>}
                                        {isM && <span className="freq-badge freq-m" title="Monthly">M</span>}
                                        {isMW && <span className="freq-badge freq-mw" title="Midweek">MW</span>}
                                        {isQ && <span className="freq-badge freq-q" title="Quarterly">Q</span>}
                                        {isA && <span className="freq-badge freq-a" title="Annual">A</span>}
                                      </div>
                                    </div>
                                    <div className="data-cells">
                                      {timelineDays.map((d, di) => {
                                        const match = completionMap.get(`${rNorm}|${arNorm}|${aId}|${d.dateStr}`);
                                        const isPastDay = d.dateStr < todayStr;
                                        const isPastWeek = (d.year < thisYear) || (d.year === thisYear && d.week < thisWeekNum);
                                        
                                        const isDMissed = isD && isPastDay && !match;
                                        const isWMissed = isW && isPastWeek && !weeklyCompletions.has(`${aId}|${d.week}|${d.year}`);
                                        
                                        let cellBg = 'transparent';
                                        if (d.isToday) cellBg = '#eff6ff';
                                        else if (isWMissed) cellBg = '#fef2f2';
                                        else if (d.isWeekend) cellBg = '#f8fafc';
                                        
                                        let cellStyle = { width: dayColWidth, background: cellBg };
                                        if (isDMissed) {
                                           cellStyle.boxShadow = 'inset 0 0 0 1px #ef4444';
                                        }

                                        return (
                                          <div key={di} className="completion-cell" style={cellStyle}>
                                            <RenderMarker match={match} onHover={() => setHoveredLog(match)} onLeave={() => setHoveredLog(null)} />
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })}
                              {areaTotalPages > 1 && (
                                <div className="area-pagination-bar">
                                   <button className="page-btn" disabled={areaPageIndex === 0} onClick={() => updateAreaPage(ak, -1)}>Prev 10</button>
                                   <span style={{ fontSize: '10px' }}>Items {(areaPageIndex * 10) + 1} - {Math.min((areaPageIndex + 1) * 10, areaEquipment.length)} of {areaEquipment.length}</span>
                                   <button className="page-btn" disabled={areaPageIndex >= areaTotalPages - 1} onClick={() => updateAreaPage(ak, 1)}>Next 10</button>
                                </div>
                              )}
                            </>
                          )}
                        </React.Fragment>
                      );
                    })}
                  </React.Fragment>
                ))}
              </div>
            </div>

            {totalPages > 1 && (
                <div className="pagination-bar">
                    <button className="page-btn" disabled={currentPage === 0} onClick={() => setCurrentPage(p => p - 1)}><ChevronLeftIcon /> Previous Page</button>
                    <span>Rooms {currentPage + 1} of {totalPages}</span>
                    <button className="page-btn" disabled={currentPage >= totalPages - 1} onClick={() => setCurrentPage(p => p + 1)}>Next Page <ChevronRightLargeIcon /></button>
                </div>
            )}
          </main>
        )}
      </div>
    </div>
  );
}
