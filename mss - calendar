  // Typing on a line the plan has (not typed before) creates its record on the first change; one record per area and line number.
  const patch = useCallback((card, fn) => setLines(prev => {
    const i = prev.findIndex(l => dtSame(l, card.area, card.line));
    if (i > -1) return prev.map((l, j) => (j === i ? fn(l) : l));
