        .data-body { display: flex; flex-direction: column; width: max-content; }
        .asset-row { display: flex; min-height: ${H.row}px; border-bottom: 1px solid #e2e8f0; width: max-content; align-items: stretch; }
        .asset-row:hover { background: #f8fafc; }
