  const [reqLog, setReqLog] = useState([]);   // the last few log requests, shown on the Diagnostics tab
  // "Load all": every equipment for the months on screen, through the same paced queue (on-screen rows first).
  const [loadAllOn, setLoadAllOn] = useState(false);
  const [loadAll, setLoadAll] = useState(null);     // { total, done, finished, months } while running or just finished
  const loadAllRef = useRef(false);                 // true once the loader has queued a Load all run; the pump ends the run when the queue drains
  const allIds = useMemo(() => assets.map(getAssetId).filter(Boolean), [assets]);
  const [pinnedRuns, setPinnedRuns] = useState([]);
  const lastYearRunsRef = useRef([]);
  const pinnedSet = useMemo(() => { const s = new Set(); pinnedRuns.forEach(r => r.ids.forEach(id => s.add(id))); return s; }, [pinnedRuns]);
  const pendingKeysRef = useRef([]);                   // read slices waiting for the flush that applies their rows
  const [loadedTick, setLoadedTick] = useState(0);   // bumped when loaded log rows (or an empty result) have been applied

  // Initialize Slicer with Previous, Current, and Next month
  useEffect(() => {
    const curMonth = today.getMonth();
    const range = [];
    if (curMonth > 0) range.push(curMonth - 1);
    range.push(curMonth);
    if (curMonth < 11) range.push(curMonth + 1);
    setVisibleMonths(range);
  }, [today]);

  const [armTextSave, setArmTextSave] = useState(false);
  useEffect(() => { if (!armTextSave) return undefined; const t = setTimeout(() => setArmTextSave(false), 8000); return () => clearTimeout(t); }, [armTextSave]);
  // Separate from Sync on purpose: this is the only place the calendar writes to Dataverse.
  const saveTextMatches = async () => {
    if (isSaving || !hasXrmConnection() || !textLinks.size) return;
    if (!armTextSave) { setArmTextSave(true); return; }   // ground rule 9: no window.confirm; the second click confirms
    setArmTextSave(false);
    setIsSaving(true);
    const epoch = epochRef.current;
    try {
      const wb = await writeBackTextLinks(logs, textLinks);
      if (epochRef.current !== epoch) return; // a Sync replaced the data while saving
      setLogs(prev => [...prev]);
      setTextLinks(prev => { const next = new Map(prev); wb.writtenKeys.forEach(k => next.delete(k)); return next; });
      setSyncNotes(prev => [...prev, `Stored the equipment id on ${wb.written} log(s)${wb.failed ? `; ${wb.failed} could not be updated and stay text-matched` : ''}.`]);
    } finally {
      setIsSaving(false);
    }
  };

  const flushLogs = useCallback(() => {
    const due = !!flushTimerRef.current || pendingLogsRef.current.length > 0 || pendingKeysRef.current.length > 0;
    if (flushTimerRef.current) { clearTimeout(flushTimerRef.current); flushTimerRef.current = null; }
    const batch = pendingLogsRef.current, links = pendingLinksRef.current, keys = pendingKeysRef.current;
    pendingLogsRef.current = [];
    pendingLinksRef.current = new Map();
    pendingKeysRef.current = [];
    if (links.size) setTextLinks(prev => { const next = new Map(prev); links.forEach((v, k) => next.set(k, v)); return next; });
    if (batch.length) setLogs(prev => prev.concat(batch));
    keys.forEach(({ list, loaded, inflight }) => list.forEach(k => { loaded.add(k); inflight.delete(k); }));
    if (due) setLoadedTick(t => t + 1);
  }, []);

  const addLogs = useCallback((rows, links) => {
    rows.forEach(l => {
      const k = getLogKey(l);
      if (logKeysRef.current.has(k)) return;
      logKeysRef.current.add(k);
      pendingLogsRef.current.push(l);
      if (links && links.has(k)) pendingLinksRef.current.set(k, links.get(k));
    });
    if (!flushTimerRef.current) flushTimerRef.current = setTimeout(flushLogs, 250);
  }, [flushLogs]);

  // Listen to BroadcastChannel & storage events from MSS Log Input & other hub apps
  useEffect(() => {
    let bc = null;
    if (typeof BroadcastChannel !== 'undefined') {
      try {
        bc = new BroadcastChannel(HUB_BROADCAST_CHANNEL);
        bc.onmessage = (ev) => {
          const data = ev && ev.data;
          if (!data || data.source === 'mss-calendar') return;
          if (data.type === 'LOG_CREATED' && data.log) {
            const links = computeTextLinks(latestRef.current.textIndex, [data.log]);
            addLogs([data.log], links);
            pushDevLog('SYNC', 'BroadcastChannel.LOG_CREATED', 'Received real-time log from ' + (data.source || 'hub'), 'OK', 1, 1, safeString(data.log.craa5_equipment));
          } else if (data.type === 'CATALOG_UPDATED') {
            setSharedCatalogCount(readSharedAssetCatalog().length);
          }
        };
      } catch (_) {}
    }
    const onStorage = (ev) => {
      if (ev && ev.key === CATALOG_STORAGE_KEY) {
        setSharedCatalogCount(readSharedAssetCatalog().length);
      }
    };
    window.addEventListener('storage', onStorage);
    return () => {
      if (bc) { try { bc.close(); } catch (_) {} }
      window.removeEventListener('storage', onStorage);
    };
  }, [addLogs]);

  // Hydrate assets from the shared MSS Log Input sessionStorage catalog ('mss_log_asset_catalog_v4')
  const loadSharedCatalogNow = useCallback(() => {
    const shared = readSharedAssetCatalog();
    setSharedCatalogCount(shared.length);
    if (!shared.length) return;
    setAssets(shared);
    const rooms = new Set(), areaKeys = new Set(), firstAreaByRoom = {};
    shared.forEach(a => {
      const r = safeString(getProp(a, 'craa5_roomname')) || 'Unassigned Room';
      const ar = safeString(getProp(a, 'craa5_areaname')) || 'Unassigned Area';
      rooms.add(r);
      const ak = `${r}|${ar}`;
      areaKeys.add(ak);
      if (!firstAreaByRoom[r]) firstAreaByRoom[r] = ak;
    });
    setExpandedKeys(prev => {
      const next = {};
      const hadAnyAreaOpen = Array.from(areaKeys).some(k => prev[k]);
      rooms.forEach(r => { next[r] = prev[r] === undefined ? true : prev[r]; });
      areaKeys.forEach(k => { if (prev[k]) next[k] = true; });
      if (!hadAnyAreaOpen) {
        Object.keys(firstAreaByRoom).forEach(r => { next[firstAreaByRoom[r]] = true; });
      }
      return next;
    });
    pushDevLog('CACHE', 'SharedCatalog.hydrate', 'Hydrated ' + shared.length + ' equipment rows from shared MSS Input catalog', 'OK', 2, shared.length);
  }, [anchorYear, idColumn]);

  // Sync loads the equipment directory, opens visible areas, and automatically triggers background log loading
  // so room/area bars, medallions, prioritization metrics, and completion percentages are consistently populated.
  const triggerSync = async () => {
    if (isLoading || isSaving) return;
    setIsLoading(true);
    setLoadProgress(10);
    loadAllRef.current = false;
    setLoadAllOn(false);
    setLoadAll(null);
    setPinnedRuns(prev => prev.length ? [] : prev);
    lastYearRunsRef.current = [];

    try {
      let fetchedAssets = [];
      let fetchedLogs = [];
      const notes = [];
      let hasIdColumn = true;
      if (hasXrmConnection()) {
        missingAssetColumns.clear();
        const a = await retrieveAssets();
        fetchedAssets = a.rows;
        if (fetchedAssets.length > 0) {
          writeSharedAssetCatalog(fetchedAssets);
          setSharedCatalogCount(fetchedAssets.length);
        }
        if (a.truncated) notes.push(`Only the first ${fetchedAssets.length} equipment rows were loaded.`);
        if (missingAssetColumns.size) notes.push(`The equipment table has no ${Array.from(missingAssetColumns).join(', ')} column${missingAssetColumns.size === 1 ? '' : 's'}, so ${missingAssetColumns.size === ASSET_FREQ_COLUMNS.length ? 'the frequency medallion cannot tell which cleans are due' : 'those frequencies cannot be checked'}.`);
        setLoadProgress(50);

        // Does the log table have the equipment id column at all? (One row, no data used.)
        try {
          await getXrmWebApi().retrieveMultipleRecords("craa5__log_", `?$select=${LOG_ASSET_ID_SELECT}&$top=1`);
        } catch (err) {
          if (!isMissingColumnError(err)) throw err;
          hasIdColumn = false;
          notes.push(`Log id column ${LOG_ASSET_ID_SELECT} unavailable (${err.message}); logs are matched by equipment name only.`);
        }
      } else {
        setLoadProgress(45);
        // Not inside the Power Apps host: no sample data is ever shown. The equipment list MSS Log Input left in this
        // browser can still be shown, with nothing read, so every day stays grey (not read) rather than missed.
        const shared = readSharedAssetCatalog();
        fetchedAssets = shared && shared.length ? shared : [];
        fetchedLogs = [];
        hasIdColumn = true;
        setSharedCatalogCount(fetchedAssets.length);
        notes.push('Not connected to Dataverse, so no cleans can be read. Open the calendar inside the Power Apps app.');
      }

      setLoadProgress(80);
      const links = computeTextLinks(buildTextIndex(fetchedAssets), fetchedLogs);

      epochRef.current += 1;
      setReqLog([]);
      diagSeqRef.current = { check: diagSeqRef.current.check + 1, lookup: diagSeqRef.current.lookup + 1 };
      missingLogColumns.clear();
      dateStyle = 0;
      setLogCheck(null);
      setLookup(null);
      const nextLoaded = new Set();
      loadedRef.current = nextLoaded;
      inflightRef.current = new Set();
      queueRef.current = [];
      pendingLogsRef.current = [];
      pendingLinksRef.current = new Map();
      pendingKeysRef.current = [];
      if (flushTimerRef.current) { clearTimeout(flushTimerRef.current); flushTimerRef.current = null; }
      logKeysRef.current = new Set(fetchedLogs.map(getLogKey));
      setLogsLoading(false);
      setAssets(fetchedAssets);
      if (!manifestSavedRef.current) { manifestSavedRef.current = true; saveCalendarManifest(); }   // never blocks, never shows an error
      setFreqEdits(prev => {
        const keys = Object.keys(prev);
        if (!keys.length) return prev;
        const have = {};
        fetchedAssets.forEach(a => { have[getAssetId(a)] = true; });
        const next = {};
        keys.forEach(id => { if (have[id]) next[id] = prev[id]; });
        return Object.keys(next).length === keys.length ? prev : next;
      });
      setLogs(fetchedLogs);
      setTextLinks(links);
      setSyncNotes(notes);
      setLoadErrors([]);
      setCanWriteBack(hasIdColumn);
      setIdColumn(hasIdColumn);
      setLoadedTick(t => t + 1);

      if (hasXrmConnection()) {
        readPlan(latestRef.current.anchorYear || anchorYear);
      }

      // Open all rooms and automatically open the first area of each room if no areas were open yet,
      // so the schedule matrix immediately renders equipment rows and starts loading log slices.
      const rooms = new Set(), areaKeys = new Set(), firstAreaByRoom = {};
      fetchedAssets.forEach(a => {
        const r = safeString(getProp(a, 'craa5_roomname')) || 'Unassigned Room';
        const ar = safeString(getProp(a, 'craa5_areaname')) || 'Unassigned Area';
        rooms.add(r);
        const ak = `${r}|${ar}`;
        areaKeys.add(ak);
        if (!firstAreaByRoom[r]) firstAreaByRoom[r] = ak;
      });
      setExpandedKeys(prev => {
        const next = {};
        const hadAnyAreaOpen = Array.from(areaKeys).some(k => prev[k]);
        rooms.forEach(r => { next[r] = prev[r] === undefined ? true : prev[r]; });
        areaKeys.forEach(k => { if (prev[k]) next[k] = true; });
        if (!hadAnyAreaOpen) {
          Object.keys(firstAreaByRoom).forEach(r => { next[firstAreaByRoom[r]] = true; });
        }
        return next;
      });

      // In Dataverse mode, automatically enable background paced loading for the visible slicer months
      // so all room/area bars, medallions, and prioritization scores populate without manual "Read" clicks.
      if (hasXrmConnection() && fetchedAssets.length > 0) {
        const monthsNow = latestRef.current.visibleMonths && latestRef.current.visibleMonths.length
          ? latestRef.current.visibleMonths
          : [today.getMonth()];
        const yrNow = latestRef.current.anchorYear || anchorYear;
        setLoadAll({
          total: fetchedAssets.length,
          done: 0,
          finished: false,
          months: `${monthsNow.map(m => MONTHS[m].slice(0, 3)).join(', ')} ${yrNow}`
        });
        setLoadAllOn(true);
      }

      setLoadProgress(100);
    } catch (err) {
      console.error("Sync Failure:", err);
      setSyncNotes([`Sync failed: ${err && err.message}`]);
    } finally {
      setTimeout(() => {
        setIsLoading(false);
        setLoadProgress(0);
      }, 350);
    }
  };

  // Auto-hydrate and sync on initial mount so the user never lands on an unloaded or inconsistent screen
  const autoSyncedMountRef = useRef(false);
  useEffect(() => {
    if (autoSyncedMountRef.current) return;
    autoSyncedMountRef.current = true;
    triggerSync();
    // eslint-disable-next-line
  }, []);

  const dayColWidth = useMemo(() => Math.floor(26 * zoom), [zoom]);
  const frozenWidth = 380;   // the original width: the medallion sits inside the equipment cell, the bar beside the room or area name

  const timelineDays = useMemo(() => {
    const days = [];
    let cur = new Date(anchorYear, 0, 1);
    while (cur.getFullYear() === anchorYear) {
      const mIdx = cur.getMonth();
      const isVisible = visibleMonths.includes(mIdx);

      if (isVisible) {
          days.push({
            dateStr: normalizeDateStr(cur),
            dayNum: cur.getDate(),
            month: MONTHS[mIdx],
            monthIdx: mIdx,
            week: getWeekNumber(cur),
            label: cur.toLocaleDateString('en-US', { weekday: 'short' }) + ' ' + cur.getDate(),
            isToday: normalizeDateStr(cur) === normalizeDateStr(today)
          });
      }
      cur.setDate(cur.getDate() + 1);
    }
    return days;
  }, [anchorYear, today, visibleMonths]);

  // TODAY: the column of today in the months on screen (-1: not on screen), and the scroll that brings it into view.
  const todayIdx = useMemo(() => { for (let i = 0; i < timelineDays.length; i++) if (timelineDays[i].isToday) return i; return -1; }, [timelineDays]);
  // Today about 70% across the day area (a month of history, a week ahead). force: also when it is in view already.
  const placeToday = (force) => {
    const vp = viewportRef.current;
    if (!vp || todayIdx < 0) return false;
    const visible = vp.clientWidth - frozenWidth;
    if (visible <= dayColWidth * 3) return false;             // not laid out yet (a hidden frame), or no room to speak of
    const x = todayIdx * dayColWidth;                         // the left edge of today's column in the day area
    const at = x - vp.scrollLeft;                             // where it sits now in the visible day area
    if (!force && at >= visible * 0.15 && at + dayColWidth <= visible * 0.85) return true;   // comfortably in view already
    vp.scrollLeft = Math.max(0, Math.round(x + dayColWidth / 2 - visible * 0.7));
    return true;
  };
  // Once, when the grid has its months: bring today into view. Leaving the matrix tab and coming back does it again.
  useEffect(() => {
    if (activeTab !== 'master' && activeTab !== 'plan') { autoTodayRef.current = false; return undefined; }
    const run = () => {
      if (autoTodayRef.current || timelineDays.length === 0) return;
      const vp = viewportRef.current;
      if (!vp || vp.clientWidth - frozenWidth <= dayColWidth * 3) return;
      autoTodayRef.current = true;
      placeToday(false);
    };
    run();
    window.addEventListener('resize', run);
    return () => window.removeEventListener('resize', run);
    // eslint-disable-next-line
  }, [activeTab, timelineDays, dayColWidth]);
  // TODAY with today's month not on screen: show it, then scroll as soon as it is there.
  useEffect(() => {
    if (todayPendingRef.current && todayIdx >= 0) { todayPendingRef.current = false; placeToday(true); }
    // eslint-disable-next-line
  }, [todayIdx, timelineDays]);
  const goToday = () => {
    if (todayIdx >= 0) { placeToday(true); setViewMsg('Scrolled to today'); return; }
    todayPendingRef.current = true;
    setAnchorYear(today.getFullYear());
    setVisibleMonths(prev => (prev.indexOf(today.getMonth()) >= 0 ? prev : prev.concat([today.getMonth()]).sort((a, b) => a - b)));
    setViewMsg('Showing the current month and scrolling to today');
  };

  // The day tint: the column under the pointer, over the header and every row (two overlays moved by refs: no re-render).
  const hideXh = () => {
    if (xhIdxRef.current < 0) return;
    xhIdxRef.current = -1;
    if (xhBodyRef.current) xhBodyRef.current.style.display = 'none';
    if (xhHeadRef.current) xhHeadRef.current.style.display = 'none';
  };
  const onGridMove = (e) => {
    const sc = e.nativeEvent && e.nativeEvent.sourceCapabilities;
    if (sc && sc.firesTouchEvents) return;   // the mouse event that follows a tap is not a pointer resting on a day
    const hb = headBlocksRef.current, corner = cornerRef.current, vp = viewportRef.current;
    if (!hb || !corner || !vp) return;
    if (e.clientX < corner.getBoundingClientRect().right) { hideXh(); return; }
    const idx = Math.floor((e.clientX - hb.getBoundingClientRect().left) / dayColWidth);
    if (idx < 0 || idx >= timelineDays.length) { hideXh(); return; }
    const b = xhBodyRef.current, h = xhHeadRef.current;
    const hh = Math.max(0, vp.clientHeight - hdrTotal) + 'px';
    if (b && xhIdxRef.current >= 0 && b.style.height !== hh) b.style.height = hh;   // the grid grew or shrank under a resting pointer
    if (idx === xhIdxRef.current) return;
    const first = xhIdxRef.current < 0;
    xhIdxRef.current = idx;
    if (b) {
      if (first) { b.style.height = hh; b.style.display = 'block'; }
      b.style.transform = 'translateX(' + (frozenWidth + idx * dayColWidth) + 'px)';
    }
    if (h) { if (first) h.style.display = 'block'; h.style.transform = 'translateX(' + (idx * dayColWidth) + 'px)'; }
  };
  // a new timeline, zoom or tier height puts the tint somewhere else
  useEffect(() => {
    hideXh();
    window.addEventListener('resize', hideXh);
    return () => { window.removeEventListener('resize', hideXh); };
  }, [timelineDays, dayColWidth, compact, fullMode, activeTab, focusOn]);   // eslint-disable-line

  const monthSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const weekSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.week === d.week && s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ week: d.week, month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const filteredTreeData = useMemo(() => {
    const map = {};
    const q = searchQuery.toLowerCase();
    const allowRooms = activePreset && Array.isArray(activePreset.allowedRooms) && activePreset.allowedRooms.length > 0 ? activePreset.allowedRooms : null;
    const allowAreas = activePreset && Array.isArray(activePreset.allowedAreas) && activePreset.allowedAreas.length > 0 ? activePreset.allowedAreas : null;
    assets.forEach(asset => {
      const equip = safeString(getProp(asset, 'craa5_equipmentidentifier'));
      const room = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
      const area = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
      if (allowRooms && !allowRooms.includes(room)) return;
      if (allowAreas && !allowAreas.includes(area)) return;
      
      const matchesSearch = !q || equip.toLowerCase().includes(q) || room.toLowerCase().includes(q) || area.toLowerCase().includes(q);

      if (matchesSearch) {
        if (!map[room]) map[room] = {};
        if (!map[room][area]) map[room][area] = [];
        map[room][area].push(asset);
      }
    });
    return map;
  }, [assets, searchQuery, activePreset]);

  // PLAN TAB (full mode): every equipment in the view (all rooms, not only the page), planned by frequency (buildFreqPlan), and
  // the header rows under the dates: hours, suggested crew, the crew builder's heads, and short or spare.
  const planMode = activeTab === 'plan' && fullMode;
  const freqPlan = useMemo(() => {
    if (!planMode) return null;
    const list = [], where = new Map();
    Object.keys(filteredTreeData).forEach(room => Object.keys(filteredTreeData[room]).forEach(area => filteredTreeData[room][area].forEach(a => { list.push(a); where.set(a, [room, area]); })));
    return buildFreqPlan({ assets: list, rules: lineRules, year: anchorYear, defaultMin: planSetup.defaultMin, groupOf: (a) => where.get(a) });
  }, [planMode, filteredTreeData, lineRules, anchorYear, planSetup.defaultMin]);
  const planCells = useMemo(() => {
    if (!freqPlan) return null;
    const hours = [], sugg = [], on = [], gap = [];
    timelineDays.forEach(d => {
      const c = fpDayCrew(planSetup, d.dateStr, freqPlan.dayMins[d.dateStr] || 0);
      const t = d.isToday ? ' today' : '';
      hours.push({ text: c.hours > 0 ? fpNum1(c.hours) : '', cls: (c.hours > 0 ? '' : 'open') + t, title: fpNum1(c.hours) + ' h of cleaning planned on ' + d.dateStr });
      sugg.push({ text: c.suggested ? String(c.suggested) : '', cls: t.trim(), title: c.cleaners + ' cleaners (' + fpNum1(c.hours) + ' h / ' + planSetup.shiftHours + ' h x ' + planSetup.share + '%) + ' + c.support + ' support' });
      on.push({ text: c.built ? String(c.onHeads) : '', cls: t.trim(), title: c.built ? (c.crews.length ? 'Crews on: ' + c.crews.join(', ') : 'No crew on this day') + ' + ' + c.support + ' support' : 'Type heads in the crew builder' });
      gap.push(!c.built ? { text: '', cls: t.trim() } : c.short > 0
        ? { text: '-' + c.short, cls: (c.onDemand >= c.short ? 'warn' : 'bad'), title: c.short + ' cleaners short' + (c.onDemand ? '; ' + c.onDemand + ' on demand can be called in' : '') }
        : { text: c.spare > 0 ? '+' + c.spare : '0', cls: 'good', title: c.spare > 0 ? c.spare + ' cleaners spare' : 'Covered' });
    });
    return { hours, sugg, on, gap };
  }, [freqPlan, planSetup, timelineDays]);

  // PAGINATION CALCULATION (Rooms)
  const roomKeys = Object.keys(filteredTreeData);
  const totalPages = Math.ceil(roomKeys.length / pageSize);
  const pagedRoomKeys = roomKeys.slice(currentPage * pageSize, (currentPage + 1) * pageSize);

  // The equipment on screen, worked out from state (open rooms and areas, their pages, the focused dialog),
  // not from what happened to render, so it cannot be disturbed by re-renders such as mouse moves. It mirrors
  // the two render paths below: the main grid and the focused dialog.
  // A stored page never points past the end of the list it pages (the list shrinks on a filter or a Sync).
  const pageOf = (pages, key, length, size) => Math.min(pages[key] || 0, Math.max(0, Math.ceil(length / size) - 1));
  const onMatrix = useMemo(() => {
    const grid = new Set();
    const dialog = new Set();
    pagedRoomKeys.forEach(room => {
      if (!expandedKeys[room]) return;
      Object.keys(filteredTreeData[room]).forEach(area => {
        const ak = `${room}|${area}`;
        if (!expandedKeys[ak]) return;
        const page = pageOf(areaPages, ak, filteredTreeData[room][area].length, equipmentPageSize);
        filteredTreeData[room][area].slice(page * equipmentPageSize, (page + 1) * equipmentPageSize).forEach(a => grid.add(getAssetId(a)));
      });
    });
    if (modalContext) {
      Object.keys(filteredTreeData)
        .filter(r => modalContext.type === 'room' ? r === modalContext.value : filteredTreeData[r][modalContext.value])
        .forEach(room => Object.keys(filteredTreeData[room])
          .filter(a => modalContext.type === 'area' ? a === modalContext.value : true)
          .forEach(area => {
            const page = pageOf(modalPages, `${room}|${area}`, filteredTreeData[room][area].length, MODAL_PAGE_SIZE);
            filteredTreeData[room][area].slice(page * MODAL_PAGE_SIZE, (page + 1) * MODAL_PAGE_SIZE).forEach(a => dialog.add(getAssetId(a)));
          }));
    }
    return { grid: Array.from(grid), dialog: Array.from(dialog) };
  }, [pagedRoomKeys, expandedKeys, areaPages, filteredTreeData, modalContext, modalPages]);
  // What the loader reads: the grid only while the matrix tab is showing, the dialog whenever it is open.
  const visibleKeyNow = useMemo(
    () => Array.from(new Set((activeTab === 'master' ? onMatrix.grid : []).concat(onMatrix.dialog))).join(','),
    [activeTab, onMatrix]
  );
  // Only restarts when the set itself changes, so quick clicks through areas become one request round.
  useEffect(() => {
    if (visibleKeyNow === visibleKey) return;
    const t = setTimeout(() => setVisibleKey(visibleKeyNow), 150);
    return () => clearTimeout(t);
  }, [visibleKeyNow, visibleKey]);

  // --- Frequency check ---
  // For every equipment: which frequencies are set on it, and for each whether a clean of at least that kind is
  // dated within the frequency's window (ok), none is and every month of the window has been read for this
  // equipment (overdue), or the window still has unread months (unknown; the medallion says which to read).
  const todayStr = normalizeDateStr(today);
  const freqWindows = useMemo(() => FREQS.map(f => {
    const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - f.days);
    const months = [];
    let y = start.getFullYear(), m = start.getMonth();
    while (y < today.getFullYear() || (y === today.getFullYear() && m <= today.getMonth())) { months.push([y, m]); m += 1; if (m > 11) { m = 0; y += 1; } }
    return { ...f, start: normalizeDateStr(start), months };
  }), [today]);
  // "2026-09" for each month on screen: a log dated in one of them counts as a clean on screen.
  const visiblePrefixes = useMemo(() => visibleMonths.map(m => `${anchorYear}-${String(m + 1).padStart(2, '0')}`), [visibleMonths, anchorYear]);
  const freqStatus = useMemo(() => {
    const loaded = loadedRef.current;
    const out = new Map();
    assets.forEach(asset => {
      const id = getAssetId(asset);
      const name = safeString(getProp(asset, 'craa5_equipmentidentifier')).trim().toLowerCase();
      // A month is read once its id slice is in (with the id column) and the name slice is in too: old entries whose
      // stored id is blank or wrong arrive only through the name request, which is queued after the id one and can
      // fail on its own. Without the id column the name slice is all there is.
      const isRead = (y, m) => monthIsRead(loaded, idColumn, id, name, y, m);
      const unreadable = !idColumn && !name;     // nothing could ever be asked for this equipment
      const latest = [null, null, null, null, null, null, null, null];   // newest clean of at least rank 1 to 7 (dated today or earlier)
      const days = completionIndex.byAsset.get(id);
      let doneVisible = 0;   // days on screen with a log for this equipment
      if (days) days.forEach((entry, date) => {
        if (visiblePrefixes.includes(date.slice(0, 7))) doneVisible += 1;
        if (date > todayStr) return;
        const r = entryRank(entry);
        for (let k = 1; k <= 7; k++) if (r >= k && (!latest[k] || date > latest[k])) latest[k] = date;
      });
      const badges = unreadable ? [] : freqWindows.filter(f => f.flags.some(c => isTrue(asset[c]))).map(f => {
        const last = latest[f.rank];
        if (last && last >= f.start) return { code: f.code, label: f.label, days: f.days, state: 'ok', last, start: f.start, missing: [] };
        const missing = f.months.filter(([y, m]) => !isRead(y, m));
        return { code: f.code, label: f.label, days: f.days, state: missing.length ? 'unknown' : 'overdue', last, start: f.start, missing };
      });
      const state = badges.some(b => b.state === 'overdue') ? 'overdue' : badges.some(b => b.state === 'ok') ? 'ok' : badges.length ? 'unknown' : 'none';
      const unread = badges.some(b => b.state === 'unknown');   // some frequency still has months to read
      const partial = state !== 'unknown' && unread;            // settled on one frequency, not yet on another
      const missing = {};
      badges.forEach(b => b.missing.forEach(([y, m]) => { missing[`${y}-${m}`] = [y, m]; }));
      const missingMonths = Object.keys(missing).map(k => missing[k]);
      // Every month on screen has been read for this equipment (by id and by name), so a blank row means no clean.
      const readVisible = !unreadable && visibleMonths.length > 0 && visibleMonths.every(m => isRead(anchorYear, m));
      out.set(id, {
        badges, state, partial, unread, missingMonths, lastAny: latest[1], noName: unreadable, unreadable, doneVisible, readVisible,
        needsVisible: !unreadable && !readVisible && visibleMonths.length > 0   // Read on the bar would load months for it
      });
    });
    return out;
    // loadedTick stands in for loadedRef.current, which is not state.
    // eslint-disable-next-line
  }, [assets, completionIndex, loadedTick, visibleMonths, anchorYear, idColumn, freqWindows, todayStr, visiblePrefixes]);
  // LATE ONLY: how many equipment are late among those read (the same red letters the medallion shows)
  const lateCount = useMemo(() => { let n = 0; freqStatus.forEach((st) => { if (st.state === 'overdue') n += 1; }); return n; }, [freqStatus]);
  // The slicer shows full month names when they fit and three letters when they do not (measured, so it follows the window and the font).
  useEffect(() => {
    const fit = () => {
      const el = slicerRef.current;
      if (!el) return;
      if (!slicerShort) { if (el.scrollWidth > el.clientWidth + 1) { slicerLongRef.current = el.scrollWidth; setSlicerShort(true); } }
      else if (slicerLongRef.current && el.clientWidth >= slicerLongRef.current) setSlicerShort(false);
    };
    fit();
    window.addEventListener('resize', fit);
    let off = false;
    try { if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { if (!off) fit(); }); } catch (e) { /* no font events */ }
    return () => { off = true; window.removeEventListener('resize', fit); };
  }, [slicerShort, focusOn, activeTab, compact, lateCount > 0 ? lateCount.toLocaleString().length : 0]);   // the count on LATE ONLY changes the width of the buttons beside the strip

  // Room and area rows, by the done-or-blank method: how many equipment were cleaned on a day on screen, missed (every
  // month on screen read, no log), not read yet, or cannot be read; plus, per day on screen, how many were cleaned.
  const groupStatus = useMemo(() => {
    const groups = {};
    const blank = (room, area) => ({ room, area, total: 0, cleaned: 0, missed: 0, unread: 0, unreadable: 0, needsVisible: [], days: {} });
    const add = (g, asset) => {
      const id = getAssetId(asset);
      const st = freqStatus.get(id);
      g.total += 1;
      if (!st) return;
      if (st.doneVisible) g.cleaned += 1; else if (st.unreadable) g.unreadable += 1; else if (st.readVisible) g.missed += 1; else g.unread += 1;
      if (st.needsVisible) g.needsVisible.push(id);
      const days = st.doneVisible ? completionIndex.byAsset.get(id) : null;
      if (days) days.forEach((entry, date) => { if (visiblePrefixes.includes(date.slice(0, 7))) g.days[date] = (g.days[date] || 0) + 1; });
    };
    Object.keys(filteredTreeData).forEach(room => {
      const rg = groups[room] = blank(room, null);
      Object.keys(filteredTreeData[room]).forEach(area => {
        const ag = groups[`${room}|${area}`] = blank(room, area);
        filteredTreeData[room][area].forEach(a => { add(rg, a); add(ag, a); });
      });
    });
    Object.keys(groups).forEach(k => {
      const g = groups[k];
      g.state = g.cleaned && !g.missed ? 'ok' : g.cleaned && g.missed ? 'partial' : g.missed ? 'missed' : 'unknown';
    });
    return groups;
  }, [filteredTreeData, freqStatus, completionIndex, visiblePrefixes]);

  // --- Completion percentages (see COMPLETION PERCENTAGES) ---
  // The daily and weekly rows under the day headers of the MSS in full mode: over the equipment listed after the search filter
  // (less what the Completion tab leaves out), from the logs read so far; what has not been read is left out and counted as
  // "not read yet". The focused dialog gets its own rows for the room or area it shows. The totals, the room and area figures and
  // Top missed are on the Completion tab.
  const completion = useMemo(() => {
    if (activeTab !== 'master' || !fullMode) return null;
    const list = [];
    Object.keys(filteredTreeData).forEach(room => Object.keys(filteredTreeData[room]).forEach(area => filteredTreeData[room][area].forEach(a => { if (!exLeftOut(exclusions.ex, room, area, getAssetId(a))) list.push(a); })));
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules });
    // loadedTick stands in for loadedRef.current, which is not state.
    // eslint-disable-next-line
  }, [activeTab, fullMode, filteredTreeData, exclusions.ex, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  const completionModal = useMemo(() => {
    if (!modalContext || !fullMode) return null;
    const list = [];
    Object.keys(filteredTreeData)
      .filter(r => modalContext.type === 'room' ? r === modalContext.value : filteredTreeData[r][modalContext.value])
      .forEach(room => Object.keys(filteredTreeData[room])
        .filter(a => modalContext.type === 'area' ? a === modalContext.value : true)
        .forEach(area => filteredTreeData[room][area].forEach(a => { if (!exLeftOut(exclusions.ex, room, area, getAssetId(a))) list.push(a); })));
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules });
    // eslint-disable-next-line
  }, [modalContext, fullMode, filteredTreeData, exclusions.ex, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  const pctCells = useMemo(() => completion ? completionCells(completion, timelineDays) : null, [completion, timelineDays]);
  const pctCellsModal = useMemo(() => completionModal ? completionCells(completionModal, timelineDays) : null, [completionModal, timelineDays]);
  // The Completion tab, computed when open or when Executive Mode (fullMode) is unlocked: every equipment that counts, the
  // groups it belongs to (its room, its area, itself) in the one pass, so the totals, every room's, area's and equipment's
  // figure and the figures per frequency letter all come from it.
  const countList = useMemo(() => ((activeTab === 'completion' || fullMode) ? buildCountList(assets, exclusions.ex) : null), [activeTab, fullMode, assets, exclusions.ex]);
  const compTab = useMemo(() => {
    if (!countList) return null;
    return computeCompletion({ assets: countList.list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules, bucketsOf: (a, i) => countList.keys[i] });
    // eslint-disable-next-line
  }, [countList, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);

  const prioritizationModel = useMemo(
    () => buildPrioritizationModel({
      assets,
      freqStatus,
      completionIndex,
      lineRules,
      planModel,
      today,
      todayStr
    }),
    [assets, freqStatus, completionIndex, lineRules, planModel, today, todayStr]
  );

  const [econ, setEcon] = useState(loadEconParams);
  const updateEcon = useCallback((next) => {
    setEcon(next);
    saveEconParams(next);
  }, []);
  const resetEcon = useCallback(() => {
    const def = { ...DEFAULT_ECON_PARAMS };
    setEcon(def);
    saveEconParams(def);
  }, []);
  // The labor rate and chemical standards from Dataverse (COST INPUTS), read the first time Graphs opens and on Read again.
  const [costReal, setCostReal] = useState(null);
  const [costReading, setCostReading] = useState(false);
  const [costUseReal, setCostUseReal] = useState(loadCostUseReal);
  const toggleCostUseReal = useCallback(() => { setCostUseReal(v => { saveCostUseReal(!v); return !v; }); }, []);
  const readCostNow = useCallback(async () => {
    if (!hasXrmConnection()) { setCostReal({ day: hubPlantDay(Date.now()), offline: true }); return; }
    setCostReading(true);
    try { setCostReal(await readCostInputs(hubPlantDay(Date.now()))); }
    catch (err) { setCostReal({ day: hubPlantDay(Date.now()), failed: String(err && err.message || err) }); }
    finally { setCostReading(false); }
  }, []);
  useEffect(() => { if (activeTab === 'graphs' && !costReal && !costReading) readCostNow(); }, [activeTab, costReal, costReading, readCostNow]);
  const costRealUsed = useMemo(() => (costUseReal && costReal ? {
    rate: costReal.rateSel && costReal.rateSel.best ? costReal.rateSel.best.rate : null,
    chem: costReal.chem && costReal.chem.areas ? costReal.chem : null
  } : null), [costUseReal, costReal]);

  const extrapolatedAnalytics = useMemo(
    () => buildExtrapolatedAnalyticsModel({
      assets,
      logs,
      completionIndex,
      lineRules,
      planModel,
      prioritizationModel,
      anchorYear,
      econ,
      real: costRealUsed
    }),
    [assets, logs, completionIndex, lineRules, planModel, prioritizationModel, anchorYear, econ, costRealUsed]
  );

  const openAreaInMatrix = useCallback((room, area) => {
    const r = safeString(room).trim();
    const a = safeString(area).trim();
    if (r) {
      setExpandedKeys(prev => Object.assign({}, prev, { [r]: true }, a ? { [`${r}|${a}`]: true } : {}));
      const rIdx = roomKeys.indexOf(r);
      if (rIdx >= 0) setCurrentPage(Math.floor(rIdx / pageSize));
    }
    setActiveTab('master');
  }, [roomKeys, pageSize]);

  // Read these equipment's log for the months of a view: 'ytd' = the months of this year so far, quarter by quarter (at most 3
  // months in a request, and the December before, where the first week starts), 'tf' = the slicer months that have started.
  // Through the same paced queue as Read and Load all (at most 3 requests at a time).
  const readMonths = useCallback((ids, metric) => {
    const c = compTab;
    if (!hasXrmConnection() || !c || !ids.length || c.endM < 0) return;
    const runs = [];
    if (metric === 'ytd') {
      for (let q = 0; q * 3 <= c.endM; q++) runs.push({ ids: ids, year: anchorYear, months: [q * 3, q * 3 + 1, q * 3 + 2].filter(m => m <= c.endM) });
      if (c.reachesPrev) runs.push({ ids: ids, year: anchorYear - 1, months: [11] });   // the week that holds 1 January starts in December
    } else {
      const months = visibleMonths.filter(m => m <= c.endM);
      if (months.length) runs.push({ ids: ids, year: anchorYear, months: months });
    }
    if (!runs.length) return;
    lastYearRunsRef.current = runs;
    setLoadErrors([]);
    setPinnedRuns(prev => prev.concat(runs));
  }, [compTab, anchorYear, visibleMonths]);
  // Save the frequency changes of these equipment (ids) to craa5_aa_assets, then show them in the list: the equipment rows are
  // patched in place for the ones Dataverse accepted; the others keep their change so it can be tried again.
  const saveFreqEdits = async (ids) => {
    if (!hasXrmConnection() || isSaving || isLoading) return;
    const items = ids.filter(id => freqEdits[id] && assetsById.get(id)).map(id => ({ id, asset: assetsById.get(id), want: freqEdits[id] }));
    const gone = ids.filter(id => freqEdits[id] && !assetsById.get(id)).map(id => ({ id, error: 'it was removed from Dataverse, so the change was dropped' }));
    if (gone.length) setFreqEdits(prev => { const next = { ...prev }; gone.forEach(g => { delete next[g.id]; }); return next; });
    if (!items.length) { if (gone.length) setFreqSave({ busy: false, ok: 0, failed: gone }); return; }
    setIsSaving(true);
    setFreqSave({ busy: true });
    const epoch = epochRef.current;
    try {
      const res = await writeFreqChanges(items);
      if (epochRef.current !== epoch) { setFreqSave(null); return; }   // a Sync replaced the data while saving
      const patches = {};
      res.forEach(r => { if (r.ok) patches[r.id] = r.patch; });
      if (Object.keys(patches).length) setAssets(prev => prev.map(a => { const patch = patches[getAssetId(a)]; return patch ? { ...a, ...patch } : a; }));
      setFreqEdits(prev => { const next = { ...prev }; Object.keys(patches).forEach(id => { delete next[id]; }); return next; });
      setFreqSave({ busy: false, ok: Object.keys(patches).length, failed: res.filter(r => !r.ok).map(r => ({ id: r.id, error: r.error })).concat(gone) });
    } catch (err) {
      setFreqSave({ busy: false, ok: 0, failed: items.map(it => ({ id: it.id, error: String(err && err.message ? err.message : err) })).concat(gone) });
    } finally {
      setIsSaving(false);
    }
  };

  // Name slices are keyed by one spelling, since the loader requests each name once however the equipment rows spell it.
  const sliceKey = (kind, year, m, item) => `${kind}|${year}|${m}|${kind === 'name' ? item.toLowerCase() : item}`;
  const jobKeys = (job) => job.items.flatMap(item => { const k = []; for (let m = job.m0; m <= job.m1; m++) k.push(sliceKey(job.kind, job.year, m, item)); return k; });

  // One global pump: at most MAX_PARALLEL_REQUESTS log requests in flight no matter how often the view changes.
  pumpRef.current = () => {
    while (activeRef.current < MAX_PARALLEL_REQUESTS && queueRef.current.length) {
      const job = queueRef.current.shift();
      activeRef.current += 1;
      (async () => {
        const started = performance.now();
        const entry = { kind: job.kind, items: job.items.length, months: `${MONTHS[job.m0].slice(0, 3)}${job.m1 > job.m0 ? '-' + MONTHS[job.m1].slice(0, 3) : ''} ${job.year}` };
        let applied = false;   // its slices go to the flush, which marks them read together with the rows
        try {
          const { rows, truncated } = job.kind === 'name'
            ? await fetchLogsByName(job.items, job.year, job.m0, job.m1, latestRef.current.idColumn)
            : await fetchLogsForAssets(job.items, job.year, job.m0, job.m1);
          if (epochRef.current === job.epoch) {
            if (truncated) {
              const note = `More than ${MAX_LOGS_PER_REQUEST.toLocaleString()} log rows matched one request, so only the first ${rows.length.toLocaleString()} were loaded. Narrow the months on screen.`;
              setSyncNotes(prev => prev.includes(note) ? prev : prev.concat(note));
            }
            pendingKeysRef.current.push({ list: jobKeys(job), loaded: job.loaded, inflight: job.inflight });
            applied = true;
            addLogs(rows, job.kind === 'name' ? computeTextLinks(latestRef.current.textIndex, rows) : null);
          }
          entry.rows = rows.length;
        } catch (err) {
          entry.error = String(err && err.message);
          if (epochRef.current === job.epoch) setLoadErrors(prev => prev.concat(String(err && err.message)).slice(-5));
        } finally {
          entry.ms = Math.round(performance.now() - started);
          if (epochRef.current === job.epoch) setReqLog(prev => prev.concat(entry).slice(-8));
          if (epochRef.current === job.epoch && loadAllRef.current) setLoadAll(prev => ({ ...(prev || {}), ...loadAllProgress() }));
          if (!applied) jobKeys(job).forEach(k => job.inflight.delete(k)); // the sets this job was created with, even after a Sync swapped them
          activeRef.current -= 1;
          pumpRef.current();
        }
      })();
    }
    if (!activeRef.current && !queueRef.current.length) {
      flushLogs();
      setLogsLoading(false);
      setPinnedRuns(prev => prev.length ? [] : prev);   // the Read runs are over, loaded or failed
      if (loadAllRef.current) {           // the Load all run has drained (every request done, or failed)
        loadAllRef.current = false;
        setLoadAll({ ...loadAllProgress(), finished: true });
        setLoadAllOn(false);
      }
    }
  };

  // How much of the Load all run is in: equipment whose every month on screen has been read (by id when the
  // log has the id column, otherwise by its name).
  const loadAllProgress = () => {
    const { idColumn: byId, visibleMonths: months, anchorYear: year, assets: list } = latestRef.current;
    const loaded = loadedRef.current;
    let done = 0, total = 0;
    list.forEach(a => {
      const item = byId ? getAssetId(a) : safeString(getProp(a, 'craa5_equipmentidentifier')).trim().toLowerCase();
      if (!item) return;   // nothing can be asked for it (no id, or no name without the id column)
      total += 1;
      if (months.every(m => loaded.has(`${byId ? 'id' : 'name'}|${year}|${m}|${item}`))) done += 1;
    });
    return { total, done, months: `${months.map(m => MONTHS[m].slice(0, 3)).join(', ')} ${year}` };
  };

  // Fetch logs for the equipment on screen, for the visible months only, and never twice.
  //  - 'id' jobs are the main path: every log stored against the equipment id (craa5_equipmentguid).
  //  - 'name' jobs catch old entries whose id is blank or matches no equipment, by the equipment name
  //    written on them (linked to equipment on the client, room and area deciding when several equipment
  //    share a name; an entry whose id matches an equipment row always goes to that equipment).
  useEffect(() => {
    // Requests that have not started are dropped and recomputed from what is on screen now.
    queueRef.current.forEach(j => jobKeys(j).forEach(k => j.inflight.delete(k)));
    queueRef.current = [];
    if (!hasXrmConnection() || isLoading) { pumpRef.current(); return; }
    const onScreen = visibleKey ? visibleKey.split(',') : [];
    let ids = onScreen;
    if (loadAllOn && visibleMonths.length) {
      const seen = new Set(onScreen);
      ids = onScreen.concat(allIds.filter(id => !seen.has(id)));   // what is on screen loads first
      loadAllRef.current = true;
    } else {
      loadAllRef.current = false;
    }
    {
      const loaded = loadedRef.current, inflight = inflightRef.current, epoch = epochRef.current;
      const queueKind = (kind, items, chunk, months, year) => {
        const keyOf = (item, m) => sliceKey(kind, year, m, item);
        // Group items by which months they are missing, so cached months are never requested again.
        const bySignature = new Map();
        items.forEach(item => {
          const missing = months.filter(m => !loaded.has(keyOf(item, m)) && !inflight.has(keyOf(item, m)));
          if (missing.length) {
            const sig = missing.slice().sort((x, y) => x - y).join(',');
            const group = bySignature.get(sig);   // push, not concat: copying the group for every item is quadratic
            if (group) group.push(item); else bySignature.set(sig, [item]);
          }
        });
        bySignature.forEach((sigItems, sig) => {
          monthRuns(sig.split(',').map(Number)).forEach(([m0, m1]) => {
            for (let i = 0; i < sigItems.length; i += chunk) {
              const job = { kind, items: sigItems.slice(i, i + chunk), m0, m1, year, epoch, loaded, inflight };
              jobKeys(job).forEach(k => inflight.add(k));
              queueRef.current.push(job);
            }
          });
        });
      };
      const queueIds = (list, months, year) => {
        if (!list.length || !months.length) return;
        const names = new Map();
        list.forEach(id => {
          const full = safeString(getProp(assetsById.get(id), 'craa5_equipmentidentifier')).trim();
          [full, nameBase(full)].forEach(n => { if (n && !names.has(n.toLowerCase())) names.set(n.toLowerCase(), n); });
        });
        if (idColumn) queueKind('id', list, ID_CHUNK, months, year);
        queueKind('name', Array.from(names.values()), NAME_CHUNK, months, year);
      };
      queueIds(ids, visibleMonths, anchorYear);
      pinnedRuns.forEach(run => queueIds(run.ids, run.months, run.year));   // the months on screen when Read was pressed
      if (queueRef.current.length) setLogsLoading(true);
    }
    pumpRef.current();
    // eslint-disable-next-line
  }, [visibleKey, visibleMonths, anchorYear, idColumn, assets, isLoading, retryTick, loadAllOn, allIds, pinnedRuns]);

  const retryLoads = () => {
    setLoadErrors([]);
    const again = lastYearRunsRef.current;
    if (again.length) setPinnedRuns(prev => prev.concat(again));   // a year read that lost slices asks for them again; the loaded ones are skipped
    setRetryTick(t => t + 1);
  };
  // Read on a bar: a run for these ids and the months on screen now. A press after a failed request queues the
  // missing months again, since the failed slices are neither read nor in flight.
  const readIds = useCallback((ids) => {
    if (!hasXrmConnection() || !ids.length || !visibleMonths.length) return;
    setLoadErrors([]);
    setPinnedRuns(prev => prev.concat({ ids, year: anchorYear, months: visibleMonths }));
  }, [anchorYear, visibleMonths]);
  const stopReading = () => { lastYearRunsRef.current = []; setPinnedRuns(prev => prev.length ? [] : prev); };
  // What a room or area bar needs: its counts, the months they cover, and whether its equipment is loading now.
  const onScreenSet = useMemo(() => new Set(visibleKeyNow ? visibleKeyNow.split(',') : []), [visibleKeyNow]);
  const monthsLabel = visibleMonths.length ? `${visibleMonths.map(m => MONTHS[m].slice(0, 3)).join(', ')} ${anchorYear}` : `${anchorYear}, no months selected`;
  const barProps = (key) => {
    const g = groupStatus[key];
    return { g, months: monthsLabel, canRead: hasXrmConnection() && !isLoading && visibleMonths.length > 0, onRead: readIds, busy: !!(logsLoading && g && g.needsVisible.some(id => pinnedSet.has(id) || onScreenSet.has(id))) };
  };
  // Hovering a check on a room or area row lists the equipment cleaned that day. Only the check is remembered: the names
  // are derived at render so a flush refreshes them, and the hover is dropped when its check leaves the screen (a filter,
  // Sync or year change removes the check without a mouseleave, so the tooltip would otherwise stick to the mouse).
  const [hoveredCell, setHoveredCell] = useState(null);   // { key, date }
  const hoverGroupDay = useCallback((key, date) => setHoveredCell({ key, date }), []);
  const leaveGroupDay = useCallback(() => setHoveredCell(null), []);
