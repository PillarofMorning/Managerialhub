        .search-box { background: #F7F9FC; border: 1px solid #cbd5e1; border-radius: 8px; padding: 5px 11px; display: flex; align-items: center; gap: 7px; flex: 1 1 130px; min-width: 130px; max-width: 210px; }
        .search-box input { background: transparent; border: none; outline: none; font-size: 12px; width: 100%; min-width: 0; font-family: inherit; color: inherit; }
        .search-box:focus-within { border-color: ${BRAND.blue}; box-shadow: 0 0 0 3px rgba(0,114,206,0.15); }

        .matrix-outer-container {
