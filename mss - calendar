// --- HELPERS ---

const getProp = (obj, targetKey) => {
  if (!obj || !targetKey) return null;
  const lowerTarget = targetKey.toLowerCase();
  const formattedKey = `${targetKey}@OData.Community.Display.V1.FormattedValue`;
  if (obj[formattedKey] !== undefined) return obj[formattedKey];
  const internalFormattedKey = `_${targetKey}_value@OData.Community.Display.V1.FormattedValue`;
  if (obj[internalFormattedKey] !== undefined) return obj[internalFormattedKey];
  if (obj[targetKey] !== undefined) {
    const val = obj[targetKey];
    if (val && typeof val === 'object' && val.name) return val.name;
    return val;
  }
  const foundKey = Object.keys(obj).find(k => k.toLowerCase() === lowerTarget);
  if (foundKey) {
    const val = obj[foundKey];
    if (val && typeof val === 'object' && val.name) return val.name;
    return val;
  }
  return null;
};

const safeString = (val) => {
  if (val === null || val === undefined) return '';
  return String(val).trim();
};

const normalizeName = (s) => (s || "").toLowerCase().replace(/[^a-z0-9]/g, '');

const normalizeDateStr = (d) => {
  if (!d) return "";
  // craa5_lastcleaned is a date-only value that Dataverse returns as midnight UTC; read it as that
  // calendar day instead of shifting it into the viewer's timezone.
  if (typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
  const dateOnly = typeof d === 'string' && d.match(/^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.0+)?Z$/);
  if (dateOnly) return dateOnly[1];
  const dateObj = new Date(d);
  if (isNaN(dateObj.getTime())) return "";
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, '0');
  const day = String(dateObj.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

// --- ID-FIRST MATCHING ---
// Logs (craa5__log_) are attached to equipment by Dataverse id: craa5_equipmentguid holds the
// craa5_aa_assetsid of the equipment row in craa5_aa_assets. Text matching is only a fallback, for old
// entries whose id is blank or matches no equipment (see computeTextLinks).
const LOG_ASSET_ID_FIELDS = ['craa5_equipmentguid'];
const LOG_ASSET_ID_SELECT = 'craa5_equipmentguid';

// The host compiles this file for old browsers without iterable support: spreading a Set, Map or
// iterator ([...set], [...map.values()]) yields nothing there, or a one-element array holding the
// collection itself (it shows as '[object Set]' when joined), and for...of over one runs zero times.
// Use Array.from and forEach for those; spreading or for...of over a real array, and object spreads,
// still work.
const normalizeId = (v) => String(v === null || v === undefined ? '' : v).toLowerCase().replace(/[{}\s]/g, '');

// Raw column value (GUIDs), unlike getProp which prefers formatted display names.
const getRaw = (obj, key) => {
  if (!obj) return null;
  if (obj[key] !== undefined) return obj[key];
  const k = Object.keys(obj).find(x => x.toLowerCase() === key.toLowerCase());
  return k ? obj[k] : null;
};

const getAssetId = (asset) => normalizeId(getRaw(asset, 'craa5_aa_assetsid'));
const getLogKey = (log) => normalizeId(getRaw(log, 'craa5__log_id') || getRaw(log, 'craa5_uid')) ||
  `${normalizeName(safeString(getProp(log, 'craa5_equipment')))}|${normalizeDateStr(getRaw(log, 'craa5_lastcleaned'))}`;

// --- CLEANING FREQUENCIES ---
// The equipment row carries one Yes/No column per frequency; the log row says which kind of clean was done
// (craa5_daily / craa5_weekly / craa5_monthly; a log with none of them set counts for every frequency).
// A frequency is within its window when a clean of at least that kind (rank) is dated within `days` of today.
const isTrue = (v) => v === true || v === 1 || /^(true|yes|1)$/i.test(String(v === null || v === undefined ? '' : v).trim());
const FREQS = [
  { code: 'D', label: 'Daily', days: 1, rank: 1, flags: ['craa5_dailyclean'] },
  { code: 'MW', label: 'Mid-week', days: 7, rank: 1, flags: ['craa5_midweek'] },
  { code: 'W', label: 'Weekly', days: 7, rank: 2, flags: ['craa5_weeklyclean'] },
  { code: 'M', label: 'Monthly', days: 31, rank: 3, flags: ['craa5_monthlyclean', 'craa5_month'] },
  { code: 'Q', label: 'Quarterly', days: 92, rank: 3, flags: ['craa5_quarterly'] },
  { code: 'A', label: 'Annual', days: 366, rank: 3, flags: ['craa5_annually'] }
];
const ASSET_FREQ_COLUMNS = FREQS.reduce((cols, f) => cols.concat(f.flags.filter(c => !cols.includes(c))), []);
const LOG_TYPE_COLUMNS = ['craa5_daily', 'craa5_weekly', 'craa5_monthly'];   // bits 1, 2, 4
const logTypeBits = (log) => LOG_TYPE_COLUMNS.reduce((bits, c, i) => bits | (isTrue(log[c]) ? (1 << i) : 0), 0);   // exact column names: no case-insensitive scan per row
const bitsRank = (bits) => !bits ? 9 : (bits & 4) ? 3 : (bits & 2) ? 2 : 1;   // 9: no kind recorded, counts for everything
// The rank of a day's entry: the best of its logs, so a log with no kind keeps counting for everything even when another log that day names one.
const entryRank = (e) => e.rank !== undefined ? e.rank : bitsRank(e.types);
const logTypeLabel = (bits) => !bits ? '' : LOG_TYPE_COLUMNS.map((c, i) => (bits & (1 << i)) ? ['Daily', 'Weekly', 'Monthly'][i] : '').filter(Boolean).join(' + ');
// "Oct–Dec 2025, Jan–Aug 2026" for a list of [year, monthIndex] pairs.
const fmtMonths = (pairs) => {
  const sorted = pairs.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]);
  const byYear = [];
  sorted.forEach(([y, m]) => { const last = byYear[byYear.length - 1]; if (last && last.y === y) last.m.push(m); else byYear.push({ y, m: [m] }); });
  return byYear.map(({ y, m }) => monthRuns(m).map(([a, b]) => MONTHS[a].slice(0, 3) + (b > a ? '–' + MONTHS[b].slice(0, 3) : '')).join(', ') + ' ' + y).join(', ');
};

// Builds { byAsset: Map<assetId, Map<dateStr, {log, via, types, rank, file}>>, unmapped, stats }. `types` holds the kinds of
// clean recorded that day (bits: daily 1, weekly 2, monthly 4), merged from every log of that equipment and day;
// `file` is the paperwork attached to one of those logs ({ rowId, name }), or null.
// textLinks (Map<logKey, assetId>) holds the text fallback, computed once when a log is loaded.
const buildCompletionIndex = (assets, logs, textLinks) => {
  const assetIds = new Set(assets.map(getAssetId));
  const byAsset = new Map();
  const unmapped = [];
  const stats = { id: 0, text: 0, unmapped: 0, duplicate: 0 };  // id + text + unmapped + duplicate = distinct logs
  const seen = new Set();

  logs.forEach(log => {
    const key = getLogKey(log);
    if (seen.has(key)) return;
    seen.add(key);

    let assetId = null;
    let via = null;
    for (const f of LOG_ASSET_ID_FIELDS) {
      const v = normalizeId(getRaw(log, f));
      if (v && assetIds.has(v)) { assetId = v; via = 'id'; break; }
    }
    if (!assetId && textLinks && textLinks.has(key) && assetIds.has(textLinks.get(key))) {
      assetId = textLinks.get(key);
      via = 'text';
    }
    if (!assetId) { unmapped.push(log); stats.unmapped++; return; }

    const date = normalizeDateStr(getRaw(log, 'craa5_lastcleaned'));
    if (!date) { unmapped.push(log); stats.unmapped++; return; }
    if (!byAsset.has(assetId)) byAsset.set(assetId, new Map());
    const days = byAsset.get(assetId);
    const existing = days.get(date);
    const types = logTypeBits(log) | (existing ? existing.types : 0);
    const rank = Math.max(bitsRank(logTypeBits(log)), existing && existing.rank ? existing.rank : 0);
    const file = logFile(log) || (existing ? existing.file : null);   // the day's paperwork, from whichever log has one
    // One marker per equipment and day: the loser is counted as a duplicate, not silently dropped, and the kind
    // of clean it recorded (and its paperwork) still count.
    if (existing && existing.via === 'id' && via === 'text') { existing.types = types; existing.rank = rank; existing.file = file; stats.duplicate++; return; }
    if (existing) { stats[existing.via]--; stats.duplicate++; }
    days.set(date, { log, via, types, rank, file });
    stats[via]++;
  });
  return { byAsset, unmapped, stats };
};

// BEGIN COMPLETION PERCENTAGES
// Every frequency letter on an equipment is one job per period: D one per day, MW and W one per Monday-to-Sunday week,
// M one per calendar month, Q one per calendar quarter, A one per calendar year. A job is done when the equipment has a
// clean of at least that kind (the medallion's ranks) dated inside its period, missed when every month the period
// touches has been read for the equipment and there is none, and left out while a month is unread.
//  - a day cell shows the Daily jobs of that day, a Sunday cell every job of that Monday-to-Sunday week (the daily jobs
//    of its days and the mid-week and weekly ones);
//  - the top figures count the jobs whose period ended inside the months on screen / in the year so far; a period that is
//    still running counts only once done, so nothing is called missed before its time is up.
// The Daily jobs are counted per month (every equipment that has read a month has one on each of its days) and per log, not
// per equipment and day, which keeps a recompute cheap with thousands of equipment.
// Which jobs exist depends on the line the equipment belongs to (see LINE RULES): a Daily job falls due only on a day the
// line had downtime, a weekend the line was down needs one Daily job for both days, and the mid-week and weekly jobs
// count only in a week the line ran. Equipment no line claims keeps the plain rule (a Daily job every day, a weekly job
// every week), which is also what every figure uses until the production plan has been read.
const PCT_GOOD = 90;   // a figure at or above this is green, at or above PCT_WARN yellow, below that red
const PCT_WARN = 70;
const JOBS_NOTE = 'A job is one cleaning letter (D, MW, W, M, Q, A) of one equipment for one period: D per day, MW and W per week, M per month, Q per quarter, A per year. The day and Sunday cells show only the daily, mid-week and weekly jobs; this figure also counts the monthly, quarterly and annual ones. ';
const DAILY_ON = [true, true, true, true, true, true, true];   // Sunday to Saturday: the days on which a Daily (D) job falls due

// A month is read for an equipment once its id slice is in (with the id column) and its name slice is in too: old
// entries whose stored id is blank or wrong arrive only through the name request. Without the id column the name
// slice is all there is.
const monthIsRead = (loaded, idColumn, id, name, y, m) => (idColumn ? loaded.has(`id|${y}|${m}|${id}`) : !!name) && (!name || loaded.has(`name|${y}|${m}|${name}`));

// Whole percent; 100 only when every job is done, 0 only when none is.
const pctOf = (done, due) => !due ? null : done >= due ? 100 : Math.min(99, Math.max(done > 0 ? 1 : 0, Math.round(100 * done / due)));
const pctTone = (pct) => pct === null ? 'none' : pct >= PCT_GOOD ? 'good' : pct >= PCT_WARN ? 'warn' : 'bad';

// bucketsOf(asset, index) is optional: it names the groups (a room, an area) an equipment belongs to, and every figure that
// moves for the equipment moves for each of its groups too (perKey), so a room's or an area's figure comes out of the same
// pass as the top figures instead of a pass of its own.
const computeCompletion = ({ assets, byAsset, loaded, idColumn, year, today, visibleMonths, rules, bucketsOf }) => {
  const todayStr = normalizeDateStr(today);
  const todayYear = today.getFullYear();
  const dayOf = (y, m, d) => normalizeDateStr(new Date(y, m, d));
  const tfMonth = {};
  visibleMonths.forEach(m => { tfMonth[m] = true; });

  // Every day from the Monday on or before 1 January to the Sunday on or after 31 December, so no week is cut short.
  const first = new Date(year, 0, 1);
  first.setDate(first.getDate() - ((first.getDay() + 6) % 7));
  const last = new Date(year, 11, 31);
  last.setDate(last.getDate() + ((7 - last.getDay()) % 7));
  const days = [], dayIndex = {};
  // One new Date per day: stepping a timestamp forward by a day can land on 01:00 where a clock change skips midnight,
  // which would drop the last day and leave a short week.
  const nDays = Math.round((last.getTime() - first.getTime()) / 864e5) + 1;
  for (let n = 0; n < nDays; n++) {
    const c = new Date(first.getFullYear(), first.getMonth(), first.getDate() + n);
    const date = normalizeDateStr(c);
    dayIndex[date] = days.length;
    days.push({ date, y: c.getFullYear(), m: c.getMonth(), k: c.getFullYear() * 12 + c.getMonth(), dow: c.getDay(), inYear: c.getFullYear() === year, week: Math.floor(days.length / 7), future: date > todayStr, closed: date < todayStr, due: 0, done: 0, all: 0, wkend: 0 });
  }
  const weeks = [];
  for (let w = 0; w * 7 < days.length; w++) {
    const mon = days[w * 7], sun = days[w * 7 + 6];
    const touched = [], seen = {};
    for (let i = w * 7; i < w * 7 + 7; i++) {   // the months this week reaches, up to today
      const d = days[i];
      if (d.future) break;
      const k = d.y * 12 + d.m;
      if (!seen[k]) { seen[k] = true; touched.push([d.y, d.m]); }
    }
    weeks.push({ monday: mon.date, sunday: sun.date, started: !mon.future, closed: sun.date < todayStr, inYear: sun.inYear, inTf: sun.inYear && !!tfMonth[sun.m], touched, due: 0, done: 0, all: 0 });
  }
  // Equipment is judged by the calendar of its group (the line or lines whose area it is in, '' for no line): which days have
  // a Daily job of their own, which weekends have one job for both days, and which weeks count the mid-week and weekly jobs.
  // The days a Daily job can fall on (up to today) are counted per calendar month in each group: every equipment of the group
  // that has read a month has one job on each of them, so the cells and the top figures take it from these counts instead of
  // walking the days once per equipment.
  const groups = new Map();
  const groupFor = (key) => {
    let g = groups.get(key);
    if (g) return g;
    const cal = key && rules ? rules.build(key, days, weeks) : lrOldRule(days, weeks);
    const mInfo = {}, mKeys = [];
    days.forEach((d, i) => {
      if (d.future || cal.kind[i] !== 1) return;
      let o = mInfo[d.k];
      if (!o) { o = mInfo[d.k] = { y: d.y, m: d.m, closed: 0, inYear: d.inYear, inTf: d.inYear && !!tfMonth[d.m] }; mKeys.push(d.k); }
      if (d.closed) o.closed += 1;
    });
    g = { key: key, cal: cal, mInfo: mInfo, mKeys: mKeys, dRead: {}, nJobs: { D: 0, MW: 0, W: 0 } };
    groups.set(key, g);
    return g;
  };
  const months = [];
  for (let m = 0; m < 12; m++) months.push({ started: dayOf(year, m, 1) <= todayStr, closed: dayOf(year, m + 1, 0) < todayStr, inTf: !!tfMonth[m], touched: [[year, m]] });
  const tfDue = visibleMonths.filter(m => months[m].started);
  const quarters = [];
  for (let q = 0; q < 4; q++) {
    const touched = [];
    for (let m = q * 3; m < q * 3 + 3; m++) if (months[m].started) touched.push([year, m]);
    quarters.push({ started: months[q * 3].started, closed: months[q * 3 + 2].closed, inTf: !!tfMonth[q * 3 + 2], touched });
  }
  const yearTouched = [];
  for (let m = 0; m < 12; m++) if (months[m].started) yearTouched.push([year, m]);
  const wholeYear = { started: months[0].started, closed: months[11].closed, inTf: !!tfMonth[11], touched: yearTouched };

  const tf = { due: 0, done: 0 }, ytd = { due: 0, done: 0 };
  const nJobs = { D: 0, MW: 0, W: 0, M: 0, Q: 0, A: 0 };
  const ids = [];
  let readTf = 0, readYtd = 0;
  const perKey = {};
  let cur = [];   // the groups of the equipment being walked
  const bucket = (k) => perKey[k] || (perKey[k] = { tf: { due: 0, done: 0 }, ytd: { due: 0, done: 0 }, equipment: 0, readTf: 0, readYtd: 0 });
  // The one place the top figures move: the year to date, the months on screen when inTf, and the same for each group.
  const bump = (inTf, due, done) => {
    ytd.due += due; ytd.done += done;
    if (inTf) { tf.due += due; tf.done += done; }
    for (let ci = 0; ci < cur.length; ci++) {
      const b = cur[ci];
      b.ytd.due += due; b.ytd.done += done;
      if (inTf) { b.tf.due += due; b.tf.done += done; }
    }
  };
  const endM = year < todayYear ? 11 : year === todayYear ? today.getMonth() : -1;   // last month of the year so far
  const reachesPrev = first.getFullYear() < year;   // the first week starts in December of the year before: its jobs need that month read
  // A job that can be judged: it goes to its day or week cell, and to the top figures once its period is over (or done).
  const settle = (done, closed, inYear, inTf, cellA, cellB) => {
    if (cellA) { cellA.due += 1; if (done) cellA.done += 1; }
    if (cellB) { cellB.due += 1; if (done) cellB.done += 1; }
    if (inYear && (done || closed)) bump(inTf, 1, done ? 1 : 0);
  };
  const weekMax = [], monthMax = [], quarterMax = [];

  assets.forEach((asset, ai) => {
    const id = getAssetId(asset);
    const name = safeString(getProp(asset, 'craa5_equipmentidentifier')).trim().toLowerCase();
    if (!id || (!idColumn && !name)) return;   // nothing could ever be asked for it
    const freqs = FREQS.filter(f => f.flags.some(c => isTrue(asset[c])));
    if (!freqs.length) return;
    ids.push(id);
    cur = bucketsOf ? bucketsOf(asset, ai).map(bucket) : [];
    for (let ci = 0; ci < cur.length; ci++) cur[ci].equipment += 1;
    const g = groupFor(rules ? rules.groupOf(asset) : '');
    freqs.forEach(f => { nJobs[f.code] += 1; if (g.nJobs[f.code] !== undefined) g.nJobs[f.code] += 1; });
    const rm = {};
    const isRead = (y, m) => { const k = y * 12 + m; if (rm[k] === undefined) rm[k] = monthIsRead(loaded, idColumn, id, name, y, m); return rm[k]; };
    const touchedRead = (touched) => touched.every(t => isRead(t[0], t[1]));
    if (tfDue.every(m => isRead(year, m))) { readTf += 1; for (let ci = 0; ci < cur.length; ci++) cur[ci].readTf += 1; }   // a month that has not started has nothing to read
    {
      let all = true;
      if (endM >= 0) {
        if (reachesPrev && !isRead(year - 1, 11)) all = false;
        for (let m = 0; m <= endM && all; m++) if (!isRead(year, m)) all = false;
      }
      if (all) { readYtd += 1; for (let ci = 0; ci < cur.length; ci++) cur[ci].readYtd += 1; }
    }
    const logged = byAsset.get(id);
    let any = !!logged;
    for (let m = 0; m < 12 && !any; m++) if (isRead(year, m)) any = true;
    if (!any && (isRead(year - 1, 11) || isRead(year + 1, 0))) any = true;
    if (!any) return;   // nothing read and nothing logged: none of its jobs can be judged yet

    // The best kind of clean (rank) logged in each week, month and quarter, and in the year.
    for (let i = 0; i < weeks.length; i++) weekMax[i] = 0;
    for (let i = 0; i < 12; i++) monthMax[i] = 0;
    for (let i = 0; i < 4; i++) quarterMax[i] = 0;
    let yearMax = 0;
    if (logged) logged.forEach((entry, date) => {
      const i = dayIndex[date];
      if (i === undefined) return;
      const d = days[i];
      if (d.future) return;
      const r = entryRank(entry);
      if (r > weekMax[d.week]) weekMax[d.week] = r;
      if (d.inYear) {
        if (r > monthMax[d.m]) monthMax[d.m] = r;
        const q = Math.floor(d.m / 3);
        if (r > quarterMax[q]) quarterMax[q] = r;
        if (r > yearMax) yearMax = r;
      }
    });

    freqs.forEach(f => {
      if (f.code === 'D') {
        // a month read for this equipment gives it one Daily job on each day of that month the group counts (a day with
        // downtime): judged (and counted in the top figures once the day is over) whether or not a log exists
        for (let q = 0; q < g.mKeys.length; q++) {
          const o = g.mInfo[g.mKeys[q]];
          if (!isRead(o.y, o.m)) continue;
          g.dRead[g.mKeys[q]] = (g.dRead[g.mKeys[q]] || 0) + 1;
          if (o.inYear) bump(o.inTf, o.closed, 0);
        }
        // a log on a day is a done job; when its month was not read for this equipment, or the day is not over, it
        // is not in those counts yet. A log on a day with no Daily job of its own is no job at all.
        if (logged) logged.forEach((entry, date) => {
          const i = dayIndex[date];
          if (i === undefined) return;
          const d = days[i];
          if (d.future || g.cal.kind[i] !== 1) return;
          const counted = d.closed && isRead(d.y, d.m);
          const wk = weeks[d.week];
          d.done += 1; wk.done += 1;
          if (!isRead(d.y, d.m)) { d.due += 1; wk.due += 1; }
          if (d.inYear) bump(!!tfMonth[d.m], counted ? 0 : 1, 1);
        });
        // the weekend jobs: one for Saturday and Sunday together, on the Sunday, done by a clean on either day. Judged
        // once done, or once every month its days touch has been read for this equipment.
        g.cal.jobs.forEach(job => {
          const at = days[job.at];
          if (at.future) return;
          let done = false, readAll = true;
          job.cover.forEach(c => {
            const dc = days[c];
            if (dc.future) return;
            if (logged && logged.has(dc.date)) done = true;
            if (!isRead(dc.y, dc.m)) readAll = false;
          });
          if (!done && !readAll) return;
          at.wkend += 1;
          settle(done, at.closed, at.inYear, at.inYear && !!tfMonth[at.m], at, weeks[at.week]);
        });
      } else if (f.code === 'MW' || f.code === 'W') {
        weeks.forEach((wk, w) => {
          if (!wk.started || !g.cal.weekOn[w]) return;   // a week the line did not run has no weekly job
          const done = weekMax[w] >= f.rank;
          if (!done && !touchedRead(wk.touched)) return;
          settle(done, wk.closed, wk.inYear, wk.inTf, wk, null);
        });
      } else if (f.code === 'M') {
        months.forEach((mo, m) => {
          if (!mo.started) return;
          const done = monthMax[m] >= f.rank;
          if (!done && !touchedRead(mo.touched)) return;
          settle(done, mo.closed, true, mo.inTf, null, null);
        });
      } else if (f.code === 'Q') {
        quarters.forEach((qu, q) => {
          if (!qu.started) return;
          const done = quarterMax[q] >= f.rank;
          if (!done && !touchedRead(qu.touched)) return;
          settle(done, qu.closed, true, qu.inTf, null, null);
        });
      } else if (wholeYear.started) {
        const done = yearMax >= f.rank;
        if (done || touchedRead(wholeYear.touched)) settle(done, wholeYear.closed, true, wholeYear.inTf, null, null);
      }
    });
  });

  groups.forEach(g => {
    days.forEach((d, i) => {
      if (d.future || g.cal.kind[i] !== 1) return;
      const n = g.dRead[d.k];
      if (n) { d.due += n; weeks[d.week].due += n; }
    });
  });
  // How many jobs each cell would have if every equipment were read: what is left out of it is "not read yet".
  groups.forEach(g => {
    weeks.forEach((wk, w) => { if (wk.started && g.cal.weekOn[w]) wk.all += g.nJobs.MW + g.nJobs.W; });
    days.forEach((d, i) => {
      const k = g.cal.kind[i];
      if (d.future || (k !== 1 && k !== 3)) return;
      d.all += g.nJobs.D;
      weeks[d.week].all += g.nJobs.D;
    });
  });
  let byLines = false;   // some equipment is in an area a line follows
  groups.forEach((g, key) => { if (key) byLines = true; });
  return { year, todayStr, days, weeks, dayIndex, tf, ytd, equipment: ids.length, readTf, readYtd, ids, endM, nJobs, reachesPrev, groups: groups.size, byLines, perKey };
};

// "7 Sep" from "2026-09-07".
const shortDate = (date) => `${Number(date.slice(8, 10))} ${MONTHS[Number(date.slice(5, 7)) - 1].slice(0, 3)}`;

// Counts that have to fit a day column: 950 stays as it is, 1,250 becomes 1.3k.
const fmtCount = (n) => n < 1000 ? String(n) : n < 10000 ? (Math.round(n / 100) / 10) + 'k' : Math.round(n / 1000) + 'k';

// The rows under the day headers, one cell per day on screen: done % of that day's Daily jobs and how many of them are not
// done, and on a Sunday done % of that Monday-to-Sunday week and how many of its jobs are not done. A cell is blank when
// nothing could be judged, italic grey while its day or week is not over, and dotted when part of what it covers is not
// read yet. The not-done cells take the colour of the percentage next to them.
const completionCells = (comp, timelineDays) => {
  const dayCells = [], weekCells = [], dayNot = [], weekNot = [];
  const blank = () => ({ pct: null, cls: '', text: '', title: '' });
  timelineDays.forEach(td => {
    const i = comp.dayIndex[td.dateStr];
    const d = i === undefined ? null : comp.days[i];
    let dayCell = blank(), weekCell = blank(), dayN = blank(), weekN = blank();
    if (d) {
      const pct = pctOf(d.done, d.due);
      if (pct !== null) {
        const open = !d.closed, part = d.due < d.all, miss = Math.max(0, d.due - d.done);
        const cls = `${open ? 'open' : pctTone(pct)}${part ? ' part' : ''}`;
        const day = `${td.label} ${td.month.slice(0, 3)}`;
        dayCell = {
          pct, text: String(pct), cls,
          title: `${day} · ${d.done} of ${d.due} daily jobs done (${pct}%)${d.wkend ? ` · ${d.wkend} of them the one Daily job for the whole weekend (done by a clean on Saturday or Sunday)` : ''}${miss ? ` · ${miss} not done${open ? ' yet' : ''}` : ''}${part ? ` · ${d.all - d.due} not read yet` : ''}${open ? ' · the day is not over' : ''}`
        };
        dayN = {
          pct: null, n: miss, text: fmtCount(miss), cls,
          title: `${day} · ${miss} of ${d.due} scheduled daily jobs not done${open ? ' yet' : ''}${part ? ` · ${d.all - d.due} not read yet` : ''}${open ? ' · the day is not over' : ''}`
        };
      }
      if (d.dow === 0) {
        const wk = comp.weeks[d.week];
        const wpct = pctOf(wk.done, wk.due);
        if (wpct !== null) {
          const open = !wk.closed, part = wk.due < wk.all, miss = Math.max(0, wk.due - wk.done);
          const cls = `${open ? 'open' : pctTone(wpct)}${part ? ' part' : ''}`;
          const wkText = `Week ${td.week}, ${shortDate(wk.monday)} to ${shortDate(wk.sunday)}`;
          weekCell = {
            pct: wpct, text: String(wpct), cls,
            title: `${wkText} · ${wk.done} of ${wk.due} jobs done (${wpct}%): the daily jobs of each day and the mid-week and weekly ones${miss ? ` · ${miss} not done${open ? ' yet' : ''}` : ''}${part ? ` · ${wk.all - wk.due} not read yet` : ''}${open ? ' · the week is not over' : ''}`
          };
          weekN = {
            pct: null, n: miss, text: fmtCount(miss), cls,
            title: `${wkText} · ${miss} of the ${wk.due} jobs due${open ? ' so far' : ''} not done${open ? ' yet' : ''}: the daily jobs of each day and the mid-week and weekly ones${part ? ` · ${wk.all - wk.due} not read yet` : ''}${open ? ' · the week is not over' : ''}`
          };
        }
      }
    }
    if (td.isToday) [dayCell, weekCell, dayN, weekN].forEach(c => { c.cls = (c.cls + ' today').trim(); });
    dayCells.push(dayCell);
    weekCells.push(weekCell);
    dayNot.push(dayN);
    weekNot.push(weekN);
  });
  return { dayCells, weekCells, dayNot, weekNot };
};

// A room's or area's figure for the slicer timeframe, from computeCompletion run over just its equipment: the jobs scheduled
// (due), done and not done, the percentage, and how much of it was read (months not read are left out, not counted as missed).
const groupFigure = (comp) => {
  const tf = comp.tf, ytd = comp.ytd;
  return {
    pct: pctOf(tf.done, tf.due), due: tf.due, done: tf.done, miss: Math.max(0, tf.due - tf.done),
    ytdPct: pctOf(ytd.done, ytd.due), ytdDue: ytd.due, ytdDone: ytd.done,
    equipment: comp.equipment, read: comp.readTf, partial: comp.equipment > 0 && comp.readTf < comp.equipment
  };
};
// The key of a room's or an area's group in computeCompletion's perKey (prefixed, so a room named like an area cannot collide).
const figKey = (room, area) => area === undefined ? 'r' + room : 'a' + room + '\u0001' + area;
// END COMPLETION PERCENTAGES

// ============================================================================
// BEGIN LINE DOWNTIME
// A line is one production line, named the way the production schedule names it: an area plus a line number
// (craa5_area and craa5_line). Until the production schedule feeds this tab, two kinds of down day are kept by hand:
//   Scheduled     weekdays on which the line is down every week.
//   Off schedule  date ranges (one day is a range of one) on which it is down besides.
// A line is down on a day when either says so (dtStatus). Saved in this browser only; nothing is written to Dataverse.
// Days are plain YYYY-MM-DD text and are turned into dates one at a time with new Date(y, m, d), so a clock change
// cannot move one.
// ============================================================================
const DOWNTIME_KEY = 'mss_line_downtime_v1';
const DT_MAX_RANGE_DAYS = 366;                 // one off-schedule range covers at most a year
const DT_MAX_AREAS = 24;                       // MSS areas listed on one line
const DT_STRIP_WEEKS = 5;                      // weeks shown in each line's preview
const DT_WEEKDAYS = [                          // Monday first, as the week runs everywhere else on this page; dow is Date.getDay()
  { dow: 1, short: 'Mon', name: 'Monday' }, { dow: 2, short: 'Tue', name: 'Tuesday' }, { dow: 3, short: 'Wed', name: 'Wednesday' },
  { dow: 4, short: 'Thu', name: 'Thursday' }, { dow: 5, short: 'Fri', name: 'Friday' }, { dow: 6, short: 'Sat', name: 'Saturday' },
  { dow: 0, short: 'Sun', name: 'Sunday' }
];
const dtPad = (n) => (n < 10 ? '0' : '') + n;
const dtYmd = (d) => d.getFullYear() + '-' + dtPad(d.getMonth() + 1) + '-' + dtPad(d.getDate());
// A real day written YYYY-MM-DD (years 2000 to 2100) as a local Date, or null (blank, half typed, 31 February...).
const dtParse = (s) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(typeof s === 'string' ? s : '');
  if (!m) return null;
  const y = Number(m[1]), mo = Number(m[2]) - 1, d = Number(m[3]);
  if (y < 2000 || y > 2100) return null;
  const date = new Date(y, mo, d);
  return date.getFullYear() === y && date.getMonth() === mo && date.getDate() === d ? date : null;
};
const dtAddDays = (ymd, n) => { const d = dtParse(ymd); return d ? dtYmd(new Date(d.getFullYear(), d.getMonth(), d.getDate() + n)) : ''; };
const dtDow = (ymd) => { const d = dtParse(ymd); return d ? d.getDay() : -1; };
const dtMonday = (ymd) => { const d = dtParse(ymd); return d ? dtYmd(new Date(d.getFullYear(), d.getMonth(), d.getDate() - ((d.getDay() + 6) % 7))) : ''; };
// Calendar days from a to b, both included (a to a is 1); 0 when either is not a day.
const dtSpan = (a, b) => {
  const x = dtParse(a), y = dtParse(b);
  return x && y ? Math.round((Date.UTC(y.getFullYear(), y.getMonth(), y.getDate()) - Date.UTC(x.getFullYear(), x.getMonth(), x.getDate())) / 86400000) + 1 : 0;
};
const dtCollapse = (s) => String(s == null ? '' : s).replace(/\s+/g, ' ').trim();
const dtSame = (l, area, n) => l.line === n && l.area.toLowerCase() === dtCollapse(area).toLowerCase();
const dtLineSort = (a, b) => a.area.toLowerCase().localeCompare(b.area.toLowerCase()) || a.line - b.line;
const dtByFrom = (a, b) => (a.from < b.from ? -1 : a.from > b.from ? 1 : a.to < b.to ? -1 : a.to > b.to ? 1 : 0);
let dtSeq = 0;
const dtId = () => 'l' + (++dtSeq).toString(36) + Math.random().toString(36).slice(2, 8);

// Why a line is down on a day: 'sched' (a scheduled weekday), 'off' (inside an off-schedule range), 'both', or ''
// (running). The production schedule will become one more source here later; a day is down when any source says so.
const dtStatus = (line, ymd, dow) => {
  const wd = dow === undefined ? dtDow(ymd) : dow;
  const sched = wd >= 0 && line.days.indexOf(wd) > -1;
  let off = false;
  for (let i = 0; i < line.off.length && !off; i++) off = line.off[i].from <= ymd && ymd <= line.off[i].to;
  return sched ? (off ? 'both' : 'sched') : (off ? 'off' : '');
};

// What was stored, made safe to use: anything malformed is dropped, never guessed at.
const dtClean = (raw) => {
  const src = raw && Array.isArray(raw.lines) ? raw.lines : [];
  const out = [];
  src.forEach((l) => {
    if (!l || typeof l !== 'object') return;
    const area = dtCollapse(typeof l.area === 'string' ? l.area : '').slice(0, 80);
    const n = typeof l.line === 'number' || typeof l.line === 'string' ? Math.floor(Number(l.line)) : 0;
    if (!area || !(n >= 1 && n <= 99) || out.some(o => dtSame(o, area, n))) return;
    const days = [];
    (Array.isArray(l.days) ? l.days : []).forEach((d) => { if (typeof d === 'number' && d % 1 === 0 && d >= 0 && d <= 6 && days.indexOf(d) < 0) days.push(d); });
    const off = [];
    (Array.isArray(l.off) ? l.off : []).forEach((r) => {
      const a = r && dtParse(r.from) ? dtYmd(dtParse(r.from)) : '';
      const b = r && dtParse(r.to) ? dtYmd(dtParse(r.to)) : '';
      if (a && b && a <= b && dtSpan(a, b) <= DT_MAX_RANGE_DAYS && !off.some(o => o.from === a && o.to === b)) off.push({ from: a, to: b });
    });
    off.sort(dtByFrom);
    const areas = [];       // the MSS areas whose equipment follow this line (blank: the area of the line itself)
    (Array.isArray(l.areas) ? l.areas : []).forEach((a) => {
      const t = dtCollapse(typeof a === 'string' ? a : '').slice(0, 80), k = normalizeName(t);
      if (t && k && areas.length < DT_MAX_AREAS && !areas.some(x => normalizeName(x) === k)) areas.push(t);
    });
    out.push({ id: typeof l.id === 'string' && l.id ? l.id.slice(0, 40) : dtId(), area: area, line: n, days: days, off: off, areas: areas });
  });
  return out;
};

// Text for the screen.
const dtDayName = (ymd, withWeekday) => {
  const d = dtParse(ymd);
  if (!d) return '';
  const wd = DT_WEEKDAYS.filter(w => w.dow === d.getDay())[0];
  return (withWeekday ? wd.short + ' ' : '') + d.getDate() + ' ' + MONTHS[d.getMonth()].slice(0, 3);
};
// "Mon 12 Oct 2026", or "Mon 12 Oct – Wed 14 Oct 2026" (each end carries its year when the range crosses a year).
const dtRangeText = (from, to) => {
  const a = dtParse(from), b = dtParse(to);
  if (!a || !b) return '';
  if (from === to) return dtDayName(from, true) + ' ' + a.getFullYear();
  return a.getFullYear() === b.getFullYear()
    ? dtDayName(from, true) + ' – ' + dtDayName(to, true) + ' ' + b.getFullYear()
    : dtDayName(from, true) + ' ' + a.getFullYear() + ' – ' + dtDayName(to, true) + ' ' + b.getFullYear();
};
// "Saturday and Sunday", "Monday, Tuesday and Friday", "" for none.
const dtDaysText = (days) => {
  const names = DT_WEEKDAYS.filter(w => days.indexOf(w.dow) > -1).map(w => w.name);
  return names.length < 2 ? names.join('') : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];
};
// The days of a preview: `weeks` weeks of seven, from the Monday `start`.
const dtStripDays = (start, weeks) => {
  const s = dtParse(start), out = [];
  if (!s) return out;
  for (let i = 0; i < weeks * 7; i++) {
    const d = new Date(s.getFullYear(), s.getMonth(), s.getDate() + i);
    out.push({ ymd: dtYmd(d), dow: d.getDay(), day: d.getDate(), month: d.getMonth() });
  }
  return out;
};
// Area names on the equipment loaded by Sync, for the Area box to suggest (any name can still be typed).
const dtAreaNames = (assets) => {
  const seen = new Set(), out = [];
  (assets || []).forEach((a) => {
    const n = dtCollapse(safeString(getProp(a, 'craa5_areaname'))), k = n.toLowerCase();
    if (n && !seen.has(k)) { seen.add(k); out.push(n); }
  });
  return out.sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
};
// The line number the Line box offers for the area typed: one more than the highest already listed for that area, 1 for a new area.
const dtNextNo = (lines, area) => {
  const k = dtCollapse(area).slice(0, 80).toLowerCase();
  let top = 0;
  lines.forEach((l) => { if (l.area.toLowerCase() === k && l.line > top) top = l.line; });
  return Math.min(99, top + 1);
};
// A date box holding a date that is unfinished (10/14/yyyy) or does not exist (31 September) reports value '' with
// validity.badInput, so the state alone cannot tell it from an empty box.
const dtUnreadable = (el) => !!(el && el.validity && el.validity.badInput);
// Chrome keeps 10/15/26 as year 0026: say so when a refused date has a year outside 2000 to 2100.
const dtYearNote = (v) => {
  const y = typeof v === 'string' ? v.split('-')[0] : '';
  return /^\d+$/.test(y) && (Number(y) < 2000 || Number(y) > 2100) ? ' The year must be 2000 to 2100 (the box shows ' + y + ').' : '';
};

// Browser storage may be missing or refuse writes (private window, a locked-down host): then the days last only
// until the page closes, and the tab says so.
const dtLoad = () => {
  try { const raw = window.localStorage.getItem(DOWNTIME_KEY); return raw ? dtClean(JSON.parse(raw)) : []; } catch (e) { return []; }
};
const dtStore = (lines) => {
  try { window.localStorage.setItem(DOWNTIME_KEY, JSON.stringify({ v: 2, lines: lines })); return true; } catch (e) { return false; }
};
const dtCanStore = () => {
  try { window.localStorage.setItem(DOWNTIME_KEY + '_probe', '1'); window.localStorage.removeItem(DOWNTIME_KEY + '_probe'); return true; } catch (e) { return false; }
};
// END LINE DOWNTIME

// ============================================================================
// BEGIN LINE RULES
// Which cleaning jobs count in the completion figures, line by line, from the production plan (the rows of craa5__aa_prd_schd,
// which the Production Schedule hub fills from the weekly Excel plan). The gaps between a line's runs are its sanitation windows.
//  - A Daily job falls due on a day the line has downtime: LR_DOWN_MIN minutes or more of that day without production.
//  - A weekend the line was down (less than LR_WEEKEND_RAN_MIN minutes of production on Saturday and Sunday together) needs one
//    Daily job for both days. It sits on the Sunday, where it ends, and a clean on either day does it.
//  - A mid-week or weekly job falls due in a Monday-to-Sunday week only when the line produced at least LR_RAN_WEEK_MIN minutes
//    in it. Monthly, quarterly and annual jobs are not touched.
// A line is the area and line number the plan names (craa5_area, craa5_line). Its equipment are the ones in the MSS areas listed
// for it on the Line Downtime tab (the area with the line's own name until a list is set). Equipment in any other area keep the
// old rule: a Daily job every day, a weekly job every week. A week with no plan row for any line is left out for the lines the
// plan has, like a month not read yet. A plan row whose product name has "maint" in it is maintenance: downtime, not production.
// Off-schedule ranges of the Line Downtime tab take production away on their days. The Scheduled weekdays stand in for the plan
// only for a line the plan does not have. Days are local days (a day is 23 or 25 hours long when the clocks change).
// ============================================================================
const LR_DOWN_MIN = 60;            // minutes of a day without production that make it a day with downtime
const LR_RAN_WEEK_MIN = 60;        // minutes of production in a Monday-to-Sunday week that make it a week the line ran
const LR_WEEKEND_RAN_MIN = 720;    // a weekend with less production than this (Saturday and Sunday together) is a down weekend
const LR_MAINT = /maint/i;
const LR_MAX_RUN_DAYS = 31;        // a plan row longer than this is a mistyped end date: left out and counted (long)
const LR_SEP = '\u0001';           // joins the line keys of a group; cannot occur in an area name typed by hand

const lrKey = (area, n) => dtCollapse(area).toLowerCase() + '|' + n;
const lrLocal = (ymd) => new Date(Number(ymd.slice(0, 4)), Number(ymd.slice(5, 7)) - 1, Number(ymd.slice(8, 10)));
const lrNextDay = (ymd) => { const d = lrLocal(ymd); return new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1).getTime(); };
const lrMondayYmd = (ms) => { const d = new Date(ms); return dtYmd(new Date(d.getFullYear(), d.getMonth(), d.getDate() - ((d.getDay() + 6) % 7))); };
// Overlapping or touching [from, to) pieces joined, in order.
const lrMerge = (iv) => {
  const out = [];
  iv.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]).forEach((x) => {
    const last = out[out.length - 1];
    if (last && x[0] <= last[1]) { if (x[1] > last[1]) last[1] = x[1]; } else out.push([x[0], x[1]]);
  });
  return out;
};

// One row of the plan table as a run, or null when it cannot be used (no area, no usable start and end).
const lrRunFromRow = (row) => {
  const area = dtCollapse(safeString(getRaw(row, 'craa5_area')));
  const n = Math.floor(Number(getRaw(row, 'craa5_line')));          // a blank line number is line 1, as in the Production Schedule hub
  const s = Date.parse(getRaw(row, 'craa5_datestarttime')), e = Date.parse(getRaw(row, 'craa5_dateendtime'));
  if (!area || !(s > 0) || !(e > s)) return null;
  return { area: area, line: n >= 1 ? n : 1, start: s, end: e, maint: LR_MAINT.test(safeString(getRaw(row, 'craa5_product'))) };
};

// The plan as the rules use it: for every line its production as merged [start, end) pieces, and every Monday-to-Sunday week
// (by its Monday, YYYY-MM-DD) that has at least one plan row on any line. Rows longer than LR_MAX_RUN_DAYS are left out.
const buildPlanModel = (runs) => {
  const lines = new Map(), weekHas = {};
  let used = 0, long = 0;
  (runs || []).forEach((r) => {
    if (r.end - r.start > LR_MAX_RUN_DAYS * 864e5) { long += 1; return; }
    used += 1;
    const key = lrKey(r.area, r.line);
    let L = lines.get(key);
    if (!L) { L = { key: key, area: r.area, line: r.line, iv: [], rows: 0, first: r.start, last: r.end }; lines.set(key, L); }
    L.rows += 1;
    if (r.start < L.first) L.first = r.start;
    if (r.end > L.last) L.last = r.end;
    if (!r.maint) L.iv.push([r.start, r.end]);
    let mon = lrMondayYmd(r.start);
    for (let guard = 0; guard < 8 && mon; guard++) {
      weekHas[mon] = true;
      mon = dtAddDays(mon, 7);
      if (!mon || lrLocal(mon).getTime() >= r.end) break;
    }
  });
  lines.forEach((L) => { L.iv = lrMerge(L.iv); });
  return { lines: lines, weekHas: weekHas, rows: used, long: long };
};

// The rule for equipment no line claims: a Daily job on every day DAILY_ON allows, a weekly job in every week.
const lrOldRule = (days, weeks) => {
  const kind = [], weekOn = [];
  days.forEach((d) => { kind.push(DAILY_ON[d.dow] ? 1 : 0); });
  weeks.forEach(() => { weekOn.push(1); });
  return { kind: kind, jobs: [], weekOn: weekOn, prod: null, planned: null, len: null };
};
// Down on a day because of what was typed on the Line Downtime tab (an off-schedule range, or a scheduled weekday).
const lrManualOff = (rec, date) => !!(rec.manual && rec.manual.off.some((o) => o.from <= date && date <= o.to));
const lrManualDown = (rec, date, dow) => !!(rec.manual && (rec.manual.days.indexOf(dow) > -1 || lrManualOff(rec, date)));

// rules = { groupOf(asset) -> group key ('' = no line claims the asset's area), build(group, days, weeks) -> calendar, recs }.
// plan comes from buildPlanModel, lines are the ones kept on the Line Downtime tab.
// A calendar, aligned with days (each { date: 'YYYY-MM-DD', dow }) and weeks (each { monday }; seven days each, Monday first):
//   kind[i]    0 no Daily job that day, 1 a Daily job of its own, 3 the Sunday that carries the weekend's one Daily job, 2 the Saturday it covers
//   jobs       [{ at, cover: [day indexes] }] the weekend jobs: the job sits on day `at` and a clean on any covered day does it
//   weekOn[w]  1 when mid-week and weekly jobs count in week w
//   prod[i]    minutes of production that day, len[i] minutes in the day, planned[w] true when the plan is known for that week (all null for the old rule)
const buildLineRules = ({ plan, lines }) => {
  const recs = new Map();
  plan.lines.forEach((m) => { recs.set(m.key, { key: m.key, area: m.area, line: m.line, model: m, manual: null }); });
  (lines || []).forEach((l) => {
    const key = lrKey(l.area, l.line), r = recs.get(key);
    if (r) r.manual = l; else recs.set(key, { key: key, area: l.area, line: l.line, model: null, manual: l });
  });
  // normalized MSS area name -> keys of the lines that claim it (only lines the plan has, or with scheduled / off-schedule days)
  const areaTo = new Map();
  recs.forEach((r) => {
    const m = r.manual;
    if (!r.model && !(m && (m.days.length || m.off.length))) return;
    (m && m.areas && m.areas.length ? m.areas : [r.area]).forEach((name) => {
      const k = normalizeName(name);
      if (!k) return;
      const list = areaTo.get(k) || [];
      if (list.indexOf(r.key) < 0) list.push(r.key);
      areaTo.set(k, list);
    });
  });
  const groupByArea = new Map();
  areaTo.forEach((list, k) => { groupByArea.set(k, list.slice().sort().join(LR_SEP)); });
  const groupOf = (asset) => areaTo.size ? (groupByArea.get(normalizeName(safeString(getProp(asset, 'craa5_areaname')))) || '') : '';

  const buildOne = (key, days, weeks) => {
    if (!key) return lrOldRule(days, weeks);
    const n = days.length;
    if (!n) return { kind: [], jobs: [], weekOn: [], prod: [], planned: [], len: [] };
    const recsOf = key.split(LR_SEP).map((k) => recs.get(k)).filter(Boolean);
    const modeled = recsOf.filter((r) => r.model);
    const kind = [], weekOn = [], jobs = [], prod = [], planned = [], len = [];
    // the edges of every day: local midnights, so a day is 23 or 25 hours long when the clocks change
    const t0 = [];
    for (let i = 0; i < n; i++) t0.push(lrLocal(days[i].date).getTime());
    t0.push(lrNextDay(days[n - 1].date));
    for (let i = 0; i < n; i++) len.push((t0[i + 1] - t0[i]) / 60000);
    // production of the group: each plan line's runs less its off-schedule days, all lines together
    const pieces = [];
    modeled.forEach((r) => {
      const blocks = r.manual ? r.manual.off.map((o) => [lrLocal(o.from).getTime(), lrNextDay(o.to)]) : [];
      r.model.iv.forEach((x) => {
        let parts = [[x[0], x[1]]];
        blocks.forEach((b) => {
          const next = [];
          parts.forEach((p) => {
            if (b[1] <= p[0] || b[0] >= p[1]) next.push(p);
            else { if (p[0] < b[0]) next.push([p[0], b[0]]); if (b[1] < p[1]) next.push([b[1], p[1]]); }
          });
          parts = next;
        });
        parts.forEach((p) => { pieces.push(p); });
      });
    });
    const merged = lrMerge(pieces);
    let j = 0;
    for (let i = 0; i < n; i++) {
      const a = t0[i], b = t0[i + 1];
      while (j < merged.length && merged[j][1] <= a) j++;
      let sum = 0;
      for (let k = j; k < merged.length && merged[k][0] < b; k++) sum += Math.min(b, merged[k][1]) - Math.max(a, merged[k][0]);
      prod.push(sum / 60000);
      kind.push(0);
    }
    for (let w = 0; w < weeks.length; w++) {
      const base = w * 7;
      const known = modeled.length > 0 && !!plan.weekHas[weeks[w].monday];
      planned.push(known);
      let sat = false, sun = false;       // the weekend counts as down
      if (modeled.length > 0) {
        if (!known) { weekOn.push(0); continue; }                  // no plan for that week: nothing to judge
        let wk = 0;
        for (let d = 0; d < 7; d++) {
          const i = base + d;
          wk += prod[i];
          kind[i] = DAILY_ON[days[i].dow] && len[i] - prod[i] >= LR_DOWN_MIN ? 1 : 0;
        }
        weekOn.push(wk >= LR_RAN_WEEK_MIN ? 1 : 0);
        sat = sun = prod[base + 5] + prod[base + 6] < LR_WEEKEND_RAN_MIN;
      } else {
        // a line the plan does not have: every day and week counts, except what was typed on the Line Downtime tab
        let allDown = true;
        const down = [];
        for (let d = 0; d < 7; d++) {
          const i = base + d;
          const dn = recsOf.length > 0 && recsOf.every((r) => lrManualDown(r, days[i].date, days[i].dow));
          down.push(dn);
          if (!dn) allDown = false;
          kind[i] = DAILY_ON[days[i].dow] ? 1 : 0;
        }
        weekOn.push(allDown ? 0 : 1);
        sat = down[5]; sun = down[6];
      }
      const s = base + 5, u = base + 6;
      if (sat && sun && kind[s] === 1 && kind[u] === 1) { kind[s] = 2; kind[u] = 3; jobs.push({ at: u, cover: [s, u] }); }
    }
    return { kind: kind, jobs: jobs, weekOn: weekOn, prod: prod, planned: planned, len: len };
  };
  // the same calendar is asked for again and again (every recompute of the figures, every card of the Line Downtime tab)
  const cache = new Map();
  const build = (key, days, weeks) => {
    const ck = key + '\u0002' + (days.length ? days[0].date : '') + '\u0002' + days.length;
    let c = cache.get(ck);
    if (!c) { c = buildOne(key, days, weeks); cache.set(ck, c); }
    return c;
  };
  return { groupOf: groupOf, build: build, recs: recs, areaTo: areaTo };
};
// The calendar of one line for `weeks` weeks from the Monday `start`, with the days it is made from (for the preview).
const lrPreview = (rules, recKey, start, weeks) => {
  const s = dtParse(start), days = [], wk = [];
  if (!s) return null;
  for (let i = 0; i < weeks * 7; i++) {
    const c = new Date(s.getFullYear(), s.getMonth(), s.getDate() + i);
    days.push({ date: dtYmd(c), dow: c.getDay() });
  }
  for (let w = 0; w < weeks; w++) wk.push({ monday: days[w * 7].date });
  return { days: days, cal: rules.build(recKey, days, wk) };
};
// ---- what the Line Downtime tab shows, worked out here so it can be checked without the screen
// "14 h", "7.5 h", "40 min".
const lrHours = (min) => {
  if (min < 60) return Math.max(0, Math.round(min)) + ' min';
  const h = Math.round(min / 6) / 10;
  return (h % 1 === 0 ? String(h) : h.toFixed(1)) + ' h';
};
// The lines of the tab: every line of the plan, then the ones typed by hand that the plan does not have. `saved` is what was
// typed for the line (scheduled days, off-schedule ranges, MSS areas), or null.
const lrCards = (plan, lines) => {
  const out = new Map();
  if (plan) plan.lines.forEach((m) => { out.set(m.key, { key: m.key, area: m.area, line: m.line, plan: m, saved: null }); });
  (lines || []).forEach((l) => {
    const key = lrKey(l.area, l.line), c = out.get(key);
    if (c) c.saved = l; else out.set(key, { key: key, area: l.area, line: l.line, plan: null, saved: l });
  });
  return Array.from(out.values()).sort(dtLineSort);
};
// The Mondays of the weeks of `year`, up to today, that no plan row reaches; and consecutive ones joined.
const lrMissingWeeks = (plan, year, todayYmd) => {
  const out = [];
  let mon = dtMonday(year + '-01-01'), guard = 0;
  while (mon && mon <= todayYmd && mon <= year + '-12-31' && guard++ < 60) { if (!plan.weekHas[mon]) out.push(mon); mon = dtAddDays(mon, 7); }
  return out;
};
const lrMissingRanges = (mondays) => {
  const out = [];
  mondays.forEach((m) => {
    const last = out[out.length - 1];
    if (last && dtAddDays(last.to, 7) === m) { last.to = m; last.n += 1; } else out.push({ from: m, to: m, n: 1 });
  });
  return out;
};
const lrRangeText = (r) => (r.n === 1 ? 'the week of ' + dtDayName(r.from, false) : r.n + ' weeks, ' + dtDayName(r.from, false) + ' to ' + dtDayName(r.to, false));
// Equipment that has a cleaning frequency (the ones with jobs), by normalized MSS area name, and by the lines that claim them.
const lrHasJobs = (a) => FREQS.some(f => f.flags.some(c => isTrue(a[c])));
const lrAreaCounts = (assets) => {
  const m = new Map();
  (assets || []).forEach((a) => {
    if (!lrHasJobs(a)) return;
    const k = normalizeName(safeString(getProp(a, 'craa5_areaname')));
    m.set(k, (m.get(k) || 0) + 1);
  });
  return m;
};
const lrCoverage = (assets, rules) => {
  const per = {};
  let claimed = 0, total = 0;
  (assets || []).forEach((a) => {
    if (!lrHasJobs(a)) return;
    total += 1;
    const g = rules.groupOf(a);
    if (!g) return;
    claimed += 1;
    g.split(LR_SEP).forEach((k) => { per[k] = (per[k] || 0) + 1; });
  });
  return { per: per, claimed: claimed, total: total };
};
// How day i of a line's preview looks: cls (for the cell), status (for tests), title. `saved` is what was typed for the line.
const lrCellView = (inPlan, saved, cal, d, i) => {
  const w = Math.floor(i / 7), when = dtRangeText(d.ymd, d.ymd);
  const k = cal.kind[i], prod = cal.prod ? cal.prod[i] : 0;
  const offDay = !!(saved && saved.off.some((o) => o.from <= d.ymd && d.ymd <= o.to));
  if (!inPlan) {
    const st = saved ? dtStatus(saved, d.ymd, d.dow) : '';
    const what = st === 'sched' ? 'down, scheduled' : st === 'off' ? 'down, off schedule' : st === 'both' ? 'down, scheduled and off schedule' : 'running';
    const extra = k === 3 ? ' · one Daily job covers Saturday and Sunday, due on the Sunday' : k === 2 ? " · covered by Sunday's Daily job" : '';
    return { cls: (st || '') + (k === 2 ? ' cov' : ''), status: st || 'run', title: when + ' · ' + what + extra };
  }
  if (!cal.planned[w]) return { cls: 'nop', status: 'noplan', title: when + ' · no plan for this week, so no Daily job is counted' };
  const run = prod > 0 ? lrHours(prod) + ' of production' : 'no production';
  const down = lrHours(Math.max(0, cal.len[i] - prod)) + ' without production';
  let cls = '', status = 'none', what = 'no Daily job (' + down + ')';
  if (k === 3) { cls = 'due wk'; status = 'weekend'; what = 'one Daily job covers Saturday and Sunday, due today (' + down + ')'; }
  else if (k === 2) { cls = 'cov'; status = 'covered'; what = "covered by Sunday's Daily job (" + down + ')'; }
  else if (k === 1) { cls = 'due'; status = 'due'; what = 'Daily job due (' + down + ')'; }
  if (offDay) { cls = 'off' + (k === 2 ? ' cov' : ''); status = 'off'; what += ' · off schedule: the production plan is taken out of this day'; }
  return { cls: cls, status: status, title: when + ' · ' + run + ' · ' + what };
};
// The last column of a week: do the mid-week and weekly jobs count in it?
const lrWeekView = (inPlan, cal, w) => {
  if (inPlan && !cal.planned[w]) return { sym: '?', cls: 'nop', title: 'No plan for this week: the mid-week and weekly jobs are left out' };
  if (cal.weekOn[w]) return { sym: '✓', cls: 'yes', title: inPlan ? 'The line ran this week: the mid-week and weekly jobs count' : 'The mid-week and weekly jobs count' };
  return { sym: '–', cls: 'no', title: inPlan ? 'The line did not run this week: no mid-week or weekly jobs' : 'Down all seven days: no mid-week or weekly jobs' };
};
// END LINE RULES

// Text fallback for logs whose equipment id is blank or matches no equipment row.
// Exact normalized name first, then a name contained in exactly one equipment name; when several
// equipment share a name ("Floors"), the log's own room and area text decides.
// Ambiguous names stay unmapped, so "Oven 1" can no longer swallow "Oven 12".
const buildTextIndex = (assets) => {
  const named = assets.map(a => ({
    id: getAssetId(a),
    norm: normalizeName(safeString(getProp(a, 'craa5_equipmentidentifier'))),
    where: `${normalizeName(safeString(getProp(a, 'craa5_roomname')))}|${normalizeName(safeString(getProp(a, 'craa5_areaname')))}`
  })).filter(a => a.id && a.norm);
  const byName = new Map();
  named.forEach(a => byName.set(a.norm, (byName.get(a.norm) || []).concat(a)));
  return { named, byName, ids: new Set(assets.map(getAssetId)) };
};

const computeTextLinks = (index, logs) => {
  const links = new Map();
  logs.forEach(log => {
    if (LOG_ASSET_ID_FIELDS.some(f => index.ids.has(normalizeId(getRaw(log, f))))) return; // matched by id
    const n = normalizeName(safeString(getProp(log, 'craa5_equipment')));
    if (!n) return;
    const where = `${normalizeName(safeString(getProp(log, 'craa5_room')))}|${normalizeName(safeString(getProp(log, 'craa5_area')))}`;
    const narrow = (list) => { if (list.length <= 1) return list; const same = list.filter(a => a.where === where); return same.length === 1 ? same : list; };
    const exact = narrow(index.byName.get(n) || []);
    if (exact.length === 1) { links.set(getLogKey(log), exact[0].id); return; }
    if (exact.length > 1 || n.length < 3) return;
    const loose = narrow(index.named.filter(a => a.norm.length >= 3 && (a.norm.includes(n) || n.includes(a.norm))));
    if (loose.length === 1) links.set(getLogKey(log), loose[0].id);
  });
  return links;
};

// Explicit write-back (never part of Sync): stores the equipment id on logs the text fallback linked,
// in craa5_equipmentguid, so the next load matches them by id. Updates run five at a time and a
// failure leaves that log text-matched.
const writeBackTextLinks = async (logs, links) => {
  const byKey = new Map(logs.map(l => [getLogKey(l), l]));
  const writtenKeys = [];
  let written = 0, failed = 0;
  const todo = Array.from(links).filter(([key]) => byKey.has(key) && normalizeId(getRaw(byKey.get(key), 'craa5__log_id')));
  for (let i = 0; i < todo.length; i += 5) {
    await Promise.all(todo.slice(i, i + 5).map(async ([key, assetId]) => {
      const log = byKey.get(key);
      try {
        await Xrm.WebApi.updateRecord("craa5__log_", normalizeId(getRaw(log, 'craa5__log_id')), { [LOG_ASSET_ID_SELECT]: assetId });
        log[LOG_ASSET_ID_SELECT] = assetId;
        writtenKeys.push(key);
        written++;
      } catch (err) {
        failed++;
      }
    }));
  }
  return { writtenKeys, written, failed };
};

// --- ON-DEMAND LOADING ---
// There are thousands of pieces of equipment, so nothing here loads the whole log table. Sync loads the
// equipment directory (four small columns); logs are fetched only for the equipment rows and months
// currently on screen: by equipment id (the main path) and, for old entries whose id is blank or matches
// no equipment, by equipment name.
const LOG_CORE = "craa5__log_id,craa5_equipment,craa5_lastcleaned,craa5_lastcleanedby,craa5_nameofemployee,craa5_uid";
// The paperwork picture is a Dataverse File column: the row carries only the file's id (in the column itself) and its
// name (in <column>_name); the bytes are read separately (downloadPaperwork) when a marker is clicked.
const LOG_FILE_COLUMN = 'craa5_pictureorfileofpaperwork';
const LOG_FILE_NAME_COLUMN = LOG_FILE_COLUMN + '_name';
const LOG_OPTIONAL = ["craa5_sap", "craa5_hoursworked", "craa5_room", "craa5_area"].concat(LOG_TYPE_COLUMNS, [LOG_FILE_COLUMN, LOG_FILE_NAME_COLUMN]); // each is dropped on its own if the table lacks it
const missingLogColumns = new Set();
const logSelect = (withId) => [LOG_CORE, ...LOG_OPTIONAL.filter(c => !missingLogColumns.has(c)), withId ? LOG_ASSET_ID_SELECT : ''].filter(Boolean).join(',');
const BUILD = 'id loader r13';    // shown under the title and on Payload Diagnostics so a pasted version can be told apart
const ASSET_CORE = "craa5_aa_assetsid,craa5_equipmentidentifier,craa5_roomname,craa5_areaname";
const missingAssetColumns = new Set();   // frequency columns this equipment table turned out not to have
const assetSelect = () => [ASSET_CORE].concat(ASSET_FREQ_COLUMNS.filter(c => !missingAssetColumns.has(c))).join(',');
const PAGE_SIZE = 1000;          // rows per Dataverse page
const ID_CHUNK = 15;             // equipment ids per log request
const NAME_CHUNK = 20;           // equipment names per log request
const MAX_PARALLEL_REQUESTS = 3; // log requests in flight at once
const MAX_ASSETS = 50000;        // safety cap; a truncated load is reported, never silent
const MAX_LOGS_PER_REQUEST = 20000;
const MODAL_PAGE_SIZE = 25;      // equipment rows per area in the focused dialog

const isMissingColumnError = (err) => /could not find a property|0x80060888|does not exist|invalid property/i.test(String(err && err.message));
const isGuid = (v) => /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);

// --- PAPERWORK (Dataverse File column) ---
// A log row says only that a file is attached (its id in the column, its name in <column>_name); the picture itself is
// read when the marker is clicked, through the Dataverse messages InitializeFileBlocksDownload + DownloadBlock (the
// app's own Xrm connection) and, failing that, GET …/craa5__log_s(id)/<column>/$value in 4 MB ranges.
const logFile = (log) => {
  const name = safeString(log[LOG_FILE_NAME_COLUMN]);   // exact column names, as logTypeBits: no case-insensitive key scan per row
  const fileId = safeString(log[LOG_FILE_COLUMN]);
  const rowId = normalizeId(getRaw(log, 'craa5__log_id'));
  return (name || fileId) && isGuid(rowId) ? { rowId, name: name || 'paperwork' } : null;
};
const PAPERWORK_CHUNK = 4194304;   // bytes per DownloadBlock / Range request
const EDM_STRING = { typeName: 'Edm.String', structuralProperty: 1 };
const EDM_INT64 = { typeName: 'Edm.Int64', structuralProperty: 1 };
// Xrm.WebApi.online.execute reads getMetadata from the request's prototype.
const xrmRequest = (name, params, types) => {
  const Req = function Req() {};
  Req.prototype.getMetadata = () => ({ boundParameter: null, parameterTypes: types, operationType: 0, operationName: name });
  const req = new Req();
  Object.keys(params).forEach(k => { req[k] = params[k]; });
  return req;
};
const readJson = async (res) => {
  if (!res) return {};
  if (typeof res.json === 'function') return (await res.json()) || {};
  return res;
};
const base64ToBytes = (b64) => {
  const bin = atob(String(b64 || '').replace(/\s/g, ''));
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
};
const mimeFromName = (name) => {
  const ext = String(name || '').toLowerCase().split('.').pop();
  return ({ png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', svg: 'image/svg+xml', heic: 'image/heic', pdf: 'application/pdf' })[ext] || '';
};
// The line under the file name in the popout: equipment · date · cleaned by · size.
const paperworkSubtitle = (pw) => {
  const log = pw.entry.log;
  const size = pw.size ? ` · ${pw.size >= 1048576 ? (pw.size / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(pw.size / 1024)) + ' KB'}` : '';
  return `${safeString(getProp(log, 'craa5_equipment'))} · ${normalizeDateStr(getRaw(log, 'craa5_lastcleaned'))}${log.craa5_lastcleanedby ? ` · ${log.craa5_lastcleanedby}` : ''}${size}`;
};
const downloadByBlocks = async (rowId) => {
  const exec = (req) => Xrm.WebApi.online.execute(req);
  const init = await readJson(await exec(xrmRequest('InitializeFileBlocksDownload',
    { Target: { '@odata.type': 'Microsoft.Dynamics.CRM.craa5__log_', craa5__log_id: rowId }, FileAttributeName: LOG_FILE_COLUMN },
    { Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 }, FileAttributeName: EDM_STRING })));
  const token = init.FileContinuationToken;
  const size = Number(init.FileSizeInBytes) || 0;
  if (!token) throw new Error('Dataverse did not start the file download');
  const block = init.IsChunkingSupported === false ? size : PAPERWORK_CHUNK;
  const parts = [];
  let got = 0;
  while (got < size) {
    const r = await readJson(await exec(xrmRequest('DownloadBlock', { Offset: got, BlockLength: Math.min(block, size - got), FileContinuationToken: token },
      { Offset: EDM_INT64, BlockLength: EDM_INT64, FileContinuationToken: EDM_STRING })));
    const bytes = base64ToBytes(r.Data);
    if (!bytes.length) throw new Error('Dataverse returned an empty part of the file');
    parts.push(bytes);
    got += bytes.length;
  }
  const type = mimeFromName(init.FileName);
  return { blob: new Blob(parts, { type: type || 'application/octet-stream' }), name: safeString(init.FileName), type };
};
const clientUrl = () => { try { return String(Xrm.Utility.getGlobalContext().getClientUrl() || '').replace(/\/+$/, ''); } catch (_) { return ''; } };
const downloadByValue = async (rowId) => {
  const url = `${clientUrl()}/api/data/v9.2/craa5__log_s(${rowId})/${LOG_FILE_COLUMN}/$value`;
  const get = async (range) => {
    const headers = { 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' };
    if (range) headers.Range = range;
    const res = await fetch(url, { credentials: 'same-origin', headers });
    if (!res.ok) {
      let detail = '';
      try { const j = await res.json(); detail = j && j.error && j.error.message || ''; } catch (_) { /* no JSON body */ }
      throw new Error(detail || `the server answered ${res.status}`);
    }
    return res;
  };
  const first = await get(null);
  const name = safeString(first.headers.get('x-ms-file-name'));
  const type = safeString(first.headers.get('mimetype')) || mimeFromName(name) || safeString(first.headers.get('content-type')).split(';')[0];
  const parts = [await first.arrayBuffer()];
  const size = parseInt(first.headers.get('x-ms-file-size') || '0', 10) || 0;
  let got = parts[0].byteLength;
  if (first.status === 206 && size > got) {   // Dataverse sent the first range of a larger file: fetch the rest
    const chunk = parseInt(first.headers.get('x-ms-chunk-size') || '0', 10) || PAPERWORK_CHUNK;
    while (got < size) {
      const buf = await (await get(`bytes=${got}-${Math.min(size, got + chunk) - 1}`)).arrayBuffer();
      if (!buf.byteLength) throw new Error('Dataverse returned an empty part of the file');
      parts.push(buf);
      got += buf.byteLength;
    }
  }
  return { blob: new Blob(parts, { type: type || 'application/octet-stream' }), name, type };
};
const downloadPaperwork = async (rowId) => {
  if (typeof Xrm === 'undefined') throw new Error('not connected to Dataverse');
  const errors = [];
  if (Xrm.WebApi && Xrm.WebApi.online && typeof Xrm.WebApi.online.execute === 'function') {
    try { return await downloadByBlocks(rowId); } catch (err) { errors.push(String(err && err.message || err)); }
  }
  if (typeof fetch === 'function') {
    try { return await downloadByValue(rowId); } catch (err) { errors.push(String(err && err.message || err)); }
  }
  throw new Error(errors.length ? Array.from(new Set(errors)).join(' · ') : 'this app has no way to download files');
};
// OData string literal: quotes doubled, then percent-encoded. Xrm.WebApi sends the query as given and Microsoft
// says special characters (& # + % , / : ; = ? @ $) must be encoded; encodeURIComponent keeps the doubled quotes.
// Lone surrogates (a half emoji from a bad import) make encodeURIComponent throw, so they become U+FFFD first.
const odataString = (v) => encodeURIComponent(Array.from(String(v).replace(/'/g, "''"), ch => (ch.length === 1 && ch >= '\ud800' && ch <= '\udfff') ? '\ufffd' : ch).join(''));
// "Gyro Mixer (+)" -> "Gyro Mixer": a log may carry the name without the trailing note in brackets.
const nameBase = (name) => { let n = String(name || '').trim(); let prev; do { prev = n; n = n.replace(/\s*\([^)]*\)\s*$/, '').trim(); } while (n !== prev); return n; };

const retrievePaged = async (entity, query, maxRows, pageSize = PAGE_SIZE) => {
  let res = await Xrm.WebApi.retrieveMultipleRecords(entity, query, pageSize);
  let rows = res.entities || [];
  while (res.nextLink && rows.length < maxRows) {
    res = await Xrm.WebApi.retrieveMultipleRecords(entity, "?" + res.nextLink.split("?")[1], pageSize);
    rows = rows.concat(res.entities || []);
  }
  return { rows, truncated: !!res.nextLink };
};

// --- PRODUCTION PLAN (craa5__aa_prd_schd) ---
// The runs the Production Schedule hub saves; the gaps between a line's runs are its sanitation windows (see LINE RULES).
// Read only, never written. One request per year on screen (a week more on each side so no week is cut short), in pages, after
// Sync and when the Line Downtime tab is opened; a failed read is reported and the figures keep the plain rule.
const PLAN_TABLE = 'craa5__aa_prd_schd';
const PLAN_COLUMNS = ['craa5_area', 'craa5_line', 'craa5_datestarttime', 'craa5_dateendtime'];
const PLAN_OPTIONAL = ['craa5_product'];     // dropped on its own if the table lacks it: a maintenance run then counts as production
const MAX_PLAN_ROWS = 20000;                 // safety cap; a truncated read is reported, never silent
const PLAN_PAGE_SIZE = 5000;                 // the most rows Dataverse sends in a page: a year of runs is a handful of requests
const missingPlanColumns = new Set();

// The Dataverse columns this page reads or writes, listed on the Payload Diagnostics tab so a missing one can be created.
// [column, need, what it is for]; need: 'required' (nothing works without it), 'optional' (dropped on its own when the table
// lacks it, the page works with less), 'written' (the page also writes it).
const freqLabel = (c) => { const f = FREQS.filter(x => x.flags.indexOf(c) > -1)[0]; return f ? f.label.toLowerCase() : c; };
const DV_COLUMN_GROUPS = [
  { id: 'assets', table: 'craa5_aa_assets', title: 'Equipment', cols: [
    ['craa5_aa_assetsid', 'required', 'the equipment id the log entries point at'],
    ['craa5_equipmentidentifier', 'required', 'the equipment name'],
    ['craa5_roomname', 'required', 'its room'],
    ['craa5_areaname', 'required', 'its area']
  ].concat(ASSET_FREQ_COLUMNS.map(c => [c, 'optional', 'Yes/No: has a ' + freqLabel(c) + ' cleaning (the medallion and the jobs)'])) },
  { id: 'log', table: 'craa5__log_', title: 'MSS log', cols: [
    ['craa5__log_id', 'required', 'the log row (also where a paperwork picture is read from)'],
    ['craa5_equipment', 'required', 'the equipment name typed on the entry (text matching of old entries)'],
    ['craa5_lastcleaned', 'required', 'the date of the clean'],
    ['craa5_lastcleanedby', 'required', 'who cleaned'],
    ['craa5_nameofemployee', 'required', 'the employee'],
    ['craa5_uid', 'required', 'the entry id'],
    [LOG_ASSET_ID_SELECT, 'written', 'the equipment id: entries are matched to equipment by it, and Save text matches writes it'],
    ['craa5_sap', 'optional', 'the SAP order (shown in the tooltip)'],
    ['craa5_hoursworked', 'optional', 'the hours (shown in the tooltip)'],
    ['craa5_room', 'optional', 'the room on the entry (tells same-named equipment apart)'],
    ['craa5_area', 'optional', 'the area on the entry (tells same-named equipment apart)'],
    ['craa5_daily', 'optional', 'Yes/No: the entry was a daily clean (the medallion and the jobs)'],
    ['craa5_weekly', 'optional', 'Yes/No: a weekly clean'],
    ['craa5_monthly', 'optional', 'Yes/No: a monthly clean'],
    [LOG_FILE_COLUMN, 'optional', 'the paperwork picture (a File column)'],
    [LOG_FILE_NAME_COLUMN, 'optional', 'the file name of that picture']
  ] },
  { id: 'plan', table: PLAN_TABLE, title: 'Production plan', cols: [
    ['craa5_area', 'required', 'the production area of a run (the line is the area plus its line number)'],
    ['craa5_line', 'required', 'the line number (blank counts as line 1)'],
    ['craa5_datestarttime', 'required', 'when the run starts'],
    ['craa5_dateendtime', 'required', 'when the run ends; the gaps between runs are the sanitation windows'],
    ['craa5_product', 'optional', 'the product; a maintenance run is told from production by it']
  ] }
];
const planIso = (ms) => new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z');   // the format the Production Schedule hub filters with
const readPlanRows = async (year) => {
  const from = new Date(year, 0, 1 - 8).getTime(), to = new Date(year, 11, 31 + 9).getTime();
  const filter = `statecode eq 0 and craa5_datestarttime lt ${planIso(to)} and craa5_dateendtime gt ${planIso(from)}`;
  for (let attempt = 0; attempt <= PLAN_OPTIONAL.length; attempt++) {
    const select = PLAN_COLUMNS.concat(PLAN_OPTIONAL.filter(c => !missingPlanColumns.has(c))).join(',');
    try {
      return await retrievePaged(PLAN_TABLE, `?$select=${select}&$filter=${filter}&$orderby=craa5_datestarttime asc`, MAX_PLAN_ROWS, PLAN_PAGE_SIZE);
    } catch (err) {
      const msg = String(err && err.message);
      const bad = PLAN_OPTIONAL.filter(c => select.split(',').indexOf(c) > -1 && new RegExp(`\\b${c}\\b`, 'i').test(msg));
      if (!isMissingColumnError(err) || !bad.length) throw err;
      bad.forEach(c => missingPlanColumns.add(c));
    }
  }
  throw new Error('the plan table could not be read');
};

// Reads log rows; queryFor(select) builds the query. If Dataverse says an optional column does not exist,
// only that column is dropped (for the rest of the session, until the next Sync) and the request is retried,
// so requests that were already in flight with the old select recover too. Errors about any other column
// are thrown.
const retrieveLogs = async (queryFor, withId, maxRows) => {
  let style = dateStyle;
  let dateError = null;   // the first error of a request whose date filter was retried
  for (let attempt = 0; ; attempt++) {
    const select = logSelect(withId);
    try {
      const res = await retrievePaged("craa5__log_", queryFor(select, style), maxRows);
      if (style > dateStyle) dateStyle = style;   // a style that worked is kept for the next requests
      return res;
    } catch (err) {
      if (attempt > LOG_OPTIONAL.length + DATE_STYLES) throw dateError || err;
      if (!isMissingColumnError(err)) {
        // A rejected date filter is retried in the next style, per request: a failure that has another cause
        // (a bad name, throttling) never changes the style for everyone else.
        const hasDate = /craa5_lastcleaned ge/.test(decodeURIComponent(queryFor(select, style)));
        if (hasDate && isDateFilterError(err)) dateError = dateError || err;
        if (hasDate && isDateFilterError(err) && style < DATE_STYLES - 1) { style += 1; continue; }
        throw dateError || err;
      }
      const msg = String(err && err.message);
      const inSelect = LOG_OPTIONAL.filter(c => select.split(',').includes(c));
      let bad = inSelect.filter(c => new RegExp(`\\b${c}\\b`, 'i').test(msg));
      // The message names no property we asked for: drop the columns only the tooltip and the frequency check need.
      if (!bad.length && !new RegExp(`\\b(${[LOG_ASSET_ID_SELECT, ...LOG_CORE.split(',')].join('|')})\\b`, 'i').test(msg)) bad = inSelect.filter(c => c === 'craa5_sap' || c === 'craa5_hoursworked' || LOG_TYPE_COLUMNS.includes(c) || c === LOG_FILE_COLUMN || c === LOG_FILE_NAME_COLUMN);
      if (!bad.length) throw err;
      bad.forEach(c => missingLogColumns.add(c));
    }
  }
};

// The equipment directory: the four columns the matrix needs plus the frequency Yes/No columns. A frequency column
// Dataverse does not know is dropped (for the session, until the next Sync) and the request is retried.
const retrieveAssets = async () => {
  for (let attempt = 0; ; attempt++) {
    const select = assetSelect();
    try {
      return await retrievePaged("craa5_aa_assets", `?$select=${select}`, MAX_ASSETS);
    } catch (err) {
      if (attempt > ASSET_FREQ_COLUMNS.length || !isMissingColumnError(err)) throw err;
      const msg = String(err && err.message);
      const inSelect = ASSET_FREQ_COLUMNS.filter(c => select.split(',').includes(c));
      let bad = inSelect.filter(c => new RegExp(`\\b${c}\\b`, 'i').test(msg));
      if (!bad.length && !new RegExp(`\\b(${ASSET_CORE.split(',').join('|')})\\b`, 'i').test(msg)) bad = inSelect;   // names none of them: leave all of them out
      if (!bad.length) throw err;
      bad.forEach(c => missingAssetColumns.add(c));
    }
  }
};

// Date-only values are stored as midnight UTC, so the window is built in UTC. Style 0 is what the original
// calendar sent (quoted ISO datetimes). If Dataverse rejects it for this column, retrieveLogs moves on to
// an unquoted date, then an unquoted datetime, and keeps the first style that works.
let dateStyle = 0;
const DATE_STYLES = 3;
const monthsFilter = (year, firstMonth, lastMonth, style = dateStyle) => {
  const start = new Date(Date.UTC(year, firstMonth, 1));
  const end = new Date(Date.UTC(year, lastMonth + 1, 0, 23, 59, 59));
  const lit = [
    (d) => `'${d.toISOString()}'`,
    (d) => d.toISOString().slice(0, 10),
    (d) => d.toISOString().slice(0, 19) + 'Z'
  ][style];
  return `craa5_lastcleaned ge ${lit(start)} and craa5_lastcleaned le ${lit(end)}`;
};
const isDateFilterError = (err) => /date|time|literal|operand|convert|parse|invalid|filter/i.test(String(err && err.message)) && !/429|throttl|exceeded the limit|time window|service protection|concurrent|too many|retry-after|timed? ?out|network|failed to fetch|unauthor|forbidden|privilege/i.test(String(err && err.message));

// Logs stored against these equipment ids in the given month run.
const fetchLogsForAssets = async (assetIds, year, firstMonth, lastMonth) => {
  const ids = assetIds.filter(isGuid);
  if (!ids.length) return { rows: [], truncated: false };
  const idFilter = ids.map(id => `${LOG_ASSET_ID_SELECT} eq '${id}'`).join(' or ');
  return retrieveLogs((select, style) => `?$select=${select}&$filter=(${idFilter}) and ${monthsFilter(year, firstMonth, lastMonth, style)}`, true, MAX_LOGS_PER_REQUEST);
};

// Logs whose equipment text equals one of these names (case-insensitive, exact: a prefix match would pull in
// "Oven 12" for "Oven 1") in the given month run. This is for old entries whose id is blank or matches no
// equipment: computeTextLinks links those afterwards on the client, and rows whose id matches equipment
// are left to the id path.
const fetchLogsByName = async (names, year, firstMonth, lastMonth, withId) => {
  if (!names.length) return { rows: [], truncated: false };
  const nameFilter = names.map(n => `craa5_equipment eq '${odataString(n)}'`).join(' or ');
  return retrieveLogs((select, style) => `?$select=${select}&$filter=(${nameFilter}) and ${monthsFilter(year, firstMonth, lastMonth, style)}`, withId, MAX_LOGS_PER_REQUEST);
};

// Contiguous runs of month indexes: [3,4,5,8] -> [[3,5],[8,8]].
const monthRuns = (months) => {
  const runs = [];
  months.slice().sort((a, b) => a - b).forEach(m => {
    const last = runs[runs.length - 1];
    if (last && m === last[1] + 1) last[1] = m; else runs.push([m, m]);
  });
  return runs;
};

const getWeekNumber = (d) => {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  date.setUTCDate(date.getUTCDate() + 4 - (date.getUTCDay() || 7));
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
};

const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

// The frequency medallion inside the equipment cell, right after the name: one letter per frequency set on the
// equipment, coloured by whether the last clean of that kind is within the frequency (green), overdue (red) or not
// read yet (grey, dotted).
const FreqMedallion = React.memo(({ st }) => {
  if (!st || st.state === 'none') return <span className="freq-pill none" data-testid="freq-pill" data-state="none" title={st && st.noName ? 'This equipment has no name and the log has no id column, so its log cannot be read.' : `No cleaning frequency set on this equipment${st && st.lastAny ? ` · last clean ${st.lastAny}` : ''}`}>–</span>;
  const lines = st.badges.map(b => `${b.label} (${b.code}): ${
    b.state === 'ok' ? `last clean ${b.last}, within ${b.days} day${b.days === 1 ? '' : 's'}`
    : b.state === 'overdue' ? `OVERDUE, no ${b.label.toLowerCase()} clean since ${b.start}${b.last ? ` (last ${b.last})` : ''}`
    : `not read yet, read ${fmtMonths(b.missing)} to check${b.last ? ` (last seen ${b.last})` : ''}`}`);
  return (
    <span className={`freq-pill ${st.state}`} data-testid="freq-pill" data-state={st.state} title={lines.join('\n')}>
      {st.badges.map(b => <span key={b.code} className={`freq-code ${b.state}`}>{b.code}</span>)}
    </span>
  );
});

// One header row of percentages, or of counts when `slim`: a cell per day on screen (see completionCells).
const PctTier = React.memo(({ cells, dayColWidth, testid, last, slim }) => (
  <div className={`pct-tier${last ? ' last' : ''}${slim ? ' cnt' : ''}`} data-testid={testid}>
    {cells.map((c, i) => (<div key={i} className={`cell-pct${c.cls ? ' ' + c.cls : ''}`} style={{ width: dayColWidth }} title={c.title || undefined} data-pct={c.pct === null ? undefined : c.pct} data-notdone={c.n === undefined ? undefined : c.n}>{c.text}</div>))}
  </div>
));

// A figure above the grid: done % of the jobs counted, how many jobs, and how much of the plant was read to get there.
const PctTile = React.memo(({ testid, label, sub, stat, equipment, read, hint, action, busy }) => {
  const pct = pctOf(stat.done, stat.due);
  const partial = equipment > 0 && read < equipment;
  return (
    <div className={`pct-tile ${busy ? 'none' : pctTone(pct)}`} data-testid={testid} data-busy={busy ? '1' : undefined} title={hint}>
      <div className="pct-tile-head"><b>{label}</b><span>{sub}</span></div>
      <div className="pct-tile-body">
        <span className="pct-tile-num" data-testid={`${testid}-pct`}>{pct === null ? '–' : `${pct}%`}</span>
        <span className="pct-tile-detail">
          <span data-testid={`${testid}-jobs`}>{stat.due ? `${stat.done.toLocaleString()} of ${stat.due.toLocaleString()} jobs done` : equipment ? 'no job can be judged yet' : 'no equipment in this list has a frequency'}</span>
          {stat.due > 0 && <span data-testid={`${testid}-notdone`} className={stat.due > stat.done ? 'pct-miss' : ''}>{`${(stat.due - stat.done).toLocaleString()} not done of ${stat.due.toLocaleString()} due so far`}</span>}
          <span data-testid={`${testid}-read`} className={partial ? 'pct-partial' : ''}>{equipment ? `${read.toLocaleString()} of ${equipment.toLocaleString()} equipment read` : ''}</span>
        </span>
        {action}
      </div>
    </div>
  );
});

// The progress bar beside a room or area name, by the done-or-blank method: an equipment is cleaned when any day on
// screen has a log for it, missed when every month on screen has been read and none has, not read otherwise.
// Green check: everything read was cleaned; yellow check: some cleaned, some missed; red: nothing cleaned; grey: not
// read yet. Read loads the months on screen not read yet for every equipment that still has one (a cleaned equipment
// can still have an unread month on screen), without opening the area.
const GroupBar = React.memo(({ g, months, busy, canRead, onRead }) => {
  if (!g || !g.total) return null;
  const counted = g.total - g.unreadable;
  const parts = [`${g.cleaned} of ${counted} cleaned`];
  if (g.missed) parts.push(`${g.missed} missed`);
  if (g.unread) parts.push(`${g.unread} not read`);
  if (g.unreadable) parts.push(`${g.unreadable} cannot be read (no name, and the log has no id column)`);
  const pct = (n) => counted ? `${Math.round(100 * n / counted)}%` : '0%';
  const title = [
    `${parts.join(' · ')} · ${months}`,
    g.state === 'ok' ? 'Everything read so far was cleaned in the months on screen.' : g.state === 'partial' ? 'Some equipment was cleaned, some was missed.' : g.state === 'missed' ? 'Nothing read so far was cleaned in the months on screen.' : 'The log has not been read for this equipment yet.',
    'Cleaned: a log on at least one day on screen. Missed: every month on screen read, no log. Not read: open the area or press Read.',
    g.needsVisible.length ? `Read: loads the months on screen not read yet for ${g.needsVisible.length} equipment (a cleaned equipment can still have an unread month on screen), without opening the area.` : ''
  ].filter(Boolean).join('\n');
  return (
    <span className={`group-bar ${g.state}`} data-testid="group-bar" data-state={g.state} title={title}>
      {g.state === 'missed' ? <AlertIcon /> : g.state === 'unknown' ? <ClockIcon /> : <CheckIcon />}
      <span className="group-text">{g.cleaned}/{counted}</span>
      {counted > 0 && <span className="group-meter"><i style={{ width: pct(g.cleaned), background: BRAND.green }} /><i style={{ width: pct(g.missed), background: BRAND.red }} /></span>}
      {canRead && g.needsVisible.length > 0 && <button className="group-read" disabled={busy} onClick={(e) => { e.stopPropagation(); onRead(g.needsVisible); }}>{busy ? 'Reading…' : `Read ${g.needsVisible.length}`}</button>}
    </span>
  );
});

// Full mode only: under a room or area name, its percentage for the slicer timeframe and the amounts, not done / due
// ("92%  4 / 50"), counted by the same job rules as the figures above the grid.
const GroupFigure = React.memo(({ f, months }) => {
  const tone = pctTone(f.pct);
  // "4 / 50": not done / due, short enough to sit beside the bar and its Read button (the corner legend and the tooltip say so)
  const what = f.due ? `${fmtCount(f.miss)} / ${fmtCount(f.due)}` : f.equipment ? (f.read ? 'none judged' : 'not read yet') : 'no frequency';
  const title = [
    f.due ? `${months}: ${f.miss.toLocaleString()} not done of ${f.due.toLocaleString()} jobs due (${f.done.toLocaleString()} done, ${f.pct}%). Due: the jobs whose period has ended, and any done sooner.` : f.equipment ? (f.read ? `${months}: no job could be judged yet.` : `${months}: the log has not been read for this equipment yet (press Read).`) : 'No equipment in this list has a cleaning frequency.',
    f.partial ? `${(f.equipment - f.read).toLocaleString()} of ${f.equipment.toLocaleString()} equipment have a month on screen that is not read yet. Months not read are left out, not counted as missed.` : '',
    f.ytdDue ? `Year to date: ${f.ytdDone.toLocaleString()} of ${f.ytdDue.toLocaleString()} due jobs done (${f.ytdPct}%).` : '',
    'Counted as in the two figures above the grid: every frequency letter on an equipment is one job per period, for the equipment in this list only.'
  ].filter(Boolean).join('\n');
  return (
    <span className="group-fig" data-testid="group-fig" data-pct={f.pct === null ? undefined : f.pct} title={title}>
      <b className={`group-fig-pct ${tone}${f.partial ? ' part' : ''}`} data-testid="group-fig-pct">{f.pct === null ? '–' : `${f.pct}%`}</b>
      <span className={`group-fig-amt${f.miss ? ' miss' : ''}`} data-testid="group-fig-notdone">{what}</span>
    </span>
  );
});
// The name of a room or area; in full mode (`f` given) the figure sits under it.
const GroupName = ({ name, f, months }) => f
  ? <span className="group-names"><span className="group-name" title={name}>{name}</span><GroupFigure f={f} months={months} /></span>
  : <span className="group-name" title={name}>{name}</span>;

// The timeline of a room or area row: a check on every day on which any of its equipment was cleaned, blank otherwise.
// A row with nothing checked is one strip (gridlines and the today stripe drawn by CSS), not a cell per day: with every
// room and area on the page this is rows x days elements, and every layout pays for them. The row shows presence only,
// so it is left alone while the same dates are checked, although groupStatus rebuilds its object on every flush.
const sameDays = (a, b) => {
  if (a === b) return true;
  const ka = a ? Object.keys(a.days) : [], kb = b ? Object.keys(b.days) : [];
  return ka.length === kb.length && ka.every(d => !!b.days[d]);
};
const GroupDays = React.memo(({ g, groupKey, timelineDays, dayColWidth, onEnter, onLeave }) => {
  if (!g || !Object.keys(g.days).length) {
    let ti = -1;
    timelineDays.forEach((d, i) => { if (d.isToday) ti = i; });
    return (
      <div className="data-cells group-strip" style={{ width: timelineDays.length * dayColWidth, backgroundSize: `${dayColWidth}px 100%` }}>
        {ti >= 0 && <div className="group-strip-today" style={{ left: ti * dayColWidth, width: dayColWidth }} />}
      </div>
    );
  }
  return (
    <div className="data-cells">
      {timelineDays.map((d, di) => {
        const n = g.days[d.dateStr];
        return (
          <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}>
            {n ? <div className="group-day" data-testid="group-day" onMouseEnter={() => onEnter(groupKey, d.dateStr)} onMouseLeave={onLeave}><CheckIcon /></div> : <div className="marker-empty" />}
          </div>
        );
      })}
    </div>
  );
}, (p, q) => p.groupKey === q.groupKey && p.timelineDays === q.timelineDays && p.dayColWidth === q.dayColWidth && p.onEnter === q.onEnter && p.onLeave === q.onLeave && sameDays(p.g, q.g));

// ----------------------------------------------------------------------------
// LINE DOWNTIME TAB: kept in App so the days survive a switch of tab, and so the matrix can use them.
// ----------------------------------------------------------------------------
function useLineDowntime() {
  const [lines, setLines] = useState(dtLoad);
  const [saved, setSaved] = useState(dtCanStore);
  const mounted = useRef(false);
  useEffect(() => {
    if (!mounted.current) { mounted.current = true; return; }
    setSaved(dtStore(lines));
  }, [lines]);
  return { lines, setLines, saved };
}

// The second click of a double-click lands on whatever the first one changed (a form sent twice, the next range slid under
// the X, the Keep button that replaced Remove line, the next card's Remove line): the buttons that add or remove ignore it.
const ignoreRepeat = (e) => { if (e.detail > 1) e.preventDefault(); };
const single = (fn) => (e) => { if (!(e.detail > 1)) fn(); };

// What the production plan read looks like on the tab.
// Payload Diagnostics: every Dataverse column this page uses, with what it is for and whether the last read found it.
function DvColumnsCard({ connected, assetsRead, logsRead, planRead, idColumn }) {
  const stateOf = (g, col) => {
    if (!connected) return 'not connected';
    const gone = g.id === 'assets' ? missingAssetColumns.has(col) : g.id === 'log' ? (missingLogColumns.has(col) || (col === LOG_ASSET_ID_SELECT && !idColumn)) : missingPlanColumns.has(col);
    if (gone) return 'missing';
    const read = g.id === 'assets' ? assetsRead : g.id === 'log' ? (col === LOG_ASSET_ID_SELECT ? assetsRead : logsRead) : planRead;
    return read ? 'found' : 'not read yet';
  };
  const rows = [];
  DV_COLUMN_GROUPS.forEach(g => g.cols.forEach(c => rows.push({ g: g, col: c[0], need: c[1], use: c[2], st: stateOf(g, c[0]) })));
  const missing = rows.filter(r => r.st === 'missing');
  const tone = { found: '#047857', missing: '#b91c1c', 'not read yet': '#94a3b8', 'not connected': '#94a3b8' };
  return (
    <div className="diag-card" data-testid="diag-columns" style={{ marginTop: '16px' }}>
      <h3>Dataverse columns this page uses</h3>
      <p style={{ color: '#64748b' }}>What the matrix, the percentages and the Line Downtime tab read, and the one column the page writes. A column marked missing is left out and the page works with what it has; create it in the table named to get the part of the page it feeds.</p>
      <p data-testid="diag-columns-summary" style={{ color: missing.length ? '#b91c1c' : '#047857', fontWeight: 700 }}>
        {!connected ? 'Not connected to Dataverse, so nothing was checked.' : missing.length ? `${missing.length} column${missing.length === 1 ? ' is' : 's are'} missing: ${missing.map(r => r.g.table + '.' + r.col).join(', ')}.` : rows.some(r => r.st === 'not read yet') ? 'No column found missing so far; the rest are checked as each table is read.' : 'Every column was found.'}
      </p>
      {DV_COLUMN_GROUPS.map(g => (
        <table key={g.id} data-testid={`diag-columns-${g.id}`} style={{ fontSize: '12px', borderCollapse: 'collapse', marginBottom: '12px' }}>
          <thead><tr><th colSpan={4} style={{ textAlign: 'left', padding: '4px 12px 4px 0', color: BRAND.blueDark }}>{g.title} <span style={{ fontWeight: 400, color: '#64748b' }}>· table {g.table}</span></th></tr></thead>
          <tbody>{rows.filter(r => r.g === g).map(r => (
            <tr key={r.col} data-testid="diag-column" data-state={r.st}>
              <td style={{ padding: '2px 14px 2px 0', fontFamily: 'monospace' }}>{r.col}</td>
              <td style={{ padding: '2px 14px 2px 0', color: '#64748b' }}>{r.need}</td>
              <td style={{ padding: '2px 14px 2px 0', color: tone[r.st], fontWeight: r.st === 'missing' ? 800 : 600 }}>{r.st}</td>
              <td style={{ padding: '2px 0', color: '#475569' }}>{r.use}</td>
            </tr>
          ))}</tbody>
        </table>
      ))}
    </div>
  );
}

function PlanPanel({ plan, planYear, planModel, coverage, assetsReady, todayStr, onRead }) {
  const hasXrm = typeof Xrm !== 'undefined';
  const data = plan.data && plan.data.year === planYear ? plan.data : null;
  const busy = plan.state === 'loading';
  const missing = data && planModel ? lrMissingRanges(lrMissingWeeks(planModel, planYear, todayStr)) : [];
  let tone = 'run', label = 'Not read', text = '';
  if (!hasXrm) {
    text = 'This page is not connected to Dataverse, so the production plan cannot be read. Every equipment keeps the plain rule: a Daily job every day and a weekly job every week.';
  } else if (busy && !data) {
    label = 'Reading'; text = 'Reading the production plan for ' + planYear + '…';
  } else if (plan.state === 'error' && !data) {
    tone = 'bad'; label = 'Not read';
    text = 'The production plan could not be read: ' + plan.error + ' Until it can be, every equipment keeps the plain rule: a Daily job every day and a weekly job every week.';
  } else if (data && planModel) {
    tone = plan.state === 'error' ? 'warn' : 'ok'; label = busy ? 'Reading again' : plan.state === 'error' ? 'Old read' : 'Read';
    let first = 0, last = 0;
    planModel.lines.forEach((m) => { if (!first || m.first < first) first = m.first; if (m.last > last) last = m.last; });
    text = data.rows.toLocaleString() + ' runs of ' + planYear + ' read for ' + planModel.lines.size + ' line' + (planModel.lines.size === 1 ? '' : 's')
      + (first ? ', from ' + dtDayName(dtYmd(new Date(first)), false) + ' to ' + dtDayName(dtYmd(new Date(last)), false) : '') + '.';
    if (plan.state === 'error') text += ' Reading it again failed (' + plan.error + '), so the full-mode figures keep using this read.';
  } else {
    label = 'Reading'; text = 'The production plan for ' + planYear + ' is not read yet.';
  }
  return (
    <div className="diag-card dt-plan" data-testid="dt-plan" data-state={!hasXrm ? 'none' : data ? (plan.state === 'error' ? 'old' : 'ready') : plan.state}>
      <div className="dt-plan-head">
        <h3>Production plan {planYear}</h3>
        <span className={'dt-chip ' + tone} data-testid="dt-plan-chip">{label}</span>
        {hasXrm && <button type="button" className="page-btn" data-testid="dt-plan-read" disabled={busy} onClick={single(onRead)}>{busy ? 'Reading…' : data || plan.state === 'error' ? 'Read again' : 'Read the plan'}</button>}
      </div>
      <p className="dt-note" data-testid="dt-plan-text">{text}</p>
      {data && data.truncated && <p className="dt-error" data-testid="dt-plan-trunc">Only the first {MAX_PLAN_ROWS.toLocaleString()} runs were read. Lines and weeks at the end of the year may be missing.</p>}
      {data && data.bad > 0 && <p className="dt-hint" data-testid="dt-plan-bad">{data.bad} row{data.bad === 1 ? ' was' : 's were'} left out: no area, or no usable start and end time.</p>}
      {data && planModel && planModel.long > 0 && <p className="dt-hint" data-testid="dt-plan-long">{planModel.long} run{planModel.long === 1 ? ' is' : 's are'} longer than {LR_MAX_RUN_DAYS} days and {planModel.long === 1 ? 'was' : 'were'} left out (a mistyped end date?).</p>}
      {data && data.noProduct && <p className="dt-hint" data-testid="dt-plan-noprod">The plan table has no craa5_product column, so a maintenance run cannot be told from production and counts as production.</p>}
      {data && planModel && (
        missing.length
          ? <p className="dt-note" data-testid="dt-plan-missing">Weeks with no plan yet: {missing.map(lrRangeText).join('; ')}. They are left out of the full-mode figures for the lines in the plan, like a month not read yet.</p>
          : <p className="dt-hint" data-testid="dt-plan-missing">Every week of {planYear} so far has plan rows.</p>
      )}
      {data && planModel && (
        assetsReady
          ? <p className="dt-note" data-testid="dt-plan-coverage">{coverage.claimed.toLocaleString()} of {coverage.total.toLocaleString()} equipment with a cleaning frequency follow a line below{coverage.total > coverage.claimed ? '. The other ' + (coverage.total - coverage.claimed).toLocaleString() + ' are in areas no line claims and keep the plain rule: a Daily job every day and a weekly job every week.' : '.'}</p>
          : <p className="dt-hint" data-testid="dt-plan-coverage">Press Sync Dataverse to count the equipment that follows each line.</p>
      )}
    </div>
  );
}

const LineCard = React.memo(({ card, view, now, todayStr, assetsReady, areaCounts, sharedWith, onPatch, onRemove }) => {
  const [from, setFrom] = useState('');
  const [to, setTo] = useState('');
  const [err, setErr] = useState('');
  const [confirm, setConfirm] = useState(false);
  const [areaIn, setAreaIn] = useState('');
  const [areaErr, setAreaErr] = useState('');
  const fromRef = useRef(null);
  const toRef = useRef(null);
  const inPlan = !!card.plan;
  const saved = card.saved || { days: [], off: [], areas: [] };
  const title = card.area + ' · Line ' + card.line;
  const eff = saved.areas.length ? saved.areas : [card.area];
  const followed = {};
  let nFollow = 0;
  eff.forEach(a => { const k = normalizeName(a); if (!followed[k]) { followed[k] = true; nFollow += areaCounts.get(k) || 0; } });
  let chip;
  if (inPlan) chip = !now || !now.planned ? { cls: 'run', st: 'run', text: 'No plan this week' } : now.prod > 0 ? { cls: 'run', st: 'run', text: 'Running today · ' + lrHours(now.prod) } : { cls: 'down', st: 'down', text: 'Down today · no production' };
  else { const st = dtStatus(saved, todayStr); chip = { cls: st ? 'down' : 'run', st: st || 'run', text: st === 'sched' ? 'Down today · scheduled' : st === 'off' ? 'Down today · off schedule' : st === 'both' ? 'Down today' : 'Running today' }; }
  const toggleDay = (dow) => onPatch(card, l => ({ ...l, days: l.days.indexOf(dow) > -1 ? l.days.filter(d => d !== dow) : l.days.concat([dow]) }));
  const addRange = () => {
    if (dtUnreadable(fromRef.current)) return setErr('Check the first day. The date is unfinished or does not exist.');
    if (dtUnreadable(toRef.current)) return setErr('Check the last day. The date is unfinished or does not exist. Fix it, or clear it for a single day.');
    const a = dtParse(from), b = to ? dtParse(to) : a;
    if (!a) return setErr(from ? 'Check the first day.' + dtYearNote(from) : 'Pick the first day.');
    if (!b) return setErr('Check the last day, or leave it empty for a single day.' + dtYearNote(to));
    const f = dtYmd(a), t = dtYmd(b);
    if (t < f) return setErr('The last day is before the first day.');
    if (dtSpan(f, t) > DT_MAX_RANGE_DAYS) return setErr('One range can cover at most a year. Add a second range for more.');
    if (saved.off.some(r => r.from === f && r.to === t)) return setErr('That range is already in the list.');
    onPatch(card, l => ({ ...l, off: l.off.concat([{ from: f, to: t }]).sort(dtByFrom) }));
    setFrom(''); setTo(''); setErr('');
  };
  const removeRange = (r) => onPatch(card, l => ({ ...l, off: l.off.filter(x => !(x.from === r.from && x.to === r.to)) }));
  const addArea = () => {
    const name = dtCollapse(areaIn).slice(0, 80), k = normalizeName(name);
    if (!name || !k) return setAreaErr('Pick or type an MSS area.');
    if (eff.some(a => normalizeName(a) === k)) return setAreaErr(name + ' is already in the list.');
    if (saved.areas.length >= DT_MAX_AREAS) return setAreaErr('At most ' + DT_MAX_AREAS + ' areas on one line.');
    onPatch(card, l => ({ ...l, areas: (l.areas.length ? l.areas : [card.area]).concat([name]) }));
    setAreaIn(''); setAreaErr('');
  };
  const dropArea = (name) => onPatch(card, l => ({ ...l, areas: l.areas.filter(a => normalizeName(a) !== normalizeName(name)) }));
  const idle = !inPlan && !saved.days.length && !saved.off.length;
  return (
    <section className="dt-card" data-testid="dt-card" data-line={card.area + '|' + card.line} data-source={inPlan ? 'plan' : 'typed'} aria-label={title}>
      <div className="dt-card-head">
        <h3 data-testid="dt-title">{title}</h3>
        {inPlan
          ? <span className="dt-src" data-testid="dt-src" title="This line is in the production plan">From the plan · {card.plan.rows.toLocaleString()} run{card.plan.rows === 1 ? '' : 's'}</span>
          : confirm
            ? (
              <span className="dt-confirm">
                Remove this line?
                <button type="button" className="page-btn danger" data-testid="dt-remove-yes" onClick={single(() => onRemove(saved.id))}>Yes, remove</button>
                <button type="button" className="page-btn" data-testid="dt-keep" onClick={single(() => setConfirm(false))}>Keep</button>
              </span>
            )
            : <button type="button" className="dt-link" data-testid="dt-remove" onClick={single(() => setConfirm(true))}>Remove line</button>}
      </div>
      <div>
        <span className={'dt-chip ' + chip.cls} data-testid="dt-today" data-status={chip.st}>{chip.text}</span>
      </div>

      <div className="dt-label">Equipment <span>{saved.areas.length ? 'follows this line' : "follows this line, by the line's own area until you pick others"}</span></div>
      <div className="dt-areas" data-testid="dt-areas">
        {eff.map(name => {
          const n = areaCounts.get(normalizeName(name)) || 0;
          const others = (sharedWith[normalizeName(name)] || []).filter(k => k !== card.key);
          return (
            <span key={name} className={'dt-area' + (assetsReady && !n ? ' empty' : '')} data-testid="dt-area-chip" data-area={name}>
              <b>{name}</b>
              {assetsReady && <i>{n.toLocaleString()} equipment</i>}
              {others.length > 0 && <em title={'Also followed by ' + others.map(k => k.split('|')[0] + ' · Line ' + k.split('|')[1]).join(', ') + ': this equipment has a Daily job only when none of the lines produces'}>shared</em>}
              {saved.areas.length > 0 && <button type="button" className="dt-x" aria-label={'Remove ' + name} title="Remove" data-testid="dt-area-x" onClick={single(() => dropArea(name))}><XIcon /></button>}
            </span>
          );
        })}
      </div>
      <form className="dt-area-form" noValidate onSubmit={(e) => { e.preventDefault(); addArea(); }}>
        <input list="dt-areas" value={areaIn} autoComplete="off" placeholder="Add an MSS area" aria-label={'Add an MSS area to ' + title} data-testid="dt-area-in" onChange={(e) => { setAreaIn(e.target.value); setAreaErr(''); }} />
        <button type="submit" className="sync-btn" data-testid="dt-area-add" onClick={ignoreRepeat}>Add</button>
      </form>
      {areaErr && <p className="dt-error" role="alert" data-testid="dt-area-error">{areaErr}</p>}
      {assetsReady
        ? (nFollow === 0 && <p className="dt-error" data-testid="dt-area-none">No equipment with a cleaning frequency is in {eff.length === 1 ? 'this area' : 'these areas'}, so nothing follows this line yet. Add the MSS areas it cleans.</p>)
        : <p className="dt-hint">Press Sync Dataverse to count the equipment.</p>}
      {idle && <p className="dt-hint" data-testid="dt-idle">This line is not in the production plan and has no days typed, so no equipment follows it.</p>}

      {inPlan && !saved.days.length
        ? <p className="dt-note" data-testid="dt-days-text">The plan decides which days this line runs, so scheduled weekdays are not used.</p>
        : (
          <>
            <div className="dt-label">Scheduled <span>{inPlan ? 'not used while the plan has this line' : 'down every week on'}</span></div>
            <div className="dt-days" role="group" aria-label={'Scheduled down days for ' + title}>
              {DT_WEEKDAYS.map(w => {
                const on = saved.days.indexOf(w.dow) > -1;
                return <button key={w.dow} type="button" className={'dt-day' + (on ? ' on' : '')} aria-pressed={on} title={w.name} data-testid={'dt-day-' + w.short} onClick={() => toggleDay(w.dow)}>{w.short}</button>;
              })}
            </div>
            <p className="dt-note" data-testid="dt-days-text">{saved.days.length ? 'Down every ' + dtDaysText(saved.days) + (inPlan ? '. Not used: the plan decides.' : '.') : 'No scheduled down days.'}</p>
          </>
        )}

      <div className="dt-label">Off schedule <span>{inPlan ? 'production taken out of these days' : 'extra days down'}</span></div>
      <form className="dt-range-form" noValidate onSubmit={(e) => { e.preventDefault(); addRange(); }}>
        <label className="dt-field"><span>First day</span><input type="date" ref={fromRef} value={from} data-testid="dt-from" onChange={(e) => { setFrom(e.target.value); setErr(''); }} /></label>
        <label className="dt-field"><span>Last day</span><input type="date" ref={toRef} value={to} data-testid="dt-to" onChange={(e) => { setTo(e.target.value); setErr(''); }} /></label>
        <button type="submit" className="sync-btn" data-testid="dt-add-range" onClick={ignoreRepeat}>Add</button>
      </form>
      <p className="dt-hint">Leave the last day empty for a single day.</p>
      {err && <p className="dt-error" role="alert" data-testid="dt-range-error">{err}</p>}
      {saved.off.length === 0
        ? <p className="dt-note" data-testid="dt-off-empty">No off-schedule days.</p>
        : (
          <ul className="dt-ranges" data-testid="dt-ranges">
            {saved.off.map(r => {
              const n = dtSpan(r.from, r.to);
              const text = dtRangeText(r.from, r.to);
              return (
                <li key={r.from + '_' + r.to} className={r.to < todayStr ? 'past' : ''} data-testid="dt-range">
                  <span className="dt-range-label">{text}</span>
                  <span className="dt-range-n">{n} day{n === 1 ? '' : 's'}{r.to < todayStr ? ' · past' : ''}</span>
                  <button type="button" className="dt-x" aria-label={'Remove ' + text} title="Remove" onClick={single(() => removeRange(r))}><XIcon /></button>
                </li>
              );
            })}
          </ul>
        )}

      {view && view.cal && (
        <div className="dt-strip" aria-label={'Next weeks for ' + title} data-testid="dt-strip">
          {DT_WEEKDAYS.map(w => <div key={'h' + w.dow} className="dt-strip-h">{w.short}</div>)}
          <div className="dt-strip-h" title="Do the mid-week and weekly jobs count in that week?">Wkly</div>
          {view.days.map((vd, i) => {
