          <span className={'dt-msg ' + (msg ? msg.kind : '')} role="status" data-testid="dt-msg">{msg ? msg.text : ''}</span>
        </form>

        <div className="dt-toolbar">
          <span className="dt-label inline">Preview</span>
          <button type="button" className="page-btn" aria-label="Earlier weeks" title="Earlier weeks" data-testid="dt-prev" disabled={!canPrev} onClick={() => setStart(s => dtAddDays(s, -7 * DT_STRIP_WEEKS))}><ChevronLeftIcon /></button>
          <span className="dt-range-text" data-testid="dt-range-text">{strip.length ? dtRangeText(strip[0].ymd, strip[strip.length - 1].ymd) : ''}</span>
          <button type="button" className="page-btn" aria-label="Later weeks" title="Later weeks" data-testid="dt-next" disabled={!canNext} onClick={() => setStart(s => dtAddDays(s, 7 * DT_STRIP_WEEKS))}><ChevronRightLargeIcon /></button>
          <button type="button" className="page-btn" data-testid="dt-this-week" disabled={start === thisMonday} onClick={() => setStart(thisMonday)}>This week</button>
          <span className="dt-legend" data-testid="dt-legend">
            <span><i className="dt-sw due" />Daily job due</span>
            <span><i className="dt-sw wk" />Sunday: one Daily job for the weekend</span>
            <span><i className="dt-sw cov" />Saturday it covers</span>
            <span><i className="dt-sw off" />Off schedule</span>
            <span><i className="dt-sw nop" />No plan</span>
          </span>
        </div>

        {cards.length === 0
          ? <div className="diag-card dt-empty" data-testid="dt-empty">{plan.data && plan.data.year === planYear ? 'The plan has no runs for ' + planYear + ' yet, and no line was added by hand.' : 'No lines yet. They appear here when the production plan is read; you can also add a line above.'}</div>
          : <div className="dt-grid">{cards.map(c => <LineCard key={c.key} card={c} view={views[c.key]} now={nows[c.key]} todayStr={todayStr} assetsReady={assets.length > 0} areaCounts={areaCounts} sharedWith={sharedWith} onPatch={patch} onRemove={remove} />)}</div>}
      </div>
    </main>
  );
}

export default function App() {
  const [activeTab, setActiveTab] = useState('master'); 
  const [fullMode, setFullMode] = useState(false);   // the CJ Schwan's logo switches it: false = the plain MSS (default), true = full mode (see header item 13)
  const downtime = useLineDowntime();   // Line Downtime tab: kept here so the days survive a switch of tab
  const [assets, setAssets] = useState([]);
  const [logs, setLogs] = useState([]);
  const [anchorYear, setAnchorYear] = useState(new Date().getFullYear());

  // The production plan (craa5__aa_prd_schd) of the year on screen, read when full mode is switched on, after Sync while it is on, and when the Line Downtime tab opens, and
  // only while something uses it: full mode (the figures) or the Line Downtime tab. The plain MSS never reads it.
  // `data` keeps the last good read, so a re-read that is running or fails does not drop the lines the figures follow.
  const [plan, setPlan] = useState({ state: 'idle', data: null, error: '' });
  const planSeqRef = useRef(0);
  const planTriedRef = useRef(null);             // the year the last read was started for
  const readPlan = useCallback(async (year) => {
    const seq = ++planSeqRef.current;
    planTriedRef.current = year;
    if (typeof Xrm === 'undefined') { setPlan({ state: 'idle', data: null, error: '' }); return; }
    setPlan(p => ({ state: 'loading', data: p.data, error: '' }));
    try {
      missingPlanColumns.clear();
      const res = await readPlanRows(year);
      if (seq !== planSeqRef.current) return;     // a newer read has started
      const runs = [];
      let bad = 0;
      res.rows.forEach(row => { const r = lrRunFromRow(row); if (r) runs.push(r); else bad += 1; });
      setPlan({ state: 'ready', data: { year, runs, rows: res.rows.length, bad, truncated: res.truncated, noProduct: missingPlanColumns.has('craa5_product') }, error: '' });
    } catch (err) {
      if (seq !== planSeqRef.current) return;
      const text = String(err && err.message ? err.message : err).replace(/[.\s]+$/, '') + '.';
      setPlan(p => ({ state: 'error', data: p.data && p.data.year === year ? p.data : null, error: text }));
    }
  }, []);
  useEffect(() => {
    if (typeof Xrm === 'undefined') return;
    if (!fullMode && activeTab !== 'downtime') return;             // the plain MSS has no use for the plan
    if (assets.length === 0 && activeTab !== 'downtime') return;   // nothing needs the plan yet
    if (planTriedRef.current === anchorYear) return;
    readPlan(anchorYear);
  }, [anchorYear, activeTab, fullMode, assets.length, readPlan]);
  const planModel = useMemo(() => (plan.data && plan.data.year === anchorYear ? buildPlanModel(plan.data.runs) : null), [plan.data, anchorYear]);
  // Which equipment follows which line, and each line's calendar (see LINE RULES); the figures and the Line Downtime tab use the same one.
  const lineRules = useMemo(() => buildLineRules({ plan: planModel || buildPlanModel([]), lines: downtime.lines }), [planModel, downtime.lines]);
  // Full mode with the plan not in yet (about to be read, or being read): the figures are drawn under the default rule (a Daily
  // job every day), which the plan then changes for the equipment a line follows, so they are shown dimmed, not as final.
  const planPending = fullMode && typeof Xrm !== 'undefined' && assets.length > 0 && !planModel && plan.state !== 'error';
  const planFailed = fullMode && plan.state === 'error' && !planModel;
  
  // Pagination State (Rooms)
  const [currentPage, setCurrentPage] = useState(0);
  const pageSize = 5; 

  // Pagination State (Equipment within Area)
  // Mapping: { "RoomName|AreaName": pageNumber }
  const [areaPages, setAreaPages] = useState({});
  const equipmentPageSize = 10;
  
  // Slicer State
  const [visibleMonths, setVisibleMonths] = useState([]); 
  
  // Modal / Focused View State
  const [modalContext, setModalContext] = useState(null); 
  const [isModalMaximized, setIsModalMaximized] = useState(false);
  
  const [isLoading, setIsLoading] = useState(false);
  const [loadProgress, setLoadProgress] = useState(0);
  const [searchQuery, setSearchQuery] = useState("");
  const [zoom, setZoom] = useState(1.0);
  const [hoveredLog, setHoveredLog] = useState(null);
  // No mouseleave comes for a marker React removes while the pointer rests on it (a filter typed from the keyboard),
  // so after every commit the marker the tooltip belongs to is checked and the tooltip is dropped when it is gone.
  const hoveredMarkerRef = useRef(null);
  useEffect(() => {
    const el = hoveredMarkerRef.current;
    if (el && !(document.body.contains(el) && el.classList.contains('marker'))) { hoveredMarkerRef.current = null; setHoveredLog(null); }
  });
  // The tooltip follows the mouse through the DOM, not through state: a state update per mouse move re-rendered every
  // equipment row on the page (hundreds of rows, a frame of 150 ms or more).
  const mousePosRef = useRef({ x: 0, y: 0 });
  const tipRef = useRef(null);   // whichever tooltip is on screen (the two are never shown together)
  
  const [expandedKeys, setExpandedKeys] = useState({});
  const [textLinks, setTextLinks] = useState(new Map()); // log key -> asset id, for logs matched by name
  const [syncNotes, setSyncNotes] = useState([]);
  const [canWriteBack, setCanWriteBack] = useState(false); // false when the log id column is missing
  const [isSaving, setIsSaving] = useState(false);
  const [idColumn, setIdColumn] = useState(true);       // false when craa5_equipmentguid does not exist on the log table
  const [logsLoading, setLogsLoading] = useState(false);
  const [loadErrors, setLoadErrors] = useState([]);
  const [modalPages, setModalPages] = useState({});     // "room|area" -> page in the focused dialog
  const epochRef = useRef(0);                           // bumped by Sync so late responses are ignored
  const loadedRef = useRef(new Set());                  // "kind|year|month|item" already fetched
  const inflightRef = useRef(new Set());
  const logKeysRef = useRef(new Set());
  const pendingLogsRef = useRef([]);                    // loaded rows waiting for one batched state update
  const pendingLinksRef = useRef(new Map());            // their text links
  const flushTimerRef = useRef(null);

  // Id match is re-derived from loaded data; the text fallback only changes when Sync runs.
  const completionIndex = useMemo(() => buildCompletionIndex(assets, logs, textLinks), [assets, logs, textLinks]);
  const textIndex = useMemo(() => buildTextIndex(assets), [assets]);
  const assetsById = useMemo(() => new Map(assets.map(a => [getAssetId(a), a])), [assets]);
  const latestRef = useRef({});
  latestRef.current = { textIndex, idColumn, visibleMonths, anchorYear, assets, fullMode, activeTab };

  const today = useMemo(() => new Date(), []);

  const rowLogsFor = (asset) => completionIndex.byAsset.get(getAssetId(asset));
  const [visibleKey, setVisibleKey] = useState('');   // visibleKeyNow, once it has stopped changing for 150 ms
  const [retryTick, setRetryTick] = useState(0);
  const queueRef = useRef([]);   // log requests waiting to start
  const activeRef = useRef(0);   // log requests in flight, across every run of the loader
  const pumpRef = useRef(null);
  const [reqLog, setReqLog] = useState([]);   // the last few log requests, shown on the Diagnostics tab
  // "Load all": every equipment for the months on screen, through the same paced queue (on-screen rows first).
  const [loadAllOn, setLoadAllOn] = useState(false);
  const [loadAll, setLoadAll] = useState(null);     // { total, done, finished, months } while running or just finished
  const loadAllRef = useRef(false);                 // true once the loader has queued a Load all run; the pump ends the run when the queue drains
  const allIds = useMemo(() => assets.map(getAssetId).filter(Boolean), [assets]);
  // "Read" on a room or area bar: one run per press, holding the equipment ids and the year and months on screen at
  // that moment, so the area loads without being opened. A run is dropped once the queue drains (loaded or failed),
  // by Stop reading, by Cancel and by Sync; later month or year changes load only what is on screen.
  const [pinnedRuns, setPinnedRuns] = useState([]);
  const lastYearRunsRef = useRef([]);   // the runs of the last Read year to date, so Retry can ask for the slices that failed
  const pinnedSet = useMemo(() => { const s = new Set(); pinnedRuns.forEach(r => r.ids.forEach(id => s.add(id))); return s; }, [pinnedRuns]);
  const pendingKeysRef = useRef([]);                   // read slices waiting for the flush that applies their rows
  const [loadedTick, setLoadedTick] = useState(0);   // bumped when loaded log rows (or an empty result) have been applied

  // Initialize Slicer with Previous, Current, and Next month
  useEffect(() => {
    const curMonth = today.getMonth();
    const range = [];
    if (curMonth > 0) range.push(curMonth - 1);
    range.push(curMonth);
    if (curMonth < 11) range.push(curMonth + 1);
    setVisibleMonths(range);
  }, [today]);

  // Separate from Sync on purpose: this is the only place the calendar writes to Dataverse.
  const saveTextMatches = async () => {
    if (isSaving || typeof Xrm === 'undefined' || !textLinks.size) return;
    if (!window.confirm(`Store the equipment id (craa5_equipmentguid) on ${textLinks.size} text-matched log row(s) in Dataverse?`)) return;
    setIsSaving(true);
    const epoch = epochRef.current;
    try {
      const wb = await writeBackTextLinks(logs, textLinks);
      if (epochRef.current !== epoch) return; // a Sync replaced the data while saving
      // Remove only the links that were written: others may have been added while the updates ran.
      setLogs(prev => [...prev]);
      setTextLinks(prev => { const next = new Map(prev); wb.writtenKeys.forEach(k => next.delete(k)); return next; });
      setSyncNotes(prev => [...prev, `Stored the equipment id on ${wb.written} log(s)${wb.failed ? `; ${wb.failed} could not be updated and stay text-matched` : ''}.`]);
    } finally {
      setIsSaving(false);
    }
  };

  // Rows from several requests are applied in one state update (at most every 250 ms): every update
  // re-renders the grid, and doing that once per request is what makes a large grid stutter.
  const flushLogs = useCallback(() => {
    const due = !!flushTimerRef.current || pendingLogsRef.current.length > 0 || pendingKeysRef.current.length > 0;
    if (flushTimerRef.current) { clearTimeout(flushTimerRef.current); flushTimerRef.current = null; }
    const batch = pendingLogsRef.current, links = pendingLinksRef.current, keys = pendingKeysRef.current;
    pendingLogsRef.current = [];
    pendingLinksRef.current = new Map();
    pendingKeysRef.current = [];
    if (links.size) setTextLinks(prev => { const next = new Map(prev); links.forEach((v, k) => next.set(k, v)); return next; });
    if (batch.length) setLogs(prev => prev.concat(batch));
    // A month counts as read only here, in the same update as its rows, so the frequency check never sees a read
    // month whose rows are still on their way (it would call the equipment overdue for a moment).
    keys.forEach(({ list, loaded, inflight }) => list.forEach(k => { loaded.add(k); inflight.delete(k); }));
    if (due) setLoadedTick(t => t + 1);
  }, []);

  const addLogs = useCallback((rows, links) => {
    rows.forEach(l => {
      const k = getLogKey(l);
      if (logKeysRef.current.has(k)) return;
      logKeysRef.current.add(k);
      pendingLogsRef.current.push(l);
      if (links && links.has(k)) pendingLinksRef.current.set(k, links.get(k));
    });
    // Even an empty result changes what counts as read, so a flush is always due.
    if (!flushTimerRef.current) flushTimerRef.current = setTimeout(flushLogs, 250);
  }, [flushLogs]);

  // Sync loads the equipment directory only (four small columns) and checks the log table has the id column.
  // Logs are then loaded per visible equipment and month by the loader below.
  const triggerSync = async () => {
    if (isLoading || isSaving) return;
    setIsLoading(true);
    setLoadProgress(5);
    loadAllRef.current = false;
    setLoadAllOn(false);
    setLoadAll(null);
    setPinnedRuns(prev => prev.length ? [] : prev);
    lastYearRunsRef.current = [];

    try {
      let fetchedAssets = [];
      let fetchedLogs = [];
      const notes = [];
      let hasIdColumn = typeof Xrm !== 'undefined';
      if (typeof Xrm !== 'undefined') {
        missingAssetColumns.clear();
        const a = await retrieveAssets();
        fetchedAssets = a.rows;
        if (a.truncated) notes.push(`Only the first ${fetchedAssets.length} equipment rows were loaded.`);
        if (missingAssetColumns.size) notes.push(`The equipment table has no ${Array.from(missingAssetColumns).join(', ')} column${missingAssetColumns.size === 1 ? '' : 's'}, so ${missingAssetColumns.size === ASSET_FREQ_COLUMNS.length ? 'the frequency medallion cannot tell which cleans are due' : 'those frequencies cannot be checked'}.`);
        setLoadProgress(50);

        // Does the log table have the equipment id column at all? (One row, no data used.)
        try {
          await Xrm.WebApi.retrieveMultipleRecords("craa5__log_", `?$select=${LOG_ASSET_ID_SELECT}&$top=1`);
        } catch (err) {
          if (!isMissingColumnError(err)) throw err;
          hasIdColumn = false;
          notes.push(`Log id column ${LOG_ASSET_ID_SELECT} unavailable (${err.message}); logs are matched by equipment name only.`);
        }
      } else {
        setLoadProgress(40);
        // Simulation with many items to test equipment pagination
        fetchedAssets = Array.from({ length: 100 }, (_, i) => ({
          craa5_aa_assetsid: `a-${i}`,
          craa5_equipmentidentifier: `Equipment ${i + 1}`,
          craa5_roomname: i < 50 ? 'Creme' : 'Bakery',
          craa5_areaname: i < 50 ? 'IBL4' : 'Ovens',
          craa5_dailyclean: i % 3 === 0, craa5_weeklyclean: i % 2 === 0, craa5_monthlyclean: i % 5 === 0
        }));
        fetchedLogs = [
          { craa5__log_id: 'l-1', craa5_equipmentguid: 'a-0', craa5_equipment: 'Equipment 1', craa5_lastcleaned: normalizeDateStr(today), craa5_lastcleanedby: 'EL/LH', craa5_uid: 'LOG-ID' }, // id match
          { craa5__log_id: 'l-2', craa5_equipment: 'Equipment 2', craa5_lastcleaned: normalizeDateStr(today), craa5_lastcleanedby: 'EL/LH', craa5_uid: 'LOG-TEXT' }, // text fallback
          { craa5__log_id: 'l-3', craa5_equipment: 'Nothing like this', craa5_lastcleaned: normalizeDateStr(today), craa5_lastcleanedby: 'EL/LH', craa5_uid: 'LOG-ORPHAN' } // unmapped
        ];
      }

      setLoadProgress(80);
      // Simulation only: with a real Dataverse, logs (and their text matches) arrive per visible equipment below.
      const links = computeTextLinks(buildTextIndex(fetchedAssets), fetchedLogs);

      // Swap the loader state together with the data. Requests started before this point finish into the
      // old sets and are ignored (epoch), so nothing half-loaded survives a Sync.
      epochRef.current += 1;
      setReqLog([]);
      diagSeqRef.current = { check: diagSeqRef.current.check + 1, lookup: diagSeqRef.current.lookup + 1 };
      missingLogColumns.clear();
      dateStyle = 0;
      setLogCheck(null);
      setLookup(null);
      loadedRef.current = new Set();
      inflightRef.current = new Set();
      queueRef.current = [];
      pendingLogsRef.current = [];
      pendingLinksRef.current = new Map();
      pendingKeysRef.current = [];
      if (flushTimerRef.current) { clearTimeout(flushTimerRef.current); flushTimerRef.current = null; }
      logKeysRef.current = new Set(fetchedLogs.map(getLogKey));
      setLogsLoading(false);
      setAssets(fetchedAssets);
      setLogs(fetchedLogs);
      setTextLinks(links);
      setSyncNotes(notes);
      setLoadErrors([]);
      setCanWriteBack(hasIdColumn);
      setIdColumn(hasIdColumn);
      // new runs may have been uploaded since the last read; the plain MSS does not read the plan, it is read when full mode (or the Line Downtime tab) asks
      if (latestRef.current.fullMode || latestRef.current.activeTab === 'downtime') readPlan(latestRef.current.anchorYear);
      else planTriedRef.current = null;

      // Rooms and areas stay the way they were (a new room opens, a room or area that is gone drops out),
      // so a Sync reloads behind the view instead of closing everything.
      const rooms = new Set(), areaKeys = new Set();
      fetchedAssets.forEach(a => {
        const r = safeString(getProp(a, 'craa5_roomname')) || '[Unassigned Room]';
        rooms.add(r);
        areaKeys.add(`${r}|${safeString(getProp(a, 'craa5_areaname')) || '[Unassigned Area]'}`);
      });
      setExpandedKeys(prev => {
        const next = {};
        rooms.forEach(r => { next[r] = prev[r] === undefined ? true : prev[r]; });
        areaKeys.forEach(k => { if (prev[k]) next[k] = true; });
        return next;
      });
      setLoadProgress(100);
    } catch (err) {
      console.error("Sync Failure:", err);
      setSyncNotes([`Sync failed: ${err && err.message}`]);
    } finally {
      setTimeout(() => {
        setIsLoading(false);
        setLoadProgress(0);
      }, 500);
    }
  };

  const dayColWidth = useMemo(() => Math.floor(26 * zoom), [zoom]);
  const frozenWidth = 380;   // the original width: the medallion sits inside the equipment cell, the bar beside the room or area name

  const timelineDays = useMemo(() => {
    const days = [];
    let cur = new Date(anchorYear, 0, 1);
    while (cur.getFullYear() === anchorYear) {
      const mIdx = cur.getMonth();
      const isVisible = visibleMonths.includes(mIdx);

      if (isVisible) {
          days.push({
            dateStr: normalizeDateStr(cur),
            dayNum: cur.getDate(),
            month: MONTHS[mIdx],
            monthIdx: mIdx,
            week: getWeekNumber(cur),
            label: cur.toLocaleDateString('en-US', { weekday: 'short' }) + ' ' + cur.getDate(),
            isToday: normalizeDateStr(cur) === normalizeDateStr(today)
          });
      }
      cur.setDate(cur.getDate() + 1);
    }
    return days;
  }, [anchorYear, today, visibleMonths]);

  const monthSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const weekSpans = useMemo(() => {
    const spans = [];
    timelineDays.forEach(d => {
      const existing = spans.find(s => s.week === d.week && s.month === d.month);
      if (existing) existing.count++;
      else spans.push({ week: d.week, month: d.month, count: 1 });
    });
    return spans;
  }, [timelineDays]);

  const filteredTreeData = useMemo(() => {
    const map = {};
    const q = searchQuery.toLowerCase();
    assets.forEach(asset => {
      const equip = safeString(getProp(asset, 'craa5_equipmentidentifier'));
      const room = safeString(getProp(asset, 'craa5_roomname')) || '[Unassigned Room]';
      const area = safeString(getProp(asset, 'craa5_areaname')) || '[Unassigned Area]';
      
      const matchesSearch = !q || equip.toLowerCase().includes(q) || room.toLowerCase().includes(q) || area.toLowerCase().includes(q);

      if (matchesSearch) {
        if (!map[room]) map[room] = {};
        if (!map[room][area]) map[room][area] = [];
        map[room][area].push(asset);
      }
    });
    return map;
  }, [assets, searchQuery]);

  // PAGINATION CALCULATION (Rooms)
  const roomKeys = Object.keys(filteredTreeData);
  const totalPages = Math.ceil(roomKeys.length / pageSize);
  const pagedRoomKeys = roomKeys.slice(currentPage * pageSize, (currentPage + 1) * pageSize);

  // The equipment on screen, worked out from state (open rooms and areas, their pages, the focused dialog),
  // not from what happened to render, so it cannot be disturbed by re-renders such as mouse moves. It mirrors
  // the two render paths below: the main grid and the focused dialog.
  // A stored page never points past the end of the list it pages (the list shrinks on a filter or a Sync).
  const pageOf = (pages, key, length, size) => Math.min(pages[key] || 0, Math.max(0, Math.ceil(length / size) - 1));
  const onMatrix = useMemo(() => {
    const grid = new Set();
    const dialog = new Set();
    pagedRoomKeys.forEach(room => {
      if (!expandedKeys[room]) return;
      Object.keys(filteredTreeData[room]).forEach(area => {
        const ak = `${room}|${area}`;
        if (!expandedKeys[ak]) return;
        const page = pageOf(areaPages, ak, filteredTreeData[room][area].length, equipmentPageSize);
        filteredTreeData[room][area].slice(page * equipmentPageSize, (page + 1) * equipmentPageSize).forEach(a => grid.add(getAssetId(a)));
      });
    });
    if (modalContext) {
      Object.keys(filteredTreeData)
        .filter(r => modalContext.type === 'room' ? r === modalContext.value : filteredTreeData[r][modalContext.value])
        .forEach(room => Object.keys(filteredTreeData[room])
          .filter(a => modalContext.type === 'area' ? a === modalContext.value : true)
          .forEach(area => {
            const page = pageOf(modalPages, `${room}|${area}`, filteredTreeData[room][area].length, MODAL_PAGE_SIZE);
            filteredTreeData[room][area].slice(page * MODAL_PAGE_SIZE, (page + 1) * MODAL_PAGE_SIZE).forEach(a => dialog.add(getAssetId(a)));
          }));
    }
    return { grid: Array.from(grid), dialog: Array.from(dialog) };
  }, [pagedRoomKeys, expandedKeys, areaPages, filteredTreeData, modalContext, modalPages]);
  // What the loader reads: the grid only while the matrix tab is showing, the dialog whenever it is open.
  const visibleKeyNow = useMemo(
    () => Array.from(new Set((activeTab === 'master' ? onMatrix.grid : []).concat(onMatrix.dialog))).join(','),
    [activeTab, onMatrix]
  );
  // Only restarts when the set itself changes, so quick clicks through areas become one request round.
  useEffect(() => {
    if (visibleKeyNow === visibleKey) return;
    const t = setTimeout(() => setVisibleKey(visibleKeyNow), 150);
    return () => clearTimeout(t);
  }, [visibleKeyNow, visibleKey]);

  // --- Frequency check ---
  // For every equipment: which frequencies are set on it, and for each whether a clean of at least that kind is
  // dated within the frequency's window (ok), none is and every month of the window has been read for this
  // equipment (overdue), or the window still has unread months (unknown; the medallion says which to read).
  const todayStr = normalizeDateStr(today);
  const freqWindows = useMemo(() => FREQS.map(f => {
    const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - f.days);
    const months = [];
    let y = start.getFullYear(), m = start.getMonth();
    while (y < today.getFullYear() || (y === today.getFullYear() && m <= today.getMonth())) { months.push([y, m]); m += 1; if (m > 11) { m = 0; y += 1; } }
    return { ...f, start: normalizeDateStr(start), months };
  }), [today]);
  // "2026-09" for each month on screen: a log dated in one of them counts as a clean on screen.
  const visiblePrefixes = useMemo(() => visibleMonths.map(m => `${anchorYear}-${String(m + 1).padStart(2, '0')}`), [visibleMonths, anchorYear]);
  const freqStatus = useMemo(() => {
    const loaded = loadedRef.current;
    const out = new Map();
    assets.forEach(asset => {
      const id = getAssetId(asset);
      const name = safeString(getProp(asset, 'craa5_equipmentidentifier')).trim().toLowerCase();
      // A month is read once its id slice is in (with the id column) and the name slice is in too: old entries whose
      // stored id is blank or wrong arrive only through the name request, which is queued after the id one and can
      // fail on its own. Without the id column the name slice is all there is.
      const isRead = (y, m) => monthIsRead(loaded, idColumn, id, name, y, m);
      const unreadable = !idColumn && !name;     // nothing could ever be asked for this equipment
      const latest = [null, null, null, null];   // newest clean of at least rank 1, 2, 3 (dated today or earlier)
      const days = completionIndex.byAsset.get(id);
      let doneVisible = 0;   // days on screen with a log for this equipment
      if (days) days.forEach((entry, date) => {
        if (visiblePrefixes.includes(date.slice(0, 7))) doneVisible += 1;
        if (date > todayStr) return;
        const r = entryRank(entry);
        for (let k = 1; k <= 3; k++) if (r >= k && (!latest[k] || date > latest[k])) latest[k] = date;
      });
      const badges = unreadable ? [] : freqWindows.filter(f => f.flags.some(c => isTrue(asset[c]))).map(f => {
        const last = latest[f.rank];
        if (last && last >= f.start) return { code: f.code, label: f.label, days: f.days, state: 'ok', last, start: f.start, missing: [] };
        const missing = f.months.filter(([y, m]) => !isRead(y, m));
        return { code: f.code, label: f.label, days: f.days, state: missing.length ? 'unknown' : 'overdue', last, start: f.start, missing };
      });
      const state = badges.some(b => b.state === 'overdue') ? 'overdue' : badges.some(b => b.state === 'ok') ? 'ok' : badges.length ? 'unknown' : 'none';
      const unread = badges.some(b => b.state === 'unknown');   // some frequency still has months to read
      const partial = state !== 'unknown' && unread;            // settled on one frequency, not yet on another
      const missing = {};
      badges.forEach(b => b.missing.forEach(([y, m]) => { missing[`${y}-${m}`] = [y, m]; }));
      const missingMonths = Object.keys(missing).map(k => missing[k]);
      // Every month on screen has been read for this equipment (by id and by name), so a blank row means no clean.
      const readVisible = !unreadable && visibleMonths.length > 0 && visibleMonths.every(m => isRead(anchorYear, m));
      out.set(id, {
        badges, state, partial, unread, missingMonths, lastAny: latest[1], noName: unreadable, unreadable, doneVisible, readVisible,
        needsVisible: !unreadable && !readVisible && visibleMonths.length > 0   // Read on the bar would load months for it
      });
    });
    return out;
    // loadedTick stands in for loadedRef.current, which is not state.
    // eslint-disable-next-line
  }, [assets, completionIndex, loadedTick, visibleMonths, anchorYear, idColumn, freqWindows, todayStr, visiblePrefixes]);

  // Room and area rows, by the done-or-blank method: how many equipment were cleaned on a day on screen, missed (every
  // month on screen read, no log), not read yet, or cannot be read; plus, per day on screen, how many were cleaned.
  const groupStatus = useMemo(() => {
    const groups = {};
    const blank = (room, area) => ({ room, area, total: 0, cleaned: 0, missed: 0, unread: 0, unreadable: 0, needsVisible: [], days: {} });
    const add = (g, asset) => {
      const id = getAssetId(asset);
      const st = freqStatus.get(id);
      g.total += 1;
      if (!st) return;
      if (st.doneVisible) g.cleaned += 1; else if (st.unreadable) g.unreadable += 1; else if (st.readVisible) g.missed += 1; else g.unread += 1;
      if (st.needsVisible) g.needsVisible.push(id);
      const days = st.doneVisible ? completionIndex.byAsset.get(id) : null;
      if (days) days.forEach((entry, date) => { if (visiblePrefixes.includes(date.slice(0, 7))) g.days[date] = (g.days[date] || 0) + 1; });
    };
    Object.keys(filteredTreeData).forEach(room => {
      const rg = groups[room] = blank(room, null);
      Object.keys(filteredTreeData[room]).forEach(area => {
        const ag = groups[`${room}|${area}`] = blank(room, area);
        filteredTreeData[room][area].forEach(a => { add(rg, a); add(ag, a); });
      });
    });
    Object.keys(groups).forEach(k => {
      const g = groups[k];
      g.state = g.cleaned && !g.missed ? 'ok' : g.cleaned && g.missed ? 'partial' : g.missed ? 'missed' : 'unknown';
    });
    return groups;
  }, [filteredTreeData, freqStatus, completionIndex, visiblePrefixes]);

  // --- Completion percentages (see COMPLETION PERCENTAGES) ---
  // Over the equipment listed after the search filter, from the logs read so far; what has not been read is left out
  // and counted as "not read yet". The focused dialog gets its own figures for the room or area it shows.
  const completion = useMemo(() => {
    if (activeTab !== 'master' || !fullMode) return null;
    const list = [], keys = [];
    Object.keys(filteredTreeData).forEach(room => Object.keys(filteredTreeData[room]).forEach(area => filteredTreeData[room][area].forEach(a => { list.push(a); keys.push([figKey(room), figKey(room, area)]); })));
    // the same pass also gives every room's and area's own figure (perKey)
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules, bucketsOf: (a, i) => keys[i] });
    // loadedTick stands in for loadedRef.current, which is not state.
    // eslint-disable-next-line
  }, [activeTab, fullMode, filteredTreeData, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  const completionModal = useMemo(() => {
    if (!modalContext || !fullMode) return null;
    const list = [];
    Object.keys(filteredTreeData)
      .filter(r => modalContext.type === 'room' ? r === modalContext.value : filteredTreeData[r][modalContext.value])
      .forEach(room => Object.keys(filteredTreeData[room])
        .filter(a => modalContext.type === 'area' ? a === modalContext.value : true)
        .forEach(area => filteredTreeData[room][area].forEach(a => list.push(a))));
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules });
    // eslint-disable-next-line
  }, [modalContext, fullMode, filteredTreeData, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  // Full mode, the room and area rows on screen: each one's figure for the slicer timeframe, taken from the same pass as the
  // two figures above the grid (a room's figure is what the tile would say for that room alone). One pass per refresh,
  // however many rows are drawn.
  const figureOf = useMemo(() => {
    if (!completion) return null;
    const none = { tf: { due: 0, done: 0 }, ytd: { due: 0, done: 0 }, equipment: 0, readTf: 0 };
    const cache = {};
    return (room, area) => { const k = figKey(room, area); return cache[k] || (cache[k] = groupFigure(completion.perKey[k] || none)); };
  }, [completion]);
  const pctCells = useMemo(() => completion ? completionCells(completion, timelineDays) : null, [completion, timelineDays]);
  const pctCellsModal = useMemo(() => completionModal ? completionCells(completionModal, timelineDays) : null, [completionModal, timelineDays]);
  // Read year to date: the months of this year so far, quarter by quarter (at most 3 months in a request), for the
  // equipment the figures cover, through the same paced queue as Read and Load all (at most 3 requests at a time).
  const readYear = useCallback(() => {
    if (typeof Xrm === 'undefined' || !completion || completion.endM < 0 || !completion.ids.length) return;
    const runs = [];
    for (let q = 0; q * 3 <= completion.endM; q++) runs.push({ ids: completion.ids, year: anchorYear, months: [q * 3, q * 3 + 1, q * 3 + 2].filter(m => m <= completion.endM) });
    if (completion.reachesPrev) runs.push({ ids: completion.ids, year: anchorYear - 1, months: [11] });   // the week that holds 1 January starts in December
    lastYearRunsRef.current = runs;
    setLoadErrors([]);
    setPinnedRuns(prev => prev.concat(runs));
  }, [completion, anchorYear]);

  // Name slices are keyed by one spelling, since the loader requests each name once however the equipment rows spell it.
  const sliceKey = (kind, year, m, item) => `${kind}|${year}|${m}|${kind === 'name' ? item.toLowerCase() : item}`;
  const jobKeys = (job) => job.items.flatMap(item => { const k = []; for (let m = job.m0; m <= job.m1; m++) k.push(sliceKey(job.kind, job.year, m, item)); return k; });

  // One global pump: at most MAX_PARALLEL_REQUESTS log requests in flight no matter how often the view changes.
  pumpRef.current = () => {
    while (activeRef.current < MAX_PARALLEL_REQUESTS && queueRef.current.length) {
      const job = queueRef.current.shift();
      activeRef.current += 1;
      (async () => {
        const started = performance.now();
        const entry = { kind: job.kind, items: job.items.length, months: `${MONTHS[job.m0].slice(0, 3)}${job.m1 > job.m0 ? '–' + MONTHS[job.m1].slice(0, 3) : ''} ${job.year}` };
        let applied = false;   // its slices go to the flush, which marks them read together with the rows
        try {
          const { rows, truncated } = job.kind === 'name'
            ? await fetchLogsByName(job.items, job.year, job.m0, job.m1, latestRef.current.idColumn)
            : await fetchLogsForAssets(job.items, job.year, job.m0, job.m1);
          if (epochRef.current === job.epoch) {
            if (truncated) {
              const note = `More than ${MAX_LOGS_PER_REQUEST.toLocaleString()} log rows matched one request, so only the first ${rows.length.toLocaleString()} were loaded. Narrow the months on screen.`;
              setSyncNotes(prev => prev.includes(note) ? prev : prev.concat(note));
            }
            pendingKeysRef.current.push({ list: jobKeys(job), loaded: job.loaded, inflight: job.inflight });
            applied = true;
            addLogs(rows, job.kind === 'name' ? computeTextLinks(latestRef.current.textIndex, rows) : null);
          }
          entry.rows = rows.length;
        } catch (err) {
          entry.error = String(err && err.message);
          if (epochRef.current === job.epoch) setLoadErrors(prev => prev.concat(String(err && err.message)).slice(-5));
        } finally {
          entry.ms = Math.round(performance.now() - started);
          if (epochRef.current === job.epoch) setReqLog(prev => prev.concat(entry).slice(-8));
          if (epochRef.current === job.epoch && loadAllRef.current) setLoadAll(prev => ({ ...(prev || {}), ...loadAllProgress() }));
          if (!applied) jobKeys(job).forEach(k => job.inflight.delete(k)); // the sets this job was created with, even after a Sync swapped them
          activeRef.current -= 1;
          pumpRef.current();
        }
      })();
    }
    if (!activeRef.current && !queueRef.current.length) {
      flushLogs();
      setLogsLoading(false);
      setPinnedRuns(prev => prev.length ? [] : prev);   // the Read runs are over, loaded or failed
      if (loadAllRef.current) {           // the Load all run has drained (every request done, or failed)
        loadAllRef.current = false;
        setLoadAll({ ...loadAllProgress(), finished: true });
        setLoadAllOn(false);
      }
    }
  };

  // How much of the Load all run is in: equipment whose every month on screen has been read (by id when the
  // log has the id column, otherwise by its name).
  const loadAllProgress = () => {
    const { idColumn: byId, visibleMonths: months, anchorYear: year, assets: list } = latestRef.current;
    const loaded = loadedRef.current;
    let done = 0, total = 0;
    list.forEach(a => {
      const item = byId ? getAssetId(a) : safeString(getProp(a, 'craa5_equipmentidentifier')).trim().toLowerCase();
      if (!item) return;   // nothing can be asked for it (no id, or no name without the id column)
      total += 1;
      if (months.every(m => loaded.has(`${byId ? 'id' : 'name'}|${year}|${m}|${item}`))) done += 1;
    });
    return { total, done, months: `${months.map(m => MONTHS[m].slice(0, 3)).join(', ')} ${year}` };
  };

  // Fetch logs for the equipment on screen, for the visible months only, and never twice.
  //  - 'id' jobs are the main path: every log stored against the equipment id (craa5_equipmentguid).
  //  - 'name' jobs catch old entries whose id is blank or matches no equipment, by the equipment name
  //    written on them (linked to equipment on the client, room and area deciding when several equipment
  //    share a name; an entry whose id matches an equipment row always goes to that equipment).
  useEffect(() => {
    // Requests that have not started are dropped and recomputed from what is on screen now.
    queueRef.current.forEach(j => jobKeys(j).forEach(k => j.inflight.delete(k)));
    queueRef.current = [];
    if (typeof Xrm === 'undefined' || isLoading) { pumpRef.current(); return; }
    const onScreen = visibleKey ? visibleKey.split(',') : [];
    let ids = onScreen;
    if (loadAllOn && visibleMonths.length) {
      const seen = new Set(onScreen);
      ids = onScreen.concat(allIds.filter(id => !seen.has(id)));   // what is on screen loads first
      loadAllRef.current = true;
    } else {
      loadAllRef.current = false;
    }
    {
      const loaded = loadedRef.current, inflight = inflightRef.current, epoch = epochRef.current;
      const queueKind = (kind, items, chunk, months, year) => {
        const keyOf = (item, m) => sliceKey(kind, year, m, item);
        // Group items by which months they are missing, so cached months are never requested again.
        const bySignature = new Map();
        items.forEach(item => {
          const missing = months.filter(m => !loaded.has(keyOf(item, m)) && !inflight.has(keyOf(item, m)));
          if (missing.length) {
            const sig = missing.slice().sort((x, y) => x - y).join(',');
            const group = bySignature.get(sig);   // push, not concat: copying the group for every item is quadratic
            if (group) group.push(item); else bySignature.set(sig, [item]);
          }
        });
        bySignature.forEach((sigItems, sig) => {
          monthRuns(sig.split(',').map(Number)).forEach(([m0, m1]) => {
            for (let i = 0; i < sigItems.length; i += chunk) {
              const job = { kind, items: sigItems.slice(i, i + chunk), m0, m1, year, epoch, loaded, inflight };
              jobKeys(job).forEach(k => inflight.add(k));
              queueRef.current.push(job);
            }
          });
        });
      };
      const queueIds = (list, months, year) => {
        if (!list.length || !months.length) return;
        const names = new Map();
        list.forEach(id => {
          const full = safeString(getProp(assetsById.get(id), 'craa5_equipmentidentifier')).trim();
          [full, nameBase(full)].forEach(n => { if (n && !names.has(n.toLowerCase())) names.set(n.toLowerCase(), n); });
        });
        if (idColumn) queueKind('id', list, ID_CHUNK, months, year);
        queueKind('name', Array.from(names.values()), NAME_CHUNK, months, year);
      };
      queueIds(ids, visibleMonths, anchorYear);
      pinnedRuns.forEach(run => queueIds(run.ids, run.months, run.year));   // the months on screen when Read was pressed
      if (queueRef.current.length) setLogsLoading(true);
    }
    pumpRef.current();
    // eslint-disable-next-line
  }, [visibleKey, visibleMonths, anchorYear, idColumn, assets, isLoading, retryTick, loadAllOn, allIds, pinnedRuns]);

  const retryLoads = () => {
    setLoadErrors([]);
    const again = lastYearRunsRef.current;
    if (again.length) setPinnedRuns(prev => prev.concat(again));   // a year read that lost slices asks for them again; the loaded ones are skipped
    setRetryTick(t => t + 1);
  };
  // Read on a bar: a run for these ids and the months on screen now. A press after a failed request queues the
  // missing months again, since the failed slices are neither read nor in flight.
  const readIds = useCallback((ids) => {
    if (typeof Xrm === 'undefined' || !ids.length || !visibleMonths.length) return;
    setLoadErrors([]);
    setPinnedRuns(prev => prev.concat({ ids, year: anchorYear, months: visibleMonths }));
  }, [anchorYear, visibleMonths]);
  const stopReading = () => { lastYearRunsRef.current = []; setPinnedRuns(prev => prev.length ? [] : prev); };
  // What a room or area bar needs: its counts, the months they cover, and whether its equipment is loading now.
  const onScreenSet = useMemo(() => new Set(visibleKeyNow ? visibleKeyNow.split(',') : []), [visibleKeyNow]);
  const monthsLabel = visibleMonths.length ? `${visibleMonths.map(m => MONTHS[m].slice(0, 3)).join(', ')} ${anchorYear}` : `${anchorYear}, no months selected`;
  const barProps = (key) => {
    const g = groupStatus[key];
    return { g, months: monthsLabel, canRead: typeof Xrm !== 'undefined' && !isLoading && visibleMonths.length > 0, onRead: readIds, busy: !!(logsLoading && g && g.needsVisible.some(id => pinnedSet.has(id) || onScreenSet.has(id))) };
  };
  // Hovering a check on a room or area row lists the equipment cleaned that day. Only the check is remembered: the names
  // are derived at render so a flush refreshes them, and the hover is dropped when its check leaves the screen (a filter,
  // Sync or year change removes the check without a mouseleave, so the tooltip would otherwise stick to the mouse).
  const [hoveredCell, setHoveredCell] = useState(null);   // { key, date }
  const hoverGroupDay = useCallback((key, date) => setHoveredCell({ key, date }), []);
  const leaveGroupDay = useCallback(() => setHoveredCell(null), []);
  const hoveredCellLive = !!(hoveredCell && groupStatus[hoveredCell.key] && groupStatus[hoveredCell.key].days[hoveredCell.date]);
  useEffect(() => { if (hoveredCell && !hoveredCellLive) setHoveredCell(null); }, [hoveredCell, hoveredCellLive]);
  const hoveredCellNames = useMemo(() => {
    if (!hoveredCellLive) return [];
    const g = groupStatus[hoveredCell.key];
    const areas = filteredTreeData[g.room] ? (g.area === null ? Object.keys(filteredTreeData[g.room]) : [g.area]) : [];
    const names = [];
    areas.forEach(a => (filteredTreeData[g.room][a] || []).forEach(asset => {
      const d = completionIndex.byAsset.get(getAssetId(asset));
      if (d && d.has(hoveredCell.date)) names.push(safeString(getProp(asset, 'craa5_equipmentidentifier')) || '(no name)');
