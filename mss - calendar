  const filteredTreeData = useMemo(() => {
    const map = {};
    const q = searchQuery.toLowerCase();
    const allowRooms = activePreset && Array.isArray(activePreset.allowedRooms) && activePreset.allowedRooms.length > 0 ? activePreset.allowedRooms : null;
    const allowAreas = activePreset && Array.isArray(activePreset.allowedAreas) && activePreset.allowedAreas.length > 0 ? activePreset.allowedAreas : null;
    assets.forEach(asset => {
      const equip = safeString(getProp(asset, 'craa5_equipmentidentifier'));
      const room = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
      const area = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
      if (allowRooms && !allowRooms.includes(room)) return;
      if (allowAreas && !allowAreas.includes(area)) return;
      
      const matchesSearch = !q || equip.toLowerCase().includes(q) || room.toLowerCase().includes(q) || area.toLowerCase().includes(q);

