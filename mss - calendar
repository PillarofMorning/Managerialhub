            return (
              <React.Fragment key={d.ymd}>
                <div className={'dt-cell' + (c.cls ? ' ' + c.cls : '') + (d.ymd === todayStr ? ' today' : '') + (d.day === 1 ? ' first' : '')} data-ymd={d.ymd} data-status={c.status} title={c.title}>
                  {d.day === 1 ? d.day + ' ' + MONTHS[d.month].slice(0, 3) : d.day}
                </div>
                {wk && <div className={'dt-wk ' + wk.cls} data-testid="dt-wk" data-week={view.days[i - 6].date} data-weekly={wk.cls} title={wk.title}>{wk.sym}</div>}
              </React.Fragment>
            );
          })}
        </div>
      )}
    </section>
  );
});

function LineDowntimeTab({ assets, lines, setLines, saved, shared, plan, planYear, planModel, rules, onReadPlan }) {
  const cpData = plan && plan.data && plan.data.year === planYear ? plan.data : null;
  const cpNote = !cpData ? '' : cpData.cleanPlan
    ? (cpData.cleanPlan.weeks ? ' Clean Plan: ' + cpData.cleanPlan.areas + ' areas, ' + cpData.cleanPlan.weeks + ' published weeks read.' : ' Clean Plan: no published week yet, so the calendar uses its own rule.')
    : cpData.cleanPlanError ? ' Clean Plan could not be read (' + cpData.cleanPlanError + '), so the calendar uses its own rule.' : '';
  const todayStr = dtYmd(new Date());
  const [area, setArea] = useState('');
  const [num, setNum] = useState(null);                   // what was typed in the Line box; until then (null) it offers the next free number of the area
  const [msg, setMsg] = useState(null);                     // { kind: 'error' | 'ok', text } after pressing Add line
  const [start, setStart] = useState(() => dtMonday(dtYmd(new Date())));
  const areaNames = useMemo(() => dtAreaNames(assets), [assets]);
  const areaCounts = useMemo(() => lrAreaCounts(assets), [assets]);
  const coverage = useMemo(() => lrCoverage(assets, rules), [assets, rules]);
  const cards = useMemo(() => lrCards(planModel, lines), [planModel, lines]);
  const strip = useMemo(() => dtStripDays(start, DT_STRIP_WEEKS), [start]);
  const thisMonday = dtMonday(todayStr);
  const views = useMemo(() => { const m = {}; cards.forEach(c => { m[c.key] = lrPreview(rules, c.key, start, DT_STRIP_WEEKS); }); return m; }, [cards, rules, start]);
  const nows = useMemo(() => {
    const m = {}, idx = (new Date().getDay() + 6) % 7;
    cards.forEach(c => { const v = lrPreview(rules, c.key, thisMonday, 1); m[c.key] = v && v.cal ? { planned: v.cal.planned[0], prod: v.cal.prod ? v.cal.prod[idx] : 0 } : null; });
    return m;
  }, [cards, rules, thisMonday]);
  // normalized MSS area -> keys of every line that follows it (a line that shares an area with another is marked "shared")
  const sharedWith = useMemo(() => { const m = {}; rules.areaTo.forEach((list, k) => { m[k] = list; }); return m; }, [rules]);
  // Typing on a line the plan has (not typed before) creates its record on the first change; one record per area and line number.
  const patch = useCallback((card, fn) => setLines(prev => {
    const i = prev.findIndex(l => dtSame(l, card.area, card.line));
    if (i > -1) return prev.map((l, j) => (j === i ? fn(l) : l));
    return prev.concat([fn({ id: dtId(), area: card.area, line: card.line, days: [], off: [], areas: [] })]);
  }), [setLines]);
  const remove = useCallback((id) => setLines(prev => prev.filter(l => l.id !== id)), [setLines]);
  const canPrev = !!dtParse(dtAddDays(start, -7 * DT_STRIP_WEEKS));                    // the preview stays inside the years dtParse accepts
  const canNext = !!dtParse(dtAddDays(start, 14 * DT_STRIP_WEEKS - 1));
  const shownNum = num === null ? String(dtNextNo(cards, area)) : num;
  const addLine = () => {
    const name = dtCollapse(area).slice(0, 80);
    const text = shownNum.trim();
    const n = /^\d{1,2}$/.test(text) ? Number(text) : 0;
    if (!name) return setMsg({ kind: 'error', text: 'Type the area name first.' });
    if (!(n >= 1 && n <= 99)) return setMsg({ kind: 'error', text: 'The line number is a whole number from 1 to 99.' });
    if (cards.some(l => dtSame(l, name, n))) return setMsg({ kind: 'error', text: name + ', line ' + n + ' is already in the list.' });
    setLines(prev => prev.concat([{ id: dtId(), area: name, line: n, days: [], off: [], areas: [] }]));
    setNum(null);                                         // the box goes back to offering the next free number of the area
    setMsg({ kind: 'ok', text: 'Added ' + name + ', line ' + n + '.' });
  };
  return (
    <main className="flex-1" style={{ minHeight: 0, overflow: 'auto', padding: '24px clamp(16px, 3vw, 32px)', background: '#F7F9FC' }} data-testid="downtime">
      <div className="dt-wrap">
        <h2 style={{ fontSize: '18px', fontWeight: '900', margin: 0, color: BRAND.blueDark }}>Line Downtime</h2>
        <p className="dt-intro" data-testid="dt-intro">
          The lines and their downtime come from the production plan, the runs the Production Schedule hub saves. A Daily job is due on a day the line has an hour or more without production{LR_IDLE_MODE === 'stretch' ? ', except that two or more days in a row with almost no production (a down weekend included) share one Daily job, on the last of them' : LR_IDLE_MODE === 'skip' ? ', a weekend it was down needs one Daily job for both days and a day it did not produce otherwise has none' : ', but a weekend the line was down needs one Daily job for both days'}, and the mid-week and weekly jobs count only in a week the line ran.
          Pick the MSS areas each line cleans; equipment in other areas keeps the plain rule. Off schedule takes production out of the dates you give.
          These rules set the Completion tab and the daily and weekly rows of the MSS in full mode (the CJ Schwan's logo).
        </p>
        <PlanPanel plan={plan} planYear={planYear} planModel={planModel} coverage={coverage} assetsReady={assets.length > 0} todayStr={todayStr} onRead={onReadPlan} />
        <p className={'dt-foot' + (saved || (shared && shared !== 'offline' && shared !== 'failed') ? '' : ' warn')} data-testid="dt-saved">
          {shared && shared !== 'offline'
            ? 'What you type here (areas, off-schedule days): ' + SHARED_TEXT[shared] + ' Lines the Production Scheduler plans take their downtime from its Clean Plan when it is published; what you type counts only for lines it does not plan.' + cpNote
            : saved
              ? 'What you type here (areas, off-schedule days) is saved in this browser. Other people and other browsers do not see it.'
              : 'This browser would not save what you type here, so it lasts only until the page is closed.'}
        </p>

        <form className="diag-card dt-add" noValidate onSubmit={(e) => { e.preventDefault(); addLine(); }}>
          <label className="dt-field grow">
            <span>Add a line that is not in the plan</span>
            <input list="dt-areas" value={area} autoComplete="off" placeholder={areaNames.length ? 'Pick or type the area' : 'Type the area, as the production schedule has it'} data-testid="dt-area" onChange={(e) => { setArea(e.target.value); setMsg(null); }} />
          </label>
          <datalist id="dt-areas">{areaNames.map(n => <option key={n} value={n} />)}</datalist>
          <label className="dt-field">
            <span>Line</span>
            <input type="number" min="1" max="99" step="1" value={shownNum} style={{ width: '76px' }} data-testid="dt-line-no" onChange={(e) => { setNum(e.target.value); setMsg(null); }} />
          </label>
          <button type="submit" className="sync-btn" data-testid="dt-add-line" onClick={ignoreRepeat}>Add line</button>
          {!areaNames.length && <span className="dt-hint" style={{ flexBasis: '100%', margin: 0 }}>Press Sync Dataverse for the area names to be suggested here.</span>}
          <span className={'dt-msg ' + (msg ? msg.kind : '')} role="status" data-testid="dt-msg">{msg ? msg.text : ''}</span>
        </form>

        <div className="dt-toolbar">
          <span className="dt-label inline">Preview</span>
          <button type="button" className="page-btn" aria-label="Earlier weeks" title="Earlier weeks" data-testid="dt-prev" disabled={!canPrev} onClick={() => setStart(s => dtAddDays(s, -7 * DT_STRIP_WEEKS))}><ChevronLeftIcon /></button>
          <span className="dt-range-text" data-testid="dt-range-text">{strip.length ? dtRangeText(strip[0].ymd, strip[strip.length - 1].ymd) : ''}</span>
          <button type="button" className="page-btn" aria-label="Later weeks" title="Later weeks" data-testid="dt-next" disabled={!canNext} onClick={() => setStart(s => dtAddDays(s, 7 * DT_STRIP_WEEKS))}><ChevronRightLargeIcon /></button>
          <button type="button" className="page-btn" data-testid="dt-this-week" disabled={start === thisMonday} onClick={() => setStart(thisMonday)}>This week</button>
          <span className="dt-legend" data-testid="dt-legend">
            <span><i className="dt-sw due" />Daily job due</span>
            <span><i className="dt-sw wk" />{LR_IDLE_MODE === 'stretch' ? 'Last day of a down stretch: one Daily job for all of it' : 'Sunday: one Daily job for the weekend'}</span>
            <span><i className="dt-sw cov" />{LR_IDLE_MODE === 'stretch' ? 'Day that job covers' : 'Saturday it covers'}</span>
            <span><i className="dt-sw off" />Off schedule</span>
            <span><i className="dt-sw nop" />No plan</span>
          </span>
        </div>

        {cards.length === 0
          ? <div className="diag-card dt-empty" data-testid="dt-empty">{plan.data && plan.data.year === planYear ? 'The plan has no runs for ' + planYear + ' yet, and no line was added by hand.' : 'No lines yet. They appear here when the production plan is read; you can also add a line above.'}</div>
          : <div className="dt-grid">{cards.map(c => <LineCard key={c.key} card={c} view={views[c.key]} now={nows[c.key]} todayStr={todayStr} assetsReady={assets.length > 0} areaCounts={areaCounts} sharedWith={sharedWith} onPatch={patch} onRemove={remove} />)}</div>}
      </div>
    </main>
  );
}

// ----------------------------------------------------------------------------
// COMPLETION TAB: the totals, what counts, and Top missed with quick frequency editing. comp and count are worked out in App only while
// this tab is open; the frequency edits and the exclusions live in App and survive a switch of tab, while the lens, months, scope,
// find text and open rooms below are lost when it closes.
// ----------------------------------------------------------------------------
const MISSED_PAGE = 10;
const FREQ_ORDER = FREQS.map((f) => f.code);
const freqLabelOf = (code) => (FREQS.filter((f) => f.code === code)[0] || { label: code }).label;
function CompletionTab({ comp, count, ex, setEx, exSaved, exShared, assets, assetsById, connected, anchorYear, thisYear, monthsLabel, tiles, planText, reading, locked, onReadIds, freqEdits, setFreqEdits, freqSave, onSave, onDismissSave }) {
  const [lens, setLens] = useState('equipment');
  const [metric, setMetric] = useState('tf');
  const [code, setCode] = useState('');                  // '' = every frequency letter
  const [scope, setScope] = useState(null);              // null, or { room } / { room, area }: where Top missed is narrowed to
  const [query, setQuery] = useState('');
  const [page, setPage] = useState(0);
  const [openRooms, setOpenRooms] = useState({});
  const [eqQuery, setEqQuery] = useState('');
  const [showAllLeft, setShowAllLeft] = useState(false);
  const [confirmReset, setConfirmReset] = useState(false);   // "Count everything again" asks once before it clears the choices
  const [confirm, setConfirm] = useState(null);          // null, 'all', or the id of the one equipment to save
  const confirmRef = useRef(null);
  const saving = !!(freqSave && freqSave.busy);
  const rows = useMemo(() => missedRows({ comp: comp, count: count, lens: lens, metric: metric, code: lens === 'equipment' ? code : '', scope: scope, query: query }), [comp, count, lens, metric, code, scope, query]);
  const pages = Math.max(1, Math.ceil(rows.length / MISSED_PAGE));
  const pageNow = Math.min(page, pages - 1);
  const shown = rows.slice(pageNow * MISSED_PAGE, (pageNow + 1) * MISSED_PAGE);
  const left = exCount(ex);
  const metricText = metric === 'ytd' ? (anchorYear === thisYear ? 'the year to date' : 'the whole year ' + anchorYear) : 'the slicer months (' + monthsLabel + ')';
  const nameOf = (id) => { const a = assetsById.get(id); return a ? safeString(getProp(a, 'craa5_equipmentidentifier')) || '(no name)' : 'Equipment no longer in the list'; };
  const whereOf = (id) => { const a = assetsById.get(id); return a ? exRoomOf(a) + ' / ' + exAreaOf(a) : ''; };
  const scopeBase = comp && scope ? (comp.perKey[scope.area ? figKey(scope.room, scope.area) : figKey(scope.room)] || { equipment: 0, readTf: 0, readYtd: 0 }) : comp;   // what the "N read" note counts: the scope, or everything
  const letters = useMemo(() => missByLetter({ comp: comp, count: count, metric: metric, scope: scope, query: query }), [comp, count, metric, scope, query]);
  const allOut = !!comp && comp.equipment === 0 && !!count && count.withFreq > 0;   // every equipment with a frequency was left out

  // ---- what counts
  const toggleRoom = (room) => setEx((prev) => exToggle(prev, 'rooms', room));
  const toggleArea = (room, area) => setEx((prev) => exToggle(prev, 'areas', exAreaKey(room, area)));
  const toggleEquipment = (id) => setEx((prev) => exToggle(prev, 'equipment', id));
  const found = useMemo(() => {
    const q = eqQuery.trim().toLowerCase();
    if (q.length < 2) return { list: [], more: false };
    const out = [];
    for (let i = 0; i < assets.length && out.length < 13; i++) {
      const a = assets[i];
      if (!FREQS.some((f) => f.flags.some((c) => isTrue(a[c])))) continue;
      const name = safeString(getProp(a, 'craa5_equipmentidentifier'));
      if ((name + ' ' + exRoomOf(a) + ' ' + exAreaOf(a)).toLowerCase().indexOf(q) > -1) out.push({ id: getAssetId(a), name: name || '(no name)', room: exRoomOf(a), area: exAreaOf(a) });
    }
    const more = out.length > 12;
    if (more) out.length = 12;
    return { list: out, more: more };
  }, [eqQuery, assets]);
  // Equipment left out that is still in the list, and entries that match nothing now (renamed or deleted rooms, areas, equipment).
  const leftAll = Object.keys(ex.equipment);
  const leftIds = leftAll.filter((id) => assetsById.has(id));
  const stale = useMemo(() => {
    if (!count || !assets.length) return [];
    const roomsNow = {}, areasNow = {}, out = [];
    count.tree.forEach((r) => { roomsNow[r.room] = true; r.areas.forEach((a) => { areasNow[exAreaKey(r.room, a.area)] = true; }); });
    Object.keys(ex.rooms).forEach((k) => { if (!exHas(roomsNow, k)) out.push({ kind: 'rooms', key: k, label: k }); });
    Object.keys(ex.areas).forEach((k) => { if (!exHas(areasNow, k)) out.push({ kind: 'areas', key: k, label: k.split(EX_SEP).join(' / ') }); });
    Object.keys(ex.equipment).forEach((id) => { if (!assetsById.has(id)) out.push({ kind: 'equipment', key: id, label: 'Equipment no longer in the list' }); });
    return out;
  }, [count, ex, assets, assetsById]);

  // ---- Top missed
  const setLensTo = (l) => { setLens(l); setPage(0); };
  const drill = (l, sc) => { setLens(l); setScope(sc); setPage(0); setQuery(''); };
  const idsOf = (r) => count.meta.filter((m) => m.freqs.length && m.room === r.room && (r.kind === 'room' || m.area === r.area)).map((m) => m.id);
  // ---- frequency edits
  const editedIds = Object.keys(freqEdits);
  const changeCount = editedIds.reduce((n, id) => n + Object.keys(freqEdits[id]).length, 0);
  const effective = (r, c) => { const e = freqEdits[r.id]; return e && e[c] !== undefined ? e[c] : r.freqs.indexOf(c) > -1; };
  const toggleFreq = (r, c) => setFreqEdits((prev) => {
    const mine = prev[r.id] ? Object.assign({}, prev[r.id]) : {};
    const was = r.freqs.indexOf(c) > -1;
    const now = mine[c] !== undefined ? mine[c] : was;
    if (!now === was) delete mine[c]; else mine[c] = !now;
    const next = Object.assign({}, prev);
    if (Object.keys(mine).length) next[r.id] = mine; else delete next[r.id];
    return next;
  });
  const undo = (ids) => setFreqEdits((prev) => { const next = Object.assign({}, prev); ids.forEach((id) => { delete next[id]; }); return next; });
  const describe = (id) => Object.keys(freqEdits[id] || {}).sort((a, b) => FREQ_ORDER.indexOf(a) - FREQ_ORDER.indexOf(b)).map((c) => freqLabelOf(c).toLowerCase() + (freqEdits[id][c] ? ' on' : ' off')).join(', ');
  const confirmIds = confirm === 'all' ? editedIds : confirm && freqEdits[confirm] ? [confirm] : [];
  const doSave = () => { const ids = confirmIds.slice(); setConfirm(null); onSave(ids); };
  // The box that guards the write: gone when there is nothing left to save (so an old Save click cannot bring it back), and brought
  // into view with its Cancel button focused when it opens (it sits above the list, which can be scrolled far below it).
  useEffect(() => { if (confirm && !confirmIds.length) setConfirm(null); }, [confirm, confirmIds.length]);
  useEffect(() => { if (!left.total) setConfirmReset(false); }, [left.total]);
  useEffect(() => {
    const box = confirmRef.current;
    if (!confirm || !box) return;
    try {
      const sc = box.closest ? box.closest('.comp-main') : null;
      if (sc) {
        const b = box.getBoundingClientRect(), v = sc.getBoundingClientRect();
        if (b.top < v.top || b.bottom > v.bottom) sc.scrollTop += b.top - v.top - 12;
      }
      const no = box.querySelector('[data-testid="comp-confirm-no"]');
      if (no && no.focus) no.focus({ preventScroll: true });
    } catch (e) { /* the box stays where it is */ }
  }, [confirm]);

  const readOf = (b) => (metric === 'ytd' ? b.readYtd : b.readTf);
  const nothingRead = !!comp && comp.equipment > 0 && comp.tf.due === 0 && comp.ytd.due === 0;

  return (
    <main className="comp-main" data-testid="completion">
      <div className="comp-wrap">
        <h2 style={{ fontSize: '18px', fontWeight: '900', margin: 0, color: BRAND.blueDark }}>Completion</h2>
        <p className="dt-intro" data-testid="comp-intro">
          The completion percentages for the whole plant, what counts toward them, and the jobs missed most. Only what has been read from the log counts: a month not read yet is left out, never counted as missed.
          The slicer months above choose the months of the first figure; the other is the year so far.
        </p>
        <p className="dt-note" data-testid="comp-plan">{planText}</p>

        <div className="comp-tiles" data-testid="comp-tiles">{tiles}</div>

        <section className="diag-card comp-card" data-testid="comp-counts">
          <div className="comp-card-head">
            <h3>What counts</h3>
            <span className="comp-sum" data-testid="comp-summary">
              {comp ? comp.equipment.toLocaleString() : 0} of {count ? count.withFreq.toLocaleString() : 0} equipment with a frequency count{left.total ? ' - left out: ' + exSummary(left) : ''}
            </span>
            {left.total > 0 && !confirmReset && <button type="button" className="page-btn" data-testid="comp-reset" onClick={() => setConfirmReset(true)}>Count everything again</button>}
            {left.total > 0 && confirmReset && (
              <span className="dt-confirm" role="alertdialog" aria-label="Count everything again?" data-testid="comp-reset-confirm">
                <span>Count everything again? Every choice here is cleared.</span>
                <button type="button" className="page-btn danger" data-testid="comp-reset-yes" onClick={() => { setConfirmReset(false); setEx(exEmpty()); }}>Yes, count everything</button>
                <button type="button" className="page-btn" data-testid="comp-reset-keep" onClick={() => setConfirmReset(false)}>Keep my choices</button>
              </span>
            )}
          </div>
          <p className="dt-hint">Untick a room or an area to leave it out of every percentage, here and in the daily and weekly rows of the MSS in full mode. Leaving things out also makes Read year to date lighter. {exShared && exShared !== 'offline' ? SHARED_TEXT[exShared] : exSaved ? 'Your choice is saved in this browser.' : 'This browser would not save it, so it lasts until the page is closed.'}</p>
          {count && count.tree.length === 0 && <p className="dt-note" data-testid="comp-tree-empty">{assets.length ? 'No equipment to list.' : 'Press Sync Dataverse to load the rooms and areas.'}</p>}
          <div className="comp-tree" data-testid="comp-tree">
            {count && count.tree.map((r) => {
              const open = !!openRooms[r.room];
              const partial = !r.left && (r.counted < r.withFreq);
              return (
                <div key={r.room} className={'comp-room' + (r.left ? ' off' : '')} data-testid="comp-room" data-room={r.room} data-left={r.left ? '1' : '0'}>
                  <div className="comp-room-head">
                    <label className="comp-check">
                      <input type="checkbox" checked={!r.left} data-testid="comp-room-check" aria-label={'Count the room ' + r.room} onChange={() => toggleRoom(r.room)} />
                      <b className="comp-name">{r.room}</b>
                    </label>
                    <span className="comp-meta">{r.withFreq.toLocaleString()} equipment with a frequency{r.left ? ' - left out' : partial ? (r.counted ? ' - ' + r.counted.toLocaleString() + ' of them count' : ' - none of them count') : ''}</span>
                    <button type="button" className="comp-fold" aria-expanded={open} data-testid="comp-room-fold" onClick={() => setOpenRooms((p) => Object.assign({}, p, { [r.room]: !open }))}>{open ? 'Hide areas' : r.areas.length + ' area' + (r.areas.length === 1 ? '' : 's')}</button>
                  </div>
                  {open && (
                    <div className="comp-areas">
                      {r.areas.map((a) => (
                        <label key={a.area} className={'comp-check area' + (a.left || r.left ? ' off' : '')} data-testid="comp-area" data-area={a.area} data-left={a.left ? '1' : '0'}>
                          <input type="checkbox" checked={!a.left} disabled={r.left} data-testid="comp-area-check" aria-label={'Count the area ' + a.area + ' of ' + r.room} onChange={() => toggleArea(r.room, a.area)} />
                          <span className="comp-name">{a.area}</span>
                          <span className="comp-meta">{a.withFreq.toLocaleString()}</span>
                        </label>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
          <div className="comp-eq">
            <label className="dt-field grow">
              <span>Leave out one equipment</span>
              <input value={eqQuery} autoComplete="off" placeholder="Type part of its name, room or area" data-testid="comp-eq-find" onChange={(e) => setEqQuery(e.target.value)} />
            </label>
            {found.list.length > 0 && (
              <ul className="comp-found" data-testid="comp-found">
                {found.list.map((f) => {
                  const off = exHas(ex.equipment, f.id);
                  return (
                    <li key={f.id}>
                      <label className="comp-check">
                        <input type="checkbox" checked={!off} data-testid="comp-eq-check" data-id={f.id} aria-label={'Count ' + f.name} onChange={() => toggleEquipment(f.id)} />
                        <span className="comp-name">{f.name}</span><span className="comp-meta">{f.room} / {f.area}</span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            )}
            {found.more && <p className="dt-hint" data-testid="comp-found-more">Showing the first 12. Type more of the name to narrow it.</p>}
            {eqQuery.trim().length >= 2 && found.list.length === 0 && <p className="dt-hint">No equipment with a frequency matches.</p>}
            {leftAll.length > 0 && assets.length === 0 && <p className="dt-hint" data-testid="comp-left-eq-wait">{leftAll.length.toLocaleString()} equipment left out. Their names show after Sync Dataverse.</p>}
            {leftIds.length > 0 && (
              <div className="comp-left" data-testid="comp-left-eq">
                <span className="dt-label inline">Equipment left out</span>
                {(showAllLeft ? leftIds : leftIds.slice(0, 30)).map((id) => (
                  <span key={id} className="comp-pill" data-id={id} title={nameOf(id) + ' in ' + whereOf(id)}>{nameOf(id)}<em>{whereOf(id)}</em><button type="button" aria-label={'Count ' + nameOf(id) + ' in ' + whereOf(id) + ' again'} title="Count it again" onClick={() => toggleEquipment(id)}><XIcon /></button></span>
                ))}
                {leftIds.length > 30 && <button type="button" className="page-btn" onClick={() => setShowAllLeft((v) => !v)}>{showAllLeft ? 'Show fewer' : 'Show all ' + leftIds.length}</button>}
              </div>
            )}
            {stale.length > 0 && (
              <div className="comp-left" data-testid="comp-left-stale">
                <span className="dt-label inline">No longer in the list</span>
                {stale.slice(0, 30).map((t) => (
