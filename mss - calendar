        .freq-code.overdue { color: #fff; background: ${BRAND.red}; }
        .freq-code.unknown { color: #64748b; text-decoration: underline dotted; text-underline-offset: 2px; }

        /* ROOM AND AREA BARS (beside the name) AND DAY CHECKS (on the timeline) */
