        .comp-seg button:focus-visible { outline: 2px solid ${BRAND.blueDark}; outline-offset: -2px; }
        .comp-seg button.on:focus-visible { box-shadow: inset 0 0 0 4px #fff; }   /* a navy ring on the blue fill is nearly invisible: a white band inside it */
        .comp-seg.small button { padding: 5px 9px; }
        .comp-seg button i { font-style: normal; margin-left: 5px; font-size: 10px; color: ${BRAND.red}; }
