                            </span>
                            <span className="graphs-cost-num">${s.val.toLocaleString()} ({pct}%)</span>
                          </div>
                          <div className="graphs-mini-track">
                            <div style={{ width: `${pct}%`, background: s.color, height: '100%', borderRadius: 999 }} />
                          </div>
                        </div>
                      );
                    })}

                    <div className="graphs-opportunity-box">
                      <div className="graphs-opp-title">Operations Line Downtime Opportunity Comparison</div>
                      <div className="graphs-opp-row">
                        <span>Golden Window Value Captured ({totals.annualGoldenWindowHrs}h aligned):</span>
                        <b style={{ color: '#047857' }}>+${totals.annualGoldenWindowSavings.toLocaleString()}/yr saved</b>
                      </div>
                      <div className="graphs-opp-row">
                        <span>Unaligned Line Hold Exposure ({totals.unalignedExposureHrs}h at risk):</span>
                        <b style={{ color: BRAND.red }}>-${totals.unalignedExposureCost.toLocaleString()}/yr risk</b>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="graphs-insight-strip">
                  <span>
                    <b>Executive Takeaway:</b> A single hour of unplanned line hold (<b>${econ.downtimeCostHr.toLocaleString()}/hr</b>) costs <b>{Math.round(econ.downtimeCostHr / Math.max(1, analytics.econ.laborRate))}x more</b> than a sanitor labor hour (<b>${analytics.econ.laborRate}/hr</b>). Synchronizing deep cleans with planned line downtime delivers the highest ROI in the plant.
                  </span>
