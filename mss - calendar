        .group-bar.partial { background: ${BRAND.yellowSoft}; border-color: ${BRAND.yellow}; color: #92400e; }
        .group-bar.missed { background: ${BRAND.redSoft}; border-color: #f5a3b3; color: #9f1239; }
        .group-bar.unknown { background: #f8fafc; border-color: #e2e8f0; color: #64748b; }
        .group-meter { width: 44px; height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; display: flex; flex-shrink: 0; }
