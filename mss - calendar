function QuickLogModal({ target, assets, onClose, onSaved, onCreated }) {
  const [mode, setMode] = useState('clean'); // 'clean' | 'skip'
  const [assetId, setAssetId] = useState(() => (target && target.asset ? getAssetId(target.asset) : (assets[0] ? getAssetId(assets[0]) : '')));
  const [equipFilter, setEquipFilter] = useState('');
  const selectedAsset = useMemo(() => {
    if (target && target.asset && getAssetId(target.asset) === assetId) return target.asset;
    return assets.find(a => getAssetId(a) === assetId) || (target && target.asset) || assets[0] || null;
  }, [target, assets, assetId]);

  const activeFreqs = useMemo(() => {
    if (!selectedAsset) return ['D', 'W', 'M'];
    const list = FREQS.filter(f => f.flags.some(c => isTrue(selectedAsset[c]))).map(f => f.code);
    return list.length ? list : ['D', 'W', 'M'];
  }, [selectedAsset]);

  const [dateStr, setDateStr] = useState(() => (target && target.dateStr) || normalizeDateStr(new Date()));
  const [cleanCode, setCleanCode] = useState(() => (target && target.cleanCode) || activeFreqs[0] || 'D');
  const sapMap = useMemo(() => getAssetSapMap(selectedAsset), [selectedAsset]);
  const [sapCode, setSapCode] = useState(() => sapMap[cleanCode] || sapMap.D || '');
  const [cleanedBy, setCleanedBy] = useState(() => {
    const id = resolveMicrosoftIdentity(loadUserOverride());
    return id.userName && id.userName !== 'Local Plant User' ? id.userName : 'Sanitor';
  });
  const [hours, setHours] = useState('1');
  const [file, setFile] = useState(null);
  const [skipCodes] = useState(loadSkipCodes);
  const [skipCode, setSkipCode] = useState('PROD_RUN');
  const [skipNote, setSkipNote] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    const nextSap = sapMap[cleanCode] || sapMap.D || '';
    setSapCode(nextSap);
  }, [cleanCode, sapMap]);

  const filteredAssets = useMemo(() => {
    const q = equipFilter.trim().toLowerCase();
    if (!q) return assets.slice(0, 60);
    return assets.filter(a => {
      const n = safeString(getProp(a, 'craa5_equipmentidentifier'));
      const r = safeString(getProp(a, 'craa5_roomname'));
      const ar = safeString(getProp(a, 'craa5_areaname'));
      return (n + ' ' + r + ' ' + ar).toLowerCase().indexOf(q) > -1;
    }).slice(0, 60);
  }, [assets, equipFilter]);

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!selectedAsset) { setError('Select a piece of equipment first.'); return; }
    if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) { setError('Pick a valid date (YYYY-MM-DD).'); return; }
    setBusy(true);
    setError('');
    try {
      if (mode === 'skip') {
        const foundSkip = skipCodes.find(s => s.code === skipCode) || { code: skipCode, label: skipCode };
        const skipEntry = {
          id: 'skip-' + Date.now(),
          date: dateStr,
          assetId: getAssetId(selectedAsset),
          equipment: safeString(getProp(selectedAsset, 'craa5_equipmentidentifier')),
          room: safeString(getProp(selectedAsset, 'craa5_roomname')) || 'Unassigned Room',
          area: safeString(getProp(selectedAsset, 'craa5_areaname')) || 'Unassigned Area',
          sap: sapCode,
          skipCode: foundSkip.code,
          skipLabel: foundSkip.label,
          note: skipNote.trim(),
          loggedBy: normalizeWhoInput(cleanedBy),
          createdAt: new Date().toISOString()
        };
        saveSkippedEntry(skipEntry);
        createCalendarLogEntry({
          asset: selectedAsset,
          dateStr,
          cleanCode,
          sapCode,
          cleanedBy,
          hours: 0,
          file: null,
          skipMeta: { skipCode: foundSkip.code, skipNote: skipNote.trim() }
        }).catch(() => {});
        pushDevLog('SYNC', 'mss_log_skipped_entries_v1', `Recorded skip (${foundSkip.code}) for ${skipEntry.equipment} on ${dateStr}`, 'OK', 1, 1);
        if (onSaved) onSaved({ kind: 'skip', skipEntry });
        onClose();
        return;
      }

      const newLog = await createCalendarLogEntry({
        asset: selectedAsset,
        dateStr,
        cleanCode,
        sapCode,
        cleanedBy,
        hours,
        file
      });
      if (onSaved) onSaved({ kind: 'clean', log: newLog, asset: selectedAsset });
      if (onCreated) onCreated(newLog);
      onClose();
    } catch (err) {
      setError(String(err && err.message || err));
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="modal-overlay" data-testid="quick-log-modal" onClick={onClose}>
      <div className="paper-box" style={{ width: '540px', maxWidth: '94vw', background: '#fff' }} onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <div>
            <h2>{mode === 'clean' ? 'Log Sanitation Clean' : 'Record Skip / Deferral'}</h2>
            <p className="brand-subtitle">Synced with MSS Log Input (craa5__log_)</p>
          </div>
          <button type="button" className="page-btn" onClick={onClose} title="Close"><XIcon /></button>
        </div>
        <form onSubmit={handleSubmit} style={{ padding: '18px 24px', display: 'flex', flexDirection: 'column', gap: '12px', overflowY: 'auto' }}>
          <div className="comp-seg" role="group" aria-label="Entry Mode">
            <button type="button" className={mode === 'clean' ? 'on' : ''} onClick={() => setMode('clean')}>Completed Clean</button>
            <button type="button" className={mode === 'skip' ? 'on' : ''} onClick={() => setMode('skip')}>Skip / Deferral</button>
          </div>

          {target && target.existingEntry && (
            <div style={{ padding: '10px 12px', borderRadius: 8, background: BRAND.greenSoft, border: `1px solid ${BRAND.greenLine}`, fontSize: 12 }}>
              <b>Already Logged on {dateStr}:</b> Cleaned by {target.existingEntry.log.craa5_lastcleanedby || 'N/A'}
              {target.existingEntry.types ? ` (${logTypeLabel(target.existingEntry.types)})` : ''}
              {target.existingEntry.log.craa5_sap ? ` - SAP ${target.existingEntry.log.craa5_sap}` : ''}.
              You can log an additional clean or attach paperwork below.
            </div>
          )}

          {(!target || !target.asset) && (
            <label className="dt-field">
              <span>Filter Equipment ({assets.length} loaded)</span>
              <input value={equipFilter} onChange={e => setEquipFilter(e.target.value)} placeholder="Type room, area, or equipment name..." />
            </label>
          )}

          <label className="dt-field">
            <span>Equipment</span>
            <select
              value={selectedAsset ? getAssetId(selectedAsset) : ''}
              onChange={e => setAssetId(e.target.value)}
              style={{ padding: '8px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13, fontWeight: 600 }}
            >
              {filteredAssets.map(a => {
                const id = getAssetId(a);
                const n = safeString(getProp(a, 'craa5_equipmentidentifier'));
                const r = safeString(getProp(a, 'craa5_roomname')) || 'Unassigned Room';
                const ar = safeString(getProp(a, 'craa5_areaname')) || 'Unassigned Area';
                return <option key={id} value={id}>{n} ({r} / {ar})</option>;
              })}
            </select>
          </label>

          <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
            <label className="dt-field" style={{ flex: '1 1 150px' }}>
              <span>Date</span>
              <input type="date" value={dateStr} onChange={e => setDateStr(e.target.value)} required />
            </label>
            <label className="dt-field" style={{ flex: '1 1 180px' }}>
              <span>Cleaned By / Initials</span>
              <input value={cleanedBy} onChange={e => setCleanedBy(e.target.value)} placeholder="e.g. JD / MK" required />
            </label>
          </div>

          {mode === 'clean' ? (
            <>
              <div className="dt-field">
                <span>Clean Frequency Type (Rollup Flags)</span>
                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginTop: 2 }}>
                  {FREQS.map(f => {
                    const isSetOnAsset = activeFreqs.indexOf(f.code) > -1;
                    return (
                      <button
                        key={f.code}
                        type="button"
                        className={'fchip' + (cleanCode === f.code ? ' on' : '')}
                        style={{ padding: '0 10px', height: 32 }}
                        onClick={() => setCleanCode(f.code)}
                        title={`${f.label} (${isSetOnAsset ? 'scheduled on this equipment' : 'additional clean'})`}
                      >
                        {f.code} - {f.label}
                      </button>
                    );
                  })}
                </div>
              </div>

              <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
                <label className="dt-field" style={{ flex: '1 1 160px' }}>
                  <span>SAP Order Number</span>
                  <input value={sapCode} onChange={e => setSapCode(e.target.value)} placeholder="Optional SAP order" />
                </label>
                <label className="dt-field" style={{ flex: '1 1 140px' }}>
                  <span>Hours Worked (Whole Int32)</span>
                  <input type="number" min="1" max="99" step="1" value={hours} onChange={e => setHours(e.target.value)} />
                </label>
              </div>

              <label className="dt-field">
                <span>Paperwork Photo or PDF (craa5_pictureorfileofpaperwork)</span>
                <input type="file" accept="image/*,application/pdf" onChange={e => setFile(e.target.files && e.target.files[0] ? e.target.files[0] : null)} />
              </label>
            </>
          ) : (
            <>
              <label className="dt-field">
                <span>Standardized Skip Code</span>
                <select
                  value={skipCode}
                  onChange={e => setSkipCode(e.target.value)}
                  style={{ padding: '8px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13, fontWeight: 600 }}
                >
                  {skipCodes.map(s => <option key={s.code} value={s.code}>{s.code} - {s.label}</option>)}
                </select>
              </label>
              <label className="dt-field">
                <span>Skip Note / Comments</span>
                <input value={skipNote} onChange={e => setSkipNote(e.target.value)} placeholder="Reason details..." />
              </label>
            </>
          )}

          {error && <p className="dt-error" role="alert">{error}</p>}

          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 10, marginTop: 6 }}>
            <button type="button" className="page-btn" onClick={onClose}>Cancel</button>
            <button type="submit" className="sync-btn" disabled={busy || !selectedAsset}>
              {busy ? 'Saving...' : mode === 'clean' ? 'Save Clean to Log' : 'Record Skip'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}

