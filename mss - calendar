// LINE DOWNTIME TAB: kept in App so the days survive a switch of tab, and so the matrix can use them.
// ----------------------------------------------------------------------------
function useLineDowntime() {
  const [lines, setLines] = useState(dtLoad);
  const [saved, setSaved] = useState(dtCanStore);
  const mounted = useRef(false);
  useEffect(() => {
    if (!mounted.current) { mounted.current = true; return; }
    setSaved(dtStore(lines));
  }, [lines]);
  return { lines, setLines, saved };
}

// What counts toward the completion percentages (see COMPLETION SELECTION): kept in App so the choice survives a switch of tab.
function useExclusions() {
  const [ex, setEx] = useState(exLoad);
  const [saved, setSaved] = useState(exCanStore);
  const mounted = useRef(false);
  const fromOther = useRef(false);   // the change came from another window: it is already stored, writing it back would only echo it
  useEffect(() => {
    if (!mounted.current) { mounted.current = true; return; }
    if (fromOther.current) { fromOther.current = false; return; }
    setSaved(exStore(ex));
  }, [ex]);
  // Two windows of the same browser: a change made in one is picked up by the other, so the last toggle does not wipe the first one's choices.
  useEffect(() => {
    if (typeof window === 'undefined' || !window.addEventListener) return undefined;
    const onStorage = (e) => { if (e.key === EXCLUDED_KEY || e.key === null) { try { fromOther.current = true; setEx(exLoad()); } catch (x) { fromOther.current = false; } } };
    window.addEventListener('storage', onStorage);
    return () => { window.removeEventListener('storage', onStorage); };
  }, []);
  return { ex, setEx, saved };
}

// ============================================================================
// VIEW (r15): how much of the screen the grid gets. COMPACT (shorter rows and header tiers, on by default) and FOCUS (the title row
// folds into one slim bar) are kept in this browser (mss_view_v1); LATE ONLY and the day tint are not. With the storage blocked the
// defaults apply on every load, which is the useful ones.
// ============================================================================
const VIEW_KEY = 'mss_view_v1';
const viewClean = (raw) => {
  const o = raw && typeof raw === 'object' ? raw : {};
  return { compact: typeof o.compact === 'boolean' ? o.compact : true, focus: o.focus === true };
};
const viewLoad = () => {
  try { const raw = window.localStorage.getItem(VIEW_KEY); return viewClean(raw ? JSON.parse(raw) : null); } catch (e) { return viewClean(null); }
};
const viewStore = (v) => {
  try { window.localStorage.setItem(VIEW_KEY, JSON.stringify({ compact: !!v.compact, focus: !!v.focus })); return true; } catch (e) { return false; }
};
// The heights that must agree between the sticky header tiers and the corner beside them, and the height of a row.
const viewSizes = (compact) => (compact
  ? { month: 22, week: 18, day: 52, pct: 18, pcn: 14, row: 30 }
  : { month: 30, week: 25, day: 65, pct: 22, pcn: 18, row: 42 });
// Equipment known to be fine: every frequency done on time and nothing left to read, or no frequency at all (LATE ONLY hides it).
const isFineRow = (st) => !!st && !st.unreadable && ((st.state === 'ok' && !st.unread) || st.state === 'none');

// The twelve month chips (the slicer, and the slim bar of FOCUS). Both spellings are in the chip; the strip decides which one shows.
// A plain mouse wheel over a strip that does not fit moves it sideways; a chip that gets the keyboard focus is brought into view.
const wheelSideways = (e) => { const el = e.currentTarget; if (el.scrollWidth > el.clientWidth && Math.abs(e.deltaY) > Math.abs(e.deltaX)) el.scrollLeft += e.deltaY; };
const chipInView = (e) => { const t = e.target; if (t && t.scrollIntoView && t.classList && t.classList.contains('month-chip')) { try { t.scrollIntoView({ block: 'nearest', inline: 'nearest' }); } catch (x) { /* an old browser: the chip stays where it is */ } } };
const MonthChips = ({ visibleMonths, onToggle }) => (
  <>
    {MONTHS.map((m, idx) => {
      const on = visibleMonths.indexOf(idx) >= 0;
      return (
        <button key={m} type="button" className={`month-chip${on ? ' active' : ''}`} aria-pressed={on} aria-label={m} title={m} onClick={() => onToggle(idx)}>
          <span className="mf">{m.toUpperCase()}</span><span className="ms" aria-hidden="true">{m.slice(0, 3).toUpperCase()}</span>
