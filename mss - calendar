// BEGIN MSS ECOSYSTEM BRIDGE (MSS LOG INPUT, SKIP CODES, QUICK LOG & UPLOAD)
// ============================================================================
const CATALOG_STORAGE_KEY = 'mss_log_asset_catalog_v4';
const SKIP_STORAGE_KEY = 'mss_log_skip_codes_v1';
const SKIP_HISTORY_STORAGE_KEY = 'mss_log_skipped_entries_v1';
const CALENDAR_TO_INPUT_QUEUE_KEY = 'mss_calendar_to_input_queue_v1';
const VIEW_CONFIG_STORAGE_KEY = 'mss_calendar_view_module_v1';
const MSS_INPUT_VIEW_CONFIG_KEY = 'mss_log_input_view_module_v1';
const USER_OVERRIDE_STORAGE_KEY = 'mss_log_input_user_override_v1';
const ACCESS_LOG_STORAGE_KEY = 'mss_log_input_access_audit_v1';
const HUB_BROADCAST_CHANNEL = 'mss_hub_sync_v1';
const HUB_CONFIG_TABLE = 'craa5__0_hubconfig';
const ACCESS_LOG_TABLE = 'craa5_mss_useraccesslog';
const MS_TABLE = 'craa5_aa_ms_assets';
const SKIP_TABLE = 'craa5_mss_skipcode';

const DEFAULT_SKIP_CODES = [
  { code: 'PROD_RUN', label: 'Production Running - No Downtime Window' },
  { code: 'MAINT_HOLD', label: 'Maintenance Hold / LOTO Active' },
  { code: 'NO_STAFF', label: 'Staffing Shortage - Deferred to Next Shift' },
  { code: 'FROZEN_EQUIP', label: 'Freezer / Cold Room Thaw Required' },
  { code: 'QA_HOLD', label: 'QA Hold / Swab Pending' },
  { code: 'DECOMMISSIONED', label: 'Equipment Offline / Not in Service' }
];

const loadSkipCodes = () => {
  try {
    const raw = window.localStorage.getItem(SKIP_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : null;
    return Array.isArray(parsed) && parsed.length ? parsed : DEFAULT_SKIP_CODES;
  } catch (_) {
    return DEFAULT_SKIP_CODES;
  }
};

const loadSkippedEntries = () => {
  try {
    const raw = window.localStorage.getItem(SKIP_HISTORY_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch (_) {
    return [];
  }
};

const saveSkippedEntry = (entry) => {
  try {
    const list = loadSkippedEntries();
    const next = [entry].concat(list).slice(0, 500);
    window.localStorage.setItem(SKIP_HISTORY_STORAGE_KEY, JSON.stringify(next));
    broadcastHubEvent({ type: 'SKIP_LOGGED', entry });
    const webApi = getXrmWebApi();
    if (webApi && typeof webApi.retrieveMultipleRecords === 'function') {
      (async () => {
        try {
          const jsonStr = JSON.stringify(next.slice(0, 200));
          let res = null;
          try {
            res = await webApi.retrieveMultipleRecords(HUB_CONFIG_TABLE, "?$select=craa5__0_hubconfigid&$filter=craa5_configkey eq 'MSS_SKIPPED_ENTRIES_LOG' or craa5_configname eq 'MSS_SKIPPED_ENTRIES_LOG'&$top=1");
          } catch (_) {
            res = await webApi.retrieveMultipleRecords(HUB_CONFIG_TABLE, "?$filter=craa5_configname eq 'MSS_SKIPPED_ENTRIES_LOG'&$top=1");
          }
          const existingId = res && res.entities && res.entities[0] ? res.entities[0].craa5__0_hubconfigid : null;
          const payload = {
            craa5_configkey: 'MSS_SKIPPED_ENTRIES_LOG',
            craa5_configname: 'MSS_SKIPPED_ENTRIES_LOG',
            craa5_configjson: jsonStr,
            craa5_scope: 'PlantWide'
          };
          if (existingId) await webApi.updateRecord(HUB_CONFIG_TABLE, existingId, payload);
          else await webApi.createRecord(HUB_CONFIG_TABLE, payload);
        } catch (_) { /* ignore optional hubconfig sync error */ }
      })();
    }
    return true;
  } catch (_) {
    return false;
  }
};

const broadcastHubEvent = (payload) => {
  try {
    if (typeof BroadcastChannel !== 'undefined') {
      const ch = new BroadcastChannel(HUB_BROADCAST_CHANNEL);
      ch.postMessage(Object.assign({ ts: Date.now(), source: 'mss_calendar' }, payload));
      ch.close();
    }
  } catch (_) { /* ignore */ }
};

const normalizeSapCode = (v) => String(v === null || v === undefined ? '' : v).trim().replace(/\.0+$/, '');

const getAssetSapMap = (asset) => {
  if (!asset) return {};
  const scRaw = asset.sapCodes || (asset.raw && asset.raw.sapCodes) || {};
  const sc = {};
  if (Array.isArray(scRaw)) {
    scRaw.forEach(entry => {
      if (!entry || !entry.code) return;
      const col = String(entry.col || '').toLowerCase();
      if (col) sc[col] = entry.code;
      if (col === 'craa5_sapdaily') sc.daily = entry.code;
      else if (col === 'craa5_sapshift') sc.shift = entry.code;
      else if (col === 'craa5_sapmidweek') sc.midweek = entry.code;
      else if (col === 'craa5_sapw') sc.weekly = entry.code;
      else if (col === 'craa5_sapbiweekly') sc.biweekly = entry.code;
      else if (col === 'craa5_sapmonthly') sc.monthly = entry.code;
      else if (col === 'craa5_saptwomonth') sc.twomonth = entry.code;
      else if (col === 'craa5_sapquarterly') sc.quarterly = entry.code;
      else if (col === 'craa5_sapsixmonth') sc.sixmonth = entry.code;
      else if (col === 'craa5_sapannual') sc.annual = entry.code;
    });
  } else if (scRaw && typeof scRaw === 'object') {
    Object.assign(sc, scRaw);
  }
  return {
    D: normalizeSapCode(sc.daily || sc.shift || sc.craa5_sapdaily || sc.craa5_sapshift || getRaw(asset, 'craa5_sapdaily') || getRaw(asset, 'craa5_sapshift') || asset.sap),
    MW: normalizeSapCode(sc.midweek || sc.craa5_sapmidweek || getRaw(asset, 'craa5_sapmidweek') || sc.daily || sc.craa5_sapdaily || getRaw(asset, 'craa5_sapdaily')),
    W: normalizeSapCode(sc.weekly || sc.biweekly || sc.craa5_sapw || sc.craa5_sapbiweekly || getRaw(asset, 'craa5_sapw') || getRaw(asset, 'craa5_sapbiweekly')),
    M: normalizeSapCode(sc.monthly || sc.twomonth || sc.craa5_sapmonthly || sc.craa5_saptwomonth || getRaw(asset, 'craa5_sapmonthly') || getRaw(asset, 'craa5_saptwomonth')),
    Q: normalizeSapCode(sc.quarterly || sc.sixmonth || sc.craa5_sapquarterly || sc.craa5_sapsixmonth || getRaw(asset, 'craa5_sapquarterly') || getRaw(asset, 'craa5_sapsixmonth')),
    A: normalizeSapCode(sc.annual || sc.craa5_sapannual || getRaw(asset, 'craa5_sapannual'))
  };
};

// Normalizes either a raw Dataverse craa5_aa_assets record or a shared MSS Log Input catalog entry
const normalizeSharedAsset = (a) => {
  if (!a || typeof a !== 'object') return null;
  const raw = a.raw && typeof a.raw === 'object' ? a.raw : {};
  const id = normalizeId(a.craa5_aa_assetsid || a.id || raw.craa5_aa_assetsid);
  const name = safeString(getProp(a, 'craa5_equipmentidentifier') || a.name || getProp(raw, 'craa5_equipmentidentifier'));
  const room = safeString(getProp(a, 'craa5_roomname') || a.room || getProp(raw, 'craa5_roomname')) || 'Unassigned Room';
  const area = safeString(getProp(a, 'craa5_areaname') || a.area || getProp(raw, 'craa5_areaname')) || 'Unassigned Area';
  if (!id && !name) return null;
  const sap = getAssetSapMap(a);
  const hasAnyFlag = FREQS.some(f => f.flags.some(c => isTrue(a[c]) || isTrue(raw[c])));
  return Object.assign({}, raw, a, {
    craa5_aa_assetsid: id || ('asset-' + normalizeName(name + room + area)),
    craa5_equipmentidentifier: name || '(no name)',
    craa5_roomname: room,
    craa5_areaname: area,
    craa5_dailyclean: hasAnyFlag ? (isTrue(a.craa5_dailyclean) || isTrue(raw.craa5_dailyclean)) : Boolean(sap.D),
    craa5_midweek: hasAnyFlag ? (isTrue(a.craa5_midweek) || isTrue(raw.craa5_midweek)) : Boolean(sap.MW && sap.MW !== sap.D),
    craa5_weeklyclean: hasAnyFlag ? (isTrue(a.craa5_weeklyclean) || isTrue(raw.craa5_weeklyclean)) : Boolean(sap.W),
    craa5_monthlyclean: hasAnyFlag ? (isTrue(a.craa5_monthlyclean) || isTrue(a.craa5_month) || isTrue(raw.craa5_monthlyclean) || isTrue(raw.craa5_month)) : Boolean(sap.M),
    craa5_quarterly: hasAnyFlag ? (isTrue(a.craa5_quarterly) || isTrue(raw.craa5_quarterly)) : Boolean(sap.Q),
    craa5_annually: hasAnyFlag ? (isTrue(a.craa5_annually) || isTrue(raw.craa5_annually)) : Boolean(sap.A),
    _sapByFreq: sap
  });
};

const readSharedAssetCatalog = () => {
