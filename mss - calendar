const CATALOG_STORAGE_KEY = 'mss_log_asset_catalog_v4';
const SKIP_STORAGE_KEY = 'mss_log_skip_codes_v1';
const SKIP_HISTORY_STORAGE_KEY = 'mss_log_skipped_entries_v1';
const CALENDAR_TO_INPUT_QUEUE_KEY = 'mss_calendar_to_input_queue_v1';
const VIEW_CONFIG_STORAGE_KEY = 'mss_calendar_view_module_v1';
const MSS_INPUT_VIEW_CONFIG_KEY = 'mss_log_input_view_module_v1';
const USER_OVERRIDE_STORAGE_KEY = 'mss_log_input_user_override_v1';
const ACCESS_LOG_STORAGE_KEY = 'mss_log_input_access_audit_v1';
const HUB_BROADCAST_CHANNEL = 'mss_hub_sync_v1';
const HUB_CONFIG_TABLE = 'craa5__0_hubconfig';
const ACCESS_LOG_TABLE = 'craa5_mss_useraccesslog';
const MS_TABLE = 'craa5_aa_ms_assets';
const SKIP_TABLE = 'craa5_mss_skipcode';

const DEFAULT_SKIP_CODES = [
  { code: 'PROD_RUN', label: 'Production Running - No Downtime Window' },
  { code: 'MAINT_HOLD', label: 'Maintenance Hold / LOTO Active' },
  { code: 'NO_STAFF', label: 'Staffing Shortage - Deferred to Next Shift' },
  { code: 'FROZEN_EQUIP', label: 'Freezer / Cold Room Thaw Required' },
  { code: 'QA_HOLD', label: 'QA Hold / Swab Pending' },
  { code: 'DECOMMISSIONED', label: 'Equipment Offline / Not in Service' }
];

const loadSkipCodes = () => {
  try {
    const raw = window.localStorage.getItem(SKIP_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : null;
    return Array.isArray(parsed) && parsed.length ? parsed : DEFAULT_SKIP_CODES;
  } catch (_) {
    return DEFAULT_SKIP_CODES;
  }
};

const loadSkippedEntries = () => {
  try {
    const raw = window.localStorage.getItem(SKIP_HISTORY_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch (_) {
    return [];
  }
};

const saveSkippedEntry = (entry) => {
  try {
    const list = loadSkippedEntries();
    const next = [entry].concat(list).slice(0, 500);
    window.localStorage.setItem(SKIP_HISTORY_STORAGE_KEY, JSON.stringify(next));
    broadcastHubEvent({ type: 'SKIP_LOGGED', entry });
    const webApi = getXrmWebApi();
    if (webApi && typeof webApi.retrieveMultipleRecords === 'function') {
      (async () => {
        try {
          await hcWrite('MSS_SKIPPED_ENTRIES_LOG', next.slice(0, 200));
        } catch (_) { /* ignore optional hubconfig sync error */ }
      })();
    }
    return true;
  } catch (_) {
    return false;
  }
};

const broadcastHubEvent = (payload) => {
  try {
    if (typeof BroadcastChannel !== 'undefined') {
      const ch = new BroadcastChannel(HUB_BROADCAST_CHANNEL);
      ch.postMessage(Object.assign({ ts: Date.now(), source: 'mss_calendar' }, payload));
      ch.close();
    }
  } catch (_) { /* ignore */ }
};

const normalizeSapCode = (v) => String(v === null || v === undefined ? '' : v).trim().replace(/\.0+$/, '');

const getAssetSapMap = (asset) => {
  if (!asset) return {};
  const scRaw = asset.sapCodes || (asset.raw && asset.raw.sapCodes) || {};
  const sc = {};
  if (Array.isArray(scRaw)) {
    scRaw.forEach(entry => {
      if (!entry || !entry.code) return;
      const col = String(entry.col || '').toLowerCase();
      if (col) sc[col] = entry.code;
      if (col === 'craa5_sapdaily') sc.daily = entry.code;
      else if (col === 'craa5_sapshift') sc.shift = entry.code;
      else if (col === 'craa5_sapmidweek') sc.midweek = entry.code;
      else if (col === 'craa5_sapw') sc.weekly = entry.code;
      else if (col === 'craa5_sapbiweekly') sc.biweekly = entry.code;
      else if (col === 'craa5_sapmonthly') sc.monthly = entry.code;
      else if (col === 'craa5_saptwomonth') sc.twomonth = entry.code;
      else if (col === 'craa5_sapquarterly') sc.quarterly = entry.code;
      else if (col === 'craa5_sapsixmonth') sc.sixmonth = entry.code;
      else if (col === 'craa5_sapannual') sc.annual = entry.code;
    });
  } else if (scRaw && typeof scRaw === 'object') {
    Object.assign(sc, scRaw);
  }
  return {
    D: normalizeSapCode(sc.daily || sc.shift || sc.craa5_sapdaily || sc.craa5_sapshift || getRaw(asset, 'craa5_sapdaily') || getRaw(asset, 'craa5_sapshift') || asset.sap),
    MW: normalizeSapCode(sc.midweek || sc.craa5_sapmidweek || getRaw(asset, 'craa5_sapmidweek') || sc.daily || sc.craa5_sapdaily || getRaw(asset, 'craa5_sapdaily')),
    W: normalizeSapCode(sc.weekly || sc.biweekly || sc.craa5_sapw || sc.craa5_sapbiweekly || getRaw(asset, 'craa5_sapw') || getRaw(asset, 'craa5_sapbiweekly')),
    M: normalizeSapCode(sc.monthly || sc.twomonth || sc.craa5_sapmonthly || sc.craa5_saptwomonth || getRaw(asset, 'craa5_sapmonthly') || getRaw(asset, 'craa5_saptwomonth')),
    Q: normalizeSapCode(sc.quarterly || sc.craa5_sapquarterly || getRaw(asset, 'craa5_sapquarterly')),
    S: normalizeSapCode(sc.sixmonth || sc.craa5_sapsixmonth || getRaw(asset, 'craa5_sapsixmonth')),
    A: normalizeSapCode(sc.annual || sc.craa5_sapannual || getRaw(asset, 'craa5_sapannual'))
  };
};

// Normalizes either a raw Dataverse craa5_aa_assets record or a shared MSS Log Input catalog entry
const normalizeSharedAsset = (a) => {
  if (!a || typeof a !== 'object') return null;
  const raw = a.raw && typeof a.raw === 'object' ? a.raw : {};
  const id = normalizeId(a.craa5_aa_assetsid || a.id || raw.craa5_aa_assetsid);
  const name = safeString(getProp(a, 'craa5_equipmentidentifier') || a.name || getProp(raw, 'craa5_equipmentidentifier'));
  const room = safeString(getProp(a, 'craa5_roomname') || a.room || getProp(raw, 'craa5_roomname')) || 'Unassigned Room';
  const area = safeString(getProp(a, 'craa5_areaname') || a.area || getProp(raw, 'craa5_areaname')) || 'Unassigned Area';
  if (!id && !name) return null;
  const sap = getAssetSapMap(a);
  const hasAnyFlag = FREQS.some(f => f.flags.some(c => isTrue(a[c]) || isTrue(raw[c])));
  return Object.assign({}, raw, a, {
    craa5_aa_assetsid: id || ('asset-' + normalizeName(name + room + area)),
    craa5_equipmentidentifier: name || '(no name)',
    craa5_roomname: room,
    craa5_areaname: area,
    craa5_dailyclean: hasAnyFlag ? (isTrue(a.craa5_dailyclean) || isTrue(raw.craa5_dailyclean)) : Boolean(sap.D),
    craa5_midweek: hasAnyFlag ? (isTrue(a.craa5_midweek) || isTrue(raw.craa5_midweek)) : Boolean(sap.MW && sap.MW !== sap.D),
    craa5_weeklyclean: hasAnyFlag ? (isTrue(a.craa5_weeklyclean) || isTrue(raw.craa5_weeklyclean)) : Boolean(sap.W),
    craa5_monthlyclean: hasAnyFlag ? (isTrue(a.craa5_monthlyclean) || isTrue(raw.craa5_monthlyclean)) : Boolean(sap.M),
    craa5_month: hasAnyFlag ? (isTrue(a.craa5_month) || isTrue(raw.craa5_month)) : Boolean(sap.S),
    craa5_quarterly: hasAnyFlag ? (isTrue(a.craa5_quarterly) || isTrue(raw.craa5_quarterly)) : Boolean(sap.Q),
    craa5_annually: hasAnyFlag ? (isTrue(a.craa5_annually) || isTrue(raw.craa5_annually)) : Boolean(sap.A),
    _sapByFreq: sap
  });
};

const readSharedAssetCatalog = () => {
  try {
    const raw = window.sessionStorage.getItem(CATALOG_STORAGE_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    const list = Array.isArray(parsed)
      ? parsed
      : (parsed && Array.isArray(parsed.assets)
        ? parsed.assets
        : (parsed && Array.isArray(parsed.items) ? parsed.items : []));
    return list.map(normalizeSharedAsset).filter(Boolean);
  } catch (_) {
    return [];
  }
};

const writeSharedAssetCatalog = (assets) => {
  try {
    if (!Array.isArray(assets) || !assets.length) return false;
    const existing = window.sessionStorage.getItem(CATALOG_STORAGE_KEY);
    if (existing) {
      const parsed = JSON.parse(existing);
      const existingArr = parsed && (Array.isArray(parsed.assets) ? parsed.assets : (Array.isArray(parsed.items) ? parsed.items : null));
      if (parsed && parsed.complete === true && existingArr && existingArr.length > 0 && existingArr[0].sapCodes) {
        return true; // preserve richer complete SAP catalog written by MSS Log Input
      }
    }
    window.sessionStorage.setItem(CATALOG_STORAGE_KEY, JSON.stringify({ v: 4, ts: Date.now(), source: 'mss_calendar', assets, items: assets }));
    return true;
  } catch (_) {
    return false;
  }
};

// Exact clean-kind boolean rollup flags used by MSS Log Input (store.createLog / inferCleanKindFlags)
const inferCleanKindFlags = (cleanCode) => {
  const c = String(cleanCode || 'D').toUpperCase();
  if (c === 'M' || c === 'Q' || c === 'S' || c === 'A') {
    return { craa5_daily: true, craa5_weekly: true, craa5_monthly: true };
  }
  if (c === 'W') {
    return { craa5_daily: true, craa5_weekly: true, craa5_monthly: false };
  }
  return { craa5_daily: true, craa5_weekly: false, craa5_monthly: false };
};

// Dataverse defines craa5_hoursworked as Edm.Int32 (Whole Number). Fractional values fail with HTTP 400.
const sanitizeHoursInt32 = (hours) => {
  const n = Number(hours);
  if (!Number.isFinite(n) || n <= 0) return 1;
  return Math.max(1, Math.ceil(n));
};

const normalizeWhoInput = (who) => {
  const parts = String(who || '').split(/[\/,&;+]+/).map(s => s.trim()).filter(Boolean);
  return parts.length ? parts.join(' / ') : 'Sanitor';
};

const bytesToBase64 = (bytes) => {
  let binary = '';
  const len = bytes.byteLength;
  const chunk = 0x8000;
  for (let i = 0; i < len; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, Math.min(i + chunk, len)));
  }
  return btoa(binary);
};

const uploadPaperworkToLog = async (rowId, file) => {
  const webApi = getXrmWebApi();
  if (!rowId || !file || !webApi) return false;
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf);
  const fileName = safeString(file.name) || 'paperwork.jpg';
  const mimeType = file.type || mimeFromName(fileName) || 'application/octet-stream';
  const errors = [];

  if (webApi.online && typeof webApi.online.execute === 'function') {
    try {
      const exec = (req) => webApi.online.execute(req);
      const init = await readJson(await exec(xrmRequest('InitializeFileBlocksUpload', {
        Target: { '@odata.type': 'Microsoft.Dynamics.CRM.craa5__log_', craa5__log_id: rowId },
        FileAttributeName: LOG_FILE_COLUMN,
        FileName: fileName
      }, {
        Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 },
        FileAttributeName: EDM_STRING,
        FileName: EDM_STRING
      })));
      const token = init.FileContinuationToken;
      if (!token) throw new Error('No FileContinuationToken returned');
      const blockIds = [];
      for (let offset = 0; offset < bytes.byteLength; offset += PAPERWORK_CHUNK) {
        const slice = bytes.subarray(offset, Math.min(bytes.byteLength, offset + PAPERWORK_CHUNK));
        const blockId = btoa('blk-' + String(offset).padStart(10, '0'));
        blockIds.push(blockId);
        await exec(xrmRequest('UploadBlock', {
          BlockId: blockId,
          BlockData: bytesToBase64(slice),
          FileContinuationToken: token
        }, {
          BlockId: EDM_STRING,
          BlockData: EDM_STRING,
          FileContinuationToken: EDM_STRING
        }));
      }
      await exec(xrmRequest('CommitFileBlocksUpload', {
        FileName: fileName,
        MimeType: mimeType,
        BlockList: blockIds,
        FileContinuationToken: token
      }, {
        FileName: EDM_STRING,
        MimeType: EDM_STRING,
        BlockList: { typeName: 'Collection(Edm.String)', structuralProperty: 4 },
        FileContinuationToken: EDM_STRING
      }));
      pushDevLog('FILE', 'craa5__log_', `Uploaded paperwork ${fileName} (${bytes.byteLength} bytes)`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return true;
    } catch (err) {
      errors.push(String(err && err.message || err));
    }
  }

  if (typeof fetch === 'function' && clientUrl()) {
    try {
      const url = `${clientUrl()}/api/data/v9.2/craa5__log_s(${rowId})/${LOG_FILE_COLUMN}`;
      const res = await fetch(url, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/octet-stream',
          'x-ms-file-name': encodeURIComponent(fileName),
          'OData-MaxVersion': '4.0',
          'OData-Version': '4.0'
        },
        body: buf
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      pushDevLog('FILE', 'craa5__log_', `Uploaded paperwork via HTTP ${fileName}`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return true;
    } catch (err) {
      errors.push(String(err && err.message || err));
    }
  }

  const msg = errors.join(' - ') || 'Paperwork upload unavailable';
  pushDevLog('ERROR', 'craa5__log_', `Paperwork upload failed (${fileName})`, 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, msg);
  throw new Error(msg);
};

// The calendar's frequency letters as contract clean kinds (data contract 6.2)
const CODE_KIND = { D: 'daily', MW: 'midweek', W: 'eow', M: 'monthly', Q: 'quarterly', S: 'semiannual', A: 'annual' };
// A finished clean from the quick log, through the shared MSS LOG WRITE block: one row per piece, clean kind and shift date,
// a fixed row id from the completion key (the same people saving again is "already logged"; other people get a second entry key|2), and a failed save waits
// in this browser's retry queue. `minutes` are person-minutes. Returns the row as the calendar keeps it on screen.
const writeCalendarClean = async ({ asset, assetId, equipName, roomName, areaName, whoRaw, dateStr, cleanCode, sapCode, minutes, file, t0 }) => {
  const api = mlwApi(getXrm(), null);
  const sapMap = getAssetSapMap(asset);
  const resolvedSap = normalizeSapCode(sapCode || sapMap[cleanCode] || '');
  const me = resolveMicrosoftIdentity(loadUserOverride());
  const entry = {
    equipmentGuid: assetId, equipment: equipName, room: roomName, area: areaName, workArea: safeString(getRaw(asset, 'craa5_workareacode')),
    kind: CODE_KIND[String(cleanCode || 'D').toUpperCase()] || 'daily', sap: resolvedSap, shiftDate: dateStr,
    cleanedBy: whoRaw, markedBy: me.userName, minutes: Number(minutes), pathogen: false, source: 'Calendar'
  };
  const built = mlwBuildRow(entry);
  if (!built.ok) throw new Error(built.problems.map(c => mlwSay(c)).join(' '));
  if (api) { try { await mlwRetryQueue(api); } catch (_) { /* the queue keeps what it could not send */ } }
  const res = await mlwWrite(api, entry);
  const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
  if (res.status === 'invalid') throw new Error(res.problems.map(c => mlwSay(c)).join(' '));
  if (res.status === 'queued') {
    pushDevLog('ERROR', 'craa5__log_', `Clean for ${equipName} (${dateStr}) not saved yet, queued`, 'ERR', ms, 0, res.error || '');
    throw new Error(mlwSay('queued') + (res.error ? ' (' + res.error + ')' : ''));
  }
  let fileUploaded = false;
  if (file && isGuid(res.id)) fileUploaded = await uploadPaperworkToLog(res.id, file);
  const localRecord = Object.assign({}, built.row, { craa5__log_id: res.id, statecode: 0, craa5_nameofemployee: whoRaw });
  if (file && fileUploaded) {
    localRecord[LOG_FILE_COLUMN] = res.id;
    localRecord[LOG_FILE_NAME_COLUMN] = file.name || 'paperwork.jpg';
  }
  if (res.separate) localRecord._mlwSeparate = mlwSay('saved_separate', 'en');   // English: the page's Spanish pass translates it
  pushDevLog('API-WRITE', 'craa5__log_', res.separate ? `${equipName} (${dateStr}) saved as a second entry (${res.key})` : res.status === 'already' ? `${equipName} (${dateStr}) was already logged as ${built.kind}` : `Logged ${built.kind} clean for ${equipName} (${dateStr}) by ${built.row.craa5_lastcleanedby}`, 'OK', ms, 1, `Key: ${res.key}`);
  if (res.status === 'saved') broadcastHubEvent({ type: 'LOG_CREATED', log: localRecord });
  return localRecord;
};

// Creates a skip log row in craa5__log_ (MSS Log Input's skip encoding); a finished clean goes through writeCalendarClean
const createCalendarLogEntry = async ({ asset, dateStr, cleanCode, sapCode, cleanedBy, hours, file, skipMeta }) => {
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const assetId = getAssetId(asset);
  const equipName = safeString(getProp(asset, 'craa5_equipmentidentifier')) || 'Equipment';
  const roomName = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
  const areaName = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
  const whoRaw = normalizeWhoInput(cleanedBy);
  const skipCodeVal = skipMeta && skipMeta.skipCode ? String(skipMeta.skipCode).trim() : '';
  const skipNoteVal = skipMeta && skipMeta.skipNote ? String(skipMeta.skipNote).trim() : '';
  const who = skipCodeVal ? `SKIPPED (${skipCodeVal}) - ${whoRaw}${skipNoteVal ? ' - ' + skipNoteVal : ''}`.slice(0, 140) : whoRaw;
  const skipToken = skipCodeVal ? `SKIP:${skipCodeVal}:${skipNoteVal}`.slice(0, 100) : '';
  if (!skipCodeVal) return writeCalendarClean({ asset, assetId, equipName, roomName, areaName, whoRaw: String(cleanedBy || '').trim() ? whoRaw : '', dateStr, cleanCode, sapCode, minutes: hours, file, t0 });
  const intHours = skipCodeVal ? 0 : sanitizeHoursInt32(hours);
  const flags = skipCodeVal
    ? { craa5_daily: false, craa5_weekly: false, craa5_monthly: false }
    : inferCleanKindFlags(cleanCode);
  const sapMap = getAssetSapMap(asset);
  const resolvedSap = normalizeSapCode(sapCode || sapMap[cleanCode] || sapMap.D || '');
  const uid = 'MSS-' + Date.now().toString(36).toUpperCase();

  const basePayload = {
    craa5_equipment: equipName,
    craa5_lastcleaned: `${dateStr}T00:00:00Z`,
    craa5_lastcleanedby: who,
    craa5_nameofemployee: whoRaw,
    craa5_uid: uid
  };
  if (assetId && !missingLogColumns.has(LOG_ASSET_ID_SELECT)) basePayload[LOG_ASSET_ID_SELECT] = assetId;
  if (!missingLogColumns.has('craa5_room')) basePayload.craa5_room = roomName;
  if (!missingLogColumns.has('craa5_area')) basePayload.craa5_area = areaName;
  if (resolvedSap && !missingLogColumns.has('craa5_sap')) basePayload.craa5_sap = resolvedSap;
  if (!missingLogColumns.has('craa5_hoursworked')) basePayload.craa5_hoursworked = intHours;
  if (skipToken && !missingLogColumns.has('craa5_idofssop')) basePayload.craa5_idofssop = skipToken;
  if (skipToken && !missingLogColumns.has('craa5_bundle')) basePayload.craa5_bundle = skipToken;
  LOG_TYPE_COLUMNS.forEach(col => {
    if (!missingLogColumns.has(col)) basePayload[col] = flags[col];
  });

  let createdId = 'local-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7);
  let fileUploaded = false;
  const webApi = getXrmWebApi();

  if (webApi && typeof webApi.createRecord === 'function') {
    let payload = Object.assign({}, basePayload);
    for (let attempt = 0; attempt < 4; attempt++) {
      try {
        const res = await webApi.createRecord('craa5__log_', payload);
        createdId = normalizeId(res && res.id) || createdId;
        break;
      } catch (err) {
        if (attempt < 3 && isMissingColumnError(err)) {
          const msg = String(err && err.message || '');
          const optionalKeys = ['craa5_idofssop', 'craa5_bundle', 'craa5_daily', 'craa5_weekly', 'craa5_monthly', 'craa5_room', 'craa5_area', 'craa5_sap', 'craa5_hoursworked', LOG_ASSET_ID_SELECT];
          let dropped = false;
          optionalKeys.forEach(k => {
            if (payload[k] !== undefined && new RegExp(`\\b${k}\\b`, 'i').test(msg)) {
              delete payload[k];
              missingLogColumns.add(k);
              dropped = true;
            }
          });
          if (!dropped) {
            if (payload.craa5_idofssop !== undefined || payload.craa5_bundle !== undefined) {
              delete payload.craa5_idofssop;
              delete payload.craa5_bundle;
            } else {
              ['craa5_daily', 'craa5_weekly', 'craa5_monthly'].forEach(k => { delete payload[k]; });
            }
          }
          continue;
        }
        pushDevLog('ERROR', 'craa5__log_', `Failed creating log for ${equipName} on ${dateStr}`, 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, String(err && err.message || err));
        throw err;
      }
    }
    if (file && isGuid(createdId)) {
      fileUploaded = await uploadPaperworkToLog(createdId, file);
    }
  }

  const localRecord = Object.assign({}, basePayload, flags, {
    craa5__log_id: createdId,
    [LOG_ASSET_ID_SELECT]: assetId,
    craa5_lastcleaned: dateStr,
    craa5_hoursworked: intHours,
    craa5_sap: resolvedSap,
    craa5_skipcode: skipCodeVal || undefined,
    craa5_skipnote: skipNoteVal || undefined
  });
  if (file && (fileUploaded || !hasXrmConnection())) {
    localRecord[LOG_FILE_COLUMN] = createdId;
    localRecord[LOG_FILE_NAME_COLUMN] = file.name || 'paperwork.jpg';
  }

  const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
  pushDevLog('API-WRITE', 'craa5__log_', skipCodeVal ? `Logged skip (${skipCodeVal}) for ${equipName} (${dateStr})` : `Logged ${cleanCode} clean for ${equipName} (${dateStr}) by ${who}`, 'OK', ms, 1, `SAP: ${resolvedSap || 'N/A'}, Hours: ${intHours}`);
  if (!skipCodeVal) broadcastHubEvent({ type: 'LOG_CREATED', log: localRecord });
  return localRecord;
};

