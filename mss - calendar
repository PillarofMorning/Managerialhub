function QuickLogModal({ target, assets, onClose, onSaved, onCreated }) {
  const [mode, setMode] = useState('clean'); // 'clean' | 'skip'
  const [assetId, setAssetId] = useState(() => (target && target.asset ? getAssetId(target.asset) : (assets[0] ? getAssetId(assets[0]) : '')));
  const [equipFilter, setEquipFilter] = useState('');
  const [notice, setNotice] = useState('');
  const selectedAsset = useMemo(() => {
    if (target && target.asset && getAssetId(target.asset) === assetId) return target.asset;
    return assets.find(a => getAssetId(a) === assetId) || (target && target.asset) || assets[0] || null;
  }, [target, assets, assetId]);

  const activeFreqs = useMemo(() => {
    if (!selectedAsset) return ['D', 'W', 'M'];
    const list = FREQS.filter(f => f.flags.some(c => isTrue(selectedAsset[c]))).map(f => f.code);
    return list.length ? list : ['D', 'W', 'M'];
  }, [selectedAsset]);

  const [dateStr, setDateStr] = useState(() => (target && target.dateStr) || hubPlantDay(Date.now()));
  const [cleanCode, setCleanCode] = useState(() => (target && target.cleanCode) || activeFreqs[0] || 'D');
  const sapMap = useMemo(() => getAssetSapMap(selectedAsset), [selectedAsset]);
  const [sapCode, setSapCode] = useState(() => sapMap[cleanCode] || sapMap.D || '');
  const [cleanedBy, setCleanedBy] = useState(() => {
    const id = resolveMicrosoftIdentity(loadUserOverride());
    return id.userName && id.userName !== 'Local Plant User' ? id.userName : 'Sanitor';
  });
  const [hours, setHours] = useState('60');   // person-minutes (data contract section 7)
  const [file, setFile] = useState(null);
  const [skipCodes] = useState(loadSkipCodes);
  const [skipCode, setSkipCode] = useState('PROD_RUN');
  const [skipNote, setSkipNote] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    const nextSap = sapMap[cleanCode] || sapMap.D || '';
    setSapCode(nextSap);
  }, [cleanCode, sapMap]);

  const filteredAssets = useMemo(() => {
    const q = equipFilter.trim().toLowerCase();
    if (!q) return assets.slice(0, 60);
    return assets.filter(a => {
      const n = safeString(getProp(a, 'craa5_equipmentidentifier'));
      const r = safeString(getProp(a, 'craa5_roomname'));
      const ar = safeString(getProp(a, 'craa5_areaname'));
      return (n + ' ' + r + ' ' + ar).toLowerCase().indexOf(q) > -1;
    }).slice(0, 60);
  }, [assets, equipFilter]);

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!selectedAsset) { setError('Select a piece of equipment first.'); return; }
    if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) { setError('Pick a valid date (YYYY-MM-DD).'); return; }
    setBusy(true);
    setError('');
    try {
      if (mode === 'skip') {
        const foundSkip = skipCodes.find(s => s.code === skipCode) || { code: skipCode, label: skipCode };
        const skipEntry = {
          id: 'skip-' + Date.now(),
          date: dateStr,
          assetId: getAssetId(selectedAsset),
          equipment: safeString(getProp(selectedAsset, 'craa5_equipmentidentifier')),
          room: safeString(getProp(selectedAsset, 'craa5_roomname')) || 'Unassigned Room',
          area: safeString(getProp(selectedAsset, 'craa5_areaname')) || 'Unassigned Area',
          sap: sapCode,
          skipCode: foundSkip.code,
          skipLabel: foundSkip.label,
          note: skipNote.trim(),
          loggedBy: normalizeWhoInput(cleanedBy),
          createdAt: new Date().toISOString()
        };
        saveSkippedEntry(skipEntry);
        createCalendarLogEntry({
          asset: selectedAsset,
          dateStr,
          cleanCode,
          sapCode,
          cleanedBy,
          hours: 0,
          file: null,
          skipMeta: { skipCode: foundSkip.code, skipNote: skipNote.trim() }
        }).catch(() => {});
        pushDevLog('SYNC', 'mss_log_skipped_entries_v1', `Recorded skip (${foundSkip.code}) for ${skipEntry.equipment} on ${dateStr}`, 'OK', 1, 1);
        if (onSaved) onSaved({ kind: 'skip', skipEntry });
        onClose();
        return;
      }

      const newLog = await createCalendarLogEntry({
        asset: selectedAsset,
        dateStr,
        cleanCode,
        sapCode,
        cleanedBy,
        hours,
        file
      });
      if (onSaved) onSaved({ kind: 'clean', log: newLog, asset: selectedAsset });
      if (onCreated) onCreated(newLog);
      // a second entry of a clean others already logged: say so before closing
      if (newLog && newLog._mlwSeparate) { setNotice(newLog._mlwSeparate); setTimeout(onClose, 4000); return; }
      onClose();
    } catch (err) {
      setError(String(err && err.message || err));
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="modal-overlay" data-testid="quick-log-modal" onClick={onClose}>
      <div className="paper-box" style={{ width: '540px', maxWidth: '94vw', background: '#fff' }} onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <div>
            <h2>{mode === 'clean' ? 'Log Sanitation Clean' : 'Record Skip / Deferral'}</h2>
            <p className="brand-subtitle">Synced with MSS Log Input (craa5__log_)</p>
          </div>
          <button type="button" className="page-btn" onClick={onClose} title="Close"><XIcon /></button>
        </div>
        <form onSubmit={handleSubmit} style={{ padding: '18px 24px', display: 'flex', flexDirection: 'column', gap: '12px', overflowY: 'auto' }}>
          <div className="comp-seg" role="group" aria-label="Entry Mode">
            <button type="button" className={mode === 'clean' ? 'on' : ''} onClick={() => setMode('clean')}>Completed Clean</button>
            <button type="button" className={mode === 'skip' ? 'on' : ''} onClick={() => setMode('skip')}>Skip / Deferral</button>
          </div>

          {target && target.existingEntry && (
            <div style={{ padding: '10px 12px', borderRadius: 8, background: BRAND.greenSoft, border: `1px solid ${BRAND.greenLine}`, fontSize: 12 }}>
              <b>Already Logged on {dateStr}:</b> Cleaned by {target.existingEntry.log.craa5_lastcleanedby || 'N/A'}
              {target.existingEntry.types ? ` (${logTypeLabel(target.existingEntry.types)})` : ''}
              {target.existingEntry.log.craa5_sap ? ` - SAP ${target.existingEntry.log.craa5_sap}` : ''}.
              You can log an additional clean or attach paperwork below.
            </div>
          )}

          {(!target || !target.asset) && (
            <label className="dt-field">
              <span>Filter Equipment ({assets.length} loaded)</span>
              <input value={equipFilter} onChange={e => setEquipFilter(e.target.value)} placeholder="Type room, area, or equipment name..." />
            </label>
          )}

          <label className="dt-field">
            <span>Equipment</span>
            <select
              value={selectedAsset ? getAssetId(selectedAsset) : ''}
              onChange={e => setAssetId(e.target.value)}
              style={{ padding: '8px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13, fontWeight: 600 }}
            >
              {filteredAssets.map(a => {
                const id = getAssetId(a);
                const n = safeString(getProp(a, 'craa5_equipmentidentifier'));
                const r = safeString(getProp(a, 'craa5_roomname')) || 'Unassigned Room';
                const ar = safeString(getProp(a, 'craa5_areaname')) || 'Unassigned Area';
                return <option key={id} value={id}>{n} ({r} / {ar})</option>;
              })}
            </select>
          </label>

          <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
            <label className="dt-field" style={{ flex: '1 1 150px' }}>
              <span>Shift date (the day the shift started)</span>
              <input type="date" value={dateStr} onChange={e => setDateStr(e.target.value)} required />
            </label>
            <label className="dt-field" style={{ flex: '1 1 180px' }}>
              <span>Cleaned By / Initials</span>
              <input value={cleanedBy} onChange={e => setCleanedBy(e.target.value)} placeholder="e.g. JD / MK" required />
            </label>
          </div>

          {mode === 'clean' ? (
            <>
              <div className="dt-field">
                <span>Which clean was done</span>
                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginTop: 2 }}>
                  {FREQS.map(f => {
                    const isSetOnAsset = activeFreqs.indexOf(f.code) > -1;
                    return (
                      <button
                        key={f.code}
                        type="button"
                        className={'fchip' + (cleanCode === f.code ? ' on' : '')}
                        style={{ padding: '0 10px', height: 32 }}
                        onClick={() => setCleanCode(f.code)}
                        title={`${f.label} (${isSetOnAsset ? 'scheduled on this equipment' : 'additional clean'})`}
                      >
                        {f.code} - {f.label}
                      </button>
                    );
                  })}
                </div>
              </div>

              <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
                <label className="dt-field" style={{ flex: '1 1 160px' }}>
                  <span>SAP Order Number</span>
                  <input value={sapCode} onChange={e => setSapCode(e.target.value)} placeholder="Optional SAP order" />
                </label>
                <label className="dt-field" style={{ flex: '1 1 140px' }}>
                  <span>Labor minutes (people x minutes)</span>
                  <input type="number" min="0" max="1440" step="1" value={hours} onChange={e => setHours(e.target.value)} />
                </label>
              </div>

              <label className="dt-field">
                <span>Paperwork Photo or PDF (craa5_pictureorfileofpaperwork)</span>
                <input type="file" accept="image/*,application/pdf" onChange={e => setFile(e.target.files && e.target.files[0] ? e.target.files[0] : null)} />
              </label>
            </>
          ) : (
            <>
              <label className="dt-field">
                <span>Standardized Skip Code</span>
                <select
                  value={skipCode}
                  onChange={e => setSkipCode(e.target.value)}
                  style={{ padding: '8px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13, fontWeight: 600 }}
                >
                  {skipCodes.map(s => <option key={s.code} value={s.code}>{s.code} - {s.label}</option>)}
                </select>
              </label>
              <label className="dt-field">
                <span>Skip Note / Comments</span>
                <input value={skipNote} onChange={e => setSkipNote(e.target.value)} placeholder="Reason details..." />
              </label>
            </>
          )}

          {error && <p className="dt-error" role="alert">{error}</p>}
          {notice && <p className="dt-note" role="status" data-testid="quick-log-notice" style={{ color: '#166534', fontWeight: 700 }}>{notice}</p>}

          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 10, marginTop: 6 }}>
            <button type="button" className="page-btn" onClick={onClose}>Cancel</button>
            <button type="submit" className="sync-btn" disabled={busy || !selectedAsset}>
              {busy ? 'Saving...' : mode === 'clean' ? 'Save Clean to Log' : 'Record Skip'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}

// ============================================================================
// CUSTOM VIEWS MANAGER TAB COMPONENT
// ============================================================================
function CustomViewsTab({ viewConfig, setViewConfig, activePresetId, setActivePresetId, assets, userIdentity, userOverride, onChangeOverride }) {
  const [editingId, setEditingId] = useState(activePresetId || 'full_plant');
  const [newName, setNewName] = useState('');
  const [newDesc, setNewDesc] = useState('');
  const [ruleMatchType, setRuleMatchType] = useState('microsoftId');
  const [ruleMatchVal, setRuleMatchVal] = useState('');
  const [ruleLabel, setRuleLabel] = useState('');
  const [rulePresetId, setRulePresetId] = useState('sanitor_simple');
  const [jsonText, setJsonText] = useState('');
  const [statusMsg, setStatusMsg] = useState('');

  const allRooms = useMemo(() => {
    const s = new Set(['Bakery', 'Creme']);
    assets.forEach(a => { const r = safeString(getProp(a, 'craa5_roomname')); if (r) s.add(r); });
    return Array.from(s).sort();
  }, [assets]);

  const allAreas = useMemo(() => {
    const s = new Set();
    assets.forEach(a => { const ar = safeString(getProp(a, 'craa5_areaname')); if (ar) s.add(ar); });
    return Array.from(s).sort();
  }, [assets]);

  const currentPreset = useMemo(
    () => viewConfig.presets.find(p => p.id === editingId) || viewConfig.presets[0],
    [viewConfig.presets, editingId]
  );

  const updatePreset = (id, patchFn) => {
    setViewConfig(prev => {
      const next = Object.assign({}, prev, {
        presets: prev.presets.map(p => (p.id === id ? patchFn(Object.assign({}, p)) : p))
      });
      saveViewModuleConfig(next);
      return next;
    });
  };

  const createPreset = (e) => {
    e.preventDefault();
    const name = newName.trim();
    if (!name) return;
    const id = 'custom_' + Date.now().toString(36);
    const preset = {
      id,
      name,
      description: newDesc.trim() || 'Custom user view preset',
      isBuiltIn: false,
      allowedTabs: ['master', 'completion', 'downtime', 'views', 'manual'],
      allowedRooms: [],
      allowedAreas: [],
      defaultTab: 'master',
      defaultFullMode: false,
      defaultCompact: true,
      defaultLateOnly: false
    };
    setViewConfig(prev => {
      const next = Object.assign({}, prev, { presets: prev.presets.concat([preset]) });
      saveViewModuleConfig(next);
      return next;
    });
    setEditingId(id);
    setActivePresetId(id);
    setNewName('');
    setNewDesc('');
    setStatusMsg(`Created view preset "${name}".`);
  };

  const deletePreset = (id) => {
    const target = viewConfig.presets.find(p => p.id === id);
    if (!target || target.isBuiltIn) return;
    setViewConfig(prev => {
      const nextPresets = prev.presets.filter(p => p.id !== id);
      const next = Object.assign({}, prev, {
        defaultPresetId: prev.defaultPresetId === id ? 'full_plant' : prev.defaultPresetId,
        presets: nextPresets,
        userRules: prev.userRules.filter(r => r.presetId !== id)
      });
      saveViewModuleConfig(next);
      return next;
    });
    setEditingId('full_plant');
    if (activePresetId === id) setActivePresetId('full_plant');
    setStatusMsg(`Deleted preset "${target.name}".`);
  };

  const addRule = (e) => {
    e.preventDefault();
    const val = ruleMatchVal.trim();
    if (!val) return;
    const rule = {
      id: 'rule-' + Date.now().toString(36),
      matchType: ruleMatchType,
      matchValue: val,
      label: ruleLabel.trim() || val,
      presetId: rulePresetId,
      active: true
    };
    setViewConfig(prev => {
      const next = Object.assign({}, prev, { userRules: prev.userRules.concat([rule]) });
      saveViewModuleConfig(next);
      return next;
    });
    setRuleMatchVal('');
    setRuleLabel('');
    setStatusMsg(`Added user rule for ${val}.`);
  };

  const removeRule = (id) => {
    setViewConfig(prev => {
      const next = Object.assign({}, prev, { userRules: prev.userRules.filter(r => r.id !== id) });
      saveViewModuleConfig(next);
      return next;
    });
  };

  const importFromMssInput = () => {
    try {
      const raw = window.localStorage.getItem(MSS_INPUT_VIEW_CONFIG_KEY);
      if (!raw) { setStatusMsg('No MSS Log Input view config found in this browser yet.'); return; }
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') { setStatusMsg('MSS Log Input view config is empty.'); return; }
      const presetKeyMap = {
        full_admin: 'full_plant',
        lead_supervisor: 'qa_supervisor',
        simple: 'sanitor_simple',
        standard: 'full_plant'
      };
      const rawPresets = Array.isArray(parsed.presets)
        ? parsed.presets
        : (parsed.presets && typeof parsed.presets === 'object' ? Object.keys(parsed.presets).map(k => Object.assign({ id: presetKeyMap[k] || k }, parsed.presets[k])) : []);
      const importedPresets = rawPresets.map(p => ({
        id: presetKeyMap[p.id] || p.id,
        name: p.name || p.label || p.id,
        description: p.description || 'Imported from MSS Log Input',
        isBuiltIn: Boolean(p.isBuiltIn),
        allowedTabs: ['master', 'completion', 'downtime', 'views', 'manual', 'payloads'],
        allowedRooms: Array.isArray(p.allowedRooms) ? p.allowedRooms : [],
        allowedAreas: Array.isArray(p.allowedAreas) ? p.allowedAreas : [],
        defaultTab: 'master',
        defaultFullMode: false,
        defaultCompact: true,
        defaultLateOnly: false
      }));
      const importedRules = Array.isArray(parsed.userRules) && parsed.userRules.length
        ? parsed.userRules
        : (Array.isArray(parsed.userAssignments) ? parsed.userAssignments.map(ua => ({
            id: ua.id || ('rule-' + Date.now().toString(36)),
            matchType: ua.matchKey && ua.matchKey.indexOf('@') > -1 ? 'email' : 'microsoftId',
            matchValue: ua.matchKey || ua.matchValue || '',
            label: ua.displayName || ua.label || ua.matchKey || '',
            presetId: presetKeyMap[ua.preset] || ua.preset || 'sanitor_simple',
            locked: Boolean(ua.lockedByAdmin),
            active: true
          })).filter(r => r.matchValue) : []);
      setViewConfig(prev => {
        const existingIds = new Set(prev.presets.map(x => x.id));
        const merged = prev.presets.map(x => {
          const match = importedPresets.find(ip => ip.id === x.id);
          return match ? Object.assign({}, x, { allowedRooms: match.allowedRooms, allowedAreas: match.allowedAreas }) : x;
        }).concat(importedPresets.filter(ip => !existingIds.has(ip.id)));
        const next = {
          defaultPresetId: prev.defaultPresetId,
          presets: merged,
          userRules: importedRules.length ? importedRules : prev.userRules
        };
        saveViewModuleConfig(next);
        return next;
      });
      pushDevLog('VIEW', 'mss_log_input_view_module_v1', 'Imported view presets and rules from MSS Log Input', 'OK', 2, importedPresets.length + importedRules.length);
      setStatusMsg(`Synced ${importedPresets.length} presets and ${importedRules.length} user rules from MSS Log Input.`);
    } catch (err) {
      setStatusMsg('Could not import from MSS Log Input: ' + String(err && err.message || err));
    }
  };

  const saveToDataverseHubConfig = async () => {
    const webApi = getXrmWebApi();
    if (!webApi) {
      setStatusMsg('Saved in browser storage (Dataverse offline).');
      return;
    }
    const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
    try {
      await hcWrite('MSS_CALENDAR_VIEW_CONFIG', viewConfig, { craa5_updatedby: safeString(currentIdentity && (currentIdentity.userName || currentIdentity.microsoftId) || 'MSS Calendar') });
      pushDevLog('API-WRITE', HUB_CONFIG_TABLE, 'Saved MSS_CALENDAR_VIEW_CONFIG to Dataverse', 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      setStatusMsg('Saved Custom Views configuration to Dataverse (craa5__0_hubconfig).');
    } catch (err) {
      pushDevLog('ERROR', HUB_CONFIG_TABLE, 'Failed saving MSS_CALENDAR_VIEW_CONFIG', 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, String(err && err.message || err));
      setStatusMsg('Saved locally; Dataverse write returned: ' + String(err && err.message || err));
    }
  };

  const toggleListItem = (list, item) => (list.indexOf(item) > -1 ? list.filter(x => x !== item) : list.concat([item]));

  return (
    <main className="comp-main" data-testid="custom-views-tab">
      <div className="comp-wrap">
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 12 }}>
          <div>
            <h2 style={{ fontSize: 18, fontWeight: 900, margin: 0, color: BRAND.blueDark }}>Custom Views &amp; Role Assignments</h2>
            <p className="dt-intro">Configure simplified views by Room, Area, and Navigation Tabs for plant users, or sync presets directly with MSS Log Input.</p>
          </div>
          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
            <button type="button" className="sync-btn outline" onClick={importFromMssInput}>Sync from MSS Log Input</button>
            <button type="button" className="sync-btn" onClick={saveToDataverseHubConfig}>Save Views to Dataverse</button>
          </div>
        </div>

        {statusMsg && <div className="comp-saved" role="status"><span>{statusMsg}</span><button type="button" className="page-btn" onClick={() => setStatusMsg('')}>OK</button></div>}

        <section className="diag-card comp-card">
          <div className="comp-card-head">
            <h3>1. Active View Preset Switcher</h3>
            <span className="comp-sum">Signed in as: {userIdentity.userName} ({userIdentity.microsoftId}) - {userIdentity.source}</span>
          </div>
          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginTop: 8 }}>
            {viewConfig.presets.map(p => {
              const isAct = p.id === activePresetId;
              return (
                <button
                  key={p.id}
                  type="button"
                  className={isAct ? 'sync-btn' : 'page-btn'}
                  onClick={() => { setActivePresetId(p.id); setEditingId(p.id); }}
                >
                  {p.name}{p.allowedRooms && p.allowedRooms.length ? ` (${p.allowedRooms.join(', ')})` : ''}
                </button>
              );
            })}
          </div>
        </section>

        <section className="diag-card comp-card">
          <div className="comp-card-head">
            <h3>2. Customize Preset: {currentPreset ? currentPreset.name : ''}</h3>
            {currentPreset && !currentPreset.isBuiltIn && (
              <button type="button" className="page-btn danger" onClick={() => deletePreset(currentPreset.id)}>Delete Preset</button>
            )}
          </div>
          {currentPreset && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <p className="dt-note">{currentPreset.description}</p>

              <div>
                <div className="dt-label">Allowed Navigation Tabs</div>
                <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginTop: 6 }}>
                  {ALL_CALENDAR_TABS.map(t => {
                    const on = currentPreset.allowedTabs.indexOf(t.id) > -1;
                    return (
                      <label key={t.id} className="comp-check">
                        <input
                          type="checkbox"
                          checked={on}
                          disabled={t.id === 'master' || t.id === 'views'}
                          onChange={() => updatePreset(currentPreset.id, p => Object.assign(p, { allowedTabs: toggleListItem(p.allowedTabs, t.id) }))}
                        />
                        <span className="comp-name" style={{ fontSize: 12 }}>{t.label}</span>
                      </label>
                    );
                  })}
                </div>
              </div>

              <div>
                <div className="dt-label">Allowed Rooms <span>{currentPreset.allowedRooms.length === 0 ? 'All Rooms shown (unticked = no filter)' : `Filtered to ${currentPreset.allowedRooms.length} room(s)`}</span></div>
                <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginTop: 6 }}>
                  {allRooms.map(room => {
                    const on = currentPreset.allowedRooms.indexOf(room) > -1;
                    return (
                      <label key={room} className="comp-check">
                        <input
                          type="checkbox"
                          checked={on}
                          onChange={() => updatePreset(currentPreset.id, p => Object.assign(p, { allowedRooms: toggleListItem(p.allowedRooms, room) }))}
                        />
                        <span className="comp-name" style={{ fontSize: 12 }}>{room}</span>
                      </label>
                    );
                  })}
                  {currentPreset.allowedRooms.length > 0 && (
                    <button type="button" className="page-btn" onClick={() => updatePreset(currentPreset.id, p => Object.assign(p, { allowedRooms: [] }))}>Show All Rooms</button>
                  )}
                </div>
              </div>

              {allAreas.length > 0 && (
                <div>
                  <div className="dt-label">Allowed Areas <span>{currentPreset.allowedAreas.length === 0 ? 'All Areas shown' : `Filtered to ${currentPreset.allowedAreas.length} area(s)`}</span></div>
                  <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginTop: 6 }}>
                    {allAreas.slice(0, 30).map(area => {
                      const on = currentPreset.allowedAreas.indexOf(area) > -1;
                      return (
                        <label key={area} className="comp-check">
                          <input
                            type="checkbox"
                            checked={on}
                            onChange={() => updatePreset(currentPreset.id, p => Object.assign(p, { allowedAreas: toggleListItem(p.allowedAreas, area) }))}
                          />
                          <span className="comp-name" style={{ fontSize: 12 }}>{area}</span>
                        </label>
                      );
                    })}
                    {currentPreset.allowedAreas.length > 0 && (
                      <button type="button" className="page-btn" onClick={() => updatePreset(currentPreset.id, p => Object.assign(p, { allowedAreas: [] }))}>Show All Areas</button>
                    )}
                  </div>
                </div>
              )}

              <div>
                <div className="dt-label">Startup Display Defaults</div>
                <div style={{ display: 'flex', gap: 16, flexWrap: 'wrap', marginTop: 6 }}>
                  <label className="comp-check">
                    <input
                      type="checkbox"
                      checked={Boolean(currentPreset.defaultFullMode)}
                      onChange={e => updatePreset(currentPreset.id, p => Object.assign(p, { defaultFullMode: e.target.checked }))}
                    />
                    <span className="comp-name" style={{ fontSize: 12 }}>Start in Full Mode (show Daily/Weekly % rows)</span>
                  </label>
                  <label className="comp-check">
                    <input
                      type="checkbox"
                      checked={Boolean(currentPreset.defaultCompact)}
                      onChange={e => updatePreset(currentPreset.id, p => Object.assign(p, { defaultCompact: e.target.checked }))}
                    />
                    <span className="comp-name" style={{ fontSize: 12 }}>Compact Rows</span>
                  </label>
                  <label className="comp-check">
                    <input
                      type="checkbox"
                      checked={Boolean(currentPreset.defaultLateOnly)}
                      onChange={e => updatePreset(currentPreset.id, p => Object.assign(p, { defaultLateOnly: e.target.checked }))}
                    />
                    <span className="comp-name" style={{ fontSize: 12 }}>Late Only Filter</span>
                  </label>
                </div>
              </div>
            </div>
          )}

          <form onSubmit={createPreset} style={{ marginTop: 16, paddingTop: 14, borderTop: '1px solid #e2e8f0', display: 'flex', gap: 10, flexWrap: 'wrap', alignItems: 'flex-end' }}>
            <label className="dt-field" style={{ flex: '1 1 200px' }}>
              <span>New Custom Preset Name</span>
              <input value={newName} onChange={e => setNewName(e.target.value)} placeholder="e.g. Packaging Night Shift" />
            </label>
            <label className="dt-field" style={{ flex: '2 1 260px' }}>
              <span>Description</span>
              <input value={newDesc} onChange={e => setNewDesc(e.target.value)} placeholder="Rooms and tabs for this role..." />
            </label>
            <button type="submit" className="sync-btn">Create Preset</button>
          </form>
        </section>

        <section className="diag-card comp-card">
          <div className="comp-card-head">
            <h3>3. User Microsoft ID &amp; Role Assignment Rules</h3>
            <span className="comp-sum">{viewConfig.userRules.length} rule(s) active</span>
          </div>
          <p className="dt-hint">Bind a plant user's Microsoft ID (e.g. U1010051), email, or username to automatically activate their custom view when they open the app.</p>
          <form onSubmit={addRule} style={{ display: 'flex', gap: 10, flexWrap: 'wrap', alignItems: 'flex-end', marginTop: 8 }}>
            <label className="dt-field">
              <span>Match By</span>
              <select value={ruleMatchType} onChange={e => setRuleMatchType(e.target.value)} style={{ padding: '7px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13 }}>
                <option value="microsoftId">Microsoft ID</option>
                <option value="email">Email</option>
                <option value="username">Name</option>
              </select>
            </label>
            <label className="dt-field" style={{ flex: '1 1 160px' }}>
              <span>User ID / Value</span>
              <input value={ruleMatchVal} onChange={e => setRuleMatchVal(e.target.value)} placeholder="e.g. U1010051" />
            </label>
            <label className="dt-field" style={{ flex: '1 1 160px' }}>
              <span>Role Label</span>
              <input value={ruleLabel} onChange={e => setRuleLabel(e.target.value)} placeholder="e.g. Bakery Lead" />
            </label>
            <label className="dt-field" style={{ flex: '1 1 180px' }}>
              <span>Assigned Preset</span>
              <select value={rulePresetId} onChange={e => setRulePresetId(e.target.value)} style={{ padding: '7px 10px', borderRadius: 8, border: '1px solid #cbd5e1', fontSize: 13 }}>
                {viewConfig.presets.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
              </select>
            </label>
            <button type="submit" className="sync-btn">Add Rule</button>
          </form>

          <div style={{ marginTop: 12, display: 'flex', flexDirection: 'column', gap: 6 }}>
            {viewConfig.userRules.map(r => {
              const pName = (viewConfig.presets.find(p => p.id === r.presetId) || { name: r.presetId }).name;
              return (
                <div key={r.id} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '6px 12px', borderRadius: 8, background: '#f8fafc', border: '1px solid #e2e8f0', fontSize: 12 }}>
                  <span><b>{r.matchValue}</b> ({r.matchType}) - {r.label} - Assigned View: <b>{pName}</b></span>
                  <div style={{ display: 'flex', gap: 6 }}>
                    <button type="button" className="page-btn" onClick={() => { onChangeOverride({ microsoftId: r.matchValue, userName: r.label, email: '' }); setActivePresetId(r.presetId); }}>Test as User</button>
                    <button type="button" className="page-btn danger" onClick={() => removeRule(r.id)}>Remove</button>
                  </div>
                </div>
              );
            })}
          </div>

          {userOverride && (
            <div style={{ marginTop: 10, padding: '8px 12px', borderRadius: 8, background: BRAND.yellowSoft, border: `1px solid ${BRAND.yellow}`, display: 'flex', alignItems: 'center', justifyContent: 'space-between', fontSize: 12 }}>
              <span>Identity Simulation Active: <b>{userOverride.userName} ({userOverride.microsoftId})</b></span>
              <button type="button" className="page-btn" onClick={() => onChangeOverride(null)}>Clear Simulation</button>
            </div>
          )}
        </section>

        <section className="diag-card comp-card">
          <div className="comp-card-head">
            <h3>4. Export / Import View Configuration JSON</h3>
            <button type="button" className="page-btn" onClick={() => setJsonText(JSON.stringify(viewConfig, null, 2))}>Load Current JSON</button>
            {jsonText && (
              <button
                type="button"
                className="sync-btn yellow"
                onClick={() => {
                  try {
                    const parsed = JSON.parse(jsonText);
                    if (!parsed || !Array.isArray(parsed.presets)) throw new Error('Invalid presets array');
                    setViewConfig(parsed);
                    saveViewModuleConfig(parsed);
                    setStatusMsg('Imported JSON view configuration.');
                  } catch (err) {
                    setStatusMsg('Invalid JSON: ' + String(err && err.message || err));
                  }
                }}
              >
                Apply JSON
              </button>
            )}
          </div>
          {jsonText && (
            <textarea
              value={jsonText}
              onChange={e => setJsonText(e.target.value)}
              rows={6}
              style={{ width: '100%', fontFamily: 'monospace', fontSize: 11, padding: 10, borderRadius: 8, border: '1px solid #cbd5e1' }}
            />
          )}
        </section>
      </div>
    </main>
  );
}

