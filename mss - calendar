  }, [filteredTreeData, freqStatus, completionIndex, visiblePrefixes]);

  // --- Completion percentages (see COMPLETION PERCENTAGES) ---
  // The daily and weekly rows under the day headers of the MSS in full mode: over the equipment listed after the search filter
  // (less what the Completion tab leaves out), from the logs read so far; what has not been read is left out and counted as
  // "not read yet". The focused dialog gets its own rows for the room or area it shows. The totals, the room and area figures and
  // Top missed are on the Completion tab.
  const completion = useMemo(() => {
    if (activeTab !== 'master' || !fullMode) return null;
    const list = [];
    Object.keys(filteredTreeData).forEach(room => Object.keys(filteredTreeData[room]).forEach(area => filteredTreeData[room][area].forEach(a => { if (!exLeftOut(exclusions.ex, room, area, getAssetId(a))) list.push(a); })));
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules });
    // loadedTick stands in for loadedRef.current, which is not state.
    // eslint-disable-next-line
  }, [activeTab, fullMode, filteredTreeData, exclusions.ex, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  const completionModal = useMemo(() => {
    if (!modalContext || !fullMode) return null;
    const list = [];
    Object.keys(filteredTreeData)
      .filter(r => modalContext.type === 'room' ? r === modalContext.value : filteredTreeData[r][modalContext.value])
      .forEach(room => Object.keys(filteredTreeData[room])
        .filter(a => modalContext.type === 'area' ? a === modalContext.value : true)
        .forEach(area => filteredTreeData[room][area].forEach(a => { if (!exLeftOut(exclusions.ex, room, area, getAssetId(a))) list.push(a); })));
    return computeCompletion({ assets: list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules });
    // eslint-disable-next-line
  }, [modalContext, fullMode, filteredTreeData, exclusions.ex, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);
  const pctCells = useMemo(() => completion ? completionCells(completion, timelineDays) : null, [completion, timelineDays]);
  const pctCellsModal = useMemo(() => completionModal ? completionCells(completionModal, timelineDays) : null, [completionModal, timelineDays]);
  // The Completion tab, computed when open or when Executive Mode (fullMode) is unlocked: every equipment that counts, the
  // groups it belongs to (its room, its area, itself) in the one pass, so the totals, every room's, area's and equipment's
  // figure and the figures per frequency letter all come from it.
  const countList = useMemo(() => ((activeTab === 'completion' || fullMode) ? buildCountList(assets, exclusions.ex) : null), [activeTab, fullMode, assets, exclusions.ex]);
  const compTab = useMemo(() => {
    if (!countList) return null;
    return computeCompletion({ assets: countList.list, byAsset: completionIndex.byAsset, loaded: loadedRef.current, idColumn, year: anchorYear, today, visibleMonths, rules: lineRules, bucketsOf: (a, i) => countList.keys[i] });
    // eslint-disable-next-line
  }, [countList, completionIndex, loadedTick, idColumn, anchorYear, today, visibleMonths, lineRules]);

  const prioritizationModel = useMemo(
    () => buildPrioritizationModel({
      assets,
      freqStatus,
      completionIndex,
      lineRules,
      planModel,
      today,
      todayStr
    }),
    [assets, freqStatus, completionIndex, lineRules, planModel, today, todayStr]
  );

  const [econ, setEcon] = useState(loadEconParams);
  const updateEcon = useCallback((next) => {
    setEcon(next);
    saveEconParams(next);
  }, []);
  const resetEcon = useCallback(() => {
    const def = { ...DEFAULT_ECON_PARAMS };
    setEcon(def);
    saveEconParams(def);
  }, []);

  const extrapolatedAnalytics = useMemo(
    () => buildExtrapolatedAnalyticsModel({
      assets,
      logs,
      completionIndex,
      lineRules,
      planModel,
      prioritizationModel,
      anchorYear,
      econ
    }),
    [assets, logs, completionIndex, lineRules, planModel, prioritizationModel, anchorYear, econ]
  );

  const openAreaInMatrix = useCallback((room, area) => {
    const r = safeString(room).trim();
    const a = safeString(area).trim();
    if (r) {
      setExpandedKeys(prev => Object.assign({}, prev, { [r]: true }, a ? { [`${r}|${a}`]: true } : {}));
      const rIdx = roomKeys.indexOf(r);
      if (rIdx >= 0) setCurrentPage(Math.floor(rIdx / pageSize));
    }
    setActiveTab('master');
  }, [roomKeys, pageSize]);

  // Read these equipment's log for the months of a view: 'ytd' = the months of this year so far, quarter by quarter (at most 3
  // months in a request, and the December before, where the first week starts), 'tf' = the slicer months that have started.
  // Through the same paced queue as Read and Load all (at most 3 requests at a time).
  const readMonths = useCallback((ids, metric) => {
    const c = compTab;
    if (!hasXrmConnection() || !c || !ids.length || c.endM < 0) return;
    const runs = [];
    if (metric === 'ytd') {
      for (let q = 0; q * 3 <= c.endM; q++) runs.push({ ids: ids, year: anchorYear, months: [q * 3, q * 3 + 1, q * 3 + 2].filter(m => m <= c.endM) });
      if (c.reachesPrev) runs.push({ ids: ids, year: anchorYear - 1, months: [11] });   // the week that holds 1 January starts in December
    } else {
      const months = visibleMonths.filter(m => m <= c.endM);
      if (months.length) runs.push({ ids: ids, year: anchorYear, months: months });
    }
    if (!runs.length) return;
    lastYearRunsRef.current = runs;
    setLoadErrors([]);
    setPinnedRuns(prev => prev.concat(runs));
  }, [compTab, anchorYear, visibleMonths]);
  // Save the frequency changes of these equipment (ids) to craa5_aa_assets, then show them in the list: the equipment rows are
  // patched in place for the ones Dataverse accepted; the others keep their change so it can be tried again.
  const saveFreqEdits = async (ids) => {
    if (!hasXrmConnection() || isSaving || isLoading) return;
    const items = ids.filter(id => freqEdits[id] && assetsById.get(id)).map(id => ({ id, asset: assetsById.get(id), want: freqEdits[id] }));
    const gone = ids.filter(id => freqEdits[id] && !assetsById.get(id)).map(id => ({ id, error: 'it was removed from Dataverse, so the change was dropped' }));
    if (gone.length) setFreqEdits(prev => { const next = { ...prev }; gone.forEach(g => { delete next[g.id]; }); return next; });
    if (!items.length) { if (gone.length) setFreqSave({ busy: false, ok: 0, failed: gone }); return; }
    setIsSaving(true);
    setFreqSave({ busy: true });
    const epoch = epochRef.current;
    try {
      const res = await writeFreqChanges(items);
      if (epochRef.current !== epoch) { setFreqSave(null); return; }   // a Sync replaced the data while saving
      const patches = {};
      res.forEach(r => { if (r.ok) patches[r.id] = r.patch; });
      if (Object.keys(patches).length) setAssets(prev => prev.map(a => { const patch = patches[getAssetId(a)]; return patch ? { ...a, ...patch } : a; }));
      setFreqEdits(prev => { const next = { ...prev }; Object.keys(patches).forEach(id => { delete next[id]; }); return next; });
      setFreqSave({ busy: false, ok: Object.keys(patches).length, failed: res.filter(r => !r.ok).map(r => ({ id: r.id, error: r.error })).concat(gone) });
    } catch (err) {
      setFreqSave({ busy: false, ok: 0, failed: items.map(it => ({ id: it.id, error: String(err && err.message ? err.message : err) })).concat(gone) });
    } finally {
      setIsSaving(false);
    }
  };

  // Name slices are keyed by one spelling, since the loader requests each name once however the equipment rows spell it.
  const sliceKey = (kind, year, m, item) => `${kind}|${year}|${m}|${kind === 'name' ? item.toLowerCase() : item}`;
  const jobKeys = (job) => job.items.flatMap(item => { const k = []; for (let m = job.m0; m <= job.m1; m++) k.push(sliceKey(job.kind, job.year, m, item)); return k; });

  // One global pump: at most MAX_PARALLEL_REQUESTS log requests in flight no matter how often the view changes.
  pumpRef.current = () => {
    while (activeRef.current < MAX_PARALLEL_REQUESTS && queueRef.current.length) {
      const job = queueRef.current.shift();
      activeRef.current += 1;
      (async () => {
        const started = performance.now();
        const entry = { kind: job.kind, items: job.items.length, months: `${MONTHS[job.m0].slice(0, 3)}${job.m1 > job.m0 ? '-' + MONTHS[job.m1].slice(0, 3) : ''} ${job.year}` };
        let applied = false;   // its slices go to the flush, which marks them read together with the rows
        try {
          const { rows, truncated } = job.kind === 'name'
            ? await fetchLogsByName(job.items, job.year, job.m0, job.m1, latestRef.current.idColumn)
            : await fetchLogsForAssets(job.items, job.year, job.m0, job.m1);
          if (epochRef.current === job.epoch) {
