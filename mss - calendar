function mlwQueue() { try { var q = JSON.parse(window.localStorage.getItem(MLW_QUEUE_KEY) || '[]'); return Array.isArray(q) ? q : []; } catch (e) { return []; } }
function mlwQueueSave(q) { try { window.localStorage.setItem(MLW_QUEUE_KEY, JSON.stringify(q)); } catch (e) { /* storage blocked: the caller still gets 'queued' */ } }
function mlwQueueCount() { return mlwQueue().length; }
function mlwEnqueue(built, e) {
    var q = mlwQueue().filter(function (x) { return x.key !== built.key; });
    q.push({ key: built.key, id: built.id, row: built.row, tries: (built.tries || 0) + 1, at: Date.now(), error: mlwErrText(e).slice(0, 300) });
    mlwQueueSave(q);
}
function mlwDequeue(key) { mlwQueueSave(mlwQueue().filter(function (x) { return x.key !== key; })); }

// The row of this completion, if any: by its fixed id, or by the completion key (a row saved where the id was not kept)
async function mlwFind(api, built) {
    var sel = [MLW_ID, 'statecode', 'craa5_lastcleanedby'];
    var useKey = !mlwMissing.craa5_completionkey;
    for (var i = 0; i < 3; i++) {
        var filter = MLW_ID + ' eq ' + built.id + (useKey ? " or craa5_completionkey eq '" + built.key.replace(/'/g, "''") + "'" : '');
        try {
            var rows = await api.query(MLW_TABLE, { select: sel, filter: filter, top: 5 });
            return (rows || [])[0] || null;
        } catch (e) {
            if (useKey && mlwIsMissingCol(mlwErrText(e))) { mlwMissing.craa5_completionkey = true; useKey = false; continue; }
            throw e;
        }
    }
    return null;
}
async function mlwSave(api, how, id, row) {
    for (var i = 0; i < 16; i++) {
        var body = mlwStrip(row);
        try {
            if (how === 'create') { body[MLW_ID] = id; await api.create(MLW_TABLE, body); }
            else await api.update(MLW_TABLE, id, body);
            return;
        } catch (e) {
            if (!mlwDropFor(e, Object.keys(body))) throw e;
        }
    }
    throw new Error('MSS log: too many missing columns');
}

// Save one finished piece. -> { status: 'saved' | 'already' | 'invalid' | 'queued', key, id, entry, separate, problems, warnings, error }
// separate = true: saved as a second entry (other people had logged this clean); say it with mlwSay('saved_separate').
async function mlwWrite(api, entry, opts) {
    var built = mlwBuildRow(entry, opts && opts.now);
    if (!built.ok) return { status: 'invalid', key: built.key, id: built.id, problems: built.problems, warnings: built.warnings };
    return mlwSend(api, built, opts);
}
// ---------- second entries (v1.4) ----------
var MLW_MAX_ENTRIES = 9;
// The clean's own key: a second entry's key|2 .. key|9 without the |n
function mlwBaseKey(key) { return String(key || '').replace(/\|\d$/, ''); }
// 1 for the first entry of a clean, 2 .. 9 for a second entry (a key that ends in |n)
function mlwEntryOf(key) { var m = /\|(\d)$/.exec(String(key || '')); return m ? Number(m[1]) : 1; }
// Entry n of a built save: its key, fixed id and row (craa5_completionkey set to that key)
function mlwSlot(built, n) {
    var key = mlwBaseKey(built.key) + (n > 1 ? '|' + n : ''), row = {};
    Object.keys(built.row || {}).forEach(function (k) { row[k] = built.row[k]; });
    row.craa5_completionkey = key;
    return { key: key, id: hubLogIdOf(key), row: row, tries: built.tries, warnings: built.warnings, n: n };
}
function mlwActive(row) { var o = {}; Object.keys(row).forEach(function (k) { o[k] = row[k]; }); o.statecode = 0; o.statuscode = 1; return o; }
// Where a save goes, read from the log without saving. -> { how, slot, found, id, blind }
//   how 'already' = an active entry of this clean by the same people (found = that row); 'create' = slot is free;
//   'update' = slot holds an undone entry (id) to bring back; 'full' = nine entries by other people (not expected).
// An undone entry is reused only when no later entry is by the same people. blind = no Read rights (only the fixed id guards).
async function mlwPlace(api, built, opts) {
    var first = mlwSlot(built, 1), names = mlwNameSet(first.row.craa5_lastcleanedby), reuse = null;
    for (var n = 1; n <= MLW_MAX_ENTRIES; n++) {
        var slot = n === 1 ? first : mlwSlot(first, n), found = null;
        try { found = await mlwFind(api, slot); }
        catch (e) { if (!mlwIsDenied(e)) throw e; return { how: 'create', slot: first, blind: true }; }
        if (found && Number(found.statecode || 0) === 0) {
            if (n === 1 && opts && opts.overwrite) return { how: 'update', slot: slot, id: hubGuid(found[MLW_ID]) || slot.id, found: found };
            if (mlwNameSet(found.craa5_lastcleanedby) === names) return { how: 'already', slot: slot, found: found };
            continue;   // the same piece, day and kind by other people: look at the next entry
        }
        if (found) { if (!reuse) reuse = { how: 'update', slot: slot, id: hubGuid(found[MLW_ID]) || slot.id, found: found }; continue; }
        return reuse || { how: 'create', slot: slot };
    }
    return reuse || { how: 'full', slot: first };
}
async function mlwSend(api, built, opts) {
    var first = mlwSlot(built, 1);   // a queued second entry is placed again from the first entry
    var out = { key: first.key, id: first.id, problems: [], warnings: built.warnings || [], entry: 1, separate: false };
    var done = function (status, slot) {
        mlwDequeue(built.key); mlwDequeue(first.key);
        out.status = status; out.key = slot.key; out.id = slot.id; out.entry = slot.n; out.separate = status === 'saved' && slot.n > 1;
        return out;
    };
    var fail = function (e) { mlwDequeue(built.key); mlwEnqueue(first, e); out.status = 'queued'; out.error = mlwErrText(e); return out; };
    if (!api || typeof api.create !== 'function') return fail('No Dataverse connection');
    try {
        for (var t = 0; t < 4; t++) {
            var p = await mlwPlace(api, first, opts);
            if (p.how === 'already' || p.how === 'full') return done('already', p.slot);
            if (p.how === 'update') { await mlwSave(api, 'update', p.id, mlwActive(p.slot.row)); return done('saved', p.slot); }   // a clean undone and then done again comes back
            try { await mlwSave(api, 'create', p.slot.id, p.slot.row); return done('saved', p.slot); }
            catch (e) {
                if (!mlwIsDuplicate(mlwErrText(e))) throw e;
                // Another device saved this entry between the read and the create: read again and compare the people
                if (p.blind) return done('already', p.slot);
            }
        }
        return done('already', first);
    } catch (e) { return fail(e); }
}
// Try every queued save again, oldest first. -> { saved, already, left }
async function mlwRetryQueue(api) {
    var q = mlwQueue(), res = { saved: 0, already: 0, left: 0 };
    for (var i = 0; i < q.length; i++) {
        var r = await mlwSend(api, { key: q[i].key, id: q[i].id, row: q[i].row, tries: q[i].tries || 1, warnings: [] });
        if (r.status === 'saved') res.saved++; else if (r.status === 'already') res.already++;
    }
    res.left = mlwQueueCount();
    return res;
}
// Undo a Done within the shift: the row is deactivated (statecode 1), never deleted, so every device drops it.
// opts (v1.4): { key } = the key the save returned (undoes that entry), or { names } = undo the active entry by these people.
// Without opts the first entry is undone (as before v1.4).
async function mlwUndo(api, equipmentGuid, shiftDate, kind, opts) {
    var key = hubCompletionKey(equipmentGuid, shiftDate, mlwKind(kind));
    if (!key) return { status: 'invalid', key: key };
    var o = opts || {};
    try {
        if (o.key && mlwBaseKey(o.key) === key) key = String(o.key);
        else if (o.names !== undefined && o.names !== null) {
            var names = mlwNameSet(o.names), hit = '';
            for (var n = 1; n <= MLW_MAX_ENTRIES && !hit; n++) {
                var k = n > 1 ? key + '|' + n : key;
                var found = await mlwFind(api, { key: k, id: hubLogIdOf(k) });
                if (!found) break;
                if (Number(found.statecode || 0) === 0 && mlwNameSet(found.craa5_lastcleanedby) === names) hit = k;
            }
            if (!hit) return { status: 'failed', key: key, error: 'No active entry by these people' };
            key = hit;
        }
        mlwDequeue(key);
        await api.update(MLW_TABLE, hubLogIdOf(key), { statecode: 1, statuscode: 2 });
        return { status: 'undone', key: key };
    } catch (e) { return { status: 'failed', key: key, error: mlwErrText(e) }; }
}

// An api for the block from Xrm.WebApi (model-driven host) or the page's dataApi (generative page host)
function mlwApi(xrm, dataApi) {
    var web = xrm && xrm.WebApi && typeof xrm.WebApi.createRecord === 'function' ? xrm.WebApi : null;
    if (web) return {
        query: async function (table, o) {
            var parts = [];
            if (o.select && o.select.length) parts.push('$select=' + o.select.join(','));
            if (o.filter) parts.push('$filter=' + o.filter.replace(/'(?:[^']|'')*'/g, function (lit) { return "'" + encodeURIComponent(lit.slice(1, -1)) + "'"; }));
            if (o.top) parts.push('$top=' + o.top);
            var res = await web.retrieveMultipleRecords(table, '?' + parts.join('&'));
            return (res && res.entities) || [];
        },
        create: function (table, body) { return web.createRecord(table, body); },
        update: function (table, id, body) { return web.updateRecord(table, id, body); }
    };
    if (dataApi && typeof dataApi.createRow === 'function') return {
        query: async function (table, o) {
            var page = await dataApi.queryTable(table, { select: o.select, filter: o.filter, pageSize: o.top || 50, top: o.top });
            return (page && page.rows) || [];
        },
        create: function (table, body) { return dataApi.createRow(table, body); },
        update: function (table, id, body) { return dataApi.updateRow(table, id, body); }
    };
    return null;
}
