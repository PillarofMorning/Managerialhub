        .focus-months { display: flex; align-items: center; gap: 4px; flex: 1 1 0; min-width: 0; overflow-x: auto; scrollbar-width: none; padding: 4px; margin: -4px; }
        .focus-months::-webkit-scrollbar { display: none; }
