    setProbing(true);
    const next = {};
    const webApi = getXrmWebApi();
    for (let i = 0; i < MSS_CALENDAR_TABLE_BLUEPRINTS.length; i++) {
      const t = MSS_CALENDAR_TABLE_BLUEPRINTS[i];
      const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
