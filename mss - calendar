                  </div>
                  <div className="exec-legend">
                    <span className="exec-leg-item"><i style={{ background: BRAND.blue }} /> Required MSS Hrs/Wk</span>
                    <span className="exec-leg-item"><i style={{ background: '#94A3B8' }} /> Scheduled Line Down Hrs/Wk</span>
                  </div>
                </div>

                <div className="graphs-svg-wrap">
                  <svg viewBox={`0 0 ${c3W} ${c3H}`} className="graphs-svg" role="img" aria-label="Area Weekly Sanitation Demand vs Line Downtime Chart">
