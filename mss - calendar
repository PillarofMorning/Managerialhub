};

// Exact clean-kind boolean rollup flags used by MSS Log Input (store.createLog / inferCleanKindFlags)
const inferCleanKindFlags = (cleanCode) => {
  const c = String(cleanCode || 'D').toUpperCase();
  if (c === 'M' || c === 'Q' || c === 'A') {
    return { craa5_daily: true, craa5_weekly: true, craa5_monthly: true };
  }
  if (c === 'W') {
    return { craa5_daily: true, craa5_weekly: true, craa5_monthly: false };
  }
  return { craa5_daily: true, craa5_weekly: false, craa5_monthly: false };
};

// Dataverse defines craa5_hoursworked as Edm.Int32 (Whole Number). Fractional values fail with HTTP 400.
const sanitizeHoursInt32 = (hours) => {
  const n = Number(hours);
  if (!Number.isFinite(n) || n <= 0) return 1;
  return Math.max(1, Math.ceil(n));
};

const normalizeWhoInput = (who) => {
  const parts = String(who || '').split(/[\/,&;+]+/).map(s => s.trim()).filter(Boolean);
  return parts.length ? parts.join(' / ') : 'Sanitor';
};

const bytesToBase64 = (bytes) => {
  let binary = '';
  const len = bytes.byteLength;
  const chunk = 0x8000;
  for (let i = 0; i < len; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, Math.min(i + chunk, len)));
  }
  return btoa(binary);
};

const uploadPaperworkToLog = async (rowId, file) => {
  const webApi = getXrmWebApi();
  if (!rowId || !file || !webApi) return false;
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf);
  const fileName = safeString(file.name) || 'paperwork.jpg';
  const mimeType = file.type || mimeFromName(fileName) || 'application/octet-stream';
  const errors = [];

  if (webApi.online && typeof webApi.online.execute === 'function') {
    try {
      const exec = (req) => webApi.online.execute(req);
      const init = await readJson(await exec(xrmRequest('InitializeFileBlocksUpload', {
        Target: { '@odata.type': 'Microsoft.Dynamics.CRM.craa5__log_', craa5__log_id: rowId },
        FileAttributeName: LOG_FILE_COLUMN,
        FileName: fileName
      }, {
        Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 },
        FileAttributeName: EDM_STRING,
        FileName: EDM_STRING
      })));
      const token = init.FileContinuationToken;
      if (!token) throw new Error('No FileContinuationToken returned');
      const blockIds = [];
      for (let offset = 0; offset < bytes.byteLength; offset += PAPERWORK_CHUNK) {
        const slice = bytes.subarray(offset, Math.min(bytes.byteLength, offset + PAPERWORK_CHUNK));
        const blockId = btoa('blk-' + String(offset).padStart(10, '0'));
        blockIds.push(blockId);
        await exec(xrmRequest('UploadBlock', {
          BlockId: blockId,
          BlockData: bytesToBase64(slice),
          FileContinuationToken: token
        }, {
          BlockId: EDM_STRING,
          BlockData: EDM_STRING,
          FileContinuationToken: EDM_STRING
        }));
      }
      await exec(xrmRequest('CommitFileBlocksUpload', {
        FileName: fileName,
        MimeType: mimeType,
        BlockList: blockIds,
        FileContinuationToken: token
      }, {
        FileName: EDM_STRING,
        MimeType: EDM_STRING,
        BlockList: { typeName: 'Collection(Edm.String)', structuralProperty: 4 },
        FileContinuationToken: EDM_STRING
      }));
      pushDevLog('FILE', 'craa5__log_', `Uploaded paperwork ${fileName} (${bytes.byteLength} bytes)`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return true;
    } catch (err) {
      errors.push(String(err && err.message || err));
    }
  }

  if (typeof fetch === 'function' && clientUrl()) {
    try {
      const url = `${clientUrl()}/api/data/v9.2/craa5__log_s(${rowId})/${LOG_FILE_COLUMN}`;
      const res = await fetch(url, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/octet-stream',
          'x-ms-file-name': encodeURIComponent(fileName),
          'OData-MaxVersion': '4.0',
          'OData-Version': '4.0'
        },
        body: buf
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      pushDevLog('FILE', 'craa5__log_', `Uploaded paperwork via HTTP ${fileName}`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return true;
    } catch (err) {
      errors.push(String(err && err.message || err));
    }
  }

  const msg = errors.join(' - ') || 'Paperwork upload unavailable';
  pushDevLog('ERROR', 'craa5__log_', `Paperwork upload failed (${fileName})`, 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, msg);
  throw new Error(msg);
};

// Creates a completion or skip log row in craa5__log_ using the exact MSS Log Input schema and adaptive fallback
const createCalendarLogEntry = async ({ asset, dateStr, cleanCode, sapCode, cleanedBy, hours, file, skipMeta }) => {
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const assetId = getAssetId(asset);
  const equipName = safeString(getProp(asset, 'craa5_equipmentidentifier')) || 'Equipment';
  const roomName = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
  const areaName = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
  const whoRaw = normalizeWhoInput(cleanedBy);
  const skipCodeVal = skipMeta && skipMeta.skipCode ? String(skipMeta.skipCode).trim() : '';
  const skipNoteVal = skipMeta && skipMeta.skipNote ? String(skipMeta.skipNote).trim() : '';
  const who = skipCodeVal ? `SKIPPED (${skipCodeVal}) - ${whoRaw}${skipNoteVal ? ' - ' + skipNoteVal : ''}`.slice(0, 140) : whoRaw;
  const skipToken = skipCodeVal ? `SKIP:${skipCodeVal}:${skipNoteVal}`.slice(0, 100) : '';
  const intHours = skipCodeVal ? 0 : sanitizeHoursInt32(hours);
  const flags = skipCodeVal
    ? { craa5_daily: false, craa5_weekly: false, craa5_monthly: false }
    : inferCleanKindFlags(cleanCode);
  const sapMap = getAssetSapMap(asset);
  const resolvedSap = normalizeSapCode(sapCode || sapMap[cleanCode] || sapMap.D || '');
  const uid = 'MSS-' + Date.now().toString(36).toUpperCase();

  const basePayload = {
    craa5_equipment: equipName,
    craa5_lastcleaned: `${dateStr}T00:00:00Z`,
    craa5_lastcleanedby: who,
    craa5_nameofemployee: whoRaw,
    craa5_uid: uid
  };
  if (assetId && !missingLogColumns.has(LOG_ASSET_ID_SELECT)) basePayload[LOG_ASSET_ID_SELECT] = assetId;
  if (!missingLogColumns.has('craa5_room')) basePayload.craa5_room = roomName;
  if (!missingLogColumns.has('craa5_area')) basePayload.craa5_area = areaName;
  if (resolvedSap && !missingLogColumns.has('craa5_sap')) basePayload.craa5_sap = resolvedSap;
  if (!missingLogColumns.has('craa5_hoursworked')) basePayload.craa5_hoursworked = intHours;
  if (skipToken && !missingLogColumns.has('craa5_idofssop')) basePayload.craa5_idofssop = skipToken;
  if (skipToken && !missingLogColumns.has('craa5_bundle')) basePayload.craa5_bundle = skipToken;
  LOG_TYPE_COLUMNS.forEach(col => {
    if (!missingLogColumns.has(col)) basePayload[col] = flags[col];
  });

  let createdId = 'local-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7);
  let fileUploaded = false;
  const webApi = getXrmWebApi();

  if (webApi && typeof webApi.createRecord === 'function') {
    let payload = Object.assign({}, basePayload);
    for (let attempt = 0; attempt < 4; attempt++) {
      try {
        const res = await webApi.createRecord('craa5__log_', payload);
        createdId = normalizeId(res && res.id) || createdId;
        break;
      } catch (err) {
        if (attempt < 3 && isMissingColumnError(err)) {
          const msg = String(err && err.message || '');
          const optionalKeys = ['craa5_idofssop', 'craa5_bundle', 'craa5_daily', 'craa5_weekly', 'craa5_monthly', 'craa5_room', 'craa5_area', 'craa5_sap', 'craa5_hoursworked', LOG_ASSET_ID_SELECT];
          let dropped = false;
          optionalKeys.forEach(k => {
            if (payload[k] !== undefined && new RegExp(`\\b${k}\\b`, 'i').test(msg)) {
              delete payload[k];
              missingLogColumns.add(k);
              dropped = true;
            }
          });
          if (!dropped) {
            if (payload.craa5_idofssop !== undefined || payload.craa5_bundle !== undefined) {
              delete payload.craa5_idofssop;
              delete payload.craa5_bundle;
            } else {
              ['craa5_daily', 'craa5_weekly', 'craa5_monthly'].forEach(k => { delete payload[k]; });
            }
          }
          continue;
        }
        pushDevLog('ERROR', 'craa5__log_', `Failed creating log for ${equipName} on ${dateStr}`, 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, String(err && err.message || err));
        throw err;
      }
    }
    if (file && isGuid(createdId)) {
      fileUploaded = await uploadPaperworkToLog(createdId, file);
    }
  }

  const localRecord = Object.assign({}, basePayload, flags, {
    craa5__log_id: createdId,
    [LOG_ASSET_ID_SELECT]: assetId,
    craa5_lastcleaned: dateStr,
    craa5_hoursworked: intHours,
    craa5_sap: resolvedSap,
    craa5_skipcode: skipCodeVal || undefined,
    craa5_skipnote: skipNoteVal || undefined
  });
  if (file && (fileUploaded || !hasXrmConnection())) {
    localRecord[LOG_FILE_COLUMN] = createdId;
    localRecord[LOG_FILE_NAME_COLUMN] = file.name || 'paperwork.jpg';
  }

  const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
  pushDevLog('API-WRITE', 'craa5__log_', skipCodeVal ? `Logged skip (${skipCodeVal}) for ${equipName} (${dateStr})` : `Logged ${cleanCode} clean for ${equipName} (${dateStr}) by ${who}`, 'OK', ms, 1, `SAP: ${resolvedSap || 'N/A'}, Hours: ${intHours}`);
  if (!skipCodeVal) broadcastHubEvent({ type: 'LOG_CREATED', log: localRecord });
  return localRecord;
};

