// SHARED SETTINGS (data contract section 12): Hub config, one row per craa5_configkey (craa5_configname matches old rows with
// a blank key). Tables in HUB_CONFIG_TABLES order: the new _e_ Hub config keeps JSON in craa5_configjson; the old _0_ one in
// craa5_manifestjson (its craa5_configjson holds 100 characters). Empty JSON means "no settings yet". Saves go to the first
// table that reads; reads take the first row with JSON.
const HC_EXCLUSIONS_KEY = 'mss_completion_exclusions';
const HC_DOWNTIME_KEY = 'mss_line_downtime';
const hcJsonCol = (table) => (table === HUB_CONFIG_TABLES[0] ? 'craa5_configjson' : HUB_MANIFEST_COL);
const hcProbe = async (web, table, key) => {
  const cols = table === HUB_CONFIG_TABLES[0] ? 'craa5_configjson' : `${HUB_MANIFEST_COL},craa5_configjson`;
  const sel = `?$select=${table}id,craa5_configkey,${cols}&$top=1&$filter=statecode eq 0 and `;
  let res = await web.retrieveMultipleRecords(table, sel + `craa5_configkey eq '${key}'`);
  if (!(res && res.entities && res.entities[0])) res = await web.retrieveMultipleRecords(table, sel + `craa5_configname eq '${key}'`);
  return (res && res.entities && res.entities[0]) || null;
};
// -> { target: { table, row } (where a save goes) | null, source: row with JSON | null }
const hcFind = async (key) => {
  const web = getXrmWebApi();
  const out = { target: null, source: null };
  if (!web) return out;
  for (let i = 0; i < HUB_CONFIG_TABLES.length; i++) {
    const table = HUB_CONFIG_TABLES[i];
    let row = null;
    try { row = await hcProbe(web, table, key); } catch (e) { continue; }   // table not there (yet)
    if (!out.target) out.target = { table, row };
    if (row && !out.source && String(hubConfigJsonOf(row)).trim()) out.source = row;
    if (out.source) break;
  }
  return out;
};
const hcRead = async (key) => {
  const f = await hcFind(key);
  if (!f.source) return { found: false, value: null };
  try { return { found: true, value: JSON.parse(hubConfigJsonOf(f.source)) }; } catch (e) { return { found: true, value: null }; }
};
const hcWrite = async (key, value, extra) => {
  const web = getXrmWebApi();
  if (!web) throw new Error('Not connected to Dataverse');
  const f = await hcFind(key);
  if (!f.target) throw new Error('No hub config table can be read');
  const table = f.target.table, row = f.target.row;
  const payload = Object.assign({ craa5_configkey: key, craa5_configname: key }, table === HUB_CONFIG_TABLES[0] ? {} : { craa5_scope: 'PlantWide' }, extra || {});
  payload[hcJsonCol(table)] = JSON.stringify(value);
  const save = (body) => (row ? web.updateRecord(table, hubGuid(row[table + 'id']), body)
    : web.createRecord(table, Object.assign({}, body, { [table + 'id']: hubIdFromKey('hubconfig|' + key) })));
  try { await save(payload); }
  catch (e) {   // an optional column (scope, updated by) the table lacks: save the key, name and JSON alone
    const base = { craa5_configkey: key, craa5_configname: key };
    base[hcJsonCol(table)] = payload[hcJsonCol(table)];
    if (Object.keys(payload).length === Object.keys(base).length) throw e;
    await save(base);
  }
};
// Keeps one setting in step with its Dataverse row: read once when the page opens (unless it was already changed here), written
// shortly after every change. -> 'offline' | 'loading' | 'shared' | 'saving' | 'failed'
function useSharedConfig(key, value, setValue, clean, serialize) {
  const [state, setState] = useState(() => (hasXrmConnection() ? 'loading' : 'offline'));
  const valueRef = useRef(value);
  valueRef.current = value;
  const loaded = useRef(false), skip = useRef(false), dirty = useRef(false), first = useRef(true), timer = useRef(null);
  const push = useCallback(() => {
    if (timer.current) clearTimeout(timer.current);
    timer.current = setTimeout(() => {
      setState('saving');
      hcWrite(key, serialize(valueRef.current)).then(() => setState('shared'), () => setState('failed'));
    }, 800);
  }, [key, serialize]);
  useEffect(() => {
    if (!hasXrmConnection()) return undefined;
    let off = false;
    hcRead(key).then((r) => {
      if (off) return;
      loaded.current = true;
      if (dirty.current) { push(); return; }
      if (r.found && r.value) { skip.current = true; setValue(clean(r.value)); }
      setState('shared');
    }, () => { if (!off) { loaded.current = true; setState('failed'); } });
    return () => { off = true; };
    // eslint-disable-next-line
  }, []);
  useEffect(() => {
    if (first.current) { first.current = false; return; }
    if (skip.current) { skip.current = false; return; }
    if (!hasXrmConnection()) return;
    dirty.current = true;
    if (loaded.current) push();
    // eslint-disable-next-line
  }, [value]);
  useEffect(() => () => { if (timer.current) clearTimeout(timer.current); }, []);
  return state;
}
