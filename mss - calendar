    const webApi = getXrmWebApi();
    if (webApi && typeof webApi.retrieveMultipleRecords === 'function') {
      (async () => {
        try {
          const jsonStr = JSON.stringify(next);
          let res = null;
          try {
            res = await webApi.retrieveMultipleRecords(HUB_CONFIG_TABLE, "?$select=craa5__0_hubconfigid&$filter=craa5_configkey eq 'MSS_LOG_ACCESS_LOG' or craa5_configname eq 'MSS_LOG_ACCESS_LOG'&$top=1");
          } catch (_) {
            res = await webApi.retrieveMultipleRecords(HUB_CONFIG_TABLE, "?$filter=craa5_configname eq 'MSS_LOG_ACCESS_LOG'&$top=1");
          }
          const existingId = res && res.entities && res.entities[0] ? res.entities[0].craa5__0_hubconfigid : null;
          const payload = {
            craa5_configkey: 'MSS_LOG_ACCESS_LOG',
            craa5_configname: 'MSS_LOG_ACCESS_LOG',
            craa5_configjson: jsonStr,
            craa5_scope: 'PlantWide',
            craa5_updatedby: safeString(identity.userName || identity.microsoftId || 'MSS Calendar')
          };
          if (existingId) await webApi.updateRecord(HUB_CONFIG_TABLE, existingId, payload);
          else await webApi.createRecord(HUB_CONFIG_TABLE, payload);
        } catch (_) { /* ignore optional hubconfig telemetry error */ }
      })();
    }
    return next;
  } catch (_) {
    return [];
  }
};

