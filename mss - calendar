// The progress bar beside a room or area name, by the done-or-blank method: an equipment is cleaned when any day on
// screen has a log for it, missed when every month on screen has been read and none has, not read otherwise.
// Green check: everything read was cleaned; yellow check: some cleaned, some missed; red: nothing cleaned; grey: not
// read yet. Read loads the months on screen not read yet for every equipment that still has one (a cleaned equipment
// can still have an unread month on screen), without opening the area.
const GroupBar = React.memo(({ g, months, busy, canRead, onRead }) => {
  if (!g || !g.total) return null;
  const counted = g.total - g.unreadable;
  const parts = [`${g.cleaned} of ${counted} cleaned`];
  if (g.missed) parts.push(`${g.missed} missed`);
  if (g.unread) parts.push(`${g.unread} not read`);
  if (g.unreadable) parts.push(`${g.unreadable} cannot be read (no name, and the log has no id column)`);
  const pct = (n) => counted ? `${Math.round(100 * n / counted)}%` : '0%';
  const title = [
    `${parts.join(' - ')} - ${months}`,
    g.state === 'ok' ? 'Everything read so far was cleaned in the months on screen.' : g.state === 'partial' ? 'Some equipment was cleaned, some was missed.' : g.state === 'missed' ? 'Nothing read so far was cleaned in the months on screen.' : 'The log has not been read for this equipment yet.',
    'Cleaned: a log on at least one day on screen. Missed: every month on screen read, no log. Not read: open the area or press Read.',
    g.needsVisible.length ? `Read: loads the months on screen not read yet for ${g.needsVisible.length} equipment (a cleaned equipment can still have an unread month on screen), without opening the area.` : ''
  ].filter(Boolean).join('\n');
  return (
    <span className={`group-bar ${g.state}`} data-testid="group-bar" data-state={g.state} title={title}>
      {g.state === 'missed' ? <AlertIcon /> : g.state === 'unknown' ? <ClockIcon /> : <CheckIcon />}
      <span className="group-text">{g.cleaned}/{counted}</span>
      {counted > 0 && <span className="group-meter"><i style={{ width: pct(g.cleaned), background: BRAND.green }} /><i style={{ width: pct(g.missed), background: BRAND.red }} /></span>}
      {canRead && g.needsVisible.length > 0 && <button className="group-read" disabled={busy} onClick={(e) => { e.stopPropagation(); onRead(g.needsVisible); }}>{busy ? 'Reading...' : `Read ${g.needsVisible.length}`}</button>}
    </span>
  );
});

// The timeline of a room or area row: a check on every day on which any of its equipment was cleaned, blank otherwise.
// A row with nothing checked is one strip (gridlines and the today stripe drawn by CSS), not a cell per day: with every
// room and area on the page this is rows x days elements, and every layout pays for them. The row shows presence only,
// so it is left alone while the same dates are checked, although groupStatus rebuilds its object on every flush.
const sameDays = (a, b) => {
  if (a === b) return true;
  const ka = a ? Object.keys(a.days) : [], kb = b ? Object.keys(b.days) : [];
  return ka.length === kb.length && ka.every(d => !!b.days[d]);
};
const GroupDays = React.memo(({ g, groupKey, timelineDays, dayColWidth, onEnter, onLeave }) => {
  if (!g || !Object.keys(g.days).length) {
    let ti = -1;
    timelineDays.forEach((d, i) => { if (d.isToday) ti = i; });
    return (
      <div className="data-cells group-strip" style={{ width: timelineDays.length * dayColWidth, backgroundSize: `${dayColWidth}px 100%` }}>
        {ti >= 0 && <div className="group-strip-today" style={{ left: ti * dayColWidth, width: dayColWidth }} />}
      </div>
    );
  }
  return (
    <div className="data-cells">
      {timelineDays.map((d, di) => {
        const n = g.days[d.dateStr];
        return (
          <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}>
            {n ? <div className="group-day" data-testid="group-day" onMouseEnter={() => onEnter(groupKey, d.dateStr)} onMouseLeave={onLeave}><CheckIcon /></div> : <div className="marker-empty" />}
          </div>
        );
      })}
    </div>
  );
}, (p, q) => p.groupKey === q.groupKey && p.timelineDays === q.timelineDays && p.dayColWidth === q.dayColWidth && p.onEnter === q.onEnter && p.onLeave === q.onLeave && sameDays(p.g, q.g));

