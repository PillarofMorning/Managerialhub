          {rows.length > MISSED_PAGE && (
            <div className="area-pagination-bar comp-pager">
              <button type="button" className="page-btn" data-testid="comp-prev" disabled={pageNow === 0} onClick={() => setPage(pageNow - 1)}>Prev {MISSED_PAGE}</button>
              <span style={{ fontSize: '10px' }} data-testid="comp-range">Items {pageNow * MISSED_PAGE + 1} - {Math.min((pageNow + 1) * MISSED_PAGE, rows.length)} of {rows.length}</span>
