const buildCalendarDataversePrompt = (tableScope, promptMode, selectedTableId, missingColsList) => {
  const tables = tableScope === 'selected'
    ? MSS_CALENDAR_TABLE_BLUEPRINTS.filter(t => t.id === selectedTableId)
    : MSS_CALENDAR_TABLE_BLUEPRINTS;

  const header = [
    'You are a Microsoft Power Platform & Dataverse Senior Architect.',
    'I am configuring the Dataverse backend for the CJ Schwan\'s Master Sanitation Schedule (MSS Calendar & MSS Log Input) ecosystem.',
    'Publisher Prefix: craa5_',
    tableScope === 'missing_only' && missingColsList.length
      ? `Focus specifically on provisioning these currently missing columns detected by our live schema checker: ${missingColsList.join(', ')}.`
      : `Target Scope: ${tables.map(t => `${t.displayName} (${t.logicalName})`).join(', ')}.`,
    ''
  ].join('\n');

  const schemaBlock = tables.map(t => {
    const cols = t.columns.map(c => `  - ${c.name} (${c.displayName}) | Type: ${c.type} | Required: ${c.required ? 'Yes' : 'No'} | Status: ${c.status} | Purpose: ${c.notes}`).join('\n');
    return `Table: ${t.displayName}\nLogical Name: ${t.logicalName} | EntitySetName: ${t.entitySetName}\nPrimary Name Column: ${t.primaryNameColumn}\nPurpose: ${t.purpose}\nColumns:\n${cols}`;
  }).join('\n\n');

  if (promptMode === 'powerfx') {
    return [
      header,
      'Please generate ready-to-paste Power Fx formulas (Patch, LookUp, Filter, Collect) for Canvas Apps / Custom Pages using these exact Dataverse logical names:',
      '1. Loading the equipment catalog (craa5_aa_assets) and checking frequency booleans (craa5_dailyclean, craa5_midweek, craa5_weeklyclean, craa5_monthlyclean, craa5_quarterly, craa5_annually).',
      '2. Patching a completed sanitation clean to craa5__log_ with craa5_equipmentguid set to craa5_aa_assetsid, craa5_hoursworked rounded up with RoundUp( hours, 0 ) as Whole Number, and rollup flags (craa5_daily, craa5_weekly, craa5_monthly).',
      '3. Querying production schedule runs (craa5__aa_prd_schd) to determine line downtime windows.',
      '',
      schemaBlock
    ].join('\n');
  }

  if (promptMode === 'webapi') {
    return [
      header,
      'Please generate:',
      '1. Dataverse Web API (OData v9.2) EntityMetadata & AttributeMetadata JSON payloads to create any missing tables and columns non-destructively.',
      '2. A PowerShell script using Invoke-RestMethod against /api/data/v9.2/EntityDefinitions to provision missing columns safely.',
      '3. Sample Xrm.WebApi.retrieveMultipleRecords and Xrm.WebApi.createRecord calls matching the schema below.',
      '',
      schemaBlock
    ].join('\n');
  }

  return [
    header,
    'Please provide a clear, beginner-friendly, step-by-step guide in make.powerapps.com (plus optional pac CLI commands) to verify and create these tables and columns without losing any existing production data:',
    '1. Exact navigation steps in Power Apps Maker Portal (Tables -> + New table / Columns -> + New column).',
    '2. Exact Data Type selections (especially Whole Number for craa5_hoursworked, File for craa5_pictureorfileofpaperwork, and Yes/No for frequency columns).',
    '3. Security role privileges needed for Sanitors (Read Assets/Plan, Create/Read/Write/Append Logs) and Supervisors (Write Assets frequencies and Hub Config).',
    '',
