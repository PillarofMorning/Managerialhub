const ES_MX_PATTERNS = [
  [/^Dataverse Live - (\d+) Equipment$/i, 'Dataverse en Vivo - $1 Equipos'],
  [/^Not connected - (\d+) Equipment$/i, 'Sin conexion - $1 Equipos'],
  [/^View: (.+)$/i, 'Vista: $1'],
