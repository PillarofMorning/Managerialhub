                              <td style={{ padding: '4px 12px 4px 0' }}>{safeString(getProp(r.l, 'craa5_equipment')) || '(blank)'}</td>
                              <td style={{ padding: '4px 12px 4px 0', fontFamily: 'monospace' }}>{r.id || '—'}</td>
                              <td style={{ padding: '4px 12px 4px 0', color: r.asset ? '#047857' : '#b45309' }}>{r.asset ? `${safeString(getProp(r.asset, 'craa5_equipmentidentifier'))} (${safeString(getProp(r.asset, 'craa5_roomname'))} / ${safeString(getProp(r.asset, 'craa5_areaname'))})` : r.state}</td>
                            </tr>
                          ))}</tbody>
                        </table>
                      </div>
                    )}
                  </div>
                )}
                {typeof Xrm !== 'undefined' && assets.length > 0 && (
                  <div data-testid="lookup-check" style={{ marginTop: '16px', paddingTop: '12px', borderTop: '1px solid #e2e8f0' }}>
                    <h3>Equipment lookup</h3>
                    <p style={{ color: '#64748b' }}>Pick one equipment to see the log rows stored against its id and, separately, rows that carry its name.</p>
                    <input style={{ border: '1px solid #cbd5e1', borderRadius: '6px', padding: '6px 10px', fontSize: '12px', width: '280px' }} placeholder="Type an equipment name…" value={lookupQuery} onChange={e => setLookupQuery(e.target.value)} />
                    {lookupQuery.trim().length >= 2 && (
                      <div style={{ marginTop: '6px', display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
                        {assets.filter(a => safeString(getProp(a, 'craa5_equipmentidentifier')).toLowerCase().includes(lookupQuery.trim().toLowerCase())).slice(0, 8).map(a => (
                          <button key={getAssetId(a)} className="page-btn" onClick={() => { setLookupQuery(''); runLookup(a); }}>{safeString(getProp(a, 'craa5_equipmentidentifier'))} · {safeString(getProp(a, 'craa5_roomname'))} / {safeString(getProp(a, 'craa5_areaname'))}</button>
                        ))}
                      </div>
                    )}
                    {lookup && (
                      <div style={{ marginTop: '10px' }}>
                        <p><b>{lookup.name}</b>{lookup.room ? ` · ${lookup.room} / ${lookup.area}` : ''} · equipment id <span style={{ fontFamily: 'monospace' }}>{lookup.id}</span>{lookup.busy ? ' · reading…' : ''}</p>
                        {[['By equipment id', lookup.byId], ['Same query the matrix sends (' + (lookup.byMatrix && lookup.byMatrix.months || 'months on screen') + ')', lookup.byMatrix], ['By equipment name', lookup.byName]].map(([label, r]) => r && (
                          <div key={label} style={{ marginBottom: '8px' }}>
                            <p>{label}: {r.skipped ? `not available (${r.skipped})` : r.error ? <span style={{ color: '#b91c1c' }}>failed: {r.error}</span> : `${r.rows.length}${r.capped && r.rows.length >= 25 ? '+' : ''} log row(s)`}</p>
                            {r.rows && r.rows.length > 0 && (
                              <table style={{ fontSize: '12px', borderCollapse: 'collapse' }}>
                                <tbody>{r.rows.slice(0, 8).map((l, i) => (
                                  <tr key={i}><td style={{ padding: '2px 12px 2px 0' }}>{normalizeDateStr(getRaw(l, 'craa5_lastcleaned'))}</td><td style={{ padding: '2px 12px 2px 0' }}>{safeString(getProp(l, 'craa5_equipment'))}</td><td style={{ padding: '2px 12px 2px 0' }}>{safeString(getProp(l, 'craa5_lastcleanedby'))}</td><td style={{ padding: '2px 12px 2px 0', fontFamily: 'monospace' }}>{normalizeId(getRaw(l, LOG_ASSET_ID_SELECT)) || 'no id'}</td></tr>
                                ))}</tbody>
                              </table>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}
                {completionIndex.unmapped.length > 0 && (
                  <table style={{ marginTop: '12px', fontSize: '12px', borderCollapse: 'collapse' }}>
                    <thead><tr><th style={{ textAlign: 'left', padding: '4px 12px 4px 0' }}>Unmapped equipment text</th><th style={{ textAlign: 'left', padding: '4px 12px' }}>Date</th><th style={{ textAlign: 'left', padding: '4px 12px' }}>UID</th></tr></thead>
                    <tbody>{completionIndex.unmapped.slice(0, 200).map((l, i) => (
                      <tr key={i}><td style={{ padding: '4px 12px 4px 0' }}>{safeString(getProp(l, 'craa5_equipment')) || '(blank)'}</td><td style={{ padding: '4px 12px' }}>{normalizeDateStr(getRaw(l, 'craa5_lastcleaned'))}</td><td style={{ padding: '4px 12px' }}>{safeString(l.craa5_uid)}</td></tr>
                    ))}</tbody>
                  </table>
                )}
             </div>
             <DvColumnsCard connected={typeof Xrm !== 'undefined'} assetsRead={assets.length > 0} logsRead={loadedRef.current.size > 0 || logs.length > 0} planRead={!!plan.data} idColumn={idColumn} />
          </main>
        ) : activeTab === 'downtime' ? (
          <LineDowntimeTab assets={assets} lines={downtime.lines} setLines={downtime.setLines} saved={downtime.saved} plan={plan} planYear={anchorYear} planModel={planModel} rules={lineRules} onReadPlan={() => readPlan(anchorYear)} />
        ) : (
          <main className="matrix-outer-container">
            <div className="viewport">
              <div className="header-row">
                <div className="frozen-column-group corner"><div className="corner-top"><span>FACILITY HIERARCHY</span><span className="corner-legend">D daily · MW mid-week · W weekly · M monthly<br />Q quarterly · A annual · red letter: overdue · dotted: not read yet<br />✓ on a room or area: cleaned that day{fullMode && ' · n / m: not done / due'}</span></div>{fullMode && <><div className="corner-pct" title="Daily jobs done that day, as a percentage of the daily jobs due (blank: none could be judged yet)">DONE % · DAY</div><div className="corner-pct cnt" title="Daily jobs scheduled that day that were not done (blank: none could be judged yet)">NOT DONE · DAY</div><div className="corner-pct" title="On every Sunday: the jobs of that Monday-to-Sunday week done, as a percentage of the jobs due (the daily jobs of each day and the mid-week and weekly ones)">DONE % · WEEK (SUNDAY)</div><div className="corner-pct last cnt" title="On every Sunday: the jobs of that Monday-to-Sunday week that were not done (the daily jobs of each day and the mid-week and weekly ones)">NOT DONE · WEEK (SUNDAY)</div></>}</div>
                <div className="header-blocks">
                  <div className="month-tier">{monthSpans.map((m, i) => (<div key={i} className="cell-month" style={{ width: m.count * dayColWidth }}>{m.month}</div>))}</div>
                  <div className="week-tier">{weekSpans.map((w, i) => (<div key={i} className="cell-week" style={{ width: w.count * dayColWidth }}>W{w.week}</div>))}</div>
                  <div className="day-tier">{timelineDays.map((d, i) => (<div key={i} className="cell-day" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}><span>{d.label}</span></div>))}</div>
                  {pctCells && <PctTier cells={pctCells.dayCells} dayColWidth={dayColWidth} testid="pct-day" />}
                  {pctCells && <PctTier cells={pctCells.dayNot} dayColWidth={dayColWidth} testid="pct-day-notdone" slim />}
                  {pctCells && <PctTier cells={pctCells.weekCells} dayColWidth={dayColWidth} testid="pct-week" />}
                  {pctCells && <PctTier cells={pctCells.weekNot} dayColWidth={dayColWidth} testid="pct-week-notdone" slim last />}
                </div>
              </div>

              <div className="data-body">
                {pagedRoomKeys.map(room => (
                  <React.Fragment key={room}>
                    <div className="asset-row room-row">
                       <div className="frozen-labels" onClick={() => setExpandedKeys(p => ({...p, [room]: !p[room]}))}>
                          <div className="group-label">
                              <ChevronDownIcon style={{ transform: expandedKeys[room] ? '' : 'rotate(-90deg)', transition: '0.2s' }} />
                              <FolderIcon color={BRAND.blueDark} />
                              <GroupName name={room} f={figureOf ? figureOf(room) : null} months={monthsLabel} />
                          </div>
                          <GroupBar {...barProps(room)} />
                          <span className="scope-action-icon" onClick={(e) => { e.stopPropagation(); openScopedModal('room', room); }} title="Expand Focused Dialog"><MaximizeIcon /></span>
                       </div>
                       <GroupDays g={groupStatus[room]} groupKey={room} timelineDays={timelineDays} dayColWidth={dayColWidth} onEnter={hoverGroupDay} onLeave={leaveGroupDay} />
                    </div>
                    {expandedKeys[room] && Object.keys(filteredTreeData[room]).map(area => {
                      const ak = `${room}|${area}`;
                      const areaEquipment = filteredTreeData[room][area];
                      const areaPageIndex = pageOf(areaPages, ak, areaEquipment.length, equipmentPageSize);
                      const areaTotalPages = Math.ceil(areaEquipment.length / equipmentPageSize);
                      const pagedEquipment = areaEquipment.slice(areaPageIndex * equipmentPageSize, (areaPageIndex + 1) * equipmentPageSize);

                      return (
                        <React.Fragment key={ak}>
                          <div className="asset-row area-row">
                             <div className="frozen-labels" style={{ paddingLeft: '30px' }} onClick={() => setExpandedKeys(p => ({...p, [ak]: !p[ak]}))}>
                                <div className="group-label">
                                    <ChevronDownIcon style={{ transform: expandedKeys[ak] ? '' : 'rotate(-90deg)', transition: '0.2s' }} />
                                    <FolderIcon color={BRAND.green} />
                                    <GroupName name={area} f={figureOf ? figureOf(room, area) : null} months={monthsLabel} />
                                </div>
                                <GroupBar {...barProps(ak)} />
                                <span className="scope-action-icon" onClick={(e) => { e.stopPropagation(); openScopedModal('area', area); }} title="Expand Focused Dialog"><MaximizeIcon /></span>
                             </div>
                             <GroupDays g={groupStatus[ak]} groupKey={ak} timelineDays={timelineDays} dayColWidth={dayColWidth} onEnter={hoverGroupDay} onLeave={leaveGroupDay} />
                          </div>
                          {expandedKeys[ak] && (
                            <>
                              {pagedEquipment.map(asset => {
                                const name = safeString(getProp(asset, 'craa5_equipmentidentifier'));
                                const rowLogs = rowLogsFor(asset);
                                const st = freqStatus.get(getAssetId(asset));
                                return (
                                  <div key={asset.craa5_aa_assetsid} className={`asset-row${st && st.state === 'overdue' ? ' row-overdue' : ''}`}>
                                    <div className="frozen-labels" style={{ paddingLeft: '60px' }}><div className="eq-label"><FileIcon /><span className="eq-name" title={name}>{name}</span><FreqMedallion st={st} /></div></div>
                                    <div className="data-cells">
                                      {timelineDays.map((d, di) => {
                                        const match = rowLogs && rowLogs.get(d.dateStr);
                                        return (
                                          <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}>
                                            {match ? <div className={`marker${match.via === 'text' ? ' marker-text' : ''}${match.file ? ' marker-file' : ''}`} data-testid={match.file ? 'marker-file' : undefined} tabIndex={match.file ? 0 : undefined} role={match.file ? 'button' : undefined} onKeyDown={match.file ? (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPaperwork(match); } } : undefined} onMouseEnter={(e) => { hoveredMarkerRef.current = e.currentTarget; setHoveredLog(match); }} onMouseLeave={() => { hoveredMarkerRef.current = null; setHoveredLog(null); }} onClick={match.file ? () => openPaperwork(match) : undefined}>{match.file ? <PaperclipIcon /> : null}</div> : <div className="marker-empty" />}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })}
                              
                              {/* PER-AREA PAGINATION BUTTONS */}
                              {areaTotalPages > 1 && (
                                <div className="area-pagination-bar">
                                   <button className="page-btn" disabled={areaPageIndex === 0} onClick={() => updateAreaPage(ak, -1)}>Prev 10</button>
                                   <span style={{ fontSize: '10px' }}>Items {(areaPageIndex * 10) + 1} - {Math.min((areaPageIndex + 1) * 10, areaEquipment.length)} of {areaEquipment.length}</span>
                                   <button className="page-btn" disabled={areaPageIndex >= areaTotalPages - 1} onClick={() => updateAreaPage(ak, 1)}>Next 10</button>
                                </div>
                              )}
                            </>
                          )}
                        </React.Fragment>
                      );
                    })}
                  </React.Fragment>
                ))}
              </div>
            </div>

            {/* MAIN ROOM PAGINATION BAR */}
            {totalPages > 1 && (
                <div className="pagination-bar">
                    <button className="page-btn" disabled={currentPage === 0} onClick={() => setCurrentPage(p => p - 1)}><ChevronLeftIcon /> Previous Page</button>
                    <span>Rooms {currentPage + 1} of {totalPages}</span>
                    <button className="page-btn" disabled={currentPage >= totalPages - 1} onClick={() => setCurrentPage(p => p + 1)}>Next Page <ChevronRightLargeIcon /></button>
                </div>
            )}
          </main>
        )}
      </div>
    </div>
  );
}
