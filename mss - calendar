const translateTextToEsMx = (raw) => {
  if (!raw || typeof raw !== 'string') return raw;
  const trimmed = raw.trim();
  if (!trimmed) return raw;
  // The ecosystem's shared words (HUB_ES, data contract section 9) win, so every app says Done, Area or Daily the same way
  const shared = hubT(trimmed, 'es');
  if (shared !== trimmed) {
    const lead = raw.match(/^\s*/)[0];
    const trail = raw.match(/\s*$/)[0];
    return lead + shared + trail;
  }
  if (ES_MX_EXACT[trimmed]) {
    const lead = raw.match(/^\s*/)[0];
    const trail = raw.match(/\s*$/)[0];
    return lead + ES_MX_EXACT[trimmed] + trail;
  }
  for (let i = 0; i < ES_MX_PATTERNS.length; i++) {
    const [re, rep] = ES_MX_PATTERNS[i];
    if (re.test(trimmed)) {
      const lead = raw.match(/^\s*/)[0];
      const trail = raw.match(/\s*$/)[0];
      return lead + trimmed.replace(re, rep) + trail;
    }
  }
  return raw;
};

const applyDomTranslation = (rootEl, lang) => {
  if (!rootEl || typeof document === 'undefined') return;
  try {
    const walker = document.createTreeWalker(rootEl, NodeFilter.SHOW_TEXT, null, false);
    let node = walker.nextNode();
    while (node) {
      const parent = node.parentElement;
      if (parent && parent.tagName !== 'SCRIPT' && parent.tagName !== 'STYLE' && parent.tagName !== 'CODE' && !parent.hasAttribute('data-no-translate')) {
        // React reuses text nodes: a value that is neither the cached English nor what was last written here is new English
        if (node._origEnText === undefined || (node.nodeValue !== node._origEnText && node.nodeValue !== node._lastSetText)) {
          node._origEnText = node.nodeValue;
        }
        const targetVal = lang === 'es' ? translateTextToEsMx(node._origEnText) : node._origEnText;
        if (node.nodeValue !== targetVal) {
          node.nodeValue = targetVal;
        }
        node._lastSetText = targetVal;
      }
      node = walker.nextNode();
    }
    const inputs = rootEl.querySelectorAll('input[placeholder], textarea[placeholder]');
    inputs.forEach(inp => {
      const ph = inp.getAttribute('placeholder') || '';
      if (inp._origPlaceholder === undefined || (ph !== inp._origPlaceholder && ph !== inp._lastSetPh)) {
        inp._origPlaceholder = ph;
      }
      const targetPh = lang === 'es' ? translateTextToEsMx(inp._origPlaceholder) : inp._origPlaceholder;
      if (ph !== targetPh) {
        inp.setAttribute('placeholder', targetPh);
      }
      inp._lastSetPh = targetPh;
    });
  } catch (_) { /* ignore DOM walk errors */ }
};

// Cross-frame Dataverse Xrm & Xrm.WebApi resolver (supports direct host, parent frame, and top frame in Power Apps).
const getXrm = () => {
  try {
    if (typeof window !== 'undefined') {
      if (window.Xrm && window.Xrm.WebApi) return window.Xrm;
      if (window.parent && window.parent !== window && window.parent.Xrm && window.parent.Xrm.WebApi) return window.parent.Xrm;
      if (window.top && window.top !== window && window.top.Xrm && window.top.Xrm.WebApi) return window.top.Xrm;
      if (window.Xrm) return window.Xrm;
      if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm;
      if (window.top && window.top !== window && window.top.Xrm) return window.top.Xrm;
    }
    if (typeof Xrm !== 'undefined') return Xrm;
  } catch (_) { /* cross-origin frame access ignored */ }
  return undefined;
};
const getXrmWebApi = () => {
  const xrm = getXrm();
  return xrm && xrm.WebApi ? xrm.WebApi : null;
};
const hasXrmConnection = () => Boolean(getXrmWebApi());

