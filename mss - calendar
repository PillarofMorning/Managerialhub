function HowToManualTab({ onNavigateTab }) {
  const [mode, setMode] = useState('diagrams'); // 'diagrams' | 'walkthrough' | 'search'
  const [activeId, setActiveId] = useState(HOW_TO_MANUAL_SECTIONS[0].id);
  const [walkIdx, setWalkIdx] = useState(0);
  const [query, setQuery] = useState('');

  const activeSec = useMemo(
    () => HOW_TO_MANUAL_SECTIONS.find(s => s.id === activeId) || HOW_TO_MANUAL_SECTIONS[0],
    [activeId]
  );
  const walkSec = HOW_TO_MANUAL_SECTIONS[walkIdx] || HOW_TO_MANUAL_SECTIONS[0];

  const filteredSections = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return HOW_TO_MANUAL_SECTIONS;
    return HOW_TO_MANUAL_SECTIONS.filter(s => {
      const text = [s.title, s.badge, s.summary, s.keywords, s.proTip].concat(s.steps.map(st => st.title + ' ' + st.desc)).join(' ').toLowerCase();
      return text.indexOf(q) > -1;
    });
  }, [query]);

  return (
    <main className="comp-main" data-testid="manual-tab">
      <div className="comp-wrap">
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 12 }}>
