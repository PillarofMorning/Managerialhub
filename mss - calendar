                      <button type="button" className="page-btn" data-testid="drill-equipment" onClick={() => drill('equipment', r.kind === 'room' ? { room: r.room } : { room: r.room, area: r.area })}>Equipment</button>
                      {connected && partial && <button type="button" className="page-btn" data-testid="row-read" disabled={locked || reading} onClick={() => onReadIds(idsOf(r), metric)} title="Reads the months of this view for just this row's equipment">Read</button>}
                    </span>
                  )}
                  {r.kind === 'equipment' && (
                    <span className="comp-rowbtns">
                      {edited && <button type="button" className="sync-btn yellow" data-testid="comp-save-row" disabled={!connected || saving || locked} onClick={() => setConfirm(r.id)}>Save</button>}
                      {edited && <button type="button" className="page-btn" data-testid="comp-undo-row" disabled={saving} onClick={() => undo([r.id])}>Undo</button>}
