const loadEconParams = () => {
  try {
    const raw = localStorage.getItem(ECON_STORAGE_KEY);
    if (!raw) return { ...DEFAULT_ECON_PARAMS };
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object') return { ...DEFAULT_ECON_PARAMS };
    const out = { ...DEFAULT_ECON_PARAMS };
    Object.keys(DEFAULT_ECON_PARAMS).forEach(k => {
      const n = Number(parsed[k]);
      if (Number.isFinite(n) && n >= 0) out[k] = n;
    });
    return out;
  } catch (_) {
    return { ...DEFAULT_ECON_PARAMS };
  }
};

const saveEconParams = (params) => {
  try {
    localStorage.setItem(ECON_STORAGE_KEY, JSON.stringify(params));
