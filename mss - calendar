// ============================================================================
function HowToManualTab({ onNavigateTab }) {
  const [mode, setMode] = useState('diagrams'); // 'diagrams' | 'walkthrough' | 'search'
  const [activeId, setActiveId] = useState(HOW_TO_MANUAL_SECTIONS[0].id);
  const [walkIdx, setWalkIdx] = useState(0);
  const [query, setQuery] = useState('');

  const activeSec = useMemo(
    () => HOW_TO_MANUAL_SECTIONS.find(s => s.id === activeId) || HOW_TO_MANUAL_SECTIONS[0],
    [activeId]
  );
  const walkSec = HOW_TO_MANUAL_SECTIONS[walkIdx] || HOW_TO_MANUAL_SECTIONS[0];

  const filteredSections = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return HOW_TO_MANUAL_SECTIONS;
    return HOW_TO_MANUAL_SECTIONS.filter(s => {
      const text = [s.title, s.badge, s.summary, s.keywords, s.proTip].concat(s.steps.map(st => st.title + ' ' + st.desc)).join(' ').toLowerCase();
      return text.indexOf(q) > -1;
    });
  }, [query]);

  return (
    <main className="comp-main" data-testid="manual-tab">
      <div className="comp-wrap">
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 12 }}>
          <div>
            <h2 style={{ fontSize: 18, fontWeight: 900, margin: 0, color: BRAND.blueDark }}>Interactive User Manual &amp; SOP Guide</h2>
            <p className="dt-intro">Step-by-step visual guide for the MSS Calendar, Quick Log Clean modal, Completion KPIs, Line Downtime, and Dataverse tools.</p>
          </div>
          <div className="comp-seg" role="group" aria-label="Manual Mode">
            <button type="button" className={mode === 'diagrams' ? 'on' : ''} onClick={() => setMode('diagrams')}>1. Annotated Diagrams</button>
            <button type="button" className={mode === 'walkthrough' ? 'on' : ''} onClick={() => setMode('walkthrough')}>2. Guided Walkthrough</button>
            <button type="button" className={mode === 'search' ? 'on' : ''} onClick={() => setMode('search')}>3. Search &amp; FAQ</button>
          </div>
        </div>

        {mode === 'diagrams' && (
          <div style={{ display: 'grid', gridTemplateColumns: 'minmax(220px, 280px) 1fr', gap: 16, alignItems: 'start' }}>
            <div className="diag-card" style={{ padding: 12, display: 'flex', flexDirection: 'column', gap: 6 }}>
              <h3>Manual Topics</h3>
              {HOW_TO_MANUAL_SECTIONS.map(s => (
                <button
                  key={s.id}
                  type="button"
                  className={s.id === activeSec.id ? 'sync-btn' : 'page-btn'}
                  style={{ textAlign: 'left', justifyContent: 'flex-start', whiteSpace: 'normal', lineHeight: 1.3 }}
                  onClick={() => setActiveId(s.id)}
                >
                  {s.title}
                </button>
              ))}
            </div>
            <div className="diag-card" style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 8 }}>
                <div>
                  <span className="dt-src">{activeSec.badge}</span>
                  <h3 style={{ fontSize: 16, marginTop: 6, marginBottom: 0 }}>{activeSec.title}</h3>
                </div>
                <button type="button" className="sync-btn yellow" onClick={() => onNavigateTab(activeSec.tabTarget)}>Open This Tab Now</button>
              </div>
              <p className="dt-note">{activeSec.summary}</p>
              {renderCalendarManualSvg(activeSec.id)}
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: 10 }}>
                {activeSec.steps.map(st => (
                  <div key={st.num} style={{ padding: 12, borderRadius: 10, border: '1px solid #e2e8f0', background: '#f8fafc' }}>
                    <div style={{ fontSize: 11, fontWeight: 900, color: BRAND.blue }}>STEP {st.num}: {st.title}</div>
                    <p style={{ margin: '6px 0 0', fontSize: 12, color: '#334155', lineHeight: 1.45 }}>{st.desc}</p>
                  </div>
                ))}
              </div>
              <div style={{ padding: '10px 14px', borderRadius: 8, background: BRAND.yellowSoft, borderLeft: `4px solid ${BRAND.yellow}`, fontSize: 12, color: '#1e293b' }}>
                <b>Pro Tip:</b> {activeSec.proTip}
              </div>
            </div>
          </div>
        )}

        {mode === 'walkthrough' && (
          <div className="diag-card" style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 10 }}>
              <span className="dt-src">Guided Step {walkIdx + 1} of {HOW_TO_MANUAL_SECTIONS.length}</span>
              <div style={{ display: 'flex', gap: 8 }}>
                <button type="button" className="page-btn" disabled={walkIdx === 0} onClick={() => setWalkIdx(i => Math.max(0, i - 1))}>Previous</button>
                <button type="button" className="page-btn" disabled={walkIdx >= HOW_TO_MANUAL_SECTIONS.length - 1} onClick={() => setWalkIdx(i => Math.min(HOW_TO_MANUAL_SECTIONS.length - 1, i + 1))}>Next</button>
                <button type="button" className="sync-btn yellow" onClick={() => onNavigateTab(walkSec.tabTarget)}>Try It Now</button>
              </div>
            </div>
            <h3 style={{ fontSize: 16, margin: 0 }}>{walkSec.title}</h3>
            <p className="dt-note">{walkSec.summary}</p>
            {renderCalendarManualSvg(walkSec.id)}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {walkSec.steps.map(st => (
                <div key={st.num} style={{ padding: '8px 12px', borderRadius: 8, background: '#f8fafc', border: '1px solid #e2e8f0', fontSize: 12 }}>
                  <b>{st.num}. {st.title}:</b> {st.desc}
                </div>
              ))}
            </div>
          </div>
        )}

        {mode === 'search' && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
            <div className="diag-card">
              <label className="dt-field">
                <span>Search Manual Steps, Keywords &amp; Troubleshooting</span>
                <input value={query} onChange={e => setQuery(e.target.value)} placeholder="Type a keyword (e.g. overdue, sap, paperwork, hours, downtime, custom view)..." />
              </label>
              <div style={{ marginTop: 12, display: 'flex', flexDirection: 'column', gap: 10 }}>
                {filteredSections.map(s => (
                  <div key={s.id} style={{ padding: 12, borderRadius: 10, border: '1px solid #e2e8f0', background: '#f8fafc' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                      <b style={{ color: BRAND.blueDark, fontSize: 13 }}>{s.title}</b>
                      <button type="button" className="page-btn" onClick={() => onNavigateTab(s.tabTarget)}>Open Tab</button>
                    </div>
                    <p style={{ margin: '4px 0 8px', fontSize: 12, color: '#475569' }}>{s.summary}</p>
                    <div style={{ fontSize: 11, color: '#1e293b' }}><b>Pro Tip:</b> {s.proTip}</div>
                  </div>
                ))}
              </div>
            </div>

            <div className="diag-card">
              <h3>Troubleshooting &amp; Common Plant Questions</h3>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: 12, marginTop: 10 }}>
                {MANUAL_FAQ_ITEMS.map((item, idx) => (
                  <div key={idx} style={{ padding: 12, borderRadius: 8, border: '1px solid #e2e8f0', background: '#fff' }}>
                    <b style={{ fontSize: 12, color: BRAND.blueDark }}>{item.q}</b>
                    <p style={{ margin: '6px 0 0', fontSize: 12, color: '#475569', lineHeight: 1.45 }}>{item.a}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>
    </main>
  );
}

// ============================================================================
// DATAVERSE SCHEMA CHECKER, AI PROMPT BUILDER & DEV TELEMETRY PANEL
// ============================================================================
function DevSchemaAndTelemetryPanel({ assets, logs, userIdentity, userOverride, onChangeOverride }) {
  const [subTab, setSubTab] = useState('schema'); // 'schema' (the app manifest) | 'telemetry' | 'health'
  const [manifestState, setManifestState] = useState(calManifestState);
  const [manifestSaving, setManifestSaving] = useState(false);
  const [devLogs, setDevLogs] = useState(() => devLogBuffer.slice());
  const [logFilter, setLogFilter] = useState('ALL');
  const [logQuery, setLogQuery] = useState('');
  const [healthResults, setHealthResults] = useState([]);
  const [auditList, setAuditList] = useState(loadAccessAuditLog);
  const [simId, setSimId] = useState(userOverride ? userOverride.microsoftId : '');
  const [simName, setSimName] = useState(userOverride ? userOverride.userName : '');

  useEffect(() => {
    const listener = (next) => setDevLogs(next);
    devLogListeners.add(listener);
    return () => { devLogListeners.delete(listener); };
  }, []);

  const saveManifestNow = async () => {
    setManifestSaving(true);
    try { await saveCalendarManifest(); } finally { setManifestState(calManifestState); setManifestSaving(false); }
  };
  const manifest = useMemo(() => hubManifest(calendarManifest()), []);

  const runHealthCheck = async () => {
    const checks = [
      { id: 'xrm', name: '1. Dataverse Xrm.WebApi Host', status: hasXrmConnection() ? 'PASS' : 'NOT CONNECTED', detail: hasXrmConnection() ? 'Connected to Xrm.WebApi' : 'Not inside the Power Apps host: nothing can be read' },
      { id: 'assets', name: '2. Equipment Catalog (craa5_aa_assets)', status: assets.length > 0 ? 'PASS' : 'WARN', detail: `${assets.length.toLocaleString()} equipment loaded (${missingAssetColumns.size} missing freq cols)` },
      { id: 'logs', name: '3. MSS Completion Log (craa5__log_)', status: missingLogColumns.has(LOG_ASSET_ID_SELECT) ? 'WARN' : 'PASS', detail: `${logs.length.toLocaleString()} log rows in memory (${missingLogColumns.size} optional cols omitted)` },
      { id: 'shared_cat', name: '4. MSS Log Input Shared Cache', status: readSharedAssetCatalog().length > 0 ? 'PASS' : 'INFO', detail: `${readSharedAssetCatalog().length} shared catalog items in sessionStorage` },
      { id: 'storage', name: '5. LocalStorage & BroadcastChannel Bridge', status: dtCanStore() ? 'PASS' : 'WARN', detail: typeof BroadcastChannel !== 'undefined' ? 'BroadcastChannel active (mss_hub_sync_v1)' : 'Storage event bridge active' }
    ];
    setHealthResults(checks);
    pushDevLog('HEALTH', 'system', `Ran 5-point system health check`, 'OK', 2, checks.length);
  };

  const missingColsDetected = useMemo(() => {
    const list = [];
    missingAssetColumns.forEach(c => list.push('craa5_aa_assets.' + c));
    missingLogColumns.forEach(c => list.push('craa5__log_.' + c));
    missingPlanColumns.forEach(c => list.push(PLAN_TABLE + '.' + c));
    return list;
  }, [devLogs.length]);

  const filteredDevLogs = useMemo(() => {
    const q = logQuery.trim().toLowerCase();
    return devLogs.filter(e => {
      if (logFilter !== 'ALL' && e.category !== logFilter && e.status !== logFilter) return false;
      if (q && (e.entity + ' ' + e.summary + ' ' + e.detail).toLowerCase().indexOf(q) < 0) return false;
      return true;
    });
  }, [devLogs, logFilter, logQuery]);

  return (
    <div className="diag-card" data-testid="dev-schema-telemetry" style={{ marginTop: 16 }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 10, marginBottom: 12 }}>
        <div>
          <h3 style={{ margin: 0 }}>App Manifest &amp; Live Developer Telemetry</h3>
          <p className="dt-hint">The tables and columns this page uses, saved to Hub config for the Dataverse monitor, and the live API calls. Table and column changes are made from the Dataverse monitor, never from this page.</p>
        </div>
        <div className="comp-seg" role="group" aria-label="Developer Console Mode">
          <button type="button" className={subTab === 'schema' ? 'on' : ''} onClick={() => setSubTab('schema')}>1. App Manifest</button>
          <button type="button" className={subTab === 'telemetry' ? 'on' : ''} onClick={() => setSubTab('telemetry')}>2. Live Dev Logs ({devLogs.length})</button>
          <button type="button" className={subTab === 'health' ? 'on' : ''} onClick={() => { setSubTab('health'); setAuditList(loadAccessAuditLog()); }}>3. Health &amp; Access Audit</button>
        </div>
      </div>

      {subTab === 'schema' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }} data-testid="app-manifest">
          <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', alignItems: 'center' }}>
            <button type="button" className="sync-btn" disabled={manifestSaving} onClick={saveManifestNow} data-testid="manifest-save">{manifestSaving ? 'Saving...' : 'Save manifest again'}</button>
            <span className="dt-src" data-testid="manifest-status">{hubManifestKey(CAL_APP_ID)}: {manifestState.status}{manifestState.at ? ' (' + manifestState.at.slice(0, 16).replace('T', ' ') + ')' : ''} - version {manifest.version}, contract {manifest.contract}, hash {manifest.hash}</span>
          </div>
          <p className="dt-note" style={{ margin: 0 }}>Saved to Hub config ({HUB_CONFIG_TABLES.join(', then ')}) when the page loads, only when it changed. The Dataverse monitor reads it to show what is missing; any new table or column is made there. "Works without" columns are dropped on their own when a table lacks them.</p>
          <table style={{ width: '100%', fontSize: 12, borderCollapse: 'collapse' }}>
            <thead><tr style={{ borderBottom: '1px solid #cbd5e1', textAlign: 'left', color: BRAND.blueDark }}><th style={{ padding: '4px 8px' }}>Table</th><th style={{ padding: '4px 8px' }}>Reads</th><th style={{ padding: '4px 8px' }}>Writes</th><th style={{ padding: '4px 8px' }}>Works without</th></tr></thead>
            <tbody>{manifest.tables.map(t => (
              <tr key={t.t} style={{ borderBottom: '1px solid #eef2f7', verticalAlign: 'top' }}>
                <td style={{ padding: '4px 8px', fontFamily: 'monospace', fontWeight: 700 }}>{t.names.join(' / ')}</td>
                <td style={{ padding: '4px 8px', fontFamily: 'monospace', color: '#475569' }}>{t.read.join(', ')}</td>
                <td style={{ padding: '4px 8px', fontFamily: 'monospace', color: '#475569' }}>{t.write.join(', ') || '-'}</td>
                <td style={{ padding: '4px 8px', fontFamily: 'monospace', color: '#94a3b8' }}>{t.opt.join(', ') || '-'}</td>
              </tr>
            ))}</tbody>
          </table>
          <p className="dt-note" style={{ margin: 0 }}>Hub config keys: {manifest.config.join(', ')}.{missingColsDetected.length ? ' Missing on the last read: ' + missingColsDetected.join(', ') + '.' : ''}</p>
        </div>
      )}

      {subTab === 'telemetry' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', justifyContent: 'space-between' }}>
            <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
              {['ALL', 'API-READ', 'API-WRITE', 'FILE', 'SCHEMA', 'ERROR'].map(f => (
                <button key={f} type="button" className={logFilter === f ? 'sync-btn' : 'page-btn'} onClick={() => setLogFilter(f)}>{f}</button>
              ))}
              <input
                value={logQuery}
                onChange={e => setLogQuery(e.target.value)}
                placeholder="Search table, filter, or error..."
                style={{ padding: '6px 10px', borderRadius: 6, border: '1px solid #cbd5e1', fontSize: 12, width: 220 }}
              />
            </div>
            <div style={{ display: 'flex', gap: 8 }}>
              <button
                type="button"
                className="page-btn"
                onClick={() => {
                  const blob = new Blob([JSON.stringify(devLogs, null, 2)], { type: 'application/json' });
                  const url = URL.createObjectURL(blob);
                  const a = document.createElement('a');
                  a.href = url;
                  a.download = `mss-calendar-dev-logs-${normalizeDateStr(new Date())}.json`;
                  a.click();
                  setTimeout(() => URL.revokeObjectURL(url), 1000);
                }}
              >
                Export Logs JSON
              </button>
              <button type="button" className="page-btn danger" onClick={clearDevLogs}>Clear Logs</button>
            </div>
          </div>

          {filteredDevLogs.length === 0 ? (
            <p className="dt-note">No developer telemetry events match the current filter yet. Run Sync Dataverse or open an area to capture live OData traffic.</p>
          ) : (
            <div style={{ maxHeight: 340, overflowY: 'auto', border: '1px solid #e2e8f0', borderRadius: 8 }}>
              <table style={{ width: '100%', fontSize: 11, borderCollapse: 'collapse' }}>
                <thead>
                  <tr style={{ background: '#f1f5f9', textAlign: 'left', color: BRAND.blueDark }}>
                    <th style={{ padding: '6px 8px' }}>Time</th>
                    <th style={{ padding: '6px 8px' }}>Category</th>
                    <th style={{ padding: '6px 8px' }}>Table / Target</th>
                    <th style={{ padding: '6px 8px' }}>Operation &amp; Query</th>
                    <th style={{ padding: '6px 8px' }}>Rows</th>
                    <th style={{ padding: '6px 8px' }}>ms</th>
                    <th style={{ padding: '6px 8px' }}>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredDevLogs.map(e => (
                    <tr key={e.id} style={{ borderTop: '1px solid #eef2f7', color: e.status === 'ERR' ? '#b91c1c' : '#1e293b' }}>
                      <td style={{ padding: '4px 8px', fontFamily: 'monospace', whiteSpace: 'nowrap' }}>{e.ts}</td>
                      <td style={{ padding: '4px 8px', fontWeight: 700 }}>{e.category}</td>
                      <td style={{ padding: '4px 8px', fontFamily: 'monospace' }}>{e.entity}</td>
                      <td style={{ padding: '4px 8px', wordBreak: 'break-all' }}>{e.summary}{e.detail ? ` - ${e.detail}` : ''}</td>
                      <td style={{ padding: '4px 8px' }}>{e.rows}</td>
                      <td style={{ padding: '4px 8px', fontFamily: 'monospace' }}>{e.ms}</td>
                      <td style={{ padding: '4px 8px', fontWeight: 800 }}>{e.status}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}

      {subTab === 'health' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
            <button type="button" className="sync-btn" onClick={runHealthCheck}>Run 5-Point System Health Check</button>
            <span className="dt-hint">Verifies Xrm host, asset catalog, log schema, shared session cache, and cross-tab BroadcastChannel.</span>
          </div>
          {healthResults.length > 0 && (
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: 10 }}>
              {healthResults.map(h => (
                <div key={h.id} style={{ padding: 10, borderRadius: 8, border: '1px solid #e2e8f0', background: '#f8fafc' }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12, fontWeight: 800 }}>
                    <span>{h.name}</span>
                    <span style={{ color: h.status === 'PASS' ? '#047857' : '#b45309' }}>{h.status}</span>
                  </div>
                  <p style={{ margin: '4px 0 0', fontSize: 11, color: '#475569' }}>{h.detail}</p>
                </div>
              ))}
            </div>
          )}

          <div style={{ padding: 12, borderRadius: 8, border: '1px solid #e2e8f0', background: '#f8fafc' }}>
            <h3 style={{ marginTop: 0 }}>Identity Simulator (Test User Role Views)</h3>
            <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'flex-end' }}>
              <label className="dt-field">
                <span>Simulate Microsoft ID</span>
                <input value={simId} onChange={e => setSimId(e.target.value)} placeholder="e.g. U1010051" />
              </label>
              <label className="dt-field">
                <span>Simulate User Name</span>
                <input value={simName} onChange={e => setSimName(e.target.value)} placeholder="e.g. Bakery Sanitor" />
              </label>
              <button type="button" className="sync-btn" onClick={() => onChangeOverride(simId.trim() ? { microsoftId: simId.trim(), userName: simName.trim() || simId.trim(), email: '' } : null)}>Apply Simulation</button>
              {userOverride && <button type="button" className="page-btn" onClick={() => { setSimId(''); setSimName(''); onChangeOverride(null); }}>Reset to Real User</button>}
            </div>
          </div>

          <div>
            <h3>Recent User Access &amp; Active View Audit Log ({auditList.length})</h3>
            {auditList.length === 0 ? (
              <p className="dt-note">No access entries recorded yet.</p>
            ) : (
              <table style={{ width: '100%', fontSize: 11, borderCollapse: 'collapse' }}>
                <thead>
                  <tr style={{ borderBottom: '1px solid #cbd5e1', textAlign: 'left', color: BRAND.blueDark }}>
                    <th style={{ padding: '4px 8px' }}>Timestamp</th>
                    <th style={{ padding: '4px 8px' }}>User</th>
                    <th style={{ padding: '4px 8px' }}>Microsoft ID</th>
                    <th style={{ padding: '4px 8px' }}>App</th>
                    <th style={{ padding: '4px 8px' }}>Active Preset</th>
                  </tr>
                </thead>
                <tbody>
                  {auditList.slice(0, 15).map((a, idx) => (
                    <tr key={a.id || idx} style={{ borderBottom: '1px solid #eef2f7' }}>
                      <td style={{ padding: '4px 8px', fontFamily: 'monospace' }}>{String(a.ts || a.accessedAt || '').slice(0, 19).replace('T', ' ')}</td>
                      <td style={{ padding: '4px 8px' }}>{a.userName}</td>
                      <td style={{ padding: '4px 8px', fontFamily: 'monospace', fontWeight: 700 }}>{a.microsoftId}</td>
                      <td style={{ padding: '4px 8px' }}>{a.app || 'MSS'}</td>
                      <td style={{ padding: '4px 8px' }}>{a.presetId || a.viewPreset || 'full_plant'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </div>
      )}
    </div>
  );
}



// ============================================================================
// EXECUTIVE PRIORITIZATION & RISK INTELLIGENCE ENGINE (VP QUALITY & VP OPS)
// ============================================================================
const buildPrioritizationModel = ({ assets, freqStatus, completionIndex, lineRules, downtimeLines, planModel, today, todayStr }) => {
  const items = [];
  const roomMap = new Map();
  const areaMap = new Map();
  const tomorrowStr = dtAddDays(todayStr, 1);
  const day2Str = dtAddDays(todayStr, 2);

  // Pre-build line availability status by normalized area name
  const areaLineState = new Map();
  const pModel = planModel || buildPlanModel([]);
  const rulesObj = lineRules || buildLineRules({ plan: pModel, lines: downtimeLines || [] });
  const mon0 = dtMonday(todayStr);
  const mon1 = dtAddDays(mon0, 7);
  const windowWeeks = [{ monday: mon0 }, { monday: mon1 }];
  const windowDays = [];
  let todayOffset = 0;
  for (let dIdx = 0; dIdx < 14; dIdx++) {
    const dStr = dtAddDays(mon0, dIdx);
    if (dStr === todayStr) todayOffset = dIdx;
    windowDays.push({ date: dStr, dow: dtDow(dStr) });
  }

  assets.forEach(asset => {
    const id = getAssetId(asset);
    const name = safeString(getProp(asset, 'craa5_equipmentidentifier')) || 'Unnamed Equipment';
    const room = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
    const area = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
    const st = freqStatus.get(id);
    const badges = st && st.badges ? st.badges : [];
    if (!badges.length) return;

    // 1. Determine Production Line Downtime Window for this equipment's Area
    const normArea = normalizeName(area);
    let lineInfo = areaLineState.get(normArea);
    if (!lineInfo) {
      const grpKey = rulesObj.calKeyOf ? rulesObj.calKeyOf(asset) : rulesObj.groupOf ? rulesObj.groupOf(asset) : '';
      if (!grpKey) {
        lineInfo = { status: 'FLEX', label: 'Independent / Any Shift', detail: 'Not tied to a continuous line run', opsPts: 16, downToday: true, down48h: true };
      } else {
        const cal = rulesObj.build(grpKey, windowDays, windowWeeks);
        const prodToday = cal.prod && cal.prod[todayOffset] !== undefined ? cal.prod[todayOffset] : 0;
        const lenToday = cal.len && cal.len[todayOffset] !== undefined ? cal.len[todayOffset] : 1440;
        const downMinToday = Math.max(0, lenToday - prodToday);
        const prodTom = cal.prod && cal.prod[todayOffset + 1] !== undefined ? cal.prod[todayOffset + 1] : 0;
        const prodDay2 = cal.prod && cal.prod[todayOffset + 2] !== undefined ? cal.prod[todayOffset + 2] : 0;
        const downMin48 = Math.max(0, 1440 - prodTom) + Math.max(0, 1440 - prodDay2);
        const lineLabel = grpKey.split(LR_SEP).map(k => {
          const parts = k.split('|');
          return (parts[0] ? parts[0].toUpperCase() : area) + ' L' + (parts[1] || '1');
        }).join(', ');

        if (downMinToday >= 180) {
          lineInfo = {
            status: 'DOWN_TODAY',
            label: 'Line Down Today (Golden Window)',
            detail: `${lineLabel} has ${Math.round(downMinToday / 60)}h sanitation window today`,
            opsPts: 25,
            downToday: true,
            down48h: true
          };
        } else if (downMin48 >= 180) {
          lineInfo = {
            status: 'DOWN_48H',
            label: 'Window Within 48h',
            detail: `${lineLabel} running today; downtime window opens within 48h`,
            opsPts: 15,
            downToday: false,
            down48h: true
          };
        } else {
          lineInfo = {
            status: 'RUNNING',
            label: 'Line Running Continuous',
            detail: `${lineLabel} scheduled in continuous production`,
            opsPts: 6,
            downToday: false,
            down48h: false
          };
        }
      }
      areaLineState.set(normArea, lineInfo);
    }

    // 2. Quality & Food Safety Depth Score (0 - 35 pts)
    const overdueBadges = badges.filter(b => b.state === 'overdue');
    const focusBadges = overdueBadges.length ? overdueBadges : badges;
    let maxRank = 1;
    let highestCode = focusBadges[0] ? focusBadges[0].code : 'D';
    focusBadges.forEach(b => {
      const fDef = FREQS.find(f => f.code === b.code);
      const r = fDef ? fDef.rank : 1;
      if (r >= maxRank) { maxRank = r; highestCode = b.code; }
    });
    const isZone1OrCritical = /drain|freezer|depositor|filler|slicer|pasteurizer|mixer|cutter/i.test(name);
    const depthPts = (maxRank >= 4 ? 30 : maxRank === 3 ? 22 : 14) + (isZone1OrCritical ? 5 : 0);

    // 3. Compliance Window Urgency Score (0 - 40 pts)
    const lastDate = st && st.lastAny ? st.lastAny : null;
    const daysSinceLast = lastDate ? Math.max(0, dtSpan(lastDate, todayStr) - 1) : 45;
    let urgencyPts = 4;
    let urgencyLabel = 'Compliant - Within Window';
    if (overdueBadges.length > 0) {
      const primaryOverdue = overdueBadges[overdueBadges.length - 1];
      const daysPast = Math.max(1, daysSinceLast - primaryOverdue.days);
      urgencyPts = Math.min(40, 26 + Math.min(14, daysPast * 2));
      urgencyLabel = `${overdueBadges.map(b => b.label).join(' + ')} Overdue (${daysPast}d past ${primaryOverdue.days}d window)`;
    } else if (st && st.state === 'unknown') {
      urgencyPts = 14;
      urgencyLabel = 'Unread History - Verify Log';
    } else {
      // Check tightest remaining window
      let minRem = 999;
      let tightestBadge = badges[0];
      badges.forEach(b => {
        const bLast = b.last ? Math.max(0, dtSpan(b.last, todayStr) - 1) : 0;
        const rem = Math.max(0, b.days - bLast);
        if (rem < minRem) { minRem = rem; tightestBadge = b; }
      });
      if (minRem <= 1) {
        urgencyPts = 21;
        urgencyLabel = `Due Within 24h (${tightestBadge ? tightestBadge.label : 'Daily'})`;
      } else if (minRem <= 3) {
        urgencyPts = 13;
        urgencyLabel = `Due in ${minRem}d (${tightestBadge ? tightestBadge.label : 'Scheduled'})`;
      } else {
        urgencyPts = 4;
        urgencyLabel = `On Track (${minRem}d remaining in window)`;
      }
    }

    const score = Math.min(100, depthPts + urgencyPts + lineInfo.opsPts);

    // 4. Classify into 4 Executive Dispatch Tiers
    let tier = 4;
    let tierLabel = 'TIER 4: COMPLIANT / ON TRACK';
    let tierShort = 'Tier 4 - Compliant';
    let tierAction = 'Routine schedule monitoring';
    if (overdueBadges.length > 0 && lineInfo.downToday) {
      tier = 1;
      tierLabel = 'TIER 1: GOLDEN WINDOW (DISPATCH NOW)';
      tierShort = 'Tier 1 - Golden Window';
      tierAction = 'Immediate Dispatch: Overdue & Line Available Today';
    } else if (overdueBadges.length > 0 && !lineInfo.downToday) {
      tier = 2;
      tierLabel = 'TIER 2: OPS / QA COORDINATION';
      tierShort = 'Tier 2 - Ops/QA Align';
      tierAction = lineInfo.down48h ? 'Lock in upcoming 48h line downtime slot' : 'Coordinate with Ops for next changeover window';
    } else if (urgencyPts >= 13 && (lineInfo.downToday || lineInfo.down48h)) {
      tier = 3;
      tierLabel = 'TIER 3: PROACTIVE 48H STAGING';
      tierShort = 'Tier 3 - Stage 48h';
      tierAction = 'Stage SAP order & crew for current/next window';
    }

    // Estimate crew hours from historical logs or asset default
    const assetLogs = completionIndex.byAsset.get(id);
    let estHours = Number(asset._estHours) || (maxRank === 3 ? 5 : maxRank === 2 ? 3 : 2);
    if (assetLogs && assetLogs.size > 0) {
      let sumH = 0, cntH = 0;
      assetLogs.forEach(entry => {
        const h = Number(entry.log && entry.log.craa5_hoursworked);
        if (h > 0) { sumH += h; cntH += 1; }
      });
      if (cntH > 0) estHours = Math.max(1, Math.round(sumH / cntH));
    }

    const sapMap = getAssetSapMap(asset);
    const sapOrder = sapMap[highestCode] || sapMap.D || sapMap.W || sapMap.M || 'SAP-STD';

    const item = {
      id,
      asset,
      name,
      room,
      area,
      st,
      badges,
      overdueBadges,
      highestCode,
      maxRank,
      isZone1OrCritical,
      lastDate,
      daysSinceLast,
      depthPts,
      urgencyPts,
      opsPts: lineInfo.opsPts,
      score,
      tier,
      tierLabel,
      tierShort,
      tierAction,
      urgencyLabel,
      lineInfo,
      estHours,
      sapOrder
    };
    items.push(item);

    // Aggregate Room & Area Bottlenecks
    const bumpGroup = (map, key, rName, aName) => {
      let g = map.get(key);
      if (!g) {
        g = { key, room: rName, area: aName, total: 0, overdue: 0, tier1: 0, tier2: 0, tier3: 0, compliant: 0, backlogHours: 0, goldenHours: 0, scoreSum: 0 };
        map.set(key, g);
      }
      g.total += 1;
      g.scoreSum += score;
      if (overdueBadges.length > 0) {
        g.overdue += 1;
        g.backlogHours += estHours;
      } else {
        g.compliant += 1;
      }
      if (tier === 1) { g.tier1 += 1; g.goldenHours += estHours; }
      else if (tier === 2) g.tier2 += 1;
      else if (tier === 3) g.tier3 += 1;
    };
    bumpGroup(roomMap, room, room, null);
    bumpGroup(areaMap, `${room}|${area}`, room, area);
  });

  items.sort((a, b) => a.tier - b.tier || b.score - a.score || b.daysSinceLast - a.daysSinceLast || a.name.localeCompare(b.name));

  const rooms = Array.from(roomMap.values()).sort((a, b) => b.overdue - a.overdue || b.tier1 - a.tier1 || a.room.localeCompare(b.room));
  const areas = Array.from(areaMap.values()).sort((a, b) => b.tier1 - a.tier1 || b.overdue - a.overdue || a.area.localeCompare(b.area));

  const counts = {
    total: items.length,
    tier1: items.filter(x => x.tier === 1).length,
    tier2: items.filter(x => x.tier === 2).length,
    tier3: items.filter(x => x.tier === 3).length,
    tier4: items.filter(x => x.tier === 4).length,
    overdue: items.filter(x => x.overdueBadges.length > 0).length,
    goldenHours: items.filter(x => x.tier === 1).reduce((s, x) => s + x.estHours, 0),
    totalBacklogHours: items.filter(x => x.overdueBadges.length > 0).reduce((s, x) => s + x.estHours, 0)
  };

  const summary = {
    totalScored: counts.total,
    goldenWindowCount: counts.tier1,
    tier2Count: counts.tier2,
    tier3Count: counts.tier3,
    tier4Count: counts.tier4,
    overdueCount: counts.overdue,
    goldenHours: counts.goldenHours,
    totalBacklogHours: counts.totalBacklogHours
  };

  return { items, rooms, areas, counts, summary };
};

// ============================================================================
// PRIORITIZATION BRIEF TAB (DESIGNED FOR VP OF QUALITY & VP OF OPERATIONS)
// ============================================================================
// ============================================================================
// TODAY TAB: what is due, done and overdue, per equipment and frequency letter, from the same frequency check as the
// medallion (freqStatus). A letter is Done today when its newest qualifying clean is dated today (shift date), Due today
// when its window closes at the end of today, Due this week when it closes within 7 days, Overdue when the window is
// read and has no clean, Not read while a month of the window has not been read (Read today's cleans reads them).
// ============================================================================
const TODAY_STATES = [
  { id: 'overdue', label: 'Overdue', color: HUB_STATUS_COLORS.overdue },
  { id: 'today', label: 'Due today', color: HUB_STATUS_COLORS.atrisk },
  { id: 'week', label: 'Due this week', color: HUB_STATUS_COLORS.planned },
  { id: 'done', label: 'Done today', color: HUB_STATUS_COLORS.done },
  { id: 'unknown', label: 'Not read', color: '#94A3B8' }
];
const todayBadgeState = (b, todayStr) => {
  if (b.state === 'overdue') return 'overdue';
  if (b.state !== 'ok') return 'unknown';
  if (b.last === todayStr) return 'done';
  const closes = hubAddDays(b.last, b.days);   // the last day this clean still covers
  if (closes <= todayStr) return 'today';
  if (closes <= hubAddDays(todayStr, 7)) return 'week';
  return 'ok';
};
// The one-page guide behind the ? button (data contract section 9: at most 7 steps, one action each, printable)
const TODAY_GUIDE = [
  'Open the Today tab at the start and end of your shift.',
  "Press Read today's cleans and wait until it says Read.",
  'Look at To do now: red is overdue, amber is due today.',
  'Clean the pieces on the list, in that order.',
  'Mark each piece done in Ganttly. If it was not on the board, tap Log clean here.',
  'In Log clean: check the shift date, pick the clean that was done, type every name and the minutes.',
  'Check Done today. A piece stays on the list until its clean is saved.'
];
function TodayTab({ tree, freqStatus, todayStr, connected, loadAll, loadAllOn, onReadAll, onCancelRead, onQuickLog }) {
  const [show, setShow] = useState('open');   // open = overdue + due today; or one state id
  const [help, setHelp] = useState(false);
  const rows = useMemo(() => {
    const out = [];
    Object.keys(tree).sort().forEach(room => Object.keys(tree[room]).sort().forEach(area => tree[room][area].forEach(asset => {
      const st = freqStatus.get(getAssetId(asset));
      if (!st || !st.badges.length) return;
      const letters = st.badges.map(b => ({ code: b.code, label: b.label, last: b.last, state: todayBadgeState(b, todayStr) }));
      out.push({ room, area, asset, name: safeString(getProp(asset, 'craa5_equipmentidentifier')) || '(no name)', letters });
    })));
    return out;
  }, [tree, freqStatus, todayStr]);
  const counts = useMemo(() => {
    const c = { overdue: 0, today: 0, week: 0, done: 0, unknown: 0 };
    rows.forEach(r => r.letters.forEach(l => { if (c[l.state] !== undefined) c[l.state] += 1; }));
    return c;
  }, [rows]);
  const wanted = (l) => show === 'open' ? (l.state === 'overdue' || l.state === 'today') : l.state === show;
  const shown = rows.filter(r => r.letters.some(wanted));
  const byArea = [];
  shown.forEach(r => { const last = byArea[byArea.length - 1]; if (last && last.room === r.room && last.area === r.area) last.rows.push(r); else byArea.push({ room: r.room, area: r.area, rows: [r] }); });
  const stateOf = (id) => TODAY_STATES.find(x => x.id === id) || { label: 'On track', color: HUB_STATUS_COLORS.done };
  return (
    <div className="dt-wrap" data-testid="today-tab" style={{ padding: '16px 20px', overflowY: 'auto' }}>
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 10, alignItems: 'center', marginBottom: 12 }}>
        <h2 style={{ margin: 0, fontSize: 18 }}>Today - {todayStr}</h2>
        {connected && !loadAllOn && <button type="button" className="sync-btn outline" onClick={onReadAll} data-testid="today-read">Read today's cleans</button>}
        {loadAllOn && <button type="button" className="sync-btn outline" onClick={onCancelRead}>Stop reading</button>}
        {loadAll && <span className="dt-note" style={{ margin: 0 }}>{loadAll.finished ? 'Read: ' + loadAll.months : 'Reading ' + loadAll.done + ' of ' + loadAll.total + ' equipment'}</span>}
        <button type="button" className="page-btn" style={{ minWidth: 44, minHeight: 44, fontWeight: 800 }} onClick={() => setHelp(h => !h)} title="Help" data-testid="today-help">?</button>
      </div>
      {help && (
        <div className="today-guide" data-testid="today-guide" style={{ border: '1px solid #B3D4F2', borderRadius: 10, padding: '12px 16px', marginBottom: 14, background: '#E6F1FB', color: '#1E293B' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 8 }}>
            <b>How to use Today</b>
            <span style={{ display: 'flex', gap: 8 }}>
              <button type="button" className="page-btn" style={{ minHeight: 36 }} onClick={() => { try { window.print(); } catch (_) { /* printing blocked */ } }}>Print</button>
              <button type="button" className="page-btn" style={{ minHeight: 36 }} onClick={() => setHelp(false)}>Close</button>
            </span>
          </div>
          <ol style={{ margin: '8px 0 0', paddingLeft: 22, fontSize: 14, lineHeight: 1.6 }}>
            {TODAY_GUIDE.map((t, i) => <li key={i}>{t}</li>)}
          </ol>
        </div>
      )}
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, marginBottom: 14 }}>
        <button type="button" className={'fchip' + (show === 'open' ? ' on' : '')} onClick={() => setShow('open')} style={{ height: 44, padding: '0 14px' }}>To do now ({counts.overdue + counts.today})</button>
        {TODAY_STATES.map(x => (
          <button key={x.id} type="button" className={'fchip' + (show === x.id ? ' on' : '')} onClick={() => setShow(x.id)} data-testid={'today-chip-' + x.id}
            style={{ height: 44, padding: '0 14px', borderColor: x.color, color: show === x.id ? '#fff' : x.color, background: show === x.id ? x.color : undefined }}>
            {x.label} ({counts[x.id]})
          </button>
        ))}
      </div>
      {!connected && <p className="dt-note">Not connected to Dataverse, so no cleans can be read.</p>}
      {connected && counts.unknown > 0 && !loadAllOn && <p className="dt-note">{counts.unknown} cleaning letters are not read yet. Press Read today's cleans to read the months on screen for every equipment.</p>}
      {connected && !shown.length && <p className="dt-note">Nothing here for this filter.</p>}
      {byArea.map(g => (
        <div key={g.room + '|' + g.area} style={{ marginBottom: 14 }}>
          <div style={{ fontWeight: 700, fontSize: 13, margin: '0 0 6px' }}>{g.room} - {g.area}</div>
          {g.rows.map(r => (
            <div key={getAssetId(r.asset)} style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 8, padding: '6px 0', borderBottom: '1px solid #E2E8F0' }}>
              <span style={{ flex: '1 1 200px', fontSize: 13 }}>{r.name}</span>
              {r.letters.filter(wanted).map(l => {
                const x = stateOf(l.state);
                return (
                  <span key={l.code} title={l.label + ' - ' + x.label + (l.last ? ' - last clean ' + l.last : ' - no clean read')}
                    style={{ display: 'inline-flex', alignItems: 'center', gap: 6, border: '1px solid ' + x.color, color: x.color, borderRadius: 999, padding: '2px 10px', fontSize: 12, fontWeight: 700 }}>
                    {l.code} - {x.label}{l.last ? ' (last ' + l.last.slice(5) + ')' : ''}
                  </span>
                );
              })}
              {connected && onQuickLog && <button type="button" className="page-btn" style={{ minHeight: 36 }} onClick={() => onQuickLog({ asset: r.asset, dateStr: todayStr })}>Log clean</button>}
            </div>
          ))}
        </div>
      ))}
    </div>
  );
}

