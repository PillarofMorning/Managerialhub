                )}
             </div>
             <DvColumnsCard connected={hasXrmConnection()} assetsRead={assets.length > 0} logsRead={loadedRef.current.size > 0 || logs.length > 0} planRead={!!plan.data} idColumn={idColumn} />
             <DevSchemaAndTelemetryPanel
               assets={assets}
               logs={logs}
               userIdentity={currentIdentity}
               userOverride={userOverride}
               onChangeOverride={(u) => { saveUserOverride(u); setUserOverride(loadUserOverride()); }}
             />
             </div>
          </main>
        ) : activeTab === 'views' && fullMode ? (
          <CustomViewsTab
            viewConfig={viewConfig}
            setViewConfig={setViewConfig}
            activePresetId={activePresetId}
            setActivePresetId={applyPresetSelection}
            assets={assets}
            userIdentity={currentIdentity}
            userOverride={userOverride}
            onChangeOverride={(u) => { saveUserOverride(u); setUserOverride(loadUserOverride()); }}
          />
        ) : activeTab === 'manual' ? (
          <HowToManualTab onNavigateTab={setActiveTab} />
        ) : activeTab === 'downtime' && fullMode ? (
          <LineDowntimeTab assets={assets} lines={downtime.lines} setLines={downtime.setLines} saved={downtime.saved} shared={downtime.shared} plan={plan} planYear={anchorYear} planModel={planModel} rules={lineRules} onReadPlan={() => readPlan(anchorYear)} />
        ) : activeTab === 'completion' && fullMode ? (
          <CompletionTab
            comp={compTab} count={countList} ex={exclusions.ex} setEx={exclusions.setEx} exSaved={exclusions.saved} exShared={exclusions.shared} assets={assets} assetsById={assetsById} connected={hasXrmConnection()}
            anchorYear={anchorYear} thisYear={today.getFullYear()} monthsLabel={monthsLabel} tiles={compTiles} planText={planText}
            locked={isLoading || isSaving || loadAllOn} reading={pinnedRuns.length > 0} onReadIds={readMonths}
            freqEdits={freqEdits} setFreqEdits={setFreqEdits} freqSave={freqSave} onSave={saveFreqEdits} onDismissSave={() => setFreqSave(null)}
          />
        ) : (
          <main className="matrix-outer-container">
            {planMode && <PlanSetupPanel raw={planRaw} setup={planSetup} setRaw={setPlanRaw} plan={freqPlan} visibleDays={timelineDays} year={anchorYear} />}
            <div className="viewport" ref={viewportRef} data-testid="matrix-viewport" onMouseMove={onGridMove} onMouseLeave={hideXh} onScroll={hideXh}>
              <div className="header-row">
                <div className="frozen-column-group corner" ref={cornerRef}>{planMode ? (<><div className="corner-top"><span>MSS PLAN - FREQUENCY ONLY</span><span className="corner-legend">D daily - MW mid-week - W weekly - M monthly<br />Q quarterly - S 6-month - A annual - nothing is read from the log<br />Every frequency starts fresh on 1 January; longer cleans sit on down days</span></div><div className="corner-pct" title="Minutes of every planned clean that day, in hours (pieces with no standard minutes use the minutes in the setup)">HOURS SCHEDULED</div><div className="corner-pct cnt" title="Cleaners for those hours at the setup's shift length and cleaning share, plus the support positions">SUGGESTED CREW</div><div className="corner-pct" title="Heads the crew builder has on that day, plus the support positions">CREW ON (BUILDER)</div><div className="corner-pct last cnt" title="Cleaners short (red, amber when on-demand positions can cover it) or spare (green)">SHORT / SPARE</div></>) : (<><div className="corner-top"><span>FACILITY HIERARCHY</span><span className="corner-legend">D daily - MW mid-week - W weekly - M monthly<br />Q quarterly - S 6-month - A annual - red letter: overdue - dotted: not read yet<br />Yes on a room or area: cleaned that day{fullMode && exCount(exclusions.ex).total > 0 && <span data-testid="corner-left-out"> - {exCount(exclusions.ex).total} left out (Completion tab)</span>}{fullMode && (planFailed ? <span data-testid="corner-plan"> - production plan not read: every day counts</span> : planPending ? <span data-testid="corner-plan"> - reading the production plan...</span> : planModel && completion && !completion.byLines ? <span data-testid="corner-plan"> - no MSS area follows a plan line: every day counts</span> : null)}</span></div>{fullMode && <><div className="corner-pct" title="Daily jobs done that day, as a percentage of the daily jobs due (blank: none could be judged yet)">DONE % - DAY</div><div className="corner-pct cnt" title="Daily jobs scheduled that day that were not done (blank: none could be judged yet)">NOT DONE - DAY</div><div className="corner-pct" title="On every Sunday: the jobs of that Monday-to-Sunday week done, as a percentage of the jobs due (the daily jobs of each day and the mid-week and weekly ones)">DONE % - WEEK (SUNDAY)</div><div className="corner-pct last cnt" title="On every Sunday: the jobs of that Monday-to-Sunday week that were not done (the daily jobs of each day and the mid-week and weekly ones)">NOT DONE - WEEK (SUNDAY)</div></>}</>)}</div>
                <div className="header-blocks" ref={headBlocksRef}>
                  <div className="month-tier">{monthSpans.map((m, i) => (<div key={i} className="cell-month" style={{ width: m.count * dayColWidth }}>{m.month}</div>))}</div>
                  <div className="week-tier">{weekSpans.map((w, i) => (<div key={i} className="cell-week" style={{ width: w.count * dayColWidth }}>W{w.week}</div>))}</div>
                  <div className="day-tier">{timelineDays.map((d, i) => (<div key={i} className="cell-day" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}><span>{d.label}</span></div>))}</div>
                  {pctCells && <PctTier cells={pctCells.dayCells} dayColWidth={dayColWidth} testid="pct-day" />}
                  {pctCells && <PctTier cells={pctCells.dayNot} dayColWidth={dayColWidth} testid="pct-day-notdone" slim />}
                  {pctCells && <PctTier cells={pctCells.weekCells} dayColWidth={dayColWidth} testid="pct-week" />}
                  {pctCells && <PctTier cells={pctCells.weekNot} dayColWidth={dayColWidth} testid="pct-week-notdone" slim last />}
                  {planCells && <PctTier cells={planCells.hours} dayColWidth={dayColWidth} testid="plan-hours" />}
                  {planCells && <PctTier cells={planCells.sugg} dayColWidth={dayColWidth} testid="plan-crew" slim />}
                  {planCells && <PctTier cells={planCells.on} dayColWidth={dayColWidth} testid="plan-on" />}
                  {planCells && <PctTier cells={planCells.gap} dayColWidth={dayColWidth} testid="plan-gap" slim last />}
                  <div className="xh-head" ref={xhHeadRef} aria-hidden="true" />
                </div>
              </div>
              <div className="xh-wrap" aria-hidden="true"><div className="xh-body" ref={xhBodyRef} /></div>

              <div className="data-body">
                {assets.length === 0 && !isLoading && (
                  <div style={{ position: 'sticky', left: 0, padding: '24px 28px', maxWidth: '720px' }}>
                    <div style={{ background: '#F8FAFC', border: `1px solid ${BRAND.blueLine}`, borderRadius: '12px', padding: '20px 24px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
                      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '12px', flexWrap: 'wrap' }}>
                        <div>
                          <div style={{ fontSize: '15px', fontWeight: 900, color: BRAND.blueDark }}>Master Sanitation Schedule</div>
                          <div style={{ fontSize: '12px', color: '#475569', marginTop: '2px' }}>Sync equipment from Dataverse or load the shared MSS Log Input catalog to view the schedule.</div>
                        </div>
                        <span style={{ padding: '3px 10px', borderRadius: '999px', background: BRAND.blueSoft, color: BRAND.blueDark, fontSize: '11px', fontWeight: 800 }}>View: {activePreset.name}</span>
                      </div>
                      <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'center' }}>
                        <button type="button" className="sync-btn" onClick={triggerSync}>Sync Dataverse</button>
                        {sharedCatalogCount > 0 && (
                          <button type="button" className="sync-btn outline" onClick={loadSharedCatalogNow}>Load Shared MSS Input Catalog ({sharedCatalogCount})</button>
                        )}
                        <button type="button" className="page-btn" onClick={() => setQuickLogTarget({ asset: null, dateStr: todayStr })}>+ Log Clean / Skip</button>
                        <button type="button" className="page-btn" onClick={() => setActiveTab('views')}>Custom Views</button>
                        <button type="button" className="page-btn" onClick={() => setActiveTab('manual')}>User Manual</button>
                      </div>
                    </div>
                  </div>
                )}
                {pagedRoomKeys.map(room => (
                  <React.Fragment key={room}>
                    <div className="asset-row room-row">
                       <div className="frozen-labels" onClick={() => setExpandedKeys(p => ({...p, [room]: !p[room]}))}>
                          <div className="group-label">
                              <ChevronDownIcon style={{ transform: expandedKeys[room] ? '' : 'rotate(-90deg)', transition: '0.2s' }} />
                              <FolderIcon color={BRAND.blueDark} />
                              <span className="group-name" title={room}>{room}</span>
                          </div>
                          {planMode ? null : <GroupBar {...barProps(room)} />}
                          {!planMode && <span className="scope-action-icon" onClick={(e) => { e.stopPropagation(); openScopedModal('room', room); }} title="Expand Focused Dialog"><MaximizeIcon /></span>}
                       </div>
                       {planMode ? <PlanGroupDays mins={freqPlan && freqPlan.groupMins.get(room)} timelineDays={timelineDays} dayColWidth={dayColWidth} /> : <GroupDays g={groupStatus[room]} groupKey={room} timelineDays={timelineDays} dayColWidth={dayColWidth} onEnter={hoverGroupDay} onLeave={leaveGroupDay} />}
                    </div>
                    {expandedKeys[room] && Object.keys(filteredTreeData[room]).map(area => {
                      const ak = `${room}|${area}`;
                      const areaEquipment = filteredTreeData[room][area];
                      const areaPageIndex = pageOf(areaPages, ak, areaEquipment.length, equipmentPageSize);
                      const areaTotalPages = Math.ceil(areaEquipment.length / equipmentPageSize);
                      const pagedEquipment = areaEquipment.slice(areaPageIndex * equipmentPageSize, (areaPageIndex + 1) * equipmentPageSize);

                      return (
                        <React.Fragment key={ak}>
                          <div className="asset-row area-row">
                             <div className="frozen-labels" style={{ paddingLeft: '30px' }} onClick={() => setExpandedKeys(p => ({...p, [ak]: !p[ak]}))}>
                                <div className="group-label">
                                    <ChevronDownIcon style={{ transform: expandedKeys[ak] ? '' : 'rotate(-90deg)', transition: '0.2s' }} />
                                    <FolderIcon color={BRAND.green} />
                                    <span className="group-name" title={area}>{area}</span>
                                </div>
                                {planMode ? null : <GroupBar {...barProps(ak)} />}
                                {!planMode && <span className="scope-action-icon" onClick={(e) => { e.stopPropagation(); openScopedModal('area', area); }} title="Expand Focused Dialog"><MaximizeIcon /></span>}
                             </div>
                             {planMode ? <PlanGroupDays mins={freqPlan && freqPlan.groupMins.get(ak)} timelineDays={timelineDays} dayColWidth={dayColWidth} /> : <GroupDays g={groupStatus[ak]} groupKey={ak} timelineDays={timelineDays} dayColWidth={dayColWidth} onEnter={hoverGroupDay} onLeave={leaveGroupDay} />}
                          </div>
                          {expandedKeys[ak] && (
                            <>
                              {planMode && pagedEquipment.map(asset => {
                                const name = safeString(getProp(asset, 'craa5_equipmentidentifier'));
                                const codes = FREQS.filter(f => f.flags.some(c => isTrue(asset[c]))).map(f => f.code);
                                const jobs = freqPlan && freqPlan.byAsset.get(getAssetId(asset));
                                const mins = fpMinutes(asset, planSetup.defaultMin);
                                return (
                                  <div key={asset.craa5_aa_assetsid} className="asset-row" data-testid="plan-row">
                                    <div className="frozen-labels" style={{ paddingLeft: '60px' }}>
                                      <div className="eq-label"><FileIcon /><span className="eq-name" title={name + ' - ' + (mins.known ? mins.std + ' standard minutes' : 'no standard minutes: ' + planSetup.defaultMin + ' used')}>{name}</span><PlanMedallion codes={codes} /></div>
                                    </div>
                                    <div className="data-cells">
                                      {timelineDays.map((d, di) => {
                                        const code = jobs && jobs.get(d.dateStr);
                                        return (
                                          <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }}>
                                            {code ? <span className={`plan-mark${code === 'D' ? ' d' : ''}`} data-code={code} title={code + ' on ' + d.dateStr + ': ' + (code === 'D' ? mins.daily : mins.std) + ' min'}>{code}</span> : <div className="marker-empty" />}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })}
                              {!planMode && (late ? pagedEquipment.filter(a => !isFineRow(freqStatus.get(getAssetId(a)))) : pagedEquipment).map(asset => {
                                const name = safeString(getProp(asset, 'craa5_equipmentidentifier'));
                                const rowLogs = rowLogsFor(asset);
                                const st = freqStatus.get(getAssetId(asset));
                                return (
                                  <div key={asset.craa5_aa_assetsid} className={`asset-row${st && st.state === 'overdue' ? ' row-overdue' : ''}`}>
                                    <div className="frozen-labels" style={{ paddingLeft: '60px' }}>
                                      <div className="eq-label"><FileIcon /><span className="eq-name" title={name}>{name}</span><FreqMedallion st={st} /></div>
                                      <button type="button" className="eq-log-btn" onClick={(e) => { e.stopPropagation(); setQuickLogTarget({ asset, dateStr: todayStr }); }} title="Log a clean or skip for this equipment">+ Log</button>
                                    </div>
                                    <div className="data-cells">
                                      {timelineDays.map((d, di) => {
                                        const match = rowLogs && rowLogs.get(d.dateStr);
                                        return (
                                          <div key={di} className="completion-cell" style={{ width: dayColWidth, background: d.isToday ? BRAND.blueSoft : 'transparent' }} onDoubleClick={!match ? () => setQuickLogTarget({ asset, dateStr: d.dateStr }) : undefined} title={!match ? 'Double-click to log clean or skip on ' + d.dateStr : undefined}>
                                            {match ? <div className={`marker${match.via === 'text' ? ' marker-text' : ''}${match.file ? ' marker-file' : ''}`} data-testid={match.file ? 'marker-file' : undefined} tabIndex={match.file ? 0 : undefined} role={match.file ? 'button' : undefined} onKeyDown={match.file ? (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPaperwork(match); } } : undefined} onMouseEnter={(e) => { hoveredMarkerRef.current = e.currentTarget; setHoveredLog(match); }} onMouseLeave={() => { hoveredMarkerRef.current = null; setHoveredLog(null); }} onClick={match.file ? () => openPaperwork(match) : undefined}>{match.file ? <PaperclipIcon /> : null}</div> : <div className="marker-empty" />}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })}
                              {late && !planMode && (() => {
                                const hidden = pagedEquipment.filter(a => isFineRow(freqStatus.get(getAssetId(a)))).length;
                                return hidden > 0 ? <div className="fine-note" data-testid="fine-note">{hidden} row{hidden === 1 ? '' : 's'} hidden: done on time, or no frequency<button type="button" onClick={() => { setLate(false); setViewMsg('Showing every row'); refocusRef.current = 'view-late'; }}>Show all</button></div> : null;
                              })()}

                              {/* PER-AREA PAGINATION BUTTONS */}
                              {areaTotalPages > 1 && (
                                <div className="area-pagination-bar">
                                   <button className="page-btn" disabled={areaPageIndex === 0} onClick={() => updateAreaPage(ak, -1)}>Prev 10</button>
                                   <span style={{ fontSize: '10px' }}>Items {(areaPageIndex * 10) + 1} - {Math.min((areaPageIndex + 1) * 10, areaEquipment.length)} of {areaEquipment.length}</span>
                                   <button className="page-btn" disabled={areaPageIndex >= areaTotalPages - 1} onClick={() => updateAreaPage(ak, 1)}>Next 10</button>
                                </div>
                              )}
                            </>
                          )}
                        </React.Fragment>
                      );
                    })}
                  </React.Fragment>
                ))}
              </div>
            </div>

            {/* MAIN ROOM PAGINATION BAR */}
            {totalPages > 1 && (
                <div className="pagination-bar">
                    <button className="page-btn" disabled={currentPage === 0} onClick={() => setCurrentPage(p => p - 1)}><ChevronLeftIcon /> Previous Page</button>
                    <span>Rooms {currentPage + 1} of {totalPages}</span>
                    <button className="page-btn" disabled={currentPage >= totalPages - 1} onClick={() => setCurrentPage(p => p + 1)}>Next Page <ChevronRightLargeIcon /></button>
                </div>
            )}
          </main>
        )}
      </div>
    </div>
  );
}