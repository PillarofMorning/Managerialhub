        .cell-pct.part { text-decoration: underline dotted; text-underline-offset: 2px; }
        .cell-pct.today { background: ${BRAND.blueSoft}; }
        .cell-pct.open.today { color: #475569; }
        /* full mode, the production plan not in yet: the figures are drawn under the default rule, so they are dimmed */
        .plan-pending .pct-tile-num, .plan-pending .pct-tile-detail, .plan-pending .cell-pct, .plan-pending .comp-pct, .plan-pending .comp-amt, .plan-pending .comp-seg.small button i, .plan-pending .fchip i { opacity: 0.4; }
        .pct-tile { display: flex; flex-direction: column; gap: 4px; min-width: 300px; padding: 8px 14px; border: 1px solid #e2e8f0; border-left-width: 5px; border-radius: 10px; background: #fff; }
