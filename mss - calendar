                : <button className="sync-btn outline" data-testid="pct-ytd-readbtn" onClick={readYear} disabled={isLoading || isSaving || loadAllOn} title={`Reads the log for these equipment for every month of ${anchorYear === thisYear ? 'the year so far' : 'the year'}${completion.reachesPrev ? ' and the December before it' : ''}, in small paced requests (at most 3 at a time, 3 months each). It can take a while with thousands of equipment; Stop reading ends it and what has loaded stays.`}>{anchorYear === thisYear ? 'Read year to date' : 'Read the whole year'}</button>
