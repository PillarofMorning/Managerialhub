const fpDefaultCrews = () => [fpNewCrew(0, '12', false, false), fpNewCrew(1, '12', true, false), fpNewCrew(2, '12', false, true), fpNewCrew(3, '12', true, true)];
const fpMonday = (ymd) => { const d = dtParse(ymd); return d ? dtYmd(new Date(d.getFullYear(), d.getMonth(), d.getDate() - ((d.getDay() + 6) % 7))) : ''; };
const fpCycleIdx = (cycleStart, date) => {
  const a = dtParse(cycleStart), b = dtParse(date);
  if (!a || !b) return 0;
  const n = Math.round((Date.UTC(b.getFullYear(), b.getMonth(), b.getDate()) - Date.UTC(a.getFullYear(), a.getMonth(), a.getDate())) / 864e5);
  return ((n % 14) + 14) % 14;
};
const fpDefaults = (year) => ({ v: 1, defaultMin: 35, shiftHours: 12, share: 85, defaultPosType: 'support', positions: [], crews: fpDefaultCrews(), cycleStart: fpMonday(year + '-01-01') });
const fpClean = (o, year) => {
  const d = fpDefaults(year);
  if (!o || typeof o !== 'object') return d;
  const num = (v, lo, hi, def) => { const n = Number(v); return v === '' || v === null || v === undefined || !isFinite(n) ? def : Math.min(hi, Math.max(lo, n)); };
  const crews = Array.isArray(o.crews) ? o.crews.filter(c => c && typeof c === 'object').map((c, i) => ({
    id: safeString(c.id) || 'c' + i, name: safeString(c.name).slice(0, 20), kind: fpKind(c.kind).id, hours: num(c.hours, 1, 24, fpKind(c.kind).hours),
    start: Math.round(num(c.start, 0, 23, 6)), heads: Math.round(num(c.heads, 0, 999, 0)),
    mask: Array.isArray(c.mask) && c.mask.length === 14 ? c.mask.map(v => (v ? 1 : 0)) : fpKind(c.kind).mask.slice(),
    extra: { kind: c.extra && ['swat', 'swing'].indexOf(c.extra.kind) >= 0 ? c.extra.kind : 'none', heads: Math.round(num(c.extra && c.extra.heads, 0, 999, 0)) }
  })) : d.crews;
  const positions = Array.isArray(o.positions) ? o.positions.filter(p => p && typeof p === 'object').map(p => ({
    name: safeString(p.name).slice(0, 40), heads: Math.round(num(p.heads, 0, 99, 0)), type: p.type === 'ondemand' ? 'ondemand' : 'support'
  })) : [];
  return { v: 1, defaultMin: num(o.defaultMin, 1, 1440, 35), shiftHours: num(o.shiftHours, 1, 24, 12), share: num(o.share, 10, 100, 85),
    defaultPosType: o.defaultPosType === 'ondemand' ? 'ondemand' : 'support', positions: positions, crews: crews,
    cycleStart: /^\d{4}-\d{2}-\d{2}$/.test(safeString(o.cycleStart)) ? fpMonday(o.cycleStart) : d.cycleStart };
};
// One day's crew picture: hours the plan needs, the suggested crew (cleaners for those hours at the suggestion's shift length and
// cleaning share, plus the support positions), and what the crew builder has on the clock (cleaners from the crews that work that
// day, with their SWAT or swing crews, plus the support positions). short > 0: cleaners missing; onDemand: heads that can be called in.
const fpDayCrew = (setup, date, mins) => {
  const share = setup.share / 100;
  const hours = (mins || 0) / 60;
  const per = setup.shiftHours * share;
  const cleaners = hours > 0 && per > 0 ? Math.ceil(hours / per - 1e-9) : 0;
  const support = setup.positions.filter(p => p.type === 'support').reduce((t, p) => t + p.heads, 0);
  const onDemand = setup.positions.filter(p => p.type === 'ondemand').reduce((t, p) => t + p.heads, 0);
  const ix = fpCycleIdx(setup.cycleStart, date);
  let onHeads = 0, capacity = 0;
  const crews = [];
  setup.crews.forEach(c => {
    if (!c.mask[ix]) return;
    const h = c.heads + (c.extra.kind !== 'none' ? c.extra.heads : 0);
    onHeads += h;
    capacity += h * c.hours * share;
    if (h) crews.push(c.name || '?');
  });
  const shortHours = hours - capacity;
  const short = shortHours > 1e-6 && per > 0 ? Math.ceil(shortHours / per - 1e-9) : 0;
  const spare = shortHours < -1e-6 && per > 0 ? Math.floor(-shortHours / per + 1e-9) : 0;
  return { hours: hours, cleaners: cleaners, support: support, suggested: cleaners + support, onHeads: onHeads + support, capacity: capacity,
    short: short, spare: spare, onDemand: onDemand, crews: crews, built: setup.crews.some(c => c.heads > 0) };
};
// END FREQUENCY PLAN

// ============================================================================
// BEGIN COMPLETION SELECTION
// The Completion tab counts every equipment that has a cleaning frequency, except what was left out: a whole room, an area of a
// room, or one equipment. What is left out counts in no percentage (the two totals, the room, area and equipment figures of Top
// missed, and the daily and weekly rows under the day headers of the MSS in full mode). Saved in this browser (see the columns
// card for the Yes/No column that would share it). Room and area names are the ones the equipment rows carry ('[Unassigned
// Room]' / 'Unassigned Area' when blank), equipment is told apart by its id.
// ============================================================================
const EXCLUDED_KEY = 'mss_completion_excluded_v1';
const EX_SEP = String.fromCharCode(1);
const EX_MAX = 5000;                 // entries kept in each list; anything beyond is dropped
const exHas = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
const exEmpty = () => ({ rooms: {}, areas: {}, equipment: {} });
const exRoomOf = (a) => safeString(getProp(a, 'craa5_roomname')) || 'Unassigned Room';
const exAreaOf = (a) => safeString(getProp(a, 'craa5_areaname')) || 'Unassigned Area';
const exAreaKey = (room, area) => room + EX_SEP + area;
// What was stored, made safe to use: anything malformed is dropped.
const exClean = (raw) => {
  const out = exEmpty();
  if (!raw || typeof raw !== 'object') return out;
  const text = (v) => (typeof v === 'string' ? v.trim() : '');   // the same as safeString: a stored name must come back as the name the equipment rows carry
  (Array.isArray(raw.rooms) ? raw.rooms : []).slice(0, EX_MAX).forEach((r) => { const t = text(r); if (t) out.rooms[t] = true; });
  (Array.isArray(raw.areas) ? raw.areas : []).slice(0, EX_MAX).forEach((r) => { const a = text(r && r.area), b = text(r && r.room); if (a && b) out.areas[exAreaKey(b, a)] = true; });
  (Array.isArray(raw.equipment) ? raw.equipment : []).slice(0, EX_MAX).forEach((id) => { const t = typeof id === 'string' ? normalizeId(id).slice(0, 80) : ''; if (t) out.equipment[t] = true; });
  return out;
};
const exSerialize = (ex) => ({
  v: 1,
  rooms: Object.keys(ex.rooms),
  areas: Object.keys(ex.areas).map((k) => ({ room: k.split(EX_SEP)[0], area: k.split(EX_SEP)[1] })),
  equipment: Object.keys(ex.equipment)
});
const exLoad = () => {
  try { const raw = window.localStorage.getItem(EXCLUDED_KEY); return raw ? exClean(JSON.parse(raw)) : exEmpty(); } catch (e) { return exEmpty(); }
};
const exStore = (ex) => {
  try { window.localStorage.setItem(EXCLUDED_KEY, JSON.stringify(exSerialize(ex))); return true; } catch (e) { return false; }
};
const exCanStore = () => {
  try { const k = EXCLUDED_KEY + '_probe'; window.localStorage.setItem(k, '1'); window.localStorage.removeItem(k); return true; } catch (e) { return false; }
};
const exCount = (ex) => {
  const r = Object.keys(ex.rooms).length, a = Object.keys(ex.areas).length, e = Object.keys(ex.equipment).length;
  return { rooms: r, areas: a, equipment: e, total: r + a + e };
};
const exLeftOut = (ex, room, area, id) => exHas(ex.rooms, room) || exHas(ex.areas, exAreaKey(room, area)) || exHas(ex.equipment, id);
// One entry switched on or off (a new state each time).
const exToggle = (ex, kind, key) => {
  const next = { rooms: Object.assign({}, ex.rooms), areas: Object.assign({}, ex.areas), equipment: Object.assign({}, ex.equipment) };
  const map = next[kind];
  if (exHas(map, key)) delete map[key]; else map[key] = true;
  return next;
};
// The text for "N left out": "1 room, 2 areas and 5 equipment".
const exSummary = (c) => {
  const parts = [];
  if (c.rooms) parts.push(c.rooms + ' room' + (c.rooms === 1 ? '' : 's'));
  if (c.areas) parts.push(c.areas + ' area' + (c.areas === 1 ? '' : 's'));
  if (c.equipment) parts.push(c.equipment + ' equipment');
  return parts.length < 2 ? parts.join('') : parts.slice(0, -1).join(', ') + ' and ' + parts[parts.length - 1];
};

// What the Completion tab works from: the equipment that count (list), the groups each one belongs to (keys: its room, its
// area, itself), the facts about each (meta) and the tree of rooms and areas with how many equipment have a frequency and how
// many of those count. Equipment with no frequency are in the list (computeCompletion skips them) but not in the tree counts.
const buildCountList = (assets, ex) => {
  const list = [], keys = [], meta = [], rooms = new Map();
  let withFreq = 0;
  (assets || []).forEach((a) => {
    const id = getAssetId(a), room = exRoomOf(a), area = exAreaOf(a);
    const freqs = FREQS.filter((f) => f.flags.some((c) => isTrue(a[c]))).map((f) => f.code);
    let r = rooms.get(room);
    if (!r) { r = { room: room, total: 0, withFreq: 0, counted: 0, left: !!exHas(ex.rooms, room), areas: new Map() }; rooms.set(room, r); }
    let ar = r.areas.get(area);
    if (!ar) { ar = { area: area, room: room, total: 0, withFreq: 0, counted: 0, left: exHas(ex.areas, exAreaKey(room, area)) }; r.areas.set(area, ar); }
    r.total += 1; ar.total += 1;
    if (freqs.length) { r.withFreq += 1; ar.withFreq += 1; withFreq += 1; }
    if (exLeftOut(ex, room, area, id)) return;
    list.push(a);
    keys.push([figKey(room), figKey(room, area), 'e' + id]);
    meta.push({ id: id, name: safeString(getProp(a, 'craa5_equipmentidentifier')) || '(no name)', room: room, area: area, freqs: freqs });
    if (freqs.length) { r.counted += 1; ar.counted += 1; }
  });
  const tree = Array.from(rooms.values()).sort((x, y) => x.room.toLowerCase().localeCompare(y.room.toLowerCase())).map((r) => ({
    room: r.room, total: r.total, withFreq: r.withFreq, counted: r.counted, left: r.left,
    areas: Array.from(r.areas.values()).sort((x, y) => x.area.toLowerCase().localeCompare(y.area.toLowerCase()))
  }));
  return { list: list, keys: keys, meta: meta, tree: tree, withFreq: withFreq };
};

// ---- Top missed
// The figure of one group for one metric: 'tf' (the months on screen) or 'ytd' (the year so far), and for one frequency letter
// when code is given (only groups that keep their figures per letter, one equipment).
const missFigure = (b, metric, code) => {
  if (!b) return { due: 0, done: 0, miss: 0, pct: null };
  let due, done;
  if (code) {
    const c = b.f && b.f[code];
    due = c ? (metric === 'ytd' ? c.ytdDue : c.tfDue) : 0;
    done = c ? (metric === 'ytd' ? c.ytdDone : c.tfDone) : 0;
  } else {
    due = metric === 'ytd' ? b.ytd.due : b.tf.due;
    done = metric === 'ytd' ? b.ytd.done : b.tf.done;
  }
  return { due: due, done: done, miss: Math.max(0, due - done), pct: pctOf(done, due) };
};
// Most not done first; the lower percentage first on a tie, then by name. Groups with nothing not done are not "missed".
const missOrder = (a, b) => b.miss - a.miss || (a.pct === null ? 101 : a.pct) - (b.pct === null ? 101 : b.pct) || a.name.toLowerCase().localeCompare(b.name.toLowerCase());
// The rows of one lens ('equipment' | 'area' | 'room'), already ranked. scope narrows to a room (and an area); query matches names.
const missedRows = ({ comp, count, lens, metric, code, scope, query }) => {
  if (!comp || !count) return [];
  const q = (query || '').trim().toLowerCase();
  const inScope = (room, area) => !scope || ((!scope.room || scope.room === room) && (!scope.area || scope.area === area));
  const rows = [];
  if (lens === 'equipment') {
    count.meta.forEach((m) => {
      if (!inScope(m.room, m.area) || !m.freqs.length) return;
      if (code && m.freqs.indexOf(code) < 0) return;
      const b = comp.perKey['e' + m.id];
      if (!b) return;
      const f = missFigure(b, metric, code);
      if (f.miss <= 0) return;
      if (q && (m.name + ' ' + m.room + ' ' + m.area).toLowerCase().indexOf(q) < 0) return;
      rows.push({ kind: 'equipment', key: m.id, name: m.name, room: m.room, area: m.area, id: m.id, freqs: m.freqs, due: f.due, done: f.done, miss: f.miss, pct: f.pct, bucket: b });
    });
  } else {
    count.tree.forEach((r) => {
      if (lens === 'room') {
        if (scope && scope.room && scope.room !== r.room) return;
        const b = comp.perKey[figKey(r.room)];
        if (!b || !b.equipment) return;
        const f = missFigure(b, metric);
        if (f.miss <= 0 && (metric === 'ytd' ? b.readYtd : b.readTf) >= b.equipment) return;   // nothing missed and all read; unread rows stay (last) for their Read button
        if (q && r.room.toLowerCase().indexOf(q) < 0) return;
        rows.push({ kind: 'room', key: r.room, name: r.room, room: r.room, area: '', due: f.due, done: f.done, miss: f.miss, pct: f.pct, bucket: b });
      } else {
        r.areas.forEach((a) => {
          if (!inScope(a.room, a.area)) return;
          const b = comp.perKey[figKey(a.room, a.area)];
          if (!b || !b.equipment) return;
          const f = missFigure(b, metric);
          if (f.miss <= 0 && (metric === 'ytd' ? b.readYtd : b.readTf) >= b.equipment) return;
          if (q && (a.area + ' ' + a.room).toLowerCase().indexOf(q) < 0) return;
          rows.push({ kind: 'area', key: a.room + EX_SEP + a.area, name: a.area, room: a.room, area: a.area, due: f.due, done: f.done, miss: f.miss, pct: f.pct, bucket: b });
        });
      }
    });
  }
  return rows.sort(missOrder);
};
// Jobs not done per frequency letter among the equipment of the list: the scope and the find text applied, the letter filter not.
const missByLetter = ({ comp, count, metric, scope, query }) => {
  const out = {};
  FREQS.forEach((f) => { out[f.code] = 0; });
  if (!comp || !count) return out;
  const q = (query || '').trim().toLowerCase();
  count.meta.forEach((m) => {
    if (!m.freqs.length || (scope && ((scope.room && scope.room !== m.room) || (scope.area && scope.area !== m.area)))) return;
    const b = comp.perKey['e' + m.id];
    if (!b) return;
    if (q && (m.name + ' ' + m.room + ' ' + m.area).toLowerCase().indexOf(q) < 0) return;
    m.freqs.forEach((c) => { out[c] += missFigure(b, metric, c).miss; });
  });
  return out;
};
// What to tell the user when Dataverse refuses a write: a permission problem in plain words, a short message as it is, anything long
// or full of ids as "refused" (the raw text stays in a tooltip).
const freqErrorText = (raw) => {
  const t = String(raw || '').trim();
  if (/prvWrite|privilege|0x80040220|access is denied|unauthori[sz]ed|forbidden|not have permission/i.test(t)) return 'you do not have permission to change equipment (ask an administrator for write access)';
  if (!t || t.length > 120 || /[0-9a-f]{8}-[0-9a-f]{4}-/i.test(t)) return 'Dataverse refused the change';
  return t;
};

// ---- Frequency edits
// The Yes/No columns to write so that an equipment row has (true) or no longer has (false) each frequency in `want`
// ({ D: false, W: true }): a frequency is switched on in the first of its columns the table has (the one the row carries when
// it carries one), and switched off in every one of its columns that is true now.
const freqPatchFor = (asset, want) => {
  const patch = {}, problems = [];
  FREQS.forEach((f) => {
    if (want[f.code] === undefined) return;
    if (want[f.code]) {
      const live = f.flags.filter((c) => !missingAssetColumns.has(c));
      const col = live.filter((c) => exHas(asset, c))[0] || live[0];
      if (col) patch[col] = true; else problems.push('this table has no column for the ' + f.label.toLowerCase() + ' letter');
    } else {
      f.flags.forEach((c) => { if (isTrue(asset[c])) patch[c] = false; });
    }
  });
  return { patch: patch, problems: problems };
};
// Writes the changes three at a time; a failure leaves that equipment as it was and says why. items: [{ id, asset, want }].
const writeFreqChanges = async (items) => {
  const out = [];
  for (let i = 0; i < items.length; i += 3) {
    await Promise.all(items.slice(i, i + 3).map(async (it) => {
      const built = freqPatchFor(it.asset, it.want);
      if (built.problems.length) { out.push({ id: it.id, ok: false, error: built.problems[0] }); return; }
      if (!Object.keys(built.patch).length) { out.push({ id: it.id, ok: true, patch: {} }); return; }
      try {
        await getXrmWebApi().updateRecord('craa5_aa_assets', it.id, built.patch);
        out.push({ id: it.id, ok: true, patch: built.patch });
      } catch (err) {
        out.push({ id: it.id, ok: false, error: String(err && err.message ? err.message : err) });
      }
    }));
  }
  return out;
};
// END COMPLETION SELECTION

// Text fallback for logs whose equipment id is blank or matches no equipment row.
// Exact normalized name first, then a name contained in exactly one equipment name; when several
// equipment share a name ("Floors"), the log's own room and area text decides.
// Ambiguous names stay unmapped, so "Oven 1" can no longer swallow "Oven 12".
const buildTextIndex = (assets) => {
  const named = assets.map(a => ({
    id: getAssetId(a),
    norm: normalizeName(safeString(getProp(a, 'craa5_equipmentidentifier'))),
    where: `${normalizeName(safeString(getProp(a, 'craa5_roomname')))}|${normalizeName(safeString(getProp(a, 'craa5_areaname')))}`
  })).filter(a => a.id && a.norm);
  const byName = new Map();
  named.forEach(a => byName.set(a.norm, (byName.get(a.norm) || []).concat(a)));
  return { named, byName, ids: new Set(assets.map(getAssetId)) };
};

const computeTextLinks = (index, logs) => {
  const links = new Map();
  logs.forEach(log => {
    if (LOG_ASSET_ID_FIELDS.some(f => index.ids.has(normalizeId(getRaw(log, f))))) return; // matched by id
    const n = normalizeName(safeString(getProp(log, 'craa5_equipment')));
    if (!n) return;
    const where = `${normalizeName(safeString(getProp(log, 'craa5_room')))}|${normalizeName(safeString(getProp(log, 'craa5_area')))}`;
    const narrow = (list) => { if (list.length <= 1) return list; const same = list.filter(a => a.where === where); return same.length === 1 ? same : list; };
    const exact = narrow(index.byName.get(n) || []);
    if (exact.length === 1) { links.set(getLogKey(log), exact[0].id); return; }
    if (exact.length > 1 || n.length < 3) return;
    const loose = narrow(index.named.filter(a => a.norm.length >= 3 && (a.norm.includes(n) || n.includes(a.norm))));
    if (loose.length === 1) links.set(getLogKey(log), loose[0].id);
  });
  return links;
};

// --- LIVE DEVELOPER TELEMETRY & CROSS-APP BRIDGE ---
const DEV_LOG_MAX = 200;
let devLogSeq = 0;
const devLogBuffer = [];
const devLogListeners = new Set();
const pushDevLog = (category, entity, summary, status = 'OK', ms = 0, rows = 0, detail = '') => {
  const entry = {
    id: ++devLogSeq,
    ts: new Date().toISOString().slice(11, 23),
    iso: new Date().toISOString(),
    category: String(category || 'INFO'),
    entity: String(entity || '-'),
    summary: String(summary || ''),
    status: String(status || 'OK'),
    ms: Math.max(0, Math.round(Number(ms) || 0)),
    rows: Number(rows) || 0,
    detail: String(detail || '')
  };
  devLogBuffer.unshift(entry);
  if (devLogBuffer.length > DEV_LOG_MAX) devLogBuffer.length = DEV_LOG_MAX;
  devLogListeners.forEach(fn => { try { fn(devLogBuffer.slice()); } catch (_) { /* ignore */ } });
  return entry;
};
const clearDevLogs = () => {
  devLogBuffer.length = 0;
  devLogListeners.forEach(fn => { try { fn([]); } catch (_) { /* ignore */ } });
};

// Explicit write-back (never part of Sync): stores the equipment id on logs the text fallback linked,
// in craa5_equipmentguid, so the next load matches them by id. Updates run five at a time and a
// failure leaves that log text-matched.
const writeBackTextLinks = async (logs, links) => {
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const byKey = new Map(logs.map(l => [getLogKey(l), l]));
  const writtenKeys = [];
  let written = 0, failed = 0;
  const todo = Array.from(links).filter(([key]) => byKey.has(key) && normalizeId(getRaw(byKey.get(key), 'craa5__log_id')));
  for (let i = 0; i < todo.length; i += 5) {
    await Promise.all(todo.slice(i, i + 5).map(async ([key, assetId]) => {
      const log = byKey.get(key);
      try {
        await getXrmWebApi().updateRecord("craa5__log_", normalizeId(getRaw(log, 'craa5__log_id')), { [LOG_ASSET_ID_SELECT]: assetId });
        log[LOG_ASSET_ID_SELECT] = assetId;
        writtenKeys.push(key);
        written++;
      } catch (err) {
        failed++;
      }
    }));
  }
  const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
  pushDevLog('API-WRITE', 'craa5__log_', `Write-back ${written} text-matched equipment GUIDs`, failed ? 'WARN' : 'OK', ms, written, failed ? `${failed} failed` : 'All updated');
  return { writtenKeys, written, failed };
};

// --- ON-DEMAND LOADING ---
// There are thousands of pieces of equipment, so nothing here loads the whole log table. Sync loads the
// equipment directory (four small columns); logs are fetched only for the equipment rows and months
// currently on screen: by equipment id (the main path) and, for old entries whose id is blank or matches
// no equipment, by equipment name.
const LOG_CORE = "craa5__log_id,craa5_equipment,craa5_lastcleaned,craa5_lastcleanedby,craa5_nameofemployee,craa5_uid,statecode";
const LOG_CONTRACT_COLUMNS = ['craa5_shiftdate', 'craa5_cleankind', 'craa5_completionkey', 'craa5_laborminutes', 'craa5_markedby', 'craa5_source'];   // data contract 1.0; optional until Gerald adds them
// The paperwork picture is a Dataverse File column: the row carries only the file's id (in the column itself) and its
// name (in <column>_name); the bytes are read separately (downloadPaperwork) when a marker is clicked.
const LOG_FILE_COLUMN = 'craa5_pictureorfileofpaperwork';
const LOG_FILE_NAME_COLUMN = LOG_FILE_COLUMN + '_name';
const LOG_OPTIONAL = ["craa5_sap", "craa5_hoursworked", "craa5_room", "craa5_area", "craa5_idofssop", "craa5_bundle"].concat(LOG_TYPE_COLUMNS, [LOG_FILE_COLUMN, LOG_FILE_NAME_COLUMN], LOG_CONTRACT_COLUMNS); // each is dropped on its own if the table lacks it
const missingLogColumns = new Set();
const logSelect = (withId) => [LOG_CORE, ...LOG_OPTIONAL.filter(c => !missingLogColumns.has(c)), withId ? LOG_ASSET_ID_SELECT : ''].filter(Boolean).join(',');
const BUILD = 'v10 - data contract 1.0';    // shown under the title and on Payload Diagnostics so a pasted version can be told apart
const ASSET_CORE = "craa5_aa_assetsid,craa5_equipmentidentifier,craa5_roomname,craa5_areaname";
const ASSET_SAP_COLUMNS = ['craa5_uniqueid', 'craa5_sapshift', 'craa5_sapdaily', 'craa5_sapmidweek', 'craa5_sapw', 'craa5_sapbiweekly', 'craa5_sapmonthly', 'craa5_saptwomonth', 'craa5_sapquarterly', 'craa5_sapsixmonth', 'craa5_sapannual'];
const missingAssetColumns = new Set();   // frequency columns this equipment table turned out not to have
// Standard minutes for the Plan tab (contract section 7); dropped on their own like the frequency columns when the table lacks them.
const ASSET_PLAN_COLUMNS = ['craa5_hoursrequired', 'craa5_dailymin'];
const ASSET_OPT_COLUMNS = ASSET_FREQ_COLUMNS.concat(ASSET_PLAN_COLUMNS);
const assetSelect = () => [ASSET_CORE].concat(ASSET_OPT_COLUMNS.filter(c => !missingAssetColumns.has(c))).join(',');
const PAGE_SIZE = 1000;          // rows per Dataverse page
const ID_CHUNK = 15;             // equipment ids per log request
const NAME_CHUNK = 20;           // equipment names per log request
const MAX_PARALLEL_REQUESTS = 3; // log requests in flight at once
const MAX_ASSETS = 50000;        // safety cap; a truncated load is reported, never silent
const MAX_LOGS_PER_REQUEST = 20000;
const MODAL_PAGE_SIZE = 25;      // equipment rows per area in the focused dialog

const isMissingColumnError = (err) => /could not find a property|0x80060888|does not exist|invalid property/i.test(String(err && err.message));
const isGuid = (v) => /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);

// --- PAPERWORK (Dataverse File column) ---
// A log row says only that a file is attached (its id in the column, its name in <column>_name); the picture itself is
// read when the marker is clicked, through the Dataverse messages InitializeFileBlocksDownload + DownloadBlock (the
// app's own Xrm connection) and, failing that, GET .../craa5__log_s(id)/<column>/$value in 4 MB ranges.
const logFile = (log) => {
  const name = safeString(log[LOG_FILE_NAME_COLUMN]);   // exact column names, as logTypeBits: no case-insensitive key scan per row
  const fileId = safeString(log[LOG_FILE_COLUMN]);
  const rowId = normalizeId(getRaw(log, 'craa5__log_id'));
  return (name || fileId) && isGuid(rowId) ? { rowId, name: name || 'paperwork' } : null;
};
const PAPERWORK_CHUNK = 4194304;   // bytes per DownloadBlock / Range request
const EDM_STRING = { typeName: 'Edm.String', structuralProperty: 1 };
const EDM_INT64 = { typeName: 'Edm.Int64', structuralProperty: 1 };
// Xrm.WebApi.online.execute reads getMetadata from the request's prototype.
const xrmRequest = (name, params, types) => {
  const Req = function Req() {};
  Req.prototype.getMetadata = () => ({ boundParameter: null, parameterTypes: types, operationType: 0, operationName: name });
  const req = new Req();
  Object.keys(params).forEach(k => { req[k] = params[k]; });
  return req;
};
const readJson = async (res) => {
  if (!res) return {};
  if (typeof res.json === 'function') return (await res.json()) || {};
  return res;
};
const base64ToBytes = (b64) => {
  const bin = atob(String(b64 || '').replace(/\s/g, ''));
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
};
const mimeFromName = (name) => {
  const ext = String(name || '').toLowerCase().split('.').pop();
  return ({ png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', svg: 'image/svg+xml', heic: 'image/heic', pdf: 'application/pdf' })[ext] || '';
};
// The line under the file name in the popout: equipment - date - cleaned by - size.
const paperworkSubtitle = (pw) => {
  const log = pw.entry.log;
  const size = pw.size ? ` - ${pw.size >= 1048576 ? (pw.size / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(pw.size / 1024)) + ' KB'}` : '';
  return `${safeString(getProp(log, 'craa5_equipment'))} - ${logDay(log)}${log.craa5_lastcleanedby ? ` - ${log.craa5_lastcleanedby}` : ''}${size}`;
};
const downloadByBlocks = async (rowId) => {
  const webApi = getXrmWebApi();
  const exec = (req) => webApi.online.execute(req);
  const init = await readJson(await exec(xrmRequest('InitializeFileBlocksDownload',
    { Target: { '@odata.type': 'Microsoft.Dynamics.CRM.craa5__log_', craa5__log_id: rowId }, FileAttributeName: LOG_FILE_COLUMN },
    { Target: { typeName: 'mscrm.crmbaseentity', structuralProperty: 5 }, FileAttributeName: EDM_STRING })));
  const token = init.FileContinuationToken;
  const size = Number(init.FileSizeInBytes) || 0;
  if (!token) throw new Error('Dataverse did not start the file download');
  const block = init.IsChunkingSupported === false ? size : PAPERWORK_CHUNK;
  const parts = [];
  let got = 0;
  while (got < size) {
    const r = await readJson(await exec(xrmRequest('DownloadBlock', { Offset: got, BlockLength: Math.min(block, size - got), FileContinuationToken: token },
      { Offset: EDM_INT64, BlockLength: EDM_INT64, FileContinuationToken: EDM_STRING })));
    const bytes = base64ToBytes(r.Data);
    if (!bytes.length) throw new Error('Dataverse returned an empty part of the file');
    parts.push(bytes);
    got += bytes.length;
  }
  const type = mimeFromName(init.FileName);
  return { blob: new Blob(parts, { type: type || 'application/octet-stream' }), name: safeString(init.FileName), type };
};
const clientUrl = () => { try { const xrm = getXrm(); return String(xrm && xrm.Utility && xrm.Utility.getGlobalContext().getClientUrl() || '').replace(/\/+$/, ''); } catch (_) { return ''; } };
const downloadByValue = async (rowId) => {
  const url = `${clientUrl()}/api/data/v9.2/craa5__log_s(${rowId})/${LOG_FILE_COLUMN}/$value`;
  const get = async (range) => {
    const headers = { 'OData-MaxVersion': '4.0', 'OData-Version': '4.0' };
    if (range) headers.Range = range;
    const res = await fetch(url, { credentials: 'same-origin', headers });
    if (!res.ok) {
      let detail = '';
      try { const j = await res.json(); detail = j && j.error && j.error.message || ''; } catch (_) { /* no JSON body */ }
      throw new Error(detail || `the server answered ${res.status}`);
    }
    return res;
  };
  const first = await get(null);
  const name = safeString(first.headers.get('x-ms-file-name'));
  const type = safeString(first.headers.get('mimetype')) || mimeFromName(name) || safeString(first.headers.get('content-type')).split(';')[0];
  const parts = [await first.arrayBuffer()];
  const size = parseInt(first.headers.get('x-ms-file-size') || '0', 10) || 0;
  let got = parts[0].byteLength;
  if (first.status === 206 && size > got) {   // Dataverse sent the first range of a larger file: fetch the rest
    const chunk = parseInt(first.headers.get('x-ms-chunk-size') || '0', 10) || PAPERWORK_CHUNK;
    while (got < size) {
      const buf = await (await get(`bytes=${got}-${Math.min(size, got + chunk) - 1}`)).arrayBuffer();
      if (!buf.byteLength) throw new Error('Dataverse returned an empty part of the file');
      parts.push(buf);
      got += buf.byteLength;
    }
  }
  return { blob: new Blob(parts, { type: type || 'application/octet-stream' }), name, type };
};
const downloadPaperwork = async (rowId) => {
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  const webApi = getXrmWebApi();
  if (!webApi && !getXrm()) throw new Error('not connected to Dataverse');
  const errors = [];
  if (webApi && webApi.online && typeof webApi.online.execute === 'function') {
    try {
      const res = await downloadByBlocks(rowId);
      pushDevLog('FILE', 'craa5__log_', `Downloaded paperwork (${res.name || rowId})`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return res;
    } catch (err) { errors.push(String(err && err.message || err)); }
  }
  if (typeof fetch === 'function') {
    try {
      const res = await downloadByValue(rowId);
      pushDevLog('FILE', 'craa5__log_', `Downloaded paperwork via HTTP (${res.name || rowId})`, 'OK', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 1);
      return res;
    } catch (err) { errors.push(String(err && err.message || err)); }
  }
  const msg = errors.length ? Array.from(new Set(errors)).join(' - ') : 'this app has no way to download files';
  pushDevLog('ERROR', 'craa5__log_', `Paperwork download failed (${rowId})`, 'ERR', (typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0, 0, msg);
  throw new Error(msg);
};
// OData string literal: quotes doubled, then percent-encoded. Xrm.WebApi sends the query as given and Microsoft
// says special characters (& # + % , / : ; = ? @ $) must be encoded; encodeURIComponent keeps the doubled quotes.
// Lone surrogates (a half emoji from a bad import) make encodeURIComponent throw, so they become U+FFFD first.
const odataString = (v) => encodeURIComponent(Array.from(String(v).replace(/'/g, "''"), ch => (ch.length === 1 && ch.charCodeAt(0) >= 0xD800 && ch.charCodeAt(0) <= 0xDFFF) ? '?' : ch).join(''));
// "Gyro Mixer (+)" -> "Gyro Mixer": a log may carry the name without the trailing note in brackets.
const nameBase = (name) => { let n = String(name || '').trim(); let prev; do { prev = n; n = n.replace(/\s*\([^)]*\)\s*$/, '').trim(); } while (n !== prev); return n; };

const retrievePaged = async (entity, query, maxRows, pageSize = PAGE_SIZE) => {
  const t0 = typeof performance !== 'undefined' ? performance.now() : Date.now();
  try {
    const webApi = getXrmWebApi();
    if (!webApi) throw new Error('Dataverse WebApi is not connected');
    let res = await webApi.retrieveMultipleRecords(entity, query, pageSize);
    let rows = res.entities || [];
    while (res.nextLink && rows.length < maxRows) {
      res = await webApi.retrieveMultipleRecords(entity, "?" + res.nextLink.split("?")[1], pageSize);
      rows = rows.concat(res.entities || []);
    }
    const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
    pushDevLog('API-READ', entity, query ? query.slice(0, 140) : '(all)', 'OK', ms, rows.length, res.nextLink ? 'Truncated at maxRows' : '');
    return { rows, truncated: !!res.nextLink };
  } catch (err) {
    const ms = Math.round((typeof performance !== 'undefined' ? performance.now() : Date.now()) - t0);
    pushDevLog('ERROR', entity, query ? query.slice(0, 140) : '(all)', 'ERR', ms, 0, String(err && err.message || err));
    throw err;
  }
};

// --- PRODUCTION PLAN (craa5__aa_prd_schd) ---
// The runs the Production Schedule hub saves; the gaps between a line's runs are its sanitation windows (see LINE RULES).
// Read only, never written. One request per year on screen (a week more on each side so no week is cut short), in pages, after
// Sync and when the Line Downtime tab is opened; a failed read is reported and the figures keep the plain rule.
const PLAN_TABLE = 'craa5__aa_prd_schd';
const PLAN_COLUMNS = ['craa5_area', 'craa5_line', 'craa5_datestarttime', 'craa5_dateendtime'];
const PLAN_OPTIONAL = ['craa5_product'];     // dropped on its own if the table lacks it: a maintenance run then counts as production
const MAX_PLAN_ROWS = 20000;                 // safety cap; a truncated read is reported, never silent
const PLAN_PAGE_SIZE = 5000;                 // the most rows Dataverse sends in a page: a year of runs is a handful of requests
const missingPlanColumns = new Set();

// The Dataverse columns this page reads or writes, listed on the Payload Diagnostics tab so a missing one can be created.
// [column, need, what it is for]; need: 'required' (nothing works without it), 'optional' (dropped on its own when the table
// lacks it, the page works with less), 'written' (the page also writes it), 'wanted' (not used yet: it would make the page better).
const freqLabel = (c) => { const f = FREQS.filter(x => x.flags.indexOf(c) > -1)[0]; return f ? f.label.toLowerCase() : c; };
const DV_COLUMN_GROUPS = [
  { id: 'assets', table: 'craa5_aa_assets', title: 'Equipment', cols: [
    ['craa5_aa_assetsid', 'required', 'the equipment id the log entries point at'],
    ['craa5_equipmentidentifier', 'required', 'the equipment name'],
    ['craa5_roomname', 'required', 'its room'],
    ['craa5_areaname', 'required', 'its area']
  ].concat(ASSET_FREQ_COLUMNS.map(c => [c, 'written', 'Yes/No: has a ' + freqLabel(c) + ' cleaning (the medallion and the jobs); the Completion tab writes it when you change a frequency'])) },
  { id: 'log', table: 'craa5__log_', title: 'MSS log', cols: [
    ['craa5__log_id', 'required', 'the log row (also where a paperwork picture is read from)'],
    ['craa5_equipment', 'required', 'the equipment name typed on the entry (text matching of old entries)'],
    ['craa5_lastcleaned', 'required', 'the date of the clean'],
    ['craa5_lastcleanedby', 'required', 'who cleaned'],
    ['craa5_nameofemployee', 'required', 'the employee'],
    ['craa5_uid', 'required', 'the entry id'],
    [LOG_ASSET_ID_SELECT, 'written', 'the equipment id: entries are matched to equipment by it, and Save text matches writes it'],
    ['craa5_sap', 'optional', 'the SAP order (shown in the tooltip)'],
    ['craa5_hoursworked', 'optional', 'the hours (shown in the tooltip)'],
    ['craa5_room', 'optional', 'the room on the entry (tells same-named equipment apart)'],
    ['craa5_area', 'optional', 'the area on the entry (tells same-named equipment apart)'],
    ['craa5_daily', 'optional', 'Yes/No: the entry was a daily clean (the medallion and the jobs)'],
    ['craa5_weekly', 'optional', 'Yes/No: a weekly clean'],
    ['craa5_monthly', 'optional', 'Yes/No: a monthly clean'],
    [LOG_FILE_COLUMN, 'optional', 'the paperwork picture (a File column)'],
    [LOG_FILE_NAME_COLUMN, 'optional', 'the file name of that picture']
  ] },
  { id: 'plan', table: PLAN_TABLE, title: 'Production plan', cols: [
    ['craa5_area', 'required', 'the production area of a run (the line is the area plus its line number)'],
    ['craa5_line', 'required', 'the line number (blank counts as line 1)'],
    ['craa5_datestarttime', 'required', 'when the run starts'],
    ['craa5_dateendtime', 'required', 'when the run ends; the gaps between runs are the sanitation windows'],
    ['craa5_product', 'optional', 'the product; a maintenance run is told from production by it']
  ] }
];
const planIso = (ms) => new Date(ms).toISOString().replace(/\.\d{3}Z$/, 'Z');   // the format the Production Schedule hub filters with
// The Clean Plan's day and week rows for the same days as the plan (see CLEAN PLAN DAYS). A missing table or column is not an
// error for the figures: they keep the calendar's own rule, and the Line Downtime tab says why.
const readCleanPlanDays = async (year) => {
  const from = new Date(year, 0, 1 - (CAL_PAD_WEEKS * 7 + 8)).getTime(), to = new Date(year, 11, 31 + CAL_PAD_WEEKS * 7 + 9).getTime();
  const filter = `statecode eq 0 and (craa5_rowtype eq 'day' or craa5_rowtype eq 'week') and craa5_start ge ${planIso(from)} and craa5_start lt ${planIso(to)}`;
  return retrievePaged(CP_TABLE, `?$select=craa5_rowtype,craa5_plankey,craa5_day,craa5_area,craa5_cleankind,craa5_status,craa5_details&$filter=${filter}`, 60000, PLAN_PAGE_SIZE);
};
const readPlanRows = async (year) => {
  const from = new Date(year, 0, 1 - (CAL_PAD_WEEKS * 7 + 8)).getTime(), to = new Date(year, 11, 31 + CAL_PAD_WEEKS * 7 + 9).getTime();   // the year, and the weeks the line calendars are padded with
  const filter = `statecode eq 0 and craa5_datestarttime lt ${planIso(to)} and craa5_dateendtime gt ${planIso(from)}`;
  for (let attempt = 0; attempt <= PLAN_OPTIONAL.length; attempt++) {
    const select = PLAN_COLUMNS.concat(PLAN_OPTIONAL.filter(c => !missingPlanColumns.has(c))).join(',');
    try {
      return await retrievePaged(PLAN_TABLE, `?$select=${select}&$filter=${filter}&$orderby=craa5_datestarttime asc`, MAX_PLAN_ROWS, PLAN_PAGE_SIZE);
    } catch (err) {
      const msg = String(err && err.message);
      const bad = PLAN_OPTIONAL.filter(c => select.split(',').indexOf(c) > -1 && new RegExp(`\\b${c}\\b`, 'i').test(msg));
      if (!isMissingColumnError(err) || !bad.length) throw err;
      bad.forEach(c => missingPlanColumns.add(c));
    }
  }
  throw new Error('the plan table could not be read');
};

// Reads log rows; queryFor(select) builds the query. If Dataverse says an optional column does not exist,
// only that column is dropped (for the rest of the session, until the next Sync) and the request is retried,
// so requests that were already in flight with the old select recover too. Errors about any other column
// are thrown.
const retrieveLogs = async (queryFor, withId, maxRows) => {
  let style = dateStyle;
  let dateError = null;   // the first error of a request whose date filter was retried
  for (let attempt = 0; ; attempt++) {
    const select = logSelect(withId);
    try {
      const res = await retrievePaged("craa5__log_", queryFor(select, style), maxRows);
      if (style > dateStyle) dateStyle = style;   // a style that worked is kept for the next requests
      return res;
    } catch (err) {
      if (attempt > LOG_OPTIONAL.length + DATE_STYLES) throw dateError || err;
      if (!isMissingColumnError(err)) {
        // A rejected date filter is retried in the next style, per request: a failure that has another cause
        // (a bad name, throttling) never changes the style for everyone else.
        const hasDate = /craa5_lastcleaned ge/.test(decodeURIComponent(queryFor(select, style)));
        if (hasDate && isDateFilterError(err)) dateError = dateError || err;
        if (hasDate && isDateFilterError(err) && style < DATE_STYLES - 1) { style += 1; continue; }
        throw dateError || err;
      }
      const msg = String(err && err.message);
      const inSelect = LOG_OPTIONAL.filter(c => select.split(',').includes(c));
      let bad = inSelect.filter(c => new RegExp(`\\b${c}\\b`, 'i').test(msg));
      // The message names no property we asked for: drop the columns only the tooltip and the frequency check need.
      if (!bad.length && !new RegExp(`\\b(${[LOG_ASSET_ID_SELECT, ...LOG_CORE.split(',')].join('|')})\\b`, 'i').test(msg)) bad = inSelect.filter(c => c === 'craa5_sap' || c === 'craa5_hoursworked' || LOG_TYPE_COLUMNS.includes(c) || LOG_CONTRACT_COLUMNS.includes(c) || c === LOG_FILE_COLUMN || c === LOG_FILE_NAME_COLUMN);
      if (!bad.length) throw err;
      bad.forEach(c => missingLogColumns.add(c));
    }
  }
};

// The equipment directory: the four columns the matrix needs plus the frequency Yes/No columns. A frequency column
// Dataverse does not know is dropped (for the session, until the next Sync) and the request is retried.
const retrieveAssets = async () => {
  for (let attempt = 0; ; attempt++) {
    const select = assetSelect();
    try {
      return await retrievePaged("craa5_aa_assets", `?$select=${select}`, MAX_ASSETS);
    } catch (err) {
      if (attempt > ASSET_OPT_COLUMNS.length || !isMissingColumnError(err)) throw err;
      const msg = String(err && err.message);
      const inSelect = ASSET_OPT_COLUMNS.filter(c => select.split(',').includes(c));
      let bad = inSelect.filter(c => new RegExp(`\\b${c}\\b`, 'i').test(msg));
      if (!bad.length && !new RegExp(`\\b(${ASSET_CORE.split(',').join('|')})\\b`, 'i').test(msg)) bad = inSelect;   // names none of them: leave all of them out
      if (!bad.length) throw err;
      bad.forEach(c => missingAssetColumns.add(c));
    }
  }
};

// Date-only values are stored as midnight UTC, so the window is built in UTC. Style 0 is what the original
// calendar sent (quoted ISO datetimes). If Dataverse rejects it for this column, retrieveLogs moves on to
// an unquoted date, then an unquoted datetime, and keeps the first style that works.
let dateStyle = 0;
const DATE_STYLES = 3;
const monthsFilter = (year, firstMonth, lastMonth, style = dateStyle) => {
  const start = new Date(Date.UTC(year, firstMonth, 1));
  const end = new Date(Date.UTC(year, lastMonth + 1, 0, 23, 59, 59));
  const lit = [
    (d) => `'${d.toISOString()}'`,
    (d) => d.toISOString().slice(0, 10),
    (d) => d.toISOString().slice(0, 19) + 'Z'
  ][style];
  return `craa5_lastcleaned ge ${lit(start)} and craa5_lastcleaned le ${lit(end)}`;
};
const isDateFilterError = (err) => /date|time|literal|operand|convert|parse|invalid|filter/i.test(String(err && err.message)) && !/429|throttl|exceeded the limit|time window|service protection|concurrent|too many|retry-after|timed? ?out|network|failed to fetch|unauthor|forbidden|privilege/i.test(String(err && err.message));

// Logs stored against these equipment ids in the given month run.
const fetchLogsForAssets = async (assetIds, year, firstMonth, lastMonth) => {
  const ids = assetIds.filter(isGuid);
  if (!ids.length) return { rows: [], truncated: false };
  const idFilter = ids.map(id => `${LOG_ASSET_ID_SELECT} eq '${id}'`).join(' or ');
  return retrieveLogs((select, style) => `?$select=${select}&$filter=(${idFilter}) and ${monthsFilter(year, firstMonth, lastMonth, style)}`, true, MAX_LOGS_PER_REQUEST);
};

// Logs whose equipment text equals one of these names (case-insensitive, exact: a prefix match would pull in
// "Oven 12" for "Oven 1") in the given month run. This is for old entries whose id is blank or matches no
// equipment: computeTextLinks links those afterwards on the client, and rows whose id matches equipment
// are left to the id path.
const fetchLogsByName = async (names, year, firstMonth, lastMonth, withId) => {
  if (!names.length) return { rows: [], truncated: false };
  const nameFilter = names.map(n => `craa5_equipment eq '${odataString(n)}'`).join(' or ');
  return retrieveLogs((select, style) => `?$select=${select}&$filter=(${nameFilter}) and ${monthsFilter(year, firstMonth, lastMonth, style)}`, withId, MAX_LOGS_PER_REQUEST);
};

// Contiguous runs of month indexes: [3,4,5,8] -> [[3,5],[8,8]].
const monthRuns = (months) => {
  const runs = [];
  months.slice().sort((a, b) => a - b).forEach(m => {
    const last = runs[runs.length - 1];
    if (last && m === last[1] + 1) last[1] = m; else runs.push([m, m]);
  });
  return runs;
};

const getWeekNumber = (d) => {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  date.setUTCDate(date.getUTCDate() + 4 - (date.getUTCDay() || 7));
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
};

const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

// The frequency medallion inside the equipment cell, right after the name: one letter per frequency set on the
// equipment, coloured by whether the last clean of that kind is within the frequency (green), overdue (red) or not
// read yet (grey, dotted).
const FreqMedallion = React.memo(({ st }) => {
  if (!st || st.state === 'none') return <span className="freq-pill none" data-testid="freq-pill" data-state="none" title={st && st.noName ? 'This equipment has no name and the log has no id column, so its log cannot be read.' : `No cleaning frequency set on this equipment${st && st.lastAny ? ` - last clean ${st.lastAny}` : ''}`}>-</span>;
  const lines = st.badges.map(b => `${b.label} (${b.code}): ${
    b.state === 'ok' ? `last clean ${b.last}, within ${b.days} day${b.days === 1 ? '' : 's'}`
    : b.state === 'overdue' ? `OVERDUE, no ${b.label.toLowerCase()} clean since ${b.start}${b.last ? ` (last ${b.last})` : ''}`
    : `not read yet, read ${fmtMonths(b.missing)} to check${b.last ? ` (last seen ${b.last})` : ''}`}`);
  return (
    <span className={`freq-pill ${st.state}`} data-testid="freq-pill" data-state={st.state} title={lines.join('\n')}>
