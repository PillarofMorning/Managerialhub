// --- HELPERS ---

const getProp = (obj, targetKey) => {
  if (!obj || !targetKey) return null;
  const lowerTarget = targetKey.toLowerCase();
  const formattedKey = `${targetKey}@OData.Community.Display.V1.FormattedValue`;
  if (obj[formattedKey] !== undefined) return obj[formattedKey];
  const internalFormattedKey = `_${targetKey}_value@OData.Community.Display.V1.FormattedValue`;
  if (obj[internalFormattedKey] !== undefined) return obj[internalFormattedKey];
  if (obj[targetKey] !== undefined) {
    const val = obj[targetKey];
    if (val && typeof val === 'object' && val.name) return val.name;
    return val;
  }
  const foundKey = Object.keys(obj).find(k => k.toLowerCase() === lowerTarget);
  if (foundKey) {
    const val = obj[foundKey];
    if (val && typeof val === 'object' && val.name) return val.name;
    return val;
  }
  return null;
};

const safeString = (val) => {
  if (val === null || val === undefined) return '';
  return String(val).trim();
};

const normalizeName = (s) => (s || "").toLowerCase().replace(/[^a-z0-9]/g, '');

const normalizeDateStr = (d) => {
  if (!d) return "";
  // craa5_lastcleaned is a date-only value that Dataverse returns as midnight UTC; read it as that
  // calendar day instead of shifting it into the viewer's timezone.
  if (typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
  const dateOnly = typeof d === 'string' && d.match(/^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.0+)?Z$/);
  if (dateOnly) return dateOnly[1];
  const dateObj = new Date(d);
  if (isNaN(dateObj.getTime())) return "";
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, '0');
  const day = String(dateObj.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

// --- ID-FIRST MATCHING ---
// Logs (craa5__log_) are attached to equipment by Dataverse id: craa5_equipmentguid holds the
// craa5_aa_assetsid of the equipment row in craa5_aa_assets. Text matching is only a fallback, for old
// entries whose id is blank or matches no equipment (see computeTextLinks).
const LOG_ASSET_ID_FIELDS = ['craa5_equipmentguid'];
const LOG_ASSET_ID_SELECT = 'craa5_equipmentguid';

const normalizeId = (v) => String(v === null || v === undefined ? '' : v).toLowerCase().replace(/[{}\s]/g, '');

// Raw column value (GUIDs), unlike getProp which prefers formatted display names.
const getRaw = (obj, key) => {
  if (!obj) return null;
  if (obj[key] !== undefined) return obj[key];
  const k = Object.keys(obj).find(x => x.toLowerCase() === key.toLowerCase());
  return k ? obj[k] : null;
};

const getAssetId = (asset) => normalizeId(getRaw(asset, 'craa5_aa_assetsid'));
const getLogKey = (log) => normalizeId(getRaw(log, 'craa5__log_id') || getRaw(log, 'craa5_uid')) ||
  `${normalizeName(safeString(getProp(log, 'craa5_equipment')))}|${normalizeDateStr(getRaw(log, 'craa5_lastcleaned'))}`;

// Builds { byAsset: Map<assetId, Map<dateStr, {log, via}>>, unmapped, stats }.
// textLinks (Map<logKey, assetId>) holds the text fallback, computed once when a log is loaded.
const buildCompletionIndex = (assets, logs, textLinks) => {
  const assetIds = new Set(assets.map(getAssetId));
  const byAsset = new Map();
  const unmapped = [];
  const stats = { id: 0, text: 0, unmapped: 0, duplicate: 0 };  // id + text + unmapped + duplicate = distinct logs
  const seen = new Set();

  logs.forEach(log => {
    const key = getLogKey(log);
    if (seen.has(key)) return;
    seen.add(key);

    let assetId = null;
    let via = null;
    for (const f of LOG_ASSET_ID_FIELDS) {
      const v = normalizeId(getRaw(log, f));
      if (v && assetIds.has(v)) { assetId = v; via = 'id'; break; }
    }
    if (!assetId && textLinks && textLinks.has(key) && assetIds.has(textLinks.get(key))) {
      assetId = textLinks.get(key);
      via = 'text';
    }
    if (!assetId) { unmapped.push(log); stats.unmapped++; return; }

    const date = normalizeDateStr(getRaw(log, 'craa5_lastcleaned'));
    if (!date) { unmapped.push(log); stats.unmapped++; return; }
    if (!byAsset.has(assetId)) byAsset.set(assetId, new Map());
    const days = byAsset.get(assetId);
    const existing = days.get(date);
    // One marker per equipment and day: the loser is counted as a duplicate, not silently dropped.
    if (existing && existing.via === 'id' && via === 'text') { stats.duplicate++; return; }
    if (existing) { stats[existing.via]--; stats.duplicate++; }
    days.set(date, { log, via });
    stats[via]++;
  });
  return { byAsset, unmapped, stats };
};

// Text fallback for logs whose equipment id is blank or matches no equipment row.
// Exact normalized name first, then a name contained in exactly one equipment name; when several
// equipment share a name ("Floors"), the log's own room and area text decides.
// Ambiguous names stay unmapped, so "Oven 1" can no longer swallow "Oven 12".
const buildTextIndex = (assets) => {
  const named = assets.map(a => ({
    id: getAssetId(a),
    norm: normalizeName(safeString(getProp(a, 'craa5_equipmentidentifier'))),
    where: `${normalizeName(safeString(getProp(a, 'craa5_roomname')))}|${normalizeName(safeString(getProp(a, 'craa5_areaname')))}`
  })).filter(a => a.id && a.norm);
  const byName = new Map();
  named.forEach(a => byName.set(a.norm, (byName.get(a.norm) || []).concat(a)));
  return { named, byName, ids: new Set(assets.map(getAssetId)) };
};

const computeTextLinks = (index, logs) => {
  const links = new Map();
  logs.forEach(log => {
    if (LOG_ASSET_ID_FIELDS.some(f => index.ids.has(normalizeId(getRaw(log, f))))) return; // matched by id
    const n = normalizeName(safeString(getProp(log, 'craa5_equipment')));
    if (!n) return;
    const where = `${normalizeName(safeString(getProp(log, 'craa5_room')))}|${normalizeName(safeString(getProp(log, 'craa5_area')))}`;
    const narrow = (list) => { if (list.length <= 1) return list; const same = list.filter(a => a.where === where); return same.length === 1 ? same : list; };
    const exact = narrow(index.byName.get(n) || []);
    if (exact.length === 1) { links.set(getLogKey(log), exact[0].id); return; }
    if (exact.length > 1 || n.length < 3) return;
    const loose = narrow(index.named.filter(a => a.norm.length >= 3 && (a.norm.includes(n) || n.includes(a.norm))));
    if (loose.length === 1) links.set(getLogKey(log), loose[0].id);
  });
  return links;
};

// Explicit write-back (never part of Sync): stores the equipment id on logs the text fallback linked,
// in craa5_equipmentguid, so the next load matches them by id. Updates run five at a time and a
// failure leaves that log text-matched.
const writeBackTextLinks = async (logs, links) => {
  const byKey = new Map(logs.map(l => [getLogKey(l), l]));
  const remaining = new Map(links);
  let written = 0, failed = 0;
  const todo = [...links].filter(([key]) => byKey.has(key) && normalizeId(getRaw(byKey.get(key), 'craa5__log_id')));
  for (let i = 0; i < todo.length; i += 5) {
    await Promise.all(todo.slice(i, i + 5).map(async ([key, assetId]) => {
      const log = byKey.get(key);
      try {
        await Xrm.WebApi.updateRecord("craa5__log_", normalizeId(getRaw(log, 'craa5__log_id')), { [LOG_ASSET_ID_SELECT]: assetId });
        log[LOG_ASSET_ID_SELECT] = assetId;
        remaining.delete(key);
        written++;
      } catch (err) {
        failed++;
      }
    }));
  }
  return { remaining, written, failed };
};

// --- ON-DEMAND LOADING ---
// There are thousands of pieces of equipment, so nothing here loads the whole log table. Sync loads the
// equipment directory (four small columns); logs are fetched only for the equipment rows and months
// currently on screen: by equipment id (the main path) and, for old entries whose id is blank or matches
// no equipment, by equipment name.
const LOG_CORE = "craa5__log_id,craa5_equipment,craa5_lastcleaned,craa5_lastcleanedby,craa5_nameofemployee,craa5_uid";
const LOG_OPTIONAL = "craa5_sap,craa5_hoursworked,craa5_room,craa5_area"; // dropped if the table lacks one of them
const logColumns = { optional: true };
const logSelect = (withId) => [LOG_CORE, logColumns.optional ? LOG_OPTIONAL : '', withId ? LOG_ASSET_ID_SELECT : ''].filter(Boolean).join(',');
const ASSET_SELECT = "craa5_aa_assetsid,craa5_equipmentidentifier,craa5_roomname,craa5_areaname";
const PAGE_SIZE = 1000;          // rows per Dataverse page
const ID_CHUNK = 15;             // equipment ids per log request
const NAME_CHUNK = 20;           // equipment names per log request
const MAX_PARALLEL_REQUESTS = 3; // log requests in flight at once
const MAX_ASSETS = 50000;        // safety cap; a truncated load is reported, never silent
const MAX_LOGS_PER_REQUEST = 20000;
const MODAL_PAGE_SIZE = 25;      // equipment rows per area in the focused dialog

const isMissingColumnError = (err) => /could not find a property|0x80060888|does not exist|invalid property/i.test(String(err && err.message));
const isGuid = (v) => /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);
// Quote-escape, and percent-encode the characters that would otherwise cut the query string short.
const odataString = (v) => String(v).replace(/'/g, "''").replace(/%/g, '%25').replace(/&/g, '%26').replace(/#/g, '%23').replace(/\+/g, '%2B');
// "Gyro Mixer (+)" -> "Gyro Mixer": a log may carry the name without the trailing note in brackets.
const nameBase = (name) => { let n = String(name || '').trim(); let prev; do { prev = n; n = n.replace(/\s*\([^)]*\)\s*$/, '').trim(); } while (n !== prev); return n; };

const retrievePaged = async (entity, query, maxRows) => {
  let res = await Xrm.WebApi.retrieveMultipleRecords(entity, query, PAGE_SIZE);
  let rows = res.entities || [];
  while (res.nextLink && rows.length < maxRows) {
    res = await Xrm.WebApi.retrieveMultipleRecords(entity, "?" + res.nextLink.split("?")[1], PAGE_SIZE);
    rows = rows.concat(res.entities || []);
  }
  return { rows, truncated: !!res.nextLink };
};

// Reads log rows; queryFor(select) builds the query. If Dataverse says one of the optional columns does not
// exist, they are dropped for the rest of the session (tooltip details only) instead of failing every load.
const retrieveLogs = async (queryFor, withId, maxRows) => {
  try {
    return await retrievePaged("craa5__log_", queryFor(logSelect(withId)), maxRows);
  } catch (err) {
    if (!logColumns.optional || !isMissingColumnError(err) || new RegExp(LOG_ASSET_ID_SELECT, 'i').test(String(err.message))) throw err;
    logColumns.optional = false;
    return retrievePaged("craa5__log_", queryFor(logSelect(withId)), maxRows);
  }
};

// Date-only values are stored as midnight UTC, so the window is built in UTC.
const monthsFilter = (year, firstMonth, lastMonth) => {
  const start = new Date(Date.UTC(year, firstMonth, 1)).toISOString();
  const end = new Date(Date.UTC(year, lastMonth + 1, 0, 23, 59, 59)).toISOString();
  return `craa5_lastcleaned ge '${start}' and craa5_lastcleaned le '${end}'`;
};

// Logs stored against these equipment ids in the given month run.
const fetchLogsForAssets = async (assetIds, year, firstMonth, lastMonth) => {
  const ids = assetIds.filter(isGuid);
  if (!ids.length) return { rows: [], truncated: false };
  const idFilter = ids.map(id => `${LOG_ASSET_ID_SELECT} eq '${id}'`).join(' or ');
  return retrieveLogs(select => `?$select=${select}&$filter=(${idFilter}) and ${monthsFilter(year, firstMonth, lastMonth)}`, true, MAX_LOGS_PER_REQUEST);
};

// Logs whose equipment text equals one of these names (case-insensitive, exact: a prefix match would pull in
// "Oven 12" for "Oven 1") in the given month run. This is for old entries whose id is blank or matches no
// equipment: computeTextLinks links those afterwards on the client, and rows whose id matches equipment
// are left to the id path.
const fetchLogsByName = async (names, year, firstMonth, lastMonth, withId) => {
  if (!names.length) return { rows: [], truncated: false };
  const nameFilter = names.map(n => `craa5_equipment eq '${odataString(n)}'`).join(' or ');
  return retrieveLogs(select => `?$select=${select}&$filter=(${nameFilter}) and ${monthsFilter(year, firstMonth, lastMonth)}`, withId, MAX_LOGS_PER_REQUEST);
};

// Contiguous runs of month indexes: [3,4,5,8] -> [[3,5],[8,8]].
const monthRuns = (months) => {
  const runs = [];
  [...months].sort((a, b) => a - b).forEach(m => {
    const last = runs[runs.length - 1];
    if (last && m === last[1] + 1) last[1] = m; else runs.push([m, m]);
  });
  return runs;
};

const getWeekNumber = (d) => {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  date.setUTCDate(date.getUTCDate() + 4 - (date.getUTCDay() || 7));
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
};

