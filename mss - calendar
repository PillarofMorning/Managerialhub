                    {areaSeries.slice(0, 8).map((a, idx) => {
                      const count = Math.min(8, areaSeries.length);
                      const colStep = c3PlotW / Math.max(1, count);
                      const pairW = Math.min(48, colStep * 0.68);
                      const singleW = (pairW - 4) / 2;
                      const x0 = c3PadL + idx * colStep + (colStep - pairW) / 2;

