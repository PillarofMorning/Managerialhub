              </section>
            </div>

            <div className="graphs-two-col">
              {/* CHART 3: AREA WEEKLY SANITATION HOURS VS SCHEDULED LINE DOWNTIME WINDOW */}
              <section className="exec-card" data-testid="chart-area-fit">
                <div className="exec-card-head">
                  <div>
                    <h3 className="exec-card-title">3. Area Weekly Sanitation Demand vs. Scheduled Line Downtime Window</h3>
