        .pct-tile.warn .pct-tile-num { color: #92400e; }
        .pct-tile.bad .pct-tile-num { color: #9f1239; }
        .pct-tile-detail { display: flex; flex-direction: column; gap: 2px; font-size: 11px; font-weight: 600; color: #475569; }
        .pct-partial { color: #b45309; }
        .pct-miss { color: #9f1239; font-weight: 800; }
        /* COMPLETION TAB */
        .comp-main { flex: 1; min-height: 0; overflow: auto; padding: 24px clamp(16px, 3vw, 32px); background: #F7F9FC; }
        .comp-wrap { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
        .comp-tiles { display: flex; gap: 12px; flex-wrap: wrap; }
        .comp-tiles .pct-tile { flex: 1 1 320px; background: #fff; }
        .comp-card { padding: 16px 18px; }
        .comp-card-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 8px; }
