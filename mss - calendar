        const id = normalizeId(getRaw(l, LOG_ASSET_ID_SELECT));
        const asset = id ? assetsById.get(id) : null;
        return { l, id, asset, state: !id ? 'no id' : asset ? 'matches equipment' : 'matches no equipment' };
      });
      if (my !== diagSeqRef.current.check) return;
      setLogCheck({ count: rows.length, noId: sample.filter(r => r.state === 'no id').length, matched: sample.filter(r => r.asset).length, orphan: sample.filter(r => r.state === 'matches no equipment').length, sample, idColumn });
    } catch (err) {
