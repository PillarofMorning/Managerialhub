        .comp-who b { font-size: 13px; color: #1F2937; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .comp-who i { font-style: normal; font-size: 11px; color: #64748b; }
        .comp-pct { min-width: 46px; font-size: 14px; font-weight: 900; color: #64748b; text-align: right; }
        .comp-pct.good { color: #15803d; }
        .comp-pct.warn { color: #92400e; }
        .comp-pct.bad { color: #9f1239; }
        .comp-amt { font-size: 12px; color: #475569; width: 210px; }
        .comp-amt b { color: #9f1239; }
