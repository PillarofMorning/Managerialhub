        .comp-find:focus-within { border-color: ${BRAND.blue}; box-shadow: 0 0 0 3px rgba(0,114,206,0.15); }
        .comp-list { list-style: none; margin: 0; padding: 0; }
        .comp-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; padding: 9px 6px; border-top: 1px solid #eef2f7; }
        .comp-row.edited { background: ${BRAND.yellowSoft}; }
        .comp-rank { width: 26px; text-align: right; font-size: 12px; font-weight: 800; color: #94a3b8; flex-shrink: 0; }
