          <div className="comp-seg" role="group" aria-label="Manual Mode">
            <button type="button" className={mode === 'diagrams' ? 'on' : ''} onClick={() => setMode('diagrams')}>1. Annotated Diagrams</button>
            <button type="button" className={mode === 'walkthrough' ? 'on' : ''} onClick={() => setMode('walkthrough')}>2. Guided Walkthrough</button>
            <button type="button" className={mode === 'search' ? 'on' : ''} onClick={() => setMode('search')}>3. Search &amp; FAQ</button>
          </div>
        </div>

        {mode === 'diagrams' && (
          <div style={{ display: 'grid', gridTemplateColumns: 'minmax(220px, 280px) 1fr', gap: 16, alignItems: 'start' }}>
            <div className="diag-card" style={{ padding: 12, display: 'flex', flexDirection: 'column', gap: 6 }}>
              <h3>Manual Topics</h3>
              {HOW_TO_MANUAL_SECTIONS.map(s => (
                <button
                  key={s.id}
                  type="button"
                  className={s.id === activeSec.id ? 'sync-btn' : 'page-btn'}
                  style={{ textAlign: 'left', justifyContent: 'flex-start', whiteSpace: 'normal', lineHeight: 1.3 }}
                  onClick={() => setActiveId(s.id)}
                >
                  {s.title}
                </button>
              ))}
            </div>
            <div className="diag-card" style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 8 }}>
                <div>
                  <span className="dt-src">{activeSec.badge}</span>
                  <h3 style={{ fontSize: 16, marginTop: 6, marginBottom: 0 }}>{activeSec.title}</h3>
                </div>
                <button type="button" className="sync-btn yellow" onClick={() => onNavigateTab(activeSec.tabTarget)}>Open This Tab Now</button>
              </div>
              <p className="dt-note">{activeSec.summary}</p>
              {renderCalendarManualSvg(activeSec.id)}
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: 10 }}>
                {activeSec.steps.map(st => (
                  <div key={st.num} style={{ padding: 12, borderRadius: 10, border: '1px solid #e2e8f0', background: '#f8fafc' }}>
                    <div style={{ fontSize: 11, fontWeight: 900, color: BRAND.blue }}>STEP {st.num}: {st.title}</div>
                    <p style={{ margin: '6px 0 0', fontSize: 12, color: '#334155', lineHeight: 1.45 }}>{st.desc}</p>
                  </div>
                ))}
              </div>
              <div style={{ padding: '10px 14px', borderRadius: 8, background: BRAND.yellowSoft, borderLeft: `4px solid ${BRAND.yellow}`, fontSize: 12, color: '#1e293b' }}>
                <b>Pro Tip:</b> {activeSec.proTip}
              </div>
            </div>
          </div>
        )}

        {mode === 'walkthrough' && (
          <div className="diag-card" style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 10 }}>
              <span className="dt-src">Guided Step {walkIdx + 1} of {HOW_TO_MANUAL_SECTIONS.length}</span>
              <div style={{ display: 'flex', gap: 8 }}>
                <button type="button" className="page-btn" disabled={walkIdx === 0} onClick={() => setWalkIdx(i => Math.max(0, i - 1))}>Previous</button>
                <button type="button" className="page-btn" disabled={walkIdx >= HOW_TO_MANUAL_SECTIONS.length - 1} onClick={() => setWalkIdx(i => Math.min(HOW_TO_MANUAL_SECTIONS.length - 1, i + 1))}>Next</button>
                <button type="button" className="sync-btn yellow" onClick={() => onNavigateTab(walkSec.tabTarget)}>Try It Now</button>
              </div>
            </div>
            <h3 style={{ fontSize: 16, margin: 0 }}>{walkSec.title}</h3>
            <p className="dt-note">{walkSec.summary}</p>
            {renderCalendarManualSvg(walkSec.id)}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {walkSec.steps.map(st => (
                <div key={st.num} style={{ padding: '8px 12px', borderRadius: 8, background: '#f8fafc', border: '1px solid #e2e8f0', fontSize: 12 }}>
                  <b>{st.num}. {st.title}:</b> {st.desc}
                </div>
              ))}
            </div>
          </div>
        )}

        {mode === 'search' && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
