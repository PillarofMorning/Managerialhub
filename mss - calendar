    const hb = headBlocksRef.current, corner = cornerRef.current, vp = viewportRef.current;
    if (!hb || !corner || !vp) return;
    if (e.clientX < corner.getBoundingClientRect().right) { hideXh(); return; }
    const idx = Math.floor((e.clientX - hb.getBoundingClientRect().left) / dayColWidth);
    if (idx < 0 || idx >= timelineDays.length) { hideXh(); return; }
    const b = xhBodyRef.current, h = xhHeadRef.current;
    const hh = Math.max(0, vp.clientHeight - hdrTotal) + 'px';
    if (b && xhIdxRef.current >= 0 && b.style.height !== hh) b.style.height = hh;   // the grid grew or shrank under a resting pointer
    if (idx === xhIdxRef.current) return;
