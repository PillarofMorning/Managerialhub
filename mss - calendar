        .group-strip-today { position: absolute; top: 0; bottom: 0; background: ${BRAND.blueSoft}; }

        .data-cells { display: flex; }
        .completion-cell { flex-shrink: 0; border-right: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: center; }
        .marker { width: 14px; height: 14px; background: ${BRAND.green}; border-radius: 3px; cursor: help; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
        .marker-text { background: ${BRAND.yellow}; }
        .marker-file { display: flex; align-items: center; justify-content: center; color: #fff; cursor: pointer; }
        .marker-text.marker-file { color: #1e293b; }
        .marker-file svg { width: 10px; height: 10px; }
        .marker-file:hover { box-shadow: 0 0 0 2px rgba(0,114,206,0.4); }
        .marker-empty { width: 4px; height: 4px; background: #e2e8f0; border-radius: 50%; opacity: 0.5; }

        /* PAPERWORK POPOUT */
        .paper-overlay { z-index: 3000; }
        .paper-box { background: #fff; border-radius: 12px; display: flex; flex-direction: column; max-width: 92vw; max-height: 90vh; min-width: 360px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); overflow: hidden; font-family: ${BRAND_FONT}; }
        .paper-box .modal-header { gap: 16px; }
        .paper-box .modal-header h2, .paper-box .modal-header .brand-subtitle { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 60vw; }
        .paper-box:focus { outline: none; }
        .paper-body { flex: 1; min-height: 140px; overflow: auto; display: flex; align-items: center; justify-content: center; background: #0f172a; padding: 12px; color: #fff; font-size: 13px; }
        .paper-body img { max-width: 100%; max-height: calc(90vh - 120px); object-fit: contain; display: block; }
        .paper-body iframe { width: 88vw; max-width: 1000px; height: calc(90vh - 120px); border: 0; background: #fff; }
        .paper-note { background: #fff; color: #1e293b; border-radius: 8px; padding: 16px 20px; max-width: 480px; }
        .paper-link { color: ${BRAND.blue}; font-weight: 700; text-decoration: none; }
        .paper-link:hover { text-decoration: underline; }
        a.sync-btn { text-decoration: none; }

        .sync-btn { background: ${BRAND.blue}; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(0,114,206,0.25); font-family: inherit; white-space: nowrap; }
        .sync-btn:hover:not(:disabled) { background: ${BRAND.blueDark}; }
        .sync-btn:disabled { opacity: 0.6; cursor: default; }
        .sync-btn.outline { background: #fff; color: ${BRAND.blue}; border: 1px solid ${BRAND.blueLine}; box-shadow: none; }
        .sync-btn.outline:hover:not(:disabled) { background: ${BRAND.blueSoft}; }
        .sync-btn.yellow { background: ${BRAND.yellow}; color: ${BRAND.blueDark}; box-shadow: 0 4px 10px rgba(255,184,28,0.3); }
        .sync-btn.yellow:hover:not(:disabled) { background: #f0a800; }
        .sync-btn.slate { background: #64748b; box-shadow: none; }
        .sync-btn.slate:hover:not(:disabled) { background: #475569; }
        .progress-bar { position: absolute; bottom: -4px; left: 0; height: 4px; background: ${BRAND.blue}; transition: width 0.3s; z-index: 1000; }

        .slicer-bar { display: flex; background: #fff; border-bottom: 1px solid #e2e8f0; padding: 6px 16px; gap: 10px; min-height: 40px; align-items: center; flex-shrink: 0; }
        .slicer-months { display: flex; align-items: center; gap: 8px; flex: 1 1 0; min-width: 0; overflow-x: auto; scrollbar-width: none; padding: 4px; margin: -4px; }
        .slicer-months::-webkit-scrollbar { display: none; }
        .slicer-tools { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .month-chip { padding: 5px 14px; border-radius: 20px; font-family: inherit; background: #fff; font-size: 11px; font-weight: 800; cursor: pointer; border: 1px solid #e2e8f0; color: #64748b; transition: 0.2s; white-space: nowrap; letter-spacing: 0.04em; flex-shrink: 0; }
        .month-chip .ms { display: none; }
        .short .month-chip .mf, .month-chip.full-year .mf { display: none; }
        .short .month-chip .ms { display: inline; }
        .month-chip.full-year { background: #F7F9FC; border-style: dashed; }
        .month-chip:focus-visible, .vt-btn:focus-visible { outline: 2px solid ${BRAND.blueDark}; outline-offset: 2px; }
        .vt-btn { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; border-radius: 14px; border: 1px solid ${BRAND.blueLine}; background: #fff; color: ${BRAND.blue}; font-family: inherit; font-size: 10px; font-weight: 800; letter-spacing: 0.05em; white-space: nowrap; cursor: pointer; flex-shrink: 0; }
        .vt-btn:hover { background: ${BRAND.blueSoft}; }
        .vt-btn.on { background: ${BRAND.blue}; border-color: ${BRAND.blueDark}; color: #fff; box-shadow: inset 0 0 0 1px #fff; }
        .vt-n { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 9px; background: ${BRAND.red}; color: #fff; font-size: 10px; line-height: 16px; text-align: center; }
        .xh-wrap { position: sticky; top: ${hdrTotal}px; height: 0; z-index: 6; pointer-events: none; }
        .xh-body { position: absolute; top: 0; left: 0; display: none; width: ${dayColWidth}px; background: rgba(15, 23, 42, 0.05); box-shadow: inset 1px 0 0 rgba(0, 70, 139, 0.3), inset -1px 0 0 rgba(0, 70, 139, 0.3); will-change: transform; }
        .header-blocks { position: relative; }
        .xh-head { position: absolute; top: 0; bottom: 0; left: 0; display: none; width: ${dayColWidth}px; background: rgba(15, 23, 42, 0.05); box-shadow: inset 1px 0 0 rgba(0, 70, 139, 0.3), inset -1px 0 0 rgba(0, 70, 139, 0.3); pointer-events: none; z-index: 3; will-change: transform; }
        .fine-note { position: sticky; left: 0; z-index: 101; display: flex; align-items: center; gap: 10px; width: max-content; min-width: ${frozenWidth}px; padding: ${compact ? 3 : 6}px 16px 3px 60px; background: #fff; border-bottom: 1px solid #e2e8f0; font-size: 11px; font-weight: 700; color: #64748b; }
        .fine-note button { border: 1px solid ${BRAND.blueLine}; background: #fff; color: ${BRAND.blue}; border-radius: 6px; padding: 1px 8px; font-size: 10px; font-weight: 800; font-family: inherit; cursor: pointer; }
        .data-body .area-pagination-bar { position: sticky; left: 0; z-index: 101; }
        .month-chip:hover { border-color: ${BRAND.blueLine}; color: ${BRAND.blue}; }
        .month-chip.active { background: ${BRAND.blue}; color: white; border-color: ${BRAND.blue}; box-shadow: 0 4px 6px -1px rgba(0,114,206,0.3); }

        .viewport::-webkit-scrollbar { width: 14px; height: 14px; }
        .viewport::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; border: 4px solid white; }
        .viewport::-webkit-scrollbar-track { background: #f8fafc; }

        .tooltip { position: fixed; background: ${BRAND.blueDark}; color: #fff; padding: 10px; border-radius: 6px; font-size: 11px; z-index: 10000; pointer-events: none; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.4); border-left: 3px solid ${BRAND.yellow}; }
        .tooltip label { display: block; color: #b3d4f2; font-size: 9px; text-transform: uppercase; font-weight: 800; margin-bottom: 2px; }
        .tooltip p { margin: 0 0 6px 0; font-weight: 600; }

        .scope-action-icon { opacity: 0.4; transition: 0.2s; color: #94a3b8; padding: 4px; border-radius: 4px; }
        .scope-action-icon:hover { opacity: 1; background: ${BRAND.blueSoft}; color: ${BRAND.blue}; }

        /* PAGINATION BARS */
        .pagination-bar {
          display: flex; align-items: center; justify-content: center; gap: 20px;
          padding: ${compact ? 5 : 12}px; background: #f8fafc; border-top: 1px solid #e2e8f0;
          font-size: 12px; font-weight: bold;
        }
        .area-pagination-bar {
          display: flex; align-items: center; padding: ${compact ? 3 : 8}px 16px; background: ${BRAND.yellowSoft}; border-bottom: 1px solid #fde68a;
          width: max-content; min-width: ${frozenWidth}px; gap: 12px;
        }

        .page-btn { padding: 6px 14px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; transition: 0.1s; font-size: 11px; font-weight: bold; font-family: inherit; }
        .page-btn:hover:not(:disabled) { border-color: ${BRAND.blue}; color: ${BRAND.blue}; background: ${BRAND.blueSoft}; }
        .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

        /* DIAGNOSTICS */
        .diag-card { background: #fff; border: 1px solid #dbe3ee; border-radius: 12px; padding: 20px; box-shadow: 0 4px 12px -2px rgba(0,70,139,0.08); }
        .diag-card h3 { font-size: 12px; font-weight: 900; color: ${BRAND.blueDark}; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px; }
        .diag-card input { font-family: inherit; }

        /* LINE DOWNTIME */
        .dt-wrap { display: flex; flex-direction: column; gap: 14px; max-width: 1500px; }
        .dt-intro { margin: 0; max-width: 800px; font-size: 13px; line-height: 1.5; color: #475569; }
        .dt-add { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; width: 100%; max-width: 760px; }
        .dt-field { display: flex; flex-direction: column; gap: 4px; font-size: 10px; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; min-width: 0; }
        .dt-field.grow { flex: 1 1 260px; }
        .dt-field input { font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0; text-transform: none; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #1F2937; min-width: 0; }
        .dt-field input:focus { outline: none; border-color: ${BRAND.blue}; box-shadow: 0 0 0 3px rgba(0,114,206,0.15); }
        .dt-msg { flex: 1 0 100%; min-height: 17px; font-size: 12px; line-height: 17px; font-weight: 700; }
        .dt-msg.error { color: #b91c1c; }
        .dt-msg.ok { color: #15803d; }
        .dt-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
        .dt-label { margin-top: 4px; font-size: 10px; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: ${BRAND.blueDark}; }
        .dt-label span { margin-left: 6px; font-weight: 700; letter-spacing: 0; text-transform: none; color: #64748b; font-size: 11px; }
        .dt-label.inline { margin: 0; }
        .dt-range-text { min-width: 200px; text-align: center; font-size: 12px; font-weight: 800; color: ${BRAND.blueDark}; }
        .dt-legend { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 14px; margin-left: auto; font-size: 11px; font-weight: 700; color: #475569; }
        .dt-sw { display: inline-block; width: 14px; height: 14px; margin-right: 5px; border-radius: 4px; vertical-align: -2px; }
        .dt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; align-items: start; }
        .dt-card { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 16px; background: #fff; border: 1px solid #dbe3ee; border-radius: 12px; box-shadow: 0 4px 12px -2px rgba(0,70,139,0.08); }
        .dt-plan { display: flex; flex-direction: column; gap: 8px; max-width: 900px; }
        .dt-plan-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
        .dt-plan-head h3 { margin: 0; flex: none; }
        .dt-chip.ok { background: ${BRAND.greenSoft}; color: #166534; border: 1px solid ${BRAND.greenLine}; }
        .dt-chip.warn { background: ${BRAND.yellowSoft}; color: #92400e; border: 1px solid ${BRAND.yellow}; }
        .dt-chip.bad { background: ${BRAND.redSoft}; color: #991b1b; border: 1px solid #fca5a5; }
        .dt-src { flex: none; align-self: center; padding: 2px 10px; border-radius: 12px; background: ${BRAND.blueSoft}; border: 1px solid ${BRAND.blueLine}; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: ${BRAND.blueDark}; white-space: nowrap; }
        .dt-areas { display: flex; flex-wrap: wrap; gap: 6px; }
        .dt-area { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 2px 6px; padding: 3px 6px 3px 10px; border: 1px solid ${BRAND.blueLine}; border-radius: 12px; background: ${BRAND.blueSoft}; font-size: 12px; color: ${BRAND.blueDark}; }
        .dt-area b { font-weight: 800; overflow-wrap: anywhere; }
        .dt-area i { font-style: normal; font-weight: 600; color: #475569; }
        .dt-area em { font-style: normal; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #92400e; }
        .dt-area-form { display: flex; gap: 8px; }
        .dt-area-form input { flex: 1 1 120px; min-width: 0; font-family: inherit; font-size: 13px; font-weight: 600; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #1F2937; }
        .dt-area-form input:focus { outline: none; border-color: ${BRAND.blue}; box-shadow: 0 0 0 3px rgba(0,114,206,0.15); }
        .dt-area-form .sync-btn { padding: 7px 18px; }
        .dt-area.empty { border-color: #fca5a5; background: ${BRAND.redSoft}; color: #991b1b; }
        .dt-card-head { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px 10px; }
        .dt-card-head h3 { flex: 1 1 160px; min-width: 0; margin: 0; font-size: 14px; font-weight: 900; color: ${BRAND.blueDark}; overflow-wrap: anywhere; }
        .dt-chip { padding: 2px 10px; border-radius: 12px; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
        .dt-chip.run { background: #F1F5F9; color: #475569; }
        .dt-chip.down { background: ${BRAND.blueSoft}; color: ${BRAND.blueDark}; border: 1px solid ${BRAND.blueLine}; }
        .dt-link { flex: none; padding: 2px 4px; border: none; background: none; font-family: inherit; font-size: 11px; font-weight: 700; color: #64748b; cursor: pointer; text-decoration: underline; }
        .dt-link:hover { color: ${BRAND.red}; }
        .dt-confirm { flex: none; display: inline-flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 11px; font-weight: 700; color: #475569; }
        .page-btn.danger { color: #fff; background: ${BRAND.red}; border-color: ${BRAND.red}; }
        .page-btn.danger:hover:not(:disabled) { background: #b8001f; border-color: #b8001f; color: #fff; }
        .dt-days { display: flex; gap: 4px; }
        .dt-day { flex: 1 1 0; min-width: 0; padding: 8px 0; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #475569; font-family: inherit; font-size: 11px; font-weight: 800; cursor: pointer; transition: 0.1s; }
        .dt-day:hover { border-color: ${BRAND.blue}; color: ${BRAND.blue}; }
        .dt-day.on { background: ${BRAND.blue}; border-color: ${BRAND.blue}; color: #fff; box-shadow: 0 4px 10px rgba(0,114,206,0.25); }
        .dt-day:focus-visible, .dt-x:focus-visible, .dt-link:focus-visible { outline: 2px solid ${BRAND.blueDark}; outline-offset: 2px; }
        .dt-note { margin: 0; font-size: 12px; color: #475569; }
        .dt-hint { margin: 0; font-size: 11px; color: #64748b; }
        .dt-error { margin: 0; font-size: 12px; font-weight: 700; color: #b91c1c; }
        .dt-range-form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px; }
        .dt-range-form .dt-field { flex: 1 1 130px; }
        .dt-range-form .sync-btn { padding: 8px 18px; }
        .dt-ranges { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
        .dt-ranges li { display: flex; align-items: center; gap: 8px; padding: 4px 6px 4px 10px; border: 1px solid ${BRAND.yellow}; border-left-width: 4px; border-radius: 8px; background: ${BRAND.yellowSoft}; font-size: 12px; font-weight: 700; color: #1F2937; }
        .dt-ranges li.past { border-color: #e2e8f0; background: #F8FAFC; color: #64748b; }
        .dt-range-label { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
        .dt-range-n { flex: none; font-size: 11px; font-weight: 600; color: #475569; }
        .dt-x { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; border: none; border-radius: 6px; background: transparent; color: #64748b; cursor: pointer; }
        .dt-x:hover { background: #fff; color: ${BRAND.red}; }
        .dt-strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)) 34px; gap: 3px; margin-top: 4px; }
        .dt-strip-h { text-align: center; font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #64748b; }
        .dt-cell { display: flex; align-items: center; justify-content: center; height: 28px; border-radius: 6px; background: #F1F5F9; color: #475569; font-size: 11px; font-weight: 700; white-space: nowrap; }
        .dt-cell.first { font-size: 9px; }
        .dt-cell.sched { background: ${BRAND.blue}; color: #fff; }
        .dt-cell.off { background: ${BRAND.yellow}; color: ${BRAND.blueDark}; }
        .dt-cell.both { background: ${BRAND.blue}; color: #fff; box-shadow: inset 0 -5px 0 ${BRAND.yellow}; }
        .dt-cell.due { background: ${BRAND.blue}; color: #fff; }
        .dt-cell.due.wk { box-shadow: inset 0 -5px 0 ${BRAND.blueDark}; }
        .dt-cell.cov { background: ${BRAND.blueSoft}; color: ${BRAND.blueDark}; box-shadow: inset 0 0 0 1px ${BRAND.blue}; }
        .dt-cell.off.cov { background: ${BRAND.yellow}; color: ${BRAND.blueDark}; box-shadow: inset 0 0 0 2px ${BRAND.blue}; }
        .dt-cell.nop { background: #fff; color: #64748b; box-shadow: inset 0 0 0 1px #cbd5e1; }
        .dt-wk { display: flex; align-items: center; justify-content: center; height: 28px; border-radius: 6px; font-size: 12px; font-weight: 900; color: #475569; background: transparent; }
        .dt-wk.yes { color: #15803d; background: ${BRAND.greenSoft}; }
        .dt-wk.no { color: #64748b; }
        .dt-wk.nop { color: #64748b; box-shadow: inset 0 0 0 1px #cbd5e1; }
        .dt-cell.today { outline: 2px solid ${BRAND.blueDark}; outline-offset: 1px; font-weight: 900; }
        .dt-sw.due { background: ${BRAND.blue}; }
        .dt-sw.wk { background: ${BRAND.blue}; box-shadow: inset 0 -5px 0 ${BRAND.blueDark}; }
        .dt-sw.cov { background: ${BRAND.blueSoft}; box-shadow: inset 0 0 0 1px ${BRAND.blue}; }
        .dt-sw.nop { background: #fff; box-shadow: inset 0 0 0 1px #cbd5e1; }
        .dt-sw.sched { background: ${BRAND.blue}; }
        .dt-sw.off { background: ${BRAND.yellow}; }
        .dt-sw.both { background: ${BRAND.blue}; box-shadow: inset 0 -5px 0 ${BRAND.yellow}; }
        .dt-empty { font-size: 13px; color: #475569; }
        .dt-foot { margin: 0; font-size: 12px; font-weight: 700; color: #475569; }
        .dt-foot.warn { color: #b45309; }

        /* MODAL DIALOG */
        .modal-overlay {
          position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
          background: rgba(0, 70, 139, 0.55); z-index: 2000;
          display: flex; align-items: center; justify-content: center;
          padding: 20px;
        }
        .modal-content {
          background: #fff; border-radius: 12px; display: flex; flex-direction: column;
          width: 90vw; height: 85vh; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
          overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); font-family: ${BRAND_FONT};
        }
        .modal-maximized { width: 100vw; height: 100vh; border-radius: 0; padding: 0; }
        .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 4px solid ${BRAND.yellow}; background: #fff; }
        .modal-header h2 { font-size: 15px; font-weight: 900; color: ${BRAND.blueDark}; margin: 0; }

        .eq-log-btn { opacity: 0; border: 1px solid ${BRAND.blueLine}; background: #fff; color: ${BRAND.blue}; border-radius: 6px; padding: 1px 6px; font-size: 9px; font-weight: 800; cursor: pointer; font-family: inherit; flex-shrink: 0; line-height: 14px; transition: opacity 0.12s; }
        .asset-row:hover .eq-log-btn, .eq-log-btn:focus-visible { opacity: 1; }
        .eq-log-btn:hover { background: ${BRAND.blueSoft}; }
        .preset-select { border: 1px solid ${BRAND.blueLine}; background: ${BRAND.blueSoft}; color: ${BRAND.blueDark}; border-radius: 8px; padding: 5px 10px; font-size: 11px; font-weight: 800; font-family: inherit; cursor: pointer; max-width: 195px; }

        /* EXECUTIVE PRIORITIZATION BRIEF (VP OF QUALITY & VP OF OPS) */
        .exec-main { flex: 1; min-height: 0; overflow: auto; padding: 20px clamp(16px, 2.5vw, 32px) 36px; background: #F4F7FB; }
        .exec-wrap { max-width: 1440px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
        .exec-hero { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; padding: 20px 24px; border-radius: 14px; background: linear-gradient(135deg, #002B5C 0%, #00468B 60%, #0072CE 100%); color: #ffffff; box-shadow: 0 10px 24px -6px rgba(0, 43, 92, 0.28); border-bottom: 4px solid ${BRAND.yellow}; }
        .exec-hero-left { flex: 1 1 540px; min-width: 0; }
        .exec-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px; border-radius: 999px; background: rgba(255, 184, 28, 0.18); border: 1px solid rgba(255, 184, 28, 0.55); color: #fde68a; font-size: 10px; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }
        .exec-title { margin: 0; font-size: 21px; font-weight: 900; letter-spacing: -0.02em; color: #ffffff; }
        .exec-sub { margin: 6px 0 0; font-size: 13px; line-height: 1.5; color: #dbeafe; max-width: 880px; }
        .exec-hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; align-self: center; }

        .exec-kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
        .exec-kpi-card { background: #ffffff; border: 1px solid #dbe3ee; border-top-width: 4px; border-radius: 12px; padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 4px 12px -2px rgba(0, 70, 139, 0.06); cursor: pointer; transition: transform 0.12s, box-shadow 0.12s; }
        .exec-kpi-card:hover { transform: translateY(-1px); box-shadow: 0 8px 18px -4px rgba(0, 70, 139, 0.12); }
        .exec-kpi-card.active { outline: 2px solid ${BRAND.blue}; outline-offset: 2px; }
        .exec-kpi-card.tier1 { border-top-color: ${BRAND.red}; background: linear-gradient(180deg, #FFFDF5 0%, #FFFFFF 100%); }
        .exec-kpi-card.tier2 { border-top-color: ${BRAND.yellow}; }
