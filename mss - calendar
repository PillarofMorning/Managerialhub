        .cell-month { flex-shrink: 0; border-right: 1px solid #cbd5e1; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; background: #fff; color: ${BRAND.blueDark}; text-transform: uppercase; letter-spacing: 0.06em; }
