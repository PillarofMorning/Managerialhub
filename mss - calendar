// ============================================================================
const buildPrioritizationModel = ({ assets, freqStatus, completionIndex, lineRules, downtimeLines, planModel, today, todayStr }) => {
  const items = [];
  const roomMap = new Map();
  const areaMap = new Map();
  const tomorrowStr = dtAddDays(todayStr, 1);
  const day2Str = dtAddDays(todayStr, 2);

  // Pre-build line availability status by normalized area name
  const areaLineState = new Map();
  const pModel = planModel || buildPlanModel([]);
  const rulesObj = lineRules || buildLineRules({ plan: pModel, lines: downtimeLines || [] });
  const mon0 = dtMonday(todayStr);
  const mon1 = dtAddDays(mon0, 7);
  const windowWeeks = [{ monday: mon0 }, { monday: mon1 }];
  const windowDays = [];
  let todayOffset = 0;
  for (let dIdx = 0; dIdx < 14; dIdx++) {
    const dStr = dtAddDays(mon0, dIdx);
    if (dStr === todayStr) todayOffset = dIdx;
    windowDays.push({ date: dStr, dow: dtDow(dStr) });
  }

  assets.forEach(asset => {
    const id = getAssetId(asset);
    const name = safeString(getProp(asset, 'craa5_equipmentidentifier')) || 'Unnamed Equipment';
    const room = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
    const area = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';
    const st = freqStatus.get(id);
    const badges = st && st.badges ? st.badges : [];
    if (!badges.length) return;

    // 1. Determine Production Line Downtime Window for this equipment's Area
    const normArea = normalizeName(area);
    let lineInfo = areaLineState.get(normArea);
    if (!lineInfo) {
      const grpKey = rulesObj.groupOf ? rulesObj.groupOf(asset) : '';
      if (!grpKey) {
        lineInfo = { status: 'FLEX', label: 'Independent / Any Shift', detail: 'Not tied to a continuous line run', opsPts: 16, downToday: true, down48h: true };
      } else {
        const cal = rulesObj.build(grpKey, windowDays, windowWeeks);
        const prodToday = cal.prod && cal.prod[todayOffset] !== undefined ? cal.prod[todayOffset] : 0;
        const lenToday = cal.len && cal.len[todayOffset] !== undefined ? cal.len[todayOffset] : 1440;
        const downMinToday = Math.max(0, lenToday - prodToday);
        const prodTom = cal.prod && cal.prod[todayOffset + 1] !== undefined ? cal.prod[todayOffset + 1] : 0;
        const prodDay2 = cal.prod && cal.prod[todayOffset + 2] !== undefined ? cal.prod[todayOffset + 2] : 0;
        const downMin48 = Math.max(0, 1440 - prodTom) + Math.max(0, 1440 - prodDay2);
        const lineLabel = grpKey.split(LR_SEP).map(k => {
          const parts = k.split('|');
          return (parts[0] ? parts[0].toUpperCase() : area) + ' L' + (parts[1] || '1');
        }).join(', ');

        if (downMinToday >= 180) {
          lineInfo = {
            status: 'DOWN_TODAY',
            label: 'Line Down Today (Golden Window)',
            detail: `${lineLabel} has ${Math.round(downMinToday / 60)}h sanitation window today`,
            opsPts: 25,
            downToday: true,
            down48h: true
          };
        } else if (downMin48 >= 180) {
          lineInfo = {
            status: 'DOWN_48H',
            label: 'Window Within 48h',
            detail: `${lineLabel} running today; downtime window opens within 48h`,
            opsPts: 15,
            downToday: false,
            down48h: true
          };
        } else {
          lineInfo = {
            status: 'RUNNING',
            label: 'Line Running Continuous',
            detail: `${lineLabel} scheduled in continuous production`,
            opsPts: 6,
            downToday: false,
            down48h: false
          };
        }
      }
      areaLineState.set(normArea, lineInfo);
    }

    // 2. Quality & Food Safety Depth Score (0 - 35 pts)
    const overdueBadges = badges.filter(b => b.state === 'overdue');
    const focusBadges = overdueBadges.length ? overdueBadges : badges;
    let maxRank = 1;
    let highestCode = focusBadges[0] ? focusBadges[0].code : 'D';
    focusBadges.forEach(b => {
      const fDef = FREQS.find(f => f.code === b.code);
      const r = fDef ? fDef.rank : 1;
      if (r >= maxRank) { maxRank = r; highestCode = b.code; }
    });
    const isZone1OrCritical = /drain|freezer|depositor|filler|slicer|pasteurizer|mixer|cutter/i.test(name);
    const depthPts = (maxRank >= 4 ? 30 : maxRank === 3 ? 22 : 14) + (isZone1OrCritical ? 5 : 0);

    // 3. Compliance Window Urgency Score (0 - 40 pts)
    const lastDate = st && st.lastAny ? st.lastAny : null;
    const daysSinceLast = lastDate ? Math.max(0, dtSpan(lastDate, todayStr) - 1) : 45;
    let urgencyPts = 4;
    let urgencyLabel = 'Compliant - Within Window';
    if (overdueBadges.length > 0) {
      const primaryOverdue = overdueBadges[overdueBadges.length - 1];
      const daysPast = Math.max(1, daysSinceLast - primaryOverdue.days);
      urgencyPts = Math.min(40, 26 + Math.min(14, daysPast * 2));
      urgencyLabel = `${overdueBadges.map(b => b.label).join(' + ')} Overdue (${daysPast}d past ${primaryOverdue.days}d window)`;
    } else if (st && st.state === 'unknown') {
      urgencyPts = 14;
      urgencyLabel = 'Unread History - Verify Log';
    } else {
      // Check tightest remaining window
      let minRem = 999;
      let tightestBadge = badges[0];
      badges.forEach(b => {
        const bLast = b.last ? Math.max(0, dtSpan(b.last, todayStr) - 1) : 0;
        const rem = Math.max(0, b.days - bLast);
        if (rem < minRem) { minRem = rem; tightestBadge = b; }
      });
      if (minRem <= 1) {
        urgencyPts = 21;
        urgencyLabel = `Due Within 24h (${tightestBadge ? tightestBadge.label : 'Daily'})`;
      } else if (minRem <= 3) {
        urgencyPts = 13;
        urgencyLabel = `Due in ${minRem}d (${tightestBadge ? tightestBadge.label : 'Scheduled'})`;
      } else {
        urgencyPts = 4;
        urgencyLabel = `On Track (${minRem}d remaining in window)`;
      }
    }

    const score = Math.min(100, depthPts + urgencyPts + lineInfo.opsPts);

    // 4. Classify into 4 Executive Dispatch Tiers
    let tier = 4;
    let tierLabel = 'TIER 4: COMPLIANT / ON TRACK';
    let tierShort = 'Tier 4 - Compliant';
    let tierAction = 'Routine schedule monitoring';
    if (overdueBadges.length > 0 && lineInfo.downToday) {
      tier = 1;
      tierLabel = 'TIER 1: GOLDEN WINDOW (DISPATCH NOW)';
      tierShort = 'Tier 1 - Golden Window';
      tierAction = 'Immediate Dispatch: Overdue & Line Available Today';
    } else if (overdueBadges.length > 0 && !lineInfo.downToday) {
      tier = 2;
      tierLabel = 'TIER 2: OPS / QA COORDINATION';
      tierShort = 'Tier 2 - Ops/QA Align';
      tierAction = lineInfo.down48h ? 'Lock in upcoming 48h line downtime slot' : 'Coordinate with Ops for next changeover window';
    } else if (urgencyPts >= 13 && (lineInfo.downToday || lineInfo.down48h)) {
      tier = 3;
      tierLabel = 'TIER 3: PROACTIVE 48H STAGING';
      tierShort = 'Tier 3 - Stage 48h';
      tierAction = 'Stage SAP order & crew for current/next window';
    }

    // Estimate crew hours from historical logs or asset default
    const assetLogs = completionIndex.byAsset.get(id);
    let estHours = Number(asset._estHours) || (maxRank === 3 ? 5 : maxRank === 2 ? 3 : 2);
    if (assetLogs && assetLogs.size > 0) {
      let sumH = 0, cntH = 0;
      assetLogs.forEach(entry => {
        const h = Number(entry.log && entry.log.craa5_hoursworked);
        if (h > 0) { sumH += h; cntH += 1; }
      });
      if (cntH > 0) estHours = Math.max(1, Math.round(sumH / cntH));
    }

    const sapMap = getAssetSapMap(asset);
    const sapOrder = sapMap[highestCode] || sapMap.D || sapMap.W || sapMap.M || 'SAP-STD';

    const item = {
      id,
      asset,
      name,
      room,
      area,
      st,
      badges,
      overdueBadges,
      highestCode,
      maxRank,
      isZone1OrCritical,
      lastDate,
      daysSinceLast,
      depthPts,
      urgencyPts,
      opsPts: lineInfo.opsPts,
      score,
      tier,
      tierLabel,
      tierShort,
      tierAction,
      urgencyLabel,
      lineInfo,
      estHours,
      sapOrder
    };
    items.push(item);

    // Aggregate Room & Area Bottlenecks
    const bumpGroup = (map, key, rName, aName) => {
      let g = map.get(key);
      if (!g) {
        g = { key, room: rName, area: aName, total: 0, overdue: 0, tier1: 0, tier2: 0, tier3: 0, compliant: 0, backlogHours: 0, goldenHours: 0, scoreSum: 0 };
        map.set(key, g);
      }
      g.total += 1;
      g.scoreSum += score;
      if (overdueBadges.length > 0) {
        g.overdue += 1;
        g.backlogHours += estHours;
      } else {
        g.compliant += 1;
      }
      if (tier === 1) { g.tier1 += 1; g.goldenHours += estHours; }
      else if (tier === 2) g.tier2 += 1;
      else if (tier === 3) g.tier3 += 1;
    };
    bumpGroup(roomMap, room, room, null);
    bumpGroup(areaMap, `${room}|${area}`, room, area);
  });

  items.sort((a, b) => a.tier - b.tier || b.score - a.score || b.daysSinceLast - a.daysSinceLast || a.name.localeCompare(b.name));

  const rooms = Array.from(roomMap.values()).sort((a, b) => b.overdue - a.overdue || b.tier1 - a.tier1 || a.room.localeCompare(b.room));
  const areas = Array.from(areaMap.values()).sort((a, b) => b.tier1 - a.tier1 || b.overdue - a.overdue || a.area.localeCompare(b.area));

  const counts = {
    total: items.length,
    tier1: items.filter(x => x.tier === 1).length,
    tier2: items.filter(x => x.tier === 2).length,
    tier3: items.filter(x => x.tier === 3).length,
    tier4: items.filter(x => x.tier === 4).length,
    overdue: items.filter(x => x.overdueBadges.length > 0).length,
    goldenHours: items.filter(x => x.tier === 1).reduce((s, x) => s + x.estHours, 0),
    totalBacklogHours: items.filter(x => x.overdueBadges.length > 0).reduce((s, x) => s + x.estHours, 0)
  };

  const summary = {
    totalScored: counts.total,
    goldenWindowCount: counts.tier1,
    tier2Count: counts.tier2,
    tier3Count: counts.tier3,
    tier4Count: counts.tier4,
    overdueCount: counts.overdue,
    goldenHours: counts.goldenHours,
    totalBacklogHours: counts.totalBacklogHours
  };

  return { items, rooms, areas, counts, summary };
};

