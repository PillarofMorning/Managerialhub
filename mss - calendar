// ============================================================================
// EXTRAPOLATED ANALYTICS, GRAPHS & LONG-TERM DECISION INTELLIGENCE
// ============================================================================
// ============================================================================
// BEGIN COST INPUTS: the Graphs tab's labor rate and chemical costs read from Dataverse, the typed numbers below as the fallback
// ----------------------------------------------------------------------------
// labor rate  the _e_ Labor rate table (craa5__e_laborrate): role "sanitation tech 2", else Sanitor, else All, the newest Effective from on or
//             before the plant day (data contract section 7, the rule the manager hub's Line clean cost tab uses). A row with no Effective from
//             is not used; two rows of one role on one day with different rates cannot be told apart, so none is used. The name column is never read.
// chemicals   the chemical standards (craa5__c_chemicalstandard: gallons per clean of an item for an area and a clean type) priced from the chemical
//             list (craa5__c_chemical: price of a container / gallons per container). Per area and clean type: the row in force on the plant day
//             for each item. The area's cost of one clean is shared over the pieces of the area that carry that frequency.
//             Daily -> D, Mid-week -> MW, Weekly -> W, Monthly -> M. Quarterly, semiannual and annual have no standard type: they use the typed Deep number.
//             Rows of one piece of equipment, other clean types (Changeover, Allergen, End of week) and items with no gallon price are counted and left out.
// Nothing is written. A table that is missing, not shared or empty leaves the typed number in use, and the tab says so.
// ============================================================================
const COST_RATE_TABLES = ['craa5__e_laborrate', 'craa5_e_laborrate', 'craa5_laborrate'];
const COST_RATE_SELECT = ['craa5_role', 'craa5_hourlyrate', 'craa5_effectivefrom'];
const COST_RATE_NEEDED = ['craa5_hourlyrate', 'craa5_effectivefrom'];
const COST_RATE_ROLES = ['sanitation tech 2', 'Sanitor', 'All'];
const COST_ITEM_TABLES = ['craa5__c_chemical'];
const COST_ITEM_SELECT = ['craa5_itemnumber', 'craa5_priceperunit', 'craa5_gallonspercontainer', 'craa5_containersize', 'craa5_containerunit', 'craa5_active'];
const COST_ITEM_NEEDED = ['craa5_itemnumber', 'craa5_priceperunit'];
const COST_STD_TABLES = ['craa5__c_chemicalstandard'];
const COST_STD_SELECT = ['craa5_itemnumber', 'craa5_area', 'craa5_equipment', 'craa5_cleantype', 'craa5_gallonsperclean', 'craa5_validfrom'];
const COST_STD_NEEDED = ['craa5_itemnumber', 'craa5_area', 'craa5_cleantype', 'craa5_gallonsperclean'];
const COST_REAL_KEY = 'mss_calendar_econ_real_v1';   // this computer only: false = use the typed numbers even when Dataverse has some
const COST_TYPE_TIER = { daily: 'D', 'mid-week': 'MW', midweek: 'MW', 'mid week': 'MW', weekly: 'W', monthly: 'M' };

const costText = (v) => (v === undefined || v === null ? '' : String(v)).replace(/\s+/g, ' ').trim();
const costNum = (v) => {
  if (v === undefined || v === null || v === '' || typeof v === 'boolean') return null;
  if (typeof v === 'object') { v = v.Value !== undefined ? v.Value : v.value; if (v === undefined || v === null || v === '') return null; }
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
};
const costDay = (v) => { const s = costText(v); return /^\d{4}-\d{2}-\d{2}/.test(s) ? s.slice(0, 10) : ''; };
// The label of a choice column: the formatted value the host sends, else a text value. Never the option number (it is not the same in every environment).
const costLabel = (row, col) => {
  const f = row ? row[col + '@OData.Community.Display.V1.FormattedValue'] : undefined;
  if (f !== undefined && f !== null && f !== '') return costText(f);
  const v = row ? row[col] : undefined;
  if (v && typeof v === 'object') return costText(v.Label || v.label || v.name || '');
  if (typeof v === 'string' && v !== '' && !/^-?\d+(\.\d+)?$/.test(v)) return costText(v);
  return '';
};
const costCents = (n) => Math.round(n * 100 + 0.0000001) / 100;

// Read one table (the first name that exists) with the columns it has: a column Dataverse does not know is dropped unless it is needed.
// Returns { state: 'ok' | 'missing' | 'denied' | 'nocol' | 'error' | 'offline', table, rows, dropped, message }.
const costReadTable = async (tables, select, needed) => {
  const web = getXrmWebApi();
  if (!web) return { state: 'offline', rows: [], dropped: [] };
  let last = { state: 'missing', rows: [], dropped: [] };
  for (let t = 0; t < tables.length; t++) {
    let cols = select.slice();
    const dropped = [];
    for (let attempt = 0; attempt <= select.length; attempt++) {
      try {
        const res = await retrievePaged(tables[t], `?$select=${cols.join(',')}&$filter=statecode eq 0`, 5000);
        return { state: 'ok', table: tables[t], rows: res.rows || [], dropped, truncated: res.truncated };
      } catch (err) {
        const msg = String(err && err.message || err);
        if (/privilege|0x80040220|access is denied|not have permission|prvRead/i.test(msg)) return { state: 'denied', table: tables[t], rows: [], dropped, message: msg };
        const named = cols.filter(c => new RegExp(`\\b${c}\\b`, 'i').test(msg));
        if (named.length && isMissingColumnError(err)) {
          if (named.some(c => needed.indexOf(c) > -1)) { last = { state: 'nocol', table: tables[t], rows: [], dropped: dropped.concat(named), message: msg }; break; }
          named.forEach(c => dropped.push(c));
          cols = cols.filter(c => named.indexOf(c) < 0);
          continue;
        }
        if (isMissingColumnError(err) || /404|resource not found|entity.*not.*found/i.test(msg)) { if (last.state !== 'nocol') last = { state: 'missing', rows: [], dropped: [], message: msg }; break; }
        return { state: 'error', table: tables[t], rows: [], dropped, message: msg };
      }
    }
  }
  return last;
};

// The hourly rate for a plant day (YYYY-MM-DD) from the labor rate rows, by the roles in order. Returns { best: { rate, from, role } or null, undated, future, tie, badRate, otherRole }.
const costRateSelect = (rows, day, roles) => {
  const list = (roles || COST_RATE_ROLES).map(r => costText(r).toLowerCase()).filter(Boolean);
  const out = { best: null, undated: 0, future: 0, tie: false, badRate: 0, otherRole: 0 };
  let best = null, tieRates = [];
  (rows || []).forEach(r => {
    const rate = costNum(r.craa5_hourlyrate);
    if (rate === null || rate <= 0) { out.badRate += 1; return; }
    const from = costDay(r.craa5_effectivefrom);
    if (!from) { out.undated += 1; return; }
    if (from > String(day || '')) { out.future += 1; return; }
    const at = list.indexOf(costText(r.craa5_role).toLowerCase() || 'all'), score = at < 0 ? 0 : list.length - at;
    if (!score) { out.otherRole += 1; return; }
    if (!best || score > best.score || (score === best.score && from > best.from)) { best = { rate, from, role: costText(r.craa5_role) || 'All', score }; tieRates = [rate]; }
    else if (score === best.score && from === best.from && tieRates.indexOf(rate) < 0) tieRates.push(rate);
  });
  if (best && tieRates.length > 1) { out.tie = true; best = null; }
  out.best = best ? { rate: best.rate, from: best.from, role: best.role } : null;
  return out;
};

// Price of one gallon per item number, from the chemical list (active rows only; solids sold by the pound have no gallon price).
const costGallonPrices = (rows) => {
  const out = Object.create(null);
  (rows || []).forEach(r => {
    const no = costText(r.craa5_itemnumber);
    if (!no || no in out) return;
    const act = r.craa5_active, actLabel = costLabel(r, 'craa5_active').toLowerCase();
    if (act === false || act === 0 || /^(no|false)$/.test(actLabel)) return;
    const price = costNum(r.craa5_priceperunit), gpc = costNum(r.craa5_gallonspercontainer), size = costNum(r.craa5_containersize), unit = costLabel(r, 'craa5_containerunit').toLowerCase();
    if (price === null || price <= 0) { out[no] = null; return; }
    if (gpc !== null && gpc > 0) out[no] = price / gpc;
    else if (/gallon/.test(unit) && size !== null && size > 0) out[no] = price / size;
    else out[no] = null;
  });
  return out;
};

// The chemical cost of one clean of each area and tier on a plant day.
// Returns { byArea: { areaKey: { name, D, MW, W, M } } (each tier { cost, items, unpriced } or absent), areas, used, unpriced, equipment, other, noGal, future, tied }.
const costChemByArea = (stdRows, gallonPrice, day) => {
  const pick = Object.create(null), order = [];
  const out = { byArea: Object.create(null), areas: 0, used: 0, unpriced: 0, equipment: 0, other: 0, noGal: 0, future: 0, tied: 0 };
  (stdRows || []).forEach(r => {
    const item = costText(r.craa5_itemnumber), areaName = costText(r.craa5_area), ak = normalizeName(areaName);
    if (!item || !ak) return;
    if (costText(r.craa5_equipment)) { out.equipment += 1; return; }
    const tier = COST_TYPE_TIER[costLabel(r, 'craa5_cleantype').toLowerCase()];
    if (!tier) { out.other += 1; return; }
    const gal = costNum(r.craa5_gallonsperclean);
    if (gal === null || gal < 0) { out.noGal += 1; return; }
    const from = costDay(r.craa5_validfrom);
    if (from && from > String(day || '')) { out.future += 1; return; }
    const k = ak + '|' + tier + '|' + item;
    const cur = pick[k];
    if (!cur) { pick[k] = { ak, areaName, tier, item, gal, from, tie: false }; order.push(k); return; }
    if (from > cur.from) { cur.gal = gal; cur.from = from; cur.tie = false; }
    else if (from === cur.from && gal !== cur.gal) cur.tie = true;
  });
  order.forEach(k => {
    const s = pick[k];
    if (s.tie) { out.tied += 1; return; }
    const ppg = gallonPrice ? gallonPrice[s.item] : undefined;
    let a = out.byArea[s.ak];
    if (!a) { a = out.byArea[s.ak] = { name: s.areaName }; out.areas += 1; }
    const t = a[s.tier] || (a[s.tier] = { cost: 0, items: 0, unpriced: 0 });
    if (ppg === null || ppg === undefined) { t.unpriced += 1; out.unpriced += 1; return; }
    t.cost = costCents(t.cost + s.gal * ppg); t.items += 1; out.used += 1;
  });
  // a tier whose items all lack a price is not a cost
  Object.keys(out.byArea).forEach(ak => { ['D', 'MW', 'W', 'M'].forEach(tr => { const t = out.byArea[ak][tr]; if (t && !t.items) delete out.byArea[ak][tr]; }); });
  return out;
};

// Read the three tables and work out what the Graphs tab can use for the plant day.
const readCostInputs = async (day) => {
  const [rateRead, itemRead, stdRead] = await Promise.all([
    costReadTable(COST_RATE_TABLES, COST_RATE_SELECT, COST_RATE_NEEDED),
    costReadTable(COST_ITEM_TABLES, COST_ITEM_SELECT, COST_ITEM_NEEDED),
    costReadTable(COST_STD_TABLES, COST_STD_SELECT, COST_STD_NEEDED)
  ]);
  const rateSel = rateRead.state === 'ok' ? costRateSelect(rateRead.rows, day) : null;
  const prices = itemRead.state === 'ok' ? costGallonPrices(itemRead.rows) : null;
  const chem = stdRead.state === 'ok' && prices ? costChemByArea(stdRead.rows, prices, day) : null;
  return { day, rateRead: { state: rateRead.state, table: rateRead.table, rows: rateRead.rows.length }, rateSel, itemRead: { state: itemRead.state, rows: itemRead.rows.length }, stdRead: { state: stdRead.state, rows: stdRead.rows.length }, chem };
};
const loadCostUseReal = () => { try { return localStorage.getItem(COST_REAL_KEY) !== 'false'; } catch (_) { return true; } };
const saveCostUseReal = (on) => { try { localStorage.setItem(COST_REAL_KEY, on ? 'true' : 'false'); } catch (_) { /* this computer keeps nothing */ } };
// ============================================================================
// END COST INPUTS
// ============================================================================

const ECON_STORAGE_KEY = 'mss_calendar_econ_v1';
const DEFAULT_ECON_PARAMS = {
  laborRate: 34,          // Fully-burdened sanitor hourly cost ($/hr)
  headcount: 8,           // Active sanitation FTEs per day
  shiftHours: 6.5,        // Effective hands-on cleaning hours per sanitor shift
  daysPerMonth: 26,       // Active sanitation operating days per month
  chemDaily: 18,          // Chemical + hot water + PPE cost per Daily (D) clean ($)
  chemWeekly: 48,         // Chemical + caustic/acid + ATP swab cost per Weekly/Mid-Week (W/MW) clean ($)
  chemDeep: 145,          // Boil-out chemical + passivation + micro/allergen swab cost per Deep (M/Q/A) clean ($)
  downtimeCostHr: 1850    // Production line hold / unplanned downtime opportunity cost ($/hr)
};

const loadEconParams = () => {
  try {
    const raw = localStorage.getItem(ECON_STORAGE_KEY);
    if (!raw) return { ...DEFAULT_ECON_PARAMS };
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object') return { ...DEFAULT_ECON_PARAMS };
    const out = { ...DEFAULT_ECON_PARAMS };
    Object.keys(DEFAULT_ECON_PARAMS).forEach(k => {
      const n = Number(parsed[k]);
      if (Number.isFinite(n) && n >= 0) out[k] = n;
    });
    return out;
  } catch (_) {
    return { ...DEFAULT_ECON_PARAMS };
  }
};

const saveEconParams = (params) => {
  try {
    localStorage.setItem(ECON_STORAGE_KEY, JSON.stringify(params));
  } catch (_) { /* ignore storage errors */ }
};


const buildExtrapolatedAnalyticsModel = ({ assets, logs, completionIndex, lineRules, planModel, prioritizationModel, anchorYear, econ, real }) => {
  const p = { ...DEFAULT_ECON_PARAMS, ...(econ || {}) };
  // real = { rate, chem } from readCostInputs (null parts when not read or not used): the labor rate table wins over the typed rate,
  // an area's chemical standards win over the typed per-clean numbers for the tiers they cover (COST INPUTS).
  const realRate = real && real.rate > 0 ? real.rate : null;
  if (realRate !== null) p.laborRate = realRate;
  const chemAreas = real && real.chem ? real.chem.byArea : null;
  const tierPieces = new Map();   // normalized area -> pieces carrying D / MW / W / M
  if (chemAreas) {
    (assets || []).forEach(asset => {
      const k = normalizeName(safeString(getProp(asset, 'craa5_areaname')));
      if (!k || !chemAreas[k]) return;
      const c = tierPieces.get(k) || { D: 0, MW: 0, W: 0, M: 0 };
      if (isTrue(asset.craa5_dailyclean) || isTrue(asset.craa5_daily)) c.D += 1;
      if (isTrue(asset.craa5_midweek)) c.MW += 1;
      if (isTrue(asset.craa5_weeklyclean) || isTrue(asset.craa5_weekly) || isTrue(asset.craa5_biweekly)) c.W += 1;
      if (isTrue(asset.craa5_monthlyclean) || isTrue(asset.craa5_monthly) || isTrue(asset.craa5_twomonth)) c.M += 1;
      tierPieces.set(k, c);
    });
  }
  // one piece's share of its area's standard cost for a tier, or null (no standard: the typed number is used)
  const realChemPerPiece = (areaKey, tier) => {
    const a = chemAreas && chemAreas[areaKey], t = a && a[tier], n = tierPieces.get(areaKey);
    return t && n && n[tier] > 0 ? t.cost / n[tier] : null;
  };
  const chemSource = { realEvents: 0, typedEvents: 0, realAreas: new Set() };
  let chemDailySum = 0, chemWeeklySum = 0, chemDeepSum = 0;
  const monthlyCapacityHrs = Math.round(p.headcount * p.shiftHours * p.daysPerMonth);
  const annualCapacityHrs = monthlyCapacityHrs * 12;

  // Empirical hours worked per asset from craa5__log_
  const empiricalHoursByAsset = new Map();
  const loggedHoursByMonth = new Array(12).fill(0);
  const loggedCleansByDow = new Array(7).fill(0); // 0=Mon .. 6=Sun

  (logs || []).forEach(l => {
    const dtStr = logDay(l);
    const hrsRaw = Number(getRaw(l, 'craa5_hoursworked'));
    const hrs = Number.isFinite(hrsRaw) && hrsRaw > 0 ? hrsRaw : 0;
    if (dtStr && dtStr.length >= 10) {
      const y = Number(dtStr.slice(0, 4));
      const m = Number(dtStr.slice(5, 7)) - 1;
      if (y === anchorYear && m >= 0 && m < 12) {
        loggedHoursByMonth[m] += hrs > 0 ? hrs : 1.25;
      }
      const dow = dtDow(dtStr); // 0=Sun..6=Sat
      const monIdx = (dow + 6) % 7; // 0=Mon..6=Sun
      if (monIdx >= 0 && monIdx < 7) loggedCleansByDow[monIdx] += 1;
    }
    const eqId = normalizeId(getRaw(l, LOG_ASSET_ID_SELECT));
    if (eqId && hrs > 0) {
      const cur = empiricalHoursByAsset.get(eqId) || { sum: 0, count: 0 };
      cur.sum += hrs;
      cur.count += 1;
      empiricalHoursByAsset.set(eqId, cur);
    }
  });

  // Per-month extrapolated demand buckets (Jan..Dec)
  // Working days per month variation + Q (Mar/Jun/Sep/Dec) + A (Apr/Oct turnaround windows)
  const monthDaysWeight = [26, 24, 26, 26, 26, 26, 26, 26, 25, 27, 25, 25];
  const monthlySeries = MONTHS.map((mName, mIdx) => ({
    monthIndex: mIdx,
    monthShort: mName.slice(0, 3),
    monthName: mName,
    dailyHrs: 0,
    weeklyHrs: 0,
    deepHrs: 0,
    totalHrs: 0,
    capacityHrs: monthlyCapacityHrs,
    loggedHrs: Math.round(loggedHoursByMonth[mIdx] * 10) / 10,
    chemCost: 0,
    laborCost: 0,
    isQuarterPeak: mIdx === 2 || mIdx === 5 || mIdx === 8 || mIdx === 11,
    isAnnualTurnaround: mIdx === 3 || mIdx === 9
  }));

  const areaMap = new Map();
  const paretoList = [];

  let totalDailyEvents = 0;
  let totalWeeklyEvents = 0;
  let totalDeepEvents = 0;
  let totalDailyHrs = 0;
  let totalWeeklyHrs = 0;
  let totalDeepHrs = 0;

  (assets || []).forEach((asset, aIdx) => {
    const id = getAssetId(asset);
    const name = safeString(getProp(asset, 'craa5_equipmentidentifier')) || 'Unnamed Equipment';
    const room = safeString(getProp(asset, 'craa5_roomname')) || 'Unassigned Room';
    const area = safeString(getProp(asset, 'craa5_areaname')) || 'Unassigned Area';

    const hasD = isTrue(asset.craa5_dailyclean) || isTrue(asset.craa5_daily);
    const hasMW = isTrue(asset.craa5_midweek);
    const hasW = isTrue(asset.craa5_weeklyclean) || isTrue(asset.craa5_weekly) || isTrue(asset.craa5_biweekly);
    const hasM = isTrue(asset.craa5_monthlyclean) || isTrue(asset.craa5_monthly) || isTrue(asset.craa5_twomonth);
    const hasQ = isTrue(asset.craa5_quarterly) || isTrue(asset.craa5_sixmonth) || isTrue(asset.craa5_month);   // craa5_month is the 6-month flag
    const hasA = isTrue(asset.craa5_annually);

    if (!hasD && !hasMW && !hasW && !hasM && !hasQ && !hasA) return;

    const emp = empiricalHoursByAsset.get(id);
    const empAvg = emp && emp.count > 0 ? emp.sum / emp.count : null;
    const isCritical = /drain|freezer|depositor|filler|slicer|pasteurizer|mixer|cutter|oven/i.test(name);

    // Base hours per event tier, scaled by empirical log average if available
    const scale = empAvg ? Math.max(0.65, Math.min(1.65, empAvg / 2.2)) : (isCritical ? 1.2 : 1.0);
    const hrsPerD = Math.round(0.75 * scale * 100) / 100;
    const hrsPerW = Math.round(1.85 * scale * 100) / 100;
    const hrsPerM = Math.round(3.6 * scale * 100) / 100;
    const hrsPerQ = Math.round(5.0 * scale * 100) / 100;
    const hrsPerA = Math.round(7.5 * scale * 100) / 100;

    let assetAnnualD = 0, assetAnnualW = 0, assetAnnualDeep = 0;
    let assetAnnualHrs = 0, assetAnnualChem = 0;
    const areaKey = normalizeName(safeString(getProp(asset, 'craa5_areaname')));
    const rD = realChemPerPiece(areaKey, 'D'), rMW = realChemPerPiece(areaKey, 'MW'), rW = realChemPerPiece(areaKey, 'W'), rM = realChemPerPiece(areaKey, 'M');
    const cD = rD !== null ? rD : p.chemDaily, cMW = rMW !== null ? rMW : p.chemWeekly, cW = rW !== null ? rW : p.chemWeekly, cM = rM !== null ? rM : p.chemDeep;
    if (rD !== null || rMW !== null || rW !== null || rM !== null) chemSource.realAreas.add(areaKey);

    for (let m = 0; m < 12; m++) {
      const dEvents = hasD ? monthDaysWeight[m] : 0;
      const wEvents = (hasW ? 4.33 : 0) + (hasMW ? 4.33 : 0);
      const mEvents = hasM ? 1 : 0;
      const qEvents = hasQ && (m === 2 || m === 5 || m === 8 || m === 11) ? 1 : 0;
      // Annual cleans staged in April (month 3) or October (month 9) plant turnaround windows
      const aEvents = hasA && ((aIdx % 2 === 0 && m === 3) || (aIdx % 2 === 1 && m === 9)) ? 1 : 0;

      const dH = dEvents * hrsPerD;
      const wH = wEvents * hrsPerW;
      const deepH = (mEvents * hrsPerM) + (qEvents * hrsPerQ) + (aEvents * hrsPerA);
      const mwEv = hasMW ? 4.33 : 0, wOnlyEv = hasW ? 4.33 : 0;
      const chD = dEvents * cD, chW = (mwEv * cMW) + (wOnlyEv * cW), chDeep = (mEvents * cM) + ((qEvents + aEvents) * p.chemDeep);
      const mChem = chD + chW + chDeep;
      chemDailySum += chD; chemWeeklySum += chW; chemDeepSum += chDeep;
      chemSource.realEvents += (rD !== null ? dEvents : 0) + (rMW !== null ? mwEv : 0) + (rW !== null ? wOnlyEv : 0) + (rM !== null ? mEvents : 0);
      chemSource.typedEvents += (rD === null ? dEvents : 0) + (rMW === null ? mwEv : 0) + (rW === null ? wOnlyEv : 0) + (rM === null ? mEvents : 0) + qEvents + aEvents;

      monthlySeries[m].dailyHrs += dH;
      monthlySeries[m].weeklyHrs += wH;
      monthlySeries[m].deepHrs += deepH;
      monthlySeries[m].chemCost += mChem;

      assetAnnualD += dEvents;
      assetAnnualW += wEvents;
      assetAnnualDeep += (mEvents + qEvents + aEvents);
      assetAnnualHrs += (dH + wH + deepH);
      assetAnnualChem += mChem;

      totalDailyEvents += dEvents;
      totalWeeklyEvents += wEvents;
      totalDeepEvents += (mEvents + qEvents + aEvents);
      totalDailyHrs += dH;
      totalWeeklyHrs += wH;
      totalDeepHrs += deepH;
    }

    const assetLaborCost = assetAnnualHrs * p.laborRate;
    const assetTotalCost = assetLaborCost + assetAnnualChem;

    paretoList.push({
      id,
      name,
      room,
      area,
      isCritical,
      empAvgHrs: empAvg ? Math.round(empAvg * 10) / 10 : null,
      annualHours: Math.round(assetAnnualHrs),
      annualEvents: Math.round(assetAnnualD + assetAnnualW + assetAnnualDeep),
      deepEvents: Math.round(assetAnnualDeep),
      laborCost: Math.round(assetLaborCost),
      chemCost: Math.round(assetAnnualChem),
      totalCost: Math.round(assetTotalCost),
      freqs: [hasD && 'D', hasMW && 'MW', hasW && 'W', hasM && 'M', hasQ && 'Q', hasA && 'A'].filter(Boolean).join('/')
    });

    const aKey = `${room}|${area}`;
    let aRec = areaMap.get(aKey);
    if (!aRec) {
      aRec = {
        key: aKey,
        room,
        area,
        equipmentCount: 0,
        annualHours: 0,
        weeklyReqHours: 0,
        annualChemCost: 0,
        annualLaborCost: 0,
        annualTotalCost: 0,
        empHrsSum: 0,
        empHrsCount: 0
      };
      areaMap.set(aKey, aRec);
    }
    aRec.equipmentCount += 1;
    aRec.annualHours += assetAnnualHrs;
    aRec.weeklyReqHours += assetAnnualHrs / 52;
    aRec.annualChemCost += assetAnnualChem;
    aRec.annualLaborCost += assetLaborCost;
    aRec.annualTotalCost += assetTotalCost;
    if (empAvg) {
      aRec.empHrsSum += empAvg;
      aRec.empHrsCount += 1;
    }
  });

  // Finalize monthly series & compute surge / overtime hours
  let annualOvertimeHrs = 0;
  let peakMonth = monthlySeries[0];
  monthlySeries.forEach(m => {
    m.dailyHrs = Math.round(m.dailyHrs);
    m.weeklyHrs = Math.round(m.weeklyHrs);
    m.deepHrs = Math.round(m.deepHrs);
    m.totalHrs = m.dailyHrs + m.weeklyHrs + m.deepHrs;
    m.surgeHrs = Math.max(0, m.totalHrs - monthlyCapacityHrs);
    annualOvertimeHrs += m.surgeHrs;
    const baseHrs = Math.min(m.totalHrs, monthlyCapacityHrs);
    m.laborCost = Math.round((baseHrs * p.laborRate) + (m.surgeHrs * p.laborRate * 1.5));
    m.chemCost = Math.round(m.chemCost);
    m.totalCost = m.laborCost + m.chemCost;
    if (m.totalHrs > peakMonth.totalHrs) peakMonth = m;
  });

  // Compute weekly line downtime hours per area from planModel (defaulting to realistic window if area is independent)
  const areaDowntimeByNorm = new Map();
  const dowAvailHours = [4.5, 4.0, 5.5, 4.5, 4.0, 10.5, 18.0]; // Mon..Sun baseline downtime hours across lines
  if (planModel && planModel.lines && planModel.lines.size > 0) {
    planModel.lines.forEach(L => {
      const normA = normalizeName(L.area);
      const spanMs = Math.max(7 * 864e5, L.last - L.first);
      const spanWeeks = Math.max(1, spanMs / (7 * 864e5));
      let prodMs = 0;
      (L.iv || []).forEach(([s, e]) => { prodMs += Math.max(0, e - s); });
      const totalWindowHrs = (spanWeeks * 168) - (prodMs / 3600000);
      const wkDownHrs = Math.max(12, Math.min(72, Math.round((totalWindowHrs / spanWeeks) * 10) / 10));
      areaDowntimeByNorm.set(normA, wkDownHrs);
    });
  }

  const areaSeries = Array.from(areaMap.values()).map(a => {
    const normA = normalizeName(a.area);
    const scheduledWkDownHrs = areaDowntimeByNorm.get(normA) || 28;
    const reqWk = Math.round(a.weeklyReqHours * 10) / 10;
    const utilizationPct = scheduledWkDownHrs > 0 ? Math.round((reqWk / scheduledWkDownHrs) * 100) : 100;
    return {
      ...a,
      annualHours: Math.round(a.annualHours),
      weeklyReqHours: reqWk,
      scheduledWkDownHrs: Math.round(scheduledWkDownHrs * 10) / 10,
      utilizationPct,
      annualChemCost: Math.round(a.annualChemCost),
      annualLaborCost: Math.round(a.annualLaborCost),
      annualTotalCost: Math.round(a.annualTotalCost),
      avgCleanHrs: a.empHrsCount > 0 ? Math.round((a.empHrsSum / a.empHrsCount) * 10) / 10 : 1.9
    };
  }).sort((a, b) => b.weeklyReqHours - a.weeklyReqHours);

  // Finalize Pareto items (Top 10 + cumulative %)
  paretoList.sort((a, b) => b.totalCost - a.totalCost);
  const grandTotalAssetCost = paretoList.reduce((acc, x) => acc + x.totalCost, 0) || 1;
  let runningCost = 0;
  const paretoItems = paretoList.slice(0, 10).map((it, idx) => {
    runningCost += it.totalCost;
    return {
      ...it,
      rank: idx + 1,
      sharePct: Math.round((it.totalCost / grandTotalAssetCost) * 1000) / 10,
      cumPct: Math.min(100, Math.round((runningCost / grandTotalAssetCost) * 100))
    };
  });

  // Day-of-week distribution (Mon..Sun)
  const dowLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const dowSeries = dowLabels.map((label, idx) => ({
    day: label,
    loggedCleans: loggedCleansByDow[idx] || 0,
    availDowntimeHrs: dowAvailHours[idx]
  }));

  // Annual cost & opportunity summary
  const totalAnnualHrs = Math.round(totalDailyHrs + totalWeeklyHrs + totalDeepHrs);
  const regularLaborCost = Math.round(Math.max(0, totalAnnualHrs - annualOvertimeHrs) * p.laborRate);
  const overtimeLaborCost = Math.round(annualOvertimeHrs * p.laborRate * 1.5);
  const totalLaborCost = regularLaborCost + overtimeLaborCost;

  const chemDailyTotal = Math.round(chemDailySum);
  const chemWeeklyTotal = Math.round(chemWeeklySum);
  const chemDeepTotal = Math.round(chemDeepSum);
  const totalChemCost = chemDailyTotal + chemWeeklyTotal + chemDeepTotal;
  const totalDirectCost = totalLaborCost + totalChemCost;

  // Golden Window Opportunity Valuation from prioritizationModel
  const goldenHrsToday = prioritizationModel && prioritizationModel.summary ? prioritizationModel.summary.goldenHours : 24;
  const tier2HrsToday = prioritizationModel && prioritizationModel.items
    ? prioritizationModel.items.filter(x => x.tier === 2).reduce((s, x) => s + x.estHours, 0)
    : 16;
  // Annualized Golden Window savings: executing deep/overdue cleans during planned downtime instead of holding active lines
  const annualGoldenWindowHrs = Math.round(Math.max(totalDeepHrs * 0.72, goldenHrsToday * 14));
  const annualGoldenWindowSavings = Math.round(annualGoldenWindowHrs * p.downtimeCostHr);
  const unalignedExposureHrs = Math.round(Math.max(12, tier2HrsToday * 4.5));
  const unalignedExposureCost = Math.round(unalignedExposureHrs * p.downtimeCostHr);

  const recommendedFte = Math.ceil((peakMonth.totalHrs / (p.shiftHours * p.daysPerMonth)) * 10) / 10;

  const allEv = chemSource.realEvents + chemSource.typedEvents;
  return {
    econ: p,
    sources: {
      rate: realRate !== null ? 'table' : 'typed',
      chemRealPct: allEv > 0 ? Math.round(chemSource.realEvents / allEv * 100) : 0,
      chemRealAreas: chemSource.realAreas.size
    },
    monthlyCapacityHrs,
    annualCapacityHrs,
    monthlySeries,
    peakMonth,
    areaSeries,
    paretoItems,
    dowSeries,
    totals: {
      totalAnnualHrs,
      totalDailyHrs: Math.round(totalDailyHrs),
      totalWeeklyHrs: Math.round(totalWeeklyHrs),
      totalDeepHrs: Math.round(totalDeepHrs),
      annualOvertimeHrs: Math.round(annualOvertimeHrs),
      regularLaborCost,
      overtimeLaborCost,
      totalLaborCost,
      chemDailyTotal,
      chemWeeklyTotal,
      chemDeepTotal,
      totalChemCost,
      totalDirectCost,
      annualGoldenWindowHrs,
      annualGoldenWindowSavings,
      unalignedExposureHrs,
      unalignedExposureCost,
      recommendedFte
    }
  };
};

// Where the Graphs tab's labor rate and chemical costs come from: the Dataverse tables (COST INPUTS) or the default boxes.
const costStateText = (state, what) => (
  state === 'missing' ? `The ${what} table was not found` :
  state === 'denied' ? `No permission to read the ${what} table (it needs Read)` :
  state === 'nocol' ? `The ${what} table is missing a column this tab needs` :
  state === 'offline' ? 'Not connected to Dataverse' :
  `The ${what} table could not be read`
);
function CostSourcePanel({ real, reading, useReal, onToggle, onRead, sources, typedRate }) {
  // every line is a list of pieces, one text node each, so the Spanish pass can match each piece whole
  const money = (n) => '$' + (Math.round(n * 100) / 100).toFixed(2);
  const list = (items) => { const out = []; items.forEach((t, i) => { if (i) out.push(', '); out.push(t); }); return out; };
  let rate = [], rateOk = false, chem = [], chemOk = false;
  if (reading && !real) { rate = ['Reading the labor rate table...']; chem = ['Reading the chemical list and standards...']; }
  else if (!real) { rate = ['Not read yet.']; }
  else if (real.offline) { rate = ['Not connected to Dataverse: the default boxes are used.']; }
  else if (real.failed) { rate = ['The tables could not be read: the default boxes are used.']; }
  else {
    const rs = real.rateSel, best = rs && rs.best, dflt = ': the default rate (' + money(typedRate) + '/h) is used.';
    if (real.rateRead.state !== 'ok') rate = [costStateText(real.rateRead.state, 'labor rate'), dflt];
    else if (best) { rateOk = true; rate = ['Labor rate ' + money(best.rate) + '/h from the labor rate table (role ' + best.role + ', from ' + best.from + ').']; }
    else {
      const why = [];
      if (rs && rs.tie) why.push('two rows start the same day with different rates');
      if (rs && rs.undated) why.push(rs.undated + ' with no Effective from');
      if (rs && rs.future) why.push(rs.future + ' that start later');
      rate = ['The labor rate table has no usable row for sanitation tech 2, Sanitor or All'].concat(why.length ? [' ('].concat(list(why), [')']) : [], [dflt]);
    }
    const ch = real.chem, cdflt = ': the default chemical boxes are used.';
    if (real.itemRead.state !== 'ok') chem = [costStateText(real.itemRead.state, 'chemical'), cdflt];
    else if (real.stdRead.state !== 'ok') chem = [costStateText(real.stdRead.state, 'chemical standard'), cdflt];
    else if (!ch || !ch.areas) chem = ['No chemical standard gives a priced Daily, Mid-week, Weekly or Monthly clean for an area yet: the default chemical boxes are used.'];
    else {
      chemOk = true;
      const left = [];
      if (ch.equipment) left.push(ch.equipment + ' for one piece of equipment');
      if (ch.other) left.push(ch.other + ' of other clean types');
      if (ch.unpriced) left.push(ch.unpriced + ' items with no gallon price');
      if (ch.noGal) left.push(ch.noGal + ' with no gallons');
      if (ch.future) left.push(ch.future + ' that start later');
      if (ch.tied) left.push(ch.tied + ' with two amounts on one day');
      chem = ['Chemical standards price ' + ch.areas + ' area(s) (' + ch.used + ' rows)']
        .concat(useReal && sources ? [': ' + sources.chemRealPct + '% of this year\'s cleans use them, the rest use the default boxes'] : [])
        .concat(['. Quarterly, semiannual and annual cleans always use the default Deep box.'])
        .concat(left.length ? [' Left out: '].concat(list(left), ['.']) : []);
    }
  }
  const off = !useReal && (rateOk || chemOk);
  const pieces = (arr) => arr.map((t, i) => <span key={i}>{t}</span>);
  return (
    <div className="dt-note" style={{ margin: '0 0 10px', display: 'flex', flexDirection: 'column', gap: 4 }} data-testid="graphs-cost-source">
      <div data-testid="graphs-cost-rate"><b>{rateOk && useReal ? 'In use:' : 'Labor:'}</b> {pieces(rate)}</div>
      {chem.length > 0 && <div data-testid="graphs-cost-chem"><b>{chemOk && useReal ? 'In use:' : 'Chemicals:'}</b> {pieces(chem)}</div>}
      {off && <div style={{ color: '#92400e' }}>The Dataverse numbers are turned off: every figure uses the default boxes.</div>}
      <div style={{ display: 'flex', gap: 12, alignItems: 'center', flexWrap: 'wrap' }}>
        <label style={{ display: 'flex', gap: 6, alignItems: 'center' }}><input type="checkbox" checked={!!useReal} onChange={onToggle} data-testid="graphs-use-real" />Use the Dataverse numbers when found</label>
        <button type="button" className="page-btn" onClick={onRead} disabled={reading} data-testid="graphs-read-cost">{reading ? 'Reading...' : 'Read again'}</button>
      </div>
    </div>
  );
}

function GraphsTab({ analytics, econ, onChangeEcon, onResetEcon, costReal, costReading, costUseReal, onToggleCostUseReal, onReadCost, fullMode, onToggleFullMode, compSummary, anchorYear, onOpenAreaInMatrix }) {
  const [activeSection, setActiveSection] = useState('all'); // 'all' | 'charts'
  const [hoveredMonth, setHoveredMonth] = useState(null);

  const { monthlySeries, monthlyCapacityHrs, peakMonth, areaSeries, paretoItems, dowSeries, totals } = analytics;

  const handleParamChange = (key, val) => {
    const num = Number(val);
    if (!Number.isFinite(num) || num < 0) return;
    onChangeEcon({ ...econ, [key]: num });
  };

  // SVG Chart 1 dimensions (12-Month Extrapolated Labor Demand vs. Headcount Capacity)
  const c1W = 680, c1H = 250, c1PadL = 48, c1PadR = 20, c1PadT = 24, c1PadB = 38;
  const c1PlotW = c1W - c1PadL - c1PadR;
  const c1PlotH = c1H - c1PadT - c1PadB;
  const maxMonthVal = Math.max(monthlyCapacityHrs * 1.15, ...monthlySeries.map(m => Math.max(m.totalHrs, m.loggedHrs)), 100);
  const y1 = (val) => c1PadT + c1PlotH - Math.min(1, Math.max(0, val / maxMonthVal)) * c1PlotH;
  const capY = y1(monthlyCapacityHrs);

  // SVG Chart 2 Donut dimensions (Annual Sanitation Cost Structure)
  const costSlices = [
    { key: 'regLabor', label: 'Base Sanitor Labor', val: totals.regularLaborCost, color: BRAND.blue },
    { key: 'otLabor', label: 'Surge / Overtime Labor', val: totals.overtimeLaborCost, color: '#F59E0B' },
    { key: 'chemDW', label: 'Routine Chemicals & Water (D/W)', val: totals.chemDailyTotal + totals.chemWeeklyTotal, color: '#008060' },
    { key: 'chemDeep', label: 'Deep Boil-Out & QA Swabs (M/Q/A)', val: totals.chemDeepTotal, color: BRAND.red }
  ];
  const donutTotal = Math.max(1, costSlices.reduce((s, x) => s + x.val, 0));
  const donutR = 64;
  const donutCirc = 2 * Math.PI * donutR;
  let donutOffset = 0;

  // SVG Chart 3 dimensions (Area Weekly Required Hours vs. Scheduled Line Downtime Window)
  const c3W = 680, c3H = 250, c3PadL = 48, c3PadR = 20, c3PadT = 24, c3PadB = 46;
  const c3PlotW = c3W - c3PadL - c3PadR;
  const c3PlotH = c3H - c3PadT - c3PadB;
  const maxAreaHrs = Math.max(40, ...areaSeries.map(a => Math.max(a.weeklyReqHours, a.scheduledWkDownHrs)));
  const y3 = (val) => c3PadT + c3PlotH - Math.min(1, Math.max(0, val / maxAreaHrs)) * c3PlotH;

  // SVG Chart 5 dimensions (Day-of-Week Logged Cleans vs. Line Downtime Availability)
  const c5W = 640, c5H = 210, c5PadL = 42, c5PadR = 42, c5PadT = 22, c5PadB = 34;
  const c5PlotW = c5W - c5PadL - c5PadR;
  const c5PlotH = c5H - c5PadT - c5PadB;
  const maxDowCleans = Math.max(10, ...dowSeries.map(d => d.loggedCleans));
  const maxDowHrs = Math.max(20, ...dowSeries.map(d => d.availDowntimeHrs));

  return (
    <main className="exec-main" data-testid="graphs-tab">
      <div className="exec-wrap">
        {/* EXECUTIVE ANALYTICS HERO BANNER */}
        <section className="exec-hero">
          <div className="exec-hero-left">
            <div className="exec-eyebrow">
              <span>LONG-TERM SANITATION STRATEGY &amp; EXTRAPOLATED ANALYTICS</span>
              <span>-</span>
              <span>{anchorYear} ANNUAL PROJECTION</span>
            </div>
            <h2 className="exec-hero-title">Extrapolated Resource Economics, Capacity Curves &amp; Dataverse Roadmap</h2>
            <p className="exec-hero-sub">
              Extrapolates full-year labor hours, chemical and utility spend, headcount capacity collisions, and production line downtime value from the Master Sanitation Schedule. Tune the live operational assumptions below to model long-term staffing, chemical budgets, and CapEx decisions.
            </p>
          </div>
          <div className="exec-hero-right">
            <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
              {[
                { id: 'all', label: 'All Graphs' },
                { id: 'charts', label: 'Executive Graphs Only' }
              ].map(btn => (
                <button
                  key={btn.id}
                  type="button"
                  onClick={() => setActiveSection(btn.id)}
                  style={{
                    padding: '7px 12px',
                    borderRadius: 8,
                    fontSize: 11,
                    fontWeight: 800,
                    cursor: 'pointer',
                    border: activeSection === btn.id ? `1.5px solid ${BRAND.yellow}` : '1px solid rgba(255,255,255,0.28)',
                    background: activeSection === btn.id ? BRAND.yellow : 'rgba(15, 23, 42, 0.35)',
                    color: activeSection === btn.id ? '#001E42' : '#ffffff'
                  }}
                >
                  {btn.label}
                </button>
              ))}
            </div>
          </div>
        </section>

        {/* INTERACTIVE ECONOMIC & OPERATIONAL ASSUMPTIONS SIMULATOR */}
        <section className="exec-card" data-testid="graphs-econ-bar">
          <div className="exec-card-head" style={{ marginBottom: 10 }}>
            <div>
              <h3 className="exec-card-title">Live Plant Cost &amp; Capacity Assumptions (What-If Simulator)</h3>
              <p className="exec-card-sub">The labor rate and chemical costs come from Dataverse when the tables have them. The boxes are the defaults used until then; change any box to recalculate the graphs.</p>
            </div>
            <button type="button" className="page-btn" onClick={onResetEcon} title="Restore the default numbers in the boxes">
              Reset Defaults
            </button>
          </div>
          <CostSourcePanel real={costReal} reading={costReading} useReal={costUseReal} onToggle={onToggleCostUseReal} onRead={onReadCost} sources={analytics.sources} typedRate={econ.laborRate} />
          <div className="graphs-param-grid">
            <label className="graphs-param-field">
              <span>Default Labor Rate ($/hr)</span>
              <input type="number" min="15" max="120" step="1" value={econ.laborRate} onChange={e => handleParamChange('laborRate', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Active Sanitor Headcount (FTE)</span>
              <input type="number" min="1" max="60" step="1" value={econ.headcount} onChange={e => handleParamChange('headcount', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Effective Clean Hrs / Shift</span>
              <input type="number" min="3" max="12" step="0.5" value={econ.shiftHours} onChange={e => handleParamChange('shiftHours', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Operating Days / Month</span>
              <input type="number" min="15" max="31" step="1" value={econ.daysPerMonth} onChange={e => handleParamChange('daysPerMonth', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Default Daily (D) Chemical ($ a piece)</span>
              <input type="number" min="0" max="500" step="2" value={econ.chemDaily} onChange={e => handleParamChange('chemDaily', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Default Weekly (W/MW) Chemical ($ a piece)</span>
              <input type="number" min="0" max="1000" step="5" value={econ.chemWeekly} onChange={e => handleParamChange('chemWeekly', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Default Deep (M/Q/S/A) Chemical ($ a piece)</span>
              <input type="number" min="0" max="2500" step="10" value={econ.chemDeep} onChange={e => handleParamChange('chemDeep', e.target.value)} />
            </label>
            <label className="graphs-param-field">
              <span>Line Hold / Downtime Cost ($/hr)</span>
              <input type="number" min="100" max="15000" step="50" value={econ.downtimeCostHr} onChange={e => handleParamChange('downtimeCostHr', e.target.value)} />
            </label>
          </div>
        </section>

        {/* EXECUTIVE EXTRAPOLATED KPI STRIP */}
        <section className="exec-kpi-grid">
          <div className="exec-kpi-card tier3">
            <div className="exec-kpi-top">
              <span className="exec-kpi-tag" style={{ background: '#DBEAFE', color: BRAND.blueDark }}>EXTRAPOLATED ANNUAL WORKLOAD</span>
              <span className="exec-kpi-pts">{monthlyCapacityHrs.toLocaleString()} hrs/mo cap</span>
            </div>
            <div className="exec-kpi-val">{totals.totalAnnualHrs.toLocaleString()} <span style={{ fontSize: 14, fontWeight: 800 }}>hrs/yr</span></div>
            <div className="exec-kpi-meta">
              <span>Peak: <b>{peakMonth.monthShort} ({peakMonth.totalHrs.toLocaleString()} hrs)</b></span>
              <span>-</span>
              <span>Rec. Peak FTE: <b>{totals.recommendedFte}</b></span>
            </div>
          </div>

          <div className="exec-kpi-card tier2">
            <div className="exec-kpi-top">
              <span className="exec-kpi-tag" style={{ background: '#FEF3C7', color: '#92400E' }}>ANNUAL LABOR + CHEMICAL BUDGET</span>
              <span className="exec-kpi-pts">{totals.annualOvertimeHrs} OT hrs</span>
            </div>
            <div className="exec-kpi-val">${totals.totalDirectCost.toLocaleString()}</div>
            <div className="exec-kpi-meta">
              <span>Labor: <b>${totals.totalLaborCost.toLocaleString()}</b></span>
              <span>-</span>
              <span>Chemicals/Swabs: <b>${totals.totalChemCost.toLocaleString()}</b></span>
            </div>
          </div>

          <div className="exec-kpi-card" style={{ borderTop: `4px solid #008060` }}>
            <div className="exec-kpi-top">
              <span className="exec-kpi-tag" style={{ background: '#D1FAE5', color: '#065F46' }}>GOLDEN WINDOW OEE VALUE</span>
              <span className="exec-kpi-pts">${econ.downtimeCostHr.toLocaleString()}/hr line rate</span>
            </div>
            <div className="exec-kpi-val" style={{ color: '#047857' }}>${totals.annualGoldenWindowSavings.toLocaleString()}</div>
            <div className="exec-kpi-meta">
              <span><b>{totals.annualGoldenWindowHrs} hrs/yr</b> of deep teardowns aligned to planned downtime</span>
            </div>
          </div>

          <div className={`exec-kpi-card ${fullMode ? 'unlocked' : 'locked'}`} onClick={!fullMode ? onToggleFullMode : undefined} style={{ cursor: !fullMode ? 'pointer' : 'default' }}>
            <div className="exec-kpi-top">
              <span className="exec-kpi-tag" style={{ background: fullMode ? '#DCFCE7' : '#F1F5F9', color: fullMode ? '#166534' : '#475569' }}>
                {fullMode ? 'VERIFIED COMPLIANCE & RISK' : 'SENSITIVE METRICS LOCKED'}
              </span>
              <span className="exec-kpi-pts">{fullMode ? 'Executive Mode' : 'Click CJ Logo'}</span>
            </div>
            {fullMode ? (
              <>
                <div className="exec-kpi-val" style={{ color: BRAND.blueDark }}>
                  {compSummary && compSummary.ytdPct !== null && compSummary.ytdPct !== undefined ? `${compSummary.ytdPct}%` : '94%'}
                </div>
                <div className="exec-kpi-meta">
                  <span>YTD MSS Completion</span>
                  <span>-</span>
                  <span>Unaligned Hold Risk: <b style={{ color: BRAND.red }}>${totals.unalignedExposureCost.toLocaleString()}</b></span>
                </div>
              </>
            ) : (
              <>
                <div className="exec-kpi-val locked-val">
                  <LockClosedIcon />
                  <span>Executive Locked</span>
                </div>
                <div className="exec-kpi-meta">
                  <span>Click the <b>CJ Foods Logo</b> to unlock YTD Completion % &amp; Line Hold Risk</span>
                </div>
              </>
            )}
          </div>
        </section>

        {/* CHARTS SECTION */}
        {(activeSection === 'all' || activeSection === 'charts') && (
          <>
            <div className="graphs-two-col">
              {/* CHART 1: 12-MONTH EXTRAPOLATED SANITATION DEMAND VS HEADCOUNT CAPACITY */}
              <section className="exec-card" data-testid="chart-monthly-demand">
                <div className="exec-card-head">
                  <div>
                    <h3 className="exec-card-title">1. 12-Month Extrapolated Sanitation Labor Demand vs. FTE Capacity</h3>
                    <p className="exec-card-sub">
                      Stacked monthly hours by frequency tier (Daily, Weekly/Mid-Week, Deep M/Q/A) against available crew capacity ({econ.headcount} FTE x {econ.shiftHours}h x {econ.daysPerMonth}d = {monthlyCapacityHrs} hrs/mo).
                    </p>
                  </div>
                  <div className="exec-legend">
                    <span className="exec-leg-item"><i style={{ background: BRAND.blue }} /> Daily ({totals.totalDailyHrs}h)</span>
                    <span className="exec-leg-item"><i style={{ background: '#008060' }} /> Weekly/MW ({totals.totalWeeklyHrs}h)</span>
                    <span className="exec-leg-item"><i style={{ background: BRAND.yellow }} /> Deep M/Q/A ({totals.totalDeepHrs}h)</span>
                    <span className="exec-leg-item"><i style={{ background: BRAND.red, height: 3 }} /> FTE Capacity ({monthlyCapacityHrs}h)</span>
                  </div>
                </div>

                <div className="graphs-svg-wrap">
                  <svg viewBox={`0 0 ${c1W} ${c1H}`} className="graphs-svg" role="img" aria-label="12-Month Extrapolated Sanitation Labor Demand Chart">
                    {/* Horizontal grid lines */}
                    {[0, 0.25, 0.5, 0.75, 1].map((t, i) => {
                      const val = Math.round(maxMonthVal * t);
                      const y = y1(val);
                      return (
                        <g key={i}>
                          <line x1={c1PadL} y1={y} x2={c1W - c1PadR} y2={y} stroke="#CBD5E1" strokeDasharray={t === 0 ? undefined : '3 3'} strokeWidth="1" opacity="0.55" />
                          <text x={c1PadL - 6} y={y + 4} textAnchor="end" fontSize="10" fontWeight="700" fill="#64748B">{val}h</text>
                        </g>
                      );
                    })}

                    {/* Monthly stacked bars */}
                    {monthlySeries.map((m, idx) => {
                      const colStep = c1PlotW / 12;
                      const barW = Math.min(32, colStep * 0.62);
                      const x = c1PadL + idx * colStep + (colStep - barW) / 2;

                      const hD = (m.dailyHrs / maxMonthVal) * c1PlotH;
                      const hW = (m.weeklyHrs / maxMonthVal) * c1PlotH;
                      const hDeep = (m.deepHrs / maxMonthVal) * c1PlotH;

                      const yD = c1PadT + c1PlotH - hD;
                      const yW = yD - hW;
                      const yDeep = yW - hDeep;
                      const overCap = m.totalHrs > monthlyCapacityHrs;

                      return (
                        <g
                          key={m.monthShort}
                          onMouseEnter={() => setHoveredMonth(m)}
                          onMouseLeave={() => setHoveredMonth(null)}
                          style={{ cursor: 'pointer' }}
                        >
                          {/* Daily tier */}
                          <rect x={x} y={yD} width={barW} height={Math.max(0, hD)} fill={BRAND.blue} rx="2" />
                          {/* Weekly / Mid-Week tier */}
                          <rect x={x} y={yW} width={barW} height={Math.max(0, hW)} fill="#008060" />
                          {/* Deep M/Q/A tier */}
                          <rect x={x} y={yDeep} width={barW} height={Math.max(0, hDeep)} fill={overCap ? BRAND.red : BRAND.yellow} rx="2" />

                          {/* Value label on top of bar */}
                          <text x={x + barW / 2} y={Math.max(12, yDeep - 5)} textAnchor="middle" fontSize="9.5" fontWeight="900" fill={overCap ? BRAND.red : '#475569'}>
                            {m.totalHrs}h
                          </text>

                          {/* Month label */}
                          <text x={x + barW / 2} y={c1H - 18} textAnchor="middle" fontSize="10.5" fontWeight="800" fill="#334155">
                            {m.monthShort}
                          </text>
                          {(m.isQuarterPeak || m.isAnnualTurnaround) && (
                            <text x={x + barW / 2} y={c1H - 6} textAnchor="middle" fontSize="8.5" fontWeight="900" fill={m.isAnnualTurnaround ? BRAND.red : '#B45309'}>
                              {m.isAnnualTurnaround ? 'SHUTDOWN' : 'Q-PEAK'}
                            </text>
                          )}
                        </g>
                      );
                    })}

                    {/* FTE Capacity threshold line */}
                    <line x1={c1PadL} y1={capY} x2={c1W - c1PadR} y2={capY} stroke={BRAND.red} strokeWidth="2" strokeDasharray="6 4" />
                    <rect x={c1W - c1PadR - 142} y={Math.max(4, capY - 18)} width="140" height="15" rx="4" fill={BRAND.red} />
                    <text x={c1W - c1PadR - 72} y={Math.max(14, capY - 7)} textAnchor="middle" fontSize="9" fontWeight="900" fill="#FFFFFF">
                      CAPACITY CEILING: {monthlyCapacityHrs}h
                    </text>
                  </svg>
                </div>

                <div className="graphs-insight-strip">
                  {hoveredMonth ? (
                    <span>
                      <b>{hoveredMonth.monthName} {anchorYear} Breakdown:</b> Total <b>{hoveredMonth.totalHrs} hrs</b> (Daily: {hoveredMonth.dailyHrs}h - Weekly/MW: {hoveredMonth.weeklyHrs}h - Deep M/Q/A: {hoveredMonth.deepHrs}h) - Est. Cost: <b>${hoveredMonth.totalCost.toLocaleString()}</b> {hoveredMonth.surgeHrs > 0 ? `- Exceeds capacity by ${hoveredMonth.surgeHrs} hrs (requires overtime or pre-staging)` : '- Within regular shift capacity'}
                    </span>
                  ) : (
                    <span>
                      <b>Long-Term Staffing Insight:</b> Quarterly (Mar/Jun/Sep/Dec) and Annual Turnaround months (Apr/Oct) create a <b>{peakMonth.totalHrs - monthlyCapacityHrs > 0 ? `+${peakMonth.totalHrs - monthlyCapacityHrs} hr surge` : 'seasonal peak'}</b> in <b>{peakMonth.monthName}</b>. Pre-staging Monthly/Quarterly cleans into mid-week Golden Windows eliminates <b>${totals.overtimeLaborCost.toLocaleString()}/yr</b> in overtime burn.
                    </span>
                  )}
                </div>
              </section>

              {/* CHART 2: ANNUAL SANITATION COST STRUCTURE & GOLDEN WINDOW ROI */}
              <section className="exec-card" data-testid="chart-cost-breakdown">
                <div className="exec-card-head">
                  <div>
                    <h3 className="exec-card-title">2. Annual Sanitation Cost Breakdown &amp; Golden Window Value</h3>
                    <p className="exec-card-sub">
                      Extrapolated annual labor and tiered chemical spend (${totals.totalDirectCost.toLocaleString()}/yr) compared against production line hold avoidance.
                    </p>
                  </div>
                </div>

                <div className="graphs-cost-layout">
                  <div className="graphs-donut-box">
                    <svg viewBox="0 0 180 180" width="168" height="168" role="img" aria-label="Annual Sanitation Cost Donut Chart">
                      <circle cx="90" cy="90" r={donutR} fill="none" stroke="#E2E8F0" strokeWidth="22" />
                      {costSlices.map(s => {
                        const frac = s.val / donutTotal;
                        const dash = frac * donutCirc;
                        const currentOffset = donutOffset;
                        donutOffset += dash;
                        return (
                          <circle
                            key={s.key}
                            cx="90"
                            cy="90"
                            r={donutR}
                            fill="none"
                            stroke={s.color}
                            strokeWidth="22"
                            strokeDasharray={`${dash} ${donutCirc - dash}`}
                            strokeDashoffset={-currentOffset}
                            transform="rotate(-90 90 90)"
                          />
                        );
                      })}
                      <text x="90" y="84" textAnchor="middle" fontSize="10" fontWeight="800" fill="#64748B">ANNUAL SPEND</text>
                      <text x="90" y="102" textAnchor="middle" fontSize="15" fontWeight="900" fill="#0F172A" className="graphs-donut-center-val">
                        ${Math.round(totals.totalDirectCost / 1000)}k
                      </text>
                    </svg>
                  </div>

                  <div className="graphs-cost-list">
                    {costSlices.map(s => {
                      const pct = Math.round((s.val / donutTotal) * 100);
                      return (
                        <div key={s.key} className="graphs-cost-row">
                          <div className="graphs-cost-row-top">
                            <span className="graphs-cost-label">
                              <i style={{ background: s.color }} />
