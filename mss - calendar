        /* AUTHENTIC CJ FOODS LOGO & EXECUTIVE LOCK BUTTON */
        .logo-btn { display: inline-flex; align-items: center; gap: 10px; height: 42px; padding: 0 12px 0 6px; border: 1px solid #cbd5e1; border-radius: 12px; background: #ffffff; color: #0f172a; font-family: inherit; cursor: pointer; flex-shrink: 0; transition: all 0.18s ease; box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06); }
        .logo-btn:focus-visible { outline: 2px solid ${BRAND.blue}; outline-offset: 2px; }
