        .group-label { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1; }
        .group-name { font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        /* FREQUENCY MEDALLION */
        .freq-pill { display: inline-flex; align-items: center; gap: 1px; padding: 2px 3px; border-radius: 999px; border: 1px solid #cbd5e1; background: #fff; font-size: 9px; font-weight: 900; line-height: 14px; letter-spacing: 0; flex-shrink: 0; cursor: help; color: #64748b; }
        .freq-pill.ok { border-color: ${BRAND.greenLine}; background: ${BRAND.greenSoft}; }
