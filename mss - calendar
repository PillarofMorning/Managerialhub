        }
        .corner { min-height: ${headH}px; border-bottom: 2px solid ${BRAND.blueLine}; background: ${BRAND.blueSoft}; display: flex; flex-direction: column; justify-content: flex-start; padding: 0; font-weight: 800; font-size: 11px; color: ${BRAND.blueDark}; letter-spacing: 0.08em; }
        .corner-top { flex: ${fullMode ? '0 0 ' + headH + 'px' : '1 1 auto'}; ${compact ? 'min-height: 0; overflow: hidden; ' : ''}box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; padding: 0 16px; }
        .corner-pct { height: ${H.pct}px; border-bottom: 1px solid #cbd5e1; display: flex; align-items: center; justify-content: flex-end; padding: 0 16px; font-size: 8px; font-weight: 800; letter-spacing: 0.06em; color: ${BRAND.blueDark}; background: #fff; flex-shrink: 0; }
        .corner-pct.cnt { height: ${H.pcn}px; }
        .corner-pct.last { border-bottom: none; height: ${H.pct - 2}px; }   /* the corner's own 2px bottom border completes the height the timeline row has */
        .corner-pct.last.cnt { height: ${H.pcn - 2}px; }
        .corner-legend { display: block; margin-top: ${compact ? 3 : 6}px; font-size: 9px; font-weight: 600; color: #475569; letter-spacing: 0; line-height: ${compact ? 1.35 : 1.5}; }

        .header-blocks { display: flex; flex-direction: column; }
        .month-tier { display: flex; height: ${H.month}px; border-bottom: 1px solid #cbd5e1; }
        .week-tier { display: flex; height: ${H.week}px; border-bottom: 1px solid #cbd5e1; }
        .day-tier { display: flex; height: ${H.day}px; border-bottom: ${fullMode ? '1px solid #cbd5e1' : `2px solid ${BRAND.blueLine}`}; }
        .pct-tier { display: flex; height: ${H.pct}px; border-bottom: 1px solid #cbd5e1; background: #fff; }
        .pct-tier.cnt { height: ${H.pcn}px; }
        .pct-tier.last { border-bottom: 2px solid ${BRAND.blueLine}; }
        .cell-pct { flex-shrink: 0; border-right: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; letter-spacing: -0.02em; color: #94a3b8; cursor: default; }
        .cell-pct.good { background: ${BRAND.greenSoft}; color: #15803d; }
        .cell-pct.warn { background: ${BRAND.yellowSoft}; color: #92400e; }
