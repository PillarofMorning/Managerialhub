        const row = res && res.entities && res.entities[0] ? res.entities[0] : null;
        const keys = row ? Object.keys(row) : [];
        next[t.logicalName] = { status: 'ONLINE', ms, colsFound: keys.length, note: row ? `Sample row returned (${keys.length} fields)` : 'Table online (0 rows)' };
