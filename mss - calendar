        }
        .area-pagination-bar {
          display: flex; align-items: center; padding: 8px 16px; background: #fffbeb; border-bottom: 1px solid #fde68a;
          width: max-content; min-width: ${frozenWidth}px; gap: 12px;
        }

        .page-btn { padding: 6px 14px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; transition: 0.1s; font-size: 11px; font-weight: bold; }
        .page-btn:hover:not(:disabled) { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
        .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

