    function shift(n: number) { var d = new Date(y, mo - 1 + n, 1); monthState[1](d.getFullYear() + '-' + sdPad(d.getMonth() + 1)); }
    var cells: string[] = []; for (var i = 0; i < 42; i++) { var d = hubAddDays(start, i); if (i >= 35 && d.slice(0, 7) !== month) break; cells.push(d); }
