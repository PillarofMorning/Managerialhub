var SD_MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
function sdMonthName(i: number, short?: boolean) { var n = sdT(SD_MONTHS[i]); return short ? n.slice(0, 3) : n; }
function sdMonthLabel(ym: string) { return sdMonthName(Number(ym.slice(5, 7)) - 1) + ' ' + ym.slice(0, 4); }
function sdHour(h: any) { if (h === null || h === undefined || !isFinite(h)) return '--'; var hh = ((Math.round(h) % 24) + 24) % 24; return (hh < 10 ? '0' : '') + hh + ':00'; }
function sdCrewLabel(c: string) { return c === 'N' ? sdT('Night shift') : sdT('Crew {c}', { c: c }); }
function sdDnLabel(dn: string) { return dn === 'night' ? sdT('Night') : dn === 'day' ? sdT('Day') : sdT('Unknown'); }
function sdUtilTone(u: any, target: number) { if (u === null || u === undefined) return 'none'; if (u > 100.5) return 'over'; if (u >= target * 0.8) return 'good'; return 'low'; }
var SD_TONE_CLS: any = { none: 'bg-slate-100 text-slate-500 border-slate-200', good: 'bg-emerald-50 text-emerald-800 border-emerald-200', low: 'bg-amber-50 text-amber-800 border-amber-200', over: 'bg-[#E6F1FB] text-[#00468B] border-[#B3D4F2]' };
function sdSide(sum: any, side: string) { return side === 'day' ? sum.day : side === 'night' ? sum.night : sum.all; }

function SdSideToggle(props: any) {
