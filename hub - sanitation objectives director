                sdLoadEmployees(dataApi),
                sdLoad(dataApi, 'workshifts', SD_READ.workshifts, 'statecode eq 0'),
                sdLoad(dataApi, 'cleanplan', SD_READ.cleanplan, "statecode eq 0 and (craa5_rowtype eq 'staff' or craa5_rowtype eq 'week' or craa5_rowtype eq 'scope')", 20000),
                sdLoad(dataApi, 'cleanplan', SD_READ.windows, "statecode eq 0 and craa5_rowtype eq 'window'", 20000),
                sdLoad(dataApi, 'assets', SD_READ.assets, 'statecode eq 0', 20000, SD_OPTIONAL.assets),
                sdLoad(dataApi, 'msslog', SD_READ.msslog, 'statecode eq 0 and craa5_lastcleaned ge ' + hubDateOnlyUtc(from), 100000, SD_OPTIONAL.msslog),
                sdLoadBoards(dataApi, from),
                sdLoad(dataApi, 'rates', SD_READ.rates, 'statecode eq 0')
            ]).then(function (res: any[]) {
                if (dead) return;
                dataState[1]({ employees: res[0], workshifts: res[1], cleanplan: res[2], windows: res[3], assets: res[4], msslog: res[5], board: res[6].live, archive: res[6].archive, rates: res[7], boards: res[6].boards });
                loadingState[1](false);
                hubSaveManifest(sdManifestIo(dataApi), SD_MANIFEST).then(function (r: string) { manifestState[1](r); });
            });
        }).then(null, function (e: any) { if (!dead) { loadingState[1](false); setMsg({ tone: 'bad', text: sdErrText(e) }); } });
        return function () { dead = true; };
    }, [reloadState[0]]);

    var today = hubPlantDay(Date.now());
    var norm = useMemo(function () {
        var assetsRaw = data.assets.rows || [];
        var assets = assetsRaw.map(sdNormAsset), byId: any = {};
        assets.forEach(function (a: any) { if (a.id) byId[a.id] = a; });
        var plan = data.cleanplan.rows || [];
        var lineAreas: any = {};
        (data.windows.rows || []).forEach(function (r: any) { if (r.craa5_area) lineAreas[hubCanon(r.craa5_area)] = true; });
        return {
            employees: (data.employees.rows || []).map(sdNormEmployee),
            slots: mpParseSlots(data.workshifts.rows || []),
            staff: plan.filter(function (r: any) { return String(r.craa5_rowtype).toLowerCase() === 'staff'; }).map(sdNormStaff),
            doneWeeks: sdDoneWeeks(plan.filter(function (r: any) { return String(r.craa5_rowtype).toLowerCase() === 'week'; })),
            scopes: mpScopes(plan.filter(function (r: any) { return String(r.craa5_rowtype).toLowerCase() === 'scope'; })),
            assetsRaw: assetsRaw, assets: assets, lineAreas: lineAreas,
            logs: (data.msslog.rows || []).map(function (r: any) { return sdNormLog(r, byId); }),
            rates: (data.rates.rows || []).map(sdNormRate)
        };
    }, [data]);
    var crewplan = crewplanState[0] && crewplanState[0].json ? crewplanState[0].json : null;
    var m = useMemo(function () {
        return sdBuildModel({ employees: norm.employees, slots: norm.slots, staff: norm.staff, doneWeeks: norm.doneWeeks, scopes: norm.scopes, assetsRaw: norm.assetsRaw, assets: norm.assets,
            logs: norm.logs, boards: data.boards, rates: norm.rates, crewplan: crewplan, settings: S, today: today, lineAreas: norm.lineAreas });
    }, [norm, S, today, crewplanState[0]]);
    var devAllowed = !!user && sdIsDev(user, S.devUsers);
    var devOpen = devOpenState[0] && devAllowed;
    var canSave = !!where.table && !!sdWriter(dataApi);

    function onLogo() { if (!devAllowed) return; var v = !devOpenState[0]; devOpenState[1](v); sdWriteSession(SD_DEV_KEY, v ? '1' : null); if (!v && (tab === 'setup' || tab === 'data')) setTab('overview'); }
    function setTab(t: string) { tabState[1](t); sdWriteLocal(SD_TAB_KEY, t); }
    function saveSettings(next: any, done?: any) {
        if (busy) return;
        setBusy(true); setMsg(null);
        var clean = sdMergeSettings(next);
        sdSaveSettings(dataApi, where, clean).then(function (id: string) {
            whereState[1](function (o: any) { var n: any = {}; for (var k in o) n[k] = o[k]; n.id = id || o.id; n.json = clean; return n; });
            settingsState[1](clean);
            if (done) done();
            setMsg({ tone: 'good', text: sdT('Saved for everyone.') });
        }, function (e: any) { setMsg({ tone: 'bad', text: sdT('Not saved: {err}', { err: sdErrText(e) }) }); }).then(function () { setBusy(false); });
    }
    function saveCrews(crews: any[], cycle: string, done: any) { var n = sdClone(S); n.crews = crews; n.cycleStart = cycle; saveSettings(n, done); }

    var tabs = SD_TAB_LIST.concat(devOpen ? SD_DEV_TAB_LIST : []);
    var shownTab = tabs.some(function (t: any) { return t[0] === tab; }) ? tab : 'overview';
    function setLang(l: string) { sdSetLang(l); hubSetLang(l); langState[1](l); setMsg(null); }
    function setTheme(t: string) { hubSetTheme(t); themeState[1](t); }
    var dark = theme === 'dark'; var th = dark ? HUB_COLORS.dark : HUB_COLORS.light;
    var noHost = !sdWeb() && !(dataApi && dataApi.queryTable);
    var problems: string[] = [];
    if (!loadingState[0] && !noHost) {
        if (!data.employees.rows) problems.push(sdT('Employees could not be read ({w}), so scheduled hours and wages are not known.', { w: sdT(sdLoadWord(data.employees)) }));
        if (!data.workshifts.rows || !norm.slots.length) problems.push(sdT('Work Shifts gave no shift hours ({w}), so shifts come only from the crew plan, the boards and the log.', { w: sdT(sdLoadWord(data.workshifts)) }));
        if (!data.msslog.rows) problems.push(sdT('The MSS log could not be read ({w}), so nothing shows as logged.', { w: sdT(sdLoadWord(data.msslog)) }));
        if (!data.cleanplan.rows) problems.push(sdT('The clean plan could not be read ({w}), so every called-for number is projected.', { w: sdT(sdLoadWord(data.cleanplan)) }));
        else if (!m.counts.staffUsed) problems.push(sdT('The Production Scheduler has not published crew plan rows yet (Crew plan tab, v4.7), so called for is projected everywhere.'));
        if (!data.rates.rows) problems.push(sdT('_e_ Labor rate could not be read ({w}): wages show "no rate set".', { w: sdT(sdLoadWord(data.rates)) }));
        else if (m.noRate) problems.push(sdT('No {r} rate row with an Effective from date on or before today: costs show "no rate set".', { r: SD_TECH2 }));
        if (!data.board.rows && !data.archive.rows) problems.push(sdT('Shift Start boards could not be read, so on the clock uses today\'s roster for every past shift.'));
    }
    var first = user && user.name ? sdFirstName(user.name) : '';
    function openShift(k: string) { setModal({ type: 'shift', key: k }); }
    function openWeek(w: string) { setModal({ type: 'week', week: w }); }
    return (
        <div ref={rootRef} className={'sd-root ' + (dark ? 'sd-dark' : '')} data-theme={theme} lang={lang === 'es' ? 'es-MX' : 'en'}
            style={{ height: heightState[0] ? heightState[0] : '100vh', overflowY: 'auto', overflowX: 'hidden', backgroundColor: th.bg, color: th.text, fontFamily: "'Segoe UI', Arial, sans-serif", position: 'relative' }}>
            <header className="bg-white border-b border-slate-200 sticky top-0 z-30 sd-noprint">
                <div className="flex flex-wrap items-center gap-3 px-4 py-2.5">
                    <div className="flex items-center gap-3 mr-2">
                        <SdLogo onClick={onLogo} open={devOpen} allowed={devAllowed} />
                        <div>
                            <div className="font-black text-[#00468B] leading-tight" data-welcome="1">{sdT('Sanitation objectives director')}</div>
                            <div className="text-[11px] text-slate-500 leading-tight">{first ? sdT('Hello, {name}. ', { name: first }) : ''}{sdT('Scheduled, called for, utilized and suggested, days and nights')}</div>
                        </div>
                    </div>
                    <div className="flex-1" />
                    <div className="flex flex-wrap items-center gap-2">
                        <div className="inline-flex rounded-lg border border-slate-300 overflow-hidden" role="group" aria-label={sdT('Language')}>
                            {[['en', 'EN'], ['es', 'ES']].map(function (x: any) { return <button key={x[0]} type="button" data-lang={x[0]} onClick={function () { setLang(x[0]); }} aria-pressed={lang === x[0]} className={'px-2.5 py-1.5 text-xs font-black ' + (lang === x[0] ? 'bg-[#0072CE] text-white' : 'bg-white text-slate-600 hover:bg-slate-50')}>{x[1]}</button>; })}
                        </div>
                        <SdBtn kind="ghost" onClick={function () { setTheme(dark ? 'light' : 'dark'); }} title={dark ? sdT('Light mode') : sdT('Dark mode')} label={dark ? sdT('Light mode') : sdT('Dark mode')} pressed={dark}><SdIcon name={dark ? 'sun' : 'moon'} /></SdBtn>
                        <SdBtn kind="ghost" onClick={function () { setModal({ type: 'help' }); }} title={sdT('Help')} label={sdT('Help')} className="font-black text-base">?</SdBtn>
                        <SdBtn onClick={function () { reloadState[1](reloadState[0] + 1); }} disabled={busy || loadingState[0]} title={sdT('Read again')}><SdIcon name="refresh" size={14} />{sdT('Read again')}</SdBtn>
                    </div>
                </div>
                <nav className="flex gap-1 px-3 pb-2 sd-tabs" style={{ overflowX: 'auto' }} role="tablist">
                    {tabs.map(function (t: any) {
                        return <button key={t[0]} type="button" data-testtab={t[0]} role="tab" aria-selected={shownTab === t[0]} onClick={function () { setTab(t[0]); }}
                            className={'px-3 py-1.5 rounded-full text-sm font-bold whitespace-nowrap ' + (shownTab === t[0] ? 'bg-[#0072CE] text-white' : 'text-slate-600 hover:bg-slate-100')}>{sdT(t[1])}</button>;
                    })}
                </nav>
            </header>
            <main className="p-3 sm:p-4 space-y-4 max-w-[1600px] mx-auto">
                {twState[0] === 'failed' && <SdNote tone="warn">{sdT('The page styling (cdn.tailwindcss.com) did not load on this computer, so the page looks plain. Everything still works.')}</SdNote>}
                {noHost && <SdNote tone="bad">{sdT('This page is not connected to Dataverse (no Xrm.WebApi and no dataApi). Open it inside the model-driven app. Nothing below is real data until it is.')}</SdNote>}
                {loadingState[0] && !noHost && <SdNote>{sdT('Reading crews, shifts, the crew plan, the MSS log and wages from Dataverse...')}</SdNote>}
                {problems.map(function (p: string, i: number) { return <SdNote key={i} tone="warn">{p}</SdNote>; })}
                {msg && <SdNote tone={msg.tone}><div className="flex items-start gap-2"><span className="flex-1" data-msg={msg.tone}>{msg.text}</span><button type="button" className="font-bold" onClick={function () { setMsg(null); }}>{sdT('Dismiss')}</button></div></SdNote>}
                {!loadingState[0] && !noHost && (
                    <div>
                        {shownTab === 'overview' && <SdOverviewTab m={m} settings={S} dark={dark} onWeek={openWeek} onShift={openShift} />}
                        {shownTab === 'calendar' && <SdCalendarTab m={m} settings={S} dark={dark} onShift={openShift} onDay={function (d: string) { setModal({ type: 'day', day: d }); }} />}
                        {shownTab === 'crews' && <SdCrewsTab m={m} settings={S} dark={dark} onShift={openShift} />}
                        {shownTab === 'year' && <SdYearTab m={m} settings={S} dark={dark} slots={norm.slots} busy={busy} canSave={canSave} onSaveCrews={saveCrews} onWeek={openWeek} />}
                        {shownTab === 'cost' && <SdCostTab m={m} dark={dark} onWeek={openWeek} />}
                        {shownTab === 'setup' && <SdSetupTab settings={S} user={user} busy={busy} canSave={canSave} onSave={saveSettings} />}
                        {shownTab === 'data' && <SdDataTab data={data} m={m} where={where} crewplan={crewplanState[0]} manifest={manifestState[0]} />}
                    </div>
                )}
            </main>
            {modal && modal.type === 'shift' && <SdShiftModal key={modal.key} m={m} shiftKey={modal.key} dark={dark} onClose={function () { setModal(null); }} />}
            {modal && modal.type === 'week' && <SdWeekModal m={m} week={modal.week} target={S.target} onShift={openShift} onClose={function () { setModal(null); }} />}
            {modal && modal.type === 'day' && <SdDayModal m={m} day={modal.day} target={S.target} onShift={openShift} onClose={function () { setModal(null); }} />}
            {modal && modal.type === 'help' && <SdHelpModal tab={shownTab} onClose={function () { setModal(null); }} />}
        </div>
    );
}
// ==== END DIRECTOR APP ====
