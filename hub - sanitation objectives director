                    <SdChip>{sdT('Logged')} {sdH(msAll.logged)}</SdChip>
                    <SdChip cls={SD_TONE_CLS[sdUtilTone(msAll.util, S.target)]}>{sdT('Utilization % (actual)')} {sdPct(msAll.util)}</SdChip>
                    <SdChip>{sdT('Wage cost (logged)')} {sdMoney(msAll.loggedWage, msAll.noRate)}</SdChip>
