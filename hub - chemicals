// ============================================================================
// DATAVERSE CHECK: reads table definitions (EntityDefinitions), plus one count per table to show whether rows can be read
// ----------------------------------------------------------------------------
// A 404 counts as "not found" only when Dataverse answers with its own error; 401 / 403 is "no permission"; no answer is
// "no answer". When a detail request fails, those details are "not checked", never "found" or "missing".
// ============================================================================
const CH_API = '/api/data/v9.2/';
const CH_HEADERS = { 'Accept': 'application/json', 'OData-MaxVersion': '4.0', 'OData-Version': '4.0', 'Prefer': 'odata.include-annotations="*"' };
const CH_TIMEOUT_MS = 20000;
const CH_PARALLEL = 4;
const CH_SYSTEM_COLUMNS = ['statecode', 'statuscode', 'createdon', 'modifiedon', 'versionnumber', 'createdby', 'modifiedby', 'ownerid', 'owningbusinessunit',
    'owningteam', 'owninguser', 'createdonbehalfby', 'modifiedonbehalfby', 'importsequencenumber', 'overriddencreatedon', 'timezoneruleversionnumber', 'utcconversiontimezonecode'];

function chGetXrm() {
    try { if (typeof window !== 'undefined' && window.Xrm) return window.Xrm; } catch (e) { /* none */ }
    try { if (typeof window !== 'undefined' && window.parent && window.parent.Xrm) return window.parent.Xrm; } catch (e) { /* cross origin */ }
    return null;
}
function chClientUrl() {
    try {
        const x = chGetXrm();
        const ctx = x && x.Utility && x.Utility.getGlobalContext ? x.Utility.getGlobalContext() : null;
        if (ctx && typeof ctx.getClientUrl === 'function') return String(ctx.getClientUrl() || '').replace(/\s+/g, '').replace(/\/+$/, '');
    } catch (e) { /* no context */ }
    return '';
}
function chErrText(e) { return e && e.message ? String(e.message) : String(e || 'Unknown error'); }
function chLabel(l) { return l && l.UserLocalizedLabel && l.UserLocalizedLabel.Label ? String(l.UserLocalizedLabel.Label) : ''; }
function chEnum(v) { return String(v && typeof v === 'object' ? v.Value : (v === undefined || v === null ? '' : v)); }
function chTime(d) { return (d.getHours() < 10 ? '0' : '') + d.getHours() + ':' + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes(); }
function chNumber(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

// One GET. Resolves { status, body, message }; status 0 = no answer. Never rejects.
function chRequest(fetcher, url) {
    return new Promise(function (resolve) {
        let done = false;
        const finish = function (r) { if (done) return; done = true; clearTimeout(timer); resolve(r); };
        const timer = setTimeout(function () { finish({ status: 0, body: null, message: 'Dataverse did not answer within ' + (CH_TIMEOUT_MS / 1000) + ' seconds.' }); }, CH_TIMEOUT_MS);
        let p;
        try { p = fetcher(url, { method: 'GET', headers: CH_HEADERS, credentials: 'same-origin' }); } catch (e) { finish({ status: 0, body: null, message: chErrText(e) }); return; }
        Promise.resolve(p).then(function (res) {
            const status = res && typeof res.status === 'number' ? res.status : 0;
            const read = res && typeof res.text === 'function' ? Promise.resolve(res.text()) : Promise.resolve('');
            return read.then(function (t) {
                let body = t;
                if (typeof t === 'string' && t) { try { body = JSON.parse(t); } catch (e) { body = t; } }
                let message = 'HTTP ' + status;
                if (body && body.error && body.error.message) message = String(body.error.message).replace(/\s+/g, ' ').slice(0, 300) + ' (HTTP ' + status + ')';
                finish({ status: status, body: body, message: message });
            }, function () { finish({ status: status, body: null, message: 'HTTP ' + status }); });
        }, function (e) { finish({ status: 0, body: null, message: chErrText(e) }); });
    });
}
function chOk(r) { return !!r && r.status >= 200 && r.status < 300; }
function chDefUrl(base, logical) { return base + CH_API + "EntityDefinitions(LogicalName='" + String(logical).replace(/[^A-Za-z0-9_]/g, '') + "')"; }

const CH_TYPE_BY_NAME = {
    StringType: 'Single line of text', MemoType: 'Multiple lines of text', IntegerType: 'Whole number', BigIntType: 'Whole number',
    DecimalType: 'Decimal number', DoubleType: 'Float', MoneyType: 'Currency', BooleanType: 'Yes/No', PicklistType: 'Choice',
    MultiSelectPicklistType: 'Choices', DateTimeType: 'Date and time', LookupType: 'Lookup', CustomerType: 'Customer', OwnerType: 'Owner',
    UniqueidentifierType: 'Unique identifier', StateType: 'Status', StatusType: 'Status Reason', FileType: 'File', ImageType: 'Image', VirtualType: 'Virtual'
};
const CH_TYPE_BY_ATTR = {
    String: 'Single line of text', Memo: 'Multiple lines of text', Integer: 'Whole number', BigInt: 'Whole number', Decimal: 'Decimal number',
    Double: 'Float', Money: 'Currency', Boolean: 'Yes/No', Picklist: 'Choice', DateTime: 'Date and time', Lookup: 'Lookup', Customer: 'Customer',
    Owner: 'Owner', Uniqueidentifier: 'Unique identifier', State: 'Status', Status: 'Status Reason', Virtual: 'Virtual'
};
function chMakerType(a) {
    if (!a) return '';
    const tn = a.AttributeTypeName && typeof a.AttributeTypeName === 'object' ? a.AttributeTypeName.Value : a.AttributeTypeName;
    if (tn && CH_TYPE_BY_NAME[tn]) return CH_TYPE_BY_NAME[tn];
    if (a.AttributeType && CH_TYPE_BY_ATTR[a.AttributeType]) return CH_TYPE_BY_ATTR[a.AttributeType];
    return String(tn || a.AttributeType || '');
}
function chRequiredText(level) {
    const v = chEnum(level);
    if (v === 'ApplicationRequired') return 'Business required';
    if (v === 'SystemRequired') return 'System required';
    if (v === 'Recommended') return 'Business recommended';
    if (v === 'None') return 'Optional';
    return '';
}
// Date only and Date and time are one kind unless the DateTime details were read.
function chTypesMatch(expected, actual) {
    if (!expected || !actual || expected === actual) return true;
    const dates = ['Date and time', 'Date only'];
    return dates.indexOf(expected) > -1 && dates.indexOf(actual) > -1;
}

// Runs fn over items with at most `limit` at a time. Resolves the results in item order.
function chPool(items, limit, fn) {
    return new Promise(function (resolve) {
        const out = new Array(items.length); let next = 0, running = 0, finished = 0;
        if (!items.length) { resolve(out); return; }
        const start = function () {
            while (running < limit && next < items.length) {
                const i = next++; running++;
                Promise.resolve().then(function () { return fn(items[i], i); }).then(function (r) { out[i] = r; }, function (e) { out[i] = { error: chErrText(e) }; })
                    .then(function () { running--; finished++; if (finished === items.length) resolve(out); else start(); });
            }
        };
        start();
    });
}

// Reads one table. Resolves { state, message, meta: {...}, attrs: { logical: info }, rows: { state, count, message } }.
// state: found | missing | denied | noanswer | error.
function chCheckTable(fetcher, base, t) {
    const sel = '?$select=LogicalName,EntitySetName,PrimaryIdAttribute,PrimaryNameAttribute,DisplayName,DisplayCollectionName,OwnershipType,IsAuditEnabled';
    const exp = '&$expand=Attributes($select=LogicalName,AttributeType,AttributeTypeName,DisplayName,RequiredLevel,IsCustomAttribute,AttributeOf)';
    return chRequest(fetcher, chDefUrl(base, t.logical) + sel + exp).then(function (r) {
        if (!chOk(r)) {
            if (r.status === 404 && r.body && r.body.error) return { state: 'missing', message: 'Dataverse has no table named ' + t.logical + '.' };
            if (r.status === 401 || r.status === 403) return { state: 'denied', message: 'No permission to read the definition of ' + t.logical + ': ' + r.message };
            if (r.status === 0) return { state: 'noanswer', message: r.message };
            return { state: 'error', message: r.message };
        }
        const b = r.body || {};
        const meta = {
            label: chLabel(b.DisplayName), plural: chLabel(b.DisplayCollectionName), set: b.EntitySetName || '', idCol: b.PrimaryIdAttribute || (t.logical + 'id'),
            primary: b.PrimaryNameAttribute || '', ownership: chEnum(b.OwnershipType), audit: chEnum(b.IsAuditEnabled)
        };
        const attrs = {};
        const list = Array.isArray(b.Attributes) ? b.Attributes : null;
        (list || []).forEach(function (a) {
            if (!a || !a.LogicalName) return;
            attrs[a.LogicalName] = { logical: a.LogicalName, label: chLabel(a.DisplayName), type: chMakerType(a), required: chRequiredText(a.RequiredLevel),
                custom: a.IsCustomAttribute === true, of: a.AttributeOf || '' };
        });
        const res = { state: 'found', message: '', meta: meta, attrs: attrs, attrsRead: !!list, details: {}, rows: null };
        if (!list) return res;
        return chReadDetails(fetcher, base, t, attrs).then(function (details) {
            res.details = details;
            return chCountRows(fetcher, base, meta);
        }).then(function (rows) { res.rows = rows; return res; });
    });
}
// The casts that hold choice values, lookup targets, text lengths and the date format. Each one is optional.
function chReadDetails(fetcher, base, t, attrs) {
    const want = { choice: false, lookup: false, text: false, date: false };
    t.columns.forEach(function (c) {
        if (c.type === 'Choice' || c.type === 'Choices') want.choice = true;
        if (c.type === 'Lookup') want.lookup = true;
        if (c.maxLength) want.text = true;
        if (c.type === 'Date only' || c.type === 'Date and time') want.date = true;
    });
    const out = { options: null, targets: null, lengths: null, formats: null, failed: [] };
    const jobs = [];
    const cast = function (name, select) { return chDefUrl(base, t.logical) + '/Attributes/Microsoft.Dynamics.CRM.' + name + '?' + select; };
    const take = function (key, url, read, what) {
        jobs.push(chRequest(fetcher, url).then(function (r) {
            if (!chOk(r) || !r.body || !Array.isArray(r.body.value)) { out.failed.push(what); return; }
            const m = {};
            r.body.value.forEach(function (a) { if (a && a.LogicalName) m[a.LogicalName] = read(a); });
            out[key] = m;
        }));
    };
    const readOptions = function (a) {
        const os = a.OptionSet || {};
        return (Array.isArray(os.Options) ? os.Options : []).map(function (o) { return [chLabel(o.Label), o.Value]; });
    };
    if (want.choice) {
        take('options', cast('PicklistAttributeMetadata', '$select=LogicalName&$expand=OptionSet($select=Options)'), readOptions, 'choice values');
        jobs.push(chRequest(fetcher, cast('MultiSelectPicklistAttributeMetadata', '$select=LogicalName&$expand=OptionSet($select=Options)')).then(function (r) {
            if (!chOk(r) || !r.body || !Array.isArray(r.body.value)) return;
            out.multi = {};
            r.body.value.forEach(function (a) { if (a && a.LogicalName) out.multi[a.LogicalName] = readOptions(a); });
        }));
    }
    if (want.lookup) take('targets', cast('LookupAttributeMetadata', '$select=LogicalName,Targets'), function (a) { return Array.isArray(a.Targets) ? a.Targets : []; }, 'lookup targets');
    if (want.text) {
        take('lengths', cast('StringAttributeMetadata', '$select=LogicalName,MaxLength'), function (a) { return a.MaxLength; }, 'text lengths');
        jobs.push(chRequest(fetcher, cast('MemoAttributeMetadata', '$select=LogicalName,MaxLength')).then(function (r) {
            if (!chOk(r) || !r.body || !Array.isArray(r.body.value)) return;
            out.memoLengths = {};
            r.body.value.forEach(function (a) { if (a && a.LogicalName) out.memoLengths[a.LogicalName] = a.MaxLength; });
        }));
    }
    if (want.date) take('formats', cast('DateTimeAttributeMetadata', '$select=LogicalName,Format,DateTimeBehavior'), function (a) {
        const f = chEnum(a.Format), beh = chEnum(a.DateTimeBehavior);
        return f === 'DateOnly' || beh === 'DateOnly' ? 'Date only' : 'Date and time';
    }, 'date formats');
    return Promise.all(jobs).then(function () {
        if (out.multi && out.options) Object.keys(out.multi).forEach(function (k) { out.options[k] = out.multi[k]; });
        else if (out.multi && !out.options) out.options = out.multi;
        return out;
    });
}
// One tiny read: can rows be read, and how many are there (Dataverse counts up to 5,000).
function chCountRows(fetcher, base, meta) {
    if (!meta.set) return Promise.resolve({ state: 'unknown', count: null, message: 'No entity set name in the definition.' });
    return chRequest(fetcher, base + CH_API + meta.set + '?$select=' + meta.idCol + '&$top=1&$count=true').then(function (r) {
        if (chOk(r)) {
            const b = r.body || {};
            const n = typeof b['@odata.count'] === 'number' ? b['@odata.count'] : (Array.isArray(b.value) ? b.value.length : null);
            return { state: 'ok', count: n, capped: n === 5000 };
        }
        if (r.status === 401 || r.status === 403) return { state: 'denied', count: null, message: 'Rows cannot be read: your security role has no Read on this table. Dataverse said: ' + r.message };
        return { state: 'unknown', count: null, message: r.message };
    });
}

// Spec + answer -> what the screen shows. Column status: found | missing | type | notchecked | (table states).
function chCompare(t, res) {
    const out = { table: t, res: res || null, state: res ? res.state : 'notchecked', columns: [], extras: [], counts: { found: 0, missing: 0, type: 0, warn: 0, notchecked: 0 } };
    const attrs = res && res.state === 'found' && res.attrsRead ? res.attrs : null;
    const d = (res && res.details) || {};
    t.columns.forEach(function (c) {
        const row = { col: c, status: 'notchecked', actualType: '', actualLabel: '', dvRequired: '', notes: [] };
        if (attrs) {
            const a = attrs[c.logical];
            const pk = res.meta && res.meta.primary;
            if (!a && c.primary && pk && attrs[pk]) {
                // The table was made with a different primary name column; that column does the same job.
                row.status = 'warn'; row.actualType = attrs[pk].type; row.notes.push('Dataverse uses ' + pk + ' as the primary name column. Use that name.');
            } else if (!a) row.status = 'missing';
            else {
                let type = a.type;
                if (type === 'Date and time' && d.formats && d.formats[c.logical]) type = d.formats[c.logical];
                row.actualType = type; row.actualLabel = a.label; row.dvRequired = a.required;
                const typeOk = chTypesMatch(c.type, type);
                row.status = typeOk ? 'found' : 'type';
                // Date only versus date and time can be changed in the maker portal, so it is a Check, not a type difference.
                if (typeOk && type !== c.type && d.formats && d.formats[c.logical]) { row.status = 'warn'; row.notes.push('Stored as ' + type + ', the hub expects ' + c.type); }
                if (typeOk && c.options && d.options && d.options[c.logical]) {
                    const have = d.options[c.logical];
                    const missingOpts = c.options.filter(function (o) { return !have.some(function (h) { return h[1] === o[1]; }); });
                    const relabel = c.options.filter(function (o) { return have.some(function (h) { return h[1] === o[1] && h[0] && o[0] && h[0].toLowerCase() !== o[0].toLowerCase(); }); });
                    if (missingOpts.length) { row.status = 'warn'; row.notes.push('Choice values missing: ' + missingOpts.map(function (o) { return o[0] + ' (' + o[1] + ')'; }).join(', ')); }
                    if (relabel.length) row.notes.push('Labels differ: ' + relabel.map(function (o) { const h = have.filter(function (x) { return x[1] === o[1]; })[0]; return o[1] + ' is "' + h[0] + '", expected "' + o[0] + '"'; }).join('; '));
                }
                if (typeOk && c.target && d.targets && d.targets[c.logical] && d.targets[c.logical].indexOf(c.target) < 0) {
                    row.status = 'warn'; row.notes.push('Points at ' + (d.targets[c.logical].join(', ') || 'nothing') + ', expected ' + c.target);
                }
                const len = (d.lengths && d.lengths[c.logical]) || (d.memoLengths && d.memoLengths[c.logical]);
                if (typeOk && c.maxLength && typeof len === 'number' && len < c.maxLength) { row.status = 'warn'; row.notes.push('Holds ' + chNumber(len) + ' characters, ' + chNumber(c.maxLength) + ' wanted'); }
            }
        }
        out.counts[row.status === 'warn' ? 'warn' : row.status]++;
        out.columns.push(row);
    });
    if (attrs) {
        const listed = {};
        t.columns.forEach(function (c) { listed[c.logical] = true; });
        const idCol = (res.meta && res.meta.idCol) || '';
        Object.keys(attrs).sort().forEach(function (k) {
            const a = attrs[k];
            if (listed[k] || k === idCol || k === (res.meta && res.meta.primary) || CH_SYSTEM_COLUMNS.indexOf(k) > -1 || a.of || !a.custom) return;
            out.extras.push(a);
        });
    }
    return out;
}
function chTableNeedsWork(v) {
    if (v.state === 'missing' || v.state === 'denied' || v.state === 'error' || v.state === 'noanswer') return true;
    if (v.res && v.res.rows && v.res.rows.state === 'denied') return true;
    return v.counts.missing + v.counts.type + v.counts.warn > 0;
}

// The build list for the maker portal: what is missing, as plain ASCII text.
function chBuildText(views, everything) {
    const lines = ['Chemical hub - Dataverse build list (' + (everything ? 'all tables' : 'only what is missing or different') + ')', ''];
    views.forEach(function (v) {
        const t = v.table;
        if (t.group === 'read' && !everything) return;
        const cols = v.columns.filter(function (r) { return everything || r.status === 'missing' || r.status === 'type' || r.status === 'warn' || v.state === 'missing'; });
        if (!everything && v.state !== 'missing' && !cols.length) return;
        lines.push((v.state === 'missing' ? 'CREATE TABLE: ' : 'TABLE: ') + t.label + ' (' + t.logical + '), plural "' + t.plural + '", ownership ' + t.ownership);
        cols.forEach(function (r) {
            const c = r.col;
            let s = '  - ' + c.label + ' (' + c.logical + '): ' + c.type + (c.required ? ', needed' : ', optional');
            if (c.primary) s += ', primary name column';
            if (c.key) s += ', alternate key';
            if (c.target) s += ', lookup to ' + c.target;
            if (c.maxLength) s += ', max length ' + c.maxLength;
            if (c.options) s += ', values: ' + c.options.map(function (o) { return o[0] + ' = ' + o[1]; }).join('; ');
            if (r.status === 'type') s += '  << now ' + r.actualType + ', change or recreate';
            if (r.notes.length) s += '  << ' + r.notes.join('; ');
            lines.push(s);
        });
        lines.push('');
    });
    return lines.join('\n').replace(/[^\x00-\x7F]/g, '');
}

