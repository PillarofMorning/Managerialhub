        return <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-lst-nocols={list}>{T[list].label + ' has no ' + (cols.length === 1 ? 'column ' : 'columns ') + cols.join(', ') + ' yet, so ' + (cols.length === 1 ? 'that box is' : 'those boxes are') + ' off. Add ' + (cols.length === 1 ? 'it' : 'them') + ' to the table (the prompts file in the chemical-ordering folder has each one), then press Refresh.'}</p>;
    };

    const aliasRow = function (f, id, isNew, set, saved) {
        const ps = isNew || edits[id] ? problemsOf('alias', f, id) : [];
        const area = impClean(f.craa5_area);
        return <LstAliasRow key={id} f={f} id={id} isNew={isNew} name={isNew ? '' : impClean(saved.craa5__c_areaaliasname)} etag={isNew ? '' : saved._etag} edited={!!edits[id]}
            flag={flags[id] || ''} notmss={mssAreas && area && !mssAreas.m[ordKey(area)] ? area : ''} problems={ps.join(' ')} off={aliasOff} entryLabels={entryLabels}
