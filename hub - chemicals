function ordAlerts(ix) {
    const out = [];
    const today = ix.today;
    const stocked = function (k) { return !!ix.stock[k]; };
    ix.itemList.forEach(function (it) {
        if (it.craa5_active === false) return;
        const k = ordKey(it.craa5_itemnumber), name = it.craa5_commonname || it.craa5__c_chemicalname || it.craa5_itemnumber;
        const q = ordDate(it.craa5_quoteexpires);
        if (q) {
            const days = ordDaysBetween(today, q);
            if (days < 0) out.push({ kind: 'quote', level: 'red', text: name + ': quote ' + (it.craa5_quotenumber ? it.craa5_quotenumber + ' ' : '') + 'expired ' + ordDay(q) + '.' });
            else if (days <= ORD_QUOTE_WARN_DAYS) out.push({ kind: 'quote', level: 'amber', text: name + ': quote expires ' + ordDay(q) + ' (in ' + days + ' days).' });
        }
        if (stocked(k) && !(ordNum(it.craa5_priceperunit) > 0)) out.push({ kind: 'price', level: 'amber', text: name + ' (' + it.craa5_itemnumber + ') has no price, so its cart total is short.' });
        if (stocked(k) && !ordKey(it.craa5_vendornumber)) out.push({ kind: 'vendor', level: 'amber', text: name + ' (' + it.craa5_itemnumber + ') has no vendor number, so it cannot go on a cart.' });
        else if (ordKey(it.craa5_vendornumber) && !ix.vendors[ordKey(it.craa5_vendornumber)]) out.push({ kind: 'vendor', level: 'amber', text: name + ': vendor ' + it.craa5_vendornumber + ' is not in Distributors (cart limit and lead time fall back to $25,000 and 9 days).' });
    });
    // last price paid per item, from the newest cart that has it
    const last = {};
    ix.cartList.slice().sort(function (a, b) { return (ordDate(b.craa5_submittedon) || ordDate(b.craa5_draftedon) || 0) - (ordDate(a.craa5_submittedon) || ordDate(a.craa5_draftedon) || 0); }).forEach(function (c) {
        (ix.linesByCart[ordKey(c.craa5__c_cartname)] || []).forEach(function (l) { const k = ordKey(l.craa5_itemnumber); if (!(k in last) && ordNum(l.craa5_unitprice) > 0) last[k] = { price: ordNum(l.craa5_unitprice), cart: c.craa5__c_cartname }; });
    });
    Object.keys(last).forEach(function (k) {
        const it = ix.items[k]; if (!it) return;
        const now = ordNum(it.craa5_priceperunit);
        if (now > 0 && Math.abs(now - last[k].price) >= 0.01) {
            const pct = (now - last[k].price) / last[k].price * 100;
            out.push({ kind: 'change', level: pct > 0 ? 'amber' : 'blue', text: (it.craa5_commonname || it.craa5__c_chemicalname) + ': price is ' + ordMoney(now) + ', ' + (pct > 0 ? 'up ' : 'down ') + Math.abs(pct).toFixed(1) + '% from ' + ordMoney(last[k].price) + ' on ' + last[k].cart + '.' });
        }
    });
    Object.keys(ix.stock).forEach(function (k) { if (!ix.items[k]) out.push({ kind: 'item', level: 'amber', text: 'Stock row ' + (ix.stock[k].rows[0].craa5__c_chemicalinventoryname || k) + ' points at item ' + k + ', which is not in Chemicals.' }); });
    // a cart still open well past its lead time keeps its lines "on order" and holds back new suggestions
    ix.cartList.forEach(function (c) {
        if (ORD_OPEN.indexOf(c.craa5_cartstatus) < 0 || c.craa5_cartstatus === 'Draft (not in SAP yet)') return;
        const sub = ordDate(c.craa5_submittedon); if (!sub) return;
        const days = ordDaysBetween(new Date(sub.getFullYear(), sub.getMonth(), sub.getDate()), today);
        if (days > ordLead(ix, c.craa5_vendornumber) + ORD_STALE_DAYS) out.push({ kind: 'stale', level: 'amber', text: c.craa5__c_cartname + ' has been ' + c.craa5_cartstatus.toLowerCase() + ' for ' + days + ' days, so its lines still count as on order. Under Open carts: Receive if it just arrived, Close as received if it came before the last count, or Cancel cart if it is not coming.' });
    });
    const rank = { red: 0, amber: 1, blue: 2 };
    return out.map(function (a, i) { return { a: a, i: i }; }).sort(function (x, y) { return rank[x.a.level] - rank[y.a.level] || x.i - y.i; }).map(function (x) { return x.a; });
}

