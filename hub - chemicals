                                <span className="text-xs text-slate-500">{[r.area, r.shift ? r.shift + ' shift' : ''].filter(function (x) { return x; }).join(', ')}</span>
                            </li>;
                        })}</ul> : <p className="text-sm text-slate-600">{t.n && !(t.inr + t.out) ? 'No reading in these dates has a target, so none can be out of range.' : 'No readings out of range in these dates.'}</p>}
