        if (mp.blank || mp.bad) { setAddMsg(mp.bad || 'Type its minimum at this place (0 if it has none).'); return; }
        const k = ordKey(it.craa5_itemnumber);
        if (L.lines.some(function (l) { return l.key === k && ordKey(l.loc) === ordKey(loc); })) { setAddMsg(cntName(it, null, it.craa5_itemnumber) + ' is already on the list at ' + loc + '.'); return; }
        setAdds(function (a) { return a.concat([{ itemNo: String(it.craa5_itemnumber), loc: loc, min: mp.n }]); }); touch();
        setAdd({ loc: loc, item: '', min: '' });
        say(cntName(it, null, it.craa5_itemnumber) + ' added at the end of ' + loc + '. Type its count, then Save (Save creates its stock row).');
    };
    const removeAdd = function (l) {
        setAdds(function (a) { return a.filter(function (x) { return !(ordKey(x.itemNo) === l.key && x.loc === l.loc); }); });
        setTyped(function (p) { const n = Object.assign({}, p); delete n[l.id]; return n; }); touch();
    };
    const copySheet = function () {
        const text = cntSheetText(L.groups, day);
        const done = function () { setCopied(true); setTimeout(function () { setCopied(false); }, 2500); };
        chCopy(text, done);
    };
    const printSheet = function () {
        setPrintNote(cntPrint(printRef.current) ? 'If no print window opened, this app blocks printing here: use Copy for Excel and print from Excel.' : 'Printing is not available here. Use Copy for Excel and print from Excel.');
    };
    const clearTyped = function () { setTyped({}); setAdds([]); setKept(''); setClearAsk(false); setOrphAsk(false); setMsg(''); };

    const field = 'min-h-[44px] rounded-lg border border-slate-300 bg-white px-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40';
    const itemChoices = ix ? ix.itemList.filter(function (it) { return it.craa5_active !== false && it.craa5_itemnumber; }).map(function (it) { return { key: String(it.craa5_itemnumber), label: cntName(it, null, it.craa5_itemnumber) + ' (' + impClean(it.craa5_itemnumber) + ')' }; })
        .sort(function (a, b) { return a.label.localeCompare(b.label); }) : [];
    const nTyped = plan ? plan.filled : 0, nLines = L ? L.lines.length : 0;
    const countOnlyLocs = L ? Object.keys(L.countOnly) : [];
    const focusNext = function (e, id) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const all = document.querySelectorAll('[data-cnt-q]');
        for (let i = 0; i < all.length; i++) { if (all[i].getAttribute('data-cnt-q') === id && all[i + 1]) { all[i + 1].focus(); return; } }
    };
    const nSaved = L && cntIsDay(day) ? L.lines.filter(function (l) { return (l.saved[day] || []).length > 0; }).length : 0;
    const lastText = function (l) {
        if (!l.last) return 'not counted yet';
        const sv = cntIsDay(day) ? (l.saved[day] || []) : [];
        const svText = sv.length && l.last.day !== day ? 'saved for this date: ' + ordQty(ordRound(sv.reduce(function (t, r) { return t + ordNum(r.craa5_quantity); }, 0), 4)) + (sv.length > 1 ? ' (' + sv.length + ' counts)' : '') + ', ' : '';
        return svText + (l.last.day === day ? 'saved for this date: ' : 'last ') + ordQty(l.last.qty) + (l.last.day === day ? '' : ' on ' + ordDay(ordDate(l.last.day))) + (l.last.n > 1 ? ' (' + l.last.n + ' counts that day)' : '');
    };
    return (
        <div>
            <style>{CNT_PRINT_CSS}</style>
            <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-center gap-2 rounded-t-xl">
                    <h1 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Count</h1>
                    <span className="ml-auto text-xs text-slate-600" data-cnt-read>{loading ? 'Reading the stock and counts...' : data ? 'Read at ' + chTime(data.loadedAt) : 'Not read yet'}</span>
                </div>
                <div className="px-5 py-4">
                    <p className="text-sm text-slate-700">Every stock row in walk order, with an empty box. Type what you find (0 when there is none); a line left blank is not counted and its stock stays as it is. Count every place of an item on the same date: the Ordering tab adds them up. Save writes the counts and sets stock on hand to them.</p>
                    <div className="mt-3 flex flex-wrap items-end gap-2">
                        <label className="text-xs font-bold text-slate-600">Count date<input type="date" data-cnt-day value={day} max={ordIsoDay(today)} onChange={function (e) { setDay(e.target.value); setDayPicked(true); setMsg(''); }} className={field + ' block mt-1'} /></label>
                        <label className="text-xs font-bold text-slate-600">Counted by<input type="text" data-cnt-by value={by} maxLength={100} onChange={function (e) { setBy(e.target.value); }} className={field + ' block mt-1 w-48'} /></label>
                        <div className="ml-auto flex flex-wrap gap-2">
                            <button type="button" data-cnt-print-btn onClick={printSheet} disabled={!L || !nLines} className={btnWhite + (!L || !nLines ? ' opacity-50 cursor-not-allowed' : '')}><PrintIcon className="w-4 h-4" />Print blank sheet</button>
                            <button type="button" data-cnt-copy onClick={copySheet} disabled={!L || !nLines} className={btnWhite + (!L || !nLines ? ' opacity-50 cursor-not-allowed' : '')}><CopyIcon className="w-4 h-4" />{copied ? 'Copied' : 'Copy for Excel'}</button>
                            <button type="button" data-cnt-refresh onClick={function () { if (!loading && !busy) load(); }} aria-disabled={loading || busy} className={btnWhite + (loading || busy ? ' opacity-50 cursor-not-allowed' : '')}><RefreshIcon className="w-4 h-4" />Refresh</button>
                        </div>
                    </div>
                    {printNote && <p className="mt-2 text-xs text-slate-600" data-cnt-print-note>{printNote}</p>}
                    {readProblem && <p role="alert" className="mt-3 flex items-start gap-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]"><WarnIcon className="w-4 h-4 mt-0.5 flex-shrink-0" />{readProblem}</p>}
                    {kept && <div className="mt-3 rounded-lg border border-[#B3D4F2] bg-[#E6F1FB] px-3 py-2 text-sm text-[#00468B]" data-cnt-kept>
                        {'Counts typed for ' + (d0 && cntIsDay(d0.day) ? cntDayText(d0.day) : 'a count') + (ordDate(kept) ? ' (on ' + ordDay(ordDate(kept)) + ' at ' + chTime(ordDate(kept)) + ')' : '') + ' were kept on this device and are not saved yet.'}
                        {!clearAsk ? <button type="button" data-cnt-clear onClick={function () { setClearAsk(true); }} className="ml-2 underline font-bold">Clear them</button>
                            : <span className="ml-2">Clear every typed count? <button type="button" data-cnt-clear-yes onClick={clearTyped} className="underline font-bold">Yes, clear</button> <button type="button" onClick={function () { setClearAsk(false); }} className="ml-2 underline">Keep them</button></span>}
                    </div>}
                    {dateAsk && <div className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-cnt-date-ask>
                        {'The count date is ' + cntDayText(day) + ', not this Sunday (' + cntDayText(thisSun) + '). Which date are these counts for?'}
                        <span className="ml-2 inline-flex flex-wrap gap-3"><button type="button" data-cnt-use-sunday onClick={function () { setDay(thisSun); setDayPicked(true); setMsg(''); }} className="underline font-bold">Use this Sunday</button>
                            <button type="button" data-cnt-keep-day onClick={function () { setDayPicked(true); }} className="underline font-bold">{'Keep ' + cntDayText(day)}</button></span>
                    </div>}
                    {orphans.length > 0 && <div className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-cnt-orphans>
                        {(orphans.length === 1 ? 'A typed count is' : orphans.length + ' typed counts are') + ' not on the list, so ' + (orphans.length === 1 ? 'it is' : 'they are') + ' not shown or saved: ' + orphans.map(orphText).join('; ') + '. Type ' + (orphans.length === 1 ? 'it' : 'them') + ' on the right line if needed.'}
                        {!orphAsk ? <button type="button" data-cnt-orph-clear onClick={function () { setOrphAsk(true); }} className="ml-2 underline font-bold">Clear {orphans.length === 1 ? 'it' : 'them'}</button>
                            : <span className="ml-2">{'Clear ' + (orphans.length === 1 ? 'it' : 'them') + '? '}<button type="button" data-cnt-orph-yes onClick={function () { setTyped(function (p) { const n = Object.assign({}, p); orphans.forEach(function (k) { delete n[k]; }); return n; }); setOrphAsk(false); }} className="underline font-bold">Yes, clear</button> <button type="button" onClick={function () { setOrphAsk(false); }} className="ml-2 underline">Keep</button></span>}
                    </div>}
                    {L && !nLines && !loading && !unread.length && <p className="mt-3 rounded-lg border border-[#B3D4F2] bg-[#E6F1FB] px-3 py-2 text-sm text-[#00468B]" data-cnt-empty>No stock rows yet, so there is nothing to count. Paste your latest Week sheet on the Import tab with Also set stock on hand ticked (that adds a stock row per item, in the sheet's order), or add items below.</p>}
                    {L && (L.left.inactive.length > 0 || L.left.noItem > 0 || countOnlyLocs.length > 0) && <ul className="mt-3 list-disc pl-5 text-sm text-slate-600 space-y-1" data-cnt-left>
                        {L.left.inactive.length > 0 && <li>{'Not on the list because the item is not active in Chemicals: ' + L.left.inactive.join(', ') + '.'}</li>}
                        {L.left.noItem > 0 && <li>{L.left.noItem + ' stock row' + (L.left.noItem === 1 ? ' has' : 's have') + ' no item number, so ' + (L.left.noItem === 1 ? 'it is' : 'they are') + ' not on the list. Fix ' + (L.left.noItem === 1 ? 'it' : 'them') + ' in the Chemical inventory table in Power Apps.'}</li>}
                        {countOnlyLocs.map(function (loc) { return <li key={loc}>{'Counted before at ' + loc + ' but with no stock row there, so not on the list: ' + L.countOnly[loc].join(', ') + '. Add them with Add an item to count them here.'}</li>; })}
                    </ul>}
                </div>
            </div>
            {L && L.groups.map(function (g) {
                const wl = walk ? (walk[g.loc] || []) : null;
                const shown = wl ? wl.map(function (id) { return g.lines.filter(function (l) { return l.id === id; })[0]; }).filter(Boolean).concat(g.lines.filter(function (l) { return !l.row; })) : g.lines;
                const nIn = g.lines.filter(function (l) { const t = typed[l.id]; return t && !cntParse(t.q).blank; }).length;
                const nSv = cntIsDay(day) ? g.lines.filter(function (l) { return (l.saved[day] || []).length > 0; }).length : 0;
                return (
                    <section key={g.loc} className="mt-4 rounded-xl border border-slate-200 bg-white shadow-sm" data-cnt-group={g.loc}>
                        <h2 className="px-5 py-3 border-b border-slate-200 flex flex-wrap items-baseline gap-2"><span className="text-base font-black text-[#00468B]">{g.loc || 'No location'}</span><span className="text-xs text-slate-600" data-cnt-group-count>{g.lines.length + ' line' + (g.lines.length === 1 ? '' : 's') + ': ' + nSv + ' saved for this date, ' + nIn + ' typed'}</span></h2>
                        <ol className="divide-y divide-slate-100">
                            {shown.map(function (l, i) {
                                const t = typed[l.id] || {}, prob = plan ? plan.problems[l.id] : '', note = plan ? plan.notes[l.id] || plan.warns[l.id] || '' : '', warn = !!(plan && !plan.notes[l.id] && plan.warns[l.id]);
                                const pid = 'cnt-p-' + L.lines.indexOf(l);
