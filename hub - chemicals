// ============================================================================
// COUNT TAB: the Sunday count, on screen and on paper (a blank count: every stock row in walk order with an empty box)
// ============================================================================
// Nothing is written until Save. Save writes one count per line with a number typed (item, location and count date) and sets
// that stock row's on hand to the count, as one change set: Dataverse saves all of it or none. A count saved again for the same
// item, place and day updates that count, so saving twice never adds a second one. A line left blank is not counted, and its
// stock stays as it is; an item counted at one place and left blank at another is pointed out first, because the Ordering tab
// adds every place's count for a day. Typed counts are kept on this device until they are saved, so a reload does not lose them.
const CNT_DRAFT = 'hubChemicals.countDraft.1';
// Dataverse takes up to 1,000 writes in one change set
const CNT_MAX_WRITES = 1000;
const CNT_LAST = 1e9;
// the printed sheet's columns and their widths (the same in every location, so the sheet lines up)
const CNT_COLS = [['Chemical', '38%'], ['Item', '14%'], ['Min', '8%'], ['Last count', '15%'], ['Count', '12%'], ['Expiry', '13%']];
// The printed sheet shows only while this page prints it: every other part of the page is hidden for the print, and the
// boxes that scroll the page on screen grow to their full height so every location prints.
const CNT_PRINT_CSS = '.ch-print-sheet{display:none}@media print{.ch-print-hide{display:none !important}.ch-print-path{height:auto !important;min-height:0 !important;max-height:none !important;overflow:visible !important;padding:0 !important;margin:0 !important;max-width:none !important;box-shadow:none !important;border:0 !important;background:#fff !important}.ch-print-sheet.ch-printing{display:block !important}@page{margin:12mm}}';

function cntLocRank(label) { for (let i = 0; i < CH_OPT_LOCATION.length; i++) { if (CH_OPT_LOCATION[i][0] === label) return i; } return CH_OPT_LOCATION.length; }
// the name on the count: Common name, else the SAP name, else the stock row's own name without its " - place" ending
function cntName(item, row, itemNo) {
    if (item && (item.craa5_commonname || item.craa5__c_chemicalname)) return impClean(item.craa5_commonname || item.craa5__c_chemicalname);
    const n = row ? impClean(row.craa5__c_chemicalinventoryname).replace(/ - [^-]*$/, '') : '';
    return n || impClean(itemNo);
}
// A typed count: blank (not counted), a number of containers (up to 2 decimal places), or a problem to show.
function cntParse(s) {
    const t = String(s === null || s === undefined ? '' : s).trim();
    if (!t) return { blank: true };
    if (/^(\d+(\.\d{0,2})?|\.\d{1,2})$/.test(t)) return { n: parseFloat(t) };
    if (/^\d*\.\d{3,}$/.test(t)) return { bad: 'Up to 2 decimal places, for example 2.25.' };
    return { bad: '"' + t.slice(0, 20) + '" is not a number. Type just the number of containers, for example 4, or 2.5 for two and a half.' };
}
function cntIsDay(s) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s || ''));
    if (!m) return false;
    const d = new Date(+m[1], +m[2] - 1, +m[3]);
    return d.getFullYear() === +m[1] && d.getMonth() === +m[2] - 1 && d.getDate() === +m[3];
}
const CNT_WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
function cntDayText(s) { return cntIsDay(s) ? CNT_WD[ordDate(s).getDay()] + ' ' + ordDay(ordDate(s)) : String(s || ''); }

// The count list. One line per stock row of an active item, and one per item added on this page and not saved yet (adds:
// [{ itemNo, loc, min }]), grouped by location (in the order of the Location choices; a place not among them goes last) and
// in walk order (Display order) inside each. Each line has the counts saved for its item and place by day, and the latest.
// Rows left off (an inactive item, no item number) and items counted at a place with no stock row there are listed in notes.
// An added line whose item and place have a stock row now (saved since, here or on another device) is not listed again: it is
// returned in merged, so the page can move its typed count to that row.
function cntLines(d, ix, adds) {
    const T = d.tables, byKey = {}, lines = [], seen = {}, expItem = {}, merged = [];
    const left = { inactive: [], noItem: 0 };
    (T.count.rows || []).forEach(function (r) {
        const dd = ordDate(r.craa5_countdate), k = ordKey(r.craa5_itemnumber);
        if (!dd || !k) return;
        if (r.craa5_expirydate) expItem[k] = true;
