        if (d.beh === 'UserLocal') return new Date(t.getFullYear(), t.getMonth(), t.getDate()).toISOString();
        return ordIsoDay(t) + (d.beh === 'TimeZoneIndependent' ? 'T00:00:00Z' : '');
    }
    if (d.beh === 'TimeZoneIndependent') return ordIsoDay(t) + 'T' + p2(t.getHours()) + ':' + p2(t.getMinutes()) + ':' + p2(t.getSeconds()) + 'Z';
