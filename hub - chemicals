    };
    // saved: the row as read (null for a new row), for the hook tests find it by
    const targetLine = function (f, id, isNew, set, saved) {
        const it = items.m[ordKey(f.craa5_itemnumber)];
        const ps = isNew || edits[id] ? problemsOf('target', f, id).join(' ') : '', fl = flags[id] || '';
        const of = isNew ? ' of the new target' : ' of ' + lstRowName('target', saved), by = lstDescribed(id, fl, ps), off = targetOff;
        const num = function (k, label) {
            return <td className={LST_CELL}><input value={f[k]} inputMode="decimal" aria-label={label + of} aria-describedby={by} disabled={!!off[k]} onChange={function (e) { set(k, e.target.value); }} className={inputCls + ' w-24 text-right' + LST_MT + (off[k] ? ' bg-slate-100' : '')} data-lst-field={k} /></td>;
        };
        return <tr key={id} className={'border-t border-slate-100 ' + (isNew ? 'bg-[#E6F1FB]/40' : edits[id] ? 'bg-[#FFF6E0]/50' : '')} data-lst-target={isNew ? 'new' : lstKey('target', saved)}>
            <td className={LST_CELL}><select value={it ? it.craa5_itemnumber : f.craa5_itemnumber} aria-label={'Chemical' + of} aria-describedby={by} disabled={!!off.craa5_itemnumber} onChange={function (e) { set('craa5_itemnumber', e.target.value); }} className={LST_BOX + ' min-w-[200px]'} data-lst-field="craa5_itemnumber">
                <option value="">Pick a chemical</option>
                {!it && impClean(f.craa5_itemnumber) ? <option value={f.craa5_itemnumber}>{f.craa5_itemnumber + (T.item.error ? '' : ' (not in the Chemical list)')}</option> : null}
                {items.list.map(function (r) { return <option key={r._id} value={r.craa5_itemnumber}>{itemLabel(r)}</option>; })}</select>
                {lstNotes(id, fl, '', ps)}
                {isNew && <button type="button" className="text-sm font-bold text-[#00468B] underline min-h-[44px]" onClick={function () { dropAdd(id); }} data-lst-remove>Remove this new row</button>}</td>
            <td className={LST_CELL}><select value={f.craa5_application} aria-label={'Application' + of} aria-describedby={by} disabled={!!off.craa5_application} onChange={function (e) { set('craa5_application', e.target.value); }} className={LST_BOX + ' min-w-[200px]'} data-lst-field="craa5_application">
                <option value="">Pick one</option>
                {f.craa5_application && appLabels.indexOf(f.craa5_application) < 0 ? <option value={f.craa5_application}>{f.craa5_application}</option> : null}
                {appLabels.map(function (l) { return <option key={l} value={l}>{l}</option>; })}</select></td>
            {num('craa5_minppm', 'Min PPM')}{num('craa5_maxppm', 'Max PPM')}{num('craa5_ppmperdrop', 'PPM per drop')}
            <td className={LST_CELL}><input value={f.craa5_testmethod} maxLength={200} aria-label={'Test method' + of} aria-describedby={by} disabled={!!off.craa5_testmethod} onChange={function (e) { set('craa5_testmethod', e.target.value); }} className={LST_BOX + (off.craa5_testmethod ? ' bg-slate-100' : '')} data-lst-field="craa5_testmethod" /></td>
            <td className={LST_CELL + ' text-center'}><input type="checkbox" checked={f.craa5_active !== false} aria-label={'Active' + of} aria-describedby={by} disabled={!!off.craa5_active} onChange={function (e) { set('craa5_active', e.target.checked); }} className={'w-5 h-5 mt-3' + LST_MT} data-lst-field="craa5_active" /></td>
            <td className={LST_CELL}><textarea value={f.craa5_notes} rows={2} maxLength={4000} aria-label={'Notes' + of} aria-describedby={by} disabled={!!off.craa5_notes} onChange={function (e) { set('craa5_notes', e.target.value); }} className={LST_BOX + ' min-w-[160px] py-2 block' + (off.craa5_notes ? ' bg-slate-100' : '')} data-lst-field="craa5_notes" /></td>
            <td className={LST_CELL + ' whitespace-nowrap'}>{isNew ? <span className="text-xs font-bold text-[#00468B]">New</span> : edits[id] ? <span className="text-xs font-bold text-[#7A4B00]">Changed</span> : null}</td>
        </tr>;
    };
    const filterBtn = function (key, label, n) {
        const on = only === key;
        return <button type="button" key={key} aria-pressed={on} data-lst-only={key} onClick={function () { setOnly(key); }}
            className={'min-h-[36px] px-3 rounded-full text-xs font-bold border ' + (on ? 'bg-[#00468B] text-white border-[#00468B]' : 'bg-white text-[#00468B] border-slate-300')}>{label + ' (' + n + ')'}</button>;
    };
    const noRoom = !!aliasOff.craa5_room;

    return (
        <div ref={wrapRef}>
            <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-center gap-2 rounded-t-xl">
                    <h1 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Lists</h1>
                    <span className="ml-auto text-xs text-slate-600" data-lst-live>{loading ? 'Reading the lists...' : data ? 'Read at ' + chTime(data.loadedAt) : 'Not read yet'}</span>
                </div>
                <div className="px-5 py-4">
                    <p className="text-sm text-slate-600">Lists the hub works from, kept in Dataverse so they can be changed here at any time. Changes are saved only when you press Save.</p>
                    {problem && <p ref={alertRef} tabIndex={-1} data-lst-alert className="mt-3 flex items-start gap-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00] focus:outline-none focus:ring-2 focus:ring-[#FFB81C]"><WarnIcon className="w-4 h-4 mt-0.5 flex-shrink-0" />{problem}</p>}
                    <div className="mt-4 flex flex-wrap items-center gap-2">
                        <button type="button" data-lst-refresh onClick={function () { if (!loading && !busy) load(failNote()); }} aria-disabled={loading || busy} className={btnBlue + (loading || busy ? ' opacity-50 cursor-not-allowed' : '')}><RefreshIcon className="w-4 h-4" />{loading ? 'Reading...' : 'Refresh'}</button>
                        <span className="ml-auto flex flex-wrap gap-2" role="group" aria-label="Show">
                            {viewBtn('areas', 'Area names', A && !A.error ? aliasRows.length : undefined)}{viewBtn('targets', 'Titration targets', G && !G.error ? targetRows.length : undefined)}
                        </span>
                    </div>
                </div>
            </div>
            {ready && view === 'areas' && <div className="mt-6">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Area names</h2>
                <p className="mt-1 text-sm text-slate-600">Each spelling of an area in the old chemical log, with the MSS area it means, the spot and the room. Leave the area blank when the log does not say which one (Creme Side: which line?); the room is enough to report it by room. Spellings that differ only in capitals or spaces count as one. A spelling can be corrected here too, but it has to match the old log for its rows to be matched.</p>
                {A.missing ? <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-lst-missing="alias">Dataverse has no _c_ Area alias table yet. Create it from the prompts file in the chemical-ordering folder, then press Refresh.</p> : <div>
                    {noRoom && <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-lst-noroom>_c_ Area alias has no Room column yet, so rooms cannot be saved. Add a column named Room (Single line of text, 50 characters) to the table, then press Refresh.</p>}
                    {missingNote('alias', aliasOff)}
                    {!mssAreas && <p className="mt-3 text-xs text-slate-600" data-lst-nomss>The MSS area list could not be read, so areas are not checked against it. Press Refresh to read it again.</p>}
                    <div className="mt-3 flex flex-wrap items-center gap-2">
                        {filterBtn('all', 'All', aliasCounts.all)}{filterBtn('noarea', 'No area yet', aliasCounts.noarea)}{filterBtn('noroom', 'No room yet', aliasCounts.noroom)}{mssAreas ? filterBtn('notmss', 'Not in MSS list', aliasCounts.notmss) : null}{filterBtn('changed', 'Changed', aliasCounts.changed)}
                        <input value={find} onChange={function (e) { setFind(e.target.value); }} placeholder="Find a spelling, area or spot" aria-label="Find" className={inputCls + ' grow min-w-[180px]'} data-lst-find />
                    </div>
                    {toolbar('alias')}
                    <datalist id="lst-areas">{(mssAreas ? mssAreas.list : []).map(function (n) { return <option key={n} value={n} />; })}</datalist>
                    <datalist id="lst-spots">{spots.map(function (n) { return <option key={n} value={n} />; })}</datalist>
                    <datalist id="lst-rooms">{rooms.map(function (n) { return <option key={n} value={n} />; })}</datalist>
                    <div className="relative mt-2 overflow-x-auto rounded-xl border border-slate-200 bg-white">
                        <table className="w-full text-sm">
                            <thead><tr><th className={th}>Spelling</th><th className={th}>Area</th><th className={th}>Spot</th><th className={th}>Room</th><th className={th}>Entry type</th><th className={th}><span className="sr-only">Status</span></th></tr></thead>
                            <tbody>
                                {adds.filter(function (a) { return a.list === 'alias'; }).map(function (a) { return aliasRow(a.f, a.nid, true, function (k, v) { setAddField(a.nid, k, v); }); })}
                                {shownAlias.map(function (r) { return aliasRow(fieldsOf('alias', r), r._id, false, function (k, v) { setField('alias', r, k, v); }, r); })}
                            </tbody>
                        </table>
                        {!shownAlias.length && <p className="px-4 py-3 text-sm text-slate-600" data-lst-empty="alias">{A.error && !aliasRows.length ? 'The spellings could not be read, so none are shown. Press Refresh to read them again.' : aliasRows.length ? 'No spellings match.' : 'No spellings yet. Paste the area mapping (7-area-alias in the import folder) on the Import tab, or add them here.'}</p>}
                    </div>
                </div>}
            </div>}
            {ready && view === 'targets' && <div className="mt-6">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Titration targets</h2>
                <p className="mt-1 text-sm text-slate-600">The PPM range each chemical should test at, per application: one target per chemical and application. The chemical log will show the range and mark each reading in or out of it. When the range changes, type the new numbers over the old ones; untick Active when a chemical is no longer tested for that application. With PPM per drop set, the clerk can type the drops counted instead of the PPM.</p>
                {G.missing ? <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-lst-missing="target">Dataverse has no _c_ Titration target table yet. Create it from the prompts file in the chemical-ordering folder, then press Refresh.</p> : <div>
                    {T.item.error && <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]" data-lst-noitems>The Chemical list could not be read, so chemicals cannot be picked and targets cannot be saved. Press Refresh to read it again.</p>}
                    {missingNote('target', targetOff)}
                    {toolbar('target')}
                    <div className="relative mt-2 overflow-x-auto rounded-xl border border-slate-200 bg-white">
                        <table className="w-full text-sm">
                            <thead><tr><th className={th}>Chemical</th><th className={th}>Application</th><th className={th + ' text-right'}>Min PPM</th><th className={th + ' text-right'}>Max PPM</th><th className={th + ' text-right'}>PPM per drop</th><th className={th}>Test method</th><th className={th}>Active</th><th className={th}>Notes</th><th className={th}><span className="sr-only">Status</span></th></tr></thead>
                            <tbody>
                                {adds.filter(function (a) { return a.list === 'target'; }).map(function (a) { return targetLine(a.f, a.nid, true, function (k, v) { setAddField(a.nid, k, v); }); })}
                                {targetRows.map(function (r) { return targetLine(fieldsOf('target', r), r._id, false, function (k, v) { setField('target', r, k, v); }, r); })}
                            </tbody>
                        </table>
                        {!targetRows.length && !adds.some(function (a) { return a.list === 'target'; }) && <p className="px-4 py-3 text-sm text-slate-600" data-lst-empty="target">{G.error ? 'The titration targets could not be read, so none are shown. Press Refresh to read them again.' : 'No titration targets yet. Press Add target for each chemical and application on your target list.'}</p>}
                    </div>
                </div>}
            </div>}
        </div>
    );
}

