    );
}

// ============================================================================
// LOG TAB: the chemical clerk's quick log, which replaces the paper day sheets
// ============================================================================
// One button, one change set, sent at once. An entry is frozen when its button is pressed (its nonce, row id, moment and
// name), kept on this device until a read finds its id, and sent again only under the same id, so a lost answer can never
// add a row twice. Everything offered comes from Dataverse at run time: choice labels and values from the usage log's own
// option sets (never the hub's CH_SPEC lists), chips from the user's own rows. The helpers below are top-level so the unit
// checks can load them; the tab's screen is LogTab.
const LOG_DRAFT = 'hubChemicals.logDraft.1';
// the history read for ranking chips (about 1,100 rows at 38 a day): a choice, not taken from the data
const LOG_HISTORY_DAYS = 28;
// the shift and entry type stay kept on this device this long after its last entry (inferred: no shift times exist anywhere)
const LOG_KEEP_HOURS = 4;
const LOG_TILES = 10;
const LOG_AMOUNTS = 6;
const LOG_AREAS = 12;
// a second press of a write button within this time is a double tap (a gloved hand), not a second entry
const LOG_GUARD_MS = 1500;
// a reading this many times over the top of its range (or under a fifth of its bottom) is asked about once: a check of the
// page's own, not a rule
const LOG_CHECK_X = 5;
// a day sheet row's name starts with its sheet day and place ("2026-10-22 #3 ..."); a Log tab name never does
const LOG_SHEET_RE = /^\d{4}-\d{2}-\d{2} #\d+(\s|$)/;
// a Log tab name ends with the time and the first 4 characters of the row id ("... 14:05 ab12")
const LOG_TAIL_RE = / (\d{2}:\d{2}) [0-9a-f]{4}$/;
// a Log tab name's amount with How many above 1 ("3x1G", "2x24oz", "3x1/2G"): the size and the count
const LOG_SIZE_RE = /\b(\d+)x(\d+(\.\d+)?|\d+\/\d+)(G|oz|lb)\b/;
// removed device entries are remembered this long, so another browser tab cannot bring one back
const LOG_TOMB_MS = 48 * 3600000;
const LOG_COUNT_MAX = 20;
const LOG_KINDS = ['jug', 'barrel', 'return', 'check'];
// the 28-day history read: what the chips are ranked from (the name for the size of a How many entry)
const LOG_HIST_COLS = ['craa5__c_chemicalusagelogname', 'craa5_entrytype', 'craa5_logdate', 'craa5_itemnumber', 'craa5_amount', 'craa5_amountunit', 'craa5_area', 'craa5_areaaswritten',
    'craa5_application', 'craa5_actiontaken', 'craa5_note'];
const LOG_ALIAS_COLS = ['craa5__c_areaaliasname', 'craa5_area', 'craa5_spot', 'craa5_room'];
// the columns the Log tab writes; a Fix compares these and sends an explicit null for one it clears (never the log date)
const LOG_FIX_COLS = ['craa5__c_chemicalusagelogname', 'craa5_entrytype', 'craa5_shift', 'craa5_itemnumber', 'craa5_application', 'craa5_amount', 'craa5_amountunit', 'craa5_gallons',
    'craa5_area', 'craa5_areaaswritten', 'craa5_spot', 'craa5_drops', 'craa5_ppm', 'craa5_targetmin', 'craa5_targetmax', 'craa5_inrange', 'craa5_actiontaken', 'craa5_note'];

// ---------------------------------------------------------------- kinds, units, choices
// An entry type label to what the Log tab makes of it, by cuRows' rules in cuRows' order, so every row it saves charts:
// 'barrel', 'return', 'check', 'jug', or '' (blank, or a label the charts do not read).
function logKind(label) {
    const e = impClean(label);
    if (!e) return '';
    if (/barrel/i.test(e)) return 'barrel';
    if (/return/i.test(e)) return 'return';
    if (/titrat/i.test(e)) return 'check';
    if (/jug|issue/i.test(e)) return 'jug';
    return '';
}
// An amount unit label to 'gal', 'oz', 'lb' or '' (as cuRows reads units).
function logUnitKind(label) { const u = impClean(label); return /^gal/i.test(u) ? 'gal' : /^(ounce|oz)/i.test(u) ? 'oz' : /^(pound|lb)/i.test(u) ? 'lb' : ''; }
// A choice column's options as Dataverse has them, in Dataverse's order: [[label, value]]. Never the hub's own CH_SPEC list
// (impChoiceLabels falls back to it), so a label Dataverse lacks is simply not offered. tbl: the table as impLoadTable read it.
function logChoices(tbl, col) {
    const real = tbl && tbl.cols ? tbl.cols[col] : '';
    const have = real && tbl.options ? tbl.options[real] : null;
    return Array.isArray(have) ? have.filter(function (o) { return o && impClean(o[0]) && o[1] !== null && o[1] !== undefined; }) : [];
}
// A label's value in Dataverse's own options of that column, or null: the same letters and digits, else the one option whose
// whole label starts with the label, or that the label starts with ('FC foamer' and 'FC foamer (food contact)'), when only
// one does. Never a CH_SPEC value.
function logChoiceValue(tbl, col, label) {
    const n = impNorm(label);
    if (!n) return null;
    const opts = logChoices(tbl, col);
    const hit = opts.filter(function (o) { return impNorm(o[0]) === n; })[0];
    if (hit) return hit[1];
    const pre = opts.filter(function (o) { const m = impNorm(o[0]); return !!m && (m.indexOf(n) === 0 || n.indexOf(m) === 0); });
    return pre.length === 1 ? pre[0][1] : null;
}
// Spec names and labels to what Dataverse takes, for the Log tab's writes: real column names, choices through logChoiceValue
// (never impOptionValue, never a CH_SPEC value), dates by the column's settings; null and undefined are left out. Returns
// { data, missing: [{ col, label, colLabel, why }] (a choice label Dataverse lacks: refused, never sent), absent: [{ col, label,
// why }] (a value for a column the table lacks), ok, why }. A create with anything missing or absent is not sent.
function logPayload(tbl, fields) {
    const out = { data: {}, missing: [], absent: [], ok: true, why: '' };
    const logical = tbl && tbl.logical ? tbl.logical : IMP_T.usage;
    Object.keys(fields || {}).forEach(function (k) {
        const v = fields[k];
        if (v === null || v === undefined) return;
        const real = tbl && tbl.cols ? tbl.cols[k] : '', c = chSpecCol(logical, k);
        const cl = c ? c.label.replace(/^_c_ /, '') : k;
        if (!real || !c) { out.absent.push({ col: k, label: cl, why: 'Ask the hub admin: the usage log has no ' + cl + ' column yet (Tables tab, Admin view)' }); return; }
        if (c.type === 'Choice') {
            const cv = logChoiceValue(tbl, k, v);
            if (cv === null) { out.missing.push({ col: k, label: impClean(v), colLabel: cl, why: 'Dataverse\'s ' + cl + ' choices have no ' + impClean(v) }); return; }
            out.data[real] = cv;
            return;
        }
        out.data[real] = tbl.dates && tbl.dates[real] ? chDateOut(tbl.dates[real], v) : v;
    });
    out.ok = !out.missing.length && !out.absent.length;
    out.why = out.missing.concat(out.absent).map(function (m) { return m.why; }).join('. ');
    return out;
}

// ---------------------------------------------------------------- amounts, names, the Note
// An amount as the day sheets write it: '1G', '55G', '1/2G', '1/4G', '3/4G', other gallons as a plain decimal ('0.3G'),
// '24oz', '20lb'; How many above 1 in front ('3x1G', '2x24oz'). value: the size of one; '' when there is no number.
function logAmountText(value, unitKind, count) {
    const v = typeof value === 'number' ? value : impNumber(value).value;
    if (typeof v !== 'number' || !isFinite(v)) return '';
    const n = typeof count === 'number' && count > 1 ? Math.round(count) + 'x' : '';
    const num = String(ordRound(v, 4));
    if (unitKind === 'gal') return n + (num === '0.5' ? '1/2' : num === '0.25' ? '1/4' : num === '0.75' ? '3/4' : num) + 'G';
    if (unitKind === 'oz') return n + num + 'oz';
    if (unitKind === 'lb') return n + num + 'lb';
    return n + num;
}
// Gallons from the unrounded total: gallons as they are, ounces / 128, rounded the way the Gallons column keeps them; null
// for pounds (or no unit).
function logGallons(tbl, total, unitKind) {
    if (typeof total !== 'number' || !isFinite(total)) return null;
    if (unitKind === 'gal') return impDec(tbl, 'craa5_gallons', total);
    if (unitKind === 'oz') return impDec(tbl, 'craa5_gallons', total / 128);
    return null;
}
// A Log tab row name: the parts (blank ones left out), then the time of at and the first 4 characters of the id, which keep
// names apart within a day. Cut to the name column's length (at least 40) so the time and id piece always stay; a name that
// would read as a day sheet place gets 'Log ' in front. tail: 'hh:mm xxxx' to keep instead (a Fix keeps the row's own).
function logName(tbl, parts, at, id, tail) {
    const p = chSpecTable(IMP_T.usage).columns.filter(function (c) { return c.primary; })[0];
    const max = Math.max(40, impMaxLen(tbl, p) || 100);
    const d = ordDate(at);
    const end = tail ? ' ' + impClean(tail) : ' ' + (d ? chTime(d) : '00:00') + ' ' + String(id || '').toLowerCase().replace(/[^0-9a-f]/g, '').slice(0, 4);
    let text = impClean((parts || []).filter(function (x) { return impClean(x); }).join(' ')) || 'Log';
    const cut = function (t) { return t.slice(0, Math.max(1, max - end.length)).trim() + end; };
    if (LOG_SHEET_RE.test(text) || LOG_SHEET_RE.test(cut(text))) text = 'Log ' + text;
    return cut(text);
}
// The 'hh:mm xxxx' a Log tab name ends with, or '' (a day sheet name, one typed in Power Apps).
function logTailOf(name) { const s = impClean(name), m = LOG_TAIL_RE.exec(s); return m ? s.slice(m.index + 1) : ''; }
// An entry's row id: the same nonce and part always give the same id.
function logIdOf(nonce, part) { return chGuidFrom('log|' + nonce + '|' + (part || 0)); }
// The Note's parts the Log tab writes, each with a fixed start, so a Fix can take them out and build them again
function logNotePart(p) {
    if (/^Drops: \d+ x \S+ PPM per drop$/.test(p)) return 'drops';
    if (/^Target \S+ to \S+ PPM: (in range|out of range)$/.test(p)) return 'target';
    if (/^Range not set: ./.test(p)) return 'range';
    if (/^Range not checked: ./.test(p)) return 'unchecked';
    if (/^Action taken: ./.test(p)) return 'action';
    if (/^Retest after the \d{1,2}:\d{2} reading$/.test(p)) return 'retest';
    return '';
}
// A Note split into what the user typed and the parts the Log tab wrote ("Drops: ", "Action taken: ", "Range not set: ",
// "Range not checked: ", "Target ", "Retest after "): { user, parts, action (the text after "Action taken: "), retest
// ('hh:mm'), noRange (a "Range not checked" part), drops and perDrop (a "Drops: n x p PPM per drop" part, else null), min and
// max (a "Target a to b PPM" part, else null), range (the "Range not set" or "Range not checked" part, else '') }. A part
// that only starts like one of them stays the user's. The page writes its parts in a fixed order (the user's text, Drops,
// Target, Range, Action taken, Retest), so the action is read on to the end of the Note, stopping only before a later part
// of another kind (the Retest part, or a Drops, Target or Range part after an action typed by hand): an action typed with
// '; ' in it stays whole.
function logSplitNote(note) {
    const out = { user: '', parts: [], action: '', retest: '', noRange: false, drops: null, perDrop: null, min: null, max: null, range: '' };
    const s = note === null || note === undefined ? '' : String(note);
    if (!s.replace(/\s+/g, '')) return out;
    const user = [], ps = s.split('; ');
    for (let i = 0; i < ps.length; i++) {
        let p = ps[i];
        const k = logNotePart(p);
        if (!k) { user.push(p); continue; }
        if (k === 'action') {
            let end = i + 1;
            while (end < ps.length && (!logNotePart(ps[end]) || logNotePart(ps[end]) === 'action')) end++;
            p = ps.slice(i, end).join('; '); i = end - 1;
        }
        out.parts.push(p);
        if (k === 'action') out.action = p.slice('Action taken: '.length);
        if (k === 'retest') out.retest = /(\d{1,2}:\d{2})/.exec(p)[1];
        if (k === 'unchecked') out.noRange = true;
        if (k === 'range' || k === 'unchecked') out.range = p;
        if (k === 'drops') { const m = /^Drops: (\d+) x (\S+) PPM per drop$/.exec(p), pd = Number(m[2]); if (isFinite(pd)) { out.drops = +m[1]; out.perDrop = pd; } }
