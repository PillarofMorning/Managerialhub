            const s = steps[i++];
            return chSend(fetcher, s.method, s.url, s.data).then(function (r) {
                if (!chOk(r)) { setProblem((s.what || 'A change') + ' was not saved. Dataverse said: ' + r.message + (i > 1 ? ' The ' + (i - 1) + ' change' + (i - 1 === 1 ? '' : 's') + ' before it were saved.' : '')); return false; }
                return step();
            });
        };
        return step().then(function (ok) { setBusy(false); if (ok) { say(doneText); load(); } return ok; });
    };
    const saveCart = function (c) {
        const now = new Date().toISOString();
        const total = ordRound(ordCartTotal(c, qtyOf), 2);
        const steps = [{ method: 'POST', url: url(T.cart), what: 'The cart', data: ordPayload(T.cart, { craa5__c_cartname: c.title, craa5_vendornumber: c.vendorNo, craa5_cartstatus: ordChoiceValue(ORD_T.cart, 'craa5_cartstatus', 'Draft (not in SAP yet)'), craa5_carttotal: total, craa5_draftedon: now }) }];
        c.lines.forEach(function (l) {
            const q = qtyOf(c, l); if (q <= 0) return;
            let fromStock = q;
            // requests join the cart as they are; only the rest becomes a new line
            l.sug.requests.forEach(function (r) {
                if (fromStock <= 0) return;
                const rq = Math.min(ordNum(r.craa5_quantity), fromStock); fromStock -= rq;
                steps.push({ method: 'PATCH', url: url(T.line, r._id), what: 'Request ' + (r.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5__c_cartname: c.title, craa5_quantity: rq, craa5_unitprice: l.sug.price, craa5_linetotal: ordRound(rq * l.sug.price, 2) }) });
            });
            if (fromStock > 0) steps.push({ method: 'POST', url: url(T.line), what: 'Line ' + l.sug.name, data: ordPayload(T.line, { craa5__c_cartlinename: (l.sug.name + ' x' + ordQty(fromStock)).slice(0, 200), craa5__c_cartname: c.title, craa5_itemnumber: l.sug.itemNo,
                craa5_quantity: fromStock, craa5_unitprice: l.sug.price, craa5_linetotal: ordRound(fromStock * l.sug.price, 2), craa5_source: ordChoiceValue(ORD_T.line, 'craa5_source', 'Suggested') }) });
        });
        run(steps, 'Saved ' + c.title + ' as a draft cart. Paste it into SAP, then add the SAP cart number under Open carts.');
    };
    const patchCart = function (c, fields, doneText) { return run([{ method: 'PATCH', url: url(T.cart, c._id), what: 'The cart', data: ordPayload(T.cart, fields) }], doneText); };
    const receive = function (c, lines, recs) {
        const now = new Date();
        const steps = [];
        recs.forEach(function (r) {
            steps.push({ method: 'PATCH', url: url(T.line, r.line._id), what: 'Line ' + (r.line.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5_quantityreceived: ordNum(r.line.craa5_quantityreceived) + r.qty, craa5_receivedon: ordIsoDay(now) }) });
            const k = ordKey(r.line.craa5_itemnumber), s = ix.stock[k];
            if (s && s.rows.length) {
                const row = s.rows[0];
                steps.push({ method: 'PATCH', url: url(T.stock, row._id), what: 'Stock of ' + (row.craa5__c_chemicalinventoryname || k), data: ordPayload(T.stock, { craa5_quantityonhand: ordNum(row.craa5_quantityonhand) + r.qty, craa5_lastupdated: now.toISOString() }) });
                row.craa5_quantityonhand = ordNum(row.craa5_quantityonhand) + r.qty;
            } else {
                const it = ix.items[k];
                steps.push({ method: 'POST', url: url(T.stock), what: 'New stock row for ' + k, data: ordPayload(T.stock, { craa5__c_chemicalinventoryname: ((it && (it.craa5_commonname || it.craa5__c_chemicalname)) || k) + ' - Chemical room', craa5_itemnumber: r.line.craa5_itemnumber,
                    craa5_location: ordChoiceValue(ORD_T.stock, 'craa5_location', 'Chemical room'), craa5_quantityonhand: r.qty, craa5_minimumthreshold: 0, craa5_lastupdated: now.toISOString() }) });
            }
        });
        const all = lines.every(function (l) {
            const r = recs.filter(function (x) { return x.line._id === l._id; })[0];
            return ordNum(l.craa5_quantityreceived) + (r ? r.qty : 0) >= ordNum(l.craa5_quantity);
        });
        steps.push({ method: 'PATCH', url: url(T.cart, c._id), what: 'The cart', data: ordPayload(T.cart, { craa5_cartstatus: ordChoiceValue(ORD_T.cart, 'craa5_cartstatus', all ? 'Received' : 'Partially received'), craa5_receivedon: now.toISOString() }) });
        return run(steps, 'Receipt saved for ' + c.craa5__c_cartname + '. Stock is updated.');
    };
    // A cart that arrived before the last count: its lines are marked received, stock is left alone (the count already has them).
    const closeCart = function (c, lines) {
        const steps = [];
        lines.forEach(function (l) {
            if (ordNum(l.craa5_quantityreceived) < ordNum(l.craa5_quantity)) steps.push({ method: 'PATCH', url: url(T.line, l._id), what: 'Line ' + (l.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5_quantityreceived: ordNum(l.craa5_quantity) }) });
        });
        steps.push({ method: 'PATCH', url: url(T.cart, c._id), what: 'The cart', data: ordPayload(T.cart, { craa5_cartstatus: ordChoiceValue(ORD_T.cart, 'craa5_cartstatus', 'Received') }) });
        return run(steps, c.craa5__c_cartname + ' closed as received. Stock was not changed.');
    };
    const addRequest = function () {
        const it = ix.items[ordKey(req.item)];
        const q = ordNum(req.qty);
        if (!it || q <= 0) { setProblem('Pick an item from the list and a quantity above 0.'); return; }
        const name = it.craa5_commonname || it.craa5__c_chemicalname || it.craa5_itemnumber;
        run([{ method: 'POST', url: url(T.line), what: 'The request', data: ordPayload(T.line, { craa5__c_cartlinename: ('Request: ' + name + ' x' + ordQty(q)).slice(0, 200), craa5_itemnumber: it.craa5_itemnumber, craa5_quantity: q,
            craa5_unitprice: ordNum(it.craa5_priceperunit), craa5_linetotal: ordRound(q * ordNum(it.craa5_priceperunit), 2), craa5_source: ordChoiceValue(ORD_T.line, 'craa5_source', 'Clerk request'), craa5_requestedby: chUserName() || null, craa5_reason: req.reason || null }) }],
            'Request added. It joins the next suggested cart for ' + ordVendorName(ix, it.craa5_vendornumber) + '.').then(function (ok) { if (ok) setReq({ item: '', qty: '1', reason: '' }); });
    };

    const spend = carts.reduce(function (n, c) { return n + ordCartTotal(c, qtyOf); }, 0);
    const openValue = openCarts.reduce(function (n, c) { return n + ordNum(c.craa5_carttotal); }, 0);
    const viewBtn = function (key, label, n) {
        const on = view === key;
        return <button type="button" key={key} onClick={function () { setView(key); }} aria-pressed={on} data-ord-view={key}
            className={'min-h-[44px] px-3 rounded-lg text-sm font-bold border focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ' + (on ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-[#00468B] border-slate-300 hover:bg-slate-50')}>{label}{n !== undefined ? ' (' + n + ')' : ''}</button>;
    };
    const ready = !!ix;
    const noData = ready && !ix.itemList.length;
    return (
        <div>
            <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-center gap-2 rounded-t-xl">
                    <h1 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Ordering</h1>
                    <span className="ml-auto text-xs text-slate-600" aria-live="polite">{loading ? 'Reading the ordering tables...' : data ? 'Read at ' + chTime(data.loadedAt) : 'Not read yet'}</span>
                </div>
                <div className="px-5 py-4">
                    <div className="grid gap-3 grid-cols-2 lg:grid-cols-4">
                        <Tile label="To order" value={ready ? sugs.length : '-'} note={ready ? 'items' : ''} />
                        <Tile label="Suggested spend" value={ready ? ordMoney(spend) : '-'} note={ready ? carts.length + ' cart' + (carts.length === 1 ? '' : 's') : ''} />
                        <Tile label="Open carts" value={ready ? openCarts.length : '-'} note={ready ? ordMoney(openValue) : ''} />
                        <Tile label="Alerts" value={ready ? alerts.length : '-'} note="" />
                    </div>
                    {problem && <p role="alert" className="mt-3 flex items-start gap-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]"><WarnIcon className="w-4 h-4 mt-0.5 flex-shrink-0" />{problem}</p>}
                    {msg && <p role="status" className="mt-3 rounded-lg border border-[#B3D4F2] bg-[#E6F1FB] px-3 py-2 text-sm text-[#00468B]">{msg}</p>}
                    {noData && <p className="mt-3 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]">The Chemical table has no rows yet. Import the files in the chemical-ordering import folder (Distributors, Chemicals, stock, carts, cart lines, counts), then press Refresh.</p>}
                    <div className="mt-4 flex flex-wrap items-center gap-2">
                        <button type="button" onClick={function () { if (!loading) load(); }} aria-disabled={loading} className={btnBlue + (loading ? ' opacity-50 cursor-not-allowed' : '')}><RefreshIcon className="w-4 h-4" />{loading ? 'Reading...' : 'Refresh'}</button>
                        <span className="ml-auto flex flex-wrap gap-2" role="group" aria-label="Show">
                            {viewBtn('suggested', 'Suggested carts', ready ? carts.length : undefined)}{viewBtn('open', 'Open carts', ready ? openCarts.length : undefined)}{viewBtn('requests', 'Requests', ready ? ix.requests.length : undefined)}{viewBtn('alerts', 'Alerts', ready ? alerts.length : undefined)}
                        </span>
                    </div>
                    <details className="mt-3">
                        <summary className="min-h-[44px] flex items-center cursor-pointer text-sm font-extrabold text-[#0072CE]">How this is read</summary>
                        <ul className="mt-1 list-disc pl-5 text-sm text-slate-700 space-y-1">
                            <li>On hand and minimum add up every stock row of the item. On order is what open carts (draft to partially received) still have to deliver.</li>
                            <li>Use a week comes from the Sunday counts over the last {ORD_USE_WEEKS} weeks: between two counts, use = the earlier count + what arrived in between - the later count. A delivery with no received date is dated its cart's submitted date plus the lead time.</li>
                            <li>An item is suggested when on hand + on order - the use expected during the lead time is at or under its minimum. It is ordered up to its par level (or minimum + 1 when there is no par level, the old sheet rule) plus that lead-time use. With no count history the use is 0, which is exactly the old sheet rule.</li>
                            <li>Lead time and cart limit come from the distributor row ({ORD_LEAD_DAYS} days and {ordMoney(ORD_CART_LIMIT)} when blank). Lines are packed biggest first into as few carts as fit under the limit; a single line over the limit is split.</li>
                            <li>Requests (cart lines with no cart yet) are added on top and join the cart when it is saved.</li>
                            <li>Nothing is written until you press a button. Save as draft cart writes the cart and its lines; Receive adds what arrived to the first stock row of each item; Close as received marks a cart that came before the last count as received and leaves stock alone, because the count already has it.</li>
                        </ul>
                    </details>
                </div>
            </div>
            {ready && view === 'suggested' && <div className="mt-6 space-y-3">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Suggested carts</h2>
                {carts.map(function (c) { return <SuggestedCart key={c.key} cart={c} qtyOf={qtyOf} setQty={setLineQty} busy={busy} copied={copied} onCopy={function (cc) { copyText(cc.key, ordSapText(cc, qtyOf)); }} onSave={saveCart} />; })}
                {!carts.length && <p className="text-sm text-slate-600">Nothing needs ordering right now.</p>}
            </div>}
            {ready && view === 'open' && <div className="mt-6 space-y-3">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Open carts</h2>
                {openCarts.map(function (c) { return <OpenCart key={c._id} cart={c} ix={ix} busy={busy} onPatch={patchCart} onReceive={receive} onClose={closeCart} />; })}
                {!openCarts.length && <p className="text-sm text-slate-600">No open carts.</p>}
            </div>}
            {ready && view === 'requests' && <div className="mt-6 space-y-3">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Requests</h2>
                <div className="rounded-xl border border-slate-200 bg-white shadow-sm px-4 py-3 flex flex-wrap items-end gap-2">
                    <label className="text-xs font-bold text-slate-600 grow min-w-[220px]">Item<input list="ord-items" value={req.item} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { item: v.split(' - ')[0] }); }); }} placeholder="Item number or name" data-ord-req-item className={inputCls + ' block w-full mt-1'} /></label>
                    <datalist id="ord-items">{ix.itemList.map(function (it) { return <option key={it._id} value={it.craa5_itemnumber + ' - ' + (it.craa5_commonname || it.craa5__c_chemicalname || '')} />; })}</datalist>
                    <label className="text-xs font-bold text-slate-600">Quantity<input type="number" min="1" step="1" value={req.qty} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { qty: v }); }); }} data-ord-req-qty className={inputCls + ' block w-24 mt-1'} /></label>
                    <label className="text-xs font-bold text-slate-600 grow min-w-[180px]">Reason<input value={req.reason} maxLength={200} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { reason: v }); }); }} className={inputCls + ' block w-full mt-1'} /></label>
                    <button type="button" data-ord-req-add className={btnBlue + (busy ? ' opacity-50 cursor-not-allowed' : '')} aria-disabled={busy} onClick={function () { if (!busy) addRequest(); }}>Add request</button>
                </div>
                {ix.requests.map(function (r) {
                    const it = ix.items[ordKey(r.craa5_itemnumber)];
                    return <div key={r._id} className="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm"><span className="font-semibold">{it ? (it.craa5_commonname || it.craa5__c_chemicalname) : r.craa5__c_cartlinename}</span> <span className="font-mono text-xs text-slate-500">{r.craa5_itemnumber}</span>
                        <span className="block text-slate-600">{ordQty(r.craa5_quantity)} requested{r.craa5_requestedby ? ' by ' + r.craa5_requestedby : ''}{r.craa5_reason ? ': ' + r.craa5_reason : ''}</span></div>;
                })}
                {!ix.requests.length && <p className="text-sm text-slate-600">No requests waiting.</p>}
            </div>}
            {ready && view === 'alerts' && <div className="mt-6 space-y-2">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Alerts</h2>
                {alerts.map(function (a, i) {
                    const cls = a.level === 'red' ? 'border-[#E4002B]/40 bg-[#FDE8EC] text-[#B80022]' : a.level === 'blue' ? 'border-[#B3D4F2] bg-[#E6F1FB] text-[#00468B]' : 'border-[#FFB81C] bg-[#FFF6E0] text-[#7A4B00]';
                    return <p key={i} className={'rounded-lg border px-3 py-2 text-sm ' + cls}>{a.text}</p>;
                })}
                {!alerts.length && <p className="text-sm text-slate-600">No alerts.</p>}
            </div>}
        </div>
    );
}

