// cart limit: a cart packed to 95% of $25,000 stays under the limit after a 5% price rise
const ORD_PRICE_MARGIN = 0.05;
const ORD_USE_WEEKS = 12;
const ORD_QUOTE_WARN_DAYS = 30;
const ORD_STALE_DAYS = 14;
const ORD_OPEN = ['Draft (not in SAP yet)', 'Submitted', 'Approved', 'Ordered', 'Partially received'];
