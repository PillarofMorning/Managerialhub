const CU_ALIAS_COLS = ['craa5__c_areaaliasname', 'craa5_area', 'craa5_room'];
// the usual read: the last 400 days (the last 12 months or the year to date, and the weeks before for the 4-week average)
const CU_DAYS = 400;
const CU_BY = [{ key: 'item', label: 'Chemical' }, { key: 'room', label: 'Room' }, { key: 'area', label: 'Area' }, { key: 'shift', label: 'Shift' }, { key: 'app', label: 'Application' },
    { key: 'dow', label: 'Weekday' }];
const CU_WD = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const CU_NO = { room: 'No room', area: 'No area', shift: 'No shift', app: 'No application' };
// the filter value for rows with no room or no shift
const CU_NONE = '(none)';
const CU_OUT_SHOWN = 8;
// a titration reading that hardly ever changes: the same PPM on 9 in 10 readings or more, of 20 or more
const CU_SAME_N = 20, CU_SAME_SHARE = 0.9;
const INS_VIEWS = [{ key: 'spend', label: 'Spend and stock' }, { key: 'use', label: 'Chemical use' }];
// out of range on the titration bars: the page's amber (a warning, not red), told apart from the blue in range by people
// with any colour vision (checked: lightness and colour-blind separation)
const CU_OUT_C = '#B45309';

// gallons for tiles and tooltips (1,234 gal, 56.5 gal, 0.13 gal); on an axis without the unit (950, 1.2K, 12K)
function cuGal(n) { const v = ordNum(n), a = Math.abs(v); return chNumber(String(a >= 100 ? Math.round(v) : ordRound(v, a >= 10 ? 1 : 2))) + ' gal'; }
function cuAxis(n) {
    const v = ordNum(n), a = Math.abs(v);
    if (a >= 9995) return Math.round(v / 1000) + 'K';
    if (a >= 999.5) return (v / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    return String(ordRound(v, 1));
}
function cuLb(n) { const v = ordNum(n); return chNumber(String(Math.abs(v) >= 100 ? Math.round(v) : ordRound(v, 1))) + ' lb'; }
// a PPM reading as written, with thousands marked (24,365 ppm, 1.5 ppm)
function cuPpm(n) { const p = String(ordRound(ordNum(n), 2)).split('.'); return chNumber(p[0]) + (p[1] ? '.' + p[1] : '') + ' ppm'; }
