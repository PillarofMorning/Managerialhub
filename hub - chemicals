function TablesTab(props) {
    const fetcher = props.fetcher;
    const [answers, setAnswers] = useState({});
    const [checking, setChecking] = useState(false);
    const [checkedAt, setCheckedAt] = useState(null);
    const [problem, setProblem] = useState('');
    const [filter, setFilter] = useState('all');
    const [copied, setCopied] = useState('');
    const runId = useRef(0);
    const base = useMemo(function () { return props.baseUrl !== undefined ? props.baseUrl : chClientUrl(); }, [props.baseUrl]);

    const run = useCallback(function () {
        if (!base) { setProblem('Cannot check from here: this page has no Dataverse address. Open the Chemical hub inside the Power Apps app and press Check again. The list below is what the hub needs.'); return; }
        const id = ++runId.current;
        setChecking(true); setProblem(''); setAnswers({});
        chPool(CH_SPEC, CH_PARALLEL, function (t) {
            return chCheckTable(fetcher, base, t).then(function (r) {
                if (runId.current === id) setAnswers(function (prev) { const n = Object.assign({}, prev); n[t.logical] = r; return n; });
                return r;
            });
        }).then(function (all) {
            if (runId.current !== id) return;
            const none = all.every(function (r) { return r && r.state === 'noanswer'; });
            if (none) setProblem('Dataverse did not answer for any table. Check the connection and press Check again.');
            setChecking(false); setCheckedAt(new Date());
        });
    }, [base, fetcher]);

    useEffect(function () { run(); }, [run]);

    const views = CH_SPEC.map(function (t) { return chCompare(t, answers[t.logical]); });
    const hubViews = views.filter(function (v) { return v.table.group === 'hub'; });
    const readViews = views.filter(function (v) { return v.table.group === 'read'; });
    const checked = views.filter(function (v) { return !!v.res; }).length;
    const tally = function (list) {
        return {
            found: list.filter(function (v) { return v.state === 'found'; }).length,
            missing: list.filter(function (v) { return v.state === 'missing'; }).length,
            work: list.filter(chTableNeedsWork).length
        };
    };
    const th = tally(hubViews), tr = tally(readViews);
    const missingCols = hubViews.reduce(function (n, v) { return n + (v.state === 'missing' ? v.table.columns.length : v.counts.missing); }, 0);
    const shown = function (list) {
        if (filter === 'work') return list.filter(chTableNeedsWork);
        if (filter === 'found') return list.filter(function (v) { return v.state === 'found' && !chTableNeedsWork(v); });
        return list;
    };
    const copy = function (everything) {
        // Before any answer nothing is known to exist, so both buttons copy the whole list.
        const text = chBuildText(views, everything || checked === 0);
        const done = function () { setCopied(everything ? 'all' : 'missing'); setTimeout(function () { setCopied(''); }, 2500); };
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copy this text', text); }); return; }
        } catch (e) { /* fall through */ }
        window.prompt('Copy this text', text);
    };
    const filterBtn = function (key, label) {
        const on = filter === key;
        return <button type="button" key={key} onClick={function () { setFilter(key); }} aria-pressed={on}
            className={'min-h-[44px] px-3 rounded-lg text-sm font-bold border focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ' + (on ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-[#00468B] border-slate-300 hover:bg-slate-50')}>{label}</button>;
    };
    const section = function (title, note, list, startOpen) {
        const vis = shown(list);
        return (
            <div className="mt-6">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">{title}</h2>
                <p className="mt-1 text-sm text-slate-600">{note}</p>
                <div className="mt-3 space-y-3">
                    {vis.map(function (v) { return <TableCard key={v.table.logical} view={v} checking={checking} startOpen={startOpen} />; })}
                    {!vis.length && <p className="text-sm text-slate-500">Nothing to show with this filter.</p>}
                </div>
            </div>
        );
    };
    return (
        <div>
            <div className="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div className="bg-[#E6F1FB] border-b border-[#CFE3F7] px-5 py-3 flex flex-wrap items-center gap-2 rounded-t-xl">
                    <TableIcon className="w-5 h-5 text-[#0072CE]" />
                    <h1 className="text-sm font-black text-[#00468B] uppercase tracking-widest">Dataverse tables</h1>
                    <span className="ml-auto text-xs text-slate-600" aria-live="polite">{checking ? 'Checking ' + checked + ' of ' + CH_SPEC.length + ' tables...' : checkedAt ? 'Last checked ' + chTime(checkedAt) : 'Not checked yet'}</span>
                </div>
                <div className="px-5 py-4">
                    <div className="grid gap-3 sm:grid-cols-3">
                        <div className="rounded-lg border border-slate-200 p-3"><p className="text-[11px] font-black uppercase tracking-widest text-slate-500">This hub's tables</p><p className="text-2xl font-black text-slate-900">{checked ? th.found : '-'} <span className="text-base font-bold text-slate-500">of {hubViews.length} found</span></p></div>
                        <div className="rounded-lg border border-slate-200 p-3"><p className="text-[11px] font-black uppercase tracking-widest text-slate-500">To create or fix</p><p className="text-2xl font-black text-slate-900">{checked ? th.work : '-'} <span className="text-base font-bold text-slate-500">{checked ? 'tables, ' + missingCols + ' columns' : 'not checked yet'}</span></p></div>
                        <div className="rounded-lg border border-slate-200 p-3"><p className="text-[11px] font-black uppercase tracking-widest text-slate-500">Read from other apps</p><p className="text-2xl font-black text-slate-900">{checked ? tr.found : '-'} <span className="text-base font-bold text-slate-500">of {readViews.length} found</span></p></div>
                    </div>
                    {problem && <p role="alert" className="mt-3 flex items-start gap-2 rounded-lg border border-[#FFB81C] bg-[#FFF6E0] px-3 py-2 text-sm text-[#7A4B00]"><WarnIcon className="w-4 h-4 mt-0.5 flex-shrink-0" />{problem}</p>}
                    <div className="mt-4 flex flex-wrap items-center gap-2">
                        <button type="button" data-ch-check onClick={function () { if (!checking) run(); }} aria-disabled={checking} className={btnBlue + (checking ? ' opacity-50 cursor-not-allowed' : '')}><RefreshIcon className="w-4 h-4" />{checking ? 'Checking...' : 'Check again'}</button>
                        <button type="button" onClick={function () { copy(false); }} className={btnWhite}><CopyIcon className="w-4 h-4" />{copied === 'missing' ? 'Copied' : 'Copy what to create'}</button>
                        <button type="button" onClick={function () { copy(true); }} className={btnWhite}><CopyIcon className="w-4 h-4" />{copied === 'all' ? 'Copied' : 'Copy full spec'}</button>
                        <span className="ml-auto flex flex-wrap gap-2" role="group" aria-label="Show">{filterBtn('all', 'All')}{filterBtn('work', 'Needs work')}{filterBtn('found', 'All good')}</span>
                    </div>
                    <details className="mt-3">
                        <summary className="min-h-[44px] flex items-center cursor-pointer text-sm font-extrabold text-[#0072CE]">How this is read</summary>
                        <ul className="mt-1 list-disc pl-5 text-sm text-slate-700 space-y-1">
                            <li>The check reads each table's definition from Dataverse (EntityDefinitions): its columns, their data types, choice values, lookup targets, text lengths and Dataverse requirement. It never reads row contents.</li>
                            <li>For a table that is found it also asks for one row id with a count, to show how many rows there are (up to 5,000) and whether your security role can read them.</li>
                            <li>Hub needs: Required means the hub cannot do its job without the column; Optional means a feature is reduced without it. The Dataverse requirement (Business required or Optional) is shown separately when found.</li>
                            <li>Not found is shown only when Dataverse itself says the table or column does not exist. If a request gets no answer or is refused, the result says so and nothing is marked missing.</li>
                            <li>Other columns found lists custom columns Dataverse has that this list does not use, for example from the old chemlog page.</li>
                            <li>Nothing on this tab writes to Dataverse. Copy what to create gives a plain text list for the Power Apps maker portal.</li>
                        </ul>
                    </details>
                </div>
            </div>
            {section("This hub's tables", 'Create or extend these. Existing tables keep their data; only columns are added.', hubViews, false)}
            {section('Read from other apps', 'Owned by MSS, Shift Start, the production scheduler and the People page. Only the columns this hub reads are listed.', readViews, false)}
        </div>
    );
}

