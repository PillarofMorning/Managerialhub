// most common one otherwise (every value on a tie), 'No two the same' when none repeats; '' when it has none
function cuUsual(x) {
    if (!x.none) return '';
    if (x.none === 1) return 'One reading: ' + cuPpm(x.lo);
    const range = x.lo !== x.hi ? ', from ' + cuPpm(x.lo) + ' to ' + cuPpm(x.hi) : '';
    if (x.modeN < 2) return 'No two the same' + range;
    if (x.mode === null) return 'Most often ' + (x.modes.length <= 3 ? x.modes.map(cuPpm).join(' or ') : x.modes.length + ' readings') + ' (' + chNumber(x.modeN) + ' each of ' + chNumber(x.none) + ')' + range;
    return (x.modeN * 2 > x.none ? 'Usually ' : 'Most often ') + cuPpm(x.mode) + ' (' + chNumber(x.modeN) + ' of ' + chNumber(x.none) + ')' + range + (x.same ? '. Hardly ever changes.' : '');
}
// the table's Most common cell: the reading, the tied readings (up to 3), or '-' when none repeats
function cuModeCell(x) { return x.mode !== null ? cuPpm(x.mode) : x.modeN >= 2 ? (x.modes.length <= 3 ? x.modes.map(cuPpm).join(' or ') : x.modes.length + ' tie') : '-'; }
