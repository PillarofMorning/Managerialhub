    const shown = lines.filter(function (l) { return inRange(l.day); });
    // open: true = only what is still to come, false = only what came (or has no part to come), none = the whole line
    const sum = function (list, open) { return list.reduce(function (n, l) { return n + (open === undefined ? l.total : open ? l.openAmt : l.total - l.openAmt); }, 0); };
