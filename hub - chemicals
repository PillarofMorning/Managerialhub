// ============================================================================
// ORDERING (phase A): suggested carts under the cart limit, cart tracker, requests, alerts
// ============================================================================
// Reads the six ordering tables by their spec names. The primary name column of each table is read from its definition
// (Dataverse picks it and it cannot be renamed), and columns that do not exist are left out of every request.
// Writes only on a button press: a draft cart with its lines, a cart step, a receipt (cart lines, cart, stock), a request.
const ORD_T = { dist: 'craa5__c_distributor', item: 'craa5__c_chemical', stock: 'craa5__c_chemicalinventory', cart: 'craa5__c_cart', line: 'craa5__c_cartline', count: 'craa5__c_chemicalcount' };
