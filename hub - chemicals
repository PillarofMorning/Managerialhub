function cuWeekTag(x) { return x.partial ? ' (partial)' : x.cut ? ' (cut by the dates)' : ''; }
// a share as a whole percent that never rounds a part to none or all of it (1 of 300 is 1%, 299 of 300 is 99%)
function cuPct(n, d) {
    if (!(d > 0)) return '-';
    const p = Math.round(n / d * 100);
    return (n > 0 && n < d ? Math.min(99, Math.max(1, p)) : p) + '%';
}

// Rooms from _c_ Area alias: (spelling as written, MSS area) -> room. The exact spelling, else the same letters and digits
// when those spellings all say the same room (as the Import tab matches spellings), else the area's room when every
// spelling of that area that names a room says the same one (via 'area': borrowed from the area's other spellings, not the
// spelling's own). Returns { room, via }. Keys start with # so no name meets an object's own fields.
function cuRooms(rows) {
    const x = {}, n = {}, a = {};
    (rows || []).forEach(function (r) {
        const nm = impClean(r.craa5__c_areaaliasname), room = impClean(r.craa5_room), ak = '#' + ordKey(r.craa5_area);
        if (!nm) return;
        const xk = '#' + ordKey(nm), nk = '#' + impNorm(nm);
        if (!(xk in x)) x[xk] = room;
        n[nk] = nk in n && n[nk] !== room ? null : room;
        if (ak !== '#' && room) a[ak] = ak in a && a[ak] !== room ? null : room;
    });
    return function (spelling, area) {
        const sp = impClean(spelling);
        if (sp) {
            if (x['#' + ordKey(sp)]) return { room: x['#' + ordKey(sp)], via: 'spelling' };
            if (n['#' + impNorm(sp)]) return { room: n['#' + impNorm(sp)], via: 'spelling' };
        }
        const ar = a['#' + ordKey(area)] || '';
        return { room: ar, via: ar ? 'area' : '' };
    };
}

// The log rows as the charts read them: { day (null when the row has no date), kind ('use', 'return', 'check', 'none' for no
// entry type, 'other' for one the hub does not know), barrel, key, itemNo, name, known (the item is in Chemicals), gal (null
// when not in gallons), lb (pounds, null otherwise), shift, room, roomVia ('area' when the room was borrowed), area, app, test
// (has a PPM), ppm, min, max, inr (true, false, or null when Target min or max is blank: a Yes/No column left out of a save
// reads No, so a stored No with no target is not a reading out of range), cost (estimated, null when it cannot be) }.
// Choice columns are read as Dataverse labels them.
function cuRows(rows, ix, roomOf, full) {
    // full: the whole chemical list was read, so an item number missing from it is not in Chemicals (else it may be unread)
    const items = ix ? ix.items : {}, itemsRead = !!(ix && ix.itemList.length) && full !== false;
    return (rows || []).map(function (r) {
        const e = impClean(r.craa5_entrytype), k = ordKey(r.craa5_itemnumber), item = items[k] || null, d = ordDate(r.craa5_logdate);
        const kind = !e ? 'none' : /barrel/i.test(e) ? 'use' : /return/i.test(e) ? 'return' : /titrat/i.test(e) ? 'check' : /jug|issue/i.test(e) ? 'use' : 'other';
        const unit = impClean(r.craa5_amountunit), amt = typeof r.craa5_amount === 'number' ? r.craa5_amount : null;
        let gal = typeof r.craa5_gallons === 'number' ? r.craa5_gallons : null;
        if (gal === null && amt !== null && /^gal/i.test(unit)) gal = amt;
        if (gal === null && amt !== null && /^(ounce|oz)/i.test(unit)) gal = amt / 128;
        const lb = gal === null && amt !== null && /^(pound|lb)/i.test(unit) ? amt : null;
        const ppm = typeof r.craa5_ppm === 'number' ? r.craa5_ppm : null;
        const min = typeof r.craa5_targetmin === 'number' ? r.craa5_targetmin : null, max = typeof r.craa5_targetmax === 'number' ? r.craa5_targetmax : null;
        const inr = ppm === null || min === null || max === null ? null : typeof r.craa5_inrange === 'boolean' ? r.craa5_inrange : ppm >= min && ppm <= max;
        // the estimate: per container from Gallons per container (or a container size in gallons), or a size in pounds
        let cost = null;
        const price = item ? ordNum(item.craa5_priceperunit) : 0, size = item ? ordNum(item.craa5_containersize) : 0, cu = item ? impClean(item.craa5_containerunit) : '';
        const gpc = item ? (ordNum(item.craa5_gallonspercontainer) > 0 ? ordNum(item.craa5_gallonspercontainer) : /^gal/i.test(cu) && size > 0 ? size : 0) : 0;
        if (price > 0 && gal !== null && gpc > 0) cost = gal / gpc * price;
        else if (price > 0 && lb !== null && /^(pound|lb)/i.test(cu) && size > 0) cost = lb / size * price;
        const area = impClean(r.craa5_area), rr = roomOf ? roomOf(r.craa5_areaaswritten, area) : { room: '', via: '' };
        return {
            day: d ? insDay(d) : null, kind: kind, barrel: /barrel/i.test(e), key: k, itemNo: impClean(r.craa5_itemnumber), known: !!item,
            name: item ? impClean(item.craa5_commonname || item.craa5__c_chemicalname || r.craa5_itemnumber) : k ? 'Item ' + impClean(r.craa5_itemnumber) + (itemsRead ? ' (not in Chemicals)' : '') : 'No item number',
            gal: gal, lb: lb, shift: impClean(r.craa5_shift), room: rr.room, roomVia: rr.via, area: area, app: impClean(r.craa5_application),
            test: ppm !== null, ppm: ppm, min: min, max: max, inr: inr, cost: cost
        };
    });
}
// the filter choices: the chemicals, rooms and shifts the rows have
function cuChoices(list) {
    const items = {}, rooms = {}, shifts = {};
    let noRoom = false, noShift = false;
    list.forEach(function (r) {
        if (!items['#' + r.key]) items['#' + r.key] = { key: r.key, label: r.name };
        if (r.room) rooms[r.room] = true; else noRoom = true;
        if (r.shift) shifts[r.shift] = true; else noShift = true;
    });
    return {
        items: Object.keys(items).map(function (k) { return items[k]; }).sort(function (a, b) { return a.label.localeCompare(b.label); }),
        rooms: Object.keys(rooms).sort().concat(noRoom ? [CU_NONE] : []),
        shifts: Object.keys(shifts).sort().concat(noShift ? [CU_NONE] : [])
    };
}
// the range's first day; the last day is today. All: the first day of the month of the first dated row.
function cuFrom(range, today, list) {
    if (range !== 'all') return insFrom(range, today, [], { counts: {} });
    let first = today;
    list.forEach(function (r) { if (r.day && r.day < first) first = r.day; });
    return first < today ? new Date(first.getFullYear(), first.getMonth(), 1) : insDay(today);
}

// Everything the view shows, worked out once per read and filter change. f: { range, item (key), room, shift (CU_NONE for
// none) }; o.readFrom: when the page could not read every row, the first whole day it read (nothing before it is drawn).
function cuBuild(list, f, today, o) {
    const pass = function (r) {
        if (f.item && r.key !== f.item) return false;
        if (f.room && (r.room || CU_NONE) !== f.room) return false;
        if (f.shift && (r.shift || CU_NONE) !== f.shift) return false;
        return true;
    };
    const rows = list.filter(pass), readFrom = o && o.readFrom ? o.readFrom : null;
    let from = cuFrom(f.range, today, list);
    if (readFrom && readFrom > from) from = readFrom;
    const to = today;
    // the first day on record (not before the first whole day read): weeks and months before it are not drawn or averaged,
    // and the week and month that hold it are partial (they start on it)
    let firstDay = null;
    list.forEach(function (r) { if (r.day && (!firstDay || r.day < firstDay)) firstDay = r.day; });
    if (readFrom && firstDay && firstDay < readFrom) firstDay = readFrom;
