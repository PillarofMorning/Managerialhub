                                        <td style={{ borderBottom: '1px solid #999', padding: '7px 6px', textAlign: 'right' }}>{ordQty(l.min)}</td>
                                        <td style={{ borderBottom: '1px solid #999', padding: '7px 6px', textAlign: 'right' }}>{l.last ? ordQty(l.last.qty) + ' (' + (ordDate(l.last.day).getMonth() + 1) + '/' + ordDate(l.last.day).getDate() + ')' : ''}</td>
                                        <td style={{ borderBottom: '1px solid #999', borderLeft: '1px solid #999', borderRight: '1px solid #999', padding: '7px 6px' }}></td>
                                        <td style={{ borderBottom: '1px solid #999', borderRight: l.reagent ? '1px solid #999' : '0', padding: '7px 6px', textAlign: 'center', color: '#999' }}>{l.reagent ? '' : '-'}</td>
                                    </tr>;
