    if (dateAsk) blockers.push('Check the count date: ' + cntDayText(day) + ' is not this Sunday. Press Use this Sunday or Keep ' + cntDayText(day) + ' at the top.');
    if (nProblems) {
        const pl = L.lines.filter(function (l) { return plan.problems[l.id]; }).map(function (l) { return l.name + ' at ' + (l.loc || 'no location'); });
        blockers.push((nProblems === 1 ? 'One line has' : nProblems + ' lines have') + ' a problem (in red): ' + pl.slice(0, 3).join(', ') + (pl.length > 3 ? ' and ' + (pl.length - 3) + ' more' : '') + '. Fix it, or clear the box to leave the line out.');
    }
    if (plan && plan.partial.length && !partialOk) blockers.push('Some items are counted at one place and not at another: type those counts, or tick Save anyway.');
    if (walk) blockers.push('Save or cancel the walk order first.');
    if (plan && plan.writes.length > CNT_MAX_WRITES) blockers.push('This is ' + plan.writes.length + ' changes, more than Dataverse takes at once (' + CNT_MAX_WRITES + '). Save one location at a time: clear the boxes of the others for now.');
    const canSave = !!plan && !busy && !loading && !blockers.length && plan.writes.length > 0;

    // a new choice of places left blank needs its own Save anyway
    useEffect(function () { setPartialOk(false); }, [partialKey]);
    // a page left open over Sunday with nothing typed moves to the new Sunday by itself
    useEffect(function () {
        if (!dayPicked && !hasTyped && cntIsDay(day) && day !== thisSun) setDay(thisSun);
    }, [thisSun, dayPicked, hasTyped]);
    // the note about counts kept on this device goes once nothing is typed
    useEffect(function () { if (kept && !hasTyped) setKept(''); }, [hasTyped]);
    // an added line whose stock row exists now (saved since, here or on another device): its typed count moves to that row's
    // box when the box is empty (otherwise it stays, named in the note about typed counts not on the list), and the add goes
    useEffect(function () {
        if (!L || !L.merged.length) return;
        const m = L.merged;
        setTyped(function (p) {
            const n = Object.assign({}, p);
            m.forEach(function (x) {
                const t = n[x.newId], r = n[x.line.id];
                const has = function (v) { return !!(v && (String(v.q || '').trim() || String(v.exp || '').trim())); };
                if (!has(t)) delete n[x.newId];
                else if (!has(r)) { n[x.line.id] = t; delete n[x.newId]; }
            });
            return n;
        });
        setAdds(function (a) { return a.filter(function (x) { return !m.some(function (y) { return y.add === x; }); }); });
    }, [L]);
    // after a Save with no answer (or counts kept on this device), once the tables are read in full: when every count typed is
    // saved as it is, the earlier try was saved, so the typed counts are cleared and the page says so
    useEffect(function () {
        if (!landCheck || loading || !plan || !L || L.merged.length || unread.length) return;
        const why0 = landCheck;
        setLandCheck('');
        if (plan.writes.length || plan.filled === 0 || Object.keys(plan.problems).length || plan.dayProblem) return;
        const lineIds = {};
        L.lines.forEach(function (l) { lineIds[l.id] = true; });
        setTyped(function (p) { const n = Object.assign({}, p); Object.keys(n).forEach(function (k) { if (lineIds[k]) delete n[k]; }); return n; });
        setKept(''); setErr('');
        setMsg(why0 === 'kept' ? 'The counts kept on this device for ' + cntDayText(day) + ' are saved already, so they were cleared.' : 'The earlier try was saved after all: every count typed for ' + cntDayText(day) + ' is saved as it is.');
    }, [landCheck, loading, plan, L]);

    const touch = function () { atRef.current = new Date().toISOString(); };
    const setLine = function (l, patch) { setTyped(function (p) { const n = Object.assign({}, p); n[l.id] = Object.assign({}, p[l.id] || {}, patch, { name: l.name, loc: l.loc }); return n; }); touch(); setMsg(''); };
    const say = function (text) { setMsg(text); };
    const url = function (tbl, id) { return base + CH_API + tbl.meta.set + (id ? '(' + String(id).replace(/[^0-9a-fA-F-]/g, '') + ')' : ''); };
    // One change set (a single write goes on its own); the tables are read again after every try. As on the Ordering tab, a new
    // row gets an id worked out from what it is and an update carries the row version read, so the same Save sent twice, or a
    // row changed elsewhere since the read, is refused whole (412) instead of saving twice or overwriting.
    const send = function (steps) {
        const one = steps[0], hd = one.create ? { 'If-None-Match': '*' } : one.etag ? { 'If-Match': one.etag } : null;
        return steps.length === 1 ? chSend(fetcher, one.method, one.url, one.data, hd).then(function (r) { return { ok: chOk(r), status: r.status, step: 1, code: r.code, message: r.message }; }) : chBatch(fetcher, base, steps);
    };
    const why = function (r, steps) {
        const s = r.step ? steps[r.step - 1] : null, m = String(r.message || '').replace(/\.$/, '');
        const vers = /0x80060882/i.test(r.code || '') || /RowVersion/i.test(m);
        const gone = r.status === 404 && (s ? !!s.etag : steps.some(function (x) { return !!x.etag; }));
        const stale = (r.status === 412 && (vers || (s ? !!s.create : steps.some(function (x) { return x.create; })))) || gone;
        if (!r.status) return (/^Dataverse did not answer/.test(m) ? m : 'Dataverse did not answer (' + m + ')') + ', so the changes may or may not have been saved. The tables were read again and your typed counts are still here: check the Last count column, then press Save again (a count already saved is updated, never saved twice).';
        if (stale) return 'Nothing was saved: a row changed in Dataverse after this page read it (a receipt on the Ordering tab, or another device), or an earlier try that got no answer was saved after all. The tables were read again and your typed counts are still here: check them, then press Save again. Dataverse said: ' + r.message;
        return 'Nothing was saved. Dataverse refused ' + (s && s.what ? s.what.charAt(0).toLowerCase() + s.what.slice(1) : 'the change') + ': ' + r.message;
    };
    const save = function () {
        if (!canSave) return;
        const now = new Date().toISOString();
        const P = cntPlan(L.lines, ix, T.line.rows, typed, { day: day, by: String(by || '').trim().slice(0, 100), now: now, today: today, taken: taken });
        if (P.dayProblem || Object.keys(P.problems).length || !P.writes.length) return;
        const steps = P.writes.map(function (w) {
            const tbl = w.table === 'count' ? T.count : T.stock;
            return { method: 'PATCH', create: !!w.create, etag: w.create ? '' : (w.row._etag || ''), url: url(tbl, w.create ? w.id : w.row._id), what: w.what, data: ordPayload(tbl, w.fields) };
        });
        const done = L.lines.filter(function (l) { const t = typed[l.id]; return t && !cntParse(t.q).blank; }).map(function (l) { return l.id; });
        // what was sent: a box changed or an item added while saving is kept (only what was saved is cleared)
        const sent = {}, sentAdds = adds.slice();
        done.forEach(function (id) { sent[id] = typed[id]; });
        setBusy(true); setErr(''); setMsg('');
        send(steps).then(function (r) {
            const text = r.ok ? '' : why(r, steps);
            return load().then(function () {
                setBusy(false);
                if (!r.ok) { setErr(text); if (!r.status) setLandCheck('try'); return; }
                setTyped(function (p) { const n = Object.assign({}, p); done.forEach(function (id) { if (n[id] === sent[id]) delete n[id]; }); return n; });
                setAdds(function (a) { return a.filter(function (x) { return sentAdds.indexOf(x) < 0; }); }); setKept('');
                say('Saved for ' + cntDayText(day) + ': ' + [P.newCounts ? P.newCounts + ' new count' + (P.newCounts === 1 ? '' : 's') : '', P.updCounts ? P.updCounts + ' count' + (P.updCounts === 1 ? '' : 's') + ' changed' : '',
                    P.stockN ? 'stock on hand set on ' + P.stockN + ' row' + (P.stockN === 1 ? '' : 's') + (P.newStock ? ' (' + P.newStock + ' new)' : '') : ''].filter(Boolean).join(', ') +
                    '. Press Refresh on the Ordering tab to see the new stock.');
            });
        });
    };
    const startWalk = function () {
        const o = {};
        L.groups.forEach(function (g) { o[g.loc] = g.lines.filter(function (l) { return !!l.row; }).map(function (l) { return l.id; }); });
        setWalk(o); setWalkAsk(null); setMsg(''); setErr('');
    };
    const move = function (loc, id, dir) {
        setWalkAsk(null);
        setWalk(function (w) {
            const list = (w[loc] || []).slice(), i = list.indexOf(id), j = i + dir;
            if (i < 0 || j < 0 || j >= list.length) return w;
            list[i] = list[j]; list[j] = id;
            const n = Object.assign({}, w); n[loc] = list; return n;
        });
    };
    const saveWalk = function (sure) {
        if (busy || loading || !walk) return;
        if (unread.length) { setErr('The walk order cannot be saved until these tables are read: ' + unread.join(', ') + '. Press Refresh.'); return; }
        const order = [];
        L.groups.forEach(function (g) { (walk[g.loc] || []).forEach(function (id) { order.push(id); }); });
        const changes = cntOrderPlan(L.lines, order);
        if (!changes.length) { setWalk(null); setWalkAsk(null); say('The walk order is unchanged.'); return; }
        // the numbers run location by location, so an item's first row (the one Receive adds to) becomes its row at the first
        // location listed: say so before it changes
        if (sure !== true) {
            const byId = {}, firstAt = {}, moved = [];
            L.lines.forEach(function (l) { byId[l.id] = l; });
            order.forEach(function (id) { const l = byId[id]; if (l && l.row && !firstAt[l.key]) firstAt[l.key] = l; });
            Object.keys(firstAt).forEach(function (k) {
                const st = ix.stock[k], l = firstAt[k];
                if (st && st.rows.length > 1 && String(st.rows[0]._id) !== l.id) moved.push(l.name + ' to ' + (l.loc || 'no location') + ' (now ' + (impClean(st.rows[0].craa5_location) || 'no location') + ')');
            });
            if (moved.length) { setWalkAsk(moved); return; }
        }
        setWalkAsk(null);
        const steps = changes.map(function (c) { return { method: 'PATCH', etag: c.line.row._etag || '', url: url(T.stock, c.line.row._id), what: 'The place of ' + c.line.name + ' at ' + c.line.loc, data: ordPayload(T.stock, { craa5_displayorder: c.order }) }; });
        setBusy(true); setErr(''); setMsg('');
        send(steps).then(function (r) {
            const text = r.ok ? '' : why(r, steps);
            return load().then(function () {
                setBusy(false);
                if (!r.ok) { setErr(text); return; }
                setWalk(null);
                say('Walk order saved (' + changes.length + ' row' + (changes.length === 1 ? '' : 's') + ' renumbered).');
            });
        });
    };
    const addLine = function () {
        setAddMsg('');
        const it = ix ? ix.items[ordKey(add.item)] : null, mp = cntParse(add.min), loc = add.loc;
        if (!it) { setAddMsg('Pick an item from the list.'); return; }
