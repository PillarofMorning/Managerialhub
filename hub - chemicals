                {openCarts.map(function (c) { return <OpenCart key={c._id} cart={c} ix={ix} busy={busy || loading} offReceive={offReceive} offClose={offClose} copied={copied} onCopy={function (cc, ls) { copyText(cc._id, ordSapTextSaved(ix, cc, ls)); }} onPatch={patchCart} onReceive={receive} onClose={closeCart} />; })}
                {!openCarts.length && <p className="text-sm text-slate-600">No open carts.</p>}
            </div>}
            {ready && view === 'requests' && <div className="mt-6 space-y-3">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Requests</h2>
                <div className="rounded-xl border border-slate-200 bg-white shadow-sm px-4 py-3 flex flex-wrap items-end gap-2">
                    <label className="text-xs font-bold text-slate-600 grow min-w-[220px]">Item<input list="ord-items" value={req.item} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { item: v.split(' - ')[0] }); }); }} placeholder="Item number or name" data-ord-req-item className={inputCls + ' block w-full mt-1'} /></label>
                    <datalist id="ord-items">{ix.itemList.map(function (it) { return <option key={it._id} value={it.craa5_itemnumber + ' - ' + (it.craa5_commonname || it.craa5__c_chemicalname || '')} />; })}</datalist>
                    <label className="text-xs font-bold text-slate-600">Quantity<input type="number" min="1" step="1" value={req.qty} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { qty: v }); }); }} data-ord-req-qty className={inputCls + ' block w-24 mt-1'} /></label>
                    <label className="text-xs font-bold text-slate-600 grow min-w-[180px]">Reason<input value={req.reason} maxLength={200} onChange={function (e) { const v = e.target.value; setReq(function (p) { return Object.assign({}, p, { reason: v }); }); }} className={inputCls + ' block w-full mt-1'} /></label>
                    <button type="button" data-ord-req-add className={btnBlue + (busy || loading || offReq ? ' opacity-50 cursor-not-allowed' : '')} aria-disabled={!!(busy || loading || offReq)}
                        title={offReq ? offReq + ' could not be read: press Refresh' : undefined} onClick={function () { if (!busy && !loading && !offReq) addRequest(); }}>Add request</button>
                </div>
                {ix.requests.map(function (r) {
                    const it = ix.items[ordKey(r.craa5_itemnumber)];
                    return <div key={r._id} className="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm"><span className="font-semibold">{it ? (it.craa5_commonname || it.craa5__c_chemicalname) : r.craa5__c_cartlinename}</span> <span className="font-mono text-xs text-slate-500">{r.craa5_itemnumber}</span>
                        <span className="block text-slate-600">{ordQty(r.craa5_quantity)} requested{r.craa5_requestedby ? ' by ' + r.craa5_requestedby : ''}{r.craa5_reason ? ': ' + r.craa5_reason : ''}</span></div>;
                })}
                {!ix.requests.length && <p className="text-sm text-slate-600">No requests waiting.</p>}
            </div>}
            {ready && view === 'alerts' && <div className="mt-6 space-y-2">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Alerts</h2>
                {alerts.map(function (a, i) {
                    const cls = a.level === 'red' ? 'border-[#E4002B]/40 bg-[#FDE8EC] text-[#B80022]' : a.level === 'blue' ? 'border-[#B3D4F2] bg-[#E6F1FB] text-[#00468B]' : 'border-[#FFB81C] bg-[#FFF6E0] text-[#7A4B00]';
                    return <p key={i} className={'rounded-lg border px-3 py-2 text-sm ' + cls}>{a.text}</p>;
                })}
                {!alerts.length && <p className="text-sm text-slate-600">No alerts.</p>}
            </div>}
        </div>
    );
}

// ============================================================================
// IMPORT: paste from Excel (a Week sheet, a Chemical log day sheet, the cart Log sheet, the INDEX sheet, or any table with
// headings)
// ============================================================================
// Replaces the maker portal's Excel import. Each pasted row is matched to what is already in Dataverse by a key (item
// number, vendor number, SAP cart number or cart name, item + location + count date, sheet day + row ...), so pasting the
// same thing twice adds nothing. Nothing is written until Import is pressed. On update: a blank cell never clears a value,
// the name column of an existing row is left alone, a cart status never moves back, and quantity received never goes down.
// A day sheet row is the exception: it mirrors the sheet, so a cell blanked in Excel clears the field and the name follows.
const IMP_LOCATION = 'Chemical room';
const IMP_PARALLEL = 4;
const IMP_RETRIES = 3;
const IMP_PREVIEW_ROWS = 60;
// tables only the Import tab reads (not in ORD_T: the Ordering tab reads every table there)
const IMP_T = { alias: 'craa5__c_chemicalalias', area: 'craa5__c_areaalias', target: 'craa5__c_titrationtarget', usage: 'craa5__c_chemicalusagelog' };
// a sheet longer than this goes into the paste box at once: typing it in (so Ctrl+Z can take it back) takes the browser
// longer for every line, about a second at 1,000 lines and many seconds beyond
const IMP_UNDO_LINES = 600;
const IMP_BLANKS = ['', '-', '--', 'tbd', 'n/a', 'na', 'none', 'null', '?', 'x?'];
const IMP_STATUS_LETTER = { O: 'Submitted', A: 'Approved', R: 'Received' };
const IMP_MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
// Old workbook codes (INDEX TYPE2 / USE columns, Log CAT column) and the hub choice they mean.
const IMP_SUB = { DETERG: 'Detergent', 'DET/SAN': 'Detergent / sanitizer', SANIT: 'Sanitizer', SUPPLY: 'Supply', EQUIP: 'Equipment', SAFETY: 'Safety' };
const IMP_USE = { FLOOR: 'Floor', GMP: 'GMP', SPEC: 'Special', DRAIN: 'Drain', EQUIP: 'Equipment', CIP: 'CIP', OVEN: 'Oven', DRY: 'Dry', CLEAN: 'Clean', PPE: 'PPE', TEST: 'Test' };
const IMP_CAT_USE = { PPE: 'PPE / Safety', TEST: 'Test reagent', EQUIP: 'Equipment' };
const IMP_CAT_TYPE2 = { SAFETY: 'PPE / Safety', EQUIP: 'Equipment', SUPPLY: 'Supply', DETERG: 'Chemical', 'DET/SAN': 'Chemical', SANIT: 'Chemical' };
// Extra headings understood when pasting a table, besides each column's label and logical name.
const IMP_ALIASES = {
    craa5__c_distributor: { craa5_vendornumber: ['supplier', 'vendor', 'vendor #', 'supplier number'], craa5__c_distributorname: ['name', 'supplier name', 'distributor'] },
    craa5__c_chemical: { craa5_itemnumber: ['item', 'item #', 'sap item', 'sap #'], craa5__c_chemicalname: ['name', 'description'], craa5_vendornumber: ['supplier', 'vendor'], craa5_priceperunit: ['cost', 'price', '$'],
        craa5_glaccount: ['gen led acc', 'gl'], craa5_purchasinggroup: ['pruchasing group'], craa5_plant: ['location / plant:', 'location / plant'], craa5_containersize: ['amt #/gal', 'amt'] },
    craa5__c_chemicalinventory: { craa5_itemnumber: ['item'], craa5_quantityonhand: ['on hand', 'current balance', 'current'], craa5_minimumthreshold: ['minimum', 'min', 'mininmum'] },
    craa5__c_cart: { craa5_sapcartnumber: ['cart', 'sap cart', 'cart #'], craa5__c_cartname: ['noc', 'cart name', 'name'], craa5_cartstatus: ['o/a/r', 'status'], craa5_submittedon: ['dos'], craa5_approvedon: ['doa'], craa5_receivedon: ['rcvd'] },
    craa5__c_cartline: { craa5_itemnumber: ['item'], craa5_quantity: ['qty'], craa5_unitprice: ['$', 'price'], craa5_linetotal: ['tot', 'total'] },
    craa5__c_chemicalcount: { craa5_itemnumber: ['item'], craa5_quantity: ['current balance', 'count', 'qty'] }
};

// ---------------------------------------------------------------- reading the paste
// Excel copies cells as tab-separated text; a cell holding a tab or line break is wrapped in quotes (its quotes doubled).
// A cell that merely starts with a quote ("FC" foamer, a ditto mark) is not wrapped, so a leading quote opens a quoted cell
// only when its closing quote ends the cell, the cell holds a line break or a doubled quote, and no tab comes before the
// closing quote (a tab there means the quotes belong to two different cells).
function impParseTsv(text) {
    const s = String(text || '').replace(/\r\n?/g, '\n');
    const rows = [];
    let row = [], cell = '', i = 0, quoted = false, atStart = true;
    const wrapped = function (from) {
        let k = from + 1, special = false;
        while (k < s.length) {
            const c = s.charAt(k);
            if (c === '"') { if (s.charAt(k + 1) === '"') { special = true; k += 2; continue; } break; }
            if (c === '\t') return false;
            if (c === '\n') special = true;
            k++;
        }
