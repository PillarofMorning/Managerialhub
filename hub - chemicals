                        </ul>
                    </details>
                </div>
            </div>
            {ready && view === 'suggested' && <div className="mt-6 space-y-3">
                <h2 className="text-sm font-black uppercase tracking-widest text-[#00468B]">Suggested carts</h2>
                {kept && (kept.saved.length > 0 || data.loadedAt !== kept.readAt) && <p data-ord-kept className="text-sm text-slate-600">{(kept.saved.length ? 'Saved since these carts were worked out on ' + ordDay(kept.at) + ' at ' + chTime(kept.at) + ': ' + kept.saved.join(', ') + '. The rest stay as they were' : 'These carts stay as they were worked out on ' + ordDay(kept.at) + ' at ' + chTime(kept.at) + ', when one was copied for SAP') + ', so they match what you copied for SAP. ' + (saveFirst || 'Press Refresh to work them out again with everything saved since.')}</p>}
                {carts.map(function (c) { return <SuggestedCart key={c.key} cart={c} qtyOf={qtyOf} setQty={setLineQty} busy={busy || loading} off={offSave} copied={copied} onCopy={function (cc) {
                    copyText(cc.key, ordSapText(cc, qtyOf));
                    if (!kept) setKept({ carts: carts, saved: [], at: stampAt || data.loadedAt, readAt: data.loadedAt, sugs: sugMap(), base: data, used: {}, copied: [cc.title] });
