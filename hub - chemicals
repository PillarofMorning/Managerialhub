    }, [aliasRows]);
    const targetRows = useMemo(function () {
        if (!G || !G.rows) return [];
        return G.rows.slice().sort(function (a, b) { return String(a.craa5__c_titrationtargetname || '').toLowerCase().localeCompare(String(b.craa5__c_titrationtargetname || '').toLowerCase()); });
    }, [G]);
    const itemLabel = function (r) { return (r.craa5_commonname || r.craa5__c_chemicalname || r.craa5_itemnumber) + ' (' + r.craa5_itemnumber + ')'; };
    // columns a table does not have yet, as the note under its heading lists them (Room has its own note)
    const missingNote = function (list, off) {
        const cols = LST_FIELDS[list].filter(function (c) { return off[c] && c !== 'craa5_room'; }).map(function (c) { const sc = chSpecCol(LST_T[list], c); return sc.label + ' (' + sc.type + (sc.maxLength ? ', ' + sc.maxLength + ' characters' : '') + ')'; });
