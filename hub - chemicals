}

// ============================================================================
// LISTS: the hub's own lists, edited in place (area names of the old chemical log, titration targets)
// ============================================================================
// The area mapping is a starting point that is never finished: any spelling can be given an area, a spot and a room later,
// and a spelling whose area the old log never recorded (Creme Side: which line?) still gets its room. Titration targets live
// in Dataverse, not in this code, so they are changed here when the kit or the supplier changes them.
// Saving works like the Ordering tab: one change set (all or nothing), each new row on an id fixed when Add is pressed (so a
// try that got no answer never saves twice), and changes only to rows as they were read (If-Match), so a change made on
// another device in the meantime is refused and read again instead of overwritten. Before a new row or a changed spelling
// is saved, its list is read again, so a row added on another device (or by the Import tab) since is not added twice.
const LST_T = { alias: 'craa5__c_areaalias', target: 'craa5__c_titrationtarget', item: 'craa5__c_chemical', area: 'craa5_aa_mss_area' };
const LST_ROOMS = ['General', 'Bakery', 'Creme', 'Support', 'Warehouse'];
const LST_FIELDS = {
    alias: ['craa5__c_areaaliasname', 'craa5_area', 'craa5_spot', 'craa5_room', 'craa5_entrytypehint'],
    target: ['craa5_itemnumber', 'craa5_application', 'craa5_minppm', 'craa5_maxppm', 'craa5_ppmperdrop', 'craa5_testmethod', 'craa5_active', 'craa5_notes']
};
const LST_NUM = ['craa5_minppm', 'craa5_maxppm', 'craa5_ppmperdrop'];
const LST_CHOICE = ['craa5_entrytypehint', 'craa5_application'];
const LST_APP_SHORT = { 'FC foamer (food contact)': 'FC', 'NFC (non-food contact)': 'NFC' };
// A row's value as the boxes show it: text for text, numbers and choices (by label), true / false for Yes/No. Notes keep their
// line breaks (as a text area gives them, LF only).
function lstShow(k, v) {
    if (k === 'craa5_active') return v === true || v === false ? v : true;
    if (v === null || v === undefined) return '';
    return k === 'craa5_notes' ? String(v).replace(/\r\n?/g, '\n') : String(v);
}
// What a box's value saves as: cleaned text (null when blank), a number (to the column's decimal places when they were read,
// so Dataverse keeps it as sent), a choice's value in Dataverse's own option set (as the Import tab writes it; tbl: the
// table as read), true / false.
function lstOut(list, k, v, tbl) {
    if (k === 'craa5_active') return v !== false;
    if (LST_NUM.indexOf(k) > -1) {
        const n = impNumber(v).value, pr = tbl && tbl.precision && tbl.cols ? tbl.precision[tbl.cols[k]] : undefined;
        if (typeof n !== 'number' || typeof pr !== 'number' || pr < 0 || pr > 10) return typeof n === 'number' ? n : null;
        // rounded on the decimal digits as typed (2.555 to 2.56, where 2.555 * 100 would give 255.49999...)
        const r = Number(Math.round(Number(n + 'e' + pr)) + 'e-' + pr);
        return isFinite(r) ? r : Math.round(n * Math.pow(10, pr)) / Math.pow(10, pr);
    }
    if (LST_CHOICE.indexOf(k) > -1) {
        const c = impClean(v), sc = chSpecCol(LST_T[list], k);
        if (!c) return null;
        return tbl && tbl.cols && tbl.options && sc ? impOptionValue(tbl, sc, c) : ordChoiceValue(LST_T[list], k, c);
    }
    const c = k === 'craa5_notes' || k === 'craa5_testmethod' ? lstShow(k, v).trim() : impClean(v);
    // a room typed in other capitals is saved as the room's own name, so "bakery" and "Bakery" report as one room
    if (k === 'craa5_room' && c) { const r = LST_ROOMS.filter(function (x) { return x.toLowerCase() === c.toLowerCase(); })[0]; if (r) return r; }
    return c ? c : null;
}
// A row's value as Dataverse holds it (a choice by its value), to set what a box saves as against.
function lstHeld(k, row) {
    if (k === 'craa5_active') return row[k] !== false;
    if (LST_CHOICE.indexOf(k) > -1) { const raw = row._raw ? row._raw[k] : undefined; return raw === undefined || raw === null ? null : raw; }
    const v = row[k];
    if (v === undefined || v === null || v === '') return null;
    return k === 'craa5_notes' ? lstShow(k, v) : v;
}
// A box's value already in Dataverse: what it saves as is what the row holds, so a fix of capitals, accents or spaces is a
// change (numbers are rounded to the column's decimal places by lstOut, so they compare as Dataverse keeps them).
function lstIn(list, k, v, row, tbl) {
    const x = lstOut(list, k, v, tbl), y = lstHeld(k, row);
    if (typeof x === 'number' && typeof y === 'number') return Math.abs(x - y) <= 0.000000001;
    return x === y;
}
// The key a row is known by: its spelling (as the Import tab matches it), or its chemical and application.
function lstKey(list, f) {
    return list === 'alias' ? ordKey(impClean(f.craa5__c_areaaliasname)) : ordKey(impClean(f.craa5_itemnumber)) + '|' + ordKey(impClean(f.craa5_application));
}
function lstTargetName(item, f) {
    const app = impClean(f.craa5_application);
    const name = item ? impClean(item.craa5_commonname || item.craa5__c_chemicalname) : impClean(f.craa5_itemnumber);
    return ((name || impClean(f.craa5_itemnumber)) + ' - ' + (LST_APP_SHORT[app] || app)).slice(0, 200);
}
function lstRowName(list, r) {
    return list === 'alias' ? impClean(r.craa5__c_areaaliasname) : impClean(r.craa5__c_titrationtargetname) || lstTargetName(null, r);
}
// A list table with Dataverse's own choices (as the Import tab reads them) and its decimal places, so a number Dataverse
// rounded on saving still counts as saved.
function lstLoadTable(fetcher, base, logical) {
    return impLoadTable(fetcher, base, logical).then(function (tbl) {
        tbl.precision = {};
        if (!tbl.meta || !Object.keys(tbl.cols).some(function (k) { return LST_NUM.indexOf(k) > -1; })) return tbl;
        return chRequest(fetcher, chDefUrl(base, logical) + '/Attributes/Microsoft.Dynamics.CRM.DecimalAttributeMetadata?$select=LogicalName,Precision').then(function (r) {
            if (chOk(r) && r.body && Array.isArray(r.body.value)) r.body.value.forEach(function (a) { if (a && a.LogicalName && typeof a.Precision === 'number') tbl.precision[a.LogicalName] = a.Precision; });
            return tbl;
        });
    });
}
function lstLoadAll(fetcher, base) {
    const keys = Object.keys(LST_T);
    return chPool(keys, CH_PARALLEL, function (k) { return k === 'alias' || k === 'target' ? lstLoadTable(fetcher, base, LST_T[k]) : ordLoadTable(fetcher, base, LST_T[k]); }).then(function (list) {
        const d = { tables: {}, loadedAt: new Date() };
        keys.forEach(function (k, i) { d.tables[k] = list[i] && list[i].logical ? list[i] : { logical: LST_T[k], label: LST_T[k], rows: [], have: {}, cols: {}, options: {}, precision: {}, error: (list[i] && list[i].error) || 'Not read.' }; });
        return d;
    });
}

// What was typed, set against the tables as read now. A change that is in Dataverse already goes (saved), and so does a
// change to a row that changed or went in Dataverse after it was typed (noted: it was typed against values that are not
// there any more); the rest stays. A new row goes once a row with its id is there: saved when that row holds what the new
// row says, else noted (an earlier try that got no answer was saved, and what was typed after it was not). done: ids a save
// was answered for, so they go as saved even when the row changed again since. A table that could not be read keeps all.
function lstReconcile(d, edits, adds, done) {
    const byId = {}, out = { edits: {}, adds: [], notes: {}, saved: {}, gone: [], changed: [], late: [] };
    ['alias', 'target'].forEach(function (l) { (d.tables[l].rows || []).forEach(function (r) { byId[r._id] = { list: l, row: r }; }); });
    Object.keys(edits).forEach(function (rid) {
        const e = edits[rid], now = byId[rid], tbl = d.tables[e.list];
        if (done && done[rid]) { out.saved[rid] = true; return; }
        if (tbl.error) { out.edits[rid] = e; return; }
        if (!now) { out.notes[rid] = 'gone'; out.gone.push(e.name); return; }
        if (Object.keys(e.f).every(function (k) { return lstIn(e.list, k, e.f[k], now.row, tbl); })) { out.saved[rid] = true; return; }
        if (now.row._etag !== e.etag) { out.notes[rid] = 'changed'; out.changed.push(e.name); return; }
        out.edits[rid] = e;
    });
    adds.forEach(function (a) {
        const tbl = d.tables[a.list], now = byId[a.nid];
