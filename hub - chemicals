                                : <button type="button" data-log-next ref={nextRef} className={btnWhite} onClick={function () { retestOrNext(false); }}>Next reading</button>}
                        </div>}
                        {review && review !== primaryWhy && <p data-log-review className="mt-2 text-sm font-semibold text-slate-800" style={clamp2}>{review}</p>}
                        <div className="mt-2 flex gap-2">
                            {showSame && <button type="button" data-log-same ref={sameRef} aria-disabled={!sameOn} className={btnWhite + ' min-h-[56px] flex-1' + (sameOn ? '' : offCls)} onClick={function (ev) { if (sameOn) pressSame(ev); }}>Same again</button>}
                            {fix && <button type="button" data-log-cancel-fix className={btnWhite + ' min-h-[56px]'} onClick={function () { endFix(); focusNext.current = 'primary'; }}>Cancel fix</button>}
                            <button type="button" data-log-primary ref={primaryRef} aria-disabled={!!primaryWhy} aria-describedby={primaryWhy ? 'log-why' : undefined} className={btnBlue + ' min-h-[56px] flex-1 text-base' + (primaryWhy ? offCls : '')} onClick={pressPrimary}>{busy ? 'Saving...' : label}</button>
                        </div>
                        {primaryWhy && <p id="log-why" data-log-why className="mt-1 text-xs font-semibold text-[#7A4B00]">{primaryWhy}</p>}
                    </div>
                </div>
                <section data-log-today aria-labelledby="log-today-h" className="mt-6 min-w-0 lg:mt-0">
                    <h2 id="log-today-h" className="text-sm font-black uppercase tracking-widest text-[#00468B]">Today</h2>
                    {listRows.ahead.length > 0 && <ul className="mt-2 space-y-2">{listRows.ahead.map(function (x, i) { return card(x, aheadCu[i], 'ahead'); })}</ul>}
                    <ul className="mt-2 space-y-2">{listRows.today.map(function (x, i) { return card(x, todayCu[i], 'today'); })}</ul>
                    {!todayN && <p className="mt-2 text-sm text-slate-600">{U ? 'Nothing logged today yet.' : 'Not read yet.'}</p>}
                    {todayN > 0 && <p data-log-footer className="mt-2 text-sm font-semibold text-slate-700">{'Today: ' + todayN + ' entr' + (todayN === 1 ? 'y' : 'ies') + ', ' + cuGal(todayGal) + (todayLb ? ', and ' + chNumber(String(ordRound(todayLb, 2))) + ' lb' : '')}</p>}
                    <details data-log-yesterday open={yOpen} onToggle={function (e) { const o = e.currentTarget.open; if (o !== yOpen) setYOpen(o); }} className="mt-3 rounded-lg border border-slate-200 bg-white px-3">
                        <summary className="min-h-[44px] flex items-center cursor-pointer text-sm font-extrabold text-[#0072CE]">{'Yesterday (' + listRows.yesterday.length + ')'}</summary>
                        <ul className="pb-3 space-y-2">{listRows.yesterday.map(function (x, i) { return card(x, yCu[i], 'yesterday'); })}</ul>
                        {!listRows.yesterday.length && <p className="pb-3 text-sm text-slate-600">Nothing logged yesterday.</p>}
                    </details>
                </section>
            </div>
        </div>
    );
}

const CH_TABS = [{ key: 'ordering', label: 'Ordering' }, { key: 'count', label: 'Count' }, { key: 'log', label: 'Log' }, { key: 'insight', label: 'Insight' }, { key: 'import', label: 'Import' }, { key: 'lists', label: 'Lists' }, { key: 'tables', label: 'Tables' }];
// Who is using the page: the admin sees every tab; the chemical clerk sees the chemical side (the Log tab first, Insight on
// Chemical use, the Import tab for day sheets, the Lists tab). It only tidies the screen: Dataverse security roles decide who can save.
const CH_VIEWS = [{ key: 'admin', label: 'Admin', tabs: null }, { key: 'clerk', label: 'Chemical clerk', tabs: ['log', 'insight', 'import', 'lists'] }];
const CH_VIEW_KEY = 'hubChemicals.view.1';
// the scroller fills the visible height (dvh: without a phone browser's toolbars, where the browser knows it)
const CH_SCROLL_CSS = '.ch-scroll{height:100vh;height:100dvh}';
function chView(key) { return CH_VIEWS.filter(function (v) { return v.key === key; })[0] || CH_VIEWS[0]; }
function chViewRead() {
    try { const v = window.localStorage ? window.localStorage.getItem(CH_VIEW_KEY) : null; return chView(v).key; } catch (e) { return CH_VIEWS[0].key; }
}
function chViewTabs(key) { const v = chView(key); return CH_TABS.filter(function (t) { return !v.tabs || v.tabs.indexOf(t.key) > -1; }); }

// The copy box: text a copy could not put on the clipboard, shown on the page and selected to copy by hand. A copy made in
// it puts the whole text on the clipboard, so a click that drops the selection, or a phone's touch and hold that picks one
// word, still copies all of it; where a browser does not allow that, the box says when only part was copied. Esc or Close ends it and the focus goes back to the button that copied. While it shows, keys are watched
// on the whole page, so Esc and the Tab loop still work after a press on its text or on the dimmed page around it.
function ChCopyBox(props) {
    const taRef = useRef(null), boxRef = useRef(null), closeRef = useRef(props.onClose);
    closeRef.current = props.onClose;
    const [did, setDid] = useState('');
    const pick = function () { const ta = taRef.current; if (!ta) return; try { ta.focus(); ta.select(); ta.setSelectionRange(0, ta.value.length); } catch (e) { /* old browser */ } };
    useEffect(function () { setDid(''); pick(); }, [props.text, props.at]);
    useEffect(function () {
        const keys = function (e) {
            if (e.key === 'Escape' || e.key === 'Esc') { e.preventDefault(); closeRef.current(); return; }
            if (e.key !== 'Tab' || !boxRef.current) return;
            const f = boxRef.current.querySelectorAll('textarea, button');
            if (!f.length) return;
            const first = f[0], last = f[f.length - 1], a = document.activeElement;
            if (Array.prototype.indexOf.call(f, a) < 0) { e.preventDefault(); (e.shiftKey ? last : first).focus(); }
            else if (e.shiftKey && a === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && a === last) { e.preventDefault(); first.focus(); }
        };
        document.addEventListener('keydown', keys, true);
        return function () { document.removeEventListener('keydown', keys, true); };
    }, []);
    // a press on the box's own text or on the dimmed page keeps the focus, and the selection, where they were
    const hold = function (e) { const t = e.target; if (!(t && t.closest && t.closest('textarea, button'))) e.preventDefault(); };
    // the whole text selected: the browser's own copy runs (it gives Windows the line ends Windows programs expect); only part
    // selected: the copy event carries the whole text instead, with Windows line ends on Windows
    const copied = function (e) {
        const ta = taRef.current;
        if (ta && ta.selectionStart === 0 && ta.selectionEnd === ta.value.length) { setDid('all'); return; }
        let all = false;
        try {
            if (e.clipboardData && e.clipboardData.setData) {
                let t = String(props.text).replace(/\r\n?/g, '\n');
                if (/^Win/.test(navigator.platform || '') || /Windows/.test(navigator.userAgent || '')) t = t.replace(/\n/g, '\r\n');
                e.clipboardData.setData('text/plain', t); e.preventDefault(); all = true;
            }
        } catch (x) { all = false; }
        setDid(all ? 'all' : 'part');
    };
    return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4" data-ch-copybox onMouseDown={hold}>
            <div ref={boxRef} role="dialog" aria-modal="true" aria-labelledby="ch-copybox-title" aria-describedby="ch-copybox-note" className="w-full max-w-2xl max-h-full overflow-y-auto rounded-xl border border-slate-200 bg-white p-4 shadow-xl">
                <h2 id="ch-copybox-title" className="text-base font-black text-[#00468B]">Copy this text</h2>
                <p id="ch-copybox-note" className="mt-1 text-sm text-slate-700">This app does not let the page copy for you, so the text is selected below. Press Ctrl+C (Cmd+C on a Mac; on a phone, touch and hold the text, then tap Select all and Copy), then Close.</p>
                <textarea ref={taRef} readOnly value={props.text} rows={10} data-ch-copybox-text aria-label="Text to copy" onCopy={copied}
                    className="mt-3 block w-full rounded-lg border border-slate-300 p-2 font-mono text-xs focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40" />
                <p role="status" className="mt-2 min-h-[1.25rem] text-sm font-semibold text-[#00468B]" data-ch-copybox-did>{did === 'all' ? 'Copied. Close this when you are done.' : did === 'part' ? 'Only part of the text was copied. Press Select all, then copy again.' : ''}</p>
                <div className="mt-2 flex flex-wrap gap-2">
                    <button type="button" className={btnWhite} data-ch-copybox-select onClick={pick}>Select all</button>
                    <button type="button" className={btnBlue} data-ch-copybox-close onClick={props.onClose}>Close</button>
                </div>
            </div>
        </div>
    );
}

export default function ChemicalHub(props) {
    const p = props || {};
    // the copy box (see chCopy): one for the page, so every tab's copy buttons use it
    const [manual, setManual] = useState(null);
    useEffect(function () {
        let n = 0;
        const show = function (text) { let from = null; try { from = document.activeElement; } catch (e) { /* none */ } n += 1; setManual({ text: text, from: from, at: n }); };
        chManualCopy = show;
        return function () { if (chManualCopy === show) chManualCopy = null; };
    }, []);
    const closeManual = function () {
        const m = manual;
        setManual(null);
        if (m && m.from && m.from.focus && document.body.contains(m.from)) { try { m.from.focus(); } catch (e) { /* gone */ } }
    };
    const [view, setView] = useState(chViewRead);
    const [tab, setTab] = useState(function () { return chViewTabs(view)[0].key; });
    // tabs opened so far: the Lists tab reads its tables only once it is first opened, then stays mounted like the others
    const [opened, setOpened] = useState(function () { const o = { ordering: true }; o[chViewTabs(view)[0].key] = true; return o; });
    const open = function (key) { setTab(key); setOpened(function (o) { if (o[key]) return o; const n = Object.assign({}, o); n[key] = true; return n; }); };
    const tabs = chViewTabs(view);
    const pickView = function (key) {
        const v = chView(key).key;
        setView(v);
        try { if (window.localStorage) window.localStorage.setItem(CH_VIEW_KEY, v); } catch (e) { /* not kept on this device */ }
        const keep = chViewTabs(v);
        if (!keep.some(function (t) { return t.key === tab; })) open(keep[0].key);
    };
    const fetcher = useMemo(function () { return p.fetcher || function (u, i) { return window.fetch(u, i); }; }, [p.fetcher]);
    useEffect(function () {
        try {
            if (!document.getElementById('tailwind-cdn')) {
                const s = document.createElement('script');
                s.id = 'tailwind-cdn'; s.src = 'https://cdn.tailwindcss.com';
                document.head.appendChild(s);
            }
        } catch (e) { /* no document */ }
    }, []);
    return (
        <div style={{ fontFamily: BRAND_FONT, minHeight: 400, overflowY: 'auto', overflowX: 'hidden', WebkitOverflowScrolling: 'touch' }} className="ch-scroll bg-slate-50 text-slate-900" data-scroller>
            <style>{CH_SCROLL_CSS}</style>
            <header className="bg-white border-b border-slate-200">
                <div className="mx-auto max-w-6xl px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <BrandLogo />
                    <div className="flex flex-col">
                        <span className="text-lg font-black text-[#00468B] leading-tight">Ordering hub</span>
                        <span className="text-xs text-slate-600">Sanitation chemicals and supplies</span>
                    </div>
                    <label className="flex items-center gap-2 text-xs font-bold text-slate-600">View<select data-ch-view value={view} onChange={function (e) { pickView(e.target.value); }}
                        className="min-h-[44px] rounded-lg border border-slate-300 bg-white px-2 text-sm font-bold text-[#00468B] focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40">
                        {CH_VIEWS.map(function (v) { return <option key={v.key} value={v.key}>{v.label}</option>; })}</select></label>
                    <nav className="brand-tabs ml-auto flex flex-wrap gap-1" role="tablist" aria-label="Ordering hub">
                        {tabs.map(function (t) {
                            const on = tab === t.key;
                            return <button type="button" key={t.key} role="tab" aria-selected={on} data-testtab onClick={function () { open(t.key); }}
                                className={'min-h-[44px] px-3 sm:px-4 rounded-lg text-sm font-extrabold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ' + (on ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]')}>{t.label}</button>;
                        })}
                    </nav>
                </div>
                <div style={{ height: 4, background: 'linear-gradient(90deg, ' + BRAND.blue + ' 0 60%, ' + BRAND.yellow + ' 60% 80%, ' + BRAND.red + ' 80% 100%)' }} />
            </header>
            <main className="mx-auto max-w-6xl px-4 py-5">
                {/* the Ordering, Log, Count, Import, Lists and Insight tabs stay mounted while hidden: Count keeps the counts typed, Ordering keeps the carts copied for SAP and what was
                    typed, Log keeps the entry being built and its saves running, a running import keeps its progress, Stop and results, and Lists keeps changes not saved yet.
                    Ordering comes first, so its live regions stay the first ones on the page */}
                <div style={{ display: tab === 'ordering' ? '' : 'none' }}><OrderingTab fetcher={fetcher} baseUrl={p.baseUrl} shown={tab === 'ordering'} /></div>
                {opened.log && <div style={{ display: tab === 'log' ? '' : 'none' }}><LogTab fetcher={fetcher} baseUrl={p.baseUrl} shown={tab === 'log'} /></div>}
                <div style={{ display: tab === 'import' ? '' : 'none' }}><ImportTab fetcher={fetcher} baseUrl={p.baseUrl} /></div>
                {opened.lists && <div style={{ display: tab === 'lists' ? '' : 'none' }}><ListsTab fetcher={fetcher} baseUrl={p.baseUrl} shown={tab === 'lists'} /></div>}
                {opened.count && <div style={{ display: tab === 'count' ? '' : 'none' }}><CountTab fetcher={fetcher} baseUrl={p.baseUrl} shown={tab === 'count'} /></div>}
                {opened.insight && <div style={{ display: tab === 'insight' ? '' : 'none' }}><InsightTab fetcher={fetcher} baseUrl={p.baseUrl} shown={tab === 'insight'} clerk={view === 'clerk'} /></div>}
                {tab === 'tables' && <TablesTab fetcher={fetcher} baseUrl={p.baseUrl} />}
            </main>
            {/* white space to scroll past, so the last row of a tab clears the bottom edge of the app */}
            <div aria-hidden="true" style={{ height: 160 }} data-bottom-space />
            {manual && <ChCopyBox text={manual.text} at={manual.at} onClose={closeManual} />}
        </div>
    );
}
