// ============================================================================
// PAGE
// ============================================================================
// ============================================================================
// INSIGHT TAB: charts of what was bought and what was counted (reads only, writes nothing)
// ============================================================================
// Spend is the cart lines on carts (requests and cancelled carts are left out), dated by the cart's Submitted on, else its
// Drafted on. A line is "not received yet" while its cart is open (draft to partially received) and the line is not received
// in full. Stock is the Sunday counts; deliveries are received lines (dated as in ordArrivals). Filters scope every chart.
const INS_RANGES = [{ key: 'ytd', label: 'Year to date' }, { key: '12m', label: 'Last 12 months' }, { key: '13w', label: 'Last 13 weeks' }, { key: 'all', label: 'All' }];
const INS_BY = [{ key: 'item', label: 'Item' }, { key: 'category', label: 'Category' }, { key: 'vendor', label: 'Distributor' }];
// colors: spend received is the company blue; not received yet is a lighter step of it (ordinal pair, light end 2.2:1 on white);
// reference lines and ticks are ink, not a series; under minimum is the status red, always with words beside it
const INS_C = { bar: BRAND.blue, open: '#7DB4E6', ink: '#334155', grid: '#E2E8F0', axis: '#64748B', base: '#CBD5E1', red: BRAND.red };
const INS_MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const INS_TOP = 10;
const INS_PANELS = 8;
const INS_DRAFT = 'Draft (not in SAP yet)';

function insDay(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
function insAddDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
function insSunday(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() - d.getDay()); }
function insMonthKey(d) { return d.getFullYear() + '-' + (d.getMonth() < 9 ? '0' : '') + (d.getMonth() + 1); }
function insShortDay(d) { return (d.getMonth() + 1) + '/' + d.getDate(); }
// money written short for axes and tiles: $950, $1.2K, $12K, $1.18M
function insK(n) {
    const v = ordNum(n), a = Math.abs(v), s = v < 0 ? '-$' : '$';
    if (a >= 999500) return s + (a / 1000000).toFixed(a >= 9995000 ? 1 : 2).replace(/\.?0+$/, '') + 'M';
    if (a >= 9995) return s + Math.round(a / 1000) + 'K';
    if (a >= 999.5) return s + (a / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    return s + Math.round(a);
}
// the top of an axis: the value rounded up to 1, 2 or 5 times a power of ten (so its half, the middle gridline, is round too)
function insNice(v) {
    if (!(v > 0)) return 1;
    const p = Math.pow(10, Math.floor(Math.log(v) / Math.LN10)), f = v / p;
    return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p;
}
function insQty(n) { const v = ordRound(ordNum(n), 1); return chNumber(String(v)); }
// a bar's path: square at the baseline, its top corners rounded (r 4, less on a short or thin bar)
