        });
    }, [base, fetcher]);
    useEffect(function () { load(); }, [load]);

    const today = useMemo(function () { const n = data ? data.loadedAt : new Date(); return new Date(n.getFullYear(), n.getMonth(), n.getDate()); }, [data]);
    const ix = useMemo(function () { return data ? ordIndex(data, today) : null; }, [data, today]);
    const use = useMemo(function () { return ix ? ordWeeklyUse(ix) : {}; }, [ix]);
    const sugs = useMemo(function () { return ix ? ordSuggest(ix, use) : []; }, [ix, use]);
    const carts = useMemo(function () { return ix ? ordBuildCarts(ix, sugs, data.loadedAt, Object.keys(ix.carts)) : []; }, [ix, sugs, data]);
    const alerts = useMemo(function () { return ix ? ordAlerts(ix) : []; }, [ix]);
