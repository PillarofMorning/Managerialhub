// Reading: a Date only column becomes 'YYYY-MM-DD', the day the app shows (Dataverse sends 'YYYY-MM-DDT00:00:00Z' when the
// adjustment is Time zone independent, and the UTC moment of local midnight when it is User local). A time zone independent
// date and time loses its Z, because it is a wall-clock time.
function chDateIn(d, v) {
    const s = String(v);
