function TablesTab(props) {
    const fetcher = props.fetcher;
    const [answers, setAnswers] = useState({});
    const [checking, setChecking] = useState(false);
    const [checkedAt, setCheckedAt] = useState(null);
    const [problem, setProblem] = useState('');
    const [filter, setFilter] = useState('all');
    const [copied, setCopied] = useState('');
    const runId = useRef(0);
    const base = useMemo(function () { return props.baseUrl !== undefined ? props.baseUrl : chClientUrl(); }, [props.baseUrl]);

    const run = useCallback(function () {
        if (!base) { setProblem('Cannot check from here: this page has no Dataverse address. Open the Chemical hub inside the Power Apps app and press Check again. The list below is what the hub needs.'); return; }
        const id = ++runId.current;
        setChecking(true); setProblem(''); setAnswers({});
        chPool(CH_SPEC, CH_PARALLEL, function (t) {
            return chCheckTable(fetcher, base, t).then(function (r) {
                if (runId.current === id) setAnswers(function (prev) { const n = Object.assign({}, prev); n[t.logical] = r; return n; });
                return r;
            });
        }).then(function (all) {
            if (runId.current !== id) return;
            const none = all.every(function (r) { return r && r.state === 'noanswer'; });
            if (none) setProblem('Dataverse did not answer for any table. Check the connection and press Check again.');
            setChecking(false); setCheckedAt(new Date());
        });
    }, [base, fetcher]);

    useEffect(function () { run(); }, [run]);

    const views = CH_SPEC.map(function (t) { return chCompare(t, answers[t.logical]); });
    const hubViews = views.filter(function (v) { return v.table.group === 'hub'; });
    const readViews = views.filter(function (v) { return v.table.group === 'read'; });
    const checked = views.filter(function (v) { return !!v.res; }).length;
    const tally = function (list) {
        return {
            found: list.filter(function (v) { return v.state === 'found'; }).length,
            missing: list.filter(function (v) { return v.state === 'missing'; }).length,
            work: list.filter(chTableNeedsWork).length
        };
    };
    const th = tally(hubViews), tr = tally(readViews);
    const missingCols = hubViews.reduce(function (n, v) { return n + (v.state === 'missing' ? v.table.columns.length : v.counts.missing); }, 0);
    const shown = function (list) {
        if (filter === 'work') return list.filter(chTableNeedsWork);
        if (filter === 'found') return list.filter(function (v) { return v.state === 'found' && !chTableNeedsWork(v); });
        return list;
    };
    const copy = function (everything) {
        // Before any answer nothing is known to exist, so both buttons copy the whole list.
        const text = chBuildText(views, everything || checked === 0);
