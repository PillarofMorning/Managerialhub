                        const twin = now.filter(function (r) { return r._id !== s.id && lstKey(list, r) === s.key; })[0];
                        if (twin) clashIds.push(s.id);
                        if (twin && clash.indexOf(lstRowName(list, twin)) < 0) clash.push(lstRowName(list, twin));
                    });
                    if (clashIds.length) ids = clashIds;
                    if (clash.length) stop = 'Nothing was saved: ' + (list === 'alias' ? (clash.length === 1 ? 'this spelling is' : 'these spellings are') : (clash.length === 1 ? 'this target is' : 'these targets are')) + ' in Dataverse already, added on another device or on the Import tab since this page read the list: ' + clash.join(', ') + '. The list was read again: change ' + (clash.length === 1 ? 'that row' : 'those rows') + ' instead.';
                }
                if (stop) { lastFail.current = { text: stop, ids: ids }; return load(stop).then(function () { finish(false); }); }
            }
            const one = steps[0], hd = one.create ? { 'If-None-Match': '*' } : { 'If-Match': one.etag || '*' };
            const sent = steps.length === 1 ? chSend(fetcher, one.method, one.url, one.data, hd).then(function (r) { return { ok: chOk(r), status: r.status, step: 1, code: r.code, message: r.message }; }) : chBatch(fetcher, base, steps);
            return sent.then(function (r) {
                const s = r.step ? steps[r.step - 1] : null;
                const why = String(r.message || '').replace(/\.$/, '');
                const stale = !r.ok && (r.status === 412 || (r.status === 404 && (s ? !!s.etag : true)));
                const failed = r.ok ? '' : !r.status ? (/^Dataverse did not answer/.test(why) ? why : 'Dataverse did not answer (' + why + ')') + ', so the changes may or may not have been saved. The lists were read again: what was saved shows as saved, and the rest is still to save.'
                    : stale ? 'Nothing was saved: a row changed in Dataverse after this page read it (or was deleted), or an earlier try that got no answer was saved after all. The lists were read again; rows marked below changed in Dataverse, so check them before you save again. Dataverse said: ' + r.message
                    : 'Nothing was saved. Dataverse refused ' + (s && s.what ? s.what.charAt(0).toLowerCase() + s.what.slice(1) : 'the change') + ': ' + r.message;
                const done = {};
                if (r.ok) steps.forEach(function (x) { done[x.id] = true; });
                lastFail.current = failed ? { text: failed, ids: ids } : null;
                return load(failed, done).then(function (res) {
                    const n = steps.length + ' change' + (steps.length === 1 ? '' : 's');
                    let good = r.ok;
                    if (r.ok) setMsg({ list: list, text: 'Saved ' + n + '.' });
                    else if (res && !r.status && steps.every(function (x) { return res.saved[x.id]; })) {
                        // the warning keeps what this read found besides (a row deleted elsewhere, a table not read)
                        good = true; lastFail.current = null; setProblem(res.extra.join(' '));
                        setMsg({ list: list, text: 'Dataverse did not answer at first, but every change is in Dataverse now. Saved ' + n + '.' });
                    }
                    finish(!!(good && res && !res.dropped));
                });
            });
        }).then(null, function (e) { setProblem('Saving stopped on an error in this page (' + chErrText(e) + '). Press Refresh to see what was saved.'); finish(false); });
    };

    const viewBtn = function (key, label, n) {
        const on = view === key;
        return <button type="button" key={key} onClick={function () { setView(key); }} aria-pressed={on} data-lst-view={key}
            className={'min-h-[44px] px-3 rounded-lg text-sm font-bold border focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ' + (on ? 'bg-[#0072CE] text-white border-[#0072CE]' : 'bg-white text-[#00468B] border-slate-300 hover:bg-slate-50')}>{label}{n !== undefined ? ' (' + n + ')' : ''}</button>;
    };
    // Add, Save and Undo stay at the top of the screen while the list scrolls, with the result of the last save beside them
    const toolbar = function (list) {
        const ch = changesOf(list), tbl = T[list];
        const bad = ch.ed.some(function (rid) { const row = (tbl.rows || []).filter(function (r) { return r._id === rid; })[0]; return row ? problemsOf(list, fieldsOf(list, row), rid).length > 0 : false; })
            || ch.ad.some(function (a) { return problemsOf(list, a.f, a.nid).length > 0; });
        const off = busy || loading || !!tbl.error || !ch.n || bad || (list === 'target' && !!T.item.error);
        const why = tbl.error ? tbl.label + ' could not be read: press Refresh' : list === 'target' && T.item.error ? 'The Chemical list could not be read: press Refresh' : bad ? 'Fix the rows marked in red first' : !ch.n ? 'Nothing changed yet' : undefined;
        return <div ref={barRef} className="sticky top-0 z-10 bg-slate-50 py-2 mt-1">
            <div className="flex flex-wrap items-center gap-2">
                <button type="button" data-lst-add={list} className={btnWhite + (busy || loading || tbl.error ? ' opacity-50 cursor-not-allowed' : '')} aria-disabled={!!(busy || loading || tbl.error)}
                    onClick={function () { if (!busy && !loading && !tbl.error) addRow(list); }}>{list === 'alias' ? 'Add spelling' : 'Add target'}</button>
                <button type="button" data-lst-save={list} className={btnBlue + (off ? ' opacity-50 cursor-not-allowed' : '')} aria-disabled={off} title={why}
                    onClick={function () { if (!off) save(list); }}>{busy ? 'Saving...' : 'Save ' + (ch.n ? ch.n + ' change' + (ch.n === 1 ? '' : 's') : 'changes')}</button>
                {ch.n > 0 && <button type="button" data-lst-undo={list} className={btnWhite + (busy ? ' opacity-50 cursor-not-allowed' : '')} aria-disabled={busy} onClick={function () { if (!busy) undo(list); }}>Undo changes</button>}
            </div>
            {msg && msg.list === list && <p ref={msgRef} tabIndex={-1} data-lst-msg className="mt-2 rounded-lg border border-[#B3D4F2] bg-[#E6F1FB] px-3 py-2 text-sm text-[#00468B] focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40">{msg.text}</p>}
        </div>;
    };
    const th = 'px-2 py-2 text-left text-xs font-black uppercase tracking-wider text-slate-500';

    const ready = !!T;
    const A = ready ? T.alias : null, G = ready ? T.target : null;
    const aliasRows = useMemo(function () {
        if (!A || !A.rows) return [];
        return A.rows.slice().sort(function (a, b) { return String(a.craa5__c_areaaliasname || '').toLowerCase().localeCompare(String(b.craa5__c_areaaliasname || '').toLowerCase()); });
    }, [A]);
    const aliasOff = useMemo(function () { return offOf('alias'); }, [A]);
    const targetOff = useMemo(function () { return offOf('target'); }, [G]);
    // the choices as Dataverse has them (the hub's own list when they could not be read)
    const labelsOf = function (tbl, list, k) {
        const have = tbl && tbl.options && tbl.cols && tbl.cols[k] ? tbl.options[tbl.cols[k]] : null;
        return (have && have.length ? have : (chSpecCol(LST_T[list], k) || { options: [] }).options).map(function (o) { return o[0]; }).filter(function (l) { return !!l; });
    };
    const entryLabels = useMemo(function () { return labelsOf(A, 'alias', 'craa5_entrytypehint'); }, [A]);
    const appLabels = useMemo(function () { return labelsOf(G, 'target', 'craa5_application'); }, [G]);
    // the filter chips go by the rows as saved, so a row stays in view while it is typed in; a spelling that is an entry type
    // (Barrel Change) needs no area or room
    const aliasIs = function (kind, r) {
        const g = function (c) { return impClean(r[c]); };
        if (kind === 'noarea') return !g('craa5_area') && !g('craa5_entrytypehint');
        if (kind === 'noroom') return !g('craa5_room') && !g('craa5_entrytypehint');
        if (kind === 'changed') return !!(edits[r._id] || flags[r._id]);
        if (kind === 'notmss') return !!(mssAreas && g('craa5_area') && !mssAreas.m[ordKey(g('craa5_area'))]);
        return true;
    };
    const aliasCounts = { all: aliasRows.length, noarea: 0, noroom: 0, notmss: 0, changed: 0 };
    aliasRows.forEach(function (r) { ['noarea', 'noroom', 'notmss', 'changed'].forEach(function (k) { if (aliasIs(k, r)) aliasCounts[k]++; }); });
    const q = impClean(find).toLowerCase();
    // Find looks in what is saved and in what is typed
    const shownAlias = aliasRows.filter(function (r) {
        if (!aliasIs(only, r)) return false;
        if (q && ['craa5__c_areaaliasname', 'craa5_area', 'craa5_spot', 'craa5_room'].map(function (c) { return impClean(r[c]) + ' ' + impClean(valOf('alias', r, c)); }).join(' ').toLowerCase().indexOf(q) < 0) return false;
        return true;
    });
    const spots = useMemo(function () {
        const m = {}, list = [];
        aliasRows.forEach(function (r) { const s = impClean(r.craa5_spot); if (s && !m[s.toLowerCase()]) { m[s.toLowerCase()] = true; list.push(s); } });
        return list.sort();
    }, [aliasRows]);
    const rooms = useMemo(function () {
        const m = {}, list = [];
        LST_ROOMS.concat(aliasRows.map(function (r) { return impClean(r.craa5_room); })).forEach(function (s) { if (s && !m[s.toLowerCase()]) { m[s.toLowerCase()] = true; list.push(s); } });
