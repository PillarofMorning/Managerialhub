// wall clock with a Z, User local the UTC moment.
function chDateOut(d, v) {
    if (!d || v === null || v === undefined || v === '') return v;
    const t = ordDate(v);
    if (!t) return v;
    const p2 = function (n) { return (n < 10 ? '0' : '') + n; };
