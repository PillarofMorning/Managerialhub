const CH_TABS = [{ key: 'ordering', label: 'Ordering' }, { key: 'tables', label: 'Tables' }];

export default function ChemicalHub(props) {
    const p = props || {};
    const [tab, setTab] = useState('ordering');
    const fetcher = useMemo(function () { return p.fetcher || function (u, i) { return window.fetch(u, i); }; }, [p.fetcher]);
    useEffect(function () {
        try {
            if (!document.getElementById('tailwind-cdn')) {
                const s = document.createElement('script');
                s.id = 'tailwind-cdn'; s.src = 'https://cdn.tailwindcss.com';
                document.head.appendChild(s);
            }
        } catch (e) { /* no document */ }
    }, []);
    return (
        <div style={{ fontFamily: BRAND_FONT, height: '100vh', minHeight: 400, overflowY: 'auto', overflowX: 'hidden', WebkitOverflowScrolling: 'touch' }} className="bg-slate-50 text-slate-900" data-scroller>
            <header className="bg-white border-b border-slate-200">
                <div className="mx-auto max-w-6xl px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <BrandLogo />
                    <div className="flex flex-col">
                        <span className="text-lg font-black text-[#00468B] leading-tight">Chemical hub</span>
                        <span className="text-xs text-slate-600">Sanitation chemicals and supplies</span>
                    </div>
                    <nav className="brand-tabs ml-auto flex gap-1" role="tablist" aria-label="Chemical hub">
                        {CH_TABS.map(function (t) {
                            const on = tab === t.key;
                            return <button type="button" key={t.key} role="tab" aria-selected={on} data-testtab onClick={function () { setTab(t.key); }}
                                className={'min-h-[44px] px-4 rounded-lg text-sm font-extrabold focus:outline-none focus:ring-2 focus:ring-[#0072CE]/40 ' + (on ? 'bg-[#0072CE] text-white' : 'text-[#00468B] hover:bg-[#E6F1FB]')}>{t.label}</button>;
                        })}
                    </nav>
                </div>
                <div style={{ height: 4, background: 'linear-gradient(90deg, ' + BRAND.blue + ' 0 60%, ' + BRAND.yellow + ' 60% 80%, ' + BRAND.red + ' 80% 100%)' }} />
            </header>
            <main className="mx-auto max-w-6xl px-4 py-5">
                {tab === 'ordering' && <OrderingTab fetcher={fetcher} baseUrl={p.baseUrl} />}
                {tab === 'tables' && <TablesTab fetcher={fetcher} baseUrl={p.baseUrl} />}
            </main>
        </div>
    );
}
