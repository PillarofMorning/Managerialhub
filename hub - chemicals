                    craa5__c_cartname: l.craa5__c_cartname, craa5_itemnumber: l.craa5_itemnumber, craa5_quantity: q, craa5_unitprice: blank(l.craa5_unitprice) ? null : ordNum(l.craa5_unitprice), craa5_linetotal: total,
                    craa5_quantityreceived: r.qty, craa5_receivedon: day, craa5_source: l._raw && l._raw.craa5_source !== undefined ? l._raw.craa5_source : null, craa5_requestedby: l.craa5_requestedby || null, craa5_reason: l.craa5_reason || null }) });
            };
            if (part > 0 && part < qty) {
                // part of the line came: that part becomes a line and the rest stays open on this one; the stored line total is
                // split between them, so the two still add up to it (a line with no price keeps no price)
                const price = blank(l.craa5_unitprice) ? null : ordNum(l.craa5_unitprice);
                const partTotal = !blank(l.craa5_linetotal) ? ordRound(ordNum(l.craa5_linetotal) * part / qty, 2) : price !== null ? ordRound(part * price, 2) : null;
                const restTotal = !blank(l.craa5_linetotal) ? ordRound(ordNum(l.craa5_linetotal) - partTotal, 2) : price !== null ? ordRound((qty - part) * price, 2) : null;
                newLine(part, name + ' x' + ordQty(part), partTotal);
                steps.push({ method: 'PATCH', url: url(T.line, l._id), etag: l._etag, what: 'Line ' + (l.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5__c_cartlinename: (name + ' x' + ordQty(qty - part)).slice(0, 200),
                    craa5_quantity: ordRound(qty - part, 4), craa5_linetotal: restTotal }) });
            } else if (part === 0 && had > 0) {
                // more of a line already received in full: the extra is a line of quantity 0, so what was ordered, the cart total and
                // the day the rest came stay as they are
                newLine(0, name + ' x0, ' + ordQty(r.qty) + ' extra received', 0);
            } else steps.push({ method: 'PATCH', url: url(T.line, l._id), etag: l._etag, what: 'Line ' + (l.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5_quantityreceived: had + r.qty, craa5_receivedon: day }) });
            const k = ordKey(l.craa5_itemnumber);
            addTo[k] = (addTo[k] || 0) + r.qty; if (!itemNo[k]) itemNo[k] = l.craa5_itemnumber;
        });
        // one stock write per item, worked out from the stock as read (nothing is changed on the page until the tables are read again)
        Object.keys(addTo).forEach(function (k) {
            const s = ix.stock[k];
            if (s && s.rows.length) {
                const row = s.rows[0];
                steps.push({ method: 'PATCH', url: url(T.stock, row._id), etag: row._etag, what: 'Stock of ' + (row.craa5__c_chemicalinventoryname || k), data: ordPayload(T.stock, { craa5_quantityonhand: ordNum(row.craa5_quantityonhand) + addTo[k], craa5_lastupdated: now.toISOString() }) });
            } else {
                const it = ix.items[k];
                steps.push({ method: 'PATCH', create: true, url: url(T.stock, chGuidFrom('stock|' + k + '|Chemical room')), what: 'New stock row for ' + k, data: ordPayload(T.stock, { craa5__c_chemicalinventoryname: ((it && (it.craa5_commonname || it.craa5__c_chemicalname)) || k) + ' - Chemical room', craa5_itemnumber: itemNo[k],
                    craa5_location: ordChoiceValue(ORD_T.stock, 'craa5_location', 'Chemical room'), craa5_quantityonhand: addTo[k], craa5_minimumthreshold: 0, craa5_lastupdated: now.toISOString() }) });
            }
        });
        const all = lines.every(function (l) {
            const r = recs.filter(function (x) { return x.line._id === l._id; })[0];
            return ordNum(l.craa5_quantityreceived) + (r ? r.qty : 0) >= ordNum(l.craa5_quantity);
        });
        steps.push({ method: 'PATCH', url: url(T.cart, c._id), etag: c._etag, what: 'The cart', data: ordPayload(T.cart, { craa5_cartstatus: ordChoiceValue(ORD_T.cart, 'craa5_cartstatus', all ? 'Received' : 'Partially received'), craa5_receivedon: now.toISOString() }) });
        return run(steps, 'Receipt saved for ' + c.craa5__c_cartname + '. Stock is updated.');
    };
    // A cart that arrived before the last count: its lines are marked received, stock is left alone (the count already has them).
    const closeCart = function (c, lines) {
        const steps = [];
        lines.forEach(function (l) {
            if (ordNum(l.craa5_quantityreceived) < ordNum(l.craa5_quantity)) steps.push({ method: 'PATCH', url: url(T.line, l._id), etag: l._etag, what: 'Line ' + (l.craa5__c_cartlinename || ''), data: ordPayload(T.line, { craa5_quantityreceived: ordNum(l.craa5_quantity) }) });
        });
        steps.push({ method: 'PATCH', url: url(T.cart, c._id), etag: c._etag, what: 'The cart', data: ordPayload(T.cart, { craa5_cartstatus: ordChoiceValue(ORD_T.cart, 'craa5_cartstatus', 'Received') }) });
        return run(steps, c.craa5__c_cartname + ' closed as received. Stock was not changed.');
    };
    const addRequest = function () {
        const it = ix.items[ordKey(req.item)];
        const q = ordNum(req.qty);
        if (!it || q <= 0) { setProblem('Pick an item from the list and a quantity above 0.'); return; }
        const name = it.craa5_commonname || it.craa5__c_chemicalname || it.craa5_itemnumber;
