                                        <div className="flex-1 min-w-[150px] sm:max-w-md">
                                            <div className="text-sm font-bold text-slate-900">{l.name}{l.isNew && <span className="ml-2 rounded bg-[#FFF6E0] px-1.5 py-0.5 text-xs font-bold text-[#7A4B00]">new</span>}</div>
                                            <div className="text-xs text-slate-600">{'Item ' + l.itemNo + ', min ' + ordQty(l.min) + ', ' + lastText(l)}</div>
                                        </div>
