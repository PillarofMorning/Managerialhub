    const say = function (text) { setMsg(text); setTimeout(function () { setMsg(function (m) { return m === text ? '' : m; }); }, 6000); };
    const copyText = function (key, text) {
        const done = function () { setCopied(key); setTimeout(function () { setCopied(''); }, 2500); };
        try { if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copy this text', text); }); return; } } catch (e) { /* fall through */ }
        window.prompt('Copy this text', text);
    };
    const T = data ? data.tables : null;
    const url = function (tbl, id) { return base + CH_API + tbl.meta.set + (id ? '(' + String(id).replace(/[^0-9a-fA-F-]/g, '') + ')' : ''); };
