{
 "contract": "ecosystem data contract",
 "version": "1.0",
 "date": "2026-10-21",
 "doc": "ecosystem/data-contract.md",
 "helpers": "ecosystem/hub-shared.js",
 "plantTimeZone": "America/Chicago",
 "prefixes": {
  "_c_": "Chemical hub",
  "_m_": "Manager hub",
  "_p_": "PBED",
  "_b_": "Pathogen BOLO",
  "_t_": "Training matrix",
  "_g_": "Ganttly / Shift Start (reserved)",
  "_e_": "Shared ecosystem",
  "_0_": "abandoned (except craa5__0_hubconfig)"
 },
 "keyFormats": {
  "area": "craa5_aa_mss_area.craa5_area exact name; compare with hubCanon",
  "room": "room name (craa5_parentroom / craa5_roomname)",
  "line": "hubLineKey(area, line): lower-case letters+digits, line number appended when > 1 (ibl4, breading2)",
  "equipment": "craa5_aa_assetsid GUID, lower case, no braces; lists joined with \"; \"",
  "employee": "craa5__aa_employeeid GUID; lists joined with \"; \"",
  "crew": "A, B, C or D (hubCrew)",
  "shiftdate": "YYYY-MM-DD plant day the shift started (board craa5_slotstart)",
  "shift": "shiftdate|crew",
  "completion": "assetGuid|shiftdate|cleanKind (hubCompletionKey); MSS log row id = hubIdFromKey(\"log|\" + key)",
  "week": "Monday YYYY-MM-DD (hubWeekKey)",
  "dateOnlyInDataverse": "midnight UTC of the plant day: YYYY-MM-DDT00:00:00Z"
 },
 "cleanKinds": [
  "daily",
  "midweek",
  "eow",
  "allergen",
  "changeover",
  "monthly",
  "quarterly",
  "semiannual",
  "annual",
  "corrective",
  "other"
 ],
 "planKindMap": {
  "full": "daily",
  "weekly": "eow",
  "midweek": "midweek",
  "allergen": "allergen",
  "changeover": "changeover",
  "none": ""
 },
 "statuses": {
  "checkoff": [
   "planned",
   "started",
   "done",
   "skipped",
   "undone"
  ],
  "cleanWindow": [
   "ok",
   "tight",
   "short",
   "overlap",
   "nocrew",
   "none"
  ],
  "board": [
   "planned",
   "live",
   "archived",
   "used",
   "cancelled"
  ],
  "attendance": [
   "present",
   "late",
   "sick",
   "pto",
   "left_early",
   "no_call",
   "loaned",
   "training"
  ],
  "tableLoad": [
   "loading",
   "ready",
   "empty",
   "missing",
   "denied",
   "error"
  ],
  "swab": [
   "positive",
   "negative",
   "pending"
  ]
 },
 "roles": {
  "256000000": "Sanitor",
